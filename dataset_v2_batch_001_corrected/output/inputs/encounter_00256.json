  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.21,
      "end_seconds": 5.27,
      "duration_seconds": 4.06,
      "text": "Excuse me, doctor, should I sit here?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.93,
      "end_seconds": 12.7,
      "duration_seconds": 3.77,
      "text": "Yes, do sit. Tell me what's been happening."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 13.44,
      "end_seconds": 24.25,
      "duration_seconds": 10.81,
      "text": "Um, so... dark urine. That's why I came. I looked a few things up online, and that probably didn't help."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 26.73,
      "end_seconds": 29.7,
      "duration_seconds": 2.97,
      "text": "how long has this been going on?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 30.24,
      "end_seconds": 42.14,
      "duration_seconds": 11.9,
      "text": "so, uh, I'm not sure when it began, to to be honest. Some weeks ago, but I can't say how many"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 43.08,
      "end_seconds": 44.3,
      "duration_seconds": 1.22,
      "text": "anything that helps?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 45.4,
      "end_seconds": 49.84,
      "duration_seconds": 4.44,
      "text": "It settles a little with drinking more water."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 50.24,
      "end_seconds": 51.19,
      "duration_seconds": 0.95,
      "text": "I see."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 52.01,
      "end_seconds": 59.9,
      "duration_seconds": 7.89,
      "text": "I mean, I've also been feeling dizzy when I stand, for two weeks"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 64.97,
      "end_seconds": 70.77,
      "duration_seconds": 5.8,
      "text": "Let me check a few things. Any blood in the stool, confusion or fever?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 71.68,
      "end_seconds": 78.57,
      "duration_seconds": 6.89,
      "text": "I haven't had blood in the stool, confusion or fever, no"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 79.62,
      "end_seconds": 82.24,
      "duration_seconds": 2.62,
      "text": "any vomiting or fainting at all?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 86.2,
      "end_seconds": 88.32,
      "duration_seconds": 2.12,
      "text": "No. None of those."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 90.05,
      "end_seconds": 93.92,
      "duration_seconds": 3.87,
      "text": "on the cardiac side, anything I should know?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 95.24,
      "end_seconds": 99.1,
      "duration_seconds": 3.86,
      "text": "I mean, no, that's been fine."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 100.33,
      "end_seconds": 104.56,
      "duration_seconds": 4.23,
      "text": "What about your tummy and and bowels, anything unusual there?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 105.19,
      "end_seconds": 110.17,
      "duration_seconds": 4.98,
      "text": "Yeah, um, no, that side's been fine."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 116.02,
      "end_seconds": 121.03,
      "duration_seconds": 5.01,
      "text": "have you ever reacted badly to a medicine or food? Any allergies?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 122.18,
      "end_seconds": 126.08,
      "duration_seconds": 3.9,
      "text": "No, um, no allergies to anything."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 143.29,
      "end_seconds": 147.73,
      "duration_seconds": 4.44,
      "text": "Moving on to your background, any past medical history?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 149.74,
      "end_seconds": 156.26,
      "duration_seconds": 6.52,
      "text": "Oh, um, I've had diabetes for about a year now."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 168.69,
      "end_seconds": 171.92,
      "duration_seconds": 3.23,
      "text": "Is there a family history of anything significant?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 172.62,
      "end_seconds": 174.78,
      "duration_seconds": 2.16,
      "text": "My sister has epilepsy."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 177.18,
      "end_seconds": 181.83,
      "duration_seconds": 4.65,
      "text": "Tell me about your routine, work, habits, that sort of thing."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 182.56,
      "end_seconds": 205.6,
      "duration_seconds": 23.04,
      "text": "I stopped smoking about two years back. A beer or two most evenings, to be honest. I work night shifts at a warehouse. Not really, I don't get much exercise. I stay with my daughter and her family."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 206.56,
      "end_seconds": 210.48,
      "duration_seconds": 3.92,
      "text": "Let's go through your medication. What are you taking?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 215.66,
      "end_seconds": 219.05,
      "duration_seconds": 3.39,
      "text": "I'm on Glycomet, twice a day."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 220.47,
      "end_seconds": 222.55,
      "duration_seconds": 2.08,
      "text": "how much do you take?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 223.62,
      "end_seconds": 229.27,
      "duration_seconds": 5.65,
      "text": "500 milligrams, I think that's what's on the box."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 230.77,
      "end_seconds": 233.23,
      "duration_seconds": 2.46,
      "text": "roughly how long on that one?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 234.57,
      "end_seconds": 236.1,
      "duration_seconds": 1.53,
      "text": "Two years now."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 236.64,
      "end_seconds": 237.34,
      "duration_seconds": 0.7,
      "text": "okay"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 238.35,
      "end_seconds": 240.95,
      "duration_seconds": 2.6,
      "text": "It's ORS, whenever I remember."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 242.2,
      "end_seconds": 244.92,
      "duration_seconds": 2.72,
      "text": "Can I take your vitals now?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 254.84,
      "end_seconds": 256.75,
      "duration_seconds": 1.91,
      "text": "Just relax your arm..."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 276.31,
      "end_seconds": 283.48,
      "duration_seconds": 7.17,
      "text": "okay: saturation 96 percent, pressure 95 over 63, heart rate 99, respiratory rate 20."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 284.61,
      "end_seconds": 286.92,
      "duration_seconds": 2.31,
      "text": "Is that alright, doctor?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 287.95,
      "end_seconds": 291.86,
      "duration_seconds": 3.91,
      "text": "Don't worry, I'll go through it in a moment."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 299.63,
      "end_seconds": 310.77,
      "duration_seconds": 11.14,
      "text": "going by what you've described, it points towards dehydration from a stomach bug we shouldn't forget an electrolyte imbalance i'd like to arrange blood salts for dehydration"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 311.88,
      "end_seconds": 314.48,
      "duration_seconds": 2.6,
      "text": "mm, you know, okay"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 315.87,
      "end_seconds": 340.56,
      "duration_seconds": 24.69,
      "text": "Small, frequent sips are better than a big glass at once, and keep going even if you don't feel thirsty. Try to get to bed and wake up at the same time each day, and keep your phone away from the bed. Good. Let us know how you get on."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 342.02,
      "end_seconds": 344.58,
      "duration_seconds": 2.56,
      "text": "thank you for your time"
    }
  ]
