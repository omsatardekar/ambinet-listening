{
  "schema_version": "1.0",
  "encounter_id": "00118",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.25,
      "end_seconds": 5.69,
      "duration_seconds": 4.44,
      "text": "Doctor? Hi. I hope I've got the right time."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.39,
      "end_seconds": 10.6,
      "duration_seconds": 4.21,
      "text": "No trouble at all, come in. What's been bothering you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 11.87,
      "end_seconds": 16.54,
      "duration_seconds": 4.67,
      "text": "Okay, so thank you for fitting us in, doctor."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 17.57,
      "end_seconds": 20.97,
      "duration_seconds": 3.4,
      "text": "Good, that'll be useful. Pull up a chair."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 21.61,
      "end_seconds": 27.59,
      "duration_seconds": 5.98,
      "text": "So, he's been having pain in my right ear, doctor."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 28.19,
      "end_seconds": 32.43,
      "duration_seconds": 4.24,
      "text": "Is this recent, or has it been a while?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 33.64,
      "end_seconds": 44.25,
      "duration_seconds": 10.61,
      "text": "Okay, um, so about... well, about four days. I looked a few things up online, and that probably didn't help."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 45.94,
      "end_seconds": 55.77,
      "duration_seconds": 9.83,
      "text": "Okay, tell me a bit more about it: how bad it gets, how often, and whether anything makes it better or worse."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 57.4,
      "end_seconds": 80.4,
      "duration_seconds": 23.0,
      "text": "Honestly, every other day. A warm cloth helps a bit. Moderate, really. I've also had muffled hearing, since last weekend. And there's a runny nose before it started as well, about two weeks now. With runny nose before it started, I'd say moderate."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 82.35,
      "end_seconds": 89.01,
      "duration_seconds": 6.66,
      "text": "Have you had pain in your right ear before, or is this the first time?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 94.89,
      "end_seconds": 102.74,
      "duration_seconds": 7.85,
      "text": "I had a similar thing a couple of years ago. It went away."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 115.56,
      "end_seconds": 119.43,
      "duration_seconds": 3.87,
      "text": "Have you had to have anything operated on?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 120.72,
      "end_seconds": 130.59,
      "duration_seconds": 9.87,
      "text": "Just a knee arthroscopy, three years ago. I just want to get back to normal, really."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 140.18,
      "end_seconds": 143.52,
      "duration_seconds": 3.34,
      "text": "Is there a family history of anything significant?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 144.64,
      "end_seconds": 150.49,
      "duration_seconds": 5.85,
      "text": "My father had a stroke. Um, my mother has migraines."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 167.56,
      "end_seconds": 172.1,
      "duration_seconds": 4.54,
      "text": "Moving on to your background, any past medical history?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 172.85,
      "end_seconds": 178.39,
      "duration_seconds": 5.54,
      "text": "I have asthma. High cholesterol, for about a year."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 179.67,
      "end_seconds": 181.01,
      "duration_seconds": 1.34,
      "text": "Right, any more?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 182.03,
      "end_seconds": 191.3,
      "duration_seconds": 9.27,
      "text": "Right, so high cholesterol is already on your record. We'll keep that in mind today. Do you have any known allergies at all?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 192.05,
      "end_seconds": 207.27,
      "duration_seconds": 15.22,
      "text": "Hmm, there was some antibiotic, I was told I was allergic. But I couldn't tell you what it was called or what it did."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 213.74,
      "end_seconds": 216.83,
      "duration_seconds": 3.09,
      "text": "A few questions about your lifestyle now."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 218.75,
      "end_seconds": 233.09,
      "duration_seconds": 14.34,
      "text": "I run a small shop, so I'm on my feet a lot. I go to the gym a couple of times a week. I'm mostly vegetarian."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 234.04,
      "end_seconds": 237.27,
      "duration_seconds": 3.23,
      "text": "Are you on any tablets or medication?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 238.87,
      "end_seconds": 254.63,
      "duration_seconds": 15.76,
      "text": "He takes Seretide inhaler, twice a day for my asthma. Okay, uh, so he is on rosuvastatin, 10 milligrams, at night, I give it to him."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 255.45,
      "end_seconds": 261.75,
      "duration_seconds": 6.3,
      "text": "Have you had any facial weakness, swelling behind the ear or recent swim?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 263.51,
      "end_seconds": 271.07,
      "duration_seconds": 7.56,
      "text": "Um, no facial weakness, swelling behind the ear or recent swim, none of it."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 271.91,
      "end_seconds": 276.85,
      "duration_seconds": 4.94,
      "text": "A few quick ones: ringing, dizziness or discharge from the ear?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 278.16,
      "end_seconds": 284.7,
      "duration_seconds": 6.54,
      "text": "No ringing, dizziness or discharge from the ear, none of it."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 285.44,
      "end_seconds": 288.8,
      "duration_seconds": 3.36,
      "text": "How about your heart, any problems like that?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 289.5,
      "end_seconds": 292.53,
      "duration_seconds": 3.03,
      "text": "No, nothing with my heart."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 294.35,
      "end_seconds": 296.72,
      "duration_seconds": 2.37,
      "text": "Is your chest okay generally?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 297.55,
      "end_seconds": 299.42,
      "duration_seconds": 1.87,
      "text": "No, nothing there."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 300.22,
      "end_seconds": 302.81,
      "duration_seconds": 2.59,
      "text": "Can I take your vitals now?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 311.0,
      "end_seconds": 312.59,
      "duration_seconds": 1.59,
      "text": "Hold still for me..."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 331.4,
      "end_seconds": 344.41,
      "duration_seconds": 13.01,
      "text": "Okay: pulse is 102 beats a minute, BMI works out to 36.3, temperature is 38.1 degrees, height 161 centimetres, pressure 116 over 79, weight 94 kilos."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 348.98,
      "end_seconds": 351.05,
      "duration_seconds": 2.07,
      "text": "Is that alright, doctor?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 351.95,
      "end_seconds": 355.4,
      "duration_seconds": 3.45,
      "text": "I'll interpret it once I've examined you."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 357.81,
      "end_seconds": 361.5,
      "duration_seconds": 3.69,
      "text": "Okay, I need to examine you for this."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 363.34,
      "end_seconds": 364.53,
      "duration_seconds": 1.19,
      "text": "I'll go gently."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 373.22,
      "end_seconds": 375.48,
      "duration_seconds": 2.26,
      "text": "The left ear looks normal."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 377.04,
      "end_seconds": 380.02,
      "duration_seconds": 2.98,
      "text": "Alright, almost done with this part."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 393.13,
      "end_seconds": 396.26,
      "duration_seconds": 3.13,
      "text": "The right eardrum looks red and bulging."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 399.39,
      "end_seconds": 411.62,
      "duration_seconds": 12.23,
      "text": "All done, you can get dressed. So, based on the history and the examination, I'd lean towards a middle ear infection. Another possibility is a wax blockage."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 412.24,
      "end_seconds": 415.24,
      "duration_seconds": 3.0,
      "text": "Yeah, doctor, is this dangerous?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 418.81,
      "end_seconds": 454.59,
      "duration_seconds": 35.78,
      "text": "Nothing I've seen today points to an emergency. It looks like a middle ear infection. I'm going to put you on amoxicillin, 500 milligrams, three times a day, for five days. That's for ear infection. Keep the ear dry for now and don't put anything in it, including cotton buds. One warning sign to remember: you get discharge, swelling behind the ear or the pain gets much worse. In that case don't wait."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 455.77,
      "end_seconds": 462.97,
      "duration_seconds": 7.2,
      "text": "I'd like to see you again in a week. That's it on my side. Anything unclear?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 464.32,
      "end_seconds": 471.17,
      "duration_seconds": 6.85,
      "text": "Um, you know, no, I think that's everything. Thank you, doctor."
    }
  ]
}