{
  "schema_version": "1.0",
  "encounter_id": "00113",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.27,
      "end_seconds": 4.74,
      "duration_seconds": 3.47,
      "text": "Evening. Long day, I imagine. Sit down."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 5.62,
      "end_seconds": 6.79,
      "duration_seconds": 1.17,
      "text": "Hi, doctor."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 8.87,
      "end_seconds": 11.78,
      "duration_seconds": 2.91,
      "text": "In your own words, what's happened?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 12.87,
      "end_seconds": 20.47,
      "duration_seconds": 7.6,
      "text": "Well, you know, I'm here because of swelling in my left calf."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 21.19,
      "end_seconds": 23.6,
      "duration_seconds": 2.41,
      "text": "Since when have you had this?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 24.53,
      "end_seconds": 28.83,
      "duration_seconds": 4.3,
      "text": "It's been going on for about two weeks."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 30.86,
      "end_seconds": 40.21,
      "duration_seconds": 9.35,
      "text": "Tell me a bit more about it: how bad it gets, how often, and whether anything makes it better or worse."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 45.47,
      "end_seconds": 60.09,
      "duration_seconds": 14.62,
      "text": "Hmm, you know, it happens a couple of times a week. It's worse with standing. My family kept telling me to get it checked."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 60.81,
      "end_seconds": 64.11,
      "duration_seconds": 3.3,
      "text": "Anything that tends to go along with it?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 65.22,
      "end_seconds": 72.52,
      "duration_seconds": 7.3,
      "text": "When it starts I tend to get pain in that calf as well."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 73.09,
      "end_seconds": 81.28,
      "duration_seconds": 8.19,
      "text": "Uh, I was just going to say that the main thing is—"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 81.38,
      "end_seconds": 87.69,
      "duration_seconds": 6.31,
      "text": "Sorry to cut in, doctor, quick question: shall I bring the trolley in now or later?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 93.85,
      "end_seconds": 95.94,
      "duration_seconds": 2.09,
      "text": "Later, thanks. Please go on."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_4",
      "role": "UNKNOWN",
      "start_seconds": 97.64,
      "end_seconds": 100.6,
      "duration_seconds": 2.96,
      "text": "Mm, that's what happened, yes."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 102.43,
      "end_seconds": 108.0,
      "duration_seconds": 5.57,
      "text": "Have you had any coughing up blood, breathlessness or recent injury to the leg?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 109.2,
      "end_seconds": 128.09,
      "duration_seconds": 18.89,
      "text": "No, no coughing up blood, no breathlessness, no recent injury to the leg. I did have warmth in the leg at one point, but that went away on its own."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 128.88,
      "end_seconds": 132.38,
      "duration_seconds": 3.5,
      "text": "A few quick ones: chest pain or fever?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 134.34,
      "end_seconds": 138.89,
      "duration_seconds": 4.55,
      "text": "I haven't had chest pain or fever, no."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 139.94,
      "end_seconds": 142.43,
      "duration_seconds": 2.49,
      "text": "Anything different when you pass water?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 144.52,
      "end_seconds": 147.47,
      "duration_seconds": 2.95,
      "text": "Nothing there, you know, no."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 148.99,
      "end_seconds": 151.38,
      "duration_seconds": 2.39,
      "text": "Any rashes or skin problems otherwise?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 152.87,
      "end_seconds": 155.84,
      "duration_seconds": 2.97,
      "text": "Nothing on the skin, no."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 156.72,
      "end_seconds": 159.3,
      "duration_seconds": 2.58,
      "text": "So, any operations in the past?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 159.99,
      "end_seconds": 165.58,
      "duration_seconds": 5.59,
      "text": "Okay, so I had my appendix out about eight years ago."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 169.91,
      "end_seconds": 172.34,
      "duration_seconds": 2.43,
      "text": "Any diagnoses you've been given before?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 173.68,
      "end_seconds": 187.24,
      "duration_seconds": 13.56,
      "text": "I have arthritis in my knees. I'd rather know what's going on than keep guessing. Uh, I've had high blood pressure for about ten years now."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 191.19,
      "end_seconds": 192.16,
      "duration_seconds": 0.97,
      "text": "Go on."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 194.0,
      "end_seconds": 195.78,
      "duration_seconds": 1.78,
      "text": "Yes, low haemoglobin."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 197.77,
      "end_seconds": 207.08,
      "duration_seconds": 9.31,
      "text": "Alright, arthritis in your knees and high blood pressure, that matches what I have here. Anything special about your diet?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 207.6,
      "end_seconds": 211.85,
      "duration_seconds": 4.25,
      "text": "I try to avoid too much sugar."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 212.68,
      "end_seconds": 217.6,
      "duration_seconds": 4.92,
      "text": "Have you ever reacted badly to a medicine or food? Any allergies?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 219.09,
      "end_seconds": 222.48,
      "duration_seconds": 3.39,
      "text": "So, no, nothing I'm aware of."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 224.36,
      "end_seconds": 227.52,
      "duration_seconds": 3.16,
      "text": "What medicines are you taking at the moment?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 229.26,
      "end_seconds": 238.12,
      "duration_seconds": 8.86,
      "text": "It's a... um, I can't remember what it's called. It's a little pink tablet."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 238.83,
      "end_seconds": 241.69,
      "duration_seconds": 2.86,
      "text": "Right, do you remember what it's for?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 243.08,
      "end_seconds": 265.05,
      "duration_seconds": 21.97,
      "text": "For the joint pain, I believe. My son sets them out for me, I just take what I'm given. I, I take iron tablets, once a day for my blood count. Paracetamol, 500 milligrams, when needed."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 265.95,
      "end_seconds": 270.43,
      "duration_seconds": 4.48,
      "text": "Doctor, our chart from the last visit lists it as 1000 milligrams."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 271.29,
      "end_seconds": 274.93,
      "duration_seconds": 3.64,
      "text": "I see. Is the most recent prescription on you?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 276.7,
      "end_seconds": 280.33,
      "duration_seconds": 3.63,
      "text": "No, I left it at home."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 289.73,
      "end_seconds": 303.71,
      "duration_seconds": 13.98,
      "text": "Doctor, I've got the readings for you. Weight 58 kilos, blood pressure 133 over 72. Heart rate 117, BMI works out to 22.7, temperature is 36.7 degrees, height 160 centimetres."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 304.63,
      "end_seconds": 305.99,
      "duration_seconds": 1.36,
      "text": "Good, thank you."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 307.31,
      "end_seconds": 310.0,
      "duration_seconds": 2.69,
      "text": "I'd like to examine you now."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 311.01,
      "end_seconds": 314.66,
      "duration_seconds": 3.65,
      "text": "A little pressure here, tell me if it's tender."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 332.56,
      "end_seconds": 334.91,
      "duration_seconds": 2.35,
      "text": "The right leg looks normal."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 336.29,
      "end_seconds": 340.34,
      "duration_seconds": 4.05,
      "text": "A little pressure here, tell me if it's tender."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 348.45,
      "end_seconds": 353.26,
      "duration_seconds": 4.81,
      "text": "The left calf is bigger than the right, tender along the vein."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 355.42,
      "end_seconds": 357.95,
      "duration_seconds": 2.53,
      "text": "All done, you can get dressed."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 372.3,
      "end_seconds": 381.41,
      "duration_seconds": 9.11,
      "text": "Okay, thinking it through, the most likely explanation is a possible deep vein clot. Cellulitis is also on my list."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 382.34,
      "end_seconds": 385.18,
      "duration_seconds": 2.84,
      "text": "Right, doctor, is this dangerous?"
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 386.26,
      "end_seconds": 403.71,
      "duration_seconds": 17.45,
      "text": "I can't promise yet, but most people with a possible deep vein clot do well once it's treated properly. So, to recap quickly. You've had swelling in your left calf for about two weeks, and no chest pain or breathlessness."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 405.17,
      "end_seconds": 407.39,
      "duration_seconds": 2.22,
      "text": "Yes, you've got it."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 409.1,
      "end_seconds": 413.42,
      "duration_seconds": 4.32,
      "text": "We should do a D-dimer blood test for suspected DVT."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_5",
      "role": "CLINICAL_STAFF",
      "start_seconds": 415.24,
      "end_seconds": 419.48,
      "duration_seconds": 4.24,
      "text": "I can book that for Wednesday at 11:30 am."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 420.15,
      "end_seconds": 430.7,
      "duration_seconds": 10.55,
      "text": "We should do a Doppler scan of the leg for suspected DVT. The result will help us decide whether anything more is needed."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 432.48,
      "end_seconds": 436.69,
      "duration_seconds": 4.21,
      "text": "Okay, so does it need any preparation?"
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 437.74,
      "end_seconds": 451.49,
      "duration_seconds": 13.75,
      "text": "Keep walking gently, and don't massage the calf. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose. Come back after the scan."
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 452.09,
      "end_seconds": 457.62,
      "duration_seconds": 5.53,
      "text": "I mean, um, good, I'll come back then."
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 459.39,
      "end_seconds": 461.1,
      "duration_seconds": 1.71,
      "text": "Thanks for coming in."
    },
    {
      "segment_id": "SEG0059",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 461.77,
      "end_seconds": 465.81,
      "duration_seconds": 4.04,
      "text": "Um, nothing more from me, thanks."
    },
    {
      "segment_id": "SEG0060",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 467.21,
      "end_seconds": 468.85,
      "duration_seconds": 1.64,
      "text": "Mind how you go."
    }
  ]
}