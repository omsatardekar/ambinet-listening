{
  "schema_version": "1.0",
  "encounter_id": "00247",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 1.33,
      "end_seconds": 8.79,
      "duration_seconds": 7.46,
      "text": "Okay, doctor, we're all set in here. I'll give you the numbers when you want them."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 10.79,
      "end_seconds": 15.5,
      "duration_seconds": 4.71,
      "text": "right, good, thank you. Welcome, tell me what's brought you in"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 20.26,
      "end_seconds": 25.71,
      "duration_seconds": 5.45,
      "text": "I wanted to to get a ring-shaped itchy patch looked at."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 27.44,
      "end_seconds": 29.42,
      "duration_seconds": 1.98,
      "text": "and when did that start?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 31.14,
      "end_seconds": 33.84,
      "duration_seconds": 2.7,
      "text": "For three days, I'd say."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 35.24,
      "end_seconds": 44.3,
      "duration_seconds": 9.06,
      "text": "Can you describe it a bit more for me? How strong it is, what the pattern is, what helps."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 46.24,
      "end_seconds": 60.12,
      "duration_seconds": 13.88,
      "text": "uh, um, it sort of comes and goes. I'd call it moderate. Sweating definitely sets it off. I kept putting it off, which I know isn't sensible"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 61.67,
      "end_seconds": 64.21,
      "duration_seconds": 2.54,
      "text": "Any scaly, peeling skin as well?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 65.59,
      "end_seconds": 66.63,
      "duration_seconds": 1.04,
      "text": "Yes, actually."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 70.82,
      "end_seconds": 76.44,
      "duration_seconds": 5.62,
      "text": "have you had a ring-shaped itchy patch before, or is this the first time?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 76.95,
      "end_seconds": 81.86,
      "duration_seconds": 4.91,
      "text": "A bit, last winter. It settled by itself back then."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 83.79,
      "end_seconds": 92.23,
      "duration_seconds": 8.44,
      "text": "Let me check a a few things. Any fever, pain, pus or similar rash on the scalp?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 94.07,
      "end_seconds": 100.27,
      "duration_seconds": 6.2,
      "text": "No, no fever, pain, pus or similar rash on the scalp."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 101.6,
      "end_seconds": 104.76,
      "duration_seconds": 3.16,
      "text": "How are your joints, any aches elsewhere?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 106.03,
      "end_seconds": 107.44,
      "duration_seconds": 1.41,
      "text": "Nothing else aches."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 109.18,
      "end_seconds": 111.91,
      "duration_seconds": 2.73,
      "text": "Has your heart given you any trouble?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 112.65,
      "end_seconds": 118.64,
      "duration_seconds": 5.99,
      "text": "My heart's been fine, uh, as far as I know."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 136.49,
      "end_seconds": 139.8,
      "duration_seconds": 3.31,
      "text": "Have you had to have anything operated on?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 141.41,
      "end_seconds": 145.18,
      "duration_seconds": 3.77,
      "text": "Just a knee arthroscopy, three years ago."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 161.86,
      "end_seconds": 167.68,
      "duration_seconds": 5.82,
      "text": "Have you ever reacted badly to a medicine or food? Any allergies?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 168.49,
      "end_seconds": 172.1,
      "duration_seconds": 3.61,
      "text": "Oh, yes, pollen, it gives me sneezing."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 189.78,
      "end_seconds": 193.71,
      "duration_seconds": 3.93,
      "text": "Any long-term health problems I should know about?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 195.6,
      "end_seconds": 202.4,
      "duration_seconds": 6.8,
      "text": "Diabetes, for about ten years. I've had acid reflux for five years now."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 203.94,
      "end_seconds": 211.36,
      "duration_seconds": 7.42,
      "text": "Okay, I can see acid reflux in your file as well. What's your current medication list?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 213.21,
      "end_seconds": 220.8,
      "duration_seconds": 7.59,
      "text": "Glimepiride, 2 milligrams, before breakfast. I'm on omeprazole, 20 milligrams, once a day."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 221.37,
      "end_seconds": 224.3,
      "duration_seconds": 2.93,
      "text": "So, is anyone at home with you?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 224.91,
      "end_seconds": 228.69,
      "duration_seconds": 3.78,
      "text": "I share a flat with two friends."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 229.25,
      "end_seconds": 231.22,
      "duration_seconds": 1.97,
      "text": "what's your diet like?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 232.65,
      "end_seconds": 237.72,
      "duration_seconds": 5.07,
      "text": "I eat out quite a lot, to be honest."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 239.81,
      "end_seconds": 242.58,
      "duration_seconds": 2.77,
      "text": "What do you do to keep active?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 244.45,
      "end_seconds": 247.6,
      "duration_seconds": 3.15,
      "text": "I cycle to work most mornings"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 249.1,
      "end_seconds": 259.23,
      "duration_seconds": 10.13,
      "text": "Here are the numbers, doctor. Respiratory rate 15, pulse is 85 beats a minute, BP is 110 over 68, temperature is 36.9 degrees."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 260.67,
      "end_seconds": 262.1,
      "duration_seconds": 1.43,
      "text": "Good, thank you."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 264.0,
      "end_seconds": 266.91,
      "duration_seconds": 2.91,
      "text": "Let's do the physical part now."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 267.51,
      "end_seconds": 268.58,
      "duration_seconds": 1.07,
      "text": "Yes, doctor."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 269.86,
      "end_seconds": 272.06,
      "duration_seconds": 2.2,
      "text": "Let me just check something."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 283.65,
      "end_seconds": 290.51,
      "duration_seconds": 6.86,
      "text": "There's a red ring-shaped scaly patch with a clearer centre in the groin crease."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 294.85,
      "end_seconds": 309.99,
      "duration_seconds": 15.14,
      "text": "Okay, you can sit up. So So where does that leave us? It points towards a fungal skin infection. Keep the area dry, wear loose cotton, and don't share towels. Look after yourself."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 311.75,
      "end_seconds": 317.23,
      "duration_seconds": 5.48,
      "text": "Hmm, um, that's everything I wanted to ask. Thank you."
    }
  ]
}