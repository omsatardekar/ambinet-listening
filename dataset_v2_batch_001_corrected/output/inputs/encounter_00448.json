{
  "schema_version": "1.0",
  "encounter_id": "00448",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.99,
      "end_seconds": 5.27,
      "duration_seconds": 4.28,
      "text": "Morning. Nice to finally see you, uh, doctor."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 9.73,
      "end_seconds": 13.8,
      "duration_seconds": 4.07,
      "text": "Right on time. Sit, please. How can I help?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 14.53,
      "end_seconds": 18.58,
      "duration_seconds": 4.05,
      "text": "Mainly I've been feeling lightheaded. That's why I came."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 19.76,
      "end_seconds": 21.44,
      "duration_seconds": 1.68,
      "text": "Let's do your observations."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 30.59,
      "end_seconds": 32.36,
      "duration_seconds": 1.77,
      "text": "Hold still for me..."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 45.12,
      "end_seconds": 54.8,
      "duration_seconds": 9.68,
      "text": "Okay: pulse 102, temperature is 36.6 degrees, SpO2 99 percent on room air, BP is 102 over 57."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 60.17,
      "end_seconds": 61.85,
      "duration_seconds": 1.68,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 63.24,
      "end_seconds": 67.4,
      "duration_seconds": 4.16,
      "text": "Don't worry, I'll go through it in a moment."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 85.28,
      "end_seconds": 87.28,
      "duration_seconds": 2.0,
      "text": "Roughly when did it start?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 88.35,
      "end_seconds": 90.72,
      "duration_seconds": 2.37,
      "text": "For one week, I'd say."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 92.24,
      "end_seconds": 94.43,
      "duration_seconds": 2.19,
      "text": "How often does it happen?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 95.13,
      "end_seconds": 98.21,
      "duration_seconds": 3.08,
      "text": "Honestly, once or twice a day."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 99.82,
      "end_seconds": 102.24,
      "duration_seconds": 2.42,
      "text": "How intense does it get?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 103.27,
      "end_seconds": 105.68,
      "duration_seconds": 2.41,
      "text": "It feels severe to me."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 110.38,
      "end_seconds": 113.51,
      "duration_seconds": 3.13,
      "text": "Have you found anything that eases it?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 115.16,
      "end_seconds": 118.89,
      "duration_seconds": 3.73,
      "text": "Only sitting down, and it's not much."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 133.59,
      "end_seconds": 135.9,
      "duration_seconds": 2.31,
      "text": "Have you had any vomiting?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 137.21,
      "end_seconds": 139.82,
      "duration_seconds": 2.61,
      "text": "Not at all, no vomiting."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 141.29,
      "end_seconds": 144.97,
      "duration_seconds": 3.68,
      "text": "Have you had any chest pain or weakness?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 147.02,
      "end_seconds": 150.27,
      "duration_seconds": 3.25,
      "text": "No, no chest pain or weakness."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 151.77,
      "end_seconds": 154.15,
      "duration_seconds": 2.38,
      "text": "Your breathing, any trouble there?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 155.21,
      "end_seconds": 156.97,
      "duration_seconds": 1.76,
      "text": "No, nothing there."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 174.33,
      "end_seconds": 179.81,
      "duration_seconds": 5.48,
      "text": "What about family history, any illnesses that run in the family?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 181.21,
      "end_seconds": 183.52,
      "duration_seconds": 2.31,
      "text": "My father had kidney stones."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 184.29,
      "end_seconds": 186.91,
      "duration_seconds": 2.62,
      "text": "Any diagnoses you've been given before?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 187.88,
      "end_seconds": 192.63,
      "duration_seconds": 4.75,
      "text": "I've had high blood pressure for two years now."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 193.63,
      "end_seconds": 196.45,
      "duration_seconds": 2.82,
      "text": "Any allergies I should know about?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 197.77,
      "end_seconds": 199.55,
      "duration_seconds": 1.78,
      "text": "Dust, I'd say."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 204.15,
      "end_seconds": 207.48,
      "duration_seconds": 3.33,
      "text": "A few questions about your lifestyle now."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 208.58,
      "end_seconds": 225.73,
      "duration_seconds": 17.15,
      "text": "I have a couple of drinks on the weekend. I smoke about ten cigarettes a day. I work night shifts at a warehouse. I live with my family, my husband and two kids."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 243.37,
      "end_seconds": 246.31,
      "duration_seconds": 2.94,
      "text": "Are you on any tablets or medication?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 250.19,
      "end_seconds": 256.28,
      "duration_seconds": 6.09,
      "text": "I take ramipril, 5 milligrams, every morning for my blood pressure."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 257.57,
      "end_seconds": 260.56,
      "duration_seconds": 2.99,
      "text": "I'll examine you now, bear with me."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 261.83,
      "end_seconds": 262.53,
      "duration_seconds": 0.7,
      "text": "Fine."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 264.35,
      "end_seconds": 268.56,
      "duration_seconds": 4.21,
      "text": "A little pressure here, tell me if it's tender."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 282.16,
      "end_seconds": 284.1,
      "duration_seconds": 1.94,
      "text": "Heart rhythm is regular."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 286.62,
      "end_seconds": 299.5,
      "duration_seconds": 12.88,
      "text": "Thanks for that. From what you've told me and what I found, it points towards postural low blood pressure. Blood tests is what I'd like next, for dizziness."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 301.0,
      "end_seconds": 304.53,
      "duration_seconds": 3.53,
      "text": "I can book that for Monday at 10 am."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 308.27,
      "end_seconds": 336.47,
      "duration_seconds": 28.2,
      "text": "Let's get an ECG, for dizziness. Get up in stages, sit on the edge of the bed for a minute first, and keep drinking water. A blood sugar test is something we might do if this doesn't improve in two weeks. If the symptoms get worse, or you feel really unwell, please come to the emergency department."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 338.15,
      "end_seconds": 341.52,
      "duration_seconds": 3.37,
      "text": "Alright, I know what to look for."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 343.6,
      "end_seconds": 351.55,
      "duration_seconds": 7.95,
      "text": "Book a review in two weeks. Right, before we finish, can you repeat the plan back to me?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 352.15,
      "end_seconds": 357.9,
      "duration_seconds": 5.75,
      "text": "So, I come back in two weeks. Is that right?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 358.96,
      "end_seconds": 363.92,
      "duration_seconds": 4.96,
      "text": "Yes, exactly right. Is there anything you wanted to ask?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 366.0,
      "end_seconds": 369.65,
      "duration_seconds": 3.65,
      "text": "That's everything I wanted to ask. Thank you."
    }
  ]
}