{
  "schema_version": "1.0",
  "encounter_id": "00067",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 1.36,
      "end_seconds": 8.02,
      "duration_seconds": 6.66,
      "text": "Doctor, this one's ready for you. Everything's on the chart, but I'll go through it."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 9.83,
      "end_seconds": 14.09,
      "duration_seconds": 4.26,
      "text": "Good, thank you. Welcome, tell me what's brought you in."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 15.4,
      "end_seconds": 23.51,
      "duration_seconds": 8.11,
      "text": "Doctor, thank you for seeing us. I mean, we came because of burning when I pass urine."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 24.88,
      "end_seconds": 27.18,
      "duration_seconds": 2.3,
      "text": "And when did that start?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 28.4,
      "end_seconds": 42.91,
      "duration_seconds": 14.51,
      "text": "Uh, honestly I can't say exactly when it started. It might have been last month or the month before, I really can't pin it down."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 44.23,
      "end_seconds": 47.55,
      "duration_seconds": 3.32,
      "text": "Would you call it mild or bad?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 50.05,
      "end_seconds": 56.48,
      "duration_seconds": 6.43,
      "text": "Well, it's... hard to say, it's kind of... I don't know—"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 58.15,
      "end_seconds": 65.0,
      "duration_seconds": 6.85,
      "text": "Alright, take your time. Mild, moderate, or severe, if you had to pick?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 69.32,
      "end_seconds": 76.4,
      "duration_seconds": 7.08,
      "text": "Yeah, you know, I'd give it a six, out of ten."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 76.66,
      "end_seconds": 77.57,
      "duration_seconds": 0.91,
      "text": "I see."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 78.05,
      "end_seconds": 85.95,
      "duration_seconds": 7.9,
      "text": "So, I was just going to say that the main thing is—"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 86.05,
      "end_seconds": 93.05,
      "duration_seconds": 7.0,
      "text": "Sorry to cut in, doctor, quick question: shall I bring the trolley in now or later?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 94.08,
      "end_seconds": 96.98,
      "duration_seconds": 2.9,
      "text": "Okay, later, thanks. Please go on."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 98.53,
      "end_seconds": 104.71,
      "duration_seconds": 6.18,
      "text": "And I've been needing to go all the time as well."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 106.46,
      "end_seconds": 110.88,
      "duration_seconds": 4.42,
      "text": "Right, did you get similar episode recently or vomiting?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 111.4,
      "end_seconds": 127.97,
      "duration_seconds": 16.57,
      "text": "Uh, no, no similar episode recently, no vomiting. I did have an urgent need to pass urine at one point, but that went away on its own."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 129.99,
      "end_seconds": 135.51,
      "duration_seconds": 5.52,
      "text": "And what about vaginal discharge, fever or blood in the urine?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 136.82,
      "end_seconds": 143.85,
      "duration_seconds": 7.03,
      "text": "No vaginal discharge, fever or blood in the urine, none of it."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 148.58,
      "end_seconds": 151.81,
      "duration_seconds": 3.23,
      "text": "Alright, any rashes or skin problems otherwise?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 153.26,
      "end_seconds": 154.26,
      "duration_seconds": 1.0,
      "text": "Skin's normal."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 155.43,
      "end_seconds": 158.03,
      "duration_seconds": 2.6,
      "text": "What medicines do you take regularly?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 159.86,
      "end_seconds": 166.41,
      "duration_seconds": 6.55,
      "text": "Right, I'm on thyroxine, 75 micrograms, maybe, every morning for my thyroid."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 167.02,
      "end_seconds": 171.49,
      "duration_seconds": 4.47,
      "text": "Have you got the box or the prescription on you?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 173.16,
      "end_seconds": 182.2,
      "duration_seconds": 9.04,
      "text": "Well, not with me. I'll bring it next time. I take cranberry juice, every day."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 194.94,
      "end_seconds": 198.87,
      "duration_seconds": 3.93,
      "text": "Anyone in the family with similar problems or other conditions?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 200.37,
      "end_seconds": 203.36,
      "duration_seconds": 2.99,
      "text": "My uncle had colon cancer."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 207.32,
      "end_seconds": 209.2,
      "duration_seconds": 1.88,
      "text": "What's your diet like?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 211.1,
      "end_seconds": 215.86,
      "duration_seconds": 4.76,
      "text": "I eat out quite a lot, to be honest."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 216.6,
      "end_seconds": 221.61,
      "duration_seconds": 5.01,
      "text": "Okay, what about allergies, to medicines or foods or anything else?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 223.63,
      "end_seconds": 235.0,
      "duration_seconds": 11.37,
      "text": "I think I reacted to some antibiotic once, you know, years ago. I don't remember which one, or what happened exactly."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 249.9,
      "end_seconds": 253.32,
      "duration_seconds": 3.42,
      "text": "Is there anything medical in your background?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 253.84,
      "end_seconds": 262.37,
      "duration_seconds": 8.53,
      "text": "I've got diabetes. I've, I've had an enlarged prostate, yes. An underactive thyroid, for two years."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 263.32,
      "end_seconds": 270.12,
      "duration_seconds": 6.8,
      "text": "Okay, so the vitals from earlier. BP is 112 over 76, oxygen saturation is 99 percent, pulse 77."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 271.26,
      "end_seconds": 272.18,
      "duration_seconds": 0.92,
      "text": "Okay, noted."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 274.96,
      "end_seconds": 277.62,
      "duration_seconds": 2.66,
      "text": "I'd like to examine you now."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 278.58,
      "end_seconds": 279.98,
      "duration_seconds": 1.4,
      "text": "I'll go gently."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 298.63,
      "end_seconds": 304.14,
      "duration_seconds": 5.51,
      "text": "There's mild tenderness above the pubic bone, and no tenderness in the loins."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 309.48,
      "end_seconds": 327.85,
      "duration_seconds": 18.37,
      "text": "Thanks, please take a seat again. Let me tell you where I've got to. It's hard to say. A urinary tract infection is one possibility and a sexually transmitted infection another, and I'd rather not commit yet."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 329.49,
      "end_seconds": 333.72,
      "duration_seconds": 4.23,
      "text": "Yeah, what are the chances it's something bad?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 334.77,
      "end_seconds": 351.9,
      "duration_seconds": 17.13,
      "text": "Nothing I've seen today points to an emergency. It looks like a urinary tract infection, but I'd like to confirm. So, to recap quickly. You've had burning when you pass urine, and no fever or blood in the urine."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 353.44,
      "end_seconds": 355.08,
      "duration_seconds": 1.64,
      "text": "Mm, that's right."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 355.93,
      "end_seconds": 362.69,
      "duration_seconds": 6.76,
      "text": "Doctor, I did a urine test before they came in, the result's on your screen."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 364.73,
      "end_seconds": 399.51,
      "duration_seconds": 34.78,
      "text": "Great, that saves time. I'm going to order a urine culture, for urinary symptoms. The treatment will be trimethoprim, 200 milligrams, twice a day, for three days. You take it by mouth. That should help with urine infection. Drink plenty of water and don't hold it in when you need to go. Try to keep a simple diary of when it happens and what you were doing, and bring it to the next visit."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 400.62,
      "end_seconds": 420.13,
      "duration_seconds": 19.51,
      "text": "And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose. If you get a fever, back pain or vomiting, or you feel really unwell, please come to the emergency department."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 422.03,
      "end_seconds": 424.42,
      "duration_seconds": 2.39,
      "text": "Got it, thank you."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 428.23,
      "end_seconds": 432.87,
      "duration_seconds": 4.64,
      "text": "I'll want another look if it's not better in three days."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 433.92,
      "end_seconds": 434.62,
      "duration_seconds": 0.7,
      "text": "Fine."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 435.23,
      "end_seconds": 438.33,
      "duration_seconds": 3.1,
      "text": "Call the clinic if you need us."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 439.8,
      "end_seconds": 447.28,
      "duration_seconds": 7.48,
      "text": "Uh, um, I think that's clear. Thank you for being so thorough."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 447.89,
      "end_seconds": 448.74,
      "duration_seconds": 0.85,
      "text": "Take care."
    }
  ]
}