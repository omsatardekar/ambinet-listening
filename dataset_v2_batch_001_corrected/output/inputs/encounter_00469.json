{
  "schema_version": "1.0",
  "encounter_id": "00469",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 0.76,
      "end_seconds": 7.12,
      "duration_seconds": 6.36,
      "text": "Doctor, your next patient is here. I've done the basics, I'll read them out in a moment."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 9.0,
      "end_seconds": 12.07,
      "duration_seconds": 3.07,
      "text": "Thank you. Right, hello, what's the problem?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 14.01,
      "end_seconds": 17.0,
      "duration_seconds": 2.99,
      "text": "Doctor, thank you for seeing us."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 18.05,
      "end_seconds": 21.8,
      "duration_seconds": 3.75,
      "text": "That's fine, sit down. We'll go through it together."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 23.14,
      "end_seconds": 27.93,
      "duration_seconds": 4.79,
      "text": "He's been feeling anxious most of the day, doctor."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 29.72,
      "end_seconds": 32.6,
      "duration_seconds": 2.88,
      "text": "How long are we talking about?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 34.21,
      "end_seconds": 42.52,
      "duration_seconds": 8.31,
      "text": "I'm not sure when it began, to be honest. Some weeks ago, but I can't say how many."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 44.33,
      "end_seconds": 47.08,
      "duration_seconds": 2.75,
      "text": "What makes it worse, if anything?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 48.53,
      "end_seconds": 53.14,
      "duration_seconds": 4.61,
      "text": "I notice it more with work and crowded places."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 53.81,
      "end_seconds": 57.73,
      "duration_seconds": 3.92,
      "text": "How would you describe it, mild, moderate, severe?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 58.33,
      "end_seconds": 60.26,
      "duration_seconds": 1.93,
      "text": "I'd call it moderate."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 60.98,
      "end_seconds": 62.73,
      "duration_seconds": 1.75,
      "text": "Does anything settle it?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 64.66,
      "end_seconds": 72.7,
      "duration_seconds": 8.04,
      "text": "Deep breathing helps a bit. Oh, and trouble falling asleep. I've also been feeling on edge."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 73.81,
      "end_seconds": 83.25,
      "duration_seconds": 9.44,
      "text": "Doctor, I've got the readings for you. Temperature 36.5, heart rate 84, blood pressure 121 over 72. Respiratory rate 18."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 85.04,
      "end_seconds": 85.74,
      "duration_seconds": 0.7,
      "text": "Thanks."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 88.36,
      "end_seconds": 91.97,
      "duration_seconds": 3.61,
      "text": "Okay, if you're comfortable, I'll examine you now."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 93.47,
      "end_seconds": 95.88,
      "duration_seconds": 2.41,
      "text": "Let me just check something."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 110.08,
      "end_seconds": 114.38,
      "duration_seconds": 4.3,
      "text": "Pulse is regular and you're breathing comfortably right now."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 116.88,
      "end_seconds": 123.46,
      "duration_seconds": 6.58,
      "text": "Okay, that's fine, sit up. Any fainting, chest pain on exertion or weight loss at all?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 123.97,
      "end_seconds": 130.85,
      "duration_seconds": 6.88,
      "text": "Hmm, I haven't had fainting, chest pain on exertion or weight loss, no."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 132.27,
      "end_seconds": 135.97,
      "duration_seconds": 3.7,
      "text": "Any low mood or alcohol use at all?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 137.26,
      "end_seconds": 140.07,
      "duration_seconds": 2.81,
      "text": "No, not any of them."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 141.38,
      "end_seconds": 143.68,
      "duration_seconds": 2.3,
      "text": "Has your skin been okay?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 145.0,
      "end_seconds": 145.89,
      "duration_seconds": 0.89,
      "text": "No rashes."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 146.62,
      "end_seconds": 148.64,
      "duration_seconds": 2.02,
      "text": "Alright, any regular medication?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 149.44,
      "end_seconds": 152.67,
      "duration_seconds": 3.23,
      "text": "No, I don't take anything regularly."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 153.65,
      "end_seconds": 156.22,
      "duration_seconds": 2.57,
      "text": "Now some background about your lifestyle."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 157.01,
      "end_seconds": 169.28,
      "duration_seconds": 12.27,
      "text": "I eat out quite a lot, to be honest. Yes, I live on my own. I drive a delivery van all day."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 181.95,
      "end_seconds": 185.89,
      "duration_seconds": 3.94,
      "text": "Anyone in the family with similar problems or other conditions?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 187.21,
      "end_seconds": 190.07,
      "duration_seconds": 2.86,
      "text": "My father had a heart attack."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 192.05,
      "end_seconds": 194.96,
      "duration_seconds": 2.91,
      "text": "Have you had any surgery before?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 195.62,
      "end_seconds": 204.32,
      "duration_seconds": 8.7,
      "text": "Just my tonsils out, when I was a child. I took the morning off to come in today."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 221.24,
      "end_seconds": 224.92,
      "duration_seconds": 3.68,
      "text": "Moving on to your background, any past medical history?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 226.44,
      "end_seconds": 231.44,
      "duration_seconds": 5.0,
      "text": "I have anxiety, for about ten years. Yes, asthma."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 233.12,
      "end_seconds": 238.32,
      "duration_seconds": 5.2,
      "text": "Okay. Yes, anxiety is known to us, good to have that clear."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 246.83,
      "end_seconds": 249.29,
      "duration_seconds": 2.46,
      "text": "Any allergies I should know about?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 250.68,
      "end_seconds": 254.42,
      "duration_seconds": 3.74,
      "text": "No allergies that I know of, no."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 255.87,
      "end_seconds": 265.63,
      "duration_seconds": 9.76,
      "text": "Putting it all together, this looks most like an anxiety disorder. I'd also keep a heart rhythm cause in mind."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 266.27,
      "end_seconds": 269.91,
      "duration_seconds": 3.64,
      "text": "Is this something I'll have for good?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 273.49,
      "end_seconds": 283.72,
      "duration_seconds": 10.23,
      "text": "I understand the worry. At the moment I'd say it's an anxiety disorder, and we'll know more once the an ECG is back."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 284.63,
      "end_seconds": 288.24,
      "duration_seconds": 3.61,
      "text": "I've already done an ECG, it's ready for you."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 289.78,
      "end_seconds": 319.04,
      "duration_seconds": 29.26,
      "text": "Thanks, I'll look at that. I'd like to arrange a thyroid test for anxiety. We'll begin with escitalopram, 5 milligrams, once a day, for two weeks then review. You take it by mouth. That should help with anxiety. Slow breathing, in for four and out for six, for a few minutes whenever it builds up. I'll want another look in two weeks."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 319.86,
      "end_seconds": 321.89,
      "duration_seconds": 2.03,
      "text": "Okay, see you then."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 327.36,
      "end_seconds": 330.25,
      "duration_seconds": 2.89,
      "text": "That's everything from me. Any other questions?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 332.32,
      "end_seconds": 334.27,
      "duration_seconds": 1.95,
      "text": "Okay, thank you. Bye."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 335.1,
      "end_seconds": 336.82,
      "duration_seconds": 1.72,
      "text": "Mind how you go."
    }
  ]
}