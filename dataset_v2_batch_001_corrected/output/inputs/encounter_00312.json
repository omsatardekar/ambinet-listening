{
  "schema_version": "1.0",
  "encounter_id": "00312",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.92,
      "end_seconds": 7.97,
      "duration_seconds": 7.05,
      "text": "Um, um, hi there, is it alright if I come in now?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 9.38,
      "end_seconds": 13.63,
      "duration_seconds": 4.25,
      "text": "Okay, yes, do sit. Tell me what's been happening."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 14.28,
      "end_seconds": 21.97,
      "duration_seconds": 7.69,
      "text": "Mainly I've been putting on weight over the last year. That's why I came."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 22.51,
      "end_seconds": 24.72,
      "duration_seconds": 2.21,
      "text": "What's your current medication list?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 26.79,
      "end_seconds": 31.74,
      "duration_seconds": 4.95,
      "text": "Hmm, I take ramipril, 5 milligrams, every morning."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 33.14,
      "end_seconds": 40.37,
      "duration_seconds": 7.23,
      "text": "Is this recent, or has it been a while? I'm asking so that we don't miss anything."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 41.93,
      "end_seconds": 44.73,
      "duration_seconds": 2.8,
      "text": "Yeah, it's been four weeks now."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 44.96,
      "end_seconds": 45.66,
      "duration_seconds": 0.7,
      "text": "Ah."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 46.96,
      "end_seconds": 52.38,
      "duration_seconds": 5.42,
      "text": "And I've been feeling out of breath on stairs as well."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 53.43,
      "end_seconds": 56.23,
      "duration_seconds": 2.8,
      "text": "Is there anything that triggers it?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 58.15,
      "end_seconds": 60.17,
      "duration_seconds": 2.02,
      "text": "It's worse with stairs."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 61.84,
      "end_seconds": 66.57,
      "duration_seconds": 4.73,
      "text": "Alright, and what about low mood, heat intolerance or palpitations?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 69.33,
      "end_seconds": 74.29,
      "duration_seconds": 4.96,
      "text": "I haven't had low mood, heat intolerance or palpitations, no."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 74.72,
      "end_seconds": 76.59,
      "duration_seconds": 1.87,
      "text": "Ah. Any chest pain?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 77.18,
      "end_seconds": 79.94,
      "duration_seconds": 2.76,
      "text": "No, none, no chest pain."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 81.36,
      "end_seconds": 84.31,
      "duration_seconds": 2.95,
      "text": "And your skin, any changes there?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 85.04,
      "end_seconds": 86.11,
      "duration_seconds": 1.07,
      "text": "No rashes."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 87.26,
      "end_seconds": 91.46,
      "duration_seconds": 4.2,
      "text": "Any pins and needles or loss of strength anywhere?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 92.23,
      "end_seconds": 93.66,
      "duration_seconds": 1.43,
      "text": "Nothing odd there."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 103.06,
      "end_seconds": 106.0,
      "duration_seconds": 2.94,
      "text": "Any allergies I should know about?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 110.2,
      "end_seconds": 113.92,
      "duration_seconds": 3.72,
      "text": "I don't have any known medication allergies."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 128.23,
      "end_seconds": 129.57,
      "duration_seconds": 1.34,
      "text": "What about alcohol?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 131.63,
      "end_seconds": 135.78,
      "duration_seconds": 4.15,
      "text": "I gave up drinking about three years ago."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 137.3,
      "end_seconds": 139.73,
      "duration_seconds": 2.43,
      "text": "Do you get any exercise?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 140.91,
      "end_seconds": 145.91,
      "duration_seconds": 5.0,
      "text": "I walk for about half an hour most days."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 147.38,
      "end_seconds": 149.49,
      "duration_seconds": 2.11,
      "text": "Tell me about your work."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 150.93,
      "end_seconds": 157.04,
      "duration_seconds": 6.11,
      "text": "I'm a software engineer, so I'm at a screen all day."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 158.27,
      "end_seconds": 160.22,
      "duration_seconds": 1.95,
      "text": "Do you live alone?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 164.68,
      "end_seconds": 167.5,
      "duration_seconds": 2.82,
      "text": "Yes, I live on my own."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 168.47,
      "end_seconds": 173.5,
      "duration_seconds": 5.03,
      "text": "Do you have any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 174.92,
      "end_seconds": 182.9,
      "duration_seconds": 7.98,
      "text": "High blood pressure, for two years. I thought it would sort itself out, but it hasn't."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 184.46,
      "end_seconds": 192.38,
      "duration_seconds": 7.92,
      "text": "Sure. Right, so high blood pressure is already on your record. We'll keep that in mind today."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 209.33,
      "end_seconds": 212.22,
      "duration_seconds": 2.89,
      "text": "Have you had any surgery before?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 214.24,
      "end_seconds": 217.4,
      "duration_seconds": 3.16,
      "text": "Just my gallbladder removed, in 2016."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 219.04,
      "end_seconds": 221.57,
      "duration_seconds": 2.53,
      "text": "Let's do the physical part now."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 222.62,
      "end_seconds": 225.49,
      "duration_seconds": 2.87,
      "text": "Stay still while I have a look."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 235.17,
      "end_seconds": 238.79,
      "duration_seconds": 3.62,
      "text": "Your waist measures about a hundred and four centimetres."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 242.85,
      "end_seconds": 254.32,
      "duration_seconds": 11.47,
      "text": "Okay, finished. So, based on the history and the examination, this looks most like weight gain with a metabolic cause that needs checking."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 256.22,
      "end_seconds": 260.03,
      "duration_seconds": 3.81,
      "text": "What are the chances it's something bad?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 261.71,
      "end_seconds": 272.73,
      "duration_seconds": 11.02,
      "text": "I can't promise yet, but most people with weight gain with a metabolic cause that needs checking do well once it's treated properly."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 285.77,
      "end_seconds": 312.26,
      "duration_seconds": 26.49,
      "text": "I think a sleep study makes sense here, for snoring and sleepiness. Start with small, specific changes: smaller portions, no sugary drinks, a thirty-minute walk most days. Please take the tablets with food so they don't upset your stomach. I'll also refer you to a dietitian. Please come and see me in six weeks."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 313.34,
      "end_seconds": 318.82,
      "duration_seconds": 5.48,
      "text": "Okay, so I'll make the appointment on my way out."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 320.27,
      "end_seconds": 322.29,
      "duration_seconds": 2.02,
      "text": "Do you have any questions?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 323.7,
      "end_seconds": 327.25,
      "duration_seconds": 3.55,
      "text": "One thing: no, actually that's all. Thanks."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 328.88,
      "end_seconds": 330.47,
      "duration_seconds": 1.59,
      "text": "Mind how you go."
    }
  ]
}