{
  "schema_version": "1.0",
  "encounter_id": "00173",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 0.95,
      "end_seconds": 5.88,
      "duration_seconds": 4.93,
      "text": "Doctor, I've brought them through. The observations are done, whenever you need them."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.58,
      "end_seconds": 10.82,
      "duration_seconds": 4.24,
      "text": "Thank you. Good morning, tell me what's been going on."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 11.58,
      "end_seconds": 16.85,
      "duration_seconds": 5.27,
      "text": "Hello, doctor. I hope it's alright if I stay in for this."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 18.85,
      "end_seconds": 22.18,
      "duration_seconds": 3.33,
      "text": "Good, that'll be useful. Pull up a chair."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 23.05,
      "end_seconds": 25.4,
      "duration_seconds": 2.35,
      "text": "I've been dealing with heartburn."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 26.0,
      "end_seconds": 31.13,
      "duration_seconds": 5.13,
      "text": "Okay, give me more detail on it, whatever comes to mind."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 33.09,
      "end_seconds": 46.23,
      "duration_seconds": 13.14,
      "text": "Maybe a five out of ten on a bad day. Antacids helps a bit. It happens a few times a day. It's worse with lying down and big meals."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 47.11,
      "end_seconds": 49.98,
      "duration_seconds": 2.87,
      "text": "Any food coming back up as well?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 51.84,
      "end_seconds": 62.1,
      "duration_seconds": 10.26,
      "text": "Yes, I have. With food coming back up, it's worse with bending over. Oh, and chest discomfort after eating."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 63.14,
      "end_seconds": 66.11,
      "duration_seconds": 2.97,
      "text": "Right, how intense does it get?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 67.79,
      "end_seconds": 77.66,
      "duration_seconds": 9.87,
      "text": "I'd call it severe. I mean, I did have a cough at night at one point, but that's gone now."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 78.54,
      "end_seconds": 83.34,
      "duration_seconds": 4.8,
      "text": "And what about black stools, vomiting blood, weight loss or anaemia?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 84.41,
      "end_seconds": 89.96,
      "duration_seconds": 5.55,
      "text": "No, no black stools, vomiting blood, weight loss or anaemia."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 91.04,
      "end_seconds": 95.0,
      "duration_seconds": 3.96,
      "text": "Alright, on the cardiac side, anything I should know?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 95.65,
      "end_seconds": 97.69,
      "duration_seconds": 2.04,
      "text": "No, that's been fine."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 107.03,
      "end_seconds": 109.79,
      "duration_seconds": 2.76,
      "text": "Now some background about your lifestyle."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 111.52,
      "end_seconds": 128.26,
      "duration_seconds": 16.74,
      "text": "I've never smoked. A beer or two most evenings, to be honest. Yes, I'm a nurse on a busy ward. Yes, I live on my own. I play badminton on Sundays."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 130.28,
      "end_seconds": 135.47,
      "duration_seconds": 5.19,
      "text": "Do you have any allergies to medicines, food, anything at all?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 136.02,
      "end_seconds": 138.67,
      "duration_seconds": 2.65,
      "text": "No, nothing I'm aware of."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 139.45,
      "end_seconds": 143.99,
      "duration_seconds": 4.54,
      "text": "Any medication at the moment, including things from the pharmacy?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 144.61,
      "end_seconds": 148.83,
      "duration_seconds": 4.22,
      "text": "I take amlodipine, 5 milligrams, once a day."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 150.73,
      "end_seconds": 156.96,
      "duration_seconds": 6.23,
      "text": "I mean, that's what's prescribed, but I'm not sure she takes it every day."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 158.07,
      "end_seconds": 167.71,
      "duration_seconds": 9.64,
      "text": "I take Seretide inhaler, twice a day for my asthma. Before this I was on losartan; that's been stopped."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 184.43,
      "end_seconds": 189.3,
      "duration_seconds": 4.87,
      "text": "Do you have any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 191.07,
      "end_seconds": 197.55,
      "duration_seconds": 6.48,
      "text": "Okay, so I've had high blood pressure, yes. I've, I've got acid reflux."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 198.3,
      "end_seconds": 199.12,
      "duration_seconds": 0.82,
      "text": "And then?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 199.97,
      "end_seconds": 204.14,
      "duration_seconds": 4.17,
      "text": "So, I have asthma, for five years."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 205.41,
      "end_seconds": 215.83,
      "duration_seconds": 10.42,
      "text": "Sure. Right, so high blood pressure is already on your record. We'll keep that in mind today. Have you had to have anything operated on?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 217.17,
      "end_seconds": 221.61,
      "duration_seconds": 4.44,
      "text": "Yes, I had my gallbladder removed, in 2016."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 223.01,
      "end_seconds": 227.6,
      "duration_seconds": 4.59,
      "text": "Any relatives with health problems I should be aware of?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 228.24,
      "end_seconds": 230.1,
      "duration_seconds": 1.86,
      "text": "My mother has diabetes."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 232.02,
      "end_seconds": 240.99,
      "duration_seconds": 8.97,
      "text": "Okay, so the vitals from earlier. Pulse is 84 beats a minute, pressure 124 over 76, saturation 97 percent."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 241.68,
      "end_seconds": 242.38,
      "duration_seconds": 0.7,
      "text": "Thanks."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 244.44,
      "end_seconds": 247.13,
      "duration_seconds": 2.69,
      "text": "Let's do the physical part now."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 248.42,
      "end_seconds": 251.57,
      "duration_seconds": 3.15,
      "text": "Okay, take your time, no rush."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 266.25,
      "end_seconds": 268.27,
      "duration_seconds": 2.02,
      "text": "Tummy is soft and non-tender."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 273.76,
      "end_seconds": 275.76,
      "duration_seconds": 2.0,
      "text": "Good, that's the examination."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 284.42,
      "end_seconds": 293.46,
      "duration_seconds": 9.04,
      "text": "Okay, so my impression is this: I'm honestly not certain yet. It could be gastro-oesophageal reflux, or it might be gastritis."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 297.59,
      "end_seconds": 303.6,
      "duration_seconds": 6.01,
      "text": "I've been thinking the worst, to be honest. Is it bad?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 304.26,
      "end_seconds": 317.39,
      "duration_seconds": 13.13,
      "text": "I can't promise yet, but most people with gastro-oesophageal reflux do well once it's treated properly. So, to recap quickly. You've had heartburn, and no black stools or anaemia."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 318.31,
      "end_seconds": 320.79,
      "duration_seconds": 2.48,
      "text": "Oh, that's what happened, yes."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 322.4,
      "end_seconds": 325.57,
      "duration_seconds": 3.17,
      "text": "We've already done an ECG this morning, doctor."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 326.43,
      "end_seconds": 350.98,
      "duration_seconds": 24.55,
      "text": "Right, thanks, I'll check it. I think an upper endoscopy makes sense here, for persistent reflux. It's a routine test and it'll give us a much clearer picture. Let's use esomeprazole, 40 milligrams, before breakfast, for eight weeks. You take it by mouth. That should help with reflux. It's a commonly used medicine and most people tolerate it well."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 354.7,
      "end_seconds": 358.85,
      "duration_seconds": 4.15,
      "text": "Should I keep taking it if I feel better?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 361.5,
      "end_seconds": 379.75,
      "duration_seconds": 18.25,
      "text": "Smaller dinners, earlier in the evening, and prop up the head of the bed with a couple of extra pillows. Don't skip meals, and try to eat smaller portions more often through the day. I'd like you back in eight weeks."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 381.44,
      "end_seconds": 384.14,
      "duration_seconds": 2.7,
      "text": "Good, I'll come back then."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 385.35,
      "end_seconds": 387.19,
      "duration_seconds": 1.84,
      "text": "Thanks for coming in."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 388.44,
      "end_seconds": 390.95,
      "duration_seconds": 2.51,
      "text": "Alright, thanks. Bye for now."
    }
  ]
}