{
  "schema_version": "1.0",
  "encounter_id": "00374",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.24,
      "end_seconds": 5.0,
      "duration_seconds": 3.76,
      "text": "Good morning. I hope the wait wasn't too long."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 6.69,
      "end_seconds": 9.88,
      "duration_seconds": 3.19,
      "text": "Thanks. Sorry, I'm a little early."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 11.9,
      "end_seconds": 13.9,
      "duration_seconds": 2.0,
      "text": "Okay. Start wherever you like."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 15.4,
      "end_seconds": 23.38,
      "duration_seconds": 7.98,
      "text": "So the thing is, I've got not being able to close my right eye fully."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 24.48,
      "end_seconds": 26.08,
      "duration_seconds": 1.6,
      "text": "When did it begin?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 26.95,
      "end_seconds": 29.84,
      "duration_seconds": 2.89,
      "text": "It's been like this since Monday."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 31.77,
      "end_seconds": 33.17,
      "duration_seconds": 1.4,
      "text": "Anything that helps?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 36.34,
      "end_seconds": 46.45,
      "duration_seconds": 10.11,
      "text": "Only eye drops, and it's not much. I've, I've also had my face drooping on the right side, since yesterday."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 65.1,
      "end_seconds": 69.01,
      "duration_seconds": 3.91,
      "text": "Have you noticed recent tick bite or headache?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 69.93,
      "end_seconds": 71.92,
      "duration_seconds": 1.99,
      "text": "No. None of those."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 72.62,
      "end_seconds": 74.84,
      "duration_seconds": 2.22,
      "text": "Is your chest okay generally?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 79.24,
      "end_seconds": 81.17,
      "duration_seconds": 1.93,
      "text": "No problems with breathing."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 82.75,
      "end_seconds": 87.54,
      "duration_seconds": 4.79,
      "text": "What about allergies, to medicines or foods or anything else?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 88.09,
      "end_seconds": 92.37,
      "duration_seconds": 4.28,
      "text": "Yes, pollen, it gives me a runny nose."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 93.33,
      "end_seconds": 94.5,
      "duration_seconds": 1.17,
      "text": "Any regular medication?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 96.52,
      "end_seconds": 97.64,
      "duration_seconds": 1.12,
      "text": "Nothing, no."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 98.87,
      "end_seconds": 102.82,
      "duration_seconds": 3.95,
      "text": "Anyone in the family with similar problems or other conditions?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 103.33,
      "end_seconds": 105.27,
      "duration_seconds": 1.94,
      "text": "My sister has epilepsy."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 106.62,
      "end_seconds": 109.55,
      "duration_seconds": 2.93,
      "text": "Now some background about your lifestyle."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 111.35,
      "end_seconds": 123.33,
      "duration_seconds": 11.98,
      "text": "No, I don't smoke and never have. I don't drink at all. Barely, I'm mostly sedentary these days. Yes, I live on my own."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 138.97,
      "end_seconds": 142.91,
      "duration_seconds": 3.94,
      "text": "Any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 143.69,
      "end_seconds": 146.86,
      "duration_seconds": 3.17,
      "text": "No, nothing, I've generally been healthy."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 148.01,
      "end_seconds": 151.31,
      "duration_seconds": 3.3,
      "text": "Before we go on, a few quick readings."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 158.42,
      "end_seconds": 159.33,
      "duration_seconds": 0.91,
      "text": "Almost there..."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 177.0,
      "end_seconds": 184.21,
      "duration_seconds": 7.21,
      "text": "Okay: BP is 116 over 69, heart rate 69, oxygen saturation is 98 percent, temperature 36.7."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 186.28,
      "end_seconds": 190.01,
      "duration_seconds": 3.73,
      "text": "Come over here and I'll have a look."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 190.86,
      "end_seconds": 195.98,
      "duration_seconds": 5.12,
      "text": "Alright, a little pressure here, tell me if it's tender."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 209.7,
      "end_seconds": 214.51,
      "duration_seconds": 4.81,
      "text": "You can't wrinkle the right forehead or puff out the right cheek."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 215.36,
      "end_seconds": 217.92,
      "duration_seconds": 2.56,
      "text": "Take your time, no rush."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 225.4,
      "end_seconds": 231.15,
      "duration_seconds": 5.75,
      "text": "Left side of the face moves normally, and arm and leg strength is normal."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 235.27,
      "end_seconds": 236.99,
      "duration_seconds": 1.72,
      "text": "Good, that's the examination."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 244.82,
      "end_seconds": 250.08,
      "duration_seconds": 5.26,
      "text": "Putting it all together, my working impression is a Bell's palsy pattern."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 251.34,
      "end_seconds": 254.97,
      "duration_seconds": 3.63,
      "text": "What are the chances it's something bad?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 259.41,
      "end_seconds": 267.1,
      "duration_seconds": 7.69,
      "text": "It's reasonable to be concerned, but right now a Bell's palsy pattern is my leading thought, not anything worse."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 276.15,
      "end_seconds": 281.01,
      "duration_seconds": 4.86,
      "text": "I think blood sugar testing makes sense here, for facial palsy."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 282.04,
      "end_seconds": 283.52,
      "duration_seconds": 1.48,
      "text": "That sounds sensible."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 285.21,
      "end_seconds": 293.28,
      "duration_seconds": 8.07,
      "text": "Let's use prednisolone, 50 milligrams, once a day, for seven days. That should help with facial weakness."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 296.8,
      "end_seconds": 297.87,
      "duration_seconds": 1.07,
      "text": "Mm, okay."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 299.13,
      "end_seconds": 319.27,
      "duration_seconds": 20.14,
      "text": "Use lubricating drops through the day and tape the eye shut at night. Don't skip meals, and try to eat smaller portions more often through the day. Please don't wait if the weakness spreads to your arm or leg, or your speech changes. That's when to be seen urgently."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 320.4,
      "end_seconds": 322.06,
      "duration_seconds": 1.66,
      "text": "Okay, fair enough."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 323.06,
      "end_seconds": 325.61,
      "duration_seconds": 2.55,
      "text": "We'll catch up in a week."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 326.77,
      "end_seconds": 328.58,
      "duration_seconds": 1.81,
      "text": "Sure, that's doable."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 329.66,
      "end_seconds": 331.84,
      "duration_seconds": 2.18,
      "text": "Right, that's all. Go gently."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 333.48,
      "end_seconds": 336.85,
      "duration_seconds": 3.37,
      "text": "No, you've explained it well. Thanks."
    }
  ]
}