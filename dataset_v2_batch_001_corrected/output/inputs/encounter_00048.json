{
  "schema_version": "1.0",
  "encounter_id": "00048",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.31,
      "end_seconds": 4.69,
      "duration_seconds": 3.38,
      "text": "Afternoon. Take the chair by the desk."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 5.23,
      "end_seconds": 8.85,
      "duration_seconds": 3.62,
      "text": "Hello, you know, doctor, thank you."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 10.69,
      "end_seconds": 12.76,
      "duration_seconds": 2.07,
      "text": "What brings you in today?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 13.72,
      "end_seconds": 18.51,
      "duration_seconds": 4.79,
      "text": "Doctor, it's a fever. It's getting on my nerves now."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 22.79,
      "end_seconds": 26.69,
      "duration_seconds": 3.9,
      "text": "Is this recent, or has it been a while?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 28.78,
      "end_seconds": 32.35,
      "duration_seconds": 3.57,
      "text": "Yesterday, it came on out of nowhere."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 33.63,
      "end_seconds": 36.19,
      "duration_seconds": 2.56,
      "text": "Is it mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 37.75,
      "end_seconds": 45.78,
      "duration_seconds": 8.03,
      "text": "Severe, I'd say. There's a blocked nose as well. As for blocked nose, severe, I'd say."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 55.82,
      "end_seconds": 58.49,
      "duration_seconds": 2.67,
      "text": "Any rash, vomiting or chest pain?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 59.72,
      "end_seconds": 61.53,
      "duration_seconds": 1.81,
      "text": "No. None of those."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 63.55,
      "end_seconds": 67.18,
      "duration_seconds": 3.63,
      "text": "Have you noticed diarrhoea or shortness of breath?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 67.79,
      "end_seconds": 69.38,
      "duration_seconds": 1.59,
      "text": "No, nothing there."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 70.88,
      "end_seconds": 73.06,
      "duration_seconds": 2.18,
      "text": "Is your mobility otherwise okay?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 78.02,
      "end_seconds": 79.52,
      "duration_seconds": 1.5,
      "text": "Nothing else aches."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 82.83,
      "end_seconds": 85.28,
      "duration_seconds": 2.45,
      "text": "Any rashes or skin problems otherwise?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 86.47,
      "end_seconds": 87.45,
      "duration_seconds": 0.98,
      "text": "No rashes."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 88.98,
      "end_seconds": 94.09,
      "duration_seconds": 5.11,
      "text": "Tell me about your routine, work, habits, that sort of thing."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 95.07,
      "end_seconds": 106.47,
      "duration_seconds": 11.4,
      "text": "I work on a farm, it's quite physical. I walk for about half an hour most days. I'm mostly vegetarian."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 120.35,
      "end_seconds": 124.65,
      "duration_seconds": 4.3,
      "text": "Moving on to your background, any past medical history?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 125.42,
      "end_seconds": 138.57,
      "duration_seconds": 13.15,
      "text": "I have high blood pressure. It's a relief to finally sit down and talk about it. I wasn't sure whether to come in at all, to be honest."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 140.34,
      "end_seconds": 141.85,
      "duration_seconds": 1.51,
      "text": "Right, any more?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 142.41,
      "end_seconds": 143.95,
      "duration_seconds": 1.54,
      "text": "I've got asthma."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 144.54,
      "end_seconds": 152.46,
      "duration_seconds": 7.92,
      "text": "Yes, asthma is known to us, good to have that clear. Do you have any known allergies at all?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 154.15,
      "end_seconds": 156.86,
      "duration_seconds": 2.71,
      "text": "Not that I know, no."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 158.39,
      "end_seconds": 161.93,
      "duration_seconds": 3.54,
      "text": "Let's go through your medication. What are you taking?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 163.71,
      "end_seconds": 176.94,
      "duration_seconds": 13.23,
      "text": "Telmisartan. I take it 40 milligrams, once a day. Seretide inhaler. I take it twice a day. Dolo, 650 milligrams, when I get the fever."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 177.58,
      "end_seconds": 180.41,
      "duration_seconds": 2.83,
      "text": "A few measurements, then we'll continue."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 193.42,
      "end_seconds": 195.35,
      "duration_seconds": 1.93,
      "text": "Hold still for me..."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 210.08,
      "end_seconds": 221.74,
      "duration_seconds": 11.66,
      "text": "Okay: temperature is 38.7 degrees, height 168 centimetres, pulse 88, BMI works out to 32.6, blood pressure 112 over 77, weight 92 kilos."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 223.45,
      "end_seconds": 226.1,
      "duration_seconds": 2.65,
      "text": "Okay, shall we do the examination?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 227.13,
      "end_seconds": 230.36,
      "duration_seconds": 3.23,
      "text": "Stay still while I have a look."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 245.19,
      "end_seconds": 250.62,
      "duration_seconds": 5.43,
      "text": "The glands in your neck feel a little tender but not big."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 251.45,
      "end_seconds": 253.51,
      "duration_seconds": 2.06,
      "text": "Take your time, no rush."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 271.4,
      "end_seconds": 275.37,
      "duration_seconds": 3.97,
      "text": "Chest is clear when I listen, no crackles."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 280.88,
      "end_seconds": 293.12,
      "duration_seconds": 12.24,
      "text": "That's all I need, thank you. Taking everything into account, it points towards a viral upper respiratory infection. An early bacterial throat infection is also on my list."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 294.62,
      "end_seconds": 297.45,
      "duration_seconds": 2.83,
      "text": "Should I be worried about this?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 298.74,
      "end_seconds": 307.09,
      "duration_seconds": 8.35,
      "text": "Nothing I've seen today points to an emergency. It looks like a viral upper respiratory infection, but I'd like to confirm."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 324.64,
      "end_seconds": 355.06,
      "duration_seconds": 30.42,
      "text": "I'm going to order a throat swab, for sore throat. Blood tests is what I'd like next, for fever. I'll start you on cetirizine, 10 milligrams, at night, for five days. You take it by mouth. It's for blocked nose. It's a commonly used medicine and most people tolerate it well. Stay home, rest, and keep the fluids up. Warm soups and water, anything that goes down easily."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 356.35,
      "end_seconds": 367.78,
      "duration_seconds": 11.43,
      "text": "If it hasn't settled in a month, we'd think about a flu swab, but not now. Come back if it's not settling in three days. Look after yourself."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 373.1,
      "end_seconds": 376.46,
      "duration_seconds": 3.36,
      "text": "I mean, all good here. Thank you."
    }
  ]
}