{
  "schema_version": "1.0",
  "encounter_id": "00294",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.5,
      "end_seconds": 9.17,
      "duration_seconds": 8.67,
      "text": "Come in, come in. Pull the door closed behind you, please. Tell me from the beginning, what's been happening?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 10.47,
      "end_seconds": 17.79,
      "duration_seconds": 7.32,
      "text": "Mainly a little chest discomfort. There's a couple of other things, but that's the main one."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 18.93,
      "end_seconds": 21.06,
      "duration_seconds": 2.13,
      "text": "Right, when did it begin?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 22.77,
      "end_seconds": 25.59,
      "duration_seconds": 2.82,
      "text": "It's been six months now."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 26.63,
      "end_seconds": 30.09,
      "duration_seconds": 3.46,
      "text": "Anything that tends to go along with it?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 31.79,
      "end_seconds": 45.56,
      "duration_seconds": 13.77,
      "text": "When it starts I tend to get a bit of dizziness with the new tablets as well. The bit of dizziness with the new tablets? That's been for four weeks."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 46.15,
      "end_seconds": 52.43,
      "duration_seconds": 6.28,
      "text": "A few quick ones: coughing up blood, bruising, palpitations or pain at rest?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 54.38,
      "end_seconds": 57.32,
      "duration_seconds": 2.94,
      "text": "No, I'd have mentioned it."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 59.28,
      "end_seconds": 62.34,
      "duration_seconds": 3.06,
      "text": "How are your bowels, any trouble?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 63.62,
      "end_seconds": 66.36,
      "duration_seconds": 2.74,
      "text": "No, that side's been fine."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 67.91,
      "end_seconds": 69.58,
      "duration_seconds": 1.67,
      "text": "Any sport or activity?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 70.45,
      "end_seconds": 73.28,
      "duration_seconds": 2.83,
      "text": "I play badminton on Sundays."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 76.61,
      "end_seconds": 78.98,
      "duration_seconds": 2.37,
      "text": "Is anyone at home with you?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 79.51,
      "end_seconds": 83.03,
      "duration_seconds": 3.52,
      "text": "I share a flat with two friends."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 95.68,
      "end_seconds": 98.2,
      "duration_seconds": 2.52,
      "text": "Are you on any regular medication?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 98.98,
      "end_seconds": 100.8,
      "duration_seconds": 1.82,
      "text": "No, nothing regular."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 108.94,
      "end_seconds": 112.88,
      "duration_seconds": 3.94,
      "text": "Moving on to your background, any past medical history?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 114.06,
      "end_seconds": 124.51,
      "duration_seconds": 10.45,
      "text": "I have heart disease, for about a year. I looked a few things up online, and that probably didn't help."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 126.34,
      "end_seconds": 129.6,
      "duration_seconds": 3.26,
      "text": "First the numbers, if you don't mind."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 139.0,
      "end_seconds": 140.86,
      "duration_seconds": 1.86,
      "text": "Hold still for me..."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 149.89,
      "end_seconds": 157.01,
      "duration_seconds": 7.12,
      "text": "Okay: pulse 69, oxygen saturation is 99 percent, respiratory rate 16. And BP is 125 over 70."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 159.01,
      "end_seconds": 160.97,
      "duration_seconds": 1.96,
      "text": "Is that alright, doctor?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 162.04,
      "end_seconds": 165.24,
      "duration_seconds": 3.2,
      "text": "We'll put it in context in a moment."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 168.24,
      "end_seconds": 171.11,
      "duration_seconds": 2.87,
      "text": "Let me examine, it won't take long."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 172.8,
      "end_seconds": 175.04,
      "duration_seconds": 2.24,
      "text": "Hold that position for me."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 193.8,
      "end_seconds": 197.12,
      "duration_seconds": 3.32,
      "text": "The scar on your chest has healed well."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 198.4,
      "end_seconds": 200.6,
      "duration_seconds": 2.2,
      "text": "Almost done with this part."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 214.4,
      "end_seconds": 217.59,
      "duration_seconds": 3.19,
      "text": "Chest is clear and heart sounds are normal."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 219.8,
      "end_seconds": 222.3,
      "duration_seconds": 2.5,
      "text": "All done, you can get dressed."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 237.65,
      "end_seconds": 245.89,
      "duration_seconds": 8.24,
      "text": "Let me tell you where I've got to. I'd lean towards stable recovery after the heart event."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 247.96,
      "end_seconds": 251.47,
      "duration_seconds": 3.51,
      "text": "What are the chances it's something bad?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 256.54,
      "end_seconds": 281.89,
      "duration_seconds": 25.35,
      "text": "I can't promise yet, but most people with stable recovery after the heart event do well once it's treated properly. I'm sending you for a lipid profile because of cardiovascular risk. It's a routine test and it'll give us a much clearer picture. I'm sending you for an echocardiogram because of follow-up. It's a routine test and it'll give us a much clearer picture."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 283.78,
      "end_seconds": 294.66,
      "duration_seconds": 10.88,
      "text": "The treatment will be atorvastatin, 40 milligrams, at night, long term. You take it by mouth. That should help with cardiovascular risk."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 296.09,
      "end_seconds": 299.69,
      "duration_seconds": 3.6,
      "text": "Is that safe with my other things?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 301.79,
      "end_seconds": 320.61,
      "duration_seconds": 18.82,
      "text": "Please don't stop the blood thinner on your own, even if you feel fine. Cardiac rehab is worth doing, it really helps your confidence. If the symptoms get worse, or you feel really unwell, please come to the emergency department."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 322.6,
      "end_seconds": 323.5,
      "duration_seconds": 0.9,
      "text": "That's clear."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 324.25,
      "end_seconds": 326.73,
      "duration_seconds": 2.48,
      "text": "Book a review in three months."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 327.8,
      "end_seconds": 329.28,
      "duration_seconds": 1.48,
      "text": "Sure, that's doable."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 330.09,
      "end_seconds": 331.52,
      "duration_seconds": 1.43,
      "text": "Look after yourself."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 332.36,
      "end_seconds": 336.71,
      "duration_seconds": 4.35,
      "text": "That's everything I wanted to ask. Thank you."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 338.04,
      "end_seconds": 339.21,
      "duration_seconds": 1.17,
      "text": "See you then."
    }
  ]
}