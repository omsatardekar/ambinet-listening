{
  "schema_version": "1.0",
  "encounter_id": "00477",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.4,
      "end_seconds": 5.28,
      "duration_seconds": 3.88,
      "text": "Hi, nice to see you. Sit down, please."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 7.12,
      "end_seconds": 8.09,
      "duration_seconds": 0.97,
      "text": "Hi. Thanks."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 10.0,
      "end_seconds": 14.41,
      "duration_seconds": 4.41,
      "text": "Good morning, doctor. I came along to help out."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 16.23,
      "end_seconds": 22.76,
      "duration_seconds": 6.53,
      "text": "That's fine, sit down. We'll go through it together. Did the receptionist sort you out quickly?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 28.41,
      "end_seconds": 31.61,
      "duration_seconds": 3.2,
      "text": "Yes, she was lovely about it."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 33.54,
      "end_seconds": 35.73,
      "duration_seconds": 2.19,
      "text": "So, how have things been?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 37.37,
      "end_seconds": 39.86,
      "duration_seconds": 2.49,
      "text": "I've been forgetting things lately."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 40.88,
      "end_seconds": 43.28,
      "duration_seconds": 2.4,
      "text": "I'll check your pressure and pulse."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 50.19,
      "end_seconds": 51.83,
      "duration_seconds": 1.64,
      "text": "Rest your hand here..."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 73.11,
      "end_seconds": 81.72,
      "duration_seconds": 8.61,
      "text": "Okay: BP is 118 over 73, respiratory rate 17, pulse is 82 beats a minute, temp 36.7 degrees."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 82.07,
      "end_seconds": 85.74,
      "duration_seconds": 3.67,
      "text": "Go on. Does it come along with anything else?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 87.45,
      "end_seconds": 103.2,
      "duration_seconds": 15.75,
      "text": "Right, when it starts I tend to get difficulty finding words as well. I was repeating the same questions at one point, but that's gone now."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 104.17,
      "end_seconds": 109.4,
      "duration_seconds": 5.23,
      "text": "A few quick ones: low mood, hallucinations or trouble with bladder control?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 110.19,
      "end_seconds": 116.99,
      "duration_seconds": 6.8,
      "text": "No low mood, hallucinations or trouble with bladder control, none of it."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 118.83,
      "end_seconds": 123.05,
      "duration_seconds": 4.22,
      "text": "Alright, have you noticed weakness on one side or falls?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 124.84,
      "end_seconds": 126.44,
      "duration_seconds": 1.6,
      "text": "No, nothing there."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 130.15,
      "end_seconds": 132.25,
      "duration_seconds": 2.1,
      "text": "Has there been any headache?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 134.22,
      "end_seconds": 137.38,
      "duration_seconds": 3.16,
      "text": "No, I haven't had any headache."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 138.19,
      "end_seconds": 145.23,
      "duration_seconds": 7.04,
      "text": "I mean, actually, doctor, I did notice headache. She doesn't always say."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 148.91,
      "end_seconds": 155.67,
      "duration_seconds": 6.76,
      "text": "No, I don't think I did. Maybe a little, I'm not sure."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 156.89,
      "end_seconds": 165.56,
      "duration_seconds": 8.67,
      "text": "Alright, I'll note both what you've said and what you've noticed. So, anything different when you pass water?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 167.6,
      "end_seconds": 170.68,
      "duration_seconds": 3.08,
      "text": "Nothing there, you know, no."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 172.46,
      "end_seconds": 174.5,
      "duration_seconds": 2.04,
      "text": "Is your chest okay generally?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 175.89,
      "end_seconds": 177.95,
      "duration_seconds": 2.06,
      "text": "No problems with breathing."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 178.75,
      "end_seconds": 180.94,
      "duration_seconds": 2.19,
      "text": "Any drug or food allergies?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 182.2,
      "end_seconds": 197.37,
      "duration_seconds": 15.17,
      "text": "Hmm, you know, there was some antibiotic, I was told I was allergic. But I couldn't tell you what it was called or what it did."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 198.08,
      "end_seconds": 202.38,
      "duration_seconds": 4.3,
      "text": "Anyone in the family with similar problems or other conditions?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 204.1,
      "end_seconds": 210.07,
      "duration_seconds": 5.97,
      "text": "My sister has thyroid problems. Hmm, my grandmother had breast cancer."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 211.26,
      "end_seconds": 216.37,
      "duration_seconds": 5.11,
      "text": "What about your general health, any conditions you're being treated for?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 216.89,
      "end_seconds": 226.42,
      "duration_seconds": 9.53,
      "text": "I mean, I've had high blood pressure, yes. I have diabetes, for five years. Yes, heart disease."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 227.79,
      "end_seconds": 230.22,
      "duration_seconds": 2.43,
      "text": "Have you had any surgery before?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 231.21,
      "end_seconds": 236.36,
      "duration_seconds": 5.15,
      "text": "Oh, just a bypass operation, six years ago."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 238.35,
      "end_seconds": 241.09,
      "duration_seconds": 2.74,
      "text": "Right, who do you live with?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 242.05,
      "end_seconds": 247.04,
      "duration_seconds": 4.99,
      "text": "I live with my family, my husband and two kids."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 247.65,
      "end_seconds": 249.34,
      "duration_seconds": 1.69,
      "text": "Any sport or activity?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 249.9,
      "end_seconds": 252.88,
      "duration_seconds": 2.98,
      "text": "I play badminton on Sundays."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 253.54,
      "end_seconds": 256.41,
      "duration_seconds": 2.87,
      "text": "What medicines do you take regularly?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 257.2,
      "end_seconds": 275.53,
      "duration_seconds": 18.33,
      "text": "It's losartan, 50 milligrams, once a day for my blood pressure, doctor. She is on Glycomet, 500 milligrams, twice a day, I give it to her. It's aspirin, once a day for my heart, doctor."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 277.33,
      "end_seconds": 279.88,
      "duration_seconds": 2.55,
      "text": "So, do you know the dose?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 281.79,
      "end_seconds": 283.29,
      "duration_seconds": 1.5,
      "text": "It's 75 milligrams."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 283.82,
      "end_seconds": 284.75,
      "duration_seconds": 0.93,
      "text": "I see."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 285.99,
      "end_seconds": 288.26,
      "duration_seconds": 2.27,
      "text": "Can I examine you now?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 289.44,
      "end_seconds": 291.01,
      "duration_seconds": 1.57,
      "text": "Let me press here."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 308.8,
      "end_seconds": 314.21,
      "duration_seconds": 5.41,
      "text": "Your gait is steady and the tone in your limbs is normal."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 317.19,
      "end_seconds": 319.49,
      "duration_seconds": 2.3,
      "text": "Okay, you can sit up."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 327.05,
      "end_seconds": 337.93,
      "duration_seconds": 10.88,
      "text": "So, based on the history and the examination, my working impression is memory difficulties that need to be worked up. We shouldn't forget a vitamin deficiency."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 350.27,
      "end_seconds": 353.44,
      "duration_seconds": 3.17,
      "text": "Any scans or blood work done already?"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 353.99,
      "end_seconds": 363.57,
      "duration_seconds": 9.58,
      "text": "I mean, I did have blood tests done a few months ago, but the paper's at home."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 365.01,
      "end_seconds": 370.52,
      "duration_seconds": 5.51,
      "text": "I'd like to arrange a CT scan of the head for memory loss."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 372.22,
      "end_seconds": 373.56,
      "duration_seconds": 1.34,
      "text": "Mm, okay."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 375.22,
      "end_seconds": 405.77,
      "duration_seconds": 30.55,
      "text": "Let's book a vitamin B12 level to look into memory loss. I'd rather check than guess, and this is the quickest way to know more. Keep a daily routine and write things down, a notebook by the door works well. I'm going to send a referral to the memory clinic. If the symptoms get worse, or you feel really unwell, please come to the emergency department. Alright, I'll see you out."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 407.01,
      "end_seconds": 409.4,
      "duration_seconds": 2.39,
      "text": "I appreciate it, doctor."
    }
  ]
}