{
  "schema_version": "1.0",
  "encounter_id": "00216",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.79,
      "end_seconds": 2.54,
      "duration_seconds": 1.75,
      "text": "Morning! Make yourself comfortable."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 3.41,
      "end_seconds": 6.26,
      "duration_seconds": 2.85,
      "text": "Thanks. Sorry, I'm a little early."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 7.03,
      "end_seconds": 9.92,
      "duration_seconds": 2.89,
      "text": "Okay, have you been waiting long?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 10.74,
      "end_seconds": 13.97,
      "duration_seconds": 3.23,
      "text": "Only about ten minutes, no trouble."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 15.43,
      "end_seconds": 17.42,
      "duration_seconds": 1.99,
      "text": "Right, what's the trouble?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 18.16,
      "end_seconds": 22.92,
      "duration_seconds": 4.76,
      "text": "I've been dealing with cramping pain in the lower tummy."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 24.91,
      "end_seconds": 27.26,
      "duration_seconds": 2.35,
      "text": "How far back does it go?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 32.26,
      "end_seconds": 36.73,
      "duration_seconds": 4.47,
      "text": "It's been nearly five years, I'm fairly sure."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 38.21,
      "end_seconds": 41.39,
      "duration_seconds": 3.18,
      "text": "Have you been passing a lot of wind?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 46.42,
      "end_seconds": 49.76,
      "duration_seconds": 3.34,
      "text": "Yes, about the same, three weeks."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 50.84,
      "end_seconds": 54.64,
      "duration_seconds": 3.8,
      "text": "On a normal day, how strong is it?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 56.48,
      "end_seconds": 60.14,
      "duration_seconds": 3.66,
      "text": "A seven out of ten, I suppose."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 61.52,
      "end_seconds": 68.39,
      "duration_seconds": 6.87,
      "text": "Have you had cramping pain in the lower tummy before, or is this the first time?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 69.98,
      "end_seconds": 75.56,
      "duration_seconds": 5.58,
      "text": "A bit, last year. It settled by itself back then."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 76.62,
      "end_seconds": 82.29,
      "duration_seconds": 5.67,
      "text": "Alright, do you have any allergies to medicines, food, anything at all?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 84.08,
      "end_seconds": 91.77,
      "duration_seconds": 7.69,
      "text": "Years back I got wheezing from aspirin, so I stay away from it now."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 93.82,
      "end_seconds": 97.72,
      "duration_seconds": 3.9,
      "text": "Do your parents or siblings have any long-term illnesses?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 99.82,
      "end_seconds": 102.1,
      "duration_seconds": 2.28,
      "text": "My father had kidney stones."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 104.11,
      "end_seconds": 105.32,
      "duration_seconds": 1.21,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 106.61,
      "end_seconds": 108.43,
      "duration_seconds": 1.82,
      "text": "No operations, no."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 110.38,
      "end_seconds": 112.06,
      "duration_seconds": 1.68,
      "text": "And alcohol, how much?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 113.66,
      "end_seconds": 118.72,
      "duration_seconds": 5.06,
      "text": "A beer or two most evenings, to be honest."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 119.91,
      "end_seconds": 121.2,
      "duration_seconds": 1.29,
      "text": "How about smoking?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 122.55,
      "end_seconds": 123.98,
      "duration_seconds": 1.43,
      "text": "I've never smoked."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 125.52,
      "end_seconds": 127.55,
      "duration_seconds": 2.03,
      "text": "Who do you live with?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 129.49,
      "end_seconds": 134.41,
      "duration_seconds": 4.92,
      "text": "I live with my family, my husband and two kids."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 136.45,
      "end_seconds": 139.34,
      "duration_seconds": 2.89,
      "text": "Right, do you have a job?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 140.49,
      "end_seconds": 142.48,
      "duration_seconds": 1.99,
      "text": "I'm a self-employed electrician."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 144.05,
      "end_seconds": 146.97,
      "duration_seconds": 2.92,
      "text": "What do you do to keep active?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 148.7,
      "end_seconds": 151.74,
      "duration_seconds": 3.04,
      "text": "I cycle to work most mornings."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 152.87,
      "end_seconds": 155.59,
      "duration_seconds": 2.72,
      "text": "Are you on any tablets or medication?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 156.13,
      "end_seconds": 158.48,
      "duration_seconds": 2.35,
      "text": "Escitalopram, once a day."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 160.24,
      "end_seconds": 162.6,
      "duration_seconds": 2.36,
      "text": "Do you know the dose?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 163.37,
      "end_seconds": 167.91,
      "duration_seconds": 4.54,
      "text": "10 milligrams, I think that's what's on the box."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 171.09,
      "end_seconds": 173.88,
      "duration_seconds": 2.79,
      "text": "Is there anything medical in your background?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 175.03,
      "end_seconds": 176.12,
      "duration_seconds": 1.09,
      "text": "Yes, anxiety."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 177.83,
      "end_seconds": 178.53,
      "duration_seconds": 0.7,
      "text": "Yes?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 179.37,
      "end_seconds": 185.07,
      "duration_seconds": 5.7,
      "text": "Okay, yes, anxiety is known to us, good to have that clear."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 195.21,
      "end_seconds": 202.68,
      "duration_seconds": 7.47,
      "text": "A few quick ones: family history of bowel cancer, weight loss, anaemia or blood in the stool?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 203.66,
      "end_seconds": 205.92,
      "duration_seconds": 2.26,
      "text": "Nothing like that, no."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 207.37,
      "end_seconds": 209.37,
      "duration_seconds": 2.0,
      "text": "Has there been any fever?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 210.1,
      "end_seconds": 213.46,
      "duration_seconds": 3.36,
      "text": "So, I haven't noticed any fever."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 214.57,
      "end_seconds": 217.94,
      "duration_seconds": 3.37,
      "text": "On the cardiac side, anything I should know?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 218.88,
      "end_seconds": 221.27,
      "duration_seconds": 2.39,
      "text": "No, nothing with my heart."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 239.58,
      "end_seconds": 249.68,
      "duration_seconds": 10.1,
      "text": "Here are the numbers, doctor. Temperature is 36.5 degrees, pressure 112 over 80, pulse 66. Respiratory rate 16, saturation 99 percent."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 251.43,
      "end_seconds": 252.33,
      "duration_seconds": 0.9,
      "text": "Right, thanks."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 254.1,
      "end_seconds": 257.6,
      "duration_seconds": 3.5,
      "text": "Okay, I need to examine you for this."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 258.89,
      "end_seconds": 259.92,
      "duration_seconds": 1.03,
      "text": "Mm, okay."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 261.49,
      "end_seconds": 263.97,
      "duration_seconds": 2.48,
      "text": "Just relax, I'll be quick."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 280.51,
      "end_seconds": 285.53,
      "duration_seconds": 5.02,
      "text": "Soft tummy, a bit tender on the left lower side, no masses."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 290.33,
      "end_seconds": 300.96,
      "duration_seconds": 10.63,
      "text": "Okay, you can sit up. So where does that leave us? This is probably irritable bowel syndrome as a working diagnosis. A food intolerance is still possible."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 302.0,
      "end_seconds": 304.85,
      "duration_seconds": 2.85,
      "text": "Is this going to go away?"
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 306.37,
      "end_seconds": 318.1,
      "duration_seconds": 11.73,
      "text": "I understand the worry. At the moment I'd say it's irritable bowel syndrome as a working diagnosis, and we'll know more once the a coeliac test is back."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 332.7,
      "end_seconds": 336.95,
      "duration_seconds": 4.25,
      "text": "I'm going to order a coeliac test, for bloating."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 337.71,
      "end_seconds": 339.25,
      "duration_seconds": 1.54,
      "text": "That sounds sensible."
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 341.16,
      "end_seconds": 359.98,
      "duration_seconds": 18.82,
      "text": "For this, mebeverine, 135 milligrams, three times a day, for four weeks. That should help with abdominal cramps. Note down what you ate before the bad days, it often reveals a pattern. Come back in six weeks. Any last questions?"
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 360.93,
      "end_seconds": 363.78,
      "duration_seconds": 2.85,
      "text": "Nothing more from me, thanks."
    }
  ]
}