  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.86,
      "end_seconds": 7.68,
      "duration_seconds": 6.82,
      "text": "Doctor, um, hello, I've got my papers here, where should I put them?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 13.54,
      "end_seconds": 17.68,
      "duration_seconds": 4.14,
      "text": "Right on time. Sit, please. How can I help?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 19.03,
      "end_seconds": 28.96,
      "duration_seconds": 9.93,
      "text": "Oh, honestly, it's tight shoes by the end of the day, and my family pushed me to come."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 30.71,
      "end_seconds": 33.76,
      "duration_seconds": 3.05,
      "text": "How long has this been going on?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 34.6,
      "end_seconds": 43.09,
      "duration_seconds": 8.49,
      "text": "Ever since... since yesterday, really. I wasn't sure whether to come in at all, to be honest."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 44.39,
      "end_seconds": 54.9,
      "duration_seconds": 10.51,
      "text": "Tell me a bit more about it: how bad it gets, how often, and whether anything makes it better or worse."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 56.28,
      "end_seconds": 59.53,
      "duration_seconds": 3.25,
      "text": "I'd say moderate. It's every other day."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 60.03,
      "end_seconds": 63.24,
      "duration_seconds": 3.21,
      "text": "Have you had a flushed face sometimes?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 64.2,
      "end_seconds": 70.92,
      "duration_seconds": 6.72,
      "text": "Yes, for ten days. About flushed face sometimes, it happens on and off."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 74.09,
      "end_seconds": 77.39,
      "duration_seconds": 3.3,
      "text": "Did you get chest pain or weight gain?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 78.75,
      "end_seconds": 81.76,
      "duration_seconds": 3.01,
      "text": "Yeah, no, not any of them."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 82.19,
      "end_seconds": 86.89,
      "duration_seconds": 4.7,
      "text": "Understood. Did you get reduced urine or breathlessness lying flat?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 87.69,
      "end_seconds": 90.17,
      "duration_seconds": 2.48,
      "text": "No, not any of them."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 91.65,
      "end_seconds": 94.57,
      "duration_seconds": 2.92,
      "text": "How are your joints, any aches elsewhere?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 95.84,
      "end_seconds": 97.25,
      "duration_seconds": 1.41,
      "text": "Nothing else aches."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 99.23,
      "end_seconds": 103.09,
      "duration_seconds": 3.86,
      "text": "Any pins and needles or loss of strength anywhere?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 104.04,
      "end_seconds": 105.45,
      "duration_seconds": 1.41,
      "text": "Nothing odd there."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 109.04,
      "end_seconds": 111.51,
      "duration_seconds": 2.47,
      "text": "Anything special about your diet?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 112.17,
      "end_seconds": 115.58,
      "duration_seconds": 3.41,
      "text": "I try to avoid too much sugar."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 116.1,
      "end_seconds": 118.17,
      "duration_seconds": 2.07,
      "text": "Are you active at all?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 119.15,
      "end_seconds": 122.28,
      "duration_seconds": 3.13,
      "text": "Barely, I'm mostly sedentary these days."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 124.2,
      "end_seconds": 125.66,
      "duration_seconds": 1.46,
      "text": "What's your job?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 127.03,
      "end_seconds": 130.15,
      "duration_seconds": 3.12,
      "text": "I teach at a primary school."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 132.09,
      "end_seconds": 138.21,
      "duration_seconds": 6.12,
      "text": "Any allergies I should know about? Bear with me, I'm just building up the picture."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 138.74,
      "end_seconds": 142.32,
      "duration_seconds": 3.58,
      "text": "I don't have any known medication allergies."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 143.51,
      "end_seconds": 147.78,
      "duration_seconds": 4.27,
      "text": "Which tablets or creams or inhalers do you use?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 148.69,
      "end_seconds": 152.04,
      "duration_seconds": 3.35,
      "text": "Losartan, 50 milligrams, once a day."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 152.7,
      "end_seconds": 155.55,
      "duration_seconds": 2.85,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 156.44,
      "end_seconds": 159.83,
      "duration_seconds": 3.39,
      "text": "No, um, nothing like that."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 171.7,
      "end_seconds": 175.58,
      "duration_seconds": 3.88,
      "text": "Any long-term health problems I should know about?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 180.05,
      "end_seconds": 185.29,
      "duration_seconds": 5.24,
      "text": "Yeah, I have high blood pressure, for about ten years."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 186.98,
      "end_seconds": 188.6,
      "duration_seconds": 1.62,
      "text": "Let's do your observations."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 199.69,
      "end_seconds": 200.56,
      "duration_seconds": 0.87,
      "text": "One second..."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 221.15,
      "end_seconds": 232.8,
      "duration_seconds": 11.65,
      "text": "Okay: heart rate 81, BMI works out to 33.8, height 165 centimetres. And temperature 36.8, weight 92 kilos, pressure 156 over 94."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 236.37,
      "end_seconds": 237.87,
      "duration_seconds": 1.5,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 242.75,
      "end_seconds": 247.15,
      "duration_seconds": 4.4,
      "text": "They help build the picture, I'll tell you more soon."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 249.25,
      "end_seconds": 252.58,
      "duration_seconds": 3.33,
      "text": "Come over here and I'll have a look."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 253.89,
      "end_seconds": 255.96,
      "duration_seconds": 2.07,
      "text": "Bear with me a second."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 273.52,
      "end_seconds": 278.04,
      "duration_seconds": 4.52,
      "text": "Mild pitting swelling around both ankles, equal on both sides."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 281.85,
      "end_seconds": 283.04,
      "duration_seconds": 1.19,
      "text": "Thanks for that."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 301.9,
      "end_seconds": 315.76,
      "duration_seconds": 13.86,
      "text": "So, based on the history and the examination, it's hard to say. Ankle swelling possibly from a blood pressure tablet is one possibility and heart-related fluid retention another, and I'd rather not commit yet."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 317.44,
      "end_seconds": 320.17,
      "duration_seconds": 2.73,
      "text": "Is this going to go away?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 321.33,
      "end_seconds": 341.6,
      "duration_seconds": 20.27,
      "text": "I understand the worry. At the moment I'd say it's ankle swelling possibly from a blood pressure tablet, and we'll watch how it goes. For now, no new medicines or tests are needed. Okay, I think we're finished. Is everything clear?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 342.81,
      "end_seconds": 346.67,
      "duration_seconds": 3.86,
      "text": "One thing: no, actually that's all. Thanks."
    }
  ]
}