{
  "schema_version": "1.0",
  "encounter_id": "00016",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.86,
      "end_seconds": 6.18,
      "duration_seconds": 5.32,
      "text": "good afternoon, doctor, the receptionist said you'd see me now"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 11.2,
      "end_seconds": 14.55,
      "duration_seconds": 3.35,
      "text": "Yes, do sit. Tell me what's been happening."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 15.16,
      "end_seconds": 20.81,
      "duration_seconds": 5.65,
      "text": "Mainly I've been feeling very thirsty. That's why I came."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 21.59,
      "end_seconds": 23.88,
      "duration_seconds": 2.29,
      "text": "And when did that start?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 24.82,
      "end_seconds": 28.68,
      "duration_seconds": 3.86,
      "text": "Yeah, for about a week, I'd say."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 29.03,
      "end_seconds": 32.91,
      "duration_seconds": 3.88,
      "text": "Mm. Any itching around the private area as well?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 34.2,
      "end_seconds": 46.57,
      "duration_seconds": 12.37,
      "text": "yeah. About two weeks, I'd say i've also been going to the toilet a lot, even at night, for about a month"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 47.57,
      "end_seconds": 49.14,
      "duration_seconds": 1.57,
      "text": "Do you drink alcohol?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 50.83,
      "end_seconds": 55.72,
      "duration_seconds": 4.89,
      "text": "I have a couple of drinks on the weekend."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 57.06,
      "end_seconds": 57.86,
      "duration_seconds": 0.8,
      "text": "Any smoking?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 59.71,
      "end_seconds": 63.29,
      "duration_seconds": 3.58,
      "text": "I stopped smoking about two years back."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 65.06,
      "end_seconds": 66.36,
      "duration_seconds": 1.3,
      "text": "how about exercise?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 68.36,
      "end_seconds": 71.99,
      "duration_seconds": 3.63,
      "text": "Not really, I don't get much exercise."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 72.57,
      "end_seconds": 74.52,
      "duration_seconds": 1.95,
      "text": "Tell me about your work."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 75.49,
      "end_seconds": 80.91,
      "duration_seconds": 5.42,
      "text": "I'm a software engineer, so I'm at a screen all day."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 82.15,
      "end_seconds": 86.85,
      "duration_seconds": 4.7,
      "text": "Anyone in the family with similar problems or other conditions?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 87.85,
      "end_seconds": 89.65,
      "duration_seconds": 1.8,
      "text": "My mother has migraines."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 106.61,
      "end_seconds": 113.17,
      "duration_seconds": 6.56,
      "text": "Right, any diagnoses you've been given before? I ask because it helps me narrow things down."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 116.9,
      "end_seconds": 120.4,
      "duration_seconds": 3.5,
      "text": "An underactive thyroid, for five years."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 131.28,
      "end_seconds": 135.77,
      "duration_seconds": 4.49,
      "text": "what about allergies, to medicines or foods or anything else?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 136.73,
      "end_seconds": 142.31,
      "duration_seconds": 5.58,
      "text": "not currently, but as a youngster aspirin gave me a rash"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 143.59,
      "end_seconds": 147.27,
      "duration_seconds": 3.68,
      "text": "Let's go through your medication. What are you taking?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 148.78,
      "end_seconds": 152.26,
      "duration_seconds": 3.48,
      "text": "I take Thyronorm, 50 micrograms, every morning."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 153.78,
      "end_seconds": 155.24,
      "duration_seconds": 1.46,
      "text": "Is that long-standing?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 156.84,
      "end_seconds": 158.24,
      "duration_seconds": 1.4,
      "text": "Six months now."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 160.0,
      "end_seconds": 162.84,
      "duration_seconds": 2.84,
      "text": "Okay, any surgery in your history?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 163.95,
      "end_seconds": 167.34,
      "duration_seconds": 3.39,
      "text": "Just a C-section, about ten years ago."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 168.4,
      "end_seconds": 173.65,
      "duration_seconds": 5.25,
      "text": "Right, did you get blurred vision or fruity smell on the breath?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 174.35,
      "end_seconds": 179.99,
      "duration_seconds": 5.64,
      "text": "No blurred vision or fruity smell on the breath, none of it."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 180.69,
      "end_seconds": 184.1,
      "duration_seconds": 3.41,
      "text": "Did you get breathlessness or abdominal pain?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 185.33,
      "end_seconds": 187.93,
      "duration_seconds": 2.6,
      "text": "No, I'd have mentioned it."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 189.89,
      "end_seconds": 194.56,
      "duration_seconds": 4.67,
      "text": "Any change in your bowel habit or your stomach generally?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 195.63,
      "end_seconds": 197.63,
      "duration_seconds": 2.0,
      "text": "no, all normal there"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 210.08,
      "end_seconds": 213.03,
      "duration_seconds": 2.95,
      "text": "First the numbers, if you don't mind."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 224.4,
      "end_seconds": 226.19,
      "duration_seconds": 1.79,
      "text": "just relax your arm.."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 240.53,
      "end_seconds": 250.2,
      "duration_seconds": 9.67,
      "text": "Okay: pressure 122 over 76, weight 59 kilos. And height 185 centimetres, temp 36.7 degrees, pulse is 73 beats a minute."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 251.62,
      "end_seconds": 255.08,
      "duration_seconds": 3.46,
      "text": "Right, let me check a few things physically."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 255.65,
      "end_seconds": 256.64,
      "duration_seconds": 0.99,
      "text": "That's fine."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 257.46,
      "end_seconds": 259.96,
      "duration_seconds": 2.5,
      "text": "Take your time, no rush."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 272.06,
      "end_seconds": 274.94,
      "duration_seconds": 2.88,
      "text": "Your tummy is soft and non-tender."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 280.91,
      "end_seconds": 289.72,
      "duration_seconds": 8.81,
      "text": "Thanks for that. Okay, so my impression is this: My working impression is possible new-onset diabetes. We shouldn't forget diabetes insipidus."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 291.51,
      "end_seconds": 294.14,
      "duration_seconds": 2.63,
      "text": "Is it something serious, doctor?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 294.94,
      "end_seconds": 329.1,
      "duration_seconds": 34.16,
      "text": "I can't promise yet, but most people with possible new-onset diabetes do well once it's treated properly. Let's get an HbA1c, for possible diabetes. It's a routine test and it'll give us a much clearer picture. Until we have the results, avoid sugary drinks and fruit juices, and keep drinking plain water. Let's hold off on a urine test for now, and if there's no change next month we can revisit it."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 330.87,
      "end_seconds": 338.54,
      "duration_seconds": 7.67,
      "text": "If you start vomiting or become drowsy, or you feel really unwell, please come to the emergency department."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 339.21,
      "end_seconds": 341.47,
      "duration_seconds": 2.26,
      "text": "Got it, thank you."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 342.02,
      "end_seconds": 345.38,
      "duration_seconds": 3.36,
      "text": "Is there anything you wanted to ask?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 346.77,
      "end_seconds": 348.35,
      "duration_seconds": 1.58,
      "text": "Right. Thanks again."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 350.15,
      "end_seconds": 352.04,
      "duration_seconds": 1.89,
      "text": "mind how you go"
    }
  ]
}