{
  "schema_version": "1.0",
  "encounter_id": "00192",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.75,
      "end_seconds": 6.25,
      "duration_seconds": 5.5,
      "text": "Good afternoon, doctor, the receptionist said you'd see me now."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.18,
      "end_seconds": 10.65,
      "duration_seconds": 3.47,
      "text": "Yes, do sit. Tell me what's been happening."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 13.8,
      "end_seconds": 24.19,
      "duration_seconds": 10.39,
      "text": "Uh, mainly scaly, peeling skin. There's a couple of other things, but that's the main one."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 25.06,
      "end_seconds": 27.56,
      "duration_seconds": 2.5,
      "text": "Since when have you had this?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 28.23,
      "end_seconds": 31.29,
      "duration_seconds": 3.06,
      "text": "It's, It's been two days now."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 32.85,
      "end_seconds": 37.0,
      "duration_seconds": 4.15,
      "text": "How would you describe it, mild, moderate, severe?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 38.43,
      "end_seconds": 46.85,
      "duration_seconds": 8.42,
      "text": "Pretty moderate, if I'm being honest. I've had itching in the groin too, for five days."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 51.25,
      "end_seconds": 55.33,
      "duration_seconds": 4.08,
      "text": "And what about pain, rash on the palms or fever?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 56.54,
      "end_seconds": 64.05,
      "duration_seconds": 7.51,
      "text": "Hmm, I haven't had pain, rash on the palms or fever, no."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 65.13,
      "end_seconds": 67.1,
      "duration_seconds": 1.97,
      "text": "What about new partner?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 68.36,
      "end_seconds": 72.37,
      "duration_seconds": 4.01,
      "text": "Uh, not at all, no new partner."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 72.78,
      "end_seconds": 75.45,
      "duration_seconds": 2.67,
      "text": "Sure. Anything unusual with passing urine?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 76.72,
      "end_seconds": 79.91,
      "duration_seconds": 3.19,
      "text": "I mean, no, that's all fine."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 81.78,
      "end_seconds": 84.09,
      "duration_seconds": 2.31,
      "text": "Is your digestion otherwise okay?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 84.79,
      "end_seconds": 86.73,
      "duration_seconds": 1.94,
      "text": "Nothing unusual, no."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 98.33,
      "end_seconds": 103.03,
      "duration_seconds": 4.7,
      "text": "Anyone in the family with similar problems or other conditions?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 104.04,
      "end_seconds": 107.2,
      "duration_seconds": 3.16,
      "text": "Uh, my brother has asthma."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 109.23,
      "end_seconds": 113.65,
      "duration_seconds": 4.42,
      "text": "Any medication at the moment, including things from the pharmacy?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 115.64,
      "end_seconds": 124.84,
      "duration_seconds": 9.2,
      "text": "Glimepiride. I take it 2 milligrams, before breakfast for my sugar. Aspirin, 75 milligrams, once a day."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 126.53,
      "end_seconds": 128.87,
      "duration_seconds": 2.34,
      "text": "Now some background about your lifestyle."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 131.94,
      "end_seconds": 149.99,
      "duration_seconds": 18.05,
      "text": "I've never smoked. A beer or two most evenings, to be honest. I go to the gym a couple of times a week. I share a flat with two friends. I'm mostly vegetarian."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 160.76,
      "end_seconds": 167.86,
      "duration_seconds": 7.1,
      "text": "Tell me about your health in general, any ongoing conditions? Just so I get the full picture."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 168.69,
      "end_seconds": 181.16,
      "duration_seconds": 12.47,
      "text": "I've had diabetes, yes. I'd rather know what's going on than keep guessing. I mean, I have heart disease, for about ten years."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 182.4,
      "end_seconds": 190.26,
      "duration_seconds": 7.86,
      "text": "Okay, I can see heart disease in your file as well. Any drug or food allergies?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 195.37,
      "end_seconds": 196.43,
      "duration_seconds": 1.06,
      "text": "No allergies."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 214.37,
      "end_seconds": 217.09,
      "duration_seconds": 2.72,
      "text": "Let me check your vitals now."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 225.22,
      "end_seconds": 226.09,
      "duration_seconds": 0.87,
      "text": "Almost there..."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 238.81,
      "end_seconds": 251.34,
      "duration_seconds": 12.53,
      "text": "Okay: height 182 centimetres, BMI works out to 18.1. And saturation 97 percent, heart rate 76, weight 60 kilos, BP is 108 over 80."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 254.25,
      "end_seconds": 256.77,
      "duration_seconds": 2.52,
      "text": "Okay, a quick examination now."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 258.47,
      "end_seconds": 262.38,
      "duration_seconds": 3.91,
      "text": "A little pressure here, tell me if it's tender."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 276.1,
      "end_seconds": 279.34,
      "duration_seconds": 3.24,
      "text": "Skin between the toes is white and peeling."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 280.42,
      "end_seconds": 282.82,
      "duration_seconds": 2.4,
      "text": "Tell me if anything hurts."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 291.27,
      "end_seconds": 297.5,
      "duration_seconds": 6.23,
      "text": "There's a red ring-shaped scaly patch with a clearer centre in the groin crease."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 301.36,
      "end_seconds": 314.16,
      "duration_seconds": 12.8,
      "text": "Okay, you can sit up. Having listened and examined, I'd lean towards a fungal skin infection. I want a skin scraping done, that's for suspected fungal infection."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 314.98,
      "end_seconds": 319.16,
      "duration_seconds": 4.18,
      "text": "I can book that for Monday at 11:30 am."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 319.95,
      "end_seconds": 321.17,
      "duration_seconds": 1.22,
      "text": "That's fine."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 322.76,
      "end_seconds": 342.58,
      "duration_seconds": 19.82,
      "text": "I'm going to put you on terbinafine cream, once a day, for two weeks. That should help with fungal infection. Keep the area dry, wear loose cotton, and don't share towels. Come back or go to emergency straight away if the symptoms get worse."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 344.41,
      "end_seconds": 346.87,
      "duration_seconds": 2.46,
      "text": "Got it, thank you."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 348.18,
      "end_seconds": 351.55,
      "duration_seconds": 3.37,
      "text": "Call the clinic if you need us."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 352.72,
      "end_seconds": 354.96,
      "duration_seconds": 2.24,
      "text": "Thanks, that was helpful."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 356.75,
      "end_seconds": 357.56,
      "duration_seconds": 0.81,
      "text": "Take care."
    }
  ]
}