  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.17,
      "end_seconds": 8.43,
      "duration_seconds": 7.26,
      "text": "I mean doctor hello I've got my papers here where should I put them?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 10.41,
      "end_seconds": 16.27,
      "duration_seconds": 5.86,
      "text": "yes, come in, take a seat what can I do for you today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 16.96,
      "end_seconds": 19.96,
      "duration_seconds": 3.0,
      "text": "it's headaches in the mornings, mostly"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 21.08,
      "end_seconds": 23.2,
      "duration_seconds": 2.12,
      "text": "And when did that start?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 24.35,
      "end_seconds": 27.19,
      "duration_seconds": 2.84,
      "text": "I've had it for two months."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 27.87,
      "end_seconds": 36.48,
      "duration_seconds": 8.61,
      "text": "can you describe it a bit more for me? How strong it is, what the pattern is, what helps"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 37.17,
      "end_seconds": 44.21,
      "duration_seconds": 7.04,
      "text": "okay so it happens a few times a day. I'd call it mild"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 45.36,
      "end_seconds": 50.22,
      "duration_seconds": 4.86,
      "text": "What about a ringing in the ears, have you noticed that?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 52.3,
      "end_seconds": 55.26,
      "duration_seconds": 2.96,
      "text": "yes, about the same, three weeks"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 55.82,
      "end_seconds": 59.83,
      "duration_seconds": 4.01,
      "text": "What's the pattern, is it there all day?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 61.63,
      "end_seconds": 65.07,
      "duration_seconds": 3.44,
      "text": "honestly, a couple of times a week"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 66.33,
      "end_seconds": 72.77,
      "duration_seconds": 6.44,
      "text": "Have you had headaches in the mornings before or is this the first time?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 73.71,
      "end_seconds": 79.2,
      "duration_seconds": 5.49,
      "text": "a a bit, last winter it settled by itself back then"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 80.06,
      "end_seconds": 82.97,
      "duration_seconds": 2.91,
      "text": "so, what medicines do you take regularly?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 84.89,
      "end_seconds": 90.69,
      "duration_seconds": 5.8,
      "text": "It's telmisartan, 40 milligrams, once a day for my pressure."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 92.42,
      "end_seconds": 96.04,
      "duration_seconds": 3.62,
      "text": "any long-term health problems I should know about?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 97.55,
      "end_seconds": 105.02,
      "duration_seconds": 7.47,
      "text": "I've got high blood pressure. A neighbour of mine said I should see someone about it."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 106.2,
      "end_seconds": 116.96,
      "duration_seconds": 10.76,
      "text": "okay, I can see high blood pressure in your file as well what about family history, any illnesses that run in the the family?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 118.23,
      "end_seconds": 121.05,
      "duration_seconds": 2.82,
      "text": "Oh my brother has asthma."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 121.83,
      "end_seconds": 124.3,
      "duration_seconds": 2.47,
      "text": "are you living with family?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 125.53,
      "end_seconds": 129.62,
      "duration_seconds": 4.09,
      "text": "I stay with my daughter and her family."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 130.39,
      "end_seconds": 132.49,
      "duration_seconds": 2.1,
      "text": "do you get any exercise?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 137.49,
      "end_seconds": 142.11,
      "duration_seconds": 4.62,
      "text": "I walk for about half an hour most days."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 143.09,
      "end_seconds": 145.03,
      "duration_seconds": 1.94,
      "text": "Anything special about your diet?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 147.07,
      "end_seconds": 150.5,
      "duration_seconds": 3.43,
      "text": "I try to avoid too much sugar."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 161.66,
      "end_seconds": 165.06,
      "duration_seconds": 3.4,
      "text": "Do you have any known allergies at all?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 166.71,
      "end_seconds": 169.89,
      "duration_seconds": 3.18,
      "text": "No allergies that I know of no."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 170.69,
      "end_seconds": 175.59,
      "duration_seconds": 4.9,
      "text": "Let me check a few things. Any weakness or chest pain?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 177.62,
      "end_seconds": 183.56,
      "duration_seconds": 5.94,
      "text": "Um uh I haven't had weakness or chest pain no."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 184.03,
      "end_seconds": 189.3,
      "duration_seconds": 5.27,
      "text": "right. Let me check a few things. Any palpitations or vision changes?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 190.69,
      "end_seconds": 195.53,
      "duration_seconds": 4.84,
      "text": "hmm, um, no, not any of them"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 196.89,
      "end_seconds": 198.93,
      "duration_seconds": 2.04,
      "text": "Is your digestion otherwise okay?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 199.63,
      "end_seconds": 202.9,
      "duration_seconds": 3.27,
      "text": "hmm, bowels are regular, nothing odd"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 203.69,
      "end_seconds": 208.18,
      "duration_seconds": 4.49,
      "text": "Let's get your blood pressure and and the other basics."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 220.68,
      "end_seconds": 222.29,
      "duration_seconds": 1.61,
      "text": "Just relax your arm..."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 238.6,
      "end_seconds": 248.02,
      "duration_seconds": 9.42,
      "text": "okay: respiratory rate 18, pulse is 75 beats a minute, blood pressure 155 over 100. And saturation 99 percent, temp 36.7 degrees"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 249.63,
      "end_seconds": 252.39,
      "duration_seconds": 2.76,
      "text": "Let's do the physical part now."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 254.02,
      "end_seconds": 256.79,
      "duration_seconds": 2.77,
      "text": "Stay still while I have a look."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 274.91,
      "end_seconds": 277.69,
      "duration_seconds": 2.78,
      "text": "there's mild pitting swelling at both ankles"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 278.81,
      "end_seconds": 281.27,
      "duration_seconds": 2.46,
      "text": "let me look at this properly"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 293.25,
      "end_seconds": 295.1,
      "duration_seconds": 1.85,
      "text": "Heart sounds are normal."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 300.14,
      "end_seconds": 303.04,
      "duration_seconds": 2.9,
      "text": "that's all I need thank you"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 316.55,
      "end_seconds": 326.94,
      "duration_seconds": 10.39,
      "text": "okay thinking it through this is probably hypertension that isn't well controlled. We shouldn't forget a side effect from the current tablet"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 327.47,
      "end_seconds": 330.43,
      "duration_seconds": 2.96,
      "text": "I mean doctor is this dangerous?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 331.45,
      "end_seconds": 346.11,
      "duration_seconds": 14.66,
      "text": "nothing I've seen today points to an emergency it looks like hypertension that isn't well controlled the treatment will be amlodipine, 5 milligrams, once a day, long term that's for high blood pressure"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 347.2,
      "end_seconds": 348.9,
      "duration_seconds": 1.7,
      "text": "okay, thank you"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 350.63,
      "end_seconds": 355.58,
      "duration_seconds": 4.95,
      "text": "Come back in a month. That's everything from me. Any other questions?"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 356.48,
      "end_seconds": 359.8,
      "duration_seconds": 3.32,
      "text": "I appreciate it, you know, doctor."
    }
  ]
}