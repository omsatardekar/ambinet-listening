{
  "schema_version": "1.0",
  "encounter_id": "00160",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.19,
      "end_seconds": 4.62,
      "duration_seconds": 3.43,
      "text": "Good morning. Come in, have a seat."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 5.56,
      "end_seconds": 6.6,
      "duration_seconds": 1.04,
      "text": "Evening, doctor."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 7.21,
      "end_seconds": 13.92,
      "duration_seconds": 6.71,
      "text": "Um, doctor, I've come along because I know the history, if it helps."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 14.51,
      "end_seconds": 19.54,
      "duration_seconds": 5.03,
      "text": "Absolutely, come and sit beside them. Okay. Start wherever you like."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 20.31,
      "end_seconds": 24.01,
      "duration_seconds": 3.7,
      "text": "She's been having severe body pain, doctor."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 24.98,
      "end_seconds": 27.07,
      "duration_seconds": 2.09,
      "text": "Roughly when did it start?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 28.58,
      "end_seconds": 35.84,
      "duration_seconds": 7.26,
      "text": "It's been about two weeks, I'm fairly sure. It's the not knowing that gets to me."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 36.44,
      "end_seconds": 39.99,
      "duration_seconds": 3.55,
      "text": "On a normal day, how strong is it?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 41.41,
      "end_seconds": 45.27,
      "duration_seconds": 3.86,
      "text": "A three out of ten, I suppose."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 47.13,
      "end_seconds": 50.6,
      "duration_seconds": 3.47,
      "text": "Anything that tends to go along with it?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 51.87,
      "end_seconds": 68.24,
      "duration_seconds": 16.37,
      "text": "A high fever goes along with it, most of the time. As for high fever, I honestly can't say when that began. It might have been last month or the month before."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 68.74,
      "end_seconds": 69.44,
      "duration_seconds": 0.7,
      "text": "Yes?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 70.57,
      "end_seconds": 73.05,
      "duration_seconds": 2.48,
      "text": "Any a skin rash as well?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 74.96,
      "end_seconds": 76.94,
      "duration_seconds": 1.98,
      "text": "Yes, for two weeks."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 78.02,
      "end_seconds": 83.25,
      "duration_seconds": 5.23,
      "text": "Did you get cough, bleeding from the gums or blood in the stool?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 83.92,
      "end_seconds": 92.83,
      "duration_seconds": 8.91,
      "text": "Hmm, I haven't had cough, bleeding from the gums or blood in the stool, no."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 96.71,
      "end_seconds": 98.08,
      "duration_seconds": 1.37,
      "text": "What about vomiting?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 99.02,
      "end_seconds": 100.78,
      "duration_seconds": 1.76,
      "text": "No, no vomiting."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 101.88,
      "end_seconds": 104.81,
      "duration_seconds": 2.93,
      "text": "Anything different when you pass water?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 106.16,
      "end_seconds": 109.31,
      "duration_seconds": 3.15,
      "text": "That's normal as far as I know."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 111.39,
      "end_seconds": 116.04,
      "duration_seconds": 4.65,
      "text": "Have you noticed any weakness, or anything odd with your balance?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 119.74,
      "end_seconds": 121.12,
      "duration_seconds": 1.38,
      "text": "Nothing odd there."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 126.66,
      "end_seconds": 129.72,
      "duration_seconds": 3.06,
      "text": "A few questions about your lifestyle now."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 131.22,
      "end_seconds": 145.23,
      "duration_seconds": 14.01,
      "text": "I smoke about ten cigarettes a day. I gave up drinking about three years ago. I cycle to work most mornings. Yes, I live on my own."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 158.88,
      "end_seconds": 160.33,
      "duration_seconds": 1.45,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 165.71,
      "end_seconds": 167.96,
      "duration_seconds": 2.25,
      "text": "No, nothing like that."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 182.89,
      "end_seconds": 184.93,
      "duration_seconds": 2.04,
      "text": "Any drug or food allergies?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 185.85,
      "end_seconds": 197.69,
      "duration_seconds": 11.84,
      "text": "Yes, dust, it gives me sneezing. Yes, ibuprofen. I've no idea what the reaction was, only that I'm not supposed to have it."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 198.48,
      "end_seconds": 202.68,
      "duration_seconds": 4.2,
      "text": "Do your parents or siblings have any long-term illnesses?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 203.97,
      "end_seconds": 207.43,
      "duration_seconds": 3.46,
      "text": "Uh, my father had kidney stones."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 209.18,
      "end_seconds": 211.72,
      "duration_seconds": 2.54,
      "text": "Any diagnoses you've been given before?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 213.52,
      "end_seconds": 216.03,
      "duration_seconds": 2.51,
      "text": "So, I've had diabetes, yes."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 220.59,
      "end_seconds": 221.29,
      "duration_seconds": 0.7,
      "text": "Right."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 223.35,
      "end_seconds": 225.3,
      "duration_seconds": 1.95,
      "text": "Yes, high blood pressure."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 226.73,
      "end_seconds": 230.04,
      "duration_seconds": 3.31,
      "text": "Are you on any tablets or medication?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 231.6,
      "end_seconds": 235.65,
      "duration_seconds": 4.05,
      "text": "It's metformin, 500 milligrams, twice a day."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 236.82,
      "end_seconds": 245.47,
      "duration_seconds": 8.65,
      "text": "It's meant to be twice a day, though I don't see she take it every time."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 250.83,
      "end_seconds": 255.12,
      "duration_seconds": 4.29,
      "text": "Ramipril, 5 milligrams, every morning for my blood pressure."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 259.99,
      "end_seconds": 262.77,
      "duration_seconds": 2.78,
      "text": "How long have you been on it?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 263.7,
      "end_seconds": 272.84,
      "duration_seconds": 9.14,
      "text": "For six months. I take Dolo, 650 milligrams, when I get the fever. Telmisartan I don't take anymore."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 278.09,
      "end_seconds": 281.84,
      "duration_seconds": 3.75,
      "text": "Let's get your blood pressure and the other basics."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 295.77,
      "end_seconds": 297.95,
      "duration_seconds": 2.18,
      "text": "Okay, give me a moment..."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 318.4,
      "end_seconds": 327.52,
      "duration_seconds": 9.12,
      "text": "Okay: temperature 38.4, saturation 97 percent. And pulse is 91 beats a minute, respiratory rate 21, BP is 115 over 76."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 330.2,
      "end_seconds": 333.75,
      "duration_seconds": 3.55,
      "text": "Right, let me check a few things physically."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 334.72,
      "end_seconds": 336.79,
      "duration_seconds": 2.07,
      "text": "Let me just check something."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 347.49,
      "end_seconds": 353.14,
      "duration_seconds": 5.65,
      "text": "There's a faint rash on your forearms, it blanches when I press."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 354.48,
      "end_seconds": 356.63,
      "duration_seconds": 2.15,
      "text": "Let me just check something."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 372.26,
      "end_seconds": 377.85,
      "duration_seconds": 5.59,
      "text": "Your tummy is soft, a little tender under the ribs on the right."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 380.56,
      "end_seconds": 383.03,
      "duration_seconds": 2.47,
      "text": "All done, you can get dressed."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 396.32,
      "end_seconds": 415.75,
      "duration_seconds": 19.43,
      "text": "Taking everything into account, this is probably a febrile illness that could be dengue. Malaria is still possible. Stop me if I've got anything wrong. You've had severe body pain for about two weeks, and no bleeding from the gums or cough."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 416.99,
      "end_seconds": 418.65,
      "duration_seconds": 1.66,
      "text": "That's it, yes."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 420.66,
      "end_seconds": 445.49,
      "duration_seconds": 24.83,
      "text": "Let's book a dengue test to look into fever. Let's book a malaria test to look into fever. Drink a lot, coconut water, ORS, whatever you can manage. Let's hold off on a full blood count for now, and if there's no change in a month we can revisit it. Let's plan a check in two days. Do you have any questions?"
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 446.6,
      "end_seconds": 450.08,
      "duration_seconds": 3.48,
      "text": "No, you've explained it well. Thanks."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 455.22,
      "end_seconds": 456.02,
      "duration_seconds": 0.8,
      "text": "Take care."
    }
  ]
}