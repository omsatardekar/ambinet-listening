      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 278.61,
      "end_seconds": 287.55,
      "duration_seconds": 8.94,
      "text": "mm keep an eye out, and if the symptoms get worse, call us the same day or go to emergency"
