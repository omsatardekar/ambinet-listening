{
  "schema_version": "1.0",
  "encounter_id": "00377",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.07,
      "end_seconds": 6.25,
      "duration_seconds": 5.18,
      "text": "Uh, morning, doctor, I hope I'm not interrupting."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.64,
      "end_seconds": 11.46,
      "duration_seconds": 3.82,
      "text": "You're fine, sit down. So, what brings you in?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 12.13,
      "end_seconds": 20.36,
      "duration_seconds": 8.23,
      "text": "Mainly aching in my thighs. There's a couple of other things, but that's the main one."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 21.9,
      "end_seconds": 24.61,
      "duration_seconds": 2.71,
      "text": "Since when have you had this?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 25.8,
      "end_seconds": 33.02,
      "duration_seconds": 7.22,
      "text": "About... well, four weeks. I took the morning off to come in today."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 34.63,
      "end_seconds": 37.52,
      "duration_seconds": 2.89,
      "text": "How much is it bothering you?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 38.71,
      "end_seconds": 51.46,
      "duration_seconds": 12.75,
      "text": "I'd say moderate. Oh, and weakness getting out of a chair. That's been about the same, about a month. And there's cramps as well, four weeks now."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 67.16,
      "end_seconds": 69.35,
      "duration_seconds": 2.19,
      "text": "Any sign of joint swelling?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 70.12,
      "end_seconds": 72.32,
      "duration_seconds": 2.2,
      "text": "No joint swelling, thankfully."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 73.36,
      "end_seconds": 77.86,
      "duration_seconds": 4.5,
      "text": "Did you get recent heavy exercise, numbness, fever or rash?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 79.54,
      "end_seconds": 81.96,
      "duration_seconds": 2.42,
      "text": "No, um, nothing there."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 83.19,
      "end_seconds": 86.22,
      "duration_seconds": 3.03,
      "text": "Right, is your chest okay generally?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 87.17,
      "end_seconds": 88.76,
      "duration_seconds": 1.59,
      "text": "No, nothing there."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 91.65,
      "end_seconds": 95.95,
      "duration_seconds": 4.3,
      "text": "What about your tummy and bowels, anything unusual there?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 97.85,
      "end_seconds": 100.26,
      "duration_seconds": 2.41,
      "text": "No, that side's been fine."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 115.06,
      "end_seconds": 118.9,
      "duration_seconds": 3.84,
      "text": "Have you had to have anything operated on?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 119.54,
      "end_seconds": 125.57,
      "duration_seconds": 6.03,
      "text": "I had a stent put in my heart two years ago."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 127.66,
      "end_seconds": 130.74,
      "duration_seconds": 3.08,
      "text": "Are you on any tablets or medication?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 132.11,
      "end_seconds": 144.38,
      "duration_seconds": 12.27,
      "text": "Losartan, 50 milligrams, once a day. Atorvastatin. I take it 20 milligrams, at night. A neighbour of mine said I should see someone about it."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 145.58,
      "end_seconds": 150.88,
      "duration_seconds": 5.3,
      "text": "Do you have any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 152.91,
      "end_seconds": 160.45,
      "duration_seconds": 7.54,
      "text": "Yes, high blood pressure. I've had high cholesterol for about a year now. Yes, heart disease."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 162.23,
      "end_seconds": 171.62,
      "duration_seconds": 9.39,
      "text": "Okay, I can see high cholesterol in your file as well. Let's talk a little about your daily life and habits."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 172.78,
      "end_seconds": 190.2,
      "duration_seconds": 17.42,
      "text": "I have a couple of drinks on the weekend. I've never smoked. I work night shifts at a warehouse. I share a flat with two friends. I try to avoid too much sugar."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 192.16,
      "end_seconds": 194.85,
      "duration_seconds": 2.69,
      "text": "Before I prescribe anything, any allergies?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 195.73,
      "end_seconds": 199.26,
      "duration_seconds": 3.53,
      "text": "I don't have any known medication allergies."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 200.72,
      "end_seconds": 203.33,
      "duration_seconds": 2.61,
      "text": "Can I take your vitals now?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 213.04,
      "end_seconds": 213.94,
      "duration_seconds": 0.9,
      "text": "One second..."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 233.42,
      "end_seconds": 240.35,
      "duration_seconds": 6.93,
      "text": "Okay: BP is 124 over 77, temp 36.6 degrees, heart rate 74, saturation 97 percent."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 242.52,
      "end_seconds": 245.47,
      "duration_seconds": 2.95,
      "text": "I'll examine you now, bear with me."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 247.33,
      "end_seconds": 251.8,
      "duration_seconds": 4.47,
      "text": "A little pressure here, tell me if it's tender."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 260.02,
      "end_seconds": 263.96,
      "duration_seconds": 3.94,
      "text": "The muscles are mildly tender when I squeeze."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 268.08,
      "end_seconds": 271.17,
      "duration_seconds": 3.09,
      "text": "So, that's all I need, thank you."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 283.09,
      "end_seconds": 300.41,
      "duration_seconds": 17.32,
      "text": "Right, here's what I'm thinking. I think we're dealing with muscle symptoms that may be related to the cholesterol tablet at this stage. I want a thyroid test done, that's for muscle weakness. So, that's everything from me. Any other questions?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 301.81,
      "end_seconds": 303.82,
      "duration_seconds": 2.01,
      "text": "Thanks, that was helpful."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 304.8,
      "end_seconds": 306.03,
      "duration_seconds": 1.23,
      "text": "See you then."
    }
  ]
}