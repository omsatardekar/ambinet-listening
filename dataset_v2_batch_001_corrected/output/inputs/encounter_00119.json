{
  "schema_version": "1.0",
  "encounter_id": "00119",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.36,
      "end_seconds": 6.47,
      "duration_seconds": 5.11,
      "text": "hi, doctor long queue outside, but here I am"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.18,
      "end_seconds": 14.51,
      "duration_seconds": 6.33,
      "text": "Yes, come in, take a a seat. What can I do for you today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 15.74,
      "end_seconds": 18.76,
      "duration_seconds": 3.02,
      "text": "doctor, thank you for seeing us"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 19.64,
      "end_seconds": 22.4,
      "duration_seconds": 2.76,
      "text": "please do. Extra information is always welcome"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 23.73,
      "end_seconds": 30.6,
      "duration_seconds": 6.87,
      "text": "Mainly sneezing fits. There's a couple of other things, but that's the main one."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 32.15,
      "end_seconds": 34.79,
      "duration_seconds": 2.64,
      "text": "How long have you had it?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 36.43,
      "end_seconds": 40.39,
      "duration_seconds": 3.96,
      "text": "it's been going on for about three months"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 40.99,
      "end_seconds": 48.67,
      "duration_seconds": 7.68,
      "text": "can you describe it a bit more for me? How strong it is, what the pattern is, what helps"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 49.8,
      "end_seconds": 60.16,
      "duration_seconds": 10.36,
      "text": "I'd call it severe. Dust definitely sets it off. It's a relief to finally sit down and talk about it."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 60.76,
      "end_seconds": 63.69,
      "duration_seconds": 2.93,
      "text": "any a runny nose as well?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 64.25,
      "end_seconds": 76.93,
      "duration_seconds": 12.68,
      "text": "Yes, uh, for three weeks. There's itchy watery eyes as well. Um, as for itchy watery eyes, it feels mild to me."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 78.23,
      "end_seconds": 80.49,
      "duration_seconds": 2.26,
      "text": "any drug or food allergies?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 81.62,
      "end_seconds": 93.18,
      "duration_seconds": 11.56,
      "text": "Hmm, there was some antibiotic, I was told I was allergic. But I couldn't tell you what it was called or what it did."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 94.14,
      "end_seconds": 98.08,
      "duration_seconds": 3.94,
      "text": "right have you ever been under the knife?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 99.46,
      "end_seconds": 103.82,
      "duration_seconds": 4.36,
      "text": "yes, I had a C-section, about ten years ago"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 105.3,
      "end_seconds": 108.02,
      "duration_seconds": 2.72,
      "text": "Any diagnoses you've been given before?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 109.03,
      "end_seconds": 120.69,
      "duration_seconds": 11.66,
      "text": "I have eczema. I've had asthma for five years now. I took the morning off to come in today. I've got acid reflux"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 122.59,
      "end_seconds": 124.21,
      "duration_seconds": 1.62,
      "text": "and apart from that?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 129.44,
      "end_seconds": 137.84,
      "duration_seconds": 8.4,
      "text": "right so acid reflux is already on your record. We'll keep that in mind today. And And your work?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 138.74,
      "end_seconds": 142.5,
      "duration_seconds": 3.76,
      "text": "I drive a delivery van all day"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 143.45,
      "end_seconds": 145.53,
      "duration_seconds": 2.08,
      "text": "Anything special about your diet?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 147.05,
      "end_seconds": 150.52,
      "duration_seconds": 3.47,
      "text": "I try to avoid too much sugar."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 151.05,
      "end_seconds": 156.7,
      "duration_seconds": 5.65,
      "text": "alright, what about family history, any illnesses that run in the family?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 157.78,
      "end_seconds": 165.09,
      "duration_seconds": 7.31,
      "text": "okay, so my brother has asthma. So, my father had a heart attack"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 165.66,
      "end_seconds": 169.66,
      "duration_seconds": 4.0,
      "text": "Which tablets or creams or inhalers do you use?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 170.31,
      "end_seconds": 176.23,
      "duration_seconds": 5.92,
      "text": "it's hydrocortisone cream when needed. It's Asthalin inhaler when needed for my asthma"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 176.97,
      "end_seconds": 183.57,
      "duration_seconds": 6.6,
      "text": "It's meant to be when needed, though I don't see she take it every time."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 184.72,
      "end_seconds": 191.65,
      "duration_seconds": 6.93,
      "text": "it's pantoprazole 40 milligrams before breakfast for my acidity. Cetirizine 10 milligrams when it flares"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 192.21,
      "end_seconds": 197.66,
      "duration_seconds": 5.45,
      "text": "Okay. Any wheezing, shortness of breath, loss of smell or rash at all?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 198.4,
      "end_seconds": 206.34,
      "duration_seconds": 7.94,
      "text": "oh, no wheezing, shortness of breath, loss of smell or rash, none of it"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 211.25,
      "end_seconds": 212.43,
      "duration_seconds": 1.18,
      "text": "Any facial pain?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 213.84,
      "end_seconds": 215.98,
      "duration_seconds": 2.14,
      "text": "nope no facial pain"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 217.95,
      "end_seconds": 219.38,
      "duration_seconds": 1.43,
      "text": "How about fever?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 220.54,
      "end_seconds": 223.41,
      "duration_seconds": 2.87,
      "text": "nope, you know, no fever"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 228.61,
      "end_seconds": 234.49,
      "duration_seconds": 5.88,
      "text": "Um, actually, doctor, I did notice fever. She doesn't always say."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 235.56,
      "end_seconds": 242.39,
      "duration_seconds": 6.83,
      "text": "No you know I don't think I did. Maybe a little I'm not sure."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 243.3,
      "end_seconds": 251.73,
      "duration_seconds": 8.43,
      "text": "Alright, I'll note both what you've said and what you've noticed. On the cardiac side, anything I should know?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 252.91,
      "end_seconds": 257.8,
      "duration_seconds": 4.89,
      "text": "My heart's been fine, as far as I know."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 271.46,
      "end_seconds": 274.07,
      "duration_seconds": 2.61,
      "text": "let me measure a few things"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 281.4,
      "end_seconds": 283.32,
      "duration_seconds": 1.92,
      "text": "just relax your arm.."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 300.13,
      "end_seconds": 309.88,
      "duration_seconds": 9.75,
      "text": "okay: pressure 125 over 70, respiratory rate 14. And temperature 36.8, pulse is 75 beats a minute, SpO2 98 percent on room air"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 310.68,
      "end_seconds": 312.9,
      "duration_seconds": 2.22,
      "text": "is that that okay?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 314.67,
      "end_seconds": 318.12,
      "duration_seconds": 3.45,
      "text": "I'll interpret it once I've examined you"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 320.66,
      "end_seconds": 323.74,
      "duration_seconds": 3.08,
      "text": "let's do the the physical part now"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 325.21,
      "end_seconds": 325.91,
      "duration_seconds": 0.7,
      "text": "sure"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 327.49,
      "end_seconds": 330.37,
      "duration_seconds": 2.88,
      "text": "Alright, tell me if anything hurts."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 338.14,
      "end_seconds": 340.26,
      "duration_seconds": 2.12,
      "text": "Chest is clear, no wheeze."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 341.73,
      "end_seconds": 342.43,
      "duration_seconds": 0.7,
      "text": "alright"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 343.61,
      "end_seconds": 345.33,
      "duration_seconds": 1.72,
      "text": "Let me press here."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 359.12,
      "end_seconds": 362.86,
      "duration_seconds": 3.74,
      "text": "the inside of your nose is pale and swollen"
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 365.3,
      "end_seconds": 367.01,
      "duration_seconds": 1.71,
      "text": "Good, that's the examination."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 385.73,
      "end_seconds": 396.79,
      "duration_seconds": 11.06,
      "text": "from what you've told me and and what I found, I think we're dealing with allergic rhinitis at this stage a viral cold is also on my list"
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 397.59,
      "end_seconds": 403.09,
      "duration_seconds": 5.5,
      "text": "I've been thinking the worst to be honest. Is it bad?"
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 405.19,
      "end_seconds": 418.5,
      "duration_seconds": 13.31,
      "text": "nothing I've seen today points to an emergency it looks like allergic rhinitis stop me if I've got anything wrong you've had sneezing fits for about three months severe and no facial pain"
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 420.07,
      "end_seconds": 423.23,
      "duration_seconds": 3.16,
      "text": "I mean yes you've got it."
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 430.24,
      "end_seconds": 439.04,
      "duration_seconds": 8.8,
      "text": "I don't need to add any tests or treatment at this point. That's it on my side. Anything unclear?"
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 439.88,
      "end_seconds": 442.88,
      "duration_seconds": 3.0,
      "text": "okay, so I appreciate it, doctor"
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 444.82,
      "end_seconds": 445.84,
      "duration_seconds": 1.02,
      "text": "Alright, goodbye."
    }
  ]
}