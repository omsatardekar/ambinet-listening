{
  "schema_version": "1.0",
  "encounter_id": "00110",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.24,
      "end_seconds": 5.73,
      "duration_seconds": 4.49,
      "text": "Good evening. Sorry to keep you waiting. What's been bothering you?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 6.72,
      "end_seconds": 11.69,
      "duration_seconds": 4.97,
      "text": "I've been dealing with a grinding sound when I move."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 12.94,
      "end_seconds": 15.48,
      "duration_seconds": 2.54,
      "text": "Let me measure a few things."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 27.16,
      "end_seconds": 28.92,
      "duration_seconds": 1.76,
      "text": "Hold still for me..."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 46.29,
      "end_seconds": 57.68,
      "duration_seconds": 11.39,
      "text": "Okay: pulse is 67 beats a minute, temperature 36.6, SpO2 98 percent on room air. And BP is 124 over 77. And when did that start?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 59.61,
      "end_seconds": 66.73,
      "duration_seconds": 7.12,
      "text": "It's been going on for two months. I've never really been one for hospitals."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 68.19,
      "end_seconds": 72.05,
      "duration_seconds": 3.86,
      "text": "How would you describe it, mild, moderate, severe?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 73.07,
      "end_seconds": 76.15,
      "duration_seconds": 3.08,
      "text": "About a four out of ten."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 76.55,
      "end_seconds": 80.25,
      "duration_seconds": 3.7,
      "text": "Uh-huh. Does it come along with anything else?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 86.29,
      "end_seconds": 97.27,
      "duration_seconds": 10.98,
      "text": "Stiffness in the morning goes along with it, most of the time. With stiffness in the morning, it feels severe to me."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 98.16,
      "end_seconds": 103.68,
      "duration_seconds": 5.52,
      "text": "Any pain in other joints, locking of the knee or fall?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 104.91,
      "end_seconds": 107.97,
      "duration_seconds": 3.06,
      "text": "No, none of that at all."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 108.88,
      "end_seconds": 110.89,
      "duration_seconds": 2.01,
      "text": "Did you notice any fever?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 111.9,
      "end_seconds": 114.82,
      "duration_seconds": 2.92,
      "text": "No, I haven't had any fever."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 119.23,
      "end_seconds": 121.45,
      "duration_seconds": 2.22,
      "text": "Has your skin been okay?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 122.68,
      "end_seconds": 124.61,
      "duration_seconds": 1.93,
      "text": "No, skin's been fine."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 139.51,
      "end_seconds": 145.23,
      "duration_seconds": 5.72,
      "text": "Have you ever reacted badly to a medicine or food? Any allergies?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 146.83,
      "end_seconds": 147.86,
      "duration_seconds": 1.03,
      "text": "No allergies."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 148.91,
      "end_seconds": 151.42,
      "duration_seconds": 2.51,
      "text": "Have you got any chronic problems?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 153.2,
      "end_seconds": 154.4,
      "duration_seconds": 1.2,
      "text": "Yes, diabetes."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 169.34,
      "end_seconds": 173.68,
      "duration_seconds": 4.34,
      "text": "Let's talk a little about your daily life and habits."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 175.54,
      "end_seconds": 187.97,
      "duration_seconds": 12.43,
      "text": "I share a flat with two friends. I eat out quite a lot, to be honest. I cycle to work most mornings."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 204.15,
      "end_seconds": 207.68,
      "duration_seconds": 3.53,
      "text": "Let's go through your medication. What are you taking?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 209.18,
      "end_seconds": 215.03,
      "duration_seconds": 5.85,
      "text": "It's Glycomet, 500 milligrams, twice a day. Volini gel, twice a day."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 217.4,
      "end_seconds": 220.2,
      "duration_seconds": 2.8,
      "text": "I'd like to examine you now."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 227.64,
      "end_seconds": 228.34,
      "duration_seconds": 0.7,
      "text": "Okay."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 229.35,
      "end_seconds": 231.47,
      "duration_seconds": 2.12,
      "text": "Just relax, I'll be quick."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 243.06,
      "end_seconds": 249.19,
      "duration_seconds": 6.13,
      "text": "Bending is limited to about a right angle, and it hurts at the end."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 254.61,
      "end_seconds": 261.55,
      "duration_seconds": 6.94,
      "text": "Good, that's the examination. Having listened and examined, I'd lean towards osteoarthritis of the knees."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 263.23,
      "end_seconds": 266.08,
      "duration_seconds": 2.85,
      "text": "Is this going to go away?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 270.66,
      "end_seconds": 293.75,
      "duration_seconds": 23.09,
      "text": "It's reasonable to be concerned, but right now osteoarthritis of the knees is my leading thought, not anything worse. An X-ray of both knees is what I'd like next, for knee pain. I'm going to put you on paracetamol, 650 milligrams, three times a day, for two weeks. That's for knee pain."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 294.79,
      "end_seconds": 298.23,
      "duration_seconds": 3.44,
      "text": "Is that safe with my other things?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 299.27,
      "end_seconds": 311.26,
      "duration_seconds": 11.99,
      "text": "Losing even a few kilos takes a lot of load off the knees, and I'd like you to do the strengthening exercises. Let's review you in four weeks."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 312.32,
      "end_seconds": 316.15,
      "duration_seconds": 3.83,
      "text": "Alright, I'll put it in my diary."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 316.99,
      "end_seconds": 319.25,
      "duration_seconds": 2.26,
      "text": "Right, that's all. Go gently."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 320.53,
      "end_seconds": 323.35,
      "duration_seconds": 2.82,
      "text": "Alright, thanks. Bye for now."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 325.28,
      "end_seconds": 326.6,
      "duration_seconds": 1.32,
      "text": "See you then."
    }
  ]
}