{
  "schema_version": "1.0",
  "encounter_id": "00238",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.71,
      "end_seconds": 4.41,
      "duration_seconds": 3.7,
      "text": "Excuse me, doctor, should I sit here?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.01,
      "end_seconds": 13.62,
      "duration_seconds": 5.61,
      "text": "Of course, put it down anywhere. So, how can I help?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 14.43,
      "end_seconds": 22.31,
      "duration_seconds": 7.88,
      "text": "Mainly breathlessness on the stairs. There's a couple of other things, but that's the main one."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 24.12,
      "end_seconds": 26.4,
      "duration_seconds": 2.28,
      "text": "Roughly when did it start?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 27.29,
      "end_seconds": 30.89,
      "duration_seconds": 3.6,
      "text": "Well, I've had it since last weekend."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 31.45,
      "end_seconds": 42.08,
      "duration_seconds": 10.63,
      "text": "Go on. Tell me a bit more about it: how bad it gets, how often, and whether anything makes it better or worse."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 43.1,
      "end_seconds": 52.03,
      "duration_seconds": 8.93,
      "text": "Pretty severe, if I'm being honest. Only resting, and it's not much. Yes, climbing stairs. That makes it worse."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 54.0,
      "end_seconds": 60.1,
      "duration_seconds": 6.1,
      "text": "Let me check a few things. Any weight loss, chest pain or fainting?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 61.83,
      "end_seconds": 66.69,
      "duration_seconds": 4.86,
      "text": "no weight loss, chest pain or fainting, none of it"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 69.94,
      "end_seconds": 72.44,
      "duration_seconds": 2.5,
      "text": "Have you had any black stools?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 75.46,
      "end_seconds": 78.42,
      "duration_seconds": 2.96,
      "text": "I haven't noticed any black stools."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 79.82,
      "end_seconds": 82.34,
      "duration_seconds": 2.52,
      "text": "anything different when you pass water?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 84.17,
      "end_seconds": 86.24,
      "duration_seconds": 2.07,
      "text": "No, that's all fine."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 87.43,
      "end_seconds": 90.72,
      "duration_seconds": 3.29,
      "text": "So, are you working at the moment?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 92.8,
      "end_seconds": 96.7,
      "duration_seconds": 3.9,
      "text": "Yes, I'm a nurse on a busy ward"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 97.89,
      "end_seconds": 99.84,
      "duration_seconds": 1.95,
      "text": "Right, how's your diet?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 101.45,
      "end_seconds": 102.82,
      "duration_seconds": 1.37,
      "text": "I'm mostly vegetarian"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 104.06,
      "end_seconds": 105.92,
      "duration_seconds": 1.86,
      "text": "do you live alone?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 107.61,
      "end_seconds": 110.96,
      "duration_seconds": 3.35,
      "text": "Yes, I live on my own."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 112.43,
      "end_seconds": 115.29,
      "duration_seconds": 2.86,
      "text": "have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 116.93,
      "end_seconds": 118.4,
      "duration_seconds": 1.47,
      "text": "No operations, no."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 135.74,
      "end_seconds": 137.69,
      "duration_seconds": 1.95,
      "text": "Any drug or food allergies?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 139.62,
      "end_seconds": 143.61,
      "duration_seconds": 3.99,
      "text": "no allergies that I know of, no"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 144.45,
      "end_seconds": 149.15,
      "duration_seconds": 4.7,
      "text": "Any medication at the moment, including things from the pharmacy?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 149.99,
      "end_seconds": 158.61,
      "duration_seconds": 8.62,
      "text": "Pantoprazole. I take it 40 milligrams, before breakfast. I take hydrocortisone cream, when needed for the eczema."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 174.47,
      "end_seconds": 178.93,
      "duration_seconds": 4.46,
      "text": "So, anyone in the family with similar problems or other conditions?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 180.75,
      "end_seconds": 183.69,
      "duration_seconds": 2.94,
      "text": "My mother had high blood pressure."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 184.23,
      "end_seconds": 187.36,
      "duration_seconds": 3.13,
      "text": "Any long-term health problems I should know about?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 188.22,
      "end_seconds": 192.43,
      "duration_seconds": 4.21,
      "text": "Acid reflux, for five years. I have eczema."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 193.41,
      "end_seconds": 200.14,
      "duration_seconds": 6.73,
      "text": "Right, so acid reflux and eczema are already on your record. We'll keep that in mind today."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 201.18,
      "end_seconds": 204.95,
      "duration_seconds": 3.77,
      "text": "Right, let me check a few things physically."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 216.1,
      "end_seconds": 217.21,
      "duration_seconds": 1.11,
      "text": "Yes, doctor."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 218.52,
      "end_seconds": 220.55,
      "duration_seconds": 2.03,
      "text": "let me just check something"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 233.54,
      "end_seconds": 235.7,
      "duration_seconds": 2.16,
      "text": "Your eyelids are pale inside."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 236.75,
      "end_seconds": 238.75,
      "duration_seconds": 2.0,
      "text": "Let me just check something."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 254.15,
      "end_seconds": 257.99,
      "duration_seconds": 3.84,
      "text": "Heart sounds are normal, I don't hear any murmur."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 262.18,
      "end_seconds": 267.71,
      "duration_seconds": 5.53,
      "text": "Okay, finished. Taking everything into account, this is probably anaemia of some kind."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 268.64,
      "end_seconds": 275.31,
      "duration_seconds": 6.67,
      "text": "Yeah, I've been thinking the worst, to be honest. Is it bad?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 276.61,
      "end_seconds": 285.53,
      "duration_seconds": 8.92,
      "text": "Nothing I've seen today points to an emergency. It looks like anaemia of some kind, but I'd like to confirm."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 303.2,
      "end_seconds": 334.6,
      "duration_seconds": 31.4,
      "text": "I'll request a full blood count, it'll help with pallor i'm sending you for a ferritin level because of possible iron deficiency we'll begin with ferrous sulfate, 200 milligrams, once a day, for three months that should help with possible iron deficiency iron can darken the stools and bother the stomach, so take it after food if the symptoms get worse, that's the point to come in urgently"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 336.03,
      "end_seconds": 337.84,
      "duration_seconds": 1.81,
      "text": "Okay, fair enough."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 339.44,
      "end_seconds": 346.45,
      "duration_seconds": 7.01,
      "text": "Please come and see me in two weeks. Okay, I think we're finished. Is everything clear?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 347.5,
      "end_seconds": 351.41,
      "duration_seconds": 3.91,
      "text": "One thing: no, actually that's all. Thanks."
    }
  ]
}