{
  "schema_version": "1.0",
  "encounter_id": "00288",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.07,
      "end_seconds": 4.29,
      "duration_seconds": 3.22,
      "text": "Good morning, how are you doing today?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 6.15,
      "end_seconds": 7.4,
      "duration_seconds": 1.25,
      "text": "Hi, doctor."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 8.28,
      "end_seconds": 14.18,
      "duration_seconds": 5.9,
      "text": "Doctor, I've come along because I know the history, if it helps."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 15.3,
      "end_seconds": 22.6,
      "duration_seconds": 7.3,
      "text": "Of course, please stay. It's helpful to have you here. Tell me from the beginning, what's been happening?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 23.94,
      "end_seconds": 30.57,
      "duration_seconds": 6.63,
      "text": "So, So the thing is, I've got a mole that has changed."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 31.26,
      "end_seconds": 33.81,
      "duration_seconds": 2.55,
      "text": "How long are we talking about?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 35.83,
      "end_seconds": 39.15,
      "duration_seconds": 3.32,
      "text": "Hmm, I've had it since Monday."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 43.14,
      "end_seconds": 46.32,
      "duration_seconds": 3.18,
      "text": "Anything that tends to go along with it?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 47.11,
      "end_seconds": 59.3,
      "duration_seconds": 12.19,
      "text": "It usually comes with it's got darker. Oh, and it bled once. Uh, the it's got darker? That's been for three weeks."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 61.16,
      "end_seconds": 66.91,
      "duration_seconds": 5.75,
      "text": "Have you noticed lumps in the armpit, history of sunburn or pain?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 67.71,
      "end_seconds": 70.69,
      "duration_seconds": 2.98,
      "text": "Right, no, I'd have mentioned it."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 76.68,
      "end_seconds": 79.51,
      "duration_seconds": 2.83,
      "text": "Have you noticed fever or weight loss?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 80.72,
      "end_seconds": 84.16,
      "duration_seconds": 3.44,
      "text": "No, none of that at all."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 85.79,
      "end_seconds": 88.26,
      "duration_seconds": 2.47,
      "text": "Is your urine normal, no changes?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 89.95,
      "end_seconds": 94.12,
      "duration_seconds": 4.17,
      "text": "I mean, that's normal as far as I know."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 94.8,
      "end_seconds": 98.27,
      "duration_seconds": 3.47,
      "text": "How about your heart, any problems like that?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 99.12,
      "end_seconds": 101.08,
      "duration_seconds": 1.96,
      "text": "No, that's been fine."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 103.9,
      "end_seconds": 106.66,
      "duration_seconds": 2.76,
      "text": "What medicines do you take regularly?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 109.71,
      "end_seconds": 112.49,
      "duration_seconds": 2.78,
      "text": "Tamsulosin. I take it at night."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 113.46,
      "end_seconds": 115.61,
      "duration_seconds": 2.15,
      "text": "How much do you take?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 117.38,
      "end_seconds": 122.71,
      "duration_seconds": 5.33,
      "text": "0.4 milligrams, I think that's what's on the box."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 123.99,
      "end_seconds": 125.39,
      "duration_seconds": 1.4,
      "text": "Is that long-standing?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 126.73,
      "end_seconds": 128.79,
      "duration_seconds": 2.06,
      "text": "For about a month."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 129.03,
      "end_seconds": 129.86,
      "duration_seconds": 0.83,
      "text": "And then?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 145.32,
      "end_seconds": 152.66,
      "duration_seconds": 7.34,
      "text": "Any long-term health problems I should know about? These questions might sound routine, but they matter."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 154.18,
      "end_seconds": 159.34,
      "duration_seconds": 5.16,
      "text": "Well, I've had an enlarged prostate for five years now."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 167.8,
      "end_seconds": 170.75,
      "duration_seconds": 2.95,
      "text": "Any allergies I should know about?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 172.72,
      "end_seconds": 175.26,
      "duration_seconds": 2.54,
      "text": "No, nothing I'm aware of."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 175.95,
      "end_seconds": 177.9,
      "duration_seconds": 1.95,
      "text": "What's your diet like?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 179.02,
      "end_seconds": 183.65,
      "duration_seconds": 4.63,
      "text": "I eat out quite a lot, to be honest."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 184.55,
      "end_seconds": 186.36,
      "duration_seconds": 1.81,
      "text": "Are you still working?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 187.67,
      "end_seconds": 192.19,
      "duration_seconds": 4.52,
      "text": "I'm retired now, I was a clerk for years."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 192.74,
      "end_seconds": 194.86,
      "duration_seconds": 2.12,
      "text": "Do you get any exercise?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 196.5,
      "end_seconds": 201.37,
      "duration_seconds": 4.87,
      "text": "I walk for about half an hour most days."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 202.88,
      "end_seconds": 205.82,
      "duration_seconds": 2.94,
      "text": "Can I take your vitals now?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 212.01,
      "end_seconds": 213.65,
      "duration_seconds": 1.64,
      "text": "Rest your hand here..."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 231.27,
      "end_seconds": 238.21,
      "duration_seconds": 6.94,
      "text": "Okay: temp 36.8 degrees, pressure 112 over 71, saturation 97 percent, pulse 83."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 241.04,
      "end_seconds": 243.87,
      "duration_seconds": 2.83,
      "text": "Let's do the physical part now."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 245.3,
      "end_seconds": 247.72,
      "duration_seconds": 2.42,
      "text": "Tell me if anything hurts."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 259.17,
      "end_seconds": 262.32,
      "duration_seconds": 3.15,
      "text": "I can't feel any glands in the armpit."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 263.78,
      "end_seconds": 264.83,
      "duration_seconds": 1.05,
      "text": "Yes, doctor."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 269.37,
      "end_seconds": 271.13,
      "duration_seconds": 1.76,
      "text": "That's fine, sit up."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 285.7,
      "end_seconds": 313.28,
      "duration_seconds": 27.58,
      "text": "Okay, thinking it through, this is probably a pigmented lesion that needs to be looked at more closely. That's my thinking for now, and it may change as we learn more. An atypical mole is also on my list. I'm sending you for a skin biopsy because of changing mole. I'm sending you for a dermoscopy because of changing mole."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 314.36,
      "end_seconds": 317.2,
      "duration_seconds": 2.84,
      "text": "Does it need any preparation?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 318.13,
      "end_seconds": 328.4,
      "duration_seconds": 10.27,
      "text": "Please use sunscreen and cover up in the midday sun, and check your skin once a month. I'll also refer you to a dermatologist."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 329.04,
      "end_seconds": 331.73,
      "duration_seconds": 2.69,
      "text": "Sure, where do I go?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 332.25,
      "end_seconds": 345.8,
      "duration_seconds": 13.55,
      "text": "Keep an eye out, and if the symptoms get worse, call us the same day or go to emergency. Let's plan a check after the biopsy results."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 350.35,
      "end_seconds": 353.33,
      "duration_seconds": 2.98,
      "text": "Um, that works for me."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 354.62,
      "end_seconds": 357.99,
      "duration_seconds": 3.37,
      "text": "Okay, I think we're finished. Is everything clear?"
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 362.9,
      "end_seconds": 365.97,
      "duration_seconds": 3.07,
      "text": "Okay, so thanks, that was helpful."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 367.38,
      "end_seconds": 369.04,
      "duration_seconds": 1.66,
      "text": "Mind how you go."
    }
  ]
}