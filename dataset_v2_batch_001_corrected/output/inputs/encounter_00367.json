  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.24,
      "end_seconds": 3.54,
      "duration_seconds": 2.3,
      "text": "Hello again. Come on in."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 5.56,
      "end_seconds": 9.36,
      "duration_seconds": 3.8,
      "text": "Hello. Is it okay if I sit here?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 10.14,
      "end_seconds": 13.16,
      "duration_seconds": 3.02,
      "text": "Go ahead, tell me what's happening."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 13.98,
      "end_seconds": 18.68,
      "duration_seconds": 4.7,
      "text": "I wanted to get headaches in the mornings looked at."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 19.63,
      "end_seconds": 23.4,
      "duration_seconds": 3.77,
      "text": "Let's go through your medication. What are you taking?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 25.0,
      "end_seconds": 28.41,
      "duration_seconds": 3.41,
      "text": "Losartan. I take it once a day."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 29.23,
      "end_seconds": 31.24,
      "duration_seconds": 2.01,
      "text": "How much do you take?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 32.08,
      "end_seconds": 36.72,
      "duration_seconds": 4.64,
      "text": "50 milligrams, I think that's what's on the box."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 38.24,
      "end_seconds": 40.65,
      "duration_seconds": 2.41,
      "text": "How far back does it go?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 45.69,
      "end_seconds": 49.06,
      "duration_seconds": 3.37,
      "text": "For about three months, I'd say."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 51.14,
      "end_seconds": 53.99,
      "duration_seconds": 2.85,
      "text": "Does it come along with anything else?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 55.7,
      "end_seconds": 69.69,
      "duration_seconds": 13.99,
      "text": "Occasional dizziness goes along with it, most of the time. The occasional dizziness? That's been for about three months. About occasional dizziness, it's moderate, honestly. I'd say all the time."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 71.59,
      "end_seconds": 75.38,
      "duration_seconds": 3.79,
      "text": "Have you noticed breathlessness, chest pain or weakness?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 81.21,
      "end_seconds": 85.56,
      "duration_seconds": 4.35,
      "text": "No breathlessness, chest pain or weakness, none of it."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 86.96,
      "end_seconds": 89.72,
      "duration_seconds": 2.76,
      "text": "Any rashes or skin problems otherwise?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 91.76,
      "end_seconds": 92.83,
      "duration_seconds": 1.07,
      "text": "No rashes."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 94.34,
      "end_seconds": 97.89,
      "duration_seconds": 3.55,
      "text": "How are your joints, any aches elsewhere?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 98.48,
      "end_seconds": 100.06,
      "duration_seconds": 1.58,
      "text": "No, nothing there."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 100.59,
      "end_seconds": 103.05,
      "duration_seconds": 2.46,
      "text": "Any drug or food allergies?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 104.14,
      "end_seconds": 105.25,
      "duration_seconds": 1.11,
      "text": "Yes, pollen."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 105.96,
      "end_seconds": 110.15,
      "duration_seconds": 4.19,
      "text": "Moving on to your background, any past medical history?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 111.58,
      "end_seconds": 116.36,
      "duration_seconds": 4.78,
      "text": "I've had high blood pressure for nearly five years now."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 118.23,
      "end_seconds": 125.06,
      "duration_seconds": 6.83,
      "text": "Right, so high blood pressure is already on your record. We'll keep that in mind today."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 138.16,
      "end_seconds": 140.4,
      "duration_seconds": 2.24,
      "text": "How do you eat, generally?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 140.95,
      "end_seconds": 143.52,
      "duration_seconds": 2.57,
      "text": "I skip breakfast most days."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 144.52,
      "end_seconds": 146.11,
      "duration_seconds": 1.59,
      "text": "Any sport or activity?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 147.8,
      "end_seconds": 150.32,
      "duration_seconds": 2.52,
      "text": "I play badminton on Sundays."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 151.59,
      "end_seconds": 154.32,
      "duration_seconds": 2.73,
      "text": "Is anyone at home with you?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 158.99,
      "end_seconds": 162.88,
      "duration_seconds": 3.89,
      "text": "I share a flat with two friends."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 177.45,
      "end_seconds": 180.4,
      "duration_seconds": 2.95,
      "text": "Let me check your vitals now."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 190.46,
      "end_seconds": 192.76,
      "duration_seconds": 2.3,
      "text": "Okay, give me a moment..."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 211.86,
      "end_seconds": 227.57,
      "duration_seconds": 15.71,
      "text": "Okay: height 183 centimetres, BMI works out to 23.9, temp 36.9 degrees, BP is 172 over 98, saturation 97 percent, respiratory rate 17, pulse is 86 beats a minute, weight 80 kilos."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 229.22,
      "end_seconds": 232.28,
      "duration_seconds": 3.06,
      "text": "If you're comfortable, I'll examine you now."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 247.66,
      "end_seconds": 248.36,
      "duration_seconds": 0.7,
      "text": "Alright."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 249.74,
      "end_seconds": 251.86,
      "duration_seconds": 2.12,
      "text": "Take your time, no rush."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 269.85,
      "end_seconds": 272.58,
      "duration_seconds": 2.73,
      "text": "There's mild pitting swelling at both ankles."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 275.72,
      "end_seconds": 276.9,
      "duration_seconds": 1.18,
      "text": "Thanks for that."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 294.9,
      "end_seconds": 312.75,
      "duration_seconds": 17.85,
      "text": "Putting it all together, this looks most like hypertension that isn't well controlled. Salt is the big one, try to keep it low even though it's hard. Do get help quickly if the symptoms get worse. Do you have any questions?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 313.84,
      "end_seconds": 317.76,
      "duration_seconds": 3.92,
      "text": "No, I think that's everything. Thank you, doctor."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 319.02,
      "end_seconds": 320.27,
      "duration_seconds": 1.25,
      "text": "All the best."
    }
  ]
