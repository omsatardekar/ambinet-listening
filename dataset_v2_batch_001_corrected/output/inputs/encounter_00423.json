{
  "schema_version": "1.0",
  "encounter_id": "00423",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.03,
      "end_seconds": 8.47,
      "duration_seconds": 7.44,
      "text": "Hi, doctor, I brought my bag, is it fine to leave it here?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 10.76,
      "end_seconds": 15.28,
      "duration_seconds": 4.52,
      "text": "Right on time. Sit, please. How can I help?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 17.36,
      "end_seconds": 22.21,
      "duration_seconds": 4.85,
      "text": "Okay, so I'm here because of trouble concentrating at work."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 24.08,
      "end_seconds": 28.23,
      "duration_seconds": 4.15,
      "text": "Let's get your blood pressure and the other basics."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 36.15,
      "end_seconds": 38.33,
      "duration_seconds": 2.18,
      "text": "Okay, give me a moment..."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 50.72,
      "end_seconds": 59.64,
      "duration_seconds": 8.92,
      "text": "Okay: saturation 99 percent, pulse is 84 beats a minute, temperature 36.9. And BP is 115 over 77."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 62.84,
      "end_seconds": 65.15,
      "duration_seconds": 2.31,
      "text": "Is that alright, doctor?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 65.72,
      "end_seconds": 68.76,
      "duration_seconds": 3.04,
      "text": "That's fine, we'll come to it."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 77.85,
      "end_seconds": 80.3,
      "duration_seconds": 2.45,
      "text": "Since when have you had this?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 82.05,
      "end_seconds": 85.9,
      "duration_seconds": 3.85,
      "text": "It's been going on for about three months."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 89.2,
      "end_seconds": 93.24,
      "duration_seconds": 4.04,
      "text": "Does anything bring it on or make it worse?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 94.36,
      "end_seconds": 96.68,
      "duration_seconds": 2.32,
      "text": "It's worse with noisy offices."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 105.12,
      "end_seconds": 109.45,
      "duration_seconds": 4.33,
      "text": "Have you noticed substance use, heavy caffeine or anxiety attacks?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 109.96,
      "end_seconds": 115.9,
      "duration_seconds": 5.94,
      "text": "No substance use, heavy caffeine or anxiety attacks, none of it."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 117.44,
      "end_seconds": 121.83,
      "duration_seconds": 4.39,
      "text": "What about your tummy and bowels, anything unusual there?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 122.94,
      "end_seconds": 125.78,
      "duration_seconds": 2.84,
      "text": "No, that side's been fine."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 127.47,
      "end_seconds": 130.09,
      "duration_seconds": 2.62,
      "text": "Have you had any surgery before?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 131.3,
      "end_seconds": 135.8,
      "duration_seconds": 4.5,
      "text": "Yes, I had my gallbladder removed, in 2016."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 136.32,
      "end_seconds": 138.04,
      "duration_seconds": 1.72,
      "text": "Okay, do you smoke?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 139.31,
      "end_seconds": 142.59,
      "duration_seconds": 3.28,
      "text": "No, I don't smoke and never have."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 144.45,
      "end_seconds": 145.93,
      "duration_seconds": 1.48,
      "text": "Do you work?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 147.17,
      "end_seconds": 153.28,
      "duration_seconds": 6.11,
      "text": "I run a small shop, so I'm on my feet a lot."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 154.06,
      "end_seconds": 155.72,
      "duration_seconds": 1.66,
      "text": "What's your diet like?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 157.76,
      "end_seconds": 162.77,
      "duration_seconds": 5.01,
      "text": "I eat out quite a lot, to be honest."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 164.25,
      "end_seconds": 165.42,
      "duration_seconds": 1.17,
      "text": "How about exercise?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 171.97,
      "end_seconds": 175.24,
      "duration_seconds": 3.27,
      "text": "Not really, I don't get much exercise."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 176.67,
      "end_seconds": 179.93,
      "duration_seconds": 3.26,
      "text": "Is there anything medical in your background?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 180.82,
      "end_seconds": 182.35,
      "duration_seconds": 1.53,
      "text": "I've got anxiety."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 184.12,
      "end_seconds": 188.64,
      "duration_seconds": 4.52,
      "text": "Okay, I can see anxiety in your file as well."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 205.37,
      "end_seconds": 210.11,
      "duration_seconds": 4.74,
      "text": "What about allergies, to medicines or foods or anything else?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 210.64,
      "end_seconds": 214.19,
      "duration_seconds": 3.55,
      "text": "I've never been told I have allergies."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 223.92,
      "end_seconds": 227.01,
      "duration_seconds": 3.09,
      "text": "Are you on any tablets or medication?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 229.01,
      "end_seconds": 234.53,
      "duration_seconds": 5.52,
      "text": "It's escitalopram, 10 milligrams, once a day for the anxiety."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 235.81,
      "end_seconds": 262.41,
      "duration_seconds": 26.6,
      "text": "Putting together what you've described, I'm honestly not certain yet. It could be difficulty with attention and organisation that needs a fuller assessment, or it might be poor sleep. I'm going to order a thyroid test, for poor concentration. Keep a regular sleep schedule and write down your tasks each morning. Let's get you seen by an adult attention clinic, I'll arrange the letter."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 263.77,
      "end_seconds": 264.47,
      "duration_seconds": 0.7,
      "text": "Okay."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 265.06,
      "end_seconds": 270.1,
      "duration_seconds": 5.04,
      "text": "I'd like to see you again after the results are back."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 271.64,
      "end_seconds": 273.35,
      "duration_seconds": 1.71,
      "text": "Sure, that's doable."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 274.69,
      "end_seconds": 281.22,
      "duration_seconds": 6.53,
      "text": "Let me check I've been clear. What will you do once you get home?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 282.75,
      "end_seconds": 288.79,
      "duration_seconds": 6.04,
      "text": "So, I come back after the results are back. Is that right?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 289.63,
      "end_seconds": 294.34,
      "duration_seconds": 4.71,
      "text": "Yes, exactly right. Right, that's it on my side. Anything unclear?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 296.02,
      "end_seconds": 300.18,
      "duration_seconds": 4.16,
      "text": "That's everything I wanted to ask. Thank you."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 301.39,
      "end_seconds": 302.3,
      "duration_seconds": 0.91,
      "text": "Alright, goodbye."
    }
  ]
}