{
  "schema_version": "1.0",
  "encounter_id": "00330",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.76,
      "end_seconds": 4.82,
      "duration_seconds": 4.06,
      "text": "Right, hi, doctor. Is this the right room?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.48,
      "end_seconds": 11.29,
      "duration_seconds": 4.81,
      "text": "No trouble at all, come in. What's been bothering you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 12.56,
      "end_seconds": 18.44,
      "duration_seconds": 5.88,
      "text": "Hello, doctor. I hope it's alright if I stay in for this."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 19.53,
      "end_seconds": 27.59,
      "duration_seconds": 8.06,
      "text": "Mainly trouble concentrating. There's a couple of other things, but that's the main one."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 29.62,
      "end_seconds": 32.01,
      "duration_seconds": 2.39,
      "text": "How far back does it go?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 32.7,
      "end_seconds": 36.45,
      "duration_seconds": 3.75,
      "text": "So, it's been like this since last night."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 37.34,
      "end_seconds": 39.65,
      "duration_seconds": 2.31,
      "text": "And how severe is it?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 41.49,
      "end_seconds": 44.77,
      "duration_seconds": 3.28,
      "text": "Pretty mild, if I'm being honest."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 45.59,
      "end_seconds": 51.21,
      "duration_seconds": 5.62,
      "text": "I was just going to say that the main thing is—"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_4",
      "role": "NURSE",
      "start_seconds": 51.31,
      "end_seconds": 58.63,
      "duration_seconds": 7.32,
      "text": "Sorry to cut in, doctor, quick question: shall I bring the trolley in now or later?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 59.73,
      "end_seconds": 61.84,
      "duration_seconds": 2.11,
      "text": "Later, thanks. Please go on."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 62.84,
      "end_seconds": 69.22,
      "duration_seconds": 6.38,
      "text": "Oh, and hair falling out. That's been about the same, two days."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 70.96,
      "end_seconds": 76.78,
      "duration_seconds": 5.82,
      "text": "Have you had trouble concentrating before, or is this the first time?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 78.36,
      "end_seconds": 85.22,
      "duration_seconds": 6.86,
      "text": "I had a similar thing a couple of years ago. It went away."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 86.09,
      "end_seconds": 89.35,
      "duration_seconds": 3.26,
      "text": "Have you had chest pain, by any chance?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 91.42,
      "end_seconds": 95.4,
      "duration_seconds": 3.98,
      "text": "No, I haven't had any chest pain."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 96.52,
      "end_seconds": 99.66,
      "duration_seconds": 3.14,
      "text": "Any night sweats or fever at all?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 101.33,
      "end_seconds": 113.25,
      "duration_seconds": 11.92,
      "text": "No, no night sweats, no fever. I did have a bit of weight gain at one point, but that went away on its own."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 114.38,
      "end_seconds": 118.75,
      "duration_seconds": 4.37,
      "text": "Did you get shortness of breath or low mood?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 120.43,
      "end_seconds": 123.76,
      "duration_seconds": 3.33,
      "text": "Well, no, not any of them."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 124.84,
      "end_seconds": 128.13,
      "duration_seconds": 3.29,
      "text": "Has your heart given you any trouble?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 133.3,
      "end_seconds": 136.84,
      "duration_seconds": 3.54,
      "text": "Um, no, nothing with my heart."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 137.37,
      "end_seconds": 139.6,
      "duration_seconds": 2.23,
      "text": "Anything unusual with passing urine?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 145.6,
      "end_seconds": 147.07,
      "duration_seconds": 1.47,
      "text": "Nothing there, no."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 151.08,
      "end_seconds": 155.5,
      "duration_seconds": 4.42,
      "text": "Which tablets or creams or inhalers do you use?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 156.03,
      "end_seconds": 160.05,
      "duration_seconds": 4.02,
      "text": "Glimepiride, 2 milligrams, before breakfast for my sugar."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 164.43,
      "end_seconds": 172.6,
      "duration_seconds": 8.17,
      "text": "Right, he is supposed to take it before breakfast, but I can't say he always does."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 174.6,
      "end_seconds": 183.1,
      "duration_seconds": 8.5,
      "text": "Rosuvastatin, 10 milligrams, at night. I thought it would sort itself out, but it hasn't."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 184.91,
      "end_seconds": 192.05,
      "duration_seconds": 7.14,
      "text": "It's a... um, I can't remember what it's called. It's a small white one."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 193.63,
      "end_seconds": 196.55,
      "duration_seconds": 2.92,
      "text": "Alright, do you remember what it's for?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 198.56,
      "end_seconds": 206.88,
      "duration_seconds": 8.32,
      "text": "For the stent, I believe. My son sets them out for me, I just take what I'm given."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 225.27,
      "end_seconds": 229.86,
      "duration_seconds": 4.59,
      "text": "Tell me about your health in general, any ongoing conditions?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 231.07,
      "end_seconds": 237.52,
      "duration_seconds": 6.45,
      "text": "I've got diabetes. I have high cholesterol. I've had heart disease, yes."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 239.28,
      "end_seconds": 247.05,
      "duration_seconds": 7.77,
      "text": "Alright, diabetes, that matches what I have here. Okay, have you had to have anything operated on?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 247.6,
      "end_seconds": 253.57,
      "duration_seconds": 5.97,
      "text": "Okay, so yes, I had my gallbladder removed, in 2016."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 254.19,
      "end_seconds": 256.68,
      "duration_seconds": 2.49,
      "text": "Before I prescribe anything, any allergies?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 257.77,
      "end_seconds": 267.99,
      "duration_seconds": 10.22,
      "text": "I think I reacted to some antibiotic once, years ago. I don't remember which one, or what happened exactly."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 280.76,
      "end_seconds": 286.21,
      "duration_seconds": 5.45,
      "text": "Tell me about your routine, work, habits, that sort of thing."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 287.76,
      "end_seconds": 299.12,
      "duration_seconds": 11.36,
      "text": "A beer or two most evenings, to be honest. No, I don't smoke and never have. Barely, I'm mostly sedentary these days."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_4",
      "role": "NURSE",
      "start_seconds": 301.21,
      "end_seconds": 309.64,
      "duration_seconds": 8.43,
      "text": "Here are the numbers, doctor. Pressure 113 over 75, temp 36.9 degrees, pulse 72, oxygen saturation is 97 percent."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 310.67,
      "end_seconds": 311.57,
      "duration_seconds": 0.9,
      "text": "Okay, noted."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 313.28,
      "end_seconds": 317.12,
      "duration_seconds": 3.84,
      "text": "Come over here and I'll have a look."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 318.37,
      "end_seconds": 320.77,
      "duration_seconds": 2.4,
      "text": "Let me just check something."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 334.29,
      "end_seconds": 339.29,
      "duration_seconds": 5.0,
      "text": "Your thyroid isn't enlarged, I can't feel any lumps in your neck."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 341.09,
      "end_seconds": 341.79,
      "duration_seconds": 0.7,
      "text": "Fine."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 342.98,
      "end_seconds": 345.25,
      "duration_seconds": 2.27,
      "text": "Let me just check something."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 361.05,
      "end_seconds": 364.39,
      "duration_seconds": 3.34,
      "text": "You look a little pale in the eyelids."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 368.13,
      "end_seconds": 388.93,
      "duration_seconds": 20.8,
      "text": "Good, that's the examination. Okay, thinking it through, I'd lean towards fatigue with no clear cause yet. That's my thinking for now, and it may change as we learn more. I can't rule out anaemia yet. It could also be an underactive thyroid, so we'll keep that open."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 390.02,
      "end_seconds": 393.96,
      "duration_seconds": 3.94,
      "text": "Is this something I'll have for good?"
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 395.95,
      "end_seconds": 412.79,
      "duration_seconds": 16.84,
      "text": "Nothing I've seen today points to an emergency. It looks like fatigue with no clear cause yet. Try to keep a regular sleep time and get some daylight in the morning. Is there anything you wanted to ask?"
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 419.07,
      "end_seconds": 420.45,
      "duration_seconds": 1.38,
      "text": "Right. Thanks again."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 421.77,
      "end_seconds": 422.47,
      "duration_seconds": 0.7,
      "text": "Goodbye."
    }
  ]
}