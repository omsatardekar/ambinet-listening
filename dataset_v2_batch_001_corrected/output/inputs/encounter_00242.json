{
  "schema_version": "1.0",
  "encounter_id": "00242",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.55,
      "end_seconds": 6.17,
      "duration_seconds": 5.62,
      "text": "Good afternoon, doctor, the receptionist said you'd see me now."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 11.93,
      "end_seconds": 16.09,
      "duration_seconds": 4.16,
      "text": "Right on time. Sit, please. How can I help?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 17.26,
      "end_seconds": 31.28,
      "duration_seconds": 14.02,
      "text": "I've, I've been getting breathless walking short distances. I looked a few things up online, and that probably didn't help. I'm hoping you can tell me something definite."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 32.17,
      "end_seconds": 35.58,
      "duration_seconds": 3.41,
      "text": "How long has this been going on?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 36.14,
      "end_seconds": 38.09,
      "duration_seconds": 1.95,
      "text": "Probably three weeks. Yeah."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 43.28,
      "end_seconds": 48.16,
      "duration_seconds": 4.88,
      "text": "Okay, give me more detail on it, whatever comes to mind."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 48.89,
      "end_seconds": 62.3,
      "duration_seconds": 13.41,
      "text": "Only stopping to rest, and it's not much. Maybe a seven out of ten on a bad day. Walking uphill definitely sets it off."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 66.19,
      "end_seconds": 69.47,
      "duration_seconds": 3.28,
      "text": "Anything that tends to go along with it?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 71.35,
      "end_seconds": 74.38,
      "duration_seconds": 3.03,
      "text": "It, It usually comes with tiredness."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 87.82,
      "end_seconds": 91.31,
      "duration_seconds": 3.49,
      "text": "What medicines are you taking at the moment?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 91.94,
      "end_seconds": 97.86,
      "duration_seconds": 5.92,
      "text": "I'm on amlodipine, 5 milligrams, once a day for my pressure."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 98.66,
      "end_seconds": 102.07,
      "duration_seconds": 3.41,
      "text": "Is there anything medical in your background?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 106.92,
      "end_seconds": 116.52,
      "duration_seconds": 9.6,
      "text": "I have high blood pressure, for nearly five years. I did try to ignore it for a while."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 117.77,
      "end_seconds": 119.83,
      "duration_seconds": 2.06,
      "text": "Any operations in the past?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 120.92,
      "end_seconds": 126.06,
      "duration_seconds": 5.14,
      "text": "Yes, I had a hernia repair, about five years back."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 130.04,
      "end_seconds": 132.4,
      "duration_seconds": 2.36,
      "text": "Is anyone at home with you?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 133.41,
      "end_seconds": 136.87,
      "duration_seconds": 3.46,
      "text": "I share a flat with two friends."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 137.63,
      "end_seconds": 139.03,
      "duration_seconds": 1.4,
      "text": "And your work?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 140.2,
      "end_seconds": 143.64,
      "duration_seconds": 3.44,
      "text": "I drive a delivery van all day."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 144.98,
      "end_seconds": 147.08,
      "duration_seconds": 2.1,
      "text": "How do you eat, generally?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 148.88,
      "end_seconds": 151.6,
      "duration_seconds": 2.72,
      "text": "I skip breakfast most days."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 164.05,
      "end_seconds": 169.1,
      "duration_seconds": 5.05,
      "text": "Are there any allergies on your record that I should check?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 169.88,
      "end_seconds": 172.29,
      "duration_seconds": 2.41,
      "text": "No, no allergies to anything."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 188.7,
      "end_seconds": 193.44,
      "duration_seconds": 4.74,
      "text": "Any leg swelling, night sweats or chest pain at all?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 195.15,
      "end_seconds": 199.79,
      "duration_seconds": 4.64,
      "text": "No, no leg swelling, night sweats or chest pain."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 200.6,
      "end_seconds": 203.44,
      "duration_seconds": 2.84,
      "text": "How are your joints, any aches elsewhere?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 204.51,
      "end_seconds": 206.07,
      "duration_seconds": 1.56,
      "text": "Nothing else aches."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 220.46,
      "end_seconds": 223.97,
      "duration_seconds": 3.51,
      "text": "Let's get your blood pressure and the other basics."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 234.68,
      "end_seconds": 236.96,
      "duration_seconds": 2.28,
      "text": "Right, rest your hand here..."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 257.42,
      "end_seconds": 264.4,
      "duration_seconds": 6.98,
      "text": "Okay: saturation 91 percent, temperature 37.0, pulse 85. And respiratory rate 20, pressure 128 over 73."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 266.14,
      "end_seconds": 267.64,
      "duration_seconds": 1.5,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 268.43,
      "end_seconds": 270.78,
      "duration_seconds": 2.35,
      "text": "I'll explain what that means shortly."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 273.12,
      "end_seconds": 276.78,
      "duration_seconds": 3.66,
      "text": "Okay, I need to examine you for this."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 278.67,
      "end_seconds": 282.36,
      "duration_seconds": 3.69,
      "text": "A little pressure here, tell me if it's tender."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 297.23,
      "end_seconds": 301.52,
      "duration_seconds": 4.29,
      "text": "There are fine crackles at the bases of both lungs."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 302.71,
      "end_seconds": 305.1,
      "duration_seconds": 2.39,
      "text": "Bear with me a second."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 318.87,
      "end_seconds": 321.07,
      "duration_seconds": 2.2,
      "text": "No clubbing in the fingers."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 322.49,
      "end_seconds": 323.19,
      "duration_seconds": 0.7,
      "text": "Fine."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 327.36,
      "end_seconds": 354.61,
      "duration_seconds": 27.25,
      "text": "Okay, finished. I think breathing tests makes sense here, for chronic breathlessness. Try a daily walk and note how far you get before you need to stop. Cut down on salt and fried food for now, it really does make a difference. I'd like you to see a chest physician as well, and I'll write the referral."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 355.84,
      "end_seconds": 357.43,
      "duration_seconds": 1.59,
      "text": "Alright, thank you."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 358.29,
      "end_seconds": 371.91,
      "duration_seconds": 13.62,
      "text": "If it hasn't settled in two weeks, we'd think about a CT scan of the chest, but not now. Take care, and call us if anything changes."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 377.09,
      "end_seconds": 381.08,
      "duration_seconds": 3.99,
      "text": "No, I think that's everything. Thank you, doctor."
    }
  ]
}