{
  "schema_version": "1.0",
  "encounter_id": "00023",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.69,
      "end_seconds": 6.32,
      "duration_seconds": 5.63,
      "text": "Right, sorry, doctor, I couldn't find the door at first."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.93,
      "end_seconds": 12.2,
      "duration_seconds": 5.27,
      "text": "of course, put it down anywhere. So, how can I help?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 14.18,
      "end_seconds": 21.28,
      "duration_seconds": 7.1,
      "text": "I wanted to get pain in my left wrist after a fall looked at."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 22.94,
      "end_seconds": 25.56,
      "duration_seconds": 2.62,
      "text": "When did you first notice it?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 26.46,
      "end_seconds": 28.83,
      "duration_seconds": 2.37,
      "text": "probably about a week yeah"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 30.25,
      "end_seconds": 33.47,
      "duration_seconds": 3.22,
      "text": "How bad is it, would you say?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 34.41,
      "end_seconds": 38.48,
      "duration_seconds": 4.07,
      "text": "a seven out of ten, I suppose"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 40.14,
      "end_seconds": 43.36,
      "duration_seconds": 3.22,
      "text": "Has there been tingling in the fingers too?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 47.27,
      "end_seconds": 55.8,
      "duration_seconds": 8.53,
      "text": "Yeah, I've had that since last weekend. As for tingling in the fingers, I'd call it moderate."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 56.39,
      "end_seconds": 57.09,
      "duration_seconds": 0.7,
      "text": "Mm."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 70.19,
      "end_seconds": 75.56,
      "duration_seconds": 5.37,
      "text": "A few quick ones: deformity, bump to the head or loss of consciousness?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 76.51,
      "end_seconds": 79.6,
      "duration_seconds": 3.09,
      "text": "no, none of that at all"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 81.37,
      "end_seconds": 82.7,
      "duration_seconds": 1.33,
      "text": "nothing like numbness?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 83.7,
      "end_seconds": 86.08,
      "duration_seconds": 2.38,
      "text": "no, uh, no numbness"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 86.73,
      "end_seconds": 88.43,
      "duration_seconds": 1.7,
      "text": "How's your breathing otherwise?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 89.49,
      "end_seconds": 90.57,
      "duration_seconds": 1.08,
      "text": "Breathing's normal."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 91.47,
      "end_seconds": 93.83,
      "duration_seconds": 2.36,
      "text": "Anything unusual with passing urine?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 96.49,
      "end_seconds": 99.86,
      "duration_seconds": 3.37,
      "text": "That's normal as far as I know."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 105.53,
      "end_seconds": 108.4,
      "duration_seconds": 2.87,
      "text": "What medicines do you take regularly?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 111.65,
      "end_seconds": 116.46,
      "duration_seconds": 4.81,
      "text": "Alendronate, 70 milligrams, once a week for my bones."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 116.83,
      "end_seconds": 117.53,
      "duration_seconds": 0.7,
      "text": "Mhm."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 121.97,
      "end_seconds": 124.74,
      "duration_seconds": 2.77,
      "text": "I take paracetamol, when needed."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 126.06,
      "end_seconds": 128.05,
      "duration_seconds": 1.99,
      "text": "Do you know the dose?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 128.6,
      "end_seconds": 129.52,
      "duration_seconds": 0.92,
      "text": "500 milligrams."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 144.21,
      "end_seconds": 149.02,
      "duration_seconds": 4.81,
      "text": "What about family history, any illnesses that run in the family?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 151.09,
      "end_seconds": 154.17,
      "duration_seconds": 3.08,
      "text": "my father had a heart attack"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 172.17,
      "end_seconds": 173.37,
      "duration_seconds": 1.2,
      "text": "How's your diet?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 175.03,
      "end_seconds": 176.6,
      "duration_seconds": 1.57,
      "text": "I'm mostly vegetarian."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 180.18,
      "end_seconds": 182.58,
      "duration_seconds": 2.4,
      "text": "do you have a job?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 183.83,
      "end_seconds": 185.63,
      "duration_seconds": 1.8,
      "text": "I'm a self-employed electrician."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 187.47,
      "end_seconds": 192.26,
      "duration_seconds": 4.79,
      "text": "Are there any allergies on your record that I should check?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 193.79,
      "end_seconds": 197.12,
      "duration_seconds": 3.33,
      "text": "I'm allergic to peanuts, I get hives"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 197.74,
      "end_seconds": 201.86,
      "duration_seconds": 4.12,
      "text": "tell me about your health in general, any ongoing conditions?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 203.68,
      "end_seconds": 206.72,
      "duration_seconds": 3.04,
      "text": "Thin bones, for nearly five years"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 210.66,
      "end_seconds": 213.07,
      "duration_seconds": 2.41,
      "text": "Let me check your vitals now."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 223.71,
      "end_seconds": 224.51,
      "duration_seconds": 0.8,
      "text": "one second.."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 245.64,
      "end_seconds": 252.93,
      "duration_seconds": 7.29,
      "text": "Okay: pulse is 71 beats a minute, oxygen saturation is 99 percent, pressure 119 over 73."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 255.64,
      "end_seconds": 258.29,
      "duration_seconds": 2.65,
      "text": "I'd like to examine you now."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 261.01,
      "end_seconds": 261.71,
      "duration_seconds": 0.7,
      "text": "fine"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 263.68,
      "end_seconds": 266.47,
      "duration_seconds": 2.79,
      "text": "Let me look at this properly."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 275.01,
      "end_seconds": 280.75,
      "duration_seconds": 5.74,
      "text": "There's swelling and tenderness at the base of the thumb side of the wrist."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 282.03,
      "end_seconds": 286.03,
      "duration_seconds": 4.0,
      "text": "a little pressure here, tell me if it's tender"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 294.41,
      "end_seconds": 298.2,
      "duration_seconds": 3.79,
      "text": "Fingers have good colour and the pulses are fine."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 300.31,
      "end_seconds": 315.88,
      "duration_seconds": 15.57,
      "text": "Okay, finished. Having listened and examined, I think we're dealing with a wrist sprain, but a small fracture is possible at this stage. That's my thinking for now, and it it may change as we learn more."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 316.47,
      "end_seconds": 319.62,
      "duration_seconds": 3.15,
      "text": "Is this going to go away?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 320.15,
      "end_seconds": 330.99,
      "duration_seconds": 10.84,
      "text": "I can't promise yet, but most people with a wrist sprain, but a small fracture is possible do well once it's treated properly."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 340.53,
      "end_seconds": 345.5,
      "duration_seconds": 4.97,
      "text": "I want an X-ray of the wrist done, that's for wrist injury."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 347.18,
      "end_seconds": 349.62,
      "duration_seconds": 2.44,
      "text": "the earliest is Wednesday, 9 am"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 351.38,
      "end_seconds": 369.22,
      "duration_seconds": 17.84,
      "text": "I'd like you to wear a splint until the X-ray result is confirmed and keep the hand raised keep an eye out, and if the symptoms get worse, call us the same day or go to emergency let's plan a check in a week"
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 370.1,
      "end_seconds": 372.16,
      "duration_seconds": 2.06,
      "text": "Okay, see you then."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 374.18,
      "end_seconds": 375.54,
      "duration_seconds": 1.36,
      "text": "Look after yourself."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 376.84,
      "end_seconds": 379.16,
      "duration_seconds": 2.32,
      "text": "I appreciate it, doctor"
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 380.37,
      "end_seconds": 381.29,
      "duration_seconds": 0.92,
      "text": "Take care."
    }
  ]
}