{
  "schema_version": "1.0",
  "encounter_id": "00044",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.05,
      "end_seconds": 5.95,
      "duration_seconds": 4.9,
      "text": "Sorry I'm a few minutes behind, you know, doctor."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.09,
      "end_seconds": 10.46,
      "duration_seconds": 3.37,
      "text": "Not at all, please sit. What's the problem?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 13.93,
      "end_seconds": 22.51,
      "duration_seconds": 8.58,
      "text": "Okay, so mainly pain on swallowing. There's a couple of other things, but that's the main one."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 23.28,
      "end_seconds": 25.01,
      "duration_seconds": 1.73,
      "text": "Let's do your observations."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 31.72,
      "end_seconds": 34.24,
      "duration_seconds": 2.52,
      "text": "Okay, give me a moment..."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 44.33,
      "end_seconds": 57.13,
      "duration_seconds": 12.8,
      "text": "Okay: temperature 39.1, BMI works out to 22.0, saturation 96 percent, height 161 centimetres, BP is 104 over 76, weight 57 kilos, heart rate 107."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 58.27,
      "end_seconds": 59.74,
      "duration_seconds": 1.47,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 60.79,
      "end_seconds": 65.31,
      "duration_seconds": 4.52,
      "text": "I'll interpret it once I've examined you. When did it begin?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 67.37,
      "end_seconds": 75.46,
      "duration_seconds": 8.09,
      "text": "Yeah, probably about a week. Yeah. I'm not great at remembering details, so bear with me."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 77.46,
      "end_seconds": 79.83,
      "duration_seconds": 2.37,
      "text": "How often does it happen?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 80.81,
      "end_seconds": 84.56,
      "duration_seconds": 3.75,
      "text": "It, It happens on and off."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 85.54,
      "end_seconds": 89.17,
      "duration_seconds": 3.63,
      "text": "Has there been swollen glands in the neck too?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 90.83,
      "end_seconds": 96.04,
      "duration_seconds": 5.21,
      "text": "Okay, you know, so yeah. Ten days, I'd say."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 97.15,
      "end_seconds": 99.56,
      "duration_seconds": 2.41,
      "text": "Right, how about runny nose?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 100.56,
      "end_seconds": 105.62,
      "duration_seconds": 5.06,
      "text": "No, uh, I haven't had any runny nose."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 105.88,
      "end_seconds": 111.53,
      "duration_seconds": 5.65,
      "text": "Right, right. Okay, and what about ear pain, cough or drooling?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 113.12,
      "end_seconds": 117.52,
      "duration_seconds": 4.4,
      "text": "No, no ear pain, cough or drooling."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 119.14,
      "end_seconds": 122.89,
      "duration_seconds": 3.75,
      "text": "On the cardiac side, anything I should know?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 124.32,
      "end_seconds": 127.82,
      "duration_seconds": 3.5,
      "text": "Okay, so no, that's been fine."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 128.58,
      "end_seconds": 132.92,
      "duration_seconds": 4.34,
      "text": "Any change in your bowel habit or your stomach generally?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 133.93,
      "end_seconds": 136.1,
      "duration_seconds": 2.17,
      "text": "No, all normal there."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 138.81,
      "end_seconds": 142.92,
      "duration_seconds": 4.11,
      "text": "Anyone in the family with similar problems or other conditions?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 144.22,
      "end_seconds": 147.25,
      "duration_seconds": 3.03,
      "text": "My father had a stroke."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 155.2,
      "end_seconds": 157.98,
      "duration_seconds": 2.78,
      "text": "Have you ever been under the knife?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 158.52,
      "end_seconds": 165.83,
      "duration_seconds": 7.31,
      "text": "Okay, so I had my thyroid operated on a long time ago."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 167.63,
      "end_seconds": 172.5,
      "duration_seconds": 4.87,
      "text": "Right, tell me about your health in general, any ongoing conditions?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 173.88,
      "end_seconds": 187.15,
      "duration_seconds": 13.27,
      "text": "Oh, I have asthma. I just want to get back to normal, really. My sister suggested writing things down, but I forgot."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 189.13,
      "end_seconds": 193.42,
      "duration_seconds": 4.29,
      "text": "Let's go through your medication. What are you taking?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 194.67,
      "end_seconds": 202.56,
      "duration_seconds": 7.89,
      "text": "Asthalin inhaler. I take it when needed. I take paracetamol, 500 milligrams, when needed."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 204.03,
      "end_seconds": 205.78,
      "duration_seconds": 1.75,
      "text": "And alcohol, how much?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 206.68,
      "end_seconds": 211.84,
      "duration_seconds": 5.16,
      "text": "A beer or two most evenings, to be honest."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 212.77,
      "end_seconds": 214.21,
      "duration_seconds": 1.44,
      "text": "Alright, any smoking?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 216.1,
      "end_seconds": 221.32,
      "duration_seconds": 5.22,
      "text": "I used to smoke but I quit five years ago."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 222.69,
      "end_seconds": 223.98,
      "duration_seconds": 1.29,
      "text": "How's your diet?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 225.68,
      "end_seconds": 227.21,
      "duration_seconds": 1.53,
      "text": "I'm mostly vegetarian."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 228.24,
      "end_seconds": 231.11,
      "duration_seconds": 2.87,
      "text": "What do you do to keep active?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 233.01,
      "end_seconds": 236.61,
      "duration_seconds": 3.6,
      "text": "I cycle to work most mornings."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 237.43,
      "end_seconds": 240.25,
      "duration_seconds": 2.82,
      "text": "So, are you living with family?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 242.21,
      "end_seconds": 246.19,
      "duration_seconds": 3.98,
      "text": "I stay with my daughter and her family."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 247.37,
      "end_seconds": 249.81,
      "duration_seconds": 2.44,
      "text": "Any allergies I should know about?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 251.6,
      "end_seconds": 255.54,
      "duration_seconds": 3.94,
      "text": "No allergies that I know of, no."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 257.85,
      "end_seconds": 261.36,
      "duration_seconds": 3.51,
      "text": "Come over here and I'll have a look."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 262.74,
      "end_seconds": 265.07,
      "duration_seconds": 2.33,
      "text": "Hold that position for me."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 276.17,
      "end_seconds": 283.06,
      "duration_seconds": 6.89,
      "text": "Both tonsils are red and swollen, and there are white patches on the left one."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 283.9,
      "end_seconds": 286.14,
      "duration_seconds": 2.24,
      "text": "Just relax, I'll be quick."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 294.31,
      "end_seconds": 297.76,
      "duration_seconds": 3.45,
      "text": "The glands under the jaw are tender."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 302.6,
      "end_seconds": 304.77,
      "duration_seconds": 2.17,
      "text": "Okay, you can sit up."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 313.53,
      "end_seconds": 320.01,
      "duration_seconds": 6.48,
      "text": "Right, here's what I'm thinking. My working impression is a throat infection, either bacterial or viral."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 321.18,
      "end_seconds": 325.53,
      "duration_seconds": 4.35,
      "text": "Uh, should I be worried about this?"
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 327.52,
      "end_seconds": 345.11,
      "duration_seconds": 17.59,
      "text": "I can't promise yet, but most people with a throat infection, either bacterial or viral do well once it's treated properly. So, to recap quickly. You've had pain on swallowing for about a week, and no drooling or ear pain."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 345.8,
      "end_seconds": 346.5,
      "duration_seconds": 0.7,
      "text": "Exactly."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 360.75,
      "end_seconds": 399.55,
      "duration_seconds": 38.8,
      "text": "We should do a throat swab for sore throat. What I'm giving you is azithromycin, 500 milligrams, once a day, for three days. You take it by mouth. That should help with throat infection. Finish the whole course of antibiotics even if you feel better after two days. Gargle with warm salt water a few times a day, it does soothe it. Please come and see me in a week. Okay, I think we're finished. Is everything clear?"
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 401.24,
      "end_seconds": 403.63,
      "duration_seconds": 2.39,
      "text": "No questions. Thank you."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 404.29,
      "end_seconds": 405.74,
      "duration_seconds": 1.45,
      "text": "Bye for now."
    }
  ]
}