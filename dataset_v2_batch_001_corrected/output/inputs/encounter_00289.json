      "role": "PATIENT",
      "start_seconds": 18.9,
      "end_seconds": 24.76,
      "duration_seconds": 5.86,
      "text": "About two weeks I think... sorry three weeks I got that wrong."
    },
    {
      "segment_id": "SEG0006",
