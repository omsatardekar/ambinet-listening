  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.63,
      "end_seconds": 6.35,
      "duration_seconds": 5.72,
      "text": "Good evening, um, doctor, thank you for staying late."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.4,
      "end_seconds": 11.67,
      "duration_seconds": 4.27,
      "text": "You're fine, sit down. So, what brings you in?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 12.41,
      "end_seconds": 16.43,
      "duration_seconds": 4.02,
      "text": "I've been dealing with more breathlessness than usual"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 17.44,
      "end_seconds": 19.92,
      "duration_seconds": 2.48,
      "text": "How long have you had it?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 24.29,
      "end_seconds": 30.91,
      "duration_seconds": 6.62,
      "text": "Ten days, I think... sorry, about four days, I got that wrong."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 32.32,
      "end_seconds": 36.87,
      "duration_seconds": 4.55,
      "text": "Okay, give me more detail on it, whatever comes to mind."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 37.79,
      "end_seconds": 45.81,
      "duration_seconds": 8.02,
      "text": "Yes, stairs. That makes it it worse. It's every other day. I get some relief from resting."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 47.23,
      "end_seconds": 51.48,
      "duration_seconds": 4.25,
      "text": "Okay, any poor sleep because of the cough as well?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 52.78,
      "end_seconds": 71.46,
      "duration_seconds": 18.68,
      "text": "Yes, I have. About poor sleep because of the cough, honestly, a couple of times a week. Oh, and a rattling chest. Hmm, as for rattling chest, it feels mild to me."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 72.76,
      "end_seconds": 75.42,
      "duration_seconds": 2.66,
      "text": "And swollen ankles, any of that?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 76.85,
      "end_seconds": 78.88,
      "duration_seconds": 2.03,
      "text": "No. No swollen ankles."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 82.95,
      "end_seconds": 88.43,
      "duration_seconds": 5.48,
      "text": "And what about weight loss, chest pain or coughing up blood?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 90.34,
      "end_seconds": 96.74,
      "duration_seconds": 6.4,
      "text": "I haven't had weight loss, chest pain or coughing up blood, no"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 97.75,
      "end_seconds": 101.14,
      "duration_seconds": 3.39,
      "text": "On the cardiac side, anything I should know?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 102.49,
      "end_seconds": 105.07,
      "duration_seconds": 2.58,
      "text": "No, nothing with my heart."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 117.32,
      "end_seconds": 122.26,
      "duration_seconds": 4.94,
      "text": "Are there any allergies on your record that I should check?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 123.27,
      "end_seconds": 132.26,
      "duration_seconds": 8.99,
      "text": "Yes, eggs. I've no idea what the reaction was, only that I'm not supposed to have it."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 142.59,
      "end_seconds": 146.44,
      "duration_seconds": 3.85,
      "text": "Do your parents or siblings have any long-term illnesses?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 147.65,
      "end_seconds": 150.41,
      "duration_seconds": 2.76,
      "text": "My father had kidney stones."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 151.27,
      "end_seconds": 157.33,
      "duration_seconds": 6.06,
      "text": "Right, what about your general health, any conditions you're being treated for?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 158.5,
      "end_seconds": 162.0,
      "duration_seconds": 3.5,
      "text": "I've had COPD for two years now."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 163.33,
      "end_seconds": 167.64,
      "duration_seconds": 4.31,
      "text": "Any medication at the moment, including things from the pharmacy?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 168.84,
      "end_seconds": 173.23,
      "duration_seconds": 4.39,
      "text": "Tiotropium inhaler, once a day for my chest."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 174.86,
      "end_seconds": 179.56,
      "duration_seconds": 4.7,
      "text": "tell me about your routine, work, habits, that sort of thing"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 183.82,
      "end_seconds": 199.91,
      "duration_seconds": 16.09,
      "text": "Barely, I'm mostly sedentary these days. I run a small shop, so I'm on my feet a lot. I live with my family, my husband and two kids."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 215.86,
      "end_seconds": 218.57,
      "duration_seconds": 2.71,
      "text": "I'll check your pressure and pulse."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 229.84,
      "end_seconds": 231.53,
      "duration_seconds": 1.69,
      "text": "hold still for me.."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 242.06,
      "end_seconds": 253.3,
      "duration_seconds": 11.24,
      "text": "Okay: saturation 90 percent, temperature is 37.0 degrees. And blood pressure 142 over 72, weight 80 kilos, respiratory rate 22, height 162 centimetres, pulse 93."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 254.93,
      "end_seconds": 258.29,
      "duration_seconds": 3.36,
      "text": "Come over here and I'll have a look."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 259.55,
      "end_seconds": 261.33,
      "duration_seconds": 1.78,
      "text": "Let me press here."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 275.69,
      "end_seconds": 281.31,
      "duration_seconds": 5.62,
      "text": "Air entry is reduced on both sides with a prolonged breathing out phase."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 283.76,
      "end_seconds": 315.2,
      "duration_seconds": 31.44,
      "text": "thanks, please take a seat again. Having listened and examined, this looks most like a flare-up of COPD. I'd like to arrange blood tests for infective exacerbation. For this, prednisolone, 30 milligrams, once a day, for five days. You take it by mouth. That's for COPD flare-up. I'm prescribing doxycycline, 100 milligrams, twice a day, for five days. That's for chest infection. Please take the tablets with food so they don't upset your stomach"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 318.62,
      "end_seconds": 324.95,
      "duration_seconds": 6.33,
      "text": "Do get help quickly if you become more breathless or your lips turn blue."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 327.0,
      "end_seconds": 328.53,
      "duration_seconds": 1.53,
      "text": "Okay, I understand."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 329.36,
      "end_seconds": 335.33,
      "duration_seconds": 5.97,
      "text": "I'll want another look in one week okay, we're done for today take care"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 337.08,
      "end_seconds": 339.24,
      "duration_seconds": 2.16,
      "text": "No questions. Thank you."
    }
  ]
}