{
  "schema_version": "1.0",
  "encounter_id": "00308",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.92,
      "end_seconds": 6.05,
      "duration_seconds": 5.13,
      "text": "Good afternoon, doctor, the receptionist said you'd see me now."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.79,
      "end_seconds": 10.96,
      "duration_seconds": 4.17,
      "text": "Right on time. Sit, please. How can I help?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 11.75,
      "end_seconds": 15.52,
      "duration_seconds": 3.77,
      "text": "Well, I've been having nausea in the mornings."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 17.32,
      "end_seconds": 21.2,
      "duration_seconds": 3.88,
      "text": "Is this recent, or has it been a while?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 24.52,
      "end_seconds": 27.33,
      "duration_seconds": 2.81,
      "text": "It's been about three months now."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 28.55,
      "end_seconds": 31.38,
      "duration_seconds": 2.83,
      "text": "Does it come along with anything else?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 32.47,
      "end_seconds": 41.83,
      "duration_seconds": 9.36,
      "text": "Tender breasts goes along with it, most of the time. The tender breasts? That's been for about two weeks."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 42.34,
      "end_seconds": 48.46,
      "duration_seconds": 6.12,
      "text": "Have you had nausea in the mornings before, or is this the first time?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 49.78,
      "end_seconds": 56.66,
      "duration_seconds": 6.88,
      "text": "A bit, a couple of years ago. It settled by itself back then."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 57.73,
      "end_seconds": 62.33,
      "duration_seconds": 4.6,
      "text": "Any vomiting everything, burning when passing urine, bleeding or fever?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 63.36,
      "end_seconds": 66.62,
      "duration_seconds": 3.26,
      "text": "No, none of that at all."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 68.7,
      "end_seconds": 70.68,
      "duration_seconds": 1.98,
      "text": "Nothing like severe abdominal pain?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 72.48,
      "end_seconds": 74.97,
      "duration_seconds": 2.49,
      "text": "No, no severe abdominal pain."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 75.28,
      "end_seconds": 78.25,
      "duration_seconds": 2.97,
      "text": "Understood. Your breathing, any trouble there?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 79.15,
      "end_seconds": 81.03,
      "duration_seconds": 1.88,
      "text": "No problems with breathing."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 82.91,
      "end_seconds": 85.8,
      "duration_seconds": 2.89,
      "text": "And your skin, any changes there?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 86.99,
      "end_seconds": 87.92,
      "duration_seconds": 0.93,
      "text": "No rashes."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 98.22,
      "end_seconds": 102.71,
      "duration_seconds": 4.49,
      "text": "Let's talk a little about your daily life and habits."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 103.53,
      "end_seconds": 115.17,
      "duration_seconds": 11.64,
      "text": "No, I don't smoke and never have. I'm mostly vegetarian. It's just me and my wife at home now. I play badminton on Sundays."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 116.2,
      "end_seconds": 119.8,
      "duration_seconds": 3.6,
      "text": "Which tablets or creams or inhalers do you use?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 121.29,
      "end_seconds": 127.8,
      "duration_seconds": 6.51,
      "text": "It's Thyronorm, 50 micrograms, every morning. Iron tablets, once a day."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 128.93,
      "end_seconds": 134.74,
      "duration_seconds": 5.81,
      "text": "Have you ever reacted badly to a medicine or food? Any allergies?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 136.67,
      "end_seconds": 140.86,
      "duration_seconds": 4.19,
      "text": "I'm allergic to penicillin, I get a rash."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 152.78,
      "end_seconds": 157.63,
      "duration_seconds": 4.85,
      "text": "Tell me about your health in general, any ongoing conditions?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 159.54,
      "end_seconds": 161.93,
      "duration_seconds": 2.39,
      "text": "Yes, an underactive thyroid."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 163.39,
      "end_seconds": 164.09,
      "duration_seconds": 0.7,
      "text": "Understood."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 165.88,
      "end_seconds": 169.71,
      "duration_seconds": 3.83,
      "text": "I have low haemoglobin, for two years."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 174.91,
      "end_seconds": 176.15,
      "duration_seconds": 1.24,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 177.46,
      "end_seconds": 182.14,
      "duration_seconds": 4.68,
      "text": "Just my tonsils out, when I was a child."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 194.63,
      "end_seconds": 197.16,
      "duration_seconds": 2.53,
      "text": "Let me check your vitals now."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 209.25,
      "end_seconds": 211.12,
      "duration_seconds": 1.87,
      "text": "Rest your hand here..."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 223.18,
      "end_seconds": 232.35,
      "duration_seconds": 9.17,
      "text": "Okay: pressure 122 over 69, SpO2 99 percent on room air, respiratory rate 17, temp 36.6 degrees, pulse 67."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 233.81,
      "end_seconds": 236.82,
      "duration_seconds": 3.01,
      "text": "Let me examine, it won't take long."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 237.71,
      "end_seconds": 240.44,
      "duration_seconds": 2.73,
      "text": "Let me look at this properly."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 253.25,
      "end_seconds": 260.12,
      "duration_seconds": 6.87,
      "text": "Tummy is soft, non-tender, and the uterus isn't palpable above the pelvic bone yet."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 265.68,
      "end_seconds": 271.49,
      "duration_seconds": 5.81,
      "text": "Thanks for that. Putting it all together, I'd lean towards an early pregnancy."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 272.63,
      "end_seconds": 274.6,
      "duration_seconds": 1.97,
      "text": "Doctor, is this dangerous?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 275.91,
      "end_seconds": 288.43,
      "duration_seconds": 12.52,
      "text": "I can't promise yet, but most people with an early pregnancy do well once it's treated properly. I'd like to arrange an early scan for early pregnancy."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 289.78,
      "end_seconds": 293.92,
      "duration_seconds": 4.14,
      "text": "We have a slot Thursday at 2 pm, if that works."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 295.5,
      "end_seconds": 297.68,
      "duration_seconds": 2.18,
      "text": "Okay, I'll be there."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 298.72,
      "end_seconds": 328.54,
      "duration_seconds": 29.82,
      "text": "I'm going to put you on folic acid, 5 milligrams, once a day, until twelve weeks. It's for pregnancy. Small, frequent meals and dry crackers before getting out of bed can calm the morning nausea. Let's hold off on blood tests for now, and if there's no change next month we can revisit it. I'd like to see you again in four weeks. Okay, I think we're finished. Is everything clear?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 332.39,
      "end_seconds": 334.7,
      "duration_seconds": 2.31,
      "text": "Thank you for your time."
    }
  ]
}