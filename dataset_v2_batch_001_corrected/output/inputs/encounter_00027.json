{
  "schema_version": "1.0",
  "encounter_id": "00027",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.12,
      "end_seconds": 6.07,
      "duration_seconds": 4.95,
      "text": "hello? Doctor? They told me to come straight in"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.05,
      "end_seconds": 11.04,
      "duration_seconds": 3.99,
      "text": "You're fine, sit down. So, what brings you in?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 12.04,
      "end_seconds": 20.75,
      "duration_seconds": 8.71,
      "text": "Yeah, you know, hello, doctor. I hope it's alright if I stay in for this."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 21.63,
      "end_seconds": 25.71,
      "duration_seconds": 4.08,
      "text": "Of course, please stay. It's helpful to have you here."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 26.79,
      "end_seconds": 31.25,
      "duration_seconds": 4.46,
      "text": "So, I've been feeling very thirsty, doctor."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 32.7,
      "end_seconds": 37.29,
      "duration_seconds": 4.59,
      "text": "Any medication at the moment, including things from the pharmacy?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 38.13,
      "end_seconds": 48.92,
      "duration_seconds": 10.79,
      "text": "I mean, it's sertraline, 50 milligrams, once a day for my mood. Oh, it's alendronate, 70 milligrams, once a week"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 50.82,
      "end_seconds": 53.91,
      "duration_seconds": 3.09,
      "text": "How long has that been going on?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 55.22,
      "end_seconds": 56.82,
      "duration_seconds": 1.6,
      "text": "For two months."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 58.86,
      "end_seconds": 60.93,
      "duration_seconds": 2.07,
      "text": "and when did that start?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 61.84,
      "end_seconds": 65.68,
      "duration_seconds": 3.84,
      "text": "Well, I'd say three days, maybe."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 66.19,
      "end_seconds": 70.24,
      "duration_seconds": 4.05,
      "text": "Oh, it was closer to five days, doctor."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 70.88,
      "end_seconds": 75.11,
      "duration_seconds": 4.23,
      "text": "okay, so roughly three to five days is that right?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 76.57,
      "end_seconds": 78.67,
      "duration_seconds": 2.1,
      "text": "That sounds about right."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 80.39,
      "end_seconds": 82.74,
      "duration_seconds": 2.35,
      "text": "And how severe is it?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 83.48,
      "end_seconds": 87.05,
      "duration_seconds": 3.57,
      "text": "Well, it feels mild to me."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 87.64,
      "end_seconds": 90.76,
      "duration_seconds": 3.12,
      "text": "Does it come along with anything else?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 92.45,
      "end_seconds": 108.76,
      "duration_seconds": 16.31,
      "text": "Itching around the private area goes along with it, most of the time. I've also been going to the toilet a lot, even at night, for about a month."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 118.28,
      "end_seconds": 121.04,
      "duration_seconds": 2.76,
      "text": "Did you get breathlessness or abdominal pain?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 122.31,
      "end_seconds": 124.31,
      "duration_seconds": 2.0,
      "text": "No. None of those."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 126.07,
      "end_seconds": 128.94,
      "duration_seconds": 2.87,
      "text": "Have you had vomiting, by any chance?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 129.81,
      "end_seconds": 131.6,
      "duration_seconds": 1.79,
      "text": "Definitely no vomiting."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 132.33,
      "end_seconds": 137.32,
      "duration_seconds": 4.99,
      "text": "Actually, doctor, I did notice vomiting. He doesn't always say."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 138.53,
      "end_seconds": 147.17,
      "duration_seconds": 8.64,
      "text": "uh, no, I don't think I did maybe a little, I'm not sure"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 148.5,
      "end_seconds": 154.74,
      "duration_seconds": 6.24,
      "text": "Alright, I'll note both what you've said and what you've noticed. Alright, nothing like fever?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 156.08,
      "end_seconds": 160.08,
      "duration_seconds": 4.0,
      "text": "Yeah, um, I haven't noticed any fever."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 161.64,
      "end_seconds": 164.1,
      "duration_seconds": 2.46,
      "text": "Your breathing, any trouble there?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 165.35,
      "end_seconds": 167.31,
      "duration_seconds": 1.96,
      "text": "no, nothing there"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 168.72,
      "end_seconds": 171.32,
      "duration_seconds": 2.6,
      "text": "Alright, do you exercise at all?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 173.94,
      "end_seconds": 180.23,
      "duration_seconds": 6.29,
      "text": "I go to the gym a couple of times a week."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 181.0,
      "end_seconds": 182.32,
      "duration_seconds": 1.32,
      "text": "how's your diet?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 184.16,
      "end_seconds": 185.83,
      "duration_seconds": 1.67,
      "text": "I'm mostly vegetarian"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 187.84,
      "end_seconds": 189.81,
      "duration_seconds": 1.97,
      "text": "do you live alone?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 190.36,
      "end_seconds": 193.52,
      "duration_seconds": 3.16,
      "text": "Yes, I live on my own"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 210.35,
      "end_seconds": 213.27,
      "duration_seconds": 2.92,
      "text": "Have you ever been under the knife?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 215.13,
      "end_seconds": 220.47,
      "duration_seconds": 5.34,
      "text": "yes, I had a knee arthroscopy, three years ago"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 221.71,
      "end_seconds": 228.56,
      "duration_seconds": 6.85,
      "text": "moving on to your background, any past medical history? Take your time, there's no rush"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 234.67,
      "end_seconds": 238.53,
      "duration_seconds": 3.86,
      "text": "I've got depression i have thin bones"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 239.39,
      "end_seconds": 240.92,
      "duration_seconds": 1.53,
      "text": "Right, any more?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 245.55,
      "end_seconds": 254.01,
      "duration_seconds": 8.46,
      "text": "Right, so thin bones is already on your record. We'll keep that in mind today. Before I prescribe anything, any allergies?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 255.82,
      "end_seconds": 264.67,
      "duration_seconds": 8.85,
      "text": "Um, years back I got vomiting from codeine, so I stay away from it now."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 281.88,
      "end_seconds": 284.21,
      "duration_seconds": 2.33,
      "text": "Can I take your vitals now?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 296.66,
      "end_seconds": 298.0,
      "duration_seconds": 1.34,
      "text": "Alright, one second..."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 313.76,
      "end_seconds": 322.13,
      "duration_seconds": 8.37,
      "text": "okay: BP is 109 over 77, temperature 36.4, pulse 86, saturation 97 percent, respiratory rate 14."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 323.42,
      "end_seconds": 325.54,
      "duration_seconds": 2.12,
      "text": "Is that that okay?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 326.12,
      "end_seconds": 329.8,
      "duration_seconds": 3.68,
      "text": "Don't worry, I'll go through it in a moment."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 331.51,
      "end_seconds": 335.06,
      "duration_seconds": 3.55,
      "text": "Okay, I need to examine you for this."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 336.26,
      "end_seconds": 336.96,
      "duration_seconds": 0.7,
      "text": "Alright."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 337.96,
      "end_seconds": 340.42,
      "duration_seconds": 2.46,
      "text": "Just relax, I'll be quick."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 359.04,
      "end_seconds": 364.22,
      "duration_seconds": 5.18,
      "text": "you're a little dry, but alert, and your breathing is normal"
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 365.4,
      "end_seconds": 367.41,
      "duration_seconds": 2.01,
      "text": "Let me just check something."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 383.35,
      "end_seconds": 386.29,
      "duration_seconds": 2.94,
      "text": "Your tummy is soft and non-tender."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 390.37,
      "end_seconds": 402.3,
      "duration_seconds": 11.93,
      "text": "okay, finished right, here's what I'm thinking i'm honestly not certain yet it could be possible new-onset diabetes, or it might be diabetes insipidus"
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 403.35,
      "end_seconds": 407.47,
      "duration_seconds": 4.12,
      "text": "Yeah, what are the chances it's something bad?"
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 408.42,
      "end_seconds": 426.21,
      "duration_seconds": 17.79,
      "text": "I understand the worry. At the moment I'd say it's possible new-onset diabetes, and we'll know more once the an HbA1c is back. Just to be sure I understood. You've been feeling very thirsty, mild, and no breathlessness or abdominal pain."
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 428.2,
      "end_seconds": 431.01,
      "duration_seconds": 2.81,
      "text": "Right, yes, you've got it."
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 431.95,
      "end_seconds": 450.92,
      "duration_seconds": 18.97,
      "text": "I'm sending you for an HbA1c because of possible diabetes. I'm sending you for a blood sugar test because of polydipsia and polyuria. Until we have the results, avoid sugary drinks and fruit juices, and keep drinking plain water."
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 452.28,
      "end_seconds": 459.21,
      "duration_seconds": 6.93,
      "text": "Oh, uh, do I need a urine test? I read it might help."
    },
    {
      "segment_id": "SEG0059",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 460.14,
      "end_seconds": 468.85,
      "duration_seconds": 8.71,
      "text": "Not right now, it wouldn't change what we do today. Book a review after the results are back. Any last questions?"
    },
    {
      "segment_id": "SEG0060",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 470.19,
      "end_seconds": 471.81,
      "duration_seconds": 1.62,
      "text": "right. Thanks again"
    }
  ]
}