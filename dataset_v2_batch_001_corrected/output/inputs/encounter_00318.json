{
  "schema_version": "1.0",
  "encounter_id": "00318",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.96,
      "end_seconds": 6.75,
      "duration_seconds": 5.79,
      "text": "So, um, excuse me, doctor, should I sit here?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.36,
      "end_seconds": 10.69,
      "duration_seconds": 3.33,
      "text": "Yes, do sit. Tell me what's been happening."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 12.66,
      "end_seconds": 17.97,
      "duration_seconds": 5.31,
      "text": "Morning, doctor. I'll stay and fill in anything that's missed."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 20.06,
      "end_seconds": 24.49,
      "duration_seconds": 4.43,
      "text": "Um, so... constipation. That's why I came."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_4",
      "role": "NURSE",
      "start_seconds": 25.15,
      "end_seconds": 33.15,
      "duration_seconds": 8.0,
      "text": "Here are the numbers, doctor. Pressure 120 over 68, temperature 36.6, saturation 99 percent, pulse is 83 beats a minute."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 33.68,
      "end_seconds": 36.63,
      "duration_seconds": 2.95,
      "text": "Thanks. How long have you had it?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 38.53,
      "end_seconds": 40.49,
      "duration_seconds": 1.96,
      "text": "About... well, two years."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 41.69,
      "end_seconds": 49.97,
      "duration_seconds": 8.28,
      "text": "Okay, give me more detail on it, whatever comes to mind. Take your time, there's no rush."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 51.85,
      "end_seconds": 59.19,
      "duration_seconds": 7.34,
      "text": "Hmm, about a eight out of ten. I get some relief from drinking more water."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 60.1,
      "end_seconds": 67.65,
      "duration_seconds": 7.55,
      "text": "And the other thing I wanted to mention is that I can't really—"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_5",
      "role": "FAMILY_MEMBER",
      "start_seconds": 67.75,
      "end_seconds": 73.56,
      "duration_seconds": 5.81,
      "text": "Tell the doctor about the other thing, that's what worries me."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 75.42,
      "end_seconds": 85.32,
      "duration_seconds": 9.9,
      "text": "Okay, so I was getting to that! Oh, and straining to pass stool. That's been about the same, about a year."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 86.07,
      "end_seconds": 88.34,
      "duration_seconds": 2.27,
      "text": "And how severe is it?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 89.72,
      "end_seconds": 92.66,
      "duration_seconds": 2.94,
      "text": "Pretty moderate, if I'm being honest."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 93.83,
      "end_seconds": 99.05,
      "duration_seconds": 5.22,
      "text": "Has there been a little bright blood on the paper too?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 100.96,
      "end_seconds": 111.06,
      "duration_seconds": 10.1,
      "text": "Yes, about the same, about a month. There was a heavy feeling in the lower tummy, yes, but that went away."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 112.27,
      "end_seconds": 117.3,
      "duration_seconds": 5.03,
      "text": "Alright, have you had constipation before, or is this the first time?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 122.41,
      "end_seconds": 129.48,
      "duration_seconds": 7.07,
      "text": "Yes, something like this happened last winter, and it went away on its own."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 131.75,
      "end_seconds": 137.74,
      "duration_seconds": 5.99,
      "text": "Let me check a few things. Any vomiting, weight loss or black stools?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 138.92,
      "end_seconds": 142.76,
      "duration_seconds": 3.84,
      "text": "No, no vomiting, weight loss or black stools."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 143.79,
      "end_seconds": 147.8,
      "duration_seconds": 4.01,
      "text": "Have you noticed fever or pain on passing stool?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 148.57,
      "end_seconds": 153.81,
      "duration_seconds": 5.24,
      "text": "I haven't had fever or pain on passing stool, no."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 154.52,
      "end_seconds": 157.94,
      "duration_seconds": 3.42,
      "text": "Anything with your nerves, like weakness or numbness?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 158.57,
      "end_seconds": 160.55,
      "duration_seconds": 1.98,
      "text": "No weakness or anything."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 162.41,
      "end_seconds": 167.82,
      "duration_seconds": 5.41,
      "text": "What about your general health, any conditions you're being treated for?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 169.07,
      "end_seconds": 180.95,
      "duration_seconds": 11.88,
      "text": "I, I have diabetes, for nearly five years. I have an underactive thyroid, for about ten years. I have thin bones, for two years."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 182.96,
      "end_seconds": 184.06,
      "duration_seconds": 1.1,
      "text": "Hm, okay."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 188.89,
      "end_seconds": 191.81,
      "duration_seconds": 2.92,
      "text": "Yes, arthritis in my knees."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 195.87,
      "end_seconds": 202.6,
      "duration_seconds": 6.73,
      "text": "Okay, I can see thin bones and arthritis in your knees in your file as well."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 216.55,
      "end_seconds": 222.98,
      "duration_seconds": 6.43,
      "text": "Right, are you on any tablets or medication? Take your time, there's no rush."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 225.16,
      "end_seconds": 233.85,
      "duration_seconds": 8.69,
      "text": "It's, It's a... um, I can't remember what it's called. It's a round yellow one."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 235.46,
      "end_seconds": 238.14,
      "duration_seconds": 2.68,
      "text": "Do you remember what it's for?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 239.03,
      "end_seconds": 273.87,
      "duration_seconds": 34.84,
      "text": "For my sugar, I believe. My wife sets them out for me, I just take what I'm given. I'm on alendronate, 70 milligrams, once a week for my bones. I mean, it's diclofenac, 50 milligrams, when needed for the joint pain. Well, it's Cremaffin, at night. I thought it would sort itself out, but it hasn't. I wasn't sure whether to come in at all, to be honest."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 275.14,
      "end_seconds": 278.3,
      "duration_seconds": 3.16,
      "text": "Since when have you been taking it?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 279.11,
      "end_seconds": 283.71,
      "duration_seconds": 4.6,
      "text": "About a year now. Thyroxine I don't take anymore."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 296.36,
      "end_seconds": 298.03,
      "duration_seconds": 1.67,
      "text": "Any procedures or operations?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 299.85,
      "end_seconds": 303.63,
      "duration_seconds": 3.78,
      "text": "I, I had my gallbladder removed in 2016."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 307.41,
      "end_seconds": 312.84,
      "duration_seconds": 5.43,
      "text": "Do you have any allergies to medicines, food, anything at all?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 317.64,
      "end_seconds": 331.84,
      "duration_seconds": 14.2,
      "text": "Hmm, there was some antibiotic, I was told I was allergic. But I couldn't tell you what it was called or what it did."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 332.86,
      "end_seconds": 335.42,
      "duration_seconds": 2.56,
      "text": "Is anyone at home with you?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 337.44,
      "end_seconds": 341.19,
      "duration_seconds": 3.75,
      "text": "I share a flat with two friends."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 343.03,
      "end_seconds": 345.73,
      "duration_seconds": 2.7,
      "text": "I'd like to examine you now."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 346.86,
      "end_seconds": 348.89,
      "duration_seconds": 2.03,
      "text": "Hold that position for me."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 365.18,
      "end_seconds": 367.93,
      "duration_seconds": 2.75,
      "text": "There's no mass in the tummy."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 369.4,
      "end_seconds": 371.77,
      "duration_seconds": 2.37,
      "text": "Hold that position for me."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 382.74,
      "end_seconds": 387.65,
      "duration_seconds": 4.91,
      "text": "I can feel firm stool in the left lower abdomen."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 390.83,
      "end_seconds": 423.8,
      "duration_seconds": 32.97,
      "text": "That's all I need, thank you. Taking everything into account, the most likely explanation is chronic constipation. We shouldn't forget haemorrhoids. I'll request a colonoscopy, it'll help with constipation and rectal bleeding. I'm sending you for blood tests because of constipation. The treatment will be lactulose, 15 ml, at night, for two weeks. That's for constipation. More fibre, more water, and give yourself ten unhurried minutes after breakfast."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 424.85,
      "end_seconds": 436.85,
      "duration_seconds": 12.0,
      "text": "Please don't wait if the symptoms get worse. That's when to be seen urgently. Please come and see me in three weeks. That's it on my side. Anything unclear?"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 438.37,
      "end_seconds": 441.07,
      "duration_seconds": 2.7,
      "text": "Alright, thanks. Bye for now."
    }
  ]
}