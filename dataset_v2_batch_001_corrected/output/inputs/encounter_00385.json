{
  "schema_version": "1.0",
  "encounter_id": "00385",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.26,
      "end_seconds": 5.17,
      "duration_seconds": 3.91,
      "text": "good evening, doctor, thank you for staying late"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.0,
      "end_seconds": 10.24,
      "duration_seconds": 4.24,
      "text": "No trouble at all, come in. What's been bothering you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 11.33,
      "end_seconds": 16.87,
      "duration_seconds": 5.54,
      "text": "um mainly I've been feeling faint that's why I came"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 18.33,
      "end_seconds": 20.97,
      "duration_seconds": 2.64,
      "text": "how long have you had it?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 22.17,
      "end_seconds": 23.66,
      "duration_seconds": 1.49,
      "text": "It started yesterday."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 24.55,
      "end_seconds": 32.89,
      "duration_seconds": 8.34,
      "text": "Can you describe it a bit more for me? How strong it is, what the pattern is, what helps."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 34.64,
      "end_seconds": 48.37,
      "duration_seconds": 13.73,
      "text": "Sitting in the shade helps a bit. It just comes and goes. I'd call it moderate. I'm not great at remembering details uh so bear with me."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 49.57,
      "end_seconds": 52.6,
      "duration_seconds": 3.03,
      "text": "has there been a pounding headache too?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 54.62,
      "end_seconds": 62.9,
      "duration_seconds": 8.28,
      "text": "Yeah, you know, yes, about the same, about four days. About pounding headache, severe, really."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 64.67,
      "end_seconds": 68.01,
      "duration_seconds": 3.34,
      "text": "okay, I'll check your pressure and pulse"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 76.37,
      "end_seconds": 77.16,
      "duration_seconds": 0.79,
      "text": "Almost there..."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 89.46,
      "end_seconds": 96.25,
      "duration_seconds": 6.79,
      "text": "Okay: temperature 36.9, pulse is 104 beats a minute, blood pressure 99 over 58."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 97.18,
      "end_seconds": 98.55,
      "duration_seconds": 1.37,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 99.85,
      "end_seconds": 102.23,
      "duration_seconds": 2.38,
      "text": "I'll come back to those numbers"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 104.9,
      "end_seconds": 107.32,
      "duration_seconds": 2.42,
      "text": "Okay, a quick examination now."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 109.09,
      "end_seconds": 109.79,
      "duration_seconds": 0.7,
      "text": "Okay."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 111.34,
      "end_seconds": 113.4,
      "duration_seconds": 2.06,
      "text": "Bear with me a second."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 121.06,
      "end_seconds": 124.39,
      "duration_seconds": 3.33,
      "text": "your skin is warm and a bit clammy"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 125.73,
      "end_seconds": 126.43,
      "duration_seconds": 0.7,
      "text": "Alright."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 128.18,
      "end_seconds": 130.14,
      "duration_seconds": 1.96,
      "text": "let me just check something"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 137.36,
      "end_seconds": 139.14,
      "duration_seconds": 1.78,
      "text": "Capillary refill is normal"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 141.17,
      "end_seconds": 141.87,
      "duration_seconds": 0.7,
      "text": "alright"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 146.27,
      "end_seconds": 149.32,
      "duration_seconds": 3.05,
      "text": "so, all done, you can get dressed"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 164.74,
      "end_seconds": 169.08,
      "duration_seconds": 4.34,
      "text": "let me check a a few things any vomiting or fever?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 169.77,
      "end_seconds": 173.11,
      "duration_seconds": 3.34,
      "text": "hmm, no, no vomiting or fever"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 174.89,
      "end_seconds": 179.99,
      "duration_seconds": 5.1,
      "text": "let me check a few things any passing no urine or fainting?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 180.97,
      "end_seconds": 183.93,
      "duration_seconds": 2.96,
      "text": "None, as far as I know."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 185.96,
      "end_seconds": 188.04,
      "duration_seconds": 2.08,
      "text": "has your skin been okay?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 189.69,
      "end_seconds": 190.6,
      "duration_seconds": 0.91,
      "text": "No rashes."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 192.53,
      "end_seconds": 195.04,
      "duration_seconds": 2.51,
      "text": "Any diagnoses you've been given before?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 196.72,
      "end_seconds": 199.46,
      "duration_seconds": 2.74,
      "text": "High blood pressure for five years"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 201.55,
      "end_seconds": 202.25,
      "duration_seconds": 0.7,
      "text": "yes?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 203.67,
      "end_seconds": 207.77,
      "duration_seconds": 4.1,
      "text": "I've had heart failure yes. I've got heart disease."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 209.75,
      "end_seconds": 211.2,
      "duration_seconds": 1.45,
      "text": "Right, any more?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 212.8,
      "end_seconds": 215.49,
      "duration_seconds": 2.69,
      "text": "have you had any surgery before?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 217.58,
      "end_seconds": 222.82,
      "duration_seconds": 5.24,
      "text": "just a stent put in my heart two years ago"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 224.74,
      "end_seconds": 230.42,
      "duration_seconds": 5.68,
      "text": "Have you ever reacted badly to a medicine or food? Any allergies?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 231.08,
      "end_seconds": 233.66,
      "duration_seconds": 2.58,
      "text": "Not that I know no."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 235.36,
      "end_seconds": 239.13,
      "duration_seconds": 3.77,
      "text": "Tell me what you take day to day."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 240.66,
      "end_seconds": 254.38,
      "duration_seconds": 13.72,
      "text": "it's, It's telmisartan, 40 milligrams, once a day for my pressure i, I take spironolactone, 25 milligrams, once a day i take aspirin, 75 milligrams, once a day"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 270.56,
      "end_seconds": 271.93,
      "duration_seconds": 1.37,
      "text": "And your work?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 274.0,
      "end_seconds": 277.33,
      "duration_seconds": 3.33,
      "text": "I drive a delivery van all day."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 278.32,
      "end_seconds": 282.26,
      "duration_seconds": 3.94,
      "text": "What do you do to to keep active?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 283.91,
      "end_seconds": 287.15,
      "duration_seconds": 3.24,
      "text": "I cycle to work most mornings."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 288.23,
      "end_seconds": 290.37,
      "duration_seconds": 2.14,
      "text": "are you living with family?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 291.9,
      "end_seconds": 295.82,
      "duration_seconds": 3.92,
      "text": "I stay with my daughter and her family."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 298.36,
      "end_seconds": 303.28,
      "duration_seconds": 4.92,
      "text": "Any relatives with health problems I should be aware of?"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 304.54,
      "end_seconds": 306.94,
      "duration_seconds": 2.4,
      "text": "my father had a stroke"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 319.65,
      "end_seconds": 341.07,
      "duration_seconds": 21.42,
      "text": "So, based on the history and the examination, my working impression is heat exhaustion with some dehydration. That's my thinking for now, and it may change as we learn more. Stop me if I've got anything wrong. You've been feeling faint, yesterday, moderate, and no fever or vomiting."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 342.61,
      "end_seconds": 344.18,
      "duration_seconds": 1.57,
      "text": "Yes, that's right."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 346.25,
      "end_seconds": 361.28,
      "duration_seconds": 15.03,
      "text": "I'm gonna order blood salts, for dehydration. You'll be taking ORS, 1 sachet, three times a day, for two days. You take it by mouth. That should help with dehydration."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 362.35,
      "end_seconds": 366.32,
      "duration_seconds": 3.97,
      "text": "Can I get that from the usual pharmacy?"
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 366.85,
      "end_seconds": 384.22,
      "duration_seconds": 17.37,
      "text": "avoid the midday sun for a few days and keep a water bottle with you please don't wait if you become confused or stop sweating that's when to be seen urgently let's plan a check in three days"
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 385.16,
      "end_seconds": 386.6,
      "duration_seconds": 1.44,
      "text": "Sure that's doable."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 387.58,
      "end_seconds": 391.59,
      "duration_seconds": 4.01,
      "text": "take care, and call us if anything changes"
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 392.19,
      "end_seconds": 394.81,
      "duration_seconds": 2.62,
      "text": "nothing more from me, thanks"
    }
  ]
}