{
  "schema_version": "1.0",
  "encounter_id": "00402",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.19,
      "end_seconds": 6.03,
      "duration_seconds": 4.84,
      "text": "sorry, doctor, I couldn't find the door at first"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.98,
      "end_seconds": 11.84,
      "duration_seconds": 3.86,
      "text": "Right on time. Sit, please. How can I help?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 12.84,
      "end_seconds": 19.06,
      "duration_seconds": 6.22,
      "text": "Hello doctor. I hope it's alright if I stay in for this."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 21.14,
      "end_seconds": 24.04,
      "duration_seconds": 2.9,
      "text": "please do extra information is always welcome"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 25.92,
      "end_seconds": 32.97,
      "duration_seconds": 7.05,
      "text": "um, uh, we came because of pain under the right ribs after fatty meals"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 33.78,
      "end_seconds": 37.78,
      "duration_seconds": 4.0,
      "text": "before we go on, a a few quick readings"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 45.91,
      "end_seconds": 47.54,
      "duration_seconds": 1.63,
      "text": "hold still for me.."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 58.4,
      "end_seconds": 66.08,
      "duration_seconds": 7.68,
      "text": "okay: pulse is 77 beats a minute, SpO2 99 percent on room air, pressure 109 over 79."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 66.85,
      "end_seconds": 68.43,
      "duration_seconds": 1.58,
      "text": "is that okay?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 70.0,
      "end_seconds": 73.27,
      "duration_seconds": 3.27,
      "text": "I'll interpret it once I've examined you"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 85.09,
      "end_seconds": 87.49,
      "duration_seconds": 2.4,
      "text": "When did you first notice it?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 89.02,
      "end_seconds": 92.04,
      "duration_seconds": 3.02,
      "text": "about a week, give or take"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 93.28,
      "end_seconds": 97.45,
      "duration_seconds": 4.17,
      "text": "It, It was closer to two weeks, doctor."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 98.54,
      "end_seconds": 102.94,
      "duration_seconds": 4.4,
      "text": "okay so roughly one to two weeks. Is that right?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 104.78,
      "end_seconds": 106.94,
      "duration_seconds": 2.16,
      "text": "yes, somewhere around that"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 107.4,
      "end_seconds": 122.31,
      "duration_seconds": 14.91,
      "text": "mm-hm tell me a bit more about it: how bad it gets, how often, and whether anything makes it better or worse bear with me, I'm just building up the picture"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 123.27,
      "end_seconds": 141.14,
      "duration_seconds": 17.87,
      "text": "Fatty food definitely sets it off. I get some relief from lying still. I've also had bloating. With bloating, I'd say severe. And, And I've been belching as well, for ten days"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 147.37,
      "end_seconds": 151.29,
      "duration_seconds": 3.92,
      "text": "How would you describe it mild moderate severe?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 151.93,
      "end_seconds": 153.91,
      "duration_seconds": 1.98,
      "text": "I'd call it mild."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 155.09,
      "end_seconds": 161.71,
      "duration_seconds": 6.62,
      "text": "let me check a few things. Any pale stools, dark urine, fever or weight loss?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 166.28,
      "end_seconds": 172.21,
      "duration_seconds": 5.93,
      "text": "No, no pale stools, dark urine, fever or weight loss."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 172.92,
      "end_seconds": 175.73,
      "duration_seconds": 2.81,
      "text": "Any breathing difficulties apart from this?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 176.4,
      "end_seconds": 177.53,
      "duration_seconds": 1.13,
      "text": "Breathing's normal."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 179.53,
      "end_seconds": 181.71,
      "duration_seconds": 2.18,
      "text": "anything unusual with passing urine?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 183.08,
      "end_seconds": 184.51,
      "duration_seconds": 1.43,
      "text": "no changes there"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 185.1,
      "end_seconds": 187.21,
      "duration_seconds": 2.11,
      "text": "any drug or food allergies?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 188.7,
      "end_seconds": 191.22,
      "duration_seconds": 2.52,
      "text": "No, nothing I'm aware of."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 196.42,
      "end_seconds": 201.1,
      "duration_seconds": 4.68,
      "text": "Do you have any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 202.25,
      "end_seconds": 207.79,
      "duration_seconds": 5.54,
      "text": "I've had diabetes, yes. Sorry, I know I'm rambling a bit"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 210.67,
      "end_seconds": 211.77,
      "duration_seconds": 1.1,
      "text": "okay, so"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 215.19,
      "end_seconds": 216.7,
      "duration_seconds": 1.51,
      "text": "Yes, high cholesterol."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 217.92,
      "end_seconds": 219.46,
      "duration_seconds": 1.54,
      "text": "Right, any more?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 220.17,
      "end_seconds": 228.73,
      "duration_seconds": 8.56,
      "text": "yes diabetes is known to us good to have that clear tell me what you take day to day"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 229.63,
      "end_seconds": 234.69,
      "duration_seconds": 5.06,
      "text": "Oh, he takes metformin, 500 milligrams, twice a day."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 235.81,
      "end_seconds": 240.91,
      "duration_seconds": 5.1,
      "text": "Um, I used to take rosuvastatin, but I stopped it."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 242.34,
      "end_seconds": 246.7,
      "duration_seconds": 4.36,
      "text": "Have you had to to have anything operated on?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 247.57,
      "end_seconds": 254.15,
      "duration_seconds": 6.58,
      "text": "um, you know, just my tonsils out, when I was a child"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 256.0,
      "end_seconds": 260.77,
      "duration_seconds": 4.77,
      "text": "Tell me about your routine, work, habits, that sort of thing."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 262.66,
      "end_seconds": 270.02,
      "duration_seconds": 7.36,
      "text": "I smoke about ten cigarettes a day. I cycle to work most mornings. I'm mostly vegetarian"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 273.01,
      "end_seconds": 275.41,
      "duration_seconds": 2.4,
      "text": "shall we do the the examination?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 288.56,
      "end_seconds": 289.26,
      "duration_seconds": 0.7,
      "text": "sure"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 291.0,
      "end_seconds": 293.45,
      "duration_seconds": 2.45,
      "text": "Let me just check something."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 302.66,
      "end_seconds": 310.33,
      "duration_seconds": 7.67,
      "text": "Mild tenderness under the right ribs, and no pain when you breathe in while I press."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 311.18,
      "end_seconds": 314.47,
      "duration_seconds": 3.29,
      "text": "Okay, stay still while I have a look."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 323.78,
      "end_seconds": 326.89,
      "duration_seconds": 3.11,
      "text": "The rest of the tummy is soft."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 328.88,
      "end_seconds": 329.91,
      "duration_seconds": 1.03,
      "text": "no problem"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 332.6,
      "end_seconds": 341.14,
      "duration_seconds": 8.54,
      "text": "okay, finished putting it all together, I'd lean towards gallstone pain. Gastritis is also on my list"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 342.59,
      "end_seconds": 345.37,
      "duration_seconds": 2.78,
      "text": "is it something serious, doctor?"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 346.38,
      "end_seconds": 356.32,
      "duration_seconds": 9.94,
      "text": "I understand the worry at the moment I'd say it's gallstone pain and we'll know more once the an ultrasound of the abdomen is back"
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 363.78,
      "end_seconds": 383.28,
      "duration_seconds": 19.5,
      "text": "I'm sending you for an ultrasound of the abdomen cos of right upper quadrant pain. I'd like to arrange liver function tests for right upper quadrant pain. Smaller lower-fat meals will probably keep the pain down until we've seen the scan. Come back after the scan"
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 384.38,
      "end_seconds": 386.64,
      "duration_seconds": 2.26,
      "text": "That works for me."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 387.36,
      "end_seconds": 389.85,
      "duration_seconds": 2.49,
      "text": "alright, I'll see you out"
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 391.07,
      "end_seconds": 393.6,
      "duration_seconds": 2.53,
      "text": "alright, thanks bye for now"
    }
  ]
}