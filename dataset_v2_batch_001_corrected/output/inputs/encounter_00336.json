{
  "schema_version": "1.0",
  "encounter_id": "00336",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.23,
      "end_seconds": 6.62,
      "duration_seconds": 5.39,
      "text": "I mean, sorry, doctor, I couldn't find the door at first."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 9.55,
      "end_seconds": 13.93,
      "duration_seconds": 4.38,
      "text": "No trouble at all, come in. What's been bothering you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 15.41,
      "end_seconds": 25.89,
      "duration_seconds": 10.48,
      "text": "Yeah, it's sneezing fits. I don't know what's causing it. I told myself I'd wait and see, and here I am."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 26.65,
      "end_seconds": 29.33,
      "duration_seconds": 2.68,
      "text": "since when have you had this?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 30.01,
      "end_seconds": 35.78,
      "duration_seconds": 5.77,
      "text": "I'd say about two weeks. Actually, no, closer to three weeks"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 36.84,
      "end_seconds": 41.41,
      "duration_seconds": 4.57,
      "text": "okay, give me more detail on it, whatever comes to mind"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 46.15,
      "end_seconds": 55.39,
      "duration_seconds": 9.24,
      "text": "It's all the time. I notice it more with dust and early mornings. A three out of ten, I suppose."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 67.04,
      "end_seconds": 71.67,
      "duration_seconds": 4.63,
      "text": "Okay, any rash, wheezing or shortness of breath at all?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 72.48,
      "end_seconds": 74.39,
      "duration_seconds": 1.91,
      "text": "No. None of those."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 75.65,
      "end_seconds": 79.58,
      "duration_seconds": 3.93,
      "text": "Anything with your heart, like skipped beats or fainting?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 80.62,
      "end_seconds": 82.12,
      "duration_seconds": 1.5,
      "text": "nothing like that"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 84.14,
      "end_seconds": 85.59,
      "duration_seconds": 1.45,
      "text": "any previous surgeries?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 87.53,
      "end_seconds": 93.03,
      "duration_seconds": 5.5,
      "text": "Yes, I had cataract surgery on my right eye, last year."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 93.98,
      "end_seconds": 97.68,
      "duration_seconds": 3.7,
      "text": "Do you have any known allergies at all?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 99.41,
      "end_seconds": 100.42,
      "duration_seconds": 1.01,
      "text": "No allergies."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 109.16,
      "end_seconds": 114.09,
      "duration_seconds": 4.93,
      "text": "So, do you have any medical conditions I should know about?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 114.93,
      "end_seconds": 118.37,
      "duration_seconds": 3.44,
      "text": "no, none that I know of"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 120.4,
      "end_seconds": 121.69,
      "duration_seconds": 1.29,
      "text": "any regular medication?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 123.12,
      "end_seconds": 124.18,
      "duration_seconds": 1.06,
      "text": "nothing, no"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 128.28,
      "end_seconds": 130.19,
      "duration_seconds": 1.91,
      "text": "do you live alone?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 131.98,
      "end_seconds": 134.81,
      "duration_seconds": 2.83,
      "text": "Yes, I live on my own."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 136.18,
      "end_seconds": 137.84,
      "duration_seconds": 1.66,
      "text": "Any sport or activity?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 139.18,
      "end_seconds": 141.65,
      "duration_seconds": 2.47,
      "text": "I play badminton on Sundays."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 143.64,
      "end_seconds": 146.02,
      "duration_seconds": 2.38,
      "text": "I'll check your pressure and pulse."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 154.46,
      "end_seconds": 155.31,
      "duration_seconds": 0.85,
      "text": "almost there.."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 173.09,
      "end_seconds": 184.17,
      "duration_seconds": 11.08,
      "text": "Okay: temperature is 36.8 degrees, blood pressure 126 over 80, respiratory rate 14. And oxygen saturation is 98 percent, pulse 79."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 185.81,
      "end_seconds": 187.5,
      "duration_seconds": 1.69,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 188.09,
      "end_seconds": 192.07,
      "duration_seconds": 3.98,
      "text": "We'll put it it in context in a moment."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 193.71,
      "end_seconds": 196.65,
      "duration_seconds": 2.94,
      "text": "Let's do the physical part now."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 197.82,
      "end_seconds": 200.26,
      "duration_seconds": 2.44,
      "text": "Take your time, no rush."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 209.83,
      "end_seconds": 212.06,
      "duration_seconds": 2.23,
      "text": "chest is clear, no wheeze"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 213.01,
      "end_seconds": 215.1,
      "duration_seconds": 2.09,
      "text": "Take your time, no rush."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 232.58,
      "end_seconds": 236.24,
      "duration_seconds": 3.66,
      "text": "The inside of your nose is pale and swollen."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 240.05,
      "end_seconds": 242.42,
      "duration_seconds": 2.37,
      "text": "Okay, you can sit up."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 259.96,
      "end_seconds": 270.35,
      "duration_seconds": 10.39,
      "text": "Okay, thinking it through, it fits best with allergic rhinitis. I want to be honest that this is an impression, not a final answer."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 270.97,
      "end_seconds": 274.73,
      "duration_seconds": 3.76,
      "text": "Is this something I'll have for good?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 275.32,
      "end_seconds": 283.01,
      "duration_seconds": 7.69,
      "text": "I can't promise yet, but most people with allergic rhinitis do well once it's treated properly"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 294.75,
      "end_seconds": 299.71,
      "duration_seconds": 4.96,
      "text": "I think an allergy test makes sense here, for allergic rhinitis."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 300.31,
      "end_seconds": 305.13,
      "duration_seconds": 4.82,
      "text": "We have a slot Monday at 11:30 am, if that works."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 306.24,
      "end_seconds": 309.84,
      "duration_seconds": 3.6,
      "text": "Okay, so okay, I'll be there."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 310.97,
      "end_seconds": 319.18,
      "duration_seconds": 8.21,
      "text": "I'm prescribing levocetirizine, 5 milligrams, at night, for two weeks. You take it by mouth. It's for allergy symptoms"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 320.13,
      "end_seconds": 322.62,
      "duration_seconds": 2.49,
      "text": "Alright, I'll collect it today."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 323.75,
      "end_seconds": 348.05,
      "duration_seconds": 24.3,
      "text": "keep the windows closed in the early morning and wash the bedsheets weekly in hot water make sure you're drinking plenty of fluids, two to three litres a day if you can, and get proper rest one warning sign to remember: the symptoms get worse in that case don't wait"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 348.65,
      "end_seconds": 349.35,
      "duration_seconds": 0.7,
      "text": "Understood."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 350.71,
      "end_seconds": 354.6,
      "duration_seconds": 3.89,
      "text": "Please come and see me in four weeks."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 355.88,
      "end_seconds": 358.1,
      "duration_seconds": 2.22,
      "text": "Okay, I'll book that."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 360.07,
      "end_seconds": 363.21,
      "duration_seconds": 3.14,
      "text": "good. Let us know how you get on"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 364.8,
      "end_seconds": 367.3,
      "duration_seconds": 2.5,
      "text": "alright, thanks bye for now"
    }
