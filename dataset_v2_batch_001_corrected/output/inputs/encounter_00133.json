{
  "schema_version": "1.0",
  "encounter_id": "00133",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.5,
      "end_seconds": 3.43,
      "duration_seconds": 2.93,
      "text": "Good evening. Sorry to keep you waiting."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "FAMILY_MEMBER",
      "start_seconds": 4.82,
      "end_seconds": 8.03,
      "duration_seconds": 3.21,
      "text": "Thank you for fitting us in, doctor."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 8.8,
      "end_seconds": 11.31,
      "duration_seconds": 2.51,
      "text": "Go ahead, tell me what's happening."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "FAMILY_MEMBER",
      "start_seconds": 13.29,
      "end_seconds": 18.46,
      "duration_seconds": 5.17,
      "text": "He's been having a burning pain in the upper tummy, doctor."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 19.22,
      "end_seconds": 21.76,
      "duration_seconds": 2.54,
      "text": "When did you first notice it?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 23.43,
      "end_seconds": 26.17,
      "duration_seconds": 2.74,
      "text": "About... well, about two weeks."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 27.19,
      "end_seconds": 31.81,
      "duration_seconds": 4.62,
      "text": "Okay, give me more detail on it, whatever comes to mind."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 35.96,
      "end_seconds": 54.39,
      "duration_seconds": 18.43,
      "text": "It's mild, honestly. It settles a little with milk. An empty stomach definitely sets it off. Oh, and a sour taste in the mouth. Had that since Monday. As for sour taste in the mouth, it feels moderate to me."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 56.01,
      "end_seconds": 58.37,
      "duration_seconds": 2.36,
      "text": "Have you had bloating after meals?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 59.34,
      "end_seconds": 61.16,
      "duration_seconds": 1.82,
      "text": "Yes, I have."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 62.66,
      "end_seconds": 65.98,
      "duration_seconds": 3.32,
      "text": "Is there anything medical in your background?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 66.87,
      "end_seconds": 79.42,
      "duration_seconds": 12.55,
      "text": "I have arthritis in my knees, for about ten years. I have acid reflux, for nearly five years. I have heart disease, for nearly five years."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 80.78,
      "end_seconds": 90.55,
      "duration_seconds": 9.77,
      "text": "Hm, okay. Right, so acid reflux is already on your record. We'll keep that in mind today. What about alcohol?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 91.17,
      "end_seconds": 95.39,
      "duration_seconds": 4.22,
      "text": "I have a couple of drinks on the weekend."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 97.47,
      "end_seconds": 99.56,
      "duration_seconds": 2.09,
      "text": "Okay, do you smoke?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 101.27,
      "end_seconds": 104.85,
      "duration_seconds": 3.58,
      "text": "I stopped smoking about two years back."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 106.86,
      "end_seconds": 108.88,
      "duration_seconds": 2.02,
      "text": "Are you active at all?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 109.83,
      "end_seconds": 112.66,
      "duration_seconds": 2.83,
      "text": "Barely, I'm mostly sedentary these days."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 113.57,
      "end_seconds": 114.88,
      "duration_seconds": 1.31,
      "text": "How's your diet?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 115.77,
      "end_seconds": 117.35,
      "duration_seconds": 1.58,
      "text": "I'm mostly vegetarian."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 131.06,
      "end_seconds": 133.55,
      "duration_seconds": 2.49,
      "text": "What medicines do you take regularly?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 136.77,
      "end_seconds": 139.46,
      "duration_seconds": 2.69,
      "text": "Paracetamol, 650 milligrams, when needed."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "FAMILY_MEMBER",
      "start_seconds": 144.23,
      "end_seconds": 151.45,
      "duration_seconds": 7.22,
      "text": "He is supposed to take it when needed, but I can't say he always does."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 153.21,
      "end_seconds": 156.2,
      "duration_seconds": 2.99,
      "text": "Pantoprazole, 40 milligrams, before breakfast."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 157.29,
      "end_seconds": 160.06,
      "duration_seconds": 2.77,
      "text": "So, when did you start it?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 161.61,
      "end_seconds": 163.29,
      "duration_seconds": 1.68,
      "text": "For two years."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 163.56,
      "end_seconds": 164.38,
      "duration_seconds": 0.82,
      "text": "Uh-huh."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 166.45,
      "end_seconds": 174.04,
      "duration_seconds": 7.59,
      "text": "Aspirin, 75 milligrams, once a day. It's the not knowing that gets to me."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 185.1,
      "end_seconds": 186.94,
      "duration_seconds": 1.84,
      "text": "Any procedures or operations?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 188.88,
      "end_seconds": 195.35,
      "duration_seconds": 6.47,
      "text": "Oh, yes, I had my appendix out, about eight years ago."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 208.99,
      "end_seconds": 211.8,
      "duration_seconds": 2.81,
      "text": "Any allergies I should know about?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 213.12,
      "end_seconds": 221.85,
      "duration_seconds": 8.73,
      "text": "I think I reacted to some antibiotic once, years ago. I don't remember which one, or what happened exactly."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 223.7,
      "end_seconds": 228.47,
      "duration_seconds": 4.77,
      "text": "Any fever, black stools, jaundice or weight loss at all?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 229.33,
      "end_seconds": 236.54,
      "duration_seconds": 7.21,
      "text": "Um, I haven't had fever, black stools, jaundice or weight loss, no."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 237.69,
      "end_seconds": 241.55,
      "duration_seconds": 3.86,
      "text": "Have you noticed vomiting blood or trouble swallowing?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 242.68,
      "end_seconds": 245.48,
      "duration_seconds": 2.8,
      "text": "No, none of that at all."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 246.03,
      "end_seconds": 248.33,
      "duration_seconds": 2.3,
      "text": "Any trouble with the waterworks?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 249.09,
      "end_seconds": 250.59,
      "duration_seconds": 1.5,
      "text": "No changes there."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 251.41,
      "end_seconds": 255.49,
      "duration_seconds": 4.08,
      "text": "Any pins and needles or loss of strength anywhere?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 256.81,
      "end_seconds": 259.85,
      "duration_seconds": 3.04,
      "text": "Well, no, that's all normal."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_4",
      "role": "NURSE",
      "start_seconds": 261.48,
      "end_seconds": 273.48,
      "duration_seconds": 12.0,
      "text": "Okay, so the vitals from earlier. Pulse 67, height 151 centimetres. Weight 85 kilos, oxygen saturation is 98 percent, pressure 127 over 75, respiratory rate 15."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 274.26,
      "end_seconds": 275.37,
      "duration_seconds": 1.11,
      "text": "Okay, noted."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 278.0,
      "end_seconds": 280.85,
      "duration_seconds": 2.85,
      "text": "Let me examine, it won't take long."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 282.66,
      "end_seconds": 285.37,
      "duration_seconds": 2.71,
      "text": "So, take your time, no rush."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 292.82,
      "end_seconds": 298.41,
      "duration_seconds": 5.59,
      "text": "Your tummy is soft, with mild tenderness in the upper middle part."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 299.99,
      "end_seconds": 302.41,
      "duration_seconds": 2.42,
      "text": "Take your time, no rush."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 319.62,
      "end_seconds": 321.77,
      "duration_seconds": 2.15,
      "text": "No guarding and no lumps."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 325.54,
      "end_seconds": 338.81,
      "duration_seconds": 13.27,
      "text": "So, that's all I need, thank you. Let me tell you where I've got to. I'd lean towards gastritis. Acid reflux is still possible. We should do an upper endoscopy for persistent dyspepsia."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 339.72,
      "end_seconds": 343.43,
      "duration_seconds": 3.71,
      "text": "I mean, how long does that take?"
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 344.4,
      "end_seconds": 364.04,
      "duration_seconds": 19.64,
      "text": "We should do blood tests for dyspepsia. We should do an H. pylori test for dyspepsia. Avoid spicy, oily food and don't take anti-inflammatory painkillers on an empty stomach. Please come and see me in four weeks. Right, that's all. Go gently."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 364.85,
      "end_seconds": 366.85,
      "duration_seconds": 2.0,
      "text": "No questions. Thank you."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 367.75,
      "end_seconds": 368.98,
      "duration_seconds": 1.23,
      "text": "Bye for now."
    }
  ]
}