{
  "schema_version": "1.0",
  "encounter_id": "00203",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.91,
      "end_seconds": 3.69,
      "duration_seconds": 2.78,
      "text": "Good afternoon. Take a seat, please."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 4.31,
      "end_seconds": 5.01,
      "duration_seconds": 0.7,
      "text": "Hi."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 5.82,
      "end_seconds": 9.2,
      "duration_seconds": 3.38,
      "text": "Thank you for fitting us in, doctor."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 10.93,
      "end_seconds": 13.47,
      "duration_seconds": 2.54,
      "text": "What seems to be the problem?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 15.22,
      "end_seconds": 23.64,
      "duration_seconds": 8.42,
      "text": "It's, It's trouble hearing in my left ear, doctor. She didn't want to come, but I insisted."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 24.65,
      "end_seconds": 27.86,
      "duration_seconds": 3.21,
      "text": "How long has this been going on?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 29.12,
      "end_seconds": 32.24,
      "duration_seconds": 3.12,
      "text": "For four weeks, I'd say."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 33.3,
      "end_seconds": 35.44,
      "duration_seconds": 2.14,
      "text": "And how severe is it?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 37.23,
      "end_seconds": 38.9,
      "duration_seconds": 1.67,
      "text": "Severe, I'd say."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 39.74,
      "end_seconds": 44.42,
      "duration_seconds": 4.68,
      "text": "Have you had a feeling of fullness in the ear?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 45.07,
      "end_seconds": 63.99,
      "duration_seconds": 18.92,
      "text": "Oh, yes, about the same, nearly five years. As for difficulty following conversation in crowds, I honestly can't say when that began. It might have been last month or the month before."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 65.7,
      "end_seconds": 68.0,
      "duration_seconds": 2.3,
      "text": "And how severe is it?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 69.83,
      "end_seconds": 73.02,
      "duration_seconds": 3.19,
      "text": "It, It feels moderate to me."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 77.93,
      "end_seconds": 85.09,
      "duration_seconds": 7.16,
      "text": "Have you had trouble hearing in your left ear before, or is this the first time?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 85.86,
      "end_seconds": 95.71,
      "duration_seconds": 9.85,
      "text": "Yes, something like this happened a couple of years ago, and it went away on its own."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 101.15,
      "end_seconds": 106.34,
      "duration_seconds": 5.19,
      "text": "What about family history, any illnesses that run in the family?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 107.25,
      "end_seconds": 113.47,
      "duration_seconds": 6.22,
      "text": "My sister has epilepsy. Well, my father had a stroke."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 129.77,
      "end_seconds": 134.47,
      "duration_seconds": 4.7,
      "text": "Do you have any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 136.3,
      "end_seconds": 139.99,
      "duration_seconds": 3.69,
      "text": "Yes, high blood pressure. I have diabetes."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 141.03,
      "end_seconds": 142.62,
      "duration_seconds": 1.59,
      "text": "Right, any more?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 144.42,
      "end_seconds": 148.72,
      "duration_seconds": 4.3,
      "text": "I have epilepsy, for about a year."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 149.97,
      "end_seconds": 155.8,
      "duration_seconds": 5.83,
      "text": "Okay, I can see high blood pressure in your file as well."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 167.85,
      "end_seconds": 169.63,
      "duration_seconds": 1.78,
      "text": "Okay, any previous surgeries?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 170.49,
      "end_seconds": 175.24,
      "duration_seconds": 4.75,
      "text": "Yes, I had a knee arthroscopy, three years ago."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 176.35,
      "end_seconds": 177.94,
      "duration_seconds": 1.59,
      "text": "Do you live alone?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 179.06,
      "end_seconds": 182.43,
      "duration_seconds": 3.37,
      "text": "Yes, I live on my own."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 183.32,
      "end_seconds": 184.52,
      "duration_seconds": 1.2,
      "text": "What's your job?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 190.21,
      "end_seconds": 193.43,
      "duration_seconds": 3.22,
      "text": "I teach at a primary school."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 194.81,
      "end_seconds": 196.92,
      "duration_seconds": 2.11,
      "text": "Anything special about your diet?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 198.42,
      "end_seconds": 201.98,
      "duration_seconds": 3.56,
      "text": "I try to avoid too much sugar."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 220.27,
      "end_seconds": 222.96,
      "duration_seconds": 2.69,
      "text": "What medicines do you take regularly?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 223.98,
      "end_seconds": 241.38,
      "duration_seconds": 17.4,
      "text": "Okay, so I take telmisartan, 40 milligrams, once a day for my pressure. I take Glycomet, 500 milligrams, twice a day. Right, I'm on levetiracetam, 500 milligrams, twice a day for the seizures."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 242.56,
      "end_seconds": 244.84,
      "duration_seconds": 2.28,
      "text": "Has there been any dizziness?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 245.65,
      "end_seconds": 247.11,
      "duration_seconds": 1.46,
      "text": "No. No dizziness."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 249.18,
      "end_seconds": 255.53,
      "duration_seconds": 6.35,
      "text": "Um, actually, doctor, I did notice dizziness. She doesn't always say."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 259.94,
      "end_seconds": 268.85,
      "duration_seconds": 8.91,
      "text": "No, you know, I don't think I did. Maybe a little, I'm not sure."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 274.67,
      "end_seconds": 282.03,
      "duration_seconds": 7.36,
      "text": "Alright, I'll note both what you've said and what you've noticed. Any facial weakness, discharge or headache?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 283.01,
      "end_seconds": 288.75,
      "duration_seconds": 5.74,
      "text": "No, you know, no facial weakness, discharge or headache."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 290.59,
      "end_seconds": 293.63,
      "duration_seconds": 3.04,
      "text": "Is your urine normal, no changes?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 295.43,
      "end_seconds": 297.08,
      "duration_seconds": 1.65,
      "text": "No changes there."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 299.11,
      "end_seconds": 301.88,
      "duration_seconds": 2.77,
      "text": "Let me check your vitals now."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 309.64,
      "end_seconds": 311.34,
      "duration_seconds": 1.7,
      "text": "Hold still for me..."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 330.96,
      "end_seconds": 341.77,
      "duration_seconds": 10.81,
      "text": "Okay: BP is 117 over 81, oxygen saturation is 97 percent, temperature is 36.5 degrees, pulse is 71 beats a minute."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 342.68,
      "end_seconds": 346.26,
      "duration_seconds": 3.58,
      "text": "Is that alright, um, doctor?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 347.8,
      "end_seconds": 352.26,
      "duration_seconds": 4.46,
      "text": "They help build the picture, I'll tell you more soon."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 354.74,
      "end_seconds": 357.89,
      "duration_seconds": 3.15,
      "text": "If you're comfortable, I'll examine you now."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 359.56,
      "end_seconds": 361.57,
      "duration_seconds": 2.01,
      "text": "Almost done with this part."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 370.11,
      "end_seconds": 377.02,
      "duration_seconds": 6.91,
      "text": "There's a lot of wax in the left ear canal, I can't see the drum."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 378.54,
      "end_seconds": 380.62,
      "duration_seconds": 2.08,
      "text": "Bear with me a second."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 391.73,
      "end_seconds": 395.04,
      "duration_seconds": 3.31,
      "text": "The right ear canal and drum are normal."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 397.44,
      "end_seconds": 411.95,
      "duration_seconds": 14.51,
      "text": "Thanks, please take a seat again. So, based on the history and the examination, I don't have a clear answer today: hearing loss from wax is possible, and so is age-related hearing loss."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 412.5,
      "end_seconds": 414.97,
      "duration_seconds": 2.47,
      "text": "Do you think it's serious?"
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 416.28,
      "end_seconds": 445.53,
      "duration_seconds": 29.25,
      "text": "I can't promise yet, but most people with hearing loss from wax do well once it's treated properly. We should do a hearing test for hearing loss. The treatment will be ear drops, three times a day, for five days. That should help with wax softening. Please don't use cotton buds or ear candles, they push the wax in further."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 445.94,
      "end_seconds": 447.9,
      "duration_seconds": 1.96,
      "text": "Mm-hm. Thanks for coming in."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 449.58,
      "end_seconds": 451.73,
      "duration_seconds": 2.15,
      "text": "No questions. Thank you."
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 452.37,
      "end_seconds": 453.75,
      "duration_seconds": 1.38,
      "text": "All the best."
    }
  ]
}