{
  "schema_version": "1.0",
  "encounter_id": "00078",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.9,
      "end_seconds": 5.57,
      "duration_seconds": 4.67,
      "text": "Hi, doctor. Long queue outside, but here I am."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.77,
      "end_seconds": 10.57,
      "duration_seconds": 3.8,
      "text": "Yes, do sit. Tell me what's been happening."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 12.23,
      "end_seconds": 17.8,
      "duration_seconds": 5.57,
      "text": "I'm here because of leaking urine when I cough or sneeze."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 18.81,
      "end_seconds": 21.16,
      "duration_seconds": 2.35,
      "text": "I'll check your pressure and pulse."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 29.71,
      "end_seconds": 31.33,
      "duration_seconds": 1.62,
      "text": "Rest your hand here..."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 41.42,
      "end_seconds": 48.16,
      "duration_seconds": 6.74,
      "text": "Okay: pulse 65, blood pressure 123 over 70, SpO2 99 percent on room air."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 48.7,
      "end_seconds": 50.79,
      "duration_seconds": 2.09,
      "text": "Is that alright, doctor?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 51.51,
      "end_seconds": 56.36,
      "duration_seconds": 4.85,
      "text": "I'll come back to those numbers. How long are we talking about?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 58.4,
      "end_seconds": 62.68,
      "duration_seconds": 4.28,
      "text": "I mean, ever since... since this morning, really."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 64.44,
      "end_seconds": 74.75,
      "duration_seconds": 10.31,
      "text": "Tell me a bit more about it: how bad it gets, how often, and whether anything makes it better or worse."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 75.42,
      "end_seconds": 87.64,
      "duration_seconds": 12.22,
      "text": "I'd say severe. Coughing and exercise definitely sets it off. I'd say all the time. I'd been needing to wear a pad, but that went away."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 95.24,
      "end_seconds": 99.93,
      "duration_seconds": 4.69,
      "text": "Let me check a few things. Any difficulty emptying or fever?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 101.81,
      "end_seconds": 104.08,
      "duration_seconds": 2.27,
      "text": "No, none of those."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 104.31,
      "end_seconds": 109.52,
      "duration_seconds": 5.21,
      "text": "Mm. Did you get back pain or burning when passing urine?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 110.06,
      "end_seconds": 114.37,
      "duration_seconds": 4.31,
      "text": "No, no back pain or burning when passing urine."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 115.93,
      "end_seconds": 119.55,
      "duration_seconds": 3.62,
      "text": "On the cardiac side, anything I should know?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 120.15,
      "end_seconds": 125.38,
      "duration_seconds": 5.23,
      "text": "My heart's been fine, as far as I know."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 138.46,
      "end_seconds": 139.86,
      "duration_seconds": 1.4,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 140.74,
      "end_seconds": 142.82,
      "duration_seconds": 2.08,
      "text": "No, nothing like that."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 151.55,
      "end_seconds": 155.43,
      "duration_seconds": 3.88,
      "text": "Do your parents or siblings have any long-term illnesses?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 156.52,
      "end_seconds": 158.62,
      "duration_seconds": 2.1,
      "text": "My mother has diabetes."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 160.34,
      "end_seconds": 163.16,
      "duration_seconds": 2.82,
      "text": "Before I prescribe anything, any allergies?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 163.93,
      "end_seconds": 167.3,
      "duration_seconds": 3.37,
      "text": "No allergies that I know of, no."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 168.79,
      "end_seconds": 170.14,
      "duration_seconds": 1.35,
      "text": "What about alcohol?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 171.27,
      "end_seconds": 175.88,
      "duration_seconds": 4.61,
      "text": "A beer or two most evenings, to be honest."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 176.91,
      "end_seconds": 178.35,
      "duration_seconds": 1.44,
      "text": "Do you smoke?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 180.16,
      "end_seconds": 183.71,
      "duration_seconds": 3.55,
      "text": "I stopped smoking about two years back."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 184.64,
      "end_seconds": 187.04,
      "duration_seconds": 2.4,
      "text": "Do you have a job?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 188.16,
      "end_seconds": 190.28,
      "duration_seconds": 2.12,
      "text": "I'm a self-employed electrician."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 191.06,
      "end_seconds": 194.21,
      "duration_seconds": 3.15,
      "text": "What do you do to keep active?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 195.6,
      "end_seconds": 198.3,
      "duration_seconds": 2.7,
      "text": "I cycle to work most mornings."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 199.06,
      "end_seconds": 201.08,
      "duration_seconds": 2.02,
      "text": "Are you living with family?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 202.24,
      "end_seconds": 206.43,
      "duration_seconds": 4.19,
      "text": "I stay with my daughter and her family."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 207.87,
      "end_seconds": 210.48,
      "duration_seconds": 2.61,
      "text": "Are you on any regular medication?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 211.24,
      "end_seconds": 212.87,
      "duration_seconds": 1.63,
      "text": "No, nothing regular."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 214.94,
      "end_seconds": 218.4,
      "duration_seconds": 3.46,
      "text": "Any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 219.92,
      "end_seconds": 223.27,
      "duration_seconds": 3.35,
      "text": "No, I've never had anything serious."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 224.32,
      "end_seconds": 227.71,
      "duration_seconds": 3.39,
      "text": "Let me examine, it won't take long."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 228.68,
      "end_seconds": 230.76,
      "duration_seconds": 2.08,
      "text": "Almost done with this part."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 244.56,
      "end_seconds": 249.74,
      "duration_seconds": 5.18,
      "text": "No bulge is visible when you cough, and the tummy is soft."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 254.71,
      "end_seconds": 284.9,
      "duration_seconds": 30.19,
      "text": "Okay, finished. Okay, so my impression is this: The most likely explanation is stress urinary incontinence. I'd also keep a urine infection in mind. I want a urine test done, that's for urinary leakage. Let's get a bladder diary, for urinary symptoms. It's a routine test and it'll give us a much clearer picture. Pelvic floor exercises, three sets a day, make a real difference over a couple of months."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 286.25,
      "end_seconds": 305.94,
      "duration_seconds": 19.69,
      "text": "Please take the tablets with food so they don't upset your stomach. I'll also refer you to a pelvic-floor physiotherapist. Do get help quickly if the symptoms get worse. Come back in eight weeks. Ask me anything before you go."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 306.79,
      "end_seconds": 309.32,
      "duration_seconds": 2.53,
      "text": "Alright, thanks. Bye for now."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 310.03,
      "end_seconds": 311.42,
      "duration_seconds": 1.39,
      "text": "Safe journey home."
    }
  ]
}