{
  "schema_version": "1.0",
  "encounter_id": "00305",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.86,
      "end_seconds": 4.49,
      "duration_seconds": 3.63,
      "text": "Hello, doctor. Where would you like me?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.03,
      "end_seconds": 12.25,
      "duration_seconds": 6.22,
      "text": "Yes, come in, take a seat. What can I do for you today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 16.09,
      "end_seconds": 20.93,
      "duration_seconds": 4.84,
      "text": "Doctor, I'm just here to help with the details."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 26.21,
      "end_seconds": 30.76,
      "duration_seconds": 4.55,
      "text": "I, I wanted to get lightheadedness looked at."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 32.21,
      "end_seconds": 35.2,
      "duration_seconds": 2.99,
      "text": "Okay, roughly when did it start?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 37.25,
      "end_seconds": 49.05,
      "duration_seconds": 11.8,
      "text": "About a week, I think... sorry, three weeks, I got that wrong. I took the morning off to come in today."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 49.3,
      "end_seconds": 52.84,
      "duration_seconds": 3.54,
      "text": "Okay, so. How much is it bothering you?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 54.86,
      "end_seconds": 64.32,
      "duration_seconds": 9.46,
      "text": "Pretty severe, if I'm being honest. Oh, and shortness of breath with it. Had that since last Tuesday."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 66.2,
      "end_seconds": 68.48,
      "duration_seconds": 2.28,
      "text": "How intense does it get?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 69.52,
      "end_seconds": 75.24,
      "duration_seconds": 5.72,
      "text": "Maybe a five out of ten on a bad day."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 77.19,
      "end_seconds": 78.76,
      "duration_seconds": 1.57,
      "text": "Have you been sweating?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 80.43,
      "end_seconds": 97.54,
      "duration_seconds": 17.11,
      "text": "Yes, uh, about the same, ten days. I've had a fluttering in the chest too, for three weeks. As for fluttering in the chest, I'd give it a five, out of ten."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 106.81,
      "end_seconds": 109.76,
      "duration_seconds": 2.95,
      "text": "Let me measure a few things."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 120.73,
      "end_seconds": 122.29,
      "duration_seconds": 1.56,
      "text": "Right, one second..."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 141.46,
      "end_seconds": 151.63,
      "duration_seconds": 10.17,
      "text": "Okay: temp 36.9 degrees, pulse is 106 beats a minute, blood pressure 118 over 75. And oxygen saturation is 99 percent."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 152.92,
      "end_seconds": 155.16,
      "duration_seconds": 2.24,
      "text": "Can I examine you now?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 156.8,
      "end_seconds": 160.9,
      "duration_seconds": 4.1,
      "text": "A little pressure here, tell me if it's tender."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 177.16,
      "end_seconds": 180.29,
      "duration_seconds": 3.13,
      "text": "No murmurs and the neck veins aren't distended."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 182.13,
      "end_seconds": 186.01,
      "duration_seconds": 3.88,
      "text": "A little pressure here, tell me if it's tender."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 193.7,
      "end_seconds": 195.73,
      "duration_seconds": 2.03,
      "text": "Pulse is irregular right now."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 200.59,
      "end_seconds": 204.74,
      "duration_seconds": 4.15,
      "text": "That's all I need, thank you. Alright, what about fainting?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 206.57,
      "end_seconds": 209.85,
      "duration_seconds": 3.28,
      "text": "No, you know, no fainting."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 211.58,
      "end_seconds": 215.06,
      "duration_seconds": 3.48,
      "text": "And what about chest pain, tremor or fever?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 216.47,
      "end_seconds": 219.51,
      "duration_seconds": 3.04,
      "text": "Nothing like that, um, no."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 224.61,
      "end_seconds": 227.23,
      "duration_seconds": 2.62,
      "text": "Right, is your mobility otherwise okay?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 228.51,
      "end_seconds": 230.74,
      "duration_seconds": 2.23,
      "text": "I move fine otherwise."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 231.58,
      "end_seconds": 234.32,
      "duration_seconds": 2.74,
      "text": "And your skin, any changes there?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 240.6,
      "end_seconds": 241.74,
      "duration_seconds": 1.14,
      "text": "No rashes."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 243.8,
      "end_seconds": 245.8,
      "duration_seconds": 2.0,
      "text": "Any surgery in your history?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 249.77,
      "end_seconds": 255.24,
      "duration_seconds": 5.47,
      "text": "Just my tonsils out, when I was a child."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 255.84,
      "end_seconds": 259.54,
      "duration_seconds": 3.7,
      "text": "Is there a family history of anything significant?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 260.67,
      "end_seconds": 262.86,
      "duration_seconds": 2.19,
      "text": "My father was diabetic."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 264.94,
      "end_seconds": 267.34,
      "duration_seconds": 2.4,
      "text": "Any drug or food allergies?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 268.61,
      "end_seconds": 279.08,
      "duration_seconds": 10.47,
      "text": "Right, I think I reacted to some antibiotic once, years ago. I don't remember which one, or what happened exactly."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 280.89,
      "end_seconds": 282.45,
      "duration_seconds": 1.56,
      "text": "Do you live alone?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 284.34,
      "end_seconds": 288.14,
      "duration_seconds": 3.8,
      "text": "Yes, I live on my own."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 289.37,
      "end_seconds": 291.76,
      "duration_seconds": 2.39,
      "text": "What do you do for work?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 293.41,
      "end_seconds": 298.75,
      "duration_seconds": 5.34,
      "text": "I work in an office, mostly sitting at a desk."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 300.67,
      "end_seconds": 303.28,
      "duration_seconds": 2.61,
      "text": "Any diagnoses you've been given before?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 304.62,
      "end_seconds": 313.79,
      "duration_seconds": 9.17,
      "text": "Yes, high blood pressure. My family kept telling me to get it checked. I have an underactive thyroid."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 331.36,
      "end_seconds": 334.78,
      "duration_seconds": 3.42,
      "text": "What medicines are you taking at the moment?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 336.51,
      "end_seconds": 340.59,
      "duration_seconds": 4.08,
      "text": "He takes telmisartan, 40 milligrams, once a day."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 342.05,
      "end_seconds": 352.37,
      "duration_seconds": 10.32,
      "text": "Having listened and examined, my working impression is palpitations with an unclear cause. I can't rule out too much caffeine yet."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 353.22,
      "end_seconds": 356.66,
      "duration_seconds": 3.44,
      "text": "What are the chances it's something bad?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 357.78,
      "end_seconds": 368.05,
      "duration_seconds": 10.27,
      "text": "I understand the worry. At the moment I'd say it's palpitations with an unclear cause, and we'll know more once the a thyroid test is back."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 379.03,
      "end_seconds": 396.3,
      "duration_seconds": 17.27,
      "text": "I'd like to arrange a thyroid test for palpitations. I'll request an ECG, it'll help with palpitations. I'm sending you for an echocardiogram because of palpitations. That will help us see what's going on underneath and decide the next step."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 398.09,
      "end_seconds": 401.75,
      "duration_seconds": 3.66,
      "text": "Where do I go for that?"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 402.68,
      "end_seconds": 432.52,
      "duration_seconds": 29.84,
      "text": "You'll be taking metoprolol, 25 milligrams, twice a day, until we review. You take it by mouth. It's for palpitations. The pharmacy will go through the details again when you pick it up. Cut back on tea, coffee and energy drinks, and note the time whenever it happens. Keep an eye out, and if you faint or have chest pain with the racing, call us the same day or go to emergency."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 434.11,
      "end_seconds": 436.99,
      "duration_seconds": 2.88,
      "text": "I'll want another look in two weeks."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 438.46,
      "end_seconds": 442.53,
      "duration_seconds": 4.07,
      "text": "I'll make the appointment on my way out."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 444.44,
      "end_seconds": 447.48,
      "duration_seconds": 3.04,
      "text": "Is there anything you wanted to ask?"
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 448.46,
      "end_seconds": 450.61,
      "duration_seconds": 2.15,
      "text": "No questions. Thank you."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 452.26,
      "end_seconds": 453.17,
      "duration_seconds": 0.91,
      "text": "Take care."
    }
  ]
}