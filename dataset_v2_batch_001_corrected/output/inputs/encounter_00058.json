{
  "schema_version": "1.0",
  "encounter_id": "00058",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.92,
      "end_seconds": 5.02,
      "duration_seconds": 4.1,
      "text": "Good morning, doctor. Can I come in?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.14,
      "end_seconds": 11.07,
      "duration_seconds": 4.93,
      "text": "That's alright, take a seat. Tell me why you've come."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 12.81,
      "end_seconds": 20.66,
      "duration_seconds": 7.85,
      "text": "Hmm, doctor, I've come along because I know the history, if it helps."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 22.28,
      "end_seconds": 26.9,
      "duration_seconds": 4.62,
      "text": "Of course, please stay. It's helpful to have you here."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 28.1,
      "end_seconds": 35.76,
      "duration_seconds": 7.66,
      "text": "He's been having sharp pain in the left chest when I breathe in, doctor."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 36.83,
      "end_seconds": 38.56,
      "duration_seconds": 1.73,
      "text": "When did it begin?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 40.47,
      "end_seconds": 51.16,
      "duration_seconds": 10.69,
      "text": "For six months, I'd say. I looked a few things up online, and that probably didn't help."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 52.02,
      "end_seconds": 55.87,
      "duration_seconds": 3.85,
      "text": "Alright, what's the pattern, is it there all day?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 57.22,
      "end_seconds": 61.36,
      "duration_seconds": 4.14,
      "text": "It happens a couple of times a week."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 63.37,
      "end_seconds": 69.66,
      "duration_seconds": 6.29,
      "text": "What about a low fever a few days ago, have you noticed that?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 71.31,
      "end_seconds": 74.79,
      "duration_seconds": 3.48,
      "text": "Yes, um, for three weeks."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 75.72,
      "end_seconds": 79.41,
      "duration_seconds": 3.69,
      "text": "How would you describe it, mild, moderate, severe?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 81.15,
      "end_seconds": 83.72,
      "duration_seconds": 2.57,
      "text": "I, I'd say severe."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 85.22,
      "end_seconds": 88.09,
      "duration_seconds": 2.87,
      "text": "Have you had a dry cough?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 89.79,
      "end_seconds": 91.5,
      "duration_seconds": 1.71,
      "text": "Yes, I have."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_4",
      "role": "NURSE",
      "start_seconds": 92.42,
      "end_seconds": 103.37,
      "duration_seconds": 10.95,
      "text": "Doctor, I've got the readings for you. Temperature 36.9, respiratory rate 16. SpO2 98 percent on room air, pulse is 79 beats a minute, pressure 112 over 80."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 105.03,
      "end_seconds": 105.98,
      "duration_seconds": 0.95,
      "text": "Okay, noted."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 107.21,
      "end_seconds": 110.72,
      "duration_seconds": 3.51,
      "text": "Let me examine, it won't take long."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 111.43,
      "end_seconds": 112.13,
      "duration_seconds": 0.7,
      "text": "Okay."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 113.84,
      "end_seconds": 116.4,
      "duration_seconds": 2.56,
      "text": "Just relax, I'll be quick."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 134.74,
      "end_seconds": 138.01,
      "duration_seconds": 3.27,
      "text": "Air entry is equal on both sides."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 138.55,
      "end_seconds": 139.25,
      "duration_seconds": 0.7,
      "text": "Okay."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 140.82,
      "end_seconds": 142.77,
      "duration_seconds": 1.95,
      "text": "Bear with me a second."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 151.29,
      "end_seconds": 155.42,
      "duration_seconds": 4.13,
      "text": "I can hear a faint rub on the left side."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 157.57,
      "end_seconds": 165.69,
      "duration_seconds": 8.12,
      "text": "That's all I need, thank you. A few quick ones: recent long travel or injury to the chest?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 167.12,
      "end_seconds": 170.23,
      "duration_seconds": 3.11,
      "text": "Yeah, nothing like that, no."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 170.92,
      "end_seconds": 176.36,
      "duration_seconds": 5.44,
      "text": "And what about breathlessness at rest, leg swelling or coughing up blood?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 177.06,
      "end_seconds": 186.1,
      "duration_seconds": 9.04,
      "text": "Well, um, no breathlessness at rest, leg swelling or coughing up blood, none of it."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 187.82,
      "end_seconds": 191.83,
      "duration_seconds": 4.01,
      "text": "How about your heart, any problems like that?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 192.61,
      "end_seconds": 195.39,
      "duration_seconds": 2.78,
      "text": "No, nothing with my heart."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 196.94,
      "end_seconds": 201.23,
      "duration_seconds": 4.29,
      "text": "Any change in your bowel habit or your stomach generally?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 205.3,
      "end_seconds": 210.09,
      "duration_seconds": 4.79,
      "text": "Okay, you know, so no, that side's been fine."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 211.74,
      "end_seconds": 214.11,
      "duration_seconds": 2.37,
      "text": "Does anything run in the family?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 216.2,
      "end_seconds": 221.6,
      "duration_seconds": 5.4,
      "text": "My father had kidney stones. My sister has epilepsy."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 233.22,
      "end_seconds": 235.88,
      "duration_seconds": 2.66,
      "text": "And what do you usually eat?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 236.58,
      "end_seconds": 240.0,
      "duration_seconds": 3.42,
      "text": "Mostly home-cooked food, rice and vegetables."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 240.61,
      "end_seconds": 242.03,
      "duration_seconds": 1.42,
      "text": "What's your job?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 243.94,
      "end_seconds": 247.06,
      "duration_seconds": 3.12,
      "text": "I teach at a primary school."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 263.3,
      "end_seconds": 266.77,
      "duration_seconds": 3.47,
      "text": "What medicines are you taking at the moment?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 268.69,
      "end_seconds": 279.23,
      "duration_seconds": 10.54,
      "text": "Well, it's furosemide, 40 milligrams, every morning for the fluid. Iron tablets, once a day for my blood count."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 280.72,
      "end_seconds": 288.52,
      "duration_seconds": 7.8,
      "text": "He is supposed to take it once a day, but I can't say he always does."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 289.47,
      "end_seconds": 295.06,
      "duration_seconds": 5.59,
      "text": "So, I'm on ibuprofen, 400 milligrams, when it hurts."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_4",
      "role": "NURSE",
      "start_seconds": 296.29,
      "end_seconds": 300.82,
      "duration_seconds": 4.53,
      "text": "Doctor, our chart from the last visit lists it as 200 milligrams."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 302.63,
      "end_seconds": 307.07,
      "duration_seconds": 4.44,
      "text": "Hm, that's different. Is the latest prescription anywhere near you?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 308.26,
      "end_seconds": 313.25,
      "duration_seconds": 4.99,
      "text": "I, I don't think I have it with me."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 314.87,
      "end_seconds": 318.82,
      "duration_seconds": 3.95,
      "text": "Moving on to your background, any past medical history?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 320.23,
      "end_seconds": 333.85,
      "duration_seconds": 13.62,
      "text": "I have heart failure, for two years. Okay, um, so yes, low haemoglobin. I'm not great at remembering details, so bear with me."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 334.37,
      "end_seconds": 343.38,
      "duration_seconds": 9.01,
      "text": "Alright, heart failure, that matches what I have here. Are there any allergies on your record that I should check?"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 345.28,
      "end_seconds": 356.62,
      "duration_seconds": 11.34,
      "text": "Well, I think I reacted to some antibiotic once, years ago. I don't remember which one, or what happened exactly."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 369.81,
      "end_seconds": 377.23,
      "duration_seconds": 7.42,
      "text": "Taking everything into account, it fits best with viral pleurisy. We shouldn't forget a chest infection."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 378.95,
      "end_seconds": 381.84,
      "duration_seconds": 2.89,
      "text": "Is it something serious, doctor?"
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 383.91,
      "end_seconds": 391.6,
      "duration_seconds": 7.69,
      "text": "I can't promise yet, but most people with viral pleurisy do well once it's treated properly."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_4",
      "role": "NURSE",
      "start_seconds": 392.66,
      "end_seconds": 396.49,
      "duration_seconds": 3.83,
      "text": "I've already done an ECG, it's ready for you."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 397.79,
      "end_seconds": 404.41,
      "duration_seconds": 6.62,
      "text": "Thanks, I'll check it. A chest X-ray is what I'd like next, for pleuritic pain."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 404.96,
      "end_seconds": 407.49,
      "duration_seconds": 2.53,
      "text": "Does it need any preparation?"
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 409.52,
      "end_seconds": 427.13,
      "duration_seconds": 17.61,
      "text": "Regular pain relief makes it easier to take deep breaths, which protects the lung. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose. Book a review in a week."
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 428.37,
      "end_seconds": 433.08,
      "duration_seconds": 4.71,
      "text": "I'll make the appointment on my way out."
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 433.64,
      "end_seconds": 436.41,
      "duration_seconds": 2.77,
      "text": "Call the clinic if you need us."
    },
    {
      "segment_id": "SEG0059",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 438.14,
      "end_seconds": 441.28,
      "duration_seconds": 3.14,
      "text": "Hmm, thanks, that was helpful."
    }
  ]
}