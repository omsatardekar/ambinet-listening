{
  "schema_version": "1.0",
  "encounter_id": "00403",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.38,
      "end_seconds": 4.75,
      "duration_seconds": 3.37,
      "text": "Hello, doctor. It's my turn, I think."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 11.07,
      "end_seconds": 15.05,
      "duration_seconds": 3.98,
      "text": "You're fine, sit down. So, what brings you in?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 16.98,
      "end_seconds": 22.08,
      "duration_seconds": 5.1,
      "text": "hello, doctor, I came in with them, if that's okay"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 23.38,
      "end_seconds": 26.34,
      "duration_seconds": 2.96,
      "text": "absolutely, come and sit beside them"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 27.27,
      "end_seconds": 30.03,
      "duration_seconds": 2.76,
      "text": "I'm here because of skipped beats."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 30.73,
      "end_seconds": 32.68,
      "duration_seconds": 1.95,
      "text": "when did it begin?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 34.48,
      "end_seconds": 38.15,
      "duration_seconds": 3.67,
      "text": "It's been like this since last Tuesday."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 38.81,
      "end_seconds": 41.54,
      "duration_seconds": 2.73,
      "text": "is it worse with anything in particular?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 43.13,
      "end_seconds": 53.59,
      "duration_seconds": 10.46,
      "text": "I notice it it more with coffee. I've also had occasional lightheadedness. As for occasional lightheadedness, pretty moderate, if I'm being honest"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 55.33,
      "end_seconds": 57.67,
      "duration_seconds": 2.34,
      "text": "Let me check your vitals now."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 68.33,
      "end_seconds": 69.11,
      "duration_seconds": 0.78,
      "text": "Almost there..."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 78.12,
      "end_seconds": 86.12,
      "duration_seconds": 8.0,
      "text": "Okay: saturation 99 percent, temp 36.7 degrees, pressure 122 over 73. And heart rate 71."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 87.66,
      "end_seconds": 90.38,
      "duration_seconds": 2.72,
      "text": "I'd like to examine you now."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 91.37,
      "end_seconds": 95.35,
      "duration_seconds": 3.98,
      "text": "a little pressure here, tell me if it's tender"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 108.33,
      "end_seconds": 114.8,
      "duration_seconds": 6.47,
      "text": "pulse is regular at the moment, with a couple of early beats while I listened"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 116.31,
      "end_seconds": 119.98,
      "duration_seconds": 3.67,
      "text": "a little pressure here, tell me if it's tender"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 128.73,
      "end_seconds": 131.91,
      "duration_seconds": 3.18,
      "text": "Heart sounds are normal with no murmur."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 134.73,
      "end_seconds": 142.11,
      "duration_seconds": 7.38,
      "text": "All done, you can get dressed. Let me check a few things. Any fainting or chest pain?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 147.74,
      "end_seconds": 150.1,
      "duration_seconds": 2.36,
      "text": "Nothing like that, no."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 150.89,
      "end_seconds": 156.26,
      "duration_seconds": 5.37,
      "text": "Let me check a few things. Any breathlessness or energy drinks?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 161.31,
      "end_seconds": 165.11,
      "duration_seconds": 3.8,
      "text": "no breathlessness or energy drinks, none of it"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 167.1,
      "end_seconds": 169.42,
      "duration_seconds": 2.32,
      "text": "your breathing, any trouble there?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 170.81,
      "end_seconds": 173.65,
      "duration_seconds": 2.84,
      "text": "No, my breathing's been fine."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 175.25,
      "end_seconds": 179.38,
      "duration_seconds": 4.13,
      "text": "What about your tummy and bowels, anything unusual there?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 180.66,
      "end_seconds": 183.35,
      "duration_seconds": 2.69,
      "text": "No, that side's been fine."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 202.28,
      "end_seconds": 205.08,
      "duration_seconds": 2.8,
      "text": "have you had any surgery before?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 205.93,
      "end_seconds": 211.12,
      "duration_seconds": 5.19,
      "text": "I had a lump removed from my back years ago"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 226.73,
      "end_seconds": 231.02,
      "duration_seconds": 4.29,
      "text": "Any medication at the moment, including things from the pharmacy?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 232.14,
      "end_seconds": 240.4,
      "duration_seconds": 8.26,
      "text": "Okay, so she takes Thyronorm, 50 micrograms, every morning. It's escitalopram, 10 milligrams, once a day, doctor."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 246.23,
      "end_seconds": 251.17,
      "duration_seconds": 4.94,
      "text": "What about family history, any illnesses that run in the family?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 252.02,
      "end_seconds": 254.36,
      "duration_seconds": 2.34,
      "text": "My father had a stroke."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 255.29,
      "end_seconds": 259.71,
      "duration_seconds": 4.42,
      "text": "what about your general health, any conditions you're being treated for?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 261.24,
      "end_seconds": 271.33,
      "duration_seconds": 10.09,
      "text": "An underactive thyroid, for nearly five years. It's the not knowing that gets to to me. Yes, anxiety."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 272.93,
      "end_seconds": 275.17,
      "duration_seconds": 2.24,
      "text": "Are you working or retired?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 276.42,
      "end_seconds": 279.75,
      "duration_seconds": 3.33,
      "text": "Retired. I stopped a few years back"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 281.52,
      "end_seconds": 283.46,
      "duration_seconds": 1.94,
      "text": "Okay, how's your diet?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 285.22,
      "end_seconds": 286.67,
      "duration_seconds": 1.45,
      "text": "I'm mostly vegetarian"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 299.04,
      "end_seconds": 304.18,
      "duration_seconds": 5.14,
      "text": "Are there any allergies on your record that I should check?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 305.9,
      "end_seconds": 313.11,
      "duration_seconds": 7.21,
      "text": "I was told I'm allergic to pollen, but I don't remember what reaction I had."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 314.98,
      "end_seconds": 348.92,
      "duration_seconds": 33.94,
      "text": "So where does that leave us? I think we're dealing with benign extra heartbeats, though we should confirm at this stage. It could also be a rhythm problem, so we'll keep that open. I'll request an ECG, it'll help with palpitations. Try cutting out caffeine for two weeks and see if the the beats settle. Come back or go to emergency straight away if the symptoms get worse."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 353.23,
      "end_seconds": 355.6,
      "duration_seconds": 2.37,
      "text": "Yes, I'll watch for that."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 356.28,
      "end_seconds": 362.46,
      "duration_seconds": 6.18,
      "text": "Please come and see me in four weeks. Call the clinic if you need us."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 363.72,
      "end_seconds": 366.07,
      "duration_seconds": 2.35,
      "text": "Thanks so much, doctor."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 366.87,
      "end_seconds": 368.05,
      "duration_seconds": 1.18,
      "text": "all the best"
    }
  ]
}