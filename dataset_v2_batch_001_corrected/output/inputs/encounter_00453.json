{
  "schema_version": "1.0",
  "encounter_id": "00453",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.88,
      "end_seconds": 6.77,
      "duration_seconds": 5.89,
      "text": "Good afternoon, doctor, the receptionist said you'd see me now."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.76,
      "end_seconds": 12.03,
      "duration_seconds": 3.27,
      "text": "yes, do sit. Tell me what's been happening"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 16.09,
      "end_seconds": 32.74,
      "duration_seconds": 16.65,
      "text": "uh, it's severe pain in my right side that comes in waves i thought I'd wait, but it hasn't gone i told myself I'd wait and see, and here I am"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 33.39,
      "end_seconds": 36.39,
      "duration_seconds": 3.0,
      "text": "a few measurements, then we'll continue"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 46.49,
      "end_seconds": 48.11,
      "duration_seconds": 1.62,
      "text": "Hold still for me..."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 62.73,
      "end_seconds": 75.52,
      "duration_seconds": 12.79,
      "text": "Okay: temperature is 37.1 degrees, BP is 120 over 70. And saturation 99 percent, heart rate 121. Is this recent, or has it been a while?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 77.26,
      "end_seconds": 79.19,
      "duration_seconds": 1.93,
      "text": "probably two days yeah"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 80.0,
      "end_seconds": 82.04,
      "duration_seconds": 2.04,
      "text": "okay, anything that helps?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 83.37,
      "end_seconds": 87.17,
      "duration_seconds": 3.8,
      "text": "A hot water bottle helps a a bit."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 88.25,
      "end_seconds": 91.62,
      "duration_seconds": 3.37,
      "text": "And what about testicular pain or vomiting?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 93.62,
      "end_seconds": 97.72,
      "duration_seconds": 4.1,
      "text": "No, you know, no testicular pain or vomiting."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 99.8,
      "end_seconds": 100.58,
      "duration_seconds": 0.78,
      "text": "Any fever?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 101.32,
      "end_seconds": 102.98,
      "duration_seconds": 1.66,
      "text": "no, no fever"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 104.03,
      "end_seconds": 107.46,
      "duration_seconds": 3.43,
      "text": "anything with your nerves, like weakness or numbness?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 108.24,
      "end_seconds": 111.26,
      "duration_seconds": 3.02,
      "text": "okay, so no, nothing like that"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 112.2,
      "end_seconds": 116.12,
      "duration_seconds": 3.92,
      "text": "how about your heart, any problems like that?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 117.36,
      "end_seconds": 118.88,
      "duration_seconds": 1.52,
      "text": "nothing like that"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 136.06,
      "end_seconds": 137.3,
      "duration_seconds": 1.24,
      "text": "Any regular medication?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 138.76,
      "end_seconds": 140.44,
      "duration_seconds": 1.68,
      "text": "No, nothing regular."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 141.19,
      "end_seconds": 143.59,
      "duration_seconds": 2.4,
      "text": "Does anything run in the family?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 145.64,
      "end_seconds": 148.96,
      "duration_seconds": 3.32,
      "text": "My mother had high blood pressure."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 149.74,
      "end_seconds": 154.64,
      "duration_seconds": 4.9,
      "text": "Tell me about your routine, work, habits, that sort of thing."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 156.09,
      "end_seconds": 166.68,
      "duration_seconds": 10.59,
      "text": "I try to avoid too much sugar. I'm a software engineer, so I'm at a screen all day. I play badminton on Sundays"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 176.32,
      "end_seconds": 186.26,
      "duration_seconds": 9.94,
      "text": "alright, are there any allergies on your record that I should check? It helps to be thorough at this stage"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 186.93,
      "end_seconds": 189.33,
      "duration_seconds": 2.4,
      "text": "No, nothing I'm aware of."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 205.03,
      "end_seconds": 208.39,
      "duration_seconds": 3.36,
      "text": "any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 209.6,
      "end_seconds": 212.9,
      "duration_seconds": 3.3,
      "text": "No, I've never had anything serious."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 214.82,
      "end_seconds": 217.24,
      "duration_seconds": 2.42,
      "text": "Can I examine you now?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 218.25,
      "end_seconds": 220.21,
      "duration_seconds": 1.96,
      "text": "almost done with this part"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 235.13,
      "end_seconds": 242.01,
      "duration_seconds": 6.88,
      "text": "There's tenderness in the right loin when I tap, and your tummy is soft."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 244.98,
      "end_seconds": 247.86,
      "duration_seconds": 2.88,
      "text": "Right, you can sit back down."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 260.34,
      "end_seconds": 265.7,
      "duration_seconds": 5.36,
      "text": "Right, here's what I'm thinking. My working impression is a kidney stone."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 266.63,
      "end_seconds": 271.71,
      "duration_seconds": 5.08,
      "text": "I've been thinking the worst, to be honest. Is it bad?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 272.84,
      "end_seconds": 308.98,
      "duration_seconds": 36.14,
      "text": "I can't promise yet, but most people with a kidney stone do well once it's treated properly. We should do a CT scan of the kidneys and bladder for suspected renal colic. We should do a urine test for flank pain. I'll start you on paracetamol, 1 gram, every six hours if needed, for three days. You take it by mouth. That's for pain. It's a commonly used medicine and most people tolerate it well."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 312.77,
      "end_seconds": 330.12,
      "duration_seconds": 17.35,
      "text": "Drink three litres of water a day and try to strain your urine so we can catch the stone if it passes. Please come and see me in a week. Okay, ask me anything before you go."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 332.97,
      "end_seconds": 335.78,
      "duration_seconds": 2.81,
      "text": "So, I appreciate it, doctor."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 337.55,
      "end_seconds": 338.38,
      "duration_seconds": 0.83,
      "text": "Take care."
    }
  ]
}