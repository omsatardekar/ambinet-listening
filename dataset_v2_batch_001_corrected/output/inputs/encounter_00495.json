      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 150.34,
      "end_seconds": 152.22,
      "duration_seconds": 1.88,
      "text": "Okay, how's your diet?"
