      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 146.43,
      "end_seconds": 148.89,
      "duration_seconds": 2.46,
      "text": "I play badminton on Sundays."
