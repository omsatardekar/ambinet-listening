    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 68.27,
      "end_seconds": 70.0,
      "duration_seconds": 1.73,
      "text": "No, no fever."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 70.94,
      "end_seconds": 75.87,
      "duration_seconds": 4.93,
      "text": "any vaginal discharge, back pain or similar episode recently at all?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 76.67,
      "end_seconds": 83.33,
      "duration_seconds": 6.66,
      "text": "I, I haven't had vaginal discharge, back pain or similar episode recently, no."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 84.56,
      "end_seconds": 88.62,
      "duration_seconds": 4.06,
      "text": "What about your tummy and bowels, anything unusual there?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 92.6,
      "end_seconds": 94.86,
      "duration_seconds": 2.26,
      "text": "No, all normal there."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 106.01,
      "end_seconds": 110.08,
      "duration_seconds": 4.07,
      "text": "Okay, any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 112.06,
      "end_seconds": 115.25,
      "duration_seconds": 3.19,
      "text": "No, I've never had anything serious."
    },
