      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 153.63,
      "end_seconds": 155.26,
      "duration_seconds": 1.63,
      "text": "I'm mostly vegetarian."
