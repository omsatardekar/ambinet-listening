  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.87,
      "end_seconds": 4.17,
      "duration_seconds": 3.3,
      "text": "hello, doctor. Where would you like me?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.04,
      "end_seconds": 8.82,
      "duration_seconds": 3.78,
      "text": "You're fine, sit down. So, what brings you in?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 10.18,
      "end_seconds": 18.25,
      "duration_seconds": 8.07,
      "text": "Mainly burning when I pass urine. There's a couple of other things, but that's the main one."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 19.79,
      "end_seconds": 22.7,
      "duration_seconds": 2.91,
      "text": "how far back does it go?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 23.6,
      "end_seconds": 26.79,
      "duration_seconds": 3.19,
      "text": "Oh, for one week, I'd say."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 28.73,
      "end_seconds": 30.6,
      "duration_seconds": 1.87,
      "text": "does anything settle it?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 31.15,
      "end_seconds": 34.52,
      "duration_seconds": 3.37,
      "text": "I get some relief from drinking water"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 35.61,
      "end_seconds": 39.7,
      "duration_seconds": 4.09,
      "text": "How would you describe it, mild, moderate, severe?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 40.35,
      "end_seconds": 43.2,
      "duration_seconds": 2.85,
      "text": "Pretty moderate, if I'm being honest."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 44.47,
      "end_seconds": 46.42,
      "duration_seconds": 1.95,
      "text": "How often does it happen?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 48.33,
      "end_seconds": 51.71,
      "duration_seconds": 3.38,
      "text": "it's once or twice a day"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 64.35,
      "end_seconds": 66.46,
      "duration_seconds": 2.11,
      "text": "has there been any fever?"
