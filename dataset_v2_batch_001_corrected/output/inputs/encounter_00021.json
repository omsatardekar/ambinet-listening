{
  "schema_version": "1.0",
  "encounter_id": "00021",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 0.86,
      "end_seconds": 8.69,
      "duration_seconds": 7.83,
      "text": "Doctor, the patient's with us now. I did the usual checks at the front, so just say when you want them."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 9.67,
      "end_seconds": 13.87,
      "duration_seconds": 4.2,
      "text": "Thanks, that's helpful. Hello, please sit. What's been happening?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 14.99,
      "end_seconds": 20.86,
      "duration_seconds": 5.87,
      "text": "Morning, doctor. I'll stay and and fill in anything that's missed."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 21.99,
      "end_seconds": 26.55,
      "duration_seconds": 4.56,
      "text": "that's fine, sit down. We'll go through it together"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 27.51,
      "end_seconds": 33.24,
      "duration_seconds": 5.73,
      "text": "Oh, you know, we came because of breathlessness on the stairs."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 34.61,
      "end_seconds": 37.53,
      "duration_seconds": 2.92,
      "text": "Alright, and when did that start?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 38.97,
      "end_seconds": 43.02,
      "duration_seconds": 4.05,
      "text": "well, it's been going on for ten days"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 43.56,
      "end_seconds": 44.26,
      "duration_seconds": 0.7,
      "text": "Right."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 44.82,
      "end_seconds": 51.99,
      "duration_seconds": 7.17,
      "text": "I was just going to say that the main thing is—"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 52.09,
      "end_seconds": 58.46,
      "duration_seconds": 6.37,
      "text": "Sorry to cut in, doctor, quick question: shall I bring the trolley in now or later?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 60.29,
      "end_seconds": 62.38,
      "duration_seconds": 2.09,
      "text": "Later, thanks. Please go on."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 63.76,
      "end_seconds": 75.51,
      "duration_seconds": 11.75,
      "text": "I've had a racing heart sometimes too, for about three months. So, I've had dizziness too, for three days."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 77.43,
      "end_seconds": 79.98,
      "duration_seconds": 2.55,
      "text": "Is it mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 82.02,
      "end_seconds": 85.77,
      "duration_seconds": 3.75,
      "text": "Well, it feels mild to me."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 86.82,
      "end_seconds": 90.2,
      "duration_seconds": 3.38,
      "text": "Any black stools, chest pain or weight loss?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 91.58,
      "end_seconds": 104.26,
      "duration_seconds": 12.68,
      "text": "No, no black stools, no chest pain, no weight loss. I was feeling tired at one point, but that went away on its own."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 104.9,
      "end_seconds": 109.28,
      "duration_seconds": 4.38,
      "text": "Any heavy periods or blood in the stool at all?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 110.14,
      "end_seconds": 116.78,
      "duration_seconds": 6.64,
      "text": "Right, I haven't had heavy periods or blood in the stool, no."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 117.79,
      "end_seconds": 120.73,
      "duration_seconds": 2.94,
      "text": "Any problems with your joints or muscles?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 122.43,
      "end_seconds": 124.7,
      "duration_seconds": 2.27,
      "text": "I move fine otherwise."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 135.72,
      "end_seconds": 138.24,
      "duration_seconds": 2.52,
      "text": "Have you got any chronic problems?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 138.9,
      "end_seconds": 143.76,
      "duration_seconds": 4.86,
      "text": "So, I've had acid reflux for two years now."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 145.59,
      "end_seconds": 150.87,
      "duration_seconds": 5.28,
      "text": "okay, I can see acid reflux in your file as well"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 159.44,
      "end_seconds": 162.96,
      "duration_seconds": 3.52,
      "text": "Let's go through your medication. What are you taking?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 164.92,
      "end_seconds": 170.66,
      "duration_seconds": 5.74,
      "text": "Hmm, he takes omeprazole, 20 milligrams, once a day."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 171.44,
      "end_seconds": 173.14,
      "duration_seconds": 1.7,
      "text": "And for how long?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 174.5,
      "end_seconds": 176.16,
      "duration_seconds": 1.66,
      "text": "For two months."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 178.06,
      "end_seconds": 180.78,
      "duration_seconds": 2.72,
      "text": "Pantoprazole I don't take anymore."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 181.82,
      "end_seconds": 185.85,
      "duration_seconds": 4.03,
      "text": "Let's talk a little about your daily life and habits."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 187.62,
      "end_seconds": 202.07,
      "duration_seconds": 14.45,
      "text": "I used to smoke but I quit five years ago. I gave up drinking about three years ago. Not really, I don't get much exercise."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 203.27,
      "end_seconds": 205.48,
      "duration_seconds": 2.21,
      "text": "Any drug or food allergies?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 206.03,
      "end_seconds": 218.8,
      "duration_seconds": 12.77,
      "text": "hmm, there was some antibiotic, I was told I was allergic. But I couldn't tell you what it was called or what it did"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 219.84,
      "end_seconds": 221.54,
      "duration_seconds": 1.7,
      "text": "Any procedures or operations?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 222.34,
      "end_seconds": 227.21,
      "duration_seconds": 4.87,
      "text": "Well, yes, I had my gallbladder removed, in 2016."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 231.82,
      "end_seconds": 241.17,
      "duration_seconds": 9.35,
      "text": "Okay, so the vitals from earlier. Saturation 96 percent, heart rate 108. Temp 37.1 degrees, respiratory rate 20, blood pressure 134 over 78."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 242.5,
      "end_seconds": 243.41,
      "duration_seconds": 0.91,
      "text": "Okay, noted."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 246.01,
      "end_seconds": 249.56,
      "duration_seconds": 3.55,
      "text": "Come over here and I'll have a look."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 251.46,
      "end_seconds": 253.21,
      "duration_seconds": 1.75,
      "text": "let me press here"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 265.65,
      "end_seconds": 269.95,
      "duration_seconds": 4.3,
      "text": "Heart sounds are normal, I don't hear any murmur."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 271.87,
      "end_seconds": 275.26,
      "duration_seconds": 3.39,
      "text": "okay, stay still while I have a look"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 291.42,
      "end_seconds": 293.66,
      "duration_seconds": 2.24,
      "text": "Your eyelids are pale inside."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 297.82,
      "end_seconds": 309.89,
      "duration_seconds": 12.07,
      "text": "okay, you can sit up so, based on the history and and the examination, it fits best with anaemia of some kind a thyroid problem is also on my list"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 314.27,
      "end_seconds": 318.84,
      "duration_seconds": 4.57,
      "text": "uh, is this something I'll have for good?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 319.43,
      "end_seconds": 332.77,
      "duration_seconds": 13.34,
      "text": "nothing I've seen today points to an emergency. It looks like anaemia of some kind, but I'd like to confirm. Let's get a full blood count, for pallor"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 333.6,
      "end_seconds": 336.26,
      "duration_seconds": 2.66,
      "text": "does it need any preparation?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 339.97,
      "end_seconds": 344.63,
      "duration_seconds": 4.66,
      "text": "I'll request a ferritin level, it'll help with possible iron deficiency."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 345.92,
      "end_seconds": 347.57,
      "duration_seconds": 1.65,
      "text": "okay, that's fine"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 348.65,
      "end_seconds": 375.01,
      "duration_seconds": 26.36,
      "text": "What I'm giving you is ferrous sulfate, 200 milligrams, once a day, for three months. That should help with possible iron deficiency. Iron can darken the stools and bother the stomach, so take it after food. Cut down on salt and fried food for now, it really does make a difference. A vitamin B12 level is something we might do if this doesn't improve next month."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 379.54,
      "end_seconds": 393.34,
      "duration_seconds": 13.8,
      "text": "keep an eye out, and if the symptoms get worse, call us the same day or go to emergency. Let's review you after the results are back. Okay, we're done for today. Take care"
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 395.12,
      "end_seconds": 398.15,
      "duration_seconds": 3.03,
      "text": "I appreciate it, uh, doctor"
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 400.06,
      "end_seconds": 401.39,
      "duration_seconds": 1.33,
      "text": "All the best."
    }
  ]
}