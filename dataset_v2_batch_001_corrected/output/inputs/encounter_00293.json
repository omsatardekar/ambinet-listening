{
  "schema_version": "1.0",
  "encounter_id": "00293",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.06,
      "end_seconds": 4.5,
      "duration_seconds": 3.44,
      "text": "Morning. Nice to finally see you, doctor."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.23,
      "end_seconds": 10.36,
      "duration_seconds": 4.13,
      "text": "Right on time. Sit, please. How can I help?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 12.23,
      "end_seconds": 17.05,
      "duration_seconds": 4.82,
      "text": "Good morning, doctor. I came along to help out."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 17.81,
      "end_seconds": 21.33,
      "duration_seconds": 3.52,
      "text": "Good, that'll be useful. Pull up a chair."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 22.82,
      "end_seconds": 28.8,
      "duration_seconds": 5.98,
      "text": "It's a blocked nose, doctor. She didn't want to come, but I insisted."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 30.56,
      "end_seconds": 34.49,
      "duration_seconds": 3.93,
      "text": "Alright, first the numbers, if you don't mind."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 42.29,
      "end_seconds": 43.13,
      "duration_seconds": 0.84,
      "text": "One second..."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 57.46,
      "end_seconds": 66.44,
      "duration_seconds": 8.98,
      "text": "Okay: temperature 36.7, BP is 111 over 79, SpO2 98 percent on room air. And pulse 64. When did it begin?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 68.36,
      "end_seconds": 72.69,
      "duration_seconds": 4.33,
      "text": "It's been about a week, I'm fairly sure."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 73.51,
      "end_seconds": 76.01,
      "duration_seconds": 2.5,
      "text": "Is it mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 77.06,
      "end_seconds": 81.93,
      "duration_seconds": 4.87,
      "text": "Maybe a seven out of ten on a bad day."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 82.89,
      "end_seconds": 85.71,
      "duration_seconds": 2.82,
      "text": "Does it come along with anything else?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 86.7,
      "end_seconds": 102.35,
      "duration_seconds": 15.65,
      "text": "Uh, um, when it starts I tend to get reduced sense of smell as well. And there's pressure in the face as well, five days now."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 103.04,
      "end_seconds": 105.21,
      "duration_seconds": 2.17,
      "text": "Does anything make it better?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 110.3,
      "end_seconds": 117.34,
      "duration_seconds": 7.04,
      "text": "Steam helps a bit. The reduced sense of smell? That's been for about four days."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 119.31,
      "end_seconds": 121.09,
      "duration_seconds": 1.78,
      "text": "Any sign of nosebleeds?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 125.37,
      "end_seconds": 128.96,
      "duration_seconds": 3.59,
      "text": "Um, I haven't noticed any nosebleeds."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 129.32,
      "end_seconds": 136.25,
      "duration_seconds": 6.93,
      "text": "Okay, keep going. Let me check a few things. Any stiff neck, fever or vision changes?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 138.15,
      "end_seconds": 140.14,
      "duration_seconds": 1.99,
      "text": "No. None of those."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 141.61,
      "end_seconds": 143.95,
      "duration_seconds": 2.34,
      "text": "Your breathing, any trouble there?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 145.07,
      "end_seconds": 146.13,
      "duration_seconds": 1.06,
      "text": "Breathing's normal."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 147.65,
      "end_seconds": 151.18,
      "duration_seconds": 3.53,
      "text": "How are your joints, any aches elsewhere?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 152.29,
      "end_seconds": 153.93,
      "duration_seconds": 1.64,
      "text": "Nothing else aches."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 169.41,
      "end_seconds": 174.52,
      "duration_seconds": 5.11,
      "text": "Right, anyone in the family with similar problems or other conditions?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 175.12,
      "end_seconds": 178.42,
      "duration_seconds": 3.3,
      "text": "Right, my sister has thyroid problems."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 180.52,
      "end_seconds": 184.35,
      "duration_seconds": 3.83,
      "text": "So, any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 184.9,
      "end_seconds": 188.29,
      "duration_seconds": 3.39,
      "text": "No, none that I know of."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 189.1,
      "end_seconds": 192.02,
      "duration_seconds": 2.92,
      "text": "What medicines do you take regularly?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 193.97,
      "end_seconds": 196.99,
      "duration_seconds": 3.02,
      "text": "Otrivin nasal drops, twice a day."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 207.57,
      "end_seconds": 212.59,
      "duration_seconds": 5.02,
      "text": "Tell me about your routine, work, habits, that sort of thing."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 213.62,
      "end_seconds": 225.56,
      "duration_seconds": 11.94,
      "text": "I run a small shop, so I'm on my feet a lot. I walk for about half an hour most days. I skip breakfast most days."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 227.53,
      "end_seconds": 232.78,
      "duration_seconds": 5.25,
      "text": "Alright, what about allergies, to medicines or foods or anything else?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 234.35,
      "end_seconds": 237.76,
      "duration_seconds": 3.41,
      "text": "I don't have any known medication allergies."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 240.1,
      "end_seconds": 243.5,
      "duration_seconds": 3.4,
      "text": "Alright, if you're comfortable, I'll examine you now."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 244.62,
      "end_seconds": 247.11,
      "duration_seconds": 2.49,
      "text": "Just relax, I'll be quick."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 263.88,
      "end_seconds": 268.86,
      "duration_seconds": 4.98,
      "text": "There's tenderness when I press over the cheeks and above the eyebrows."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 269.81,
      "end_seconds": 272.22,
      "duration_seconds": 2.41,
      "text": "Bear with me a second."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 290.96,
      "end_seconds": 293.78,
      "duration_seconds": 2.82,
      "text": "The nose is congested with swollen lining."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 294.35,
      "end_seconds": 295.42,
      "duration_seconds": 1.07,
      "text": "No problem."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 299.82,
      "end_seconds": 302.49,
      "duration_seconds": 2.67,
      "text": "All done, you can get dressed."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 310.47,
      "end_seconds": 313.93,
      "duration_seconds": 3.46,
      "text": "Putting it all together, it points towards sinusitis."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 315.86,
      "end_seconds": 319.56,
      "duration_seconds": 3.7,
      "text": "What are the chances it's something bad?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 321.15,
      "end_seconds": 350.12,
      "duration_seconds": 28.97,
      "text": "I understand the worry. At the moment I'd say it's sinusitis, and we'll know more once the an X-ray of the sinuses is back. I'd like to arrange an X-ray of the sinuses for sinusitis. For this, amoxicillin-clavulanate, 625 milligrams, twice a day, for five days. You take it by mouth. That should help with sinusitis. For this, saline nasal spray, three times a day, for one week. It's for nasal congestion."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 351.01,
      "end_seconds": 363.6,
      "duration_seconds": 12.59,
      "text": "Steam a couple of times a day and saline rinses will help clear things. Let's plan a check if it's not better in a week. Okay, we're done for today. Take care."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 365.33,
      "end_seconds": 367.92,
      "duration_seconds": 2.59,
      "text": "Alright, thanks. Bye for now."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 369.02,
      "end_seconds": 369.72,
      "duration_seconds": 0.7,
      "text": "Goodbye."
    }
  ]
}