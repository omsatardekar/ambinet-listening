  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.25,
      "end_seconds": 4.6,
      "duration_seconds": 3.35,
      "text": "Hi, nice to see you. Sit down, please."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 5.33,
      "end_seconds": 6.24,
      "duration_seconds": 0.91,
      "text": "Hi. Thanks."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 7.19,
      "end_seconds": 12.03,
      "duration_seconds": 4.84,
      "text": "Morning, doctor. I'll stay and fill in anything that's missed."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 13.6,
      "end_seconds": 19.73,
      "duration_seconds": 6.13,
      "text": "of course, please stay it's helpful to have you here what brings you in today?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 24.01,
      "end_seconds": 30.14,
      "duration_seconds": 6.13,
      "text": "Yeah, it's breathlessness on slopes. I don't know what's causing it."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 32.06,
      "end_seconds": 34.44,
      "duration_seconds": 2.38,
      "text": "Roughly when did it start?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 36.15,
      "end_seconds": 41.87,
      "duration_seconds": 5.72,
      "text": "I'd say two months. Actually, no, closer to about a month"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 42.79,
      "end_seconds": 46.43,
      "duration_seconds": 3.64,
      "text": "does anything bring it on or make it worse?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 47.28,
      "end_seconds": 50.21,
      "duration_seconds": 2.93,
      "text": "I notice it more with slopes."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 50.69,
      "end_seconds": 54.95,
      "duration_seconds": 4.26,
      "text": "Sure. Right, anything that tends to go along with it?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 55.58,
      "end_seconds": 71.26,
      "duration_seconds": 15.68,
      "text": "Occasional chest tightness goes along with it, most of the time. The Occasional chest tightness? That's been for nearly five years. Poor sleep was there, um, but it's gone away on its own."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 76.35,
      "end_seconds": 82.33,
      "duration_seconds": 5.98,
      "text": "have you had breathlessness on slopes before, or is this the first time?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 83.75,
      "end_seconds": 88.73,
      "duration_seconds": 4.98,
      "text": "a bit, last winter it settled by itself back then"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 90.59,
      "end_seconds": 92.8,
      "duration_seconds": 2.21,
      "text": "Did you notice any palpitations?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 93.71,
      "end_seconds": 96.62,
      "duration_seconds": 2.91,
      "text": "Not at all, no palpitations."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 98.02,
      "end_seconds": 103.94,
      "duration_seconds": 5.92,
      "text": "Have you had any pain at rest, coughing up blood, bruising or black stools?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 104.85,
      "end_seconds": 114.22,
      "duration_seconds": 9.37,
      "text": "I mean, no pain at rest, coughing up blood, bruising or black stools, none of it."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 115.47,
      "end_seconds": 118.8,
      "duration_seconds": 3.33,
      "text": "So, is your urine normal, no changes?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 120.48,
      "end_seconds": 123.75,
      "duration_seconds": 3.27,
      "text": "No, um, that's all fine."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 125.68,
      "end_seconds": 128.83,
      "duration_seconds": 3.15,
      "text": "Any muscle or joint problems besides this?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 129.7,
      "end_seconds": 131.82,
      "duration_seconds": 2.12,
      "text": "No, joints are fine."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 139.62,
      "end_seconds": 142.3,
      "duration_seconds": 2.68,
      "text": "Have you got any chronic problems?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 142.97,
      "end_seconds": 144.75,
      "duration_seconds": 1.78,
      "text": "Yes, heart disease."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 146.41,
      "end_seconds": 147.93,
      "duration_seconds": 1.52,
      "text": "Okay, keep going."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 149.36,
      "end_seconds": 150.89,
      "duration_seconds": 1.53,
      "text": "I have diabetes."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 152.16,
      "end_seconds": 154.15,
      "duration_seconds": 1.99,
      "text": "And And apart from that?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 154.94,
      "end_seconds": 160.09,
      "duration_seconds": 5.15,
      "text": "Are there any allergies on your record that I should check?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 161.62,
      "end_seconds": 164.26,
      "duration_seconds": 2.64,
      "text": "no, nothing I'm aware of"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 179.58,
      "end_seconds": 183.11,
      "duration_seconds": 3.53,
      "text": "Tell me what you take day to day."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 183.87,
      "end_seconds": 189.82,
      "duration_seconds": 5.95,
      "text": "I take aspirin, 75 milligrams, maybe, once a day for my heart."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 191.73,
      "end_seconds": 196.26,
      "duration_seconds": 4.53,
      "text": "did you happen to bring the the box or the paperwork?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 197.63,
      "end_seconds": 202.13,
      "duration_seconds": 4.5,
      "text": "Not with me. I'll bring it it next time."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 202.91,
      "end_seconds": 206.34,
      "duration_seconds": 3.43,
      "text": "a few questions about your lifestyle now"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 208.28,
      "end_seconds": 223.57,
      "duration_seconds": 15.29,
      "text": "I don't drink at all. I teach at a primary school. I go to the gym a couple of times a week. I skip breakfast most days."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 224.75,
      "end_seconds": 228.44,
      "duration_seconds": 3.69,
      "text": "Have you had to have anything operated on?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 230.44,
      "end_seconds": 239.39,
      "duration_seconds": 8.95,
      "text": "I had a knee arthroscopy three years ago. I told myself I'd wait and see, and here I am."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 240.76,
      "end_seconds": 244.94,
      "duration_seconds": 4.18,
      "text": "Let's get your blood pressure and the other basics."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 252.16,
      "end_seconds": 252.98,
      "duration_seconds": 0.82,
      "text": "One second..."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 264.73,
      "end_seconds": 273.49,
      "duration_seconds": 8.76,
      "text": "okay: respiratory rate 16, height 154 centimetres. And pressure 109 over 81, temperature 36.6, pulse 69, weight 84 kilos"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 274.35,
      "end_seconds": 276.48,
      "duration_seconds": 2.13,
      "text": "is that alright, doctor?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 277.71,
      "end_seconds": 280.51,
      "duration_seconds": 2.8,
      "text": "that's fine, we'll come to it"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 283.1,
      "end_seconds": 285.79,
      "duration_seconds": 2.69,
      "text": "Shall we do the the examination?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 287.07,
      "end_seconds": 289.32,
      "duration_seconds": 2.25,
      "text": "Almost done with this part."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 306.12,
      "end_seconds": 309.87,
      "duration_seconds": 3.75,
      "text": "The scar on your chest has healed well."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 310.7,
      "end_seconds": 313.75,
      "duration_seconds": 3.05,
      "text": "Stay still while I have a look."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 328.35,
      "end_seconds": 331.5,
      "duration_seconds": 3.15,
      "text": "Chest is clear and heart sounds are normal."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 342.49,
      "end_seconds": 343.69,
      "duration_seconds": 1.2,
      "text": "Mm, okay."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 347.04,
      "end_seconds": 381.41,
      "duration_seconds": 34.37,
      "text": "thanks, please take a seat again okay, thinking it through, it points towards stable recovery after the heart event we should do a lipid profile for cardiovascular risk i'm sending you for an ECG because of follow-up the result will help us decide whether anything more is needed for this, atorvastatin, 40 milligrams, at night, long term it's for cardiovascular risk please don't stop the blood thinner on your own, even if you feel fine"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 382.52,
      "end_seconds": 390.23,
      "duration_seconds": 7.71,
      "text": "Cardiac rehab is worth doing, it really helps your confidence. I'm going to send a referral to cardiac rehabilitation."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 391.38,
      "end_seconds": 393.99,
      "duration_seconds": 2.61,
      "text": "Sure, where do I go?"
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 396.0,
      "end_seconds": 404.13,
      "duration_seconds": 8.13,
      "text": "And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 405.27,
      "end_seconds": 407.81,
      "duration_seconds": 2.54,
      "text": "Yes, I'll watch for that."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 408.35,
      "end_seconds": 427.07,
      "duration_seconds": 18.72,
      "text": "let's hold off on an echocardiogram for now, and if there's no change in a month we can revisit it the thing that would worry me is if the symptoms get worse if that happens, go to emergency"
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 431.22,
      "end_seconds": 431.92,
      "duration_seconds": 0.7,
      "text": "Understood."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 433.17,
      "end_seconds": 435.99,
      "duration_seconds": 2.82,
      "text": "Let's review you in three months."
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 436.83,
      "end_seconds": 441.54,
      "duration_seconds": 4.71,
      "text": "hmm, I'll make the appointment on my way out"
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 442.52,
      "end_seconds": 444.87,
      "duration_seconds": 2.35,
      "text": "Alright, I'll see you out."
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 446.64,
      "end_seconds": 448.79,
      "duration_seconds": 2.15,
      "text": "no questions. Thank you"
    }
  ]
