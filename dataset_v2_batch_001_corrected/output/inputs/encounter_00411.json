{
  "schema_version": "1.0",
  "encounter_id": "00411",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.07,
      "end_seconds": 5.33,
      "duration_seconds": 4.26,
      "text": "Hmm, hello doctor, sorry, am I early?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.75,
      "end_seconds": 10.37,
      "duration_seconds": 3.62,
      "text": "Not at all, please sit. What's the problem?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 11.99,
      "end_seconds": 21.88,
      "duration_seconds": 9.89,
      "text": "I'm here because of a thump in the chest at night. It's a relief to finally sit down and talk about it."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 23.89,
      "end_seconds": 26.33,
      "duration_seconds": 2.44,
      "text": "I'll take a few measurements first."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 34.68,
      "end_seconds": 36.97,
      "duration_seconds": 2.29,
      "text": "Okay, give me a moment..."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 58.38,
      "end_seconds": 66.95,
      "duration_seconds": 8.57,
      "text": "Okay: temp 36.9 degrees, respiratory rate 16. And SpO2 98 percent on room air, pulse 68, pressure 108 over 78."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 68.23,
      "end_seconds": 69.78,
      "duration_seconds": 1.55,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 71.41,
      "end_seconds": 74.0,
      "duration_seconds": 2.59,
      "text": "That's fine, we'll come to it."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 88.91,
      "end_seconds": 94.04,
      "duration_seconds": 5.13,
      "text": "How far back does it go? Just so I get the full picture."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 94.91,
      "end_seconds": 97.3,
      "duration_seconds": 2.39,
      "text": "For five days, I'd say."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 98.21,
      "end_seconds": 100.31,
      "duration_seconds": 2.1,
      "text": "How often does it happen?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 101.84,
      "end_seconds": 109.57,
      "duration_seconds": 7.73,
      "text": "It happens on and off. I've also been feeling anxious about it, for three weeks."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 110.27,
      "end_seconds": 114.01,
      "duration_seconds": 3.74,
      "text": "Did you get energy drinks or leg swelling?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 115.95,
      "end_seconds": 119.25,
      "duration_seconds": 3.3,
      "text": "No, no energy drinks or leg swelling."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 120.13,
      "end_seconds": 124.23,
      "duration_seconds": 4.1,
      "text": "Did you get fainting or family history of sudden death?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 125.85,
      "end_seconds": 131.18,
      "duration_seconds": 5.33,
      "text": "I haven't had fainting or family history of sudden death, no."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 132.95,
      "end_seconds": 135.61,
      "duration_seconds": 2.66,
      "text": "Anything different when you pass water?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 136.45,
      "end_seconds": 139.59,
      "duration_seconds": 3.14,
      "text": "No, um, that's all fine."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 140.87,
      "end_seconds": 142.82,
      "duration_seconds": 1.95,
      "text": "Any operations in the past?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 144.18,
      "end_seconds": 151.74,
      "duration_seconds": 7.56,
      "text": "I had a hernia repair about five years back. I've never really been one for hospitals."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 161.69,
      "end_seconds": 166.06,
      "duration_seconds": 4.37,
      "text": "Do you have any medical conditions I should know about?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 167.18,
      "end_seconds": 170.21,
      "duration_seconds": 3.03,
      "text": "No, none that I know of."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 172.29,
      "end_seconds": 173.51,
      "duration_seconds": 1.22,
      "text": "Any regular medication?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 174.84,
      "end_seconds": 177.7,
      "duration_seconds": 2.86,
      "text": "No, I don't take anything regularly."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 188.16,
      "end_seconds": 191.87,
      "duration_seconds": 3.71,
      "text": "Right, do you have any known allergies at all?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 193.1,
      "end_seconds": 194.13,
      "duration_seconds": 1.03,
      "text": "No allergies."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 195.84,
      "end_seconds": 199.97,
      "duration_seconds": 4.13,
      "text": "Let's talk a little about your daily life and habits."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 202.05,
      "end_seconds": 216.02,
      "duration_seconds": 13.97,
      "text": "I cycle to work most mornings. I live with my family, my husband and two kids. I work in an office, mostly sitting at a desk."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 218.57,
      "end_seconds": 221.53,
      "duration_seconds": 2.96,
      "text": "I'd like to examine you now."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 223.2,
      "end_seconds": 225.72,
      "duration_seconds": 2.52,
      "text": "Let me look at this properly."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 235.81,
      "end_seconds": 239.25,
      "duration_seconds": 3.44,
      "text": "Heart sounds are normal with no murmur."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 242.22,
      "end_seconds": 245.28,
      "duration_seconds": 3.06,
      "text": "Right, you can sit back down."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 260.5,
      "end_seconds": 270.19,
      "duration_seconds": 9.69,
      "text": "So, based on the history and the examination, the most likely explanation is benign extra heartbeats, though we should confirm."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 271.42,
      "end_seconds": 274.78,
      "duration_seconds": 3.36,
      "text": "Uh, do you think it's serious?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 276.28,
      "end_seconds": 292.32,
      "duration_seconds": 16.04,
      "text": "I understand the worry. At the moment I'd say it's benign extra heartbeats, though we should confirm, and we'll know more once the a thyroid test is back. Let's get a thyroid test, for palpitations."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 293.29,
      "end_seconds": 295.58,
      "duration_seconds": 2.29,
      "text": "Does it need any preparation?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 296.68,
      "end_seconds": 304.39,
      "duration_seconds": 7.71,
      "text": "Try cutting out caffeine for two weeks and see if the beats settle. Look after yourself."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 305.8,
      "end_seconds": 308.28,
      "duration_seconds": 2.48,
      "text": "Alright, thanks. Bye for now."
    }
  ]
}