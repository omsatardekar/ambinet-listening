{
  "schema_version": "1.0",
  "encounter_id": "00193",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 0.64,
      "end_seconds": 8.51,
      "duration_seconds": 7.87,
      "text": "Doctor, I've checked them in and done the preliminary measurements, I'll hand them over when you ask."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 10.57,
      "end_seconds": 16.09,
      "duration_seconds": 5.52,
      "text": "Thanks. Hello, come in, sit down. What brings you in today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 17.56,
      "end_seconds": 19.65,
      "duration_seconds": 2.09,
      "text": "It's sneezing fits, mostly."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 21.27,
      "end_seconds": 23.54,
      "duration_seconds": 2.27,
      "text": "And when did that start?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 24.39,
      "end_seconds": 27.14,
      "duration_seconds": 2.75,
      "text": "I've had it since last night."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 31.61,
      "end_seconds": 33.51,
      "duration_seconds": 1.9,
      "text": "Does anything settle it?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 34.45,
      "end_seconds": 37.81,
      "duration_seconds": 3.36,
      "text": "I get some relief from antihistamines."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 39.1,
      "end_seconds": 42.0,
      "duration_seconds": 2.9,
      "text": "Is it mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 43.63,
      "end_seconds": 46.24,
      "duration_seconds": 2.61,
      "text": "It feels moderate to me."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 48.3,
      "end_seconds": 51.58,
      "duration_seconds": 3.28,
      "text": "What's the pattern, is it there all day?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 52.43,
      "end_seconds": 54.91,
      "duration_seconds": 2.48,
      "text": "It happens every other day."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 61.06,
      "end_seconds": 63.47,
      "duration_seconds": 2.41,
      "text": "Any a dry cough as well?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 65.49,
      "end_seconds": 66.98,
      "duration_seconds": 1.49,
      "text": "Yeah, that too."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 69.02,
      "end_seconds": 72.75,
      "duration_seconds": 3.73,
      "text": "How would you describe it, mild, moderate, severe?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 74.81,
      "end_seconds": 76.44,
      "duration_seconds": 1.63,
      "text": "It's severe, honestly."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 77.59,
      "end_seconds": 89.03,
      "duration_seconds": 11.44,
      "text": "Doctor, I've got the readings for you. Temperature is 36.9 degrees, BP is 123 over 74, pulse 83, oxygen saturation is 97 percent, respiratory rate 15."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 90.78,
      "end_seconds": 92.07,
      "duration_seconds": 1.29,
      "text": "Good, thank you."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 94.69,
      "end_seconds": 97.08,
      "duration_seconds": 2.39,
      "text": "Let's do the physical part now."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 98.64,
      "end_seconds": 100.76,
      "duration_seconds": 2.12,
      "text": "Mm, um, okay."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 102.03,
      "end_seconds": 104.36,
      "duration_seconds": 2.33,
      "text": "Tell me if anything hurts."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 120.78,
      "end_seconds": 123.25,
      "duration_seconds": 2.47,
      "text": "Chest is clear, no wheeze."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 127.32,
      "end_seconds": 129.59,
      "duration_seconds": 2.27,
      "text": "Okay, you can sit up."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 143.09,
      "end_seconds": 145.1,
      "duration_seconds": 2.01,
      "text": "Nothing like shortness of breath?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 145.91,
      "end_seconds": 149.26,
      "duration_seconds": 3.35,
      "text": "Not at all, no shortness of breath."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 151.13,
      "end_seconds": 153.3,
      "duration_seconds": 2.17,
      "text": "Any rash or facial pain?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 154.16,
      "end_seconds": 158.39,
      "duration_seconds": 4.23,
      "text": "No rash or facial pain, none of it."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 160.4,
      "end_seconds": 163.59,
      "duration_seconds": 3.19,
      "text": "Anything on the skin I should know about?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 165.65,
      "end_seconds": 166.56,
      "duration_seconds": 0.91,
      "text": "Skin's normal."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 179.2,
      "end_seconds": 184.03,
      "duration_seconds": 4.83,
      "text": "What about your general health, any conditions you're being treated for?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 185.28,
      "end_seconds": 190.0,
      "duration_seconds": 4.72,
      "text": "I, I have asthma, for about ten years."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 208.26,
      "end_seconds": 211.84,
      "duration_seconds": 3.58,
      "text": "What medicines are you taking at the moment?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 212.51,
      "end_seconds": 216.82,
      "duration_seconds": 4.31,
      "text": "Seretide inhaler, twice a day for my asthma."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 218.25,
      "end_seconds": 222.53,
      "duration_seconds": 4.28,
      "text": "Right, do your parents or siblings have any long-term illnesses?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 224.18,
      "end_seconds": 226.4,
      "duration_seconds": 2.22,
      "text": "My mother has diabetes."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 241.13,
      "end_seconds": 242.94,
      "duration_seconds": 1.81,
      "text": "Do you drink alcohol?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 243.58,
      "end_seconds": 247.66,
      "duration_seconds": 4.08,
      "text": "I have a couple of drinks on the weekend."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 248.73,
      "end_seconds": 250.82,
      "duration_seconds": 2.09,
      "text": "Right, do you work?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 252.31,
      "end_seconds": 259.16,
      "duration_seconds": 6.85,
      "text": "I run a small shop, so I'm on my feet a lot."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 261.22,
      "end_seconds": 263.64,
      "duration_seconds": 2.42,
      "text": "Do you exercise at all?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 265.36,
      "end_seconds": 271.39,
      "duration_seconds": 6.03,
      "text": "I go to the gym a couple of times a week."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 273.12,
      "end_seconds": 275.49,
      "duration_seconds": 2.37,
      "text": "Who's at home with you?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 276.99,
      "end_seconds": 281.94,
      "duration_seconds": 4.95,
      "text": "It's just me and my wife at home now."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 283.71,
      "end_seconds": 288.4,
      "duration_seconds": 4.69,
      "text": "What about allergies, to medicines or foods or anything else?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 289.2,
      "end_seconds": 297.14,
      "duration_seconds": 7.94,
      "text": "I, I was told I'm allergic to penicillin, but I don't remember what reaction I had."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 298.45,
      "end_seconds": 308.93,
      "duration_seconds": 10.48,
      "text": "From what you've told me and what I found, I don't have a clear answer today: allergic rhinitis is possible, and so is a viral cold."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 310.91,
      "end_seconds": 313.52,
      "duration_seconds": 2.61,
      "text": "Is it something serious, doctor?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 315.47,
      "end_seconds": 331.4,
      "duration_seconds": 15.93,
      "text": "I understand the worry. At the moment I'd say it's allergic rhinitis, and we'll watch how it goes. Keep the windows closed in the early morning and wash the bedsheets weekly in hot water. Any last questions?"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 332.98,
      "end_seconds": 334.9,
      "duration_seconds": 1.92,
      "text": "Thanks so much, doctor."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 336.27,
      "end_seconds": 337.99,
      "duration_seconds": 1.72,
      "text": "Mind how you go."
    }
  ]
}