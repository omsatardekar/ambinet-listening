{
  "schema_version": "1.0",
  "encounter_id": "00395",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.15,
      "end_seconds": 4.7,
      "duration_seconds": 3.55,
      "text": "Hello doctor, sorry, am I early?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.55,
      "end_seconds": 10.83,
      "duration_seconds": 4.28,
      "text": "Right on time. Sit, please. How can I help?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 12.59,
      "end_seconds": 25.29,
      "duration_seconds": 12.7,
      "text": "Um, so... tiredness all the time. That's why I came. I looked a few things up online, and that probably didn't help."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 26.41,
      "end_seconds": 30.21,
      "duration_seconds": 3.8,
      "text": "Which tablets or creams or inhalers do you use?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 35.42,
      "end_seconds": 44.8,
      "duration_seconds": 9.38,
      "text": "Metformin. I take it 500 milligrams, twice a day. Well, I do miss it now and then, to be fair."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 57.3,
      "end_seconds": 60.25,
      "duration_seconds": 2.95,
      "text": "How long have you had it?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 60.85,
      "end_seconds": 64.06,
      "duration_seconds": 3.21,
      "text": "For about two weeks, I'd say."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 66.12,
      "end_seconds": 70.18,
      "duration_seconds": 4.06,
      "text": "Right, anything that tends to go along with it?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 73.63,
      "end_seconds": 79.0,
      "duration_seconds": 5.37,
      "text": "Hair falling out goes along with it, most of the time."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 79.37,
      "end_seconds": 80.2,
      "duration_seconds": 0.83,
      "text": "And then?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 81.34,
      "end_seconds": 85.51,
      "duration_seconds": 4.17,
      "text": "Have you noticed fever or blood in the stool?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 86.35,
      "end_seconds": 90.12,
      "duration_seconds": 3.77,
      "text": "Yeah, um, no, none of those."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 91.71,
      "end_seconds": 96.15,
      "duration_seconds": 4.44,
      "text": "Have you noticed low mood, chest pain or night sweats?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 98.08,
      "end_seconds": 100.99,
      "duration_seconds": 2.91,
      "text": "None, as far as I know."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 101.84,
      "end_seconds": 105.7,
      "duration_seconds": 3.86,
      "text": "How about your heart, any problems like that?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 107.23,
      "end_seconds": 112.06,
      "duration_seconds": 4.83,
      "text": "My heart's been fine, as far as I know."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 114.08,
      "end_seconds": 117.09,
      "duration_seconds": 3.01,
      "text": "Any problems with your joints or muscles?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 118.69,
      "end_seconds": 120.71,
      "duration_seconds": 2.02,
      "text": "No, joints are fine."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 121.95,
      "end_seconds": 124.84,
      "duration_seconds": 2.89,
      "text": "Any diagnoses you've been given before?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 126.43,
      "end_seconds": 129.76,
      "duration_seconds": 3.33,
      "text": "I have diabetes, for nearly five years."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 130.58,
      "end_seconds": 132.37,
      "duration_seconds": 1.79,
      "text": "Do you drink alcohol?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 134.07,
      "end_seconds": 136.53,
      "duration_seconds": 2.46,
      "text": "I don't drink at all."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 137.35,
      "end_seconds": 138.71,
      "duration_seconds": 1.36,
      "text": "Do you smoke?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 139.99,
      "end_seconds": 143.99,
      "duration_seconds": 4.0,
      "text": "No, I don't smoke and never have."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 145.17,
      "end_seconds": 147.13,
      "duration_seconds": 1.96,
      "text": "What's your diet like?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 148.74,
      "end_seconds": 153.07,
      "duration_seconds": 4.33,
      "text": "I eat out quite a lot, to be honest."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 153.97,
      "end_seconds": 156.76,
      "duration_seconds": 2.79,
      "text": "Are you working at the moment?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 158.6,
      "end_seconds": 163.13,
      "duration_seconds": 4.53,
      "text": "Yes, I'm a nurse on a busy ward."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 163.94,
      "end_seconds": 165.9,
      "duration_seconds": 1.96,
      "text": "Are you living with family?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 167.62,
      "end_seconds": 171.49,
      "duration_seconds": 3.87,
      "text": "I stay with my daughter and her family."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 173.51,
      "end_seconds": 174.88,
      "duration_seconds": 1.37,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 175.54,
      "end_seconds": 181.26,
      "duration_seconds": 5.72,
      "text": "Oh, yes, I had my tonsils out, when I was a child."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 189.13,
      "end_seconds": 193.56,
      "duration_seconds": 4.43,
      "text": "What about family history, any illnesses that run in the family?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 197.84,
      "end_seconds": 200.61,
      "duration_seconds": 2.77,
      "text": "So, my mother has diabetes."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 203.4,
      "end_seconds": 206.52,
      "duration_seconds": 3.12,
      "text": "Come over here and I'll have a look."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 208.04,
      "end_seconds": 209.99,
      "duration_seconds": 1.95,
      "text": "Let me just check something."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 226.01,
      "end_seconds": 231.56,
      "duration_seconds": 5.55,
      "text": "Your thyroid isn't enlarged, I can't feel any lumps in your neck."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 235.5,
      "end_seconds": 238.15,
      "duration_seconds": 2.65,
      "text": "Right, you can sit back down."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 249.95,
      "end_seconds": 258.75,
      "duration_seconds": 8.8,
      "text": "From what you've told me and what I found, I'd lean towards persistent tiredness, possibly from low iron."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 263.84,
      "end_seconds": 265.99,
      "duration_seconds": 2.15,
      "text": "Doctor, is this dangerous?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 267.88,
      "end_seconds": 276.29,
      "duration_seconds": 8.41,
      "text": "Nothing I've seen today points to an emergency. It looks like persistent tiredness, possibly from low iron."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 277.59,
      "end_seconds": 281.07,
      "duration_seconds": 3.48,
      "text": "Should I have blood tests as well?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 282.2,
      "end_seconds": 296.41,
      "duration_seconds": 14.21,
      "text": "Not at this point, no. It isn't indicated yet. I don't need to add any tests or treatment at this point. Good. Let us know how you get on."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 298.39,
      "end_seconds": 302.87,
      "duration_seconds": 4.48,
      "text": "I think that's clear. Thank you for being so thorough."
    }
  ]
}