{
  "schema_version": "1.0",
  "encounter_id": "00164",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.89,
      "end_seconds": 2.12,
      "duration_seconds": 1.23,
      "text": "Afternoon, doctor."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 3.99,
      "end_seconds": 7.69,
      "duration_seconds": 3.7,
      "text": "Yes, do sit. Tell me what's been happening."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 8.59,
      "end_seconds": 12.71,
      "duration_seconds": 4.12,
      "text": "Good morning, doctor. I came along to help out."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 14.47,
      "end_seconds": 17.1,
      "duration_seconds": 2.63,
      "text": "Absolutely, come and sit beside them."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 18.8,
      "end_seconds": 22.46,
      "duration_seconds": 3.66,
      "text": "We came because of a tight band-like headache."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 27.4,
      "end_seconds": 30.67,
      "duration_seconds": 3.27,
      "text": "Okay, how long has this been going on?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 31.59,
      "end_seconds": 38.01,
      "duration_seconds": 6.42,
      "text": "I'd say about three months. Actually, no, closer to six months."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 39.67,
      "end_seconds": 43.01,
      "duration_seconds": 3.34,
      "text": "Right, would you call it mild or bad?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 43.73,
      "end_seconds": 44.71,
      "duration_seconds": 0.98,
      "text": "Mostly mild."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 46.41,
      "end_seconds": 50.14,
      "duration_seconds": 3.73,
      "text": "Does anything bring it on or make it worse?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 51.69,
      "end_seconds": 53.86,
      "duration_seconds": 2.17,
      "text": "It's worse with stress."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 55.72,
      "end_seconds": 57.47,
      "duration_seconds": 1.75,
      "text": "Does anything settle it?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 58.71,
      "end_seconds": 64.2,
      "duration_seconds": 5.49,
      "text": "I, I get some relief from a head massage and rest."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 65.35,
      "end_seconds": 69.02,
      "duration_seconds": 3.67,
      "text": "Right, anything that tends to go along with it?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 75.59,
      "end_seconds": 90.44,
      "duration_seconds": 14.85,
      "text": "Tired eyes goes along with it, most of the time. The tired eyes? That's been for two years. And there's trouble sleeping as well, you know, two months now."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 90.7,
      "end_seconds": 93.47,
      "duration_seconds": 2.77,
      "text": "Right. Alright, any numbness or fever?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 95.48,
      "end_seconds": 98.26,
      "duration_seconds": 2.78,
      "text": "Well, nothing like that, no."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 99.48,
      "end_seconds": 101.46,
      "duration_seconds": 1.98,
      "text": "Okay, nothing like vomiting?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 102.92,
      "end_seconds": 106.69,
      "duration_seconds": 3.77,
      "text": "Not at all, uh, no vomiting."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 107.66,
      "end_seconds": 112.53,
      "duration_seconds": 4.87,
      "text": "Actually, doctor, I did notice vomiting. He doesn't always say."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 114.14,
      "end_seconds": 120.93,
      "duration_seconds": 6.79,
      "text": "No, I don't think I did. Maybe a little, I'm not sure."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 122.25,
      "end_seconds": 131.54,
      "duration_seconds": 9.29,
      "text": "Alright, I'll note both what you've said and what you've noticed. Any jaw pain when chewing, blurred vision or weakness?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 132.69,
      "end_seconds": 134.79,
      "duration_seconds": 2.1,
      "text": "Nothing like that, no."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 135.95,
      "end_seconds": 138.58,
      "duration_seconds": 2.63,
      "text": "How are your bowels, any trouble?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 139.93,
      "end_seconds": 142.36,
      "duration_seconds": 2.43,
      "text": "No, that side's been fine."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 146.02,
      "end_seconds": 149.53,
      "duration_seconds": 3.51,
      "text": "Is there a family history of anything significant?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 150.23,
      "end_seconds": 152.22,
      "duration_seconds": 1.99,
      "text": "My sister has epilepsy."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 154.21,
      "end_seconds": 157.11,
      "duration_seconds": 2.9,
      "text": "Have you had any surgery before?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 158.82,
      "end_seconds": 163.34,
      "duration_seconds": 4.52,
      "text": "I had a lump removed from my back years ago."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 164.17,
      "end_seconds": 166.61,
      "duration_seconds": 2.44,
      "text": "Any diagnoses you've been given before?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 167.89,
      "end_seconds": 175.8,
      "duration_seconds": 7.91,
      "text": "I have anxiety, for about ten years. My sister suggested writing things down, but I forgot."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 176.79,
      "end_seconds": 177.57,
      "duration_seconds": 0.78,
      "text": "Any others?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 179.36,
      "end_seconds": 183.64,
      "duration_seconds": 4.28,
      "text": "I've had high blood pressure for two years now."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 184.84,
      "end_seconds": 189.13,
      "duration_seconds": 4.29,
      "text": "Right, right. A few questions about your lifestyle now."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 194.53,
      "end_seconds": 206.53,
      "duration_seconds": 12.0,
      "text": "I don't drink at all. I walk for about half an hour most days. It's just me and my wife at home now."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 216.68,
      "end_seconds": 220.49,
      "duration_seconds": 3.81,
      "text": "Let's go through your medication. What are you taking?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 222.14,
      "end_seconds": 228.57,
      "duration_seconds": 6.43,
      "text": "Well, uh, I take escitalopram, 10 milligrams, once a day."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 229.56,
      "end_seconds": 239.16,
      "duration_seconds": 9.6,
      "text": "Doctor, I think the last prescription for the escitalopram was 5 milligrams. We changed it at the last visit."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 241.19,
      "end_seconds": 244.5,
      "duration_seconds": 3.31,
      "text": "Alright. Did you bring the up-to-date prescription?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 245.79,
      "end_seconds": 261.15,
      "duration_seconds": 15.36,
      "text": "So, you know, not with me. I'll bring it next time. I'm on amlodipine, 5 milligrams, once a day for my pressure. I'm, I'm on paracetamol, 500 milligrams, when needed."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 262.55,
      "end_seconds": 264.19,
      "duration_seconds": 1.64,
      "text": "And for how long?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 266.1,
      "end_seconds": 267.97,
      "duration_seconds": 1.87,
      "text": "About about three months."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 279.5,
      "end_seconds": 283.31,
      "duration_seconds": 3.81,
      "text": "Okay, do you have any known allergies at all?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 284.96,
      "end_seconds": 293.23,
      "duration_seconds": 8.27,
      "text": "Right, years back I got vomiting from codeine, so I stay away from it now."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 294.33,
      "end_seconds": 296.84,
      "duration_seconds": 2.51,
      "text": "A few measurements, then we'll continue."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 304.69,
      "end_seconds": 306.45,
      "duration_seconds": 1.76,
      "text": "Hold still for me..."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 318.75,
      "end_seconds": 326.63,
      "duration_seconds": 7.88,
      "text": "Okay: pressure 113 over 73, oxygen saturation is 99 percent, pulse is 73 beats a minute."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 327.72,
      "end_seconds": 329.8,
      "duration_seconds": 2.08,
      "text": "Is that alright, doctor?"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 332.87,
      "end_seconds": 335.98,
      "duration_seconds": 3.11,
      "text": "I'll interpret it once I've examined you."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 337.72,
      "end_seconds": 340.87,
      "duration_seconds": 3.15,
      "text": "If you're comfortable, I'll examine you now."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 341.84,
      "end_seconds": 344.31,
      "duration_seconds": 2.47,
      "text": "Let me just check something."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 352.42,
      "end_seconds": 355.37,
      "duration_seconds": 2.95,
      "text": "Your eye movements and reflexes are normal."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 357.03,
      "end_seconds": 359.16,
      "duration_seconds": 2.13,
      "text": "Almost done with this part."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 373.96,
      "end_seconds": 379.65,
      "duration_seconds": 5.69,
      "text": "The muscles at the back of your neck are tight and tender."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 382.71,
      "end_seconds": 383.91,
      "duration_seconds": 1.2,
      "text": "Thanks for that."
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 399.65,
      "end_seconds": 408.56,
      "duration_seconds": 8.91,
      "text": "So where does that leave us? I'd lean towards a tension-type headache. It could also be migraine, so we'll keep that open."
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 409.08,
      "end_seconds": 412.46,
      "duration_seconds": 3.38,
      "text": "What are the chances it's something bad?"
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 418.63,
      "end_seconds": 431.78,
      "duration_seconds": 13.15,
      "text": "I can't promise yet, but most people with a tension-type headache do well once it's treated properly. Let's get an eye check, for headache and eye strain."
    },
    {
      "segment_id": "SEG0059",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 433.53,
      "end_seconds": 434.87,
      "duration_seconds": 1.34,
      "text": "That sounds sensible."
    },
    {
      "segment_id": "SEG0060",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 436.01,
      "end_seconds": 457.15,
      "duration_seconds": 21.14,
      "text": "I'm prescribing amitriptyline, 10 milligrams, at night, for six weeks. You take it by mouth. That should help with headache prevention. Painkillers on most days can actually make the headaches stick around. Physiotherapy would be the right next step, I'll refer you."
    },
    {
      "segment_id": "SEG0061",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 458.45,
      "end_seconds": 459.98,
      "duration_seconds": 1.53,
      "text": "Alright, thank you."
    },
    {
      "segment_id": "SEG0062",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 460.79,
      "end_seconds": 473.75,
      "duration_seconds": 12.96,
      "text": "And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose. Book a review in four weeks."
    },
    {
      "segment_id": "SEG0063",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 476.84,
      "end_seconds": 480.93,
      "duration_seconds": 4.09,
      "text": "I'll make the appointment on my way out."
    },
    {
      "segment_id": "SEG0064",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 481.58,
      "end_seconds": 488.67,
      "duration_seconds": 7.09,
      "text": "Tell me what you've taken from all that, so I can fill in any gaps."
    },
    {
      "segment_id": "SEG0065",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 489.72,
      "end_seconds": 499.7,
      "duration_seconds": 9.98,
      "text": "So, I take the amitriptyline, 10 milligrams, at night and come back in four weeks. Is that right?"
    },
    {
      "segment_id": "SEG0066",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 501.05,
      "end_seconds": 505.89,
      "duration_seconds": 4.84,
      "text": "Yes, exactly right. That's everything from me. Any other questions?"
    },
    {
      "segment_id": "SEG0067",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 507.77,
      "end_seconds": 514.68,
      "duration_seconds": 6.91,
      "text": "Um, uh, I think that's clear. Thank you for being so thorough."
    }
  ]
}