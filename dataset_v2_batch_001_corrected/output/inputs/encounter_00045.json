{
  "schema_version": "1.0",
  "encounter_id": "00045",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.11,
      "end_seconds": 9.08,
      "duration_seconds": 7.97,
      "text": "Okay, so doctor, hello, I've got my papers here, where should I put them?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 9.93,
      "end_seconds": 16.53,
      "duration_seconds": 6.6,
      "text": "Yes, come in, take a seat. What can I do for you today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 17.84,
      "end_seconds": 20.74,
      "duration_seconds": 2.9,
      "text": "Doctor, thank you for seeing us."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 22.56,
      "end_seconds": 27.09,
      "duration_seconds": 4.53,
      "text": "Of course, please stay. It's helpful to have you here."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 27.67,
      "end_seconds": 34.57,
      "duration_seconds": 6.9,
      "text": "Okay, um, so I've been dealing with bloating after milk or ice cream."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 36.37,
      "end_seconds": 40.4,
      "duration_seconds": 4.03,
      "text": "Is this recent, or has it been a while?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 43.77,
      "end_seconds": 46.04,
      "duration_seconds": 2.27,
      "text": "About... well, five days."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 47.83,
      "end_seconds": 57.76,
      "duration_seconds": 9.93,
      "text": "Tell me a bit more about it: how bad it gets, how often, and whether anything makes it better or worse."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 59.48,
      "end_seconds": 68.29,
      "duration_seconds": 8.81,
      "text": "I mean, a five out of ten, I suppose. Milk definitely sets it off."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 69.31,
      "end_seconds": 72.27,
      "duration_seconds": 2.96,
      "text": "Has there been rumbling and gas too?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 73.35,
      "end_seconds": 80.42,
      "duration_seconds": 7.07,
      "text": "Mm, yes. Oh, uh, and an occasional queasy feeling. Had that since Monday."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 81.35,
      "end_seconds": 84.23,
      "duration_seconds": 2.88,
      "text": "What about cramps, have you noticed that?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 85.82,
      "end_seconds": 94.7,
      "duration_seconds": 8.88,
      "text": "Yes, um, actually. Okay, um, so as for cramps, pretty severe, if I'm being honest."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 95.8,
      "end_seconds": 98.39,
      "duration_seconds": 2.59,
      "text": "Before I prescribe anything, any allergies?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 99.93,
      "end_seconds": 104.59,
      "duration_seconds": 4.66,
      "text": "None, um, as far as I'm aware."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 106.36,
      "end_seconds": 114.75,
      "duration_seconds": 8.39,
      "text": "Hold on, um, doctor, I think she reacted to codeine once. I'm not certain, though."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 115.57,
      "end_seconds": 117.94,
      "duration_seconds": 2.37,
      "text": "I don't remember that."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 119.04,
      "end_seconds": 126.48,
      "duration_seconds": 7.44,
      "text": "Okay, I'll note both of those. Tell me about your health in general, any ongoing conditions?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 127.32,
      "end_seconds": 135.26,
      "duration_seconds": 7.94,
      "text": "Uh, um, I have arthritis in my knees, for about a year."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 137.24,
      "end_seconds": 138.54,
      "duration_seconds": 1.3,
      "text": "Okay, anything else?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 140.5,
      "end_seconds": 142.16,
      "duration_seconds": 1.66,
      "text": "I've got gout."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 143.24,
      "end_seconds": 150.55,
      "duration_seconds": 7.31,
      "text": "Okay, I can see arthritis in your knees and gout in your file as well. How's your diet?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 151.85,
      "end_seconds": 153.51,
      "duration_seconds": 1.66,
      "text": "I'm mostly vegetarian."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 155.42,
      "end_seconds": 157.41,
      "duration_seconds": 1.99,
      "text": "Who's at home with you?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 158.26,
      "end_seconds": 163.17,
      "duration_seconds": 4.91,
      "text": "It's just me and my wife at home now."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 173.01,
      "end_seconds": 174.25,
      "duration_seconds": 1.24,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 174.99,
      "end_seconds": 181.3,
      "duration_seconds": 6.31,
      "text": "Um, you know, just a C-section, about ten years ago."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 192.42,
      "end_seconds": 194.53,
      "duration_seconds": 2.11,
      "text": "What's your current medication list?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 196.21,
      "end_seconds": 210.35,
      "duration_seconds": 14.14,
      "text": "It's diclofenac, 50 milligrams, when needed for the joint pain, doctor. She is on allopurinol, 100 milligrams, once a day for the gout, I give it to her."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 211.03,
      "end_seconds": 215.93,
      "duration_seconds": 4.9,
      "text": "Did you get weight loss or blood in the stool?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 216.81,
      "end_seconds": 224.25,
      "duration_seconds": 7.44,
      "text": "I mean, uh, no, no weight loss or blood in the stool."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 225.74,
      "end_seconds": 229.36,
      "duration_seconds": 3.62,
      "text": "A few quick ones: rash or night-time symptoms?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 231.28,
      "end_seconds": 234.56,
      "duration_seconds": 3.28,
      "text": "Okay, so nothing like that, no."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 235.7,
      "end_seconds": 237.27,
      "duration_seconds": 1.57,
      "text": "Right, any fever?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 242.66,
      "end_seconds": 244.42,
      "duration_seconds": 1.76,
      "text": "No fever, thankfully."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 245.89,
      "end_seconds": 251.7,
      "duration_seconds": 5.81,
      "text": "Actually, doctor, I did notice fever. She doesn't always say."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 252.96,
      "end_seconds": 261.1,
      "duration_seconds": 8.14,
      "text": "I mean, no, I don't think I did. Maybe a little, I'm not sure."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 262.61,
      "end_seconds": 269.96,
      "duration_seconds": 7.35,
      "text": "Alright, I'll note both what you've said and what you've noticed. Your breathing, any trouble there?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 271.57,
      "end_seconds": 272.63,
      "duration_seconds": 1.06,
      "text": "Breathing's normal."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 274.0,
      "end_seconds": 277.46,
      "duration_seconds": 3.46,
      "text": "Before we go on, a few quick readings."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 288.28,
      "end_seconds": 289.85,
      "duration_seconds": 1.57,
      "text": "Rest your hand here..."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 311.09,
      "end_seconds": 316.94,
      "duration_seconds": 5.85,
      "text": "Okay: oxygen saturation is 97 percent, BP is 120 over 77, pulse 81."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 317.96,
      "end_seconds": 319.54,
      "duration_seconds": 1.58,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 320.2,
      "end_seconds": 323.45,
      "duration_seconds": 3.25,
      "text": "I'll interpret it once I've examined you."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 325.9,
      "end_seconds": 328.76,
      "duration_seconds": 2.86,
      "text": "Let me have a look at you."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 329.95,
      "end_seconds": 333.18,
      "duration_seconds": 3.23,
      "text": "Stay still while I have a look."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 341.56,
      "end_seconds": 345.84,
      "duration_seconds": 4.28,
      "text": "Your tummy is soft and non-tender, with active bowel sounds."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 360.3,
      "end_seconds": 361.52,
      "duration_seconds": 1.22,
      "text": "Mm, okay."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 364.97,
      "end_seconds": 375.72,
      "duration_seconds": 10.75,
      "text": "Okay, you can sit up. So where does that leave us? This is probably lactose intolerance. It could also be coeliac disease, so we'll keep that open."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 377.06,
      "end_seconds": 380.8,
      "duration_seconds": 3.74,
      "text": "Is this something I'll have for good?"
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 381.8,
      "end_seconds": 397.34,
      "duration_seconds": 15.54,
      "text": "I can't promise yet, but most people with lactose intolerance do well once it's treated properly. Let's book a hydrogen breath test to look into suspected lactose intolerance. Good. Let us know how you get on."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 397.88,
      "end_seconds": 401.78,
      "duration_seconds": 3.9,
      "text": "Right, uh, I appreciate it, doctor."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 402.52,
      "end_seconds": 404.42,
      "duration_seconds": 1.9,
      "text": "Mind how you go."
    }
  ]
}