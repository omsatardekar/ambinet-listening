{
  "schema_version": "1.0",
  "encounter_id": "00356",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.3,
      "end_seconds": 4.95,
      "duration_seconds": 3.65,
      "text": "Hi, nice to see you. Sit down, please."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 5.68,
      "end_seconds": 6.89,
      "duration_seconds": 1.21,
      "text": "hi, doctor"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 7.84,
      "end_seconds": 10.7,
      "duration_seconds": 2.86,
      "text": "did you find the place alright?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 11.96,
      "end_seconds": 20.28,
      "duration_seconds": 8.32,
      "text": "Um, uh, yes, it was easy enough. The The parking was the hard part."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 22.26,
      "end_seconds": 25.14,
      "duration_seconds": 2.88,
      "text": "In your own words, what's happened?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 25.98,
      "end_seconds": 34.18,
      "duration_seconds": 8.2,
      "text": "well, you know, mainly I've been coughing up yellow phlegm. That's why I came"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 35.0,
      "end_seconds": 37.52,
      "duration_seconds": 2.52,
      "text": "how long have you had it?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 38.65,
      "end_seconds": 48.89,
      "duration_seconds": 10.24,
      "text": "ever since... since yesterday really. I wasn't sure whether to come in at all to be honest"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 50.6,
      "end_seconds": 55.72,
      "duration_seconds": 5.12,
      "text": "okay, give me more detail on it, whatever comes to mind"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 57.4,
      "end_seconds": 84.15,
      "duration_seconds": 26.75,
      "text": "maybe a four out of ten on a bad day it's once or twice a day sorry I know I'm rambling a bit hmm uh and there's a tight chest as well one week now yeah um with tight chest I'd say severe it sort of comes and goes"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 92.43,
      "end_seconds": 98.12,
      "duration_seconds": 5.69,
      "text": "Any night sweats, coughing up blood, shortness of breath or weight loss at all?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 99.02,
      "end_seconds": 109.36,
      "duration_seconds": 10.34,
      "text": "well, I haven't had night sweats, coughing up blood, shortness of breath or weight loss, no"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 110.01,
      "end_seconds": 112.49,
      "duration_seconds": 2.48,
      "text": "Did you notice any leg swelling?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 114.5,
      "end_seconds": 116.45,
      "duration_seconds": 1.95,
      "text": "no no leg swelling"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 117.91,
      "end_seconds": 120.25,
      "duration_seconds": 2.34,
      "text": "Is your mobility otherwise okay?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 121.05,
      "end_seconds": 122.63,
      "duration_seconds": 1.58,
      "text": "nothing else aches"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 123.64,
      "end_seconds": 127.7,
      "duration_seconds": 4.06,
      "text": "anything with your nerves, like weakness or numbness?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 129.75,
      "end_seconds": 132.72,
      "duration_seconds": 2.97,
      "text": "I mean no nothing like that"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 133.6,
      "end_seconds": 135.96,
      "duration_seconds": 2.36,
      "text": "have you got any chronic problems?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 137.57,
      "end_seconds": 146.49,
      "duration_seconds": 8.92,
      "text": "I've had high blood pressure for about ten years now. I have asthma, for about ten years"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 148.09,
      "end_seconds": 158.9,
      "duration_seconds": 10.81,
      "text": "okay, I can see high blood pressure in your file as well. Right, tell me about your routine, work, habits, that sort of thing"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 159.97,
      "end_seconds": 173.83,
      "duration_seconds": 13.86,
      "text": "I work in an office, mostly sitting at a desk. I live with my family, my husband and two kids. I cycle to work most mornings."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 184.77,
      "end_seconds": 190.35,
      "duration_seconds": 5.58,
      "text": "alright are there any allergies on your record that I should check?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 191.75,
      "end_seconds": 194.88,
      "duration_seconds": 3.13,
      "text": "none, as far as I'm aware"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 195.9,
      "end_seconds": 199.41,
      "duration_seconds": 3.51,
      "text": "have you had to to have anything operated on?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 204.4,
      "end_seconds": 209.57,
      "duration_seconds": 5.17,
      "text": "just a lump removed from my back, years ago"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 211.07,
      "end_seconds": 213.03,
      "duration_seconds": 1.96,
      "text": "What's your current medication list?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 214.02,
      "end_seconds": 221.96,
      "duration_seconds": 7.94,
      "text": "It's something called telm... telmisartan, 40 milligrams, maybe, once a day for my pressure."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 222.95,
      "end_seconds": 225.83,
      "duration_seconds": 2.88,
      "text": "is the packet here, or the prescription?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 227.52,
      "end_seconds": 235.03,
      "duration_seconds": 7.51,
      "text": "not with me i'll bring it next time. Asthalin inhaler i take it when needed"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 237.06,
      "end_seconds": 239.83,
      "duration_seconds": 2.77,
      "text": "I'll check your pressure and and pulse."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 250.63,
      "end_seconds": 252.6,
      "duration_seconds": 1.97,
      "text": "rest your hand here.."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 272.29,
      "end_seconds": 279.55,
      "duration_seconds": 7.26,
      "text": "okay: pulse 100, blood pressure 121 over 67. And And respiratory rate 19, oxygen saturation is 98 percent"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 281.34,
      "end_seconds": 283.57,
      "duration_seconds": 2.23,
      "text": "can I examine you now?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 285.24,
      "end_seconds": 289.06,
      "duration_seconds": 3.82,
      "text": "a little pressure here tell me if it's tender"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 304.6,
      "end_seconds": 306.67,
      "duration_seconds": 2.07,
      "text": "No crackles at the bases"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 309.5,
      "end_seconds": 311.87,
      "duration_seconds": 2.37,
      "text": "thanks please take a seat again"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 322.46,
      "end_seconds": 333.04,
      "duration_seconds": 10.58,
      "text": "So where does that leave us? I think we're dealing with a chest infection, probably viral at this stage. We shouldn't forget pneumonia."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 334.49,
      "end_seconds": 337.38,
      "duration_seconds": 2.89,
      "text": "do you think it's serious?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 337.94,
      "end_seconds": 358.7,
      "duration_seconds": 20.76,
      "text": "nothing I've seen today points to an emergency. It looks like a chest infection, probably viral, but I'd like to confirm. I'm sending you for blood tests because of cough. That will help us see what's going on underneath and decide the next step"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 360.19,
      "end_seconds": 361.95,
      "duration_seconds": 1.76,
      "text": "that sounds sensible"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 364.0,
      "end_seconds": 390.49,
      "duration_seconds": 26.49,
      "text": "I'm prescribing azithromycin, 500 milligrams, once a day, for three days. That's for chest infection. The pharmacy will go through the details again when you pick it up. Steam and warm fluids can ease the cough, and try to sleep with your head propped up. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 391.4,
      "end_seconds": 395.19,
      "duration_seconds": 3.79,
      "text": "well, yes, I'll watch for that"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 396.07,
      "end_seconds": 407.26,
      "duration_seconds": 11.19,
      "text": "keep an eye out, and if you become breathless or cough up blood, call us the same day or go to emergency we'll catch up in a week"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 409.15,
      "end_seconds": 411.22,
      "duration_seconds": 2.07,
      "text": "that works for me"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 413.24,
      "end_seconds": 415.02,
      "duration_seconds": 1.78,
      "text": "thanks for coming in"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 415.76,
      "end_seconds": 418.99,
      "duration_seconds": 3.23,
      "text": "Thanks so much uh doctor."
    }
  ]
}