{
  "schema_version": "1.0",
  "encounter_id": "00065",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.18,
      "end_seconds": 7.46,
      "duration_seconds": 6.28,
      "text": "Hi there, is it alright if I come in now?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.21,
      "end_seconds": 11.8,
      "duration_seconds": 3.59,
      "text": "Not at all, please sit. What's the problem?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 16.72,
      "end_seconds": 22.09,
      "duration_seconds": 5.37,
      "text": "Good morning, doctor. I came along to help out."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 23.43,
      "end_seconds": 27.34,
      "duration_seconds": 3.91,
      "text": "That's fine, sit down. We'll go through it together."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 28.21,
      "end_seconds": 34.64,
      "duration_seconds": 6.43,
      "text": "Doctor, it's fever and chills. It's getting on my nerves now."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_4",
      "role": "NURSE",
      "start_seconds": 35.8,
      "end_seconds": 47.36,
      "duration_seconds": 11.56,
      "text": "Doctor, I've got the readings for you. Pressure 129 over 81, oxygen saturation is 94 percent, respiratory rate 23. Pulse is 100 beats a minute."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 49.32,
      "end_seconds": 53.26,
      "duration_seconds": 3.94,
      "text": "Good, thank you. When did you first notice it?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 53.79,
      "end_seconds": 57.0,
      "duration_seconds": 3.21,
      "text": "Ever since... since last Tuesday, really."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 62.15,
      "end_seconds": 64.72,
      "duration_seconds": 2.57,
      "text": "How much is it bothering you?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 65.92,
      "end_seconds": 98.47,
      "duration_seconds": 32.55,
      "text": "Pretty severe, if I'm being honest. Oh, and a cough with phlegm. Oh, about cough with phlegm, yes, deep breaths. That makes it worse. I've also had shortness of breath, for about two weeks. Yeah, I've also been feeling very weak, for one week. About feeling very weak, a six out of ten, I suppose."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 98.81,
      "end_seconds": 105.82,
      "duration_seconds": 7.01,
      "text": "Okay, keep going. A few quick ones: coughing up blood, confusion or leg swelling?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 106.74,
      "end_seconds": 112.95,
      "duration_seconds": 6.21,
      "text": "So, no coughing up blood, confusion or leg swelling, none of it."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 113.52,
      "end_seconds": 114.4,
      "duration_seconds": 0.88,
      "text": "Any palpitations?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 114.98,
      "end_seconds": 117.69,
      "duration_seconds": 2.71,
      "text": "I haven't noticed any palpitations."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 118.96,
      "end_seconds": 119.76,
      "duration_seconds": 0.8,
      "text": "Any vomiting?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 120.5,
      "end_seconds": 123.25,
      "duration_seconds": 2.75,
      "text": "Nope, um, no vomiting."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 124.85,
      "end_seconds": 130.39,
      "duration_seconds": 5.54,
      "text": "Actually, doctor, I did notice vomiting. She doesn't always say."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 131.71,
      "end_seconds": 138.57,
      "duration_seconds": 6.86,
      "text": "Yeah, no, I don't think I did. Maybe a little, I'm not sure."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 143.53,
      "end_seconds": 152.36,
      "duration_seconds": 8.83,
      "text": "Alright, I'll note both what you've said and what you've noticed. What about your tummy and bowels, anything unusual there?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 153.52,
      "end_seconds": 156.63,
      "duration_seconds": 3.11,
      "text": "No, that side's been fine."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 161.66,
      "end_seconds": 166.28,
      "duration_seconds": 4.62,
      "text": "What about allergies, to medicines or foods or anything else?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 167.84,
      "end_seconds": 182.18,
      "duration_seconds": 14.34,
      "text": "Hmm, uh, there was some antibiotic, I was told I was allergic. But I couldn't tell you what it was called or what it did."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 182.77,
      "end_seconds": 185.47,
      "duration_seconds": 2.7,
      "text": "Have you got any chronic problems?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 186.04,
      "end_seconds": 189.14,
      "duration_seconds": 3.1,
      "text": "I have COPD, for two years."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 190.09,
      "end_seconds": 190.96,
      "duration_seconds": 0.87,
      "text": "Anything more?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 191.66,
      "end_seconds": 198.8,
      "duration_seconds": 7.14,
      "text": "I've got diabetes. I've had high blood pressure, yes. I've got heart disease."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 200.39,
      "end_seconds": 208.67,
      "duration_seconds": 8.28,
      "text": "Go on. Yes, COPD is known to us, good to have that clear. Do you live alone?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 210.71,
      "end_seconds": 214.18,
      "duration_seconds": 3.47,
      "text": "Yes, I live on my own."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 216.96,
      "end_seconds": 218.18,
      "duration_seconds": 1.22,
      "text": "How's your diet?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 219.56,
      "end_seconds": 221.03,
      "duration_seconds": 1.47,
      "text": "I'm mostly vegetarian."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 222.95,
      "end_seconds": 225.34,
      "duration_seconds": 2.39,
      "text": "What do you do for work?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 226.79,
      "end_seconds": 232.2,
      "duration_seconds": 5.41,
      "text": "I work in an office, mostly sitting at a desk."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 236.6,
      "end_seconds": 240.81,
      "duration_seconds": 4.21,
      "text": "Any medication at the moment, including things from the pharmacy?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 242.67,
      "end_seconds": 270.19,
      "duration_seconds": 27.52,
      "text": "She takes Tiotropium inhaler, once a day for my chest. I mean, she is on glimepiride, 2 milligrams, before breakfast, I give it to her. Yeah, she is on amlodipine, 5 milligrams, once a day for my pressure, I give it to her. She takes aspirin, 75 milligrams, once a day for my heart."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 281.63,
      "end_seconds": 286.38,
      "duration_seconds": 4.75,
      "text": "What about family history, any illnesses that run in the family?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 287.6,
      "end_seconds": 291.31,
      "duration_seconds": 3.71,
      "text": "Oh, my grandmother had breast cancer."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 298.82,
      "end_seconds": 302.1,
      "duration_seconds": 3.28,
      "text": "Have you ever been under the knife?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 303.53,
      "end_seconds": 310.22,
      "duration_seconds": 6.69,
      "text": "Yeah, I had a stent put in my heart two years ago."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 311.17,
      "end_seconds": 325.01,
      "duration_seconds": 13.84,
      "text": "Putting together what you've described, this looks most like a possible pneumonia on the right side. That's my thinking for now, and it may change as we learn more. Pleurisy is still possible."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_4",
      "role": "NURSE",
      "start_seconds": 337.64,
      "end_seconds": 344.27,
      "duration_seconds": 6.63,
      "text": "Doctor, I did a chest X-ray before they came in, the result's on your screen."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 345.35,
      "end_seconds": 350.79,
      "duration_seconds": 5.44,
      "text": "Thanks, I'll check it. Blood tests is what I'd like next, for infection."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 352.03,
      "end_seconds": 353.17,
      "duration_seconds": 1.14,
      "text": "Mm, okay."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 354.01,
      "end_seconds": 382.05,
      "duration_seconds": 28.04,
      "text": "Let's use paracetamol, 500 milligrams, every six hours if needed, for three days. You take it by mouth. It's for fever and body aches. What I'm giving you is amoxicillin-clavulanate, 625 milligrams, three times a day, for five days. You take it by mouth. That's for chest infection. Rest and fluids, and finish every dose of the antibiotic. Take care, and call us if anything changes."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 383.33,
      "end_seconds": 387.45,
      "duration_seconds": 4.12,
      "text": "That's everything I wanted to ask. Thank you."
    }
  ]
}