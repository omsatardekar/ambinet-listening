{
  "schema_version": "1.0",
  "encounter_id": "00427",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 0.7,
      "end_seconds": 6.42,
      "duration_seconds": 5.72,
      "text": "Doctor, I've brought them through. The observations are done, whenever you need them."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.35,
      "end_seconds": 11.92,
      "duration_seconds": 3.57,
      "text": "Okay, thanks. Hi, how can I help today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 12.78,
      "end_seconds": 22.35,
      "duration_seconds": 9.57,
      "text": "Doctor, I've come along because I know the history, if it helps. We came because of burning when I pass urine."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 22.96,
      "end_seconds": 34.66,
      "duration_seconds": 11.7,
      "text": "Here are the numbers, doctor. Temperature is 36.6 degrees, SpO2 97 percent on room air. Pulse 77, respiratory rate 14, pressure 111 over 69."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 36.02,
      "end_seconds": 40.19,
      "duration_seconds": 4.17,
      "text": "Good, thank you. How long have you had it?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 42.22,
      "end_seconds": 45.21,
      "duration_seconds": 2.99,
      "text": "Since Friday, that's when it began."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 45.85,
      "end_seconds": 50.59,
      "duration_seconds": 4.74,
      "text": "Okay, give me more detail on it, whatever comes to mind."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 52.19,
      "end_seconds": 68.0,
      "duration_seconds": 15.81,
      "text": "Pretty severe, if I'm being honest. Honestly, all the time. And cloudy, smelly urine, too. Pain low in the tummy was there, but it's gone away on its own."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 69.38,
      "end_seconds": 71.11,
      "duration_seconds": 1.73,
      "text": "Nothing like back pain?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 72.39,
      "end_seconds": 74.44,
      "duration_seconds": 2.05,
      "text": "No, no back pain."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 75.54,
      "end_seconds": 76.93,
      "duration_seconds": 1.39,
      "text": "Nothing like fever?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 78.06,
      "end_seconds": 79.74,
      "duration_seconds": 1.68,
      "text": "No, no fever."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 81.6,
      "end_seconds": 86.11,
      "duration_seconds": 4.51,
      "text": "Actually, doctor, I did notice fever. She doesn't always say."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 89.7,
      "end_seconds": 95.37,
      "duration_seconds": 5.67,
      "text": "No, I don't think I did. Maybe a little, I'm not sure."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 95.99,
      "end_seconds": 106.96,
      "duration_seconds": 10.97,
      "text": "Alright, I'll note both what you've said and what you've noticed. A few quick ones: similar episode recently, blood in the urine or vaginal discharge?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 107.57,
      "end_seconds": 114.62,
      "duration_seconds": 7.05,
      "text": "I haven't had similar episode recently, blood in the urine or vaginal discharge, no."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 119.27,
      "end_seconds": 121.24,
      "duration_seconds": 1.97,
      "text": "Is your mobility otherwise okay?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 127.81,
      "end_seconds": 129.41,
      "duration_seconds": 1.6,
      "text": "No, nothing there."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 130.68,
      "end_seconds": 135.32,
      "duration_seconds": 4.64,
      "text": "Have you noticed any weakness, or anything odd with your balance?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 136.07,
      "end_seconds": 137.58,
      "duration_seconds": 1.51,
      "text": "Nothing odd there."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 139.66,
      "end_seconds": 142.09,
      "duration_seconds": 2.43,
      "text": "So, any procedures or operations?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 144.0,
      "end_seconds": 148.71,
      "duration_seconds": 4.71,
      "text": "I had my appendix out about eight years ago."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 149.82,
      "end_seconds": 153.72,
      "duration_seconds": 3.9,
      "text": "Alright, are you on any tablets or medication?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 154.79,
      "end_seconds": 161.73,
      "duration_seconds": 6.94,
      "text": "She is on metformin, 500 milligrams, twice a day, I give it to her."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 162.99,
      "end_seconds": 164.59,
      "duration_seconds": 1.6,
      "text": "And for how long?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 165.85,
      "end_seconds": 177.64,
      "duration_seconds": 11.79,
      "text": "Two months now. It's allopurinol, 100 milligrams, once a day, doctor. She is on cranberry juice, every day, I give it to her."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 179.66,
      "end_seconds": 185.23,
      "duration_seconds": 5.57,
      "text": "Alright, what about your general health, any conditions you're being treated for?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 186.85,
      "end_seconds": 191.97,
      "duration_seconds": 5.12,
      "text": "I've got diabetes. I've had gout for two years now."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 192.51,
      "end_seconds": 197.95,
      "duration_seconds": 5.44,
      "text": "Okay, I can see diabetes and gout in your file as well."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 207.3,
      "end_seconds": 211.67,
      "duration_seconds": 4.37,
      "text": "Let's talk a little about your daily life and habits."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 216.32,
      "end_seconds": 229.61,
      "duration_seconds": 13.29,
      "text": "I smoke, yes, around five a day. I don't drink at all. I skip breakfast most days. Barely, I'm mostly sedentary these days."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 231.8,
      "end_seconds": 234.29,
      "duration_seconds": 2.49,
      "text": "Let's do the physical part now."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 235.24,
      "end_seconds": 237.08,
      "duration_seconds": 1.84,
      "text": "Let me press here."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 250.37,
      "end_seconds": 256.85,
      "duration_seconds": 6.48,
      "text": "There's mild tenderness above the pubic bone, and no tenderness in the loins."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 262.0,
      "end_seconds": 263.68,
      "duration_seconds": 1.68,
      "text": "That's fine, sit up."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 282.31,
      "end_seconds": 297.43,
      "duration_seconds": 15.12,
      "text": "Taking everything into account, it fits best with a urinary tract infection. The reason I say that is that your story and my examination fit together. We shouldn't forget a sexually transmitted infection."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 298.51,
      "end_seconds": 301.34,
      "duration_seconds": 2.83,
      "text": "Should I be worried about this?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 301.9,
      "end_seconds": 320.4,
      "duration_seconds": 18.5,
      "text": "I understand the worry. At the moment I'd say it's a urinary tract infection, and we'll know more once the a urine test is back. So, to recap quickly. You've had burning when you pass urine, since Friday, severe, and no back pain or vaginal discharge."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 321.74,
      "end_seconds": 323.23,
      "duration_seconds": 1.49,
      "text": "Yes, that's right."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 324.6,
      "end_seconds": 328.18,
      "duration_seconds": 3.58,
      "text": "We've already done a urine test this morning, doctor."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 329.17,
      "end_seconds": 334.76,
      "duration_seconds": 5.59,
      "text": "Thanks, I'll check it. I'd like to arrange a urine culture for urinary symptoms."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 335.84,
      "end_seconds": 338.44,
      "duration_seconds": 2.6,
      "text": "Alright, when would that be?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 339.2,
      "end_seconds": 374.26,
      "duration_seconds": 35.06,
      "text": "I'll start you on nitrofurantoin, 100 milligrams, twice a day, for five days. That should help with urine infection. Drink plenty of water and don't hold it in when you need to go. If you smoke, this is a good moment to think about stopping, and we can help you with that. Let's review you in a week. How would you describe the plan, so we're on the same page?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 375.49,
      "end_seconds": 385.21,
      "duration_seconds": 9.72,
      "text": "So, I take the nitrofurantoin, 100 milligrams, twice a day and come back in a week. Is that right?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 386.46,
      "end_seconds": 390.81,
      "duration_seconds": 4.35,
      "text": "Yes, exactly right. Call the clinic if you need us."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 391.83,
      "end_seconds": 394.18,
      "duration_seconds": 2.35,
      "text": "Thanks so much, doctor."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 394.73,
      "end_seconds": 396.03,
      "duration_seconds": 1.3,
      "text": "Safe journey home."
    }
  ]
}