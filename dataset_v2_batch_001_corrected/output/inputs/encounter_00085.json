{
  "schema_version": "1.0",
  "encounter_id": "00085",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.33,
      "end_seconds": 5.84,
      "duration_seconds": 4.51,
      "text": "Good evening, doctor, thank you for staying late."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.47,
      "end_seconds": 11.69,
      "duration_seconds": 4.22,
      "text": "Right on time. Sit, please. How can I help?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 13.51,
      "end_seconds": 17.48,
      "duration_seconds": 3.97,
      "text": "Good morning, doctor. I came along to help out."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 22.63,
      "end_seconds": 26.74,
      "duration_seconds": 4.11,
      "text": "That's fine, sit down. We'll go through it together."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 28.35,
      "end_seconds": 34.44,
      "duration_seconds": 6.09,
      "text": "Honestly, it's pressure in the face, and my family pushed me to come."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_4",
      "role": "NURSE",
      "start_seconds": 35.6,
      "end_seconds": 44.07,
      "duration_seconds": 8.47,
      "text": "Doctor, I've got the readings for you. Heart rate 76, blood pressure 123 over 76, SpO2 99 percent on room air."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 45.25,
      "end_seconds": 49.69,
      "duration_seconds": 4.44,
      "text": "Okay, good, thank you. How long have you had it?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 50.45,
      "end_seconds": 52.71,
      "duration_seconds": 2.26,
      "text": "Probably ten days. Yeah."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 53.49,
      "end_seconds": 60.78,
      "duration_seconds": 7.29,
      "text": "Yeah, I was just going to say that the main thing is—"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_4",
      "role": "NURSE",
      "start_seconds": 60.88,
      "end_seconds": 67.87,
      "duration_seconds": 6.99,
      "text": "Sorry to cut in, doctor, quick question: shall I bring the trolley in now or later?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 69.68,
      "end_seconds": 71.85,
      "duration_seconds": 2.17,
      "text": "Later, thanks. Please go on."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 73.14,
      "end_seconds": 97.61,
      "duration_seconds": 24.47,
      "text": "There's a blocked nose as well. About blocked nose, pretty mild, if I'm being honest. As for reduced sense of smell, I honestly can't say when that began. It might have been last month or the month before. There's thick yellow discharge from the nose as well."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 99.01,
      "end_seconds": 105.37,
      "duration_seconds": 6.36,
      "text": "And what about vision changes, nosebleeds, swelling around the eyes or ear pain?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 106.49,
      "end_seconds": 108.86,
      "duration_seconds": 2.37,
      "text": "No, I'd have mentioned it."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 110.78,
      "end_seconds": 115.89,
      "duration_seconds": 5.11,
      "text": "Let me check a few things. Any stiff neck or fever?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 117.74,
      "end_seconds": 120.14,
      "duration_seconds": 2.4,
      "text": "No, I'd have mentioned it."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 125.23,
      "end_seconds": 127.99,
      "duration_seconds": 2.76,
      "text": "Is your urine normal, no changes?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 133.03,
      "end_seconds": 134.72,
      "duration_seconds": 1.69,
      "text": "Nothing there, no."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 136.48,
      "end_seconds": 139.4,
      "duration_seconds": 2.92,
      "text": "How are your bowels, any trouble?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 142.49,
      "end_seconds": 144.76,
      "duration_seconds": 2.27,
      "text": "No, all normal there."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 158.39,
      "end_seconds": 161.27,
      "duration_seconds": 2.88,
      "text": "Any allergies I should know about?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 161.87,
      "end_seconds": 173.9,
      "duration_seconds": 12.03,
      "text": "Hmm, there was some antibiotic, I was told I was allergic. But I couldn't tell you what it was called or what it did."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 175.19,
      "end_seconds": 183.33,
      "duration_seconds": 8.14,
      "text": "So, are you on any tablets or medication? These questions might sound routine, but they matter."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 184.77,
      "end_seconds": 188.82,
      "duration_seconds": 4.05,
      "text": "Hydrocortisone cream, when needed for the eczema."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 190.55,
      "end_seconds": 196.92,
      "duration_seconds": 6.37,
      "text": "That's what's prescribed, but I'm not sure he takes it every day."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 197.85,
      "end_seconds": 210.29,
      "duration_seconds": 12.44,
      "text": "It's Asthalin inhaler, when needed. It's iron tablets, once a day for my blood count. I take Otrivin nasal drops, twice a day."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 211.51,
      "end_seconds": 215.4,
      "duration_seconds": 3.89,
      "text": "Let's talk a little about your daily life and habits."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 218.62,
      "end_seconds": 233.69,
      "duration_seconds": 15.07,
      "text": "I have a couple of drinks on the weekend. I smoke, yes, around five a day. Yes, I'm a nurse on a busy ward. I'm mostly vegetarian."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 234.86,
      "end_seconds": 240.11,
      "duration_seconds": 5.25,
      "text": "What about your general health, any conditions you're being treated for?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 240.78,
      "end_seconds": 248.44,
      "duration_seconds": 7.66,
      "text": "I've got eczema. I looked a few things up online, and that probably didn't help."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 249.18,
      "end_seconds": 250.7,
      "duration_seconds": 1.52,
      "text": "Okay, keep going."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 252.58,
      "end_seconds": 257.59,
      "duration_seconds": 5.01,
      "text": "I have asthma, for five years. Yes, low haemoglobin."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 259.68,
      "end_seconds": 265.08,
      "duration_seconds": 5.4,
      "text": "Okay, I can see asthma and low haemoglobin in your file as well."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 267.51,
      "end_seconds": 270.19,
      "duration_seconds": 2.68,
      "text": "I'd like to examine you now."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 271.46,
      "end_seconds": 272.5,
      "duration_seconds": 1.04,
      "text": "Mm, okay."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 273.43,
      "end_seconds": 275.73,
      "duration_seconds": 2.3,
      "text": "Take your time, no rush."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 293.55,
      "end_seconds": 299.43,
      "duration_seconds": 5.88,
      "text": "There's tenderness when I press over the cheeks and above the eyebrows."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 300.45,
      "end_seconds": 302.68,
      "duration_seconds": 2.23,
      "text": "Bear with me a second."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 313.07,
      "end_seconds": 316.42,
      "duration_seconds": 3.35,
      "text": "The nose is congested with swollen lining."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 319.01,
      "end_seconds": 321.37,
      "duration_seconds": 2.36,
      "text": "Okay, you can sit up."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 337.48,
      "end_seconds": 346.3,
      "duration_seconds": 8.82,
      "text": "Putting it all together, I think we're dealing with sinusitis at this stage. A viral cold is still possible."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 347.57,
      "end_seconds": 353.3,
      "duration_seconds": 5.73,
      "text": "I've been thinking the worst, to be honest. Is it bad?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 355.35,
      "end_seconds": 368.19,
      "duration_seconds": 12.84,
      "text": "Nothing I've seen today points to an emergency. It looks like sinusitis, but I'd like to confirm. I want an X-ray of the sinuses done, that's for sinusitis."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 369.82,
      "end_seconds": 371.33,
      "duration_seconds": 1.51,
      "text": "Okay, that's fine."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 372.48,
      "end_seconds": 389.48,
      "duration_seconds": 17.0,
      "text": "The treatment will be saline nasal spray, three times a day, for one week. That's for nasal congestion. For this, amoxicillin-clavulanate, 625 milligrams, twice a day, for five days. That should help with sinusitis."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 391.25,
      "end_seconds": 394.92,
      "duration_seconds": 3.67,
      "text": "Can I get that from the usual pharmacy?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 396.36,
      "end_seconds": 413.76,
      "duration_seconds": 17.4,
      "text": "Steam a couple of times a day and saline rinses will help clear things. Come back or go to emergency straight away if the symptoms get worse. Let's plan a check in ten days. That's it on my side. Anything unclear?"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 415.16,
      "end_seconds": 417.23,
      "duration_seconds": 2.07,
      "text": "Thanks, that was helpful."
    }
  ]
}