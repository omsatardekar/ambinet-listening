{
  "schema_version": "1.0",
  "encounter_id": "00029",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.2,
      "end_seconds": 2.44,
      "duration_seconds": 1.24,
      "text": "Afternoon, doctor."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 2.94,
      "end_seconds": 8.01,
      "duration_seconds": 5.07,
      "text": "Okay, you're fine, sit down. So, what brings you in?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 8.64,
      "end_seconds": 15.06,
      "duration_seconds": 6.42,
      "text": "Uh, you know, good morning, doctor. I came along to help out."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 15.71,
      "end_seconds": 20.74,
      "duration_seconds": 5.03,
      "text": "Of course, please stay. It's helpful to have you here."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 22.05,
      "end_seconds": 31.89,
      "duration_seconds": 9.84,
      "text": "It's been clearing my throat all the time, doctor. She didn't want to come, but I insisted."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 32.83,
      "end_seconds": 36.45,
      "duration_seconds": 3.62,
      "text": "Is this recent, or has it been a while?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 37.56,
      "end_seconds": 43.45,
      "duration_seconds": 5.89,
      "text": "Um, uh, it's been three weeks, I'm fairly sure."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 45.16,
      "end_seconds": 48.82,
      "duration_seconds": 3.66,
      "text": "How would you describe it, mild, moderate, severe?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 53.61,
      "end_seconds": 57.43,
      "duration_seconds": 3.82,
      "text": "Pretty severe, if I'm being honest."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 59.2,
      "end_seconds": 63.38,
      "duration_seconds": 4.18,
      "text": "Has there been a hoarse voice in the mornings too?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 65.15,
      "end_seconds": 66.3,
      "duration_seconds": 1.15,
      "text": "Mm, yes."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 67.44,
      "end_seconds": 71.91,
      "duration_seconds": 4.47,
      "text": "Any a dry cough that won't go away as well?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 77.29,
      "end_seconds": 88.39,
      "duration_seconds": 11.1,
      "text": "Yes, actually. A burning in the chest after meals was there, but it's gone away on its own."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 89.31,
      "end_seconds": 93.14,
      "duration_seconds": 3.83,
      "text": "Tell me what you take day to day."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 94.29,
      "end_seconds": 106.04,
      "duration_seconds": 11.75,
      "text": "She is on amlodipine, 5 milligrams, once a day, I give it to her. She takes pantoprazole, before breakfast for my acidity."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 107.7,
      "end_seconds": 109.68,
      "duration_seconds": 1.98,
      "text": "Do you know the dose?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 112.32,
      "end_seconds": 113.73,
      "duration_seconds": 1.41,
      "text": "It's 40 milligrams."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 115.73,
      "end_seconds": 118.55,
      "duration_seconds": 2.82,
      "text": "How long has that been going on?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 119.23,
      "end_seconds": 127.26,
      "duration_seconds": 8.03,
      "text": "About two months. It's Seretide inhaler, twice a day, doctor. She takes Digene, after meals."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 128.76,
      "end_seconds": 134.65,
      "duration_seconds": 5.89,
      "text": "Before this I was on Asthalin inhaler; that's been stopped."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 135.17,
      "end_seconds": 139.63,
      "duration_seconds": 4.46,
      "text": "Tell me about your health in general, any ongoing conditions?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 141.16,
      "end_seconds": 157.59,
      "duration_seconds": 16.43,
      "text": "High blood pressure, for nearly five years. I just want to get back to normal, really. I told myself I'd wait and see, and here I am."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 159.56,
      "end_seconds": 160.46,
      "duration_seconds": 0.9,
      "text": "Anything more?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 162.01,
      "end_seconds": 170.24,
      "duration_seconds": 8.23,
      "text": "Acid reflux, for five years. My family kept telling me to get it checked."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 171.99,
      "end_seconds": 172.81,
      "duration_seconds": 0.82,
      "text": "And then?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 173.37,
      "end_seconds": 177.41,
      "duration_seconds": 4.04,
      "text": "I've had asthma for five years now."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 179.15,
      "end_seconds": 180.13,
      "duration_seconds": 0.98,
      "text": "Anything more?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 192.09,
      "end_seconds": 196.62,
      "duration_seconds": 4.53,
      "text": "Anyone in the family with similar problems or other conditions?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 197.88,
      "end_seconds": 206.27,
      "duration_seconds": 8.39,
      "text": "Well, uh, my father had kidney stones. Well, my grandmother had breast cancer."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 217.92,
      "end_seconds": 223.34,
      "duration_seconds": 5.42,
      "text": "Are there any allergies on your record that I should check?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 224.33,
      "end_seconds": 239.39,
      "duration_seconds": 15.06,
      "text": "Hmm, there was some antibiotic, I was told I was allergic. But I couldn't tell you what it was called or what it did."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 241.14,
      "end_seconds": 243.54,
      "duration_seconds": 2.4,
      "text": "Are you working at the moment?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 244.62,
      "end_seconds": 249.17,
      "duration_seconds": 4.55,
      "text": "Yes, I'm a nurse on a busy ward."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 250.01,
      "end_seconds": 252.69,
      "duration_seconds": 2.68,
      "text": "And what do you usually eat?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 254.09,
      "end_seconds": 257.48,
      "duration_seconds": 3.39,
      "text": "Mostly home-cooked food, rice and vegetables."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 258.41,
      "end_seconds": 262.41,
      "duration_seconds": 4.0,
      "text": "Have you had any night sweats, wheezing or trouble swallowing?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 263.73,
      "end_seconds": 268.03,
      "duration_seconds": 4.3,
      "text": "No, no night sweats, wheezing or trouble swallowing."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 268.82,
      "end_seconds": 273.59,
      "duration_seconds": 4.77,
      "text": "Have you had any weight loss or coughing up blood?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 274.76,
      "end_seconds": 279.95,
      "duration_seconds": 5.19,
      "text": "No weight loss or coughing up blood, none of it."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 281.54,
      "end_seconds": 285.37,
      "duration_seconds": 3.83,
      "text": "Anything with your heart, like skipped beats or fainting?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 286.68,
      "end_seconds": 288.47,
      "duration_seconds": 1.79,
      "text": "Nothing like that."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 290.51,
      "end_seconds": 294.46,
      "duration_seconds": 3.95,
      "text": "Let's get your blood pressure and the other basics."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 305.69,
      "end_seconds": 307.35,
      "duration_seconds": 1.66,
      "text": "Just relax your arm..."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 325.58,
      "end_seconds": 337.42,
      "duration_seconds": 11.84,
      "text": "Okay: temp 36.7 degrees, BP is 119 over 70, respiratory rate 15. And saturation 99 percent, weight 75 kilos, height 174 centimetres, heart rate 69."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 339.46,
      "end_seconds": 341.29,
      "duration_seconds": 1.83,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 342.32,
      "end_seconds": 345.3,
      "duration_seconds": 2.98,
      "text": "I'll interpret it once I've examined you."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 346.94,
      "end_seconds": 350.68,
      "duration_seconds": 3.74,
      "text": "Okay, I need to examine you for this."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 351.98,
      "end_seconds": 354.37,
      "duration_seconds": 2.39,
      "text": "Tell me if anything hurts."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 365.28,
      "end_seconds": 370.39,
      "duration_seconds": 5.11,
      "text": "Chest is clear and the throat looks a little red at the back."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 373.83,
      "end_seconds": 386.66,
      "duration_seconds": 12.83,
      "text": "All done, you can get dressed. Okay, thinking it through, it points towards a cough driven by acid reflux. I can't rule out post-nasal drip yet."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 387.27,
      "end_seconds": 390.58,
      "duration_seconds": 3.31,
      "text": "Right, doctor, is this dangerous?"
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 392.63,
      "end_seconds": 412.72,
      "duration_seconds": 20.09,
      "text": "Nothing I've seen today points to an emergency. It looks like a cough driven by acid reflux, but I'd like to confirm. Let me just check I've got this right. You've been clearing your throat all the time for three weeks, severe, and no wheezing or coughing up blood."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 413.84,
      "end_seconds": 414.54,
      "duration_seconds": 0.7,
      "text": "Exactly."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 422.99,
      "end_seconds": 439.73,
      "duration_seconds": 16.74,
      "text": "Let's get a chest X-ray, for chronic cough. Let's get breathing tests, for chronic cough. Don't eat for two or three hours before lying down, and raise the head of the bed a little. Book a review in a month."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 440.27,
      "end_seconds": 443.66,
      "duration_seconds": 3.39,
      "text": "Okay, so okay, I'll book that."
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 444.26,
      "end_seconds": 452.3,
      "duration_seconds": 8.04,
      "text": "Can you tell me the plan back in your own words, so I know I've explained it clearly?"
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 453.67,
      "end_seconds": 459.83,
      "duration_seconds": 6.16,
      "text": "So, I come back in a month. Is that right?"
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 461.84,
      "end_seconds": 466.59,
      "duration_seconds": 4.75,
      "text": "Yes, exactly right. Take care, and call us if anything changes."
    },
    {
      "segment_id": "SEG0059",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 470.5,
      "end_seconds": 474.26,
      "duration_seconds": 3.76,
      "text": "Thanks so much, you know, doctor."
    },
    {
      "segment_id": "SEG0060",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 476.28,
      "end_seconds": 477.55,
      "duration_seconds": 1.27,
      "text": "Bye for now."
    }
  ]
}