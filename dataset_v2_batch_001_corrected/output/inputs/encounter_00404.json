{
  "schema_version": "1.0",
  "encounter_id": "00404",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.85,
      "end_seconds": 5.11,
      "duration_seconds": 4.26,
      "text": "Hello? Doctor? They told me to come straight in."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.76,
      "end_seconds": 8.99,
      "duration_seconds": 3.23,
      "text": "Yes, do sit. Tell me what's been happening."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 9.81,
      "end_seconds": 17.86,
      "duration_seconds": 8.05,
      "text": "Mainly my heart racing. There's a couple of other things, but that's the main one."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 19.88,
      "end_seconds": 23.17,
      "duration_seconds": 3.29,
      "text": "Okay, how long have you had it?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 24.86,
      "end_seconds": 31.83,
      "duration_seconds": 6.97,
      "text": "I'd say about a month. Actually, no, closer to about three months."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 32.47,
      "end_seconds": 35.04,
      "duration_seconds": 2.57,
      "text": "Is it mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 36.71,
      "end_seconds": 41.75,
      "duration_seconds": 5.04,
      "text": "It's moderate, honestly. I've been feeling anxious and jittery too."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 43.26,
      "end_seconds": 46.14,
      "duration_seconds": 2.88,
      "text": "Have you noticed diarrhoea or chest pain?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 48.14,
      "end_seconds": 51.31,
      "duration_seconds": 3.17,
      "text": "None, as far as I know."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 51.82,
      "end_seconds": 58.0,
      "duration_seconds": 6.18,
      "text": "And what about trouble sleeping, lump in the neck or shortness of breath?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 58.66,
      "end_seconds": 66.44,
      "duration_seconds": 7.78,
      "text": "Well, no trouble sleeping, lump in the neck or shortness of breath, none of it."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 67.49,
      "end_seconds": 71.96,
      "duration_seconds": 4.47,
      "text": "Any change in your bowel habit or your stomach generally?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 77.47,
      "end_seconds": 80.2,
      "duration_seconds": 2.73,
      "text": "No, that side's been fine."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 96.74,
      "end_seconds": 99.67,
      "duration_seconds": 2.93,
      "text": "A few questions about your lifestyle now."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 101.62,
      "end_seconds": 119.71,
      "duration_seconds": 18.09,
      "text": "I gave up drinking about three years ago. I smoke about ten cigarettes a day. I eat out quite a lot, to be honest. I share a flat with two friends. I'm a self-employed electrician."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 120.35,
      "end_seconds": 124.75,
      "duration_seconds": 4.4,
      "text": "Moving on to your background, any past medical history?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 126.23,
      "end_seconds": 131.32,
      "duration_seconds": 5.09,
      "text": "Uh, I have arthritis in my knees, for two years."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 132.39,
      "end_seconds": 133.09,
      "duration_seconds": 0.7,
      "text": "Yes?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 134.61,
      "end_seconds": 142.72,
      "duration_seconds": 8.11,
      "text": "Yes, arthritis in your knees is known to us, good to have that clear. Any operations in the past?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 143.82,
      "end_seconds": 149.35,
      "duration_seconds": 5.53,
      "text": "Yes, I had cataract surgery on my right eye, last year."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 150.77,
      "end_seconds": 154.33,
      "duration_seconds": 3.56,
      "text": "Tell me what you take day to day."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 155.22,
      "end_seconds": 162.07,
      "duration_seconds": 6.85,
      "text": "Paracetamol. I take it 650 milligrams, when needed for the knee pain."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 163.5,
      "end_seconds": 167.31,
      "duration_seconds": 3.81,
      "text": "Let's get your blood pressure and the other basics."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 176.62,
      "end_seconds": 177.6,
      "duration_seconds": 0.98,
      "text": "One second..."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 189.15,
      "end_seconds": 197.36,
      "duration_seconds": 8.21,
      "text": "Okay: respiratory rate 18, blood pressure 132 over 86, pulse 109, SpO2 97 percent on room air."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 198.84,
      "end_seconds": 200.29,
      "duration_seconds": 1.45,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 201.07,
      "end_seconds": 204.23,
      "duration_seconds": 3.16,
      "text": "Okay, I'll explain what that means shortly."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 220.65,
      "end_seconds": 230.87,
      "duration_seconds": 10.22,
      "text": "Okay, so my impression from what you've said is this: The most likely explanation is an overactive thyroid. Another possibility is a heart rhythm problem."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 248.71,
      "end_seconds": 252.73,
      "duration_seconds": 4.02,
      "text": "We should do a thyroid test for hyperthyroid symptoms."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 254.07,
      "end_seconds": 259.09,
      "duration_seconds": 5.02,
      "text": "We have a slot Thursday at 9 am, if that works."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 259.92,
      "end_seconds": 292.24,
      "duration_seconds": 32.32,
      "text": "We should do an ECG for palpitations. I'd rather check than guess, and this is the quickest way to know more. I'm sending you for a thyroid scan because of hyperthyroidism. You'll be taking propranolol, 20 milligrams, twice a day, until we review. You take it by mouth. It's for palpitations and tremor. Limit tea, coffee and anything that speeds up the heart for now. Let's get you seen by an endocrinologist, I'll arrange the letter."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 294.15,
      "end_seconds": 296.95,
      "duration_seconds": 2.8,
      "text": "I'll want another look in two weeks."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 297.79,
      "end_seconds": 301.78,
      "duration_seconds": 3.99,
      "text": "I'll make the appointment on my way out."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 302.56,
      "end_seconds": 311.26,
      "duration_seconds": 8.7,
      "text": "So, can you tell me the plan back in your own words, so I know I've explained it clearly?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 312.72,
      "end_seconds": 322.26,
      "duration_seconds": 9.54,
      "text": "So, I take the propranolol, 20 milligrams, twice a day and come back in two weeks. Is that right?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 324.35,
      "end_seconds": 328.6,
      "duration_seconds": 4.25,
      "text": "Yes, exactly right. Okay, we're done for today. Take care."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 330.48,
      "end_seconds": 334.99,
      "duration_seconds": 4.51,
      "text": "No, I think that's everything. Thank you, doctor."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 336.2,
      "end_seconds": 337.67,
      "duration_seconds": 1.47,
      "text": "Safe journey home."
    }
  ]
}