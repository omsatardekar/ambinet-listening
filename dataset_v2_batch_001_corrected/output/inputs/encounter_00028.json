{
  "schema_version": "1.0",
  "encounter_id": "00028",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 0.65,
      "end_seconds": 4.93,
      "duration_seconds": 4.28,
      "text": "Doctor, we're ready in room two, I've already taken the observations."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 9.13,
      "end_seconds": 13.54,
      "duration_seconds": 4.41,
      "text": "Thanks, that's helpful. Hello, please sit. What's been happening?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 15.33,
      "end_seconds": 20.39,
      "duration_seconds": 5.06,
      "text": "I've been feeling lightheaded, and I wanted to get it checked."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 22.12,
      "end_seconds": 26.32,
      "duration_seconds": 4.2,
      "text": "Is this recent, or has it been a while?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 27.83,
      "end_seconds": 31.91,
      "duration_seconds": 4.08,
      "text": "It's been two months, I'm fairly sure."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 32.6,
      "end_seconds": 36.85,
      "duration_seconds": 4.25,
      "text": "Is it constant, or does it come and go?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 37.77,
      "end_seconds": 41.55,
      "duration_seconds": 3.78,
      "text": "Honestly, a couple of times a week."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 43.61,
      "end_seconds": 46.59,
      "duration_seconds": 2.98,
      "text": "How bad is it, would you say?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 48.26,
      "end_seconds": 51.05,
      "duration_seconds": 2.79,
      "text": "About a four out of ten."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 52.78,
      "end_seconds": 56.05,
      "duration_seconds": 3.27,
      "text": "Is it worse with anything in particular?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 58.09,
      "end_seconds": 65.38,
      "duration_seconds": 7.29,
      "text": "It's worse with standing up and hot weather. I've been sweating too, for three weeks."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 66.39,
      "end_seconds": 68.98,
      "duration_seconds": 2.59,
      "text": "Any vomiting, slurred speech or palpitations?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 69.96,
      "end_seconds": 71.93,
      "duration_seconds": 1.97,
      "text": "No, none of those."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 73.83,
      "end_seconds": 77.04,
      "duration_seconds": 3.21,
      "text": "And what about fainting completely or chest pain?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 78.42,
      "end_seconds": 83.41,
      "duration_seconds": 4.99,
      "text": "I haven't had fainting completely or chest pain, no."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 84.95,
      "end_seconds": 87.96,
      "duration_seconds": 3.01,
      "text": "Is your urine normal, no changes?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 88.97,
      "end_seconds": 91.8,
      "duration_seconds": 2.83,
      "text": "Nothing there, uh, no."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 92.48,
      "end_seconds": 93.69,
      "duration_seconds": 1.21,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 95.41,
      "end_seconds": 97.87,
      "duration_seconds": 2.46,
      "text": "No, never had any surgery."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 98.62,
      "end_seconds": 101.8,
      "duration_seconds": 3.18,
      "text": "Is there anything medical in your background?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 102.83,
      "end_seconds": 104.38,
      "duration_seconds": 1.55,
      "text": "I have diabetes."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 105.42,
      "end_seconds": 107.8,
      "duration_seconds": 2.38,
      "text": "Any allergies I should know about?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 108.38,
      "end_seconds": 110.84,
      "duration_seconds": 2.46,
      "text": "Not that I know, no."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 116.44,
      "end_seconds": 119.01,
      "duration_seconds": 2.57,
      "text": "And what do you usually eat?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 120.47,
      "end_seconds": 123.5,
      "duration_seconds": 3.03,
      "text": "Mostly home-cooked food, rice and vegetables."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 124.44,
      "end_seconds": 127.27,
      "duration_seconds": 2.83,
      "text": "What do you do to keep active?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 129.1,
      "end_seconds": 131.81,
      "duration_seconds": 2.71,
      "text": "I cycle to work most mornings."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 133.04,
      "end_seconds": 135.35,
      "duration_seconds": 2.31,
      "text": "Are you working or retired?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 136.73,
      "end_seconds": 140.01,
      "duration_seconds": 3.28,
      "text": "Retired. I stopped a few years back."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 141.01,
      "end_seconds": 144.7,
      "duration_seconds": 3.69,
      "text": "Tell me what you take day to day."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 146.0,
      "end_seconds": 151.35,
      "duration_seconds": 5.35,
      "text": "I take glimepiride, 2 milligrams, before breakfast for my sugar."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 162.86,
      "end_seconds": 178.52,
      "duration_seconds": 15.66,
      "text": "Okay, so the vitals from earlier. Weight 90 kilos, SpO2 96 percent on room air, BMI works out to 26.0, temperature 37.1, pulse is 102 beats a minute, pressure 101 over 59, height 186 centimetres."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 180.53,
      "end_seconds": 181.53,
      "duration_seconds": 1.0,
      "text": "Okay, noted."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 184.45,
      "end_seconds": 187.75,
      "duration_seconds": 3.3,
      "text": "Let me have a look at you."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 189.26,
      "end_seconds": 190.96,
      "duration_seconds": 1.7,
      "text": "Let me press here."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 209.7,
      "end_seconds": 211.56,
      "duration_seconds": 1.86,
      "text": "Heart rhythm is regular."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 213.38,
      "end_seconds": 215.14,
      "duration_seconds": 1.76,
      "text": "Let me press here."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 229.71,
      "end_seconds": 234.24,
      "duration_seconds": 4.53,
      "text": "Your blood pressure drops when you stand, I'll note that."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 248.01,
      "end_seconds": 248.97,
      "duration_seconds": 0.96,
      "text": "Go ahead."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 253.59,
      "end_seconds": 264.14,
      "duration_seconds": 10.55,
      "text": "Thanks for that. Having listened and examined, I'd lean towards postural low blood pressure. I can't rule out a heart rhythm problem yet."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 281.49,
      "end_seconds": 295.07,
      "duration_seconds": 13.58,
      "text": "I want an ECG done, that's for dizziness. The result will help us decide whether anything more is needed. I want a blood sugar test done, that's for dizziness."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 295.59,
      "end_seconds": 297.85,
      "duration_seconds": 2.26,
      "text": "How long does that take?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 299.64,
      "end_seconds": 330.7,
      "duration_seconds": 31.06,
      "text": "Get up in stages, sit on the edge of the bed for a minute first, and keep drinking water. Try to get to bed and wake up at the same time each day, and keep your phone away from the bed. Let's hold off on blood tests for now, and if there's no change in two weeks we can revisit it. Let's plan a check in two weeks."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 332.64,
      "end_seconds": 334.78,
      "duration_seconds": 2.14,
      "text": "Okay, see you then."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 335.39,
      "end_seconds": 338.33,
      "duration_seconds": 2.94,
      "text": "That's everything from me. Any other questions?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 340.38,
      "end_seconds": 342.66,
      "duration_seconds": 2.28,
      "text": "Okay, thank you. Bye."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 343.29,
      "end_seconds": 345.0,
      "duration_seconds": 1.71,
      "text": "Okay, bye for now."
    }
  ]
}