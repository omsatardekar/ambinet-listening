{
  "schema_version": "1.0",
  "encounter_id": "00099",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 0.86,
      "end_seconds": 6.15,
      "duration_seconds": 5.29,
      "text": "Doctor, I've brought them through. The observations are done, whenever you need them."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.71,
      "end_seconds": 11.38,
      "duration_seconds": 3.67,
      "text": "Perfect, thanks. Hello there, so what's the trouble?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 13.21,
      "end_seconds": 16.31,
      "duration_seconds": 3.1,
      "text": "It's pressure behind the eyes, mostly."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 17.02,
      "end_seconds": 19.13,
      "duration_seconds": 2.11,
      "text": "And when did that start?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 20.65,
      "end_seconds": 23.26,
      "duration_seconds": 2.61,
      "text": "Ever since... since yesterday, really."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 24.35,
      "end_seconds": 26.81,
      "duration_seconds": 2.46,
      "text": "And how severe is it?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 27.57,
      "end_seconds": 29.13,
      "duration_seconds": 1.56,
      "text": "Moderate, I'd say."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 29.66,
      "end_seconds": 35.52,
      "duration_seconds": 5.86,
      "text": "I was just going to say that the main thing is—"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 35.62,
      "end_seconds": 41.66,
      "duration_seconds": 6.04,
      "text": "Sorry to cut in, doctor, quick question: shall I bring the trolley in now or later?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 42.23,
      "end_seconds": 44.35,
      "duration_seconds": 2.12,
      "text": "Later, thanks. Please go on."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 46.3,
      "end_seconds": 51.11,
      "duration_seconds": 4.81,
      "text": "I mean, there's headaches for a while as well."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 52.74,
      "end_seconds": 56.76,
      "duration_seconds": 4.02,
      "text": "How would you describe it, mild, moderate, severe?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 58.59,
      "end_seconds": 59.69,
      "duration_seconds": 1.1,
      "text": "Severe, really."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 60.23,
      "end_seconds": 60.93,
      "duration_seconds": 0.7,
      "text": "Mm."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_4",
      "role": "UNKNOWN",
      "start_seconds": 62.41,
      "end_seconds": 64.57,
      "duration_seconds": 2.16,
      "text": "Yes, exactly like that."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 66.62,
      "end_seconds": 74.96,
      "duration_seconds": 8.34,
      "text": "Okay, so the vitals from earlier. Pulse is 77 beats a minute, pressure 115 over 75, respiratory rate 15."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 76.89,
      "end_seconds": 77.59,
      "duration_seconds": 0.7,
      "text": "Thanks."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 79.15,
      "end_seconds": 82.01,
      "duration_seconds": 2.86,
      "text": "Let me examine, it won't take long."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 82.58,
      "end_seconds": 83.28,
      "duration_seconds": 0.7,
      "text": "Alright."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 84.16,
      "end_seconds": 86.4,
      "duration_seconds": 2.24,
      "text": "Almost done with this part."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 102.59,
      "end_seconds": 105.93,
      "duration_seconds": 3.34,
      "text": "Power and reflexes are equal on both sides."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 107.02,
      "end_seconds": 108.32,
      "duration_seconds": 1.3,
      "text": "I'll go gently."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 121.98,
      "end_seconds": 127.65,
      "duration_seconds": 5.67,
      "text": "Visual fields are full to confrontation and the optic discs look normal."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 129.8,
      "end_seconds": 135.65,
      "duration_seconds": 5.85,
      "text": "Okay, you can sit up. Any confusion, seizures or head injury at all?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 139.85,
      "end_seconds": 152.59,
      "duration_seconds": 12.74,
      "text": "No, uh, no confusion, no seizures, no head injury. I did have neck tightness at one point, but that went away on its own."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 154.54,
      "end_seconds": 158.74,
      "duration_seconds": 4.2,
      "text": "Have you noticed weakness, jaw pain on chewing or fever?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 159.32,
      "end_seconds": 161.63,
      "duration_seconds": 2.31,
      "text": "Nothing like that, no."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 163.15,
      "end_seconds": 165.16,
      "duration_seconds": 2.01,
      "text": "Is your digestion otherwise okay?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 166.44,
      "end_seconds": 169.04,
      "duration_seconds": 2.6,
      "text": "Bowels are regular, nothing odd."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 178.17,
      "end_seconds": 179.57,
      "duration_seconds": 1.4,
      "text": "Do you smoke?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 181.31,
      "end_seconds": 184.88,
      "duration_seconds": 3.57,
      "text": "I smoke about ten cigarettes a day."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 186.08,
      "end_seconds": 188.9,
      "duration_seconds": 2.82,
      "text": "Okay, do you get any exercise?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 189.77,
      "end_seconds": 194.66,
      "duration_seconds": 4.89,
      "text": "I walk for about half an hour most days."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 195.72,
      "end_seconds": 199.35,
      "duration_seconds": 3.63,
      "text": "Have you had to have anything operated on?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 201.41,
      "end_seconds": 205.25,
      "duration_seconds": 3.84,
      "text": "I had my gallbladder removed in 2016."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 206.68,
      "end_seconds": 210.72,
      "duration_seconds": 4.04,
      "text": "Let's go through your medication. What are you taking?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 211.42,
      "end_seconds": 217.53,
      "duration_seconds": 6.11,
      "text": "I'm on losartan, 50 milligrams, once a day for my blood pressure."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 218.18,
      "end_seconds": 221.05,
      "duration_seconds": 2.87,
      "text": "How long have you taken that?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 222.77,
      "end_seconds": 231.42,
      "duration_seconds": 8.65,
      "text": "Nearly five years now. I take allopurinol, 100 milligrams, maybe, once a day for the gout."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 233.18,
      "end_seconds": 237.86,
      "duration_seconds": 4.68,
      "text": "Have you got the box or the prescription on you?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 239.74,
      "end_seconds": 248.46,
      "duration_seconds": 8.72,
      "text": "Not with me. I'll bring it next time. It's aspirin, 75 milligrams, once a day."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 250.27,
      "end_seconds": 255.43,
      "duration_seconds": 5.16,
      "text": "Doctor, our chart from the last visit lists it as 150 milligrams."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 256.46,
      "end_seconds": 259.22,
      "duration_seconds": 2.76,
      "text": "Alright. Did you bring the up-to-date prescription?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 259.74,
      "end_seconds": 267.54,
      "duration_seconds": 7.8,
      "text": "No, I left it at home. It's atorvastatin, 20 milligrams, at night for my cholesterol."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 269.34,
      "end_seconds": 272.66,
      "duration_seconds": 3.32,
      "text": "Since when have you been taking it?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 274.53,
      "end_seconds": 276.06,
      "duration_seconds": 1.53,
      "text": "About two months."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 278.08,
      "end_seconds": 284.06,
      "duration_seconds": 5.98,
      "text": "So, are there any allergies on your record that I should check?"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 285.3,
      "end_seconds": 288.0,
      "duration_seconds": 2.7,
      "text": "No, no allergies to anything."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 290.03,
      "end_seconds": 294.45,
      "duration_seconds": 4.42,
      "text": "Tell me about your health in general, any ongoing conditions?"
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 296.45,
      "end_seconds": 301.27,
      "duration_seconds": 4.82,
      "text": "I've had high blood pressure for about a year now."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 307.64,
      "end_seconds": 308.67,
      "duration_seconds": 1.03,
      "text": "Hm, okay."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 309.26,
      "end_seconds": 324.12,
      "duration_seconds": 14.86,
      "text": "I have gout. I have heart disease, for about a year. Yes, high cholesterol. I've had thin bones for two years now. Sorry, I know I'm rambling a bit."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 325.01,
      "end_seconds": 332.35,
      "duration_seconds": 7.34,
      "text": "Right, so high blood pressure and gout are already on your record. We'll keep that in mind today."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 348.94,
      "end_seconds": 358.87,
      "duration_seconds": 9.93,
      "text": "Okay, thinking it through, my working impression is a headache disorder of uncertain type. I'd also keep tension-type headache in mind."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 359.44,
      "end_seconds": 362.82,
      "duration_seconds": 3.38,
      "text": "Is this going to go away?"
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 364.87,
      "end_seconds": 383.79,
      "duration_seconds": 18.92,
      "text": "It's reasonable to be concerned, but right now a headache disorder of uncertain type is my leading thought, not anything worse. I'm sending you for an eye pressure check because of headache with blurred vision. The result will help us decide whether anything more is needed."
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_5",
      "role": "CLINICAL_STAFF",
      "start_seconds": 385.51,
      "end_seconds": 389.36,
      "duration_seconds": 3.85,
      "text": "I can book that for Friday at 2 pm."
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 390.75,
      "end_seconds": 398.11,
      "duration_seconds": 7.36,
      "text": "I think an MRI of the brain makes sense here, for headaches with visual symptoms."
    },
    {
      "segment_id": "SEG0059",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 402.26,
      "end_seconds": 404.51,
      "duration_seconds": 2.25,
      "text": "How long does that take?"
    },
    {
      "segment_id": "SEG0060",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 405.48,
      "end_seconds": 429.03,
      "duration_seconds": 23.55,
      "text": "Note down each headache with the date, time and what you were doing. Let's get you seen by a neurologist, I'll arrange the letter. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose. I'll want another look in four weeks. Okay, I think we're finished. Is everything clear?"
    },
    {
      "segment_id": "SEG0061",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 430.5,
      "end_seconds": 432.69,
      "duration_seconds": 2.19,
      "text": "No questions. Thank you."
    },
    {
      "segment_id": "SEG0062",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 436.13,
      "end_seconds": 437.34,
      "duration_seconds": 1.21,
      "text": "All the best."
    }
  ]
}