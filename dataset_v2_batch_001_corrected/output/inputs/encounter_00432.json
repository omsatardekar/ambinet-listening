{
  "schema_version": "1.0",
  "encounter_id": "00432",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.36,
      "end_seconds": 6.47,
      "duration_seconds": 5.11,
      "text": "hello, um, doctor where would you like me?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 11.1,
      "end_seconds": 15.8,
      "duration_seconds": 4.7,
      "text": "So, no trouble at all, come in. What's been bothering you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 17.33,
      "end_seconds": 23.46,
      "duration_seconds": 6.13,
      "text": "Uh, mainly I've been feeling tired. That's why I came."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 24.9,
      "end_seconds": 27.26,
      "duration_seconds": 2.36,
      "text": "roughly when did it start?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 27.98,
      "end_seconds": 30.38,
      "duration_seconds": 2.4,
      "text": "Probably three weeks. Yeah."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 30.72,
      "end_seconds": 35.22,
      "duration_seconds": 4.5,
      "text": "Ah. How would you describe it, mild, moderate, severe?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 36.56,
      "end_seconds": 45.0,
      "duration_seconds": 8.44,
      "text": "it's moderate, honestly and there's a racing heart sometimes as well, you know, two months now"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 46.63,
      "end_seconds": 49.88,
      "duration_seconds": 3.25,
      "text": "have you had any fainting or chest pain?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 50.75,
      "end_seconds": 55.45,
      "duration_seconds": 4.7,
      "text": "Yeah, you know, no, I'd have mentioned it."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 56.2,
      "end_seconds": 61.5,
      "duration_seconds": 5.3,
      "text": "have you had any blood in the stool, heavy periods or weight loss?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 63.26,
      "end_seconds": 71.11,
      "duration_seconds": 7.85,
      "text": "No blood in the stool, heavy periods or weight loss, none of it."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 71.68,
      "end_seconds": 74.19,
      "duration_seconds": 2.51,
      "text": "Is your urine normal, no changes?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 75.62,
      "end_seconds": 77.87,
      "duration_seconds": 2.25,
      "text": "No, that's all fine."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 88.02,
      "end_seconds": 89.31,
      "duration_seconds": 1.29,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 90.01,
      "end_seconds": 91.62,
      "duration_seconds": 1.61,
      "text": "No operations, no."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 105.87,
      "end_seconds": 109.14,
      "duration_seconds": 3.27,
      "text": "Right, what medicines do you take regularly?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 110.86,
      "end_seconds": 114.62,
      "duration_seconds": 3.76,
      "text": "it's pantoprazole, 40 milligrams, before breakfast"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 115.31,
      "end_seconds": 120.09,
      "duration_seconds": 4.78,
      "text": "What about allergies, to medicines or foods or anything else?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 121.69,
      "end_seconds": 126.41,
      "duration_seconds": 4.72,
      "text": "Yeah, I don't have any known medication allergies."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 128.1,
      "end_seconds": 131.32,
      "duration_seconds": 3.22,
      "text": "And what do you do for a living?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 132.74,
      "end_seconds": 137.02,
      "duration_seconds": 4.28,
      "text": "I work night shifts at a warehouse"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 138.89,
      "end_seconds": 140.61,
      "duration_seconds": 1.72,
      "text": "What's your diet like?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 145.86,
      "end_seconds": 151.08,
      "duration_seconds": 5.22,
      "text": "I eat out quite a lot, to be honest."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 151.98,
      "end_seconds": 154.0,
      "duration_seconds": 2.02,
      "text": "Who do you live with?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 155.76,
      "end_seconds": 161.39,
      "duration_seconds": 5.63,
      "text": "I live with my family, my husband and two kids."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 161.91,
      "end_seconds": 167.31,
      "duration_seconds": 5.4,
      "text": "What about your general health, any conditions you're being treated for?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 167.85,
      "end_seconds": 172.29,
      "duration_seconds": 4.44,
      "text": "I have acid reflux, for nearly five years."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 172.85,
      "end_seconds": 173.55,
      "duration_seconds": 0.7,
      "text": "Yes?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 175.36,
      "end_seconds": 183.31,
      "duration_seconds": 7.95,
      "text": "Yes, acid reflux is known to us, good to have that clear. Can I take your vitals now?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 189.86,
      "end_seconds": 191.7,
      "duration_seconds": 1.84,
      "text": "Hold still for me..."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 201.74,
      "end_seconds": 210.41,
      "duration_seconds": 8.67,
      "text": "Okay: temperature 37.0, pulse 112, BP is 118 over 81, SpO2 98 percent on room air."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 213.71,
      "end_seconds": 215.83,
      "duration_seconds": 2.12,
      "text": "Is that alright, doctor?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 216.62,
      "end_seconds": 220.93,
      "duration_seconds": 4.31,
      "text": "Don't worry, I'll go through it in a moment."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 222.49,
      "end_seconds": 225.77,
      "duration_seconds": 3.28,
      "text": "okay, I need to examine you for this"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 226.86,
      "end_seconds": 230.01,
      "duration_seconds": 3.15,
      "text": "Stay still while I have a look."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 247.91,
      "end_seconds": 252.27,
      "duration_seconds": 4.36,
      "text": "heart sounds are normal, I don't hear any murmur"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 254.05,
      "end_seconds": 257.38,
      "duration_seconds": 3.33,
      "text": "stay still while I have a look"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 264.54,
      "end_seconds": 266.62,
      "duration_seconds": 2.08,
      "text": "Your eyelids are pale inside."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 271.44,
      "end_seconds": 272.35,
      "duration_seconds": 0.91,
      "text": "Okay, finished."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 286.0,
      "end_seconds": 305.28,
      "duration_seconds": 19.28,
      "text": "Let me tell you where I've got to. It's hard to say. Anaemia of some kind is one possibility and a vitamin deficiency another, and I'd rather not commit yet. We should do a full blood count for pallor."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 307.14,
      "end_seconds": 308.31,
      "duration_seconds": 1.17,
      "text": "Mm, okay."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 309.62,
      "end_seconds": 320.78,
      "duration_seconds": 11.16,
      "text": "We'll begin with ferrous sulfate, 200 milligrams, once a day, for three months. You take it it by mouth. That's for possible iron deficiency."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 325.52,
      "end_seconds": 328.05,
      "duration_seconds": 2.53,
      "text": "fine, I'll start it"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 331.29,
      "end_seconds": 345.01,
      "duration_seconds": 13.72,
      "text": "Iron can darken the stools and bother the stomach, so take it after food. The thing that would worry me is if the symptoms get worse. If that happens, go to emergency."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 346.49,
      "end_seconds": 349.68,
      "duration_seconds": 3.19,
      "text": "Yes, I'll keep that in mind."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 350.92,
      "end_seconds": 353.79,
      "duration_seconds": 2.87,
      "text": "see me again in two weeks"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 354.96,
      "end_seconds": 358.37,
      "duration_seconds": 3.41,
      "text": "okay, um, see you then"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 359.38,
      "end_seconds": 364.25,
      "duration_seconds": 4.87,
      "text": "How would you describe the plan, so we're on the same page?"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 368.09,
      "end_seconds": 381.43,
      "duration_seconds": 13.34,
      "text": "So, um, I take the ferrous sulfate, 200 milligrams, once a day and come back in two weeks. Is that right?"
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 382.93,
      "end_seconds": 387.42,
      "duration_seconds": 4.49,
      "text": "Yes, exactly right. That's everything from me. Any other questions?"
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 393.65,
      "end_seconds": 395.85,
      "duration_seconds": 2.2,
      "text": "thanks so much, doctor"
    }
  ]
}