      "start_seconds": 174.86,
      "end_seconds": 184.35,
      "duration_seconds": 9.49,
      "text": "okay: temperature is 36.7 degrees, pulse 66, height 171 centimetres, BP is 114 over 70, weight 92 kilos, saturation 98 percent"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 185.53,
      "end_seconds": 187.06,
      "duration_seconds": 1.53,
      "text": "is that normal?"
