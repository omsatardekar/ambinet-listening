    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 243.27,
      "end_seconds": 244.69,
      "duration_seconds": 1.42,
      "text": "Thanks for that."
