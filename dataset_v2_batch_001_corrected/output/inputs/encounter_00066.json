    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 188.79,
      "end_seconds": 193.27,
      "duration_seconds": 4.48,
      "text": "okay, we'll put it in context in a moment"
