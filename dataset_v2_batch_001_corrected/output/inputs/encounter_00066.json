    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 195.73,
      "end_seconds": 199.1,
      "duration_seconds": 3.37,
      "text": "Okay, I need to examine you for this."
