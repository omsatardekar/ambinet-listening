{
  "schema_version": "1.0",
  "encounter_id": "00161",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.39,
      "end_seconds": 6.5,
      "duration_seconds": 5.11,
      "text": "Good afternoon, doctor, the receptionist said you'd see me now."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.37,
      "end_seconds": 12.42,
      "duration_seconds": 4.05,
      "text": "You're fine, sit down. So, what brings you in?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 13.82,
      "end_seconds": 19.36,
      "duration_seconds": 5.54,
      "text": "Hello, doctor, I came in with them, if that's okay."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 20.48,
      "end_seconds": 24.95,
      "duration_seconds": 4.47,
      "text": "I wanted to get irregular periods looked at."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 26.31,
      "end_seconds": 29.45,
      "duration_seconds": 3.14,
      "text": "How bad is it, would you say?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 30.15,
      "end_seconds": 42.84,
      "duration_seconds": 12.69,
      "text": "Yeah, you know, maybe a five out of ten on a bad day. And there's excess hair on my face as well, two days now."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 43.42,
      "end_seconds": 48.22,
      "duration_seconds": 4.8,
      "text": "What about acne along the jaw, have you noticed that?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 51.16,
      "end_seconds": 52.73,
      "duration_seconds": 1.57,
      "text": "Yes, since Monday."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 54.56,
      "end_seconds": 57.72,
      "duration_seconds": 3.16,
      "text": "Have you had thinning hair on the scalp?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 59.56,
      "end_seconds": 62.77,
      "duration_seconds": 3.21,
      "text": "Yes, about the same, five days."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 63.94,
      "end_seconds": 69.25,
      "duration_seconds": 5.31,
      "text": "A few quick ones: heavy bleeding or milk from the breasts?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 71.19,
      "end_seconds": 73.43,
      "duration_seconds": 2.24,
      "text": "No, none of those."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 74.15,
      "end_seconds": 78.07,
      "duration_seconds": 3.92,
      "text": "And what about trying for a baby or missed period?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 78.9,
      "end_seconds": 80.73,
      "duration_seconds": 1.83,
      "text": "No. None of those."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 82.41,
      "end_seconds": 86.53,
      "duration_seconds": 4.12,
      "text": "Anything with your heart, like skipped beats or fainting?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 90.51,
      "end_seconds": 94.66,
      "duration_seconds": 4.15,
      "text": "My heart's been fine, as far as I know."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 102.71,
      "end_seconds": 105.91,
      "duration_seconds": 3.2,
      "text": "Is there anything medical in your background?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 107.72,
      "end_seconds": 109.56,
      "duration_seconds": 1.84,
      "text": "I've got acid reflux."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 111.03,
      "end_seconds": 111.93,
      "duration_seconds": 0.9,
      "text": "And then?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 113.58,
      "end_seconds": 116.2,
      "duration_seconds": 2.62,
      "text": "Depression, for nearly five years."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 118.05,
      "end_seconds": 126.36,
      "duration_seconds": 8.31,
      "text": "Alright, acid reflux and depression, that matches what I have here. Which tablets or creams or inhalers do you use?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 127.4,
      "end_seconds": 131.57,
      "duration_seconds": 4.17,
      "text": "Pantoprazole. I take it 40 milligrams, before breakfast."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 133.44,
      "end_seconds": 143.67,
      "duration_seconds": 10.23,
      "text": "Doctor, I think the last prescription for the pantoprazole was 20 milligrams. We changed it at the last visit."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 145.5,
      "end_seconds": 148.74,
      "duration_seconds": 3.24,
      "text": "Alright. Did you bring the up-to-date prescription?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 152.39,
      "end_seconds": 160.45,
      "duration_seconds": 8.06,
      "text": "Not with me. I'll bring it next time. Escitalopram, 10 milligrams, once a day."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 161.5,
      "end_seconds": 166.22,
      "duration_seconds": 4.72,
      "text": "Have you ever reacted badly to a medicine or food? Any allergies?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 167.12,
      "end_seconds": 177.06,
      "duration_seconds": 9.94,
      "text": "I think I reacted to some antibiotic once, years ago. I don't remember which one, or what happened exactly."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 178.19,
      "end_seconds": 179.9,
      "duration_seconds": 1.71,
      "text": "And alcohol, how much?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 181.79,
      "end_seconds": 186.24,
      "duration_seconds": 4.45,
      "text": "A beer or two most evenings, to be honest."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 187.89,
      "end_seconds": 190.77,
      "duration_seconds": 2.88,
      "text": "Right, is anyone at home with you?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 192.64,
      "end_seconds": 196.28,
      "duration_seconds": 3.64,
      "text": "I share a flat with two friends."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 197.29,
      "end_seconds": 198.86,
      "duration_seconds": 1.57,
      "text": "What's your diet like?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 199.4,
      "end_seconds": 203.65,
      "duration_seconds": 4.25,
      "text": "I eat out quite a lot, to be honest."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 204.27,
      "end_seconds": 206.38,
      "duration_seconds": 2.11,
      "text": "Do you exercise at all?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 206.96,
      "end_seconds": 212.23,
      "duration_seconds": 5.27,
      "text": "I go to the gym a couple of times a week."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 215.57,
      "end_seconds": 216.74,
      "duration_seconds": 1.17,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 217.9,
      "end_seconds": 221.66,
      "duration_seconds": 3.76,
      "text": "I had a C-section about ten years ago."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 222.57,
      "end_seconds": 226.56,
      "duration_seconds": 3.99,
      "text": "Let's get your blood pressure and the other basics."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 237.12,
      "end_seconds": 238.01,
      "duration_seconds": 0.89,
      "text": "One second..."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 252.22,
      "end_seconds": 263.75,
      "duration_seconds": 11.53,
      "text": "Okay: weight 90 kilos, SpO2 98 percent on room air, heart rate 71. And BMI works out to 32.3, height 167 centimetres, BP is 113 over 82."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 265.58,
      "end_seconds": 266.92,
      "duration_seconds": 1.34,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 267.61,
      "end_seconds": 270.25,
      "duration_seconds": 2.64,
      "text": "I'll explain what that means shortly."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 272.89,
      "end_seconds": 274.93,
      "duration_seconds": 2.04,
      "text": "Shall we do the examination?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 276.31,
      "end_seconds": 278.43,
      "duration_seconds": 2.12,
      "text": "Just relax, I'll be quick."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 291.13,
      "end_seconds": 296.61,
      "duration_seconds": 5.48,
      "text": "Facial acne along the jaw and some dark coarse hair on the chin."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 299.23,
      "end_seconds": 301.77,
      "duration_seconds": 2.54,
      "text": "That's all I need, thank you."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 308.84,
      "end_seconds": 330.2,
      "duration_seconds": 21.36,
      "text": "Okay, thinking it through, it fits best with possible polycystic ovary syndrome. The reason I say that is that your story and my examination fit together. Another possibility is a thyroid problem. Let me just check I've got this right. You've had irregular periods, and no milk from the breasts or missed period."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 331.81,
      "end_seconds": 333.83,
      "duration_seconds": 2.02,
      "text": "That's what happened, yes."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 346.17,
      "end_seconds": 372.69,
      "duration_seconds": 26.52,
      "text": "I'd like to arrange a pelvic ultrasound for irregular periods. I'd like to arrange a thyroid test for irregular periods. That will help us see what's going on underneath and decide the next step. Regular exercise and modest weight loss can bring cycles back. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 373.68,
      "end_seconds": 377.96,
      "duration_seconds": 4.28,
      "text": "Uh, yes, I'll keep that in mind."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 379.23,
      "end_seconds": 391.73,
      "duration_seconds": 12.5,
      "text": "Please don't wait if the symptoms get worse. That's when to be seen urgently. I'll want another look after the results are back. Good. Let us know how you get on."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 395.58,
      "end_seconds": 397.86,
      "duration_seconds": 2.28,
      "text": "Thanks, that was helpful."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 399.31,
      "end_seconds": 400.54,
      "duration_seconds": 1.23,
      "text": "Bye for now."
    }
  ]
}