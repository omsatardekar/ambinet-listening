{
  "schema_version": "1.0",
  "encounter_id": "00241",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.13,
      "end_seconds": 4.26,
      "duration_seconds": 3.13,
      "text": "Okay, welcome. Let's see what's going on."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 6.3,
      "end_seconds": 7.86,
      "duration_seconds": 1.56,
      "text": "Good morning, doctor."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 9.11,
      "end_seconds": 11.88,
      "duration_seconds": 2.77,
      "text": "What made you decide to come in?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 13.18,
      "end_seconds": 20.03,
      "duration_seconds": 6.85,
      "text": "So the thing is, I've got a red swollen area on my leg."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 22.04,
      "end_seconds": 24.79,
      "duration_seconds": 2.75,
      "text": "Since when have you had this?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 25.72,
      "end_seconds": 34.77,
      "duration_seconds": 9.05,
      "text": "It's been going on for about a week. I'm not great at remembering details, so bear with me."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 42.57,
      "end_seconds": 48.67,
      "duration_seconds": 6.1,
      "text": "Have you noticed pus, calf pain, red streaks going up the leg or vomiting?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 49.83,
      "end_seconds": 56.1,
      "duration_seconds": 6.27,
      "text": "No, no pus, calf pain, red streaks going up the leg or vomiting."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 56.63,
      "end_seconds": 59.56,
      "duration_seconds": 2.93,
      "text": "Hm, okay. Anything unusual with passing urine?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 61.15,
      "end_seconds": 63.45,
      "duration_seconds": 2.3,
      "text": "No, that's all fine."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 64.52,
      "end_seconds": 69.23,
      "duration_seconds": 4.71,
      "text": "Do you have any medical conditions I should know about?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 70.84,
      "end_seconds": 74.2,
      "duration_seconds": 3.36,
      "text": "No, none that I know of."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 75.98,
      "end_seconds": 77.24,
      "duration_seconds": 1.26,
      "text": "Any regular medication?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 79.12,
      "end_seconds": 80.25,
      "duration_seconds": 1.13,
      "text": "Nothing, no."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 81.05,
      "end_seconds": 82.25,
      "duration_seconds": 1.2,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 84.22,
      "end_seconds": 85.71,
      "duration_seconds": 1.49,
      "text": "No operations, no."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 87.73,
      "end_seconds": 88.94,
      "duration_seconds": 1.21,
      "text": "And your work?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 90.66,
      "end_seconds": 93.91,
      "duration_seconds": 3.25,
      "text": "I drive a delivery van all day."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 96.18,
      "end_seconds": 98.57,
      "duration_seconds": 2.39,
      "text": "Is anyone at home with you?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 100.49,
      "end_seconds": 104.1,
      "duration_seconds": 3.61,
      "text": "I share a flat with two friends."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 105.58,
      "end_seconds": 107.04,
      "duration_seconds": 1.46,
      "text": "How about exercise?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 108.85,
      "end_seconds": 112.76,
      "duration_seconds": 3.91,
      "text": "Not really, I don't get much exercise."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 114.29,
      "end_seconds": 118.57,
      "duration_seconds": 4.28,
      "text": "Are there any allergies on your record that I should check?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 119.26,
      "end_seconds": 121.87,
      "duration_seconds": 2.61,
      "text": "Not that I know, no."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 123.46,
      "end_seconds": 127.08,
      "duration_seconds": 3.62,
      "text": "Before we go on, a few quick readings."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 133.73,
      "end_seconds": 136.06,
      "duration_seconds": 2.33,
      "text": "Okay, give me a moment..."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 149.64,
      "end_seconds": 161.53,
      "duration_seconds": 11.89,
      "text": "Okay: temp 38.2 degrees, pulse is 105 beats a minute, BP is 123 over 74. And respiratory rate 17, oxygen saturation is 96 percent."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 162.24,
      "end_seconds": 163.94,
      "duration_seconds": 1.7,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 165.13,
      "end_seconds": 169.57,
      "duration_seconds": 4.44,
      "text": "They help build the picture, I'll tell you more soon."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 170.98,
      "end_seconds": 174.27,
      "duration_seconds": 3.29,
      "text": "Come over here and I'll have a look."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 188.79,
      "end_seconds": 189.49,
      "duration_seconds": 0.7,
      "text": "Okay."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 190.92,
      "end_seconds": 193.02,
      "duration_seconds": 2.1,
      "text": "Just relax, I'll be quick."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 209.85,
      "end_seconds": 215.24,
      "duration_seconds": 5.39,
      "text": "There's a small scab where the cut was, no pus coming out."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 216.68,
      "end_seconds": 220.43,
      "duration_seconds": 3.75,
      "text": "A little pressure here, tell me if it's tender."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 233.23,
      "end_seconds": 240.49,
      "duration_seconds": 7.26,
      "text": "The skin on the lower leg is red, warm and swollen, about the size of my palm."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 242.91,
      "end_seconds": 245.37,
      "duration_seconds": 2.46,
      "text": "Thanks, please take a seat again."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 255.05,
      "end_seconds": 263.88,
      "duration_seconds": 8.83,
      "text": "Taking everything into account, I'm honestly not certain yet. It could be cellulitis, or it might be an abscess forming."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 265.88,
      "end_seconds": 268.25,
      "duration_seconds": 2.37,
      "text": "Is it something serious, doctor?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 270.13,
      "end_seconds": 280.8,
      "duration_seconds": 10.67,
      "text": "I understand the worry. At the moment I'd say it's cellulitis, and we'll know more once the a wound swab is back."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 293.63,
      "end_seconds": 302.55,
      "duration_seconds": 8.92,
      "text": "I think a wound swab makes sense here, for infected wound. The result will help us decide whether anything more is needed."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 306.3,
      "end_seconds": 310.82,
      "duration_seconds": 4.52,
      "text": "I can book that for Friday at 3:30 pm."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 312.77,
      "end_seconds": 340.49,
      "duration_seconds": 27.72,
      "text": "I'm sending you for blood tests because of infection. We'll begin with cephalexin, 500 milligrams, four times a day, for seven days. That should help with skin infection. The pharmacy will go through the details again when you pick it up. Mark the edge of the redness with a pen so we can see whether it spreads. Keep the leg raised on a pillow when you're sitting."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 345.39,
      "end_seconds": 361.96,
      "duration_seconds": 16.57,
      "text": "The thing that would worry me is if the redness spreads or the fever gets higher. If that happens, go to emergency. Book a review in two days. Call the clinic if you need us."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 363.6,
      "end_seconds": 366.14,
      "duration_seconds": 2.54,
      "text": "Well, thanks, that was helpful."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 367.11,
      "end_seconds": 367.81,
      "duration_seconds": 0.7,
      "text": "Goodbye."
    }
  ]
}