{
  "schema_version": "1.0",
  "encounter_id": "00060",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.89,
      "end_seconds": 5.65,
      "duration_seconds": 4.76,
      "text": "Yeah, morning. Nice to finally see you, doctor."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.49,
      "end_seconds": 10.54,
      "duration_seconds": 4.05,
      "text": "No trouble at all, come in. What's been bothering you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 11.24,
      "end_seconds": 14.24,
      "duration_seconds": 3.0,
      "text": "Doctor, thank you for seeing us."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 16.3,
      "end_seconds": 20.83,
      "duration_seconds": 4.53,
      "text": "Well, um, I've been having fever and chills."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 22.46,
      "end_seconds": 25.61,
      "duration_seconds": 3.15,
      "text": "How long has this been going on?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 26.73,
      "end_seconds": 28.66,
      "duration_seconds": 1.93,
      "text": "About... well, two weeks."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 30.04,
      "end_seconds": 38.6,
      "duration_seconds": 8.56,
      "text": "Can you describe it a bit more for me? How strong it is, what the pattern is, what helps."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 39.2,
      "end_seconds": 53.98,
      "duration_seconds": 14.78,
      "text": "Honestly, a couple of times a week. Severe, I'd say. I've also had shortness of breath, for five days. As for shortness of breath, only resting, and it's not much."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 54.85,
      "end_seconds": 57.25,
      "duration_seconds": 2.4,
      "text": "Have you been feeling very weak?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 58.32,
      "end_seconds": 61.83,
      "duration_seconds": 3.51,
      "text": "Yeah, I've had that since Friday."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 63.3,
      "end_seconds": 70.1,
      "duration_seconds": 6.8,
      "text": "What about sharp pain on the right side when you breathe in, have you noticed that?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 71.22,
      "end_seconds": 72.77,
      "duration_seconds": 1.55,
      "text": "Yeah, that too."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 73.92,
      "end_seconds": 77.61,
      "duration_seconds": 3.69,
      "text": "Any coughing up blood, palpitations or recent travel?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 78.16,
      "end_seconds": 80.33,
      "duration_seconds": 2.17,
      "text": "No, none of those."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 81.11,
      "end_seconds": 83.66,
      "duration_seconds": 2.55,
      "text": "Did you notice any leg swelling?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 85.68,
      "end_seconds": 87.8,
      "duration_seconds": 2.12,
      "text": "No. No leg swelling."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 89.8,
      "end_seconds": 93.58,
      "duration_seconds": 3.78,
      "text": "On the cardiac side, anything I should know?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 94.95,
      "end_seconds": 97.86,
      "duration_seconds": 2.91,
      "text": "No, nothing with my heart."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 99.84,
      "end_seconds": 105.22,
      "duration_seconds": 5.38,
      "text": "Have you noticed any weakness, or anything odd with your balance?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 108.61,
      "end_seconds": 111.44,
      "duration_seconds": 2.83,
      "text": "Yeah, no, that's all normal."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 113.02,
      "end_seconds": 116.78,
      "duration_seconds": 3.76,
      "text": "Have you had to have anything operated on?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 118.05,
      "end_seconds": 123.25,
      "duration_seconds": 5.2,
      "text": "I had my thyroid operated on a long time ago."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 132.53,
      "end_seconds": 135.1,
      "duration_seconds": 2.57,
      "text": "Any diagnoses you've been given before?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 136.96,
      "end_seconds": 143.96,
      "duration_seconds": 7.0,
      "text": "I have diabetes, for about a year. I have high blood pressure, for two years."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 149.35,
      "end_seconds": 158.75,
      "duration_seconds": 9.4,
      "text": "Alright, high blood pressure, that matches what I have here. Any medication at the moment, including things from the pharmacy?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 159.76,
      "end_seconds": 165.19,
      "duration_seconds": 5.43,
      "text": "She takes ramipril, 5 milligrams, every morning for my blood pressure."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 167.22,
      "end_seconds": 171.98,
      "duration_seconds": 4.76,
      "text": "I used to take telmisartan, but I stopped it."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 173.78,
      "end_seconds": 178.16,
      "duration_seconds": 4.38,
      "text": "Are there any allergies on your record that I should check?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 179.54,
      "end_seconds": 190.86,
      "duration_seconds": 11.32,
      "text": "Hmm, there was some antibiotic, I was told I was allergic. But I couldn't tell you what it was called or what it did."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 202.35,
      "end_seconds": 205.76,
      "duration_seconds": 3.41,
      "text": "A few questions about your lifestyle now."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 207.65,
      "end_seconds": 223.94,
      "duration_seconds": 16.29,
      "text": "I smoke, yes, around five a day. A beer or two most evenings, to be honest. I try to avoid too much sugar. I walk for about half an hour most days."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 225.24,
      "end_seconds": 227.95,
      "duration_seconds": 2.71,
      "text": "A few measurements, then we'll continue."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 236.05,
      "end_seconds": 237.74,
      "duration_seconds": 1.69,
      "text": "Hold still for me..."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 253.19,
      "end_seconds": 269.92,
      "duration_seconds": 16.73,
      "text": "Okay: BP is 139 over 75, heart rate 90. And respiratory rate 22, BMI works out to 17.3, height 180 centimetres, SpO2 91 percent on room air, weight 56 kilos, temp 37.2 degrees."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 272.37,
      "end_seconds": 275.84,
      "duration_seconds": 3.47,
      "text": "Let me examine, it won't take long."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 277.42,
      "end_seconds": 279.63,
      "duration_seconds": 2.21,
      "text": "Let me just check something."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 296.06,
      "end_seconds": 298.58,
      "duration_seconds": 2.52,
      "text": "Breathing rate is a bit fast."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 300.44,
      "end_seconds": 302.01,
      "duration_seconds": 1.57,
      "text": "Let me press here."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 309.9,
      "end_seconds": 314.76,
      "duration_seconds": 4.86,
      "text": "There's bronchial breathing and crackles at the right lower zone."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 317.39,
      "end_seconds": 318.72,
      "duration_seconds": 1.33,
      "text": "Thanks for that."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 330.53,
      "end_seconds": 349.48,
      "duration_seconds": 18.95,
      "text": "Okay, so my impression is this: This looks most like a possible pneumonia on the right side. A pulmonary embolism is still possible. We should do a sputum culture for pneumonia. That will help us see what's going on underneath and decide the next step."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 351.49,
      "end_seconds": 353.05,
      "duration_seconds": 1.56,
      "text": "That sounds sensible."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 354.67,
      "end_seconds": 360.73,
      "duration_seconds": 6.06,
      "text": "We should do blood tests for infection. Let's get a chest X-ray, for suspected pneumonia."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 361.97,
      "end_seconds": 363.89,
      "duration_seconds": 1.92,
      "text": "Is that done here?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 365.14,
      "end_seconds": 392.72,
      "duration_seconds": 27.58,
      "text": "We'll begin with paracetamol, 500 milligrams, every six hours if needed, for three days. It's for fever and body aches. Rest and fluids, and finish every dose of the antibiotic. If you smoke, this is a good moment to think about stopping, and we can help you with that. Do get help quickly if the breathlessness worsens or you become drowsy."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 393.91,
      "end_seconds": 395.59,
      "duration_seconds": 1.68,
      "text": "Okay, I'll remember."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 397.32,
      "end_seconds": 403.15,
      "duration_seconds": 5.83,
      "text": "Book a review in three days. That's everything from me. Any other questions?"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 404.26,
      "end_seconds": 408.08,
      "duration_seconds": 3.82,
      "text": "Okay, so nothing more from me, thanks."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 408.61,
      "end_seconds": 409.94,
      "duration_seconds": 1.33,
      "text": "Safe journey home."
    }
  ]
}