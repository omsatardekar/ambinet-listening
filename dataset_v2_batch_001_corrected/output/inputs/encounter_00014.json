{
  "schema_version": "1.0",
  "encounter_id": "00014",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.9,
      "end_seconds": 7.04,
      "duration_seconds": 6.14,
      "text": "Doctor, hello, I've got my papers here, where should I put them?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.95,
      "end_seconds": 12.34,
      "duration_seconds": 3.39,
      "text": "Yes, do sit. Tell me what's been happening."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 14.39,
      "end_seconds": 23.55,
      "duration_seconds": 9.16,
      "text": "Mainly a dry cough that won't go away. There's a couple of other things, but that's the main one."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 24.77,
      "end_seconds": 27.14,
      "duration_seconds": 2.37,
      "text": "How far back does it go?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 28.58,
      "end_seconds": 32.86,
      "duration_seconds": 4.28,
      "text": "It's been nearly five years, I'm fairly sure."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 34.35,
      "end_seconds": 43.81,
      "duration_seconds": 9.46,
      "text": "Can you describe it a bit more for me? How strong it is, what the pattern is, what helps."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 45.37,
      "end_seconds": 60.08,
      "duration_seconds": 14.71,
      "text": "I notice it more with lying down. I'd say once or twice a day. I've also had a burning in the chest after meals, for three weeks."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 67.49,
      "end_seconds": 70.88,
      "duration_seconds": 3.39,
      "text": "Before we go on, a few quick readings."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 79.25,
      "end_seconds": 80.86,
      "duration_seconds": 1.61,
      "text": "Just relax your arm..."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 95.51,
      "end_seconds": 104.63,
      "duration_seconds": 9.12,
      "text": "Okay: temp 36.8 degrees, respiratory rate 17, heart rate 68, BP is 110 over 76, oxygen saturation is 97 percent."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 105.68,
      "end_seconds": 107.66,
      "duration_seconds": 1.98,
      "text": "Is that alright, doctor?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 108.43,
      "end_seconds": 111.65,
      "duration_seconds": 3.22,
      "text": "Let's look at it together in a minute."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 113.88,
      "end_seconds": 116.79,
      "duration_seconds": 2.91,
      "text": "I'd like to examine you now."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 118.78,
      "end_seconds": 121.51,
      "duration_seconds": 2.73,
      "text": "Stay still while I have a look."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 133.1,
      "end_seconds": 139.52,
      "duration_seconds": 6.42,
      "text": "Chest is clear and the throat looks a little red at the back."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 152.17,
      "end_seconds": 153.14,
      "duration_seconds": 0.97,
      "text": "No problem."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 157.97,
      "end_seconds": 165.53,
      "duration_seconds": 7.56,
      "text": "That's all I need, thank you. Any night sweats, shortness of breath or wheezing at all?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 166.07,
      "end_seconds": 170.64,
      "duration_seconds": 4.57,
      "text": "No, no night sweats, shortness of breath or wheezing."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 171.5,
      "end_seconds": 174.29,
      "duration_seconds": 2.79,
      "text": "Is your urine normal, no changes?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 174.99,
      "end_seconds": 176.46,
      "duration_seconds": 1.47,
      "text": "No changes there."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 179.71,
      "end_seconds": 182.55,
      "duration_seconds": 2.84,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 183.17,
      "end_seconds": 184.82,
      "duration_seconds": 1.65,
      "text": "No operations, no."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 185.66,
      "end_seconds": 189.86,
      "duration_seconds": 4.2,
      "text": "Do you have any medical conditions I should know about?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 191.73,
      "end_seconds": 194.62,
      "duration_seconds": 2.89,
      "text": "No, none that I know of."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 209.11,
      "end_seconds": 212.99,
      "duration_seconds": 3.88,
      "text": "Let's talk a little about your daily life and habits."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 213.81,
      "end_seconds": 225.81,
      "duration_seconds": 12.0,
      "text": "I stopped smoking about two years back. I run a small shop, so I'm on my feet a lot. I share a flat with two friends."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 227.0,
      "end_seconds": 229.66,
      "duration_seconds": 2.66,
      "text": "Are you on any regular medication?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 231.25,
      "end_seconds": 233.07,
      "duration_seconds": 1.82,
      "text": "No, nothing regular."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 234.19,
      "end_seconds": 238.88,
      "duration_seconds": 4.69,
      "text": "Are there any allergies on your record that I should check?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 239.76,
      "end_seconds": 242.22,
      "duration_seconds": 2.46,
      "text": "No, no allergies to anything."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 247.63,
      "end_seconds": 261.87,
      "duration_seconds": 14.24,
      "text": "Let me tell you where I've got to. This looks most like a cough driven by acid reflux. I want to be honest that this is an impression, not a final answer."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 266.86,
      "end_seconds": 270.31,
      "duration_seconds": 3.45,
      "text": "Is this something I'll have for good?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 271.55,
      "end_seconds": 284.91,
      "duration_seconds": 13.36,
      "text": "I understand the worry. At the moment I'd say it's a cough driven by acid reflux, and we'll know more once the a chest X-ray is back."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 295.44,
      "end_seconds": 322.06,
      "duration_seconds": 26.62,
      "text": "Let's book a chest X-ray to look into chronic cough. Let's use pantoprazole, 40 milligrams, before breakfast, for four weeks. You take it by mouth. That should help with reflux. Don't eat for two or three hours before lying down, and raise the head of the bed a little. Book a review in four weeks. Call the clinic if you need us."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 323.16,
      "end_seconds": 325.63,
      "duration_seconds": 2.47,
      "text": "Thank you for your time."
    }
  ]
}