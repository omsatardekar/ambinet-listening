{
  "schema_version": "1.0",
  "encounter_id": "00104",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.0,
      "end_seconds": 4.47,
      "duration_seconds": 3.47,
      "text": "Hello, doctor. It's my turn, I think."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.08,
      "end_seconds": 10.04,
      "duration_seconds": 3.96,
      "text": "You're fine, sit down. So, what brings you in?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 11.61,
      "end_seconds": 15.99,
      "duration_seconds": 4.38,
      "text": "Good morning, doctor. I came along to help out."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 16.69,
      "end_seconds": 21.43,
      "duration_seconds": 4.74,
      "text": "Of course, please stay. It's helpful to have you here."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 23.21,
      "end_seconds": 31.2,
      "duration_seconds": 7.99,
      "text": "Doctor, um, it's been feeling anxious most of the day. That's what we're worried about."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 32.18,
      "end_seconds": 34.27,
      "duration_seconds": 2.09,
      "text": "What's your current medication list?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 34.79,
      "end_seconds": 43.17,
      "duration_seconds": 8.38,
      "text": "He takes escitalopram, 10 milligrams, once a day for the anxiety. It's glimepiride, 2 milligrams, before breakfast, doctor."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 58.91,
      "end_seconds": 61.56,
      "duration_seconds": 2.65,
      "text": "Since when have you had this?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 63.17,
      "end_seconds": 66.72,
      "duration_seconds": 3.55,
      "text": "Right, around three weeks, I think."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 67.29,
      "end_seconds": 71.6,
      "duration_seconds": 4.31,
      "text": "I think it's been nearer a month, actually."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 72.32,
      "end_seconds": 76.39,
      "duration_seconds": 4.07,
      "text": "Okay, so roughly three to four weeks. Is that right?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 79.22,
      "end_seconds": 81.84,
      "duration_seconds": 2.62,
      "text": "I, I suppose so, yes."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 85.52,
      "end_seconds": 88.45,
      "duration_seconds": 2.93,
      "text": "Is it mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 90.07,
      "end_seconds": 91.3,
      "duration_seconds": 1.23,
      "text": "Severe, really."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 93.15,
      "end_seconds": 95.72,
      "duration_seconds": 2.57,
      "text": "Any trouble falling asleep as well?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 97.52,
      "end_seconds": 100.31,
      "duration_seconds": 2.79,
      "text": "Yes, for about three months."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 102.4,
      "end_seconds": 106.56,
      "duration_seconds": 4.16,
      "text": "Any a tight feeling in the chest as well?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 107.44,
      "end_seconds": 113.6,
      "duration_seconds": 6.16,
      "text": "Yes, I have. With tight feeling in the chest, I'd call it severe."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 131.96,
      "end_seconds": 135.21,
      "duration_seconds": 3.25,
      "text": "Have you had any low mood or fainting?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 136.71,
      "end_seconds": 140.72,
      "duration_seconds": 4.01,
      "text": "No low mood or fainting, none of it."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 141.7,
      "end_seconds": 147.86,
      "duration_seconds": 6.16,
      "text": "Have you noticed weight loss, thoughts of harming myself or chest pain on exertion?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 152.02,
      "end_seconds": 159.53,
      "duration_seconds": 7.51,
      "text": "I haven't had weight loss, thoughts of harming myself or chest pain on exertion, no."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 160.16,
      "end_seconds": 163.21,
      "duration_seconds": 3.05,
      "text": "Alright, is your digestion otherwise okay?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 164.53,
      "end_seconds": 167.01,
      "duration_seconds": 2.48,
      "text": "Bowels are regular, nothing odd."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 183.29,
      "end_seconds": 186.17,
      "duration_seconds": 2.88,
      "text": "A few questions about your lifestyle now."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 189.48,
      "end_seconds": 204.46,
      "duration_seconds": 14.98,
      "text": "I have a couple of drinks on the weekend. Yes, I live on my own. I work on a farm, it's quite physical. I play badminton on Sundays."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 205.36,
      "end_seconds": 207.67,
      "duration_seconds": 2.31,
      "text": "Any drug or food allergies?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 208.55,
      "end_seconds": 209.49,
      "duration_seconds": 0.94,
      "text": "No allergies."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 210.22,
      "end_seconds": 214.92,
      "duration_seconds": 4.7,
      "text": "Do you have any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 216.01,
      "end_seconds": 221.58,
      "duration_seconds": 5.57,
      "text": "I have anxiety. I've had diabetes for about ten years now."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 222.97,
      "end_seconds": 232.26,
      "duration_seconds": 9.29,
      "text": "Okay, yes, anxiety is known to us, good to have that clear. A few measurements, then we'll continue."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 241.61,
      "end_seconds": 243.34,
      "duration_seconds": 1.73,
      "text": "Hold still for me..."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 258.57,
      "end_seconds": 266.24,
      "duration_seconds": 7.67,
      "text": "Okay: SpO2 97 percent on room air, blood pressure 117 over 73, temperature 36.8, heart rate 83."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 268.63,
      "end_seconds": 271.2,
      "duration_seconds": 2.57,
      "text": "Let's do the physical part now."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 272.51,
      "end_seconds": 275.64,
      "duration_seconds": 3.13,
      "text": "Stay still while I have a look."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 286.56,
      "end_seconds": 290.19,
      "duration_seconds": 3.63,
      "text": "Pulse is regular and you're breathing comfortably right now."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 295.37,
      "end_seconds": 327.47,
      "duration_seconds": 32.1,
      "text": "All done, you can get dressed. Taking everything into account, I think we're dealing with an anxiety disorder at this stage. A heart rhythm cause is also on my list. I think a thyroid test makes sense here, for anxiety. Slow breathing, in for four and out for six, for a few minutes whenever it builds up. A counsellor would be the right next step, I'll refer you. Book a review in four weeks. Thanks for coming in."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 328.2,
      "end_seconds": 332.26,
      "duration_seconds": 4.06,
      "text": "So, no, you've explained it well. Thanks."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 332.98,
      "end_seconds": 333.9,
      "duration_seconds": 0.92,
      "text": "Take care."
    }
  ]
}