{
  "schema_version": "1.0",
  "encounter_id": "00243",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.86,
      "end_seconds": 4.37,
      "duration_seconds": 3.51,
      "text": "Hello, doctor. It's my turn, I think."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.36,
      "end_seconds": 9.51,
      "duration_seconds": 4.15,
      "text": "You're fine, sit down. So, what brings you in?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 10.08,
      "end_seconds": 18.15,
      "duration_seconds": 8.07,
      "text": "It's breathlessness on the stairs, mostly. A neighbour of mine said I should see someone about it."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 19.05,
      "end_seconds": 21.96,
      "duration_seconds": 2.91,
      "text": "I'll check your pressure and pulse."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 32.79,
      "end_seconds": 34.41,
      "duration_seconds": 1.62,
      "text": "Just relax your arm..."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 48.12,
      "end_seconds": 56.3,
      "duration_seconds": 8.18,
      "text": "Okay: pulse 123, SpO2 96 percent on room air, blood pressure 133 over 81. When did you first notice it?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 58.33,
      "end_seconds": 60.56,
      "duration_seconds": 2.23,
      "text": "About... well, three weeks."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 61.66,
      "end_seconds": 65.71,
      "duration_seconds": 4.05,
      "text": "Is it constant, or does it come and go?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 67.34,
      "end_seconds": 71.51,
      "duration_seconds": 4.17,
      "text": "Honestly, all the time. I've also been feeling tired."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 72.41,
      "end_seconds": 78.21,
      "duration_seconds": 5.8,
      "text": "let me check a few things any blood in the stool or heavy periods?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 79.29,
      "end_seconds": 85.55,
      "duration_seconds": 6.26,
      "text": "No blood in the stool or heavy periods, none of it."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 87.43,
      "end_seconds": 92.83,
      "duration_seconds": 5.4,
      "text": "So, a few quick ones: fainting, chest pain or black stools?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 94.03,
      "end_seconds": 98.04,
      "duration_seconds": 4.01,
      "text": "No, no fainting, chest pain or black stools."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 99.4,
      "end_seconds": 102.97,
      "duration_seconds": 3.57,
      "text": "on the cardiac side, anything I should know?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 103.81,
      "end_seconds": 105.49,
      "duration_seconds": 1.68,
      "text": "nothing like that"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 106.05,
      "end_seconds": 107.32,
      "duration_seconds": 1.27,
      "text": "Any regular medication?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 108.32,
      "end_seconds": 109.5,
      "duration_seconds": 1.18,
      "text": "Nothing, no."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 110.12,
      "end_seconds": 112.09,
      "duration_seconds": 1.97,
      "text": "anything special about your diet?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 113.11,
      "end_seconds": 116.95,
      "duration_seconds": 3.84,
      "text": "I try to avoid too much sugar"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 122.28,
      "end_seconds": 124.29,
      "duration_seconds": 2.01,
      "text": "Who do you live with?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 125.64,
      "end_seconds": 130.94,
      "duration_seconds": 5.3,
      "text": "I live with my family, my husband and two kids."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 132.04,
      "end_seconds": 134.16,
      "duration_seconds": 2.12,
      "text": "are you active at all?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 135.27,
      "end_seconds": 138.08,
      "duration_seconds": 2.81,
      "text": "Barely, I'm mostly sedentary these days"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 139.81,
      "end_seconds": 142.72,
      "duration_seconds": 2.91,
      "text": "Is there anything medical in your background?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 143.35,
      "end_seconds": 146.36,
      "duration_seconds": 3.01,
      "text": "Acid reflux, for about a year"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 147.34,
      "end_seconds": 151.24,
      "duration_seconds": 3.9,
      "text": "so, have you had to have anything operated on?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 153.3,
      "end_seconds": 160.23,
      "duration_seconds": 6.93,
      "text": "I had my gallbladder removed in 2016 i'm hoping you can tell me something definite"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 161.86,
      "end_seconds": 167.6,
      "duration_seconds": 5.74,
      "text": "right, are there any allergies on your record that I should check?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 168.36,
      "end_seconds": 172.06,
      "duration_seconds": 3.7,
      "text": "right, I've never been told I have allergies"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 174.17,
      "end_seconds": 177.09,
      "duration_seconds": 2.92,
      "text": "If you're comfortable, I'll examine you now."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 185.85,
      "end_seconds": 186.55,
      "duration_seconds": 0.7,
      "text": "Okay."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 188.18,
      "end_seconds": 190.32,
      "duration_seconds": 2.14,
      "text": "Let me just check something."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 208.37,
      "end_seconds": 212.87,
      "duration_seconds": 4.5,
      "text": "Heart sounds are normal, I don't hear any murmur."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 213.39,
      "end_seconds": 214.45,
      "duration_seconds": 1.06,
      "text": "Yes, doctor."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 220.17,
      "end_seconds": 222.26,
      "duration_seconds": 2.09,
      "text": "That's fine, sit up."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 234.06,
      "end_seconds": 244.33,
      "duration_seconds": 10.27,
      "text": "So where does that leave us? I think we're dealing with anaemia of some kind at this stage. I can't rule out a thyroid problem yet."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 262.55,
      "end_seconds": 267.88,
      "duration_seconds": 5.33,
      "text": "I want a ferritin level done, that's for possible iron deficiency."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 269.16,
      "end_seconds": 271.49,
      "duration_seconds": 2.33,
      "text": "Does it need any preparation?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 275.33,
      "end_seconds": 280.33,
      "duration_seconds": 5.0,
      "text": "A vitamin B12 level is what I'd like next, for possible deficiency"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 281.81,
      "end_seconds": 285.11,
      "duration_seconds": 3.3,
      "text": "Where do I go for that?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 286.62,
      "end_seconds": 304.75,
      "duration_seconds": 18.13,
      "text": "I'd like you to take ferrous sulfate, 200 milligrams, once a day, for three months. That should help with possible iron deficiency. Iron can darken the stools and bother the stomach, so take it after food. We'll catch up after the results are back."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 306.84,
      "end_seconds": 308.35,
      "duration_seconds": 1.51,
      "text": "sure, that's doable"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 309.35,
      "end_seconds": 312.58,
      "duration_seconds": 3.23,
      "text": "Is there anything you wanted to ask?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 314.53,
      "end_seconds": 316.77,
      "duration_seconds": 2.24,
      "text": "All good here. Thank you."
    }
  ]
}