{
  "schema_version": "1.0",
  "encounter_id": "00353",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.03,
      "end_seconds": 3.27,
      "duration_seconds": 2.24,
      "text": "Hello. Right, let's get started."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "CAREGIVER",
      "start_seconds": 3.81,
      "end_seconds": 7.91,
      "duration_seconds": 4.1,
      "text": "Good morning, doctor. I came along to help out."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 8.76,
      "end_seconds": 15.92,
      "duration_seconds": 7.16,
      "text": "Absolutely, come and sit beside them. What was the main thing you wanted to talk about?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 17.74,
      "end_seconds": 21.1,
      "duration_seconds": 3.36,
      "text": "I've been dealing with fever and chills."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 21.96,
      "end_seconds": 29.88,
      "duration_seconds": 7.92,
      "text": "is this recent, or has it been a while? I'm asking so that we don't miss anything"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 31.28,
      "end_seconds": 38.41,
      "duration_seconds": 7.13,
      "text": "I've had it for one week. I did try to ignore it for a while."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 40.13,
      "end_seconds": 43.38,
      "duration_seconds": 3.25,
      "text": "Does it come along with anything else?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 48.36,
      "end_seconds": 80.95,
      "duration_seconds": 32.59,
      "text": "Sharp pain on the right side when I breathe in goes along with it, most of the time. Um, the Sharp pain on the right side when I breathe in? That's been for about four days. Okay, so as for Sharp pain on the right side when I breathe in, mostly severe. I've had shortness of breath too, for five days"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 91.59,
      "end_seconds": 94.29,
      "duration_seconds": 2.7,
      "text": "A few measurements, then we'll continue."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 105.74,
      "end_seconds": 106.64,
      "duration_seconds": 0.9,
      "text": "Almost there..."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 121.63,
      "end_seconds": 130.38,
      "duration_seconds": 8.75,
      "text": "Okay: oxygen saturation is 94 percent, respiratory rate 26, blood pressure 138 over 85. And heart rate 89."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 131.51,
      "end_seconds": 133.63,
      "duration_seconds": 2.12,
      "text": "is that alright, doctor?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 135.33,
      "end_seconds": 139.73,
      "duration_seconds": 4.4,
      "text": "They help build the picture, I'll tell you more soon."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 142.48,
      "end_seconds": 146.26,
      "duration_seconds": 3.78,
      "text": "Right, let me check a a few things physically."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 153.5,
      "end_seconds": 154.59,
      "duration_seconds": 1.09,
      "text": "yes, doctor"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 155.85,
      "end_seconds": 158.33,
      "duration_seconds": 2.48,
      "text": "Right, bear with me a second."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 169.63,
      "end_seconds": 172.07,
      "duration_seconds": 2.44,
      "text": "Breathing rate is a bit fast."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 177.26,
      "end_seconds": 180.27,
      "duration_seconds": 3.01,
      "text": "Thanks, please take a seat again."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 197.6,
      "end_seconds": 200.66,
      "duration_seconds": 3.06,
      "text": "Have you noticed recent travel or vomiting?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 201.57,
      "end_seconds": 203.78,
      "duration_seconds": 2.21,
      "text": "nothing like that, no"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 205.82,
      "end_seconds": 208.98,
      "duration_seconds": 3.16,
      "text": "A few quick ones: confusion or leg swelling?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 210.26,
      "end_seconds": 214.3,
      "duration_seconds": 4.04,
      "text": "No confusion or leg swelling, none of it."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 215.33,
      "end_seconds": 216.8,
      "duration_seconds": 1.47,
      "text": "Neurologically, anything strange?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 217.6,
      "end_seconds": 219.0,
      "duration_seconds": 1.4,
      "text": "Nothing odd there."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 220.54,
      "end_seconds": 223.41,
      "duration_seconds": 2.87,
      "text": "what medicines do you take regularly?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "CAREGIVER",
      "start_seconds": 224.91,
      "end_seconds": 243.75,
      "duration_seconds": 18.84,
      "text": "He takes Tiotropium inhaler, once a day for my chest. It's metformin, 500 milligrams, twice a day, doctor. He is on Dolo, 650 milligrams, when I get the fever, I give it to him."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 245.22,
      "end_seconds": 250.3,
      "duration_seconds": 5.08,
      "text": "have you ever reacted badly to a medicine or food? Any allergies?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 251.42,
      "end_seconds": 254.24,
      "duration_seconds": 2.82,
      "text": "No, no allergies to anything."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 254.98,
      "end_seconds": 256.15,
      "duration_seconds": 1.17,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 257.19,
      "end_seconds": 259.48,
      "duration_seconds": 2.29,
      "text": "No, nothing like that."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 260.26,
      "end_seconds": 263.49,
      "duration_seconds": 3.23,
      "text": "What kind of work do you do?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 264.65,
      "end_seconds": 268.86,
      "duration_seconds": 4.21,
      "text": "I work on a farm, it's quite physical."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 270.8,
      "end_seconds": 272.05,
      "duration_seconds": 1.25,
      "text": "how's your diet?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 273.28,
      "end_seconds": 274.67,
      "duration_seconds": 1.39,
      "text": "I'm mostly vegetarian."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 275.68,
      "end_seconds": 276.92,
      "duration_seconds": 1.24,
      "text": "how about exercise?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 278.82,
      "end_seconds": 282.87,
      "duration_seconds": 4.05,
      "text": "Not really, I don't get much exercise."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 284.27,
      "end_seconds": 289.41,
      "duration_seconds": 5.14,
      "text": "Do you have any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 291.21,
      "end_seconds": 301.49,
      "duration_seconds": 10.28,
      "text": "I've had COPD for about ten years now. A neighbour of mine said I should see someone about it."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 302.34,
      "end_seconds": 303.04,
      "duration_seconds": 0.7,
      "text": "Sure."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 304.68,
      "end_seconds": 317.68,
      "duration_seconds": 13.0,
      "text": "I have diabetes. It's a relief to finally sit down and talk about it. I'm not great at remembering details, so bear with me."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 318.37,
      "end_seconds": 330.89,
      "duration_seconds": 12.52,
      "text": "Go on. Yes, COPD is known to us, good to have that clear. Putting it all together, this is probably a possible pneumonia on the right side."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 331.91,
      "end_seconds": 334.62,
      "duration_seconds": 2.71,
      "text": "Do you think it's serious?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 336.64,
      "end_seconds": 369.26,
      "duration_seconds": 32.62,
      "text": "It's reasonable to be concerned, but right now a possible pneumonia on the right side is my leading thought, not anything worse. I think a sputum culture makes sense here, for pneumonia. Let's book blood tests to look into infection. Let's book a chest X-ray to look into suspected pneumonia. We'll begin with levofloxacin, 500 milligrams, once a day, for five days. That's for chest infection. Rest and fluids, and finish every dose of the antibiotic."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 370.57,
      "end_seconds": 381.36,
      "duration_seconds": 10.79,
      "text": "Keep an eye out, and if the breathlessness worsens or you become drowsy, call us the same day or go to emergency."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 382.91,
      "end_seconds": 386.24,
      "duration_seconds": 3.33,
      "text": "Alright, I know what to look for."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 386.8,
      "end_seconds": 391.31,
      "duration_seconds": 4.51,
      "text": "Book a review after the X-ray. Thanks for coming in."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 393.0,
      "end_seconds": 395.49,
      "duration_seconds": 2.49,
      "text": "Nothing more from me, thanks."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 396.19,
      "end_seconds": 397.64,
      "duration_seconds": 1.45,
      "text": "Safe journey home."
    }
  ]
}