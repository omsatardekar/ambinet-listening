{
  "schema_version": "1.0",
  "encounter_id": "00302",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.77,
      "end_seconds": 4.42,
      "duration_seconds": 3.65,
      "text": "Hello, doctor. Where would you like me?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 4.98,
      "end_seconds": 10.3,
      "duration_seconds": 5.32,
      "text": "Yes, come in, take a seat. What can I do for you today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 10.92,
      "end_seconds": 19.96,
      "duration_seconds": 9.04,
      "text": "I wanted to get itching in the groin looked at. I didn't want to make a fuss, you know."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 20.69,
      "end_seconds": 23.18,
      "duration_seconds": 2.49,
      "text": "Since when have you had this?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 24.9,
      "end_seconds": 27.42,
      "duration_seconds": 2.52,
      "text": "Ever since... since Monday, really."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 27.99,
      "end_seconds": 37.95,
      "duration_seconds": 9.96,
      "text": "Tell me a bit more about it: how bad it gets, how often, and whether anything makes it better or worse."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 39.83,
      "end_seconds": 43.89,
      "duration_seconds": 4.06,
      "text": "It happens on and off. Moderate, I'd say."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 45.4,
      "end_seconds": 48.62,
      "duration_seconds": 3.22,
      "text": "has there been a ring-shaped itchy patch too?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 50.68,
      "end_seconds": 68.97,
      "duration_seconds": 18.29,
      "text": "yeah. Four weeks, I'd say. About ring-shaped itchy patch, yes, sweating. That makes it worse. I've had darker skin around the patch too, you know, for about a month. About darker skin around the patch, moderate, I'd say"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 77.89,
      "end_seconds": 82.62,
      "duration_seconds": 4.73,
      "text": "Let me check a a few things. Any pain or fever?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 84.54,
      "end_seconds": 87.66,
      "duration_seconds": 3.12,
      "text": "None, as far as I know."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 89.54,
      "end_seconds": 95.6,
      "duration_seconds": 6.06,
      "text": "have you had any rash on the palms or similar rash on the scalp?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 98.88,
      "end_seconds": 105.48,
      "duration_seconds": 6.6,
      "text": "Yeah, no, no rash on the palms or similar rash on the scalp."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 106.96,
      "end_seconds": 111.38,
      "duration_seconds": 4.42,
      "text": "Anything with your heart, like skipped beats or fainting?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 113.81,
      "end_seconds": 116.35,
      "duration_seconds": 2.54,
      "text": "no, nothing with my heart"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 134.51,
      "end_seconds": 136.49,
      "duration_seconds": 1.98,
      "text": "are you active at all?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 137.53,
      "end_seconds": 140.98,
      "duration_seconds": 3.45,
      "text": "Barely, I'm mostly sedentary these days."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 141.69,
      "end_seconds": 143.63,
      "duration_seconds": 1.94,
      "text": "Do you have a job?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 145.49,
      "end_seconds": 147.58,
      "duration_seconds": 2.09,
      "text": "I'm a self-employed electrician"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 152.68,
      "end_seconds": 154.59,
      "duration_seconds": 1.91,
      "text": "do you live alone?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 159.16,
      "end_seconds": 162.14,
      "duration_seconds": 2.98,
      "text": "Yes, I live on my own."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 180.2,
      "end_seconds": 185.1,
      "duration_seconds": 4.9,
      "text": "Any medication at the moment, including things from the pharmacy?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 185.82,
      "end_seconds": 193.84,
      "duration_seconds": 8.02,
      "text": "I'm on metformin, 500 milligrams, twice a day. Sumatriptan. I take it 50 milligrams, when needed."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 195.35,
      "end_seconds": 198.34,
      "duration_seconds": 2.99,
      "text": "Before I prescribe anything, any allergies?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 200.26,
      "end_seconds": 204.79,
      "duration_seconds": 4.53,
      "text": "Ibuprofen. I come out in... well, a rash."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 206.42,
      "end_seconds": 209.24,
      "duration_seconds": 2.82,
      "text": "Any diagnoses you've been given before?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 211.11,
      "end_seconds": 214.82,
      "duration_seconds": 3.71,
      "text": "I have diabetes, for nearly five years."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 215.54,
      "end_seconds": 217.08,
      "duration_seconds": 1.54,
      "text": "Okay, anything else?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 218.52,
      "end_seconds": 222.85,
      "duration_seconds": 4.33,
      "text": "I've had migraines for nearly five years now."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 226.77,
      "end_seconds": 229.9,
      "duration_seconds": 3.13,
      "text": "Go on. Any surgery in your history?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 231.09,
      "end_seconds": 235.25,
      "duration_seconds": 4.16,
      "text": "Just cataract surgery on my right eye, last year."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 237.01,
      "end_seconds": 239.5,
      "duration_seconds": 2.49,
      "text": "Let me measure a few things."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 249.02,
      "end_seconds": 250.77,
      "duration_seconds": 1.75,
      "text": "Just relax your arm..."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 259.79,
      "end_seconds": 268.69,
      "duration_seconds": 8.9,
      "text": "Okay: temperature is 36.6 degrees, blood pressure 118 over 68, heart rate 86. And oxygen saturation is 99 percent."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 270.17,
      "end_seconds": 271.53,
      "duration_seconds": 1.36,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 273.26,
      "end_seconds": 277.08,
      "duration_seconds": 3.82,
      "text": "we'll put it in context in a moment"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 279.41,
      "end_seconds": 282.86,
      "duration_seconds": 3.45,
      "text": "Okay, I need to examine you for this."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 284.39,
      "end_seconds": 285.09,
      "duration_seconds": 0.7,
      "text": "Alright."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 287.07,
      "end_seconds": 288.72,
      "duration_seconds": 1.65,
      "text": "Let me press here."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 300.91,
      "end_seconds": 304.57,
      "duration_seconds": 3.66,
      "text": "Skin between the toes is white and peeling."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 306.43,
      "end_seconds": 309.13,
      "duration_seconds": 2.7,
      "text": "Let me look at this properly."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 317.4,
      "end_seconds": 323.09,
      "duration_seconds": 5.69,
      "text": "There's a red ring-shaped scaly patch with a clearer centre in the groin crease."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 326.64,
      "end_seconds": 345.85,
      "duration_seconds": 19.21,
      "text": "thanks, please take a seat again. Having listened and examined, it points towards a fungal skin infection. A skin scraping is what I'd like next, for suspected fungal infection. I'll start you on fluconazole, 150 milligrams, once a week, for two weeks. It's for fungal infection"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 346.62,
      "end_seconds": 347.66,
      "duration_seconds": 1.04,
      "text": "Right, understood."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 348.28,
      "end_seconds": 365.91,
      "duration_seconds": 17.63,
      "text": "Keep the area dry, wear loose cotton, and don't share towels. Please take the tablets with food so they don't upset your stomach. If the symptoms get worse, that's the point to come in urgently. Book a review in three weeks."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 366.54,
      "end_seconds": 368.74,
      "duration_seconds": 2.2,
      "text": "Okay, see you then."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 369.96,
      "end_seconds": 372.06,
      "duration_seconds": 2.1,
      "text": "Alright, I'll see you out."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 373.67,
      "end_seconds": 377.54,
      "duration_seconds": 3.87,
      "text": "One thing: no, actually that's all. Thanks."
    }
  ]
}