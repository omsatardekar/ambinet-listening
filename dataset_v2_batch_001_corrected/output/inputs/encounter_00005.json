{
  "schema_version": "1.0",
  "encounter_id": "00005",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.01,
      "end_seconds": 5.99,
      "duration_seconds": 4.98,
      "text": "sorry I'm a few minutes behind, you know, doctor"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.36,
      "end_seconds": 12.99,
      "duration_seconds": 5.63,
      "text": "Yes, come in, take a seat. What can I do for you today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 14.98,
      "end_seconds": 18.95,
      "duration_seconds": 3.97,
      "text": "Thank you for fitting us in, doctor."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 19.87,
      "end_seconds": 26.77,
      "duration_seconds": 6.9,
      "text": "Right, mainly I've been forgetting things lately. That's why I came."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 32.19,
      "end_seconds": 37.12,
      "duration_seconds": 4.93,
      "text": "So, any medication at the moment, including things from the pharmacy?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 38.04,
      "end_seconds": 43.06,
      "duration_seconds": 5.02,
      "text": "it's, It's amlodipine, 5 milligrams, maybe, once a day"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 44.18,
      "end_seconds": 48.93,
      "duration_seconds": 4.75,
      "text": "Have you got the box or the prescription on you?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 49.51,
      "end_seconds": 54.0,
      "duration_seconds": 4.49,
      "text": "well, not with me i'll bring it next time"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 71.16,
      "end_seconds": 73.58,
      "duration_seconds": 2.42,
      "text": "roughly when did it start?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 74.68,
      "end_seconds": 81.26,
      "duration_seconds": 6.58,
      "text": "I'd say two weeks. Actually, um, no, closer to four weeks."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 82.48,
      "end_seconds": 85.24,
      "duration_seconds": 2.76,
      "text": "does it come along with anything else?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 86.74,
      "end_seconds": 90.53,
      "duration_seconds": 3.79,
      "text": "It usually comes with difficulty finding words."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 91.96,
      "end_seconds": 95.13,
      "duration_seconds": 3.17,
      "text": "have you been repeating the same questions?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 96.97,
      "end_seconds": 106.01,
      "duration_seconds": 9.04,
      "text": "yes, I have and I've been getting lost on familiar roads as well, for two months"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 107.03,
      "end_seconds": 112.09,
      "duration_seconds": 5.06,
      "text": "have you noticed weakness on one side, falls, low mood or headache?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 113.65,
      "end_seconds": 115.95,
      "duration_seconds": 2.3,
      "text": "nothing like that, no"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 117.1,
      "end_seconds": 119.4,
      "duration_seconds": 2.3,
      "text": "has your skin been okay?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 120.67,
      "end_seconds": 121.8,
      "duration_seconds": 1.13,
      "text": "No rashes."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 122.33,
      "end_seconds": 125.15,
      "duration_seconds": 2.82,
      "text": "Have you had any surgery before?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 127.24,
      "end_seconds": 133.1,
      "duration_seconds": 5.86,
      "text": "Yes, I had a lump removed from my back, years ago."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 147.15,
      "end_seconds": 153.89,
      "duration_seconds": 6.74,
      "text": "Any allergies I should know about? I ask because it helps me narrow things down."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 154.52,
      "end_seconds": 165.33,
      "duration_seconds": 10.81,
      "text": "I think I reacted to some antibiotic once, years ago. I don't remember which one, or what happened exactly"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 173.5,
      "end_seconds": 177.3,
      "duration_seconds": 3.8,
      "text": "Moving on to your background, any past medical history?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 178.2,
      "end_seconds": 179.98,
      "duration_seconds": 1.78,
      "text": "I have diabetes."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 181.82,
      "end_seconds": 183.88,
      "duration_seconds": 2.06,
      "text": "Okay, and what else?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 185.87,
      "end_seconds": 188.45,
      "duration_seconds": 2.58,
      "text": "I have high blood pressure."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 189.74,
      "end_seconds": 197.48,
      "duration_seconds": 7.74,
      "text": "alright, diabetes, that that matches what I have here okay, now some background about your lifestyle"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 198.83,
      "end_seconds": 213.21,
      "duration_seconds": 14.38,
      "text": "Barely, I'm mostly sedentary these days. I eat out quite a lot, to be honest. I work on a farm, it's quite physical."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 213.73,
      "end_seconds": 216.63,
      "duration_seconds": 2.9,
      "text": "Okay, I'll check your pressure and pulse."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 228.99,
      "end_seconds": 230.9,
      "duration_seconds": 1.91,
      "text": "Rest your hand here..."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 243.49,
      "end_seconds": 249.74,
      "duration_seconds": 6.25,
      "text": "Okay: saturation 99 percent, pulse 75. And pressure 120 over 74, temp 36.6 degrees."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 251.52,
      "end_seconds": 252.98,
      "duration_seconds": 1.46,
      "text": "is that okay?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 254.39,
      "end_seconds": 258.62,
      "duration_seconds": 4.23,
      "text": "don't worry, I'll go through it in a moment"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 259.77,
      "end_seconds": 262.12,
      "duration_seconds": 2.35,
      "text": "I'd like to examine you now."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 264.0,
      "end_seconds": 264.7,
      "duration_seconds": 0.7,
      "text": "Okay."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 265.81,
      "end_seconds": 268.39,
      "duration_seconds": 2.58,
      "text": "take your time, no rush"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 280.94,
      "end_seconds": 286.02,
      "duration_seconds": 5.08,
      "text": "your gait is steady and the tone in your limbs is normal"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 289.07,
      "end_seconds": 305.41,
      "duration_seconds": 16.34,
      "text": "That's fine, sit up. Right, here's what I'm thinking. This looks most like memory difficulties that need to be worked up. That's my thinking for now, and it may change as we learn more. Another possibility is early dementia."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 307.07,
      "end_seconds": 310.51,
      "duration_seconds": 3.44,
      "text": "Should I be worried about this?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 312.51,
      "end_seconds": 326.7,
      "duration_seconds": 14.19,
      "text": "I can't promise yet, but most people with memory difficulties that need to be worked up do well once it's treated properly. Have you had any tests for this so so far?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 330.2,
      "end_seconds": 338.51,
      "duration_seconds": 8.31,
      "text": "I did have a thyroid test done a few months ago, but the paper's at home."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 340.6,
      "end_seconds": 346.11,
      "duration_seconds": 5.51,
      "text": "I want a CT scan of the head done, that's for memory loss"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 347.46,
      "end_seconds": 351.03,
      "duration_seconds": 3.57,
      "text": "so, alright, when would that be?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 352.04,
      "end_seconds": 381.36,
      "duration_seconds": 29.32,
      "text": "I'm sending you for blood tests because of memory loss. Keep a daily routine and write things down, a notebook by the door works well. I'll also refer you to the memory clinic. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose. Do get help quickly if the symptoms get worse."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 386.29,
      "end_seconds": 387.3,
      "duration_seconds": 1.01,
      "text": "that's clear"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 388.86,
      "end_seconds": 394.31,
      "duration_seconds": 5.45,
      "text": "See me again in four weeks. Call the clinic if you need us."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 396.37,
      "end_seconds": 400.13,
      "duration_seconds": 3.76,
      "text": "Yeah, uh, thanks so much, doctor."
    }
  ]
}