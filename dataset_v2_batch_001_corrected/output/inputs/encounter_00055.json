{
  "schema_version": "1.0",
  "encounter_id": "00055",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.3,
      "end_seconds": 7.78,
      "duration_seconds": 6.48,
      "text": "Okay, so good afternoon, doctor, the receptionist said you'd see me now."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 9.16,
      "end_seconds": 13.08,
      "duration_seconds": 3.92,
      "text": "Not at all, please sit. What's the problem?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 13.96,
      "end_seconds": 25.53,
      "duration_seconds": 11.57,
      "text": "Um, so... dark marks after they heal. That's why I came. My sister suggested writing things down, but I forgot."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 27.05,
      "end_seconds": 30.6,
      "duration_seconds": 3.55,
      "text": "Let's go through your medication. What are you taking?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 31.8,
      "end_seconds": 42.39,
      "duration_seconds": 10.59,
      "text": "I'm on omeprazole, 20 milligrams, once a day for the reflux. It's face wash, twice a day."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 47.11,
      "end_seconds": 49.83,
      "duration_seconds": 2.72,
      "text": "How long have you been on it?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 50.45,
      "end_seconds": 52.44,
      "duration_seconds": 1.99,
      "text": "For nearly five years."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 61.62,
      "end_seconds": 63.59,
      "duration_seconds": 1.97,
      "text": "When did it begin?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 64.53,
      "end_seconds": 67.09,
      "duration_seconds": 2.56,
      "text": "About... well, about a month."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 67.94,
      "end_seconds": 71.06,
      "duration_seconds": 3.12,
      "text": "Anything that tends to go along with it?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 71.69,
      "end_seconds": 86.05,
      "duration_seconds": 14.36,
      "text": "Painful lumps on the chin goes along with it, most of the time. Flare-ups before my period was there, but it's gone away on its own."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 87.95,
      "end_seconds": 90.16,
      "duration_seconds": 2.21,
      "text": "Did you notice any fever?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 90.67,
      "end_seconds": 92.4,
      "duration_seconds": 1.73,
      "text": "Definitely no fever."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 94.25,
      "end_seconds": 100.03,
      "duration_seconds": 5.78,
      "text": "Have you had any excess hair growth, new face cream, irregular periods or pregnancy?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 101.11,
      "end_seconds": 102.94,
      "duration_seconds": 1.83,
      "text": "No, nothing there."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 103.21,
      "end_seconds": 108.38,
      "duration_seconds": 5.17,
      "text": "Understood. Alright, what about your tummy and bowels, anything unusual there?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 109.66,
      "end_seconds": 112.86,
      "duration_seconds": 3.2,
      "text": "Well, no, that side's been fine."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 114.78,
      "end_seconds": 116.8,
      "duration_seconds": 2.02,
      "text": "Is your mobility otherwise okay?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 118.4,
      "end_seconds": 120.22,
      "duration_seconds": 1.82,
      "text": "No, nothing there."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 120.74,
      "end_seconds": 125.38,
      "duration_seconds": 4.64,
      "text": "Do you have any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 125.97,
      "end_seconds": 129.89,
      "duration_seconds": 3.92,
      "text": "I've had acid reflux for two years now."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 131.85,
      "end_seconds": 139.66,
      "duration_seconds": 7.81,
      "text": "Yes, acid reflux is known to us, good to have that clear. Does anything run in the family?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 141.0,
      "end_seconds": 145.57,
      "duration_seconds": 4.57,
      "text": "Right, uh, my uncle had colon cancer."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 155.32,
      "end_seconds": 163.1,
      "duration_seconds": 7.78,
      "text": "Do you have any allergies to medicines, food, anything at all? It helps to be thorough at this stage."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 163.76,
      "end_seconds": 167.67,
      "duration_seconds": 3.91,
      "text": "I've never been told I have allergies."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 169.1,
      "end_seconds": 171.3,
      "duration_seconds": 2.2,
      "text": "Do you have a job?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 172.53,
      "end_seconds": 174.49,
      "duration_seconds": 1.96,
      "text": "I'm a self-employed electrician."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 179.31,
      "end_seconds": 182.15,
      "duration_seconds": 2.84,
      "text": "Okay, anything special about your diet?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 184.24,
      "end_seconds": 188.08,
      "duration_seconds": 3.84,
      "text": "I try to avoid too much sugar."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 189.69,
      "end_seconds": 192.02,
      "duration_seconds": 2.33,
      "text": "Let me check your vitals now."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 204.49,
      "end_seconds": 206.22,
      "duration_seconds": 1.73,
      "text": "Just relax your arm..."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 226.15,
      "end_seconds": 236.75,
      "duration_seconds": 10.6,
      "text": "Okay: blood pressure 119 over 80, SpO2 98 percent on room air, pulse 64, weight 62 kilos, temperature 36.9, height 161 centimetres."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 238.4,
      "end_seconds": 239.96,
      "duration_seconds": 1.56,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 241.38,
      "end_seconds": 245.46,
      "duration_seconds": 4.08,
      "text": "Don't worry, I'll go through it in a moment."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 247.36,
      "end_seconds": 250.2,
      "duration_seconds": 2.84,
      "text": "Let's do the physical part now."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 251.8,
      "end_seconds": 253.82,
      "duration_seconds": 2.02,
      "text": "Hold that position for me."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 263.03,
      "end_seconds": 269.7,
      "duration_seconds": 6.67,
      "text": "There are red papules and a few pustules over the cheeks and chin, with some blackheads."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 275.4,
      "end_seconds": 276.72,
      "duration_seconds": 1.32,
      "text": "Thanks for that."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 287.36,
      "end_seconds": 296.94,
      "duration_seconds": 9.58,
      "text": "Having listened and examined, I think we're dealing with moderate acne at this stage. I'd also keep a hormonal cause in mind."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 298.12,
      "end_seconds": 302.3,
      "duration_seconds": 4.18,
      "text": "Is this something I'll have for good?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 303.72,
      "end_seconds": 333.81,
      "duration_seconds": 30.09,
      "text": "I understand the worry. At the moment I'd say it's moderate acne, and we'll watch how it goes. For this, adapalene gel, at night, for eight weeks. That should help with acne. It takes six to eight weeks to see the difference, so please don't give up in the first fortnight. If the symptoms get worse, or you feel really unwell, please come to the emergency department."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 335.05,
      "end_seconds": 336.86,
      "duration_seconds": 1.81,
      "text": "Okay, I understand."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 337.96,
      "end_seconds": 339.35,
      "duration_seconds": 1.39,
      "text": "Any last questions?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 340.02,
      "end_seconds": 342.68,
      "duration_seconds": 2.66,
      "text": "Alright, thanks. Bye for now."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 343.36,
      "end_seconds": 344.06,
      "duration_seconds": 0.7,
      "text": "Goodbye."
    }
  ]
}