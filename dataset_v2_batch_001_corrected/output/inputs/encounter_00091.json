{
  "schema_version": "1.0",
  "encounter_id": "00091",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.01,
      "end_seconds": 4.09,
      "duration_seconds": 3.08,
      "text": "Good evening. Sorry to keep you waiting."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 6.11,
      "end_seconds": 7.85,
      "duration_seconds": 1.74,
      "text": "Good morning, doctor."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 9.57,
      "end_seconds": 13.0,
      "duration_seconds": 3.43,
      "text": "Alright, tell me what's been troubling you."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 15.04,
      "end_seconds": 23.45,
      "duration_seconds": 8.41,
      "text": "So, you know, honestly, it's fever with chills, and my family pushed me to come."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 24.83,
      "end_seconds": 27.8,
      "duration_seconds": 2.97,
      "text": "so, how far back does it go?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 28.83,
      "end_seconds": 32.5,
      "duration_seconds": 3.67,
      "text": "It's been five days, I'm fairly sure."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 33.54,
      "end_seconds": 42.56,
      "duration_seconds": 9.02,
      "text": "Tell me a bit more about it: how bad it gets, how often, and whether anything makes it better or worse."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 43.69,
      "end_seconds": 49.19,
      "duration_seconds": 5.5,
      "text": "Paracetamol helps a bit. Moderate, I'd say. There's nausea as well"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 50.45,
      "end_seconds": 53.93,
      "duration_seconds": 3.48,
      "text": "what's the pattern, is it there all day?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 54.95,
      "end_seconds": 57.86,
      "duration_seconds": 2.91,
      "text": "Honestly, once or twice a day."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 59.91,
      "end_seconds": 61.09,
      "duration_seconds": 1.18,
      "text": "Nothing like vomiting?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 61.61,
      "end_seconds": 63.38,
      "duration_seconds": 1.77,
      "text": "No, no vomiting."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 64.31,
      "end_seconds": 68.11,
      "duration_seconds": 3.8,
      "text": "Did you get cough, diarrhoea, rash or stiff neck?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 69.92,
      "end_seconds": 74.14,
      "duration_seconds": 4.22,
      "text": "no, no cough, diarrhoea, rash or stiff neck"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 76.08,
      "end_seconds": 79.49,
      "duration_seconds": 3.41,
      "text": "How about your heart, any problems like that?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 80.64,
      "end_seconds": 82.16,
      "duration_seconds": 1.52,
      "text": "Nothing like that."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 83.82,
      "end_seconds": 86.17,
      "duration_seconds": 2.35,
      "text": "Is your mobility otherwise okay?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 88.24,
      "end_seconds": 90.05,
      "duration_seconds": 1.81,
      "text": "I move fine otherwise."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 101.5,
      "end_seconds": 109.37,
      "duration_seconds": 7.87,
      "text": "what about allergies, to medicines or foods or anything else? Just so I get the full picture"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 111.02,
      "end_seconds": 113.65,
      "duration_seconds": 2.63,
      "text": "Not that I know, no."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 115.71,
      "end_seconds": 119.82,
      "duration_seconds": 4.11,
      "text": "okay, what medicines are you taking at the moment?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 120.48,
      "end_seconds": 124.0,
      "duration_seconds": 3.52,
      "text": "I'm on atorvastatin, 20 milligrams, at night."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 125.53,
      "end_seconds": 129.59,
      "duration_seconds": 4.06,
      "text": "Let's talk a little about your daily life and habits."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 130.71,
      "end_seconds": 146.6,
      "duration_seconds": 15.89,
      "text": "No, I don't smoke and never have. I try to avoid too much sugar. I live with my family, my husband and two kids. I work in an office, mostly sitting at a desk."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 147.27,
      "end_seconds": 151.21,
      "duration_seconds": 3.94,
      "text": "Anyone in the family with similar problems or other conditions?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 152.51,
      "end_seconds": 154.83,
      "duration_seconds": 2.32,
      "text": "my sister has thyroid problems"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 168.35,
      "end_seconds": 170.76,
      "duration_seconds": 2.41,
      "text": "have you had any surgery before?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 171.82,
      "end_seconds": 176.72,
      "duration_seconds": 4.9,
      "text": "I had my thyroid operated on a long time ago."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 178.08,
      "end_seconds": 180.59,
      "duration_seconds": 2.51,
      "text": "Have you got any chronic problems?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 181.55,
      "end_seconds": 186.18,
      "duration_seconds": 4.63,
      "text": "I have high cholesterol, for about a year."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 187.18,
      "end_seconds": 196.62,
      "duration_seconds": 9.44,
      "text": "right, so high cholesterol is already on your record. We'll keep that in mind today. Let's get your blood pressure and the other basics"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 207.61,
      "end_seconds": 209.27,
      "duration_seconds": 1.66,
      "text": "just relax your arm.."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 218.72,
      "end_seconds": 226.32,
      "duration_seconds": 7.6,
      "text": "Okay: temperature 38.9, blood pressure 124 over 69, pulse 97, saturation 98 percent, respiratory rate 21."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 227.31,
      "end_seconds": 229.26,
      "duration_seconds": 1.95,
      "text": "Is that alright, doctor?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 230.53,
      "end_seconds": 233.5,
      "duration_seconds": 2.97,
      "text": "So, that's fine, we'll come to it."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 235.06,
      "end_seconds": 238.43,
      "duration_seconds": 3.37,
      "text": "okay, I need to examine you for this"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 247.27,
      "end_seconds": 249.32,
      "duration_seconds": 2.05,
      "text": "Mm, you know, okay."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 251.26,
      "end_seconds": 253.34,
      "duration_seconds": 2.08,
      "text": "Just relax, I'll be quick."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 272.03,
      "end_seconds": 275.85,
      "duration_seconds": 3.82,
      "text": "Your spleen tip is just palpable under the ribs."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 277.78,
      "end_seconds": 282.28,
      "duration_seconds": 4.5,
      "text": "a little pressure here, tell me if it's tender"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 290.21,
      "end_seconds": 294.68,
      "duration_seconds": 4.47,
      "text": "No rash anywhere on your body that I can see"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 299.76,
      "end_seconds": 307.56,
      "duration_seconds": 7.8,
      "text": "Thanks, please take a seat again. Okay, thinking it through, I'd lean towards malaria until proven otherwise."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 308.58,
      "end_seconds": 312.2,
      "duration_seconds": 3.62,
      "text": "Is this something I'll have for good?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 312.78,
      "end_seconds": 334.22,
      "duration_seconds": 21.44,
      "text": "I understand the worry at the moment I'd say it's malaria until proven otherwise, and we'll know more once the a dengue test is back we should do a dengue test for fever the result will help us decide whether anything more is needed"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 334.91,
      "end_seconds": 337.53,
      "duration_seconds": 2.62,
      "text": "The earliest is Friday, 10 am."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 339.31,
      "end_seconds": 351.1,
      "duration_seconds": 11.79,
      "text": "We should do a malaria test for fever after travel. I'd rather check than guess, and this is the quickest way to know more."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 357.21,
      "end_seconds": 358.45,
      "duration_seconds": 1.24,
      "text": "Okay, noted."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 360.24,
      "end_seconds": 385.33,
      "duration_seconds": 25.09,
      "text": "What I'm giving you is paracetamol, 500 milligrams, every six hours if needed, for three days. You take it by mouth. That's for fever and body aches. Let the lab know you travelled recently, that's important for the tests. Let's hold off on blood tests for now, and if there's no change in a month we can revisit it."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 390.47,
      "end_seconds": 404.34,
      "duration_seconds": 13.87,
      "text": "keep an eye out, and if you get confused, very drowsy, or the shaking returns, call us the same day or go to emergency book a review after the results are back"
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 405.02,
      "end_seconds": 405.72,
      "duration_seconds": 0.7,
      "text": "okay"
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 406.55,
      "end_seconds": 409.67,
      "duration_seconds": 3.12,
      "text": "That's it on my side. Anything unclear?"
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 411.23,
      "end_seconds": 413.16,
      "duration_seconds": 1.93,
      "text": "no questions thank you"
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 414.22,
      "end_seconds": 416.19,
      "duration_seconds": 1.97,
      "text": "mind how you go"
    }
  ]
}