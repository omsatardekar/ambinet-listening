{
  "schema_version": "1.0",
  "encounter_id": "00500",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 0.58,
      "end_seconds": 5.64,
      "duration_seconds": 5.06,
      "text": "doctor, if you're free, we can start i've got the numbers noted down"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.38,
      "end_seconds": 11.06,
      "duration_seconds": 4.68,
      "text": "thank you. Good morning, tell me what's been going on"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 11.72,
      "end_seconds": 16.9,
      "duration_seconds": 5.18,
      "text": "I'm here because of pain in my right shoulder."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 18.06,
      "end_seconds": 20.09,
      "duration_seconds": 2.03,
      "text": "Roughly when did it start?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 21.49,
      "end_seconds": 34.53,
      "duration_seconds": 13.04,
      "text": "so, honestly I can't say exactly when it started it might have been last month or the month before, I really can't pin it down"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 37.71,
      "end_seconds": 46.63,
      "duration_seconds": 8.92,
      "text": "Can you describe it a a bit more for me? How strong it is, what the pattern is, what helps."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 47.82,
      "end_seconds": 53.44,
      "duration_seconds": 5.62,
      "text": "Lifting my arm definitely sets it off. Mild, I'd say."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 59.39,
      "end_seconds": 64.34,
      "duration_seconds": 4.95,
      "text": "right, have you had a dull ache down the arm?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 65.97,
      "end_seconds": 67.7,
      "duration_seconds": 1.73,
      "text": "yes, I have"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 68.34,
      "end_seconds": 76.83,
      "duration_seconds": 8.49,
      "text": "can you describe it a bit more for me? How strong it is, what the pattern is, what helps"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 78.57,
      "end_seconds": 84.42,
      "duration_seconds": 5.85,
      "text": "I'd say a few times a day. I'd call it it mild."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 85.93,
      "end_seconds": 88.8,
      "duration_seconds": 2.87,
      "text": "Any trouble lifting your arm as well?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 92.54,
      "end_seconds": 95.05,
      "duration_seconds": 2.51,
      "text": "Yes, since this morning."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 105.23,
      "end_seconds": 109.2,
      "duration_seconds": 3.97,
      "text": "have you noticed chest pain, fever or neck pain?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 111.03,
      "end_seconds": 116.98,
      "duration_seconds": 5.95,
      "text": "I haven't had chest pain, fever or neck pain, no."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 118.57,
      "end_seconds": 121.16,
      "duration_seconds": 2.59,
      "text": "Okay, anything unusual with passing urine?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 121.98,
      "end_seconds": 125.58,
      "duration_seconds": 3.6,
      "text": "That's normal as far as I know."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 130.89,
      "end_seconds": 134.92,
      "duration_seconds": 4.03,
      "text": "let's talk a little about your daily life and habits"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 135.57,
      "end_seconds": 154.67,
      "duration_seconds": 19.1,
      "text": "I don't drink at all. I used to smoke but I quit five years ago. I work in an office, mostly sitting at a desk. I share a flat with two friends. I'm mostly vegetarian"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 160.02,
      "end_seconds": 161.42,
      "duration_seconds": 1.4,
      "text": "any previous surgeries?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 162.61,
      "end_seconds": 167.68,
      "duration_seconds": 5.07,
      "text": "Yeah, I had a knee arthroscopy three years ago."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 170.31,
      "end_seconds": 174.07,
      "duration_seconds": 3.76,
      "text": "Is there a a family history of anything significant?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 176.06,
      "end_seconds": 181.55,
      "duration_seconds": 5.49,
      "text": "my uncle had colon cancer. My father had a heart attack"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 197.68,
      "end_seconds": 200.23,
      "duration_seconds": 2.55,
      "text": "have you got any chronic problems?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 201.73,
      "end_seconds": 203.85,
      "duration_seconds": 2.12,
      "text": "Diabetes, for two years"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 205.62,
      "end_seconds": 212.11,
      "duration_seconds": 6.49,
      "text": "Right, so diabetes is already on your record. We'll keep that that in mind today."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 227.02,
      "end_seconds": 232.28,
      "duration_seconds": 5.26,
      "text": "any medication at the moment including things from the the pharmacy?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 233.07,
      "end_seconds": 240.42,
      "duration_seconds": 7.35,
      "text": "Glimepiride. I take it 2 milligrams before breakfast. It's paracetamol 500 milligrams when needed"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 241.49,
      "end_seconds": 246.92,
      "duration_seconds": 5.43,
      "text": "Doctor, our chart from the last visit lists it as 1000 milligrams."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 248.59,
      "end_seconds": 252.21,
      "duration_seconds": 3.62,
      "text": "Hm. Do you have the latest prescription with you?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 252.79,
      "end_seconds": 261.68,
      "duration_seconds": 8.89,
      "text": "Not with me. I'll bring it next time. I, I was on metformin before. I stopped taking it."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 263.11,
      "end_seconds": 266.65,
      "duration_seconds": 3.54,
      "text": "Do you have any known allergies at all?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 269.47,
      "end_seconds": 274.73,
      "duration_seconds": 5.26,
      "text": "uh, I've never been told I have allergies"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 275.56,
      "end_seconds": 289.36,
      "duration_seconds": 13.8,
      "text": "Okay, so the vitals from earlier. BMI works out to to 33.3, blood pressure 108 over 79, temperature 36.4, pulse is 85 beats a minute, weight 95 kilos, height 169 centimetres, saturation 97 percent."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 294.25,
      "end_seconds": 295.3,
      "duration_seconds": 1.05,
      "text": "Okay, noted."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 296.31,
      "end_seconds": 299.37,
      "duration_seconds": 3.06,
      "text": "let me have a look at you"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 300.29,
      "end_seconds": 301.27,
      "duration_seconds": 0.98,
      "text": "Go ahead."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 303.19,
      "end_seconds": 307.21,
      "duration_seconds": 4.02,
      "text": "Okay a little pressure here tell me if it's tender."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 325.47,
      "end_seconds": 332.57,
      "duration_seconds": 7.1,
      "text": "lifting the arm to the side is painful between sixty and a hundred twenty degrees"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 333.39,
      "end_seconds": 337.67,
      "duration_seconds": 4.28,
      "text": "okay, a little pressure here, tell me if it's tender"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 346.21,
      "end_seconds": 349.8,
      "duration_seconds": 3.59,
      "text": "Neck movements are full and don't reproduce it it"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 351.33,
      "end_seconds": 353.2,
      "duration_seconds": 1.87,
      "text": "yes uh doctor"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 355.83,
      "end_seconds": 368.39,
      "duration_seconds": 12.56,
      "text": "That's fine, sit up. Okay, thinking it through, I think we're dealing with a rotator cuff problem at this stage. I can't rule out a pinched nerve in the neck yet."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 371.98,
      "end_seconds": 375.29,
      "duration_seconds": 3.31,
      "text": "should I be worried about this?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 376.8,
      "end_seconds": 399.47,
      "duration_seconds": 22.67,
      "text": "it's reasonable to be concerned, but right now a rotator cuff problem is my leading thought, not anything worse we should do an X-ray of the shoulder for shoulder pain and please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose come back in four weeks"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 400.96,
      "end_seconds": 403.6,
      "duration_seconds": 2.64,
      "text": "Good, I'll come back then."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 404.54,
      "end_seconds": 407.8,
      "duration_seconds": 3.26,
      "text": "call the clinic if you need us"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 408.56,
      "end_seconds": 413.63,
      "duration_seconds": 5.07,
      "text": "no, I think that's everything thank you, doctor"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 414.74,
      "end_seconds": 416.32,
      "duration_seconds": 1.58,
      "text": "So all the best."
    }
  ]
}