{
  "schema_version": "1.0",
  "encounter_id": "00026",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.56,
      "end_seconds": 3.71,
      "duration_seconds": 3.15,
      "text": "Okay, welcome. Let's see what's going on."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 5.59,
      "end_seconds": 6.29,
      "duration_seconds": 0.7,
      "text": "Morning."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 7.74,
      "end_seconds": 11.03,
      "duration_seconds": 3.29,
      "text": "Thank you for fitting us in, doctor."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 12.26,
      "end_seconds": 13.98,
      "duration_seconds": 1.72,
      "text": "Right, what's the trouble?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 15.66,
      "end_seconds": 21.39,
      "duration_seconds": 5.73,
      "text": "Doctor, it's headaches in the evening. That's what we're worried about."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 22.95,
      "end_seconds": 25.8,
      "duration_seconds": 2.85,
      "text": "When did you first notice it?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 28.17,
      "end_seconds": 31.92,
      "duration_seconds": 3.75,
      "text": "It's been about four days, I'm fairly sure."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 32.63,
      "end_seconds": 35.22,
      "duration_seconds": 2.59,
      "text": "So, how intense does it get?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 36.02,
      "end_seconds": 37.58,
      "duration_seconds": 1.56,
      "text": "It's severe, honestly."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 39.06,
      "end_seconds": 42.97,
      "duration_seconds": 3.91,
      "text": "Okay, does it come along with anything else?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 44.87,
      "end_seconds": 52.31,
      "duration_seconds": 7.44,
      "text": "Trouble switching off at night goes along with it, most of the time."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 56.82,
      "end_seconds": 61.09,
      "duration_seconds": 4.27,
      "text": "Has there been a knot in your stomach too?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 62.36,
      "end_seconds": 64.1,
      "duration_seconds": 1.74,
      "text": "Yes, I have."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 64.93,
      "end_seconds": 70.97,
      "duration_seconds": 6.04,
      "text": "Have you had headaches in the evening before, or is this the first time?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 72.47,
      "end_seconds": 81.41,
      "duration_seconds": 8.94,
      "text": "Yes, um, something like this happened about six months ago, and it went away on its own."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_4",
      "role": "UNKNOWN",
      "start_seconds": 82.9,
      "end_seconds": 86.27,
      "duration_seconds": 3.37,
      "text": "Yes, that's right, that's how it was."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 87.17,
      "end_seconds": 90.41,
      "duration_seconds": 3.24,
      "text": "Have you noticed chest pain or weight loss?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 91.78,
      "end_seconds": 95.37,
      "duration_seconds": 3.59,
      "text": "No, no chest pain or weight loss."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 97.26,
      "end_seconds": 101.81,
      "duration_seconds": 4.55,
      "text": "Any alcohol use, thoughts of harming myself or fainting?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 102.82,
      "end_seconds": 104.54,
      "duration_seconds": 1.72,
      "text": "No, nothing there."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 105.65,
      "end_seconds": 107.88,
      "duration_seconds": 2.23,
      "text": "Any sign of panic attacks?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 109.17,
      "end_seconds": 113.03,
      "duration_seconds": 3.86,
      "text": "No, I haven't had any panic attacks."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 113.59,
      "end_seconds": 116.09,
      "duration_seconds": 2.5,
      "text": "Is your urine normal, no changes?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 116.83,
      "end_seconds": 118.44,
      "duration_seconds": 1.61,
      "text": "No changes there."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 119.35,
      "end_seconds": 121.49,
      "duration_seconds": 2.14,
      "text": "Has your skin been okay?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 123.08,
      "end_seconds": 125.51,
      "duration_seconds": 2.43,
      "text": "Nothing on the skin, no."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 126.05,
      "end_seconds": 127.36,
      "duration_seconds": 1.31,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 128.15,
      "end_seconds": 133.24,
      "duration_seconds": 5.09,
      "text": "Yes, I had my appendix out, about eight years ago."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 134.39,
      "end_seconds": 137.06,
      "duration_seconds": 2.67,
      "text": "Any diagnoses you've been given before?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 137.77,
      "end_seconds": 144.15,
      "duration_seconds": 6.38,
      "text": "Well, I've had anxiety for about a year now. Yes, acid reflux."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 145.68,
      "end_seconds": 151.89,
      "duration_seconds": 6.21,
      "text": "Okay, I can see acid reflux in your file as well. What about alcohol?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 152.48,
      "end_seconds": 156.23,
      "duration_seconds": 3.75,
      "text": "I gave up drinking about three years ago."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 157.11,
      "end_seconds": 159.12,
      "duration_seconds": 2.01,
      "text": "Anything special about your diet?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 160.66,
      "end_seconds": 164.35,
      "duration_seconds": 3.69,
      "text": "I try to avoid too much sugar."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 166.29,
      "end_seconds": 169.75,
      "duration_seconds": 3.46,
      "text": "Do you have any known allergies at all?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 171.63,
      "end_seconds": 174.95,
      "duration_seconds": 3.32,
      "text": "No allergies that I know of, no."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 176.23,
      "end_seconds": 178.95,
      "duration_seconds": 2.72,
      "text": "Does anything run in the family?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 180.83,
      "end_seconds": 182.81,
      "duration_seconds": 1.98,
      "text": "My sister has epilepsy."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 194.14,
      "end_seconds": 198.21,
      "duration_seconds": 4.07,
      "text": "Right, are you on any tablets or medication?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 202.19,
      "end_seconds": 206.74,
      "duration_seconds": 4.55,
      "text": "Escitalopram. I take it once a day for the anxiety."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 207.7,
      "end_seconds": 209.81,
      "duration_seconds": 2.11,
      "text": "Do you know the dose?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 210.62,
      "end_seconds": 212.16,
      "duration_seconds": 1.54,
      "text": "It's 10 milligrams."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 213.39,
      "end_seconds": 215.86,
      "duration_seconds": 2.47,
      "text": "Roughly how long on that one?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 217.35,
      "end_seconds": 231.65,
      "duration_seconds": 14.3,
      "text": "About two years. Pantoprazole, 40 milligrams, before breakfast for my acidity. Paracetamol. I take it 500 milligrams, when needed. I had omeprazole at one point, but I'm off it now."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_5",
      "role": "NURSE",
      "start_seconds": 233.63,
      "end_seconds": 243.41,
      "duration_seconds": 9.78,
      "text": "Here are the numbers, doctor. Pulse 65, BP is 113 over 82. SpO2 98 percent on room air, temperature is 36.4 degrees."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 244.51,
      "end_seconds": 256.9,
      "duration_seconds": 12.39,
      "text": "Thanks. Putting together what you've described, it points towards stress-related symptoms. I'd also keep an anxiety disorder in mind. Another possibility is a depressive episode."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 258.59,
      "end_seconds": 263.57,
      "duration_seconds": 4.98,
      "text": "Oh, um, what are the chances it's something bad?"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 264.07,
      "end_seconds": 285.63,
      "duration_seconds": 21.56,
      "text": "Nothing I've seen today points to an emergency. It looks like stress-related symptoms, but I'd like to confirm. Let me just check I've got this right. You've had headaches in the evening for about four days, severe, and no panic attacks or weight loss."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 287.39,
      "end_seconds": 289.02,
      "duration_seconds": 1.63,
      "text": "Mm, that's right."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 307.58,
      "end_seconds": 311.79,
      "duration_seconds": 4.21,
      "text": "I think blood tests makes sense here, for stress-related symptoms."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_6",
      "role": "CLINICAL_STAFF",
      "start_seconds": 313.61,
      "end_seconds": 317.11,
      "duration_seconds": 3.5,
      "text": "I can book that for Thursday at 10 am."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 318.99,
      "end_seconds": 321.46,
      "duration_seconds": 2.47,
      "text": "So, okay, I'll be there."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 322.15,
      "end_seconds": 343.33,
      "duration_seconds": 21.18,
      "text": "Talking to someone, even a counsellor, helps more than people expect. Block out proper breaks in the day, and one evening a week that's yours. Please take the tablets with food so they don't upset your stomach. I'll also refer you to a counsellor."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 345.06,
      "end_seconds": 347.54,
      "duration_seconds": 2.48,
      "text": "Sure, where do I go?"
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 349.58,
      "end_seconds": 362.08,
      "duration_seconds": 12.5,
      "text": "Please don't wait if the symptoms get worse. That's when to be seen urgently. Please come and see me in a month. That's everything from me. Any other questions?"
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 362.75,
      "end_seconds": 365.15,
      "duration_seconds": 2.4,
      "text": "Nothing more from me, thanks."
    }
  ]
}