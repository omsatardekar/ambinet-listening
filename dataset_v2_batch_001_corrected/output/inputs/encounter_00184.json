{
  "schema_version": "1.0",
  "encounter_id": "00184",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.08,
      "end_seconds": 5.41,
      "duration_seconds": 4.33,
      "text": "Doctor? Hi. I hope I've got the right time."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.22,
      "end_seconds": 11.5,
      "duration_seconds": 5.28,
      "text": "Of course, put it down anywhere. So, how can I help?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 13.41,
      "end_seconds": 18.94,
      "duration_seconds": 5.53,
      "text": "Hello, doctor. I hope it's alright if I stay in for this."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 19.9,
      "end_seconds": 22.77,
      "duration_seconds": 2.87,
      "text": "Please do. Extra information is always welcome."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 24.37,
      "end_seconds": 28.34,
      "duration_seconds": 3.97,
      "text": "She's been having been wanting to stop smoking, doctor."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 29.92,
      "end_seconds": 36.82,
      "duration_seconds": 6.9,
      "text": "I've also been getting out of breath quicker than before, for six months."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 37.63,
      "end_seconds": 40.17,
      "duration_seconds": 2.54,
      "text": "Is it mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 40.71,
      "end_seconds": 41.77,
      "duration_seconds": 1.06,
      "text": "Moderate, really."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 47.14,
      "end_seconds": 49.98,
      "duration_seconds": 2.84,
      "text": "Is it worse with anything in particular?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 50.84,
      "end_seconds": 54.59,
      "duration_seconds": 3.75,
      "text": "Yes, uh, stairs. That makes it worse."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 56.32,
      "end_seconds": 59.54,
      "duration_seconds": 3.22,
      "text": "Any low mood or alcohol problems at all?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 61.33,
      "end_seconds": 64.64,
      "duration_seconds": 3.31,
      "text": "I mean, nothing like that, no."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 66.74,
      "end_seconds": 70.29,
      "duration_seconds": 3.55,
      "text": "And coughing up blood, any of that?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 71.24,
      "end_seconds": 75.67,
      "duration_seconds": 4.43,
      "text": "So, not at all, no coughing up blood."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 77.23,
      "end_seconds": 81.05,
      "duration_seconds": 3.82,
      "text": "On the cardiac side, anything I should know?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 82.84,
      "end_seconds": 84.5,
      "duration_seconds": 1.66,
      "text": "Nothing like that."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 85.97,
      "end_seconds": 88.79,
      "duration_seconds": 2.82,
      "text": "And your skin, any changes there?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 89.97,
      "end_seconds": 90.95,
      "duration_seconds": 0.98,
      "text": "No rashes."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 104.63,
      "end_seconds": 109.46,
      "duration_seconds": 4.83,
      "text": "Tell me about your health in general, any ongoing conditions?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 110.4,
      "end_seconds": 120.51,
      "duration_seconds": 10.11,
      "text": "I have high blood pressure, for five years. I told myself I'd wait and see, and here I am."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 121.12,
      "end_seconds": 127.95,
      "duration_seconds": 6.83,
      "text": "Right, so high blood pressure is already on your record. We'll keep that in mind today."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 140.51,
      "end_seconds": 142.91,
      "duration_seconds": 2.4,
      "text": "Do you have a job?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 144.14,
      "end_seconds": 145.95,
      "duration_seconds": 1.81,
      "text": "I'm a self-employed electrician."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 147.2,
      "end_seconds": 148.76,
      "duration_seconds": 1.56,
      "text": "Do you live alone?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 149.32,
      "end_seconds": 152.72,
      "duration_seconds": 3.4,
      "text": "Yes, I live on my own."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 154.51,
      "end_seconds": 157.35,
      "duration_seconds": 2.84,
      "text": "And what do you usually eat?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 158.76,
      "end_seconds": 161.66,
      "duration_seconds": 2.9,
      "text": "Mostly home-cooked food, rice and vegetables."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 163.39,
      "end_seconds": 166.22,
      "duration_seconds": 2.83,
      "text": "What medicines do you take regularly?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 168.55,
      "end_seconds": 170.79,
      "duration_seconds": 2.24,
      "text": "Amlodipine, once a day."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 171.46,
      "end_seconds": 173.98,
      "duration_seconds": 2.52,
      "text": "So, do you know the dose?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 175.26,
      "end_seconds": 176.71,
      "duration_seconds": 1.45,
      "text": "It's 5 milligrams."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 182.81,
      "end_seconds": 185.69,
      "duration_seconds": 2.88,
      "text": "How long have you been on it?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 187.59,
      "end_seconds": 189.26,
      "duration_seconds": 1.67,
      "text": "About two years."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 190.0,
      "end_seconds": 191.44,
      "duration_seconds": 1.44,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 192.94,
      "end_seconds": 196.0,
      "duration_seconds": 3.06,
      "text": "Well, no, nothing like that."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 207.32,
      "end_seconds": 212.71,
      "duration_seconds": 5.39,
      "text": "Have you ever reacted badly to a medicine or food? Any allergies?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 214.5,
      "end_seconds": 217.85,
      "duration_seconds": 3.35,
      "text": "Yes, shellfish, it gives me vomiting."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 219.54,
      "end_seconds": 221.2,
      "duration_seconds": 1.66,
      "text": "Let's do your observations."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 230.52,
      "end_seconds": 232.43,
      "duration_seconds": 1.91,
      "text": "Hold still for me..."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 245.29,
      "end_seconds": 250.77,
      "duration_seconds": 5.48,
      "text": "Okay: heart rate 72, temperature is 36.8 degrees, pressure 111 over 69."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 251.8,
      "end_seconds": 253.2,
      "duration_seconds": 1.4,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 253.8,
      "end_seconds": 256.85,
      "duration_seconds": 3.05,
      "text": "I'll interpret it once I've examined you."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 258.16,
      "end_seconds": 260.51,
      "duration_seconds": 2.35,
      "text": "Let's do the physical part now."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 262.42,
      "end_seconds": 265.56,
      "duration_seconds": 3.14,
      "text": "Stay still while I have a look."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 278.64,
      "end_seconds": 283.69,
      "duration_seconds": 5.05,
      "text": "Chest sounds clear, a bit of wheeze when you breathe out hard."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 289.16,
      "end_seconds": 299.39,
      "duration_seconds": 10.23,
      "text": "Thanks, please take a seat again. Taking everything into account, I can't pin this down yet. We're looking at nicotine dependence or early chronic bronchitis."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 299.98,
      "end_seconds": 302.25,
      "duration_seconds": 2.27,
      "text": "Do you think it's serious?"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 303.17,
      "end_seconds": 319.62,
      "duration_seconds": 16.45,
      "text": "Nothing I've seen today points to an emergency. It looks like nicotine dependence. The treatment will be nicotine patches, 14 milligrams, once a day, for six weeks. It's for smoking cessation. Book a review in four weeks."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 321.54,
      "end_seconds": 325.57,
      "duration_seconds": 4.03,
      "text": "Alright, I'll put it in my diary."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 327.27,
      "end_seconds": 330.41,
      "duration_seconds": 3.14,
      "text": "That's it on my side. Anything unclear?"
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 331.24,
      "end_seconds": 333.36,
      "duration_seconds": 2.12,
      "text": "Thanks so much, doctor."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 335.1,
      "end_seconds": 337.68,
      "duration_seconds": 2.58,
      "text": "Okay, mind how you go."
    }
  ]
}