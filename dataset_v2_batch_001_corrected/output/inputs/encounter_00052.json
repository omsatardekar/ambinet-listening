{
  "schema_version": "1.0",
  "encounter_id": "00052",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 0.75,
      "end_seconds": 6.35,
      "duration_seconds": 5.6,
      "text": "all set here, doctor chart's updated, and I'll read the readings out when you're ready"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.05,
      "end_seconds": 12.46,
      "duration_seconds": 5.41,
      "text": "great. Hello, come in and sit down. How can I help?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 14.56,
      "end_seconds": 22.0,
      "duration_seconds": 7.44,
      "text": "Doctor, uh, I've come along cos I know the history, if it helps."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 26.98,
      "end_seconds": 30.35,
      "duration_seconds": 3.37,
      "text": "Please do. Extra information is always welcome."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 31.1,
      "end_seconds": 37.85,
      "duration_seconds": 6.75,
      "text": "yeah, it's pain in my right ankle i don't know what's causing it"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 39.09,
      "end_seconds": 41.29,
      "duration_seconds": 2.2,
      "text": "and when did that start?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 43.19,
      "end_seconds": 47.43,
      "duration_seconds": 4.24,
      "text": "About about a month, give or take."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 49.39,
      "end_seconds": 55.36,
      "duration_seconds": 5.97,
      "text": "Yeah, uh, hm, I'd say more like about two months."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 56.81,
      "end_seconds": 61.72,
      "duration_seconds": 4.91,
      "text": "Okay, so roughly one to two months. Is that right?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 62.36,
      "end_seconds": 65.29,
      "duration_seconds": 2.93,
      "text": "That That sounds about right."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 66.05,
      "end_seconds": 69.31,
      "duration_seconds": 3.26,
      "text": "What's the pattern, is it there all day?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 70.56,
      "end_seconds": 74.02,
      "duration_seconds": 3.46,
      "text": "I'd say once or twice a day."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 74.79,
      "end_seconds": 84.13,
      "duration_seconds": 9.34,
      "text": "Uh, uh, I was just going to say that that the main thing is—"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 84.23,
      "end_seconds": 90.52,
      "duration_seconds": 6.29,
      "text": "Sorry to cut in, doctor, quick question: shall I bring the trolley in now or later?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 91.63,
      "end_seconds": 93.88,
      "duration_seconds": 2.25,
      "text": "Later, thanks. Please go on."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 96.78,
      "end_seconds": 99.3,
      "duration_seconds": 2.52,
      "text": "And difficulty walking, too."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 104.67,
      "end_seconds": 114.05,
      "duration_seconds": 9.38,
      "text": "doctor, I've got the readings for you temp 36.7 degrees, pulse is 81 beats a minute bP is 110 over 68, saturation 97 percent"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 115.96,
      "end_seconds": 122.79,
      "duration_seconds": 6.83,
      "text": "Good, thank you. Any numbness, pain at the back of the heel or fever at all?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 124.86,
      "end_seconds": 142.2,
      "duration_seconds": 17.34,
      "text": "No, uh, no numbness, no pain at the back of the heel, no fever. I did have bruising at one point, but that went away on its own."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 143.74,
      "end_seconds": 148.93,
      "duration_seconds": 5.19,
      "text": "Any pain in the knee or pop or crack at all?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 150.78,
      "end_seconds": 158.1,
      "duration_seconds": 7.32,
      "text": "Um, no pain in the knee or pop or crack, none of it."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 158.67,
      "end_seconds": 160.12,
      "duration_seconds": 1.45,
      "text": "Neurologically, anything strange?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 160.87,
      "end_seconds": 164.54,
      "duration_seconds": 3.67,
      "text": "no, um, that's all normal"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 165.38,
      "end_seconds": 174.71,
      "duration_seconds": 9.33,
      "text": "Do you have any allergies to medicines, food, anything at all? I'm asking so that we don't miss anything."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 175.32,
      "end_seconds": 178.98,
      "duration_seconds": 3.66,
      "text": "Right, none, as far as I'm aware."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 180.59,
      "end_seconds": 182.72,
      "duration_seconds": 2.13,
      "text": "Any operations in the past?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 184.58,
      "end_seconds": 195.63,
      "duration_seconds": 11.05,
      "text": "I had my thyroid operated on a long time ago. I took the morning off to come in today."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 197.63,
      "end_seconds": 200.42,
      "duration_seconds": 2.79,
      "text": "any diagnoses you've been given before?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 202.21,
      "end_seconds": 207.81,
      "duration_seconds": 5.6,
      "text": "I've had anxiety, yes. Heart failure, for about a year."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 208.55,
      "end_seconds": 210.11,
      "duration_seconds": 1.56,
      "text": "Right, any more?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 211.25,
      "end_seconds": 220.83,
      "duration_seconds": 9.58,
      "text": "I've had high blood pressure, yes. A neighbour of mine said I should see someone about it."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 225.61,
      "end_seconds": 235.26,
      "duration_seconds": 9.65,
      "text": "Right, yes, anxiety is known to us, good to have that clear. Anyone in the family with similar problems or other conditions?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 236.75,
      "end_seconds": 240.82,
      "duration_seconds": 4.07,
      "text": "My father was diabetic. My mother has migraines."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 242.11,
      "end_seconds": 245.87,
      "duration_seconds": 3.76,
      "text": "What medicines are you taking at the moment?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 246.98,
      "end_seconds": 256.86,
      "duration_seconds": 9.88,
      "text": "Hmm, it's a... um, I can't remember what it's called. It's a small white one."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 263.1,
      "end_seconds": 265.89,
      "duration_seconds": 2.79,
      "text": "do you remember what it's for?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 266.89,
      "end_seconds": 288.67,
      "duration_seconds": 21.78,
      "text": "Uh, uh, for the fluid, I believe. My wife sets them out for me, I just take what I'm given. Ramipril. I take it 5 milligrams, every morning for my blood pressure. Volini spray, a few times a day."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 303.02,
      "end_seconds": 305.92,
      "duration_seconds": 2.9,
      "text": "so, are you working or retired?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 306.75,
      "end_seconds": 310.76,
      "duration_seconds": 4.01,
      "text": "Retired. I stopped a few years back."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 314.98,
      "end_seconds": 317.47,
      "duration_seconds": 2.49,
      "text": "And what do you usually eat?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 318.18,
      "end_seconds": 321.47,
      "duration_seconds": 3.29,
      "text": "Mostly home-cooked food, rice and vegetables"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 330.56,
      "end_seconds": 346.55,
      "duration_seconds": 15.99,
      "text": "Listening to the whole story, this is probably an ankle sprain. The reason I say that is that the way you describe it it fits together. I can't rule out a small fracture yet. Another possibility is a ligament tear."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 347.97,
      "end_seconds": 350.62,
      "duration_seconds": 2.65,
      "text": "Do you think it's serious?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 351.69,
      "end_seconds": 362.82,
      "duration_seconds": 11.13,
      "text": "I understand the worry. At the moment I'd say it's an ankle sprain, and we'll know more once the an X-ray of the ankle is back"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 364.37,
      "end_seconds": 369.68,
      "duration_seconds": 5.31,
      "text": "I've already done an X-ray of the ankle, it's ready for you."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 371.47,
      "end_seconds": 393.38,
      "duration_seconds": 21.91,
      "text": "perfect. I'll start you on paracetamol, 650 milligrams, three times a day, for three days. That's for ankle pain. Rest, ice for twenty minutes at a time, a compression bandage and keep the foot up. If the symptoms get worse, or you feel really unwell, please come to the emergency department"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 394.13,
      "end_seconds": 396.72,
      "duration_seconds": 2.59,
      "text": "okay, uh, I'll remember"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 398.0,
      "end_seconds": 402.84,
      "duration_seconds": 4.84,
      "text": "See me again in ten days. Do you have any questions?"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 403.8,
      "end_seconds": 406.59,
      "duration_seconds": 2.79,
      "text": "oh, thanks, that was helpful"
    }
  ]
}