{
  "schema_version": "1.0",
  "encounter_id": "00063",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.4,
      "end_seconds": 8.38,
      "duration_seconds": 6.98,
      "text": "Hi doctor, sorry, the lift was out and I had to take the stairs."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 10.36,
      "end_seconds": 14.24,
      "duration_seconds": 3.88,
      "text": "Right on time. Sit, please. How can I help?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 15.6,
      "end_seconds": 21.27,
      "duration_seconds": 5.67,
      "text": "It's a dry cough. I thought I'd wait, but it hasn't gone."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 21.84,
      "end_seconds": 25.4,
      "duration_seconds": 3.56,
      "text": "Okay, since when have you had this?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 29.17,
      "end_seconds": 32.51,
      "duration_seconds": 3.34,
      "text": "It's been two weeks, I'm fairly sure."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 33.61,
      "end_seconds": 43.01,
      "duration_seconds": 9.4,
      "text": "Tell me a bit more about it: how bad it gets, how often, and whether anything makes it better or worse."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 44.93,
      "end_seconds": 58.15,
      "duration_seconds": 13.22,
      "text": "It just comes and goes. Maybe a seven out of ten on a bad day. I've had aching all over too, for four weeks."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 59.37,
      "end_seconds": 64.71,
      "duration_seconds": 5.34,
      "text": "What about a low fever a few days ago, have you noticed that?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 66.27,
      "end_seconds": 68.87,
      "duration_seconds": 2.6,
      "text": "Yes, for about three months."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 73.16,
      "end_seconds": 77.24,
      "duration_seconds": 4.08,
      "text": "Right, does it happen all the time or in spells?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 79.15,
      "end_seconds": 82.76,
      "duration_seconds": 3.61,
      "text": "I'd say a few times a day."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 85.6,
      "end_seconds": 91.57,
      "duration_seconds": 5.97,
      "text": "Alright, have you had a dry cough before, or is this the first time?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 92.22,
      "end_seconds": 98.46,
      "duration_seconds": 6.24,
      "text": "A bit, a couple of years ago. It settled by itself back then."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 100.13,
      "end_seconds": 104.52,
      "duration_seconds": 4.39,
      "text": "What about allergies, to medicines or foods or anything else?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 105.68,
      "end_seconds": 108.65,
      "duration_seconds": 2.97,
      "text": "Oh, no, nothing I'm aware of."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 111.77,
      "end_seconds": 114.92,
      "duration_seconds": 3.15,
      "text": "Is there a family history of anything significant?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 116.4,
      "end_seconds": 118.91,
      "duration_seconds": 2.51,
      "text": "My uncle had colon cancer."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 136.83,
      "end_seconds": 139.06,
      "duration_seconds": 2.23,
      "text": "What's your current medication list?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 140.13,
      "end_seconds": 148.13,
      "duration_seconds": 8.0,
      "text": "Pantoprazole, 40 milligrams, before breakfast for my acidity. I'm on ibuprofen, when it hurts."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 149.74,
      "end_seconds": 151.96,
      "duration_seconds": 2.22,
      "text": "How much do you take?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 156.78,
      "end_seconds": 161.89,
      "duration_seconds": 5.11,
      "text": "400 milligrams, I think that's what's on the box."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 162.71,
      "end_seconds": 166.97,
      "duration_seconds": 4.26,
      "text": "Let's talk a little about your daily life and habits."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 168.44,
      "end_seconds": 179.76,
      "duration_seconds": 11.32,
      "text": "I cycle to work most mornings. I teach at a primary school. It's just me and my wife at home now."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 181.02,
      "end_seconds": 182.62,
      "duration_seconds": 1.6,
      "text": "Any procedures or operations?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 183.53,
      "end_seconds": 187.29,
      "duration_seconds": 3.76,
      "text": "Just a knee arthroscopy, three years ago."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 188.38,
      "end_seconds": 191.81,
      "duration_seconds": 3.43,
      "text": "Any long-term health problems I should know about?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 193.23,
      "end_seconds": 195.92,
      "duration_seconds": 2.69,
      "text": "Acid reflux, for five years."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 200.11,
      "end_seconds": 200.81,
      "duration_seconds": 0.7,
      "text": "Yes?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 217.42,
      "end_seconds": 223.52,
      "duration_seconds": 6.1,
      "text": "Did you get injury to the chest, leg swelling or breathlessness at rest?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 224.17,
      "end_seconds": 226.84,
      "duration_seconds": 2.67,
      "text": "Yeah, nothing like that, no."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 227.54,
      "end_seconds": 230.17,
      "duration_seconds": 2.63,
      "text": "Any sign of coughing up blood?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 234.48,
      "end_seconds": 238.32,
      "duration_seconds": 3.84,
      "text": "Nope, uh, no coughing up blood."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 239.09,
      "end_seconds": 241.54,
      "duration_seconds": 2.45,
      "text": "Any rashes or skin problems otherwise?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 245.43,
      "end_seconds": 246.4,
      "duration_seconds": 0.97,
      "text": "No rashes."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 247.42,
      "end_seconds": 251.88,
      "duration_seconds": 4.46,
      "text": "Right, any change in your bowel habit or your stomach generally?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 253.53,
      "end_seconds": 255.03,
      "duration_seconds": 1.5,
      "text": "Nothing unusual, no."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 256.37,
      "end_seconds": 259.19,
      "duration_seconds": 2.82,
      "text": "I'll check your pressure and pulse."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 266.8,
      "end_seconds": 267.78,
      "duration_seconds": 0.98,
      "text": "Almost there..."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 289.19,
      "end_seconds": 299.48,
      "duration_seconds": 10.29,
      "text": "Okay: oxygen saturation is 97 percent, pulse is 75 beats a minute, temp 36.5 degrees, pressure 113 over 82, respiratory rate 14."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 300.23,
      "end_seconds": 301.76,
      "duration_seconds": 1.53,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 302.54,
      "end_seconds": 304.97,
      "duration_seconds": 2.43,
      "text": "I'll explain what that means shortly."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 306.63,
      "end_seconds": 309.05,
      "duration_seconds": 2.42,
      "text": "Shall we do the examination?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 324.67,
      "end_seconds": 325.37,
      "duration_seconds": 0.7,
      "text": "Sure."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 326.45,
      "end_seconds": 328.59,
      "duration_seconds": 2.14,
      "text": "Tell me if anything hurts."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 336.31,
      "end_seconds": 341.04,
      "duration_seconds": 4.73,
      "text": "I can hear a faint rub on the left side."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 347.02,
      "end_seconds": 370.05,
      "duration_seconds": 23.03,
      "text": "Okay, you can sit up. So where does that leave us? It's hard to say. Viral pleurisy is one possibility and a chest infection another, and I'd rather not commit yet. Regular pain relief makes it easier to take deep breaths, which protects the lung. Come back after the X-ray."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 371.84,
      "end_seconds": 375.1,
      "duration_seconds": 3.26,
      "text": "Okay, you know, I'll book that."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 376.09,
      "end_seconds": 379.14,
      "duration_seconds": 3.05,
      "text": "Call the clinic if you need us."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 381.22,
      "end_seconds": 382.76,
      "duration_seconds": 1.54,
      "text": "Right. Thanks again."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 383.68,
      "end_seconds": 384.98,
      "duration_seconds": 1.3,
      "text": "Safe journey home."
    }
  ]
}