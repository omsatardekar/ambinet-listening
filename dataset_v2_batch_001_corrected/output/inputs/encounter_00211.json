{
  "schema_version": "1.0",
  "encounter_id": "00211",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.32,
      "end_seconds": 5.48,
      "duration_seconds": 4.16,
      "text": "Good morning. I hope the wait wasn't too long."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 6.82,
      "end_seconds": 10.89,
      "duration_seconds": 4.07,
      "text": "Thanks, doctor. It's been a long few days."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 12.05,
      "end_seconds": 14.86,
      "duration_seconds": 2.81,
      "text": "Go ahead, tell me what's happening."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 15.88,
      "end_seconds": 20.89,
      "duration_seconds": 5.01,
      "text": "it's palpitations i thought I'd wait, but it hasn't gone"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 21.49,
      "end_seconds": 23.83,
      "duration_seconds": 2.34,
      "text": "What medicines do you take regularly?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 27.18,
      "end_seconds": 36.7,
      "duration_seconds": 9.52,
      "text": "um, you know, it's something called esci... escitalopram, 10 milligrams, maybe, once a day"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 38.43,
      "end_seconds": 43.03,
      "duration_seconds": 4.6,
      "text": "did you happen to bring the box or the paperwork?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 43.69,
      "end_seconds": 55.61,
      "duration_seconds": 11.92,
      "text": "No, it's at home. I mean, um, it's Thyronorm, 50 micrograms, every morning. Telmisartan. I take it 40 milligrams, once a day."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 57.23,
      "end_seconds": 59.28,
      "duration_seconds": 2.05,
      "text": "And when did that start?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 64.5,
      "end_seconds": 68.83,
      "duration_seconds": 4.33,
      "text": "I've, I've had it for two months"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 69.43,
      "end_seconds": 74.61,
      "duration_seconds": 5.18,
      "text": "Okay, give me more detail on it, whatever comes to mind."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 75.87,
      "end_seconds": 82.28,
      "duration_seconds": 6.41,
      "text": "I, I'd call it moderate. It happens a few times a day"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 83.51,
      "end_seconds": 86.59,
      "duration_seconds": 3.08,
      "text": "does it come along with anything else?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 88.45,
      "end_seconds": 111.98,
      "duration_seconds": 23.53,
      "text": "When it starts I tend to get lightheadedness as well. Oh, and shortness of breath with it. That's been about the same, about a week. Okay, you know, so with shortness of breath with it, about a eight out of ten."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 113.04,
      "end_seconds": 117.89,
      "duration_seconds": 4.85,
      "text": "Have you had palpitations before, or is this the first time?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 119.73,
      "end_seconds": 130.0,
      "duration_seconds": 10.27,
      "text": "I mean, uh, yes, something like this happened last winter, and it went away on its own."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 148.24,
      "end_seconds": 150.01,
      "duration_seconds": 1.77,
      "text": "How about weight loss?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 151.41,
      "end_seconds": 156.94,
      "duration_seconds": 5.53,
      "text": "Um, um, not at all, no weight loss."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 157.58,
      "end_seconds": 161.35,
      "duration_seconds": 3.77,
      "text": "Any fever, tremor or leg swelling at all?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 163.0,
      "end_seconds": 167.75,
      "duration_seconds": 4.75,
      "text": "I haven't had fever, tremor or leg swelling, no."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 168.77,
      "end_seconds": 171.41,
      "duration_seconds": 2.64,
      "text": "any rashes or skin problems otherwise?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 173.21,
      "end_seconds": 176.27,
      "duration_seconds": 3.06,
      "text": "yeah, no, skin's been fine"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 177.21,
      "end_seconds": 182.58,
      "duration_seconds": 5.37,
      "text": "Do you have any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 186.21,
      "end_seconds": 190.9,
      "duration_seconds": 4.69,
      "text": "Um, I've had anxiety for five years now."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 192.85,
      "end_seconds": 194.52,
      "duration_seconds": 1.67,
      "text": "Okay, and what else?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 196.05,
      "end_seconds": 200.42,
      "duration_seconds": 4.37,
      "text": "I have an underactive thyroid, for five years."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 204.17,
      "end_seconds": 205.62,
      "duration_seconds": 1.45,
      "text": "okay, anything else?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 210.57,
      "end_seconds": 229.09,
      "duration_seconds": 18.52,
      "text": "hmm, uh, I have high blood pressure it's a relief to finally sit down and talk about it i'd rather not end up on lots of tablets if I can avoid it"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 229.7,
      "end_seconds": 237.46,
      "duration_seconds": 7.76,
      "text": "Yes, an underactive thyroid and high blood pressure are known to us, good to have that clear. Any smoking?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 238.07,
      "end_seconds": 239.76,
      "duration_seconds": 1.69,
      "text": "I've never smoked"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 240.42,
      "end_seconds": 242.0,
      "duration_seconds": 1.58,
      "text": "do you drink alcohol?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 242.79,
      "end_seconds": 245.43,
      "duration_seconds": 2.64,
      "text": "I don't drink at all."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 247.14,
      "end_seconds": 249.26,
      "duration_seconds": 2.12,
      "text": "Do you have a job?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 250.47,
      "end_seconds": 252.42,
      "duration_seconds": 1.95,
      "text": "I'm a self-employed electrician"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 253.07,
      "end_seconds": 255.52,
      "duration_seconds": 2.45,
      "text": "Are you living with family?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 257.42,
      "end_seconds": 262.21,
      "duration_seconds": 4.79,
      "text": "I stay with my daughter and her family"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 263.53,
      "end_seconds": 264.76,
      "duration_seconds": 1.23,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 266.12,
      "end_seconds": 268.95,
      "duration_seconds": 2.83,
      "text": "Yeah, no, nothing like that."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 277.09,
      "end_seconds": 279.63,
      "duration_seconds": 2.54,
      "text": "Does anything run in the family?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 281.01,
      "end_seconds": 286.7,
      "duration_seconds": 5.69,
      "text": "my father had a stroke i mean, my sister has epilepsy"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 292.21,
      "end_seconds": 294.13,
      "duration_seconds": 1.92,
      "text": "let's do your observations"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 302.93,
      "end_seconds": 304.62,
      "duration_seconds": 1.69,
      "text": "Rest your hand here..."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 323.86,
      "end_seconds": 335.53,
      "duration_seconds": 11.67,
      "text": "Okay: respiratory rate 20, SpO2 97 percent on room air, temperature 36.8, pulse is 121 beats a minute, blood pressure 131 over 74."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 336.79,
      "end_seconds": 338.43,
      "duration_seconds": 1.64,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 340.04,
      "end_seconds": 343.42,
      "duration_seconds": 3.38,
      "text": "I'll interpret it once I've examined you."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 344.61,
      "end_seconds": 348.03,
      "duration_seconds": 3.42,
      "text": "Okay, I need to examine you for this."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 349.44,
      "end_seconds": 351.93,
      "duration_seconds": 2.49,
      "text": "Take your time, no rush."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 364.1,
      "end_seconds": 366.55,
      "duration_seconds": 2.45,
      "text": "pulse is irregular right now"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 368.08,
      "end_seconds": 370.06,
      "duration_seconds": 1.98,
      "text": "Hold that position for me."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 382.21,
      "end_seconds": 386.1,
      "duration_seconds": 3.89,
      "text": "No murmurs and the neck veins aren't distended."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 390.47,
      "end_seconds": 392.55,
      "duration_seconds": 2.08,
      "text": "Okay, you can sit up."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 406.37,
      "end_seconds": 418.48,
      "duration_seconds": 12.11,
      "text": "Taking everything into account, my working impression is a possible heart rhythm problem like atrial fibrillation. A thyroid problem is still possible. I'd like to arrange an echocardiogram for palpitations."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 420.26,
      "end_seconds": 423.09,
      "duration_seconds": 2.83,
      "text": "The The earliest is Thursday, 9 am."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 425.15,
      "end_seconds": 426.34,
      "duration_seconds": 1.19,
      "text": "That's fine."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 428.15,
      "end_seconds": 449.4,
      "duration_seconds": 21.25,
      "text": "I'd like to arrange a Holter monitor for palpitations. I want an ECG done, that's for palpitations. I'm prescribing metoprolol, 25 milligrams, twice a day, until we review. You take it by mouth. That's for palpitations. The pharmacy will go through the details again when you pick it up"
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 450.56,
      "end_seconds": 455.0,
      "duration_seconds": 4.44,
      "text": "Well, is that safe with my other things?"
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 455.83,
      "end_seconds": 483.57,
      "duration_seconds": 27.74,
      "text": "Cut back on tea, coffee and energy drinks, and note the time whenever it happens. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose. A thyroid test is something we might do if this doesn't improve next month. See me again after the results are back."
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 484.68,
      "end_seconds": 486.37,
      "duration_seconds": 1.69,
      "text": "Sure, that's doable."
    },
    {
      "segment_id": "SEG0059",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 488.38,
      "end_seconds": 491.13,
      "duration_seconds": 2.75,
      "text": "That's everything from me. Any other questions?"
    },
    {
      "segment_id": "SEG0060",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 492.56,
      "end_seconds": 495.93,
      "duration_seconds": 3.37,
      "text": "Okay, um, thank you. Bye."
    }
  ]
}