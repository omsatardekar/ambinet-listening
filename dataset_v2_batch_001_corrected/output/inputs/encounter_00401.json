{
  "schema_version": "1.0",
  "encounter_id": "00401",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.7,
      "end_seconds": 4.71,
      "duration_seconds": 4.01,
      "text": "Oh, hi, doctor. Is this the right room?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.31,
      "end_seconds": 10.14,
      "duration_seconds": 3.83,
      "text": "You're fine, sit down. So, what brings you in?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 11.89,
      "end_seconds": 19.73,
      "duration_seconds": 7.84,
      "text": "It's a dry cough that won't go away. I thought I'd wait, but it hasn't gone."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 20.52,
      "end_seconds": 22.43,
      "duration_seconds": 1.91,
      "text": "When did it begin?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 24.41,
      "end_seconds": 26.82,
      "duration_seconds": 2.41,
      "text": "Probably about three months. Yeah."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 27.48,
      "end_seconds": 35.48,
      "duration_seconds": 8.0,
      "text": "Can you describe it a bit more for me? How strong it is, what the pattern is, what helps."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 37.57,
      "end_seconds": 54.17,
      "duration_seconds": 16.6,
      "text": "Only sipping water, and it's not much. It's every other day. Yes, lying down and after meals. That makes it worse. Maybe a four out of ten on a bad day."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 55.31,
      "end_seconds": 57.08,
      "duration_seconds": 1.77,
      "text": "Let's do your observations."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 70.12,
      "end_seconds": 71.96,
      "duration_seconds": 1.84,
      "text": "Rest your hand here..."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 89.51,
      "end_seconds": 97.05,
      "duration_seconds": 7.54,
      "text": "Okay: pulse is 79 beats a minute, respiratory rate 18. And pressure 126 over 74, saturation 97 percent."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 98.53,
      "end_seconds": 100.13,
      "duration_seconds": 1.6,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 101.04,
      "end_seconds": 103.61,
      "duration_seconds": 2.57,
      "text": "That's fine, we'll come to it."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 105.77,
      "end_seconds": 109.06,
      "duration_seconds": 3.29,
      "text": "If you're comfortable, I'll examine you now."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 110.37,
      "end_seconds": 111.07,
      "duration_seconds": 0.7,
      "text": "Fine."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 112.93,
      "end_seconds": 115.06,
      "duration_seconds": 2.13,
      "text": "Tell me if anything hurts."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 122.3,
      "end_seconds": 127.44,
      "duration_seconds": 5.14,
      "text": "Chest is clear and the throat looks a little red at the back."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 132.05,
      "end_seconds": 140.47,
      "duration_seconds": 8.42,
      "text": "All done, you can get dressed. Did you get weight loss, coughing up blood or shortness of breath?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 141.93,
      "end_seconds": 148.17,
      "duration_seconds": 6.24,
      "text": "No weight loss, coughing up blood or shortness of breath, none of it."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 149.75,
      "end_seconds": 153.43,
      "duration_seconds": 3.68,
      "text": "How about your heart, any problems like that?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 155.17,
      "end_seconds": 157.54,
      "duration_seconds": 2.37,
      "text": "No, that's been fine."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 159.54,
      "end_seconds": 164.1,
      "duration_seconds": 4.56,
      "text": "Have you noticed any weakness, or anything odd with your balance?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 165.38,
      "end_seconds": 167.53,
      "duration_seconds": 2.15,
      "text": "No, nothing like that."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 180.99,
      "end_seconds": 185.62,
      "duration_seconds": 4.63,
      "text": "Do you have any medical conditions I should know about?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 187.37,
      "end_seconds": 190.39,
      "duration_seconds": 3.02,
      "text": "No, I've never had anything serious."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 191.94,
      "end_seconds": 193.23,
      "duration_seconds": 1.29,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 194.2,
      "end_seconds": 196.11,
      "duration_seconds": 1.91,
      "text": "No, nothing like that."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 210.88,
      "end_seconds": 213.4,
      "duration_seconds": 2.52,
      "text": "Are you on any regular medication?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 214.73,
      "end_seconds": 215.98,
      "duration_seconds": 1.25,
      "text": "Nothing, no."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 228.79,
      "end_seconds": 233.42,
      "duration_seconds": 4.63,
      "text": "Do you have any allergies to medicines, food, anything at all?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 234.01,
      "end_seconds": 234.96,
      "duration_seconds": 0.95,
      "text": "No allergies."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 243.86,
      "end_seconds": 245.25,
      "duration_seconds": 1.39,
      "text": "And your work?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 247.25,
      "end_seconds": 250.46,
      "duration_seconds": 3.21,
      "text": "I drive a delivery van all day."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 252.09,
      "end_seconds": 254.19,
      "duration_seconds": 2.1,
      "text": "Anything special about your diet?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 256.16,
      "end_seconds": 259.59,
      "duration_seconds": 3.43,
      "text": "I try to avoid too much sugar."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 261.52,
      "end_seconds": 274.87,
      "duration_seconds": 13.35,
      "text": "Okay, thinking it through, my working impression is a cough driven by acid reflux. Let's get breathing tests, for chronic cough. Let's get a chest X-ray, for chronic cough."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 276.81,
      "end_seconds": 279.63,
      "duration_seconds": 2.82,
      "text": "How long does that take?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 281.51,
      "end_seconds": 297.34,
      "duration_seconds": 15.83,
      "text": "You'll be taking pantoprazole, 40 milligrams, before breakfast, for four weeks. You take it by mouth. That's for reflux. The pharmacy will go through the details again when you pick it up."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 298.45,
      "end_seconds": 303.54,
      "duration_seconds": 5.09,
      "text": "Hmm, can I get that from the usual pharmacy?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 304.19,
      "end_seconds": 329.92,
      "duration_seconds": 25.73,
      "text": "Don't eat for two or three hours before lying down, and raise the head of the bed a little. Cut down on salt and fried food for now, it really does make a difference. If the symptoms get worse, or you feel really unwell, please come to the emergency department. Book a review in a month."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 330.82,
      "end_seconds": 333.24,
      "duration_seconds": 2.42,
      "text": "Yes, I can do that."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 334.95,
      "end_seconds": 336.29,
      "duration_seconds": 1.34,
      "text": "Look after yourself."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 337.91,
      "end_seconds": 340.6,
      "duration_seconds": 2.69,
      "text": "All good here. Thank you."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 342.14,
      "end_seconds": 344.16,
      "duration_seconds": 2.02,
      "text": "Right, see you then."
    }
  ]
}