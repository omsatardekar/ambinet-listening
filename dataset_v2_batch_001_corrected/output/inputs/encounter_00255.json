  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.8,
      "end_seconds": 4.52,
      "duration_seconds": 3.72,
      "text": "afternoon take the chair by the the desk"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 6.42,
      "end_seconds": 7.32,
      "duration_seconds": 0.9,
      "text": "Thank you."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 8.22,
      "end_seconds": 11.45,
      "duration_seconds": 3.23,
      "text": "is this your first time with this clinic?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 13.01,
      "end_seconds": 19.01,
      "duration_seconds": 6.0,
      "text": "mm, first time with this one, yes a friend recommended it"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 20.13,
      "end_seconds": 22.76,
      "duration_seconds": 2.63,
      "text": "tell me what's been troubling you"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 24.34,
      "end_seconds": 32.7,
      "duration_seconds": 8.36,
      "text": "okay, so mainly a ringing noise. There's a couple of other things, but that's the main one"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 34.02,
      "end_seconds": 36.56,
      "duration_seconds": 2.54,
      "text": "and and when did that start?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 37.93,
      "end_seconds": 41.23,
      "duration_seconds": 3.3,
      "text": "so, it's been two months now"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 42.78,
      "end_seconds": 45.02,
      "duration_seconds": 2.24,
      "text": "how often does it happen?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 49.2,
      "end_seconds": 52.93,
      "duration_seconds": 3.73,
      "text": "I'd say once or twice a day"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 54.54,
      "end_seconds": 57.84,
      "duration_seconds": 3.3,
      "text": "does it come along with anything else?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 59.44,
      "end_seconds": 98.08,
      "duration_seconds": 38.64,
      "text": "When it starts I tend to to get difficulty following conversation in crowds as well. I mean the difficulty following conversation in crowds? That's been for nearly five years. With difficulty following conversation in crowds it feels mild to me. I've also been turning the TV up. As for trouble hearing in my left ear I honestly can't say when that began. It might have been last month or the month before."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 113.11,
      "end_seconds": 115.56,
      "duration_seconds": 2.45,
      "text": "What medicines do you take regularly?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 119.68,
      "end_seconds": 123.92,
      "duration_seconds": 4.24,
      "text": "Glimepiride i take it 2 milligrams before breakfast"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 125.09,
      "end_seconds": 126.91,
      "duration_seconds": 1.82,
      "text": "is that that long-standing?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 128.45,
      "end_seconds": 144.39,
      "duration_seconds": 15.94,
      "text": "About three months now. Ramipril 5 milligrams every morning for my blood pressure i did try to ignore it for a while a neighbour of mine said I should see someone about it"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 144.77,
      "end_seconds": 145.65,
      "duration_seconds": 0.88,
      "text": "go on"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 151.05,
      "end_seconds": 157.48,
      "duration_seconds": 6.43,
      "text": "I take sodium valproate, 500 milligrams, twice a day for the fits."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 158.52,
      "end_seconds": 163.23,
      "duration_seconds": 4.71,
      "text": "doctor, our chart from the last visit lists it as 250 milligrams"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 165.28,
      "end_seconds": 168.86,
      "duration_seconds": 3.58,
      "text": "Hm. Do you have the latest prescription with you?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 169.97,
      "end_seconds": 175.4,
      "duration_seconds": 5.43,
      "text": "okay, so I don't think I have it with me"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 177.45,
      "end_seconds": 181.4,
      "duration_seconds": 3.95,
      "text": "have you had to to have anything operated on?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 182.31,
      "end_seconds": 187.46,
      "duration_seconds": 5.15,
      "text": "um, I had a knee arthroscopy three years ago"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 188.14,
      "end_seconds": 194.0,
      "duration_seconds": 5.86,
      "text": "Okay, tell me about your routine, work, habits, that sort of thing."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 195.85,
      "end_seconds": 217.07,
      "duration_seconds": 21.22,
      "text": "I used to smoke but I quit five years ago. I walk for about half an hour most days. I run a small shop, so I'm on my feet a lot. I eat out quite a lot, to be honest"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 227.76,
      "end_seconds": 231.08,
      "duration_seconds": 3.32,
      "text": "any long-term health problems I should know about?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 231.8,
      "end_seconds": 233.8,
      "duration_seconds": 2.0,
      "text": "I've I've got diabetes."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 235.78,
      "end_seconds": 236.48,
      "duration_seconds": 0.7,
      "text": "right"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 237.22,
      "end_seconds": 242.86,
      "duration_seconds": 5.64,
      "text": "High blood pressure, for about a year. Epilepsy, for five years."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 246.74,
      "end_seconds": 257.14,
      "duration_seconds": 10.4,
      "text": "okay, I can see diabetes in your file as well. Have you ever reacted badly to a medicine or food? Any allergies?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 258.75,
      "end_seconds": 263.77,
      "duration_seconds": 5.02,
      "text": "well, you know, none, as far as I'm aware"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 279.41,
      "end_seconds": 282.09,
      "duration_seconds": 2.68,
      "text": "does anything run in the family?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 283.9,
      "end_seconds": 290.33,
      "duration_seconds": 6.43,
      "text": "My mother has migraines. Okay uh so my sister has epilepsy."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 291.26,
      "end_seconds": 295.82,
      "duration_seconds": 4.56,
      "text": "let me check a few things. Any discharge or facial weakness?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 296.8,
      "end_seconds": 299.41,
      "duration_seconds": 2.61,
      "text": "no, I'd have mentioned it"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 300.06,
      "end_seconds": 305.39,
      "duration_seconds": 5.33,
      "text": "let me check a few things. Any dizziness, ear pain or headache?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 306.31,
      "end_seconds": 312.56,
      "duration_seconds": 6.25,
      "text": "Hmm, um, no, no dizziness, ear pain or headache."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 314.38,
      "end_seconds": 318.23,
      "duration_seconds": 3.85,
      "text": "anything on the the skin I should know about?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 319.75,
      "end_seconds": 320.84,
      "duration_seconds": 1.09,
      "text": "skin's normal"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 321.41,
      "end_seconds": 332.45,
      "duration_seconds": 11.04,
      "text": "doctor, I've got the the readings for you bP is 112 over 76, temperature 36.6, oxygen saturation is 97 percent heart rate 74."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 333.74,
      "end_seconds": 348.75,
      "duration_seconds": 15.01,
      "text": "Okay, noted. Let me tell you where I've got to. My working impression is hearing loss from wax. That's my thinking for now, and it may change as we learn more. Age-related hearing loss is still possible."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 350.48,
      "end_seconds": 355.64,
      "duration_seconds": 5.16,
      "text": "I've been thinking the worst to be honest is it bad?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 357.37,
      "end_seconds": 376.83,
      "duration_seconds": 19.46,
      "text": "it's reasonable to be concerned, but right now hearing loss from wax is my leading thought, not anything worse we should do a hearing test for hearing loss i'll start you on ear drops, three times a day, for five days that should help with wax softening"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 378.79,
      "end_seconds": 379.84,
      "duration_seconds": 1.05,
      "text": "right, understood"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 381.1,
      "end_seconds": 407.08,
      "duration_seconds": 25.98,
      "text": "please don't use cotton buds or ear candles they push the wax in further. And please bring the latest prescription or the medicine boxes to the next visit so we can settle the the dose. Come back after the hearing test. Let me check I've been clear. What will you do once you get home?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 407.72,
      "end_seconds": 413.51,
      "duration_seconds": 5.79,
      "text": "So, I come back after the hearing test. Is that right?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 418.73,
      "end_seconds": 421.31,
      "duration_seconds": 2.58,
      "text": "Yes exactly right. Any last questions?"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 422.05,
      "end_seconds": 424.46,
      "duration_seconds": 2.41,
      "text": "well okay thank you bye"
    }
  ]
}