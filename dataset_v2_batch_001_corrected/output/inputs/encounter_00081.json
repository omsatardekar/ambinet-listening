{
  "schema_version": "1.0",
  "encounter_id": "00081",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 0.63,
      "end_seconds": 7.14,
      "duration_seconds": 6.51,
      "text": "Okay, doctor, we're all set in here. I'll give you the numbers when you want them."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.72,
      "end_seconds": 13.67,
      "duration_seconds": 5.95,
      "text": "Okay, great. Hello, come in and sit down. How can I help?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 15.29,
      "end_seconds": 20.49,
      "duration_seconds": 5.2,
      "text": "Hello, doctor, I came in with them, if that's okay."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 21.78,
      "end_seconds": 25.04,
      "duration_seconds": 3.26,
      "text": "So, absolutely, come and sit beside them."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 26.99,
      "end_seconds": 33.93,
      "duration_seconds": 6.94,
      "text": "I'm here because of morning shakiness. My family kept telling me to get it checked."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 35.12,
      "end_seconds": 36.74,
      "duration_seconds": 1.62,
      "text": "When did it begin?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 38.53,
      "end_seconds": 41.33,
      "duration_seconds": 2.8,
      "text": "I've had it for five days."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 42.05,
      "end_seconds": 45.86,
      "duration_seconds": 3.81,
      "text": "Okay, what's the pattern, is it there all day?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 47.66,
      "end_seconds": 49.59,
      "duration_seconds": 1.93,
      "text": "Honestly, every other day."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 50.41,
      "end_seconds": 56.88,
      "duration_seconds": 6.47,
      "text": "And the other thing I wanted to mention is that I can't really—"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 56.98,
      "end_seconds": 61.84,
      "duration_seconds": 4.86,
      "text": "Tell the doctor about the other thing, that's what worries me."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 63.03,
      "end_seconds": 65.87,
      "duration_seconds": 2.84,
      "text": "I was getting to that!"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 66.93,
      "end_seconds": 74.92,
      "duration_seconds": 7.99,
      "text": "That's fine, one at a time. I'll ask about everything. Have you had an upset stomach in the mornings?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 75.83,
      "end_seconds": 79.94,
      "duration_seconds": 4.11,
      "text": "Yes, you know, about the same, three weeks."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 81.76,
      "end_seconds": 86.91,
      "duration_seconds": 5.15,
      "text": "Have you had morning shakiness before, or is this the first time?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 90.65,
      "end_seconds": 98.51,
      "duration_seconds": 7.86,
      "text": "Yes, something like this happened last year, and it went away on its own."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 100.24,
      "end_seconds": 103.27,
      "duration_seconds": 3.03,
      "text": "And what about seizures or vomiting blood?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 108.13,
      "end_seconds": 121.89,
      "duration_seconds": 13.76,
      "text": "No, no seizures, no vomiting blood. I was wanting to cut down on drinking at one point, but that went away on its own."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 122.91,
      "end_seconds": 128.29,
      "duration_seconds": 5.38,
      "text": "Right, and what about blackouts, thoughts of harming myself or yellow eyes?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 129.19,
      "end_seconds": 135.89,
      "duration_seconds": 6.7,
      "text": "No blackouts, thoughts of harming myself or yellow eyes, none of it."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 136.47,
      "end_seconds": 139.02,
      "duration_seconds": 2.55,
      "text": "Anything different when you pass water?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 140.76,
      "end_seconds": 142.56,
      "duration_seconds": 1.8,
      "text": "Nothing there, no."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 143.11,
      "end_seconds": 146.04,
      "duration_seconds": 2.93,
      "text": "Any rashes or skin problems otherwise?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 146.87,
      "end_seconds": 147.77,
      "duration_seconds": 0.9,
      "text": "No rashes."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 160.57,
      "end_seconds": 164.47,
      "duration_seconds": 3.9,
      "text": "Have you had to have anything operated on?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 165.71,
      "end_seconds": 171.12,
      "duration_seconds": 5.41,
      "text": "Um, just a lump removed from my back, years ago."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 176.59,
      "end_seconds": 180.38,
      "duration_seconds": 3.79,
      "text": "So, are you on any tablets or medication?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 181.46,
      "end_seconds": 188.73,
      "duration_seconds": 7.27,
      "text": "It's a... um, I can't remember what it's called. It's a round yellow one."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 189.86,
      "end_seconds": 192.69,
      "duration_seconds": 2.83,
      "text": "Do you remember what it's for?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 194.1,
      "end_seconds": 204.69,
      "duration_seconds": 10.59,
      "text": "Oh, for the reflux, I believe. My husband sets them out for me, I just take what I'm given."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 206.09,
      "end_seconds": 208.71,
      "duration_seconds": 2.62,
      "text": "Any allergies I should know about?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 209.33,
      "end_seconds": 221.69,
      "duration_seconds": 12.36,
      "text": "Hmm, there was some antibiotic, I was told I was allergic. But I couldn't tell you what it was called or what it did."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 222.44,
      "end_seconds": 223.28,
      "duration_seconds": 0.84,
      "text": "Any smoking?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 223.85,
      "end_seconds": 227.71,
      "duration_seconds": 3.86,
      "text": "I smoke, yes, around five a day."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 228.68,
      "end_seconds": 231.57,
      "duration_seconds": 2.89,
      "text": "Is anyone at home with you?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 232.28,
      "end_seconds": 236.18,
      "duration_seconds": 3.9,
      "text": "I share a flat with two friends."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 254.95,
      "end_seconds": 259.0,
      "duration_seconds": 4.05,
      "text": "Tell me about your health in general, any ongoing conditions?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 260.38,
      "end_seconds": 268.99,
      "duration_seconds": 8.61,
      "text": "I've, I've got acid reflux. I told myself I'd wait and see, and here I am."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 270.73,
      "end_seconds": 271.65,
      "duration_seconds": 0.92,
      "text": "Anything more?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 272.68,
      "end_seconds": 275.55,
      "duration_seconds": 2.87,
      "text": "I've had high blood pressure, yes."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 276.57,
      "end_seconds": 281.41,
      "duration_seconds": 4.84,
      "text": "Okay, I can see acid reflux in your file as well."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 284.5,
      "end_seconds": 300.51,
      "duration_seconds": 16.01,
      "text": "Here are the numbers, doctor. Oxygen saturation is 98 percent, BMI works out to 23.0, pulse is 82 beats a minute, height 172 centimetres, weight 68 kilos, respiratory rate 16, blood pressure 122 over 81, temperature is 36.7 degrees."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 301.87,
      "end_seconds": 334.92,
      "duration_seconds": 33.05,
      "text": "Good, thank you. Right, here's what I'm thinking. This looks most like alcohol use that you'd like to reduce. We shouldn't forget anxiety driving the drinking. It could also be alcohol-related liver strain, so we'll keep that open. Blood tests is what I'd like next, for alcohol use. I'll request liver function tests, it'll help with alcohol use. Plan a few alcohol-free days each week and track how much you drink."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 336.34,
      "end_seconds": 352.42,
      "duration_seconds": 16.08,
      "text": "Let's get you seen by the alcohol support service, I'll arrange the letter. The thing that would worry me is if you have severe shaking, confusion or seizures when you cut down. If that happens, go to emergency."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 353.65,
      "end_seconds": 357.18,
      "duration_seconds": 3.53,
      "text": "Alright, I know what to look for."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 357.91,
      "end_seconds": 361.94,
      "duration_seconds": 4.03,
      "text": "See me again in four weeks. Any last questions?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 363.73,
      "end_seconds": 370.53,
      "duration_seconds": 6.8,
      "text": "Um, you know, that's everything I wanted to ask. Thank you."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 371.72,
      "end_seconds": 373.18,
      "duration_seconds": 1.46,
      "text": "All the best."
    }
  ]
}