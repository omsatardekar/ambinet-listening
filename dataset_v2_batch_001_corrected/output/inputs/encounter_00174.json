{
  "schema_version": "1.0",
  "encounter_id": "00174",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.81,
      "end_seconds": 3.87,
      "duration_seconds": 3.06,
      "text": "Evening. Long day, I imagine. Sit down."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 6.92,
      "end_seconds": 9.22,
      "duration_seconds": 2.3,
      "text": "Hello, doctor, thank you."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 10.44,
      "end_seconds": 13.84,
      "duration_seconds": 3.4,
      "text": "Is this your first time with this clinic?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 18.81,
      "end_seconds": 24.52,
      "duration_seconds": 5.71,
      "text": "Mm, first time with this one, yes. A friend recommended it."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 25.59,
      "end_seconds": 28.59,
      "duration_seconds": 3.0,
      "text": "What made you decide to come in?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 31.81,
      "end_seconds": 54.06,
      "duration_seconds": 22.25,
      "text": "I've been wanting to stop smoking. I just want to get back to normal, really. It's a relief to finally sit down and talk about it. Oh, and irritability when I try to cut down. That's been about the same, ten days."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 55.08,
      "end_seconds": 58.87,
      "duration_seconds": 3.79,
      "text": "And what about alcohol problems or coughing up blood?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 60.71,
      "end_seconds": 63.84,
      "duration_seconds": 3.13,
      "text": "None, as far as I know."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 65.56,
      "end_seconds": 68.84,
      "duration_seconds": 3.28,
      "text": "Has your heart given you any trouble?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 69.63,
      "end_seconds": 72.0,
      "duration_seconds": 2.37,
      "text": "No, nothing with my heart."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 73.64,
      "end_seconds": 75.19,
      "duration_seconds": 1.55,
      "text": "Neurologically, anything strange?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 77.1,
      "end_seconds": 79.45,
      "duration_seconds": 2.35,
      "text": "No, nothing like that."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 89.16,
      "end_seconds": 93.02,
      "duration_seconds": 3.86,
      "text": "Have you had to have anything operated on?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 94.83,
      "end_seconds": 98.59,
      "duration_seconds": 3.76,
      "text": "I had a knee arthroscopy three years ago."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 116.45,
      "end_seconds": 118.22,
      "duration_seconds": 1.77,
      "text": "Do you drink alcohol?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 123.59,
      "end_seconds": 128.44,
      "duration_seconds": 4.85,
      "text": "I have a couple of drinks on the weekend."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 130.07,
      "end_seconds": 130.9,
      "duration_seconds": 0.83,
      "text": "Any smoking?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 132.37,
      "end_seconds": 137.67,
      "duration_seconds": 5.3,
      "text": "I used to smoke but I quit five years ago."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 138.6,
      "end_seconds": 141.53,
      "duration_seconds": 2.93,
      "text": "Alright, are you working at the moment?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 143.52,
      "end_seconds": 147.58,
      "duration_seconds": 4.06,
      "text": "Yes, I'm a nurse on a busy ward."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 149.51,
      "end_seconds": 151.25,
      "duration_seconds": 1.74,
      "text": "Any sport or activity?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 154.73,
      "end_seconds": 157.35,
      "duration_seconds": 2.62,
      "text": "I play badminton on Sundays."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 171.44,
      "end_seconds": 174.9,
      "duration_seconds": 3.46,
      "text": "Is there a family history of anything significant?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 175.91,
      "end_seconds": 178.27,
      "duration_seconds": 2.36,
      "text": "My uncle had colon cancer."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 179.68,
      "end_seconds": 181.0,
      "duration_seconds": 1.32,
      "text": "Any regular medication?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 183.08,
      "end_seconds": 184.63,
      "duration_seconds": 1.55,
      "text": "No, nothing regular."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 186.4,
      "end_seconds": 192.15,
      "duration_seconds": 5.75,
      "text": "Any allergies I should know about? These questions might sound routine, but they matter."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 192.97,
      "end_seconds": 196.41,
      "duration_seconds": 3.44,
      "text": "No, uh, no allergies to anything."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 197.62,
      "end_seconds": 201.63,
      "duration_seconds": 4.01,
      "text": "Any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 207.15,
      "end_seconds": 210.11,
      "duration_seconds": 2.96,
      "text": "No, nothing, I've generally been healthy."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 215.04,
      "end_seconds": 217.84,
      "duration_seconds": 2.8,
      "text": "A few measurements, then we'll continue."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 224.79,
      "end_seconds": 226.53,
      "duration_seconds": 1.74,
      "text": "Just relax your arm..."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 244.91,
      "end_seconds": 251.41,
      "duration_seconds": 6.5,
      "text": "Okay: respiratory rate 16, BP is 124 over 78, saturation 97 percent, pulse 66."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 253.46,
      "end_seconds": 257.41,
      "duration_seconds": 3.95,
      "text": "Right, let me check a few things physically."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 258.49,
      "end_seconds": 260.78,
      "duration_seconds": 2.29,
      "text": "Just relax, I'll be quick."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 274.8,
      "end_seconds": 280.4,
      "duration_seconds": 5.6,
      "text": "Chest sounds clear, a bit of wheeze when you breathe out hard."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 285.46,
      "end_seconds": 288.06,
      "duration_seconds": 2.6,
      "text": "All done, you can get dressed."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 301.19,
      "end_seconds": 314.91,
      "duration_seconds": 13.72,
      "text": "Right, here's what I'm thinking. My working impression is nicotine dependence. What I'm giving you is nicotine patches, 14 milligrams, once a day, for six weeks. That's for smoking cessation."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 315.65,
      "end_seconds": 317.98,
      "duration_seconds": 2.33,
      "text": "That's easy enough to remember."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 319.51,
      "end_seconds": 321.85,
      "duration_seconds": 2.34,
      "text": "Alright, I'll see you out."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 323.37,
      "end_seconds": 326.55,
      "duration_seconds": 3.18,
      "text": "Thanks so much, um, doctor."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 328.34,
      "end_seconds": 329.9,
      "duration_seconds": 1.56,
      "text": "Mind how you go."
    }
  ]
}