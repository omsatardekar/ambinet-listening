{
  "schema_version": "1.0",
  "encounter_id": "00195",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 0.55,
      "end_seconds": 7.01,
      "duration_seconds": 6.46,
      "text": "All set here, doctor. Chart's updated, and I'll read the readings out when you're ready."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.67,
      "end_seconds": 12.84,
      "duration_seconds": 4.17,
      "text": "Good, thank you. Welcome, tell me what's brought you in."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 14.91,
      "end_seconds": 26.21,
      "duration_seconds": 11.3,
      "text": "Yeah, uh, it's a night-time cough. I don't know what's causing it. I'd rather know what's going on than keep guessing."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 27.33,
      "end_seconds": 30.03,
      "duration_seconds": 2.7,
      "text": "When did you first notice it?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 31.45,
      "end_seconds": 35.86,
      "duration_seconds": 4.41,
      "text": "Um, it's been five days, I'm fairly sure."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 36.52,
      "end_seconds": 40.72,
      "duration_seconds": 4.2,
      "text": "Is it constant, or does it come and go?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 45.13,
      "end_seconds": 48.33,
      "duration_seconds": 3.2,
      "text": "It sort of comes and goes."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 49.19,
      "end_seconds": 52.87,
      "duration_seconds": 3.68,
      "text": "What about a tight chest, have you noticed that?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 58.99,
      "end_seconds": 66.98,
      "duration_seconds": 7.99,
      "text": "Yes, about the same, about four days. With tight chest, it feels severe to me."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 82.36,
      "end_seconds": 92.37,
      "duration_seconds": 10.01,
      "text": "Here are the numbers, doctor. Blood pressure 129 over 74, saturation 94 percent, respiratory rate 24, pulse 102, temperature 37.0."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 93.23,
      "end_seconds": 94.18,
      "duration_seconds": 0.95,
      "text": "Okay, noted."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 95.92,
      "end_seconds": 98.87,
      "duration_seconds": 2.95,
      "text": "Let's do the physical part now."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 99.98,
      "end_seconds": 102.8,
      "duration_seconds": 2.82,
      "text": "Stay still while I have a look."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 120.16,
      "end_seconds": 123.83,
      "duration_seconds": 3.67,
      "text": "You're speaking in full sentences, which is reassuring."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 127.46,
      "end_seconds": 129.49,
      "duration_seconds": 2.03,
      "text": "That's fine, sit up."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 139.79,
      "end_seconds": 145.78,
      "duration_seconds": 5.99,
      "text": "Let me check a few things. Any fever, weight loss or leg swelling?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 147.44,
      "end_seconds": 149.65,
      "duration_seconds": 2.21,
      "text": "No, none of those."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 151.39,
      "end_seconds": 155.64,
      "duration_seconds": 4.25,
      "text": "Right, anything with your heart, like skipped beats or fainting?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 156.84,
      "end_seconds": 159.02,
      "duration_seconds": 2.18,
      "text": "No, that's been fine."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 161.03,
      "end_seconds": 163.99,
      "duration_seconds": 2.96,
      "text": "Have you got any chronic problems?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 165.7,
      "end_seconds": 166.77,
      "duration_seconds": 1.07,
      "text": "Yes, asthma."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 168.37,
      "end_seconds": 173.28,
      "duration_seconds": 4.91,
      "text": "Okay, I can see asthma in your file as well."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 181.17,
      "end_seconds": 182.63,
      "duration_seconds": 1.46,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 183.9,
      "end_seconds": 185.63,
      "duration_seconds": 1.73,
      "text": "No operations, no."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 187.09,
      "end_seconds": 188.42,
      "duration_seconds": 1.33,
      "text": "Any regular medication?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 193.7,
      "end_seconds": 196.79,
      "duration_seconds": 3.09,
      "text": "No, I don't take anything regularly."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 209.34,
      "end_seconds": 212.09,
      "duration_seconds": 2.75,
      "text": "Does anything run in the family?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 217.33,
      "end_seconds": 219.9,
      "duration_seconds": 2.57,
      "text": "My grandmother had breast cancer."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 220.91,
      "end_seconds": 222.99,
      "duration_seconds": 2.08,
      "text": "Do you have a job?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 223.61,
      "end_seconds": 225.78,
      "duration_seconds": 2.17,
      "text": "I'm a self-employed electrician."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 230.16,
      "end_seconds": 233.57,
      "duration_seconds": 3.41,
      "text": "What do you do to keep active?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 235.47,
      "end_seconds": 238.33,
      "duration_seconds": 2.86,
      "text": "I cycle to work most mornings."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 239.65,
      "end_seconds": 244.82,
      "duration_seconds": 5.17,
      "text": "Okay, thinking it through, my working impression is an asthma flare-up."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 246.44,
      "end_seconds": 248.78,
      "duration_seconds": 2.34,
      "text": "Doctor, is this dangerous?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 249.8,
      "end_seconds": 262.85,
      "duration_seconds": 13.05,
      "text": "Nothing I've seen today points to an emergency. It looks like an asthma flare-up, but I'd like to confirm. I'll request a chest X-ray, it'll help with wheeze."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 264.45,
      "end_seconds": 268.59,
      "duration_seconds": 4.14,
      "text": "I've already done a peak flow reading, it's ready for you."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 269.73,
      "end_seconds": 297.38,
      "duration_seconds": 27.65,
      "text": "Thanks, I'll check it. I'm prescribing prednisolone, 30 milligrams, once a day, for five days. It's for asthma flare-up. Let me watch you use the inhaler, a lot of people don't get the full dose. Rinse your mouth after the steroid inhaler. I'm not ordering breathing tests today. If things carry on in two weeks, we'll consider it. Let's review you in two weeks. Any last questions?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 298.57,
      "end_seconds": 300.74,
      "duration_seconds": 2.17,
      "text": "Thanks so much, doctor."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 302.09,
      "end_seconds": 304.48,
      "duration_seconds": 2.39,
      "text": "Alright, mind how you go."
    }
  ]
}