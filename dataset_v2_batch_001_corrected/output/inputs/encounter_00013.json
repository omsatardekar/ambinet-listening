{
  "schema_version": "1.0",
  "encounter_id": "00013",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 1.35,
      "end_seconds": 5.69,
      "duration_seconds": 4.34,
      "text": "Morning, doctor. I've settled them in, ready when you are."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.21,
      "end_seconds": 9.73,
      "duration_seconds": 3.52,
      "text": "okay, thanks hi, how can I help today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 11.24,
      "end_seconds": 18.74,
      "duration_seconds": 7.5,
      "text": "Mainly I've been waking up at night with pins and needles. That's why I came."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 20.12,
      "end_seconds": 22.5,
      "duration_seconds": 2.38,
      "text": "right, when did it begin?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 24.58,
      "end_seconds": 28.32,
      "duration_seconds": 3.74,
      "text": "It's been three days, I'm fairly sure."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 30.41,
      "end_seconds": 33.61,
      "duration_seconds": 3.2,
      "text": "How bad is it, would you say?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 34.32,
      "end_seconds": 35.37,
      "duration_seconds": 1.05,
      "text": "Mostly mild."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 37.19,
      "end_seconds": 40.87,
      "duration_seconds": 3.68,
      "text": "Anything that tends to go along with it?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 42.31,
      "end_seconds": 48.01,
      "duration_seconds": 5.7,
      "text": "A weak grip goes along with it, most of the time."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 48.74,
      "end_seconds": 53.04,
      "duration_seconds": 4.3,
      "text": "Any numbness in the thumb and first two fingers as well?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 54.93,
      "end_seconds": 65.97,
      "duration_seconds": 11.04,
      "text": "Yeah, I've had that since last Tuesday. The weak grip? That's been for five days. I mean, as for weak grip, mostly moderate."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 66.52,
      "end_seconds": 71.86,
      "duration_seconds": 5.34,
      "text": "Let me check a few things. Any headache, bladder problems or trouble walking?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 73.23,
      "end_seconds": 78.62,
      "duration_seconds": 5.39,
      "text": "oh, no, no headache, bladder problems or trouble walking"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 83.02,
      "end_seconds": 88.1,
      "duration_seconds": 5.08,
      "text": "Did you get weakness in the legs or swelling in the joints?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 92.63,
      "end_seconds": 95.55,
      "duration_seconds": 2.92,
      "text": "No, I'd have mentioned it."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 96.28,
      "end_seconds": 98.97,
      "duration_seconds": 2.69,
      "text": "And your skin, any changes there?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 100.18,
      "end_seconds": 101.26,
      "duration_seconds": 1.08,
      "text": "no rashes"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 105.79,
      "end_seconds": 110.24,
      "duration_seconds": 4.45,
      "text": "Anything with your heart, like skipped beats or fainting?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 111.89,
      "end_seconds": 113.27,
      "duration_seconds": 1.38,
      "text": "Nothing like that."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 114.22,
      "end_seconds": 117.39,
      "duration_seconds": 3.17,
      "text": "Do you have any known allergies at all?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 119.02,
      "end_seconds": 129.44,
      "duration_seconds": 10.42,
      "text": "I think I reacted to some antibiotic once, years ago. I don't remember which one, or what happened exactly."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 140.28,
      "end_seconds": 144.9,
      "duration_seconds": 4.62,
      "text": "What about your general health, any conditions you're being treated for?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 146.84,
      "end_seconds": 152.79,
      "duration_seconds": 5.95,
      "text": "I've had an underactive thyroid, yes. I have diabetes. I have high cholesterol."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 153.91,
      "end_seconds": 162.3,
      "duration_seconds": 8.39,
      "text": "Right, so diabetes is already on your record. We'll keep that in mind today. A few questions about your lifestyle now."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 162.83,
      "end_seconds": 174.84,
      "duration_seconds": 12.01,
      "text": "I go to the gym a couple of times a week. I share a flat with two friends. I teach at a primary school."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 183.18,
      "end_seconds": 186.12,
      "duration_seconds": 2.94,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 188.15,
      "end_seconds": 190.1,
      "duration_seconds": 1.95,
      "text": "No, nothing like that."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 191.65,
      "end_seconds": 196.01,
      "duration_seconds": 4.36,
      "text": "Any medication at the moment, including things from the pharmacy?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 198.67,
      "end_seconds": 202.62,
      "duration_seconds": 3.95,
      "text": "Atorvastatin, 20 milligrams, at night for my cholesterol."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 204.62,
      "end_seconds": 209.17,
      "duration_seconds": 4.55,
      "text": "Doctor, our chart from the last visit lists it as 40 milligrams."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 213.01,
      "end_seconds": 216.79,
      "duration_seconds": 3.78,
      "text": "hm. Do you have the latest prescription with you?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 217.74,
      "end_seconds": 232.28,
      "duration_seconds": 14.54,
      "text": "No, I left it at home. Paracetamol. I take it 500 milligrams, when needed. I had rosuvastatin at one point, uh, but I'm off it now."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 233.14,
      "end_seconds": 242.98,
      "duration_seconds": 9.84,
      "text": "Here are the numbers, doctor. Blood pressure 111 over 82, SpO2 98 percent on room air. Respiratory rate 14, temperature 36.5, pulse 78."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 244.17,
      "end_seconds": 244.87,
      "duration_seconds": 0.7,
      "text": "Thanks."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 247.19,
      "end_seconds": 249.73,
      "duration_seconds": 2.54,
      "text": "Let's do the physical part now."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 250.84,
      "end_seconds": 251.89,
      "duration_seconds": 1.05,
      "text": "No problem."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 253.12,
      "end_seconds": 255.55,
      "duration_seconds": 2.43,
      "text": "Tell me if anything hurts."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 266.98,
      "end_seconds": 270.31,
      "duration_seconds": 3.33,
      "text": "Tapping over the wrist reproduces the tingling."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 271.76,
      "end_seconds": 275.95,
      "duration_seconds": 4.19,
      "text": "A little pressure here, tell me if it's tender."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 290.49,
      "end_seconds": 295.18,
      "duration_seconds": 4.69,
      "text": "Bending the wrist for a minute brings on the numbness."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 296.33,
      "end_seconds": 298.68,
      "duration_seconds": 2.35,
      "text": "Let me look at this properly."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 308.45,
      "end_seconds": 311.33,
      "duration_seconds": 2.88,
      "text": "Power in the thumb is slightly reduced"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 317.1,
      "end_seconds": 319.27,
      "duration_seconds": 2.17,
      "text": "Okay, you can sit up."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 326.92,
      "end_seconds": 348.44,
      "duration_seconds": 21.52,
      "text": "Okay, so my impression is this: It fits best with carpal tunnel syndrome. It could also be a pinched nerve in the neck, so we'll keep that open. I think a nerve conduction study makes sense here, for hand numbness. The result will help us decide whether anything more is needed."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 351.2,
      "end_seconds": 352.57,
      "duration_seconds": 1.37,
      "text": "Fine by me."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 353.93,
      "end_seconds": 358.54,
      "duration_seconds": 4.61,
      "text": "I'm going to order a blood sugar test, for neuropathy screen."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 359.39,
      "end_seconds": 360.5,
      "duration_seconds": 1.11,
      "text": "mm, okay"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 362.21,
      "end_seconds": 380.55,
      "duration_seconds": 18.34,
      "text": "Take short breaks from typing and keep the wrist straight. I think physiotherapy should see you too. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 382.52,
      "end_seconds": 383.22,
      "duration_seconds": 0.7,
      "text": "Understood."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 384.93,
      "end_seconds": 392.25,
      "duration_seconds": 7.32,
      "text": "If the symptoms get worse, that's the point to come in urgently. Let's review you in four weeks."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 393.28,
      "end_seconds": 395.88,
      "duration_seconds": 2.6,
      "text": "Yes, I can do that."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 397.63,
      "end_seconds": 400.58,
      "duration_seconds": 2.95,
      "text": "Call the clinic if you need us."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 401.97,
      "end_seconds": 403.83,
      "duration_seconds": 1.86,
      "text": "No questions. Thank you."
    }
  ]
}