{
  "schema_version": "1.0",
  "encounter_id": "00053",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.15,
      "end_seconds": 6.65,
      "duration_seconds": 5.5,
      "text": "Right, um, sorry I'm a few minutes behind, doctor."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.19,
      "end_seconds": 11.76,
      "duration_seconds": 4.57,
      "text": "You're fine, sit down. So, what brings you in?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 12.51,
      "end_seconds": 17.26,
      "duration_seconds": 4.75,
      "text": "I've been dealing with a tight band-like headache."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 18.86,
      "end_seconds": 21.6,
      "duration_seconds": 2.74,
      "text": "How long are we talking about?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 23.11,
      "end_seconds": 35.58,
      "duration_seconds": 12.47,
      "text": "It's been going on for six months. I'd rather know what's going on than keep guessing. I've never really been one for hospitals."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 37.22,
      "end_seconds": 45.82,
      "duration_seconds": 8.6,
      "text": "Tell me a bit more about it: how bad it gets, how often, and whether anything makes it better or worse."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 46.82,
      "end_seconds": 55.23,
      "duration_seconds": 8.41,
      "text": "I notice it more with stress and long hours on the computer. I'd call it severe."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 56.62,
      "end_seconds": 58.77,
      "duration_seconds": 2.15,
      "text": "Any trouble sleeping as well?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 59.38,
      "end_seconds": 65.78,
      "duration_seconds": 6.4,
      "text": "Mm, yes. There was irritability, yes, but that went away."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 67.86,
      "end_seconds": 74.13,
      "duration_seconds": 6.27,
      "text": "Have you had a tight band-like headache before, or is this the first time?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 75.81,
      "end_seconds": 82.08,
      "duration_seconds": 6.27,
      "text": "Well, a bit, last winter. It settled by itself back then."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 83.56,
      "end_seconds": 86.46,
      "duration_seconds": 2.9,
      "text": "First the numbers, if you don't mind."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 96.11,
      "end_seconds": 97.85,
      "duration_seconds": 1.74,
      "text": "hold still for me.."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 118.82,
      "end_seconds": 131.93,
      "duration_seconds": 13.11,
      "text": "Okay: weight 60 kilos, respiratory rate 18. And blood pressure 113 over 69, pulse 71, height 171 centimetres, SpO2 97 percent on room air, BMI works out to 20.5."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 134.46,
      "end_seconds": 136.7,
      "duration_seconds": 2.24,
      "text": "can I examine you now?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 137.79,
      "end_seconds": 139.07,
      "duration_seconds": 1.28,
      "text": "Mm, okay."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 140.68,
      "end_seconds": 142.24,
      "duration_seconds": 1.56,
      "text": "let me press here"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 151.49,
      "end_seconds": 154.78,
      "duration_seconds": 3.29,
      "text": "your eye movements and reflexes are normal"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 157.82,
      "end_seconds": 164.76,
      "duration_seconds": 6.94,
      "text": "all done, you can get dressed. Have you had any fever, vomiting or weakness?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 166.07,
      "end_seconds": 170.07,
      "duration_seconds": 4.0,
      "text": "Um, no, I'd have mentioned it."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 170.66,
      "end_seconds": 175.83,
      "duration_seconds": 5.17,
      "text": "right. Have you had any jaw pain when chewing or blurred vision?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 176.78,
      "end_seconds": 179.55,
      "duration_seconds": 2.77,
      "text": "Well, nothing like that, no."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 180.77,
      "end_seconds": 184.12,
      "duration_seconds": 3.35,
      "text": "Has your heart given you any trouble?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 184.69,
      "end_seconds": 190.48,
      "duration_seconds": 5.79,
      "text": "okay, so my heart's been fine, as far as I know"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 191.32,
      "end_seconds": 193.79,
      "duration_seconds": 2.47,
      "text": "have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 195.17,
      "end_seconds": 199.41,
      "duration_seconds": 4.24,
      "text": "No, uh, never had any surgery."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 201.25,
      "end_seconds": 202.54,
      "duration_seconds": 1.29,
      "text": "how about smoking?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 203.5,
      "end_seconds": 207.56,
      "duration_seconds": 4.06,
      "text": "No, I don't smoke and never have."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 208.24,
      "end_seconds": 210.48,
      "duration_seconds": 2.24,
      "text": "Tell me about your work."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 212.52,
      "end_seconds": 219.14,
      "duration_seconds": 6.62,
      "text": "I'm a software engineer, so I'm at a screen all day."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 220.76,
      "end_seconds": 222.35,
      "duration_seconds": 1.59,
      "text": "do you live alone?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 224.02,
      "end_seconds": 227.54,
      "duration_seconds": 3.52,
      "text": "Yes, I live on my own."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 229.04,
      "end_seconds": 231.13,
      "duration_seconds": 2.09,
      "text": "How do you eat, generally?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 233.18,
      "end_seconds": 235.9,
      "duration_seconds": 2.72,
      "text": "I skip breakfast most days."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 236.51,
      "end_seconds": 241.15,
      "duration_seconds": 4.64,
      "text": "Any medication at the moment, including things from the pharmacy?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 242.63,
      "end_seconds": 253.4,
      "duration_seconds": 10.77,
      "text": "I'm on amlodipine, 5 milligrams, once a day for my pressure. Oh, I take Combiflam, most days."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 272.3,
      "end_seconds": 277.13,
      "duration_seconds": 4.83,
      "text": "Are there any allergies on your record that that I should check?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 277.93,
      "end_seconds": 280.74,
      "duration_seconds": 2.81,
      "text": "No, no allergies to anything."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 281.48,
      "end_seconds": 283.84,
      "duration_seconds": 2.36,
      "text": "have you got any chronic problems?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 284.5,
      "end_seconds": 288.84,
      "duration_seconds": 4.34,
      "text": "High blood pressure, for about ten years."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 290.41,
      "end_seconds": 291.39,
      "duration_seconds": 0.98,
      "text": "Hm, okay."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 304.32,
      "end_seconds": 339.46,
      "duration_seconds": 35.14,
      "text": "I'll request an eye check, it'll help with headache and eye strain. We'll begin with amitriptyline, 10 milligrams, at night, for six weeks. You take it by mouth. That's for headache prevention. Take a break from the screen every hour and do a few neck stretches. Painkillers on most days can actually make the headaches stick around. If the symptoms get worse, or you feel really unwell, please come to the emergency department."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 340.68,
      "end_seconds": 348.6,
      "duration_seconds": 7.92,
      "text": "I'd like to see you again in four weeks. So, that's it on my side. Anything unclear?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 350.53,
      "end_seconds": 352.82,
      "duration_seconds": 2.29,
      "text": "Thanks so much, doctor."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 354.05,
      "end_seconds": 355.29,
      "duration_seconds": 1.24,
      "text": "Bye for now."
    }
  ]
}