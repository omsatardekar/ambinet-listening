{
  "schema_version": "1.0",
  "encounter_id": "00295",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.76,
      "end_seconds": 4.26,
      "duration_seconds": 3.5,
      "text": "Good morning, doctor. Can I come in?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.24,
      "end_seconds": 12.61,
      "duration_seconds": 6.37,
      "text": "Yes, come in, take a seat. What can I do for you today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 13.98,
      "end_seconds": 18.98,
      "duration_seconds": 5.0,
      "text": "Hello, doctor, I came in with them, if that's okay."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 21.05,
      "end_seconds": 25.59,
      "duration_seconds": 4.54,
      "text": "Alright, of course, please stay. It's helpful to have you here."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 29.1,
      "end_seconds": 33.32,
      "duration_seconds": 4.22,
      "text": "He's been having been feeling low most days, doctor."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 34.37,
      "end_seconds": 36.65,
      "duration_seconds": 2.28,
      "text": "Roughly when did it start?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 38.19,
      "end_seconds": 62.21,
      "duration_seconds": 24.02,
      "text": "It's been about a year now. As for losing interest in things I used to enjoy, I honestly can't say when that began. It might have been last month or the month before. About losing interest in things I used to enjoy, a seven out of ten, I suppose."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 66.17,
      "end_seconds": 68.76,
      "duration_seconds": 2.59,
      "text": "So, any poor appetite as well?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 70.75,
      "end_seconds": 77.64,
      "duration_seconds": 6.89,
      "text": "Yes, I have. So, I've also had trouble sleeping, for two months."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 79.7,
      "end_seconds": 82.39,
      "duration_seconds": 2.69,
      "text": "I'll check your pressure and pulse."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 92.02,
      "end_seconds": 94.1,
      "duration_seconds": 2.08,
      "text": "Okay, give me a moment..."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 114.64,
      "end_seconds": 118.68,
      "duration_seconds": 4.04,
      "text": "Okay: heart rate 65, pressure 108 over 74."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 119.22,
      "end_seconds": 120.85,
      "duration_seconds": 1.63,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 122.24,
      "end_seconds": 124.91,
      "duration_seconds": 2.67,
      "text": "That's fine, we'll come to it."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 126.48,
      "end_seconds": 128.65,
      "duration_seconds": 2.17,
      "text": "Shall we do the examination?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 129.67,
      "end_seconds": 132.46,
      "duration_seconds": 2.79,
      "text": "Stay still while I have a look."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 147.43,
      "end_seconds": 152.45,
      "duration_seconds": 5.02,
      "text": "You're well kempt and speaking clearly, and you maintain good eye contact."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 155.71,
      "end_seconds": 164.82,
      "duration_seconds": 9.11,
      "text": "Thanks for that. Any periods of unusually high energy, hearing voices, drinking more than usual or weight loss at all?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 166.09,
      "end_seconds": 175.29,
      "duration_seconds": 9.2,
      "text": "No periods of unusually high energy, hearing voices, drinking more than usual or weight loss, none of it."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 176.02,
      "end_seconds": 178.72,
      "duration_seconds": 2.7,
      "text": "What about thoughts of harming myself?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 179.28,
      "end_seconds": 182.82,
      "duration_seconds": 3.54,
      "text": "No, none, no thoughts of harming myself."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 183.95,
      "end_seconds": 187.91,
      "duration_seconds": 3.96,
      "text": "How about your heart, any problems like that?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 188.85,
      "end_seconds": 194.44,
      "duration_seconds": 5.59,
      "text": "Right, my heart's been fine, as far as I know."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 195.84,
      "end_seconds": 200.62,
      "duration_seconds": 4.78,
      "text": "Have you ever reacted badly to a medicine or food? Any allergies?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 201.75,
      "end_seconds": 213.37,
      "duration_seconds": 11.62,
      "text": "So, I think I reacted to some antibiotic once, years ago. I don't remember which one, or what happened exactly."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 214.79,
      "end_seconds": 219.26,
      "duration_seconds": 4.47,
      "text": "What about your general health, any conditions you're being treated for?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 220.78,
      "end_seconds": 226.04,
      "duration_seconds": 5.26,
      "text": "I've got an underactive thyroid. Depression, for about ten years."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 227.08,
      "end_seconds": 233.52,
      "duration_seconds": 6.44,
      "text": "Mm-hm. Alright, an underactive thyroid and depression, that matches what I have here."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 244.01,
      "end_seconds": 245.49,
      "duration_seconds": 1.48,
      "text": "And your work?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 246.04,
      "end_seconds": 249.57,
      "duration_seconds": 3.53,
      "text": "I drive a delivery van all day."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 250.61,
      "end_seconds": 252.8,
      "duration_seconds": 2.19,
      "text": "Anything special about your diet?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 256.37,
      "end_seconds": 260.17,
      "duration_seconds": 3.8,
      "text": "I try to avoid too much sugar."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 267.25,
      "end_seconds": 271.07,
      "duration_seconds": 3.82,
      "text": "Let's go through your medication. What are you taking?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 275.84,
      "end_seconds": 279.29,
      "duration_seconds": 3.45,
      "text": "It's thyroxine, 75 micrograms, every morning, doctor."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 279.68,
      "end_seconds": 280.66,
      "duration_seconds": 0.98,
      "text": "Go on."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 285.78,
      "end_seconds": 290.78,
      "duration_seconds": 5.0,
      "text": "I used to take sertraline, but I stopped it."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 300.54,
      "end_seconds": 303.18,
      "duration_seconds": 2.64,
      "text": "Have you had any surgery before?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 303.92,
      "end_seconds": 309.11,
      "duration_seconds": 5.19,
      "text": "Yes, I had a hernia repair, about five years back."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 311.15,
      "end_seconds": 315.1,
      "duration_seconds": 3.95,
      "text": "Any relatives with health problems I should be aware of?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 317.89,
      "end_seconds": 320.29,
      "duration_seconds": 2.4,
      "text": "My father had kidney stones."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 322.08,
      "end_seconds": 335.9,
      "duration_seconds": 13.82,
      "text": "Okay, so my impression is this: I'd lean towards a depressive episode. That's my thinking for now, and it may change as we learn more. A reaction to recent stress is still possible."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 336.63,
      "end_seconds": 340.46,
      "duration_seconds": 3.83,
      "text": "What are the chances it's something bad?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 342.3,
      "end_seconds": 357.69,
      "duration_seconds": 15.39,
      "text": "It's reasonable to be concerned, but right now a depressive episode is my leading thought, not anything worse. I'm sending you for a thyroid test because of low mood. I'm sending you for blood tests because of low mood."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 358.39,
      "end_seconds": 359.95,
      "duration_seconds": 1.56,
      "text": "Okay, that's fine."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 361.3,
      "end_seconds": 372.78,
      "duration_seconds": 11.48,
      "text": "It usually takes a few weeks for the tablet to start helping, so give it time and stay in touch. I'll also refer you to a counsellor."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 374.39,
      "end_seconds": 375.09,
      "duration_seconds": 0.7,
      "text": "Okay."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 377.14,
      "end_seconds": 382.97,
      "duration_seconds": 5.83,
      "text": "I'll want another look in two weeks. Do you have any questions?"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 383.89,
      "end_seconds": 387.05,
      "duration_seconds": 3.16,
      "text": "I mean, thanks so much, doctor."
    }
  ]
}