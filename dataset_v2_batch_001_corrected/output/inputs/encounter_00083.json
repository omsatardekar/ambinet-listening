{
  "schema_version": "1.0",
  "encounter_id": "00083",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.11,
      "end_seconds": 5.87,
      "duration_seconds": 4.76,
      "text": "good afternoon, doctor, the receptionist said you'd see me now"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.94,
      "end_seconds": 12.41,
      "duration_seconds": 4.47,
      "text": "Right on time. Sit, please. How can I help?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 14.08,
      "end_seconds": 18.56,
      "duration_seconds": 4.48,
      "text": "Good morning, doctor. I came along to help out."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 21.9,
      "end_seconds": 25.28,
      "duration_seconds": 3.38,
      "text": "Yes, that's no problem at all. Please sit."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 26.38,
      "end_seconds": 33.82,
      "duration_seconds": 7.44,
      "text": "I've been feeling low most days, and I wanted to get it checked"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 38.87,
      "end_seconds": 41.41,
      "duration_seconds": 2.54,
      "text": "when did you first notice it?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 42.85,
      "end_seconds": 46.85,
      "duration_seconds": 4.0,
      "text": "Yeah, it's been two months, I'm fairly sure."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 48.46,
      "end_seconds": 50.73,
      "duration_seconds": 2.27,
      "text": "how intense does it get?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 52.36,
      "end_seconds": 57.16,
      "duration_seconds": 4.8,
      "text": "Maybe a five out of ten on a bad day."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 58.77,
      "end_seconds": 62.94,
      "duration_seconds": 4.17,
      "text": "So, anything that tends to go along with it?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 63.62,
      "end_seconds": 77.97,
      "duration_seconds": 14.35,
      "text": "It usually comes with trouble sleeping. I've also been losing interest in things I used to enjoy. The trouble sleeping? That's been for four weeks. With trouble sleeping, mostly moderate."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 79.69,
      "end_seconds": 85.99,
      "duration_seconds": 6.3,
      "text": "Let me check a few things. Any periods of unusually high energy or panic attacks?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 86.85,
      "end_seconds": 88.91,
      "duration_seconds": 2.06,
      "text": "Nothing like that, no."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 90.49,
      "end_seconds": 96.05,
      "duration_seconds": 5.56,
      "text": "Any hearing voices, drinking more than usual or thoughts of harming myself?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 97.7,
      "end_seconds": 105.47,
      "duration_seconds": 7.77,
      "text": "No hearing voices, drinking more than usual or thoughts of harming myself, none of it."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 106.18,
      "end_seconds": 110.56,
      "duration_seconds": 4.38,
      "text": "anything with your heart, like skipped beats or fainting?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 111.23,
      "end_seconds": 112.6,
      "duration_seconds": 1.37,
      "text": "Nothing like that."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 114.22,
      "end_seconds": 117.36,
      "duration_seconds": 3.14,
      "text": "Any muscle or joint problems besides this?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 118.08,
      "end_seconds": 119.66,
      "duration_seconds": 1.58,
      "text": "Nothing else aches."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 120.78,
      "end_seconds": 123.6,
      "duration_seconds": 2.82,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 124.17,
      "end_seconds": 125.69,
      "duration_seconds": 1.52,
      "text": "no operations, no"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 140.88,
      "end_seconds": 142.87,
      "duration_seconds": 1.99,
      "text": "What's your current medication list?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 144.14,
      "end_seconds": 156.13,
      "duration_seconds": 11.99,
      "text": "He takes sertraline, 50 milligrams, once a day. He is on thyroxine, 75 micrograms, every morning for my thyroid, I give it to him."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 157.45,
      "end_seconds": 162.13,
      "duration_seconds": 4.68,
      "text": "What about allergies, to medicines or foods or anything else?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 165.94,
      "end_seconds": 168.87,
      "duration_seconds": 2.93,
      "text": "Not that I know, no."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 170.51,
      "end_seconds": 176.22,
      "duration_seconds": 5.71,
      "text": "I'm not sure that's right. I seem to recall a problem with aspirin"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 177.24,
      "end_seconds": 180.58,
      "duration_seconds": 3.34,
      "text": "Maybe, but I don't recall it."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 181.11,
      "end_seconds": 187.5,
      "duration_seconds": 6.39,
      "text": "Alright, so that's unclear. I'll record what each of you said. How about smoking?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 188.28,
      "end_seconds": 192.05,
      "duration_seconds": 3.77,
      "text": "No, I don't smoke and never have."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 193.77,
      "end_seconds": 195.7,
      "duration_seconds": 1.93,
      "text": "And alcohol, how much?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 201.04,
      "end_seconds": 205.57,
      "duration_seconds": 4.53,
      "text": "I have a couple of drinks on the weekend."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 207.63,
      "end_seconds": 208.91,
      "duration_seconds": 1.28,
      "text": "What's your job?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 213.58,
      "end_seconds": 216.77,
      "duration_seconds": 3.19,
      "text": "I teach at a primary school."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 218.58,
      "end_seconds": 220.31,
      "duration_seconds": 1.73,
      "text": "Do you live alone?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 221.24,
      "end_seconds": 224.52,
      "duration_seconds": 3.28,
      "text": "Yes, I live on my own."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 226.59,
      "end_seconds": 228.23,
      "duration_seconds": 1.64,
      "text": "What's your diet like?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 234.22,
      "end_seconds": 238.38,
      "duration_seconds": 4.16,
      "text": "I eat out quite a lot, to be honest."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 239.19,
      "end_seconds": 242.9,
      "duration_seconds": 3.71,
      "text": "Any long-term health problems I should know about?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 244.03,
      "end_seconds": 249.81,
      "duration_seconds": 5.78,
      "text": "Yes, depression. I have an underactive thyroid, for five years."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 250.58,
      "end_seconds": 252.09,
      "duration_seconds": 1.51,
      "text": "right, any more?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 264.5,
      "end_seconds": 266.92,
      "duration_seconds": 2.42,
      "text": "Let me check your vitals now."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 278.71,
      "end_seconds": 280.09,
      "duration_seconds": 1.38,
      "text": "Okay, almost there..."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 296.6,
      "end_seconds": 302.42,
      "duration_seconds": 5.82,
      "text": "okay: temperature is 36.5 degrees, heart rate 77, BP is 116 over 73."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 305.03,
      "end_seconds": 307.04,
      "duration_seconds": 2.01,
      "text": "can I examine you now?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 308.66,
      "end_seconds": 313.49,
      "duration_seconds": 4.83,
      "text": "A A little pressure here, tell me if it's tender."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 326.81,
      "end_seconds": 332.05,
      "duration_seconds": 5.24,
      "text": "You're well kempt and speaking clearly, and you maintain good eye contact."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 335.92,
      "end_seconds": 346.97,
      "duration_seconds": 11.05,
      "text": "thanks for that. So where does that leave us? I can't pin this down yet. We're looking at a depressive episode or a reaction to recent stress"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 354.4,
      "end_seconds": 389.71,
      "duration_seconds": 35.31,
      "text": "Let's get a thyroid test, for low mood. I'm sending you for blood tests because of low mood. Try to keep some routine, a bit of daylight and a short walk each day. It usually takes a few weeks for the tablet to start helping, so give it time and stay in touch. I'll also refer you to a counsellor. Come back or go to emergency straight away if you have thoughts of harming yourself."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 391.64,
      "end_seconds": 397.12,
      "duration_seconds": 5.48,
      "text": "Book a review in two weeks. Is there anything you wanted to ask?"
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 397.95,
      "end_seconds": 402.22,
      "duration_seconds": 4.27,
      "text": "no, I think that's everything thank you, doctor"
    }
  ]
}