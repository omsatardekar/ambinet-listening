{
  "schema_version": "1.0",
  "encounter_id": "00389",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.87,
      "end_seconds": 8.67,
      "duration_seconds": 7.8,
      "text": "Hi doctor, sorry, the lift was out and I had to take the stairs."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 10.64,
      "end_seconds": 14.09,
      "duration_seconds": 3.45,
      "text": "Yes, do sit. Tell me what's been happening."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 15.83,
      "end_seconds": 19.84,
      "duration_seconds": 4.01,
      "text": "Well, I've been having an upset stomach."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 20.61,
      "end_seconds": 23.57,
      "duration_seconds": 2.96,
      "text": "Are you on any regular medication?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 24.68,
      "end_seconds": 28.11,
      "duration_seconds": 3.43,
      "text": "No, I don't take anything regularly."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 33.0,
      "end_seconds": 35.79,
      "duration_seconds": 2.79,
      "text": "How long have you had it?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 36.83,
      "end_seconds": 53.75,
      "duration_seconds": 16.92,
      "text": "Since Friday, that's when it began. I'd rather not end up on lots of tablets if I can avoid it. I thought it would sort itself out, but it hasn't."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 54.19,
      "end_seconds": 57.04,
      "duration_seconds": 2.85,
      "text": "Mm-hm. Is it mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 57.71,
      "end_seconds": 60.75,
      "duration_seconds": 3.04,
      "text": "Pretty mild, if I'm being honest."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 65.76,
      "end_seconds": 71.26,
      "duration_seconds": 5.5,
      "text": "Have you been feeling a bit dizzy after taking all your tablets?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 72.4,
      "end_seconds": 73.87,
      "duration_seconds": 1.47,
      "text": "Yeah, that too."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 81.78,
      "end_seconds": 85.21,
      "duration_seconds": 3.43,
      "text": "Any black stools, fainting, vomiting or falls?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 86.22,
      "end_seconds": 88.46,
      "duration_seconds": 2.24,
      "text": "No. None of those."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 89.65,
      "end_seconds": 92.09,
      "duration_seconds": 2.44,
      "text": "Your breathing, any trouble there?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 92.59,
      "end_seconds": 95.25,
      "duration_seconds": 2.66,
      "text": "No, my breathing's been fine."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 97.11,
      "end_seconds": 99.56,
      "duration_seconds": 2.45,
      "text": "Anything different when you pass water?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 104.1,
      "end_seconds": 105.59,
      "duration_seconds": 1.49,
      "text": "No changes there."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 107.05,
      "end_seconds": 111.21,
      "duration_seconds": 4.16,
      "text": "Right, any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 114.03,
      "end_seconds": 117.54,
      "duration_seconds": 3.51,
      "text": "No, none that I know of."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 128.61,
      "end_seconds": 131.13,
      "duration_seconds": 2.52,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 132.11,
      "end_seconds": 135.31,
      "duration_seconds": 3.2,
      "text": "Oh, no, never had any surgery."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 139.51,
      "end_seconds": 141.96,
      "duration_seconds": 2.45,
      "text": "Is anyone at home with you?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 145.88,
      "end_seconds": 149.52,
      "duration_seconds": 3.64,
      "text": "I share a flat with two friends."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 150.85,
      "end_seconds": 152.98,
      "duration_seconds": 2.13,
      "text": "Do you have a job?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 158.02,
      "end_seconds": 159.86,
      "duration_seconds": 1.84,
      "text": "I'm a self-employed electrician."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 160.4,
      "end_seconds": 165.87,
      "duration_seconds": 5.47,
      "text": "Do you have any allergies to medicines, food, anything at all?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 167.27,
      "end_seconds": 170.45,
      "duration_seconds": 3.18,
      "text": "None, as far as I'm aware."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 174.17,
      "end_seconds": 177.63,
      "duration_seconds": 3.46,
      "text": "First the numbers, if you don't mind."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 188.36,
      "end_seconds": 189.97,
      "duration_seconds": 1.61,
      "text": "Just relax your arm..."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 202.58,
      "end_seconds": 208.86,
      "duration_seconds": 6.28,
      "text": "Okay: oxygen saturation is 98 percent, BP is 118 over 75, heart rate 85."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 210.58,
      "end_seconds": 211.93,
      "duration_seconds": 1.35,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 216.67,
      "end_seconds": 219.44,
      "duration_seconds": 2.77,
      "text": "I'll interpret it once I've examined you."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 221.21,
      "end_seconds": 224.19,
      "duration_seconds": 2.98,
      "text": "If you're comfortable, I'll examine you now."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 224.73,
      "end_seconds": 225.66,
      "duration_seconds": 0.93,
      "text": "Go ahead."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 227.24,
      "end_seconds": 229.37,
      "duration_seconds": 2.13,
      "text": "Bear with me a second."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 244.19,
      "end_seconds": 248.59,
      "duration_seconds": 4.4,
      "text": "Your blood pressure falls a little when you stand."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 250.49,
      "end_seconds": 251.19,
      "duration_seconds": 0.7,
      "text": "Fine."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 256.52,
      "end_seconds": 257.51,
      "duration_seconds": 0.99,
      "text": "Okay, finished."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 269.24,
      "end_seconds": 283.97,
      "duration_seconds": 14.73,
      "text": "Let me tell you where I've got to. The most likely explanation is possible side effects from too many medicines. I want to be honest that this is an impression, not a final answer."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 293.55,
      "end_seconds": 297.24,
      "duration_seconds": 3.69,
      "text": "An ECG is what I'd like next, for dizziness."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 299.01,
      "end_seconds": 300.53,
      "duration_seconds": 1.52,
      "text": "That sounds sensible."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 302.45,
      "end_seconds": 313.49,
      "duration_seconds": 11.04,
      "text": "Bring every box and bottle you have at home to the next visit, even the herbal ones, and we'll sort them together. Come back in a week."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 314.96,
      "end_seconds": 315.66,
      "duration_seconds": 0.7,
      "text": "Fine."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 316.43,
      "end_seconds": 319.87,
      "duration_seconds": 3.44,
      "text": "Good. Let us know how you get on."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 323.51,
      "end_seconds": 324.97,
      "duration_seconds": 1.46,
      "text": "Right. Thanks again."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 326.44,
      "end_seconds": 327.64,
      "duration_seconds": 1.2,
      "text": "All the best."
    }
  ]
}