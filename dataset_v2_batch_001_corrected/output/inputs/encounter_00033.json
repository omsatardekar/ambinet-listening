{
  "schema_version": "1.0",
  "encounter_id": "00033",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 1.35,
      "end_seconds": 8.96,
      "duration_seconds": 7.61,
      "text": "Doctor, I've checked them in and done the preliminary measurements, I'll hand them over when you ask."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 10.93,
      "end_seconds": 14.78,
      "duration_seconds": 3.85,
      "text": "Thanks, that's helpful. Hello, please sit. What's been happening?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 16.19,
      "end_seconds": 21.18,
      "duration_seconds": 4.99,
      "text": "Hello, doctor, I came in with them, if that's okay."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 22.37,
      "end_seconds": 30.13,
      "duration_seconds": 7.76,
      "text": "Honestly, it's blood on the toilet paper, and my family pushed me to come."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 31.88,
      "end_seconds": 35.03,
      "duration_seconds": 3.15,
      "text": "Alright, how long have you had it?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 36.23,
      "end_seconds": 49.56,
      "duration_seconds": 13.33,
      "text": "Honestly I can't say exactly when it started. It might have been last month or the month before, I really can't pin it down."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 50.63,
      "end_seconds": 52.69,
      "duration_seconds": 2.06,
      "text": "How intense does it get?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 54.28,
      "end_seconds": 63.81,
      "duration_seconds": 9.53,
      "text": "Mostly moderate. I've also had pain when I pass stool. I've also had an itchy bottom, since yesterday."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 65.34,
      "end_seconds": 72.79,
      "duration_seconds": 7.45,
      "text": "Okay, so the vitals from earlier. Pressure 114 over 71, SpO2 98 percent on room air, pulse 75."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 73.49,
      "end_seconds": 74.52,
      "duration_seconds": 1.03,
      "text": "Okay, noted."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 76.75,
      "end_seconds": 79.25,
      "duration_seconds": 2.5,
      "text": "So, can I examine you now?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 81.18,
      "end_seconds": 82.47,
      "duration_seconds": 1.29,
      "text": "I'll go gently."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 94.46,
      "end_seconds": 101.45,
      "duration_seconds": 6.99,
      "text": "There's a small external pile at the edge, and I don't see any fissure."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 102.64,
      "end_seconds": 104.7,
      "duration_seconds": 2.06,
      "text": "Almost done with this part."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 111.84,
      "end_seconds": 113.82,
      "duration_seconds": 1.98,
      "text": "Tummy is soft and non-tender."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 116.61,
      "end_seconds": 120.89,
      "duration_seconds": 4.28,
      "text": "Good, that's the examination. Have you had any fever?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 121.6,
      "end_seconds": 122.97,
      "duration_seconds": 1.37,
      "text": "No. No fever."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 123.58,
      "end_seconds": 130.17,
      "duration_seconds": 6.59,
      "text": "Um, actually, doctor, I did notice fever. He doesn't always say."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 130.68,
      "end_seconds": 136.3,
      "duration_seconds": 5.62,
      "text": "No, I don't think I did. Maybe a little, I'm not sure."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 137.51,
      "end_seconds": 150.62,
      "duration_seconds": 13.11,
      "text": "Alright, I'll note both what you've said and what you've noticed. Okay, did you get change in bowel habit, family history of bowel cancer or black stools?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 151.2,
      "end_seconds": 153.06,
      "duration_seconds": 1.86,
      "text": "No. None of those."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 153.68,
      "end_seconds": 156.95,
      "duration_seconds": 3.27,
      "text": "Any weight loss or abdominal pain at all?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 158.16,
      "end_seconds": 161.97,
      "duration_seconds": 3.81,
      "text": "No, no weight loss or abdominal pain."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 163.44,
      "end_seconds": 167.36,
      "duration_seconds": 3.92,
      "text": "Anything on the skin I should know about?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 168.3,
      "end_seconds": 169.23,
      "duration_seconds": 0.93,
      "text": "No rashes."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 170.45,
      "end_seconds": 174.89,
      "duration_seconds": 4.44,
      "text": "What about allergies, to medicines or foods or anything else?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 176.04,
      "end_seconds": 184.05,
      "duration_seconds": 8.01,
      "text": "I was told I'm allergic to latex, but I don't remember what reaction I had."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 200.93,
      "end_seconds": 204.15,
      "duration_seconds": 3.22,
      "text": "Right, what medicines do you take regularly?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 205.62,
      "end_seconds": 220.55,
      "duration_seconds": 14.93,
      "text": "He is on iron tablets, once a day, I give it to him. He is on sertraline, 50 milligrams, once a day for my mood, I give it to him."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 221.13,
      "end_seconds": 222.92,
      "duration_seconds": 1.79,
      "text": "And for how long?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 224.81,
      "end_seconds": 226.77,
      "duration_seconds": 1.96,
      "text": "Nearly five years now."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 228.07,
      "end_seconds": 229.92,
      "duration_seconds": 1.85,
      "text": "Do you live alone?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 231.99,
      "end_seconds": 234.84,
      "duration_seconds": 2.85,
      "text": "Yes, I live on my own."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 236.13,
      "end_seconds": 238.54,
      "duration_seconds": 2.41,
      "text": "Do you have a job?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 239.26,
      "end_seconds": 241.11,
      "duration_seconds": 1.85,
      "text": "I'm a self-employed electrician."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 254.69,
      "end_seconds": 257.08,
      "duration_seconds": 2.39,
      "text": "Have you got any chronic problems?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 259.15,
      "end_seconds": 264.78,
      "duration_seconds": 5.63,
      "text": "I have low haemoglobin. I have migraines, for two years."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 266.07,
      "end_seconds": 266.77,
      "duration_seconds": 0.7,
      "text": "Understood."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 268.11,
      "end_seconds": 269.74,
      "duration_seconds": 1.63,
      "text": "I've got depression."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 271.48,
      "end_seconds": 281.44,
      "duration_seconds": 9.96,
      "text": "Right, so depression is already on your record. We'll keep that in mind today. Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 282.05,
      "end_seconds": 283.59,
      "duration_seconds": 1.54,
      "text": "No operations, no."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 287.15,
      "end_seconds": 291.24,
      "duration_seconds": 4.09,
      "text": "So, is there a family history of anything significant?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 296.21,
      "end_seconds": 301.35,
      "duration_seconds": 5.14,
      "text": "My mother has diabetes. My mother had high blood pressure."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 305.7,
      "end_seconds": 322.9,
      "duration_seconds": 17.2,
      "text": "Okay, so my impression is this: This looks most like haemorrhoids. I want to be honest that this is an impression, not a final answer. I'd also keep something higher up in the bowel that we shouldn't miss in mind."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 327.04,
      "end_seconds": 331.97,
      "duration_seconds": 4.93,
      "text": "Well, uh, should I be worried about this?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 333.61,
      "end_seconds": 342.1,
      "duration_seconds": 8.49,
      "text": "I understand the worry. At the moment I'd say it's haemorrhoids, and we'll know more once the a colonoscopy is back."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 360.42,
      "end_seconds": 372.01,
      "duration_seconds": 11.59,
      "text": "I think a colonoscopy makes sense here, for rectal bleeding. That will help us see what's going on underneath and decide the next step."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 373.43,
      "end_seconds": 374.95,
      "duration_seconds": 1.52,
      "text": "Okay, that's fine."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 375.45,
      "end_seconds": 402.92,
      "duration_seconds": 27.47,
      "text": "I'm sending you for blood tests because of rectal bleeding. We'll begin with lactulose, 15 ml, at night, for two weeks. You take it by mouth. It's for constipation. Soak in a warm bath for ten minutes after you pass stool, and don't strain. Don't skip meals, and try to eat smaller portions more often through the day. We'll refer you to a colorectal surgeon."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 404.81,
      "end_seconds": 417.81,
      "duration_seconds": 13.0,
      "text": "One warning sign to remember: you pass a lot of blood or feel faint. In that case don't wait. We'll catch up in three weeks. Look after yourself."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 418.37,
      "end_seconds": 420.54,
      "duration_seconds": 2.17,
      "text": "Thanks, that was helpful."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 422.0,
      "end_seconds": 423.32,
      "duration_seconds": 1.32,
      "text": "See you then."
    }
  ]
}