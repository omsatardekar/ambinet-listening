{
  "schema_version": "1.0",
  "encounter_id": "00252",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.32,
      "end_seconds": 5.29,
      "duration_seconds": 3.97,
      "text": "Hi, nice to see you. Sit down, please."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 5.91,
      "end_seconds": 9.15,
      "duration_seconds": 3.24,
      "text": "Thanks. Sorry, I'm a little early."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 9.84,
      "end_seconds": 11.6,
      "duration_seconds": 1.76,
      "text": "Right, what's the trouble?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 12.66,
      "end_seconds": 27.51,
      "duration_seconds": 14.85,
      "text": "Doctor, uh, it's pain in both knees. It's getting on my nerves now. I'm not great at remembering details, so bear with me."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 28.52,
      "end_seconds": 31.95,
      "duration_seconds": 3.43,
      "text": "How long has this been going on?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 33.29,
      "end_seconds": 50.08,
      "duration_seconds": 16.79,
      "text": "Oh, um, it's been going on for two months. I told myself I'd wait and see, and here I am. I thought it would sort itself out, but it hasn't."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 50.39,
      "end_seconds": 56.48,
      "duration_seconds": 6.09,
      "text": "Uh-huh. Okay, give me more detail on it, whatever comes to mind."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 57.37,
      "end_seconds": 87.62,
      "duration_seconds": 30.25,
      "text": "Okay, um, so I'd give it a five, out of ten. Squatting definitely sets it off. Oh, and a grinding sound when I move. That's been about the same, about three months. Oh, about grinding sound when I move, mild, I'd say. Oh, and difficulty getting up from a chair. That's been about the same, six months."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 103.35,
      "end_seconds": 106.24,
      "duration_seconds": 2.89,
      "text": "Right, have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 108.27,
      "end_seconds": 111.05,
      "duration_seconds": 2.78,
      "text": "No, never had any surgery."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 115.79,
      "end_seconds": 119.48,
      "duration_seconds": 3.69,
      "text": "Moving on to your background, any past medical history?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 122.27,
      "end_seconds": 126.66,
      "duration_seconds": 4.39,
      "text": "Arthritis in my knees, for about ten years."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 127.59,
      "end_seconds": 139.12,
      "duration_seconds": 11.53,
      "text": "Right, right. Yes, arthritis in your knees is known to us, good to have that clear. What medicines are you taking at the moment?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 141.19,
      "end_seconds": 147.75,
      "duration_seconds": 6.56,
      "text": "Paracetamol. I take it 650 milligrams, when needed for the knee pain."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 149.63,
      "end_seconds": 151.51,
      "duration_seconds": 1.88,
      "text": "Alright, and your work?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 156.47,
      "end_seconds": 160.61,
      "duration_seconds": 4.14,
      "text": "I drive a delivery van all day."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 162.49,
      "end_seconds": 164.59,
      "duration_seconds": 2.1,
      "text": "How do you eat, generally?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 165.1,
      "end_seconds": 167.9,
      "duration_seconds": 2.8,
      "text": "I skip breakfast most days."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 168.81,
      "end_seconds": 175.58,
      "duration_seconds": 6.77,
      "text": "Any pain in other joints, redness over the knee, fever or back pain at all?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 176.86,
      "end_seconds": 179.92,
      "duration_seconds": 3.06,
      "text": "No, not any of them."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 180.8,
      "end_seconds": 183.69,
      "duration_seconds": 2.89,
      "text": "Alright, any rashes or skin problems otherwise?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 184.58,
      "end_seconds": 185.75,
      "duration_seconds": 1.17,
      "text": "No rashes."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 187.63,
      "end_seconds": 196.62,
      "duration_seconds": 8.99,
      "text": "Doctor, I've got the readings for you. Respiratory rate 14, BP is 111 over 70, pulse 71, oxygen saturation is 99 percent."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 197.59,
      "end_seconds": 198.59,
      "duration_seconds": 1.0,
      "text": "Okay, noted."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 200.73,
      "end_seconds": 204.3,
      "duration_seconds": 3.57,
      "text": "Okay, I'll examine you now, bear with me."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 211.8,
      "end_seconds": 212.79,
      "duration_seconds": 0.99,
      "text": "That's fine."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 213.61,
      "end_seconds": 215.94,
      "duration_seconds": 2.33,
      "text": "Tell me if anything hurts."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 234.42,
      "end_seconds": 241.16,
      "duration_seconds": 6.74,
      "text": "Bending is limited to about a right angle, and it hurts at the end."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 244.96,
      "end_seconds": 256.61,
      "duration_seconds": 11.65,
      "text": "That's all I need, thank you. Having listened and examined, I don't have a clear answer today: osteoarthritis of the knees is possible, and so is a meniscal problem."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 268.86,
      "end_seconds": 300.16,
      "duration_seconds": 31.3,
      "text": "Blood tests is what I'd like next, for joint pain. I'll request an X-ray of both knees, it'll help with knee pain. For this, etoricoxib, 60 milligrams, once a day, for five days. It's for knee pain. Losing even a few kilos takes a lot of load off the knees, and I'd like you to do the strengthening exercises. Don't skip meals, and try to eat smaller portions more often through the day."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 302.07,
      "end_seconds": 319.19,
      "duration_seconds": 17.12,
      "text": "I'm going to send a referral to physiotherapy. Keep an eye out, and if the symptoms get worse, call us the same day or go to emergency. Come back in four weeks. Okay, we're done for today. Take care."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 324.52,
      "end_seconds": 329.52,
      "duration_seconds": 5.0,
      "text": "Yeah, no, I think that's everything. Thank you, doctor."
    }
  ]
}