{
  "schema_version": "1.0",
  "encounter_id": "00212",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.9,
      "end_seconds": 5.5,
      "duration_seconds": 4.6,
      "text": "Hello, come through. Tell me from the beginning, what's been happening?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 6.38,
      "end_seconds": 13.32,
      "duration_seconds": 6.94,
      "text": "doctor, uh, it's swelling in my left calf it's getting on my nerves now"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 16.4,
      "end_seconds": 20.6,
      "duration_seconds": 4.2,
      "text": "Let's go through your medication. What are you taking?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 21.37,
      "end_seconds": 28.01,
      "duration_seconds": 6.64,
      "text": "Telmisartan, 40 milligrams, once a day. Paracetamol, 500 milligrams, when needed."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 29.06,
      "end_seconds": 31.31,
      "duration_seconds": 2.25,
      "text": "Roughly when did it start?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 32.43,
      "end_seconds": 41.25,
      "duration_seconds": 8.82,
      "text": "I'm not sure when it began, to be honest. Some weeks ago, but I can't say how many."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 42.48,
      "end_seconds": 52.97,
      "duration_seconds": 10.49,
      "text": "Tell me a bit more about it: how bad it gets, how often, and whether anything makes it better or worse."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 54.7,
      "end_seconds": 74.73,
      "duration_seconds": 20.03,
      "text": "I get some relief from raising the leg. I'd call it mild. Oh, and pain in that calf. That's been about the same, one week. Uh, uh, with pain in that calf, I'd call it severe."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 75.44,
      "end_seconds": 80.15,
      "duration_seconds": 4.71,
      "text": "Have you had any chest pain or coughing up blood?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 81.4,
      "end_seconds": 83.4,
      "duration_seconds": 2.0,
      "text": "Nothing like that, no."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 85.17,
      "end_seconds": 89.55,
      "duration_seconds": 4.38,
      "text": "have you had any recent injury to the leg or fever?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 91.11,
      "end_seconds": 93.36,
      "duration_seconds": 2.25,
      "text": "Nothing like that, no."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 94.54,
      "end_seconds": 96.64,
      "duration_seconds": 2.1,
      "text": "Any trouble with the waterworks?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 97.59,
      "end_seconds": 99.22,
      "duration_seconds": 1.63,
      "text": "Nothing there, no."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 100.27,
      "end_seconds": 103.06,
      "duration_seconds": 2.79,
      "text": "Any breathing difficulties apart from this?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 104.74,
      "end_seconds": 105.73,
      "duration_seconds": 0.99,
      "text": "Breathing's normal."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 124.31,
      "end_seconds": 127.75,
      "duration_seconds": 3.44,
      "text": "right, before I prescribe anything, any allergies?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 129.17,
      "end_seconds": 132.9,
      "duration_seconds": 3.73,
      "text": "No allergies that I know of, no."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 143.05,
      "end_seconds": 146.88,
      "duration_seconds": 3.83,
      "text": "And what do you do for a living?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 147.55,
      "end_seconds": 151.01,
      "duration_seconds": 3.46,
      "text": "I work night shifts at a warehouse."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 151.58,
      "end_seconds": 154.19,
      "duration_seconds": 2.61,
      "text": "Is anyone at home with you?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 154.95,
      "end_seconds": 158.2,
      "duration_seconds": 3.25,
      "text": "I share a flat with two friends."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 159.46,
      "end_seconds": 162.83,
      "duration_seconds": 3.37,
      "text": "Any long-term health problems I should know about?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 164.33,
      "end_seconds": 169.33,
      "duration_seconds": 5.0,
      "text": "I have high blood pressure, for nearly five years"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 171.17,
      "end_seconds": 181.3,
      "duration_seconds": 10.13,
      "text": "yes, high blood pressure is known to us, good to have that clear. Okay, before we go on, a few quick readings"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 190.23,
      "end_seconds": 191.86,
      "duration_seconds": 1.63,
      "text": "hold still for me.."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 206.17,
      "end_seconds": 215.84,
      "duration_seconds": 9.67,
      "text": "okay: temperature is 36.7 degrees, SpO2 97 percent on room air, pressure 123 over 88, pulse is 107 beats a a minute"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 218.07,
      "end_seconds": 220.33,
      "duration_seconds": 2.26,
      "text": "Okay, a quick examination now."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 221.14,
      "end_seconds": 222.09,
      "duration_seconds": 0.95,
      "text": "Go ahead."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 223.9,
      "end_seconds": 227.77,
      "duration_seconds": 3.87,
      "text": "A little pressure here, tell me if it's tender."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 235.37,
      "end_seconds": 237.41,
      "duration_seconds": 2.04,
      "text": "The right leg looks normal."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 240.55,
      "end_seconds": 248.91,
      "duration_seconds": 8.36,
      "text": "Good, that's the examination. Having listened and examined, this is probably a possible deep vein clot. We shouldn't forget cellulitis."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 249.72,
      "end_seconds": 252.4,
      "duration_seconds": 2.68,
      "text": "Is this going to go away?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 254.02,
      "end_seconds": 261.99,
      "duration_seconds": 7.97,
      "text": "I can't promise yet, but most people with a possible deep vein clot do well once it's treated properly"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 270.01,
      "end_seconds": 288.83,
      "duration_seconds": 18.82,
      "text": "I think a Doppler scan of the leg makes sense here, for suspected DVT. I'm sending you for a D-dimer blood test because of suspected DVT. I'd rather check than guess, and this is the quickest way to know more."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 289.55,
      "end_seconds": 291.16,
      "duration_seconds": 1.61,
      "text": "Fine by me."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 291.75,
      "end_seconds": 302.87,
      "duration_seconds": 11.12,
      "text": "Keep walking gently, and don't massage the calf. If you get chest pain or sudden breathlessness, or you feel really unwell, please come to the emergency department."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 303.61,
      "end_seconds": 304.31,
      "duration_seconds": 0.7,
      "text": "Understood."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 305.84,
      "end_seconds": 308.58,
      "duration_seconds": 2.74,
      "text": "Book a review in two days."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 309.49,
      "end_seconds": 311.15,
      "duration_seconds": 1.66,
      "text": "sure, that's doable"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 312.13,
      "end_seconds": 315.08,
      "duration_seconds": 2.95,
      "text": "that's everything from me any other questions?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 316.59,
      "end_seconds": 319.49,
      "duration_seconds": 2.9,
      "text": "yeah, okay, thank you. Bye"
    }
  ]
}