{
  "schema_version": "1.0",
  "encounter_id": "00006",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.23,
      "end_seconds": 5.02,
      "duration_seconds": 3.79,
      "text": "Morning, doctor, I hope I'm not interrupting."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.83,
      "end_seconds": 10.76,
      "duration_seconds": 3.93,
      "text": "You're fine, sit down. So, what brings you in?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 12.62,
      "end_seconds": 17.95,
      "duration_seconds": 5.33,
      "text": "Oh, you know, mainly I've been snoring. That's why I came."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 18.62,
      "end_seconds": 22.13,
      "duration_seconds": 3.51,
      "text": "Tell me what you take day to day."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 26.13,
      "end_seconds": 29.94,
      "duration_seconds": 3.81,
      "text": "Rosuvastatin. I take it 10 milligrams, at night."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 30.47,
      "end_seconds": 33.15,
      "duration_seconds": 2.68,
      "text": "How long are we talking about?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 34.89,
      "end_seconds": 37.01,
      "duration_seconds": 2.12,
      "text": "About... well, two months."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 38.09,
      "end_seconds": 42.98,
      "duration_seconds": 4.89,
      "text": "Have you been putting on weight over the last year?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 48.35,
      "end_seconds": 51.07,
      "duration_seconds": 2.72,
      "text": "Yes, for about a month."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 60.92,
      "end_seconds": 64.31,
      "duration_seconds": 3.39,
      "text": "Have you had chest pain, by any chance?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 65.64,
      "end_seconds": 70.77,
      "duration_seconds": 5.13,
      "text": "So, uh, I haven't noticed any chest pain."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 71.51,
      "end_seconds": 76.91,
      "duration_seconds": 5.4,
      "text": "Alright, any heat intolerance, low mood or irregular periods at all?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 78.35,
      "end_seconds": 84.57,
      "duration_seconds": 6.22,
      "text": "Um, no heat intolerance, low mood or irregular periods, none of it."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 85.2,
      "end_seconds": 87.98,
      "duration_seconds": 2.78,
      "text": "Has your heart given you any trouble?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 88.59,
      "end_seconds": 94.3,
      "duration_seconds": 5.71,
      "text": "Yeah, my heart's been fine, as far as I know."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 95.92,
      "end_seconds": 99.74,
      "duration_seconds": 3.82,
      "text": "Any long-term health problems I should know about?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 103.51,
      "end_seconds": 111.5,
      "duration_seconds": 7.99,
      "text": "High cholesterol, for nearly five years. I took the morning off to come in today."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 113.14,
      "end_seconds": 113.99,
      "duration_seconds": 0.85,
      "text": "And then?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 115.78,
      "end_seconds": 121.37,
      "duration_seconds": 5.59,
      "text": "Tell me about your routine, work, habits, that sort of thing."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 124.62,
      "end_seconds": 142.81,
      "duration_seconds": 18.19,
      "text": "I've never smoked. I have a couple of drinks on the weekend. I work in an office, mostly sitting at a desk. I play badminton on Sundays. I live with my family, my husband and two kids."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 143.9,
      "end_seconds": 149.44,
      "duration_seconds": 5.54,
      "text": "Have you ever reacted badly to a medicine or food? Any allergies?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 150.39,
      "end_seconds": 153.98,
      "duration_seconds": 3.59,
      "text": "Yes, dust, it gives me sneezing."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 170.77,
      "end_seconds": 172.11,
      "duration_seconds": 1.34,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 174.09,
      "end_seconds": 175.7,
      "duration_seconds": 1.61,
      "text": "No operations, no."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 177.78,
      "end_seconds": 180.83,
      "duration_seconds": 3.05,
      "text": "Alright, I'll check your pressure and pulse."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 192.29,
      "end_seconds": 194.5,
      "duration_seconds": 2.21,
      "text": "Okay, give me a moment..."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 208.64,
      "end_seconds": 220.34,
      "duration_seconds": 11.7,
      "text": "Okay: heart rate 76, respiratory rate 14, height 154 centimetres. And temperature 36.6, weight 64 kilos, BMI works out to 27.0, BP is 127 over 76."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 220.84,
      "end_seconds": 222.33,
      "duration_seconds": 1.49,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 223.48,
      "end_seconds": 226.75,
      "duration_seconds": 3.27,
      "text": "Let's look at it together in a minute."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 234.49,
      "end_seconds": 244.93,
      "duration_seconds": 10.44,
      "text": "Okay, so my impression from what you've said is this: It points towards weight gain with a metabolic cause that needs checking."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 246.06,
      "end_seconds": 249.34,
      "duration_seconds": 3.28,
      "text": "Hmm, doctor, is this dangerous?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 250.11,
      "end_seconds": 266.66,
      "duration_seconds": 16.55,
      "text": "Nothing I've seen today points to an emergency. It looks like weight gain with a metabolic cause that needs checking, but I'd like to confirm. I'm going to order a thyroid test, for weight gain."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 268.39,
      "end_seconds": 272.23,
      "duration_seconds": 3.84,
      "text": "Hmm, where do I go for that?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 273.72,
      "end_seconds": 304.21,
      "duration_seconds": 30.49,
      "text": "Let's get a lipid profile, for metabolic risk. I think a sleep study makes sense here, for snoring and sleepiness. Start with small, specific changes: smaller portions, no sugary drinks, a thirty-minute walk most days. A dietitian would be the right next step, I'll refer you. If it hasn't settled next month, we'd think about an HbA1c, but not now. Okay, I think we're finished. Is everything clear?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 305.05,
      "end_seconds": 306.5,
      "duration_seconds": 1.45,
      "text": "Right. Thanks again."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 307.77,
      "end_seconds": 309.0,
      "duration_seconds": 1.23,
      "text": "Safe journey home."
    }
  ]
}