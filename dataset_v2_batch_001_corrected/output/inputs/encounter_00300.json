{
  "schema_version": "1.0",
  "encounter_id": "00300",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.71,
      "end_seconds": 4.44,
      "duration_seconds": 3.73,
      "text": "Morning, doctor, I hope I'm not interrupting."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.36,
      "end_seconds": 9.32,
      "duration_seconds": 3.96,
      "text": "You're fine, sit down. So, what brings you in?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 10.74,
      "end_seconds": 21.6,
      "duration_seconds": 10.86,
      "text": "Doctor, it's a routine check-up. It's getting on my nerves now. I did try to ignore it for a while."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 27.04,
      "end_seconds": 30.38,
      "duration_seconds": 3.34,
      "text": "Have you had a bit of back stiffness?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 32.36,
      "end_seconds": 56.01,
      "duration_seconds": 23.65,
      "text": "Yes, about the same, about a week. With bit of back stiffness, mostly moderate. It happens a couple of times a week. I've also had mild headaches now and then, for four weeks. About mild headaches now and then, I'd say a couple of times a week."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 67.6,
      "end_seconds": 71.1,
      "duration_seconds": 3.5,
      "text": "Any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 73.16,
      "end_seconds": 76.93,
      "duration_seconds": 3.77,
      "text": "No, nothing, I've generally been healthy."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 80.47,
      "end_seconds": 81.79,
      "duration_seconds": 1.32,
      "text": "Do you smoke?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 82.5,
      "end_seconds": 84.14,
      "duration_seconds": 1.64,
      "text": "I've never smoked."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 85.45,
      "end_seconds": 89.07,
      "duration_seconds": 3.62,
      "text": "And what do you do for a living?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 89.95,
      "end_seconds": 93.41,
      "duration_seconds": 3.46,
      "text": "I work night shifts at a warehouse."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 98.03,
      "end_seconds": 100.82,
      "duration_seconds": 2.79,
      "text": "Is anyone at home with you?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 102.26,
      "end_seconds": 106.46,
      "duration_seconds": 4.2,
      "text": "I share a flat with two friends."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 107.96,
      "end_seconds": 112.15,
      "duration_seconds": 4.19,
      "text": "Anyone in the family with similar problems or other conditions?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 113.57,
      "end_seconds": 118.18,
      "duration_seconds": 4.61,
      "text": "I mean, my mother had high blood pressure."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 120.19,
      "end_seconds": 121.64,
      "duration_seconds": 1.45,
      "text": "Any regular medication?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 123.13,
      "end_seconds": 126.67,
      "duration_seconds": 3.54,
      "text": "No, I don't take anything regularly."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 127.33,
      "end_seconds": 128.94,
      "duration_seconds": 1.61,
      "text": "Any shortness of breath?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 134.54,
      "end_seconds": 139.75,
      "duration_seconds": 5.21,
      "text": "So, not that I've noticed, no shortness of breath."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 141.84,
      "end_seconds": 147.54,
      "duration_seconds": 5.7,
      "text": "A few quick ones: blood in the stool, weight loss or low mood?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 148.6,
      "end_seconds": 152.73,
      "duration_seconds": 4.13,
      "text": "Oh, none, as far as I know."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 154.04,
      "end_seconds": 156.86,
      "duration_seconds": 2.82,
      "text": "Is your urine normal, no changes?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 158.35,
      "end_seconds": 163.05,
      "duration_seconds": 4.7,
      "text": "Yeah, that's normal as far as I know."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 164.72,
      "end_seconds": 166.55,
      "duration_seconds": 1.83,
      "text": "How's your breathing otherwise?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 167.46,
      "end_seconds": 171.35,
      "duration_seconds": 3.89,
      "text": "Okay, so no, my breathing's been fine."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 183.6,
      "end_seconds": 186.18,
      "duration_seconds": 2.58,
      "text": "Let me check your vitals now."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 193.8,
      "end_seconds": 195.37,
      "duration_seconds": 1.57,
      "text": "Rest your hand here..."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 213.45,
      "end_seconds": 219.56,
      "duration_seconds": 6.11,
      "text": "Okay: respiratory rate 15, pulse 73. And blood pressure 120 over 78, temperature 36.8."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 221.28,
      "end_seconds": 224.75,
      "duration_seconds": 3.47,
      "text": "Let me examine, it won't take long."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 225.94,
      "end_seconds": 228.31,
      "duration_seconds": 2.37,
      "text": "Let me just check something."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 239.55,
      "end_seconds": 242.2,
      "duration_seconds": 2.65,
      "text": "Heart and lung sounds are normal."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 258.39,
      "end_seconds": 259.09,
      "duration_seconds": 0.7,
      "text": "Sure."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 260.6,
      "end_seconds": 262.91,
      "duration_seconds": 2.31,
      "text": "Almost done with this part."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 273.96,
      "end_seconds": 276.84,
      "duration_seconds": 2.88,
      "text": "Your tummy is soft with no tenderness."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 279.95,
      "end_seconds": 291.75,
      "duration_seconds": 11.8,
      "text": "Okay, finished. From what you've told me and what I found, it points towards generally well, nothing worrying today. A tendency towards high cholesterol is still possible."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 292.39,
      "end_seconds": 295.68,
      "duration_seconds": 3.29,
      "text": "Is this going to go away?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 297.31,
      "end_seconds": 315.67,
      "duration_seconds": 18.36,
      "text": "Nothing I've seen today points to an emergency. It looks like generally well, nothing worrying today. Keep up regular exercise, around a hundred and fifty minutes a week, and go easy on processed food. Right, that's all. Go gently."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 319.86,
      "end_seconds": 324.06,
      "duration_seconds": 4.2,
      "text": "That's everything I wanted to ask. Thank you."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 325.2,
      "end_seconds": 326.4,
      "duration_seconds": 1.2,
      "text": "All the best."
    }
  ]
}