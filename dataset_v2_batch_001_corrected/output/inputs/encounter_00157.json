{
  "schema_version": "1.0",
  "encounter_id": "00157",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.83,
      "end_seconds": 4.78,
      "duration_seconds": 3.95,
      "text": "Hi there, come on in. Right, what's the trouble?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 6.34,
      "end_seconds": 10.93,
      "duration_seconds": 4.59,
      "text": "Doctor, it's sneezing fits. It's getting on my nerves now."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 11.53,
      "end_seconds": 14.93,
      "duration_seconds": 3.4,
      "text": "Tell me what you take day to day."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 16.95,
      "end_seconds": 21.23,
      "duration_seconds": 4.28,
      "text": "I take cetirizine, 10 milligrams, when it flares."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 23.31,
      "end_seconds": 25.97,
      "duration_seconds": 2.66,
      "text": "How long are we talking about?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 27.59,
      "end_seconds": 36.3,
      "duration_seconds": 8.71,
      "text": "I've, I've had it since last weekend. I told myself I'd wait and see, and here I am."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 38.32,
      "end_seconds": 41.72,
      "duration_seconds": 3.4,
      "text": "Anything you do that brings it on?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 46.7,
      "end_seconds": 53.95,
      "duration_seconds": 7.25,
      "text": "I notice it more with early mornings. There's a blocked nose at night as well."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 70.25,
      "end_seconds": 75.63,
      "duration_seconds": 5.38,
      "text": "Did you get loss of smell, facial pain, fever or shortness of breath?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 76.34,
      "end_seconds": 77.88,
      "duration_seconds": 1.54,
      "text": "No, nothing there."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 78.1,
      "end_seconds": 81.62,
      "duration_seconds": 3.52,
      "text": "Sure. And your skin, any changes there?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 83.44,
      "end_seconds": 84.43,
      "duration_seconds": 0.99,
      "text": "Skin's normal."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 95.68,
      "end_seconds": 98.12,
      "duration_seconds": 2.44,
      "text": "Any drug or food allergies?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 99.86,
      "end_seconds": 102.82,
      "duration_seconds": 2.96,
      "text": "None, as far as I'm aware."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 104.52,
      "end_seconds": 106.51,
      "duration_seconds": 1.99,
      "text": "Do you exercise at all?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 107.98,
      "end_seconds": 114.09,
      "duration_seconds": 6.11,
      "text": "I go to the gym a couple of times a week."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 117.65,
      "end_seconds": 119.68,
      "duration_seconds": 2.03,
      "text": "Are you living with family?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 120.2,
      "end_seconds": 124.13,
      "duration_seconds": 3.93,
      "text": "I stay with my daughter and her family."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 125.06,
      "end_seconds": 128.99,
      "duration_seconds": 3.93,
      "text": "Any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 130.4,
      "end_seconds": 134.83,
      "duration_seconds": 4.43,
      "text": "Um, no, I've never had anything serious."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 135.49,
      "end_seconds": 139.88,
      "duration_seconds": 4.39,
      "text": "Let's get your blood pressure and the other basics."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 147.58,
      "end_seconds": 149.8,
      "duration_seconds": 2.22,
      "text": "Okay, give me a moment..."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 166.66,
      "end_seconds": 175.47,
      "duration_seconds": 8.81,
      "text": "Okay: respiratory rate 16, pressure 123 over 68, SpO2 98 percent on room air, temperature is 36.5 degrees, pulse 83."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 176.58,
      "end_seconds": 179.94,
      "duration_seconds": 3.36,
      "text": "Let me have a look at you."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 181.57,
      "end_seconds": 183.83,
      "duration_seconds": 2.26,
      "text": "Almost done with this part."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 193.21,
      "end_seconds": 195.66,
      "duration_seconds": 2.45,
      "text": "Chest is clear, no wheeze."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 196.77,
      "end_seconds": 199.07,
      "duration_seconds": 2.3,
      "text": "Bear with me a second."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 215.09,
      "end_seconds": 219.03,
      "duration_seconds": 3.94,
      "text": "The inside of your nose is pale and swollen."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 222.45,
      "end_seconds": 224.52,
      "duration_seconds": 2.07,
      "text": "Good, that's the examination."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 237.09,
      "end_seconds": 243.85,
      "duration_seconds": 6.76,
      "text": "Let me tell you where I've got to. The most likely explanation is allergic rhinitis."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 245.0,
      "end_seconds": 247.37,
      "duration_seconds": 2.37,
      "text": "Do you think it's serious?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 249.07,
      "end_seconds": 257.34,
      "duration_seconds": 8.27,
      "text": "Nothing I've seen today points to an emergency. It looks like allergic rhinitis, but I'd like to confirm."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 264.83,
      "end_seconds": 293.76,
      "duration_seconds": 28.93,
      "text": "I want an allergy test done, that's for allergic rhinitis. What I'm giving you is fluticasone nasal spray, 50 micrograms, one spray each side daily, for four weeks. It's for allergic rhinitis. Keep the windows closed in the early morning and wash the bedsheets weekly in hot water. Keep an eye out, and if the symptoms get worse, call us the same day or go to emergency."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 295.4,
      "end_seconds": 300.45,
      "duration_seconds": 5.05,
      "text": "Alright, uh, I know what to look for."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 302.47,
      "end_seconds": 304.83,
      "duration_seconds": 2.36,
      "text": "Book a review in four weeks."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 306.63,
      "end_seconds": 310.71,
      "duration_seconds": 4.08,
      "text": "I'll make the appointment on my way out."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 312.26,
      "end_seconds": 313.55,
      "duration_seconds": 1.29,
      "text": "Any last questions?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 314.83,
      "end_seconds": 318.31,
      "duration_seconds": 3.48,
      "text": "One thing: no, actually that's all. Thanks."
    }
  ]
}