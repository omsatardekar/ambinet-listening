{
  "schema_version": "1.0",
  "encounter_id": "00041",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 0.95,
      "end_seconds": 7.69,
      "duration_seconds": 6.74,
      "text": "Doctor, I've checked them in and done the preliminary measurements, I'll hand them over when you ask."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.75,
      "end_seconds": 12.6,
      "duration_seconds": 3.85,
      "text": "Okay, thank you. Right, hello, what's the problem?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 14.49,
      "end_seconds": 20.53,
      "duration_seconds": 6.04,
      "text": "Doctor, it's pain in my lower back. It's getting on my nerves now."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 21.84,
      "end_seconds": 25.14,
      "duration_seconds": 3.3,
      "text": "Are you on any tablets or medication?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 26.33,
      "end_seconds": 40.51,
      "duration_seconds": 14.18,
      "text": "Okay, so I'm on telmisartan, 40 milligrams, once a day for my pressure. Hmm, um, I take paracetamol, 650 milligrams, when needed for the knee pain."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 41.25,
      "end_seconds": 43.66,
      "duration_seconds": 2.41,
      "text": "How long have you taken that?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 45.62,
      "end_seconds": 51.32,
      "duration_seconds": 5.7,
      "text": "About nearly five years. It's pantoprazole, 40 milligrams, before breakfast."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 55.8,
      "end_seconds": 60.53,
      "duration_seconds": 4.73,
      "text": "Doctor, our chart from the last visit lists it as 20 milligrams."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 62.32,
      "end_seconds": 65.72,
      "duration_seconds": 3.4,
      "text": "Alright. Did you bring the up-to-date prescription?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 67.35,
      "end_seconds": 71.28,
      "duration_seconds": 3.93,
      "text": "I don't think I have it with me."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 72.98,
      "end_seconds": 76.37,
      "duration_seconds": 3.39,
      "text": "What's the pattern, is it there all day?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 77.42,
      "end_seconds": 89.58,
      "duration_seconds": 12.16,
      "text": "Honestly, all the time. As for stiffness, I honestly can't say when that began. It might have been last month or the month before."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 91.3,
      "end_seconds": 94.11,
      "duration_seconds": 2.81,
      "text": "Any difficulty bending forward as well?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 94.89,
      "end_seconds": 105.78,
      "duration_seconds": 10.89,
      "text": "Yeah, that too. There's a muscle spasm as well. About muscle spasm, it feels severe to me. It's once or twice a day."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 107.57,
      "end_seconds": 114.81,
      "duration_seconds": 7.24,
      "text": "Have you had pain in your lower back before, or is this the first time?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 116.88,
      "end_seconds": 123.13,
      "duration_seconds": 6.25,
      "text": "I had a similar thing about six months ago. It went away."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 123.64,
      "end_seconds": 129.89,
      "duration_seconds": 6.25,
      "text": "Have you had any weight loss, bladder problems or numbness in the legs?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 131.48,
      "end_seconds": 137.55,
      "duration_seconds": 6.07,
      "text": "Right, no, no weight loss, bladder problems or numbness in the legs."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 141.21,
      "end_seconds": 146.23,
      "duration_seconds": 5.02,
      "text": "Have you noticed weakness in the legs or numbness around the groin?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 146.96,
      "end_seconds": 149.45,
      "duration_seconds": 2.49,
      "text": "No, I'd have mentioned it."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 151.44,
      "end_seconds": 153.82,
      "duration_seconds": 2.38,
      "text": "Your breathing, any trouble there?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 155.88,
      "end_seconds": 156.81,
      "duration_seconds": 0.93,
      "text": "Breathing's normal."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 171.34,
      "end_seconds": 176.16,
      "duration_seconds": 4.82,
      "text": "Tell me about your routine, work, habits, that sort of thing."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 176.86,
      "end_seconds": 198.54,
      "duration_seconds": 21.68,
      "text": "I stopped smoking about two years back. I go to the gym a couple of times a week. I run a small shop, so I'm on my feet a lot. I live with my family, my husband and two kids."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 199.47,
      "end_seconds": 202.01,
      "duration_seconds": 2.54,
      "text": "Have you got any chronic problems?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 202.76,
      "end_seconds": 205.87,
      "duration_seconds": 3.11,
      "text": "High blood pressure, for two years."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 206.57,
      "end_seconds": 208.13,
      "duration_seconds": 1.56,
      "text": "Right, any more?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 210.49,
      "end_seconds": 217.07,
      "duration_seconds": 6.58,
      "text": "I've had arthritis in my knees, yes. Acid reflux, for about a year."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 218.11,
      "end_seconds": 218.81,
      "duration_seconds": 0.7,
      "text": "Right."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 237.32,
      "end_seconds": 239.22,
      "duration_seconds": 1.9,
      "text": "Any procedures or operations?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 241.69,
      "end_seconds": 246.08,
      "duration_seconds": 4.39,
      "text": "I had a hernia repair about five years back."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 246.91,
      "end_seconds": 255.93,
      "duration_seconds": 9.02,
      "text": "Okay, so the vitals from earlier. Respiratory rate 15, temperature is 36.8 degrees, pressure 121 over 68, heart rate 70."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 257.64,
      "end_seconds": 258.57,
      "duration_seconds": 0.93,
      "text": "Okay, noted."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 260.02,
      "end_seconds": 262.86,
      "duration_seconds": 2.84,
      "text": "Let me have a look at you."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 263.9,
      "end_seconds": 266.33,
      "duration_seconds": 2.43,
      "text": "Just relax, I'll be quick."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 282.28,
      "end_seconds": 288.54,
      "duration_seconds": 6.26,
      "text": "Straight leg raise is negative on both sides and power in the legs is normal."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 290.42,
      "end_seconds": 292.89,
      "duration_seconds": 2.47,
      "text": "Let me just check something."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 304.19,
      "end_seconds": 309.29,
      "duration_seconds": 5.1,
      "text": "There's tenderness over the muscles on the right of the lower back."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 311.54,
      "end_seconds": 314.6,
      "duration_seconds": 3.06,
      "text": "All done, you can get dressed."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 324.96,
      "end_seconds": 335.88,
      "duration_seconds": 10.92,
      "text": "Let me repeat that back to make sure. You've had pain in your lower back, and no weakness in the legs or weight loss."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 336.57,
      "end_seconds": 338.33,
      "duration_seconds": 1.76,
      "text": "Yes, that's right."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 340.06,
      "end_seconds": 359.63,
      "duration_seconds": 19.57,
      "text": "Let's book an MRI of the lumbar spine to look into persistent back pain. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose. That's it on my side. Anything unclear?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 361.13,
      "end_seconds": 365.51,
      "duration_seconds": 4.38,
      "text": "That's everything I wanted to ask. Thank you."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 367.21,
      "end_seconds": 369.18,
      "duration_seconds": 1.97,
      "text": "Okay, bye for now."
    }
  ]
}