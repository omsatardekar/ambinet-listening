  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.27,
      "end_seconds": 4.68,
      "duration_seconds": 3.41,
      "text": "Sorry I'm a few minutes behind, doctor."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.35,
      "end_seconds": 12.42,
      "duration_seconds": 6.07,
      "text": "yes, come in, take a seat what can I do for you today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 13.98,
      "end_seconds": 19.45,
      "duration_seconds": 5.47,
      "text": "Hello, doctor, I came in with them, if that's okay."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 21.0,
      "end_seconds": 25.38,
      "duration_seconds": 4.38,
      "text": "That's fine, sit down. We'll go through it it together."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 26.97,
      "end_seconds": 31.31,
      "duration_seconds": 4.34,
      "text": "it's a burning in the chest after meals, mostly"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 32.34,
      "end_seconds": 35.26,
      "duration_seconds": 2.92,
      "text": "how bad is it, would you say?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 37.33,
      "end_seconds": 64.47,
      "duration_seconds": 27.14,
      "text": "Severe, really oh, and a sour taste in the mouth that's been about the same, nearly five years as for sour taste in the mouth, I'd say a couple of times a week i did have a hoarse voice in the mornings at one point, but that's gone now"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 65.2,
      "end_seconds": 72.0,
      "duration_seconds": 6.8,
      "text": "Have you had any coughing up blood, night sweats, shortness of breath or trouble swallowing?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 72.64,
      "end_seconds": 75.15,
      "duration_seconds": 2.51,
      "text": "No, not any of them."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 76.03,
      "end_seconds": 79.32,
      "duration_seconds": 3.29,
      "text": "Anything on the skin I should know about?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 80.06,
      "end_seconds": 81.18,
      "duration_seconds": 1.12,
      "text": "Skin's normal."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 82.61,
      "end_seconds": 84.62,
      "duration_seconds": 2.01,
      "text": "Any surgery in your history?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 86.7,
      "end_seconds": 91.25,
      "duration_seconds": 4.55,
      "text": "Yes, I had a hysterectomy, about twelve years ago."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 92.25,
      "end_seconds": 96.13,
      "duration_seconds": 3.88,
      "text": "Do you have any known allergies at all?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 97.2,
      "end_seconds": 100.72,
      "duration_seconds": 3.52,
      "text": "None, as far as I'm aware."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 101.97,
      "end_seconds": 103.25,
      "duration_seconds": 1.28,
      "text": "what's your job?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 105.04,
      "end_seconds": 108.18,
      "duration_seconds": 3.14,
      "text": "I teach at a primary school."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 109.77,
      "end_seconds": 112.37,
      "duration_seconds": 2.6,
      "text": "And what do you usually eat?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 112.88,
      "end_seconds": 115.98,
      "duration_seconds": 3.1,
      "text": "Mostly home-cooked food, rice and vegetables."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 117.07,
      "end_seconds": 119.52,
      "duration_seconds": 2.45,
      "text": "who's at home with you?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 122.82,
      "end_seconds": 126.85,
      "duration_seconds": 4.03,
      "text": "It's just me and my wife at home now."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 139.69,
      "end_seconds": 144.51,
      "duration_seconds": 4.82,
      "text": "do you have any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 145.66,
      "end_seconds": 146.8,
      "duration_seconds": 1.14,
      "text": "Yes, asthma."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 148.09,
      "end_seconds": 159.08,
      "duration_seconds": 10.99,
      "text": "Right. Right, so asthma is already on your record. We'll keep that in mind today. Any medication at the moment, including things from the pharmacy?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 159.77,
      "end_seconds": 165.78,
      "duration_seconds": 6.01,
      "text": "she is on Asthalin inhaler, when needed, I give it to her"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 167.33,
      "end_seconds": 170.58,
      "duration_seconds": 3.25,
      "text": "Okay, can I take your vitals now?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 180.29,
      "end_seconds": 181.98,
      "duration_seconds": 1.69,
      "text": "Just relax your arm..."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 202.26,
      "end_seconds": 211.23,
      "duration_seconds": 8.97,
      "text": "Okay: BP is 125 over 79, temperature 36.6, heart rate 75. And saturation 97 percent, respiratory rate 14."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 212.02,
      "end_seconds": 213.59,
      "duration_seconds": 1.57,
      "text": "is that okay?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 215.24,
      "end_seconds": 218.43,
      "duration_seconds": 3.19,
      "text": "Let's look at it together in a minute."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 219.47,
      "end_seconds": 222.5,
      "duration_seconds": 3.03,
      "text": "Let me examine, it won't take long."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 223.69,
      "end_seconds": 224.99,
      "duration_seconds": 1.3,
      "text": "I'll go gently."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 238.16,
      "end_seconds": 243.22,
      "duration_seconds": 5.06,
      "text": "Chest is clear and the throat looks a little red at the back."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 246.41,
      "end_seconds": 248.09,
      "duration_seconds": 1.68,
      "text": "that's fine, sit up"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 257.38,
      "end_seconds": 270.29,
      "duration_seconds": 12.91,
      "text": "So, based on the history and the examination, I can't pin this down yet. We're looking at a cough driven by acid reflux or cough-variant asthma."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 271.7,
      "end_seconds": 276.08,
      "duration_seconds": 4.38,
      "text": "um, is this going to go away?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 277.06,
      "end_seconds": 286.78,
      "duration_seconds": 9.72,
      "text": "It's reasonable to be concerned, but right now a cough driven by acid reflux is my leading thought, not anything worse."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 298.16,
      "end_seconds": 335.35,
      "duration_seconds": 37.19,
      "text": "I think a chest X-ray makes sense here, for chronic cough. Let's get breathing tests, for chronic cough. For this, pantoprazole, 40 milligrams, before breakfast, for four weeks. It's for reflux. Don't eat for two or three hours before lying down, and raise the head of the bed a little. Don't skip meals, and try to eat smaller portions more often through the day. Please don't wait if the symptoms get worse. That's when to be seen urgently"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 337.25,
      "end_seconds": 338.74,
      "duration_seconds": 1.49,
      "text": "okay, I understand"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 342.69,
      "end_seconds": 349.97,
      "duration_seconds": 7.28,
      "text": "Please come and see me in a month. Okay, we're done for today. Take care."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 350.55,
      "end_seconds": 353.41,
      "duration_seconds": 2.86,
      "text": "Um, thanks so much, doctor."
    }
  ]
}