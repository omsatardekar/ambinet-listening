{
  "schema_version": "1.0",
  "encounter_id": "00109",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 0.81,
      "end_seconds": 10.53,
      "duration_seconds": 9.72,
      "text": "Doctor, the patient's with us now. I did the usual checks at the front, so just say when you want them."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 12.38,
      "end_seconds": 16.48,
      "duration_seconds": 4.1,
      "text": "Thanks, that's helpful. Hello, please sit. What's been happening?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 17.05,
      "end_seconds": 21.83,
      "duration_seconds": 4.78,
      "text": "Hello, doctor, I came in with them, if that's okay."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 26.17,
      "end_seconds": 30.73,
      "duration_seconds": 4.56,
      "text": "Of course, please stay. It's helpful to have you here."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 31.61,
      "end_seconds": 44.27,
      "duration_seconds": 12.66,
      "text": "Well, I've been having a dry cough at night. I've never really been one for hospitals. A neighbour of mine said I should see someone about it."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 50.54,
      "end_seconds": 53.35,
      "duration_seconds": 2.81,
      "text": "How long has this been going on?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 54.22,
      "end_seconds": 56.78,
      "duration_seconds": 2.56,
      "text": "I'd say a week, maybe."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 57.72,
      "end_seconds": 61.58,
      "duration_seconds": 3.86,
      "text": "I think it's been nearer two weeks, actually."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 62.81,
      "end_seconds": 67.82,
      "duration_seconds": 5.01,
      "text": "Okay, so roughly one to two weeks. Is that right?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 69.29,
      "end_seconds": 71.46,
      "duration_seconds": 2.17,
      "text": "I suppose so, yes."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 72.64,
      "end_seconds": 81.11,
      "duration_seconds": 8.47,
      "text": "Can you describe it a bit more for me? How strong it is, what the pattern is, what helps."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 82.4,
      "end_seconds": 89.59,
      "duration_seconds": 7.19,
      "text": "It's once or twice a day. Yes, cold air. That makes it worse."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 90.01,
      "end_seconds": 95.73,
      "duration_seconds": 5.72,
      "text": "I was just going to say that the main thing is—"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 95.83,
      "end_seconds": 102.3,
      "duration_seconds": 6.47,
      "text": "Sorry to cut in, doctor, quick question: shall I bring the trolley in now or later?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 103.86,
      "end_seconds": 111.29,
      "duration_seconds": 7.43,
      "text": "Later, thanks. Please go on. What about a mild wheeze at times, have you noticed that?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 111.8,
      "end_seconds": 113.36,
      "duration_seconds": 1.56,
      "text": "Yeah, that too."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 115.33,
      "end_seconds": 118.9,
      "duration_seconds": 3.57,
      "text": "How would you describe it, mild, moderate, severe?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 120.67,
      "end_seconds": 121.79,
      "duration_seconds": 1.12,
      "text": "Mostly severe."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 123.43,
      "end_seconds": 128.49,
      "duration_seconds": 5.06,
      "text": "What about a tickle in the chest, have you noticed that?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 130.01,
      "end_seconds": 139.03,
      "duration_seconds": 9.02,
      "text": "Yeah, that too. I did have a runny nose in the mornings at one point, but that's gone now."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_5",
      "role": "UNKNOWN",
      "start_seconds": 141.01,
      "end_seconds": 143.03,
      "duration_seconds": 2.02,
      "text": "Yes, exactly like that."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 143.98,
      "end_seconds": 146.52,
      "duration_seconds": 2.54,
      "text": "What about operations, anything like that?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 148.61,
      "end_seconds": 153.39,
      "duration_seconds": 4.78,
      "text": "I had a hernia repair about five years back."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 154.62,
      "end_seconds": 156.82,
      "duration_seconds": 2.2,
      "text": "What's your current medication list?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 158.89,
      "end_seconds": 166.72,
      "duration_seconds": 7.83,
      "text": "Hydrocortisone cream, when needed. Omeprazole, 20 milligrams, maybe, once a day for the reflux."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 168.37,
      "end_seconds": 172.93,
      "duration_seconds": 4.56,
      "text": "Have you got the box or the prescription on you?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 173.56,
      "end_seconds": 182.53,
      "duration_seconds": 8.97,
      "text": "Not with me. I'll bring it next time. I take Seretide inhaler, twice a day for my asthma."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 184.61,
      "end_seconds": 189.94,
      "duration_seconds": 5.33,
      "text": "That's what's prescribed, but I'm not sure she takes it every day."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 191.63,
      "end_seconds": 194.11,
      "duration_seconds": 2.48,
      "text": "Any diagnoses you've been given before?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 195.33,
      "end_seconds": 197.61,
      "duration_seconds": 2.28,
      "text": "Eczema, for two years."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 199.21,
      "end_seconds": 199.91,
      "duration_seconds": 0.7,
      "text": "Understood."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 200.98,
      "end_seconds": 208.78,
      "duration_seconds": 7.8,
      "text": "I've had acid reflux for two years now. I have asthma, for about ten years."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 209.33,
      "end_seconds": 213.58,
      "duration_seconds": 4.25,
      "text": "Do your parents or siblings have any long-term illnesses?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 215.39,
      "end_seconds": 217.42,
      "duration_seconds": 2.03,
      "text": "My brother has asthma."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 218.35,
      "end_seconds": 220.26,
      "duration_seconds": 1.91,
      "text": "What's your diet like?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 221.9,
      "end_seconds": 226.81,
      "duration_seconds": 4.91,
      "text": "I eat out quite a lot, to be honest."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 241.6,
      "end_seconds": 245.51,
      "duration_seconds": 3.91,
      "text": "Any weight loss, chest pain or fever at all?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 246.32,
      "end_seconds": 251.62,
      "duration_seconds": 5.3,
      "text": "I haven't had weight loss, chest pain or fever, no."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 253.34,
      "end_seconds": 254.27,
      "duration_seconds": 0.93,
      "text": "Any heartburn?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 254.94,
      "end_seconds": 258.07,
      "duration_seconds": 3.13,
      "text": "No, I haven't had any heartburn."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 258.37,
      "end_seconds": 261.18,
      "duration_seconds": 2.81,
      "text": "Mm. Has your skin been okay?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 261.84,
      "end_seconds": 264.97,
      "duration_seconds": 3.13,
      "text": "No, um, skin's been fine."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 265.9,
      "end_seconds": 269.6,
      "duration_seconds": 3.7,
      "text": "What about your tummy and bowels, anything unusual there?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 271.31,
      "end_seconds": 273.82,
      "duration_seconds": 2.51,
      "text": "No, that side's been fine."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 277.29,
      "end_seconds": 286.1,
      "duration_seconds": 8.81,
      "text": "Okay, so the vitals from earlier. Pulse 86, pressure 122 over 81, temperature is 36.7 degrees. Saturation 97 percent, respiratory rate 16."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 287.86,
      "end_seconds": 288.9,
      "duration_seconds": 1.04,
      "text": "Okay, noted."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 290.94,
      "end_seconds": 293.73,
      "duration_seconds": 2.79,
      "text": "I'd like to examine you now."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 295.09,
      "end_seconds": 296.29,
      "duration_seconds": 1.2,
      "text": "I'll go gently."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 304.21,
      "end_seconds": 307.54,
      "duration_seconds": 3.33,
      "text": "A faint wheeze when you breathe out forcefully."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 309.7,
      "end_seconds": 311.02,
      "duration_seconds": 1.32,
      "text": "Thanks for that."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 329.5,
      "end_seconds": 347.28,
      "duration_seconds": 17.78,
      "text": "Okay, so my impression is this: It points towards cough-variant asthma. We shouldn't forget reflux-related cough. Post-nasal drip is still possible. Stop me if I've got anything wrong. You've had a dry cough at night, and no heartburn or chest pain."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 348.93,
      "end_seconds": 351.1,
      "duration_seconds": 2.17,
      "text": "That's what happened, yes."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 352.09,
      "end_seconds": 356.33,
      "duration_seconds": 4.24,
      "text": "I've already done a peak flow reading, it's ready for you."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 356.97,
      "end_seconds": 388.84,
      "duration_seconds": 31.87,
      "text": "Good, thank you. Breathing tests is what I'd like next, for chronic cough. What I'm giving you is salbutamol inhaler, 100 micrograms, two puffs when needed, for two weeks. It's for cough and wheeze. Try the inhaler before exercise and note whether the cough settles. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 390.31,
      "end_seconds": 391.82,
      "duration_seconds": 1.51,
      "text": "Okay, fair enough."
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 392.89,
      "end_seconds": 398.45,
      "duration_seconds": 5.56,
      "text": "One warning sign to remember: the symptoms get worse. In that case don't wait."
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 402.75,
      "end_seconds": 404.68,
      "duration_seconds": 1.93,
      "text": "Got it, thank you."
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 406.22,
      "end_seconds": 408.75,
      "duration_seconds": 2.53,
      "text": "We'll catch up in two weeks."
    },
    {
      "segment_id": "SEG0059",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 414.27,
      "end_seconds": 414.97,
      "duration_seconds": 0.7,
      "text": "Fine."
    },
    {
      "segment_id": "SEG0060",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 420.89,
      "end_seconds": 422.3,
      "duration_seconds": 1.41,
      "text": "Look after yourself."
    },
    {
      "segment_id": "SEG0061",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 423.35,
      "end_seconds": 425.62,
      "duration_seconds": 2.27,
      "text": "I appreciate it, doctor."
    },
    {
      "segment_id": "SEG0062",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 427.67,
      "end_seconds": 429.15,
      "duration_seconds": 1.48,
      "text": "See you then."
    }
  ]
}