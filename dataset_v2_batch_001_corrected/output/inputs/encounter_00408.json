{
  "schema_version": "1.0",
  "encounter_id": "00408",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 0.9,
      "end_seconds": 5.38,
      "duration_seconds": 4.48,
      "text": "Doctor, we're ready in room two, I've already taken the observations."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.94,
      "end_seconds": 11.35,
      "duration_seconds": 5.41,
      "text": "Thanks. Hello, come in, sit down. What brings you in today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 12.97,
      "end_seconds": 17.1,
      "duration_seconds": 4.13,
      "text": "Doctor, uh, thank you for seeing us."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 18.06,
      "end_seconds": 20.78,
      "duration_seconds": 2.72,
      "text": "Please do. Extra information is always welcome."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 21.91,
      "end_seconds": 30.22,
      "duration_seconds": 8.31,
      "text": "Honestly, it's a burning pain in the upper tummy, and my family pushed me to come."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 31.18,
      "end_seconds": 33.61,
      "duration_seconds": 2.43,
      "text": "Roughly when did it start?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 35.22,
      "end_seconds": 37.37,
      "duration_seconds": 2.15,
      "text": "About... well, six months."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 38.07,
      "end_seconds": 40.81,
      "duration_seconds": 2.74,
      "text": "Is there anything that triggers it?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 45.71,
      "end_seconds": 71.0,
      "duration_seconds": 25.29,
      "text": "Well, uh, an empty stomach definitely sets it off. And bloating after meals, too. Yeah, about bloating after meals, moderate, really. Um, I've been belching a lot too. Uh, you know, as for belching a lot, I'd say on and off."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 71.67,
      "end_seconds": 73.61,
      "duration_seconds": 1.94,
      "text": "Has there been nausea too?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 74.67,
      "end_seconds": 75.84,
      "duration_seconds": 1.17,
      "text": "Mm, yes."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 76.71,
      "end_seconds": 79.63,
      "duration_seconds": 2.92,
      "text": "How much is it bothering you?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 80.82,
      "end_seconds": 83.51,
      "duration_seconds": 2.69,
      "text": "Yeah, I'd call it mild."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 85.3,
      "end_seconds": 95.92,
      "duration_seconds": 10.62,
      "text": "Doctor, I've got the readings for you. Blood pressure 126 over 75, respiratory rate 18. Oxygen saturation is 97 percent, temperature is 36.5 degrees, heart rate 82."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 96.58,
      "end_seconds": 97.5,
      "duration_seconds": 0.92,
      "text": "Okay, noted."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 99.51,
      "end_seconds": 102.39,
      "duration_seconds": 2.88,
      "text": "If you're comfortable, I'll examine you now."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 103.31,
      "end_seconds": 105.29,
      "duration_seconds": 1.98,
      "text": "Hold that position for me."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 119.07,
      "end_seconds": 125.04,
      "duration_seconds": 5.97,
      "text": "Your tummy is soft, with mild tenderness in the upper middle part."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 126.32,
      "end_seconds": 128.27,
      "duration_seconds": 1.95,
      "text": "Almost done with this part."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 140.33,
      "end_seconds": 142.57,
      "duration_seconds": 2.24,
      "text": "No guarding and no lumps."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 143.89,
      "end_seconds": 144.86,
      "duration_seconds": 0.97,
      "text": "Go ahead."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 149.36,
      "end_seconds": 154.62,
      "duration_seconds": 5.26,
      "text": "All done, you can get dressed. And what about weight loss or jaundice?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 155.49,
      "end_seconds": 158.8,
      "duration_seconds": 3.31,
      "text": "Yeah, no, none of those."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 159.8,
      "end_seconds": 164.27,
      "duration_seconds": 4.47,
      "text": "Did you get trouble swallowing, black stools or vomiting blood?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 165.69,
      "end_seconds": 171.4,
      "duration_seconds": 5.71,
      "text": "I mean, no, no trouble swallowing, black stools or vomiting blood."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 173.12,
      "end_seconds": 174.95,
      "duration_seconds": 1.83,
      "text": "How's your breathing otherwise?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 175.91,
      "end_seconds": 176.88,
      "duration_seconds": 0.97,
      "text": "Breathing's normal."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 177.69,
      "end_seconds": 181.41,
      "duration_seconds": 3.72,
      "text": "Any pins and needles or loss of strength anywhere?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 183.42,
      "end_seconds": 187.36,
      "duration_seconds": 3.94,
      "text": "So, you know, no, nothing like that."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 189.14,
      "end_seconds": 190.44,
      "duration_seconds": 1.3,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 191.82,
      "end_seconds": 196.21,
      "duration_seconds": 4.39,
      "text": "So, uh, no, nothing like that."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 197.73,
      "end_seconds": 200.78,
      "duration_seconds": 3.05,
      "text": "Are you on any tablets or medication?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 202.68,
      "end_seconds": 209.71,
      "duration_seconds": 7.03,
      "text": "I take paracetamol, 650 milligrams, when needed for the knee pain."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 210.26,
      "end_seconds": 219.99,
      "duration_seconds": 9.73,
      "text": "Oh, doctor, I think the last prescription for the paracetamol was 325 milligrams. We changed it at the last visit."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 221.2,
      "end_seconds": 225.18,
      "duration_seconds": 3.98,
      "text": "Right. Do you happen to have the current prescription here?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 226.85,
      "end_seconds": 236.44,
      "duration_seconds": 9.59,
      "text": "I don't think I have it with me. Yeah, I'm on pantoprazole, 40 milligrams, before breakfast."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 237.49,
      "end_seconds": 243.48,
      "duration_seconds": 5.99,
      "text": "That's what's prescribed, but I'm not sure he takes it every day."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 255.1,
      "end_seconds": 258.61,
      "duration_seconds": 3.51,
      "text": "Any long-term health problems I should know about?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 260.67,
      "end_seconds": 266.28,
      "duration_seconds": 5.61,
      "text": "I have arthritis in my knees. Yes, acid reflux."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 267.43,
      "end_seconds": 272.44,
      "duration_seconds": 5.01,
      "text": "Understood. Alright, acid reflux, that matches what I have here."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 287.04,
      "end_seconds": 291.96,
      "duration_seconds": 4.92,
      "text": "Any relatives with health problems I should be aware of?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 293.7,
      "end_seconds": 296.39,
      "duration_seconds": 2.69,
      "text": "So, my brother has asthma."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 315.02,
      "end_seconds": 316.86,
      "duration_seconds": 1.84,
      "text": "Do you live alone?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 317.49,
      "end_seconds": 320.96,
      "duration_seconds": 3.47,
      "text": "Yes, I live on my own."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 322.47,
      "end_seconds": 324.25,
      "duration_seconds": 1.78,
      "text": "Any sport or activity?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 325.49,
      "end_seconds": 327.96,
      "duration_seconds": 2.47,
      "text": "I play badminton on Sundays."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 329.97,
      "end_seconds": 345.05,
      "duration_seconds": 15.08,
      "text": "Let me tell you where I've got to. My working impression is gastritis. The reason I say that is that your story and my examination fit together. I can't rule out a stomach ulcer yet."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 347.03,
      "end_seconds": 349.96,
      "duration_seconds": 2.93,
      "text": "Do you think it's serious?"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 351.15,
      "end_seconds": 369.69,
      "duration_seconds": 18.54,
      "text": "I understand the worry. At the moment I'd say it's gastritis, and we'll watch how it goes. Let me just check I've got this right. You've had a burning pain in the upper tummy for six months, and no trouble swallowing or black stools."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 371.73,
      "end_seconds": 374.21,
      "duration_seconds": 2.48,
      "text": "That's what happened, yes."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 375.86,
      "end_seconds": 387.63,
      "duration_seconds": 11.77,
      "text": "And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose. Today I'm not changing anything. Look after yourself."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 389.55,
      "end_seconds": 393.62,
      "duration_seconds": 4.07,
      "text": "Alright, you know, thanks. Bye for now."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 394.7,
      "end_seconds": 395.94,
      "duration_seconds": 1.24,
      "text": "All the best."
    }
  ]
}