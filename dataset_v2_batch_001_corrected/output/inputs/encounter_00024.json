{
  "schema_version": "1.0",
  "encounter_id": "00024",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.86,
      "end_seconds": 6.97,
      "duration_seconds": 6.11,
      "text": "hmm, doctor? Hi. I hope I've got the right time"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 10.26,
      "end_seconds": 13.92,
      "duration_seconds": 3.66,
      "text": "Right on time. Sit, please. How can I help?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 15.58,
      "end_seconds": 21.98,
      "duration_seconds": 6.4,
      "text": "I, I wanted to get a red swollen area on my leg looked at."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 23.64,
      "end_seconds": 31.17,
      "duration_seconds": 7.53,
      "text": "Doctor, I've got the readings for you. Pulse 97, pressure 119 over 73, temperature 38.7."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 31.94,
      "end_seconds": 35.33,
      "duration_seconds": 3.39,
      "text": "Good, thank you. Roughly when did it start?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 37.1,
      "end_seconds": 41.02,
      "duration_seconds": 3.92,
      "text": "I mean, ever since... since last Tuesday, really."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 42.89,
      "end_seconds": 46.39,
      "duration_seconds": 3.5,
      "text": "is it it worse with anything in particular?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 48.29,
      "end_seconds": 51.48,
      "duration_seconds": 3.19,
      "text": "yes, walking that makes it worse"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 52.25,
      "end_seconds": 56.14,
      "duration_seconds": 3.89,
      "text": "does it happen all the time or in spells?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 56.78,
      "end_seconds": 59.81,
      "duration_seconds": 3.03,
      "text": "Honestly, a few times a day."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 60.9,
      "end_seconds": 64.27,
      "duration_seconds": 3.37,
      "text": "is there anything that takes the edge off?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 65.81,
      "end_seconds": 70.35,
      "duration_seconds": 4.54,
      "text": "It settles a little with elevating the leg."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 72.09,
      "end_seconds": 75.24,
      "duration_seconds": 3.15,
      "text": "Anything that tends to go along with it?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 76.55,
      "end_seconds": 82.0,
      "duration_seconds": 5.45,
      "text": "when it starts I tend to get a fever as well"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 83.4,
      "end_seconds": 86.82,
      "duration_seconds": 3.42,
      "text": "Have you had pain in that area?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 87.9,
      "end_seconds": 90.15,
      "duration_seconds": 2.25,
      "text": "Yes, for two days."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 91.43,
      "end_seconds": 95.52,
      "duration_seconds": 4.09,
      "text": "Is it constant, or does it come and go?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 96.62,
      "end_seconds": 110.75,
      "duration_seconds": 14.13,
      "text": "it's a few times a day as for fever, moderate, really oh, and chills that's been about the same, three days as for chills, it's all the time"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 112.6,
      "end_seconds": 120.26,
      "duration_seconds": 7.66,
      "text": "Have you had a red swollen area on your leg before, or is this the first time?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 121.59,
      "end_seconds": 126.91,
      "duration_seconds": 5.32,
      "text": "A bit, last year. It settled by itself back then."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 128.99,
      "end_seconds": 135.74,
      "duration_seconds": 6.75,
      "text": "alright, and what about red streaks going up the leg, numbness around it or pus?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 137.78,
      "end_seconds": 140.36,
      "duration_seconds": 2.58,
      "text": "No, not any of them."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 142.0,
      "end_seconds": 145.63,
      "duration_seconds": 3.63,
      "text": "and what about vomiting or shortness of breath?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 146.83,
      "end_seconds": 150.21,
      "duration_seconds": 3.38,
      "text": "No, no vomiting or shortness of breath."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 151.82,
      "end_seconds": 154.59,
      "duration_seconds": 2.77,
      "text": "Anything different when you pass water?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 155.42,
      "end_seconds": 157.04,
      "duration_seconds": 1.62,
      "text": "no changes there"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 172.01,
      "end_seconds": 174.65,
      "duration_seconds": 2.64,
      "text": "Have you had any surgery before?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 175.61,
      "end_seconds": 182.19,
      "duration_seconds": 6.58,
      "text": "Yes, I had a a lump removed from my back, years ago."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 183.02,
      "end_seconds": 187.27,
      "duration_seconds": 4.25,
      "text": "Is there a a family history of anything significant?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 191.42,
      "end_seconds": 194.06,
      "duration_seconds": 2.64,
      "text": "my grandmother had breast cancer"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 208.76,
      "end_seconds": 211.09,
      "duration_seconds": 2.33,
      "text": "Any drug or food allergies?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 211.95,
      "end_seconds": 222.79,
      "duration_seconds": 10.84,
      "text": "Uh, I think I reacted to to some antibiotic once, years ago. I don't remember which one, or what happened exactly."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 227.89,
      "end_seconds": 232.92,
      "duration_seconds": 5.03,
      "text": "Do you have any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 234.85,
      "end_seconds": 235.9,
      "duration_seconds": 1.05,
      "text": "Yes, diabetes."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 241.76,
      "end_seconds": 242.46,
      "duration_seconds": 0.7,
      "text": "Understood."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 244.01,
      "end_seconds": 248.47,
      "duration_seconds": 4.46,
      "text": "I, I have heart disease, for about a year."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 249.81,
      "end_seconds": 250.51,
      "duration_seconds": 0.7,
      "text": "ah"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 251.59,
      "end_seconds": 255.15,
      "duration_seconds": 3.56,
      "text": "I've had arthritis in my knees, yes."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 256.28,
      "end_seconds": 264.87,
      "duration_seconds": 8.59,
      "text": "Okay, I can see arthritis in your knees in your file as well. Anything special about your diet?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 266.29,
      "end_seconds": 269.61,
      "duration_seconds": 3.32,
      "text": "I try to avoid too much sugar."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 270.59,
      "end_seconds": 273.32,
      "duration_seconds": 2.73,
      "text": "Right, are you living with family?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 274.4,
      "end_seconds": 278.03,
      "duration_seconds": 3.63,
      "text": "I stay with my daughter and her family."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 278.92,
      "end_seconds": 286.22,
      "duration_seconds": 7.3,
      "text": "Right, tell me what you take day to day. Take your time, there's no rush."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 287.29,
      "end_seconds": 297.02,
      "duration_seconds": 9.73,
      "text": "Oh, I take glimepiride, 2 milligrams, before breakfast for my sugar. Clopidogrel, 75 milligrams, once a day."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 298.49,
      "end_seconds": 303.8,
      "duration_seconds": 5.31,
      "text": "doctor, our chart from the last visit lists it as 150 milligrams"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 304.69,
      "end_seconds": 308.81,
      "duration_seconds": 4.12,
      "text": "I see. Is the most recent prescription on you?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 310.47,
      "end_seconds": 318.72,
      "duration_seconds": 8.25,
      "text": "Well, uh, I don't think I have it with me. Diclofenac, 50 milligrams, when needed."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 321.43,
      "end_seconds": 323.54,
      "duration_seconds": 2.11,
      "text": "Okay, a quick examination now."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 341.71,
      "end_seconds": 342.71,
      "duration_seconds": 1.0,
      "text": "no problem"
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 344.42,
      "end_seconds": 345.59,
      "duration_seconds": 1.17,
      "text": "I'll go gently."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 355.14,
      "end_seconds": 362.26,
      "duration_seconds": 7.12,
      "text": "the skin on the lower leg is red, warm and swollen, about the size of my palm"
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 363.73,
      "end_seconds": 366.4,
      "duration_seconds": 2.67,
      "text": "Let me look at this properly."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 384.73,
      "end_seconds": 390.37,
      "duration_seconds": 5.64,
      "text": "there's a a small scab where the cut was, no pus coming out"
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 391.83,
      "end_seconds": 392.9,
      "duration_seconds": 1.07,
      "text": "yes, doctor"
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 397.82,
      "end_seconds": 405.66,
      "duration_seconds": 7.84,
      "text": "Okay, finished. Taking everything into account, this looks most like cellulitis. An abscess forming is also on my list."
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 407.66,
      "end_seconds": 411.41,
      "duration_seconds": 3.75,
      "text": "What are the the chances it's something bad?"
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 412.94,
      "end_seconds": 431.99,
      "duration_seconds": 19.05,
      "text": "Nothing I've seen today points to an emergency. It looks like cellulitis, but I'd like to confirm. Stop me if I've got anything wrong. You've had a red swollen area on your leg, since last Tuesday, and no vomiting or pus."
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 436.14,
      "end_seconds": 436.84,
      "duration_seconds": 0.7,
      "text": "Exactly."
    },
    {
      "segment_id": "SEG0059",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 437.95,
      "end_seconds": 474.61,
      "duration_seconds": 36.66,
      "text": "A wound swab is what I'd like next, for infected wound. Blood tests is what I'd like next, for infection. The treatment will be cephalexin, 500 milligrams, four times a day, for seven days. That's for skin infection. Keep the leg raised on a pillow when you're sitting. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose. I'd like you back in two days."
    },
    {
      "segment_id": "SEG0060",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 475.33,
      "end_seconds": 484.11,
      "duration_seconds": 8.78,
      "text": "can you tell me the the plan back in your own words, so I know I've explained it clearly?"
    },
    {
      "segment_id": "SEG0061",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 485.25,
      "end_seconds": 494.93,
      "duration_seconds": 9.68,
      "text": "So, I take the cephalexin, 500 milligrams, four times a day and come back in two days. Is that right?"
    },
    {
      "segment_id": "SEG0062",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 496.18,
      "end_seconds": 500.98,
      "duration_seconds": 4.8,
      "text": "Yes, exactly right. Call the clinic if you need us."
    },
    {
      "segment_id": "SEG0063",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 502.27,
      "end_seconds": 505.12,
      "duration_seconds": 2.85,
      "text": "nothing more from me, thanks"
    }
  ]
}