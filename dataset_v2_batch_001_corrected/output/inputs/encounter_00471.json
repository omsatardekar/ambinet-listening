{
  "schema_version": "1.0",
  "encounter_id": "00471",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.69,
      "end_seconds": 2.35,
      "duration_seconds": 1.66,
      "text": "morning! Make yourself comfortable"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "CAREGIVER",
      "start_seconds": 3.21,
      "end_seconds": 10.2,
      "duration_seconds": 6.99,
      "text": "Right, um, hello, doctor, I came in with them, if that's okay."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 11.36,
      "end_seconds": 15.77,
      "duration_seconds": 4.41,
      "text": "What was the main thing you wanted to talk about?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 16.5,
      "end_seconds": 30.62,
      "duration_seconds": 14.12,
      "text": "honestly, it's a heavy feeling in the left arm, and my family pushed me to come i mean, and there's breathlessness on exertion as well, four weeks now"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 31.83,
      "end_seconds": 35.69,
      "duration_seconds": 3.86,
      "text": "does it happen all the time or in spells?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 41.24,
      "end_seconds": 50.99,
      "duration_seconds": 9.75,
      "text": "I'd say once or twice a day. Oh, um, and tightness in my chest when I walk."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 52.74,
      "end_seconds": 55.7,
      "duration_seconds": 2.96,
      "text": "How much is it bothering you?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 56.22,
      "end_seconds": 59.89,
      "duration_seconds": 3.67,
      "text": "Pretty severe, if I'm being honest."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 60.85,
      "end_seconds": 64.28,
      "duration_seconds": 3.43,
      "text": "So, what medicines do you take regularly?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 68.18,
      "end_seconds": 79.57,
      "duration_seconds": 11.39,
      "text": "Clopidogrel. I take it 75 milligrams, once a day. It's rosuvastatin, 10 milligrams, at night. It's ramipril, 5 milligrams, every morning."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "CAREGIVER",
      "start_seconds": 81.18,
      "end_seconds": 90.63,
      "duration_seconds": 9.45,
      "text": "Doctor, I think the last prescription for the ramipril was 10 milligrams. We changed it at the last visit."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 92.26,
      "end_seconds": 95.14,
      "duration_seconds": 2.88,
      "text": "alright did you bring the up-to-date prescription?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 96.57,
      "end_seconds": 101.3,
      "duration_seconds": 4.73,
      "text": "Well, not with me. I'll bring it next time."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 103.19,
      "end_seconds": 111.4,
      "duration_seconds": 8.21,
      "text": "It's, It's a... um, I can't remember what it's called. It's a little pink tablet."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 113.47,
      "end_seconds": 115.9,
      "duration_seconds": 2.43,
      "text": "Do you remember what it's for?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 116.88,
      "end_seconds": 132.28,
      "duration_seconds": 15.4,
      "text": "For my thyroid, I believe. My son sets them out for me, I just take what I'm given. I used to take aspirin, but I stopped it."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 148.08,
      "end_seconds": 149.03,
      "duration_seconds": 0.95,
      "text": "Any smoking?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 150.91,
      "end_seconds": 155.32,
      "duration_seconds": 4.41,
      "text": "I smoke, yes, around five a day."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 157.33,
      "end_seconds": 158.91,
      "duration_seconds": 1.58,
      "text": "Do you live alone?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 159.98,
      "end_seconds": 163.13,
      "duration_seconds": 3.15,
      "text": "Yes, I live on my own."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 165.21,
      "end_seconds": 167.55,
      "duration_seconds": 2.34,
      "text": "Any allergies I should know about?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 169.21,
      "end_seconds": 170.32,
      "duration_seconds": 1.11,
      "text": "no allergies"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 172.11,
      "end_seconds": 173.58,
      "duration_seconds": 1.47,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 174.99,
      "end_seconds": 181.62,
      "duration_seconds": 6.63,
      "text": "I had a stent put in my heart two years ago."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 193.11,
      "end_seconds": 195.71,
      "duration_seconds": 2.6,
      "text": "Does anything run in the family?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 197.6,
      "end_seconds": 207.47,
      "duration_seconds": 9.87,
      "text": "Well, my father had a heart attack. Hmm, you know, my father had kidney stones."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 211.44,
      "end_seconds": 214.32,
      "duration_seconds": 2.88,
      "text": "Have you got any chronic problems?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 216.13,
      "end_seconds": 233.36,
      "duration_seconds": 17.23,
      "text": "I've had heart disease for nearly five years now. My sister suggested writing things down, but I forgot. I've had diabetes for nearly five years now. I've never really been one for hospitals."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 234.91,
      "end_seconds": 237.11,
      "duration_seconds": 2.2,
      "text": "Right, and apart from that?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 237.79,
      "end_seconds": 254.79,
      "duration_seconds": 17.0,
      "text": "High cholesterol, for five years i did try to ignore it for a while hmm, you know, I've got high blood pressure sorry, I know I'm rambling a bit"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 255.48,
      "end_seconds": 257.38,
      "duration_seconds": 1.9,
      "text": "And apart from that?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 258.26,
      "end_seconds": 263.63,
      "duration_seconds": 5.37,
      "text": "I, I have an underactive thyroid, for about a year."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 264.18,
      "end_seconds": 274.28,
      "duration_seconds": 10.1,
      "text": "okay, I can see high cholesterol and high blood pressure in your file as well. Have you noticed palpitations or cough?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 274.85,
      "end_seconds": 287.23,
      "duration_seconds": 12.38,
      "text": "No, no palpitations, no cough. I was sweating with it at one point, but that went away on its own."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 288.3,
      "end_seconds": 294.99,
      "duration_seconds": 6.69,
      "text": "A A few quick ones: pain at rest, swelling in the ankles or fever?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 296.75,
      "end_seconds": 302.76,
      "duration_seconds": 6.01,
      "text": "No, no pain at rest, swelling in the ankles or fever."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 304.66,
      "end_seconds": 308.15,
      "duration_seconds": 3.49,
      "text": "anything with your nerves, like weakness or numbness?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 309.4,
      "end_seconds": 313.14,
      "duration_seconds": 3.74,
      "text": "No, you know, that's all normal."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 314.71,
      "end_seconds": 317.49,
      "duration_seconds": 2.78,
      "text": "how are your bowels, any trouble?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 318.69,
      "end_seconds": 322.52,
      "duration_seconds": 3.83,
      "text": "No, you know, all normal there."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_4",
      "role": "NURSE",
      "start_seconds": 324.44,
      "end_seconds": 333.59,
      "duration_seconds": 9.15,
      "text": "Doctor, I've got the readings for you. Saturation 97 percent, BP is 167 over 99. Temperature 36.9, pulse is 84 beats a minute."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 334.53,
      "end_seconds": 335.58,
      "duration_seconds": 1.05,
      "text": "Okay, noted."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 337.08,
      "end_seconds": 339.97,
      "duration_seconds": 2.89,
      "text": "let me have a look at you"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 340.82,
      "end_seconds": 342.2,
      "duration_seconds": 1.38,
      "text": "I'll go gently."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 355.22,
      "end_seconds": 357.81,
      "duration_seconds": 2.59,
      "text": "Heart sounds are normal, no murmurs."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 359.49,
      "end_seconds": 360.19,
      "duration_seconds": 0.7,
      "text": "Alright."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 362.09,
      "end_seconds": 363.35,
      "duration_seconds": 1.26,
      "text": "I'll go gently."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 380.77,
      "end_seconds": 385.08,
      "duration_seconds": 4.31,
      "text": "Lungs are clear and and there's no swelling in your ankles."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 387.81,
      "end_seconds": 405.82,
      "duration_seconds": 18.01,
      "text": "All done, you can get dressed. Taking everything into account, my working impression is angina-type chest pain. I'd also keep a musculoskeletal cause in mind. It could also be gastro-oesophageal reflux, so we'll keep that open."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_4",
      "role": "NURSE",
      "start_seconds": 407.31,
      "end_seconds": 410.6,
      "duration_seconds": 3.29,
      "text": "we've already done an ECG this morning, doctor"
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 412.21,
      "end_seconds": 428.28,
      "duration_seconds": 16.07,
      "text": "good, thank you. I'm sending you for a treadmill test because of exertional chest tightness. I'm going to put you on GTN spray, 0.4 milligrams, when the chest tightness comes, as needed. That's for chest tightness"
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 429.08,
      "end_seconds": 431.9,
      "duration_seconds": 2.82,
      "text": "That's easy enough to remember."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 432.63,
      "end_seconds": 448.33,
      "duration_seconds": 15.7,
      "text": "Don't push through the chest tightness, stop, sit down, and use the spray if I've given it to you. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 448.99,
      "end_seconds": 449.69,
      "duration_seconds": 0.7,
      "text": "Understood."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 453.9,
      "end_seconds": 457.92,
      "duration_seconds": 4.02,
      "text": "I'll want another look after the results are back."
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 459.47,
      "end_seconds": 463.83,
      "duration_seconds": 4.36,
      "text": "Yes, you know, I can do that."
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 465.34,
      "end_seconds": 468.71,
      "duration_seconds": 3.37,
      "text": "That's everything from me. Any other questions?"
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 470.71,
      "end_seconds": 473.84,
      "duration_seconds": 3.13,
      "text": "Nothing more from me, thanks."
    },
    {
      "segment_id": "SEG0059",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 475.82,
      "end_seconds": 477.23,
      "duration_seconds": 1.41,
      "text": "All the best."
    }
  ]
}