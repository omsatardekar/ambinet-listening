{
  "schema_version": "1.0",
  "encounter_id": "00165",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 0.53,
      "end_seconds": 7.75,
      "duration_seconds": 7.22,
      "text": "Okay, doctor, we're all set in here. I'll give you the numbers when you want them."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 9.21,
      "end_seconds": 14.14,
      "duration_seconds": 4.93,
      "text": "Thanks. Hello, come in, sit down. What brings you in today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 15.19,
      "end_seconds": 18.09,
      "duration_seconds": 2.9,
      "text": "Well, I've been having a fever."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 19.93,
      "end_seconds": 27.54,
      "duration_seconds": 7.61,
      "text": "Here are the numbers, doctor. Heart rate 107, SpO2 97 percent on room air, blood pressure 119 over 66."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 28.8,
      "end_seconds": 31.57,
      "duration_seconds": 2.77,
      "text": "Thanks. Does anything make it better?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 33.28,
      "end_seconds": 37.72,
      "duration_seconds": 4.44,
      "text": "Okay, so only paracetamol, and it's not much."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 39.78,
      "end_seconds": 42.45,
      "duration_seconds": 2.67,
      "text": "Any pain on swallowing as well?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 43.98,
      "end_seconds": 53.79,
      "duration_seconds": 9.81,
      "text": "Yes, for two days. With pain on swallowing, it's mild, honestly. It happens a couple of times a week."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 55.8,
      "end_seconds": 58.99,
      "duration_seconds": 3.19,
      "text": "And what about ear pain or cough?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 60.37,
      "end_seconds": 63.32,
      "duration_seconds": 2.95,
      "text": "None, as far as I know."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 65.33,
      "end_seconds": 69.46,
      "duration_seconds": 4.13,
      "text": "Any rash, difficulty breathing or runny nose at all?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 70.53,
      "end_seconds": 72.91,
      "duration_seconds": 2.38,
      "text": "No, not any of them."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 74.41,
      "end_seconds": 76.37,
      "duration_seconds": 1.96,
      "text": "Is your mobility otherwise okay?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 77.24,
      "end_seconds": 78.81,
      "duration_seconds": 1.57,
      "text": "No, nothing there."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 79.65,
      "end_seconds": 80.98,
      "duration_seconds": 1.33,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 82.29,
      "end_seconds": 84.01,
      "duration_seconds": 1.72,
      "text": "No operations, no."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 90.19,
      "end_seconds": 94.5,
      "duration_seconds": 4.31,
      "text": "Any relatives with health problems I should be aware of?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 95.32,
      "end_seconds": 97.45,
      "duration_seconds": 2.13,
      "text": "My mother has diabetes."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 107.05,
      "end_seconds": 115.54,
      "duration_seconds": 8.49,
      "text": "Okay, any long-term health problems I should know about? I ask because it helps me narrow things down."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 117.17,
      "end_seconds": 119.84,
      "duration_seconds": 2.67,
      "text": "Asthma, for nearly five years."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 121.9,
      "end_seconds": 125.34,
      "duration_seconds": 3.44,
      "text": "Right, right. Before I prescribe anything, any allergies?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 126.67,
      "end_seconds": 127.66,
      "duration_seconds": 0.99,
      "text": "No allergies."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 129.67,
      "end_seconds": 133.3,
      "duration_seconds": 3.63,
      "text": "Which tablets or creams or inhalers do you use?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 133.94,
      "end_seconds": 141.83,
      "duration_seconds": 7.89,
      "text": "It's Seretide inhaler, twice a day for my asthma. Paracetamol, 500 milligrams, when needed."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 155.61,
      "end_seconds": 158.37,
      "duration_seconds": 2.76,
      "text": "Now some background about your lifestyle."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 159.95,
      "end_seconds": 170.1,
      "duration_seconds": 10.15,
      "text": "I drive a delivery van all day. I play badminton on Sundays. I stay with my daughter and her family."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 171.71,
      "end_seconds": 175.58,
      "duration_seconds": 3.87,
      "text": "So, come over here and I'll have a look."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 176.43,
      "end_seconds": 178.59,
      "duration_seconds": 2.16,
      "text": "Just relax, I'll be quick."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 188.8,
      "end_seconds": 191.91,
      "duration_seconds": 3.11,
      "text": "The glands under the jaw are tender."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 192.76,
      "end_seconds": 195.64,
      "duration_seconds": 2.88,
      "text": "Let me look at this properly."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 206.75,
      "end_seconds": 213.48,
      "duration_seconds": 6.73,
      "text": "Both tonsils are red and swollen, and there are white patches on the left one."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 232.12,
      "end_seconds": 232.82,
      "duration_seconds": 0.7,
      "text": "Sure."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 238.78,
      "end_seconds": 255.99,
      "duration_seconds": 17.21,
      "text": "Right, you can sit back down. So where does that leave us? My working impression is tonsillitis, probably bacterial. I want to be honest that this is an impression, not a final answer. We shouldn't forget a viral throat infection."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 257.24,
      "end_seconds": 263.52,
      "duration_seconds": 6.28,
      "text": "I've been thinking the worst, um, to be honest. Is it bad?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 265.38,
      "end_seconds": 284.94,
      "duration_seconds": 19.56,
      "text": "I can't promise yet, but most people with tonsillitis, probably bacterial do well once it's treated properly. I'm sending you for a throat swab because of sore throat. Let's use azithromycin, 500 milligrams, once a day, for three days. That should help with throat infection."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 287.01,
      "end_seconds": 288.19,
      "duration_seconds": 1.18,
      "text": "Right, understood."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 288.92,
      "end_seconds": 295.04,
      "duration_seconds": 6.12,
      "text": "Finish the whole course of antibiotics even if you feel better after two days."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 295.51,
      "end_seconds": 315.38,
      "duration_seconds": 19.87,
      "text": "Right, right. Cut down on salt and fried food for now, it really does make a difference. Do get help quickly if you can't swallow your saliva or you have trouble breathing. I'd like to see you again in a week. Is there anything you wanted to ask?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 317.0,
      "end_seconds": 320.39,
      "duration_seconds": 3.39,
      "text": "One thing: no, actually that's all. Thanks."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 322.36,
      "end_seconds": 323.6,
      "duration_seconds": 1.24,
      "text": "All the best."
    }
  ]
}