    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 15.6,
      "end_seconds": 22.67,
      "duration_seconds": 7.07,
      "text": "it's aching bones and muscles i thought I'd wait, but it hasn't gone"
    },
    {
      "segment_id": "SEG0004",
