      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 100.8,
      "end_seconds": 106.08,
      "duration_seconds": 5.28,
      "text": "I had a similar thing last year it went away"
