      "role": "DOCTOR",
      "start_seconds": 146.82,
      "end_seconds": 149.25,
      "duration_seconds": 2.43,
      "text": "What about operations anything like that?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 150.88,
      "end_seconds": 155.1,
      "duration_seconds": 4.22,
      "text": "I had a hernia repair about five years back"
