      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 311.5,
      "end_seconds": 314.33,
      "duration_seconds": 2.83,
      "text": "Right, you can sit back down."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 328.66,
      "end_seconds": 344.23,
      "duration_seconds": 15.57,
      "text": "I'm sending you for a vitamin B12 level because of tingling and tiredness i want a vitamin D level done that's for bone aches the result will help us decide whether anything more is needed"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 345.69,
      "end_seconds": 347.11,
      "duration_seconds": 1.42,
      "text": "Will it hurt?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 349.14,
      "end_seconds": 358.62,
      "duration_seconds": 9.48,
      "text": "I'm gonna order a full blood count for fatigue. I'd rather check than guess and this is the quickest way to know more."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 360.27,
      "end_seconds": 362.92,
      "duration_seconds": 2.65,
      "text": "does it need any preparation?"
