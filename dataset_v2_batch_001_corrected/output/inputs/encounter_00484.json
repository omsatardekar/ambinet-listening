    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 214.09,
      "end_seconds": 226.17,
      "duration_seconds": 12.08,
      "text": "I have acid reflux. My sister suggested writing things down but I forgot. It's the the not knowing that gets to me. Yes heart failure."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 227.21,
      "end_seconds": 230.77,
      "duration_seconds": 3.56,
      "text": "Alright first the numbers if you don't mind."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 238.54,
      "end_seconds": 240.11,
      "duration_seconds": 1.57,
      "text": "hold still for me.."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 252.16,
      "end_seconds": 263.92,
      "duration_seconds": 11.76,
      "text": "Okay: height 157 centimetres weight 96 kilos BMI works out to 38.9. And respiratory rate 14 pressure 111 over 70 saturation 99 percent temperature 36.6 heart rate 71."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 266.44,
      "end_seconds": 270.27,
      "duration_seconds": 3.83,
      "text": "right let me check a few things physically"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 272.04,
      "end_seconds": 273.94,
      "duration_seconds": 1.9,
      "text": "Let me press here."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 282.56,
      "end_seconds": 286.28,
      "duration_seconds": 3.72,
      "text": "the tongue looks smooth and a little red"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 288.28,
      "end_seconds": 290.3,
      "duration_seconds": 2.02,
      "text": "hold that position for me"
