    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 363.5,
      "end_seconds": 387.16,
      "duration_seconds": 23.66,
      "text": "I'll start you on vitamin D, 60000 units, once a week, for eight weeks. That's for possible deficiency. Some midday sunlight on the arms for fifteen minutes helps. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
