      "start_seconds": 0.93,
      "end_seconds": 6.66,
      "duration_seconds": 5.73,
      "text": "Good afternoon, doctor, the receptionist said you'd see me now."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.41,
      "end_seconds": 14.19,
      "duration_seconds": 5.78,
      "text": "Yes come in take a seat. What can I do for you today?"
