{
  "schema_version": "1.0",
  "encounter_id": "00440",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.07,
      "end_seconds": 10.75,
      "duration_seconds": 9.68,
      "text": "Right, um, hi, doctor, I brought my bag, is it fine to leave it here?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 12.54,
      "end_seconds": 16.98,
      "duration_seconds": 4.44,
      "text": "Right on time. Sit, please. How can I help?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 18.91,
      "end_seconds": 24.36,
      "duration_seconds": 5.45,
      "text": "Oh, morning, doctor. I'll stay and fill in anything that's missed."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 26.4,
      "end_seconds": 31.72,
      "duration_seconds": 5.32,
      "text": "Oh, uh, I'm here cos of severe body pain."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 32.74,
      "end_seconds": 35.55,
      "duration_seconds": 2.81,
      "text": "How long have you had it?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 36.66,
      "end_seconds": 39.73,
      "duration_seconds": 3.07,
      "text": "Ever since... since Monday, really."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 42.42,
      "end_seconds": 47.85,
      "duration_seconds": 5.43,
      "text": "okay, give me more detail on it, whatever comes to mind"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 49.64,
      "end_seconds": 56.29,
      "duration_seconds": 6.65,
      "text": "Moving around definitely sets it off. Mild, really it comes and goes"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 57.25,
      "end_seconds": 60.39,
      "duration_seconds": 3.14,
      "text": "Has there been a poor appetite too?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 61.63,
      "end_seconds": 69.51,
      "duration_seconds": 7.88,
      "text": "uh, uh, yes, that started yesterday. I've also had a skin rash"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 70.92,
      "end_seconds": 73.43,
      "duration_seconds": 2.51,
      "text": "Let me measure a few things."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 85.52,
      "end_seconds": 86.3,
      "duration_seconds": 0.78,
      "text": "one second.."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 101.13,
      "end_seconds": 110.47,
      "duration_seconds": 9.34,
      "text": "Okay: SpO2 95 percent on room air, weight 77 kilos, pulse 94, respiratory rate 21, height 177 centimetres, pressure 125 over 69."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 111.6,
      "end_seconds": 115.04,
      "duration_seconds": 3.44,
      "text": "Let me have a look at you."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 116.9,
      "end_seconds": 119.36,
      "duration_seconds": 2.46,
      "text": "take your time, no rush"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 130.1,
      "end_seconds": 135.87,
      "duration_seconds": 5.77,
      "text": "there's a faint rash on your forearms, it blanches when I press"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 136.85,
      "end_seconds": 138.95,
      "duration_seconds": 2.1,
      "text": "Take your time, no rush."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 146.88,
      "end_seconds": 152.93,
      "duration_seconds": 6.05,
      "text": "Your tummy is soft, a little tender under the ribs on the right."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 158.56,
      "end_seconds": 161.34,
      "duration_seconds": 2.78,
      "text": "That's all I need, thank you."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 171.68,
      "end_seconds": 178.84,
      "duration_seconds": 7.16,
      "text": "Let me check a few things. Any breathlessness, bleeding from the gums or blood in the stool?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 180.02,
      "end_seconds": 189.48,
      "duration_seconds": 9.46,
      "text": "well, uh, I haven't had breathlessness, bleeding from the gums or blood in the stool, no"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 191.35,
      "end_seconds": 194.66,
      "duration_seconds": 3.31,
      "text": "Have you noticed vomiting or abdominal pain?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 196.01,
      "end_seconds": 199.5,
      "duration_seconds": 3.49,
      "text": "no, no vomiting or abdominal pain"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 200.02,
      "end_seconds": 201.68,
      "duration_seconds": 1.66,
      "text": "Any sign of cough?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 202.71,
      "end_seconds": 206.89,
      "duration_seconds": 4.18,
      "text": "Oh, you know, no, none, no cough."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 207.85,
      "end_seconds": 213.74,
      "duration_seconds": 5.89,
      "text": "So, actually, doctor, I did notice cough. She doesn't always say."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 214.31,
      "end_seconds": 221.18,
      "duration_seconds": 6.87,
      "text": "No, I don't think I did. Maybe a little, I'm not sure."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 222.52,
      "end_seconds": 229.53,
      "duration_seconds": 7.01,
      "text": "Alright, I'll note both what you've said and what you've noticed. Any trouble with the waterworks?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 231.22,
      "end_seconds": 233.79,
      "duration_seconds": 2.57,
      "text": "No, that's all fine."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 234.91,
      "end_seconds": 238.14,
      "duration_seconds": 3.23,
      "text": "anything with your nerves, like weakness or numbness?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 239.22,
      "end_seconds": 241.42,
      "duration_seconds": 2.2,
      "text": "No weakness or anything."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 242.77,
      "end_seconds": 246.42,
      "duration_seconds": 3.65,
      "text": "Is there a family history of anything significant?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 247.47,
      "end_seconds": 252.75,
      "duration_seconds": 5.28,
      "text": "My grandmother had breast cancer. My sister has epilepsy."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 254.58,
      "end_seconds": 255.88,
      "duration_seconds": 1.3,
      "text": "How's your diet?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 257.66,
      "end_seconds": 259.33,
      "duration_seconds": 1.67,
      "text": "I'm mostly vegetarian"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 261.17,
      "end_seconds": 262.42,
      "duration_seconds": 1.25,
      "text": "do you work?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 263.93,
      "end_seconds": 270.61,
      "duration_seconds": 6.68,
      "text": "I run a small shop, so I'm on my feet a lot."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 275.21,
      "end_seconds": 278.44,
      "duration_seconds": 3.23,
      "text": "Is there anything medical in your background?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 280.33,
      "end_seconds": 286.8,
      "duration_seconds": 6.47,
      "text": "High blood pressure, for about ten years. I've had diabetes, yes."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 287.53,
      "end_seconds": 296.45,
      "duration_seconds": 8.92,
      "text": "Ah. Yes, high blood pressure is known to us, good to have that clear. Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 297.96,
      "end_seconds": 299.65,
      "duration_seconds": 1.69,
      "text": "No operations, no."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 305.04,
      "end_seconds": 309.59,
      "duration_seconds": 4.55,
      "text": "Any medication at the moment, including things from the pharmacy?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 310.26,
      "end_seconds": 312.59,
      "duration_seconds": 2.33,
      "text": "Losartan, once a day."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 313.17,
      "end_seconds": 315.94,
      "duration_seconds": 2.77,
      "text": "okay, and what strength is that?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 317.14,
      "end_seconds": 325.89,
      "duration_seconds": 8.75,
      "text": "50 milligrams, I think that's what's on the box. Glimepiride. I take it 2 milligrams, before breakfast."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 329.13,
      "end_seconds": 340.47,
      "duration_seconds": 11.34,
      "text": "I mean, doctor, I think the last prescription for the glimepiride was 4 milligrams. We changed it at the last visit."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 341.78,
      "end_seconds": 345.78,
      "duration_seconds": 4.0,
      "text": "right. Do you happen to have the current prescription here?"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 347.15,
      "end_seconds": 354.3,
      "duration_seconds": 7.15,
      "text": "I mean, uh, not with me. I'll bring it next time."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 365.62,
      "end_seconds": 368.39,
      "duration_seconds": 2.77,
      "text": "Before I prescribe anything, any allergies?"
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 370.21,
      "end_seconds": 375.66,
      "duration_seconds": 5.45,
      "text": "Yeah, um, no, no allergies to to anything."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 376.99,
      "end_seconds": 389.0,
      "duration_seconds": 12.01,
      "text": "so, based on the history and the examination, it fits best with a viral fever, possibly dengue i'd also keep typhoid fever in mind"
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 389.92,
      "end_seconds": 393.62,
      "duration_seconds": 3.7,
      "text": "Yeah, is this going to go away?"
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 394.9,
      "end_seconds": 408.96,
      "duration_seconds": 14.06,
      "text": "Nothing I've seen today points to an emergency. It looks like a viral fever, possibly dengue, but I'd like to confirm. A dengue test is what I'd like next, for fever."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 412.14,
      "end_seconds": 416.38,
      "duration_seconds": 4.24,
      "text": "okay, so where do I go for that?"
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 418.2,
      "end_seconds": 424.16,
      "duration_seconds": 5.96,
      "text": "A full blood count is what I'd like next, for platelet count."
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 424.96,
      "end_seconds": 428.25,
      "duration_seconds": 3.29,
      "text": "Well, alright, when would that be?"
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 429.07,
      "end_seconds": 456.84,
      "duration_seconds": 27.77,
      "text": "I'll start you on paracetamol, 500 milligrams, every six hours if needed, for three days. You take it by mouth. That's for fever and body aches. Please avoid ibuprofen or any anti-inflammatory painkillers for now, stick with paracetamol only. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose. I'd like to see you again in two days."
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 458.73,
      "end_seconds": 464.77,
      "duration_seconds": 6.04,
      "text": "Okay, um, so alright, I'll put it in my diary."
    },
    {
      "segment_id": "SEG0059",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 466.49,
      "end_seconds": 470.02,
      "duration_seconds": 3.53,
      "text": "Take care, and call us if anything changes."
    },
    {
      "segment_id": "SEG0060",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 476.23,
      "end_seconds": 479.34,
      "duration_seconds": 3.11,
      "text": "Nothing more from me, thanks."
    },
    {
      "segment_id": "SEG0061",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 480.88,
      "end_seconds": 481.58,
      "duration_seconds": 0.7,
      "text": "goodbye"
    }
  ]
}