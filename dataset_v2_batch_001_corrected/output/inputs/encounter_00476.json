{
  "schema_version": "1.0",
  "encounter_id": "00476",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.53,
      "end_seconds": 5.09,
      "duration_seconds": 4.56,
      "text": "Doctor? Hi. I hope I've got the right time."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.88,
      "end_seconds": 11.34,
      "duration_seconds": 5.46,
      "text": "Of course, put it down anywhere. So, how can I help?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 13.23,
      "end_seconds": 26.99,
      "duration_seconds": 13.76,
      "text": "Um, so... blood in my urine. That's why I came. I'd rather know what's going on than keep guessing. I just want to get back to normal, really."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 28.34,
      "end_seconds": 30.67,
      "duration_seconds": 2.33,
      "text": "Since when have you had this?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 32.08,
      "end_seconds": 35.24,
      "duration_seconds": 3.16,
      "text": "Since yesterday, that's when it began."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 36.1,
      "end_seconds": 43.24,
      "duration_seconds": 7.14,
      "text": "Let me check a few things. Any difficulty passing urine, recent injury or pain on passing urine?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 44.01,
      "end_seconds": 51.98,
      "duration_seconds": 7.97,
      "text": "I haven't had difficulty passing urine, recent injury or pain on passing urine, no."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 53.51,
      "end_seconds": 58.5,
      "duration_seconds": 4.99,
      "text": "So, have you noticed any weakness, or anything odd with your balance?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 60.26,
      "end_seconds": 61.7,
      "duration_seconds": 1.44,
      "text": "Nothing odd there."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 63.79,
      "end_seconds": 65.47,
      "duration_seconds": 1.68,
      "text": "Do you live alone?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 66.41,
      "end_seconds": 69.53,
      "duration_seconds": 3.12,
      "text": "Yes, I live on my own."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 70.97,
      "end_seconds": 73.03,
      "duration_seconds": 2.06,
      "text": "Do you exercise at all?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 73.88,
      "end_seconds": 79.25,
      "duration_seconds": 5.37,
      "text": "I go to the gym a couple of times a week."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 80.91,
      "end_seconds": 83.65,
      "duration_seconds": 2.74,
      "text": "Okay, tell me about your work."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 84.42,
      "end_seconds": 90.42,
      "duration_seconds": 6.0,
      "text": "I'm a software engineer, so I'm at a screen all day."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 99.11,
      "end_seconds": 103.02,
      "duration_seconds": 3.91,
      "text": "Any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 103.95,
      "end_seconds": 106.86,
      "duration_seconds": 2.91,
      "text": "No, I've never had anything serious."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 120.76,
      "end_seconds": 122.18,
      "duration_seconds": 1.42,
      "text": "Any regular medication?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 123.74,
      "end_seconds": 124.92,
      "duration_seconds": 1.18,
      "text": "Nothing, no."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 133.25,
      "end_seconds": 135.56,
      "duration_seconds": 2.31,
      "text": "Any drug or food allergies?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 136.76,
      "end_seconds": 141.28,
      "duration_seconds": 4.52,
      "text": "Eggs. I come out in... well, stomach cramps."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 150.36,
      "end_seconds": 153.44,
      "duration_seconds": 3.08,
      "text": "Okay, I'll take a few measurements first."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 160.54,
      "end_seconds": 162.18,
      "duration_seconds": 1.64,
      "text": "Just relax your arm..."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 182.48,
      "end_seconds": 191.75,
      "duration_seconds": 9.27,
      "text": "Okay: temp 36.6 degrees, pressure 120 over 76. And weight 92 kilos, height 154 centimetres, heart rate 86."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 193.2,
      "end_seconds": 194.61,
      "duration_seconds": 1.41,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 195.57,
      "end_seconds": 197.91,
      "duration_seconds": 2.34,
      "text": "I'll come back to those numbers."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 199.39,
      "end_seconds": 202.48,
      "duration_seconds": 3.09,
      "text": "I'll examine you now, bear with me."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 204.28,
      "end_seconds": 207.62,
      "duration_seconds": 3.34,
      "text": "Stay still while I have a look."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 225.81,
      "end_seconds": 230.48,
      "duration_seconds": 4.67,
      "text": "Abdomen is soft, no masses, and no tenderness in the loins."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 234.44,
      "end_seconds": 250.34,
      "duration_seconds": 15.9,
      "text": "Right, you can sit back down. Right, here's what I'm thinking. I'm honestly not certain yet. It could be blood in the urine that needs full investigation, or it might be a kidney stone."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 256.41,
      "end_seconds": 258.32,
      "duration_seconds": 1.91,
      "text": "Doctor, is this dangerous?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 260.19,
      "end_seconds": 278.68,
      "duration_seconds": 18.49,
      "text": "I can't promise yet, but most people with blood in the urine that needs full investigation do well once it's treated properly. Stop me if I've got anything wrong. You've had blood in your urine, since yesterday, and no pain on passing urine or recent injury."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 279.93,
      "end_seconds": 280.63,
      "duration_seconds": 0.7,
      "text": "Correct."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 282.29,
      "end_seconds": 300.07,
      "duration_seconds": 17.78,
      "text": "We should do a CT scan of the kidneys and bladder for haematuria. Keep drinking plenty of water, and let us know quickly if you pass clots or can't pass urine. Let's get you seen by the urology clinic, I'll arrange the letter."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 300.99,
      "end_seconds": 303.56,
      "duration_seconds": 2.57,
      "text": "Sure, where do I go?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 304.08,
      "end_seconds": 308.76,
      "duration_seconds": 4.68,
      "text": "Come back in two weeks. Ask me anything before you go."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 309.79,
      "end_seconds": 311.81,
      "duration_seconds": 2.02,
      "text": "I appreciate it, doctor."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 313.53,
      "end_seconds": 314.81,
      "duration_seconds": 1.28,
      "text": "See you then."
    }
  ]
}