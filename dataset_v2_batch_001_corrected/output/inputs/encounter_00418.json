{
  "schema_version": "1.0",
  "encounter_id": "00418",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.83,
      "end_seconds": 7.24,
      "duration_seconds": 6.41,
      "text": "Doctor, hello, I've got my papers here, where should I put them?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.23,
      "end_seconds": 14.51,
      "duration_seconds": 6.28,
      "text": "Yes, come in, take a seat. What can I do for you today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 16.57,
      "end_seconds": 22.03,
      "duration_seconds": 5.46,
      "text": "Morning, doctor. I'll stay and fill in anything that's missed."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 23.9,
      "end_seconds": 27.68,
      "duration_seconds": 3.78,
      "text": "Good, that'll be useful. Pull up a chair."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 28.39,
      "end_seconds": 31.36,
      "duration_seconds": 2.97,
      "text": "he's been having muffled hearing, doctor"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 32.61,
      "end_seconds": 35.06,
      "duration_seconds": 2.45,
      "text": "How far back does it go?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 36.99,
      "end_seconds": 46.27,
      "duration_seconds": 9.28,
      "text": "I mean, I've had it since Friday. I kept putting it off, which I know isn't sensible."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 47.77,
      "end_seconds": 51.68,
      "duration_seconds": 3.91,
      "text": "On a normal day, how strong is it?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 52.24,
      "end_seconds": 55.35,
      "duration_seconds": 3.11,
      "text": "Well, it feels severe to me."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 57.3,
      "end_seconds": 61.67,
      "duration_seconds": 4.37,
      "text": "Okay, anything that tends to go along with it?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 62.19,
      "end_seconds": 71.07,
      "duration_seconds": 8.88,
      "text": "When it starts I tend to get a fever as well. The fever? That's been for three days."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 82.53,
      "end_seconds": 86.84,
      "duration_seconds": 4.31,
      "text": "Let's go through your medication. What are you taking?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 88.57,
      "end_seconds": 92.77,
      "duration_seconds": 4.2,
      "text": "Uh, it's paracetamol, 500 milligrams, when needed."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 98.23,
      "end_seconds": 100.51,
      "duration_seconds": 2.28,
      "text": "Any drug or food allergies?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 101.08,
      "end_seconds": 103.96,
      "duration_seconds": 2.88,
      "text": "No, no allergies to anything."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 105.44,
      "end_seconds": 108.51,
      "duration_seconds": 3.07,
      "text": "What kind of work do you do?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 109.72,
      "end_seconds": 113.77,
      "duration_seconds": 4.05,
      "text": "I work on a farm, it's quite physical"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 114.44,
      "end_seconds": 115.91,
      "duration_seconds": 1.47,
      "text": "How's your diet?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 116.86,
      "end_seconds": 118.68,
      "duration_seconds": 1.82,
      "text": "I'm mostly vegetarian"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 119.92,
      "end_seconds": 122.37,
      "duration_seconds": 2.45,
      "text": "Who do you live with?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 123.7,
      "end_seconds": 128.95,
      "duration_seconds": 5.25,
      "text": "I live with my family, my husband and two kids."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 130.45,
      "end_seconds": 134.44,
      "duration_seconds": 3.99,
      "text": "Do you have any medical conditions I should know about?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 136.37,
      "end_seconds": 140.92,
      "duration_seconds": 4.55,
      "text": "No, you know, none that I know of."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 142.28,
      "end_seconds": 145.24,
      "duration_seconds": 2.96,
      "text": "what about operations, anything like that?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 146.01,
      "end_seconds": 151.44,
      "duration_seconds": 5.43,
      "text": "So, just a lump removed from my back, years ago."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 153.25,
      "end_seconds": 158.33,
      "duration_seconds": 5.08,
      "text": "A few quick ones: discharge from the ear or swelling behind the ear?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 158.96,
      "end_seconds": 168.75,
      "duration_seconds": 9.79,
      "text": "I mean, um, no discharge from the ear or swelling behind the ear, none of it."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 169.74,
      "end_seconds": 175.43,
      "duration_seconds": 5.69,
      "text": "Let me check a few things. Any ringing, facial weakness or dizziness?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 177.31,
      "end_seconds": 180.49,
      "duration_seconds": 3.18,
      "text": "No, not any of them."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 182.0,
      "end_seconds": 184.74,
      "duration_seconds": 2.74,
      "text": "Has your heart given you any trouble?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 185.82,
      "end_seconds": 187.28,
      "duration_seconds": 1.46,
      "text": "Nothing like that."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 188.21,
      "end_seconds": 190.18,
      "duration_seconds": 1.97,
      "text": "is your mobility otherwise okay?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 191.12,
      "end_seconds": 194.38,
      "duration_seconds": 3.26,
      "text": "Oh, no, joints are fine."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 196.48,
      "end_seconds": 200.52,
      "duration_seconds": 4.04,
      "text": "Before we go on, a few quick readings."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 214.05,
      "end_seconds": 214.87,
      "duration_seconds": 0.82,
      "text": "one second.."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 226.14,
      "end_seconds": 235.95,
      "duration_seconds": 9.81,
      "text": "Okay: blood pressure 122 over 80, saturation 96 percent, heart rate 88. And respiratory rate 16, temp 39.0 degrees."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 237.34,
      "end_seconds": 239.74,
      "duration_seconds": 2.4,
      "text": "Can I examine you now?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 240.89,
      "end_seconds": 242.92,
      "duration_seconds": 2.03,
      "text": "bear with me a second"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 259.75,
      "end_seconds": 262.16,
      "duration_seconds": 2.41,
      "text": "The left ear looks normal."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 263.74,
      "end_seconds": 266.02,
      "duration_seconds": 2.28,
      "text": "Bear with me a second."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 273.47,
      "end_seconds": 276.42,
      "duration_seconds": 2.95,
      "text": "The right eardrum looks red and bulging."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 279.11,
      "end_seconds": 280.95,
      "duration_seconds": 1.84,
      "text": "Good, that's the examination."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 295.55,
      "end_seconds": 308.52,
      "duration_seconds": 12.97,
      "text": "putting it all together, I think we're dealing with a middle ear infection at this stage it could also be a wax blockage, so we'll keep that open"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 310.22,
      "end_seconds": 312.75,
      "duration_seconds": 2.53,
      "text": "do you think it's serious?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 313.62,
      "end_seconds": 322.34,
      "duration_seconds": 8.72,
      "text": "I understand the worry. At the moment I'd say it's a middle ear infection, and we'll watch how it goes."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 338.11,
      "end_seconds": 348.16,
      "duration_seconds": 10.05,
      "text": "I'll start you on amoxicillin, 500 milligrams, three times a day, for five days. That should help with ear infection"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 349.88,
      "end_seconds": 354.07,
      "duration_seconds": 4.19,
      "text": "Well, is that safe with my other things?"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 356.01,
      "end_seconds": 366.4,
      "duration_seconds": 10.39,
      "text": "Keep the ear dry for now and don't put anything in it, including cotton buds. I'll want another look in a week."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 368.09,
      "end_seconds": 373.82,
      "duration_seconds": 5.73,
      "text": "I mean, I'll make the appointment on my way out."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 378.73,
      "end_seconds": 379.96,
      "duration_seconds": 1.23,
      "text": "Any last questions?"
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 381.8,
      "end_seconds": 386.32,
      "duration_seconds": 4.52,
      "text": "I mean, uh, no questions. Thank you."
    }
  ]
}