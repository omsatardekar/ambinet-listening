{
  "schema_version": "1.0",
  "encounter_id": "00450",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.06,
      "end_seconds": 5.64,
      "duration_seconds": 4.58,
      "text": "Hi, doctor. Long queue outside, but here I am."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.76,
      "end_seconds": 10.01,
      "duration_seconds": 3.25,
      "text": "Not at all, please sit. What's the problem?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 11.32,
      "end_seconds": 17.75,
      "duration_seconds": 6.43,
      "text": "Um, uh, so... nausea in the mornings. That's why I came."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 18.65,
      "end_seconds": 21.21,
      "duration_seconds": 2.56,
      "text": "Are you on any regular medication?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 22.01,
      "end_seconds": 26.11,
      "duration_seconds": 4.1,
      "text": "Okay, so no, I don't take anything regularly."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 27.15,
      "end_seconds": 29.9,
      "duration_seconds": 2.75,
      "text": "How long are we talking about?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 30.72,
      "end_seconds": 36.35,
      "duration_seconds": 5.63,
      "text": "Okay, uh, so it's been going on for three weeks."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 38.21,
      "end_seconds": 42.99,
      "duration_seconds": 4.78,
      "text": "So, how would you describe it, mild, moderate, severe?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 44.82,
      "end_seconds": 49.33,
      "duration_seconds": 4.51,
      "text": "A three out of ten, uh, I suppose."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 50.34,
      "end_seconds": 53.55,
      "duration_seconds": 3.21,
      "text": "Have you noticed vomiting everything or fever?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 55.25,
      "end_seconds": 59.75,
      "duration_seconds": 4.5,
      "text": "Um, no, no vomiting everything or fever."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 61.49,
      "end_seconds": 64.4,
      "duration_seconds": 2.91,
      "text": "A few quick ones: dizziness or bleeding?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 65.73,
      "end_seconds": 68.08,
      "duration_seconds": 2.35,
      "text": "Nothing like that, no."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 73.46,
      "end_seconds": 77.02,
      "duration_seconds": 3.56,
      "text": "How are your joints, any aches elsewhere?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 78.77,
      "end_seconds": 80.21,
      "duration_seconds": 1.44,
      "text": "Nothing else aches."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 94.54,
      "end_seconds": 100.25,
      "duration_seconds": 5.71,
      "text": "Tell me about your routine, work, habits, that sort of thing."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 101.64,
      "end_seconds": 111.77,
      "duration_seconds": 10.13,
      "text": "I don't drink at all. Not really, I don't get much exercise. Yes, I live on my own."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 113.77,
      "end_seconds": 117.28,
      "duration_seconds": 3.51,
      "text": "Any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 118.47,
      "end_seconds": 121.73,
      "duration_seconds": 3.26,
      "text": "No, nothing, I've generally been healthy."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 137.37,
      "end_seconds": 141.64,
      "duration_seconds": 4.27,
      "text": "What about allergies, to medicines or foods or anything else?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 145.01,
      "end_seconds": 150.35,
      "duration_seconds": 5.34,
      "text": "No allergies that I know of, you know, no."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 151.66,
      "end_seconds": 153.26,
      "duration_seconds": 1.6,
      "text": "Let's do your observations."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 160.53,
      "end_seconds": 161.42,
      "duration_seconds": 0.89,
      "text": "One second..."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 180.08,
      "end_seconds": 189.54,
      "duration_seconds": 9.46,
      "text": "Okay: respiratory rate 17, pressure 110 over 70, oxygen saturation is 99 percent, pulse 65, temp 36.7 degrees."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 191.9,
      "end_seconds": 194.23,
      "duration_seconds": 2.33,
      "text": "Shall we do the examination?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 195.63,
      "end_seconds": 197.65,
      "duration_seconds": 2.02,
      "text": "Hold that position for me."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 214.94,
      "end_seconds": 221.15,
      "duration_seconds": 6.21,
      "text": "Tummy is soft, non-tender, and the uterus isn't palpable above the pelvic bone yet."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 224.3,
      "end_seconds": 226.5,
      "duration_seconds": 2.2,
      "text": "Right, that's fine, sit up."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 245.02,
      "end_seconds": 255.17,
      "duration_seconds": 10.15,
      "text": "Having listened and examined, the most likely explanation is an early pregnancy. That's my thinking for now, and it may change as we learn more."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 255.82,
      "end_seconds": 261.29,
      "duration_seconds": 5.47,
      "text": "I've been thinking the worst, to be honest. Is it bad?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 262.08,
      "end_seconds": 271.72,
      "duration_seconds": 9.64,
      "text": "I understand the worry. At the moment I'd say it's an early pregnancy, and we'll know more once the blood tests is back."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 283.35,
      "end_seconds": 287.48,
      "duration_seconds": 4.13,
      "text": "I'd like to arrange blood tests for antenatal screening."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 289.15,
      "end_seconds": 291.6,
      "duration_seconds": 2.45,
      "text": "How long does that take?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 292.3,
      "end_seconds": 312.18,
      "duration_seconds": 19.88,
      "text": "I'd like you to take folic acid, 5 milligrams, once a day, until twelve weeks. You take it by mouth. That should help with pregnancy. Avoid alcohol and don't take any new tablets without checking with us first. Let's plan a check after the scan."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 313.24,
      "end_seconds": 315.28,
      "duration_seconds": 2.04,
      "text": "Okay, I'll book that."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 316.24,
      "end_seconds": 318.12,
      "duration_seconds": 1.88,
      "text": "Thanks for coming in."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 319.1,
      "end_seconds": 321.54,
      "duration_seconds": 2.44,
      "text": "Thank you for your time."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 323.32,
      "end_seconds": 324.27,
      "duration_seconds": 0.95,
      "text": "Take care."
    }
  ]
}