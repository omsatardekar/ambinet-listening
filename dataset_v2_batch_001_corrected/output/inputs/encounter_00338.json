  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 1.27,
      "end_seconds": 7.25,
      "duration_seconds": 5.98,
      "text": "All set here, doctor. Chart's updated, and I'll read the readings out when you're ready."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.53,
      "end_seconds": 13.48,
      "duration_seconds": 4.95,
      "text": "Thanks. Hello, come in, sit down. What brings you in today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 14.65,
      "end_seconds": 26.13,
      "duration_seconds": 11.48,
      "text": "Uh, you know, doctor, thank you for seeing us. It's blurry vision, doctor. She didn't want to to come, but I insisted."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 27.19,
      "end_seconds": 29.97,
      "duration_seconds": 2.78,
      "text": "What medicines do you take regularly?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 30.64,
      "end_seconds": 34.92,
      "duration_seconds": 4.28,
      "text": "It's, It's amlodipine, 5 milligrams, once a day."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 36.81,
      "end_seconds": 42.56,
      "duration_seconds": 5.75,
      "text": "Doctor, our chart from the last visit lists it as 2.5 milligrams."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 43.36,
      "end_seconds": 47.54,
      "duration_seconds": 4.18,
      "text": "Hm, that's different. Is the latest prescription anywhere near you?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 48.65,
      "end_seconds": 59.67,
      "duration_seconds": 11.02,
      "text": "Uh, um, no, I left it at home. Right, I had metformin at one point, but I'm off it now."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 61.04,
      "end_seconds": 64.92,
      "duration_seconds": 3.88,
      "text": "On a normal day, how strong is it?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 66.27,
      "end_seconds": 70.29,
      "duration_seconds": 4.02,
      "text": "A A six out of ten, I suppose."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 70.71,
      "end_seconds": 77.75,
      "duration_seconds": 7.04,
      "text": "And the other thing I wanted to mention is that I can't really—"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 77.85,
      "end_seconds": 84.2,
      "duration_seconds": 6.35,
      "text": "Yeah, tell the doctor about the other thing, that's what worries me."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 86.21,
      "end_seconds": 89.79,
      "duration_seconds": 3.58,
      "text": "Yeah, I was getting to that!"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 90.36,
      "end_seconds": 94.49,
      "duration_seconds": 4.13,
      "text": "That's fine, one at a time. I'll ask about everything."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 96.55,
      "end_seconds": 103.72,
      "duration_seconds": 7.17,
      "text": "I've had tiredness too, for about a month. I've been feeling very thirsty too."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 105.23,
      "end_seconds": 109.01,
      "duration_seconds": 3.78,
      "text": "And what about weight loss or foot sores?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 109.69,
      "end_seconds": 114.23,
      "duration_seconds": 4.54,
      "text": "well, no, none of that at all"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 116.22,
      "end_seconds": 122.83,
      "duration_seconds": 6.61,
      "text": "Let me check a a few things. Any fever, abdominal pain or chest pain?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 123.36,
      "end_seconds": 125.26,
      "duration_seconds": 1.9,
      "text": "no, nothing there"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 126.66,
      "end_seconds": 130.7,
      "duration_seconds": 4.04,
      "text": "Any change in your bowel habit or your stomach generally?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 132.02,
      "end_seconds": 135.03,
      "duration_seconds": 3.01,
      "text": "so, no, all normal there"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 135.8,
      "end_seconds": 138.93,
      "duration_seconds": 3.13,
      "text": "And what do you do for a living?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 140.61,
      "end_seconds": 144.91,
      "duration_seconds": 4.3,
      "text": "I work night shifts at a warehouse."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 162.03,
      "end_seconds": 167.31,
      "duration_seconds": 5.28,
      "text": "Do you have any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 168.19,
      "end_seconds": 186.14,
      "duration_seconds": 17.95,
      "text": "right, I've had diabetes, yes so, yes, high cholesterol i kept putting it off, which I know isn't sensible my family kept telling me to get it checked. High blood pressure, for about a year"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 187.44,
      "end_seconds": 191.93,
      "duration_seconds": 4.49,
      "text": "okay, I can see diabetes in your file as well"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 210.46,
      "end_seconds": 213.23,
      "duration_seconds": 2.77,
      "text": "Before I prescribe anything, any allergies?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 215.23,
      "end_seconds": 219.34,
      "duration_seconds": 4.11,
      "text": "I've never been told I have allergies."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 220.97,
      "end_seconds": 222.16,
      "duration_seconds": 1.19,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 223.9,
      "end_seconds": 228.61,
      "duration_seconds": 4.71,
      "text": "just my appendix out, about eight years ago"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 230.32,
      "end_seconds": 239.61,
      "duration_seconds": 9.29,
      "text": "Here are the numbers, doctor. Oxygen saturation is 99 percent, temp 36.8 degrees. Pulse 88, blood pressure 164 over 91."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 241.32,
      "end_seconds": 260.56,
      "duration_seconds": 19.24,
      "text": "Thanks. Listening to the whole story, it it fits best with diabetes that isn't well controlled. It could also be a medication issue, so we'll keep that open. A urine infection is still possible. I'm sending you for a urine protein test because of diabetes."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_5",
      "role": "CLINICAL_STAFF",
      "start_seconds": 262.41,
      "end_seconds": 265.57,
      "duration_seconds": 3.16,
      "text": "The earliest is Wednesday, 11:30 am."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 266.91,
      "end_seconds": 267.9,
      "duration_seconds": 0.99,
      "text": "That's fine."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 268.43,
      "end_seconds": 277.16,
      "duration_seconds": 8.73,
      "text": "I'm sending you for an eye check because of diabetes. Kidney function tests is what I'd like next, for diabetes."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 282.22,
      "end_seconds": 283.83,
      "duration_seconds": 1.61,
      "text": "fine by me"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 284.87,
      "end_seconds": 288.66,
      "duration_seconds": 3.79,
      "text": "Have you had any tests for this so far?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 290.48,
      "end_seconds": 299.75,
      "duration_seconds": 9.27,
      "text": "oh, I did have an HbA1c done a few months ago, but the paper's at home"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 300.63,
      "end_seconds": 330.17,
      "duration_seconds": 29.54,
      "text": "you'll be taking glimepiride, 1 milligrams, before breakfast, until we review that should help with blood sugar control check your feet every day, and never walk barefoot cut back on sweets, sugary drinks and white rice, and keep to regular meal times and please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 331.64,
      "end_seconds": 333.32,
      "duration_seconds": 1.68,
      "text": "okay, I understand"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 334.01,
      "end_seconds": 349.3,
      "duration_seconds": 15.29,
      "text": "If you vomit repeatedly or become drowsy, or you feel really unwell, please come to to the emergency department. I'd like to see you again in four weeks. Okay, I think we're finished. Is everything clear?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 350.01,
      "end_seconds": 357.3,
      "duration_seconds": 7.29,
      "text": "hmm, you know, I think that's clear thank you for being so thorough"
    }
  ]
}