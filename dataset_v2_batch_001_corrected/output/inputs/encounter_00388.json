{
  "schema_version": "1.0",
  "encounter_id": "00388",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.31,
      "end_seconds": 6.47,
      "duration_seconds": 5.16,
      "text": "Well, hello? Doctor? They told me to come straight in."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.75,
      "end_seconds": 13.42,
      "duration_seconds": 5.67,
      "text": "Yes, come in, take a seat. What can I do for you today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 14.77,
      "end_seconds": 22.76,
      "duration_seconds": 7.99,
      "text": "It's burning in both feet. I thought I'd wait, um, but it hasn't gone."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 23.76,
      "end_seconds": 26.21,
      "duration_seconds": 2.45,
      "text": "How far back does it go?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 29.28,
      "end_seconds": 33.28,
      "duration_seconds": 4.0,
      "text": "It's, It's been going on for two years."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 37.73,
      "end_seconds": 43.08,
      "duration_seconds": 5.35,
      "text": "Okay, give me more detail on it, whatever comes to mind."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 43.62,
      "end_seconds": 69.05,
      "duration_seconds": 25.43,
      "text": "I get some relief from walking around. I notice it more with bedsheets touching them. Honestly, on and off. It feels mild to me. As for feeling unsteady in the dark, I honestly can't say when that began. It might have been last month or the month before."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 70.38,
      "end_seconds": 75.72,
      "duration_seconds": 5.34,
      "text": "And what about hand symptoms, fever, weakness in the legs or back pain?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 77.49,
      "end_seconds": 79.05,
      "duration_seconds": 1.56,
      "text": "No, nothing there."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 80.62,
      "end_seconds": 83.31,
      "duration_seconds": 2.69,
      "text": "And your skin, any changes there?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 84.84,
      "end_seconds": 87.62,
      "duration_seconds": 2.78,
      "text": "Right, no, skin's been fine."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 88.91,
      "end_seconds": 90.9,
      "duration_seconds": 1.99,
      "text": "Anything unusual with passing urine?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 92.7,
      "end_seconds": 94.22,
      "duration_seconds": 1.52,
      "text": "No changes there."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 103.28,
      "end_seconds": 107.37,
      "duration_seconds": 4.09,
      "text": "Moving on to your background, any past medical history?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 109.29,
      "end_seconds": 119.59,
      "duration_seconds": 10.3,
      "text": "I've got acid reflux. I've had diabetes for about a year now. I'm not great at remembering details, so bear with me."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 121.62,
      "end_seconds": 122.41,
      "duration_seconds": 0.79,
      "text": "Any others?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 123.24,
      "end_seconds": 125.73,
      "duration_seconds": 2.49,
      "text": "So, what's your diet like?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 126.56,
      "end_seconds": 130.85,
      "duration_seconds": 4.29,
      "text": "I eat out quite a lot, to be honest."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 132.8,
      "end_seconds": 134.82,
      "duration_seconds": 2.02,
      "text": "Are you working or retired?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 135.47,
      "end_seconds": 139.28,
      "duration_seconds": 3.81,
      "text": "Retired. I stopped a few years back."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 150.77,
      "end_seconds": 153.33,
      "duration_seconds": 2.56,
      "text": "Okay, any drug or food allergies?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 154.11,
      "end_seconds": 157.33,
      "duration_seconds": 3.22,
      "text": "None, as far as I'm aware."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 170.75,
      "end_seconds": 172.7,
      "duration_seconds": 1.95,
      "text": "What's your current medication list?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 174.4,
      "end_seconds": 185.59,
      "duration_seconds": 11.19,
      "text": "I take pantoprazole, 40 milligrams, before breakfast for my acidity. Glycomet. I take it 500 milligrams, twice a day for my sugar."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 187.65,
      "end_seconds": 189.99,
      "duration_seconds": 2.34,
      "text": "Can I take your vitals now?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 201.92,
      "end_seconds": 202.88,
      "duration_seconds": 0.96,
      "text": "Almost there..."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 224.88,
      "end_seconds": 232.25,
      "duration_seconds": 7.37,
      "text": "Okay: saturation 98 percent, pressure 109 over 81. And temp 37.0 degrees, respiratory rate 17, pulse 77."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 232.85,
      "end_seconds": 234.88,
      "duration_seconds": 2.03,
      "text": "Is that alright, doctor?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 236.07,
      "end_seconds": 240.18,
      "duration_seconds": 4.11,
      "text": "They help build the picture, I'll tell you more soon."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 243.11,
      "end_seconds": 246.16,
      "duration_seconds": 3.05,
      "text": "If you're comfortable, I'll examine you now."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 247.19,
      "end_seconds": 249.97,
      "duration_seconds": 2.78,
      "text": "Let me look at this properly."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 264.8,
      "end_seconds": 266.54,
      "duration_seconds": 1.74,
      "text": "Ankle reflexes are absent."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 268.41,
      "end_seconds": 270.9,
      "duration_seconds": 2.49,
      "text": "Let me look at this properly."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 280.91,
      "end_seconds": 285.34,
      "duration_seconds": 4.43,
      "text": "Feeling of light touch is reduced in both feet."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 290.88,
      "end_seconds": 312.61,
      "duration_seconds": 21.73,
      "text": "Thanks, please take a seat again. Right, here's what I'm thinking. The most likely explanation is peripheral neuropathy, possibly related to sugar. I'd also keep a vitamin B12 deficiency in mind. I'd like to arrange a vitamin B12 level for neuropathy. I'd like to arrange an HbA1c for neuropathy."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 314.64,
      "end_seconds": 316.58,
      "duration_seconds": 1.94,
      "text": "Is that done here?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 317.39,
      "end_seconds": 339.27,
      "duration_seconds": 21.88,
      "text": "We'll begin with pregabalin, 75 milligrams, at night, for four weeks. That should help with nerve pain. It's a commonly used medicine and most people tolerate it well. Check your feet every evening for cuts or blisters, you may not feel them. If the symptoms get worse, that's the point to come in urgently."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 342.81,
      "end_seconds": 346.32,
      "duration_seconds": 3.51,
      "text": "Alright, I know what to look for."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 347.39,
      "end_seconds": 352.58,
      "duration_seconds": 5.19,
      "text": "Let's plan a check in four weeks. Do you have any questions?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 354.09,
      "end_seconds": 357.68,
      "duration_seconds": 3.59,
      "text": "That's everything I wanted to ask. Thank you."
    }
  ]
}