{
  "schema_version": "1.0",
  "encounter_id": "00191",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 1.3,
      "end_seconds": 5.52,
      "duration_seconds": 4.22,
      "text": "Doctor, we're ready in room two, I've already taken the observations."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.21,
      "end_seconds": 10.4,
      "duration_seconds": 4.19,
      "text": "Good, thank you. Welcome, tell me what's brought you in."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 11.69,
      "end_seconds": 14.7,
      "duration_seconds": 3.01,
      "text": "It's fever and chills, mostly."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 16.49,
      "end_seconds": 18.49,
      "duration_seconds": 2.0,
      "text": "And when did that start?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 20.44,
      "end_seconds": 28.64,
      "duration_seconds": 8.2,
      "text": "Probably five days. Yeah. A neighbour of mine said I should see someone about it."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 30.63,
      "end_seconds": 33.54,
      "duration_seconds": 2.91,
      "text": "How bad is it, would you say?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 34.37,
      "end_seconds": 43.77,
      "duration_seconds": 9.4,
      "text": "Um, you know, a six out of ten, I suppose. And, And a cough with phlegm, too."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 44.62,
      "end_seconds": 47.46,
      "duration_seconds": 2.84,
      "text": "Is it worse with anything in particular?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 50.98,
      "end_seconds": 55.03,
      "duration_seconds": 4.05,
      "text": "Yes, deep breaths. That makes it worse."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 57.79,
      "end_seconds": 61.72,
      "duration_seconds": 3.93,
      "text": "Is it constant, or does it come and go?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 63.2,
      "end_seconds": 72.96,
      "duration_seconds": 9.76,
      "text": "Honestly, a few times a day. I've been feeling very weak too. As for feeling very weak, severe, really."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 73.88,
      "end_seconds": 75.32,
      "duration_seconds": 1.44,
      "text": "What about alcohol?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 76.44,
      "end_seconds": 80.38,
      "duration_seconds": 3.94,
      "text": "I gave up drinking about three years ago."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 81.45,
      "end_seconds": 82.87,
      "duration_seconds": 1.42,
      "text": "How about smoking?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 84.54,
      "end_seconds": 88.41,
      "duration_seconds": 3.87,
      "text": "I stopped smoking about two years back."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 89.08,
      "end_seconds": 92.13,
      "duration_seconds": 3.05,
      "text": "What do you do to keep active?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 94.05,
      "end_seconds": 97.68,
      "duration_seconds": 3.63,
      "text": "I cycle to work most mornings."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 99.61,
      "end_seconds": 101.81,
      "duration_seconds": 2.2,
      "text": "Right, what's your diet like?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 105.56,
      "end_seconds": 110.27,
      "duration_seconds": 4.71,
      "text": "I eat out quite a lot, to be honest."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 114.22,
      "end_seconds": 116.69,
      "duration_seconds": 2.47,
      "text": "Is anyone at home with you?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 119.86,
      "end_seconds": 123.56,
      "duration_seconds": 3.7,
      "text": "I share a flat with two friends."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 124.66,
      "end_seconds": 128.56,
      "duration_seconds": 3.9,
      "text": "Have you had to have anything operated on?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 129.72,
      "end_seconds": 142.25,
      "duration_seconds": 12.53,
      "text": "Um, um, just my thyroid operated on, a long time ago. I told myself I'd wait and see, and here I am."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 143.23,
      "end_seconds": 147.85,
      "duration_seconds": 4.62,
      "text": "Any medication at the moment, including things from the pharmacy?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 148.73,
      "end_seconds": 163.01,
      "duration_seconds": 14.28,
      "text": "Hmm, I'm on Tiotropium inhaler, once a day. Though honestly, some days I forget to take it. Losartan, 50 milligrams, once a day for my blood pressure."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 163.47,
      "end_seconds": 164.57,
      "duration_seconds": 1.1,
      "text": "Right, right."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 165.55,
      "end_seconds": 172.72,
      "duration_seconds": 7.17,
      "text": "Uh, um, I'm on Dolo, 650 milligrams, when I get the fever."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 174.02,
      "end_seconds": 178.73,
      "duration_seconds": 4.71,
      "text": "What about your general health, any conditions you're being treated for?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 180.73,
      "end_seconds": 191.87,
      "duration_seconds": 11.14,
      "text": "Well, I've had COPD for two years now. Yeah, I've had high blood pressure for about ten years now."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 193.01,
      "end_seconds": 199.1,
      "duration_seconds": 6.09,
      "text": "Right, so COPD is already on your record. We'll keep that in mind today."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 217.79,
      "end_seconds": 222.49,
      "duration_seconds": 4.7,
      "text": "What about allergies, to medicines or foods or anything else?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 223.74,
      "end_seconds": 227.56,
      "duration_seconds": 3.82,
      "text": "Well, no, none that I know of."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 229.11,
      "end_seconds": 233.5,
      "duration_seconds": 4.39,
      "text": "Have you had any vomiting, leg swelling or recent travel?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 235.38,
      "end_seconds": 241.7,
      "duration_seconds": 6.32,
      "text": "Well, I haven't had vomiting, leg swelling or recent travel, no."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 243.07,
      "end_seconds": 246.54,
      "duration_seconds": 3.47,
      "text": "And what about confusion or coughing up blood?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 247.94,
      "end_seconds": 249.72,
      "duration_seconds": 1.78,
      "text": "No, nothing there."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 251.8,
      "end_seconds": 253.89,
      "duration_seconds": 2.09,
      "text": "Has your skin been okay?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 255.93,
      "end_seconds": 260.25,
      "duration_seconds": 4.32,
      "text": "Yeah, you know, nothing on the skin, no."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 264.84,
      "end_seconds": 267.67,
      "duration_seconds": 2.83,
      "text": "How are your bowels, any trouble?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 269.33,
      "end_seconds": 271.93,
      "duration_seconds": 2.6,
      "text": "No, that side's been fine."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 273.06,
      "end_seconds": 286.88,
      "duration_seconds": 13.82,
      "text": "Here are the numbers, doctor. Heart rate 89, pressure 139 over 76. Oxygen saturation is 94 percent, respiratory rate 20, temperature is 37.6 degrees, weight 88 kilos, height 158 centimetres."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 288.11,
      "end_seconds": 289.44,
      "duration_seconds": 1.33,
      "text": "Good, thank you."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 300.39,
      "end_seconds": 315.74,
      "duration_seconds": 15.35,
      "text": "Okay, so my impression from what you've said is this: I think we're dealing with a possible pneumonia on the right side at this stage. I'd also keep pleurisy in mind."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 316.29,
      "end_seconds": 320.04,
      "duration_seconds": 3.75,
      "text": "I mean, do you think it's serious?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 321.02,
      "end_seconds": 349.71,
      "duration_seconds": 28.69,
      "text": "I can't promise yet, but most people with a possible pneumonia on the right side do well once it's treated properly. We should do blood tests for infection. I'm sending you for a sputum culture because of pneumonia. I'll start you on amoxicillin-clavulanate, 625 milligrams, three times a day, for five days. You take it by mouth. That's for chest infection. It's a commonly used medicine and most people tolerate it well."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 351.18,
      "end_seconds": 353.61,
      "duration_seconds": 2.43,
      "text": "Mm, um, okay."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 355.54,
      "end_seconds": 359.86,
      "duration_seconds": 4.32,
      "text": "Rest and fluids, and finish every dose of the antibiotic."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 361.35,
      "end_seconds": 367.39,
      "duration_seconds": 6.04,
      "text": "Yeah, do I need a chest X-ray? I read it might help."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 368.89,
      "end_seconds": 378.46,
      "duration_seconds": 9.57,
      "text": "I don't think that's needed at this stage, the history doesn't call for it. Book a review in three days."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 380.41,
      "end_seconds": 381.11,
      "duration_seconds": 0.7,
      "text": "Fine."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 381.64,
      "end_seconds": 384.46,
      "duration_seconds": 2.82,
      "text": "That's it on my side. Anything unclear?"
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 387.64,
      "end_seconds": 392.66,
      "duration_seconds": 5.02,
      "text": "I mean, that's everything I wanted to ask. Thank you."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 394.05,
      "end_seconds": 396.0,
      "duration_seconds": 1.95,
      "text": "So, bye for now."
    }
  ]
}