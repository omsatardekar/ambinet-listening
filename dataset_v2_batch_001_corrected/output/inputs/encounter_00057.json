{
  "schema_version": "1.0",
  "encounter_id": "00057",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.57,
      "end_seconds": 5.39,
      "duration_seconds": 4.82,
      "text": "Hi, uh, doctor. Is this the right room?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.43,
      "end_seconds": 10.87,
      "duration_seconds": 4.44,
      "text": "You're fine, sit down. So, what brings you in?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 11.72,
      "end_seconds": 25.72,
      "duration_seconds": 14.0,
      "text": "Morning, doctor. I'll stay and fill in anything that's missed. Okay, um, so it's fever and joint pains, doctor. She didn't want to come, but I insisted."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_4",
      "role": "NURSE",
      "start_seconds": 26.96,
      "end_seconds": 44.95,
      "duration_seconds": 17.99,
      "text": "Doctor, I've got the readings for you. Weight 93 kilos, heart rate 90. BMI works out to 31.4, respiratory rate 19, SpO2 95 percent on room air, height 172 centimetres, temperature is 38.5 degrees, blood pressure 108 over 72."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 46.87,
      "end_seconds": 49.67,
      "duration_seconds": 2.8,
      "text": "Thanks. How far back does it go?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 50.99,
      "end_seconds": 53.77,
      "duration_seconds": 2.78,
      "text": "for two weeks, I'd say"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 59.41,
      "end_seconds": 61.45,
      "duration_seconds": 2.04,
      "text": "How intense does it get?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 62.42,
      "end_seconds": 90.26,
      "duration_seconds": 27.84,
      "text": "I'd give it a four, out of ten. So, I've had a headache too, for one week. I mean, about headache, it comes and goes. I've also been feeling wiped out, for about a week. Uh, uh, with feeling wiped out, it's severe, honestly."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 101.62,
      "end_seconds": 105.46,
      "duration_seconds": 3.84,
      "text": "Okay, a few quick ones: vomiting or cough?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 107.36,
      "end_seconds": 111.4,
      "duration_seconds": 4.04,
      "text": "No vomiting or cough, none of it."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 112.67,
      "end_seconds": 115.89,
      "duration_seconds": 3.22,
      "text": "Have you had bleeding, by any chance?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 116.96,
      "end_seconds": 120.11,
      "duration_seconds": 3.15,
      "text": "um, no, none, no bleeding"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 121.68,
      "end_seconds": 125.47,
      "duration_seconds": 3.79,
      "text": "Have you noticed diarrhoea, red eyes or neck stiffness?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 128.79,
      "end_seconds": 135.06,
      "duration_seconds": 6.27,
      "text": "no, you know, no diarrhoea, red eyes or neck stiffness"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 137.12,
      "end_seconds": 139.3,
      "duration_seconds": 2.18,
      "text": "Is your mobility otherwise okay?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 141.3,
      "end_seconds": 142.92,
      "duration_seconds": 1.62,
      "text": "no, nothing there"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 144.51,
      "end_seconds": 146.49,
      "duration_seconds": 1.98,
      "text": "Any trouble with the waterworks?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 148.34,
      "end_seconds": 154.37,
      "duration_seconds": 6.03,
      "text": "I mean, um, that's normal as far as I know."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 156.44,
      "end_seconds": 161.47,
      "duration_seconds": 5.03,
      "text": "Tell me about your routine, work, habits, that sort of thing."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 163.08,
      "end_seconds": 184.38,
      "duration_seconds": 21.3,
      "text": "I smoke about ten cigarettes a day. A beer or two most evenings, to be honest. Not really, I don't get much exercise. I live with my family, my husband and two kids. I work night shifts at a warehouse"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 184.96,
      "end_seconds": 187.34,
      "duration_seconds": 2.38,
      "text": "Does anything run in the family?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 188.07,
      "end_seconds": 191.15,
      "duration_seconds": 3.08,
      "text": "My father had kidney stones."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 192.41,
      "end_seconds": 197.08,
      "duration_seconds": 4.67,
      "text": "Have you ever reacted badly to a medicine or food? Any allergies?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 201.39,
      "end_seconds": 214.6,
      "duration_seconds": 13.21,
      "text": "Hmm, there was some antibiotic, I was told I was allergic. But I couldn't tell you what it was called or what it did."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 215.69,
      "end_seconds": 219.05,
      "duration_seconds": 3.36,
      "text": "Have you ever been under the knife?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 220.67,
      "end_seconds": 226.05,
      "duration_seconds": 5.38,
      "text": "Just a lump removed from my back, years ago."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 228.14,
      "end_seconds": 233.17,
      "duration_seconds": 5.03,
      "text": "so, any medication at the moment, including things from the pharmacy?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 234.01,
      "end_seconds": 239.44,
      "duration_seconds": 5.43,
      "text": "Right, you know, it's escitalopram, once a day, doctor."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 240.99,
      "end_seconds": 243.21,
      "duration_seconds": 2.22,
      "text": "how much do you take?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 243.92,
      "end_seconds": 249.17,
      "duration_seconds": 5.25,
      "text": "10 milligrams, I think that's what's on the box."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 249.74,
      "end_seconds": 250.44,
      "duration_seconds": 0.7,
      "text": "Okay."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 251.9,
      "end_seconds": 263.61,
      "duration_seconds": 11.71,
      "text": "She takes pantoprazole, 40 milligrams, before breakfast for my acidity. She is on Dolo, 650 milligrams, when it flares, I give it to her."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 268.34,
      "end_seconds": 269.95,
      "duration_seconds": 1.61,
      "text": "and for how long?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 270.99,
      "end_seconds": 272.93,
      "duration_seconds": 1.94,
      "text": "For about a year."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 273.74,
      "end_seconds": 278.21,
      "duration_seconds": 4.47,
      "text": "Do you have any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 278.93,
      "end_seconds": 288.44,
      "duration_seconds": 9.51,
      "text": "High blood pressure, for about ten years. So, you know, I have anxiety, for five years"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 290.22,
      "end_seconds": 291.03,
      "duration_seconds": 0.81,
      "text": "I follow."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 292.23,
      "end_seconds": 293.92,
      "duration_seconds": 1.69,
      "text": "Yes, acid reflux."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 295.79,
      "end_seconds": 298.24,
      "duration_seconds": 2.45,
      "text": "Can I examine you now?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 310.29,
      "end_seconds": 310.99,
      "duration_seconds": 0.7,
      "text": "Alright."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 312.27,
      "end_seconds": 314.51,
      "duration_seconds": 2.24,
      "text": "Just relax, I'll be quick."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 330.94,
      "end_seconds": 336.56,
      "duration_seconds": 5.62,
      "text": "A fine rash over the chest and back, not itchy to touch."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 338.18,
      "end_seconds": 340.19,
      "duration_seconds": 2.01,
      "text": "Almost done with this part."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 354.84,
      "end_seconds": 359.56,
      "duration_seconds": 4.72,
      "text": "Both wrists and several finger joints are puffy and tender."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 360.55,
      "end_seconds": 361.25,
      "duration_seconds": 0.7,
      "text": "Fine."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 364.98,
      "end_seconds": 366.76,
      "duration_seconds": 1.78,
      "text": "Right, thanks for that."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 377.65,
      "end_seconds": 399.01,
      "duration_seconds": 21.36,
      "text": "So where does that leave us? This is probably a viral fever with joint involvement, possibly chikungunya. I can't rule out dengue fever yet. We should do a dengue test for fever. I'd rather check than guess, and this is the quickest way to know more."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 400.16,
      "end_seconds": 401.27,
      "duration_seconds": 1.11,
      "text": "Okay, noted."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 401.8,
      "end_seconds": 415.22,
      "duration_seconds": 13.42,
      "text": "let's book a chikungunya test to look into fever with joint pain avoid anti-inflammatory painkillers until we know it isn't dengue okay, that's everything from me any other questions?"
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 418.72,
      "end_seconds": 420.18,
      "duration_seconds": 1.46,
      "text": "Right. Thanks again."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 421.53,
      "end_seconds": 423.44,
      "duration_seconds": 1.91,
      "text": "mind how you go"
    }
  ]
}