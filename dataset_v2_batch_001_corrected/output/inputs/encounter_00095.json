{
  "schema_version": "1.0",
  "encounter_id": "00095",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.34,
      "end_seconds": 3.31,
      "duration_seconds": 1.97,
      "text": "afternoon, um, doctor"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.3,
      "end_seconds": 11.65,
      "duration_seconds": 6.35,
      "text": "Yes, come in, take a seat. What can I do for you today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 12.26,
      "end_seconds": 18.2,
      "duration_seconds": 5.94,
      "text": "It's the room spinning. I thought I'd wait, but it it hasn't gone."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 18.92,
      "end_seconds": 20.81,
      "duration_seconds": 1.89,
      "text": "let's do your observations"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 33.23,
      "end_seconds": 34.05,
      "duration_seconds": 0.82,
      "text": "almost there.."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 44.51,
      "end_seconds": 49.88,
      "duration_seconds": 5.37,
      "text": "Okay: saturation 99 percent, blood pressure 128 over 74, pulse 67."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 50.67,
      "end_seconds": 52.2,
      "duration_seconds": 1.53,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 54.47,
      "end_seconds": 57.95,
      "duration_seconds": 3.48,
      "text": "Right, I'll interpret it once I've examined you."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 59.52,
      "end_seconds": 64.42,
      "duration_seconds": 4.9,
      "text": "I've also been feeling unsteady, for about four days."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 66.43,
      "end_seconds": 67.78,
      "duration_seconds": 1.35,
      "text": "Any hearing loss?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 69.65,
      "end_seconds": 71.75,
      "duration_seconds": 2.1,
      "text": "No, no hearing loss."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 73.23,
      "end_seconds": 79.57,
      "duration_seconds": 6.34,
      "text": "A few quick ones: slurred speech, double vision, weakness or numbness in the face?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 80.98,
      "end_seconds": 88.76,
      "duration_seconds": 7.78,
      "text": "Um, no slurred speech, double vision, weakness or numbness in the face, none of it."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 89.48,
      "end_seconds": 92.33,
      "duration_seconds": 2.85,
      "text": "Anything different when you pass water?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 94.26,
      "end_seconds": 96.21,
      "duration_seconds": 1.95,
      "text": "No, that's all fine."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 109.24,
      "end_seconds": 112.1,
      "duration_seconds": 2.86,
      "text": "have you ever been under the knife?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 116.04,
      "end_seconds": 119.94,
      "duration_seconds": 3.9,
      "text": "I had my gallbladder removed in 2016."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 136.05,
      "end_seconds": 137.5,
      "duration_seconds": 1.45,
      "text": "How about exercise?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 139.26,
      "end_seconds": 142.81,
      "duration_seconds": 3.55,
      "text": "Not really, I don't get much exercise."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 144.26,
      "end_seconds": 146.99,
      "duration_seconds": 2.73,
      "text": "And what do you usually eat?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 148.12,
      "end_seconds": 151.65,
      "duration_seconds": 3.53,
      "text": "Mostly home-cooked food, rice and vegetables."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 159.74,
      "end_seconds": 162.53,
      "duration_seconds": 2.79,
      "text": "Before I prescribe anything, any allergies?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 163.44,
      "end_seconds": 171.45,
      "duration_seconds": 8.01,
      "text": "Right, years back I got wheezing from aspirin, so I stay away from it now."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 172.82,
      "end_seconds": 176.59,
      "duration_seconds": 3.77,
      "text": "Let's go through your medication. What are you taking?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 178.6,
      "end_seconds": 199.62,
      "duration_seconds": 21.02,
      "text": "Metformin, 500 milligrams, twice a day for my sugar. It's losartan, 50 milligrams, once a day. Um, I take Vertin, 16 milligrams, when it comes. Right, before this I was on ramipril; that's been stopped."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 201.01,
      "end_seconds": 205.7,
      "duration_seconds": 4.69,
      "text": "do you have any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 206.5,
      "end_seconds": 215.95,
      "duration_seconds": 9.45,
      "text": "I've got diabetes. High blood pressure, for about a year. My sister suggested writing things down, but I forgot."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 217.47,
      "end_seconds": 224.15,
      "duration_seconds": 6.68,
      "text": "Okay, I can see diabetes and high blood pressure in your file as well."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 225.73,
      "end_seconds": 227.82,
      "duration_seconds": 2.09,
      "text": "Shall we do the examination?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 228.86,
      "end_seconds": 230.81,
      "duration_seconds": 1.95,
      "text": "let me just check something"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 240.06,
      "end_seconds": 247.58,
      "duration_seconds": 7.52,
      "text": "When I turn your head to the right, your eyes flick sideways, that's called nystagmus."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 250.36,
      "end_seconds": 262.24,
      "duration_seconds": 11.88,
      "text": "Good, that's the examination. Having listened and examined, it's hard to say. Benign positional vertigo is one possibility and a migraine-related dizziness another, and I'd rather not commit yet."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 263.49,
      "end_seconds": 267.28,
      "duration_seconds": 3.79,
      "text": "Is this something I'll have for good?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 273.04,
      "end_seconds": 293.52,
      "duration_seconds": 20.48,
      "text": "it's reasonable to be concerned, but right now benign positional vertigo is my leading thought, not anything worse. A hearing test is what I'd like next, for tinnitus and vertigo get up slowly from lying down and sit for a moment first"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 293.96,
      "end_seconds": 300.46,
      "duration_seconds": 6.5,
      "text": "Mm-hm. Don't skip meals, and try to eat smaller portions more often through the day."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 300.73,
      "end_seconds": 307.56,
      "duration_seconds": 6.83,
      "text": "ah let's plan a check in three weeks is there anything you wanted to ask?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 308.18,
      "end_seconds": 309.63,
      "duration_seconds": 1.45,
      "text": "Right. Thanks again."
    }
  ]
}