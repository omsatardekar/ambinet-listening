{
  "schema_version": "1.0",
  "encounter_id": "00054",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.39,
      "end_seconds": 8.88,
      "duration_seconds": 7.49,
      "text": "Hi, doctor, I brought my bag, is it fine to leave it here?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 10.2,
      "end_seconds": 13.51,
      "duration_seconds": 3.31,
      "text": "Not at all, please sit. What's the problem?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 17.81,
      "end_seconds": 21.69,
      "duration_seconds": 3.88,
      "text": "I'm here because of a weak urine stream."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 23.42,
      "end_seconds": 25.88,
      "duration_seconds": 2.46,
      "text": "When did you first notice it?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 26.86,
      "end_seconds": 38.36,
      "duration_seconds": 11.5,
      "text": "Yeah, um, it's been about a month, I'm fairly sure. I've also had dribbling at the end, for about three months."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 39.44,
      "end_seconds": 41.93,
      "duration_seconds": 2.49,
      "text": "Let me measure a few things."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 54.23,
      "end_seconds": 56.13,
      "duration_seconds": 1.9,
      "text": "Just relax your arm..."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 66.02,
      "end_seconds": 75.03,
      "duration_seconds": 9.01,
      "text": "Okay: pulse 66, temp 36.7 degrees, respiratory rate 16, saturation 97 percent, blood pressure 120 over 71."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 75.65,
      "end_seconds": 77.1,
      "duration_seconds": 1.45,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 79.04,
      "end_seconds": 81.49,
      "duration_seconds": 2.45,
      "text": "I'll come back to those numbers."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 90.44,
      "end_seconds": 96.95,
      "duration_seconds": 6.51,
      "text": "Did you get burning when passing urine, weight loss, blood in the urine or fever?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 98.95,
      "end_seconds": 101.24,
      "duration_seconds": 2.29,
      "text": "Nothing like that, no."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 102.06,
      "end_seconds": 103.98,
      "duration_seconds": 1.92,
      "text": "How's your breathing otherwise?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 105.91,
      "end_seconds": 108.08,
      "duration_seconds": 2.17,
      "text": "No problems with breathing."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 110.17,
      "end_seconds": 114.23,
      "duration_seconds": 4.06,
      "text": "Anything with your heart, like skipped beats or fainting?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 116.25,
      "end_seconds": 122.12,
      "duration_seconds": 5.87,
      "text": "My heart's been fine, um, as far as I know."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 138.49,
      "end_seconds": 140.97,
      "duration_seconds": 2.48,
      "text": "Is anyone at home with you?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 146.48,
      "end_seconds": 149.76,
      "duration_seconds": 3.28,
      "text": "I share a flat with two friends."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 151.5,
      "end_seconds": 152.89,
      "duration_seconds": 1.39,
      "text": "And your work?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 157.82,
      "end_seconds": 161.71,
      "duration_seconds": 3.89,
      "text": "I drive a delivery van all day."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 162.3,
      "end_seconds": 164.58,
      "duration_seconds": 2.28,
      "text": "How do you eat, generally?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 165.93,
      "end_seconds": 168.29,
      "duration_seconds": 2.36,
      "text": "I skip breakfast most days."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 170.28,
      "end_seconds": 173.97,
      "duration_seconds": 3.69,
      "text": "Any long-term health problems I should know about?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 178.77,
      "end_seconds": 181.16,
      "duration_seconds": 2.39,
      "text": "Diabetes, for two years."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 185.18,
      "end_seconds": 190.9,
      "duration_seconds": 5.72,
      "text": "Ah. Right, do you have any allergies to medicines, food, anything at all?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 192.85,
      "end_seconds": 195.78,
      "duration_seconds": 2.93,
      "text": "None, as far as I'm aware."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 204.45,
      "end_seconds": 208.65,
      "duration_seconds": 4.2,
      "text": "Any medication at the moment, including things from the pharmacy?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 209.75,
      "end_seconds": 221.72,
      "duration_seconds": 11.97,
      "text": "Glimepiride. I take it 2 milligrams, before breakfast. Sorry, I know I'm rambling a bit. I told myself I'd wait and see, and here I am."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 222.58,
      "end_seconds": 229.36,
      "duration_seconds": 6.78,
      "text": "Let me tell you where I've got to. I'd lean towards an enlarged prostate causing urinary symptoms."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 245.36,
      "end_seconds": 255.47,
      "duration_seconds": 10.11,
      "text": "Let's book an ultrasound of the bladder and prostate to look into urinary symptoms. I'm sending you for kidney function tests because of urinary symptoms."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 256.1,
      "end_seconds": 260.01,
      "duration_seconds": 3.91,
      "text": "Alright, um, when would that be?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 260.96,
      "end_seconds": 270.23,
      "duration_seconds": 9.27,
      "text": "I'd like you to take tamsulosin, 0.4 milligrams, at night, for four weeks. That should help with urinary symptoms."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 271.29,
      "end_seconds": 272.48,
      "duration_seconds": 1.19,
      "text": "Right, understood."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 277.99,
      "end_seconds": 304.57,
      "duration_seconds": 26.58,
      "text": "Cut back on tea and coffee after the afternoon and go before you sleep. I'll also refer you to the urology clinic. Let's hold off on a urine test for now, and if there's no change in two weeks we can revisit it. If the symptoms get worse, that's the point to come in urgently. Let's plan a check in four weeks."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 306.24,
      "end_seconds": 308.45,
      "duration_seconds": 2.21,
      "text": "Okay, see you then."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 310.11,
      "end_seconds": 312.36,
      "duration_seconds": 2.25,
      "text": "Do you have any questions?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 313.08,
      "end_seconds": 316.99,
      "duration_seconds": 3.91,
      "text": "Right, uh, I appreciate it, doctor."
    }
  ]
}