{
  "schema_version": "1.0",
  "encounter_id": "00226",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.82,
      "end_seconds": 5.2,
      "duration_seconds": 4.38,
      "text": "Hi, doctor. Long queue outside, but here I am."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.82,
      "end_seconds": 10.62,
      "duration_seconds": 3.8,
      "text": "You're fine, sit down. So, what brings you in?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 12.59,
      "end_seconds": 19.72,
      "duration_seconds": 7.13,
      "text": "Mainly my heart racing. There's a couple of other things, but that's the main one."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 21.01,
      "end_seconds": 24.2,
      "duration_seconds": 3.19,
      "text": "Okay, when did you first notice it?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 25.73,
      "end_seconds": 27.65,
      "duration_seconds": 1.92,
      "text": "Probably five days. Yeah."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 30.48,
      "end_seconds": 33.18,
      "duration_seconds": 2.7,
      "text": "Is it mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 38.4,
      "end_seconds": 40.2,
      "duration_seconds": 1.8,
      "text": "I'd call it severe."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 41.01,
      "end_seconds": 43.78,
      "duration_seconds": 2.77,
      "text": "Do you notice anything setting it off?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 44.52,
      "end_seconds": 51.71,
      "duration_seconds": 7.19,
      "text": "Coffee and stress definitely sets it off. I'd been sweating, but that went away."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 53.55,
      "end_seconds": 58.11,
      "duration_seconds": 4.56,
      "text": "Alright, and what about weight loss, tremor or leg swelling?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 58.67,
      "end_seconds": 61.95,
      "duration_seconds": 3.28,
      "text": "None, as far as I know."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 62.88,
      "end_seconds": 64.46,
      "duration_seconds": 1.58,
      "text": "What about chest pain?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 65.75,
      "end_seconds": 68.83,
      "duration_seconds": 3.08,
      "text": "I haven't noticed any chest pain."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 69.92,
      "end_seconds": 72.0,
      "duration_seconds": 2.08,
      "text": "Any trouble with the waterworks?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 73.53,
      "end_seconds": 76.69,
      "duration_seconds": 3.16,
      "text": "That's normal as far as I know."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 78.47,
      "end_seconds": 80.42,
      "duration_seconds": 1.95,
      "text": "Is your mobility otherwise okay?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 82.02,
      "end_seconds": 83.39,
      "duration_seconds": 1.37,
      "text": "Nothing else aches."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 84.09,
      "end_seconds": 86.76,
      "duration_seconds": 2.67,
      "text": "Now some background about your lifestyle."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 88.2,
      "end_seconds": 99.64,
      "duration_seconds": 11.44,
      "text": "I don't drink at all. I eat out quite a lot, to be honest. I walk for about half an hour most days."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 101.04,
      "end_seconds": 104.64,
      "duration_seconds": 3.6,
      "text": "Alright, is there anything medical in your background?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 109.65,
      "end_seconds": 113.58,
      "duration_seconds": 3.93,
      "text": "High blood pressure, for about ten years."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 114.28,
      "end_seconds": 116.97,
      "duration_seconds": 2.69,
      "text": "What medicines do you take regularly?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 118.49,
      "end_seconds": 130.09,
      "duration_seconds": 11.6,
      "text": "I take losartan, 50 milligrams, once a day for my blood pressure. I'm supposed to take it regularly, but I don't always manage."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 132.08,
      "end_seconds": 134.86,
      "duration_seconds": 2.78,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 136.5,
      "end_seconds": 138.11,
      "duration_seconds": 1.61,
      "text": "No operations, no."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 146.66,
      "end_seconds": 148.63,
      "duration_seconds": 1.97,
      "text": "Any drug or food allergies?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 150.49,
      "end_seconds": 151.52,
      "duration_seconds": 1.03,
      "text": "No allergies."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 152.46,
      "end_seconds": 155.32,
      "duration_seconds": 2.86,
      "text": "Can I take your vitals now?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 161.78,
      "end_seconds": 163.51,
      "duration_seconds": 1.73,
      "text": "Just relax your arm..."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 176.24,
      "end_seconds": 187.73,
      "duration_seconds": 11.49,
      "text": "Okay: temperature 36.5, pressure 128 over 80, weight 65 kilos, BMI works out to 22.2, height 171 centimetres, pulse is 122 beats a minute."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 189.13,
      "end_seconds": 191.08,
      "duration_seconds": 1.95,
      "text": "Is that alright, doctor?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 192.71,
      "end_seconds": 196.06,
      "duration_seconds": 3.35,
      "text": "I'll interpret it once I've examined you."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 199.02,
      "end_seconds": 201.14,
      "duration_seconds": 2.12,
      "text": "Can I examine you now?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 202.76,
      "end_seconds": 205.5,
      "duration_seconds": 2.74,
      "text": "Alright, bear with me a second."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 218.92,
      "end_seconds": 222.37,
      "duration_seconds": 3.45,
      "text": "No murmurs and the neck veins aren't distended."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 224.22,
      "end_seconds": 225.27,
      "duration_seconds": 1.05,
      "text": "Yes, doctor."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 227.44,
      "end_seconds": 228.37,
      "duration_seconds": 0.93,
      "text": "Okay, finished."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 247.26,
      "end_seconds": 257.8,
      "duration_seconds": 10.54,
      "text": "Taking everything into account, my working impression is a possible heart rhythm problem like atrial fibrillation. I'd also keep a thyroid problem in mind."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 276.05,
      "end_seconds": 279.84,
      "duration_seconds": 3.79,
      "text": "I'd like to arrange a thyroid test for palpitations."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 280.7,
      "end_seconds": 283.57,
      "duration_seconds": 2.87,
      "text": "Where do I go for that?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 285.35,
      "end_seconds": 304.36,
      "duration_seconds": 19.01,
      "text": "Let's get a Holter monitor, for palpitations. For this, metoprolol, 25 milligrams, twice a day, until we review. It's for palpitations. Cut back on tea, coffee and energy drinks, and note the time whenever it happens. I'll want another look after the results are back."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 305.56,
      "end_seconds": 306.26,
      "duration_seconds": 0.7,
      "text": "Fine."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 307.41,
      "end_seconds": 309.62,
      "duration_seconds": 2.21,
      "text": "Alright, I'll see you out."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 311.41,
      "end_seconds": 313.56,
      "duration_seconds": 2.15,
      "text": "No questions. Thank you."
    }
  ]
