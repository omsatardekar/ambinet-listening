{
  "schema_version": "1.0",
  "encounter_id": "00270",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.92,
      "end_seconds": 9.07,
      "duration_seconds": 8.15,
      "text": "So, hi doctor, sorry, the lift was out and I had to take the stairs."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 10.17,
      "end_seconds": 16.21,
      "duration_seconds": 6.04,
      "text": "Yes, come in, take a seat. What can I do for you today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 17.87,
      "end_seconds": 31.44,
      "duration_seconds": 13.57,
      "text": "Hello, doctor. I hope it's alright if I stay in for this. Doctor, you know, it's tiny spots between my fingers. That's what we're worried about."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 32.5,
      "end_seconds": 34.63,
      "duration_seconds": 2.13,
      "text": "Roughly when did it start?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 36.5,
      "end_seconds": 40.34,
      "duration_seconds": 3.84,
      "text": "Right, uh, around three days, I think."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 42.35,
      "end_seconds": 46.32,
      "duration_seconds": 3.97,
      "text": "Yeah, hm, I'd say more like five days."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 51.31,
      "end_seconds": 55.54,
      "duration_seconds": 4.23,
      "text": "Okay, so roughly three to five days. Is that right?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 56.14,
      "end_seconds": 57.22,
      "duration_seconds": 1.08,
      "text": "Yeah, roughly."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 58.13,
      "end_seconds": 60.58,
      "duration_seconds": 2.45,
      "text": "Is it mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 62.34,
      "end_seconds": 68.84,
      "duration_seconds": 6.5,
      "text": "It feels mild to me. There's trouble sleeping because of it as well."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 70.22,
      "end_seconds": 73.22,
      "duration_seconds": 3.0,
      "text": "Is it mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 75.22,
      "end_seconds": 78.36,
      "duration_seconds": 3.14,
      "text": "About a five out of ten."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 93.84,
      "end_seconds": 97.79,
      "duration_seconds": 3.95,
      "text": "Any relatives with health problems I should be aware of?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 99.24,
      "end_seconds": 104.55,
      "duration_seconds": 5.31,
      "text": "Well, my brother has asthma. My sister has thyroid problems."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 108.62,
      "end_seconds": 110.97,
      "duration_seconds": 2.35,
      "text": "Do you have a job?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 111.73,
      "end_seconds": 113.65,
      "duration_seconds": 1.92,
      "text": "I'm a self-employed electrician."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 114.86,
      "end_seconds": 117.59,
      "duration_seconds": 2.73,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 122.8,
      "end_seconds": 124.47,
      "duration_seconds": 1.67,
      "text": "No operations, no."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 128.66,
      "end_seconds": 131.48,
      "duration_seconds": 2.82,
      "text": "Any allergies I should know about?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 132.59,
      "end_seconds": 136.56,
      "duration_seconds": 3.97,
      "text": "I've never been told I have allergies."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 138.35,
      "end_seconds": 147.73,
      "duration_seconds": 9.38,
      "text": "Hold on, um, doctor, I think he reacted to sulfa drugs once. I'm not certain, though."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 149.44,
      "end_seconds": 153.92,
      "duration_seconds": 4.48,
      "text": "Uh, maybe, but I don't recall it."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 155.98,
      "end_seconds": 159.22,
      "duration_seconds": 3.24,
      "text": "Fair enough, I'll write down both versions."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 172.14,
      "end_seconds": 175.3,
      "duration_seconds": 3.16,
      "text": "Are you on any tablets or medication?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 176.3,
      "end_seconds": 180.93,
      "duration_seconds": 4.63,
      "text": "Hydrocortisone cream. I take it when needed for the eczema."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 181.2,
      "end_seconds": 181.9,
      "duration_seconds": 0.7,
      "text": "Okay."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 183.55,
      "end_seconds": 190.69,
      "duration_seconds": 7.14,
      "text": "Escitalopram, 10 milligrams, once a day for the anxiety. I'm on paracetamol, when needed."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 191.61,
      "end_seconds": 193.7,
      "duration_seconds": 2.09,
      "text": "And what strength is that?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 197.94,
      "end_seconds": 205.65,
      "duration_seconds": 7.71,
      "text": "650 milligrams, I think that's what's on the box. I'm on cetirizine, 10 milligrams, at night."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 206.36,
      "end_seconds": 208.84,
      "duration_seconds": 2.48,
      "text": "Roughly how long on that one?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 209.66,
      "end_seconds": 211.72,
      "duration_seconds": 2.06,
      "text": "Nearly five years now."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 213.24,
      "end_seconds": 217.07,
      "duration_seconds": 3.83,
      "text": "Any long-term health problems I should know about?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 218.33,
      "end_seconds": 220.96,
      "duration_seconds": 2.63,
      "text": "Eczema, for nearly five years."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 222.46,
      "end_seconds": 224.21,
      "duration_seconds": 1.75,
      "text": "And apart from that?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 225.73,
      "end_seconds": 229.02,
      "duration_seconds": 3.29,
      "text": "I have anxiety, for nearly five years."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 230.97,
      "end_seconds": 232.59,
      "duration_seconds": 1.62,
      "text": "And apart from that?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 234.3,
      "end_seconds": 237.11,
      "duration_seconds": 2.81,
      "text": "I have arthritis in my knees."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 238.14,
      "end_seconds": 249.79,
      "duration_seconds": 11.65,
      "text": "Yes, arthritis in your knees is known to us, good to have that clear. And what about fever or itching in other family members?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 250.75,
      "end_seconds": 267.79,
      "duration_seconds": 17.04,
      "text": "Okay, uh, so no, no fever, no itching in other family members. I did have a rash that started in the finger webs at one point, but that went away on its own."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 268.71,
      "end_seconds": 273.04,
      "duration_seconds": 4.33,
      "text": "Any rash on the face or pus at all?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 274.4,
      "end_seconds": 276.35,
      "duration_seconds": 1.95,
      "text": "No. None of those."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 278.28,
      "end_seconds": 280.62,
      "duration_seconds": 2.34,
      "text": "Did you notice any joint pain?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 283.14,
      "end_seconds": 286.4,
      "duration_seconds": 3.26,
      "text": "Not at all, no joint pain."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 287.59,
      "end_seconds": 289.8,
      "duration_seconds": 2.21,
      "text": "Your breathing, any trouble there?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 291.5,
      "end_seconds": 292.43,
      "duration_seconds": 0.93,
      "text": "Breathing's normal."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 293.61,
      "end_seconds": 296.4,
      "duration_seconds": 2.79,
      "text": "Any muscle or joint problems besides this?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 298.07,
      "end_seconds": 299.92,
      "duration_seconds": 1.85,
      "text": "I move fine otherwise."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 301.67,
      "end_seconds": 303.6,
      "duration_seconds": 1.93,
      "text": "Let's do your observations."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 314.12,
      "end_seconds": 315.79,
      "duration_seconds": 1.67,
      "text": "Rest your hand here..."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 329.42,
      "end_seconds": 338.81,
      "duration_seconds": 9.39,
      "text": "Okay: blood pressure 115 over 82, respiratory rate 14, oxygen saturation is 97 percent, pulse is 67 beats a minute."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 340.38,
      "end_seconds": 343.33,
      "duration_seconds": 2.95,
      "text": "I'll examine you now, bear with me."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 344.7,
      "end_seconds": 345.4,
      "duration_seconds": 0.7,
      "text": "Sure."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 347.36,
      "end_seconds": 348.96,
      "duration_seconds": 1.6,
      "text": "Let me press here."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 363.51,
      "end_seconds": 369.16,
      "duration_seconds": 5.65,
      "text": "Tiny linear burrows between the fingers and scratched papules on the wrists."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 371.64,
      "end_seconds": 406.7,
      "duration_seconds": 35.06,
      "text": "Alright, good, that's the examination. From what you've told me and what I found, this looks most like scabies. I want to be honest that this is an impression, not a final answer. I can't rule out eczema yet. I'll start you on permethrin cream, applied once, repeated in a week, for two applications. That's for scabies. Everyone in the house should be treated at the same time, and bedding washed hot. Book a review in two weeks."
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_4",
      "role": "CLINICAL_STAFF",
      "start_seconds": 407.94,
      "end_seconds": 411.76,
      "duration_seconds": 3.82,
      "text": "Come by reception afterwards and I'll fix the appointment."
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 413.24,
      "end_seconds": 417.16,
      "duration_seconds": 3.92,
      "text": "Okay, I think we're finished. Is everything clear?"
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 421.0,
      "end_seconds": 424.91,
      "duration_seconds": 3.91,
      "text": "That's everything I wanted to ask. Thank you."
    }
  ]
}