{
  "schema_version": "1.0",
  "encounter_id": "00297",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 1.08,
      "end_seconds": 6.84,
      "duration_seconds": 5.76,
      "text": "Doctor, I've brought them through. The observations are done, whenever you need them."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.8,
      "end_seconds": 11.91,
      "duration_seconds": 4.11,
      "text": "Thank you. Good morning, tell me what's been going on."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 12.8,
      "end_seconds": 15.78,
      "duration_seconds": 2.98,
      "text": "Doctor, thank you for seeing us."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 16.29,
      "end_seconds": 19.78,
      "duration_seconds": 3.49,
      "text": "Yes, that's no problem at all. Please sit."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 21.54,
      "end_seconds": 27.06,
      "duration_seconds": 5.52,
      "text": "He's been having tightness in my chest when I walk, doctor."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 33.31,
      "end_seconds": 44.68,
      "duration_seconds": 11.37,
      "text": "Here are the numbers, doctor. Weight 58 kilos, saturation 99 percent. Pulse is 87 beats a minute, pressure 148 over 95, BMI works out to 24.5, height 154 centimetres."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 46.21,
      "end_seconds": 49.91,
      "duration_seconds": 3.7,
      "text": "Good, thank you. Since when have you had this?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 51.65,
      "end_seconds": 55.03,
      "duration_seconds": 3.38,
      "text": "About three days, give or take."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 60.51,
      "end_seconds": 64.3,
      "duration_seconds": 3.79,
      "text": "Hm, I'd say more like five days."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 65.2,
      "end_seconds": 69.35,
      "duration_seconds": 4.15,
      "text": "Okay, so roughly three to five days. Is that right?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 70.91,
      "end_seconds": 72.88,
      "duration_seconds": 1.97,
      "text": "I suppose so, yes."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 74.5,
      "end_seconds": 78.36,
      "duration_seconds": 3.86,
      "text": "Is it constant, or does it come and go?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 83.36,
      "end_seconds": 86.87,
      "duration_seconds": 3.51,
      "text": "It's a couple of times a week."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 87.39,
      "end_seconds": 91.13,
      "duration_seconds": 3.74,
      "text": "So, is it worse with anything in particular?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 96.99,
      "end_seconds": 102.13,
      "duration_seconds": 5.14,
      "text": "I notice it more with climbing stairs and walking fast."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 103.0,
      "end_seconds": 108.64,
      "duration_seconds": 5.64,
      "text": "I was just going to say that the main thing is—"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 108.74,
      "end_seconds": 116.22,
      "duration_seconds": 7.48,
      "text": "Sorry to cut in, doctor, quick question: shall I bring the trolley in now or later?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 117.62,
      "end_seconds": 120.17,
      "duration_seconds": 2.55,
      "text": "Later, thanks. Please go on."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 121.39,
      "end_seconds": 128.05,
      "duration_seconds": 6.66,
      "text": "Right, and I've been sweating with it as well, for five days."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 129.73,
      "end_seconds": 133.75,
      "duration_seconds": 4.02,
      "text": "What's the pattern, is it there all day?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 135.0,
      "end_seconds": 137.26,
      "duration_seconds": 2.26,
      "text": "It just comes and goes."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_5",
      "role": "UNKNOWN",
      "start_seconds": 138.82,
      "end_seconds": 141.73,
      "duration_seconds": 2.91,
      "text": "Mm, that's what happened, yes."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 142.86,
      "end_seconds": 145.93,
      "duration_seconds": 3.07,
      "text": "Have you had any pain at rest?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 147.86,
      "end_seconds": 151.56,
      "duration_seconds": 3.7,
      "text": "No, I haven't had any pain at rest."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 152.36,
      "end_seconds": 157.76,
      "duration_seconds": 5.4,
      "text": "And what about palpitations, swelling in the ankles, cough or fever?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 159.16,
      "end_seconds": 173.42,
      "duration_seconds": 14.26,
      "text": "No, no palpitations, no swelling in the ankles, no cough. I did have a heavy feeling in the left arm at one point, but that went away on its own."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 174.85,
      "end_seconds": 178.51,
      "duration_seconds": 3.66,
      "text": "Any pins and needles or loss of strength anywhere?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 179.52,
      "end_seconds": 181.61,
      "duration_seconds": 2.09,
      "text": "No weakness or anything."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 184.65,
      "end_seconds": 187.51,
      "duration_seconds": 2.86,
      "text": "A few questions about your lifestyle now."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 190.27,
      "end_seconds": 206.02,
      "duration_seconds": 15.75,
      "text": "I smoke, yes, around five a day. I gave up drinking about three years ago. It's just me and my wife at home now. I walk for about half an hour most days."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 206.62,
      "end_seconds": 211.0,
      "duration_seconds": 4.38,
      "text": "Tell me about your health in general, any ongoing conditions?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 211.69,
      "end_seconds": 221.28,
      "duration_seconds": 9.59,
      "text": "Yes, high blood pressure. High cholesterol, for about ten years. Yes, diabetes. I have heart disease, for five years."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 222.75,
      "end_seconds": 233.56,
      "duration_seconds": 10.81,
      "text": "Yes, high blood pressure and high cholesterol are known to us, good to have that clear. Let's go through your medication. What are you taking?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 234.26,
      "end_seconds": 244.31,
      "duration_seconds": 10.05,
      "text": "I'm on telmisartan, 40 milligrams, once a day. Rosuvastatin. I take it 10 milligrams, maybe, at night."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 245.07,
      "end_seconds": 248.92,
      "duration_seconds": 3.85,
      "text": "So, is the packet here, or the prescription?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 249.87,
      "end_seconds": 261.13,
      "duration_seconds": 11.26,
      "text": "Not with me. I'll bring it next time. Glimepiride, 2 milligrams, before breakfast. Clopidogrel, 75 milligrams, once a day for the stent."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 262.6,
      "end_seconds": 265.55,
      "duration_seconds": 2.95,
      "text": "How long has that been going on?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 266.95,
      "end_seconds": 269.07,
      "duration_seconds": 2.12,
      "text": "Nearly five years now."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 273.62,
      "end_seconds": 278.13,
      "duration_seconds": 4.51,
      "text": "Are there any allergies on your record that I should check?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 279.28,
      "end_seconds": 288.21,
      "duration_seconds": 8.93,
      "text": "I think I reacted to some antibiotic once, years ago. I don't remember which one, or what happened exactly."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 289.32,
      "end_seconds": 293.24,
      "duration_seconds": 3.92,
      "text": "Come over here and I'll have a look."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 294.55,
      "end_seconds": 296.91,
      "duration_seconds": 2.36,
      "text": "Let me look at this properly."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 310.9,
      "end_seconds": 315.58,
      "duration_seconds": 4.68,
      "text": "Lungs are clear and there's no swelling in your ankles."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 317.01,
      "end_seconds": 319.31,
      "duration_seconds": 2.3,
      "text": "Let me just check something."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 330.94,
      "end_seconds": 333.45,
      "duration_seconds": 2.51,
      "text": "Heart sounds are normal, no murmurs."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 337.3,
      "end_seconds": 339.03,
      "duration_seconds": 1.73,
      "text": "That's fine, sit up."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 351.35,
      "end_seconds": 357.88,
      "duration_seconds": 6.53,
      "text": "Right, here's what I'm thinking. This is probably angina-type chest pain. We shouldn't forget gastro-oesophageal reflux."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 358.73,
      "end_seconds": 363.98,
      "duration_seconds": 5.25,
      "text": "I've been thinking the worst, to be honest. Is it bad?"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 364.9,
      "end_seconds": 372.72,
      "duration_seconds": 7.82,
      "text": "It's reasonable to be concerned, but right now angina-type chest pain is my leading thought, not anything worse."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 383.03,
      "end_seconds": 388.43,
      "duration_seconds": 5.4,
      "text": "Doctor, I did an ECG before they came in, the result's on your screen."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 390.24,
      "end_seconds": 398.11,
      "duration_seconds": 7.87,
      "text": "Great, that saves time. I think a treadmill test makes sense here, for exertional chest tightness."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 398.95,
      "end_seconds": 401.68,
      "duration_seconds": 2.73,
      "text": "Alright, when would that be?"
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 403.43,
      "end_seconds": 411.48,
      "duration_seconds": 8.05,
      "text": "And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 413.19,
      "end_seconds": 414.68,
      "duration_seconds": 1.49,
      "text": "Okay, I'll remember."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 415.5,
      "end_seconds": 418.79,
      "duration_seconds": 3.29,
      "text": "That's it on my side. Anything unclear?"
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 420.75,
      "end_seconds": 424.39,
      "duration_seconds": 3.64,
      "text": "That's everything I wanted to ask. Thank you."
    }
  ]
}