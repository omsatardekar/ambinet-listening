  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.02,
      "end_seconds": 2.07,
      "duration_seconds": 1.05,
      "text": "Afternoon, doctor."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 3.0,
      "end_seconds": 6.32,
      "duration_seconds": 3.32,
      "text": "Not at all, please sit. What's the problem?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 7.73,
      "end_seconds": 12.66,
      "duration_seconds": 4.93,
      "text": "So, I've been getting breathless walking short distances, doctor."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 13.88,
      "end_seconds": 15.59,
      "duration_seconds": 1.71,
      "text": "When did it begin?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 17.45,
      "end_seconds": 20.39,
      "duration_seconds": 2.94,
      "text": "For about three months, I'd say."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 35.01,
      "end_seconds": 38.62,
      "duration_seconds": 3.61,
      "text": "Did you get night sweats or weight loss?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 39.52,
      "end_seconds": 41.31,
      "duration_seconds": 1.79,
      "text": "No, nothing there."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 42.93,
      "end_seconds": 45.66,
      "duration_seconds": 2.73,
      "text": "Any coughing up blood or chest pain?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 47.13,
      "end_seconds": 50.52,
      "duration_seconds": 3.39,
      "text": "Yeah, no, I'd have mentioned it."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 50.81,
      "end_seconds": 53.56,
      "duration_seconds": 2.75,
      "text": "I see. Is your digestion otherwise okay?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 54.63,
      "end_seconds": 56.9,
      "duration_seconds": 2.27,
      "text": "No, all normal there."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 72.65,
      "end_seconds": 76.55,
      "duration_seconds": 3.9,
      "text": "Is there a family history of anything significant?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 77.49,
      "end_seconds": 80.43,
      "duration_seconds": 2.94,
      "text": "Oh, my father had kidney stones."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 81.49,
      "end_seconds": 84.59,
      "duration_seconds": 3.1,
      "text": "Right, have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 85.56,
      "end_seconds": 87.32,
      "duration_seconds": 1.76,
      "text": "No operations, no."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 88.92,
      "end_seconds": 94.05,
      "duration_seconds": 5.13,
      "text": "Do you have any allergies to medicines, food, anything at all?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 95.59,
      "end_seconds": 103.16,
      "duration_seconds": 7.57,
      "text": "I had a reaction to penicillin when I was younger, hives, and I've avoided it since."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 105.25,
      "end_seconds": 107.99,
      "duration_seconds": 2.74,
      "text": "Are you on any regular medication?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 109.25,
      "end_seconds": 112.5,
      "duration_seconds": 3.25,
      "text": "No, I don't take anything regularly."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 115.54,
      "end_seconds": 120.57,
      "duration_seconds": 5.03,
      "text": "Alright, do you have any medical conditions I should know about?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 121.14,
      "end_seconds": 124.55,
      "duration_seconds": 3.41,
      "text": "No, I've never had anything serious."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 129.43,
      "end_seconds": 132.34,
      "duration_seconds": 2.91,
      "text": "A few questions about your lifestyle now."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 134.22,
      "end_seconds": 148.61,
      "duration_seconds": 14.39,
      "text": "It's just me and my wife at home now. Yes, I'm a nurse on a busy ward. I walk for about half an hour most days."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 156.17,
      "end_seconds": 158.79,
      "duration_seconds": 2.62,
      "text": "A few measurements, then we'll continue."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 164.9,
      "end_seconds": 166.74,
      "duration_seconds": 1.84,
      "text": "Hold still for me..."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 177.1,
      "end_seconds": 184.52,
      "duration_seconds": 7.42,
      "text": "Okay: SpO2 92 percent on room air, heart rate 100, BP is 122 over 80, respiratory rate 23."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 187.22,
      "end_seconds": 190.09,
      "duration_seconds": 2.87,
      "text": "I'll examine you now, bear with me."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 190.99,
      "end_seconds": 193.47,
      "duration_seconds": 2.48,
      "text": "Just relax, I'll be quick."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 208.25,
      "end_seconds": 210.63,
      "duration_seconds": 2.38,
      "text": "No clubbing in the fingers."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 211.66,
      "end_seconds": 213.92,
      "duration_seconds": 2.26,
      "text": "Bear with me a second."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 231.37,
      "end_seconds": 235.61,
      "duration_seconds": 4.24,
      "text": "There are fine crackles at the bases of both lungs."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 239.08,
      "end_seconds": 241.53,
      "duration_seconds": 2.45,
      "text": "Okay, you can sit up."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 254.67,
      "end_seconds": 278.44,
      "duration_seconds": 23.77,
      "text": "Taking everything into account, this looks most like chronic breathlessness that needs a proper work-up. I want to be honest that this is an impression, not a final answer. So, to recap quickly. You've been getting breathless walking short distances for about three months, and no night sweats or weight loss."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 279.58,
      "end_seconds": 281.16,
      "duration_seconds": 1.58,
      "text": "Yes, that's right."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 282.0,
      "end_seconds": 303.41,
      "duration_seconds": 21.41,
      "text": "I think breathing tests makes sense here, for chronic breathlessness. I'd rather check than guess, and this is the quickest way to know more. Try a daily walk and note how far you get before you need to stop. I think a chest physician should see you too."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 304.57,
      "end_seconds": 305.27,
      "duration_seconds": 0.7,
      "text": "Okay."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 308.0,
      "end_seconds": 314.77,
      "duration_seconds": 6.77,
      "text": "If the symptoms get worse, or you feel really unwell, please come to the emergency department."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 315.91,
      "end_seconds": 319.14,
      "duration_seconds": 3.23,
      "text": "Yes, I'll keep that in mind."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 324.04,
      "end_seconds": 325.34,
      "duration_seconds": 1.3,
      "text": "Any last questions?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 326.65,
      "end_seconds": 330.52,
      "duration_seconds": 3.87,
      "text": "Hmm, nothing more from me, thanks."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 332.14,
      "end_seconds": 333.49,
      "duration_seconds": 1.35,
      "text": "All the best."
    }
  ]
