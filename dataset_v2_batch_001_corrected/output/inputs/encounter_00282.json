{
  "schema_version": "1.0",
  "encounter_id": "00282",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 1.32,
      "end_seconds": 7.63,
      "duration_seconds": 6.31,
      "text": "okay, doctor, we're all set in here. I'll give you the numbers when you want them"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 9.7,
      "end_seconds": 13.18,
      "duration_seconds": 3.48,
      "text": "okay, thanks. Hi, how can I help today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 14.57,
      "end_seconds": 20.68,
      "duration_seconds": 6.11,
      "text": "Hello um doctor. I hope it's alright if I stay in for this."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 22.6,
      "end_seconds": 26.91,
      "duration_seconds": 4.31,
      "text": "Of course please stay. It's helpful to have you here."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 28.91,
      "end_seconds": 32.85,
      "duration_seconds": 3.94,
      "text": "doctor it's bruising. That's what we're worried about"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 33.45,
      "end_seconds": 35.45,
      "duration_seconds": 2.0,
      "text": "And when did that start?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 38.61,
      "end_seconds": 42.35,
      "duration_seconds": 3.74,
      "text": "It's been going on for about two weeks."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 43.01,
      "end_seconds": 50.15,
      "duration_seconds": 7.14,
      "text": "Hmm, I was just going to say that the the main thing is—"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 50.25,
      "end_seconds": 57.77,
      "duration_seconds": 7.52,
      "text": "sorry to to cut in, doctor, quick question: shall I bring the trolley in now or later?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 58.69,
      "end_seconds": 61.04,
      "duration_seconds": 2.35,
      "text": "Later thanks. Please go on."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 63.11,
      "end_seconds": 68.39,
      "duration_seconds": 5.28,
      "text": "I've, I've had a weak grip too, for two days"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 69.05,
      "end_seconds": 73.51,
      "duration_seconds": 4.46,
      "text": "right, on a normal day, how strong is it?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 77.66,
      "end_seconds": 89.38,
      "duration_seconds": 11.72,
      "text": "okay, so pretty moderate, if I'm being honest oh, and tingling in the fingers that's been about the same, one week"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 90.27,
      "end_seconds": 92.43,
      "duration_seconds": 2.16,
      "text": "How often does it happen?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 93.51,
      "end_seconds": 99.82,
      "duration_seconds": 6.31,
      "text": "It's, um... not exactly... well, hard to explain, I mean—"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 100.86,
      "end_seconds": 106.89,
      "duration_seconds": 6.03,
      "text": "Let me put it another way: how many times in a typical day or week?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 107.78,
      "end_seconds": 109.65,
      "duration_seconds": 1.87,
      "text": "it's on and off"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 111.73,
      "end_seconds": 113.94,
      "duration_seconds": 2.21,
      "text": "and how severe is it?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 115.61,
      "end_seconds": 122.16,
      "duration_seconds": 6.55,
      "text": "Well it's... hard to say it's kind of... I don't know—"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 124.03,
      "end_seconds": 129.34,
      "duration_seconds": 5.31,
      "text": "take your time. Mild moderate or severe if you had to pick?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 130.31,
      "end_seconds": 139.95,
      "duration_seconds": 9.64,
      "text": "I'd say mild. And there's pain in my left wrist after a fall as well, one week now."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 140.68,
      "end_seconds": 143.37,
      "duration_seconds": 2.69,
      "text": "how much is it bothering you?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 144.71,
      "end_seconds": 146.49,
      "duration_seconds": 1.78,
      "text": "it's severe, honestly"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_5",
      "role": "UNKNOWN",
      "start_seconds": 147.17,
      "end_seconds": 149.22,
      "duration_seconds": 2.05,
      "text": "Yes exactly like that."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 163.94,
      "end_seconds": 168.61,
      "duration_seconds": 4.67,
      "text": "Alright, have you noticed pain in the shoulder or numbness?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 169.83,
      "end_seconds": 172.33,
      "duration_seconds": 2.5,
      "text": "no I'd have mentioned it"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 174.3,
      "end_seconds": 181.31,
      "duration_seconds": 7.01,
      "text": "alright, any pain in the elbow, bump to the head or loss of consciousness at all?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 181.92,
      "end_seconds": 184.51,
      "duration_seconds": 2.59,
      "text": "No, I'd have mentioned it."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 185.23,
      "end_seconds": 187.86,
      "duration_seconds": 2.63,
      "text": "right, is your digestion otherwise okay?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 189.47,
      "end_seconds": 191.25,
      "duration_seconds": 1.78,
      "text": "nothing unusual, no"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 192.43,
      "end_seconds": 194.51,
      "duration_seconds": 2.08,
      "text": "anything unusual with passing urine?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 195.56,
      "end_seconds": 197.22,
      "duration_seconds": 1.66,
      "text": "no changes there"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 199.31,
      "end_seconds": 203.48,
      "duration_seconds": 4.17,
      "text": "right which tablets or creams or inhalers do you use?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 204.82,
      "end_seconds": 210.01,
      "duration_seconds": 5.19,
      "text": "it's alendronate, 70 milligrams, once a week for my bones"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 211.14,
      "end_seconds": 217.05,
      "duration_seconds": 5.91,
      "text": "That's what's prescribed, but I'm not sure he takes it every day."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 217.71,
      "end_seconds": 231.8,
      "duration_seconds": 14.09,
      "text": "Hydrocortisone cream. I take it when needed. Sumatriptan. I take it 50 milligrams when needed. I told myself I'd wait and see and here I am. Paracetamol 500 milligrams when needed."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 233.58,
      "end_seconds": 237.52,
      "duration_seconds": 3.94,
      "text": "Any relatives with health problems I should be aware of?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 238.56,
      "end_seconds": 240.39,
      "duration_seconds": 1.83,
      "text": "my father was diabetic"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 241.2,
      "end_seconds": 246.28,
      "duration_seconds": 5.08,
      "text": "Alright, what about allergies, to medicines or foods or anything else?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 249.61,
      "end_seconds": 260.32,
      "duration_seconds": 10.71,
      "text": "I think I reacted to some antibiotic once, years ago i don't remember which one, or what happened exactly"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 268.72,
      "end_seconds": 272.14,
      "duration_seconds": 3.42,
      "text": "A few questions about your lifestyle now."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 272.9,
      "end_seconds": 284.64,
      "duration_seconds": 11.74,
      "text": "I stopped smoking about two years back. I gave up drinking about three years ago. I live with my family, my husband and two kids."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 285.92,
      "end_seconds": 289.29,
      "duration_seconds": 3.37,
      "text": "is there anything medical in your background?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 290.94,
      "end_seconds": 306.27,
      "duration_seconds": 15.33,
      "text": "I have thin bones, for nearly five years okay, so I've had eczema, yes a neighbour of mine said I should see someone about it i've had migraines, yes"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 306.95,
      "end_seconds": 313.11,
      "duration_seconds": 6.16,
      "text": "Alright, migraines, that matches what I have here. Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 314.62,
      "end_seconds": 317.09,
      "duration_seconds": 2.47,
      "text": "no never had any surgery"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 318.51,
      "end_seconds": 327.74,
      "duration_seconds": 9.23,
      "text": "Okay, so so the vitals from earlier. Blood pressure 122 over 81, saturation 99 percent, pulse 85, temperature is 36.7 degrees."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 328.9,
      "end_seconds": 329.83,
      "duration_seconds": 0.93,
      "text": "okay, noted"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 332.36,
      "end_seconds": 335.89,
      "duration_seconds": 3.53,
      "text": "if you're comfortable, I'll examine you now"
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 336.57,
      "end_seconds": 337.27,
      "duration_seconds": 0.7,
      "text": "Alright."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 338.28,
      "end_seconds": 339.88,
      "duration_seconds": 1.6,
      "text": "let me press here"
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 350.89,
      "end_seconds": 357.47,
      "duration_seconds": 6.58,
      "text": "There's swelling and tenderness at the base of the thumb side of the wrist."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 358.77,
      "end_seconds": 361.78,
      "duration_seconds": 3.01,
      "text": "Stay still while I have a look."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 370.52,
      "end_seconds": 374.68,
      "duration_seconds": 4.16,
      "text": "Fingers have good colour and the pulses are fine."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 379.96,
      "end_seconds": 396.15,
      "duration_seconds": 16.19,
      "text": "thanks for that okay, thinking it through, my working impression is a wrist sprain, but a small fracture is possible the reason I say that is that your story and my examination fit together another possibility is a scaphoid fracture"
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 399.83,
      "end_seconds": 402.55,
      "duration_seconds": 2.72,
      "text": "Do you think it's serious?"
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 404.35,
      "end_seconds": 437.85,
      "duration_seconds": 33.5,
      "text": "I understand the worry. At the moment I'd say it's a wrist sprain, but a small fracture is possible, and we'll know more once the an X-ray of the wrist is back. Let's book an X-ray of the wrist to look into wrist injury. I'd like you to wear a splint until the X-ray result is confirmed and and keep the hand raised. Do get help quickly if the symptoms get worse."
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 438.43,
      "end_seconds": 439.13,
      "duration_seconds": 0.7,
      "text": "understood"
    },
    {
      "segment_id": "SEG0059",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 440.6,
      "end_seconds": 443.56,
      "duration_seconds": 2.96,
      "text": "is there anything you wanted to ask?"
    },
    {
      "segment_id": "SEG0060",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 445.57,
      "end_seconds": 448.41,
      "duration_seconds": 2.84,
      "text": "nothing more from me thanks"
    }
  ]
}