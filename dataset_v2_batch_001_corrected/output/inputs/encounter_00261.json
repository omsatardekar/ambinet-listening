{
  "schema_version": "1.0",
  "encounter_id": "00261",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.09,
      "end_seconds": 5.05,
      "duration_seconds": 3.96,
      "text": "Good evening, doctor, thank you for staying late."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.03,
      "end_seconds": 10.97,
      "duration_seconds": 3.94,
      "text": "Right on time. Sit, please. How can I help?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 14.44,
      "end_seconds": 20.17,
      "duration_seconds": 5.73,
      "text": "hello, doctor i hope it's alright if I stay in for this"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 22.13,
      "end_seconds": 28.49,
      "duration_seconds": 6.36,
      "text": "Yeah, it's a routine check-up. I don't know what's causing it."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 29.34,
      "end_seconds": 36.23,
      "duration_seconds": 6.89,
      "text": "And the other thing I wanted to mention is that I can't really—"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 36.33,
      "end_seconds": 41.73,
      "duration_seconds": 5.4,
      "text": "Tell the doctor about the other thing, that's what worries me."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 43.12,
      "end_seconds": 45.86,
      "duration_seconds": 2.74,
      "text": "I was getting to that!"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 47.22,
      "end_seconds": 50.55,
      "duration_seconds": 3.33,
      "text": "Have you had a few skipped meals?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 52.46,
      "end_seconds": 59.53,
      "duration_seconds": 7.07,
      "text": "yes, I have. Occasional tiredness was there, but it's gone away on its own"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_4",
      "role": "NURSE",
      "start_seconds": 69.14,
      "end_seconds": 76.01,
      "duration_seconds": 6.87,
      "text": "Here are the numbers, doctor. Pulse 67, SpO2 99 percent on room air, pressure 122 over 81."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 80.54,
      "end_seconds": 81.24,
      "duration_seconds": 0.7,
      "text": "thanks"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 83.65,
      "end_seconds": 87.01,
      "duration_seconds": 3.36,
      "text": "Alright, if you're comfortable, I'll examine you now."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 87.73,
      "end_seconds": 88.93,
      "duration_seconds": 1.2,
      "text": "mm, okay"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 89.85,
      "end_seconds": 92.79,
      "duration_seconds": 2.94,
      "text": "Let me look at this properly."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 105.2,
      "end_seconds": 107.8,
      "duration_seconds": 2.6,
      "text": "Heart and lung sounds are normal."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 108.58,
      "end_seconds": 109.28,
      "duration_seconds": 0.7,
      "text": "Fine."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 110.26,
      "end_seconds": 112.25,
      "duration_seconds": 1.99,
      "text": "Tell me if anything hurts."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 125.51,
      "end_seconds": 128.75,
      "duration_seconds": 3.24,
      "text": "your tummy is soft with no tenderness"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 134.68,
      "end_seconds": 140.91,
      "duration_seconds": 6.23,
      "text": "that's fine, sit up have you noticed shortness of breath or persistent cough?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 142.88,
      "end_seconds": 148.46,
      "duration_seconds": 5.58,
      "text": "I haven't had shortness of breath or persistent cough, no"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 152.17,
      "end_seconds": 154.73,
      "duration_seconds": 2.56,
      "text": "Has there been any low mood?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 156.63,
      "end_seconds": 160.43,
      "duration_seconds": 3.8,
      "text": "no, I haven't had any low mood"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 161.31,
      "end_seconds": 166.48,
      "duration_seconds": 5.17,
      "text": "have you noticed chest pain, blood in the stool or weight loss?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 168.28,
      "end_seconds": 173.72,
      "duration_seconds": 5.44,
      "text": "No, no chest pain, blood in the stool or weight loss."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 175.57,
      "end_seconds": 178.02,
      "duration_seconds": 2.45,
      "text": "Okay, any trouble with the waterworks?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 178.68,
      "end_seconds": 183.08,
      "duration_seconds": 4.4,
      "text": "well, that's normal as far as I know"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 189.21,
      "end_seconds": 191.31,
      "duration_seconds": 2.1,
      "text": "Do you exercise at all?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 193.16,
      "end_seconds": 199.16,
      "duration_seconds": 6.0,
      "text": "I go to the gym a couple of times a week."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 208.75,
      "end_seconds": 217.25,
      "duration_seconds": 8.5,
      "text": "tell me about your health in general, any ongoing conditions? Bear with me, I'm just building up the picture"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 218.0,
      "end_seconds": 222.59,
      "duration_seconds": 4.59,
      "text": "Yes, diabetes. I've had high blood pressure, yes."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 227.99,
      "end_seconds": 236.3,
      "duration_seconds": 8.31,
      "text": "Okay, I can see diabetes in your file as well. Any relatives with health problems I should be aware of?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 242.47,
      "end_seconds": 244.34,
      "duration_seconds": 1.87,
      "text": "my brother has asthma"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 244.9,
      "end_seconds": 249.12,
      "duration_seconds": 4.22,
      "text": "Which tablets or creams or inhalers do you use?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 250.38,
      "end_seconds": 257.53,
      "duration_seconds": 7.15,
      "text": "it's a... um, I can't remember what it's called. It's a little pink tablet"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 258.45,
      "end_seconds": 261.33,
      "duration_seconds": 2.88,
      "text": "do you remember what it's for?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 262.62,
      "end_seconds": 275.9,
      "duration_seconds": 13.28,
      "text": "For my sugar, I believe. My husband sets them out for me, I just take what I'm given. Telmisartan. I take it 40 milligrams, once a day."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 277.71,
      "end_seconds": 284.88,
      "duration_seconds": 7.17,
      "text": "she is supposed to take it once a day, but I can't say she always does"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 285.98,
      "end_seconds": 291.15,
      "duration_seconds": 5.17,
      "text": "Have you ever reacted badly to a medicine or food? Any allergies?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 292.11,
      "end_seconds": 300.84,
      "duration_seconds": 8.73,
      "text": "I think I reacted to some antibiotic once, years ago. I don't remember which one, or what happened exactly"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 302.77,
      "end_seconds": 319.36,
      "duration_seconds": 16.59,
      "text": "Taking everything into account, I think we're dealing with generally well, nothing worrying today at this stage. The reason I say that is that your story and my examination fit together. I can't rule out a tendency towards high cholesterol yet."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 320.11,
      "end_seconds": 325.28,
      "duration_seconds": 5.17,
      "text": "I've been thinking the worst, to be honest. Is it bad?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 326.59,
      "end_seconds": 350.31,
      "duration_seconds": 23.72,
      "text": "I can't promise yet, but most people with generally well, nothing worrying today do well once it's treated properly. I'm going to order a lipid profile, for health screening. The result will help us decide whether anything more is needed. An HbA1c is what I'd like next, for health screening."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 353.42,
      "end_seconds": 355.98,
      "duration_seconds": 2.56,
      "text": "Does it need any preparation?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 357.64,
      "end_seconds": 365.7,
      "duration_seconds": 8.06,
      "text": "Keep up regular exercise, around a hundred and fifty minutes a week, and go easy on processed food."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 366.73,
      "end_seconds": 369.88,
      "duration_seconds": 3.15,
      "text": "can you send me for blood tests?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 371.36,
      "end_seconds": 382.53,
      "duration_seconds": 11.17,
      "text": "I don't think that's needed at this stage, the history doesn't call for it. Come back after the results are back. Right, any last questions?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 383.6,
      "end_seconds": 385.68,
      "duration_seconds": 2.08,
      "text": "Okay, thank you. Bye."
    }
  ]
}