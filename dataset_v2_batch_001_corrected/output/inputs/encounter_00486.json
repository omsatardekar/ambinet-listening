{
  "schema_version": "1.0",
  "encounter_id": "00486",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.08,
      "end_seconds": 6.24,
      "duration_seconds": 5.16,
      "text": "Right, morning. Nice to finally see you, doctor."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.25,
      "end_seconds": 12.57,
      "duration_seconds": 4.32,
      "text": "That's alright, take a seat. Tell me why you've come."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 13.54,
      "end_seconds": 18.23,
      "duration_seconds": 4.69,
      "text": "hmm, I'm here because of dry, scaly patches"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 23.06,
      "end_seconds": 25.64,
      "duration_seconds": 2.58,
      "text": "How far back does it go?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 27.63,
      "end_seconds": 34.14,
      "duration_seconds": 6.51,
      "text": "Two days, I think... sorry, about four days, I got that wrong."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 35.52,
      "end_seconds": 40.65,
      "duration_seconds": 5.13,
      "text": "Okay, give me more detail on it, whatever comes to mind."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 42.24,
      "end_seconds": 51.64,
      "duration_seconds": 9.4,
      "text": "It's moderate, honestly. Only moisturiser, and it's not much. Well, you know, I've also had redness."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 52.47,
      "end_seconds": 57.07,
      "duration_seconds": 4.6,
      "text": "Has there been itching that wakes you at night too?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 60.48,
      "end_seconds": 66.75,
      "duration_seconds": 6.27,
      "text": "yes, you know, for two months. I've also had an itchy rash"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 68.39,
      "end_seconds": 72.5,
      "duration_seconds": 4.11,
      "text": "Does it happen all the time or in spells?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 73.69,
      "end_seconds": 76.91,
      "duration_seconds": 3.22,
      "text": "honestly, a few times a day"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 85.88,
      "end_seconds": 91.03,
      "duration_seconds": 5.15,
      "text": "Did you get similar rash in family members or new soap or detergent?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 92.07,
      "end_seconds": 100.55,
      "duration_seconds": 8.48,
      "text": "uh, no, no similar rash in family members or new soap or detergent"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 101.6,
      "end_seconds": 104.64,
      "duration_seconds": 3.04,
      "text": "Did you get oozing or joint pain?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 105.34,
      "end_seconds": 111.41,
      "duration_seconds": 6.07,
      "text": "I mean, I haven't had oozing or joint pain, no."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 112.86,
      "end_seconds": 117.2,
      "duration_seconds": 4.34,
      "text": "What about your tummy and bowels, anything unusual there?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 118.13,
      "end_seconds": 119.95,
      "duration_seconds": 1.82,
      "text": "Nothing unusual, no."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 121.94,
      "end_seconds": 124.5,
      "duration_seconds": 2.56,
      "text": "is your urine normal, no changes?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 125.04,
      "end_seconds": 127.28,
      "duration_seconds": 2.24,
      "text": "No, that's all fine."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 128.58,
      "end_seconds": 130.45,
      "duration_seconds": 1.87,
      "text": "what's your diet like?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 134.82,
      "end_seconds": 140.48,
      "duration_seconds": 5.66,
      "text": "I eat out quite a lot, to be honest."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 141.15,
      "end_seconds": 142.37,
      "duration_seconds": 1.22,
      "text": "How about exercise?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 142.98,
      "end_seconds": 146.9,
      "duration_seconds": 3.92,
      "text": "Not really, I don't get much exercise."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 147.88,
      "end_seconds": 151.16,
      "duration_seconds": 3.28,
      "text": "what medicines are you taking at the moment?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 152.69,
      "end_seconds": 173.58,
      "duration_seconds": 20.89,
      "text": "Asthalin inhaler. I take it when needed. It's hydrocortisone cream, when needed. I, I do miss it now and then, to be fair. Hmm, I take thyroxine, 75 micrograms, every morning for my thyroid."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 174.9,
      "end_seconds": 179.45,
      "duration_seconds": 4.55,
      "text": "doctor, our chart from the last visit lists it as 150 micrograms"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 180.37,
      "end_seconds": 183.98,
      "duration_seconds": 3.61,
      "text": "I see. Is the most recent prescription on you?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 185.41,
      "end_seconds": 192.87,
      "duration_seconds": 7.46,
      "text": "Yeah, I don't think I have it with me. Moisturiser, twice a day."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 194.66,
      "end_seconds": 198.15,
      "duration_seconds": 3.49,
      "text": "Any long-term health problems I should know about?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 199.06,
      "end_seconds": 209.5,
      "duration_seconds": 10.44,
      "text": "I've had asthma, yes. I've got eczema. Yes, an underactive thyroid. I've had epilepsy for two years now."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 210.54,
      "end_seconds": 216.35,
      "duration_seconds": 5.81,
      "text": "right, so asthma is already on your record we'll keep that in mind today"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 230.86,
      "end_seconds": 233.22,
      "duration_seconds": 2.36,
      "text": "Any allergies I should know about?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 238.27,
      "end_seconds": 254.35,
      "duration_seconds": 16.08,
      "text": "Hmm, you know, there was some antibiotic, I was told I was allergic. But I couldn't tell you what it was called or what it did."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 255.28,
      "end_seconds": 259.42,
      "duration_seconds": 4.14,
      "text": "Any relatives with health problems I should be aware of?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 261.37,
      "end_seconds": 263.79,
      "duration_seconds": 2.42,
      "text": "My father was diabetic."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 281.85,
      "end_seconds": 290.8,
      "duration_seconds": 8.95,
      "text": "here are the numbers, doctor saturation 97 percent, respiratory rate 14. BP is 117 over 73, pulse is 81 beats a minute"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 292.36,
      "end_seconds": 293.06,
      "duration_seconds": 0.7,
      "text": "Thanks."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 296.05,
      "end_seconds": 298.62,
      "duration_seconds": 2.57,
      "text": "So, can I examine you now?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 299.58,
      "end_seconds": 301.87,
      "duration_seconds": 2.29,
      "text": "take your time, no rush"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 315.81,
      "end_seconds": 321.73,
      "duration_seconds": 5.92,
      "text": "There are dry red patches in the creases of both elbows with scratch marks."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 323.66,
      "end_seconds": 325.76,
      "duration_seconds": 2.1,
      "text": "Tell me if anything hurts."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 339.35,
      "end_seconds": 342.33,
      "duration_seconds": 2.98,
      "text": "No signs of infection, no crusting."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 345.6,
      "end_seconds": 378.36,
      "duration_seconds": 32.76,
      "text": "Okay, you can sit up. So, based on the history and the examination, it points towards an eczema flare-up. A fungal infection is still possible. You'll be taking mometasone cream, once a day, for two weeks. It's for eczema. Moisturise right after a bath, thick creams are better than lotions, and use a mild soap. Try to get to bed and wake up at the same time each day, and keep your phone away from the bed."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 378.94,
      "end_seconds": 389.03,
      "duration_seconds": 10.09,
      "text": "And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose. Come back in two weeks."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 390.91,
      "end_seconds": 395.7,
      "duration_seconds": 4.79,
      "text": "I'll make the appointment on my way out."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 399.29,
      "end_seconds": 400.61,
      "duration_seconds": 1.32,
      "text": "Look after yourself."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 402.17,
      "end_seconds": 403.71,
      "duration_seconds": 1.54,
      "text": "Right. Thanks again."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 404.81,
      "end_seconds": 405.51,
      "duration_seconds": 0.7,
      "text": "goodbye"
    }
  ]
}