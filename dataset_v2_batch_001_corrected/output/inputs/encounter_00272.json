{
  "schema_version": "1.0",
  "encounter_id": "00272",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.93,
      "end_seconds": 5.77,
      "duration_seconds": 4.84,
      "text": "Hi there, is it alright if I come in now?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.31,
      "end_seconds": 11.85,
      "duration_seconds": 5.54,
      "text": "Of course, put it down anywhere. So, how can I help?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 12.46,
      "end_seconds": 25.63,
      "duration_seconds": 13.17,
      "text": "Morning, doctor. I'll stay and fill in anything that's missed. It's a burning pain in the upper tummy, doctor. He didn't want to come, but I insisted."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 26.73,
      "end_seconds": 28.56,
      "duration_seconds": 1.83,
      "text": "Let's do your observations."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 39.5,
      "end_seconds": 41.26,
      "duration_seconds": 1.76,
      "text": "Hold still for me..."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 51.36,
      "end_seconds": 60.09,
      "duration_seconds": 8.73,
      "text": "Okay: heart rate 78, temperature is 36.6 degrees, BP is 119 over 71. And oxygen saturation is 97 percent."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 61.07,
      "end_seconds": 62.5,
      "duration_seconds": 1.43,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 67.49,
      "end_seconds": 70.03,
      "duration_seconds": 2.54,
      "text": "I'll explain what that means shortly."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 77.48,
      "end_seconds": 80.26,
      "duration_seconds": 2.78,
      "text": "Since when have you had this?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 83.42,
      "end_seconds": 88.75,
      "duration_seconds": 5.33,
      "text": "Around six months... no wait, it's more like about a month."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 90.21,
      "end_seconds": 94.65,
      "duration_seconds": 4.44,
      "text": "Does it happen all the time or in spells?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 96.65,
      "end_seconds": 98.88,
      "duration_seconds": 2.23,
      "text": "Honestly, on and off."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 100.0,
      "end_seconds": 103.24,
      "duration_seconds": 3.24,
      "text": "Do you notice anything setting it off?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 104.15,
      "end_seconds": 109.37,
      "duration_seconds": 5.22,
      "text": "Yes, spicy food and an empty stomach. That makes it worse."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 111.34,
      "end_seconds": 113.95,
      "duration_seconds": 2.61,
      "text": "How much is it bothering you?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 114.99,
      "end_seconds": 129.14,
      "duration_seconds": 14.15,
      "text": "A seven out of ten, I suppose. I've also had nausea, for about a week. There's bloating after meals as well. About bloating after meals, it feels moderate to me."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 131.05,
      "end_seconds": 136.15,
      "duration_seconds": 5.1,
      "text": "Have you noticed jaundice, trouble swallowing, vomiting blood or fever?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 137.18,
      "end_seconds": 139.96,
      "duration_seconds": 2.78,
      "text": "No, uh, nothing there."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 141.79,
      "end_seconds": 145.11,
      "duration_seconds": 3.32,
      "text": "Anything on the skin I should know about?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 146.83,
      "end_seconds": 147.88,
      "duration_seconds": 1.05,
      "text": "No rashes."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 149.85,
      "end_seconds": 155.36,
      "duration_seconds": 5.51,
      "text": "Have you noticed any weakness, or anything odd with your balance?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 156.7,
      "end_seconds": 158.26,
      "duration_seconds": 1.56,
      "text": "Nothing odd there."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 160.11,
      "end_seconds": 164.9,
      "duration_seconds": 4.79,
      "text": "Let's talk a little about your daily life and habits."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 166.79,
      "end_seconds": 176.54,
      "duration_seconds": 9.75,
      "text": "I don't drink at all. Not really, I don't get much exercise. I skip breakfast most days."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 183.6,
      "end_seconds": 186.99,
      "duration_seconds": 3.39,
      "text": "What medicines are you taking at the moment?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 187.54,
      "end_seconds": 192.87,
      "duration_seconds": 5.33,
      "text": "He is on diclofenac, when needed, I give it to him."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 194.11,
      "end_seconds": 196.53,
      "duration_seconds": 2.42,
      "text": "And what strength is that?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 197.77,
      "end_seconds": 202.2,
      "duration_seconds": 4.43,
      "text": "50 milligrams, I think that's what's on the box."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 203.29,
      "end_seconds": 205.63,
      "duration_seconds": 2.34,
      "text": "Roughly how long on that one?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 206.68,
      "end_seconds": 211.67,
      "duration_seconds": 4.99,
      "text": "For six months. He takes Digene, when it burns."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 212.3,
      "end_seconds": 215.25,
      "duration_seconds": 2.95,
      "text": "Roughly how long on that one?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 216.32,
      "end_seconds": 217.72,
      "duration_seconds": 1.4,
      "text": "Six months now."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 235.43,
      "end_seconds": 238.73,
      "duration_seconds": 3.3,
      "text": "Is there anything medical in your background?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 240.05,
      "end_seconds": 245.47,
      "duration_seconds": 5.42,
      "text": "I have arthritis in my knees, for nearly five years."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 250.17,
      "end_seconds": 252.12,
      "duration_seconds": 1.95,
      "text": "Any operations in the past?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 253.85,
      "end_seconds": 257.86,
      "duration_seconds": 4.01,
      "text": "I had a knee arthroscopy three years ago."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 259.7,
      "end_seconds": 263.99,
      "duration_seconds": 4.29,
      "text": "What about allergies, to medicines or foods or anything else?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 265.24,
      "end_seconds": 268.7,
      "duration_seconds": 3.46,
      "text": "No, none that I know of."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 270.61,
      "end_seconds": 273.32,
      "duration_seconds": 2.71,
      "text": "I'd like to examine you now."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 274.33,
      "end_seconds": 276.41,
      "duration_seconds": 2.08,
      "text": "Hold that position for me."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 286.17,
      "end_seconds": 288.52,
      "duration_seconds": 2.35,
      "text": "No guarding and no lumps."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 294.09,
      "end_seconds": 313.13,
      "duration_seconds": 19.04,
      "text": "Okay, finished. Okay, thinking it through, I'd lean towards gastritis. It could also be acid reflux, so we'll keep that open. Avoid spicy, oily food and don't take anti-inflammatory painkillers on an empty stomach. Okay, I think we're finished. Is everything clear?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 315.99,
      "end_seconds": 318.23,
      "duration_seconds": 2.24,
      "text": "Okay, thank you. Bye."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 319.7,
      "end_seconds": 320.4,
      "duration_seconds": 0.7,
      "text": "Goodbye."
    }
  ]
}