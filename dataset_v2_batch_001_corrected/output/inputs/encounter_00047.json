{
  "schema_version": "1.0",
  "encounter_id": "00047",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.29,
      "end_seconds": 7.45,
      "duration_seconds": 6.16,
      "text": "Uh, good afternoon, doctor, the receptionist said you'd see me now."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 9.38,
      "end_seconds": 14.39,
      "duration_seconds": 5.01,
      "text": "That's alright, take a seat. Tell me why you've come."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 15.22,
      "end_seconds": 20.65,
      "duration_seconds": 5.43,
      "text": "Mainly I've been feeling overwhelmed at work. That's why I came."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 21.7,
      "end_seconds": 24.23,
      "duration_seconds": 2.53,
      "text": "How long have you had it?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 29.77,
      "end_seconds": 34.17,
      "duration_seconds": 4.4,
      "text": "It's been going on for about two weeks."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 35.57,
      "end_seconds": 38.41,
      "duration_seconds": 2.84,
      "text": "Is it worse with anything in particular?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 39.93,
      "end_seconds": 43.17,
      "duration_seconds": 3.24,
      "text": "I notice it more with deadlines."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 47.93,
      "end_seconds": 50.96,
      "duration_seconds": 3.03,
      "text": "Is it mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 52.5,
      "end_seconds": 62.29,
      "duration_seconds": 9.79,
      "text": "I'd call it severe. I've also been feeling short-tempered, for three days. There's a knot in my stomach as well."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 75.37,
      "end_seconds": 78.82,
      "duration_seconds": 3.45,
      "text": "Have you had to have anything operated on?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 80.32,
      "end_seconds": 85.9,
      "duration_seconds": 5.58,
      "text": "Oh, yes, I had a hernia repair, about five years back."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 90.82,
      "end_seconds": 92.19,
      "duration_seconds": 1.37,
      "text": "Okay, any smoking?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 92.92,
      "end_seconds": 96.74,
      "duration_seconds": 3.82,
      "text": "No, I don't smoke and never have."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 97.9,
      "end_seconds": 99.46,
      "duration_seconds": 1.56,
      "text": "Do you drink alcohol?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 101.19,
      "end_seconds": 103.81,
      "duration_seconds": 2.62,
      "text": "I don't drink at all."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 104.7,
      "end_seconds": 107.06,
      "duration_seconds": 2.36,
      "text": "Okay, are you still working?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 107.79,
      "end_seconds": 112.49,
      "duration_seconds": 4.7,
      "text": "I'm retired now, I was a clerk for years."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 117.21,
      "end_seconds": 118.83,
      "duration_seconds": 1.62,
      "text": "Do you live alone?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 120.0,
      "end_seconds": 123.11,
      "duration_seconds": 3.11,
      "text": "Yes, I live on my own."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 139.49,
      "end_seconds": 144.3,
      "duration_seconds": 4.81,
      "text": "Are there any allergies on your record that I should check?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 145.64,
      "end_seconds": 149.07,
      "duration_seconds": 3.43,
      "text": "Yes, pollen. I get a runny nose."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 150.72,
      "end_seconds": 154.91,
      "duration_seconds": 4.19,
      "text": "Right, moving on to your background, any past medical history?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 156.56,
      "end_seconds": 160.15,
      "duration_seconds": 3.59,
      "text": "I have anxiety. I have acid reflux."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 161.23,
      "end_seconds": 162.81,
      "duration_seconds": 1.58,
      "text": "Okay, anything else?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 164.77,
      "end_seconds": 174.36,
      "duration_seconds": 9.59,
      "text": "Okay, I can see acid reflux in your file as well. Which tablets or creams or inhalers do you use?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 175.06,
      "end_seconds": 184.34,
      "duration_seconds": 9.28,
      "text": "I take escitalopram, 10 milligrams, once a day for the anxiety. I take pantoprazole, before breakfast for my acidity."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 185.06,
      "end_seconds": 187.18,
      "duration_seconds": 2.12,
      "text": "And what strength is that?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 188.29,
      "end_seconds": 197.55,
      "duration_seconds": 9.26,
      "text": "40 milligrams, I think that's what's on the box. I'm on paracetamol, 500 milligrams, when needed."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 198.54,
      "end_seconds": 202.77,
      "duration_seconds": 4.23,
      "text": "Anyone in the family with similar problems or other conditions?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 204.04,
      "end_seconds": 206.02,
      "duration_seconds": 1.98,
      "text": "My brother has asthma."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 206.98,
      "end_seconds": 208.57,
      "duration_seconds": 1.59,
      "text": "How about alcohol use?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 210.49,
      "end_seconds": 212.53,
      "duration_seconds": 2.04,
      "text": "Definitely no alcohol use."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 214.3,
      "end_seconds": 218.72,
      "duration_seconds": 4.42,
      "text": "Did you get weight loss, fainting or panic attacks?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 222.81,
      "end_seconds": 227.82,
      "duration_seconds": 5.01,
      "text": "So, um, none, as far as I know."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 228.06,
      "end_seconds": 230.5,
      "duration_seconds": 2.44,
      "text": "Ah. Anything unusual with passing urine?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 231.89,
      "end_seconds": 235.42,
      "duration_seconds": 3.53,
      "text": "That's normal as far as I know."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 237.4,
      "end_seconds": 240.15,
      "duration_seconds": 2.75,
      "text": "Let me measure a few things."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 247.17,
      "end_seconds": 247.96,
      "duration_seconds": 0.79,
      "text": "One second..."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 267.91,
      "end_seconds": 275.35,
      "duration_seconds": 7.44,
      "text": "Okay: temperature 36.8, pressure 119 over 76, pulse 64, SpO2 99 percent on room air."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 292.0,
      "end_seconds": 300.02,
      "duration_seconds": 8.02,
      "text": "Going by what you've described, it fits best with stress-related symptoms. I can't rule out a depressive episode yet."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 301.46,
      "end_seconds": 304.84,
      "duration_seconds": 3.38,
      "text": "What are the chances it's something bad?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 305.57,
      "end_seconds": 331.7,
      "duration_seconds": 26.13,
      "text": "Nothing I've seen today points to an emergency. It looks like stress-related symptoms, but I'd like to confirm. I'll request blood tests, it'll help with stress-related symptoms. Talking to someone, even a counsellor, helps more than people expect. We'll refer you to a counsellor. I'd like you back in a month. So, thanks for coming in."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 333.26,
      "end_seconds": 335.17,
      "duration_seconds": 1.91,
      "text": "I appreciate it, doctor."
    }
  ]
}