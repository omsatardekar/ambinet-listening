{
  "schema_version": "1.0",
  "encounter_id": "00345",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 1.26,
      "end_seconds": 6.09,
      "duration_seconds": 4.83,
      "text": "Afternoon doctor. They're in and comfortable and I have the measurements ready."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.91,
      "end_seconds": 11.46,
      "duration_seconds": 4.55,
      "text": "Thank you. Good morning, tell me what's been going on."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 12.34,
      "end_seconds": 19.2,
      "duration_seconds": 6.86,
      "text": "Oh doctor I've come along because I know the history if it helps."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 19.72,
      "end_seconds": 23.78,
      "duration_seconds": 4.06,
      "text": "that's fine, sit down we'll go through it together"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 25.12,
      "end_seconds": 30.34,
      "duration_seconds": 5.22,
      "text": "he's been having an urgent need to go sometimes, doctor"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 31.95,
      "end_seconds": 34.67,
      "duration_seconds": 2.72,
      "text": "When did you first notice it?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 35.91,
      "end_seconds": 38.74,
      "duration_seconds": 2.83,
      "text": "for three weeks, I'd say"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 40.06,
      "end_seconds": 43.11,
      "duration_seconds": 3.05,
      "text": "How bad is it would you say?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 43.7,
      "end_seconds": 46.56,
      "duration_seconds": 2.86,
      "text": "Pretty moderate if I'm being honest."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 48.18,
      "end_seconds": 51.69,
      "duration_seconds": 3.51,
      "text": "okay, does it come along with anything else?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 52.52,
      "end_seconds": 64.34,
      "duration_seconds": 11.82,
      "text": "hmm, it usually comes with leaking urine when I cough or sneeze the leaking urine when I cough or sneeze? That's been since last Tuesday"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 65.67,
      "end_seconds": 67.35,
      "duration_seconds": 1.68,
      "text": "And alcohol, how much?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 68.59,
      "end_seconds": 73.11,
      "duration_seconds": 4.52,
      "text": "A beer or two most evenings, to be honest"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 74.66,
      "end_seconds": 77.05,
      "duration_seconds": 2.39,
      "text": "tell me about your work"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 78.04,
      "end_seconds": 83.49,
      "duration_seconds": 5.45,
      "text": "I'm a software engineer, so I'm at a screen all day."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 84.6,
      "end_seconds": 87.0,
      "duration_seconds": 2.4,
      "text": "do you get any exercise?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 90.48,
      "end_seconds": 95.17,
      "duration_seconds": 4.69,
      "text": "I walk for about half an hour most days"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 111.63,
      "end_seconds": 115.65,
      "duration_seconds": 4.02,
      "text": "Moving on to your background, any past medical history?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 117.27,
      "end_seconds": 121.71,
      "duration_seconds": 4.44,
      "text": "I've had diabetes yes. Yes high blood pressure."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 122.81,
      "end_seconds": 123.6,
      "duration_seconds": 0.79,
      "text": "uh-huh"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 124.61,
      "end_seconds": 131.18,
      "duration_seconds": 6.57,
      "text": "I've got heart disease. I kept putting it off which I know isn't sensible."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 132.33,
      "end_seconds": 139.9,
      "duration_seconds": 7.57,
      "text": "Alright high blood pressure and heart disease that matches what I have here. Have you had any surgery before?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 141.2,
      "end_seconds": 144.71,
      "duration_seconds": 3.51,
      "text": "I had my gallbladder removed in 2016"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 148.94,
      "end_seconds": 151.58,
      "duration_seconds": 2.64,
      "text": "alright, what's your current medication list?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 152.48,
      "end_seconds": 156.5,
      "duration_seconds": 4.02,
      "text": "Glimepiride 2 milligrams maybe before breakfast for my sugar"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 158.48,
      "end_seconds": 162.87,
      "duration_seconds": 4.39,
      "text": "have you got the box or the prescription on you?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 164.6,
      "end_seconds": 174.51,
      "duration_seconds": 9.91,
      "text": "hmm, not with me i'll bring it next time i'm on aspirin, 75 milligrams, once a day for my heart"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 175.84,
      "end_seconds": 181.62,
      "duration_seconds": 5.78,
      "text": "That's what's prescribed but I'm not sure he takes it every day."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 182.75,
      "end_seconds": 185.38,
      "duration_seconds": 2.63,
      "text": "does anything run in the family?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 186.08,
      "end_seconds": 188.83,
      "duration_seconds": 2.75,
      "text": "my father had kidney stones"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 190.15,
      "end_seconds": 194.91,
      "duration_seconds": 4.76,
      "text": "Are there any allergies on your record that I should check?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 196.3,
      "end_seconds": 197.2,
      "duration_seconds": 0.9,
      "text": "no allergies"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 198.1,
      "end_seconds": 205.71,
      "duration_seconds": 7.61,
      "text": "Hold on, doctor, I think he reacted to ibuprofen once. I'm not certain, though."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 206.85,
      "end_seconds": 209.55,
      "duration_seconds": 2.7,
      "text": "Really? I don't think so."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 211.03,
      "end_seconds": 220.45,
      "duration_seconds": 9.42,
      "text": "Alright, so that's unclear. I'll record what each of you said. Alright, any fever or burning when passing urine at all?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 224.77,
      "end_seconds": 240.68,
      "duration_seconds": 15.91,
      "text": "no, no fever, no burning when passing urine i did have a heavy dragging feeling low down at one point, but that that went away on its own"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 242.35,
      "end_seconds": 243.71,
      "duration_seconds": 1.36,
      "text": "Any difficulty emptying?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 244.8,
      "end_seconds": 246.61,
      "duration_seconds": 1.81,
      "text": "No no difficulty emptying."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 248.15,
      "end_seconds": 252.81,
      "duration_seconds": 4.66,
      "text": "Have you had any constipation or blood in the urine?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 254.43,
      "end_seconds": 259.81,
      "duration_seconds": 5.38,
      "text": "Um no no constipation or blood in the urine."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 260.49,
      "end_seconds": 264.56,
      "duration_seconds": 4.07,
      "text": "any change in your bowel habit or your stomach generally?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 266.28,
      "end_seconds": 268.86,
      "duration_seconds": 2.58,
      "text": "bowels are regular nothing odd"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 270.2,
      "end_seconds": 271.77,
      "duration_seconds": 1.57,
      "text": "how's your breathing otherwise?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 272.3,
      "end_seconds": 275.25,
      "duration_seconds": 2.95,
      "text": "no, my breathing's been fine"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 276.09,
      "end_seconds": 288.42,
      "duration_seconds": 12.33,
      "text": "doctor, I've got the readings for you weight 90 kilos, height 162 centimetres, pulse 83. BP is 128 over 70, saturation 98 percent, temperature is 36.8 degrees"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 289.31,
      "end_seconds": 290.65,
      "duration_seconds": 1.34,
      "text": "Good, thank you."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 292.68,
      "end_seconds": 294.68,
      "duration_seconds": 2.0,
      "text": "shall we do the examination?"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 296.03,
      "end_seconds": 297.3,
      "duration_seconds": 1.27,
      "text": "I'll go gently."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 304.57,
      "end_seconds": 310.78,
      "duration_seconds": 6.21,
      "text": "No bulge is visible when you cough and the the tummy is soft."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 316.17,
      "end_seconds": 318.69,
      "duration_seconds": 2.52,
      "text": "right, you can sit back down"
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 329.2,
      "end_seconds": 347.88,
      "duration_seconds": 18.68,
      "text": "taking everything into account, I'd lean towards stress urinary incontinence. Another possibility is a urine infection. A bladder diary is what I'd like next, for urinary symptoms. I'd rather check than guess, and this is the quickest way to know more"
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 348.94,
      "end_seconds": 354.78,
      "duration_seconds": 5.84,
      "text": "doctor I did a urine test before they came in the result's on your screen"
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 356.44,
      "end_seconds": 365.84,
      "duration_seconds": 9.4,
      "text": "thanks I'll look at that. Pelvic floor exercises three sets a day make a real difference over a couple of months"
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 366.07,
      "end_seconds": 366.77,
      "duration_seconds": 0.7,
      "text": "yes?"
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 369.58,
      "end_seconds": 379.38,
      "duration_seconds": 9.8,
      "text": "And please bring the latest prescription or the medicine boxes to the next visit so we can settle the dose."
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 380.41,
      "end_seconds": 382.82,
      "duration_seconds": 2.41,
      "text": "Yes, I'll watch for that."
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 383.85,
      "end_seconds": 386.66,
      "duration_seconds": 2.81,
      "text": "I'll want another look in six weeks"
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 388.14,
      "end_seconds": 390.64,
      "duration_seconds": 2.5,
      "text": "good I'll come back then"
    },
    {
      "segment_id": "SEG0059",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 391.41,
      "end_seconds": 394.45,
      "duration_seconds": 3.04,
      "text": "that's everything from me any other questions?"
    },
    {
      "segment_id": "SEG0060",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 395.23,
      "end_seconds": 397.18,
      "duration_seconds": 1.95,
      "text": "thanks so much, doctor"
    }
  ]
