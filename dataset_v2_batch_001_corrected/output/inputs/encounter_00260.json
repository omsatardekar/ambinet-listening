{
  "schema_version": "1.0",
  "encounter_id": "00260",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.39,
      "end_seconds": 4.59,
      "duration_seconds": 3.2,
      "text": "Good afternoon. Have a seat and we'll begin."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 6.32,
      "end_seconds": 7.24,
      "duration_seconds": 0.92,
      "text": "Thank you."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 8.41,
      "end_seconds": 12.18,
      "duration_seconds": 3.77,
      "text": "Tell me from the beginning, what's been happening?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 14.15,
      "end_seconds": 15.79,
      "duration_seconds": 1.64,
      "text": "It's fever, mostly."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 16.34,
      "end_seconds": 19.61,
      "duration_seconds": 3.27,
      "text": "How long has this been going on?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 21.31,
      "end_seconds": 23.76,
      "duration_seconds": 2.45,
      "text": "About... well, about two weeks."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 25.55,
      "end_seconds": 28.32,
      "duration_seconds": 2.77,
      "text": "Would you call it mild or bad?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 29.39,
      "end_seconds": 53.91,
      "duration_seconds": 24.52,
      "text": "Pretty mild, if I'm being honest. I've, I've also had a mild headache. I've had body aches too, for about four days. As for body aches, pretty moderate, if I'm being honest. There was a sore throat, yes, but that went away."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 55.04,
      "end_seconds": 56.43,
      "duration_seconds": 1.39,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 57.36,
      "end_seconds": 59.94,
      "duration_seconds": 2.58,
      "text": "No, never had any surgery."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 60.5,
      "end_seconds": 64.06,
      "duration_seconds": 3.56,
      "text": "Let's go through your medication. What are you taking?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 65.74,
      "end_seconds": 69.64,
      "duration_seconds": 3.9,
      "text": "Ramipril. I take it 5 milligrams, every morning."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 70.26,
      "end_seconds": 76.27,
      "duration_seconds": 6.01,
      "text": "Doctor, our chart from the last visit lists it as 2.5 milligrams."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 80.9,
      "end_seconds": 84.66,
      "duration_seconds": 3.76,
      "text": "Hm. Do you have the latest prescription with you?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 85.67,
      "end_seconds": 91.19,
      "duration_seconds": 5.52,
      "text": "Not with me. I'll bring it next time. Asthalin inhaler, when needed."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 99.28,
      "end_seconds": 104.43,
      "duration_seconds": 5.15,
      "text": "Do you have any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 107.81,
      "end_seconds": 112.77,
      "duration_seconds": 4.96,
      "text": "High blood pressure, for about a year. I have asthma."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 113.42,
      "end_seconds": 114.88,
      "duration_seconds": 1.46,
      "text": "Okay, anything else?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 125.06,
      "end_seconds": 129.23,
      "duration_seconds": 4.17,
      "text": "Any relatives with health problems I should be aware of?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 130.68,
      "end_seconds": 133.14,
      "duration_seconds": 2.46,
      "text": "Oh, my mother has diabetes."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 134.7,
      "end_seconds": 137.07,
      "duration_seconds": 2.37,
      "text": "Do you get any exercise?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 137.69,
      "end_seconds": 142.26,
      "duration_seconds": 4.57,
      "text": "I walk for about half an hour most days."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 144.14,
      "end_seconds": 146.51,
      "duration_seconds": 2.37,
      "text": "What do you do for work?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 147.79,
      "end_seconds": 152.54,
      "duration_seconds": 4.75,
      "text": "I work in an office, mostly sitting at a desk."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 156.7,
      "end_seconds": 159.12,
      "duration_seconds": 2.42,
      "text": "And what do you usually eat?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 160.03,
      "end_seconds": 163.01,
      "duration_seconds": 2.98,
      "text": "Mostly home-cooked food, rice and vegetables."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 172.02,
      "end_seconds": 174.74,
      "duration_seconds": 2.72,
      "text": "Any allergies I should know about?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 176.42,
      "end_seconds": 187.92,
      "duration_seconds": 11.5,
      "text": "I think I reacted to some antibiotic once, uh, years ago. I don't remember which one, or what happened exactly."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 189.73,
      "end_seconds": 194.25,
      "duration_seconds": 4.52,
      "text": "Any chest pain, rash, burning when passing urine or diarrhoea?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 195.93,
      "end_seconds": 202.66,
      "duration_seconds": 6.73,
      "text": "No chest pain, rash, burning when passing urine or diarrhoea, none of it."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 204.69,
      "end_seconds": 210.02,
      "duration_seconds": 5.33,
      "text": "Let me check a few things. Any vomiting or stiff neck?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 211.35,
      "end_seconds": 214.3,
      "duration_seconds": 2.95,
      "text": "No, no vomiting or stiff neck."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 216.08,
      "end_seconds": 219.74,
      "duration_seconds": 3.66,
      "text": "Anything on the skin I should know about?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 220.96,
      "end_seconds": 224.48,
      "duration_seconds": 3.52,
      "text": "Right, nothing on the skin, no."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 225.88,
      "end_seconds": 228.82,
      "duration_seconds": 2.94,
      "text": "Is your urine normal, no changes?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 230.66,
      "end_seconds": 232.18,
      "duration_seconds": 1.52,
      "text": "Nothing there, no."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 233.39,
      "end_seconds": 240.79,
      "duration_seconds": 7.4,
      "text": "Here are the numbers, doctor. Pulse 101, SpO2 98 percent on room air, blood pressure 111 over 72."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 242.78,
      "end_seconds": 243.48,
      "duration_seconds": 0.7,
      "text": "Thanks."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 245.75,
      "end_seconds": 248.8,
      "duration_seconds": 3.05,
      "text": "Let me examine, it won't take long."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 249.91,
      "end_seconds": 252.01,
      "duration_seconds": 2.1,
      "text": "Hold that position for me."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 266.2,
      "end_seconds": 269.9,
      "duration_seconds": 3.7,
      "text": "Chest is clear when I listen, no crackles."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 271.48,
      "end_seconds": 274.9,
      "duration_seconds": 3.42,
      "text": "Stay still while I have a look."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 289.31,
      "end_seconds": 295.61,
      "duration_seconds": 6.3,
      "text": "Your throat looks red at the back, but there's no pus on the tonsils."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 298.83,
      "end_seconds": 307.37,
      "duration_seconds": 8.54,
      "text": "Good, that's the examination. Putting it all together, this is probably a viral illness. We shouldn't forget influenza."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 310.31,
      "end_seconds": 312.41,
      "duration_seconds": 2.1,
      "text": "Doctor, is this dangerous?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 314.44,
      "end_seconds": 329.36,
      "duration_seconds": 14.92,
      "text": "I can't promise yet, but most people with a viral illness do well once it's treated properly. Stop me if I've got anything wrong. You've had fever for about two weeks, mild, and no rash or diarrhoea."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 330.49,
      "end_seconds": 331.98,
      "duration_seconds": 1.49,
      "text": "That's it, yes."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 333.77,
      "end_seconds": 340.43,
      "duration_seconds": 6.66,
      "text": "Doctor, I did a flu swab before they came in, the result's on your screen."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 341.85,
      "end_seconds": 350.94,
      "duration_seconds": 9.09,
      "text": "Perfect. I'll request blood tests, it'll help with fever. I'll request a throat swab, it'll help with sore throat."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 351.57,
      "end_seconds": 353.06,
      "duration_seconds": 1.49,
      "text": "Okay, that's fine."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 354.09,
      "end_seconds": 363.5,
      "duration_seconds": 9.41,
      "text": "I'm going to put you on cetirizine, 10 milligrams, at night, for five days. You take it by mouth. It's for blocked nose."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 364.47,
      "end_seconds": 368.63,
      "duration_seconds": 4.16,
      "text": "Okay, so alright, I'll collect it today."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 369.6,
      "end_seconds": 393.48,
      "duration_seconds": 23.88,
      "text": "We'll begin with paracetamol, 500 milligrams, every six hours if needed, for three days. That's for fever and body aches. Stay home, rest, and keep the fluids up. Warm soups and water, anything that goes down easily. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 394.33,
      "end_seconds": 395.03,
      "duration_seconds": 0.7,
      "text": "Understood."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 396.09,
      "end_seconds": 405.64,
      "duration_seconds": 9.55,
      "text": "Do get help quickly if the symptoms get worse. Let's review you in five days. Take care, and call us if anything changes."
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 407.21,
      "end_seconds": 410.61,
      "duration_seconds": 3.4,
      "text": "Um, nothing more from me, thanks."
    }
  ]
}