{
  "schema_version": "1.0",
  "encounter_id": "00051",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.51,
      "end_seconds": 6.73,
      "duration_seconds": 6.22,
      "text": "hi there, uh, is it alright if I come in now?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.45,
      "end_seconds": 14.19,
      "duration_seconds": 5.74,
      "text": "Yes, come in, take a seat. What can I do for you today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 15.51,
      "end_seconds": 21.01,
      "duration_seconds": 5.5,
      "text": "hello, doctor, I came in with them, if that's okay"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 22.01,
      "end_seconds": 25.7,
      "duration_seconds": 3.69,
      "text": "That's fine, sit down. We'll go through it together."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 26.49,
      "end_seconds": 31.72,
      "duration_seconds": 5.23,
      "text": "We came because of red scaly patches on my elbows."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 33.36,
      "end_seconds": 35.11,
      "duration_seconds": 1.75,
      "text": "When did it begin?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 36.64,
      "end_seconds": 44.15,
      "duration_seconds": 7.51,
      "text": "I've had it for two months. I did try to ignore it for a while"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 45.78,
      "end_seconds": 54.46,
      "duration_seconds": 8.68,
      "text": "tell me a bit more about it: how bad it gets, how often, and whether anything makes it better or worse"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 55.88,
      "end_seconds": 75.93,
      "duration_seconds": 20.05,
      "text": "Sunlight helps a bit. Cold weather definitely sets it off. A eight out of ten, you know, I suppose. As for itching, I honestly can't say when that began. It might have been last month or the month before."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 77.95,
      "end_seconds": 81.88,
      "duration_seconds": 3.93,
      "text": "What about pitted nails, have you noticed that?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 86.85,
      "end_seconds": 93.13,
      "duration_seconds": 6.28,
      "text": "well, um, yes, about the same, nearly five years"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 93.67,
      "end_seconds": 102.64,
      "duration_seconds": 8.97,
      "text": "Ah. Have you had red scaly patches on your elbows before, or is this the the first time?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 104.61,
      "end_seconds": 110.2,
      "duration_seconds": 5.59,
      "text": "I had a similar thing last year. It went away."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 112.18,
      "end_seconds": 115.02,
      "duration_seconds": 2.84,
      "text": "Can I take your vitals now?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 127.28,
      "end_seconds": 128.11,
      "duration_seconds": 0.83,
      "text": "One second..."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 147.92,
      "end_seconds": 154.42,
      "duration_seconds": 6.5,
      "text": "Okay: saturation 97 percent, pressure 108 over 75, temp 36.9 degrees, heart rate 73."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 156.21,
      "end_seconds": 158.59,
      "duration_seconds": 2.38,
      "text": "shall we do the examination?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 160.25,
      "end_seconds": 162.73,
      "duration_seconds": 2.48,
      "text": "Just relax, I'll be quick."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 172.67,
      "end_seconds": 175.81,
      "duration_seconds": 3.14,
      "text": "A few small pits in the fingernails."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 177.56,
      "end_seconds": 179.92,
      "duration_seconds": 2.36,
      "text": "Just relax, I'll be quick."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 187.72,
      "end_seconds": 191.38,
      "duration_seconds": 3.66,
      "text": "Well-defined thick silvery plaques over both elbows and knees."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 196.38,
      "end_seconds": 203.96,
      "duration_seconds": 7.58,
      "text": "All done, you can get dressed. Right, have you had any sore throat before it started or fever?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 205.61,
      "end_seconds": 212.16,
      "duration_seconds": 6.55,
      "text": "I haven't had sore throat before it started or fever, no."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 213.49,
      "end_seconds": 217.65,
      "duration_seconds": 4.16,
      "text": "Any new medicines, weeping or joint swelling at all?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 219.04,
      "end_seconds": 224.39,
      "duration_seconds": 5.35,
      "text": "no, uh, no new medicines, weeping or joint swelling"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 228.36,
      "end_seconds": 232.57,
      "duration_seconds": 4.21,
      "text": "Alright, how about your heart, any problems like that?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 234.34,
      "end_seconds": 236.1,
      "duration_seconds": 1.76,
      "text": "Nothing like that."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 237.89,
      "end_seconds": 240.78,
      "duration_seconds": 2.89,
      "text": "is your urine normal, no changes?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 242.14,
      "end_seconds": 245.96,
      "duration_seconds": 3.82,
      "text": "that's normal as far as I know"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 248.03,
      "end_seconds": 251.49,
      "duration_seconds": 3.46,
      "text": "Right, any diagnoses you've been given before?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 252.52,
      "end_seconds": 254.87,
      "duration_seconds": 2.35,
      "text": "Yes, high blood pressure."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 256.8,
      "end_seconds": 257.65,
      "duration_seconds": 0.85,
      "text": "go on"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 259.19,
      "end_seconds": 260.95,
      "duration_seconds": 1.76,
      "text": "I have diabetes."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 262.39,
      "end_seconds": 263.09,
      "duration_seconds": 0.7,
      "text": "Mhm."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 281.09,
      "end_seconds": 284.46,
      "duration_seconds": 3.37,
      "text": "a a few questions about your lifestyle now"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 286.25,
      "end_seconds": 297.98,
      "duration_seconds": 11.73,
      "text": "A beer or two most evenings, to be honest. I'm mostly vegetarian. I walk for about half an hour most days."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 299.3,
      "end_seconds": 301.89,
      "duration_seconds": 2.59,
      "text": "have you had any surgery before?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 305.44,
      "end_seconds": 309.17,
      "duration_seconds": 3.73,
      "text": "just a knee arthroscopy, three years ago"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 321.71,
      "end_seconds": 324.5,
      "duration_seconds": 2.79,
      "text": "Before I prescribe anything, any allergies?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 325.5,
      "end_seconds": 329.4,
      "duration_seconds": 3.9,
      "text": "I don't have any known medication allergies."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 340.35,
      "end_seconds": 343.49,
      "duration_seconds": 3.14,
      "text": "Tell me what you take day to day."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 344.86,
      "end_seconds": 351.2,
      "duration_seconds": 6.34,
      "text": "Amlodipine. I take it 5 milligrams, once a day for my pressure"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 353.07,
      "end_seconds": 366.58,
      "duration_seconds": 13.51,
      "text": "Hmm, uh, doctor, I think the last prescription for the amlodipine was 2.5 milligrams. We changed it at the last visit."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 367.5,
      "end_seconds": 372.62,
      "duration_seconds": 5.12,
      "text": "Okay. Have you got the newest prescription or the box with you?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 374.64,
      "end_seconds": 393.58,
      "duration_seconds": 18.94,
      "text": "Not with me. I'll bring it next time. Glimepiride. I take it 2 milligrams, before breakfast. Coconut oil. I take it daily. Sorry, I know I'm rambling a bit. My family kept telling me to get it checked."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 395.57,
      "end_seconds": 399.2,
      "duration_seconds": 3.63,
      "text": "is there a family history of anything significant?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 400.61,
      "end_seconds": 403.65,
      "duration_seconds": 3.04,
      "text": "My sister has thyroid problems."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 404.81,
      "end_seconds": 412.87,
      "duration_seconds": 8.06,
      "text": "so, based on the history and the examination, it fits best with plaque psoriasis another possibility is a fungal infection"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 413.55,
      "end_seconds": 416.76,
      "duration_seconds": 3.21,
      "text": "Doctor, um, is this dangerous?"
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 418.1,
      "end_seconds": 436.07,
      "duration_seconds": 17.97,
      "text": "I can't promise yet, but most people with plaque psoriasis do well once it's treated properly let me just check I've got this right you've had red scaly patches on your elbows for two months, and no sore throat before it started or fever"
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 437.33,
      "end_seconds": 438.94,
      "duration_seconds": 1.61,
      "text": "Yes, that's right."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 439.77,
      "end_seconds": 450.78,
      "duration_seconds": 11.01,
      "text": "We should do blood tests for baseline before treatment. You'll be taking calcipotriol-betamethasone gel, once a day, for four weeks. That should help with psoriasis."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 452.73,
      "end_seconds": 453.86,
      "duration_seconds": 1.13,
      "text": "Mm, okay."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 455.64,
      "end_seconds": 485.95,
      "duration_seconds": 30.31,
      "text": "A little sunlight helps psoriasis, but avoid sunburn. Moisturise often. Cut back on tea, coffee and fizzy drinks for a couple of weeks and see how things settle. I'll also refer you to a dermatologist. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose. One warning sign to remember: the symptoms get worse. In that case don't wait. Come back in four weeks."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 490.43,
      "end_seconds": 493.59,
      "duration_seconds": 3.16,
      "text": "Call the clinic if you need us."
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 494.92,
      "end_seconds": 496.75,
      "duration_seconds": 1.83,
      "text": "Right. Thanks again."
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 497.75,
      "end_seconds": 498.67,
      "duration_seconds": 0.92,
      "text": "So, goodbye."
    }
  ]
}