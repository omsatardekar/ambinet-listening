{
  "schema_version": "1.0",
  "encounter_id": "00002",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.83,
      "end_seconds": 2.12,
      "duration_seconds": 1.29,
      "text": "Hello, come through."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 3.68,
      "end_seconds": 4.8,
      "duration_seconds": 1.12,
      "text": "evening, doctor"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 6.32,
      "end_seconds": 9.46,
      "duration_seconds": 3.14,
      "text": "What made you decide to come in?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 10.75,
      "end_seconds": 17.59,
      "duration_seconds": 6.84,
      "text": "So, I've been feeling a bit dizzy after taking all my tablets, doctor."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 18.59,
      "end_seconds": 22.42,
      "duration_seconds": 3.83,
      "text": "Let's go through your medication. What are you taking?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 23.86,
      "end_seconds": 39.15,
      "duration_seconds": 15.29,
      "text": "Atorvastatin, 20 milligrams, at night. It's metformin, 500 milligrams, twice a day for my sugar. Though honestly, some days I forget to take it. Aspirin, 75 milligrams, once a day"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 40.12,
      "end_seconds": 43.39,
      "duration_seconds": 3.27,
      "text": "since when have you been taking it?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 47.98,
      "end_seconds": 49.32,
      "duration_seconds": 1.34,
      "text": "For two months."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 59.49,
      "end_seconds": 61.74,
      "duration_seconds": 2.25,
      "text": "right, when did it begin?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 62.74,
      "end_seconds": 66.49,
      "duration_seconds": 3.75,
      "text": "Okay, so it's been like this since Monday."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 67.91,
      "end_seconds": 71.14,
      "duration_seconds": 3.23,
      "text": "How bad is it, would you say?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 71.93,
      "end_seconds": 76.27,
      "duration_seconds": 4.34,
      "text": "I, I'd give it a seven, out of ten."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 77.23,
      "end_seconds": 79.67,
      "duration_seconds": 2.44,
      "text": "have you had dry mouth?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 80.97,
      "end_seconds": 82.04,
      "duration_seconds": 1.07,
      "text": "Yes, actually."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 83.69,
      "end_seconds": 85.93,
      "duration_seconds": 2.24,
      "text": "How intense does it get?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 86.56,
      "end_seconds": 87.71,
      "duration_seconds": 1.15,
      "text": "Mild, really."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 87.97,
      "end_seconds": 89.45,
      "duration_seconds": 1.48,
      "text": "And And then?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 91.23,
      "end_seconds": 102.87,
      "duration_seconds": 11.64,
      "text": "I've been feeling confused about which tablets to take too. Yeah, I did have an upset stomach at one point, but that's gone now"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 103.43,
      "end_seconds": 107.97,
      "duration_seconds": 4.54,
      "text": "So, a few quick ones: vomiting, black stools or fainting?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 108.61,
      "end_seconds": 110.59,
      "duration_seconds": 1.98,
      "text": "No. None of those."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 111.45,
      "end_seconds": 117.03,
      "duration_seconds": 5.58,
      "text": "let me check a few things. Any falls, low mood or chest pain?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 118.04,
      "end_seconds": 122.27,
      "duration_seconds": 4.23,
      "text": "No, no falls, low mood or chest pain."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 123.53,
      "end_seconds": 126.04,
      "duration_seconds": 2.51,
      "text": "Is your urine normal, no changes?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 128.09,
      "end_seconds": 129.71,
      "duration_seconds": 1.62,
      "text": "No changes there."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 130.71,
      "end_seconds": 134.29,
      "duration_seconds": 3.58,
      "text": "Do you have any known allergies at all?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 135.13,
      "end_seconds": 146.01,
      "duration_seconds": 10.88,
      "text": "I think I reacted to some antibiotic once, years ago. I don't remember which one, or what happened exactly."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 147.09,
      "end_seconds": 150.32,
      "duration_seconds": 3.23,
      "text": "Have you ever been under the knife?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 151.4,
      "end_seconds": 157.0,
      "duration_seconds": 5.6,
      "text": "Yes, I had a stent put in my heart, two years ago."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 158.45,
      "end_seconds": 161.01,
      "duration_seconds": 2.56,
      "text": "Now some background about your lifestyle."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 162.46,
      "end_seconds": 180.23,
      "duration_seconds": 17.77,
      "text": "I gave up drinking about three years ago. I used to smoke but I quit five years ago. I'm a software engineer, so I'm at a screen all day. Yes, I live on my own."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 180.88,
      "end_seconds": 185.91,
      "duration_seconds": 5.03,
      "text": "What about family history, any illnesses that run in the family?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 186.78,
      "end_seconds": 191.33,
      "duration_seconds": 4.55,
      "text": "my father had kidney stones my mother has migraines"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 204.16,
      "end_seconds": 208.68,
      "duration_seconds": 4.52,
      "text": "What about your general health, any conditions you're being treated for?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 210.38,
      "end_seconds": 234.77,
      "duration_seconds": 24.39,
      "text": "High cholesterol, for two years. I kept putting it off, which I know isn't sensible. I took the morning off to come in today. I have diabetes, for about a year. I thought it would sort itself out, but it hasn't. I've never really been one for hospitals. I've got heart disease."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 235.36,
      "end_seconds": 242.08,
      "duration_seconds": 6.72,
      "text": "okay, I can see diabetes in your file as well i'll take a few measurements first"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 250.13,
      "end_seconds": 251.08,
      "duration_seconds": 0.95,
      "text": "Almost there..."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 261.88,
      "end_seconds": 284.68,
      "duration_seconds": 22.8,
      "text": "Okay: respiratory rate 16, temperature 36.8, pulse is 65 beats a minute, oxygen saturation is 97 percent, BP is 125 over 74. Stop me if I've got anything wrong. You've been feeling a bit dizzy after taking all your tablets, since Monday, and no chest pain or low mood."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 285.21,
      "end_seconds": 287.68,
      "duration_seconds": 2.47,
      "text": "mm, um, that's right"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 301.75,
      "end_seconds": 324.79,
      "duration_seconds": 23.04,
      "text": "An ECG is what I'd like next, for dizziness. I think blood tests makes sense here, for medication review. Bring every box and bottle you have at home to the next visit, even the herbal ones, and we'll sort them together. Call the clinic if you need us."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 325.31,
      "end_seconds": 327.3,
      "duration_seconds": 1.99,
      "text": "No questions. Thank you."
    }
  ]
}