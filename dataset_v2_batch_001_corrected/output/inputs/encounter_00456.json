{
  "schema_version": "1.0",
  "encounter_id": "00456",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.22,
      "end_seconds": 6.17,
      "duration_seconds": 4.95,
      "text": "Hi, uh, doctor. Is this the right room?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.96,
      "end_seconds": 11.19,
      "duration_seconds": 4.23,
      "text": "No trouble at all, come in. What's been bothering you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 12.77,
      "end_seconds": 19.97,
      "duration_seconds": 7.2,
      "text": "I've been getting lost on familiar roads, and I wanted to get it checked."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 21.1,
      "end_seconds": 22.88,
      "duration_seconds": 1.78,
      "text": "When did it begin?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 23.61,
      "end_seconds": 26.87,
      "duration_seconds": 3.26,
      "text": "I've had it for six months."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 27.56,
      "end_seconds": 30.31,
      "duration_seconds": 2.75,
      "text": "Does it come along with anything else?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 31.62,
      "end_seconds": 35.07,
      "duration_seconds": 3.45,
      "text": "It usually comes with difficulty finding words."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 36.22,
      "end_seconds": 39.09,
      "duration_seconds": 2.87,
      "text": "Okay, have you been forgetting things lately?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 40.88,
      "end_seconds": 46.81,
      "duration_seconds": 5.93,
      "text": "Yes, for three weeks. I'd been misplacing things, but that went away."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 60.86,
      "end_seconds": 63.32,
      "duration_seconds": 2.46,
      "text": "Let me measure a few things."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 72.86,
      "end_seconds": 73.82,
      "duration_seconds": 0.96,
      "text": "One second..."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 90.95,
      "end_seconds": 100.4,
      "duration_seconds": 9.45,
      "text": "Okay: blood pressure 118 over 74, SpO2 99 percent on room air, temperature 36.4. And heart rate 78."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 102.99,
      "end_seconds": 105.38,
      "duration_seconds": 2.39,
      "text": "Can I examine you now?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 106.78,
      "end_seconds": 107.89,
      "duration_seconds": 1.11,
      "text": "Go ahead."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 109.25,
      "end_seconds": 111.53,
      "duration_seconds": 2.28,
      "text": "Hold that position for me."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 129.78,
      "end_seconds": 134.58,
      "duration_seconds": 4.8,
      "text": "Your gait is steady and the tone in your limbs is normal."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 137.8,
      "end_seconds": 142.6,
      "duration_seconds": 4.8,
      "text": "That's fine, sit up. And what about hallucinations or low mood?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 143.74,
      "end_seconds": 146.4,
      "duration_seconds": 2.66,
      "text": "No, not any of them."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 147.04,
      "end_seconds": 150.24,
      "duration_seconds": 3.2,
      "text": "Has there been any trouble with bladder control?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 151.77,
      "end_seconds": 155.4,
      "duration_seconds": 3.63,
      "text": "I haven't noticed any trouble with bladder control."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 157.36,
      "end_seconds": 161.47,
      "duration_seconds": 4.11,
      "text": "And what about falls, weakness on one side or headache?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 167.54,
      "end_seconds": 170.09,
      "duration_seconds": 2.55,
      "text": "Oh, no, none of those."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 171.8,
      "end_seconds": 174.64,
      "duration_seconds": 2.84,
      "text": "Has your heart given you any trouble?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 176.18,
      "end_seconds": 180.4,
      "duration_seconds": 4.22,
      "text": "My heart's been fine, as far as I know."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 181.47,
      "end_seconds": 183.51,
      "duration_seconds": 2.04,
      "text": "Any operations in the past?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 185.3,
      "end_seconds": 189.73,
      "duration_seconds": 4.43,
      "text": "Just a hernia repair, about five years back."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 202.17,
      "end_seconds": 204.38,
      "duration_seconds": 2.21,
      "text": "Are you living with family?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 206.13,
      "end_seconds": 210.59,
      "duration_seconds": 4.46,
      "text": "I stay with my daughter and her family."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 212.57,
      "end_seconds": 214.97,
      "duration_seconds": 2.4,
      "text": "And what do you usually eat?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 215.49,
      "end_seconds": 218.83,
      "duration_seconds": 3.34,
      "text": "Mostly home-cooked food, rice and vegetables."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 220.89,
      "end_seconds": 225.31,
      "duration_seconds": 4.42,
      "text": "What about your general health, any conditions you're being treated for?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 226.38,
      "end_seconds": 228.38,
      "duration_seconds": 2.0,
      "text": "I have high cholesterol."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 228.99,
      "end_seconds": 229.69,
      "duration_seconds": 0.7,
      "text": "Right."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 231.47,
      "end_seconds": 245.31,
      "duration_seconds": 13.84,
      "text": "I've had diabetes, yes. High blood pressure, for about ten years. I'd rather not end up on lots of tablets if I can avoid it."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 247.37,
      "end_seconds": 261.96,
      "duration_seconds": 14.59,
      "text": "Right. Right, so diabetes and high blood pressure are already on your record. We'll keep that in mind today. Right, any medication at the moment, including things from the pharmacy?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 262.8,
      "end_seconds": 270.07,
      "duration_seconds": 7.27,
      "text": "I'm on something called rosu... rosuvastatin, 10 milligrams, maybe, at night for my cholesterol."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 270.74,
      "end_seconds": 274.9,
      "duration_seconds": 4.16,
      "text": "Did you happen to bring the box or the paperwork?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 276.96,
      "end_seconds": 283.78,
      "duration_seconds": 6.82,
      "text": "Not with me. I'll bring it next time. Ramipril, 5 milligrams, every morning."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 284.51,
      "end_seconds": 300.75,
      "duration_seconds": 16.24,
      "text": "Let me tell you where I've got to. It points towards memory difficulties that need to be worked up. I want to be honest that this is an impression, not a final answer. We shouldn't forget early dementia."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 309.36,
      "end_seconds": 321.39,
      "duration_seconds": 12.03,
      "text": "Let's get a vitamin B12 level, for memory loss. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 324.91,
      "end_seconds": 325.61,
      "duration_seconds": 0.7,
      "text": "Understood."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 327.48,
      "end_seconds": 329.62,
      "duration_seconds": 2.14,
      "text": "Right, that's all. Go gently."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 331.59,
      "end_seconds": 334.31,
      "duration_seconds": 2.72,
      "text": "Alright, thanks. Bye for now."
    }
  ]
}