{
  "schema_version": "1.0",
  "encounter_id": "00363",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.56,
      "end_seconds": 7.34,
      "duration_seconds": 6.78,
      "text": "Hi, doctor, I brought my bag, is it fine to leave it here?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.54,
      "end_seconds": 12.62,
      "duration_seconds": 4.08,
      "text": "you're fine, sit down so, what brings you in?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 14.05,
      "end_seconds": 18.12,
      "duration_seconds": 4.07,
      "text": "Good morning, doctor. I came along to help out."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 21.11,
      "end_seconds": 24.74,
      "duration_seconds": 3.63,
      "text": "yes, that's no problem at all please sit"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 26.46,
      "end_seconds": 30.11,
      "duration_seconds": 3.65,
      "text": "We came because of a high fever."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 31.42,
      "end_seconds": 33.2,
      "duration_seconds": 1.78,
      "text": "when did it begin?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 34.18,
      "end_seconds": 37.05,
      "duration_seconds": 2.87,
      "text": "Around a week, I think."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 40.5,
      "end_seconds": 44.08,
      "duration_seconds": 3.58,
      "text": "Hm, I'd say more like two weeks."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 45.38,
      "end_seconds": 49.48,
      "duration_seconds": 4.1,
      "text": "okay, so roughly one to two weeks. Is that right?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 50.56,
      "end_seconds": 51.58,
      "duration_seconds": 1.02,
      "text": "Yeah, roughly."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 52.13,
      "end_seconds": 55.44,
      "duration_seconds": 3.31,
      "text": "What's the pattern, is it there all day?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 57.1,
      "end_seconds": 60.09,
      "duration_seconds": 2.99,
      "text": "it's once or twice a day"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 61.05,
      "end_seconds": 66.59,
      "duration_seconds": 5.54,
      "text": "I was just gonna say that the main thing is—"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_4",
      "role": "NURSE",
      "start_seconds": 66.69,
      "end_seconds": 73.87,
      "duration_seconds": 7.18,
      "text": "sorry to cut in, doctor, quick question: shall I bring the trolley in now or later?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 75.49,
      "end_seconds": 77.8,
      "duration_seconds": 2.31,
      "text": "Later, thanks. Please go on."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 79.42,
      "end_seconds": 87.17,
      "duration_seconds": 7.75,
      "text": "Oh, and pain behind my eyes. I've also had no appetite, for two days."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 104.16,
      "end_seconds": 108.7,
      "duration_seconds": 4.54,
      "text": "anyone in the family with similar problems or other conditions?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 109.79,
      "end_seconds": 115.39,
      "duration_seconds": 5.6,
      "text": "My uncle had colon cancer. My sister has thyroid problems."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 117.06,
      "end_seconds": 121.72,
      "duration_seconds": 4.66,
      "text": "Tell me about your health in general, any ongoing conditions?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 123.44,
      "end_seconds": 128.13,
      "duration_seconds": 4.69,
      "text": "High blood pressure, for five years. I've got diabetes."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 129.07,
      "end_seconds": 137.48,
      "duration_seconds": 8.41,
      "text": "Right, so high blood pressure and diabetes are already on your record. We'll keep that in mind today. Do you smoke?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 139.53,
      "end_seconds": 142.97,
      "duration_seconds": 3.44,
      "text": "I stopped smoking about two years back."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 144.65,
      "end_seconds": 146.81,
      "duration_seconds": 2.16,
      "text": "How do you eat, generally?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 148.06,
      "end_seconds": 150.6,
      "duration_seconds": 2.54,
      "text": "I skip breakfast most days"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 152.33,
      "end_seconds": 155.61,
      "duration_seconds": 3.28,
      "text": "What kind of work do you do?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 157.34,
      "end_seconds": 161.04,
      "duration_seconds": 3.7,
      "text": "I work on a farm, it's quite physical"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 165.36,
      "end_seconds": 172.81,
      "duration_seconds": 7.45,
      "text": "any medication at the moment, including things from the pharmacy? It helps to be thorough at this stage"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 176.22,
      "end_seconds": 192.73,
      "duration_seconds": 16.51,
      "text": "He is on losartan, 50 milligrams, once a day for my blood pressure, I give it to him. He is on Glycomet, 500 milligrams, twice a day, I give it to him."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 193.49,
      "end_seconds": 199.15,
      "duration_seconds": 5.66,
      "text": "I had ramipril at one point, but I'm off it now."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 200.38,
      "end_seconds": 205.27,
      "duration_seconds": 4.89,
      "text": "Do you have any allergies to medicines, food, anything at all?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 205.78,
      "end_seconds": 208.64,
      "duration_seconds": 2.86,
      "text": "Not that I know, no."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 212.79,
      "end_seconds": 214.01,
      "duration_seconds": 1.22,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 214.52,
      "end_seconds": 216.99,
      "duration_seconds": 2.47,
      "text": "No, never had any surgery."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 217.69,
      "end_seconds": 219.8,
      "duration_seconds": 2.11,
      "text": "have you had any vomiting?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 224.96,
      "end_seconds": 226.56,
      "duration_seconds": 1.6,
      "text": "no vomiting, thankfully"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 228.34,
      "end_seconds": 233.42,
      "duration_seconds": 5.08,
      "text": "Any abdominal pain, blood in the stool, cough or breathlessness at all?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 235.35,
      "end_seconds": 248.05,
      "duration_seconds": 12.7,
      "text": "no, no abdominal pain, no blood in the stool, no cough. I did have severe body pain at one point, but that went away on its own"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 249.67,
      "end_seconds": 252.13,
      "duration_seconds": 2.46,
      "text": "how are your bowels, any trouble?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 253.19,
      "end_seconds": 255.54,
      "duration_seconds": 2.35,
      "text": "No, all normal there."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 257.48,
      "end_seconds": 261.14,
      "duration_seconds": 3.66,
      "text": "how about your heart, any problems like that?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 262.64,
      "end_seconds": 265.77,
      "duration_seconds": 3.13,
      "text": "Right, no, nothing with my heart."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_4",
      "role": "NURSE",
      "start_seconds": 266.81,
      "end_seconds": 276.67,
      "duration_seconds": 9.86,
      "text": "Doctor, I've got the readings for you. Blood pressure 106 over 70, pulse is 104 beats a minute, temperature is 38.7 degrees."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 278.49,
      "end_seconds": 279.9,
      "duration_seconds": 1.41,
      "text": "Good, thank you."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 280.96,
      "end_seconds": 283.14,
      "duration_seconds": 2.18,
      "text": "Shall we do the examination?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 296.18,
      "end_seconds": 296.88,
      "duration_seconds": 0.7,
      "text": "Fine."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 298.42,
      "end_seconds": 301.31,
      "duration_seconds": 2.89,
      "text": "Let me look at this properly."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 319.75,
      "end_seconds": 325.1,
      "duration_seconds": 5.35,
      "text": "there's a faint rash on your forearms, it blanches when I press"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 326.78,
      "end_seconds": 329.1,
      "duration_seconds": 2.32,
      "text": "Bear with me a second."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 345.04,
      "end_seconds": 350.68,
      "duration_seconds": 5.64,
      "text": "Your tummy is soft, a a little tender under the ribs on the right."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 354.05,
      "end_seconds": 378.9,
      "duration_seconds": 24.85,
      "text": "That's fine, sit up. Having listened and examined, I think we're dealing with a febrile illness that could be dengue at this stage. I can't rule out a viral flu-like illness yet. Malaria is still possible. We should do a full blood count for platelet count. I'm going to order a dengue test, for fever."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 380.82,
      "end_seconds": 399.99,
      "duration_seconds": 19.17,
      "text": "What I'm giving you is paracetamol, 500 milligrams, every six hours if needed, for three days. You take it by mouth. It's for fever and body aches. I'll put all of this in writing so you don't have to remember it."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 401.2,
      "end_seconds": 405.16,
      "duration_seconds": 3.96,
      "text": "Can I get that from the usual pharmacy?"
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 407.13,
      "end_seconds": 424.66,
      "duration_seconds": 17.53,
      "text": "Drink a lot, coconut water, ORS, whatever you can manage. Please don't wait if you notice any bleeding or you can't keep fluids down. That's when to be seen urgently. Come back in two days."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 430.81,
      "end_seconds": 431.51,
      "duration_seconds": 0.7,
      "text": "Okay."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 432.39,
      "end_seconds": 433.82,
      "duration_seconds": 1.43,
      "text": "any last questions?"
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 435.53,
      "end_seconds": 437.5,
      "duration_seconds": 1.97,
      "text": "No questions. Thank you."
    }
  ]
}