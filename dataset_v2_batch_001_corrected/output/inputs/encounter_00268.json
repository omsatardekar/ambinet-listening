{
  "schema_version": "1.0",
  "encounter_id": "00268",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.02,
      "end_seconds": 9.74,
      "duration_seconds": 8.72,
      "text": "Okay, so hi, doctor, I brought my bag, is it fine to leave it here?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 10.94,
      "end_seconds": 15.57,
      "duration_seconds": 4.63,
      "text": "That's alright, take a seat. Tell me why you've come."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 19.06,
      "end_seconds": 25.2,
      "duration_seconds": 6.14,
      "text": "So, So the thing is, I've got a very sore throat."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 26.16,
      "end_seconds": 29.12,
      "duration_seconds": 2.96,
      "text": "Since when have you had this?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 30.78,
      "end_seconds": 35.77,
      "duration_seconds": 4.99,
      "text": "Okay, so it's been five days, I'm fairly sure."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 36.11,
      "end_seconds": 40.84,
      "duration_seconds": 4.73,
      "text": "Uh-huh. On a normal day, how strong is it?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 42.39,
      "end_seconds": 44.44,
      "duration_seconds": 2.05,
      "text": "I'd call it severe."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 45.48,
      "end_seconds": 47.79,
      "duration_seconds": 2.31,
      "text": "Does anything make it better?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 48.95,
      "end_seconds": 52.67,
      "duration_seconds": 3.72,
      "text": "I get some relief from warm salt water."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 54.15,
      "end_seconds": 56.86,
      "duration_seconds": 2.71,
      "text": "Has there been any runny nose?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 58.64,
      "end_seconds": 62.16,
      "duration_seconds": 3.52,
      "text": "Not at all, no runny nose."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 63.08,
      "end_seconds": 65.97,
      "duration_seconds": 2.89,
      "text": "Any ear pain, cough or difficulty breathing?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 66.79,
      "end_seconds": 71.01,
      "duration_seconds": 4.22,
      "text": "No, no ear pain, cough or difficulty breathing."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 72.95,
      "end_seconds": 76.92,
      "duration_seconds": 3.97,
      "text": "Any change in your bowel habit or your stomach generally?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 80.57,
      "end_seconds": 84.24,
      "duration_seconds": 3.67,
      "text": "Uh, bowels are regular, nothing odd."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 96.46,
      "end_seconds": 99.23,
      "duration_seconds": 2.77,
      "text": "Are you on any regular medication?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 100.77,
      "end_seconds": 102.59,
      "duration_seconds": 1.82,
      "text": "No, nothing regular."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 109.6,
      "end_seconds": 115.2,
      "duration_seconds": 5.6,
      "text": "Do you have any allergies to medicines, food, anything at all?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 117.08,
      "end_seconds": 120.41,
      "duration_seconds": 3.33,
      "text": "I don't have any known medication allergies."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 122.11,
      "end_seconds": 124.28,
      "duration_seconds": 2.17,
      "text": "Tell me about your work."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 129.08,
      "end_seconds": 135.26,
      "duration_seconds": 6.18,
      "text": "I'm a software engineer, so I'm at a screen all day."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 136.21,
      "end_seconds": 138.79,
      "duration_seconds": 2.58,
      "text": "Okay, are you active at all?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 140.01,
      "end_seconds": 142.85,
      "duration_seconds": 2.84,
      "text": "Barely, I'm mostly sedentary these days."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 143.58,
      "end_seconds": 145.93,
      "duration_seconds": 2.35,
      "text": "How do you eat, generally?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 147.88,
      "end_seconds": 150.23,
      "duration_seconds": 2.35,
      "text": "I skip breakfast most days."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 152.15,
      "end_seconds": 155.43,
      "duration_seconds": 3.28,
      "text": "Any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 156.79,
      "end_seconds": 161.62,
      "duration_seconds": 4.83,
      "text": "Okay, so no, nothing, I've generally been healthy."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 163.0,
      "end_seconds": 165.38,
      "duration_seconds": 2.38,
      "text": "Let me check your vitals now."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 176.26,
      "end_seconds": 178.2,
      "duration_seconds": 1.94,
      "text": "Hold still for me..."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 193.17,
      "end_seconds": 200.01,
      "duration_seconds": 6.84,
      "text": "Okay: temperature is 39.1 degrees, saturation 98 percent, blood pressure 104 over 76. And pulse 102."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 202.81,
      "end_seconds": 204.47,
      "duration_seconds": 1.66,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 205.02,
      "end_seconds": 208.2,
      "duration_seconds": 3.18,
      "text": "Let's look at it together in a minute."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 209.27,
      "end_seconds": 212.65,
      "duration_seconds": 3.38,
      "text": "Come over here and I'll have a look."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 213.6,
      "end_seconds": 215.72,
      "duration_seconds": 2.12,
      "text": "Almost done with this part."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 228.83,
      "end_seconds": 231.55,
      "duration_seconds": 2.72,
      "text": "The glands under the jaw are tender."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 233.04,
      "end_seconds": 235.79,
      "duration_seconds": 2.75,
      "text": "Stay still while I have a look."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 249.81,
      "end_seconds": 256.89,
      "duration_seconds": 7.08,
      "text": "Both tonsils are red and swollen, and there are white patches on the left one."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 259.82,
      "end_seconds": 260.78,
      "duration_seconds": 0.96,
      "text": "Okay, finished."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 268.15,
      "end_seconds": 274.98,
      "duration_seconds": 6.83,
      "text": "Okay, thinking it through, this is probably a throat infection, either bacterial or viral."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 276.98,
      "end_seconds": 279.27,
      "duration_seconds": 2.29,
      "text": "Doctor, is this dangerous?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 281.17,
      "end_seconds": 292.39,
      "duration_seconds": 11.22,
      "text": "I understand the worry. At the moment I'd say it's a throat infection, either bacterial or viral, and we'll know more once the a throat swab is back."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 299.98,
      "end_seconds": 330.01,
      "duration_seconds": 30.03,
      "text": "I'll request a throat swab, it'll help with sore throat. It's a routine test and it'll give us a much clearer picture. I'd like you to take paracetamol, 500 milligrams, every six hours if needed, for three days. That's for fever and body aches. Gargle with warm salt water a few times a day, it does soothe it. Finish the whole course of antibiotics even if you feel better after two days."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 330.57,
      "end_seconds": 337.6,
      "duration_seconds": 7.03,
      "text": "I'd like you back if it's not better in three days. Call the clinic if you need us."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 341.89,
      "end_seconds": 344.28,
      "duration_seconds": 2.39,
      "text": "Oh, no questions. Thank you."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 346.05,
      "end_seconds": 347.44,
      "duration_seconds": 1.39,
      "text": "All the best."
    }
  ]
}