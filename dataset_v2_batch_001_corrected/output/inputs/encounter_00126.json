{
  "schema_version": "1.0",
  "encounter_id": "00126",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.63,
      "end_seconds": 6.34,
      "duration_seconds": 5.71,
      "text": "Hi, you know, doctor. Long queue outside, but here I am."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.74,
      "end_seconds": 13.74,
      "duration_seconds": 6.0,
      "text": "Right, yes, come in, take a seat. What can I do for you today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 15.12,
      "end_seconds": 26.92,
      "duration_seconds": 11.8,
      "text": "Well, you know, hello, doctor. I hope it's alright if I stay in for this. Doctor, it's periods lasting longer. That's what we're worried about."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 28.29,
      "end_seconds": 30.01,
      "duration_seconds": 1.72,
      "text": "When did it begin?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 31.69,
      "end_seconds": 40.39,
      "duration_seconds": 8.7,
      "text": "It's been like this since this morning. I didn't want to make a fuss, you know."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 41.2,
      "end_seconds": 45.11,
      "duration_seconds": 3.91,
      "text": "How would you describe it, mild, moderate, severe?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 47.2,
      "end_seconds": 55.46,
      "duration_seconds": 8.26,
      "text": "I'd call it severe. I did have very heavy periods at one point, but that's gone now."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 70.85,
      "end_seconds": 74.32,
      "duration_seconds": 3.47,
      "text": "Have you had any vaginal discharge or fever?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 75.88,
      "end_seconds": 77.45,
      "duration_seconds": 1.57,
      "text": "No, nothing there."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 78.39,
      "end_seconds": 80.34,
      "duration_seconds": 1.95,
      "text": "Is your mobility otherwise okay?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 81.49,
      "end_seconds": 83.08,
      "duration_seconds": 1.59,
      "text": "No, nothing there."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 84.43,
      "end_seconds": 87.5,
      "duration_seconds": 3.07,
      "text": "Have you ever been under the knife?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 88.02,
      "end_seconds": 92.66,
      "duration_seconds": 4.64,
      "text": "Just cataract surgery on my right eye, last year."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 94.67,
      "end_seconds": 100.16,
      "duration_seconds": 5.49,
      "text": "Have you ever reacted badly to a medicine or food? Any allergies?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 101.82,
      "end_seconds": 104.12,
      "duration_seconds": 2.3,
      "text": "Sulfa drugs, I'd say."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 105.71,
      "end_seconds": 109.77,
      "duration_seconds": 4.06,
      "text": "Do your parents or siblings have any long-term illnesses?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 111.03,
      "end_seconds": 113.23,
      "duration_seconds": 2.2,
      "text": "My mother has migraines."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 114.7,
      "end_seconds": 116.86,
      "duration_seconds": 2.16,
      "text": "Do you have a job?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 118.09,
      "end_seconds": 120.13,
      "duration_seconds": 2.04,
      "text": "I'm a self-employed electrician."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 121.14,
      "end_seconds": 123.24,
      "duration_seconds": 2.1,
      "text": "Who do you live with?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 124.51,
      "end_seconds": 129.27,
      "duration_seconds": 4.76,
      "text": "I live with my family, my husband and two kids."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 130.44,
      "end_seconds": 132.76,
      "duration_seconds": 2.32,
      "text": "Do you exercise at all?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 133.27,
      "end_seconds": 138.24,
      "duration_seconds": 4.97,
      "text": "I go to the gym a couple of times a week."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 150.98,
      "end_seconds": 155.08,
      "duration_seconds": 4.1,
      "text": "Moving on to your background, any past medical history?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 156.17,
      "end_seconds": 158.2,
      "duration_seconds": 2.03,
      "text": "Yes, an underactive thyroid."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 159.7,
      "end_seconds": 170.55,
      "duration_seconds": 10.85,
      "text": "Mhm. Okay, I can see an underactive thyroid in your file as well. Any medication at the moment, including things from the pharmacy?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 171.1,
      "end_seconds": 175.85,
      "duration_seconds": 4.75,
      "text": "Right, it's Thyronorm, 50 micrograms, every morning, doctor."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 185.5,
      "end_seconds": 189.11,
      "duration_seconds": 3.61,
      "text": "Let's get your blood pressure and the other basics."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 200.96,
      "end_seconds": 202.84,
      "duration_seconds": 1.88,
      "text": "Just relax your arm..."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 213.68,
      "end_seconds": 228.93,
      "duration_seconds": 15.25,
      "text": "Okay: temperature is 36.6 degrees, saturation 97 percent, height 172 centimetres, BMI works out to 30.1, weight 89 kilos, pressure 111 over 75, pulse is 75 beats a minute."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 231.75,
      "end_seconds": 235.12,
      "duration_seconds": 3.37,
      "text": "Come over here and I'll have a look."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 236.79,
      "end_seconds": 239.37,
      "duration_seconds": 2.58,
      "text": "Just relax, I'll be quick."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 250.2,
      "end_seconds": 256.29,
      "duration_seconds": 6.09,
      "text": "The tummy is soft, a little tender in the lower part, and there's no mass."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 257.17,
      "end_seconds": 259.31,
      "duration_seconds": 2.14,
      "text": "Take your time, no rush."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 275.47,
      "end_seconds": 277.48,
      "duration_seconds": 2.01,
      "text": "You look a little pale."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 283.45,
      "end_seconds": 315.73,
      "duration_seconds": 32.28,
      "text": "Right, you can sit back down. From what you've told me and what I found, I think we're dealing with heavy periods with a cause still to find at this stage. Let's book blood tests to look into heavy periods. I want a pregnancy test done, that's for abnormal bleeding. I'm prescribing ferrous sulfate, 200 milligrams, once a day, for three months. That's for possible iron deficiency."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 317.56,
      "end_seconds": 338.49,
      "duration_seconds": 20.93,
      "text": "Keep a note of how many pads you use each day and the dates, it helps us a lot. The thing that would worry me is if you soak through a pad every hour or feel faint. If that happens, go to emergency."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 339.03,
      "end_seconds": 341.79,
      "duration_seconds": 2.76,
      "text": "Okay, uh, fair enough."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 342.32,
      "end_seconds": 349.62,
      "duration_seconds": 7.3,
      "text": "Book a review after the results are back. That's it on my side. Anything unclear?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 354.95,
      "end_seconds": 356.88,
      "duration_seconds": 1.93,
      "text": "Thanks, that was helpful."
    }
  ]
}