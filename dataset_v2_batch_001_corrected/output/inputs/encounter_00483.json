{
  "schema_version": "1.0",
  "encounter_id": "00483",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.68,
      "end_seconds": 5.18,
      "duration_seconds": 4.5,
      "text": "Sorry I'm a few minutes behind, um, doctor."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 9.55,
      "end_seconds": 15.19,
      "duration_seconds": 5.64,
      "text": "Yes, come in, take a seat. What can I do for you today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 17.49,
      "end_seconds": 21.09,
      "duration_seconds": 3.6,
      "text": "I'm here because of more breathlessness than usual."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 21.98,
      "end_seconds": 24.64,
      "duration_seconds": 2.66,
      "text": "When did you first notice it?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 25.54,
      "end_seconds": 35.6,
      "duration_seconds": 10.06,
      "text": "Hm. It was either the end of last month or earlier than that. I couldn't tell you the date."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 36.12,
      "end_seconds": 39.65,
      "duration_seconds": 3.53,
      "text": "Right, right. So, and how severe is it?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 41.05,
      "end_seconds": 56.77,
      "duration_seconds": 15.72,
      "text": "Hmm, maybe a four out of ten on a bad day. And a wheeze, too. About wheeze, it's severe, honestly. It settles a little with the inhaler."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 58.62,
      "end_seconds": 61.31,
      "duration_seconds": 2.69,
      "text": "Let me measure a few things."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 72.4,
      "end_seconds": 74.01,
      "duration_seconds": 1.61,
      "text": "Hold still for me..."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 94.42,
      "end_seconds": 102.98,
      "duration_seconds": 8.56,
      "text": "Okay: pulse 90, pressure 130 over 74, respiratory rate 21, temperature is 37.1 degrees, saturation 89 percent."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 107.24,
      "end_seconds": 108.76,
      "duration_seconds": 1.52,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 111.79,
      "end_seconds": 114.27,
      "duration_seconds": 2.48,
      "text": "That's fine, we'll come to it."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 115.74,
      "end_seconds": 119.42,
      "duration_seconds": 3.68,
      "text": "Okay, I need to examine you for this."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 121.09,
      "end_seconds": 123.04,
      "duration_seconds": 1.95,
      "text": "Let me press here."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 138.58,
      "end_seconds": 143.82,
      "duration_seconds": 5.24,
      "text": "Air entry is reduced on both sides with a prolonged breathing out phase."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 148.47,
      "end_seconds": 153.44,
      "duration_seconds": 4.97,
      "text": "Thanks for that. Have you had any weight loss or chest pain?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 154.62,
      "end_seconds": 156.58,
      "duration_seconds": 1.96,
      "text": "No. None of those."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 157.62,
      "end_seconds": 162.08,
      "duration_seconds": 4.46,
      "text": "Have you had any coughing up blood, fever or swollen ankles?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 163.23,
      "end_seconds": 168.81,
      "duration_seconds": 5.58,
      "text": "No coughing up blood, fever or swollen ankles, none of it."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 169.45,
      "end_seconds": 172.88,
      "duration_seconds": 3.43,
      "text": "Anything on the skin I should know about?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 173.89,
      "end_seconds": 174.79,
      "duration_seconds": 0.9,
      "text": "Skin's normal."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 175.88,
      "end_seconds": 179.82,
      "duration_seconds": 3.94,
      "text": "What about your tummy and bowels, anything unusual there?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 180.69,
      "end_seconds": 183.5,
      "duration_seconds": 2.81,
      "text": "Bowels are regular, nothing odd."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 202.29,
      "end_seconds": 205.47,
      "duration_seconds": 3.18,
      "text": "Is there anything medical in your background?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 206.74,
      "end_seconds": 224.71,
      "duration_seconds": 17.97,
      "text": "Yeah, I've had high blood pressure for about a year now. My family kept telling me to get it checked. COPD, for about ten years. I just want to get back to normal, really."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 226.18,
      "end_seconds": 233.65,
      "duration_seconds": 7.47,
      "text": "Alright, COPD, that matches what I have here. Anyone in the family with similar problems or other conditions?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 234.56,
      "end_seconds": 237.31,
      "duration_seconds": 2.75,
      "text": "My father had a heart attack."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 238.1,
      "end_seconds": 240.9,
      "duration_seconds": 2.8,
      "text": "Now some background about your lifestyle."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 242.52,
      "end_seconds": 253.18,
      "duration_seconds": 10.66,
      "text": "Barely, I'm mostly sedentary these days. I stay with my daughter and her family. I teach at a primary school."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 254.2,
      "end_seconds": 258.89,
      "duration_seconds": 4.69,
      "text": "So, what about allergies, to medicines or foods or anything else?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 263.54,
      "end_seconds": 266.34,
      "duration_seconds": 2.8,
      "text": "Yes, I'm allergic to pollen."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 280.93,
      "end_seconds": 285.35,
      "duration_seconds": 4.42,
      "text": "Let's go through your medication. What are you taking?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 286.23,
      "end_seconds": 295.32,
      "duration_seconds": 9.09,
      "text": "Amlodipine. I take it 5 milligrams, once a day. Tiotropium inhaler, once a day for my chest."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 296.83,
      "end_seconds": 301.83,
      "duration_seconds": 5.0,
      "text": "Okay, thinking it through, my working impression is a flare-up of COPD."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 303.21,
      "end_seconds": 305.72,
      "duration_seconds": 2.51,
      "text": "Do you think it's serious?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 306.39,
      "end_seconds": 317.16,
      "duration_seconds": 10.77,
      "text": "I understand the worry. At the moment I'd say it's a flare-up of COPD, and we'll know more once the a sputum culture is back."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 325.63,
      "end_seconds": 329.84,
      "duration_seconds": 4.21,
      "text": "I'll request a sputum culture, it'll help with productive cough."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 330.77,
      "end_seconds": 332.78,
      "duration_seconds": 2.01,
      "text": "Mm, uh, okay."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 333.69,
      "end_seconds": 364.95,
      "duration_seconds": 31.26,
      "text": "I'll request a chest X-ray, it'll help with breathlessness. It's a routine test and it'll give us a much clearer picture. I'm prescribing doxycycline, 100 milligrams, twice a day, for five days. You take it by mouth. That should help with chest infection. I'll start you on prednisolone, 30 milligrams, once a day, for five days. You take it by mouth. That's for COPD flare-up. I'd like to see you again in two weeks. Thanks for coming in."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 365.5,
      "end_seconds": 366.94,
      "duration_seconds": 1.44,
      "text": "Right. Thanks again."
    }
  ]
}