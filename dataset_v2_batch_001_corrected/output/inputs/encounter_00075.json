{
  "schema_version": "1.0",
  "encounter_id": "00075",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.13,
      "end_seconds": 6.37,
      "duration_seconds": 5.24,
      "text": "Well, hi, doctor. Long queue outside, but here I am."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.72,
      "end_seconds": 11.05,
      "duration_seconds": 3.33,
      "text": "not at all please sit what's the problem?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 12.37,
      "end_seconds": 29.66,
      "duration_seconds": 17.29,
      "text": "right, I've been sweating, and I wanted to get it checked. A neighbour of mine said I should see someone about it. I told myself I'd wait and see, and here I am"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 30.98,
      "end_seconds": 37.12,
      "duration_seconds": 6.14,
      "text": "since when have you had this? Bear with me, I'm just building up the picture"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 37.79,
      "end_seconds": 41.79,
      "duration_seconds": 4.0,
      "text": "It's It's been two days I'm fairly sure."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 42.7,
      "end_seconds": 50.6,
      "duration_seconds": 7.9,
      "text": "can you describe it a bit more for me? How strong it is, what the pattern is, what helps"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 52.59,
      "end_seconds": 55.74,
      "duration_seconds": 3.15,
      "text": "Mostly mild. It's all the time."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 56.93,
      "end_seconds": 60.12,
      "duration_seconds": 3.19,
      "text": "right, any a headache afterwards as well?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 62.86,
      "end_seconds": 67.02,
      "duration_seconds": 4.16,
      "text": "yeah, I've had that since this morning"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 67.91,
      "end_seconds": 69.88,
      "duration_seconds": 1.97,
      "text": "and how severe is it?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 71.05,
      "end_seconds": 74.57,
      "duration_seconds": 3.52,
      "text": "Pretty severe, if I'm being honest."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 75.21,
      "end_seconds": 79.74,
      "duration_seconds": 4.53,
      "text": "Alright, what about allergies, to medicines or foods or anything else?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 81.05,
      "end_seconds": 86.37,
      "duration_seconds": 5.32,
      "text": "hmm, I'm allergic to shellfish, I get hives"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 100.95,
      "end_seconds": 103.41,
      "duration_seconds": 2.46,
      "text": "So, who's at home with you?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 104.52,
      "end_seconds": 109.59,
      "duration_seconds": 5.07,
      "text": "It's just me and my wife at home now."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 111.69,
      "end_seconds": 113.14,
      "duration_seconds": 1.45,
      "text": "Do you work?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 114.87,
      "end_seconds": 120.9,
      "duration_seconds": 6.03,
      "text": "I run a small shop, so I'm on my feet a lot."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 122.27,
      "end_seconds": 124.49,
      "duration_seconds": 2.22,
      "text": "Do you exercise at all?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 126.17,
      "end_seconds": 131.78,
      "duration_seconds": 5.61,
      "text": "I go to the gym a couple of times a week"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 132.79,
      "end_seconds": 135.92,
      "duration_seconds": 3.13,
      "text": "are you on any tablets or medication?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 136.62,
      "end_seconds": 142.91,
      "duration_seconds": 6.29,
      "text": "Metformin. I take it 500 milligrams twice a day for my sugar"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 146.66,
      "end_seconds": 149.95,
      "duration_seconds": 3.29,
      "text": "Okay since when have you been taking it?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 151.66,
      "end_seconds": 153.45,
      "duration_seconds": 1.79,
      "text": "About two months."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 155.53,
      "end_seconds": 158.14,
      "duration_seconds": 2.61,
      "text": "any diagnoses you've been given before?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 159.52,
      "end_seconds": 163.84,
      "duration_seconds": 4.32,
      "text": "I've had diabetes for five years now"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 165.92,
      "end_seconds": 166.62,
      "duration_seconds": 0.7,
      "text": "yes?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 175.57,
      "end_seconds": 178.05,
      "duration_seconds": 2.48,
      "text": "have you had any surgery before?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 179.38,
      "end_seconds": 185.37,
      "duration_seconds": 5.99,
      "text": "yes, I had my thyroid operated on, a long time ago"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 186.26,
      "end_seconds": 189.68,
      "duration_seconds": 3.42,
      "text": "Did you get vomiting or weight loss?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 191.38,
      "end_seconds": 193.83,
      "duration_seconds": 2.45,
      "text": "No. None of those."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 194.6,
      "end_seconds": 197.88,
      "duration_seconds": 3.28,
      "text": "A few quick ones: confusion or seizure?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 199.37,
      "end_seconds": 202.94,
      "duration_seconds": 3.57,
      "text": "no, uh, no confusion or seizure"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 206.92,
      "end_seconds": 210.44,
      "duration_seconds": 3.52,
      "text": "How about your heart, any problems like that?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 212.12,
      "end_seconds": 213.89,
      "duration_seconds": 1.77,
      "text": "nothing like that"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 232.16,
      "end_seconds": 235.09,
      "duration_seconds": 2.93,
      "text": "A few measurements, then we'll continue."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 245.01,
      "end_seconds": 245.9,
      "duration_seconds": 0.89,
      "text": "Almost there..."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 257.91,
      "end_seconds": 265.41,
      "duration_seconds": 7.5,
      "text": "Okay: temp 36.7 degrees, heart rate 79, pressure 117 over 69, SpO2 97 percent on room air."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 267.9,
      "end_seconds": 270.93,
      "duration_seconds": 3.03,
      "text": "I'll examine you now, bear with me."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 272.87,
      "end_seconds": 274.98,
      "duration_seconds": 2.11,
      "text": "bear with me a second"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 293.66,
      "end_seconds": 297.96,
      "duration_seconds": 4.3,
      "text": "Pulse is normal and there's no tremor right now."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 298.65,
      "end_seconds": 299.66,
      "duration_seconds": 1.01,
      "text": "No problem."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 302.29,
      "end_seconds": 323.32,
      "duration_seconds": 21.03,
      "text": "that's all I need, thank you. So where does that leave us? I'd lean towards low sugar episodes related to diabetes medication. I'll request an HbA1c, it'll help with diabetes control. That will help us see what's going on underneath and decide the next step"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 324.3,
      "end_seconds": 328.0,
      "duration_seconds": 3.7,
      "text": "where do I go for that?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 329.69,
      "end_seconds": 346.92,
      "duration_seconds": 17.23,
      "text": "Always keep glucose tablets or a sweet in your bag, and don't skip meals if you've taken your sugar tablet. Please don't wait if you black out or can't wake up properly after an episode. That's when to be seen urgently."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 347.57,
      "end_seconds": 350.3,
      "duration_seconds": 2.73,
      "text": "okay you know I'll remember"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 351.7,
      "end_seconds": 357.25,
      "duration_seconds": 5.55,
      "text": "we'll catch up in two weeks. Ask me anything before you go"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 358.46,
      "end_seconds": 360.09,
      "duration_seconds": 1.63,
      "text": "Right. Thanks again."
    }
  ]
}