{
  "schema_version": "1.0",
  "encounter_id": "00378",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.94,
      "end_seconds": 7.17,
      "duration_seconds": 6.23,
      "text": "Right, hello? Doctor? They told me to come straight in."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 9.22,
      "end_seconds": 13.58,
      "duration_seconds": 4.36,
      "text": "You're fine, sit down. So, what brings you in?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 14.83,
      "end_seconds": 25.23,
      "duration_seconds": 10.4,
      "text": "Um, I've been waking up at night with pins and needles. I didn't want to make a fuss, you know."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 26.4,
      "end_seconds": 29.15,
      "duration_seconds": 2.75,
      "text": "how far back does it go?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 29.84,
      "end_seconds": 31.93,
      "duration_seconds": 2.09,
      "text": "About... well, four weeks."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 33.56,
      "end_seconds": 38.08,
      "duration_seconds": 4.52,
      "text": "okay, give me more detail on it, whatever comes to mind"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 38.91,
      "end_seconds": 61.58,
      "duration_seconds": 22.67,
      "text": "oh, uh, it settles a little with shaking my hand. Honestly, every other day. A three out of ten, I suppose. I told myself I'd wait and see, and here I am. There's a weak grip as well"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 63.28,
      "end_seconds": 66.63,
      "duration_seconds": 3.35,
      "text": "Any bladder problems or headache at all?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 68.63,
      "end_seconds": 71.82,
      "duration_seconds": 3.19,
      "text": "No, I'd have mentioned it."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 73.08,
      "end_seconds": 77.97,
      "duration_seconds": 4.89,
      "text": "Any weakness in the legs or trouble walking at all?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 79.69,
      "end_seconds": 87.6,
      "duration_seconds": 7.91,
      "text": "I mean, you know, I haven't had weakness in the legs or trouble walking, no."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 88.36,
      "end_seconds": 91.13,
      "duration_seconds": 2.77,
      "text": "Anything different when you pass water?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 92.58,
      "end_seconds": 95.37,
      "duration_seconds": 2.79,
      "text": "Right, no, that's all fine."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 96.82,
      "end_seconds": 100.53,
      "duration_seconds": 3.71,
      "text": "which tablets or creams or inhalers do you use?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 102.53,
      "end_seconds": 107.24,
      "duration_seconds": 4.71,
      "text": "Paracetamol. I take it 500 milligrams, when needed"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 111.23,
      "end_seconds": 112.88,
      "duration_seconds": 1.65,
      "text": "And for how long?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 117.65,
      "end_seconds": 119.6,
      "duration_seconds": 1.95,
      "text": "For about a year."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 133.21,
      "end_seconds": 136.57,
      "duration_seconds": 3.36,
      "text": "So, any allergies I should know about?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 141.15,
      "end_seconds": 145.27,
      "duration_seconds": 4.12,
      "text": "Hmm, yes, dust. I get itchy eyes."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 146.93,
      "end_seconds": 152.54,
      "duration_seconds": 5.61,
      "text": "Tell me about your routine, work, habits, that sort of thing."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 154.37,
      "end_seconds": 174.1,
      "duration_seconds": 19.73,
      "text": "I gave up drinking about three years ago. I smoke, yes, around five a day. Yes, I'm a nurse on a busy ward. I try to avoid too much sugar. I stay with my daughter and her family."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 175.35,
      "end_seconds": 179.74,
      "duration_seconds": 4.39,
      "text": "Do you have any medical conditions I should know about?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 181.24,
      "end_seconds": 185.0,
      "duration_seconds": 3.76,
      "text": "No, I've never had anything serious."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 195.78,
      "end_seconds": 199.32,
      "duration_seconds": 3.54,
      "text": "have you had to have anything operated on?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 199.84,
      "end_seconds": 207.04,
      "duration_seconds": 7.2,
      "text": "Uh, I had my tonsils out when I was a child."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 207.9,
      "end_seconds": 211.92,
      "duration_seconds": 4.02,
      "text": "Let's get your blood pressure and the other basics."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 220.69,
      "end_seconds": 223.02,
      "duration_seconds": 2.33,
      "text": "Okay, give me a moment..."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 234.7,
      "end_seconds": 247.39,
      "duration_seconds": 12.69,
      "text": "okay: height 175 centimetres, pulse is 86 beats a minute, weight 59 kilos, temp 36.6 degrees, BMI works out to 19.3, respiratory rate 18, pressure 116 over 74."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 249.82,
      "end_seconds": 253.84,
      "duration_seconds": 4.02,
      "text": "Right, let me check a few things physically."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 255.63,
      "end_seconds": 257.72,
      "duration_seconds": 2.09,
      "text": "Let me just check something."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 269.9,
      "end_seconds": 273.83,
      "duration_seconds": 3.93,
      "text": "Bending the wrist for a minute brings on the numbness."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 283.52,
      "end_seconds": 284.22,
      "duration_seconds": 0.7,
      "text": "Okay."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 285.81,
      "end_seconds": 287.78,
      "duration_seconds": 1.97,
      "text": "Bear with me a second."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 304.8,
      "end_seconds": 307.93,
      "duration_seconds": 3.13,
      "text": "Tapping over the wrist reproduces the the tingling."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 312.52,
      "end_seconds": 323.85,
      "duration_seconds": 11.33,
      "text": "Right, you can sit back down. Having listened and and examined, this looks most like carpal tunnel syndrome. Diabetic neuropathy is still possible."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 324.99,
      "end_seconds": 328.93,
      "duration_seconds": 3.94,
      "text": "uh, is this going to go away?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 330.91,
      "end_seconds": 344.29,
      "duration_seconds": 13.38,
      "text": "Nothing I've seen today points to an emergency. It looks like carpal tunnel syndrome. Alright, there's nothing new for me to start or arrange today. Okay, we're done for today. Take care."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 346.12,
      "end_seconds": 351.07,
      "duration_seconds": 4.95,
      "text": "No, you know, you've explained it well. Thanks."
    }
  ]
}