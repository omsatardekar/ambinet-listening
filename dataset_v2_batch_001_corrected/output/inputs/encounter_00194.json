{
  "schema_version": "1.0",
  "encounter_id": "00194",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.02,
      "end_seconds": 5.55,
      "duration_seconds": 4.53,
      "text": "Sorry, doctor, I couldn't find the door at first."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 10.98,
      "end_seconds": 15.92,
      "duration_seconds": 4.94,
      "text": "that's alright, take a seat tell me why you've come"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 17.53,
      "end_seconds": 30.09,
      "duration_seconds": 12.56,
      "text": "Doctor, I'm just here to help with the details. It's, It's red scaly patches on my elbows, doctor. He didn't want to come, but I insisted."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 31.45,
      "end_seconds": 35.8,
      "duration_seconds": 4.35,
      "text": "is this recent, or has it been a while?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 36.87,
      "end_seconds": 42.94,
      "duration_seconds": 6.07,
      "text": "It's been two years now. I'm hoping you can tell me something definite."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 43.67,
      "end_seconds": 48.3,
      "duration_seconds": 4.63,
      "text": "Okay, give me more detail on it, whatever comes to mind."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 50.14,
      "end_seconds": 58.65,
      "duration_seconds": 8.51,
      "text": "It's worse with stress and cold weather. Only sunlight, and it's not much. I'd call it mild."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 60.61,
      "end_seconds": 63.41,
      "duration_seconds": 2.8,
      "text": "any scaling on the scalp as well?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 64.42,
      "end_seconds": 65.44,
      "duration_seconds": 1.02,
      "text": "Mm, yes."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 66.46,
      "end_seconds": 68.78,
      "duration_seconds": 2.32,
      "text": "has there been itching too?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 69.88,
      "end_seconds": 84.13,
      "duration_seconds": 14.25,
      "text": "yes, um, about the same, about three months. Oh, as for itching, honestly, a couple of times a week. And there's pitted nails as well, about a month now"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 86.21,
      "end_seconds": 88.9,
      "duration_seconds": 2.69,
      "text": "Let me check your vitals now."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 101.68,
      "end_seconds": 102.55,
      "duration_seconds": 0.87,
      "text": "Almost there..."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 122.92,
      "end_seconds": 127.37,
      "duration_seconds": 4.45,
      "text": "okay: temperature 36.5, pulse 83, pressure 109 over 75."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 129.46,
      "end_seconds": 130.95,
      "duration_seconds": 1.49,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 136.56,
      "end_seconds": 139.98,
      "duration_seconds": 3.42,
      "text": "Let's look at it together in a minute."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 142.03,
      "end_seconds": 144.97,
      "duration_seconds": 2.94,
      "text": "Let me have a look at you."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 162.75,
      "end_seconds": 163.45,
      "duration_seconds": 0.7,
      "text": "Okay."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 165.26,
      "end_seconds": 168.39,
      "duration_seconds": 3.13,
      "text": "Stay still while I have a look."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 177.37,
      "end_seconds": 181.41,
      "duration_seconds": 4.04,
      "text": "Well-defined thick silvery plaques over both elbows and knees."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 183.03,
      "end_seconds": 185.19,
      "duration_seconds": 2.16,
      "text": "take your time, no rush"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 193.73,
      "end_seconds": 196.54,
      "duration_seconds": 2.81,
      "text": "A few small pits in the fingernails."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 197.85,
      "end_seconds": 198.55,
      "duration_seconds": 0.7,
      "text": "fine"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 203.88,
      "end_seconds": 207.97,
      "duration_seconds": 4.09,
      "text": "Thanks, please take a seat again. Nothing like fever?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 210.04,
      "end_seconds": 213.62,
      "duration_seconds": 3.58,
      "text": "Not that that I've noticed, no fever."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 215.07,
      "end_seconds": 220.65,
      "duration_seconds": 5.58,
      "text": "actually, doctor, I did notice fever. He doesn't always say"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 222.13,
      "end_seconds": 229.65,
      "duration_seconds": 7.52,
      "text": "well, no, I don't think I did. Maybe a little, I'm not sure"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 230.52,
      "end_seconds": 237.77,
      "duration_seconds": 7.25,
      "text": "alright, I'll note both what you've said and what you've noticed. And new medicines, any of that?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 239.76,
      "end_seconds": 241.91,
      "duration_seconds": 2.15,
      "text": "Definitely no new medicines."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 242.44,
      "end_seconds": 249.06,
      "duration_seconds": 6.62,
      "text": "did you get joint swelling, weeping, eye redness or sore throat before it started?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 253.38,
      "end_seconds": 262.06,
      "duration_seconds": 8.68,
      "text": "No, um, no joint swelling, weeping, eye redness or sore throat before it started."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 263.26,
      "end_seconds": 267.08,
      "duration_seconds": 3.82,
      "text": "On the the cardiac side, anything I should know?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 269.09,
      "end_seconds": 274.7,
      "duration_seconds": 5.61,
      "text": "oh, my heart's been fine, as far as I know"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 275.79,
      "end_seconds": 280.31,
      "duration_seconds": 4.52,
      "text": "moving on to your background, any past medical history?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 281.51,
      "end_seconds": 284.31,
      "duration_seconds": 2.8,
      "text": "I've had high blood pressure, yes."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 285.76,
      "end_seconds": 286.46,
      "duration_seconds": 0.7,
      "text": "Mm."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 289.91,
      "end_seconds": 293.12,
      "duration_seconds": 3.21,
      "text": "I've got diabetes yes, heart disease"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 294.87,
      "end_seconds": 301.08,
      "duration_seconds": 6.21,
      "text": "alright, diabetes, that matches what I have here a few questions about your lifestyle now"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 303.03,
      "end_seconds": 319.55,
      "duration_seconds": 16.52,
      "text": "I gave up drinking about three years ago. Mostly home-cooked food, rice and vegetables. I work on a farm, it's quite physical. I go to the gym a couple of times a week."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 335.66,
      "end_seconds": 339.13,
      "duration_seconds": 3.47,
      "text": "have you had to have anything operated on?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 340.47,
      "end_seconds": 344.2,
      "duration_seconds": 3.73,
      "text": "I had a bypass operation six years ago."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 344.99,
      "end_seconds": 347.16,
      "duration_seconds": 2.17,
      "text": "Any drug or food allergies?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 347.72,
      "end_seconds": 350.39,
      "duration_seconds": 2.67,
      "text": "Yes, aspirin. I get wheezing."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 352.08,
      "end_seconds": 355.35,
      "duration_seconds": 3.27,
      "text": "tell me what you take day to day"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 357.04,
      "end_seconds": 371.41,
      "duration_seconds": 14.37,
      "text": "yeah, I take telmisartan, 40 milligrams, once a day for my pressure. Uh, I'm on something called metf... metformin, 500 milligrams, maybe, twice a day"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 373.13,
      "end_seconds": 378.66,
      "duration_seconds": 5.53,
      "text": "Okay, did you happen to bring the box or the paperwork?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 379.48,
      "end_seconds": 390.49,
      "duration_seconds": 11.01,
      "text": "No, it's at home. Aspirin. I take it 75 milligrams, once a day. I'd been on clopidogrel, not any more though, I stopped."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 401.84,
      "end_seconds": 430.35,
      "duration_seconds": 28.51,
      "text": "Putting it all together, it's hard to say. Plaque psoriasis is one possibility and a fungal infection another, and I'd rather not commit yet. I want blood tests done, that's for baseline before treatment. What I'm giving you is calcipotriol-betamethasone gel, once a day, for four weeks. That's for psoriasis. A little sunlight helps psoriasis, but avoid sunburn. Moisturise often. I'm going to send a referral to a dermatologist."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 431.12,
      "end_seconds": 432.78,
      "duration_seconds": 1.66,
      "text": "Alright, thank you."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 433.43,
      "end_seconds": 444.79,
      "duration_seconds": 11.36,
      "text": "and please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose we'll catch up in six weeks"
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 445.41,
      "end_seconds": 447.99,
      "duration_seconds": 2.58,
      "text": "Sure, you know, that's doable."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 449.01,
      "end_seconds": 452.36,
      "duration_seconds": 3.35,
      "text": "Good. Let us know how you get on."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 453.06,
      "end_seconds": 455.37,
      "duration_seconds": 2.31,
      "text": "thanks so much, doctor"
    }
  ]
}