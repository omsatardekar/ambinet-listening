{
  "schema_version": "1.0",
  "encounter_id": "00370",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.05,
      "end_seconds": 8.33,
      "duration_seconds": 7.28,
      "text": "Okay, uh, so hello? Doctor? They told me to come straight in."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 10.05,
      "end_seconds": 15.51,
      "duration_seconds": 5.46,
      "text": "Yes, come in, take a seat. What can I do for you today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 16.68,
      "end_seconds": 20.62,
      "duration_seconds": 3.94,
      "text": "Doctor, you know, thank you for seeing us."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 21.51,
      "end_seconds": 26.07,
      "duration_seconds": 4.56,
      "text": "Of course, please stay. It's helpful to have you here."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 26.7,
      "end_seconds": 30.82,
      "duration_seconds": 4.12,
      "text": "He's been having swollen ankles in the evening, doctor."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 31.43,
      "end_seconds": 35.28,
      "duration_seconds": 3.85,
      "text": "Alright, how long has this been going on?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 36.23,
      "end_seconds": 41.5,
      "duration_seconds": 5.27,
      "text": "I mean, it's been about a month, I'm fairly sure."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 42.8,
      "end_seconds": 50.79,
      "duration_seconds": 7.99,
      "text": "Can you describe it a bit more for me? How strong it is, what the pattern is, what helps."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 52.76,
      "end_seconds": 65.41,
      "duration_seconds": 12.65,
      "text": "Yes, standing all day. That makes it worse. It settles a little with raising the legs. Pretty mild, if I'm being honest. It comes and goes."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 70.02,
      "end_seconds": 73.61,
      "duration_seconds": 3.59,
      "text": "Anything that tends to go along with it?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 74.81,
      "end_seconds": 92.91,
      "duration_seconds": 18.1,
      "text": "Tight shoes by the end of the day goes along with it, most of the time. The tight shoes by the end of the day? That's been for two days. And a heavy feeling in the legs, too."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 94.61,
      "end_seconds": 101.59,
      "duration_seconds": 6.98,
      "text": "And what about one leg more swollen than the other, breathlessness lying flat or weight gain?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 102.82,
      "end_seconds": 104.89,
      "duration_seconds": 2.07,
      "text": "No, none of those."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 106.68,
      "end_seconds": 110.35,
      "duration_seconds": 3.67,
      "text": "And what about calf pain or chest pain?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 111.03,
      "end_seconds": 116.09,
      "duration_seconds": 5.06,
      "text": "No calf pain or chest pain, none of it."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 118.02,
      "end_seconds": 119.36,
      "duration_seconds": 1.34,
      "text": "Neurologically, anything strange?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 119.96,
      "end_seconds": 121.43,
      "duration_seconds": 1.47,
      "text": "Nothing odd there."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 122.32,
      "end_seconds": 126.06,
      "duration_seconds": 3.74,
      "text": "Anything on the skin I should know about?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 127.21,
      "end_seconds": 128.12,
      "duration_seconds": 0.91,
      "text": "Skin's normal."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 145.81,
      "end_seconds": 150.95,
      "duration_seconds": 5.14,
      "text": "Do you have any allergies to medicines, food, anything at all?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 152.11,
      "end_seconds": 154.99,
      "duration_seconds": 2.88,
      "text": "No, nothing I'm aware of."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 157.05,
      "end_seconds": 162.45,
      "duration_seconds": 5.4,
      "text": "Do you have any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 163.06,
      "end_seconds": 165.76,
      "duration_seconds": 2.7,
      "text": "I've got high blood pressure."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 167.01,
      "end_seconds": 172.0,
      "duration_seconds": 4.99,
      "text": "Okay, keep going. A few questions about your lifestyle now."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 173.0,
      "end_seconds": 180.85,
      "duration_seconds": 7.85,
      "text": "I stay with my daughter and her family. I'm mostly vegetarian. I cycle to work most mornings."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 182.46,
      "end_seconds": 186.72,
      "duration_seconds": 4.26,
      "text": "Any medication at the moment, including things from the pharmacy?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 190.75,
      "end_seconds": 196.98,
      "duration_seconds": 6.23,
      "text": "He is on ramipril, 5 milligrams, every morning, I give it to him."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 198.92,
      "end_seconds": 202.27,
      "duration_seconds": 3.35,
      "text": "First the numbers, if you don't mind."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 211.8,
      "end_seconds": 213.74,
      "duration_seconds": 1.94,
      "text": "Rest your hand here..."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 224.97,
      "end_seconds": 233.97,
      "duration_seconds": 9.0,
      "text": "Okay: temperature 36.5, blood pressure 167 over 103. And pulse 79, respiratory rate 15, oxygen saturation is 99 percent."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 234.93,
      "end_seconds": 237.65,
      "duration_seconds": 2.72,
      "text": "Well, is that alright, doctor?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 238.29,
      "end_seconds": 242.28,
      "duration_seconds": 3.99,
      "text": "Don't worry, I'll go through it in a moment."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 244.35,
      "end_seconds": 246.63,
      "duration_seconds": 2.28,
      "text": "Shall we do the examination?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 248.34,
      "end_seconds": 249.45,
      "duration_seconds": 1.11,
      "text": "No problem."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 250.67,
      "end_seconds": 252.89,
      "duration_seconds": 2.22,
      "text": "Tell me if anything hurts."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 263.96,
      "end_seconds": 267.66,
      "duration_seconds": 3.7,
      "text": "Chest is clear and the neck veins aren't raised."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 269.06,
      "end_seconds": 271.52,
      "duration_seconds": 2.46,
      "text": "Hold that position for me."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 280.62,
      "end_seconds": 285.42,
      "duration_seconds": 4.8,
      "text": "Mild pitting swelling around both ankles, equal on both sides."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 289.19,
      "end_seconds": 291.01,
      "duration_seconds": 1.82,
      "text": "That's fine, sit up."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 304.15,
      "end_seconds": 312.67,
      "duration_seconds": 8.52,
      "text": "Right, here's what I'm thinking. The most likely explanation is ankle swelling possibly from a blood pressure tablet."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 331.35,
      "end_seconds": 355.74,
      "duration_seconds": 24.39,
      "text": "We should do kidney function tests for leg swelling. Raise your legs when you're sitting and try compression socks. I'm not ordering an echocardiogram today. If things carry on in two weeks, we'll consider it. If the symptoms get worse, that's the point to come in urgently. Come back after the results are back. Ask me anything before you go."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 356.8,
      "end_seconds": 359.26,
      "duration_seconds": 2.46,
      "text": "Alright, thanks. Bye for now."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 360.48,
      "end_seconds": 361.69,
      "duration_seconds": 1.21,
      "text": "Safe journey home."
    }
  ]
}