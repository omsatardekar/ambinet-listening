{
  "schema_version": "1.0",
  "encounter_id": "00050",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.52,
      "end_seconds": 3.9,
      "duration_seconds": 3.38,
      "text": "Morning. Nice to finally see you, doctor."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 4.61,
      "end_seconds": 9.07,
      "duration_seconds": 4.46,
      "text": "You're fine, sit down. So, what brings you in?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 10.65,
      "end_seconds": 15.05,
      "duration_seconds": 4.4,
      "text": "So, I'm here because of tingling in the feet."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 16.7,
      "end_seconds": 19.53,
      "duration_seconds": 2.83,
      "text": "since when have you had this?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 21.56,
      "end_seconds": 24.74,
      "duration_seconds": 3.18,
      "text": "Since Friday, that's when it began"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 26.75,
      "end_seconds": 29.36,
      "duration_seconds": 2.61,
      "text": "is it mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 31.53,
      "end_seconds": 35.58,
      "duration_seconds": 4.05,
      "text": "I'd give it a seven, out of ten."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 36.9,
      "end_seconds": 39.38,
      "duration_seconds": 2.48,
      "text": "Have you had a sore tongue?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 40.91,
      "end_seconds": 44.54,
      "duration_seconds": 3.63,
      "text": "Yeah, I've had that since this morning."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 45.78,
      "end_seconds": 47.37,
      "duration_seconds": 1.59,
      "text": "Let's do your observations."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 54.14,
      "end_seconds": 55.53,
      "duration_seconds": 1.39,
      "text": "Alright, almost there..."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 68.12,
      "end_seconds": 76.59,
      "duration_seconds": 8.47,
      "text": "Okay: pressure 115 over 75, SpO2 99 percent on room air. And temperature is 36.7 degrees, pulse 71."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 79.17,
      "end_seconds": 81.98,
      "duration_seconds": 2.81,
      "text": "Let's do the physical part now."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 83.08,
      "end_seconds": 84.3,
      "duration_seconds": 1.22,
      "text": "I'll go gently"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 95.8,
      "end_seconds": 98.94,
      "duration_seconds": 3.14,
      "text": "Gentle pressure over the shin bone is tender."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 100.1,
      "end_seconds": 102.3,
      "duration_seconds": 2.2,
      "text": "Let me just check something."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 111.94,
      "end_seconds": 115.07,
      "duration_seconds": 3.13,
      "text": "The tongue looks smooth and a little red."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 120.57,
      "end_seconds": 121.58,
      "duration_seconds": 1.01,
      "text": "Okay, finished."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 135.23,
      "end_seconds": 138.7,
      "duration_seconds": 3.47,
      "text": "Alright, any weight loss, breathlessness or poor diet?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 139.75,
      "end_seconds": 143.05,
      "duration_seconds": 3.3,
      "text": "No, um, not any of them."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 148.14,
      "end_seconds": 150.18,
      "duration_seconds": 2.04,
      "text": "anything unusual with passing urine?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 150.85,
      "end_seconds": 154.18,
      "duration_seconds": 3.33,
      "text": "that's normal as far as I know"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 170.52,
      "end_seconds": 174.44,
      "duration_seconds": 3.92,
      "text": "do you have any medical conditions I should know about?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 176.42,
      "end_seconds": 180.99,
      "duration_seconds": 4.57,
      "text": "No, um, nothing, I've generally been healthy."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 190.95,
      "end_seconds": 195.95,
      "duration_seconds": 5.0,
      "text": "what about allergies, to medicines or foods or anything else?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 197.02,
      "end_seconds": 201.47,
      "duration_seconds": 4.45,
      "text": "I mean, you know, not that I know, no."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 201.99,
      "end_seconds": 207.03,
      "duration_seconds": 5.04,
      "text": "okay, anyone in the family with similar problems or other conditions?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 209.06,
      "end_seconds": 211.14,
      "duration_seconds": 2.08,
      "text": "My sister has epilepsy."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 229.2,
      "end_seconds": 232.62,
      "duration_seconds": 3.42,
      "text": "okay, are you on any regular medication?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 233.45,
      "end_seconds": 237.33,
      "duration_seconds": 3.88,
      "text": "Um, no, I don't take anything regularly."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 242.24,
      "end_seconds": 244.96,
      "duration_seconds": 2.72,
      "text": "What do you do for work?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 246.1,
      "end_seconds": 251.39,
      "duration_seconds": 5.29,
      "text": "I work in an office, mostly sitting at a desk."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 252.41,
      "end_seconds": 254.98,
      "duration_seconds": 2.57,
      "text": "Right, who's at home with you?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 255.77,
      "end_seconds": 260.07,
      "duration_seconds": 4.3,
      "text": "It's just me and my wife at home now."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 261.23,
      "end_seconds": 263.43,
      "duration_seconds": 2.2,
      "text": "do you exercise at all?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 264.12,
      "end_seconds": 269.76,
      "duration_seconds": 5.64,
      "text": "I go to the gym a couple of times a week."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 271.05,
      "end_seconds": 301.76,
      "duration_seconds": 30.71,
      "text": "okay, so my impression is this: The most likely explanation is a vitamin deficiency. Let's book a vitamin D level to look into bone aches. I'm going to put you on vitamin D, 60000 units, once a week, for eight weeks. That should help with possible deficiency. Some midday sunlight on the arms for fifteen minutes helps. I'd like you back after the results are back"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 302.62,
      "end_seconds": 308.07,
      "duration_seconds": 5.45,
      "text": "right, how would you describe the plan, so we're on the same page?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 309.61,
      "end_seconds": 315.36,
      "duration_seconds": 5.75,
      "text": "So, I come back after the results are back. Is that right?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 315.98,
      "end_seconds": 320.61,
      "duration_seconds": 4.63,
      "text": "Yes, exactly right. Okay, that's everything from me. Any other questions?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 321.62,
      "end_seconds": 324.74,
      "duration_seconds": 3.12,
      "text": "I appreciate it, uh, doctor."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 326.46,
      "end_seconds": 327.83,
      "duration_seconds": 1.37,
      "text": "bye for now"
    }
  ]
