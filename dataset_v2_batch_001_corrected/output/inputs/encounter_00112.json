{
  "schema_version": "1.0",
  "encounter_id": "00112",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.7,
      "end_seconds": 5.6,
      "duration_seconds": 4.9,
      "text": "Right, um, good morning, doctor. Can I come in?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.47,
      "end_seconds": 10.26,
      "duration_seconds": 3.79,
      "text": "Right on time. Sit, please. How can I help?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 11.21,
      "end_seconds": 18.27,
      "duration_seconds": 7.06,
      "text": "Honestly, it's very heavy periods, and my family pushed me to come."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 20.24,
      "end_seconds": 23.06,
      "duration_seconds": 2.82,
      "text": "Okay, and when did that start?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 24.21,
      "end_seconds": 27.26,
      "duration_seconds": 3.05,
      "text": "Since yesterday, that's when it began."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 31.4,
      "end_seconds": 34.89,
      "duration_seconds": 3.49,
      "text": "Anything that tends to go along with it?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 36.96,
      "end_seconds": 41.4,
      "duration_seconds": 4.44,
      "text": "Tiredness goes along with it, most of the time."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 42.14,
      "end_seconds": 44.32,
      "duration_seconds": 2.18,
      "text": "Have you been passing clots?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 48.74,
      "end_seconds": 55.56,
      "duration_seconds": 6.82,
      "text": "So, yes, since this morning. There's cramping pain in the lower tummy as well."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 56.7,
      "end_seconds": 59.99,
      "duration_seconds": 3.29,
      "text": "Alright, is it mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 60.9,
      "end_seconds": 66.69,
      "duration_seconds": 5.79,
      "text": "Moderate, I'd say. The tiredness? That's been for three days."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 67.79,
      "end_seconds": 73.1,
      "duration_seconds": 5.31,
      "text": "Have you had very heavy periods before, or is this the first time?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 74.29,
      "end_seconds": 79.61,
      "duration_seconds": 5.32,
      "text": "I had a similar thing last year. It went away."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 81.36,
      "end_seconds": 87.4,
      "duration_seconds": 6.04,
      "text": "So, did you get weight loss, pain during sex, fever or vaginal discharge?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 88.56,
      "end_seconds": 91.49,
      "duration_seconds": 2.93,
      "text": "No, I'd have mentioned it."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 92.55,
      "end_seconds": 94.42,
      "duration_seconds": 1.87,
      "text": "How's your breathing otherwise?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 96.16,
      "end_seconds": 98.98,
      "duration_seconds": 2.82,
      "text": "No, you know, nothing there."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 100.9,
      "end_seconds": 102.07,
      "duration_seconds": 1.17,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 102.7,
      "end_seconds": 108.68,
      "duration_seconds": 5.98,
      "text": "So, you know, yes, I had a knee arthroscopy, three years ago."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 125.12,
      "end_seconds": 129.34,
      "duration_seconds": 4.22,
      "text": "Any relatives with health problems I should be aware of?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 131.24,
      "end_seconds": 135.47,
      "duration_seconds": 4.23,
      "text": "My mother has diabetes. My grandmother had breast cancer."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 137.57,
      "end_seconds": 142.34,
      "duration_seconds": 4.77,
      "text": "What about allergies, to medicines or foods or anything else?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 143.27,
      "end_seconds": 148.13,
      "duration_seconds": 4.86,
      "text": "I'm allergic to sulfa drugs, I get itching all over."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 150.04,
      "end_seconds": 154.24,
      "duration_seconds": 4.2,
      "text": "Moving on to your background, any past medical history?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 155.92,
      "end_seconds": 161.33,
      "duration_seconds": 5.41,
      "text": "Yes, an underactive thyroid. I have eczema, for five years."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 165.82,
      "end_seconds": 173.61,
      "duration_seconds": 7.79,
      "text": "Okay, I can see an underactive thyroid and eczema in your file as well. What about alcohol?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 175.24,
      "end_seconds": 179.47,
      "duration_seconds": 4.23,
      "text": "A beer or two most evenings, to be honest."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 180.58,
      "end_seconds": 182.59,
      "duration_seconds": 2.01,
      "text": "Okay, do you smoke?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 183.62,
      "end_seconds": 187.15,
      "duration_seconds": 3.53,
      "text": "I smoke about ten cigarettes a day."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 191.84,
      "end_seconds": 193.48,
      "duration_seconds": 1.64,
      "text": "What's your diet like?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 195.2,
      "end_seconds": 199.55,
      "duration_seconds": 4.35,
      "text": "I eat out quite a lot, to be honest."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 201.16,
      "end_seconds": 204.03,
      "duration_seconds": 2.87,
      "text": "Is anyone at home with you?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 205.17,
      "end_seconds": 208.34,
      "duration_seconds": 3.17,
      "text": "I share a flat with two friends."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 208.97,
      "end_seconds": 212.25,
      "duration_seconds": 3.28,
      "text": "Are you on any tablets or medication?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 213.33,
      "end_seconds": 217.27,
      "duration_seconds": 3.94,
      "text": "I'm on thyroxine, 75 micrograms, maybe, every morning."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 217.94,
      "end_seconds": 222.68,
      "duration_seconds": 4.74,
      "text": "Did you happen to bring the box or the paperwork?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 224.38,
      "end_seconds": 231.31,
      "duration_seconds": 6.93,
      "text": "No, it's at home. Hydrocortisone cream. I take it when needed for the eczema."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 232.37,
      "end_seconds": 234.32,
      "duration_seconds": 1.95,
      "text": "Let's do your observations."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 245.91,
      "end_seconds": 247.72,
      "duration_seconds": 1.81,
      "text": "Just relax your arm..."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 263.56,
      "end_seconds": 273.83,
      "duration_seconds": 10.27,
      "text": "Okay: saturation 99 percent, BP is 123 over 80, temperature 36.7. And respiratory rate 14, pulse is 85 beats a minute."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 275.0,
      "end_seconds": 277.75,
      "duration_seconds": 2.75,
      "text": "Let me have a look at you."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 278.56,
      "end_seconds": 280.95,
      "duration_seconds": 2.39,
      "text": "Take your time, no rush."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 291.53,
      "end_seconds": 297.93,
      "duration_seconds": 6.4,
      "text": "The tummy is soft, a little tender in the lower part, and there's no mass."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 299.05,
      "end_seconds": 301.61,
      "duration_seconds": 2.56,
      "text": "Take your time, no rush."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 315.05,
      "end_seconds": 317.49,
      "duration_seconds": 2.44,
      "text": "You look a little pale."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 320.73,
      "end_seconds": 323.76,
      "duration_seconds": 3.03,
      "text": "Right, you can sit back down."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 339.57,
      "end_seconds": 349.89,
      "duration_seconds": 10.32,
      "text": "Taking everything into account, this looks most like heavy periods with a cause still to find. A hormonal imbalance is still possible."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 365.16,
      "end_seconds": 368.92,
      "duration_seconds": 3.76,
      "text": "Have you had any tests for this so far?"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 369.71,
      "end_seconds": 376.15,
      "duration_seconds": 6.44,
      "text": "I did have a pregnancy test done last month, but the paper's at home."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 377.73,
      "end_seconds": 381.77,
      "duration_seconds": 4.04,
      "text": "Let's book a pelvic ultrasound to look into heavy periods."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 383.81,
      "end_seconds": 387.87,
      "duration_seconds": 4.06,
      "text": "I can book that for Friday at 11:30 am."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 388.47,
      "end_seconds": 390.51,
      "duration_seconds": 2.04,
      "text": "Okay, I'll be there."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 391.25,
      "end_seconds": 429.54,
      "duration_seconds": 38.29,
      "text": "I'm sending you for blood tests because of heavy periods. I'm prescribing tranexamic acid, 500 milligrams, three times a day during periods, for three cycles. You take it by mouth. That should help with heavy bleeding. What I'm giving you is ferrous sulfate, 200 milligrams, once a day, for three months. That should help with possible iron deficiency. Keep a note of how many pads you use each day and the dates, it helps us a lot."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 430.93,
      "end_seconds": 446.14,
      "duration_seconds": 15.21,
      "text": "Cut down on salt and fried food for now, it really does make a difference. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 446.81,
      "end_seconds": 448.36,
      "duration_seconds": 1.55,
      "text": "Okay, I understand."
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 449.64,
      "end_seconds": 458.47,
      "duration_seconds": 8.83,
      "text": "Come back or go to emergency straight away if you soak through a pad every hour or feel faint."
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 459.16,
      "end_seconds": 461.78,
      "duration_seconds": 2.62,
      "text": "Okay, uh, I understand."
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 464.97,
      "end_seconds": 471.0,
      "duration_seconds": 6.03,
      "text": "Come back in four weeks. Okay, we're done for today. Take care."
    },
    {
      "segment_id": "SEG0059",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 471.96,
      "end_seconds": 476.15,
      "duration_seconds": 4.19,
      "text": "Okay, uh, so no questions. Thank you."
    },
    {
      "segment_id": "SEG0060",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 477.1,
      "end_seconds": 478.47,
      "duration_seconds": 1.37,
      "text": "See you then."
    }
  ]
}