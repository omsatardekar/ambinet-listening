  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.93,
      "end_seconds": 4.93,
      "duration_seconds": 4.0,
      "text": "Morning. Nice to finally see you, doctor."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.0,
      "end_seconds": 9.3,
      "duration_seconds": 3.3,
      "text": "Yes, do sit. Tell me what's been happening."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 10.81,
      "end_seconds": 15.4,
      "duration_seconds": 4.59,
      "text": "good morning, doctor. I came along to help out"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 17.21,
      "end_seconds": 21.05,
      "duration_seconds": 3.84,
      "text": "Alright, yes, that's no problem at all. Please sit."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 22.53,
      "end_seconds": 28.95,
      "duration_seconds": 6.42,
      "text": "I mean, I'm here because of a mole on my back that looks different."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 29.95,
      "end_seconds": 32.88,
      "duration_seconds": 2.93,
      "text": "since when have you had this?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 33.78,
      "end_seconds": 37.03,
      "duration_seconds": 3.25,
      "text": "Around about a month, I think."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 39.02,
      "end_seconds": 43.05,
      "duration_seconds": 4.03,
      "text": "I think it's been nearer about two months, actually."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 44.94,
      "end_seconds": 49.14,
      "duration_seconds": 4.2,
      "text": "Okay, so roughly one to two months. Is that right?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 50.67,
      "end_seconds": 52.76,
      "duration_seconds": 2.09,
      "text": "That sounds about right."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 53.0,
      "end_seconds": 53.7,
      "duration_seconds": 0.7,
      "text": "Okay."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 55.23,
      "end_seconds": 57.92,
      "duration_seconds": 2.69,
      "text": "There's it bled once as well."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 59.08,
      "end_seconds": 60.88,
      "duration_seconds": 1.8,
      "text": "Let's do your observations."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 69.43,
      "end_seconds": 71.32,
      "duration_seconds": 1.89,
      "text": "Rest your hand here..."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 82.83,
      "end_seconds": 88.19,
      "duration_seconds": 5.36,
      "text": "okay: pulse is 84 beats a a minute, pressure 122 over 81."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 89.33,
      "end_seconds": 92.25,
      "duration_seconds": 2.92,
      "text": "if you're comfortable, I'll examine you now"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 94.09,
      "end_seconds": 96.34,
      "duration_seconds": 2.25,
      "text": "bear with me a second"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 103.84,
      "end_seconds": 109.74,
      "duration_seconds": 5.9,
      "text": "It's about eight millimetres, with an uneven border and two shades of brown."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 112.02,
      "end_seconds": 119.57,
      "duration_seconds": 7.55,
      "text": "Thanks, please take a seat again. So, a few quick ones: pain or lumps in the armpit?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 121.63,
      "end_seconds": 126.0,
      "duration_seconds": 4.37,
      "text": "No, no pain or lumps in the armpit."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 128.04,
      "end_seconds": 134.95,
      "duration_seconds": 6.91,
      "text": "Let me check a few things. Any history of skin cancer or weight loss?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 135.94,
      "end_seconds": 137.6,
      "duration_seconds": 1.66,
      "text": "No, nothing there."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 139.51,
      "end_seconds": 143.38,
      "duration_seconds": 3.87,
      "text": "Right, on the cardiac side, anything I should know?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 145.03,
      "end_seconds": 149.31,
      "duration_seconds": 4.28,
      "text": "My heart's been fine, as far as I know."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 151.21,
      "end_seconds": 153.72,
      "duration_seconds": 2.51,
      "text": "any breathing difficulties apart from this?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 154.44,
      "end_seconds": 156.43,
      "duration_seconds": 1.99,
      "text": "No problems with breathing."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 158.14,
      "end_seconds": 159.71,
      "duration_seconds": 1.57,
      "text": "Any procedures or operations?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 160.86,
      "end_seconds": 168.17,
      "duration_seconds": 7.31,
      "text": "Just a knee arthroscopy, three years ago. Sorry, I know I'm rambling a bit."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 183.79,
      "end_seconds": 186.13,
      "duration_seconds": 2.34,
      "text": "any drug or food allergies?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 186.76,
      "end_seconds": 187.88,
      "duration_seconds": 1.12,
      "text": "No allergies."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 203.49,
      "end_seconds": 204.71,
      "duration_seconds": 1.22,
      "text": "Any regular medication?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 205.36,
      "end_seconds": 207.07,
      "duration_seconds": 1.71,
      "text": "No, nothing regular."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 208.61,
      "end_seconds": 211.64,
      "duration_seconds": 3.03,
      "text": "A few questions about your lifestyle now."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 213.51,
      "end_seconds": 227.41,
      "duration_seconds": 13.9,
      "text": "I run a small shop, so I'm on my feet a lot. I try to avoid too much sugar. I share a flat with two friends."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 228.11,
      "end_seconds": 231.79,
      "duration_seconds": 3.68,
      "text": "any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 232.67,
      "end_seconds": 235.63,
      "duration_seconds": 2.96,
      "text": "No, none that I know of."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 238.48,
      "end_seconds": 246.39,
      "duration_seconds": 7.91,
      "text": "putting it all together, this is probably a pigmented lesion that needs to be looked at more closely"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 247.38,
      "end_seconds": 251.03,
      "duration_seconds": 3.65,
      "text": "Is this something I'll have for good?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 252.58,
      "end_seconds": 265.5,
      "duration_seconds": 12.92,
      "text": "I understand the worry at the moment I'd say it's a pigmented lesion that needs to be looked at more closely, and we'll watch how it goes"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 282.8,
      "end_seconds": 291.28,
      "duration_seconds": 8.48,
      "text": "Please use sunscreen and cover up in the midday sun, and check your skin once a month."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 293.32,
      "end_seconds": 297.89,
      "duration_seconds": 4.57,
      "text": "Could I get a dermoscopy done? A friend had it."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 302.18,
      "end_seconds": 308.94,
      "duration_seconds": 6.76,
      "text": "Not at this point, no. It isn't indicated yet. Do you have any questions?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 314.45,
      "end_seconds": 315.93,
      "duration_seconds": 1.48,
      "text": "Right. Thanks again."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 317.89,
      "end_seconds": 320.1,
      "duration_seconds": 2.21,
      "text": "so, mind how you go"
    }
  ]
