{
  "schema_version": "1.0",
  "encounter_id": "00155",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.89,
      "end_seconds": 1.93,
      "duration_seconds": 1.04,
      "text": "Afternoon, doctor."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 2.52,
      "end_seconds": 6.17,
      "duration_seconds": 3.65,
      "text": "Yes, do sit. Tell me what's been happening."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 6.96,
      "end_seconds": 13.01,
      "duration_seconds": 6.05,
      "text": "Hello, doctor. I hope it's alright if I stay in for this."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 14.98,
      "end_seconds": 20.76,
      "duration_seconds": 5.78,
      "text": "I wanted to get a throbbing headache on one side looked at."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 22.59,
      "end_seconds": 24.31,
      "duration_seconds": 1.72,
      "text": "When did it begin?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 25.13,
      "end_seconds": 33.13,
      "duration_seconds": 8.0,
      "text": "It's been about a month now. My family kept telling me to get it checked."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 34.79,
      "end_seconds": 43.93,
      "duration_seconds": 9.14,
      "text": "Tell me a bit more about it: how bad it gets, how often, and whether anything makes it better or worse."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 45.2,
      "end_seconds": 59.0,
      "duration_seconds": 13.8,
      "text": "Um, it's worse with bright lights. Maybe a four out of ten on a bad day. I told myself I'd wait and see, and here I am."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 60.08,
      "end_seconds": 63.54,
      "duration_seconds": 3.46,
      "text": "Anything that tends to go along with it?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 64.21,
      "end_seconds": 70.83,
      "duration_seconds": 6.62,
      "text": "It usually comes with vomiting. And nausea as well, since last Tuesday."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 74.48,
      "end_seconds": 83.33,
      "duration_seconds": 8.85,
      "text": "Tell me a bit more about it: how bad it it gets, how often, and whether anything makes it better or worse."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 85.42,
      "end_seconds": 93.0,
      "duration_seconds": 7.58,
      "text": "It happens all the time. I'd call it moderate. The vomiting? That's been for ten days."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 93.57,
      "end_seconds": 96.19,
      "duration_seconds": 2.62,
      "text": "can I take your vitals now?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 108.34,
      "end_seconds": 110.04,
      "duration_seconds": 1.7,
      "text": "just relax your arm.."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 129.08,
      "end_seconds": 138.22,
      "duration_seconds": 9.14,
      "text": "okay: pulse is 67 beats a minute, temperature 37.0, oxygen saturation is 97 percent, blood pressure 120 over 73."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 139.88,
      "end_seconds": 141.93,
      "duration_seconds": 2.05,
      "text": "Is that alright, doctor?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 143.76,
      "end_seconds": 148.39,
      "duration_seconds": 4.63,
      "text": "Okay, they help build the picture, I'll tell you more soon."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 149.82,
      "end_seconds": 151.84,
      "duration_seconds": 2.02,
      "text": "Can I examine you now?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 164.98,
      "end_seconds": 165.91,
      "duration_seconds": 0.93,
      "text": "Go ahead."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 167.23,
      "end_seconds": 169.28,
      "duration_seconds": 2.05,
      "text": "Let me just check something."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 178.34,
      "end_seconds": 181.88,
      "duration_seconds": 3.54,
      "text": "Neck is supple, no stiffness at all."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 183.82,
      "end_seconds": 186.51,
      "duration_seconds": 2.69,
      "text": "let me look at this properly"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 202.44,
      "end_seconds": 206.09,
      "duration_seconds": 3.65,
      "text": "Cranial nerves look normal, eye movements are full."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 209.3,
      "end_seconds": 214.78,
      "duration_seconds": 5.48,
      "text": "Good, that's the examination. And what about double vision or loss of consciousness?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 215.84,
      "end_seconds": 217.64,
      "duration_seconds": 1.8,
      "text": "No, nothing there."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 218.28,
      "end_seconds": 221.21,
      "duration_seconds": 2.93,
      "text": "and what about neck stiffness or fever?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 223.04,
      "end_seconds": 224.58,
      "duration_seconds": 1.54,
      "text": "No, nothing there."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 226.45,
      "end_seconds": 229.33,
      "duration_seconds": 2.88,
      "text": "Anything different when you pass water?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 230.13,
      "end_seconds": 233.39,
      "duration_seconds": 3.26,
      "text": "That's normal as far as I know."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 247.09,
      "end_seconds": 252.41,
      "duration_seconds": 5.32,
      "text": "okay, are there any allergies on your record that I should check?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 256.98,
      "end_seconds": 260.32,
      "duration_seconds": 3.34,
      "text": "Uh, not that I know, no."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 261.73,
      "end_seconds": 264.2,
      "duration_seconds": 2.47,
      "text": "any diagnoses you've been given before?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 265.32,
      "end_seconds": 269.78,
      "duration_seconds": 4.46,
      "text": "I have migraines, for about ten years yes, anxiety"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 270.67,
      "end_seconds": 276.35,
      "duration_seconds": 5.68,
      "text": "Yes, migraines and anxiety are known to us, good to have that clear."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 294.14,
      "end_seconds": 297.99,
      "duration_seconds": 3.85,
      "text": "Let's go through your medication. What are you taking?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 298.87,
      "end_seconds": 305.7,
      "duration_seconds": 6.83,
      "text": "I'm on something called suma... sumatriptan, 50 milligrams, maybe, when needed for my migraines"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 309.91,
      "end_seconds": 314.31,
      "duration_seconds": 4.4,
      "text": "Did you happen to bring the box or the paperwork?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 319.51,
      "end_seconds": 322.26,
      "duration_seconds": 2.75,
      "text": "oh, no, it's at home"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 323.4,
      "end_seconds": 325.75,
      "duration_seconds": 2.35,
      "text": "So, and alcohol, how much?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 326.51,
      "end_seconds": 331.44,
      "duration_seconds": 4.93,
      "text": "I have a couple of drinks on the weekend."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 332.45,
      "end_seconds": 334.85,
      "duration_seconds": 2.4,
      "text": "What do you do for work?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 338.75,
      "end_seconds": 343.71,
      "duration_seconds": 4.96,
      "text": "I work in an office, mostly sitting at a desk."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 348.96,
      "end_seconds": 351.31,
      "duration_seconds": 2.35,
      "text": "Is anyone at home with you?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 352.94,
      "end_seconds": 356.9,
      "duration_seconds": 3.96,
      "text": "I share a flat with two friends"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 358.21,
      "end_seconds": 368.6,
      "duration_seconds": 10.39,
      "text": "Okay, thinking it through, I think we're dealing with migraine with aura at this stage. Tension-type headache is also on my list."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 369.3,
      "end_seconds": 372.57,
      "duration_seconds": 3.27,
      "text": "Okay, so do you think it's serious?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 373.52,
      "end_seconds": 388.57,
      "duration_seconds": 15.05,
      "text": "I understand the worry. At the moment I'd say it's migraine with aura, and we'll know more once the an MRI of the brain is back. I'll request an MRI of the brain, it'll help with recurrent headaches."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 390.07,
      "end_seconds": 391.1,
      "duration_seconds": 1.03,
      "text": "Okay, noted."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 393.19,
      "end_seconds": 423.8,
      "duration_seconds": 30.61,
      "text": "The treatment will be propranolol, 20 milligrams, twice a day, for three months. You take it by mouth. That should help with migraine prevention. The treatment will be domperidone, 10 milligrams, when nauseous, as needed. You take it by mouth. That's for migraine nausea. Try not to skip meals and keep your sleep regular. Keep a headache diary, things like skipped meals, poor sleep, certain foods and the weather."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 425.88,
      "end_seconds": 445.81,
      "duration_seconds": 19.93,
      "text": "and please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose please don't wait if you have the worst headache of your life or any weakness that's when to be seen urgently"
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 446.82,
      "end_seconds": 450.34,
      "duration_seconds": 3.52,
      "text": "yes, I'll keep that in mind"
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 452.23,
      "end_seconds": 461.86,
      "duration_seconds": 9.63,
      "text": "book a review in six weeks. Let me check I've been clear. What will you do once you get home?"
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 463.72,
      "end_seconds": 476.19,
      "duration_seconds": 12.47,
      "text": "So, I take the propranolol, 20 milligrams, twice a day and take the domperidone, 10 milligrams, when nauseous. Is that right?"
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 477.73,
      "end_seconds": 481.62,
      "duration_seconds": 3.89,
      "text": "Yes, exactly right. Do you have any questions?"
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 483.71,
      "end_seconds": 485.88,
      "duration_seconds": 2.17,
      "text": "okay, thank you bye"
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 487.55,
      "end_seconds": 488.41,
      "duration_seconds": 0.86,
      "text": "take care"
    }
  ]
}