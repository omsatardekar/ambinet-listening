{
  "schema_version": "1.0",
  "encounter_id": "00102",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.59,
      "end_seconds": 4.53,
      "duration_seconds": 3.94,
      "text": "Good afternoon. Have a seat and we'll begin."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 5.87,
      "end_seconds": 6.91,
      "duration_seconds": 1.04,
      "text": "Good afternoon."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 7.99,
      "end_seconds": 12.54,
      "duration_seconds": 4.55,
      "text": "Morning, doctor. I'll stay and fill in anything that's missed."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 14.04,
      "end_seconds": 19.23,
      "duration_seconds": 5.19,
      "text": "Good, that'll be useful. Pull up a chair. What brings you in today?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 20.8,
      "end_seconds": 30.38,
      "duration_seconds": 9.58,
      "text": "It's not being able to close my right eye fully, doctor. She didn't want to come, but I insisted."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_4",
      "role": "NURSE",
      "start_seconds": 31.17,
      "end_seconds": 44.52,
      "duration_seconds": 13.35,
      "text": "Here are the numbers, doctor. Height 168 centimetres, weight 58 kilos. BMI works out to 20.5, pulse is 86 beats a minute, saturation 98 percent, BP is 112 over 77."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 45.07,
      "end_seconds": 48.36,
      "duration_seconds": 3.29,
      "text": "Good, thank you. How intense does it get?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 48.91,
      "end_seconds": 52.0,
      "duration_seconds": 3.09,
      "text": "Oh, it feels mild to me."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 52.74,
      "end_seconds": 54.36,
      "duration_seconds": 1.62,
      "text": "Does anything settle it?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 54.9,
      "end_seconds": 57.38,
      "duration_seconds": 2.48,
      "text": "Eye drops helps a bit."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 58.29,
      "end_seconds": 61.56,
      "duration_seconds": 3.27,
      "text": "Does it come along with anything else?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 63.46,
      "end_seconds": 73.44,
      "duration_seconds": 9.98,
      "text": "It usually comes with pain behind the right ear. And my face drooping on the right side as well, since yesterday."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 74.94,
      "end_seconds": 77.53,
      "duration_seconds": 2.59,
      "text": "How much is it bothering you?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 78.38,
      "end_seconds": 86.96,
      "duration_seconds": 8.58,
      "text": "Moderate, I'd say. So, uh, the pain behind the right ear? That's been for four weeks."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 88.16,
      "end_seconds": 97.02,
      "duration_seconds": 8.86,
      "text": "Tell me a bit more about it: how bad it gets, how often, and whether anything makes it better or worse."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 98.56,
      "end_seconds": 102.78,
      "duration_seconds": 4.22,
      "text": "It sort of comes and goes. I'd say moderate."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 109.92,
      "end_seconds": 115.09,
      "duration_seconds": 5.17,
      "text": "A few quick ones: rash around the ear or hearing changes?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 115.96,
      "end_seconds": 121.02,
      "duration_seconds": 5.06,
      "text": "No, no rash around the ear or hearing changes."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 122.37,
      "end_seconds": 127.18,
      "duration_seconds": 4.81,
      "text": "A few quick ones: recent tick bite or slurred speech?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 130.59,
      "end_seconds": 133.6,
      "duration_seconds": 3.01,
      "text": "No, none of that at all."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 134.63,
      "end_seconds": 137.36,
      "duration_seconds": 2.73,
      "text": "Alright, is your digestion otherwise okay?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 139.03,
      "end_seconds": 141.44,
      "duration_seconds": 2.41,
      "text": "No, that side's been fine."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 144.74,
      "end_seconds": 147.53,
      "duration_seconds": 2.79,
      "text": "Any muscle or joint problems besides this?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 148.69,
      "end_seconds": 150.26,
      "duration_seconds": 1.57,
      "text": "No, nothing there."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 163.1,
      "end_seconds": 166.93,
      "duration_seconds": 3.83,
      "text": "Tell me what you take day to day."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 169.02,
      "end_seconds": 175.67,
      "duration_seconds": 6.65,
      "text": "I'm, I'm on something called glim... glimepiride, 2 milligrams, maybe, before breakfast."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 177.46,
      "end_seconds": 181.67,
      "duration_seconds": 4.21,
      "text": "Do you have the packet or the prescription with you?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 187.44,
      "end_seconds": 189.56,
      "duration_seconds": 2.12,
      "text": "No, it's at home."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 191.34,
      "end_seconds": 196.61,
      "duration_seconds": 5.27,
      "text": "Do you have any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 197.89,
      "end_seconds": 201.34,
      "duration_seconds": 3.45,
      "text": "I've had diabetes for five years now."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 201.86,
      "end_seconds": 203.33,
      "duration_seconds": 1.47,
      "text": "Okay, keep going."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 204.25,
      "end_seconds": 208.58,
      "duration_seconds": 4.33,
      "text": "I have high blood pressure, for five years."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 209.92,
      "end_seconds": 221.9,
      "duration_seconds": 11.98,
      "text": "Okay. Yes, diabetes and high blood pressure are known to us, good to have that clear. Have you ever reacted badly to a medicine or food? Any allergies?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 223.59,
      "end_seconds": 232.28,
      "duration_seconds": 8.69,
      "text": "I was told I'm allergic to shellfish, but I don't remember what reaction I had. Yes, peanuts."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 233.03,
      "end_seconds": 237.59,
      "duration_seconds": 4.56,
      "text": "Anyone in the family with similar problems or other conditions?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 242.3,
      "end_seconds": 249.48,
      "duration_seconds": 7.18,
      "text": "Uh, my mother had high blood pressure. My sister has thyroid problems."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 250.52,
      "end_seconds": 253.3,
      "duration_seconds": 2.78,
      "text": "Now some background about your lifestyle."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 254.23,
      "end_seconds": 267.18,
      "duration_seconds": 12.95,
      "text": "A beer or two most evenings, to be honest. Not really, I don't get much exercise. I drive a delivery van all day."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 268.52,
      "end_seconds": 271.42,
      "duration_seconds": 2.9,
      "text": "Let me have a look at you."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 276.87,
      "end_seconds": 277.96,
      "duration_seconds": 1.09,
      "text": "Mm, okay."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 279.55,
      "end_seconds": 281.67,
      "duration_seconds": 2.12,
      "text": "Hold that position for me."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 292.93,
      "end_seconds": 297.65,
      "duration_seconds": 4.72,
      "text": "You can't wrinkle the right forehead or puff out the right cheek."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 298.89,
      "end_seconds": 301.26,
      "duration_seconds": 2.37,
      "text": "Hold that position for me."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 315.54,
      "end_seconds": 322.12,
      "duration_seconds": 6.58,
      "text": "Left side of the face moves normally, and arm and leg strength is normal."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 323.56,
      "end_seconds": 324.26,
      "duration_seconds": 0.7,
      "text": "Fine."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 327.06,
      "end_seconds": 346.02,
      "duration_seconds": 18.96,
      "text": "Okay, you can sit up. Taking everything into account, this looks most like a Bell's palsy pattern. The reason I say that is that your story and my examination fit together. Another possibility is a viral nerve infection."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 347.61,
      "end_seconds": 350.88,
      "duration_seconds": 3.27,
      "text": "Should I be worried about this?"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 352.74,
      "end_seconds": 375.67,
      "duration_seconds": 22.93,
      "text": "I understand the worry. At the moment I'd say it's a Bell's palsy pattern, and we'll watch how it goes. Just to be sure I understood. You've had not being able to close your right eye fully, mild, and no rash around the ear or slurred speech."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 376.59,
      "end_seconds": 378.24,
      "duration_seconds": 1.65,
      "text": "Mm, that's right."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 379.32,
      "end_seconds": 392.31,
      "duration_seconds": 12.99,
      "text": "Use lubricating drops through the day and tape the eye shut at night. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 393.58,
      "end_seconds": 395.52,
      "duration_seconds": 1.94,
      "text": "Got it, thank you."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 396.53,
      "end_seconds": 398.22,
      "duration_seconds": 1.69,
      "text": "Thanks for coming in."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 400.04,
      "end_seconds": 403.03,
      "duration_seconds": 2.99,
      "text": "Hmm, okay, thank you. Bye."
    }
  ]
}