{
  "schema_version": "1.0",
  "encounter_id": "00159",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.94,
      "end_seconds": 8.67,
      "duration_seconds": 7.73,
      "text": "hi, doctor, I brought my bag, is it fine to leave it here?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 10.31,
      "end_seconds": 16.55,
      "duration_seconds": 6.24,
      "text": "Alright, of course, put it down anywhere. So, how can I help?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 18.34,
      "end_seconds": 22.6,
      "duration_seconds": 4.26,
      "text": "Good morning, doctor. I came along to help out."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 23.72,
      "end_seconds": 27.73,
      "duration_seconds": 4.01,
      "text": "Yes, that's no problem at all. Please sit."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 28.44,
      "end_seconds": 31.93,
      "duration_seconds": 3.49,
      "text": "It's a weak urine stream, mostly."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 36.7,
      "end_seconds": 39.49,
      "duration_seconds": 2.79,
      "text": "I'll take a a few measurements first."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 47.52,
      "end_seconds": 49.71,
      "duration_seconds": 2.19,
      "text": "okay, give me a moment.."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 71.26,
      "end_seconds": 87.89,
      "duration_seconds": 16.63,
      "text": "Okay: BMI works out to 26.0, oxygen saturation is 97 percent, weight 77 kilos, pulse 70, temperature 36.6, BP is 118 over 71, height 172 centimetres. Roughly when did it start?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 88.42,
      "end_seconds": 91.69,
      "duration_seconds": 3.27,
      "text": "It's been nearly five years now."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 92.28,
      "end_seconds": 96.01,
      "duration_seconds": 3.73,
      "text": "have you been having to rush to the toilet?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 96.91,
      "end_seconds": 99.1,
      "duration_seconds": 2.19,
      "text": "Yes, for four weeks."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 100.68,
      "end_seconds": 105.97,
      "duration_seconds": 5.29,
      "text": "what about a feeling that the bladder doesn't empty, have you noticed that?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 107.85,
      "end_seconds": 116.73,
      "duration_seconds": 8.88,
      "text": "yeah, that too as for feeling that the bladder doesn't empty, I'd give it a five, out of ten"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 129.63,
      "end_seconds": 134.05,
      "duration_seconds": 4.42,
      "text": "Any fever, burning when passing urine or weight loss?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 134.63,
      "end_seconds": 140.84,
      "duration_seconds": 6.21,
      "text": "No fever, burning when passing urine or weight loss, none of it."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 141.82,
      "end_seconds": 145.19,
      "duration_seconds": 3.37,
      "text": "And blood in the urine, any of that?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 147.07,
      "end_seconds": 150.27,
      "duration_seconds": 3.2,
      "text": "No, no blood in the urine."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 152.37,
      "end_seconds": 155.8,
      "duration_seconds": 3.43,
      "text": "Anything on the skin I should know about?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 157.63,
      "end_seconds": 159.76,
      "duration_seconds": 2.13,
      "text": "no, skin's been fine"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 160.74,
      "end_seconds": 162.7,
      "duration_seconds": 1.96,
      "text": "Is your digestion otherwise okay?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 164.47,
      "end_seconds": 165.99,
      "duration_seconds": 1.52,
      "text": "Nothing unusual, no."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 167.98,
      "end_seconds": 170.44,
      "duration_seconds": 2.46,
      "text": "What medicines do you take regularly?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 172.11,
      "end_seconds": 177.25,
      "duration_seconds": 5.14,
      "text": "Metformin, 500 milligrams, maybe, twice a day for my sugar."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 178.41,
      "end_seconds": 182.91,
      "duration_seconds": 4.5,
      "text": "Have you got the box or the prescription on you?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 183.68,
      "end_seconds": 185.61,
      "duration_seconds": 1.93,
      "text": "No, it's at home."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 202.14,
      "end_seconds": 207.31,
      "duration_seconds": 5.17,
      "text": "So, any relatives with health problems I should be aware of?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 209.39,
      "end_seconds": 211.6,
      "duration_seconds": 2.21,
      "text": "My sister has epilepsy."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 221.47,
      "end_seconds": 224.22,
      "duration_seconds": 2.75,
      "text": "Alright, are you living with family?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 224.72,
      "end_seconds": 228.52,
      "duration_seconds": 3.8,
      "text": "I stay with my daughter and her family."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 229.35,
      "end_seconds": 232.03,
      "duration_seconds": 2.68,
      "text": "what do you do for work?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 233.0,
      "end_seconds": 238.1,
      "duration_seconds": 5.1,
      "text": "I work in an office, mostly sitting at a desk."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 239.3,
      "end_seconds": 241.81,
      "duration_seconds": 2.51,
      "text": "And what do you usually eat?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 242.58,
      "end_seconds": 245.77,
      "duration_seconds": 3.19,
      "text": "Mostly home-cooked food, rice and vegetables."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 247.46,
      "end_seconds": 251.2,
      "duration_seconds": 3.74,
      "text": "any long-term health problems I should know about?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 253.22,
      "end_seconds": 254.24,
      "duration_seconds": 1.02,
      "text": "yes, diabetes"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 255.5,
      "end_seconds": 258.88,
      "duration_seconds": 3.38,
      "text": "I'll examine you now, bear with me."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 259.95,
      "end_seconds": 260.89,
      "duration_seconds": 0.94,
      "text": "no problem"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 261.78,
      "end_seconds": 264.14,
      "duration_seconds": 2.36,
      "text": "Take your time, no rush."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 271.81,
      "end_seconds": 275.31,
      "duration_seconds": 3.5,
      "text": "your bladder isn't palpable and the tummy is soft"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 276.92,
      "end_seconds": 278.56,
      "duration_seconds": 1.64,
      "text": "Let me press here."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 296.77,
      "end_seconds": 301.37,
      "duration_seconds": 4.6,
      "text": "on rectal examination the the prostate feels smooth and enlarged"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 306.38,
      "end_seconds": 320.63,
      "duration_seconds": 14.25,
      "text": "Okay, finished. Right, here's what I'm thinking. I think we're dealing with an enlarged prostate causing urinary symptoms at this stage. I want to be honest that this is an impression, not a final answer."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 322.18,
      "end_seconds": 326.12,
      "duration_seconds": 3.94,
      "text": "Is this something I'll have for good?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 327.65,
      "end_seconds": 349.45,
      "duration_seconds": 21.8,
      "text": "I understand the worry. At the moment I'd say it's an enlarged prostate causing urinary symptoms, and we'll watch how it goes. The urology clinic would be the right next step, I'll refer you. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 350.54,
      "end_seconds": 353.17,
      "duration_seconds": 2.63,
      "text": "Yes, I'll watch for that."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 353.81,
      "end_seconds": 359.12,
      "duration_seconds": 5.31,
      "text": "come back after the results are back do you have any questions?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 360.24,
      "end_seconds": 363.83,
      "duration_seconds": 3.59,
      "text": "That's everything I wanted to ask. Thank you."
    }
  ]
}