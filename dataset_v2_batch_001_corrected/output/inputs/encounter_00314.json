{
  "schema_version": "1.0",
  "encounter_id": "00314",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.37,
      "end_seconds": 5.35,
      "duration_seconds": 3.98,
      "text": "Sorry I'm a few minutes behind, doctor."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.33,
      "end_seconds": 11.25,
      "duration_seconds": 3.92,
      "text": "Not at all, please sit. What's the problem?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 14.23,
      "end_seconds": 20.92,
      "duration_seconds": 6.69,
      "text": "So, it's warmth in the toe. I thought I'd wait, but it hasn't gone."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 21.99,
      "end_seconds": 25.8,
      "duration_seconds": 3.81,
      "text": "Is this recent, or has it been a while?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 27.01,
      "end_seconds": 33.92,
      "duration_seconds": 6.91,
      "text": "I'd say about a week. Actually, no, closer to about two weeks."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 43.96,
      "end_seconds": 46.94,
      "duration_seconds": 2.98,
      "text": "Did you get rash or kidney problems?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 51.33,
      "end_seconds": 55.25,
      "duration_seconds": 3.92,
      "text": "No rash or kidney problems, none of it."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 55.79,
      "end_seconds": 59.04,
      "duration_seconds": 3.25,
      "text": "Mm. Any rashes or skin problems otherwise?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 59.81,
      "end_seconds": 62.66,
      "duration_seconds": 2.85,
      "text": "Yeah, no, skin's been fine."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 77.86,
      "end_seconds": 80.32,
      "duration_seconds": 2.46,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 81.29,
      "end_seconds": 83.93,
      "duration_seconds": 2.64,
      "text": "No, never had any surgery."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 92.33,
      "end_seconds": 96.96,
      "duration_seconds": 4.63,
      "text": "What about allergies, to medicines or foods or anything else?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 97.81,
      "end_seconds": 101.34,
      "duration_seconds": 3.53,
      "text": "Yes, codeine, it gives me vomiting."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 102.13,
      "end_seconds": 104.78,
      "duration_seconds": 2.65,
      "text": "Are you on any regular medication?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 106.24,
      "end_seconds": 109.57,
      "duration_seconds": 3.33,
      "text": "No, I don't take anything regularly."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 111.11,
      "end_seconds": 112.31,
      "duration_seconds": 1.2,
      "text": "What about alcohol?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 113.21,
      "end_seconds": 116.85,
      "duration_seconds": 3.64,
      "text": "I gave up drinking about three years ago."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 118.77,
      "end_seconds": 120.06,
      "duration_seconds": 1.29,
      "text": "Right, any smoking?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 122.07,
      "end_seconds": 125.53,
      "duration_seconds": 3.46,
      "text": "I smoke, yes, around five a day."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 126.88,
      "end_seconds": 128.18,
      "duration_seconds": 1.3,
      "text": "What's your job?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 129.77,
      "end_seconds": 132.64,
      "duration_seconds": 2.87,
      "text": "I teach at a primary school."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 137.03,
      "end_seconds": 139.39,
      "duration_seconds": 2.36,
      "text": "And what do you usually eat?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 140.19,
      "end_seconds": 143.39,
      "duration_seconds": 3.2,
      "text": "Mostly home-cooked food, rice and vegetables."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 144.67,
      "end_seconds": 147.19,
      "duration_seconds": 2.52,
      "text": "Okay, who do you live with?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 148.99,
      "end_seconds": 154.23,
      "duration_seconds": 5.24,
      "text": "I live with my family, my husband and two kids."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 154.92,
      "end_seconds": 158.96,
      "duration_seconds": 4.04,
      "text": "Do you have any medical conditions I should know about?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 160.3,
      "end_seconds": 163.61,
      "duration_seconds": 3.31,
      "text": "No, I've never had anything serious."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 165.1,
      "end_seconds": 167.01,
      "duration_seconds": 1.91,
      "text": "Let's do your observations."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 180.11,
      "end_seconds": 180.89,
      "duration_seconds": 0.78,
      "text": "One second..."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 192.22,
      "end_seconds": 200.28,
      "duration_seconds": 8.06,
      "text": "Okay: pulse 84, BP is 116 over 74, temperature is 36.7 degrees, SpO2 99 percent on room air."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 201.87,
      "end_seconds": 204.06,
      "duration_seconds": 2.19,
      "text": "Okay, a quick examination now."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 205.69,
      "end_seconds": 206.87,
      "duration_seconds": 1.18,
      "text": "Mm, okay."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 208.02,
      "end_seconds": 209.29,
      "duration_seconds": 1.27,
      "text": "I'll go gently."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 221.2,
      "end_seconds": 226.91,
      "duration_seconds": 5.71,
      "text": "The big toe joint is red, hot, swollen and extremely tender to touch."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 230.27,
      "end_seconds": 231.19,
      "duration_seconds": 0.92,
      "text": "Okay, finished."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 247.69,
      "end_seconds": 257.69,
      "duration_seconds": 10.0,
      "text": "So, based on the history and the examination, I can't pin this down yet. We're looking at an acute gout flare or pseudogout."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 259.72,
      "end_seconds": 261.98,
      "duration_seconds": 2.26,
      "text": "Do you think it's serious?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 263.87,
      "end_seconds": 277.55,
      "duration_seconds": 13.68,
      "text": "I can't promise yet, but most people with an acute gout flare do well once it's treated properly. Let's book a uric acid level to look into suspected gout."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 282.05,
      "end_seconds": 284.78,
      "duration_seconds": 2.73,
      "text": "Alright, when would that be?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 285.66,
      "end_seconds": 316.77,
      "duration_seconds": 31.11,
      "text": "We'll begin with naproxen, 500 milligrams, twice a day after food, for five days. That should help with gout flare. Cut right back on red meat, organ meats, beer and sugary drinks, and drink plenty of water. Please don't wait if the joint gets hotter or you develop a fever. That's when to be seen urgently. Let's review you in two weeks."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 318.26,
      "end_seconds": 322.36,
      "duration_seconds": 4.1,
      "text": "I'll make the appointment on my way out."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 323.7,
      "end_seconds": 326.47,
      "duration_seconds": 2.77,
      "text": "Ask me anything before you go."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 327.55,
      "end_seconds": 331.02,
      "duration_seconds": 3.47,
      "text": "No, you've explained it well. Thanks."
    }
  ]
}