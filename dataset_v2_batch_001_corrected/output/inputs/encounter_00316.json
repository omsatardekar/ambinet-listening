{
  "schema_version": "1.0",
  "encounter_id": "00316",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.35,
      "end_seconds": 5.78,
      "duration_seconds": 4.43,
      "text": "Hi there, come on in. What's been bothering you?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 7.74,
      "end_seconds": 20.61,
      "duration_seconds": 12.87,
      "text": "Yeah, it's itchy raised red welts. I don't know what's causing it. I told myself I'd wait and see, and here I am."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 21.93,
      "end_seconds": 24.16,
      "duration_seconds": 2.23,
      "text": "And when did that start?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 25.02,
      "end_seconds": 28.52,
      "duration_seconds": 3.5,
      "text": "It's been one week, I'm fairly sure."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 28.98,
      "end_seconds": 29.79,
      "duration_seconds": 0.81,
      "text": "And then?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 30.68,
      "end_seconds": 33.83,
      "duration_seconds": 3.15,
      "text": "Anything you do that brings it on?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 34.4,
      "end_seconds": 37.83,
      "duration_seconds": 3.43,
      "text": "Oh, yes, heat. That makes it worse."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 43.52,
      "end_seconds": 47.32,
      "duration_seconds": 3.8,
      "text": "Does it happen all the time or in spells?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 48.54,
      "end_seconds": 50.46,
      "duration_seconds": 1.92,
      "text": "Honestly, all the time."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 51.45,
      "end_seconds": 53.62,
      "duration_seconds": 2.17,
      "text": "And how severe is it?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 55.57,
      "end_seconds": 58.62,
      "duration_seconds": 3.05,
      "text": "About a five out of ten."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 60.71,
      "end_seconds": 64.56,
      "duration_seconds": 3.85,
      "text": "Anything that tends to go along with it?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 66.16,
      "end_seconds": 75.47,
      "duration_seconds": 9.31,
      "text": "When it starts I tend to get itching all over as well. Oh, about itching all over, I'd say severe."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 83.45,
      "end_seconds": 89.12,
      "duration_seconds": 5.67,
      "text": "Tell me about your routine, work, habits, that sort of thing."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 92.56,
      "end_seconds": 100.49,
      "duration_seconds": 7.93,
      "text": "Yes, I live on my own. Barely, I'm mostly sedentary these days. I skip breakfast most days."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 102.23,
      "end_seconds": 103.55,
      "duration_seconds": 1.32,
      "text": "Any regular medication?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 105.61,
      "end_seconds": 108.43,
      "duration_seconds": 2.82,
      "text": "No, I don't take anything regularly."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 110.25,
      "end_seconds": 114.01,
      "duration_seconds": 3.76,
      "text": "Any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 115.48,
      "end_seconds": 118.64,
      "duration_seconds": 3.16,
      "text": "No, none that I know of."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 128.96,
      "end_seconds": 133.2,
      "duration_seconds": 4.24,
      "text": "What about allergies, to medicines or foods or anything else?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 135.09,
      "end_seconds": 138.41,
      "duration_seconds": 3.32,
      "text": "None, as far as I'm aware."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 146.69,
      "end_seconds": 150.37,
      "duration_seconds": 3.68,
      "text": "A few quick ones: wheezing, fever or trouble breathing?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 151.87,
      "end_seconds": 155.7,
      "duration_seconds": 3.83,
      "text": "Uh, no, I'd have mentioned it."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 157.35,
      "end_seconds": 160.3,
      "duration_seconds": 2.95,
      "text": "Has your heart given you any trouble?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 161.67,
      "end_seconds": 163.32,
      "duration_seconds": 1.65,
      "text": "Nothing like that."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 163.94,
      "end_seconds": 166.75,
      "duration_seconds": 2.81,
      "text": "Can I take your vitals now?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 179.42,
      "end_seconds": 180.36,
      "duration_seconds": 0.94,
      "text": "Almost there..."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 194.94,
      "end_seconds": 202.91,
      "duration_seconds": 7.97,
      "text": "Okay: blood pressure 113 over 70, pulse is 80 beats a minute, SpO2 98 percent on room air."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 205.87,
      "end_seconds": 208.96,
      "duration_seconds": 3.09,
      "text": "I'll examine you now, bear with me."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 209.96,
      "end_seconds": 210.66,
      "duration_seconds": 0.7,
      "text": "Alright."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 212.57,
      "end_seconds": 214.54,
      "duration_seconds": 1.97,
      "text": "Hold that position for me."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 222.06,
      "end_seconds": 227.36,
      "duration_seconds": 5.3,
      "text": "There are raised pink welts on the chest and back, some joined together."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 229.35,
      "end_seconds": 231.45,
      "duration_seconds": 2.1,
      "text": "Hold that position for me."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 243.44,
      "end_seconds": 248.98,
      "duration_seconds": 5.54,
      "text": "Lips look a little puffy, but the tongue and throat are normal."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 250.09,
      "end_seconds": 250.79,
      "duration_seconds": 0.7,
      "text": "Fine."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 253.63,
      "end_seconds": 268.07,
      "duration_seconds": 14.44,
      "text": "Thanks for that. Right, here's what I'm thinking. It fits best with acute urticaria, possibly allergic. I want to be honest that this is an impression, not a final answer."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 278.13,
      "end_seconds": 312.31,
      "duration_seconds": 34.18,
      "text": "I think an allergy test makes sense here, for recurrent urticaria. You'll be taking prednisolone, 20 milligrams, once a day, for three days. You take it by mouth. That's for hives. Write down anything new you ate, took or used before this started, even small things. Keep an eye out, and if your lips or tongue swell more, or you have trouble breathing, call us the same day or go to emergency. Any last questions?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 313.35,
      "end_seconds": 315.24,
      "duration_seconds": 1.89,
      "text": "No questions. Thank you."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 320.01,
      "end_seconds": 320.86,
      "duration_seconds": 0.85,
      "text": "Take care."
    }
  ]
}