{
  "schema_version": "1.0",
  "encounter_id": "00136",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 1.01,
      "end_seconds": 5.07,
      "duration_seconds": 4.06,
      "text": "Ready for you, doctor. I'll stay in case you need anything."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.56,
      "end_seconds": 11.64,
      "duration_seconds": 5.08,
      "text": "great. Hello, come in and sit down. How can I help?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 13.05,
      "end_seconds": 17.68,
      "duration_seconds": 4.63,
      "text": "Good morning, doctor. I came along to help out."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 19.62,
      "end_seconds": 23.13,
      "duration_seconds": 3.51,
      "text": "absolutely, come and and sit beside them"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 25.21,
      "end_seconds": 42.51,
      "duration_seconds": 17.3,
      "text": "mainly my heart racing there's a couple of other things, but that's the main one sorry, I know I'm rambling a bit i just want to get back to normal, really"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 44.27,
      "end_seconds": 47.34,
      "duration_seconds": 3.07,
      "text": "are you on any tablets or medication?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 48.72,
      "end_seconds": 52.58,
      "duration_seconds": 3.86,
      "text": "It's alendronate, 70 milligrams, once a week, doctor."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 53.74,
      "end_seconds": 56.57,
      "duration_seconds": 2.83,
      "text": "How long have you been on it?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 58.21,
      "end_seconds": 68.07,
      "duration_seconds": 9.86,
      "text": "for six months she takes sumatriptan, 50 milligrams, when needed she takes aspirin, 75 milligrams, once a day"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 72.54,
      "end_seconds": 75.37,
      "duration_seconds": 2.83,
      "text": "How long have you taken that?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 75.91,
      "end_seconds": 77.26,
      "duration_seconds": 1.35,
      "text": "Two years now."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 78.2,
      "end_seconds": 80.57,
      "duration_seconds": 2.37,
      "text": "how far back does it go?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 81.39,
      "end_seconds": 84.64,
      "duration_seconds": 3.25,
      "text": "About a week, give or take."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 86.23,
      "end_seconds": 89.78,
      "duration_seconds": 3.55,
      "text": "I think it's been nearer two weeks, actually."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 91.11,
      "end_seconds": 95.38,
      "duration_seconds": 4.27,
      "text": "Okay, so roughly one to two weeks. Is that right?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 96.37,
      "end_seconds": 102.8,
      "duration_seconds": 6.43,
      "text": "That sounds about right. And I've been feeling anxious and jittery as well."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 104.08,
      "end_seconds": 108.5,
      "duration_seconds": 4.42,
      "text": "Okay, have you been losing weight even though you're eating well?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 110.16,
      "end_seconds": 121.93,
      "duration_seconds": 11.77,
      "text": "yes, for four weeks i've been feeling hot and sweaty too, for ten days as for feeling hot and sweaty, it's every other day"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 123.75,
      "end_seconds": 129.84,
      "duration_seconds": 6.09,
      "text": "Have you had your heart racing before, or is this the the first time?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 131.38,
      "end_seconds": 137.88,
      "duration_seconds": 6.5,
      "text": "Yes, something like this happened last winter, and it went away on its own."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 139.72,
      "end_seconds": 143.58,
      "duration_seconds": 3.86,
      "text": "and what about trouble sleeping, diarrhoea or chest pain?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 148.36,
      "end_seconds": 150.9,
      "duration_seconds": 2.54,
      "text": "No, I'd have mentioned it."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 152.68,
      "end_seconds": 156.58,
      "duration_seconds": 3.9,
      "text": "a few quick ones: shortness of breath or eye bulging?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 158.39,
      "end_seconds": 161.13,
      "duration_seconds": 2.74,
      "text": "No, I'd have mentioned it."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 167.05,
      "end_seconds": 170.84,
      "duration_seconds": 3.79,
      "text": "Anything with your nerves, like weakness or numbness?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 174.53,
      "end_seconds": 176.74,
      "duration_seconds": 2.21,
      "text": "No, that's all normal."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 178.13,
      "end_seconds": 182.42,
      "duration_seconds": 4.29,
      "text": "Anything on the the skin I should know about?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 183.12,
      "end_seconds": 185.12,
      "duration_seconds": 2.0,
      "text": "No, skin's been fine."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 187.07,
      "end_seconds": 192.02,
      "duration_seconds": 4.95,
      "text": "What about your general health, any conditions you're being treated for?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 193.94,
      "end_seconds": 195.8,
      "duration_seconds": 1.86,
      "text": "I have thin bones."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 197.47,
      "end_seconds": 198.17,
      "duration_seconds": 0.7,
      "text": "Mhm."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 199.15,
      "end_seconds": 209.53,
      "duration_seconds": 10.38,
      "text": "I have migraines, for about ten years. I've never really been one for hospitals. I'm hoping you can tell me something definite."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 210.07,
      "end_seconds": 211.14,
      "duration_seconds": 1.07,
      "text": "Okay, so."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 215.59,
      "end_seconds": 217.45,
      "duration_seconds": 1.86,
      "text": "I've got heart disease."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 218.9,
      "end_seconds": 220.94,
      "duration_seconds": 2.04,
      "text": "do you exercise at all?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 224.74,
      "end_seconds": 229.7,
      "duration_seconds": 4.96,
      "text": "I go to the gym a couple of times a week."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 231.22,
      "end_seconds": 233.82,
      "duration_seconds": 2.6,
      "text": "And what do you usually eat?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 235.13,
      "end_seconds": 238.04,
      "duration_seconds": 2.91,
      "text": "Mostly home-cooked food, rice and vegetables"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 239.07,
      "end_seconds": 241.5,
      "duration_seconds": 2.43,
      "text": "Who do you live with?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 242.46,
      "end_seconds": 248.14,
      "duration_seconds": 5.68,
      "text": "I live with my family, my husband and two kids"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 264.84,
      "end_seconds": 267.01,
      "duration_seconds": 2.17,
      "text": "Any drug or food allergies?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 271.19,
      "end_seconds": 283.26,
      "duration_seconds": 12.07,
      "text": "Hmm, there was some antibiotic, I was told I was allergic. But I couldn't tell you what it was called or what it did."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 285.25,
      "end_seconds": 288.95,
      "duration_seconds": 3.7,
      "text": "Do your parents or siblings have any long-term illnesses?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 293.39,
      "end_seconds": 297.64,
      "duration_seconds": 4.25,
      "text": "My sister has epilepsy. My mother has migraines."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 299.37,
      "end_seconds": 301.51,
      "duration_seconds": 2.14,
      "text": "so, any procedures or operations?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 303.08,
      "end_seconds": 313.85,
      "duration_seconds": 10.77,
      "text": "Just a stent put in my heart, two years ago. I didn't want to make a fuss, you know."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 325.71,
      "end_seconds": 344.29,
      "duration_seconds": 18.58,
      "text": "Doctor, I've got the readings for you. SpO2 99 percent on room air, height 156 centimetres, BMI works out to to 30.0. Heart rate 124, respiratory rate 19, weight 73 kilos, temp 36.7 degrees, pressure 132 over 77."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 345.5,
      "end_seconds": 346.53,
      "duration_seconds": 1.03,
      "text": "Okay, noted."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 347.95,
      "end_seconds": 351.74,
      "duration_seconds": 3.79,
      "text": "Okay, I need to examine you for this."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 353.55,
      "end_seconds": 355.95,
      "duration_seconds": 2.4,
      "text": "Just relax, I'll be quick."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 366.84,
      "end_seconds": 370.19,
      "duration_seconds": 3.35,
      "text": "your thyroid feels a little enlarged and smooth"
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 371.09,
      "end_seconds": 373.44,
      "duration_seconds": 2.35,
      "text": "just relax, I'll be quick"
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 388.64,
      "end_seconds": 394.93,
      "duration_seconds": 6.29,
      "text": "there's a fine tremor in the outstretched hands, and your palms are warm and moist"
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 396.72,
      "end_seconds": 397.42,
      "duration_seconds": 0.7,
      "text": "Alright."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 400.33,
      "end_seconds": 417.16,
      "duration_seconds": 16.83,
      "text": "Thanks, please take a seat again. From what you've told me and what I found, I think we're dealing with an overactive thyroid at this stage. I can't rule out a heart rhythm problem yet."
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 425.01,
      "end_seconds": 430.92,
      "duration_seconds": 5.91,
      "text": "Doctor, I did an ECG before they came in, the result's on your screen."
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 431.6,
      "end_seconds": 441.51,
      "duration_seconds": 9.91,
      "text": "Thanks, I'll look at that. I want a thyroid scan done, that's for hyperthyroidism. Let's book a thyroid test to look into hyperthyroid symptoms."
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 445.8,
      "end_seconds": 448.9,
      "duration_seconds": 3.1,
      "text": "Where do I go for that?"
    },
    {
      "segment_id": "SEG0059",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 449.96,
      "end_seconds": 468.35,
      "duration_seconds": 18.39,
      "text": "The treatment will be propranolol, 20 milligrams, twice a day, until we review. You take it by mouth. That should help with palpitations and tremor. Limit tea, coffee and anything that speeds up the heart for now. Do you have any questions?"
    },
    {
      "segment_id": "SEG0060",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 469.78,
      "end_seconds": 471.92,
      "duration_seconds": 2.14,
      "text": "no questions. Thank you"
    }
  ]
}