  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.57,
      "end_seconds": 4.49,
      "duration_seconds": 3.92,
      "text": "Good morning. I hope the wait wasn't too long."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 5.34,
      "end_seconds": 6.04,
      "duration_seconds": 0.7,
      "text": "Hello."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 6.98,
      "end_seconds": 9.37,
      "duration_seconds": 2.39,
      "text": "How can I help you today?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 11.13,
      "end_seconds": 17.4,
      "duration_seconds": 6.27,
      "text": "It's burning in both feet. I thought I'd wait, but it hasn't gone."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 18.9,
      "end_seconds": 22.96,
      "duration_seconds": 4.06,
      "text": "Is this recent, or has it been a while?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 25.03,
      "end_seconds": 31.61,
      "duration_seconds": 6.58,
      "text": "Two years, I think... sorry, about a year, I got that wrong."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 33.33,
      "end_seconds": 45.74,
      "duration_seconds": 12.41,
      "text": "Can you describe it a bit more for me? How strong it is, what the pattern is, what helps. Take your time, there's no rush."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 47.28,
      "end_seconds": 55.86,
      "duration_seconds": 8.58,
      "text": "It's worse with bedsheets touching them. A seven out of ten, I suppose. Walking around helps a bit."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 56.55,
      "end_seconds": 59.31,
      "duration_seconds": 2.76,
      "text": "Any numbness in the toes as well?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 60.0,
      "end_seconds": 61.53,
      "duration_seconds": 1.53,
      "text": "Yes, I have."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 77.05,
      "end_seconds": 81.36,
      "duration_seconds": 4.31,
      "text": "Do you have any medical conditions I should know about?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 82.01,
      "end_seconds": 85.03,
      "duration_seconds": 3.02,
      "text": "No, none that I know of."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 92.1,
      "end_seconds": 93.36,
      "duration_seconds": 1.26,
      "text": "Any regular medication?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 94.07,
      "end_seconds": 95.21,
      "duration_seconds": 1.14,
      "text": "Nothing, no."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 108.9,
      "end_seconds": 110.13,
      "duration_seconds": 1.23,
      "text": "And your work?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 111.77,
      "end_seconds": 115.14,
      "duration_seconds": 3.37,
      "text": "I drive a delivery van all day."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 116.6,
      "end_seconds": 119.81,
      "duration_seconds": 3.21,
      "text": "Alright, and what do you usually eat?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 121.16,
      "end_seconds": 124.12,
      "duration_seconds": 2.96,
      "text": "Mostly home-cooked food, rice and vegetables."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 125.8,
      "end_seconds": 128.06,
      "duration_seconds": 2.26,
      "text": "Do you get any exercise?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 130.03,
      "end_seconds": 134.8,
      "duration_seconds": 4.77,
      "text": "I walk for about half an hour most days."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 135.36,
      "end_seconds": 139.89,
      "duration_seconds": 4.53,
      "text": "What about family history, any illnesses that run in the family?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 141.12,
      "end_seconds": 143.86,
      "duration_seconds": 2.74,
      "text": "My uncle had colon cancer."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 145.08,
      "end_seconds": 148.3,
      "duration_seconds": 3.22,
      "text": "Have you ever been under the knife?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 149.98,
      "end_seconds": 155.0,
      "duration_seconds": 5.02,
      "text": "Yes, I had my appendix out, about eight years ago."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 173.38,
      "end_seconds": 177.16,
      "duration_seconds": 3.78,
      "text": "Have you had back pain, by any chance?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 179.21,
      "end_seconds": 181.43,
      "duration_seconds": 2.22,
      "text": "No. No back pain."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 182.23,
      "end_seconds": 186.07,
      "duration_seconds": 3.84,
      "text": "A few quick ones: bladder problems or foot ulcers?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 187.91,
      "end_seconds": 189.58,
      "duration_seconds": 1.67,
      "text": "No, nothing there."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 190.93,
      "end_seconds": 195.79,
      "duration_seconds": 4.86,
      "text": "Any change in your bowel habit or your stomach generally?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 197.87,
      "end_seconds": 200.68,
      "duration_seconds": 2.81,
      "text": "Bowels are regular, nothing odd."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 202.65,
      "end_seconds": 204.46,
      "duration_seconds": 1.81,
      "text": "Let's do your observations."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 217.66,
      "end_seconds": 219.57,
      "duration_seconds": 1.91,
      "text": "Just relax your arm..."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 231.03,
      "end_seconds": 236.48,
      "duration_seconds": 5.45,
      "text": "Okay: temp 36.7 degrees, pulse 72, blood pressure 114 over 79."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 237.64,
      "end_seconds": 239.66,
      "duration_seconds": 2.02,
      "text": "Is that alright, doctor?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 241.05,
      "end_seconds": 243.95,
      "duration_seconds": 2.9,
      "text": "That's fine, we'll come to it."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 245.92,
      "end_seconds": 248.78,
      "duration_seconds": 2.86,
      "text": "I'd like to examine you now."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 250.6,
      "end_seconds": 252.71,
      "duration_seconds": 2.11,
      "text": "Take your time, no rush."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 270.15,
      "end_seconds": 274.46,
      "duration_seconds": 4.31,
      "text": "Feeling of light touch is reduced in both feet."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 279.45,
      "end_seconds": 287.2,
      "duration_seconds": 7.75,
      "text": "That's fine, sit up. Okay, so my impression is this: It points towards peripheral neuropathy, possibly related to sugar."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 288.9,
      "end_seconds": 292.13,
      "duration_seconds": 3.23,
      "text": "Right, do you think it's serious?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 293.91,
      "end_seconds": 310.39,
      "duration_seconds": 16.48,
      "text": "It's reasonable to be concerned, but right now peripheral neuropathy, possibly related to sugar is my leading thought, not anything worse. I'm going to order a vitamin B12 level, for neuropathy. Okay, I think we're finished. Is everything clear?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 312.03,
      "end_seconds": 315.71,
      "duration_seconds": 3.68,
      "text": "That's everything I wanted to ask. Thank you."
    }
  ]
}