{
  "schema_version": "1.0",
  "encounter_id": "00435",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.74,
      "end_seconds": 5.38,
      "duration_seconds": 4.64,
      "text": "Hi, doctor. Long queue outside, but here I am."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.14,
      "end_seconds": 10.64,
      "duration_seconds": 4.5,
      "text": "No trouble at all, come in. What's been bothering you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 12.04,
      "end_seconds": 18.1,
      "duration_seconds": 6.06,
      "text": "Hello, doctor. I hope it's alright if I stay in for this."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 23.14,
      "end_seconds": 26.52,
      "duration_seconds": 3.38,
      "text": "Yes, that's no problem at all. Please sit."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 31.34,
      "end_seconds": 38.37,
      "duration_seconds": 7.03,
      "text": "Yeah, it's pain in my right shoulder. I don't know what's causing it."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 39.02,
      "end_seconds": 43.5,
      "duration_seconds": 4.48,
      "text": "Is this recent, or has it been a while?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 44.0,
      "end_seconds": 47.41,
      "duration_seconds": 3.41,
      "text": "It's been going on for three days."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 49.48,
      "end_seconds": 52.11,
      "duration_seconds": 2.63,
      "text": "How much is it bothering you?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 53.06,
      "end_seconds": 57.88,
      "duration_seconds": 4.82,
      "text": "Maybe a four out of ten on a bad day."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 58.94,
      "end_seconds": 65.31,
      "duration_seconds": 6.37,
      "text": "So, what about a dull ache down the arm, have you noticed that?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 66.36,
      "end_seconds": 67.58,
      "duration_seconds": 1.22,
      "text": "Mm, yes."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 72.0,
      "end_seconds": 75.69,
      "duration_seconds": 3.69,
      "text": "Okay, is it mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 77.19,
      "end_seconds": 80.57,
      "duration_seconds": 3.38,
      "text": "About a three out of ten."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 81.62,
      "end_seconds": 86.6,
      "duration_seconds": 4.98,
      "text": "What about trouble lifting your arm, have you noticed that?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 88.37,
      "end_seconds": 92.42,
      "duration_seconds": 4.05,
      "text": "Yeah, I've had that since last night."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 94.08,
      "end_seconds": 98.26,
      "duration_seconds": 4.18,
      "text": "Right, has there been a click in the shoulder too?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 99.63,
      "end_seconds": 102.72,
      "duration_seconds": 3.09,
      "text": "Yeah. About three months, I'd say."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 120.79,
      "end_seconds": 122.95,
      "duration_seconds": 2.16,
      "text": "Alright, do you drink alcohol?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 123.69,
      "end_seconds": 127.78,
      "duration_seconds": 4.09,
      "text": "I gave up drinking about three years ago."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 128.49,
      "end_seconds": 129.45,
      "duration_seconds": 0.96,
      "text": "Any smoking?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 130.62,
      "end_seconds": 134.72,
      "duration_seconds": 4.1,
      "text": "I smoke, yes, around five a day."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 135.27,
      "end_seconds": 136.87,
      "duration_seconds": 1.6,
      "text": "Any sport or activity?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 138.77,
      "end_seconds": 141.34,
      "duration_seconds": 2.57,
      "text": "I play badminton on Sundays."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 142.59,
      "end_seconds": 143.87,
      "duration_seconds": 1.28,
      "text": "What's your job?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 145.51,
      "end_seconds": 148.91,
      "duration_seconds": 3.4,
      "text": "I teach at a primary school."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 149.43,
      "end_seconds": 150.66,
      "duration_seconds": 1.23,
      "text": "How's your diet?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 151.19,
      "end_seconds": 152.79,
      "duration_seconds": 1.6,
      "text": "I'm mostly vegetarian."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 153.53,
      "end_seconds": 158.66,
      "duration_seconds": 5.13,
      "text": "What about your general health, any conditions you're being treated for?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 160.18,
      "end_seconds": 165.43,
      "duration_seconds": 5.25,
      "text": "I have diabetes, for five years. I have high blood pressure."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 167.3,
      "end_seconds": 168.68,
      "duration_seconds": 1.38,
      "text": "Right, any more?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 170.36,
      "end_seconds": 171.88,
      "duration_seconds": 1.52,
      "text": "Yes, acid reflux."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 173.47,
      "end_seconds": 183.89,
      "duration_seconds": 10.42,
      "text": "Uh-huh. Okay, I can see diabetes and acid reflux in your file as well. What medicines are you taking at the moment?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 185.22,
      "end_seconds": 203.08,
      "duration_seconds": 17.86,
      "text": "I'm, I'm on glimepiride, 2 milligrams, before breakfast for my sugar. Amlodipine, 5 milligrams, once a day for my pressure. I take pantoprazole, 40 milligrams, before breakfast. Volini gel. I take it twice a day."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 209.0,
      "end_seconds": 210.25,
      "duration_seconds": 1.25,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 211.45,
      "end_seconds": 212.98,
      "duration_seconds": 1.53,
      "text": "No operations, no."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 219.22,
      "end_seconds": 221.24,
      "duration_seconds": 2.02,
      "text": "Any drug or food allergies?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 222.74,
      "end_seconds": 231.67,
      "duration_seconds": 8.93,
      "text": "I think I reacted to some antibiotic once, years ago. I don't remember which one, or what happened exactly."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 250.62,
      "end_seconds": 255.65,
      "duration_seconds": 5.03,
      "text": "Did you get numbness in the hand, fever or fall?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 257.59,
      "end_seconds": 259.12,
      "duration_seconds": 1.53,
      "text": "No, nothing there."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 259.94,
      "end_seconds": 263.3,
      "duration_seconds": 3.36,
      "text": "Anything with your nerves, like weakness or numbness?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 264.1,
      "end_seconds": 265.58,
      "duration_seconds": 1.48,
      "text": "Nothing odd there."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_4",
      "role": "NURSE",
      "start_seconds": 277.39,
      "end_seconds": 287.35,
      "duration_seconds": 9.96,
      "text": "Okay, so the vitals from earlier. BP is 109 over 74, respiratory rate 16, heart rate 82, temperature is 36.6 degrees."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 288.76,
      "end_seconds": 289.46,
      "duration_seconds": 0.7,
      "text": "Thanks."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 291.54,
      "end_seconds": 295.52,
      "duration_seconds": 3.98,
      "text": "Okay, I need to examine you for this."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 297.17,
      "end_seconds": 299.68,
      "duration_seconds": 2.51,
      "text": "Let me look at this properly."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 307.71,
      "end_seconds": 311.06,
      "duration_seconds": 3.35,
      "text": "Neck movements are full and don't reproduce it."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 313.0,
      "end_seconds": 314.96,
      "duration_seconds": 1.96,
      "text": "Let me press here."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 328.03,
      "end_seconds": 335.28,
      "duration_seconds": 7.25,
      "text": "Lifting the arm to the side is painful between sixty and a hundred twenty degrees."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 338.22,
      "end_seconds": 358.17,
      "duration_seconds": 19.95,
      "text": "That's fine, sit up. Let me tell you where I've got to. I think we're dealing with a rotator cuff problem at this stage. That's my thinking for now, and it may change as we learn more. We shouldn't forget frozen shoulder."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 359.96,
      "end_seconds": 362.42,
      "duration_seconds": 2.46,
      "text": "Do you think it's serious?"
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 368.46,
      "end_seconds": 388.21,
      "duration_seconds": 19.75,
      "text": "I understand the worry. At the moment I'd say it's a rotator cuff problem, and we'll watch how it goes. Stop me if I've got anything wrong. You've had pain in your right shoulder for three days, and no fever or numbness in the hand."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 389.54,
      "end_seconds": 391.36,
      "duration_seconds": 1.82,
      "text": "Mm, that's right."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 392.37,
      "end_seconds": 400.27,
      "duration_seconds": 7.9,
      "text": "There's nothing new for me to start or arrange today. Is there anything you wanted to ask?"
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 401.12,
      "end_seconds": 404.61,
      "duration_seconds": 3.49,
      "text": "One thing: no, actually that's all. Thanks."
    }
  ]
}