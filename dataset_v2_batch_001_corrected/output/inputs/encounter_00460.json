{
  "schema_version": "1.0",
  "encounter_id": "00460",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.09,
      "end_seconds": 5.14,
      "duration_seconds": 4.05,
      "text": "Hello, doctor. It's my turn, I think."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.19,
      "end_seconds": 12.4,
      "duration_seconds": 5.21,
      "text": "Alright, that's alright, take a seat. Tell me why you've come."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 14.16,
      "end_seconds": 17.94,
      "duration_seconds": 3.78,
      "text": "I've been dealing with a bad cough."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 18.7,
      "end_seconds": 23.24,
      "duration_seconds": 4.54,
      "text": "Okay, give me more detail on it, whatever comes to mind."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 23.98,
      "end_seconds": 37.63,
      "duration_seconds": 13.65,
      "text": "Lying down and cold air definitely sets it off. I'd say every other day. It settles a little with honey and warm water. I've also been coughing up yellow phlegm."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 38.82,
      "end_seconds": 41.56,
      "duration_seconds": 2.74,
      "text": "How much is it bothering you?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 43.53,
      "end_seconds": 46.94,
      "duration_seconds": 3.41,
      "text": "Pretty severe, if I'm being honest."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 48.26,
      "end_seconds": 50.91,
      "duration_seconds": 2.65,
      "text": "Now some background about your lifestyle."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 52.38,
      "end_seconds": 68.03,
      "duration_seconds": 15.65,
      "text": "I smoke about ten cigarettes a day. I don't drink at all. I share a flat with two friends. I walk for about half an hour most days."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 69.61,
      "end_seconds": 72.97,
      "duration_seconds": 3.36,
      "text": "Right, what medicines do you take regularly?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 73.64,
      "end_seconds": 85.31,
      "duration_seconds": 11.67,
      "text": "Seretide inhaler. I take it twice a day. Cough syrup. I take it at night. I was on amlodipine before. I stopped taking it."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 87.34,
      "end_seconds": 88.6,
      "duration_seconds": 1.26,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 90.19,
      "end_seconds": 91.86,
      "duration_seconds": 1.67,
      "text": "No operations, no."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 107.83,
      "end_seconds": 110.2,
      "duration_seconds": 2.37,
      "text": "Any drug or food allergies?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 111.59,
      "end_seconds": 114.39,
      "duration_seconds": 2.8,
      "text": "No, none that I know of."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 116.09,
      "end_seconds": 120.9,
      "duration_seconds": 4.81,
      "text": "Do you have any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 121.54,
      "end_seconds": 131.41,
      "duration_seconds": 9.87,
      "text": "Yes, asthma. I'd rather know what's going on than keep guessing. I've had high blood pressure, yes."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 134.17,
      "end_seconds": 138.55,
      "duration_seconds": 4.38,
      "text": "Have you noticed weight loss or shortness of breath?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 139.31,
      "end_seconds": 140.86,
      "duration_seconds": 1.55,
      "text": "No, nothing there."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 141.61,
      "end_seconds": 145.3,
      "duration_seconds": 3.69,
      "text": "Have you had any leg swelling or chest pain?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 146.47,
      "end_seconds": 151.53,
      "duration_seconds": 5.06,
      "text": "No leg swelling or chest pain, none of it."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 153.05,
      "end_seconds": 157.45,
      "duration_seconds": 4.4,
      "text": "Any pins and needles or loss of strength anywhere?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 162.14,
      "end_seconds": 165.05,
      "duration_seconds": 2.91,
      "text": "Oh, no, nothing like that."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 182.3,
      "end_seconds": 185.0,
      "duration_seconds": 2.7,
      "text": "Let me check your vitals now."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 197.33,
      "end_seconds": 199.78,
      "duration_seconds": 2.45,
      "text": "Okay, give me a moment..."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 218.74,
      "end_seconds": 229.17,
      "duration_seconds": 10.43,
      "text": "Okay: respiratory rate 18, SpO2 97 percent on room air, heart rate 89, temperature is 39.3 degrees, blood pressure 105 over 75."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 230.23,
      "end_seconds": 232.42,
      "duration_seconds": 2.19,
      "text": "Is that alright, doctor?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 233.94,
      "end_seconds": 237.37,
      "duration_seconds": 3.43,
      "text": "We'll put it in context in a moment."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 239.45,
      "end_seconds": 242.64,
      "duration_seconds": 3.19,
      "text": "If you're comfortable, I'll examine you now."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 244.29,
      "end_seconds": 245.48,
      "duration_seconds": 1.19,
      "text": "I'll go gently."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 254.46,
      "end_seconds": 258.69,
      "duration_seconds": 4.23,
      "text": "There are a few scattered wheezes on both sides."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 259.71,
      "end_seconds": 261.92,
      "duration_seconds": 2.21,
      "text": "Take your time, no rush."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 272.33,
      "end_seconds": 274.47,
      "duration_seconds": 2.14,
      "text": "No crackles at the bases."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 277.36,
      "end_seconds": 278.35,
      "duration_seconds": 0.99,
      "text": "Okay, finished."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 297.33,
      "end_seconds": 320.07,
      "duration_seconds": 22.74,
      "text": "Taking everything into account, this looks most like acute bronchitis. It could also be pneumonia, so we'll keep that open. We should do a chest X-ray for cough. I want blood tests done, that's for cough. I'd rather check than guess, and this is the quickest way to know more."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 320.84,
      "end_seconds": 322.03,
      "duration_seconds": 1.19,
      "text": "Okay, noted."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 323.51,
      "end_seconds": 361.45,
      "duration_seconds": 37.94,
      "text": "Let's use salbutamol inhaler, 100 micrograms, two puffs when needed, for one week. It's for wheeze. I'll put all of this in writing so you don't have to remember it. I'm prescribing azithromycin, 500 milligrams, once a day, for three days. You take it by mouth. It's for chest infection. It's a commonly used medicine and most people tolerate it well. Steam and warm fluids can ease the cough, and try to sleep with your head propped up."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 363.39,
      "end_seconds": 366.0,
      "duration_seconds": 2.61,
      "text": "Book a review in ten days."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 367.37,
      "end_seconds": 369.74,
      "duration_seconds": 2.37,
      "text": "Yes, I can do that."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 370.29,
      "end_seconds": 372.32,
      "duration_seconds": 2.03,
      "text": "Do you have any questions?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 373.39,
      "end_seconds": 378.32,
      "duration_seconds": 4.93,
      "text": "I think that's clear. Thank you for being so thorough."
    }
  ]
}