{
  "schema_version": "1.0",
  "encounter_id": "00232",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 1.22,
      "end_seconds": 10.38,
      "duration_seconds": 9.16,
      "text": "Doctor, the patient's with us now. I did the usual checks at the front, so just say when you want them."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 12.31,
      "end_seconds": 16.25,
      "duration_seconds": 3.94,
      "text": "perfect, thanks hello there, so what's the trouble?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 22.24,
      "end_seconds": 29.66,
      "duration_seconds": 7.42,
      "text": "Um, so... numbness on the left side of my face. That's why I came."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 30.67,
      "end_seconds": 37.0,
      "duration_seconds": 6.33,
      "text": "Doctor, I've got the readings for you. Pulse 92, temperature 36.5, pressure 148 over 95."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 37.72,
      "end_seconds": 40.28,
      "duration_seconds": 2.56,
      "text": "Thanks. And when did that start?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 42.04,
      "end_seconds": 43.97,
      "duration_seconds": 1.93,
      "text": "About... well, ten days."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 45.88,
      "end_seconds": 50.73,
      "duration_seconds": 4.85,
      "text": "Okay, give me more detail on it, whatever comes to mind."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 52.61,
      "end_seconds": 64.5,
      "duration_seconds": 11.89,
      "text": "I'd give it a three, out of ten. It's a couple of times a week. Um, I've also had tiredness, for five days."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 66.24,
      "end_seconds": 69.14,
      "duration_seconds": 2.9,
      "text": "did you get chest pain or palpitations?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 70.25,
      "end_seconds": 75.57,
      "duration_seconds": 5.32,
      "text": "Right, I haven't had chest pain or palpitations, no."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 76.11,
      "end_seconds": 79.64,
      "duration_seconds": 3.53,
      "text": "Mm. And loss of vision, any of that?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 80.23,
      "end_seconds": 84.2,
      "duration_seconds": 3.97,
      "text": "Not that I've noticed, no loss of vision."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 84.49,
      "end_seconds": 87.01,
      "duration_seconds": 2.52,
      "text": "okay, so how's your breathing otherwise?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 88.51,
      "end_seconds": 89.41,
      "duration_seconds": 0.9,
      "text": "Breathing's normal."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 90.58,
      "end_seconds": 95.66,
      "duration_seconds": 5.08,
      "text": "Do you have any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 101.01,
      "end_seconds": 106.07,
      "duration_seconds": 5.06,
      "text": "uh, I have high cholesterol, for about a year"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 107.43,
      "end_seconds": 108.13,
      "duration_seconds": 0.7,
      "text": "Mm."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 116.35,
      "end_seconds": 121.77,
      "duration_seconds": 5.42,
      "text": "Alright, do you have any allergies to medicines, food, anything at all?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 122.38,
      "end_seconds": 129.28,
      "duration_seconds": 6.9,
      "text": "Years back I got stomach pain from ibuprofen, so I stay away from it now."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 131.34,
      "end_seconds": 135.43,
      "duration_seconds": 4.09,
      "text": "Any medication at the moment, including things from the pharmacy?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 136.02,
      "end_seconds": 140.22,
      "duration_seconds": 4.2,
      "text": "Oh, I'm on rosuvastatin, 10 milligrams, at night."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 154.2,
      "end_seconds": 156.6,
      "duration_seconds": 2.4,
      "text": "now some background about your lifestyle"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 157.97,
      "end_seconds": 175.36,
      "duration_seconds": 17.39,
      "text": "I stopped smoking about two years back. I eat out quite a lot, to be honest. Not really, I don't get much exercise. It's just me and my wife at home now."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 177.94,
      "end_seconds": 181.23,
      "duration_seconds": 3.29,
      "text": "right, let me check a few things physically"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 182.81,
      "end_seconds": 185.41,
      "duration_seconds": 2.6,
      "text": "Let me look at this properly."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 197.93,
      "end_seconds": 202.22,
      "duration_seconds": 4.29,
      "text": "There's mild drooping at the left corner of your mouth."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 203.7,
      "end_seconds": 205.95,
      "duration_seconds": 2.25,
      "text": "Bear with me a second."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 221.43,
      "end_seconds": 224.96,
      "duration_seconds": 3.53,
      "text": "grip strength is a little weaker on the left"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 230.6,
      "end_seconds": 234.13,
      "duration_seconds": 3.53,
      "text": "Thanks, please take a a seat again."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 245.88,
      "end_seconds": 258.77,
      "duration_seconds": 12.89,
      "text": "So where does that leave us? This is probably a possible mini-stroke, which we need to investigate urgently. I wanna be honest that this is an impression, not a final answer."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 259.57,
      "end_seconds": 263.39,
      "duration_seconds": 3.82,
      "text": "So, is this something I'll have for good?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 265.26,
      "end_seconds": 290.98,
      "duration_seconds": 25.72,
      "text": "I understand the worry. At the moment I'd say it's a possible mini-stroke, which we need to investigate urgently, and we'll know more once the a carotid scan is back. Let me just check I've got this right. You've had numbness on the left side of your face for ten days, and no chest pain or palpitations."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 291.9,
      "end_seconds": 293.91,
      "duration_seconds": 2.01,
      "text": "yes, you've got it"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 311.84,
      "end_seconds": 315.66,
      "duration_seconds": 3.82,
      "text": "Let's get a carotid scan, for possible stroke."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 316.81,
      "end_seconds": 318.38,
      "duration_seconds": 1.57,
      "text": "Will it hurt?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 320.26,
      "end_seconds": 344.32,
      "duration_seconds": 24.06,
      "text": "what I'm giving you is clopidogrel, 75 milligrams, once a day, until we review you take it by mouth that's for stroke prevention don't drive for now, and bring someone with you to the the next visit i'll also refer you to the stroke clinic let's plan a check after the results are back"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 344.94,
      "end_seconds": 348.83,
      "duration_seconds": 3.89,
      "text": "Good, uh, I'll come back then."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 349.41,
      "end_seconds": 352.46,
      "duration_seconds": 3.05,
      "text": "That's everything from me. Any other questions?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 354.83,
      "end_seconds": 356.78,
      "duration_seconds": 1.95,
      "text": "Thanks, that was helpful."
    }
  ]
}