{
  "schema_version": "1.0",
  "encounter_id": "00433",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.38,
      "end_seconds": 2.44,
      "duration_seconds": 1.06,
      "text": "Afternoon, doctor."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 3.87,
      "end_seconds": 8.45,
      "duration_seconds": 4.58,
      "text": "Of course, put it down anywhere. So, how can I help?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 9.87,
      "end_seconds": 17.7,
      "duration_seconds": 7.83,
      "text": "Morning, doctor. I'll stay and fill in anything that's missed. We came because of constipation."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 22.73,
      "end_seconds": 25.21,
      "duration_seconds": 2.48,
      "text": "How long are we talking about?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 26.31,
      "end_seconds": 28.38,
      "duration_seconds": 2.07,
      "text": "About... well, one week."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 30.35,
      "end_seconds": 33.12,
      "duration_seconds": 2.77,
      "text": "Is it mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 35.69,
      "end_seconds": 43.12,
      "duration_seconds": 7.43,
      "text": "Pretty mild, if I'm being honest. And I've been feeling weak as well, for ten days."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 44.34,
      "end_seconds": 46.98,
      "duration_seconds": 2.64,
      "text": "Have you had a bad headache?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 48.39,
      "end_seconds": 51.46,
      "duration_seconds": 3.07,
      "text": "Yeah. About four days, I'd say."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 53.19,
      "end_seconds": 55.87,
      "duration_seconds": 2.68,
      "text": "How much is it bothering you?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 56.69,
      "end_seconds": 66.15,
      "duration_seconds": 9.46,
      "text": "Pretty severe, if I'm being honest. I had a dull stomach ache before. That's settled now, though."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 82.22,
      "end_seconds": 85.54,
      "duration_seconds": 3.32,
      "text": "Is there anything medical in your background?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 86.66,
      "end_seconds": 92.66,
      "duration_seconds": 6.0,
      "text": "I've got diabetes. I have an enlarged prostate. Yes, heart disease."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 93.9,
      "end_seconds": 97.68,
      "duration_seconds": 3.78,
      "text": "So, what medicines are you taking at the moment?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 99.04,
      "end_seconds": 107.66,
      "duration_seconds": 8.62,
      "text": "It's Glycomet, 500 milligrams, twice a day, doctor. It's tamsulosin, at night for the prostate, doctor."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 109.08,
      "end_seconds": 111.22,
      "duration_seconds": 2.14,
      "text": "And what strength is that?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 111.82,
      "end_seconds": 121.3,
      "duration_seconds": 9.48,
      "text": "0.4 milligrams, I think that's what's on the box. It's clopidogrel, once a day for the stent, doctor."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 122.69,
      "end_seconds": 124.83,
      "duration_seconds": 2.14,
      "text": "And what strength is that?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 126.44,
      "end_seconds": 127.9,
      "duration_seconds": 1.46,
      "text": "It's 75 milligrams."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 128.64,
      "end_seconds": 131.27,
      "duration_seconds": 2.63,
      "text": "Have you had any surgery before?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 132.43,
      "end_seconds": 137.64,
      "duration_seconds": 5.21,
      "text": "Yes, I had a bypass operation, six years ago."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 151.11,
      "end_seconds": 151.95,
      "duration_seconds": 0.84,
      "text": "Any smoking?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 152.6,
      "end_seconds": 157.89,
      "duration_seconds": 5.29,
      "text": "I used to smoke but I quit five years ago."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 159.22,
      "end_seconds": 160.4,
      "duration_seconds": 1.18,
      "text": "What about alcohol?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 161.99,
      "end_seconds": 164.35,
      "duration_seconds": 2.36,
      "text": "I don't drink at all."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 165.98,
      "end_seconds": 169.09,
      "duration_seconds": 3.11,
      "text": "What kind of work do you do?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 169.74,
      "end_seconds": 173.65,
      "duration_seconds": 3.91,
      "text": "I work on a farm, it's quite physical."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 175.18,
      "end_seconds": 177.18,
      "duration_seconds": 2.0,
      "text": "Do you exercise at all?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 178.16,
      "end_seconds": 183.22,
      "duration_seconds": 5.06,
      "text": "I go to the gym a couple of times a week."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 183.76,
      "end_seconds": 186.05,
      "duration_seconds": 2.29,
      "text": "Who's at home with you?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 187.04,
      "end_seconds": 191.23,
      "duration_seconds": 4.19,
      "text": "It's just me and my wife at home now."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 196.16,
      "end_seconds": 200.07,
      "duration_seconds": 3.91,
      "text": "A few quick ones: burning when passing urine or cough?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 201.61,
      "end_seconds": 207.11,
      "duration_seconds": 5.5,
      "text": "Well, no burning when passing urine or cough, none of it."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 208.1,
      "end_seconds": 213.14,
      "duration_seconds": 5.04,
      "text": "Did you get vomiting, blood in the stool, jaundice or rash?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 213.84,
      "end_seconds": 216.77,
      "duration_seconds": 2.93,
      "text": "No, not any of them."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 218.3,
      "end_seconds": 220.61,
      "duration_seconds": 2.31,
      "text": "Anything unusual with passing urine?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 221.97,
      "end_seconds": 225.43,
      "duration_seconds": 3.46,
      "text": "That's normal as far as I know."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 226.62,
      "end_seconds": 230.03,
      "duration_seconds": 3.41,
      "text": "Before we go on, a few quick readings."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 243.66,
      "end_seconds": 245.26,
      "duration_seconds": 1.6,
      "text": "Just relax your arm..."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 259.9,
      "end_seconds": 269.45,
      "duration_seconds": 9.55,
      "text": "Okay: oxygen saturation is 98 percent, temp 38.8 degrees, pulse is 94 beats a minute, BP is 123 over 69."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 272.08,
      "end_seconds": 275.28,
      "duration_seconds": 3.2,
      "text": "Come over here and I'll have a look."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 276.26,
      "end_seconds": 276.96,
      "duration_seconds": 0.7,
      "text": "Alright."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 278.72,
      "end_seconds": 281.64,
      "duration_seconds": 2.92,
      "text": "Right, just relax, I'll be quick."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 288.83,
      "end_seconds": 292.41,
      "duration_seconds": 3.58,
      "text": "I can't feel your liver or spleen enlarged."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 293.39,
      "end_seconds": 295.8,
      "duration_seconds": 2.41,
      "text": "Hold that position for me."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 304.26,
      "end_seconds": 309.83,
      "duration_seconds": 5.57,
      "text": "Your tummy is a bit full and tender in the lower part."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 313.85,
      "end_seconds": 328.49,
      "duration_seconds": 14.64,
      "text": "All done, you can get dressed. From what you've told me and what I found, it points towards typhoid fever, which we need to confirm. Malaria is also on my list."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 344.79,
      "end_seconds": 379.73,
      "duration_seconds": 34.94,
      "text": "I'm going to order blood cultures, for prolonged fever. I'm going to order a full blood count, for fever. Let's use paracetamol, 500 milligrams, every six hours if needed, for three days. It's for fever and body aches. Eat only home-cooked food and drink boiled or bottled water while this is going on. A malaria test is something we might do if this doesn't improve in a month. Please come and see me after the results are back."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 380.58,
      "end_seconds": 384.02,
      "duration_seconds": 3.44,
      "text": "Okay, we're done for today. Take care."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 385.79,
      "end_seconds": 387.75,
      "duration_seconds": 1.96,
      "text": "I appreciate it, doctor."
    }
  ]
}