{
  "schema_version": "1.0",
  "encounter_id": "00022",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.09,
      "end_seconds": 7.86,
      "duration_seconds": 6.77,
      "text": "doctor, hello, I've got my papers here, where should I put them?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 11.92,
      "end_seconds": 15.51,
      "duration_seconds": 3.59,
      "text": "Not at all, please sit. What's the problem?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 16.7,
      "end_seconds": 23.92,
      "duration_seconds": 7.22,
      "text": "Honestly, it's swelling in my left calf, and my family pushed me to to come."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 25.4,
      "end_seconds": 27.54,
      "duration_seconds": 2.14,
      "text": "And when did that start?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 29.04,
      "end_seconds": 31.12,
      "duration_seconds": 2.08,
      "text": "About... well, one week."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 31.69,
      "end_seconds": 32.67,
      "duration_seconds": 0.98,
      "text": "And then?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 34.74,
      "end_seconds": 39.3,
      "duration_seconds": 4.56,
      "text": "Okay, give me more detail on it, whatever comes to mind."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 41.39,
      "end_seconds": 50.14,
      "duration_seconds": 8.75,
      "text": "It settles a a little with raising the leg. I'd say a few times a day."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 65.64,
      "end_seconds": 68.56,
      "duration_seconds": 2.92,
      "text": "Let me check your vitals now."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 79.88,
      "end_seconds": 81.69,
      "duration_seconds": 1.81,
      "text": "just relax your arm.."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 98.13,
      "end_seconds": 104.42,
      "duration_seconds": 6.29,
      "text": "Okay: respiratory rate 16, pulse 119, pressure 112 over 75. And temperature 36.6."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 106.87,
      "end_seconds": 109.71,
      "duration_seconds": 2.84,
      "text": "let me have a look at you"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 110.83,
      "end_seconds": 112.72,
      "duration_seconds": 1.89,
      "text": "Let me press here."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 128.7,
      "end_seconds": 133.73,
      "duration_seconds": 5.03,
      "text": "The left calf is bigger than the right, tender along the vein."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 139.26,
      "end_seconds": 142.58,
      "duration_seconds": 3.32,
      "text": "Thanks, please take a a seat again."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 161.35,
      "end_seconds": 165.26,
      "duration_seconds": 3.91,
      "text": "Have you had any breathlessness or coughing up blood?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 166.22,
      "end_seconds": 169.05,
      "duration_seconds": 2.83,
      "text": "No, I'd have mentioned it."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 170.28,
      "end_seconds": 175.35,
      "duration_seconds": 5.07,
      "text": "A few quick ones: swelling in the other leg or chest pain?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 177.42,
      "end_seconds": 179.55,
      "duration_seconds": 2.13,
      "text": "Nothing like that, no."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 181.08,
      "end_seconds": 183.79,
      "duration_seconds": 2.71,
      "text": "is your urine normal, no changes?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 184.83,
      "end_seconds": 186.39,
      "duration_seconds": 1.56,
      "text": "No changes there."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 188.29,
      "end_seconds": 195.76,
      "duration_seconds": 7.47,
      "text": "any medical conditions, anything you've been treated for? Bear with me, I'm just building up the picture"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 197.62,
      "end_seconds": 200.81,
      "duration_seconds": 3.19,
      "text": "no, none that I know of"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 202.88,
      "end_seconds": 206.55,
      "duration_seconds": 3.67,
      "text": "Is there a family history of anything significant?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 207.87,
      "end_seconds": 210.59,
      "duration_seconds": 2.72,
      "text": "My grandmother had breast cancer."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 227.77,
      "end_seconds": 230.31,
      "duration_seconds": 2.54,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 231.85,
      "end_seconds": 234.66,
      "duration_seconds": 2.81,
      "text": "No, never had any surgery."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 236.09,
      "end_seconds": 238.61,
      "duration_seconds": 2.52,
      "text": "Before I prescribe anything, any allergies?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 240.41,
      "end_seconds": 245.46,
      "duration_seconds": 5.05,
      "text": "I mean, I don't have any known medication allergies."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 260.55,
      "end_seconds": 263.8,
      "duration_seconds": 3.25,
      "text": "A few questions about your lifestyle now."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 265.82,
      "end_seconds": 276.53,
      "duration_seconds": 10.71,
      "text": "Mostly home-cooked food, rice and vegetables. I live with my family, my husband and two kids. Barely, I'm mostly sedentary these days"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 278.05,
      "end_seconds": 282.58,
      "duration_seconds": 4.53,
      "text": "Any medication at the moment, including things from the pharmacy?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 283.81,
      "end_seconds": 286.8,
      "duration_seconds": 2.99,
      "text": "Paracetamol, 500 milligrams, when needed"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 287.35,
      "end_seconds": 293.42,
      "duration_seconds": 6.07,
      "text": "Right, here's what I'm thinking. This looks most like a possible deep vein clot."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 295.12,
      "end_seconds": 299.46,
      "duration_seconds": 4.34,
      "text": "Um, is this going to go away?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 300.1,
      "end_seconds": 314.6,
      "duration_seconds": 14.5,
      "text": "nothing I've seen today points to an emergency. It looks like a possible deep vein clot, but I'd like to confirm. I'm sending you for a D-dimer blood test because of suspected DVT"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 315.8,
      "end_seconds": 318.77,
      "duration_seconds": 2.97,
      "text": "The earliest is Thursday, 11:30 am."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 320.13,
      "end_seconds": 339.52,
      "duration_seconds": 19.39,
      "text": "keep walking gently, and don't massage the calf if it hasn't settled in two weeks, we'd think about a Doppler scan of the leg, but not now if you get chest pain or sudden breathlessness, that's the point to come in urgently"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 341.2,
      "end_seconds": 345.55,
      "duration_seconds": 4.35,
      "text": "Alright, I know what to to look for."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 347.05,
      "end_seconds": 350.51,
      "duration_seconds": 3.46,
      "text": "I'd like you back in two days"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 355.71,
      "end_seconds": 356.41,
      "duration_seconds": 0.7,
      "text": "Fine."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 357.67,
      "end_seconds": 360.02,
      "duration_seconds": 2.35,
      "text": "do you have any questions?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 360.87,
      "end_seconds": 362.98,
      "duration_seconds": 2.11,
      "text": "Thanks, that was helpful."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 364.94,
      "end_seconds": 366.77,
      "duration_seconds": 1.83,
      "text": "mind how you go"
    }
  ]
