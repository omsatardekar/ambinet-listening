{
  "schema_version": "1.0",
  "encounter_id": "00459",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.4,
      "end_seconds": 6.05,
      "duration_seconds": 4.65,
      "text": "Uh, hi, doctor. Is this the right room?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.03,
      "end_seconds": 11.12,
      "duration_seconds": 4.09,
      "text": "That's alright, take a seat. Tell me why you've come."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 11.84,
      "end_seconds": 18.39,
      "duration_seconds": 6.55,
      "text": "So, I've been dealing with a very painful, swollen big toe."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 19.15,
      "end_seconds": 22.96,
      "duration_seconds": 3.81,
      "text": "What medicines are you taking at the moment?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 23.57,
      "end_seconds": 41.52,
      "duration_seconds": 17.95,
      "text": "I take amlodipine, 5 milligrams, once a day. Well, um, I'm on allopurinol, 100 milligrams, once a day. So, uh, I'm on ibuprofen, 400 milligrams, twice a day."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 43.39,
      "end_seconds": 51.13,
      "duration_seconds": 7.74,
      "text": "Can you describe it a bit more for me? How strong it is, what the pattern is, what helps."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 52.68,
      "end_seconds": 56.71,
      "duration_seconds": 4.03,
      "text": "I'd say all the time. Mostly moderate."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 57.75,
      "end_seconds": 61.01,
      "duration_seconds": 3.26,
      "text": "So, does it come along with anything else?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 61.73,
      "end_seconds": 73.52,
      "duration_seconds": 11.79,
      "text": "Right, when it starts I tend to get trouble walking as well. The trouble walking? That's been for ten days."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 87.78,
      "end_seconds": 92.98,
      "duration_seconds": 5.2,
      "text": "Have you noticed trauma to the toe, kidney problems or rash?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 94.76,
      "end_seconds": 102.38,
      "duration_seconds": 7.62,
      "text": "I, I haven't had trauma to the toe, kidney problems or rash, no."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 103.79,
      "end_seconds": 108.95,
      "duration_seconds": 5.16,
      "text": "Have you noticed any weakness, or anything odd with your balance?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 110.97,
      "end_seconds": 114.21,
      "duration_seconds": 3.24,
      "text": "Uh, no, that's all normal."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 115.56,
      "end_seconds": 121.02,
      "duration_seconds": 5.46,
      "text": "What about your general health, any conditions you're being treated for?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 122.21,
      "end_seconds": 132.81,
      "duration_seconds": 10.6,
      "text": "High blood pressure, for about ten years. Sorry, I know I'm rambling a bit. I have gout, for about ten years."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 133.76,
      "end_seconds": 136.53,
      "duration_seconds": 2.77,
      "text": "Have you ever been under the knife?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 138.04,
      "end_seconds": 142.08,
      "duration_seconds": 4.04,
      "text": "Just a hernia repair, about five years back."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 151.8,
      "end_seconds": 155.03,
      "duration_seconds": 3.23,
      "text": "Okay, a few questions about your lifestyle now."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 156.23,
      "end_seconds": 169.78,
      "duration_seconds": 13.55,
      "text": "I share a flat with two friends. I'm a software engineer, so I'm at a screen all day. I eat out quite a lot, to be honest."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 171.34,
      "end_seconds": 174.53,
      "duration_seconds": 3.19,
      "text": "Right, before I prescribe anything, any allergies?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 175.48,
      "end_seconds": 179.26,
      "duration_seconds": 3.78,
      "text": "No allergies that I know of, no."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 190.25,
      "end_seconds": 192.97,
      "duration_seconds": 2.72,
      "text": "Let me measure a few things."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 201.48,
      "end_seconds": 203.34,
      "duration_seconds": 1.86,
      "text": "Rest your hand here..."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 212.78,
      "end_seconds": 229.2,
      "duration_seconds": 16.42,
      "text": "Okay: pulse is 74 beats a minute, BMI works out to 20.8. And respiratory rate 14, blood pressure 111 over 74, temperature is 36.5 degrees, SpO2 97 percent on room air, weight 69 kilos, height 182 centimetres."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 230.41,
      "end_seconds": 232.03,
      "duration_seconds": 1.62,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 232.94,
      "end_seconds": 236.66,
      "duration_seconds": 3.72,
      "text": "Okay, I'll interpret it once I've examined you."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 239.14,
      "end_seconds": 242.7,
      "duration_seconds": 3.56,
      "text": "I'll examine you now, bear with me."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 244.59,
      "end_seconds": 245.29,
      "duration_seconds": 0.7,
      "text": "Alright."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 247.28,
      "end_seconds": 249.77,
      "duration_seconds": 2.49,
      "text": "Just relax, I'll be quick."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 258.92,
      "end_seconds": 265.57,
      "duration_seconds": 6.65,
      "text": "The big toe joint is red, hot, swollen and extremely tender to touch."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 268.36,
      "end_seconds": 295.99,
      "duration_seconds": 27.63,
      "text": "Thanks, please take a seat again. Okay, thinking it through, this looks most like an acute gout flare. I'd also keep pseudogout in mind. I'd like to arrange kidney function tests for gout. I'd like to arrange a uric acid level for suspected gout. Cut right back on red meat, organ meats, beer and sugary drinks, and drink plenty of water. Right, that's all. Go gently."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 296.5,
      "end_seconds": 299.84,
      "duration_seconds": 3.34,
      "text": "No, you've explained it well. Thanks."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 301.37,
      "end_seconds": 302.74,
      "duration_seconds": 1.37,
      "text": "See you then."
    }
  ]
}