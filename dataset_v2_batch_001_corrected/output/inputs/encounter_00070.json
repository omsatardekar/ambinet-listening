{
  "schema_version": "1.0",
  "encounter_id": "00070",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.86,
      "end_seconds": 4.46,
      "duration_seconds": 3.6,
      "text": "So, evening. Long day, I imagine. Sit down."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 10.02,
      "end_seconds": 11.73,
      "duration_seconds": 1.71,
      "text": "Good morning, doctor."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 12.64,
      "end_seconds": 19.69,
      "duration_seconds": 7.05,
      "text": "Oh, hello, doctor. I hope it's alright if I stay in for this."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 20.78,
      "end_seconds": 26.08,
      "duration_seconds": 5.3,
      "text": "Good, that'll be useful. Pull up a chair. Right, what's the trouble?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 27.71,
      "end_seconds": 31.57,
      "duration_seconds": 3.86,
      "text": "She's been having a fit last month, doctor."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 32.31,
      "end_seconds": 34.41,
      "duration_seconds": 2.1,
      "text": "What's your current medication list?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 35.03,
      "end_seconds": 42.02,
      "duration_seconds": 6.99,
      "text": "Um, it's alendronate, 70 milligrams, once a week for my bones."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 43.23,
      "end_seconds": 45.07,
      "duration_seconds": 1.84,
      "text": "And for how long?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 46.01,
      "end_seconds": 54.14,
      "duration_seconds": 8.13,
      "text": "Nearly five years now. It's something called clop... clopidogrel, 75 milligrams, maybe, once a day."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 55.39,
      "end_seconds": 59.3,
      "duration_seconds": 3.91,
      "text": "Do you have the packet or the prescription with you?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 60.84,
      "end_seconds": 64.34,
      "duration_seconds": 3.5,
      "text": "Hmm, no, it's at home."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 66.24,
      "end_seconds": 68.93,
      "duration_seconds": 2.69,
      "text": "Since when have you had this?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 70.63,
      "end_seconds": 76.11,
      "duration_seconds": 5.48,
      "text": "Right, uh, it's been going on for about four days."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 77.79,
      "end_seconds": 80.63,
      "duration_seconds": 2.84,
      "text": "Anything you do that brings it on?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 82.49,
      "end_seconds": 86.42,
      "duration_seconds": 3.93,
      "text": "Um, it's worse with missed sleep."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 87.0,
      "end_seconds": 90.07,
      "duration_seconds": 3.07,
      "text": "Does it come along with anything else?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 91.87,
      "end_seconds": 99.37,
      "duration_seconds": 7.5,
      "text": "I mean, when it starts I tend to get tiredness as well."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 101.11,
      "end_seconds": 103.74,
      "duration_seconds": 2.63,
      "text": "Have you been biting your tongue?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 105.01,
      "end_seconds": 109.79,
      "duration_seconds": 4.78,
      "text": "Yeah, you know, I've had that since this morning."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 110.49,
      "end_seconds": 113.69,
      "duration_seconds": 3.2,
      "text": "Have you had a bit of confusion afterwards?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 115.76,
      "end_seconds": 120.04,
      "duration_seconds": 4.28,
      "text": "Yes, about the same, about two weeks."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 120.88,
      "end_seconds": 127.38,
      "duration_seconds": 6.5,
      "text": "Have you had a fit last month before, or is this the first time?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 128.87,
      "end_seconds": 136.17,
      "duration_seconds": 7.3,
      "text": "Yes, something like this happened last winter, and it went away on its own."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 137.93,
      "end_seconds": 142.83,
      "duration_seconds": 4.9,
      "text": "Have you had any weakness on one side or head injury?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 144.58,
      "end_seconds": 152.23,
      "duration_seconds": 7.65,
      "text": "Uh, you know, I haven't had weakness on one side or head injury, no."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 153.33,
      "end_seconds": 158.11,
      "duration_seconds": 4.78,
      "text": "Right, have you noticed loss of bladder control, fever or headache?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 159.68,
      "end_seconds": 163.63,
      "duration_seconds": 3.95,
      "text": "Okay, so no, I'd have mentioned it."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 165.68,
      "end_seconds": 167.93,
      "duration_seconds": 2.25,
      "text": "Is your chest okay generally?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 169.29,
      "end_seconds": 171.06,
      "duration_seconds": 1.77,
      "text": "No, nothing there."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 187.93,
      "end_seconds": 190.9,
      "duration_seconds": 2.97,
      "text": "Before I prescribe anything, any allergies?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 191.42,
      "end_seconds": 196.11,
      "duration_seconds": 4.69,
      "text": "Okay, so no, none that I know of."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 196.92,
      "end_seconds": 205.81,
      "duration_seconds": 8.89,
      "text": "Actually, I remember she had some kind of reaction to penicillin before. I couldn't swear to it."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 207.81,
      "end_seconds": 211.0,
      "duration_seconds": 3.19,
      "text": "I mean, I don't remember that."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 212.15,
      "end_seconds": 214.68,
      "duration_seconds": 2.53,
      "text": "Okay, I'll note both of those."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 227.58,
      "end_seconds": 229.24,
      "duration_seconds": 1.66,
      "text": "Do you live alone?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 232.93,
      "end_seconds": 236.3,
      "duration_seconds": 3.37,
      "text": "Yes, I live on my own."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 237.15,
      "end_seconds": 239.1,
      "duration_seconds": 1.95,
      "text": "Do you get any exercise?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 240.82,
      "end_seconds": 245.2,
      "duration_seconds": 4.38,
      "text": "I walk for about half an hour most days."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 245.92,
      "end_seconds": 247.12,
      "duration_seconds": 1.2,
      "text": "And your work?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 248.18,
      "end_seconds": 252.11,
      "duration_seconds": 3.93,
      "text": "I drive a delivery van all day."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 253.24,
      "end_seconds": 254.67,
      "duration_seconds": 1.43,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 255.82,
      "end_seconds": 259.04,
      "duration_seconds": 3.22,
      "text": "Hmm, no, nothing like that."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 262.9,
      "end_seconds": 265.87,
      "duration_seconds": 2.97,
      "text": "Is there anything medical in your background?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 266.71,
      "end_seconds": 278.55,
      "duration_seconds": 11.84,
      "text": "I have epilepsy. I, I have thin bones, for about a year. Sorry, I know I'm rambling a bit. I have heart disease."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 279.53,
      "end_seconds": 280.23,
      "duration_seconds": 0.7,
      "text": "Yes?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 281.11,
      "end_seconds": 287.87,
      "duration_seconds": 6.76,
      "text": "Right, so epilepsy and thin bones are already on your record. We'll keep that in mind today."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_4",
      "role": "NURSE",
      "start_seconds": 306.86,
      "end_seconds": 319.71,
      "duration_seconds": 12.85,
      "text": "Doctor, I've got the readings for you. Blood pressure 121 over 75, respiratory rate 18, oxygen saturation is 97 percent, temperature 37.0, pulse is 73 beats a minute."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 321.27,
      "end_seconds": 322.33,
      "duration_seconds": 1.06,
      "text": "Okay, noted."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 323.51,
      "end_seconds": 326.72,
      "duration_seconds": 3.21,
      "text": "Come over here and I'll have a look."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 327.74,
      "end_seconds": 328.44,
      "duration_seconds": 0.7,
      "text": "Alright."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 330.06,
      "end_seconds": 331.74,
      "duration_seconds": 1.68,
      "text": "Let me press here."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 347.19,
      "end_seconds": 350.13,
      "duration_seconds": 2.94,
      "text": "You're alert and orientated, speech is clear."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 351.35,
      "end_seconds": 353.49,
      "duration_seconds": 2.14,
      "text": "Just relax, I'll be quick."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 365.65,
      "end_seconds": 368.99,
      "duration_seconds": 3.34,
      "text": "Reflexes and power are symmetrical on both sides."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 369.59,
      "end_seconds": 370.79,
      "duration_seconds": 1.2,
      "text": "Okay, ready."
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 373.12,
      "end_seconds": 385.71,
      "duration_seconds": 12.59,
      "text": "Thanks for that. So where does that leave us? I think we're dealing with breakthrough seizure on known epilepsy at this stage. A provoked seizure from missed medication is still possible."
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 386.26,
      "end_seconds": 388.83,
      "duration_seconds": 2.57,
      "text": "Do you think it's serious?"
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 390.21,
      "end_seconds": 422.04,
      "duration_seconds": 31.83,
      "text": "Nothing I've seen today points to an emergency. It looks like breakthrough seizure on known epilepsy, but I'd like to confirm. Let's book an MRI of the brain to look into seizure. Let's get an EEG, for seizure. No driving until we've reviewed you again, I'm sorry, but that's the rule. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0059",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 423.53,
      "end_seconds": 431.49,
      "duration_seconds": 7.96,
      "text": "Please don't wait if you have another seizure lasting more than five minutes. That's when to be seen urgently."
    },
    {
      "segment_id": "SEG0060",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 436.17,
      "end_seconds": 438.91,
      "duration_seconds": 2.74,
      "text": "Right, um, will do."
    },
    {
      "segment_id": "SEG0061",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 439.57,
      "end_seconds": 445.68,
      "duration_seconds": 6.11,
      "text": "We'll catch up after the results are back. Call the clinic if you need us."
    },
    {
      "segment_id": "SEG0062",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 446.79,
      "end_seconds": 450.67,
      "duration_seconds": 3.88,
      "text": "Okay, so thanks, that was helpful."
    }
  ]
}