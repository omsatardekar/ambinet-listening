{
  "schema_version": "1.0",
  "encounter_id": "00149",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.28,
      "end_seconds": 5.11,
      "duration_seconds": 3.83,
      "text": "Excuse me, doctor, should I sit here?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.33,
      "end_seconds": 10.33,
      "duration_seconds": 4.0,
      "text": "Not at all, please sit. What's the problem?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 12.33,
      "end_seconds": 17.59,
      "duration_seconds": 5.26,
      "text": "I've been dealing with a burning pain in the upper tummy."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 18.74,
      "end_seconds": 21.3,
      "duration_seconds": 2.56,
      "text": "How long have you had it?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 22.81,
      "end_seconds": 25.29,
      "duration_seconds": 2.48,
      "text": "Probably about four days. Yeah."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 27.3,
      "end_seconds": 32.55,
      "duration_seconds": 5.25,
      "text": "Okay, give me more detail on it, whatever comes to mind."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 34.58,
      "end_seconds": 40.44,
      "duration_seconds": 5.86,
      "text": "It feels mild to me. It sort of comes and goes."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 41.64,
      "end_seconds": 44.74,
      "duration_seconds": 3.1,
      "text": "Does it come along with anything else?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 46.75,
      "end_seconds": 67.5,
      "duration_seconds": 20.75,
      "text": "When it starts I tend to get nausea as well. The, The nausea? That's been for three days. With nausea, it comes and goes. Oh, and a sour taste in the mouth. Had that since this morning."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 69.46,
      "end_seconds": 73.07,
      "duration_seconds": 3.61,
      "text": "Did you get weight loss or vomiting blood?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 74.53,
      "end_seconds": 79.19,
      "duration_seconds": 4.66,
      "text": "I haven't had weight loss or vomiting blood, no."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 79.92,
      "end_seconds": 83.08,
      "duration_seconds": 3.16,
      "text": "Did you get trouble swallowing or jaundice?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 84.21,
      "end_seconds": 88.31,
      "duration_seconds": 4.1,
      "text": "No trouble swallowing or jaundice, none of it."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 93.66,
      "end_seconds": 97.44,
      "duration_seconds": 3.78,
      "text": "How about your heart, any problems like that?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 98.99,
      "end_seconds": 104.17,
      "duration_seconds": 5.18,
      "text": "My heart's been fine, as far as I know."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 104.99,
      "end_seconds": 107.84,
      "duration_seconds": 2.85,
      "text": "Does anything run in the family?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 109.56,
      "end_seconds": 111.58,
      "duration_seconds": 2.02,
      "text": "My mother has migraines."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 115.66,
      "end_seconds": 116.97,
      "duration_seconds": 1.31,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 118.11,
      "end_seconds": 119.69,
      "duration_seconds": 1.58,
      "text": "No operations, no."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 121.56,
      "end_seconds": 125.11,
      "duration_seconds": 3.55,
      "text": "Alright, are you on any regular medication?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 125.95,
      "end_seconds": 128.87,
      "duration_seconds": 2.92,
      "text": "No, I don't take anything regularly."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 130.13,
      "end_seconds": 131.56,
      "duration_seconds": 1.43,
      "text": "How about smoking?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 132.33,
      "end_seconds": 136.27,
      "duration_seconds": 3.94,
      "text": "No, I don't smoke and never have."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 137.16,
      "end_seconds": 138.95,
      "duration_seconds": 1.79,
      "text": "And alcohol, how much?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 140.28,
      "end_seconds": 144.35,
      "duration_seconds": 4.07,
      "text": "I have a couple of drinks on the weekend."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 145.42,
      "end_seconds": 147.52,
      "duration_seconds": 2.1,
      "text": "Are you active at all?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 149.42,
      "end_seconds": 152.59,
      "duration_seconds": 3.17,
      "text": "Barely, I'm mostly sedentary these days."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 153.52,
      "end_seconds": 155.5,
      "duration_seconds": 1.98,
      "text": "Who's at home with you?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 157.56,
      "end_seconds": 161.7,
      "duration_seconds": 4.14,
      "text": "It's just me and my wife at home now."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 162.69,
      "end_seconds": 165.27,
      "duration_seconds": 2.58,
      "text": "How do you eat, generally?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 166.52,
      "end_seconds": 168.76,
      "duration_seconds": 2.24,
      "text": "I skip breakfast most days."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 170.55,
      "end_seconds": 174.4,
      "duration_seconds": 3.85,
      "text": "Any long-term health problems I should know about?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 180.24,
      "end_seconds": 183.07,
      "duration_seconds": 2.83,
      "text": "I have arthritis in my knees."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 196.04,
      "end_seconds": 205.29,
      "duration_seconds": 9.25,
      "text": "Do you have any allergies to medicines, food, anything at all? These questions might sound routine, but they matter."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 206.54,
      "end_seconds": 209.63,
      "duration_seconds": 3.09,
      "text": "None, as far as I'm aware."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 219.34,
      "end_seconds": 221.79,
      "duration_seconds": 2.45,
      "text": "I'll take a few measurements first."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 232.16,
      "end_seconds": 233.14,
      "duration_seconds": 0.98,
      "text": "One second..."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 243.15,
      "end_seconds": 253.62,
      "duration_seconds": 10.47,
      "text": "Okay: temperature is 36.7 degrees, saturation 97 percent, respiratory rate 15. And blood pressure 119 over 69, pulse is 72 beats a minute."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 255.26,
      "end_seconds": 256.78,
      "duration_seconds": 1.52,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 257.91,
      "end_seconds": 260.81,
      "duration_seconds": 2.9,
      "text": "I'll interpret it once I've examined you."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 262.11,
      "end_seconds": 264.55,
      "duration_seconds": 2.44,
      "text": "Let's do the physical part now."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 266.51,
      "end_seconds": 268.56,
      "duration_seconds": 2.05,
      "text": "Let me just check something."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 283.13,
      "end_seconds": 288.94,
      "duration_seconds": 5.81,
      "text": "Your tummy is soft, with mild tenderness in the upper middle part."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 290.98,
      "end_seconds": 291.68,
      "duration_seconds": 0.7,
      "text": "Okay."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 295.68,
      "end_seconds": 304.39,
      "duration_seconds": 8.71,
      "text": "Right, you can sit back down. Right, here's what I'm thinking. It fits best with gastritis. Acid reflux is still possible."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 320.9,
      "end_seconds": 328.29,
      "duration_seconds": 7.39,
      "text": "I want an H. pylori test done, that's for dyspepsia. Alright, I'll see you out."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 329.2,
      "end_seconds": 332.39,
      "duration_seconds": 3.19,
      "text": "I appreciate it, uh, doctor."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 333.96,
      "end_seconds": 335.2,
      "duration_seconds": 1.24,
      "text": "See you then."
    }
  ]
}