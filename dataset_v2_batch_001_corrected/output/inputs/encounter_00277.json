{
  "schema_version": "1.0",
  "encounter_id": "00277",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.0,
      "end_seconds": 6.02,
      "duration_seconds": 5.02,
      "text": "good afternoon, doctor, the receptionist said you'd see me now"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.4,
      "end_seconds": 13.64,
      "duration_seconds": 6.24,
      "text": "yes, come in, take a seat what can I do for you today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 14.36,
      "end_seconds": 18.54,
      "duration_seconds": 4.18,
      "text": "good morning, doctor. I came along to help out"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 20.61,
      "end_seconds": 23.25,
      "duration_seconds": 2.64,
      "text": "absolutely, come and sit beside them"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 23.91,
      "end_seconds": 29.38,
      "duration_seconds": 5.47,
      "text": "doctor it's pain in my right ankle. That's what we're worried about"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 31.0,
      "end_seconds": 33.47,
      "duration_seconds": 2.47,
      "text": "Roughly when did it start?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 35.14,
      "end_seconds": 38.4,
      "duration_seconds": 3.26,
      "text": "It's been three days I'm fairly sure."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 40.16,
      "end_seconds": 49.67,
      "duration_seconds": 9.51,
      "text": "tell me a bit more about it: how bad it gets, how often, and whether anything makes it better or worse"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 51.7,
      "end_seconds": 63.62,
      "duration_seconds": 11.92,
      "text": "I'd say moderate. Yes putting weight on it and walking. That makes it worse. And a twist during football too. There's bruising as well."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_4",
      "role": "NURSE",
      "start_seconds": 64.95,
      "end_seconds": 74.82,
      "duration_seconds": 9.87,
      "text": "Here are the numbers, doctor. Weight 69 kilos, temp 36.8 degrees. BP is 126 over 72, height 166 centimetres, pulse 69."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 76.24,
      "end_seconds": 76.94,
      "duration_seconds": 0.7,
      "text": "thanks"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 79.43,
      "end_seconds": 83.08,
      "duration_seconds": 3.65,
      "text": "Come over here and I'll have a look."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 84.87,
      "end_seconds": 87.54,
      "duration_seconds": 2.67,
      "text": "so, just relax, I'll be quick"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 102.8,
      "end_seconds": 109.71,
      "duration_seconds": 6.91,
      "text": "there's swelling and bruising on the outer side of the ankle, tender over the ligament"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 110.86,
      "end_seconds": 112.61,
      "duration_seconds": 1.75,
      "text": "so, I'll go gently"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 119.62,
      "end_seconds": 125.54,
      "duration_seconds": 5.92,
      "text": "The bones themselves aren't tender and the the ankle feels stable when I test it."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 128.6,
      "end_seconds": 136.38,
      "duration_seconds": 7.78,
      "text": "thanks please take a a seat again. Did you get pain at the back of the heel or fever?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 138.43,
      "end_seconds": 140.71,
      "duration_seconds": 2.28,
      "text": "Nothing like that, no."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 142.29,
      "end_seconds": 149.36,
      "duration_seconds": 7.07,
      "text": "let me check a few things any pop or crack or pain in the knee?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 150.84,
      "end_seconds": 157.41,
      "duration_seconds": 6.57,
      "text": "I haven't had pop or crack or pain in the knee, no."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 160.53,
      "end_seconds": 163.5,
      "duration_seconds": 2.97,
      "text": "has your heart given you any trouble?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 166.86,
      "end_seconds": 169.31,
      "duration_seconds": 2.45,
      "text": "No, nothing with my heart."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 180.71,
      "end_seconds": 183.43,
      "duration_seconds": 2.72,
      "text": "any diagnoses you've been given before?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 184.82,
      "end_seconds": 194.01,
      "duration_seconds": 9.19,
      "text": "I have acid reflux. An underactive thyroid, for nearly five years. An enlarged prostate, for about ten years."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 194.6,
      "end_seconds": 200.28,
      "duration_seconds": 5.68,
      "text": "yes, an enlarged prostate is known to us, good to have that clear"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 216.51,
      "end_seconds": 219.06,
      "duration_seconds": 2.55,
      "text": "now some background about your lifestyle"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 220.22,
      "end_seconds": 232.04,
      "duration_seconds": 11.82,
      "text": "I don't drink at all. I stay with my daughter and her family. I work on a farm, it's quite physical"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 233.63,
      "end_seconds": 236.54,
      "duration_seconds": 2.91,
      "text": "Before I prescribe anything, any allergies?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 237.36,
      "end_seconds": 239.85,
      "duration_seconds": 2.49,
      "text": "no, no allergies to anything"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 241.29,
      "end_seconds": 248.26,
      "duration_seconds": 6.97,
      "text": "Hold on, doctor, I think he reacted to aspirin once. I'm not certain, though."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 248.95,
      "end_seconds": 251.19,
      "duration_seconds": 2.24,
      "text": "I don't remember that"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 253.06,
      "end_seconds": 261.1,
      "duration_seconds": 8.04,
      "text": "Alright so so that's unclear. I'll record what each of you said. What medicines are you taking at the moment?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 262.99,
      "end_seconds": 285.36,
      "duration_seconds": 22.37,
      "text": "Omeprazole, 20 milligrams, once a day for the reflux. I just want to get back to normal, really. Thyronorm. I take it 50 micrograms, every morning. I'm on tamsulosin, 0.4 milligrams, at night for the prostate. I'm on paracetamol, 500 milligrams, when needed."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 290.22,
      "end_seconds": 298.64,
      "duration_seconds": 8.42,
      "text": "Doctor, I think the last prescription for the paracetamol was 250 milligrams. We changed it at the last visit."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 300.19,
      "end_seconds": 303.86,
      "duration_seconds": 3.67,
      "text": "hm do you have the latest prescription with you?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 304.82,
      "end_seconds": 308.72,
      "duration_seconds": 3.9,
      "text": "Not with me. I'll bring it next time."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 310.27,
      "end_seconds": 311.62,
      "duration_seconds": 1.35,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 313.53,
      "end_seconds": 317.4,
      "duration_seconds": 3.87,
      "text": "yes I had my gallbladder removed in 2016"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 318.63,
      "end_seconds": 340.6,
      "duration_seconds": 21.97,
      "text": "from what you've told me and what I found I think we're dealing with an ankle sprain at this stage i want to be honest that this is an impression not a final answer it could also be a small fracture so we'll keep that open"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 354.28,
      "end_seconds": 359.75,
      "duration_seconds": 5.47,
      "text": "Let's book an X-ray of the ankle to look into ankle injury."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 362.66,
      "end_seconds": 365.98,
      "duration_seconds": 3.32,
      "text": "um does it need any preparation?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 367.26,
      "end_seconds": 384.44,
      "duration_seconds": 17.18,
      "text": "rest ice for twenty minutes at a time a compression bandage and keep the foot up and please bring the latest prescription or the medicine boxes to the next visit so we can settle the dose let's review you in ten days"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 385.41,
      "end_seconds": 387.77,
      "duration_seconds": 2.36,
      "text": "okay, see you then"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 391.53,
      "end_seconds": 392.95,
      "duration_seconds": 1.42,
      "text": "look after yourself"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 394.34,
      "end_seconds": 399.02,
      "duration_seconds": 4.68,
      "text": "no, I think that's everything thank you, doctor"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 400.24,
      "end_seconds": 401.18,
      "duration_seconds": 0.94,
      "text": "take care"
    }
  ]
}