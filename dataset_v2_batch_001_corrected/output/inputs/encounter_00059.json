{
  "schema_version": "1.0",
  "encounter_id": "00059",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 0.57,
      "end_seconds": 5.93,
      "duration_seconds": 5.36,
      "text": "Afternoon, doctor. They're in and comfortable, and I have the measurements ready."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.07,
      "end_seconds": 11.01,
      "duration_seconds": 3.94,
      "text": "Okay, thanks. Hi, how can I help today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 12.46,
      "end_seconds": 19.73,
      "duration_seconds": 7.27,
      "text": "Hmm, doctor, I've come along because I know the history, if it helps."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 21.4,
      "end_seconds": 33.39,
      "duration_seconds": 11.99,
      "text": "Well, I've been having a sticky discharge in the morning. I thought it would sort itself out, but it hasn't."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 35.17,
      "end_seconds": 45.68,
      "duration_seconds": 10.51,
      "text": "Here are the numbers, doctor. Heart rate 65, respiratory rate 18, oxygen saturation is 99 percent, pressure 111 over 68, temperature is 36.5 degrees."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 47.69,
      "end_seconds": 48.39,
      "duration_seconds": 0.7,
      "text": "Thanks."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 61.1,
      "end_seconds": 65.21,
      "duration_seconds": 4.11,
      "text": "Is this recent, or has it been a while?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 66.65,
      "end_seconds": 68.68,
      "duration_seconds": 2.03,
      "text": "Probably two weeks. Yeah."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 69.37,
      "end_seconds": 72.5,
      "duration_seconds": 3.13,
      "text": "What about itching, have you noticed that?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 73.16,
      "end_seconds": 82.19,
      "duration_seconds": 9.03,
      "text": "Yes, um, I have. Watering was there, but it's gone away on its own."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 88.06,
      "end_seconds": 93.45,
      "duration_seconds": 5.39,
      "text": "Have you noticed pain in the eye or sensitivity to light?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 95.08,
      "end_seconds": 101.2,
      "duration_seconds": 6.12,
      "text": "No pain in the eye or sensitivity to light, none of it."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 103.16,
      "end_seconds": 110.88,
      "duration_seconds": 7.72,
      "text": "Let me check a few things. Any contact lens, loss of vision or foreign body in the eye?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 114.93,
      "end_seconds": 122.48,
      "duration_seconds": 7.55,
      "text": "Hmm, no, no contact lens, loss of vision or foreign body in the eye."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 123.16,
      "end_seconds": 125.34,
      "duration_seconds": 2.18,
      "text": "Is your chest okay generally?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 126.45,
      "end_seconds": 129.18,
      "duration_seconds": 2.73,
      "text": "Yeah, no problems with breathing."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 138.96,
      "end_seconds": 141.37,
      "duration_seconds": 2.41,
      "text": "Any allergies I should know about?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 142.87,
      "end_seconds": 148.68,
      "duration_seconds": 5.81,
      "text": "Sulfa drugs. I come out in... well, itching all over."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 153.7,
      "end_seconds": 156.64,
      "duration_seconds": 2.94,
      "text": "What medicines do you take regularly?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 159.76,
      "end_seconds": 166.79,
      "duration_seconds": 7.03,
      "text": "Well, she is on hydrocortisone cream, when needed, I give it to her."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 167.6,
      "end_seconds": 170.31,
      "duration_seconds": 2.71,
      "text": "Roughly how long on that one?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 171.15,
      "end_seconds": 173.32,
      "duration_seconds": 2.17,
      "text": "Nearly five years now."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 174.64,
      "end_seconds": 175.86,
      "duration_seconds": 1.22,
      "text": "How about smoking?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 177.56,
      "end_seconds": 181.71,
      "duration_seconds": 4.15,
      "text": "No, I don't smoke and never have."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 183.42,
      "end_seconds": 184.63,
      "duration_seconds": 1.21,
      "text": "What about alcohol?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 186.67,
      "end_seconds": 192.17,
      "duration_seconds": 5.5,
      "text": "A beer or two most evenings, to be honest."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 194.03,
      "end_seconds": 196.51,
      "duration_seconds": 2.48,
      "text": "Is anyone at home with you?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 197.34,
      "end_seconds": 201.29,
      "duration_seconds": 3.95,
      "text": "I share a flat with two friends."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 204.96,
      "end_seconds": 206.92,
      "duration_seconds": 1.96,
      "text": "What's your diet like?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 208.88,
      "end_seconds": 213.66,
      "duration_seconds": 4.78,
      "text": "I eat out quite a lot, to be honest."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 214.39,
      "end_seconds": 216.98,
      "duration_seconds": 2.59,
      "text": "Are you working at the moment?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 218.72,
      "end_seconds": 223.14,
      "duration_seconds": 4.42,
      "text": "Yes, I'm a nurse on a busy ward."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 224.09,
      "end_seconds": 227.53,
      "duration_seconds": 3.44,
      "text": "Is there anything medical in your background?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 229.36,
      "end_seconds": 235.13,
      "duration_seconds": 5.77,
      "text": "I've got eczema. I have low haemoglobin, for two years."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 244.49,
      "end_seconds": 245.92,
      "duration_seconds": 1.43,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 250.03,
      "end_seconds": 253.85,
      "duration_seconds": 3.82,
      "text": "Right, no, never had any surgery."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 255.7,
      "end_seconds": 258.58,
      "duration_seconds": 2.88,
      "text": "I'd like to examine you now."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 259.47,
      "end_seconds": 261.81,
      "duration_seconds": 2.34,
      "text": "Hold that position for me."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 270.02,
      "end_seconds": 276.86,
      "duration_seconds": 6.84,
      "text": "The white of the eye is pink all over, and there's some sticky discharge on the lashes."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 278.57,
      "end_seconds": 279.62,
      "duration_seconds": 1.05,
      "text": "No problem."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 281.15,
      "end_seconds": 283.52,
      "duration_seconds": 2.37,
      "text": "Tell me if anything hurts."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 297.84,
      "end_seconds": 303.07,
      "duration_seconds": 5.23,
      "text": "Your vision is normal on the chart and the pupil reacts well."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 307.74,
      "end_seconds": 325.47,
      "duration_seconds": 17.73,
      "text": "Okay, you can sit up. Right, here's what I'm thinking. The most likely explanation is conjunctivitis. I want to be honest that this is an impression, not a final answer. A corneal problem is still possible."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 326.77,
      "end_seconds": 329.85,
      "duration_seconds": 3.08,
      "text": "Well, do you think it's serious?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 331.01,
      "end_seconds": 342.52,
      "duration_seconds": 11.51,
      "text": "It's reasonable to be concerned, but right now conjunctivitis is my leading thought, not anything worse. Let's book an eye swab to look into red eye."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 343.96,
      "end_seconds": 345.18,
      "duration_seconds": 1.22,
      "text": "Okay, noted."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 345.85,
      "end_seconds": 370.26,
      "duration_seconds": 24.41,
      "text": "I'm prescribing chloramphenicol eye drops, four times a day, for five days. It's for conjunctivitis. Wash your hands often, don't share towels, and don't rub the eye. Try to keep a simple diary of when it happens and what you were doing, and bring it to the next visit. Any last questions?"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 371.37,
      "end_seconds": 375.6,
      "duration_seconds": 4.23,
      "text": "One thing: no, actually that's all. Thanks."
    }
  ]
}