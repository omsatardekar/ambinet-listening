{
  "schema_version": "1.0",
  "encounter_id": "00491",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.3,
      "end_seconds": 3.47,
      "duration_seconds": 2.17,
      "text": "Hello. Right, let's get started."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 4.05,
      "end_seconds": 8.44,
      "duration_seconds": 4.39,
      "text": "hello is it okay if I sit here?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 9.72,
      "end_seconds": 13.16,
      "duration_seconds": 3.44,
      "text": "Did you find the the place alright?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 14.64,
      "end_seconds": 21.77,
      "duration_seconds": 7.13,
      "text": "um, yes, it was easy enough. The parking was the hard part"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 23.82,
      "end_seconds": 26.29,
      "duration_seconds": 2.47,
      "text": "How can I help you today?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 28.02,
      "end_seconds": 31.06,
      "duration_seconds": 3.04,
      "text": "it's a fit last month, mostly"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 32.64,
      "end_seconds": 35.46,
      "duration_seconds": 2.82,
      "text": "How far back does it go?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 36.37,
      "end_seconds": 39.19,
      "duration_seconds": 2.82,
      "text": "About... well, about two weeks."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 39.69,
      "end_seconds": 53.94,
      "duration_seconds": 14.25,
      "text": "right tell me a bit more about it: how bad it gets, how often, and whether anything makes it better or worse i'll explain everything as we go along"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 54.74,
      "end_seconds": 63.68,
      "duration_seconds": 8.94,
      "text": "I'd say on and off. I notice it it more with missed sleep and missing tablets."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 74.18,
      "end_seconds": 79.4,
      "duration_seconds": 5.22,
      "text": "have you had any loss of bladder control or weakness on one side?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 84.18,
      "end_seconds": 89.26,
      "duration_seconds": 5.08,
      "text": "No, no loss of bladder control or weakness on one side."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 90.85,
      "end_seconds": 94.28,
      "duration_seconds": 3.43,
      "text": "Okay, any breathing difficulties apart from this?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 95.89,
      "end_seconds": 97.7,
      "duration_seconds": 1.81,
      "text": "No problems with breathing."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 98.69,
      "end_seconds": 102.26,
      "duration_seconds": 3.57,
      "text": "Any long-term health problems I should know about?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 103.25,
      "end_seconds": 104.5,
      "duration_seconds": 1.25,
      "text": "Yes, epilepsy."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 105.42,
      "end_seconds": 116.41,
      "duration_seconds": 10.99,
      "text": "right, so epilepsy is already on your record. We'll keep that in mind today. Alright, tell me what you take day to day"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 117.68,
      "end_seconds": 122.4,
      "duration_seconds": 4.72,
      "text": "Sodium valproate. I take it 500 milligrams, twice a day."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 139.67,
      "end_seconds": 144.22,
      "duration_seconds": 4.55,
      "text": "Okay, any relatives with health problems I should be aware of?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 145.36,
      "end_seconds": 147.97,
      "duration_seconds": 2.61,
      "text": "My uncle had colon cancer."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 149.17,
      "end_seconds": 151.14,
      "duration_seconds": 1.97,
      "text": "do you live alone?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 152.02,
      "end_seconds": 155.23,
      "duration_seconds": 3.21,
      "text": "Yes, I live on my own"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 156.26,
      "end_seconds": 158.05,
      "duration_seconds": 1.79,
      "text": "What's your diet like?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 161.04,
      "end_seconds": 165.53,
      "duration_seconds": 4.49,
      "text": "I eat out quite a lot, to be honest."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 170.42,
      "end_seconds": 175.46,
      "duration_seconds": 5.04,
      "text": "Okay, do you have any allergies to medicines, food, anything at all?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 176.18,
      "end_seconds": 179.64,
      "duration_seconds": 3.46,
      "text": "Right, no, no allergies to anything."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 180.84,
      "end_seconds": 184.66,
      "duration_seconds": 3.82,
      "text": "let's get your blood pressure and the other basics"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 195.1,
      "end_seconds": 197.24,
      "duration_seconds": 2.14,
      "text": "Okay, give me a moment..."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 216.86,
      "end_seconds": 227.54,
      "duration_seconds": 10.68,
      "text": "okay: oxygen saturation is 98 percent, pulse is 76 beats a a minute, temperature 36.9, respiratory rate 17, pressure 117 over 69."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 228.61,
      "end_seconds": 230.42,
      "duration_seconds": 1.81,
      "text": "Is that that okay?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 232.41,
      "end_seconds": 235.72,
      "duration_seconds": 3.31,
      "text": "That's fine, we'll come to to it."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 238.71,
      "end_seconds": 242.03,
      "duration_seconds": 3.32,
      "text": "I'll examine you now, bear with me."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 253.89,
      "end_seconds": 254.59,
      "duration_seconds": 0.7,
      "text": "Fine."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 255.74,
      "end_seconds": 260.09,
      "duration_seconds": 4.35,
      "text": "right, a little pressure here, tell me if it's tender"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 276.11,
      "end_seconds": 279.4,
      "duration_seconds": 3.29,
      "text": "Reflexes and power are symmetrical on both sides."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 283.83,
      "end_seconds": 299.04,
      "duration_seconds": 15.21,
      "text": "That's all I need, thank you. So where does that leave us? It's hard to say. Breakthrough seizure on known epilepsy is one possibility and a provoked seizure from missed medication another, and I'd rather not commit yet."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 300.19,
      "end_seconds": 305.99,
      "duration_seconds": 5.8,
      "text": "I've been thinking the worst, to be honest. Is it bad?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 307.96,
      "end_seconds": 317.42,
      "duration_seconds": 9.46,
      "text": "it's reasonable to be concerned, but right now breakthrough seizure on known epilepsy is my leading thought, not anything worse"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 328.93,
      "end_seconds": 347.26,
      "duration_seconds": 18.33,
      "text": "I'm sending you for an MRI of the brain cos of seizure. No driving until we've reviewed you again, I'm sorry, but that's the rule. Book a review in four weeks. Is there anything you wanted to ask?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 352.52,
      "end_seconds": 357.2,
      "duration_seconds": 4.68,
      "text": "I think that's clear. Thank you for being so thorough."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 357.78,
      "end_seconds": 359.14,
      "duration_seconds": 1.36,
      "text": "bye for now"
    }
  ]
}