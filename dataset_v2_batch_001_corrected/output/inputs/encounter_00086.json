{
  "schema_version": "1.0",
  "encounter_id": "00086",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 1.39,
      "end_seconds": 8.32,
      "duration_seconds": 6.93,
      "text": "All set here, doctor. Chart's updated, and I'll read the readings out when you're ready."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 13.27,
      "end_seconds": 17.76,
      "duration_seconds": 4.49,
      "text": "Great. Hello, come in and sit down. How can I help?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 18.45,
      "end_seconds": 28.41,
      "duration_seconds": 9.96,
      "text": "I wanted to get a heavy feeling in the left arm looked at. My family kept telling me to get it checked."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 29.35,
      "end_seconds": 31.32,
      "duration_seconds": 1.97,
      "text": "And when did that start?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 32.95,
      "end_seconds": 36.95,
      "duration_seconds": 4.0,
      "text": "It's been about a week, I'm fairly sure."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 37.8,
      "end_seconds": 47.21,
      "duration_seconds": 9.41,
      "text": "Tell me a bit more about it: how bad it gets, how often, and whether anything makes it better or worse."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 48.61,
      "end_seconds": 62.88,
      "duration_seconds": 14.27,
      "text": "Only resting, and it's not much. It's moderate, honestly. Oh, and tiredness. That's been about the same, about a week. I'd been sweating with it, but that went away."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 64.75,
      "end_seconds": 66.95,
      "duration_seconds": 2.2,
      "text": "Any drug or food allergies?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 68.89,
      "end_seconds": 72.17,
      "duration_seconds": 3.28,
      "text": "No, none that I know of."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 73.08,
      "end_seconds": 74.36,
      "duration_seconds": 1.28,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 75.4,
      "end_seconds": 79.85,
      "duration_seconds": 4.45,
      "text": "Just a hernia repair, about five years back."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 82.36,
      "end_seconds": 84.91,
      "duration_seconds": 2.55,
      "text": "Does anything run in the family?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 86.47,
      "end_seconds": 88.89,
      "duration_seconds": 2.42,
      "text": "My sister has thyroid problems."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 92.13,
      "end_seconds": 94.64,
      "duration_seconds": 2.51,
      "text": "What do you do for work?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 98.06,
      "end_seconds": 103.71,
      "duration_seconds": 5.65,
      "text": "I work in an office, mostly sitting at a desk."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 105.14,
      "end_seconds": 106.87,
      "duration_seconds": 1.73,
      "text": "Any sport or activity?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 108.06,
      "end_seconds": 110.34,
      "duration_seconds": 2.28,
      "text": "I play badminton on Sundays."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 112.33,
      "end_seconds": 114.58,
      "duration_seconds": 2.25,
      "text": "Are you living with family?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 115.14,
      "end_seconds": 118.78,
      "duration_seconds": 3.64,
      "text": "I stay with my daughter and her family."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 119.46,
      "end_seconds": 122.14,
      "duration_seconds": 2.68,
      "text": "Any diagnoses you've been given before?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 123.96,
      "end_seconds": 142.63,
      "duration_seconds": 18.67,
      "text": "I mean, I have high blood pressure, for nearly five years. It's a relief to finally sit down and talk about it. I did try to ignore it for a while. I have high cholesterol, for five years."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 143.41,
      "end_seconds": 148.81,
      "duration_seconds": 5.4,
      "text": "Right, right. Right, what medicines are you taking at the moment?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 150.07,
      "end_seconds": 155.68,
      "duration_seconds": 5.61,
      "text": "Ramipril. I take it every morning for my blood pressure."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 156.87,
      "end_seconds": 159.22,
      "duration_seconds": 2.35,
      "text": "And what strength is that?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 162.95,
      "end_seconds": 174.82,
      "duration_seconds": 11.87,
      "text": "5 milligrams, I think that's what's on the box. I mean, I'm on something called ator... atorvastatin, 20 milligrams, maybe, at night for my cholesterol."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 175.63,
      "end_seconds": 179.99,
      "duration_seconds": 4.36,
      "text": "Did you happen to bring the box or the paperwork?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 181.69,
      "end_seconds": 189.66,
      "duration_seconds": 7.97,
      "text": "Not with me. I'll bring it next time. Aspirin, 75 milligrams, once a day."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 204.63,
      "end_seconds": 210.99,
      "duration_seconds": 6.36,
      "text": "Have you had any pain at rest, cough or swelling in the ankles?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 211.61,
      "end_seconds": 219.22,
      "duration_seconds": 7.61,
      "text": "I haven't had pain at rest, cough or swelling in the ankles, no."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 221.17,
      "end_seconds": 223.26,
      "duration_seconds": 2.09,
      "text": "Did you notice any fainting?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 225.29,
      "end_seconds": 226.86,
      "duration_seconds": 1.57,
      "text": "No, no fainting."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 228.48,
      "end_seconds": 230.88,
      "duration_seconds": 2.4,
      "text": "Any breathing difficulties apart from this?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 232.38,
      "end_seconds": 234.89,
      "duration_seconds": 2.51,
      "text": "No, my breathing's been fine."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 236.59,
      "end_seconds": 240.89,
      "duration_seconds": 4.3,
      "text": "What about your tummy and bowels, anything unusual there?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 241.97,
      "end_seconds": 245.99,
      "duration_seconds": 4.02,
      "text": "Right, um, no, all normal there."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 247.0,
      "end_seconds": 259.48,
      "duration_seconds": 12.48,
      "text": "Here are the numbers, doctor. Respiratory rate 15, temp 36.5 degrees, BP is 153 over 98. Pulse is 79 beats a minute, oxygen saturation is 97 percent."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 260.15,
      "end_seconds": 261.2,
      "duration_seconds": 1.05,
      "text": "Okay, noted."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 264.2,
      "end_seconds": 267.15,
      "duration_seconds": 2.95,
      "text": "Let's do the physical part now."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 268.87,
      "end_seconds": 270.99,
      "duration_seconds": 2.12,
      "text": "Hold that position for me."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 281.51,
      "end_seconds": 285.66,
      "duration_seconds": 4.15,
      "text": "Lungs are clear and there's no swelling in your ankles."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 290.49,
      "end_seconds": 291.44,
      "duration_seconds": 0.95,
      "text": "Okay, finished."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 309.44,
      "end_seconds": 320.46,
      "duration_seconds": 11.02,
      "text": "From what you've told me and what I found, I can't pin this down yet. We're looking at angina-type chest pain or gastro-oesophageal reflux."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 329.13,
      "end_seconds": 332.26,
      "duration_seconds": 3.13,
      "text": "We've already done an ECG this morning, doctor."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 332.77,
      "end_seconds": 344.07,
      "duration_seconds": 11.3,
      "text": "Alright, thanks, I'll check it. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 345.87,
      "end_seconds": 347.44,
      "duration_seconds": 1.57,
      "text": "Okay, fair enough."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 349.27,
      "end_seconds": 356.03,
      "duration_seconds": 6.76,
      "text": "There's nothing new for me to start or arrange today. Okay, we're done for today. Take care."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 356.99,
      "end_seconds": 362.58,
      "duration_seconds": 5.59,
      "text": "I think that's clear. Thank you for being so thorough."
    }
  ]
}