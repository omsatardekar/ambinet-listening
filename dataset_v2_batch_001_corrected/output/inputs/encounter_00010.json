{
  "schema_version": "1.0",
  "encounter_id": "00010",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.51,
      "end_seconds": 4.93,
      "duration_seconds": 4.42,
      "text": "Um, excuse me, doctor, should I sit here?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.19,
      "end_seconds": 10.17,
      "duration_seconds": 3.98,
      "text": "Right on time. Sit, please. How can I help?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 12.24,
      "end_seconds": 19.19,
      "duration_seconds": 6.95,
      "text": "mainly nearly passing out there's a couple of other things, but that's the main one"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 21.03,
      "end_seconds": 23.48,
      "duration_seconds": 2.45,
      "text": "Let me check your vitals now."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 34.81,
      "end_seconds": 35.68,
      "duration_seconds": 0.87,
      "text": "Almost there..."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 51.72,
      "end_seconds": 65.86,
      "duration_seconds": 14.14,
      "text": "Okay: height 173 centimetres, SpO2 99 percent on room air, BMI works out to 20.7, respiratory rate 17, pressure 98 over 59, temperature is 37.1 degrees, weight 62 kilos, pulse 108."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 66.58,
      "end_seconds": 68.16,
      "duration_seconds": 1.58,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 69.04,
      "end_seconds": 73.99,
      "duration_seconds": 4.95,
      "text": "I'll interpret it once I've examined you. Does anything make it better?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 75.76,
      "end_seconds": 79.22,
      "duration_seconds": 3.46,
      "text": "It settles a little with lying down."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 80.47,
      "end_seconds": 84.05,
      "duration_seconds": 3.58,
      "text": "Anything that that tends to go along with it?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 88.86,
      "end_seconds": 99.55,
      "duration_seconds": 10.69,
      "text": "it usually comes with a pounding in the head. And I've been sweating as well. I'd been feeling lightheaded, but that went away"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 101.52,
      "end_seconds": 107.49,
      "duration_seconds": 5.97,
      "text": "Have you had nearly passing out before, or is this the first time?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 108.45,
      "end_seconds": 114.92,
      "duration_seconds": 6.47,
      "text": "I had a similar thing a couple of years ago. It went away."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 116.33,
      "end_seconds": 120.07,
      "duration_seconds": 3.74,
      "text": "Okay, and what about vomiting, palpitations or slurred speech?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 125.05,
      "end_seconds": 128.07,
      "duration_seconds": 3.02,
      "text": "Hmm, nothing like that, no."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 128.92,
      "end_seconds": 132.79,
      "duration_seconds": 3.87,
      "text": "have you had any fainting completely or chest pain?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 134.13,
      "end_seconds": 136.99,
      "duration_seconds": 2.86,
      "text": "So, no, none of those."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 137.74,
      "end_seconds": 140.4,
      "duration_seconds": 2.66,
      "text": "Any breathing difficulties apart from this?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 142.28,
      "end_seconds": 145.07,
      "duration_seconds": 2.79,
      "text": "Um, no problems with breathing."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 146.7,
      "end_seconds": 147.99,
      "duration_seconds": 1.29,
      "text": "any previous surgeries?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 148.52,
      "end_seconds": 151.94,
      "duration_seconds": 3.42,
      "text": "yeah, no, never had any surgery"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 166.86,
      "end_seconds": 171.57,
      "duration_seconds": 4.71,
      "text": "Let's talk a little about your daily life and habits."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 172.32,
      "end_seconds": 182.73,
      "duration_seconds": 10.41,
      "text": "I've never smoked. I'm retired now, I was a clerk for years. It's just me and my wife at home now."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 192.12,
      "end_seconds": 200.85,
      "duration_seconds": 8.73,
      "text": "What about your general health, any conditions you're being treated for? I'll explain everything as we go along."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 202.08,
      "end_seconds": 229.82,
      "duration_seconds": 27.74,
      "text": "I've had high blood pressure for about a year now. A neighbour of mine said I should see someone about it. I've got diabetes. I didn't want to make a fuss, you know. I wasn't sure whether to come in at all, to be honest. Yes, arthritis in my knees."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 234.24,
      "end_seconds": 243.59,
      "duration_seconds": 9.35,
      "text": "Yes, high blood pressure is known to us, good to have that clear. Any allergies I should know about?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 244.69,
      "end_seconds": 247.7,
      "duration_seconds": 3.01,
      "text": "No, none that I know of."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 248.88,
      "end_seconds": 251.39,
      "duration_seconds": 2.51,
      "text": "does anything run in the family?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 256.78,
      "end_seconds": 258.67,
      "duration_seconds": 1.89,
      "text": "My brother has asthma."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 259.55,
      "end_seconds": 263.15,
      "duration_seconds": 3.6,
      "text": "Let's go through your medication. What are you taking?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 265.09,
      "end_seconds": 277.87,
      "duration_seconds": 12.78,
      "text": "I take amlodipine, 5 milligrams, once a day for my pressure. something called glyc... Glycomet. I take it 500 milligrams, maybe, twice a day for my sugar."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 279.77,
      "end_seconds": 285.06,
      "duration_seconds": 5.29,
      "text": "Did you happen to bring the the box or the paperwork?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 289.43,
      "end_seconds": 292.87,
      "duration_seconds": 3.44,
      "text": "No, you know, it's at home."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 294.18,
      "end_seconds": 298.59,
      "duration_seconds": 4.41,
      "text": "Come over here and and I'll have a look."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 299.78,
      "end_seconds": 303.01,
      "duration_seconds": 3.23,
      "text": "Stay still while I have a look."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 313.94,
      "end_seconds": 315.52,
      "duration_seconds": 1.58,
      "text": "Heart rhythm is regular."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 317.12,
      "end_seconds": 319.89,
      "duration_seconds": 2.77,
      "text": "Stay still while I have a look."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 332.51,
      "end_seconds": 336.65,
      "duration_seconds": 4.14,
      "text": "Your blood pressure drops when you stand, I'll note that."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 341.73,
      "end_seconds": 343.7,
      "duration_seconds": 1.97,
      "text": "That's fine, sit up."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 360.79,
      "end_seconds": 386.54,
      "duration_seconds": 25.75,
      "text": "Putting it all together, I think we're dealing with postural low blood pressure at this stage. I want to be honest that this is an impression, not a final answer. I'd also keep dehydration in mind. Just to be sure I understood. You've had nearly passing out, and no palpitations or slurred speech."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 388.35,
      "end_seconds": 389.05,
      "duration_seconds": 0.7,
      "text": "Correct."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 390.18,
      "end_seconds": 398.76,
      "duration_seconds": 8.58,
      "text": "I'm sending you for blood tests because of dizziness. The result will help us decide whether anything more is needed."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 399.45,
      "end_seconds": 402.04,
      "duration_seconds": 2.59,
      "text": "The earliest is Friday, 10 am."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 403.95,
      "end_seconds": 406.19,
      "duration_seconds": 2.24,
      "text": "Okay, I'll be there."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 407.68,
      "end_seconds": 412.54,
      "duration_seconds": 4.86,
      "text": "I'm sending you for a blood sugar test because of dizziness."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 413.46,
      "end_seconds": 416.63,
      "duration_seconds": 3.17,
      "text": "where do I go for that?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 417.94,
      "end_seconds": 449.27,
      "duration_seconds": 31.33,
      "text": "get up in stages, sit on the edge of the bed for a minute first, and keep drinking water. Try to get to bed and wake up at the same time each day, and keep your phone away from the bed. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose. Please come and see me in two weeks. Look after yourself"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 450.15,
      "end_seconds": 452.17,
      "duration_seconds": 2.02,
      "text": "No questions. Thank you."
    }
  ]
}