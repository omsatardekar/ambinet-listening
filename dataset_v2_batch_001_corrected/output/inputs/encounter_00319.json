{
  "schema_version": "1.0",
  "encounter_id": "00319",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.15,
      "end_seconds": 5.77,
      "duration_seconds": 4.62,
      "text": "Well, morning. Nice to finally see you, doctor."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.33,
      "end_seconds": 12.93,
      "duration_seconds": 5.6,
      "text": "Of course, put it down anywhere. So, how can I help?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 13.9,
      "end_seconds": 20.32,
      "duration_seconds": 6.42,
      "text": "Um, so... pain in my right ankle. That's why I came."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 21.75,
      "end_seconds": 25.57,
      "duration_seconds": 3.82,
      "text": "Let's get your blood pressure and the other basics."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 35.6,
      "end_seconds": 37.89,
      "duration_seconds": 2.29,
      "text": "Okay, give me a moment..."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 54.93,
      "end_seconds": 62.86,
      "duration_seconds": 7.93,
      "text": "Okay: temp 36.7 degrees, BP is 119 over 72, oxygen saturation is 97 percent, heart rate 84."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 63.65,
      "end_seconds": 67.64,
      "duration_seconds": 3.99,
      "text": "Oh, uh, is that alright, doctor?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 68.15,
      "end_seconds": 74.16,
      "duration_seconds": 6.01,
      "text": "So, I'll interpret it once I've examined you. How long are we talking about?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 79.76,
      "end_seconds": 82.35,
      "duration_seconds": 2.59,
      "text": "For five days, I'd say."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 82.99,
      "end_seconds": 88.65,
      "duration_seconds": 5.66,
      "text": "Okay, give me more detail on it, whatever comes to mind."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 89.61,
      "end_seconds": 100.45,
      "duration_seconds": 10.84,
      "text": "Oh, um, it just comes and goes. It settles a little with ice. I've never really been one for hospitals."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 101.14,
      "end_seconds": 103.88,
      "duration_seconds": 2.74,
      "text": "Have you had a twist during football?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 104.84,
      "end_seconds": 107.72,
      "duration_seconds": 2.88,
      "text": "Right, yes, since this morning."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 108.84,
      "end_seconds": 111.51,
      "duration_seconds": 2.67,
      "text": "How much is it bothering you?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 112.05,
      "end_seconds": 139.52,
      "duration_seconds": 27.47,
      "text": "A five out of ten, uh, I suppose. Hmm, as for swelling, I honestly can't say when that began. It might have been last month or the month before. Right, with swelling, pretty moderate, if I'm being honest. It settles a little with elevation."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 140.36,
      "end_seconds": 146.6,
      "duration_seconds": 6.24,
      "text": "Have you had pain in your right ankle before, or is this the first time?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 147.45,
      "end_seconds": 153.73,
      "duration_seconds": 6.28,
      "text": "Okay, so a bit, last year. It settled by itself back then."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 159.8,
      "end_seconds": 166.61,
      "duration_seconds": 6.81,
      "text": "Have you noticed pain at the back of the heel, pain in the knee or numbness?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 167.73,
      "end_seconds": 177.43,
      "duration_seconds": 9.7,
      "text": "I haven't had pain at the back of the heel, pain in the knee or numbness, no."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 179.23,
      "end_seconds": 182.23,
      "duration_seconds": 3.0,
      "text": "Is your urine normal, no changes?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 183.79,
      "end_seconds": 188.55,
      "duration_seconds": 4.76,
      "text": "Uh, that's normal as far as I know."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 189.26,
      "end_seconds": 193.61,
      "duration_seconds": 4.35,
      "text": "What about allergies, to medicines or foods or anything else?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 195.31,
      "end_seconds": 210.19,
      "duration_seconds": 14.88,
      "text": "Hmm, there was some antibiotic, I was told I was allergic. But I couldn't tell you what it was called or what it did."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 223.31,
      "end_seconds": 224.78,
      "duration_seconds": 1.47,
      "text": "And your work?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 225.31,
      "end_seconds": 228.97,
      "duration_seconds": 3.66,
      "text": "I drive a delivery van all day."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 230.89,
      "end_seconds": 232.47,
      "duration_seconds": 1.58,
      "text": "Any sport or activity?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 234.03,
      "end_seconds": 236.6,
      "duration_seconds": 2.57,
      "text": "I play badminton on Sundays."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 238.68,
      "end_seconds": 241.18,
      "duration_seconds": 2.5,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 242.07,
      "end_seconds": 244.96,
      "duration_seconds": 2.89,
      "text": "Oh, no, nothing like that."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 245.83,
      "end_seconds": 248.31,
      "duration_seconds": 2.48,
      "text": "What medicines do you take regularly?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 249.14,
      "end_seconds": 274.95,
      "duration_seconds": 25.81,
      "text": "Okay, so I take pantoprazole, 40 milligrams, before breakfast for my acidity. Asthalin inhaler. I take it when needed for my asthma. I'd rather not end up on lots of tablets if I can avoid it. Paracetamol. I take it when needed."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 276.52,
      "end_seconds": 278.5,
      "duration_seconds": 1.98,
      "text": "How much do you take?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 284.6,
      "end_seconds": 289.57,
      "duration_seconds": 4.97,
      "text": "500 milligrams, I think that's what's on the box."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 299.73,
      "end_seconds": 302.16,
      "duration_seconds": 2.43,
      "text": "Any diagnoses you've been given before?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 302.71,
      "end_seconds": 308.35,
      "duration_seconds": 5.64,
      "text": "Yes, acid reflux. I've had asthma for about ten years now."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 310.68,
      "end_seconds": 313.12,
      "duration_seconds": 2.44,
      "text": "Okay, a quick examination now."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 314.62,
      "end_seconds": 316.62,
      "duration_seconds": 2.0,
      "text": "Let me just check something."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 333.14,
      "end_seconds": 339.43,
      "duration_seconds": 6.29,
      "text": "There's swelling and bruising on the outer side of the ankle, tender over the ligament."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 340.67,
      "end_seconds": 342.85,
      "duration_seconds": 2.18,
      "text": "Take your time, no rush."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 359.1,
      "end_seconds": 364.55,
      "duration_seconds": 5.45,
      "text": "The bones themselves aren't tender and the ankle feels stable when I test it."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 368.88,
      "end_seconds": 369.9,
      "duration_seconds": 1.02,
      "text": "Okay, finished."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 381.06,
      "end_seconds": 387.48,
      "duration_seconds": 6.42,
      "text": "Putting it all together, it points towards an ankle sprain. We shouldn't forget a small fracture."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 388.31,
      "end_seconds": 391.27,
      "duration_seconds": 2.96,
      "text": "Is this going to go away?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 392.36,
      "end_seconds": 414.88,
      "duration_seconds": 22.52,
      "text": "I understand the worry. At the moment I'd say it's an ankle sprain, and we'll know more once the an X-ray of the ankle is back. Just to be sure I understood. You've had pain in your right ankle for five days, and no pain in the knee or pain at the back of the heel."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 415.47,
      "end_seconds": 417.18,
      "duration_seconds": 1.71,
      "text": "Yes, that's right."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 418.81,
      "end_seconds": 424.24,
      "duration_seconds": 5.43,
      "text": "I'll request an X-ray of the ankle, it'll help with ankle injury."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 430.21,
      "end_seconds": 431.99,
      "duration_seconds": 1.78,
      "text": "Fine by me."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 437.09,
      "end_seconds": 454.77,
      "duration_seconds": 17.68,
      "text": "The treatment will be ibuprofen, 400 milligrams, three times a day after food, for three days. It's for ankle pain. Rest, ice for twenty minutes at a time, a compression bandage and keep the foot up. Please come and see me in ten days."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 456.85,
      "end_seconds": 461.73,
      "duration_seconds": 4.88,
      "text": "Hmm, I'll make the appointment on my way out."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 462.47,
      "end_seconds": 463.79,
      "duration_seconds": 1.32,
      "text": "Any last questions?"
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 465.2,
      "end_seconds": 470.44,
      "duration_seconds": 5.24,
      "text": "Okay, so that's everything I wanted to ask. Thank you."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 472.13,
      "end_seconds": 473.64,
      "duration_seconds": 1.51,
      "text": "Alright, take care."
    }
  ]
}