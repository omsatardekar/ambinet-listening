{
  "schema_version": "1.0",
  "encounter_id": "00128",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.32,
      "end_seconds": 2.46,
      "duration_seconds": 1.14,
      "text": "Afternoon, doctor."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 3.38,
      "end_seconds": 8.19,
      "duration_seconds": 4.81,
      "text": "That's alright, take a seat. Tell me why you've come."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 10.07,
      "end_seconds": 22.52,
      "duration_seconds": 12.45,
      "text": "Doctor, um, thank you for seeing us. Yeah, it's irregular periods, doctor. She didn't want to come, but I insisted."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 23.66,
      "end_seconds": 26.38,
      "duration_seconds": 2.72,
      "text": "How far back does it go?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 27.42,
      "end_seconds": 32.18,
      "duration_seconds": 4.76,
      "text": "About three days, you know, give or take."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 33.8,
      "end_seconds": 38.34,
      "duration_seconds": 4.54,
      "text": "I, I think it's been nearer five days, actually."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 39.59,
      "end_seconds": 43.95,
      "duration_seconds": 4.36,
      "text": "Okay, so roughly three to five days. Is that right?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 45.04,
      "end_seconds": 48.28,
      "duration_seconds": 3.24,
      "text": "Yeah, I suppose so, yes."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 48.55,
      "end_seconds": 52.66,
      "duration_seconds": 4.11,
      "text": "Okay. How would you describe it, mild, moderate, severe?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 54.59,
      "end_seconds": 58.41,
      "duration_seconds": 3.82,
      "text": "Okay, so I'd call it mild."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 58.86,
      "end_seconds": 63.26,
      "duration_seconds": 4.4,
      "text": "Uh-huh. What about night sweats, have you noticed that?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 64.13,
      "end_seconds": 79.78,
      "duration_seconds": 15.65,
      "text": "Oh, yes, about the same, two months. As for night sweats, it happens a couple of times a week. Uh, I've had poor sleep too, for three days."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 81.75,
      "end_seconds": 83.73,
      "duration_seconds": 1.98,
      "text": "And how severe is it?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 86.26,
      "end_seconds": 87.38,
      "duration_seconds": 1.12,
      "text": "Mostly mild."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 88.63,
      "end_seconds": 94.47,
      "duration_seconds": 5.84,
      "text": "Have you had irregular periods before, or is this the first time?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 95.76,
      "end_seconds": 101.83,
      "duration_seconds": 6.07,
      "text": "A bit, last year. It settled by itself back then."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 103.42,
      "end_seconds": 108.29,
      "duration_seconds": 4.87,
      "text": "Are there any allergies on your record that I should check?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 109.41,
      "end_seconds": 113.14,
      "duration_seconds": 3.73,
      "text": "Yeah, none, as far as I'm aware."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 127.64,
      "end_seconds": 135.42,
      "duration_seconds": 7.78,
      "text": "Which tablets or creams or inhalers do you use? I'll explain everything as we go along."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 137.15,
      "end_seconds": 147.11,
      "duration_seconds": 9.96,
      "text": "Thyronorm. I take it 50 micrograms, every morning. Alendronate, 70 milligrams, once a week for my bones."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 148.53,
      "end_seconds": 152.54,
      "duration_seconds": 4.01,
      "text": "Tell me about your health in general, any ongoing conditions?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 158.07,
      "end_seconds": 166.1,
      "duration_seconds": 8.03,
      "text": "I have an underactive thyroid, for nearly five years. I have thin bones, for five years."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 167.03,
      "end_seconds": 168.72,
      "duration_seconds": 1.69,
      "text": "Do you drink alcohol?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 169.4,
      "end_seconds": 175.03,
      "duration_seconds": 5.63,
      "text": "A beer or two most evenings, to be honest."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 176.25,
      "end_seconds": 178.7,
      "duration_seconds": 2.45,
      "text": "What do you do for work?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 179.37,
      "end_seconds": 184.6,
      "duration_seconds": 5.23,
      "text": "I work in an office, mostly sitting at a desk."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 185.55,
      "end_seconds": 187.28,
      "duration_seconds": 1.73,
      "text": "Any sport or activity?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 190.2,
      "end_seconds": 192.95,
      "duration_seconds": 2.75,
      "text": "I play badminton on Sundays."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 193.55,
      "end_seconds": 196.1,
      "duration_seconds": 2.55,
      "text": "Okay, who's at home with you?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 197.2,
      "end_seconds": 201.89,
      "duration_seconds": 4.69,
      "text": "It's just me and my wife at home now."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 220.74,
      "end_seconds": 222.34,
      "duration_seconds": 1.6,
      "text": "How about heavy bleeding?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 222.88,
      "end_seconds": 226.52,
      "duration_seconds": 3.64,
      "text": "No, um, no heavy bleeding."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 227.19,
      "end_seconds": 231.18,
      "duration_seconds": 3.99,
      "text": "Alright, any breast lumps, palpitations or bleeding after sex?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 235.07,
      "end_seconds": 241.37,
      "duration_seconds": 6.3,
      "text": "So, no breast lumps, palpitations or bleeding after sex, none of it."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 241.94,
      "end_seconds": 245.29,
      "duration_seconds": 3.35,
      "text": "Anything on the skin I should know about?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 246.34,
      "end_seconds": 247.53,
      "duration_seconds": 1.19,
      "text": "No rashes."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 248.47,
      "end_seconds": 252.25,
      "duration_seconds": 3.78,
      "text": "Let's get your blood pressure and the other basics."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 264.82,
      "end_seconds": 267.2,
      "duration_seconds": 2.38,
      "text": "Okay, give me a moment..."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 277.66,
      "end_seconds": 286.15,
      "duration_seconds": 8.49,
      "text": "Okay: BP is 114 over 82, heart rate 83, respiratory rate 18, temperature is 36.9 degrees."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 286.92,
      "end_seconds": 288.5,
      "duration_seconds": 1.58,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 289.01,
      "end_seconds": 292.15,
      "duration_seconds": 3.14,
      "text": "We'll put it in context in a moment."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 293.69,
      "end_seconds": 296.83,
      "duration_seconds": 3.14,
      "text": "Come over here and I'll have a look."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 297.89,
      "end_seconds": 300.96,
      "duration_seconds": 3.07,
      "text": "Stay still while I have a look."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 315.05,
      "end_seconds": 320.86,
      "duration_seconds": 5.81,
      "text": "Blood pressure and pulse are fine, and there are no breast lumps on examination."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 324.76,
      "end_seconds": 338.97,
      "duration_seconds": 14.21,
      "text": "Okay, that's all I need, thank you. Taking everything into account, this is probably perimenopausal symptoms. That's my thinking for now, and it may change as we learn more. Another possibility is anaemia."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 353.38,
      "end_seconds": 357.05,
      "duration_seconds": 3.67,
      "text": "Have you had any tests for this so far?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 358.08,
      "end_seconds": 367.67,
      "duration_seconds": 9.59,
      "text": "I had a thyroid test done at another clinic last year. I don't have the report with me."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 369.27,
      "end_seconds": 373.63,
      "duration_seconds": 4.36,
      "text": "I think blood tests makes sense here, for irregular periods."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 374.65,
      "end_seconds": 377.59,
      "duration_seconds": 2.94,
      "text": "Does it need any preparation?"
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 379.53,
      "end_seconds": 405.1,
      "duration_seconds": 25.57,
      "text": "I think a bone density scan makes sense here, for menopause. Layers of clothing, a fan by the bed, and cutting down on caffeine and spicy food can help the flushes. Make sure you're drinking plenty of fluids, two to three litres a day if you can, and get proper rest. Please come and see me after the results are back."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 406.46,
      "end_seconds": 410.63,
      "duration_seconds": 4.17,
      "text": "I'll make the appointment on my way out."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 411.72,
      "end_seconds": 413.01,
      "duration_seconds": 1.29,
      "text": "Look after yourself."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 414.74,
      "end_seconds": 419.96,
      "duration_seconds": 5.22,
      "text": "Hmm, that's everything I wanted to ask. Thank you."
    }
  ]
}