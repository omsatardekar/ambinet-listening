{
  "schema_version": "1.0",
  "encounter_id": "00481",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.16,
      "end_seconds": 4.61,
      "duration_seconds": 3.45,
      "text": "Morning, doctor, I hope I'm not interrupting."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.07,
      "end_seconds": 9.33,
      "duration_seconds": 3.26,
      "text": "Not at all, please sit. What's the problem?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 11.43,
      "end_seconds": 17.28,
      "duration_seconds": 5.85,
      "text": "Doctor, it's an itchy rash. It's getting on my nerves now."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 17.87,
      "end_seconds": 28.96,
      "duration_seconds": 11.09,
      "text": "Here are the numbers, doctor. Temperature 36.7, pulse is 65 beats a minute, pressure 115 over 71. Respiratory rate 16, saturation 97 percent."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 30.84,
      "end_seconds": 34.49,
      "duration_seconds": 3.65,
      "text": "Thanks. How long has this been going on?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 36.58,
      "end_seconds": 39.17,
      "duration_seconds": 2.59,
      "text": "It's been two months now."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 40.84,
      "end_seconds": 45.9,
      "duration_seconds": 5.06,
      "text": "Okay, give me more detail on it, whatever comes to mind."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 47.04,
      "end_seconds": 58.62,
      "duration_seconds": 11.58,
      "text": "Mostly mild. It's worse with soap and sweating. Honestly, a few times a day. Oh, and itching that wakes me at night."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 59.23,
      "end_seconds": 63.16,
      "duration_seconds": 3.93,
      "text": "Is it constant, or does it come and go?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 64.19,
      "end_seconds": 68.06,
      "duration_seconds": 3.87,
      "text": "It happens a few times a day."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 80.38,
      "end_seconds": 86.11,
      "duration_seconds": 5.73,
      "text": "Have you had any similar rash in family members or new soap or detergent?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 86.81,
      "end_seconds": 92.56,
      "duration_seconds": 5.75,
      "text": "No, no similar rash in family members or new soap or detergent."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 93.82,
      "end_seconds": 97.8,
      "duration_seconds": 3.98,
      "text": "Did you get oozing, fever or breathing trouble?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 99.4,
      "end_seconds": 104.66,
      "duration_seconds": 5.26,
      "text": "I haven't had oozing, fever or breathing trouble, no."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 106.31,
      "end_seconds": 109.78,
      "duration_seconds": 3.47,
      "text": "How are your joints, any aches elsewhere?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 110.9,
      "end_seconds": 112.47,
      "duration_seconds": 1.57,
      "text": "No, nothing there."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 118.45,
      "end_seconds": 119.76,
      "duration_seconds": 1.31,
      "text": "Neurologically, anything strange?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 124.99,
      "end_seconds": 127.08,
      "duration_seconds": 2.09,
      "text": "No weakness or anything."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 128.54,
      "end_seconds": 133.44,
      "duration_seconds": 4.9,
      "text": "So, what about family history, any illnesses that run in the family?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 134.36,
      "end_seconds": 136.8,
      "duration_seconds": 2.44,
      "text": "My sister has thyroid problems."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 152.75,
      "end_seconds": 156.9,
      "duration_seconds": 4.15,
      "text": "Right, any long-term health problems I should know about?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 157.72,
      "end_seconds": 162.38,
      "duration_seconds": 4.66,
      "text": "Yeah, I have eczema, for about a year."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 164.27,
      "end_seconds": 168.41,
      "duration_seconds": 4.14,
      "text": "Which tablets or creams or inhalers do you use?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 169.68,
      "end_seconds": 171.62,
      "duration_seconds": 1.94,
      "text": "Hydrocortisone cream, when needed."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 173.57,
      "end_seconds": 179.45,
      "duration_seconds": 5.88,
      "text": "Any allergies I should know about? Just so I get the full picture."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 180.97,
      "end_seconds": 185.41,
      "duration_seconds": 4.44,
      "text": "No, uh, none that I know of."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 186.76,
      "end_seconds": 188.13,
      "duration_seconds": 1.37,
      "text": "What about alcohol?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 190.01,
      "end_seconds": 192.61,
      "duration_seconds": 2.6,
      "text": "I don't drink at all."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 193.86,
      "end_seconds": 194.65,
      "duration_seconds": 0.79,
      "text": "Any smoking?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 196.18,
      "end_seconds": 199.54,
      "duration_seconds": 3.36,
      "text": "I stopped smoking about two years back."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 200.74,
      "end_seconds": 202.12,
      "duration_seconds": 1.38,
      "text": "Do you work?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 203.17,
      "end_seconds": 208.71,
      "duration_seconds": 5.54,
      "text": "I run a small shop, so I'm on my feet a lot."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 209.81,
      "end_seconds": 211.06,
      "duration_seconds": 1.25,
      "text": "How about exercise?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 215.56,
      "end_seconds": 219.33,
      "duration_seconds": 3.77,
      "text": "Not really, I don't get much exercise."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 221.35,
      "end_seconds": 222.95,
      "duration_seconds": 1.6,
      "text": "What's your diet like?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 224.96,
      "end_seconds": 229.76,
      "duration_seconds": 4.8,
      "text": "I eat out quite a lot, to be honest."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 232.21,
      "end_seconds": 235.36,
      "duration_seconds": 3.15,
      "text": "If you're comfortable, I'll examine you now."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 243.42,
      "end_seconds": 244.53,
      "duration_seconds": 1.11,
      "text": "No problem."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 245.4,
      "end_seconds": 246.68,
      "duration_seconds": 1.28,
      "text": "I'll go gently."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 254.54,
      "end_seconds": 261.13,
      "duration_seconds": 6.59,
      "text": "There are dry red patches in the creases of both elbows with scratch marks."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 261.64,
      "end_seconds": 262.74,
      "duration_seconds": 1.1,
      "text": "No problem."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 263.78,
      "end_seconds": 265.11,
      "duration_seconds": 1.33,
      "text": "I'll go gently."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 276.79,
      "end_seconds": 279.51,
      "duration_seconds": 2.72,
      "text": "No signs of infection, no crusting."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 284.88,
      "end_seconds": 306.85,
      "duration_seconds": 21.97,
      "text": "Okay, you can sit up. I'm going to put you on mometasone cream, once a day, for two weeks. That should help with eczema. Moisturise right after a bath, thick creams are better than lotions, and use a mild soap. Let's review you in two weeks. Ask me anything before you go."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 307.47,
      "end_seconds": 312.89,
      "duration_seconds": 5.42,
      "text": "Hmm, no, I think that's everything. Thank you, doctor."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 313.6,
      "end_seconds": 315.37,
      "duration_seconds": 1.77,
      "text": "Okay, bye for now."
    }
  ]
}