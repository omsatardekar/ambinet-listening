{
  "schema_version": "1.0",
  "encounter_id": "00166",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.03,
      "end_seconds": 5.24,
      "duration_seconds": 4.21,
      "text": "Doctor? Hi. I hope I've got the right time."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.58,
      "end_seconds": 11.63,
      "duration_seconds": 4.05,
      "text": "You're fine, sit down. So, what brings you in?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 12.56,
      "end_seconds": 19.39,
      "duration_seconds": 6.83,
      "text": "I wanted to to get a lump feeling in the throat looked at."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 20.97,
      "end_seconds": 23.09,
      "duration_seconds": 2.12,
      "text": "And when did that start?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 24.18,
      "end_seconds": 26.36,
      "duration_seconds": 2.18,
      "text": "About... well, ten days."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 27.12,
      "end_seconds": 32.15,
      "duration_seconds": 5.03,
      "text": "What about a cough at night, have you noticed that?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 33.56,
      "end_seconds": 35.95,
      "duration_seconds": 2.39,
      "text": "Yes, for about two weeks."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 36.61,
      "end_seconds": 39.79,
      "duration_seconds": 3.18,
      "text": "what about heartburn, have you noticed that?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 41.23,
      "end_seconds": 43.84,
      "duration_seconds": 2.61,
      "text": "Yes, for about two weeks."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 44.98,
      "end_seconds": 48.75,
      "duration_seconds": 3.77,
      "text": "And what do you do to cope with it?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 50.71,
      "end_seconds": 54.17,
      "duration_seconds": 3.46,
      "text": "Right, I get some relief from antacids."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 63.04,
      "end_seconds": 65.71,
      "duration_seconds": 2.67,
      "text": "And what do you usually eat?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 67.8,
      "end_seconds": 70.98,
      "duration_seconds": 3.18,
      "text": "Mostly home-cooked food, rice and vegetables."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 71.62,
      "end_seconds": 74.22,
      "duration_seconds": 2.6,
      "text": "are you working at the moment?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 75.74,
      "end_seconds": 79.55,
      "duration_seconds": 3.81,
      "text": "Yes, I'm a nurse on a busy ward."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 81.62,
      "end_seconds": 85.54,
      "duration_seconds": 3.92,
      "text": "Tell me what you take day to day."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 86.87,
      "end_seconds": 95.51,
      "duration_seconds": 8.64,
      "text": "Seretide inhaler. I take it twice a day. Amlodipine, 5 milligrams, maybe, once a day for my pressure."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 96.89,
      "end_seconds": 101.35,
      "duration_seconds": 4.46,
      "text": "did you happen to bring the box or the paperwork?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 101.89,
      "end_seconds": 108.89,
      "duration_seconds": 7.0,
      "text": "No, it's at home. I had telmisartan at one point, but I'm off it now."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 110.09,
      "end_seconds": 114.33,
      "duration_seconds": 4.24,
      "text": "Tell me about your health in general, any ongoing conditions?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 114.84,
      "end_seconds": 118.62,
      "duration_seconds": 3.78,
      "text": "I've had asthma for about ten years now."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 120.0,
      "end_seconds": 120.7,
      "duration_seconds": 0.7,
      "text": "Mm."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 122.32,
      "end_seconds": 124.28,
      "duration_seconds": 1.96,
      "text": "yes, high blood pressure"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 125.84,
      "end_seconds": 133.18,
      "duration_seconds": 7.34,
      "text": "alright, high blood pressure, that matches what I have here any sign of pain on exertion?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 134.95,
      "end_seconds": 140.59,
      "duration_seconds": 5.64,
      "text": "Uh, no, I haven't had any pain on exertion."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 141.26,
      "end_seconds": 146.24,
      "duration_seconds": 4.98,
      "text": "Okay, have you noticed trouble swallowing, black stools or anaemia?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 147.72,
      "end_seconds": 152.49,
      "duration_seconds": 4.77,
      "text": "no, no trouble swallowing, black stools or anaemia"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 154.24,
      "end_seconds": 157.06,
      "duration_seconds": 2.82,
      "text": "Any problems with your joints or muscles?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 157.66,
      "end_seconds": 159.21,
      "duration_seconds": 1.55,
      "text": "No, nothing there."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 169.16,
      "end_seconds": 172.65,
      "duration_seconds": 3.49,
      "text": "Before we go on, a few quick readings."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 181.21,
      "end_seconds": 182.0,
      "duration_seconds": 0.79,
      "text": "One second..."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 202.69,
      "end_seconds": 209.58,
      "duration_seconds": 6.89,
      "text": "Okay: SpO2 99 percent on room air, pressure 108 over 72, temperature 36.7, pulse 78."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 211.5,
      "end_seconds": 213.03,
      "duration_seconds": 1.53,
      "text": "is that normal?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 214.73,
      "end_seconds": 219.51,
      "duration_seconds": 4.78,
      "text": "they help build the the picture, I'll tell you more soon"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 221.15,
      "end_seconds": 224.08,
      "duration_seconds": 2.93,
      "text": "I'd like to examine you now"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 237.47,
      "end_seconds": 238.54,
      "duration_seconds": 1.07,
      "text": "Yes, doctor."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 239.76,
      "end_seconds": 241.88,
      "duration_seconds": 2.12,
      "text": "hold that position for me"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 250.62,
      "end_seconds": 252.78,
      "duration_seconds": 2.16,
      "text": "tummy is soft and non-tender"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 256.36,
      "end_seconds": 286.64,
      "duration_seconds": 30.28,
      "text": "That's all I need, thank you. Right, here's what I'm thinking. This looks most like gastro-oesophageal reflux. That's my thinking for now, and it may change as we learn more. I'd also keep gastritis in mind. I'd like to arrange an ECG for chest discomfort. I want an upper endoscopy done, that's for persistent reflux. What I'm giving you is esomeprazole, 40 milligrams, before breakfast, for eight weeks. That should help with reflux."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 288.26,
      "end_seconds": 292.35,
      "duration_seconds": 4.09,
      "text": "Should I keep taking it if I feel better?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 293.96,
      "end_seconds": 311.03,
      "duration_seconds": 17.07,
      "text": "smaller dinners, earlier in the evening, and prop up the head of the bed with a couple of extra pillows. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 312.63,
      "end_seconds": 314.37,
      "duration_seconds": 1.74,
      "text": "okay, fair enough"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 316.11,
      "end_seconds": 318.64,
      "duration_seconds": 2.53,
      "text": "Let's review you in eight weeks."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 319.63,
      "end_seconds": 323.71,
      "duration_seconds": 4.08,
      "text": "Alright, I'll put it in my diary."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 325.27,
      "end_seconds": 326.7,
      "duration_seconds": 1.43,
      "text": "any last questions?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 327.3,
      "end_seconds": 330.09,
      "duration_seconds": 2.79,
      "text": "thank you for your time"
    }
  ]
}