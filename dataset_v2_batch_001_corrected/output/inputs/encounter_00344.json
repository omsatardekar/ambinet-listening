{
  "schema_version": "1.0",
  "encounter_id": "00344",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 0.87,
      "end_seconds": 6.86,
      "duration_seconds": 5.99,
      "text": "Doctor, I've brought them through. The observations are done, whenever you need them."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.54,
      "end_seconds": 12.67,
      "duration_seconds": 4.13,
      "text": "Okay, thanks. Hi, how can I help today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 13.31,
      "end_seconds": 21.38,
      "duration_seconds": 8.07,
      "text": "Mainly a mole that has changed. There's a couple of other things, but that's the main one."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 22.96,
      "end_seconds": 28.34,
      "duration_seconds": 5.38,
      "text": "When did you first notice it? Just so I get the full picture."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 29.69,
      "end_seconds": 33.26,
      "duration_seconds": 3.57,
      "text": "It's been like this since last Tuesday."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 34.83,
      "end_seconds": 40.77,
      "duration_seconds": 5.94,
      "text": "Alright, what about a bit of itching on it, have you noticed that?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 42.35,
      "end_seconds": 50.6,
      "duration_seconds": 8.25,
      "text": "Yes, I have. About bit of itching on it, honestly, once or twice a day."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 51.74,
      "end_seconds": 58.11,
      "duration_seconds": 6.37,
      "text": "Have you had a mole that has changed before, or is this the first time?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 58.73,
      "end_seconds": 64.3,
      "duration_seconds": 5.57,
      "text": "I had a similar thing last winter. It went away."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 66.26,
      "end_seconds": 73.38,
      "duration_seconds": 7.12,
      "text": "Let me check a few things. Any history of skin cancer, fever or lumps in the armpit?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 74.61,
      "end_seconds": 82.27,
      "duration_seconds": 7.66,
      "text": "I haven't had history of skin cancer, fever or lumps in the armpit, no."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 83.14,
      "end_seconds": 87.27,
      "duration_seconds": 4.13,
      "text": "Okay, have you had any pain or history of sunburn?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 89.09,
      "end_seconds": 93.67,
      "duration_seconds": 4.58,
      "text": "I haven't had pain or history of sunburn, no."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 94.62,
      "end_seconds": 98.08,
      "duration_seconds": 3.46,
      "text": "How are your joints, any aches elsewhere?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 99.04,
      "end_seconds": 101.21,
      "duration_seconds": 2.17,
      "text": "No, joints are fine."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 104.95,
      "end_seconds": 108.88,
      "duration_seconds": 3.93,
      "text": "Anything with your heart, like skipped beats or fainting?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 110.2,
      "end_seconds": 115.05,
      "duration_seconds": 4.85,
      "text": "My heart's been fine, as far as I know."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 120.19,
      "end_seconds": 122.27,
      "duration_seconds": 2.08,
      "text": "Alright, do you drink alcohol?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 123.01,
      "end_seconds": 127.01,
      "duration_seconds": 4.0,
      "text": "I gave up drinking about three years ago."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 128.29,
      "end_seconds": 129.23,
      "duration_seconds": 0.94,
      "text": "Any smoking?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 130.81,
      "end_seconds": 134.47,
      "duration_seconds": 3.66,
      "text": "I stopped smoking about two years back."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 135.37,
      "end_seconds": 137.4,
      "duration_seconds": 2.03,
      "text": "Do you exercise at all?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 139.02,
      "end_seconds": 144.02,
      "duration_seconds": 5.0,
      "text": "I go to the gym a couple of times a week."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 146.07,
      "end_seconds": 147.31,
      "duration_seconds": 1.24,
      "text": "What's your job?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 149.1,
      "end_seconds": 152.2,
      "duration_seconds": 3.1,
      "text": "I teach at a primary school."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 153.99,
      "end_seconds": 156.02,
      "duration_seconds": 2.03,
      "text": "Anything special about your diet?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 157.8,
      "end_seconds": 161.39,
      "duration_seconds": 3.59,
      "text": "I try to avoid too much sugar."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 171.84,
      "end_seconds": 173.24,
      "duration_seconds": 1.4,
      "text": "Any regular medication?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 174.14,
      "end_seconds": 175.7,
      "duration_seconds": 1.56,
      "text": "No, nothing regular."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 176.25,
      "end_seconds": 179.55,
      "duration_seconds": 3.3,
      "text": "Have you had to have anything operated on?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 181.55,
      "end_seconds": 186.33,
      "duration_seconds": 4.78,
      "text": "Yes, I had my appendix out, about eight years ago."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 187.69,
      "end_seconds": 192.38,
      "duration_seconds": 4.69,
      "text": "What about allergies, to medicines or foods or anything else?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 194.21,
      "end_seconds": 196.57,
      "duration_seconds": 2.36,
      "text": "Yes, shellfish. I get vomiting."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 199.43,
      "end_seconds": 204.02,
      "duration_seconds": 4.59,
      "text": "Do you have any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 205.78,
      "end_seconds": 209.58,
      "duration_seconds": 3.8,
      "text": "I have high cholesterol, for nearly five years."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 210.26,
      "end_seconds": 216.23,
      "duration_seconds": 5.97,
      "text": "Yes, high cholesterol is known to us, good to have that clear."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 225.38,
      "end_seconds": 232.63,
      "duration_seconds": 7.25,
      "text": "Okay, so the vitals from earlier. Saturation 97 percent, heart rate 73, pressure 113 over 68."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 234.38,
      "end_seconds": 235.93,
      "duration_seconds": 1.55,
      "text": "Good, thank you."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 238.32,
      "end_seconds": 241.2,
      "duration_seconds": 2.88,
      "text": "If you're comfortable, I'll examine you now."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 252.78,
      "end_seconds": 253.48,
      "duration_seconds": 0.7,
      "text": "Sure."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 254.85,
      "end_seconds": 256.05,
      "duration_seconds": 1.2,
      "text": "I'll go gently."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 264.1,
      "end_seconds": 267.47,
      "duration_seconds": 3.37,
      "text": "I can't feel any glands in the armpit."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 271.96,
      "end_seconds": 301.86,
      "duration_seconds": 29.9,
      "text": "Right, you can sit back down. So where does that leave us? My working impression is a pigmented lesion that needs to be looked at more closely. I want to be honest that this is an impression, not a final answer. An atypical mole is also on my list. Please use sunscreen and cover up in the midday sun, and check your skin once a month. Alright, I'll see you out."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 302.91,
      "end_seconds": 306.91,
      "duration_seconds": 4.0,
      "text": "That's everything I wanted to ask. Thank you."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 308.82,
      "end_seconds": 310.19,
      "duration_seconds": 1.37,
      "text": "See you then."
    }
  ]
}