{
  "schema_version": "1.0",
  "encounter_id": "00315",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.76,
      "end_seconds": 5.31,
      "duration_seconds": 4.55,
      "text": "Hello? Doctor? They told me to come straight in."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.33,
      "end_seconds": 13.88,
      "duration_seconds": 6.55,
      "text": "Yes, come in, take a seat. What can I do for you today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 14.55,
      "end_seconds": 18.37,
      "duration_seconds": 3.82,
      "text": "Thank you for fitting us in, doctor."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 19.5,
      "end_seconds": 25.94,
      "duration_seconds": 6.44,
      "text": "It's sharp heel pain with my first steps in the morning, mostly."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 27.92,
      "end_seconds": 30.66,
      "duration_seconds": 2.74,
      "text": "Since when have you had this?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 32.27,
      "end_seconds": 36.13,
      "duration_seconds": 3.86,
      "text": "Oh, I've had it since last Tuesday."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 36.7,
      "end_seconds": 39.33,
      "duration_seconds": 2.63,
      "text": "Ah. How intense does it get?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 40.21,
      "end_seconds": 43.68,
      "duration_seconds": 3.47,
      "text": "I mean, I'd call it mild."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 45.15,
      "end_seconds": 48.37,
      "duration_seconds": 3.22,
      "text": "Does it come along with anything else?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 50.08,
      "end_seconds": 62.12,
      "duration_seconds": 12.04,
      "text": "When it starts I tend to get a tender spot on the sole as well. I've also had limping a bit by the evening, since yesterday."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 63.01,
      "end_seconds": 66.08,
      "duration_seconds": 3.07,
      "text": "Would you call it mild or bad?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 67.91,
      "end_seconds": 87.23,
      "duration_seconds": 19.32,
      "text": "I'd give it a six, uh, out of ten. The tender spot on the sole? That's been for four weeks. As for tender spot on the sole, about a eight out of ten."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 102.31,
      "end_seconds": 105.8,
      "duration_seconds": 3.49,
      "text": "Okay, a few measurements, then we'll continue."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 113.65,
      "end_seconds": 115.71,
      "duration_seconds": 2.06,
      "text": "Okay, give me a moment..."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 130.07,
      "end_seconds": 139.8,
      "duration_seconds": 9.73,
      "text": "Okay: temperature 36.7, pulse is 83 beats a minute, respiratory rate 15, oxygen saturation is 98 percent, pressure 119 over 80."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 142.43,
      "end_seconds": 145.88,
      "duration_seconds": 3.45,
      "text": "Let me examine, it won't take long."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 147.79,
      "end_seconds": 148.87,
      "duration_seconds": 1.08,
      "text": "Mm, okay."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 150.07,
      "end_seconds": 152.26,
      "duration_seconds": 2.19,
      "text": "Tell me if anything hurts."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 164.68,
      "end_seconds": 168.81,
      "duration_seconds": 4.13,
      "text": "Pressing on the inner heel brings on the pain."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 169.78,
      "end_seconds": 170.48,
      "duration_seconds": 0.7,
      "text": "Alright."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 171.99,
      "end_seconds": 173.35,
      "duration_seconds": 1.36,
      "text": "I'll go gently."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 185.79,
      "end_seconds": 188.21,
      "duration_seconds": 2.42,
      "text": "The ankle and foot move fully."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 193.97,
      "end_seconds": 194.91,
      "duration_seconds": 0.94,
      "text": "No problem."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 198.51,
      "end_seconds": 200.49,
      "duration_seconds": 1.98,
      "text": "Good, that's the examination."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 218.29,
      "end_seconds": 224.79,
      "duration_seconds": 6.5,
      "text": "Let me check a few things. Any fever, numbness in the foot or back pain?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 225.46,
      "end_seconds": 233.97,
      "duration_seconds": 8.51,
      "text": "Right, you know, no fever, numbness in the foot or back pain, none of it."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 235.11,
      "end_seconds": 239.15,
      "duration_seconds": 4.04,
      "text": "Any pain in other joints or recent injury at all?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 241.09,
      "end_seconds": 243.38,
      "duration_seconds": 2.29,
      "text": "No, none of those."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 244.67,
      "end_seconds": 249.03,
      "duration_seconds": 4.36,
      "text": "Any change in your bowel habit or your stomach generally?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 250.22,
      "end_seconds": 253.54,
      "duration_seconds": 3.32,
      "text": "No, um, all normal there."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 254.15,
      "end_seconds": 258.38,
      "duration_seconds": 4.23,
      "text": "Any pins and needles or loss of strength anywhere?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 261.34,
      "end_seconds": 264.57,
      "duration_seconds": 3.23,
      "text": "Hmm, no, nothing like that."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 266.32,
      "end_seconds": 270.93,
      "duration_seconds": 4.61,
      "text": "What about allergies, to medicines or foods or anything else?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 272.7,
      "end_seconds": 276.35,
      "duration_seconds": 3.65,
      "text": "I don't have any known medication allergies."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 277.09,
      "end_seconds": 281.87,
      "duration_seconds": 4.78,
      "text": "Do you have any medical conditions I should know about?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 282.8,
      "end_seconds": 286.11,
      "duration_seconds": 3.31,
      "text": "No, none that I know of."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 286.87,
      "end_seconds": 289.67,
      "duration_seconds": 2.8,
      "text": "What kind of work do you do?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 290.93,
      "end_seconds": 294.88,
      "duration_seconds": 3.95,
      "text": "I work on a farm, it's quite physical."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 295.39,
      "end_seconds": 297.96,
      "duration_seconds": 2.57,
      "text": "And what do you usually eat?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 299.78,
      "end_seconds": 303.08,
      "duration_seconds": 3.3,
      "text": "Mostly home-cooked food, rice and vegetables."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 303.87,
      "end_seconds": 305.17,
      "duration_seconds": 1.3,
      "text": "Any regular medication?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 307.13,
      "end_seconds": 310.37,
      "duration_seconds": 3.24,
      "text": "No, I don't take anything regularly."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 324.23,
      "end_seconds": 327.99,
      "duration_seconds": 3.76,
      "text": "Have you had to have anything operated on?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 329.82,
      "end_seconds": 334.9,
      "duration_seconds": 5.08,
      "text": "So, just a lump removed from my back, years ago."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 336.52,
      "end_seconds": 368.45,
      "duration_seconds": 31.93,
      "text": "Taking everything into account, I'd lean towards plantar fasciitis. Another possibility is a stress reaction in the bone. I'll request an X-ray of the foot, it'll help with heel pain. Roll the sole over a bottle and stretch the calf against a wall twice a day. Cut down on salt and fried food for now, it really does make a difference. I'd like you to see physiotherapy as well, and I'll write the referral."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 369.64,
      "end_seconds": 372.4,
      "duration_seconds": 2.76,
      "text": "Alright, uh, thank you."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 373.43,
      "end_seconds": 385.44,
      "duration_seconds": 12.01,
      "text": "The thing that would worry me is if the symptoms get worse. If that happens, go to emergency. Come back in six weeks. Look after yourself."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 386.35,
      "end_seconds": 389.13,
      "duration_seconds": 2.78,
      "text": "Thank you for your time."
    }
  ]
}