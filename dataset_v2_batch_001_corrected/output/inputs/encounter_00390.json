{
  "schema_version": "1.0",
  "encounter_id": "00390",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.64,
      "end_seconds": 4.09,
      "duration_seconds": 3.45,
      "text": "Morning, doctor, I hope I'm not interrupting."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.18,
      "end_seconds": 10.8,
      "duration_seconds": 4.62,
      "text": "Alright, no trouble at all, come in. What's been bothering you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 11.42,
      "end_seconds": 19.01,
      "duration_seconds": 7.59,
      "text": "Doctor, thank you for seeing us. He's been having a little chest discomfort, doctor."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 20.76,
      "end_seconds": 23.13,
      "duration_seconds": 2.37,
      "text": "How intense does it get?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 28.81,
      "end_seconds": 46.96,
      "duration_seconds": 18.15,
      "text": "It's severe, honestly. Oh, and breathlessness on slopes. That's been about the same, two months. A bit of dizziness with the new tablets was there, but it's gone away on its own."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 48.21,
      "end_seconds": 50.55,
      "duration_seconds": 2.34,
      "text": "Let me measure a few things."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 59.58,
      "end_seconds": 61.48,
      "duration_seconds": 1.9,
      "text": "Just relax your arm..."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 72.37,
      "end_seconds": 81.48,
      "duration_seconds": 9.11,
      "text": "Okay: temperature is 36.6 degrees, blood pressure 126 over 79. And oxygen saturation is 99 percent, heart rate 77."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 83.11,
      "end_seconds": 86.47,
      "duration_seconds": 3.36,
      "text": "Right, if you're comfortable, I'll examine you now."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 104.96,
      "end_seconds": 106.13,
      "duration_seconds": 1.17,
      "text": "Yes, doctor."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 107.43,
      "end_seconds": 108.82,
      "duration_seconds": 1.39,
      "text": "I'll go gently."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 115.84,
      "end_seconds": 119.36,
      "duration_seconds": 3.52,
      "text": "Chest is clear and heart sounds are normal."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 120.85,
      "end_seconds": 122.6,
      "duration_seconds": 1.75,
      "text": "Let me press here."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 140.53,
      "end_seconds": 143.76,
      "duration_seconds": 3.23,
      "text": "The scar on your chest has healed well."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 146.46,
      "end_seconds": 154.9,
      "duration_seconds": 8.44,
      "text": "That's fine, sit up. Let me check a few things. Any bruising, fainting, coughing up blood or pain at rest?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 155.99,
      "end_seconds": 163.56,
      "duration_seconds": 7.57,
      "text": "Right, I haven't had bruising, fainting, coughing up blood or pain at rest, no."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 164.99,
      "end_seconds": 169.1,
      "duration_seconds": 4.11,
      "text": "What about your tummy and bowels, anything unusual there?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 169.99,
      "end_seconds": 172.47,
      "duration_seconds": 2.48,
      "text": "No, that side's been fine."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 173.97,
      "end_seconds": 176.61,
      "duration_seconds": 2.64,
      "text": "Any rashes or skin problems otherwise?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 178.48,
      "end_seconds": 179.4,
      "duration_seconds": 0.92,
      "text": "Skin's normal."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 180.27,
      "end_seconds": 183.78,
      "duration_seconds": 3.51,
      "text": "Let's go through your medication. What are you taking?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 185.49,
      "end_seconds": 193.46,
      "duration_seconds": 7.97,
      "text": "He is on clopidogrel, 75 milligrams, once a day for the stent, I give it to him."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 194.78,
      "end_seconds": 196.01,
      "duration_seconds": 1.23,
      "text": "Is that long-standing?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 197.91,
      "end_seconds": 205.35,
      "duration_seconds": 7.44,
      "text": "For two years. It's amlodipine, 5 milligrams, once a day for my pressure, doctor."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 214.83,
      "end_seconds": 218.18,
      "duration_seconds": 3.35,
      "text": "Do you have any known allergies at all?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 218.87,
      "end_seconds": 223.41,
      "duration_seconds": 4.54,
      "text": "Hmm, none, as far as I'm aware."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 224.73,
      "end_seconds": 230.56,
      "duration_seconds": 5.83,
      "text": "I'm not sure that's right. I seem to recall a problem with codeine."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 232.54,
      "end_seconds": 235.77,
      "duration_seconds": 3.23,
      "text": "Maybe, but I don't recall it."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 237.3,
      "end_seconds": 245.69,
      "duration_seconds": 8.39,
      "text": "Alright, so that's unclear. I'll record what each of you said. So, does anything run in the family?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 247.74,
      "end_seconds": 251.79,
      "duration_seconds": 4.05,
      "text": "My sister has epilepsy. My grandmother had breast cancer."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 252.6,
      "end_seconds": 254.62,
      "duration_seconds": 2.02,
      "text": "Any surgery in your history?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 256.2,
      "end_seconds": 261.0,
      "duration_seconds": 4.8,
      "text": "Just a stent put in my heart, two years ago."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 262.77,
      "end_seconds": 264.01,
      "duration_seconds": 1.24,
      "text": "How about exercise?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 265.4,
      "end_seconds": 269.46,
      "duration_seconds": 4.06,
      "text": "Not really, I don't get much exercise."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 270.97,
      "end_seconds": 273.18,
      "duration_seconds": 2.21,
      "text": "How do you eat, generally?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 274.0,
      "end_seconds": 276.33,
      "duration_seconds": 2.33,
      "text": "I skip breakfast most days."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 277.19,
      "end_seconds": 278.35,
      "duration_seconds": 1.16,
      "text": "And your work?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 279.8,
      "end_seconds": 282.98,
      "duration_seconds": 3.18,
      "text": "I drive a delivery van all day."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 283.77,
      "end_seconds": 287.39,
      "duration_seconds": 3.62,
      "text": "Any long-term health problems I should know about?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 289.33,
      "end_seconds": 301.9,
      "duration_seconds": 12.57,
      "text": "I have heart disease, for five years. I just want to get back to normal, really. I kept putting it off, which I know isn't sensible."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 303.12,
      "end_seconds": 304.44,
      "duration_seconds": 1.32,
      "text": "Okay, keep going."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 306.03,
      "end_seconds": 311.74,
      "duration_seconds": 5.71,
      "text": "I've got diabetes. I have high blood pressure, for two years."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 320.28,
      "end_seconds": 336.36,
      "duration_seconds": 16.08,
      "text": "So where does that leave us? I think we're dealing with stable recovery after the heart event at this stage. Another possibility is medication side effects. There's nothing new for me to start or arrange today. Alright, I'll see you out."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 336.93,
      "end_seconds": 339.95,
      "duration_seconds": 3.02,
      "text": "No, you've explained it well. Thanks."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 340.47,
      "end_seconds": 341.3,
      "duration_seconds": 0.83,
      "text": "Take care."
    }
  ]
}