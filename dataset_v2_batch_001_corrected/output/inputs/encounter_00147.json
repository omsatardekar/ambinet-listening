{
  "schema_version": "1.0",
  "encounter_id": "00147",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 0.76,
      "end_seconds": 10.26,
      "duration_seconds": 9.5,
      "text": "Doctor, the patient's with us now. I did the usual checks at the front, so just say when you want them."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 11.31,
      "end_seconds": 14.72,
      "duration_seconds": 3.41,
      "text": "Perfect, thanks. Hello there, so what's the trouble?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 16.13,
      "end_seconds": 23.48,
      "duration_seconds": 7.35,
      "text": "Hmm, you know, hello, doctor, I came in with them, if that's okay."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 25.46,
      "end_seconds": 29.81,
      "duration_seconds": 4.35,
      "text": "That's fine, sit down. We'll go through it together."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 31.66,
      "end_seconds": 37.53,
      "duration_seconds": 5.87,
      "text": "Well, um, I've been having headaches for a while."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 38.09,
      "end_seconds": 40.83,
      "duration_seconds": 2.74,
      "text": "What medicines do you take regularly?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 42.22,
      "end_seconds": 50.65,
      "duration_seconds": 8.43,
      "text": "It's a... um, um, I can't remember what it's called. It's a round yellow one."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 51.75,
      "end_seconds": 54.31,
      "duration_seconds": 2.56,
      "text": "Do you remember what it's for?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 55.69,
      "end_seconds": 71.33,
      "duration_seconds": 15.64,
      "text": "For my pressure, I believe. My wife sets them out for me, I just take what I'm given. It's alendronate, 70 milligrams, maybe, once a week."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 72.44,
      "end_seconds": 76.55,
      "duration_seconds": 4.11,
      "text": "Did you happen to bring the box or the paperwork?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 81.5,
      "end_seconds": 95.41,
      "duration_seconds": 13.91,
      "text": "Right, not with me. I'll bring it next time. Spironolactone, 25 milligrams, once a day for my heart. It's paracetamol, when it hurts."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 96.69,
      "end_seconds": 98.77,
      "duration_seconds": 2.08,
      "text": "Do you know the dose?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 99.42,
      "end_seconds": 100.44,
      "duration_seconds": 1.02,
      "text": "500 milligrams."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 102.2,
      "end_seconds": 103.64,
      "duration_seconds": 1.44,
      "text": "Is that long-standing?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 105.26,
      "end_seconds": 111.66,
      "duration_seconds": 6.4,
      "text": "For about a year. I was on losartan before. I stopped taking it."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 123.21,
      "end_seconds": 126.17,
      "duration_seconds": 2.96,
      "text": "How far back does it go?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 127.62,
      "end_seconds": 130.58,
      "duration_seconds": 2.96,
      "text": "Around two weeks, I think."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 132.36,
      "end_seconds": 137.47,
      "duration_seconds": 5.11,
      "text": "It was closer to three weeks, you know, doctor."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 138.48,
      "end_seconds": 143.09,
      "duration_seconds": 4.61,
      "text": "Okay, so roughly two to three weeks. Is that right?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 144.82,
      "end_seconds": 148.07,
      "duration_seconds": 3.25,
      "text": "Yeah, yes, somewhere around that."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 149.83,
      "end_seconds": 154.42,
      "duration_seconds": 4.59,
      "text": "Okay, give me more detail on it, whatever comes to mind."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 156.36,
      "end_seconds": 167.12,
      "duration_seconds": 10.76,
      "text": "Uh, I'd say severe. It settles a little with painkillers. It's worse with coughing. I'd say every other day."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 168.54,
      "end_seconds": 171.75,
      "duration_seconds": 3.21,
      "text": "Does it come along with anything else?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 173.73,
      "end_seconds": 180.52,
      "duration_seconds": 6.79,
      "text": "Um, when it starts I tend to get neck tightness as well."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 181.45,
      "end_seconds": 189.29,
      "duration_seconds": 7.84,
      "text": "Well, I was just going to say that the main thing is—"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 189.39,
      "end_seconds": 196.66,
      "duration_seconds": 7.27,
      "text": "Sorry to cut in, doctor, quick question: shall I bring the trolley in now or later?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 197.27,
      "end_seconds": 203.02,
      "duration_seconds": 5.75,
      "text": "Later, thanks. Please go on. What about occasional nausea, have you noticed that?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 205.01,
      "end_seconds": 236.91,
      "duration_seconds": 31.9,
      "text": "Yes, uh, for three weeks. As for occasional nausea, maybe a eight out of ten on a bad day. It happens a couple of times a week. I've had blurry vision at times too, you know, for one week. Okay, so the neck tightness? That's been since last Tuesday. I mean, about neck tightness, it comes and goes."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 237.65,
      "end_seconds": 244.61,
      "duration_seconds": 6.96,
      "text": "Have you had headaches for a while before, or is this the first time?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 245.41,
      "end_seconds": 251.74,
      "duration_seconds": 6.33,
      "text": "Hmm, a bit, last winter. It settled by itself back then."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 264.98,
      "end_seconds": 270.05,
      "duration_seconds": 5.07,
      "text": "And what about jaw pain on chewing, head injury or fever?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 271.43,
      "end_seconds": 278.34,
      "duration_seconds": 6.91,
      "text": "Well, no jaw pain on chewing, head injury or fever, none of it."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 279.76,
      "end_seconds": 283.11,
      "duration_seconds": 3.35,
      "text": "Did you get confusion, weakness or seizures?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 284.19,
      "end_seconds": 287.55,
      "duration_seconds": 3.36,
      "text": "No, no confusion, weakness or seizures."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 288.13,
      "end_seconds": 290.42,
      "duration_seconds": 2.29,
      "text": "Anything unusual with passing urine?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 291.4,
      "end_seconds": 293.86,
      "duration_seconds": 2.46,
      "text": "No, that's all fine."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 295.94,
      "end_seconds": 303.41,
      "duration_seconds": 7.47,
      "text": "Before I prescribe anything, any allergies? I ask because it helps me narrow things down."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 304.1,
      "end_seconds": 305.14,
      "duration_seconds": 1.04,
      "text": "No allergies."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 310.5,
      "end_seconds": 313.55,
      "duration_seconds": 3.05,
      "text": "Okay, do you get any exercise?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 314.44,
      "end_seconds": 319.32,
      "duration_seconds": 4.88,
      "text": "I walk for about half an hour most days."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 320.11,
      "end_seconds": 322.07,
      "duration_seconds": 1.96,
      "text": "Are you living with family?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 323.3,
      "end_seconds": 327.9,
      "duration_seconds": 4.6,
      "text": "I stay with my daughter and her family."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 328.99,
      "end_seconds": 333.96,
      "duration_seconds": 4.97,
      "text": "What about family history, any illnesses that run in the family?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 337.48,
      "end_seconds": 339.46,
      "duration_seconds": 1.98,
      "text": "My brother has asthma."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 343.73,
      "end_seconds": 349.05,
      "duration_seconds": 5.32,
      "text": "Right, do you have any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 349.85,
      "end_seconds": 361.56,
      "duration_seconds": 11.71,
      "text": "High blood pressure, for nearly five years. I've got thin bones. I've had heart failure for about ten years now."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 362.59,
      "end_seconds": 363.37,
      "duration_seconds": 0.78,
      "text": "Anything more?"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 369.14,
      "end_seconds": 378.36,
      "duration_seconds": 9.22,
      "text": "Here are the numbers, doctor. Temperature 36.7, respiratory rate 14. Blood pressure 121 over 69, saturation 98 percent, pulse 69."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 379.65,
      "end_seconds": 381.48,
      "duration_seconds": 1.83,
      "text": "Right, good, thank you."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 383.33,
      "end_seconds": 386.52,
      "duration_seconds": 3.19,
      "text": "I'll examine you now, bear with me."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 387.31,
      "end_seconds": 388.01,
      "duration_seconds": 0.7,
      "text": "Okay."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 389.81,
      "end_seconds": 391.85,
      "duration_seconds": 2.04,
      "text": "Almost done with this part."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 401.14,
      "end_seconds": 405.91,
      "duration_seconds": 4.77,
      "text": "Visual fields are full to confrontation and the optic discs look normal."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 407.84,
      "end_seconds": 408.54,
      "duration_seconds": 0.7,
      "text": "Okay."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 409.74,
      "end_seconds": 412.18,
      "duration_seconds": 2.44,
      "text": "Let me just check something."
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 423.86,
      "end_seconds": 427.67,
      "duration_seconds": 3.81,
      "text": "Power and reflexes are equal on both sides."
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 433.64,
      "end_seconds": 448.42,
      "duration_seconds": 14.78,
      "text": "Okay, you can sit up. Putting it all together, I don't have a clear answer today: a headache disorder of uncertain type is possible, and so is a secondary headache we should exclude."
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 450.34,
      "end_seconds": 453.55,
      "duration_seconds": 3.21,
      "text": "Yeah, is it something serious, doctor?"
    },
    {
      "segment_id": "SEG0059",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 454.27,
      "end_seconds": 469.7,
      "duration_seconds": 15.43,
      "text": "It's reasonable to be concerned, but right now a headache disorder of uncertain type is my leading thought, not anything worse. I think an MRI of the brain makes sense here, for headaches with visual symptoms."
    },
    {
      "segment_id": "SEG0060",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 471.26,
      "end_seconds": 473.03,
      "duration_seconds": 1.77,
      "text": "That sounds sensible."
    },
    {
      "segment_id": "SEG0061",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 476.85,
      "end_seconds": 503.02,
      "duration_seconds": 26.17,
      "text": "I think an eye pressure check makes sense here, for headache with blurred vision. Note down each headache with the date, time and what you were doing. Let's get you seen by a neurologist, I'll arrange the letter. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0062",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 504.3,
      "end_seconds": 505.0,
      "duration_seconds": 0.7,
      "text": "Understood."
    },
    {
      "segment_id": "SEG0063",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 506.25,
      "end_seconds": 512.32,
      "duration_seconds": 6.07,
      "text": "I'll want another look after the scan. Call the clinic if you need us."
    },
    {
      "segment_id": "SEG0064",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 512.84,
      "end_seconds": 516.09,
      "duration_seconds": 3.25,
      "text": "Right, thanks so much, doctor."
    },
    {
      "segment_id": "SEG0065",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 518.16,
      "end_seconds": 518.86,
      "duration_seconds": 0.7,
      "text": "Goodbye."
    }
  ]
}