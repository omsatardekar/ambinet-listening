{
  "schema_version": "1.0",
  "encounter_id": "00258",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.24,
      "end_seconds": 9.08,
      "duration_seconds": 7.84,
      "text": "Hi doctor, sorry, the lift was out and I had to take the stairs."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 11.17,
      "end_seconds": 15.71,
      "duration_seconds": 4.54,
      "text": "Right on time. Sit, please. How can I help?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 16.34,
      "end_seconds": 19.71,
      "duration_seconds": 3.37,
      "text": "Doctor, thank you for seeing us."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 20.56,
      "end_seconds": 23.81,
      "duration_seconds": 3.25,
      "text": "Please do. Extra information is always welcome."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 25.05,
      "end_seconds": 30.59,
      "duration_seconds": 5.54,
      "text": "So, I've been getting breathless walking short distances, doctor."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 36.35,
      "end_seconds": 39.07,
      "duration_seconds": 2.72,
      "text": "How far back does it go?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 40.17,
      "end_seconds": 55.69,
      "duration_seconds": 15.52,
      "text": "About... well, about a month. I kept putting it off, which I know isn't sensible. I'm not great at remembering details, so bear with me."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 56.23,
      "end_seconds": 58.65,
      "duration_seconds": 2.42,
      "text": "How intense does it get?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 60.7,
      "end_seconds": 62.05,
      "duration_seconds": 1.35,
      "text": "Severe, really."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 63.77,
      "end_seconds": 67.62,
      "duration_seconds": 3.85,
      "text": "Anything that tends to go along with it?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 68.26,
      "end_seconds": 101.0,
      "duration_seconds": 32.74,
      "text": "A feeling that I can't take a deep breath goes along with it, most of the time. The feeling that I can't take a deep breath? That's been for nearly five years. With feeling that I can't take a deep breath, about a three out of ten. Oh, I had occasional wheeze before. That's settled now, though."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 102.96,
      "end_seconds": 106.12,
      "duration_seconds": 3.16,
      "text": "Right, can I take your vitals now?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 117.25,
      "end_seconds": 118.93,
      "duration_seconds": 1.68,
      "text": "Just relax your arm..."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 132.7,
      "end_seconds": 140.09,
      "duration_seconds": 7.39,
      "text": "Okay: saturation 91 percent, heart rate 86, pressure 134 over 84. And respiratory rate 21."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 141.28,
      "end_seconds": 143.68,
      "duration_seconds": 2.4,
      "text": "Okay, a quick examination now."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 154.85,
      "end_seconds": 155.55,
      "duration_seconds": 0.7,
      "text": "Alright."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 157.53,
      "end_seconds": 159.81,
      "duration_seconds": 2.28,
      "text": "Almost done with this part."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 174.13,
      "end_seconds": 176.3,
      "duration_seconds": 2.17,
      "text": "No clubbing in the fingers."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 177.63,
      "end_seconds": 180.96,
      "duration_seconds": 3.33,
      "text": "Stay still while I have a look."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 190.78,
      "end_seconds": 195.35,
      "duration_seconds": 4.57,
      "text": "There are fine crackles at the bases of both lungs."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 198.93,
      "end_seconds": 200.78,
      "duration_seconds": 1.85,
      "text": "That's fine, sit up."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 208.48,
      "end_seconds": 212.37,
      "duration_seconds": 3.89,
      "text": "Okay, have you noticed coughing up blood or fever?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 212.93,
      "end_seconds": 217.68,
      "duration_seconds": 4.75,
      "text": "So, um, no, I'd have mentioned it."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 218.96,
      "end_seconds": 223.84,
      "duration_seconds": 4.88,
      "text": "Have you noticed night sweats, chest pain or leg swelling?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 225.93,
      "end_seconds": 230.45,
      "duration_seconds": 4.52,
      "text": "Right, uh, no, I'd have mentioned it."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 230.93,
      "end_seconds": 231.63,
      "duration_seconds": 0.7,
      "text": "Yes?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 233.69,
      "end_seconds": 235.98,
      "duration_seconds": 2.29,
      "text": "Is your mobility otherwise okay?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 237.65,
      "end_seconds": 240.8,
      "duration_seconds": 3.15,
      "text": "Uh, I move fine otherwise."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 242.59,
      "end_seconds": 245.53,
      "duration_seconds": 2.94,
      "text": "Right, any trouble with the waterworks?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 246.39,
      "end_seconds": 249.25,
      "duration_seconds": 2.86,
      "text": "Nothing there, you know, no."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 250.72,
      "end_seconds": 253.48,
      "duration_seconds": 2.76,
      "text": "Is there anything medical in your background?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 254.7,
      "end_seconds": 265.43,
      "duration_seconds": 10.73,
      "text": "I, I have asthma, for nearly five years. Yes, high blood pressure. I just want to get back to normal, really."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 266.14,
      "end_seconds": 269.97,
      "duration_seconds": 3.83,
      "text": "I see. Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 270.99,
      "end_seconds": 273.34,
      "duration_seconds": 2.35,
      "text": "No, nothing like that."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 274.45,
      "end_seconds": 277.2,
      "duration_seconds": 2.75,
      "text": "Are you on any tablets or medication?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 279.02,
      "end_seconds": 283.86,
      "duration_seconds": 4.84,
      "text": "Well, um, he takes Asthalin inhaler, when needed."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 284.1,
      "end_seconds": 284.8,
      "duration_seconds": 0.7,
      "text": "Sure."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 288.5,
      "end_seconds": 291.82,
      "duration_seconds": 3.32,
      "text": "He takes losartan, once a day."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 292.7,
      "end_seconds": 294.91,
      "duration_seconds": 2.21,
      "text": "How much do you take?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 296.0,
      "end_seconds": 297.48,
      "duration_seconds": 1.48,
      "text": "It's 50 milligrams."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 299.56,
      "end_seconds": 303.4,
      "duration_seconds": 3.84,
      "text": "Do you have any known allergies at all?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 304.82,
      "end_seconds": 308.42,
      "duration_seconds": 3.6,
      "text": "I don't have any known medication allergies."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 309.73,
      "end_seconds": 314.42,
      "duration_seconds": 4.69,
      "text": "Tell me about your routine, work, habits, that sort of thing."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 319.25,
      "end_seconds": 331.2,
      "duration_seconds": 11.95,
      "text": "Not really, I don't get much exercise. I stay with my daughter and her family. I eat out quite a lot, to be honest."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 333.21,
      "end_seconds": 345.33,
      "duration_seconds": 12.12,
      "text": "Right, here's what I'm thinking. The most likely explanation is chronic breathlessness that needs a proper work-up. I'd also keep a lung condition in mind."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 346.34,
      "end_seconds": 349.94,
      "duration_seconds": 3.6,
      "text": "Is it something serious, uh, doctor?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 351.02,
      "end_seconds": 360.11,
      "duration_seconds": 9.09,
      "text": "It's reasonable to be concerned, but right now chronic breathlessness that needs a proper work-up is my leading thought, not anything worse."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 367.24,
      "end_seconds": 370.57,
      "duration_seconds": 3.33,
      "text": "Let's get breathing tests, for chronic breathlessness."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 371.66,
      "end_seconds": 373.19,
      "duration_seconds": 1.53,
      "text": "That sounds sensible."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 374.65,
      "end_seconds": 383.92,
      "duration_seconds": 9.27,
      "text": "Try a daily walk and note how far you get before you need to stop. I'll want another look in four weeks."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 385.09,
      "end_seconds": 387.92,
      "duration_seconds": 2.83,
      "text": "So, okay, see you then."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 389.43,
      "end_seconds": 392.6,
      "duration_seconds": 3.17,
      "text": "Good. Let us know how you get on."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 394.1,
      "end_seconds": 400.52,
      "duration_seconds": 6.42,
      "text": "Yeah, I think that's clear. Thank you for being so thorough."
    }
  ]
}