{
  "schema_version": "1.0",
  "encounter_id": "00384",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.91,
      "end_seconds": 4.78,
      "duration_seconds": 3.87,
      "text": "Sorry I'm a few minutes behind, doctor."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.37,
      "end_seconds": 12.31,
      "duration_seconds": 5.94,
      "text": "so, yes, come in, take a seat. What can I do for you today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 14.17,
      "end_seconds": 20.99,
      "duration_seconds": 6.82,
      "text": "um, uh, hello, doctor, I came in with them, if that's okay"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 22.73,
      "end_seconds": 27.6,
      "duration_seconds": 4.87,
      "text": "that's fine, sit down we'll go through it it together"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 29.41,
      "end_seconds": 38.08,
      "duration_seconds": 8.67,
      "text": "well mainly the room spinning. There's a couple of other things but that's the main one"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 39.34,
      "end_seconds": 41.7,
      "duration_seconds": 2.36,
      "text": "how long have you had it?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 43.66,
      "end_seconds": 47.13,
      "duration_seconds": 3.47,
      "text": "I mean, I'd say three weeks, maybe."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 47.96,
      "end_seconds": 51.86,
      "duration_seconds": 3.9,
      "text": "I think it's been nearer a month actually"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 52.51,
      "end_seconds": 56.58,
      "duration_seconds": 4.07,
      "text": "okay so roughly three to four weeks. Is that right?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 58.21,
      "end_seconds": 60.13,
      "duration_seconds": 1.92,
      "text": "That sounds about right."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 61.43,
      "end_seconds": 69.93,
      "duration_seconds": 8.5,
      "text": "Tell me a bit more about it: how bad it gets how often and whether anything makes it better or worse."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 73.02,
      "end_seconds": 78.03,
      "duration_seconds": 5.01,
      "text": "I get some relief from lying still it's mild honestly"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 78.75,
      "end_seconds": 81.93,
      "duration_seconds": 3.18,
      "text": "any a ringing in your ear as well?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 83.74,
      "end_seconds": 96.44,
      "duration_seconds": 12.7,
      "text": "Yes actually. With ringing in my ear I'd say on and off. I've also had a bit of vomiting. Right there was nausea yes but that went away."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 115.06,
      "end_seconds": 121.14,
      "duration_seconds": 6.08,
      "text": "let me check a few things any numbness in the face or slurred speech?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 126.07,
      "end_seconds": 130.5,
      "duration_seconds": 4.43,
      "text": "no, no numbness in the face or slurred speech"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 131.15,
      "end_seconds": 134.43,
      "duration_seconds": 3.28,
      "text": "did you get headache, hearing loss or weakness?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 135.86,
      "end_seconds": 140.89,
      "duration_seconds": 5.03,
      "text": "I haven't had headache hearing loss or weakness no."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 142.1,
      "end_seconds": 144.57,
      "duration_seconds": 2.47,
      "text": "And your skin, any changes there?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 145.79,
      "end_seconds": 146.7,
      "duration_seconds": 0.91,
      "text": "skin's normal"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 147.29,
      "end_seconds": 151.41,
      "duration_seconds": 4.12,
      "text": "tell me about your health in general any ongoing conditions?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 152.83,
      "end_seconds": 171.05,
      "duration_seconds": 18.22,
      "text": "I have diabetes, for about a year i've had high blood pressure for nearly five years now it's the not knowing that gets to me i thought it would sort itself out, but it hasn't"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 172.73,
      "end_seconds": 184.87,
      "duration_seconds": 12.14,
      "text": "Yes, diabetes and and high blood pressure are known to us, good to have that clear. Any relatives with health problems I should be aware of?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 186.68,
      "end_seconds": 191.67,
      "duration_seconds": 4.99,
      "text": "My father was diabetic. Yeah my father had a stroke."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 193.0,
      "end_seconds": 195.45,
      "duration_seconds": 2.45,
      "text": "what about operations anything like that?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 196.15,
      "end_seconds": 201.17,
      "duration_seconds": 5.02,
      "text": "yes I had a hernia repair about five years back"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 210.36,
      "end_seconds": 214.14,
      "duration_seconds": 3.78,
      "text": "Which tablets or creams or inhalers do you use?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 216.08,
      "end_seconds": 231.12,
      "duration_seconds": 15.04,
      "text": "he is on Glycomet 500 milligrams twice a day for my sugar I give it to him. It's ramipril 5 milligrams every morning for my blood pressure doctor"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 232.92,
      "end_seconds": 237.92,
      "duration_seconds": 5.0,
      "text": "alright, are there any allergies on your record that I should check?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 239.73,
      "end_seconds": 243.87,
      "duration_seconds": 4.14,
      "text": "yeah, none, as far as I'm aware"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 245.06,
      "end_seconds": 254.13,
      "duration_seconds": 9.07,
      "text": "so, actually, I remember he had some kind of reaction to codeine before i couldn't swear to it"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 255.94,
      "end_seconds": 259.04,
      "duration_seconds": 3.1,
      "text": "Maybe, but I don't recall it."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 263.33,
      "end_seconds": 268.01,
      "duration_seconds": 4.68,
      "text": "fair enough, I'll write down both versions what about alcohol?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 269.65,
      "end_seconds": 272.19,
      "duration_seconds": 2.54,
      "text": "I don't drink at all"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 273.37,
      "end_seconds": 275.88,
      "duration_seconds": 2.51,
      "text": "Are you working at the moment?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 276.61,
      "end_seconds": 280.73,
      "duration_seconds": 4.12,
      "text": "Yes, I'm a nurse on a busy ward."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 282.7,
      "end_seconds": 284.75,
      "duration_seconds": 2.05,
      "text": "Are you active at all?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 286.74,
      "end_seconds": 289.57,
      "duration_seconds": 2.83,
      "text": "Barely, I'm mostly sedentary these days"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 305.37,
      "end_seconds": 307.83,
      "duration_seconds": 2.46,
      "text": "Can I take your vitals now?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 317.15,
      "end_seconds": 318.05,
      "duration_seconds": 0.9,
      "text": "Almost there..."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 331.34,
      "end_seconds": 341.9,
      "duration_seconds": 10.56,
      "text": "Okay: BP is 123 over 78, SpO2 99 percent on room air, temp 36.4 degrees, pulse is 71 beats a minute."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 343.29,
      "end_seconds": 346.2,
      "duration_seconds": 2.91,
      "text": "Is that alright, uh, doctor?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 347.05,
      "end_seconds": 350.93,
      "duration_seconds": 3.88,
      "text": "I'll interpret it it once I've examined you."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 353.77,
      "end_seconds": 356.24,
      "duration_seconds": 2.47,
      "text": "I'd like to examine you now"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 358.11,
      "end_seconds": 358.81,
      "duration_seconds": 0.7,
      "text": "Sure."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 360.44,
      "end_seconds": 362.84,
      "duration_seconds": 2.4,
      "text": "let me look at this properly"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 373.4,
      "end_seconds": 380.74,
      "duration_seconds": 7.34,
      "text": "When I turn your head to the right, your eyes flick sideways, that's called nystagmus."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 384.25,
      "end_seconds": 385.24,
      "duration_seconds": 0.99,
      "text": "go ahead"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 386.81,
      "end_seconds": 389.15,
      "duration_seconds": 2.34,
      "text": "Let me look at this properly."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 403.16,
      "end_seconds": 407.09,
      "duration_seconds": 3.93,
      "text": "Your walking is steady and the finger-nose test is normal."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 411.14,
      "end_seconds": 446.18,
      "duration_seconds": 35.04,
      "text": "good, that's the examination. Okay, thinking it through, I don't have a clear answer today: benign positional vertigo is possible, and so is a migraine-related dizziness. A hearing test is what I'd like next, for tinnitus and vertigo. Let's use betahistine, 16 milligrams, three times a day, for two weeks. It's for vertigo. There's a simple head manoeuvre we can do, and I'll show you how to repeat it at home"
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 448.09,
      "end_seconds": 453.79,
      "duration_seconds": 5.7,
      "text": "get up slowly from lying down and sit for a a moment first"
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 454.11,
      "end_seconds": 470.6,
      "duration_seconds": 16.49,
      "text": "I follow cut back on tea, coffee and fizzy drinks for a couple of weeks and see how things settle if you get weakness, slurred speech or a severe headache with the dizziness, that's the point to come in urgently"
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 472.65,
      "end_seconds": 476.14,
      "duration_seconds": 3.49,
      "text": "Oh, yes, I'll keep that in mind."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 476.68,
      "end_seconds": 478.74,
      "duration_seconds": 2.06,
      "text": "come back in two weeks"
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 480.82,
      "end_seconds": 483.14,
      "duration_seconds": 2.32,
      "text": "Okay, I'll book that."
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 484.01,
      "end_seconds": 487.96,
      "duration_seconds": 3.95,
      "text": "okay I think we're finished. Is everything clear?"
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 489.8,
      "end_seconds": 493.43,
      "duration_seconds": 3.63,
      "text": "No um you've explained it well. Thanks."
    },
    {
      "segment_id": "SEG0059",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 494.53,
      "end_seconds": 495.83,
      "duration_seconds": 1.3,
      "text": "see you then"
    }
  ]
}