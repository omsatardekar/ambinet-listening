{
  "schema_version": "1.0",
  "encounter_id": "00373",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.06,
      "end_seconds": 4.4,
      "duration_seconds": 3.34,
      "text": "Hello doctor, sorry, am I early?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.42,
      "end_seconds": 13.87,
      "duration_seconds": 5.45,
      "text": "Yes, come in, take a seat. What can I do for you today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 15.23,
      "end_seconds": 23.27,
      "duration_seconds": 8.04,
      "text": "so the thing is, you know, I've got a burning pain in the upper tummy"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 23.93,
      "end_seconds": 26.27,
      "duration_seconds": 2.34,
      "text": "how far back does it go?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 28.2,
      "end_seconds": 41.9,
      "duration_seconds": 13.7,
      "text": "Probably about four days. Yeah. I told myself I'd wait and see, and here I am. I kept putting it off, which I know isn't sensible."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 42.52,
      "end_seconds": 52.95,
      "duration_seconds": 10.43,
      "text": "Tell me a bit more about it: how bad it gets, how often, and whether anything makes it better or worse."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 54.53,
      "end_seconds": 63.91,
      "duration_seconds": 9.38,
      "text": "I'd say mild. Spicy food definitely sets it off. Antacids helps a bit. Honestly, once or twice a day."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 64.45,
      "end_seconds": 67.07,
      "duration_seconds": 2.62,
      "text": "I'll check your pressure and pulse"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 79.42,
      "end_seconds": 80.77,
      "duration_seconds": 1.35,
      "text": "Okay, one second..."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 91.46,
      "end_seconds": 100.75,
      "duration_seconds": 9.29,
      "text": "Okay: temp 36.4 degrees, SpO2 97 percent on room air. And heart rate 79, pressure 127 over 72, respiratory rate 17."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 102.6,
      "end_seconds": 106.12,
      "duration_seconds": 3.52,
      "text": "Let me examine, it won't take long."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 107.76,
      "end_seconds": 111.72,
      "duration_seconds": 3.96,
      "text": "A little pressure here, tell me if it's tender."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 122.8,
      "end_seconds": 125.04,
      "duration_seconds": 2.24,
      "text": "No guarding and no lumps."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 128.65,
      "end_seconds": 131.23,
      "duration_seconds": 2.58,
      "text": "Thanks, please take a seat again."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 146.72,
      "end_seconds": 150.46,
      "duration_seconds": 3.74,
      "text": "Any black stools, weight loss or vomiting blood?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 151.79,
      "end_seconds": 155.0,
      "duration_seconds": 3.21,
      "text": "none, as far as I know"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 159.94,
      "end_seconds": 161.97,
      "duration_seconds": 2.03,
      "text": "Is your chest okay generally?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 162.98,
      "end_seconds": 164.86,
      "duration_seconds": 1.88,
      "text": "No problems with breathing."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 166.67,
      "end_seconds": 169.24,
      "duration_seconds": 2.57,
      "text": "Have you got any chronic problems?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 170.11,
      "end_seconds": 173.89,
      "duration_seconds": 3.78,
      "text": "I've had acid reflux for five years now."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 175.18,
      "end_seconds": 178.7,
      "duration_seconds": 3.52,
      "text": "What medicines are you taking at the moment?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 180.77,
      "end_seconds": 192.85,
      "duration_seconds": 12.08,
      "text": "Omeprazole. I take it 20 milligrams, once a day. It's a relief to finally sit down and talk about it. Gelusil, after meals."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 194.68,
      "end_seconds": 199.67,
      "duration_seconds": 4.99,
      "text": "Do you have any allergies to medicines, food, anything at all?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 201.74,
      "end_seconds": 204.61,
      "duration_seconds": 2.87,
      "text": "Yes, I'm allergic to eggs."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 213.38,
      "end_seconds": 215.73,
      "duration_seconds": 2.35,
      "text": "have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 216.31,
      "end_seconds": 218.78,
      "duration_seconds": 2.47,
      "text": "No, never had any surgery."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 237.21,
      "end_seconds": 241.16,
      "duration_seconds": 3.95,
      "text": "right, and what do you do for a living?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 241.93,
      "end_seconds": 245.46,
      "duration_seconds": 3.53,
      "text": "I work night shifts at a warehouse."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 246.62,
      "end_seconds": 248.43,
      "duration_seconds": 1.81,
      "text": "Do you live alone?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 250.39,
      "end_seconds": 253.49,
      "duration_seconds": 3.1,
      "text": "Yes, I live on my own."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 254.56,
      "end_seconds": 256.53,
      "duration_seconds": 1.97,
      "text": "Anything special about your diet?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 257.85,
      "end_seconds": 261.71,
      "duration_seconds": 3.86,
      "text": "I try to avoid too much sugar."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 262.52,
      "end_seconds": 268.02,
      "duration_seconds": 5.5,
      "text": "Okay, so my impression is this: It fits best with gastritis."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 269.6,
      "end_seconds": 272.14,
      "duration_seconds": 2.54,
      "text": "Do you think it's serious?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 274.08,
      "end_seconds": 284.93,
      "duration_seconds": 10.85,
      "text": "I understand the worry. At the moment I'd say it's gastritis, and we'll know more once the an H. pylori test is back."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 296.71,
      "end_seconds": 301.2,
      "duration_seconds": 4.49,
      "text": "I think an H. pylori test makes sense here, for dyspepsia"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 302.31,
      "end_seconds": 303.79,
      "duration_seconds": 1.48,
      "text": "Fine by me."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 307.02,
      "end_seconds": 316.09,
      "duration_seconds": 9.07,
      "text": "Avoid spicy, oily food and don't take anti-inflammatory painkillers on an empty stomach. Please come and see me in four weeks."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 317.13,
      "end_seconds": 321.08,
      "duration_seconds": 3.95,
      "text": "I'll make the appointment on my way out."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 322.65,
      "end_seconds": 325.53,
      "duration_seconds": 2.88,
      "text": "Ask me anything before you go."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 328.18,
      "end_seconds": 332.72,
      "duration_seconds": 4.54,
      "text": "So, one thing: no, actually that's all. Thanks."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 333.22,
      "end_seconds": 334.66,
      "duration_seconds": 1.44,
      "text": "Safe journey home."
    }
  ]
}