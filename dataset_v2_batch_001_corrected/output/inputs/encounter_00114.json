{
  "schema_version": "1.0",
  "encounter_id": "00114",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.18,
      "end_seconds": 5.02,
      "duration_seconds": 3.84,
      "text": "Hi, doctor. Is this the right room?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.66,
      "end_seconds": 10.3,
      "duration_seconds": 3.64,
      "text": "Not at all, please sit. What's the problem?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 11.36,
      "end_seconds": 13.18,
      "duration_seconds": 1.82,
      "text": "It's heartburn, mostly."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 14.27,
      "end_seconds": 16.32,
      "duration_seconds": 2.05,
      "text": "And when did that start?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 17.6,
      "end_seconds": 30.93,
      "duration_seconds": 13.33,
      "text": "About... well, about a month. I kept putting it off, which I know isn't sensible. I took the morning off to come in today."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 32.18,
      "end_seconds": 34.54,
      "duration_seconds": 2.36,
      "text": "How often does it happen?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 36.15,
      "end_seconds": 38.96,
      "duration_seconds": 2.81,
      "text": "It sort of comes and goes."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 39.83,
      "end_seconds": 42.71,
      "duration_seconds": 2.88,
      "text": "Any food coming back up as well?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 43.73,
      "end_seconds": 51.61,
      "duration_seconds": 7.88,
      "text": "Yes, about the same, about a week. About food coming back up, I'd call it severe."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 54.55,
      "end_seconds": 56.51,
      "duration_seconds": 1.96,
      "text": "Any drug or food allergies?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 57.15,
      "end_seconds": 63.69,
      "duration_seconds": 6.54,
      "text": "Not currently, but as a youngster sulfa drugs gave me a rash."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 65.78,
      "end_seconds": 68.7,
      "duration_seconds": 2.92,
      "text": "A few questions about your lifestyle now."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 69.7,
      "end_seconds": 81.19,
      "duration_seconds": 11.49,
      "text": "Mostly home-cooked food, rice and vegetables. I work on a farm, it's quite physical. I walk for about half an hour most days."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 82.12,
      "end_seconds": 86.43,
      "duration_seconds": 4.31,
      "text": "Which tablets or creams or inhalers do you use?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 88.1,
      "end_seconds": 93.34,
      "duration_seconds": 5.24,
      "text": "Losartan. I take it 50 milligrams, maybe, once a day."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 95.08,
      "end_seconds": 97.94,
      "duration_seconds": 2.86,
      "text": "Is the packet here, or the prescription?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 99.42,
      "end_seconds": 104.75,
      "duration_seconds": 5.33,
      "text": "No, it's at home. It's, It's Eno, when I get it."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 105.6,
      "end_seconds": 107.03,
      "duration_seconds": 1.43,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 108.92,
      "end_seconds": 112.9,
      "duration_seconds": 3.98,
      "text": "No, uh, never had any surgery."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 113.47,
      "end_seconds": 119.01,
      "duration_seconds": 5.54,
      "text": "What about your general health, any conditions you're being treated for?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 120.77,
      "end_seconds": 126.15,
      "duration_seconds": 5.38,
      "text": "Oh, I have high blood pressure, for about ten years."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 127.05,
      "end_seconds": 132.69,
      "duration_seconds": 5.64,
      "text": "Uh-huh. Alright, high blood pressure, that matches what I have here."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 145.87,
      "end_seconds": 150.09,
      "duration_seconds": 4.22,
      "text": "A few quick ones: pain on exertion or weight loss?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 151.17,
      "end_seconds": 155.13,
      "duration_seconds": 3.96,
      "text": "So, none, as far as I know."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 155.57,
      "end_seconds": 159.44,
      "duration_seconds": 3.87,
      "text": "Uh-huh. Have you noticed trouble swallowing or black stools?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 160.93,
      "end_seconds": 165.75,
      "duration_seconds": 4.82,
      "text": "I haven't had trouble swallowing or black stools, no."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 166.3,
      "end_seconds": 171.12,
      "duration_seconds": 4.82,
      "text": "Right, right. Right, has your heart given you any trouble?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 171.93,
      "end_seconds": 173.58,
      "duration_seconds": 1.65,
      "text": "Nothing like that."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 191.83,
      "end_seconds": 194.81,
      "duration_seconds": 2.98,
      "text": "A few measurements, then we'll continue."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 207.79,
      "end_seconds": 210.07,
      "duration_seconds": 2.28,
      "text": "Okay, give me a moment..."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 222.4,
      "end_seconds": 229.74,
      "duration_seconds": 7.34,
      "text": "Okay: pressure 113 over 74, SpO2 99 percent on room air, temp 36.9 degrees, pulse 71."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 231.71,
      "end_seconds": 235.0,
      "duration_seconds": 3.29,
      "text": "Okay, I need to examine you for this."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 236.43,
      "end_seconds": 238.98,
      "duration_seconds": 2.55,
      "text": "Let me look at this properly."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 253.51,
      "end_seconds": 255.48,
      "duration_seconds": 1.97,
      "text": "Tummy is soft and non-tender."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 259.13,
      "end_seconds": 260.81,
      "duration_seconds": 1.68,
      "text": "Good, that's the examination."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 278.27,
      "end_seconds": 304.11,
      "duration_seconds": 25.84,
      "text": "Let me tell you where I've got to. I think we're dealing with gastro-oesophageal reflux at this stage. It could also be gastritis, so we'll keep that open. We should do an ECG for chest discomfort. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose. Okay, we're done for today. Take care."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 305.13,
      "end_seconds": 307.96,
      "duration_seconds": 2.83,
      "text": "Thanks so much, um, doctor."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 309.8,
      "end_seconds": 311.09,
      "duration_seconds": 1.29,
      "text": "Right, take care."
    }
  ]
}