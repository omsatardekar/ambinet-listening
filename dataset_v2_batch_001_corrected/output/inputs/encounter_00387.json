    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 179.99,
      "end_seconds": 182.21,
      "duration_seconds": 2.22,
      "text": "Who do you live with?"
