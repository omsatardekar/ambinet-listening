      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 141.06,
      "end_seconds": 144.37,
      "duration_seconds": 3.31,
      "text": "no, I don't take anything regularly"
