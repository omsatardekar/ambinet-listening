      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 221.71,
      "end_seconds": 224.34,
      "duration_seconds": 2.63,
      "text": "well, I've had diabetes, yes"
