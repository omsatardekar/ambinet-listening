      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 192.73,
      "end_seconds": 198.38,
      "duration_seconds": 5.65,
      "text": "I run a small shop, so I'm on my feet a lot."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 199.0,
      "end_seconds": 200.21,
      "duration_seconds": 1.21,
      "text": "how's your diet?"
