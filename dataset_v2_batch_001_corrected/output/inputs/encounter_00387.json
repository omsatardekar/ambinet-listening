      "role": "PATIENT",
      "start_seconds": 152.0,
      "end_seconds": 162.63,
      "duration_seconds": 10.63,
      "text": "Hmm, years back I got itching all over from sulfa drugs, so I stay away from it now."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 170.55,
      "end_seconds": 172.55,
      "duration_seconds": 2.0,
      "text": "And alcohol, how much?"
