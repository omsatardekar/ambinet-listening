      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 201.96,
      "end_seconds": 203.51,
      "duration_seconds": 1.55,
      "text": "I'm mostly vegetarian."
