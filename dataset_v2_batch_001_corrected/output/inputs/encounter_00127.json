{
  "schema_version": "1.0",
  "encounter_id": "00127",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.67,
      "end_seconds": 4.16,
      "duration_seconds": 3.49,
      "text": "Sorry I'm a few minutes behind, doctor."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.9,
      "end_seconds": 10.52,
      "duration_seconds": 4.62,
      "text": "Of course, put it down anywhere. So, how can I help?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 11.49,
      "end_seconds": 16.17,
      "duration_seconds": 4.68,
      "text": "Morning, doctor. I'll stay and fill in anything that's missed."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 19.39,
      "end_seconds": 24.12,
      "duration_seconds": 4.73,
      "text": "Of course, please stay. It's helpful to have you here."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 25.85,
      "end_seconds": 28.46,
      "duration_seconds": 2.61,
      "text": "We came because of trouble sleeping."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 29.48,
      "end_seconds": 32.67,
      "duration_seconds": 3.19,
      "text": "How long has this been going on?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 34.21,
      "end_seconds": 36.13,
      "duration_seconds": 1.92,
      "text": "Probably two months. Yeah."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 37.17,
      "end_seconds": 47.1,
      "duration_seconds": 9.93,
      "text": "Tell me a bit more about it: how bad it gets, how often, and whether anything makes it better or worse."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 48.17,
      "end_seconds": 53.59,
      "duration_seconds": 5.42,
      "text": "Yeah, mostly severe. I get some relief from a warm bath."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 54.06,
      "end_seconds": 61.8,
      "duration_seconds": 7.74,
      "text": "And the other thing I wanted to mention is that I can't really—"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 61.9,
      "end_seconds": 66.71,
      "duration_seconds": 4.81,
      "text": "Tell the doctor about the other thing, that's what worries me."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 69.26,
      "end_seconds": 71.75,
      "duration_seconds": 2.49,
      "text": "I was getting to that!"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 73.67,
      "end_seconds": 77.36,
      "duration_seconds": 3.69,
      "text": "Have you been feeling exhausted in the day?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 78.86,
      "end_seconds": 89.42,
      "duration_seconds": 10.56,
      "text": "Yeah, that too. About feeling exhausted in the day, maybe a seven out of ten on a bad day."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 89.62,
      "end_seconds": 91.07,
      "duration_seconds": 1.45,
      "text": "Okay, keep going."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 91.85,
      "end_seconds": 99.24,
      "duration_seconds": 7.39,
      "text": "I've also had trouble concentrating. As for trouble concentrating, it feels severe to me."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_4",
      "role": "UNKNOWN",
      "start_seconds": 100.63,
      "end_seconds": 104.42,
      "duration_seconds": 3.79,
      "text": "Yes, that's right, that's how it was."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 105.47,
      "end_seconds": 108.92,
      "duration_seconds": 3.45,
      "text": "Any low mood or chest pain at all?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 110.32,
      "end_seconds": 124.41,
      "duration_seconds": 14.09,
      "text": "No, no low mood, no chest pain. I was waking up at three in the morning at one point, but that went away on its own."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 125.04,
      "end_seconds": 128.81,
      "duration_seconds": 3.77,
      "text": "And what about restless legs, snoring or heavy caffeine?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 130.59,
      "end_seconds": 135.41,
      "duration_seconds": 4.82,
      "text": "No restless legs, snoring or heavy caffeine, none of it."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 136.05,
      "end_seconds": 139.46,
      "duration_seconds": 3.41,
      "text": "Has your heart given you any trouble?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 140.97,
      "end_seconds": 145.92,
      "duration_seconds": 4.95,
      "text": "My heart's been fine, as far as I know."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 149.75,
      "end_seconds": 153.19,
      "duration_seconds": 3.44,
      "text": "Are you on any tablets or medication?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 154.61,
      "end_seconds": 167.66,
      "duration_seconds": 13.05,
      "text": "I'm on escitalopram, 10 milligrams, once a day. Telmisartan, 40 milligrams, once a day. I take melatonin, 3 milligrams, maybe, at night."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 170.75,
      "end_seconds": 176.07,
      "duration_seconds": 5.32,
      "text": "Okay, have you got the box or the prescription on you?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 181.57,
      "end_seconds": 183.6,
      "duration_seconds": 2.03,
      "text": "No, it's at home."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 184.37,
      "end_seconds": 189.73,
      "duration_seconds": 5.36,
      "text": "What about family history, any illnesses that run in the family?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 191.22,
      "end_seconds": 193.11,
      "duration_seconds": 1.89,
      "text": "My father was diabetic."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 194.93,
      "end_seconds": 196.29,
      "duration_seconds": 1.36,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 197.59,
      "end_seconds": 202.95,
      "duration_seconds": 5.36,
      "text": "I had my thyroid operated on a long time ago."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 203.93,
      "end_seconds": 207.95,
      "duration_seconds": 4.02,
      "text": "Moving on to your background, any past medical history?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 208.9,
      "end_seconds": 212.85,
      "duration_seconds": 3.95,
      "text": "I've had anxiety for five years now."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 214.54,
      "end_seconds": 215.24,
      "duration_seconds": 0.7,
      "text": "Ah."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 216.85,
      "end_seconds": 225.4,
      "duration_seconds": 8.55,
      "text": "I have high blood pressure, for two years. I thought it would sort itself out, but it hasn't."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 226.02,
      "end_seconds": 230.92,
      "duration_seconds": 4.9,
      "text": "Okay, I can see anxiety in your file as well."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 238.68,
      "end_seconds": 240.64,
      "duration_seconds": 1.96,
      "text": "What's your diet like?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 241.99,
      "end_seconds": 246.55,
      "duration_seconds": 4.56,
      "text": "I eat out quite a lot, to be honest."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 259.83,
      "end_seconds": 264.64,
      "duration_seconds": 4.81,
      "text": "Have you ever reacted badly to a medicine or food? Any allergies?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 266.63,
      "end_seconds": 275.4,
      "duration_seconds": 8.77,
      "text": "I think I reacted to some antibiotic once, years ago. I don't remember which one, or what happened exactly."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 276.98,
      "end_seconds": 279.5,
      "duration_seconds": 2.52,
      "text": "Let me measure a few things."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 289.19,
      "end_seconds": 290.92,
      "duration_seconds": 1.73,
      "text": "Rest your hand here..."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 301.29,
      "end_seconds": 311.51,
      "duration_seconds": 10.22,
      "text": "Okay: respiratory rate 17, BP is 114 over 69, oxygen saturation is 97 percent, pulse is 82 beats a minute, temperature 36.8."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 313.53,
      "end_seconds": 314.93,
      "duration_seconds": 1.4,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 318.77,
      "end_seconds": 335.92,
      "duration_seconds": 17.15,
      "text": "Don't worry, I'll go through it in a moment. So, based on your history, this looks most like insomnia, probably stress-related. The reason I say that is that the way you describe it fits together. We shouldn't forget a thyroid problem."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 336.61,
      "end_seconds": 339.75,
      "duration_seconds": 3.14,
      "text": "What are the chances it's something bad?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 340.56,
      "end_seconds": 361.46,
      "duration_seconds": 20.9,
      "text": "I understand the worry. At the moment I'd say it's insomnia, probably stress-related, and we'll know more once the a sleep study is back. Let me just check I've got this right. You've had trouble sleeping for two months, severe, and no snoring or low mood."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 362.44,
      "end_seconds": 363.9,
      "duration_seconds": 1.46,
      "text": "Mm, that's right."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 364.5,
      "end_seconds": 394.7,
      "duration_seconds": 30.2,
      "text": "Let's get a sleep study, for insomnia. Let's book a thyroid test to look into insomnia. Same wake-up time every day, no screens in the hour before bed, and no coffee after lunch. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose. I'd like you back in four weeks. Okay, we're done for today. Take care."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 400.19,
      "end_seconds": 402.6,
      "duration_seconds": 2.41,
      "text": "Nothing more from me, thanks."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 403.51,
      "end_seconds": 404.92,
      "duration_seconds": 1.41,
      "text": "All the best."
    }
  ]
}