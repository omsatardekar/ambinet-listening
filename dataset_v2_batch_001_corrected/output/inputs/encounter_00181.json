    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 177.97,
      "end_seconds": 179.94,
      "duration_seconds": 1.97,
      "text": "No, none of those."
