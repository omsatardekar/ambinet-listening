    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 81.93,
      "end_seconds": 84.28,
      "duration_seconds": 2.35,
      "text": "let me check your vitals now"
