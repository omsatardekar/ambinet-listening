      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 122.66,
      "end_seconds": 125.18,
      "duration_seconds": 2.52,
      "text": "So tell me if anything hurts."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 134.45,
      "end_seconds": 136.48,
      "duration_seconds": 2.03,
      "text": "the right leg looks normal"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 140.09,
      "end_seconds": 143.11,
      "duration_seconds": 3.02,
      "text": "that's all I need, thank you"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 161.98,
      "end_seconds": 166.46,
      "duration_seconds": 4.48,
      "text": "Did you get recent injury to the leg or breathlessness?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 168.12,
      "end_seconds": 171.09,
      "duration_seconds": 2.97,
      "text": "right, no, none of those"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 173.15,
      "end_seconds": 176.17,
      "duration_seconds": 3.02,
