    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 216.97,
      "end_seconds": 219.25,
      "duration_seconds": 2.28,
      "text": "How do you eat, generally?"
