      "role": "PATIENT",
      "start_seconds": 185.88,
      "end_seconds": 188.35,
      "duration_seconds": 2.47,
      "text": "No my breathing's been fine."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 189.9,
      "end_seconds": 192.88,
      "duration_seconds": 2.98,
      "text": "is your urine normal, no changes?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 193.71,
      "end_seconds": 196.26,
