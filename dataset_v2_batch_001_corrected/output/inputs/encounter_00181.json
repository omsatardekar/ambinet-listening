    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 107.09,
      "end_seconds": 116.82,
      "duration_seconds": 9.73,
      "text": "okay: blood pressure 128 over 78, SpO2 99 percent on room air, heart rate 105, temperature is 36.9 degrees"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 117.88,
      "end_seconds": 121.24,
      "duration_seconds": 3.36,
      "text": "Let's do the the physical part now."
