      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 181.77,
      "end_seconds": 184.95,
      "duration_seconds": 3.18,
      "text": "so so any breathing difficulties apart from this?"
