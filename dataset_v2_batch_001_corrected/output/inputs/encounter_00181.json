      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 237.43,
      "end_seconds": 240.73,
      "duration_seconds": 3.3,
      "text": "is there a family history of anything significant?"
