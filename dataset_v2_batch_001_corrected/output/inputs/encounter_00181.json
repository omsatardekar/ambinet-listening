    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 242.5,
      "end_seconds": 246.32,
      "duration_seconds": 3.82,
      "text": "um, my sister has thyroid problems"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 247.48,
      "end_seconds": 251.35,
      "duration_seconds": 3.87,
      "text": "which tablets or creams or inhalers do you use?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 253.26,
      "end_seconds": 268.23,
      "duration_seconds": 14.97,
      "text": "I mean, I take diclofenac, 50 milligrams, when needed for the joint pain. I've never really been one for hospitals. I wasn't sure whether to come in at all, to be honest."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 276.72,
      "end_seconds": 283.23,
      "duration_seconds": 6.51,
      "text": "have you got any chronic problems? These questions might sound routine, but they matter"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 284.54,
      "end_seconds": 287.7,
      "duration_seconds": 3.16,
      "text": "I've got arthritis in my knees."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 289.78,
      "end_seconds": 290.48,
      "duration_seconds": 0.7,
      "text": "yes?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 291.48,
      "end_seconds": 303.32,
      "duration_seconds": 11.84,
      "text": "Okay I can see arthritis in your knees in your file as well. Do you have any known allergies at all? I ask because it helps me narrow things down."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 304.09,
      "end_seconds": 306.86,
      "duration_seconds": 2.77,
      "text": "not that I know no"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 307.36,
      "end_seconds": 309.33,
      "duration_seconds": 1.97,
      "text": "any procedures or operations?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 310.06,
      "end_seconds": 313.19,
      "duration_seconds": 3.13,
      "text": "I had my gallbladder removed in 2016."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 314.03,
      "end_seconds": 319.4,
      "duration_seconds": 5.37,
      "text": "I want a D-dimer blood test done, that's for suspected DVT"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 321.1,
      "end_seconds": 322.62,
      "duration_seconds": 1.52,
      "text": "fine by me"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 323.29,
      "end_seconds": 347.2,
      "duration_seconds": 23.91,
      "text": "I'm sending you for a Doppler scan of the leg because of suspected DVT keep walking gently, and don't massage the calf do get help quickly if you get chest pain or sudden breathlessness i'd like to see you again after the scan before we finish, can you repeat the plan back to me?"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 351.9,
      "end_seconds": 357.12,
      "duration_seconds": 5.22,
      "text": "So I come back after the scan. Is that right?"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 358.6,
      "end_seconds": 361.23,
      "duration_seconds": 2.63,
      "text": "Yes, exactly right. Look after yourself."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 362.37,
      "end_seconds": 366.17,
      "duration_seconds": 3.8,
      "text": "that's everything I wanted to ask thank you"
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 366.75,
      "end_seconds": 368.48,
