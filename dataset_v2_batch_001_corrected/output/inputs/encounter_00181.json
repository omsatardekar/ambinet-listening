      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 230.34,
      "end_seconds": 235.43,
      "duration_seconds": 5.09,
      "text": "I live with my family, my husband and two kids."
