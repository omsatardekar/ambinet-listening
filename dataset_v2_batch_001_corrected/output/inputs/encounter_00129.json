{
  "schema_version": "1.0",
  "encounter_id": "00129",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.78,
      "end_seconds": 6.22,
      "duration_seconds": 5.44,
      "text": "Hello, um, doctor. Where would you like me?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.79,
      "end_seconds": 12.5,
      "duration_seconds": 4.71,
      "text": "Of course, put it down anywhere. So, how can I help?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 17.86,
      "end_seconds": 21.36,
      "duration_seconds": 3.5,
      "text": "Thank you for fitting us in, doctor."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_4",
      "role": "FAMILY_MEMBER",
      "start_seconds": 23.45,
      "end_seconds": 26.83,
      "duration_seconds": 3.38,
      "text": "She's been having occasional nausea, doctor."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 27.37,
      "end_seconds": 30.53,
      "duration_seconds": 3.16,
      "text": "How long has this been going on?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 32.6,
      "end_seconds": 35.9,
      "duration_seconds": 3.3,
      "text": "Ever since... since last Tuesday, really."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 36.59,
      "end_seconds": 40.31,
      "duration_seconds": 3.72,
      "text": "On a normal day, how strong is it?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 41.05,
      "end_seconds": 46.04,
      "duration_seconds": 4.99,
      "text": "A six out of ten, uh, I suppose."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 46.87,
      "end_seconds": 54.58,
      "duration_seconds": 7.71,
      "text": "And the other thing I wanted to mention is that I can't really—"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_4",
      "role": "FAMILY_MEMBER",
      "start_seconds": 54.68,
      "end_seconds": 62.01,
      "duration_seconds": 7.33,
      "text": "I mean, tell the doctor about the other thing, that's what worries me."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 63.83,
      "end_seconds": 72.51,
      "duration_seconds": 8.68,
      "text": "Okay, so I was getting to that! And, And blurry vision at times, too."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 73.92,
      "end_seconds": 77.7,
      "duration_seconds": 3.78,
      "text": "On a normal day, how strong is it?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 79.72,
      "end_seconds": 81.38,
      "duration_seconds": 1.66,
      "text": "It's moderate, honestly."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 83.46,
      "end_seconds": 90.15,
      "duration_seconds": 6.69,
      "text": "Let me check a few things. Any weakness, jaw pain on chewing or fever?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 91.8,
      "end_seconds": 106.57,
      "duration_seconds": 14.77,
      "text": "No, uh, no weakness, no jaw pain on chewing, no fever. I did have pressure behind the eyes at one point, but that went away on its own."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 108.38,
      "end_seconds": 113.57,
      "duration_seconds": 5.19,
      "text": "Let me check a few things. Any confusion, seizures or head injury?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 114.4,
      "end_seconds": 117.89,
      "duration_seconds": 3.49,
      "text": "None, as far as I know."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 119.94,
      "end_seconds": 122.19,
      "duration_seconds": 2.25,
      "text": "Has your skin been okay?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 123.37,
      "end_seconds": 124.44,
      "duration_seconds": 1.07,
      "text": "Skin's normal."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 125.79,
      "end_seconds": 130.32,
      "duration_seconds": 4.53,
      "text": "What about your general health, any conditions you're being treated for?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 131.45,
      "end_seconds": 150.5,
      "duration_seconds": 19.05,
      "text": "Uh, I have high blood pressure, for five years. Uh, I've had heart failure for nearly five years now. I've had low haemoglobin for two years now. Right, um, I've had anxiety, yes."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 152.43,
      "end_seconds": 159.91,
      "duration_seconds": 7.48,
      "text": "Hm, okay. Right, so anxiety is already on your record. We'll keep that in mind today."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 176.13,
      "end_seconds": 181.62,
      "duration_seconds": 5.49,
      "text": "Do you have any allergies to medicines, food, anything at all?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 182.87,
      "end_seconds": 195.31,
      "duration_seconds": 12.44,
      "text": "Hmm, there was some antibiotic, I was told I was allergic. But I couldn't tell you what it was called or what it did."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 196.39,
      "end_seconds": 198.45,
      "duration_seconds": 2.06,
      "text": "Do you get any exercise?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 203.55,
      "end_seconds": 208.16,
      "duration_seconds": 4.61,
      "text": "I walk for about half an hour most days."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 209.31,
      "end_seconds": 211.67,
      "duration_seconds": 2.36,
      "text": "Are you living with family?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 212.66,
      "end_seconds": 217.27,
      "duration_seconds": 4.61,
      "text": "I stay with my daughter and her family."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 219.36,
      "end_seconds": 221.95,
      "duration_seconds": 2.59,
      "text": "What medicines do you take regularly?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 223.72,
      "end_seconds": 231.02,
      "duration_seconds": 7.3,
      "text": "It's a... um, I can't remember what it's called. It's a small white one."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 232.19,
      "end_seconds": 234.93,
      "duration_seconds": 2.74,
      "text": "Do you remember what it's for?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 236.5,
      "end_seconds": 260.73,
      "duration_seconds": 24.23,
      "text": "For the fluid, I believe. My daughter sets them out for me, I just take what I'm given. I'm on iron tablets, once a day. Escitalopram, 10 milligrams, once a day. Well, it's paracetamol, 500 milligrams, when it hurts. Telmisartan I don't take anymore."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 275.16,
      "end_seconds": 279.01,
      "duration_seconds": 3.85,
      "text": "Do your parents or siblings have any long-term illnesses?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 280.18,
      "end_seconds": 282.49,
      "duration_seconds": 2.31,
      "text": "My mother has migraines."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 283.37,
      "end_seconds": 287.14,
      "duration_seconds": 3.77,
      "text": "Before we go on, a few quick readings."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 295.43,
      "end_seconds": 296.23,
      "duration_seconds": 0.8,
      "text": "One second..."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 305.26,
      "end_seconds": 311.02,
      "duration_seconds": 5.76,
      "text": "Okay: oxygen saturation is 98 percent, blood pressure 127 over 71, pulse 64."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 312.03,
      "end_seconds": 314.07,
      "duration_seconds": 2.04,
      "text": "Can I examine you now?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 315.56,
      "end_seconds": 318.4,
      "duration_seconds": 2.84,
      "text": "Let me look at this properly."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 327.52,
      "end_seconds": 331.36,
      "duration_seconds": 3.84,
      "text": "Power and reflexes are equal on both sides."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 333.07,
      "end_seconds": 335.63,
      "duration_seconds": 2.56,
      "text": "Just relax, I'll be quick."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 344.96,
      "end_seconds": 349.63,
      "duration_seconds": 4.67,
      "text": "Visual fields are full to confrontation and the optic discs look normal."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 351.47,
      "end_seconds": 352.73,
      "duration_seconds": 1.26,
      "text": "Yes, doctor."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 356.19,
      "end_seconds": 382.36,
      "duration_seconds": 26.17,
      "text": "Okay, finished. So where does that leave us? I think we're dealing with a headache disorder of uncertain type at this stage. I can't rule out a secondary headache we should exclude yet. Note down each headache with the date, time and what you were doing. See me again after the scan. Okay, we're done for today. Take care."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 384.03,
      "end_seconds": 386.17,
      "duration_seconds": 2.14,
      "text": "Thanks so much, doctor."
    }
  ]
}