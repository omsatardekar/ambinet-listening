{
  "schema_version": "1.0",
  "encounter_id": "00354",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.35,
      "end_seconds": 4.79,
      "duration_seconds": 3.44,
      "text": "Sorry I'm a few minutes behind, doctor."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.1,
      "end_seconds": 9.85,
      "duration_seconds": 3.75,
      "text": "You're fine, sit down. So, what brings you in?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 10.48,
      "end_seconds": 19.12,
      "duration_seconds": 8.64,
      "text": "Mainly fever and joint pains. There's a couple of other things, but that's the main one."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 20.21,
      "end_seconds": 23.89,
      "duration_seconds": 3.68,
      "text": "Tell me what you take day to day."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 25.02,
      "end_seconds": 29.4,
      "duration_seconds": 4.38,
      "text": "Dolo. I take it 650 milligrams, when it flares"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 30.08,
      "end_seconds": 32.84,
      "duration_seconds": 2.76,
      "text": "Since when have you had this?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 33.93,
      "end_seconds": 35.91,
      "duration_seconds": 1.98,
      "text": "about... well, six months"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 36.56,
      "end_seconds": 41.17,
      "duration_seconds": 4.61,
      "text": "Alright, on a normal day, how strong is it?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 42.54,
      "end_seconds": 46.07,
      "duration_seconds": 3.53,
      "text": "A three out of ten, I suppose."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 47.82,
      "end_seconds": 51.21,
      "duration_seconds": 3.39,
      "text": "Right, have you been feeling wiped out?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 55.98,
      "end_seconds": 62.68,
      "duration_seconds": 6.7,
      "text": "Yes, actually. A headache was there, but it's gone away on its own."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 75.03,
      "end_seconds": 79.45,
      "duration_seconds": 4.42,
      "text": "Let me check a few things. Any cough, bleeding or diarrhoea?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 80.96,
      "end_seconds": 83.78,
      "duration_seconds": 2.82,
      "text": "No, not any of them."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 85.72,
      "end_seconds": 89.05,
      "duration_seconds": 3.33,
      "text": "Have you noticed red eyes or neck stiffness?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 90.82,
      "end_seconds": 94.08,
      "duration_seconds": 3.26,
      "text": "No, um, none of those."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 94.58,
      "end_seconds": 98.66,
      "duration_seconds": 4.08,
      "text": "What about your tummy and bowels, anything unusual there?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 100.09,
      "end_seconds": 102.97,
      "duration_seconds": 2.88,
      "text": "Bowels are regular, nothing odd."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 104.75,
      "end_seconds": 107.11,
      "duration_seconds": 2.36,
      "text": "Is your chest okay generally?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 109.18,
      "end_seconds": 111.56,
      "duration_seconds": 2.38,
      "text": "no, my breathing's been fine"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 125.23,
      "end_seconds": 127.57,
      "duration_seconds": 2.34,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 128.48,
      "end_seconds": 129.95,
      "duration_seconds": 1.47,
      "text": "No operations, no."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 131.52,
      "end_seconds": 133.93,
      "duration_seconds": 2.41,
      "text": "Are you active at all?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 134.54,
      "end_seconds": 137.68,
      "duration_seconds": 3.14,
      "text": "Barely, I'm mostly sedentary these days."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 139.1,
      "end_seconds": 141.15,
      "duration_seconds": 2.05,
      "text": "Alright, what's your job?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 142.39,
      "end_seconds": 145.66,
      "duration_seconds": 3.27,
      "text": "I teach at a primary school."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 156.38,
      "end_seconds": 158.93,
      "duration_seconds": 2.55,
      "text": "Have you got any chronic problems?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 160.9,
      "end_seconds": 163.18,
      "duration_seconds": 2.28,
      "text": "I have high blood pressure."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 163.84,
      "end_seconds": 167.41,
      "duration_seconds": 3.57,
      "text": "Let's get your blood pressure and the other basics."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 177.84,
      "end_seconds": 178.68,
      "duration_seconds": 0.84,
      "text": "Almost there..."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 194.61,
      "end_seconds": 209.61,
      "duration_seconds": 15.0,
      "text": "Okay: BMI works out to 19.0, oxygen saturation is 98 percent, pulse is 90 beats a minute, weight 53 kilos, temp 38.1 degrees, blood pressure 116 over 67, height 167 centimetres."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 211.06,
      "end_seconds": 213.08,
      "duration_seconds": 2.02,
      "text": "Is that alright, doctor?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 214.41,
      "end_seconds": 217.3,
      "duration_seconds": 2.89,
      "text": "I'll come back to those numbers"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 218.89,
      "end_seconds": 221.7,
      "duration_seconds": 2.81,
      "text": "Let me have a look at you."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 223.34,
      "end_seconds": 225.1,
      "duration_seconds": 1.76,
      "text": "Let me press here."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 233.93,
      "end_seconds": 237.84,
      "duration_seconds": 3.91,
      "text": "Both wrists and several finger joints are puffy and tender."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 238.91,
      "end_seconds": 241.27,
      "duration_seconds": 2.36,
      "text": "just relax, I'll be quick"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 259.26,
      "end_seconds": 264.45,
      "duration_seconds": 5.19,
      "text": "A fine rash over the chest and back, not itchy to touch."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 267.53,
      "end_seconds": 286.13,
      "duration_seconds": 18.6,
      "text": "Okay, finished. So, based on the history and the examination, I think we're dealing with a viral fever with joint involvement, possibly chikungunya at this stage. That's my thinking for now, and it may change as we learn more."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 288.1,
      "end_seconds": 291.25,
      "duration_seconds": 3.15,
      "text": "is this going to go away?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 295.06,
      "end_seconds": 316.13,
      "duration_seconds": 21.07,
      "text": "I understand the worry. At the moment I'd say it's a viral fever with joint involvement, possibly chikungunya, and we'll know more once the a full blood count is back. Stop me if I've got anything wrong. You've had fever and joint pains for six months, and no bleeding or red eyes."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 316.96,
      "end_seconds": 317.66,
      "duration_seconds": 0.7,
      "text": "Exactly."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 319.33,
      "end_seconds": 324.03,
      "duration_seconds": 4.7,
      "text": "I'm going to order a full blood count, for fever."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 325.71,
      "end_seconds": 328.53,
      "duration_seconds": 2.82,
      "text": "Alright, when would that that be?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 330.56,
      "end_seconds": 341.17,
      "duration_seconds": 10.61,
      "text": "we should do a dengue test for fever. Avoid anti-inflammatory painkillers until we know it isn't dengue. Do get help quickly if the symptoms get worse"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 345.9,
      "end_seconds": 349.39,
      "duration_seconds": 3.49,
      "text": "Alright, I know what to look for."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 350.22,
      "end_seconds": 353.89,
      "duration_seconds": 3.67,
      "text": "I'd like to see you again in four days"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 354.71,
      "end_seconds": 356.88,
      "duration_seconds": 2.17,
      "text": "That works for me."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 357.89,
      "end_seconds": 361.3,
      "duration_seconds": 3.41,
      "text": "Okay, I think we're finished. Is everything clear?"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 364.98,
      "end_seconds": 367.26,
      "duration_seconds": 2.28,
      "text": "Thank you for your time."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 368.88,
      "end_seconds": 370.76,
      "duration_seconds": 1.88,
      "text": "Alright, bye for now."
    }
  ]
}