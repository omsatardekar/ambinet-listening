    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 82.14,
      "end_seconds": 87.32,
      "duration_seconds": 5.18,
      "text": "Do you have any allergies to medicines, food, anything at all?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 88.14,
      "end_seconds": 95.2,
      "duration_seconds": 7.06,
      "text": "Years back I got a rash from ibuprofen, so I stay away from it now."
