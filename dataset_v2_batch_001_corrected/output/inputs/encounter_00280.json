{
  "schema_version": "1.0",
  "encounter_id": "00280",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.06,
      "end_seconds": 9.2,
      "duration_seconds": 8.14,
      "text": "Hi, you know, doctor, I brought my bag, is it fine to leave it here?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 10.13,
      "end_seconds": 14.96,
      "duration_seconds": 4.83,
      "text": "Of course, put it down anywhere. So, how can I help?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 16.88,
      "end_seconds": 21.46,
      "duration_seconds": 4.58,
      "text": "Hmm, I wanted to get diarrhoea looked at."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 22.23,
      "end_seconds": 24.76,
      "duration_seconds": 2.53,
      "text": "Since when have you had this?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 25.59,
      "end_seconds": 27.61,
      "duration_seconds": 2.02,
      "text": "About... well, one week."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 28.47,
      "end_seconds": 33.57,
      "duration_seconds": 5.1,
      "text": "Okay, give me more detail on it, whatever comes to mind."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 35.08,
      "end_seconds": 44.41,
      "duration_seconds": 9.33,
      "text": "Yes, eating and drinking milk. That makes it worse. Honestly, all the time. About a four out of ten."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 46.49,
      "end_seconds": 49.24,
      "duration_seconds": 2.75,
      "text": "Any vomiting or rash at all?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 50.62,
      "end_seconds": 53.86,
      "duration_seconds": 3.24,
      "text": "So, no, no vomiting or rash."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 55.7,
      "end_seconds": 58.09,
      "duration_seconds": 2.39,
      "text": "Any black stools or recent antibiotics?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 59.19,
      "end_seconds": 62.58,
      "duration_seconds": 3.39,
      "text": "No, no black stools or recent antibiotics."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 64.65,
      "end_seconds": 68.57,
      "duration_seconds": 3.92,
      "text": "Anything with your heart, like skipped beats or fainting?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 69.66,
      "end_seconds": 71.09,
      "duration_seconds": 1.43,
      "text": "Nothing like that."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 72.17,
      "end_seconds": 75.13,
      "duration_seconds": 2.96,
      "text": "Right, are you living with family?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 77.92,
      "end_seconds": 82.28,
      "duration_seconds": 4.36,
      "text": "I stay with my daughter and her family."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 87.25,
      "end_seconds": 90.44,
      "duration_seconds": 3.19,
      "text": "What kind of work do you do?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 90.97,
      "end_seconds": 94.73,
      "duration_seconds": 3.76,
      "text": "I work on a farm, it's quite physical."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 95.56,
      "end_seconds": 98.02,
      "duration_seconds": 2.46,
      "text": "And what do you usually eat?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 100.01,
      "end_seconds": 102.83,
      "duration_seconds": 2.82,
      "text": "Mostly home-cooked food, rice and vegetables."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 104.28,
      "end_seconds": 108.29,
      "duration_seconds": 4.01,
      "text": "Any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 109.29,
      "end_seconds": 112.89,
      "duration_seconds": 3.6,
      "text": "No, nothing, I've generally been healthy."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 124.06,
      "end_seconds": 126.98,
      "duration_seconds": 2.92,
      "text": "Are you on any regular medication?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 128.92,
      "end_seconds": 129.94,
      "duration_seconds": 1.02,
      "text": "Nothing, no."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 140.91,
      "end_seconds": 144.92,
      "duration_seconds": 4.01,
      "text": "Right, do you have any known allergies at all?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 145.79,
      "end_seconds": 149.58,
      "duration_seconds": 3.79,
      "text": "I don't have any known medication allergies."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 151.39,
      "end_seconds": 153.85,
      "duration_seconds": 2.46,
      "text": "Let me measure a few things."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 163.91,
      "end_seconds": 166.25,
      "duration_seconds": 2.34,
      "text": "Okay, give me a moment..."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 185.51,
      "end_seconds": 197.23,
      "duration_seconds": 11.72,
      "text": "Okay: temp 39.0 degrees, respiratory rate 18, pulse is 104 beats a minute, pressure 124 over 72, oxygen saturation is 95 percent."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 200.23,
      "end_seconds": 202.67,
      "duration_seconds": 2.44,
      "text": "Okay, a quick examination now."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 212.49,
      "end_seconds": 213.19,
      "duration_seconds": 0.7,
      "text": "Alright."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 214.75,
      "end_seconds": 218.69,
      "duration_seconds": 3.94,
      "text": "Right, stay still while I have a look."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 228.2,
      "end_seconds": 229.48,
      "duration_seconds": 1.28,
      "text": "You're mildly dehydrated."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 234.98,
      "end_seconds": 244.27,
      "duration_seconds": 9.29,
      "text": "All done, you can get dressed. So, based on the history and the examination, I'd lean towards acute gastroenteritis."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 245.2,
      "end_seconds": 247.12,
      "duration_seconds": 1.92,
      "text": "Doctor, is this dangerous?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 252.34,
      "end_seconds": 259.02,
      "duration_seconds": 6.68,
      "text": "I can't promise yet, but most people with acute gastroenteritis do well once it's treated properly."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 269.17,
      "end_seconds": 286.62,
      "duration_seconds": 17.45,
      "text": "Let's book a stool test to look into diarrhoea. We should do blood salts for dehydration. I'm going to put you on ORS, 1 sachet, after each loose stool, for three days. That's for dehydration."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 287.88,
      "end_seconds": 290.15,
      "duration_seconds": 2.27,
      "text": "Fine, I'll start it."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 291.92,
      "end_seconds": 299.6,
      "duration_seconds": 7.68,
      "text": "Stick to bananas, rice, toast, curd, and avoid milk and oily food till it settles."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 299.96,
      "end_seconds": 315.95,
      "duration_seconds": 15.99,
      "text": "Right, right. One warning sign to remember: you pass blood or can't keep anything down. In that case don't wait. Come back if it's not better in three days. Thanks for coming in."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 317.67,
      "end_seconds": 319.82,
      "duration_seconds": 2.15,
      "text": "Thanks, that was helpful."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 321.82,
      "end_seconds": 323.63,
      "duration_seconds": 1.81,
      "text": "Mind how you go."
    }
  ]
}