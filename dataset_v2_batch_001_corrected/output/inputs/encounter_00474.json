{
  "schema_version": "1.0",
  "encounter_id": "00474",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.12,
      "end_seconds": 5.28,
      "duration_seconds": 4.16,
      "text": "Morning, doctor, I hope I'm not interrupting."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.97,
      "end_seconds": 10.75,
      "duration_seconds": 3.78,
      "text": "Right on time. Sit, please. How can I help?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 12.38,
      "end_seconds": 16.91,
      "duration_seconds": 4.53,
      "text": "I've been getting out of puff on the stairs."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 18.1,
      "end_seconds": 21.02,
      "duration_seconds": 2.92,
      "text": "When did you first notice it?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 22.92,
      "end_seconds": 32.26,
      "duration_seconds": 9.34,
      "text": "Yesterday, it came on out of nowhere. It's a relief to finally sit down and talk about it."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 32.89,
      "end_seconds": 35.94,
      "duration_seconds": 3.05,
      "text": "is it mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 36.89,
      "end_seconds": 52.89,
      "duration_seconds": 16.0,
      "text": "I'd say moderate. And I've been having put on weight as well, for six months. Oh, and a dry cough at night. That's been about the same, six months."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 53.58,
      "end_seconds": 56.35,
      "duration_seconds": 2.77,
      "text": "Can I take your vitals now?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 65.68,
      "end_seconds": 66.54,
      "duration_seconds": 0.86,
      "text": "Almost there..."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 80.04,
      "end_seconds": 87.64,
      "duration_seconds": 7.6,
      "text": "okay: temp 36.7 degrees, saturation 99 percent, pulse 85, blood pressure 122 over 77."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 91.71,
      "end_seconds": 93.34,
      "duration_seconds": 1.63,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 94.39,
      "end_seconds": 97.14,
      "duration_seconds": 2.75,
      "text": "I'll interpret it once I've examined you."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 99.61,
      "end_seconds": 101.76,
      "duration_seconds": 2.15,
      "text": "Can I examine you now?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 102.53,
      "end_seconds": 103.23,
      "duration_seconds": 0.7,
      "text": "okay"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 105.0,
      "end_seconds": 106.27,
      "duration_seconds": 1.27,
      "text": "I'll go gently."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 123.78,
      "end_seconds": 127.6,
      "duration_seconds": 3.82,
      "text": "Heart sounds are normal and the chest is clear."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 130.81,
      "end_seconds": 137.46,
      "duration_seconds": 6.65,
      "text": "All done, you can get dressed. Okay, did you get palpitations or wheezing?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 140.77,
      "end_seconds": 143.63,
      "duration_seconds": 2.86,
      "text": "None, as far as I know."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 144.61,
      "end_seconds": 149.12,
      "duration_seconds": 4.51,
      "text": "Have you had any fever, coughing up blood or calf swelling?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 154.08,
      "end_seconds": 156.56,
      "duration_seconds": 2.48,
      "text": "no, I'd have mentioned it"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 158.41,
      "end_seconds": 161.11,
      "duration_seconds": 2.7,
      "text": "right, is your mobility otherwise okay?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 161.67,
      "end_seconds": 163.17,
      "duration_seconds": 1.5,
      "text": "no, nothing there"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 164.78,
      "end_seconds": 167.63,
      "duration_seconds": 2.85,
      "text": "are you on any tablets or medication?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 168.42,
      "end_seconds": 179.01,
      "duration_seconds": 10.59,
      "text": "It's iron tablets, once a day for my blood count. I do miss it now and then, to be fair."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 196.66,
      "end_seconds": 200.73,
      "duration_seconds": 4.07,
      "text": "Moving on to your background, any past medical history?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 202.37,
      "end_seconds": 205.23,
      "duration_seconds": 2.86,
      "text": "I've had low haemoglobin, yes."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 206.31,
      "end_seconds": 208.38,
      "duration_seconds": 2.07,
      "text": "Do you have a job?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 208.99,
      "end_seconds": 211.14,
      "duration_seconds": 2.15,
      "text": "I'm a self-employed electrician."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 214.19,
      "end_seconds": 216.45,
      "duration_seconds": 2.26,
      "text": "Do you get any exercise?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 217.71,
      "end_seconds": 222.66,
      "duration_seconds": 4.95,
      "text": "I walk for about half an hour most days"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 230.04,
      "end_seconds": 232.52,
      "duration_seconds": 2.48,
      "text": "have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 233.57,
      "end_seconds": 236.31,
      "duration_seconds": 2.74,
      "text": "no, never had any surgery"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 246.44,
      "end_seconds": 257.05,
      "duration_seconds": 10.61,
      "text": "Taking everything into account, it fits best with breathlessness with several possible contributors. That's my thinking for now, and it may change as we learn more."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 258.83,
      "end_seconds": 261.55,
      "duration_seconds": 2.72,
      "text": "Do you think it's serious?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 262.28,
      "end_seconds": 284.66,
      "duration_seconds": 22.38,
      "text": "I understand the worry. At the moment I'd say it's breathlessness with several possible contributors, and we'll know more once the blood tests is back. Stop me if I've got anything wrong. You've been getting out of puff on the stairs, yesterday, moderate, and no wheezing or coughing up blood."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 286.44,
      "end_seconds": 288.03,
      "duration_seconds": 1.59,
      "text": "that's it, yes"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 289.04,
      "end_seconds": 293.23,
      "duration_seconds": 4.19,
      "text": "I think blood tests makes sense here, for breathlessness."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 298.0,
      "end_seconds": 300.49,
      "duration_seconds": 2.49,
      "text": "Does it need any preparation?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 302.16,
      "end_seconds": 312.31,
      "duration_seconds": 10.15,
      "text": "Let's get an echocardiogram, for breathlessness. A short daily walk, building up slowly, is a sensible start. Come back after the results are back."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 313.52,
      "end_seconds": 315.7,
      "duration_seconds": 2.18,
      "text": "That works for me."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 316.46,
      "end_seconds": 319.65,
      "duration_seconds": 3.19,
      "text": "That's everything from me. Any other questions?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 322.69,
      "end_seconds": 326.01,
      "duration_seconds": 3.32,
      "text": "One thing: no, actually that's all. Thanks."
    }
  ]
}