{
  "schema_version": "1.0",
  "encounter_id": "00108",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.15,
      "end_seconds": 4.55,
      "duration_seconds": 3.4,
      "text": "Afternoon. Take the chair by the desk."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 5.6,
      "end_seconds": 6.51,
      "duration_seconds": 0.91,
      "text": "Hi. Thanks."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 10.88,
      "end_seconds": 12.78,
      "duration_seconds": 1.9,
      "text": "Right, what's the trouble?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 14.88,
      "end_seconds": 27.61,
      "duration_seconds": 12.73,
      "text": "Um, so... a weak urine stream. That's why I came. Uh, I've been having to rush to the toilet too, for about a month."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 31.73,
      "end_seconds": 39.22,
      "duration_seconds": 7.49,
      "text": "Have you had any weight loss, fever, blood in the urine or burning when passing urine?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 41.13,
      "end_seconds": 43.26,
      "duration_seconds": 2.13,
      "text": "No, none of those."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 44.88,
      "end_seconds": 47.69,
      "duration_seconds": 2.81,
      "text": "And your skin, any changes there?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 49.78,
      "end_seconds": 52.38,
      "duration_seconds": 2.6,
      "text": "Nothing on the skin, no."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 61.51,
      "end_seconds": 62.9,
      "duration_seconds": 1.39,
      "text": "What about alcohol?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 64.73,
      "end_seconds": 67.52,
      "duration_seconds": 2.79,
      "text": "I don't drink at all."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 69.29,
      "end_seconds": 70.53,
      "duration_seconds": 1.24,
      "text": "How about smoking?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 71.57,
      "end_seconds": 76.32,
      "duration_seconds": 4.75,
      "text": "I used to smoke but I quit five years ago."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 77.03,
      "end_seconds": 79.41,
      "duration_seconds": 2.38,
      "text": "How do you eat, generally?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 80.32,
      "end_seconds": 83.03,
      "duration_seconds": 2.71,
      "text": "I skip breakfast most days."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 84.55,
      "end_seconds": 86.95,
      "duration_seconds": 2.4,
      "text": "Are you working at the moment?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 87.48,
      "end_seconds": 91.27,
      "duration_seconds": 3.79,
      "text": "Yes, I'm a nurse on a busy ward."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 91.98,
      "end_seconds": 94.16,
      "duration_seconds": 2.18,
      "text": "Who's at home with you?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 95.76,
      "end_seconds": 100.29,
      "duration_seconds": 4.53,
      "text": "It's just me and my wife at home now."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 101.89,
      "end_seconds": 106.23,
      "duration_seconds": 4.34,
      "text": "What about allergies, to medicines or foods or anything else?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 108.09,
      "end_seconds": 115.32,
      "duration_seconds": 7.23,
      "text": "I was told I'm allergic to codeine, but I don't remember what reaction I had."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 116.76,
      "end_seconds": 121.93,
      "duration_seconds": 5.17,
      "text": "Do you have any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 123.38,
      "end_seconds": 127.85,
      "duration_seconds": 4.47,
      "text": "I have high blood pressure, for nearly five years."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 129.61,
      "end_seconds": 130.31,
      "duration_seconds": 0.7,
      "text": "Yes?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 132.08,
      "end_seconds": 141.46,
      "duration_seconds": 9.38,
      "text": "Alright, high blood pressure, that matches what I have here. Okay, tell me what you take day to day."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 143.36,
      "end_seconds": 148.79,
      "duration_seconds": 5.43,
      "text": "Amlodipine. I take it 5 milligrams, maybe, once a day."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 149.56,
      "end_seconds": 154.18,
      "duration_seconds": 4.62,
      "text": "Did you happen to bring the box or the paperwork?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 156.1,
      "end_seconds": 160.27,
      "duration_seconds": 4.17,
      "text": "Not with me. I'll bring it next time."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 174.58,
      "end_seconds": 178.96,
      "duration_seconds": 4.38,
      "text": "Let's get your blood pressure and the other basics."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 185.82,
      "end_seconds": 187.58,
      "duration_seconds": 1.76,
      "text": "Just relax your arm..."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 207.85,
      "end_seconds": 213.98,
      "duration_seconds": 6.13,
      "text": "Okay: heart rate 67, blood pressure 125 over 69, temperature 36.7."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 232.08,
      "end_seconds": 244.82,
      "duration_seconds": 12.74,
      "text": "Let me tell you where I've got to. It's hard to say. An enlarged prostate causing urinary symptoms is one possibility and a urine infection another, and I'd rather not commit yet."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 246.43,
      "end_seconds": 250.05,
      "duration_seconds": 3.62,
      "text": "Is this something I'll have for good?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 251.0,
      "end_seconds": 278.9,
      "duration_seconds": 27.9,
      "text": "Nothing I've seen today points to an emergency. It looks like an enlarged prostate causing urinary symptoms, but I'd like to confirm. I'm going to order a urine test, for urinary symptoms. I want an ultrasound of the bladder and prostate done, that's for urinary symptoms. I'll start you on tamsulosin, 0.4 milligrams, at night, for four weeks. You take it by mouth. That should help with urinary symptoms."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 280.61,
      "end_seconds": 284.3,
      "duration_seconds": 3.69,
      "text": "Can I get that from the usual pharmacy?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 285.9,
      "end_seconds": 300.94,
      "duration_seconds": 15.04,
      "text": "Cut back on tea and coffee after the afternoon and go before you sleep. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 302.44,
      "end_seconds": 303.14,
      "duration_seconds": 0.7,
      "text": "Understood."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 303.71,
      "end_seconds": 306.96,
      "duration_seconds": 3.25,
      "text": "See me again after the results are back."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 307.64,
      "end_seconds": 310.68,
      "duration_seconds": 3.04,
      "text": "Okay, um, I'll book that."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 314.89,
      "end_seconds": 316.1,
      "duration_seconds": 1.21,
      "text": "Any last questions?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 316.96,
      "end_seconds": 321.73,
      "duration_seconds": 4.77,
      "text": "I think that's clear. Thank you for being so thorough."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 323.14,
      "end_seconds": 324.37,
      "duration_seconds": 1.23,
      "text": "All the best."
    }
  ]
}