{
  "schema_version": "1.0",
  "encounter_id": "00421",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.25,
      "end_seconds": 5.45,
      "duration_seconds": 4.2,
      "text": "Morning, doctor, I hope I'm not interrupting."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.33,
      "end_seconds": 10.84,
      "duration_seconds": 4.51,
      "text": "No trouble at all, come in. What's been bothering you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 12.55,
      "end_seconds": 16.59,
      "duration_seconds": 4.04,
      "text": "Yeah, thank you for fitting us in, doctor."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 17.19,
      "end_seconds": 29.87,
      "duration_seconds": 12.68,
      "text": "Honestly, it's stomach cramps, and my family pushed me to come. It's a relief to finally sit down and talk about it."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 30.62,
      "end_seconds": 33.22,
      "duration_seconds": 2.6,
      "text": "Since when have you had this?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 33.86,
      "end_seconds": 38.16,
      "duration_seconds": 4.3,
      "text": "It's been two days, I'm fairly sure."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 39.6,
      "end_seconds": 41.67,
      "duration_seconds": 2.07,
      "text": "Have you been feeling weak?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 42.66,
      "end_seconds": 65.29,
      "duration_seconds": 22.63,
      "text": "so, yeah. One week, I'd say. Um, I've also had loose motions, since last Tuesday. With loose motions, I'd give it a three, out of ten. I notice it more with drinking milk and eating. Only fasting, and it's not much"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 66.35,
      "end_seconds": 69.2,
      "duration_seconds": 2.85,
      "text": "Has there been a low fever too?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 71.0,
      "end_seconds": 78.05,
      "duration_seconds": 7.05,
      "text": "Yes, I have. With low fever, I'd say once or twice a day."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 78.88,
      "end_seconds": 82.92,
      "duration_seconds": 4.04,
      "text": "Alright, which tablets or creams or inhalers do you use?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 83.53,
      "end_seconds": 97.88,
      "duration_seconds": 14.35,
      "text": "Metformin. I take it 500 milligrams, twice a day. I'm on pantoprazole, 40 milligrams, before breakfast. Well, I take Asthalin inhaler, when needed"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 98.88,
      "end_seconds": 100.66,
      "duration_seconds": 1.78,
      "text": "Do you drink alcohol?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 101.5,
      "end_seconds": 104.02,
      "duration_seconds": 2.52,
      "text": "I don't drink at all."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 104.93,
      "end_seconds": 105.79,
      "duration_seconds": 0.86,
      "text": "Any smoking?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 106.72,
      "end_seconds": 110.59,
      "duration_seconds": 3.87,
      "text": "No, I don't smoke and never have."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 111.35,
      "end_seconds": 113.55,
      "duration_seconds": 2.2,
      "text": "How do you eat, generally?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 114.74,
      "end_seconds": 117.25,
      "duration_seconds": 2.51,
      "text": "I skip breakfast most days."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 118.75,
      "end_seconds": 122.14,
      "duration_seconds": 3.39,
      "text": "What do you do to keep active?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 123.68,
      "end_seconds": 126.81,
      "duration_seconds": 3.13,
      "text": "I cycle to work most mornings."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 127.91,
      "end_seconds": 130.49,
      "duration_seconds": 2.58,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 132.54,
      "end_seconds": 134.23,
      "duration_seconds": 1.69,
      "text": "No operations, no."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 135.03,
      "end_seconds": 139.58,
      "duration_seconds": 4.55,
      "text": "Tell me about your health in general, any ongoing conditions?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 140.14,
      "end_seconds": 153.14,
      "duration_seconds": 13.0,
      "text": "I've had diabetes for two years now um, I have acid reflux, for nearly five years i've had asthma, yes"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 154.47,
      "end_seconds": 159.68,
      "duration_seconds": 5.21,
      "text": "okay, I can see acid reflux in your file as well"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 178.39,
      "end_seconds": 182.55,
      "duration_seconds": 4.16,
      "text": "What about allergies, to medicines or foods or anything else?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 183.65,
      "end_seconds": 187.14,
      "duration_seconds": 3.49,
      "text": "No, none that I know of."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 189.2,
      "end_seconds": 198.1,
      "duration_seconds": 8.9,
      "text": "Hold on, you know, doctor, I think she reacted to aspirin once. I'm not certain, though."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 198.6,
      "end_seconds": 201.7,
      "duration_seconds": 3.1,
      "text": "Maybe, but I don't recall it."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 203.78,
      "end_seconds": 209.82,
      "duration_seconds": 6.04,
      "text": "Fair enough, I'll write down both versions. Does anything run in the family?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 211.32,
      "end_seconds": 217.72,
      "duration_seconds": 6.4,
      "text": "um, my sister has thyroid problems my father was diabetic"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 218.73,
      "end_seconds": 220.59,
      "duration_seconds": 1.86,
      "text": "any sign of vomiting?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 221.92,
      "end_seconds": 223.52,
      "duration_seconds": 1.6,
      "text": "Definitely no vomiting."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 227.77,
      "end_seconds": 234.08,
      "duration_seconds": 6.31,
      "text": "um, actually, doctor, I did notice vomiting. She doesn't always say"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 235.6,
      "end_seconds": 242.53,
      "duration_seconds": 6.93,
      "text": "No, I don't think I did. Maybe a little, I'm not sure."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 243.43,
      "end_seconds": 255.18,
      "duration_seconds": 11.75,
      "text": "Alright, I'll note both what you've said and what you've noticed. Have you noticed recent antibiotics, rash, weight loss or blood in the stool?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 257.06,
      "end_seconds": 264.47,
      "duration_seconds": 7.41,
      "text": "So, no, no recent antibiotics, rash, weight loss or blood in the stool."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 266.06,
      "end_seconds": 271.21,
      "duration_seconds": 5.15,
      "text": "Have you noticed any weakness, or anything odd with your balance?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 272.53,
      "end_seconds": 274.49,
      "duration_seconds": 1.96,
      "text": "No weakness or anything."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 274.99,
      "end_seconds": 277.41,
      "duration_seconds": 2.42,
      "text": "Is your chest okay generally?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 278.95,
      "end_seconds": 280.02,
      "duration_seconds": 1.07,
      "text": "Breathing's normal."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 281.6,
      "end_seconds": 285.59,
      "duration_seconds": 3.99,
      "text": "Let's get your blood pressure and the other basics."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 292.65,
      "end_seconds": 294.22,
      "duration_seconds": 1.57,
      "text": "hold still for me.."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 304.57,
      "end_seconds": 313.03,
      "duration_seconds": 8.46,
      "text": "Okay: temp 38.2 degrees, blood pressure 126 over 79, pulse 102. And And SpO2 97 percent on room air."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 314.59,
      "end_seconds": 316.82,
      "duration_seconds": 2.23,
      "text": "Okay, a quick examination now."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 317.95,
      "end_seconds": 320.18,
      "duration_seconds": 2.23,
      "text": "Let me just check something."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 331.24,
      "end_seconds": 332.51,
      "duration_seconds": 1.27,
      "text": "you're mildly dehydrated"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 333.84,
      "end_seconds": 337.42,
      "duration_seconds": 3.58,
      "text": "Okay, stay still while I have a look."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 355.78,
      "end_seconds": 361.24,
      "duration_seconds": 5.46,
      "text": "Bowel sounds are active, tummy is soft with mild tenderness all around."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 364.6,
      "end_seconds": 366.76,
      "duration_seconds": 2.16,
      "text": "Okay, you can sit up."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 380.44,
      "end_seconds": 389.03,
      "duration_seconds": 8.59,
      "text": "let me tell you where I've got to. I'd lean towards acute gastroenteritis. Another possibility is food poisoning"
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 404.95,
      "end_seconds": 426.22,
      "duration_seconds": 21.27,
      "text": "let's get a stool test, for diarrhoea. Let's book blood salts to look into dehydration. I'm going to put you on ORS, 1 sachet, after each loose stool, for three days. That should help with dehydration. Let's use zinc, 20 milligrams, once a day, for ten days. That should help with diarrhoea"
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 429.15,
      "end_seconds": 430.29,
      "duration_seconds": 1.14,
      "text": "Mm, okay."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 431.38,
      "end_seconds": 445.51,
      "duration_seconds": 14.13,
      "text": "Stick to bananas, rice, toast, curd, and avoid milk and oily food till it settles. One warning sign to remember: you pass blood or can't keep anything down. In that that case don't wait."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 447.33,
      "end_seconds": 449.28,
      "duration_seconds": 1.95,
      "text": "Okay, fair enough."
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 450.04,
      "end_seconds": 456.6,
      "duration_seconds": 6.56,
      "text": "Let's plan a check in three days. Okay, I think we're finished. Is everything clear?"
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 457.29,
      "end_seconds": 461.1,
      "duration_seconds": 3.81,
      "text": "So, no, you've explained it well. Thanks."
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 461.67,
      "end_seconds": 462.53,
      "duration_seconds": 0.86,
      "text": "Take care."
    }
  ]
}