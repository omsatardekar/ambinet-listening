{
  "schema_version": "1.0",
  "encounter_id": "00398",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.34,
      "end_seconds": 8.46,
      "duration_seconds": 7.12,
      "text": "Good afternoon, um, doctor, the receptionist said you'd see me now."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 9.11,
      "end_seconds": 13.57,
      "duration_seconds": 4.46,
      "text": "Right on time. Sit, please. How can I help?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 15.18,
      "end_seconds": 21.99,
      "duration_seconds": 6.81,
      "text": "I've, I've been coughing after exercise, and I wanted to get it checked."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 23.4,
      "end_seconds": 25.36,
      "duration_seconds": 1.96,
      "text": "When did it begin?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 26.69,
      "end_seconds": 35.21,
      "duration_seconds": 8.52,
      "text": "It's been like this since last night. Sorry, uh, I know I'm rambling a bit."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 36.65,
      "end_seconds": 41.92,
      "duration_seconds": 5.27,
      "text": "Okay, give me more detail on it, whatever comes to mind."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 43.88,
      "end_seconds": 69.76,
      "duration_seconds": 25.88,
      "text": "Running definitely sets it off. It happens a few times a day. Moderate, I'd say. I get some relief from resting. And there's a runny nose in the mornings as well, about three months now. A mild wheeze at times was there, but it's gone away on its own."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 75.26,
      "end_seconds": 84.04,
      "duration_seconds": 8.78,
      "text": "Here are the numbers, doctor. Saturation 97 percent, blood pressure 126 over 72, temperature is 36.5 degrees. Pulse 66, respiratory rate 15."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 85.7,
      "end_seconds": 86.66,
      "duration_seconds": 0.96,
      "text": "Okay, noted."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 87.98,
      "end_seconds": 91.41,
      "duration_seconds": 3.43,
      "text": "Let me have a look at you."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 92.58,
      "end_seconds": 93.76,
      "duration_seconds": 1.18,
      "text": "I'll go gently."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 110.63,
      "end_seconds": 113.81,
      "duration_seconds": 3.18,
      "text": "A faint wheeze when you breathe out forcefully."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 117.46,
      "end_seconds": 118.36,
      "duration_seconds": 0.9,
      "text": "Okay, finished."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 129.44,
      "end_seconds": 134.53,
      "duration_seconds": 5.09,
      "text": "Did you get heartburn, weight loss, fever or chest pain?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 135.88,
      "end_seconds": 138.96,
      "duration_seconds": 3.08,
      "text": "Yeah, no, none of those."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 140.71,
      "end_seconds": 144.07,
      "duration_seconds": 3.36,
      "text": "Have you had night sweats, by any chance?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 144.59,
      "end_seconds": 148.69,
      "duration_seconds": 4.1,
      "text": "Hmm, not at all, no night sweats."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 149.83,
      "end_seconds": 153.83,
      "duration_seconds": 4.0,
      "text": "Anything with your heart, like skipped beats or fainting?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 154.94,
      "end_seconds": 156.62,
      "duration_seconds": 1.68,
      "text": "Nothing like that."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 158.31,
      "end_seconds": 161.21,
      "duration_seconds": 2.9,
      "text": "Alright, any trouble with the waterworks?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 161.84,
      "end_seconds": 166.08,
      "duration_seconds": 4.24,
      "text": "Well, um, no, that's all fine."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 166.7,
      "end_seconds": 169.47,
      "duration_seconds": 2.77,
      "text": "Have you had any surgery before?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 171.17,
      "end_seconds": 189.74,
      "duration_seconds": 18.57,
      "text": "I mean, uh, yes, I had a hysterectomy, about twelve years ago. A neighbour of mine said I should see someone about it. My sister suggested writing things down, but I forgot."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 191.2,
      "end_seconds": 193.25,
      "duration_seconds": 2.05,
      "text": "Any drug or food allergies?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 194.93,
      "end_seconds": 199.55,
      "duration_seconds": 4.62,
      "text": "Oh, yes, eggs, it gives me a rash."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 200.66,
      "end_seconds": 203.1,
      "duration_seconds": 2.44,
      "text": "What's your current medication list?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 206.95,
      "end_seconds": 218.99,
      "duration_seconds": 12.04,
      "text": "I take hydrocortisone cream, when needed. So, I'm on apixaban, 5 milligrams, twice a day for the heart rhythm."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 224.72,
      "end_seconds": 230.23,
      "duration_seconds": 5.51,
      "text": "Doctor, our chart from the last visit lists it as 10 milligrams."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 231.45,
      "end_seconds": 235.65,
      "duration_seconds": 4.2,
      "text": "So, I see. Is the most recent prescription on you?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 237.27,
      "end_seconds": 242.78,
      "duration_seconds": 5.51,
      "text": "So, um, not with me. I'll bring it next time."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 243.5,
      "end_seconds": 248.67,
      "duration_seconds": 5.17,
      "text": "Alright, tell me about your health in general, any ongoing conditions?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 249.83,
      "end_seconds": 257.25,
      "duration_seconds": 7.42,
      "text": "Uh, I've got eczema. I'd rather know what's going on than keep guessing."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 258.1,
      "end_seconds": 259.64,
      "duration_seconds": 1.54,
      "text": "Right, any more?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 264.47,
      "end_seconds": 266.58,
      "duration_seconds": 2.11,
      "text": "Yes, an irregular heartbeat."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 268.48,
      "end_seconds": 276.58,
      "duration_seconds": 8.1,
      "text": "Alright, an irregular heartbeat, that matches what I have here. Okay, are you living with family?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 277.26,
      "end_seconds": 281.43,
      "duration_seconds": 4.17,
      "text": "I stay with my daughter and her family."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 283.53,
      "end_seconds": 286.12,
      "duration_seconds": 2.59,
      "text": "How do you eat, generally?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 287.95,
      "end_seconds": 290.58,
      "duration_seconds": 2.63,
      "text": "I skip breakfast most days."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 305.88,
      "end_seconds": 314.7,
      "duration_seconds": 8.82,
      "text": "So where does that leave us? The most likely explanation is cough-variant asthma. I can't rule out reflux-related cough yet."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 315.78,
      "end_seconds": 319.5,
      "duration_seconds": 3.72,
      "text": "What are the chances it's something bad?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 320.93,
      "end_seconds": 329.83,
      "duration_seconds": 8.9,
      "text": "Nothing I've seen today points to an emergency. It looks like cough-variant asthma, but I'd like to confirm."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 340.84,
      "end_seconds": 357.18,
      "duration_seconds": 16.34,
      "text": "I'm going to order a peak flow reading, for chronic cough. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose. Okay, I think we're finished. Is everything clear?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 361.99,
      "end_seconds": 368.01,
      "duration_seconds": 6.02,
      "text": "Hmm, I think that's clear. Thank you for being so thorough."
    }
  ]
}