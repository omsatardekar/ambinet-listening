{
  "schema_version": "1.0",
  "encounter_id": "00462",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.06,
      "end_seconds": 4.6,
      "duration_seconds": 3.54,
      "text": "Hello, doctor. Where would you like me?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.49,
      "end_seconds": 10.3,
      "duration_seconds": 3.81,
      "text": "Yes, do sit. Tell me what's been happening."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 11.19,
      "end_seconds": 19.1,
      "duration_seconds": 7.91,
      "text": "Mainly aching bones and muscles. There's a couple of other things, but that's the main one."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 20.8,
      "end_seconds": 23.2,
      "duration_seconds": 2.4,
      "text": "Roughly when did it start?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 26.1,
      "end_seconds": 36.22,
      "duration_seconds": 10.12,
      "text": "It's been about a month, I'm fairly sure. A neighbour of mine said I should see someone about it."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 38.25,
      "end_seconds": 42.37,
      "duration_seconds": 4.12,
      "text": "Does it happen all the time or in spells?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 43.11,
      "end_seconds": 51.45,
      "duration_seconds": 8.34,
      "text": "It, It happens a couple of times a week. I've also had tingling in the feet, since yesterday."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 70.17,
      "end_seconds": 73.67,
      "duration_seconds": 3.5,
      "text": "Have you had black stools, by any chance?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 75.31,
      "end_seconds": 77.25,
      "duration_seconds": 1.94,
      "text": "No, no black stools."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 78.31,
      "end_seconds": 82.63,
      "duration_seconds": 4.32,
      "text": "Any poor diet, weight loss or fractures at all?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 84.67,
      "end_seconds": 90.63,
      "duration_seconds": 5.96,
      "text": "Okay, so I haven't had poor diet, weight loss or fractures, no."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 92.68,
      "end_seconds": 94.78,
      "duration_seconds": 2.1,
      "text": "Is your chest okay generally?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 96.61,
      "end_seconds": 99.38,
      "duration_seconds": 2.77,
      "text": "No, you know, nothing there."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 100.08,
      "end_seconds": 101.52,
      "duration_seconds": 1.44,
      "text": "And your work?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 102.88,
      "end_seconds": 106.72,
      "duration_seconds": 3.84,
      "text": "I drive a delivery van all day."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 107.28,
      "end_seconds": 109.6,
      "duration_seconds": 2.32,
      "text": "Anything special about your diet?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 111.18,
      "end_seconds": 114.57,
      "duration_seconds": 3.39,
      "text": "I try to avoid too much sugar."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 115.13,
      "end_seconds": 116.39,
      "duration_seconds": 1.26,
      "text": "Any regular medication?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 117.88,
      "end_seconds": 121.13,
      "duration_seconds": 3.25,
      "text": "No, I don't take anything regularly."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 123.21,
      "end_seconds": 126.12,
      "duration_seconds": 2.91,
      "text": "Before I prescribe anything, any allergies?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 131.45,
      "end_seconds": 134.92,
      "duration_seconds": 3.47,
      "text": "So, not that I know, no."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 136.64,
      "end_seconds": 138.09,
      "duration_seconds": 1.45,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 140.19,
      "end_seconds": 142.41,
      "duration_seconds": 2.22,
      "text": "No, nothing like that."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 157.91,
      "end_seconds": 162.46,
      "duration_seconds": 4.55,
      "text": "Okay, do you have any medical conditions I should know about?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 163.92,
      "end_seconds": 167.31,
      "duration_seconds": 3.39,
      "text": "No, I've never had anything serious."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 168.39,
      "end_seconds": 170.01,
      "duration_seconds": 1.62,
      "text": "Let's do your observations."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 182.43,
      "end_seconds": 183.99,
      "duration_seconds": 1.56,
      "text": "Alright, one second..."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 204.48,
      "end_seconds": 210.91,
      "duration_seconds": 6.43,
      "text": "Okay: pulse 85, respiratory rate 16, pressure 114 over 81, temperature is 36.8 degrees."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 228.55,
      "end_seconds": 239.7,
      "duration_seconds": 11.15,
      "text": "From what you've told me, this is probably a vitamin deficiency. I want to be honest that this is an impression, not a final answer."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 241.61,
      "end_seconds": 244.84,
      "duration_seconds": 3.23,
      "text": "Oh, is it something serious, doctor?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 246.69,
      "end_seconds": 254.97,
      "duration_seconds": 8.28,
      "text": "Nothing I've seen today points to an emergency. It looks like a vitamin deficiency, but I'd like to confirm."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 268.11,
      "end_seconds": 272.53,
      "duration_seconds": 4.42,
      "text": "I'm going to order a vitamin D level, for bone aches."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 273.39,
      "end_seconds": 277.17,
      "duration_seconds": 3.78,
      "text": "I can book that for Monday at 2 pm."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 279.14,
      "end_seconds": 296.14,
      "duration_seconds": 17.0,
      "text": "I'd like you to take vitamin D, 60000 units, once a week, for eight weeks. That should help with possible deficiency. Some midday sunlight on the arms for fifteen minutes helps. I'd like to see you again after the results are back."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 298.21,
      "end_seconds": 301.89,
      "duration_seconds": 3.68,
      "text": "Alright, I'll put it in my diary."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 302.74,
      "end_seconds": 305.09,
      "duration_seconds": 2.35,
      "text": "Right, that's all. Go gently."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 306.58,
      "end_seconds": 310.13,
      "duration_seconds": 3.55,
      "text": "Hmm, alright, thanks. Bye for now."
    }
  ]
}