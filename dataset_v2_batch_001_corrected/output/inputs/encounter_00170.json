{
  "schema_version": "1.0",
  "encounter_id": "00170",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 0.55,
      "end_seconds": 8.74,
      "duration_seconds": 8.19,
      "text": "Doctor, the the patient's with us now. I did the usual checks at the front, so just say when you want them."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 9.57,
      "end_seconds": 14.58,
      "duration_seconds": 5.01,
      "text": "Great. Hello, come in and sit down. How can I help?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 16.37,
      "end_seconds": 19.59,
      "duration_seconds": 3.22,
      "text": "thank you for fitting us in, doctor"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 20.66,
      "end_seconds": 28.51,
      "duration_seconds": 7.85,
      "text": "it's swelling in my left calf i thought I'd wait, but it hasn't gone"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 30.32,
      "end_seconds": 38.01,
      "duration_seconds": 7.69,
      "text": "how long has this been going on? Bear with me, I'm just building up the picture"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 39.43,
      "end_seconds": 43.72,
      "duration_seconds": 4.29,
      "text": "It's been going on for about two weeks."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 44.93,
      "end_seconds": 54.53,
      "duration_seconds": 9.6,
      "text": "Tell me a bit more about it: how bad it gets, how often, and whether anything makes it better or worse."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 55.3,
      "end_seconds": 64.92,
      "duration_seconds": 9.62,
      "text": "I'd say moderate. I'd say every other day. I'm not great at remembering details, so bear with me."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 65.79,
      "end_seconds": 68.97,
      "duration_seconds": 3.18,
      "text": "Does it come along with anything else?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 70.39,
      "end_seconds": 77.65,
      "duration_seconds": 7.26,
      "text": "Pain in that calf goes along with it, um, most of the time."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 79.07,
      "end_seconds": 83.36,
      "duration_seconds": 4.29,
      "text": "what about warmth in the leg, have you noticed that?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 85.04,
      "end_seconds": 88.5,
      "duration_seconds": 3.46,
      "text": "yeah. About four days, I'd say"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 89.1,
      "end_seconds": 90.31,
      "duration_seconds": 1.21,
      "text": "Do you work?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 91.24,
      "end_seconds": 97.34,
      "duration_seconds": 6.1,
      "text": "I run a small shop, so I'm on my feet a lot"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 101.24,
      "end_seconds": 103.42,
      "duration_seconds": 2.18,
      "text": "Anything special about your diet?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 105.35,
      "end_seconds": 108.82,
      "duration_seconds": 3.47,
      "text": "I try to avoid too much sugar."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 109.81,
      "end_seconds": 112.6,
      "duration_seconds": 2.79,
      "text": "Is there anything medical in your background?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 114.59,
      "end_seconds": 120.35,
      "duration_seconds": 5.76,
      "text": "I've got high blood pressure. Yes, arthritis in my knees."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 122.09,
      "end_seconds": 122.79,
      "duration_seconds": 0.7,
      "text": "mm-hm"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 123.39,
      "end_seconds": 125.52,
      "duration_seconds": 2.13,
      "text": "Eczema, for two years."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 127.54,
      "end_seconds": 128.87,
      "duration_seconds": 1.33,
      "text": "is there more?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 132.05,
      "end_seconds": 138.94,
      "duration_seconds": 6.89,
      "text": "Alright, arthritis in your knees and eczema, that matches what I have here. Any previous surgeries?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 140.72,
      "end_seconds": 146.4,
      "duration_seconds": 5.68,
      "text": "Okay, so I had a lump removed from my back years ago."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 164.09,
      "end_seconds": 167.8,
      "duration_seconds": 3.71,
      "text": "what medicines are you taking at the moment?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 169.72,
      "end_seconds": 175.2,
      "duration_seconds": 5.48,
      "text": "I'm on amlodipine, 5 milligrams, once a day for my pressure."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 177.05,
      "end_seconds": 182.02,
      "duration_seconds": 4.97,
      "text": "Doctor, our chart from the last visit lists it it as 10 milligrams."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 187.24,
      "end_seconds": 191.24,
      "duration_seconds": 4.0,
      "text": "I see. Is the most recent prescription on you?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 192.16,
      "end_seconds": 200.52,
      "duration_seconds": 8.36,
      "text": "Not with me. I'll bring it it next time. It's diclofenac, 50 milligrams, when needed."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 201.2,
      "end_seconds": 208.27,
      "duration_seconds": 7.07,
      "text": "it's meant to be when needed, though I don't see he take it every time"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 210.18,
      "end_seconds": 214.8,
      "duration_seconds": 4.62,
      "text": "right, anyone in the family with similar problems or other conditions?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 215.54,
      "end_seconds": 219.6,
      "duration_seconds": 4.06,
      "text": "My father had kidney stones. My mother has diabetes."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 221.03,
      "end_seconds": 226.88,
      "duration_seconds": 5.85,
      "text": "And what about recent injury to the leg, breathlessness or chest pain?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 227.76,
      "end_seconds": 231.17,
      "duration_seconds": 3.41,
      "text": "um, no, not any of them"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 233.41,
      "end_seconds": 236.21,
      "duration_seconds": 2.8,
      "text": "Any breathing difficulties apart from this?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 238.1,
      "end_seconds": 240.99,
      "duration_seconds": 2.89,
      "text": "no, my breathing's been fine"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 241.67,
      "end_seconds": 249.5,
      "duration_seconds": 7.83,
      "text": "Doctor, I've got the readings for you. Heart rate 113, saturation 97 percent, blood pressure 119 over 78."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 250.96,
      "end_seconds": 252.44,
      "duration_seconds": 1.48,
      "text": "Good, thank you."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 254.13,
      "end_seconds": 257.82,
      "duration_seconds": 3.69,
      "text": "Come over here and I'll have a look."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 259.7,
      "end_seconds": 260.4,
      "duration_seconds": 0.7,
      "text": "sure"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 262.06,
      "end_seconds": 264.34,
      "duration_seconds": 2.28,
      "text": "hold that position for me"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 280.2,
      "end_seconds": 282.23,
      "duration_seconds": 2.03,
      "text": "The right leg looks normal."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 283.48,
      "end_seconds": 284.6,
      "duration_seconds": 1.12,
      "text": "Mm, okay."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 286.09,
      "end_seconds": 288.06,
      "duration_seconds": 1.97,
      "text": "tell me if anything hurts"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 299.69,
      "end_seconds": 304.77,
      "duration_seconds": 5.08,
      "text": "the left calf is bigger than the right, tender along the vein"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 309.11,
      "end_seconds": 310.51,
      "duration_seconds": 1.4,
      "text": "Thanks for that."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 322.14,
      "end_seconds": 351.38,
      "duration_seconds": 29.24,
      "text": "Okay, thinking it through, this looks most like a possible deep vein clot. That's my thinking for now, and it may change as we learn more. A muscle strain is also on my list. Let me repeat that back to make sure. You've had swelling in your left calf for about two weeks, moderate, and no chest pain or recent injury to the leg."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 352.89,
      "end_seconds": 354.53,
      "duration_seconds": 1.64,
      "text": "mm, that's right"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 373.22,
      "end_seconds": 400.91,
      "duration_seconds": 27.69,
      "text": "A D-dimer blood test is what I'd like next, for suspected DVT. I want a Doppler scan of the leg done, that's for suspected DVT. That will help us see what's going on underneath and decide the next step. Keep walking gently, and don't massage the calf. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 402.12,
      "end_seconds": 408.94,
      "duration_seconds": 6.82,
      "text": "Come back or go to emergency straight away if you get chest pain or sudden breathlessness."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 410.59,
      "end_seconds": 411.59,
      "duration_seconds": 1.0,
      "text": "That's clear."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 412.46,
      "end_seconds": 414.89,
      "duration_seconds": 2.43,
      "text": "Book a review in two days."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 416.87,
      "end_seconds": 420.91,
      "duration_seconds": 4.04,
      "text": "I'll make the appointment on my way out."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 422.72,
      "end_seconds": 428.5,
      "duration_seconds": 5.78,
      "text": "Let me check I've been clear. What will you do once you get home?"
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 429.46,
      "end_seconds": 436.0,
      "duration_seconds": 6.54,
      "text": "So, uh, I come back in two days. Is that right?"
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 437.8,
      "end_seconds": 441.25,
      "duration_seconds": 3.45,
      "text": "So, yes, exactly right. Thanks for coming in."
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 442.68,
      "end_seconds": 445.17,
      "duration_seconds": 2.49,
      "text": "All good here. Thank you."
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 445.86,
      "end_seconds": 447.53,
      "duration_seconds": 1.67,
      "text": "Mind how you go."
    }
  ]
}