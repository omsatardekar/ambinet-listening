{
  "schema_version": "1.0",
  "encounter_id": "00498",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 1.09,
      "end_seconds": 10.33,
      "duration_seconds": 9.24,
      "text": "Doctor, the patient's with us now. I did the usual checks at the front, so just say when you want them."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 12.28,
      "end_seconds": 17.09,
      "duration_seconds": 4.81,
      "text": "Good, thank you. Welcome, tell me what's brought you in."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 18.53,
      "end_seconds": 24.34,
      "duration_seconds": 5.81,
      "text": "So, I've been getting out of puff on the stairs, doctor."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 25.29,
      "end_seconds": 27.81,
      "duration_seconds": 2.52,
      "text": "How long are we talking about?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 28.38,
      "end_seconds": 31.9,
      "duration_seconds": 3.52,
      "text": "Ever since... since this morning, really."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 32.19,
      "end_seconds": 43.52,
      "duration_seconds": 11.33,
      "text": "Okay, keep going. Tell me a bit more about it: how bad it gets, how often, and whether anything makes it better or worse."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 44.27,
      "end_seconds": 53.61,
      "duration_seconds": 9.34,
      "text": "I'd call it severe. Honestly, a few times a day. It's worse with stairs and carrying shopping."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 58.55,
      "end_seconds": 61.69,
      "duration_seconds": 3.14,
      "text": "Any long-term health problems I should know about?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 62.44,
      "end_seconds": 66.37,
      "duration_seconds": 3.93,
      "text": "I have low haemoglobin, for two years."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 67.94,
      "end_seconds": 68.64,
      "duration_seconds": 0.7,
      "text": "Mm."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 86.62,
      "end_seconds": 89.33,
      "duration_seconds": 2.71,
      "text": "Does anything run in the family?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 90.48,
      "end_seconds": 93.24,
      "duration_seconds": 2.76,
      "text": "My mother had high blood pressure."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 96.51,
      "end_seconds": 98.76,
      "duration_seconds": 2.25,
      "text": "Tell me about your work."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 99.59,
      "end_seconds": 105.64,
      "duration_seconds": 6.05,
      "text": "I'm a software engineer, so I'm at a screen all day."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 106.78,
      "end_seconds": 109.64,
      "duration_seconds": 2.86,
      "text": "What do you do to keep active?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 110.96,
      "end_seconds": 113.88,
      "duration_seconds": 2.92,
      "text": "I cycle to work most mornings."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 115.38,
      "end_seconds": 118.05,
      "duration_seconds": 2.67,
      "text": "What medicines do you take regularly?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 118.96,
      "end_seconds": 123.47,
      "duration_seconds": 4.51,
      "text": "Oh, I take iron tablets, once a day."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 136.01,
      "end_seconds": 138.6,
      "duration_seconds": 2.59,
      "text": "Any allergies I should know about?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 139.58,
      "end_seconds": 142.96,
      "duration_seconds": 3.38,
      "text": "Yes, ibuprofen, it gives me stomach pain."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 157.99,
      "end_seconds": 159.7,
      "duration_seconds": 1.71,
      "text": "Alright, any previous surgeries?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 161.21,
      "end_seconds": 163.58,
      "duration_seconds": 2.37,
      "text": "No, never had any surgery."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 165.36,
      "end_seconds": 168.91,
      "duration_seconds": 3.55,
      "text": "Okay, any fever, wheezing, palpitations or calf swelling?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 169.83,
      "end_seconds": 172.1,
      "duration_seconds": 2.27,
      "text": "No, none of those."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 172.85,
      "end_seconds": 175.86,
      "duration_seconds": 3.01,
      "text": "And your skin, any changes there?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 176.99,
      "end_seconds": 180.46,
      "duration_seconds": 3.47,
      "text": "Uh, nothing on the skin, no."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 181.16,
      "end_seconds": 191.54,
      "duration_seconds": 10.38,
      "text": "Okay, so the vitals from earlier. Respiratory rate 17, oxygen saturation is 99 percent, temperature is 36.6 degrees, pulse 69, BP is 118 over 73."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 192.69,
      "end_seconds": 193.39,
      "duration_seconds": 0.7,
      "text": "Thanks."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 195.09,
      "end_seconds": 197.37,
      "duration_seconds": 2.28,
      "text": "Shall we do the examination?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 198.62,
      "end_seconds": 201.35,
      "duration_seconds": 2.73,
      "text": "Stay still while I have a look."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 219.36,
      "end_seconds": 225.03,
      "duration_seconds": 5.67,
      "text": "Your BMI is on the high side and you look a little pale."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 226.53,
      "end_seconds": 228.3,
      "duration_seconds": 1.77,
      "text": "Right, I'll go gently."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 243.47,
      "end_seconds": 247.03,
      "duration_seconds": 3.56,
      "text": "Heart sounds are normal and the chest is clear."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 252.88,
      "end_seconds": 255.52,
      "duration_seconds": 2.64,
      "text": "That's all I need, thank you."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 273.58,
      "end_seconds": 305.52,
      "duration_seconds": 31.94,
      "text": "Okay, thinking it through, this looks most like breathlessness with several possible contributors. We should do a chest X-ray for breathlessness. That will help us see what's going on underneath and decide the next step. We should do an echocardiogram for breathlessness. A short daily walk, building up slowly, is a sensible start. Please take the tablets with food so they don't upset your stomach."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 306.17,
      "end_seconds": 321.63,
      "duration_seconds": 15.46,
      "text": "I'm not ordering blood tests today. If things carry on in two weeks, we'll consider it. If the symptoms get worse, or you feel really unwell, please come to the emergency department. Come back in four weeks."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 323.6,
      "end_seconds": 327.36,
      "duration_seconds": 3.76,
      "text": "Yes, you know, I can do that."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 328.85,
      "end_seconds": 331.72,
      "duration_seconds": 2.87,
      "text": "That's it on my side. Anything unclear?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 335.14,
      "end_seconds": 337.43,
      "duration_seconds": 2.29,
      "text": "Thank you for your time."
    }
  ]
}