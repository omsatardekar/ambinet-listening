{
  "schema_version": "1.0",
  "encounter_id": "00101",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 1.11,
      "end_seconds": 9.5,
      "duration_seconds": 8.39,
      "text": "Doctor, the patient's with us now. I did the usual checks at the front, so just say when you want them."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 11.33,
      "end_seconds": 15.1,
      "duration_seconds": 3.77,
      "text": "Okay, thanks. Hi, how can I help today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 19.56,
      "end_seconds": 25.81,
      "duration_seconds": 6.25,
      "text": "Doctor, it's numbness in the toes. It's getting on my nerves now."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 27.31,
      "end_seconds": 28.89,
      "duration_seconds": 1.58,
      "text": "When did it begin?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 30.3,
      "end_seconds": 34.26,
      "duration_seconds": 3.96,
      "text": "I've had it for about three months."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 35.28,
      "end_seconds": 38.19,
      "duration_seconds": 2.91,
      "text": "Would you call it mild or bad?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 40.19,
      "end_seconds": 41.26,
      "duration_seconds": 1.07,
      "text": "Mostly moderate."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 42.43,
      "end_seconds": 44.61,
      "duration_seconds": 2.18,
      "text": "How often does it happen?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 45.86,
      "end_seconds": 49.8,
      "duration_seconds": 3.94,
      "text": "It happens a couple of times a week."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 51.27,
      "end_seconds": 64.51,
      "duration_seconds": 13.24,
      "text": "Doctor, I've got the readings for you. Heart rate 86, temperature 36.5. Oxygen saturation is 98 percent, blood pressure 114 over 71, weight 92 kilos, height 159 centimetres."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 66.11,
      "end_seconds": 67.2,
      "duration_seconds": 1.09,
      "text": "Okay, noted."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 68.24,
      "end_seconds": 71.38,
      "duration_seconds": 3.14,
      "text": "Let me examine, it won't take long."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 73.05,
      "end_seconds": 74.15,
      "duration_seconds": 1.1,
      "text": "Yes, doctor."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 75.26,
      "end_seconds": 76.44,
      "duration_seconds": 1.18,
      "text": "I'll go gently."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 83.89,
      "end_seconds": 85.52,
      "duration_seconds": 1.63,
      "text": "Ankle reflexes are absent."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 87.04,
      "end_seconds": 89.23,
      "duration_seconds": 2.19,
      "text": "Almost done with this part."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 108.09,
      "end_seconds": 111.91,
      "duration_seconds": 3.82,
      "text": "Feeling of light touch is reduced in both feet."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 114.39,
      "end_seconds": 121.06,
      "duration_seconds": 6.67,
      "text": "All done, you can get dressed. And what about hand symptoms, bladder problems or back pain?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 121.69,
      "end_seconds": 124.85,
      "duration_seconds": 3.16,
      "text": "No, none of that at all."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 126.39,
      "end_seconds": 129.3,
      "duration_seconds": 2.91,
      "text": "So, and fever, any of that?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 131.23,
      "end_seconds": 134.32,
      "duration_seconds": 3.09,
      "text": "So, no, none, no fever."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 135.77,
      "end_seconds": 138.04,
      "duration_seconds": 2.27,
      "text": "Is your digestion otherwise okay?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 139.33,
      "end_seconds": 141.11,
      "duration_seconds": 1.78,
      "text": "Nothing unusual, no."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 142.21,
      "end_seconds": 145.28,
      "duration_seconds": 3.07,
      "text": "How are your joints, any aches elsewhere?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 145.98,
      "end_seconds": 148.95,
      "duration_seconds": 2.97,
      "text": "Hmm, no, joints are fine."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 163.18,
      "end_seconds": 164.47,
      "duration_seconds": 1.29,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 165.8,
      "end_seconds": 167.87,
      "duration_seconds": 2.07,
      "text": "No, nothing like that."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 169.3,
      "end_seconds": 178.13,
      "duration_seconds": 8.83,
      "text": "Do you have any medical conditions, anything you've been treated for? It helps to be thorough at this stage."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 179.71,
      "end_seconds": 181.1,
      "duration_seconds": 1.39,
      "text": "I've got diabetes."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 183.11,
      "end_seconds": 186.37,
      "duration_seconds": 3.26,
      "text": "And what do you do for a living?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 188.19,
      "end_seconds": 191.53,
      "duration_seconds": 3.34,
      "text": "I work night shifts at a warehouse."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 193.18,
      "end_seconds": 195.41,
      "duration_seconds": 2.23,
      "text": "Who's at home with you?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 196.75,
      "end_seconds": 201.02,
      "duration_seconds": 4.27,
      "text": "It's just me and my wife at home now."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 201.52,
      "end_seconds": 203.65,
      "duration_seconds": 2.13,
      "text": "Do you get any exercise?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 205.47,
      "end_seconds": 209.96,
      "duration_seconds": 4.49,
      "text": "I walk for about half an hour most days."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 223.54,
      "end_seconds": 227.35,
      "duration_seconds": 3.81,
      "text": "Let's go through your medication. What are you taking?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 228.88,
      "end_seconds": 233.07,
      "duration_seconds": 4.19,
      "text": "It's Glycomet, 500 milligrams, twice a day."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 234.4,
      "end_seconds": 239.56,
      "duration_seconds": 5.16,
      "text": "Okay, what about allergies, to medicines or foods or anything else?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 240.27,
      "end_seconds": 242.83,
      "duration_seconds": 2.56,
      "text": "No, nothing I'm aware of."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 256.97,
      "end_seconds": 263.44,
      "duration_seconds": 6.47,
      "text": "Putting it all together, the most likely explanation is peripheral neuropathy, possibly related to sugar."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 278.68,
      "end_seconds": 307.67,
      "duration_seconds": 28.99,
      "text": "I'm going to order a vitamin B12 level, for neuropathy. I'm going to order an HbA1c, for neuropathy. The treatment will be pregabalin, 75 milligrams, at night, for four weeks. It's for nerve pain. Check your feet every evening for cuts or blisters, you may not feel them. A short walk every day, even twenty minutes, will help more than you'd think. I'm going to send a referral to podiatry."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 311.32,
      "end_seconds": 323.08,
      "duration_seconds": 11.76,
      "text": "One warning sign to remember: the symptoms get worse. In that case don't wait. Come back after the results are back. Ask me anything before you go."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 324.23,
      "end_seconds": 326.58,
      "duration_seconds": 2.35,
      "text": "All good here. Thank you."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 327.19,
      "end_seconds": 328.17,
      "duration_seconds": 0.98,
      "text": "Take care."
    }
  ]
}