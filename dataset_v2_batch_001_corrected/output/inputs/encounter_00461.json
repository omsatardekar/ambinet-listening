{
  "schema_version": "1.0",
  "encounter_id": "00461",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.67,
      "end_seconds": 5.36,
      "duration_seconds": 4.69,
      "text": "Hi there, is it alright if I come in now?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.43,
      "end_seconds": 10.35,
      "duration_seconds": 3.92,
      "text": "You're fine, sit down. So, what brings you in?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 12.07,
      "end_seconds": 19.51,
      "duration_seconds": 7.44,
      "text": "I mean, I've been dealing with a routine check-up. Oh, and a few skipped meals."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 20.38,
      "end_seconds": 24.5,
      "duration_seconds": 4.12,
      "text": "Let's get your blood pressure and the other basics."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 33.06,
      "end_seconds": 35.03,
      "duration_seconds": 1.97,
      "text": "Just relax your arm..."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 53.02,
      "end_seconds": 65.24,
      "duration_seconds": 12.22,
      "text": "Okay: pulse is 70 beats a minute, blood pressure 123 over 81, height 153 centimetres, saturation 97 percent, temperature 36.5, weight 68 kilos."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 66.25,
      "end_seconds": 70.11,
      "duration_seconds": 3.86,
      "text": "Right, let me check a few things physically."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 88.54,
      "end_seconds": 89.24,
      "duration_seconds": 0.7,
      "text": "Sure."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 90.49,
      "end_seconds": 92.59,
      "duration_seconds": 2.1,
      "text": "Just relax, I'll be quick."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 104.15,
      "end_seconds": 107.0,
      "duration_seconds": 2.85,
      "text": "Your tummy is soft with no tenderness."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 108.75,
      "end_seconds": 110.45,
      "duration_seconds": 1.7,
      "text": "Let me press here."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 120.25,
      "end_seconds": 123.15,
      "duration_seconds": 2.9,
      "text": "Heart and lung sounds are normal."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 124.8,
      "end_seconds": 125.97,
      "duration_seconds": 1.17,
      "text": "Mm, okay."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 131.93,
      "end_seconds": 134.15,
      "duration_seconds": 2.22,
      "text": "Okay, you can sit up."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 152.98,
      "end_seconds": 158.62,
      "duration_seconds": 5.64,
      "text": "Have you had any shortness of breath, persistent cough or chest pain?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 159.36,
      "end_seconds": 161.49,
      "duration_seconds": 2.13,
      "text": "No. None of those."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 162.03,
      "end_seconds": 165.03,
      "duration_seconds": 3.0,
      "text": "How are your bowels, any trouble?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 166.81,
      "end_seconds": 168.54,
      "duration_seconds": 1.73,
      "text": "Nothing unusual, no."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 170.44,
      "end_seconds": 174.85,
      "duration_seconds": 4.41,
      "text": "What about family history, any illnesses that run in the family?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 176.75,
      "end_seconds": 180.34,
      "duration_seconds": 3.59,
      "text": "Oh, my father had a heart attack."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 182.43,
      "end_seconds": 184.98,
      "duration_seconds": 2.55,
      "text": "Is anyone at home with you?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 185.54,
      "end_seconds": 188.76,
      "duration_seconds": 3.22,
      "text": "I share a flat with two friends."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 189.96,
      "end_seconds": 192.38,
      "duration_seconds": 2.42,
      "text": "Do you have a job?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 197.19,
      "end_seconds": 199.17,
      "duration_seconds": 1.98,
      "text": "I'm a self-employed electrician."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 216.98,
      "end_seconds": 224.53,
      "duration_seconds": 7.55,
      "text": "Okay, any medical conditions, anything you've been treated for? It helps to be thorough at this stage."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 225.08,
      "end_seconds": 228.27,
      "duration_seconds": 3.19,
      "text": "No, I've never had anything serious."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 246.67,
      "end_seconds": 249.34,
      "duration_seconds": 2.67,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 250.73,
      "end_seconds": 254.48,
      "duration_seconds": 3.75,
      "text": "No, you know, never had any surgery."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 256.37,
      "end_seconds": 258.33,
      "duration_seconds": 1.96,
      "text": "Any drug or food allergies?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 259.55,
      "end_seconds": 262.5,
      "duration_seconds": 2.95,
      "text": "No, none that I know of."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 263.69,
      "end_seconds": 265.08,
      "duration_seconds": 1.39,
      "text": "Any regular medication?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 266.97,
      "end_seconds": 270.37,
      "duration_seconds": 3.4,
      "text": "No, I don't take anything regularly."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 271.88,
      "end_seconds": 286.22,
      "duration_seconds": 14.34,
      "text": "Having listened and examined, it's hard to say. Generally well, nothing worrying today is one possibility and a tendency towards high cholesterol another, and I'd rather not commit yet."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 286.8,
      "end_seconds": 289.07,
      "duration_seconds": 2.27,
      "text": "Do you think it's serious?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 290.4,
      "end_seconds": 319.22,
      "duration_seconds": 28.82,
      "text": "Nothing I've seen today points to an emergency. It looks like generally well, nothing worrying today, but I'd like to confirm. Let's get an HbA1c, for health screening. I'd rather check than guess, and this is the quickest way to know more. Keep up regular exercise, around a hundred and fifty minutes a week, and go easy on processed food. I'd like to see you again in a year."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 323.41,
      "end_seconds": 325.59,
      "duration_seconds": 2.18,
      "text": "Okay, I'll book that."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 330.21,
      "end_seconds": 332.55,
      "duration_seconds": 2.34,
      "text": "Right, that's all. Go gently."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 333.47,
      "end_seconds": 336.77,
      "duration_seconds": 3.3,
      "text": "No, you've explained it well. Thanks."
    }
  ]
}