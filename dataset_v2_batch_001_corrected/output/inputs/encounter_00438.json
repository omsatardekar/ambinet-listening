{
  "schema_version": "1.0",
  "encounter_id": "00438",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.82,
      "end_seconds": 8.25,
      "duration_seconds": 7.43,
      "text": "Doctor, hello, I've got my papers here, where should I put them?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 9.68,
      "end_seconds": 15.5,
      "duration_seconds": 5.82,
      "text": "Yes, come in, take a seat. What can I do for you today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 17.23,
      "end_seconds": 21.72,
      "duration_seconds": 4.49,
      "text": "Doctor, uh, thank you for seeing us."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 26.49,
      "end_seconds": 30.88,
      "duration_seconds": 4.39,
      "text": "Of course, please stay. It's helpful to have you here."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 31.68,
      "end_seconds": 35.69,
      "duration_seconds": 4.01,
      "text": "She's been having a night-time cough, doctor."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 39.65,
      "end_seconds": 41.62,
      "duration_seconds": 1.97,
      "text": "And when did that start?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 42.61,
      "end_seconds": 46.86,
      "duration_seconds": 4.25,
      "text": "Right, I've had it for two days."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 47.75,
      "end_seconds": 51.06,
      "duration_seconds": 3.31,
      "text": "On a normal day, how strong is it?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 52.68,
      "end_seconds": 74.56,
      "duration_seconds": 21.88,
      "text": "It's severe, honestly. I've had wheezing too, for five days. About wheezing, I'd call it moderate. It happens once or twice a day. I get some relief from the inhaler. I've had shortness of breath on walking too, for five days."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 78.45,
      "end_seconds": 82.98,
      "duration_seconds": 4.53,
      "text": "What about family history, any illnesses that run in the family?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 84.72,
      "end_seconds": 89.89,
      "duration_seconds": 5.17,
      "text": "My father had a heart attack. My mother has migraines."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 106.74,
      "end_seconds": 109.55,
      "duration_seconds": 2.81,
      "text": "Any diagnoses you've been given before?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 110.71,
      "end_seconds": 118.24,
      "duration_seconds": 7.53,
      "text": "Yeah, I've had asthma, yes. I've had low haemoglobin for nearly five years now."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 122.32,
      "end_seconds": 129.21,
      "duration_seconds": 6.89,
      "text": "Okay, I can see low haemoglobin in your file as well. Alright, any previous surgeries?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 130.39,
      "end_seconds": 133.75,
      "duration_seconds": 3.36,
      "text": "So, no, never had any surgery."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 135.34,
      "end_seconds": 140.77,
      "duration_seconds": 5.43,
      "text": "Okay, have you ever reacted badly to a medicine or food? Any allergies?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 142.81,
      "end_seconds": 145.83,
      "duration_seconds": 3.02,
      "text": "Not that I know, no."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 147.14,
      "end_seconds": 149.41,
      "duration_seconds": 2.27,
      "text": "Do you have a job?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 150.46,
      "end_seconds": 152.53,
      "duration_seconds": 2.07,
      "text": "I'm a self-employed electrician."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 153.28,
      "end_seconds": 155.04,
      "duration_seconds": 1.76,
      "text": "Do you live alone?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 157.02,
      "end_seconds": 160.84,
      "duration_seconds": 3.82,
      "text": "Yes, I live on my own."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 162.21,
      "end_seconds": 164.04,
      "duration_seconds": 1.83,
      "text": "What's your diet like?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 165.89,
      "end_seconds": 170.75,
      "duration_seconds": 4.86,
      "text": "I eat out quite a lot, to be honest."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 172.23,
      "end_seconds": 176.12,
      "duration_seconds": 3.89,
      "text": "Which tablets or creams or inhalers do you use?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 176.94,
      "end_seconds": 181.26,
      "duration_seconds": 4.32,
      "text": "Okay, so I'm on Asthalin inhaler, when needed."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 182.82,
      "end_seconds": 191.46,
      "duration_seconds": 8.64,
      "text": "Hmm, it's meant to be when needed, though I don't see she take it every time."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 192.75,
      "end_seconds": 205.29,
      "duration_seconds": 12.54,
      "text": "It's iron tablets, once a day for my blood count. Uh, I used to take Seretide inhaler, but I stopped it."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 206.62,
      "end_seconds": 209.74,
      "duration_seconds": 3.12,
      "text": "Did you get runny nose or chest pain?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 210.49,
      "end_seconds": 215.14,
      "duration_seconds": 4.65,
      "text": "No, uh, none of that at all."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 215.94,
      "end_seconds": 220.98,
      "duration_seconds": 5.04,
      "text": "A few quick ones: weight loss, fever or leg swelling?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 221.65,
      "end_seconds": 223.61,
      "duration_seconds": 1.96,
      "text": "No. None of those."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 224.38,
      "end_seconds": 226.75,
      "duration_seconds": 2.37,
      "text": "Any rashes or skin problems otherwise?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 228.3,
      "end_seconds": 231.3,
      "duration_seconds": 3.0,
      "text": "Nothing on the skin, no."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 233.4,
      "end_seconds": 235.54,
      "duration_seconds": 2.14,
      "text": "Is your mobility otherwise okay?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 236.63,
      "end_seconds": 239.63,
      "duration_seconds": 3.0,
      "text": "Well, I move fine otherwise."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 240.44,
      "end_seconds": 242.93,
      "duration_seconds": 2.49,
      "text": "A few measurements, then we'll continue."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 251.7,
      "end_seconds": 252.62,
      "duration_seconds": 0.92,
      "text": "One second..."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 263.88,
      "end_seconds": 270.28,
      "duration_seconds": 6.4,
      "text": "Okay: blood pressure 118 over 73, respiratory rate 21. And saturation 94 percent, pulse 95."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 272.4,
      "end_seconds": 274.42,
      "duration_seconds": 2.02,
      "text": "Can I examine you now?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 276.4,
      "end_seconds": 278.12,
      "duration_seconds": 1.72,
      "text": "Let me press here."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 292.32,
      "end_seconds": 295.68,
      "duration_seconds": 3.36,
      "text": "You're speaking in full sentences, which is reassuring."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 296.86,
      "end_seconds": 298.47,
      "duration_seconds": 1.61,
      "text": "Let me press here."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 308.87,
      "end_seconds": 315.2,
      "duration_seconds": 6.33,
      "text": "I can hear a widespread wheeze on both sides when you breathe out."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 318.9,
      "end_seconds": 321.13,
      "duration_seconds": 2.23,
      "text": "Okay, you can sit up."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 334.3,
      "end_seconds": 343.24,
      "duration_seconds": 8.94,
      "text": "Right, here's what I'm thinking. I think we're dealing with an asthma flare-up at this stage. A chest infection is still possible."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 347.98,
      "end_seconds": 354.97,
      "duration_seconds": 6.99,
      "text": "I've been thinking the worst, uh, to be honest. Is it bad?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 358.26,
      "end_seconds": 367.0,
      "duration_seconds": 8.74,
      "text": "It's reasonable to be concerned, but right now an asthma flare-up is my leading thought, not anything worse."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 380.81,
      "end_seconds": 400.3,
      "duration_seconds": 19.49,
      "text": "A peak flow reading is what I'd like next, for asthma control. We should do breathing tests for asthma. We'll begin with prednisolone, 30 milligrams, once a day, for five days. You take it by mouth. That should help with asthma flare-up."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 402.33,
      "end_seconds": 404.53,
      "duration_seconds": 2.2,
      "text": "Mm, you know, okay."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 405.68,
      "end_seconds": 412.17,
      "duration_seconds": 6.49,
      "text": "Let me watch you use the inhaler, a lot of people don't get the full dose."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 413.5,
      "end_seconds": 418.27,
      "duration_seconds": 4.77,
      "text": "Should I have a chest X-ray as well?"
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 419.2,
      "end_seconds": 432.66,
      "duration_seconds": 13.46,
      "text": "Not at this point, no. It isn't indicated yet. Please don't wait if the inhaler isn't helping or you can't speak in full sentences. That's when to be seen urgently."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 434.2,
      "end_seconds": 438.63,
      "duration_seconds": 4.43,
      "text": "Alright, I know what to look for."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 440.11,
      "end_seconds": 444.21,
      "duration_seconds": 4.1,
      "text": "Come back in two weeks. Right, that's all. Go gently."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 444.94,
      "end_seconds": 448.91,
      "duration_seconds": 3.97,
      "text": "One thing: no, actually that's all. Thanks."
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 450.81,
      "end_seconds": 452.47,
      "duration_seconds": 1.66,
      "text": "Mind how you go."
    }
  ]
}