{
  "schema_version": "1.0",
  "encounter_id": "00494",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.51,
      "end_seconds": 3.35,
      "duration_seconds": 2.84,
      "text": "Evening. Long day, I imagine. Sit down."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "CAREGIVER",
      "start_seconds": 4.72,
      "end_seconds": 12.42,
      "duration_seconds": 7.7,
      "text": "Yeah, uh, doctor, I've come along because I know the history, if it helps."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 13.68,
      "end_seconds": 19.43,
      "duration_seconds": 5.75,
      "text": "Please do. Extra information is always welcome. Go ahead, tell me what's happening."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "CAREGIVER",
      "start_seconds": 21.07,
      "end_seconds": 28.26,
      "duration_seconds": 7.19,
      "text": "It's excess hair on my face, doctor. She didn't want to come, but I insisted."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 28.84,
      "end_seconds": 32.13,
      "duration_seconds": 3.29,
      "text": "Right, how long are we talking about?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 34.01,
      "end_seconds": 37.71,
      "duration_seconds": 3.7,
      "text": "About a week, give or take."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "CAREGIVER",
      "start_seconds": 39.62,
      "end_seconds": 43.86,
      "duration_seconds": 4.24,
      "text": "It, It was closer to two weeks, doctor."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 45.16,
      "end_seconds": 49.28,
      "duration_seconds": 4.12,
      "text": "Okay, so roughly one to two weeks. Is that right?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 49.82,
      "end_seconds": 73.86,
      "duration_seconds": 24.04,
      "text": "Oh, uh, yes, somewhere around that. Right, as for irregular periods, I honestly can't say when that began. It might have been last month or the month before. I've also been putting on weight around the middle, for about three months."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 75.9,
      "end_seconds": 82.89,
      "duration_seconds": 6.99,
      "text": "Okay, have you had excess hair on your face before, or is this the first time?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 83.71,
      "end_seconds": 94.08,
      "duration_seconds": 10.37,
      "text": "Yes, something like this happened a couple of years ago, and it went away on its own."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 95.2,
      "end_seconds": 97.8,
      "duration_seconds": 2.6,
      "text": "I'll check your pressure and pulse."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 105.91,
      "end_seconds": 107.63,
      "duration_seconds": 1.72,
      "text": "Hold still for me..."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 125.23,
      "end_seconds": 138.73,
      "duration_seconds": 13.5,
      "text": "Okay: pressure 128 over 77, BMI works out to 18.7. And respiratory rate 16, temperature 36.5, pulse is 66 beats a minute, height 173 centimetres, weight 56 kilos."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 140.26,
      "end_seconds": 142.39,
      "duration_seconds": 2.13,
      "text": "Can I examine you now?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 144.12,
      "end_seconds": 146.25,
      "duration_seconds": 2.13,
      "text": "Bear with me a second."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 155.07,
      "end_seconds": 160.34,
      "duration_seconds": 5.27,
      "text": "Facial acne along the jaw and some dark coarse hair on the chin."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 162.48,
      "end_seconds": 172.49,
      "duration_seconds": 10.01,
      "text": "Right, you can sit back down. Have you had any missed period, pelvic pain, trying for a baby or heavy bleeding?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 174.25,
      "end_seconds": 176.59,
      "duration_seconds": 2.34,
      "text": "No. None of those."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 177.24,
      "end_seconds": 179.64,
      "duration_seconds": 2.4,
      "text": "Is your chest okay generally?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 181.67,
      "end_seconds": 182.81,
      "duration_seconds": 1.14,
      "text": "Breathing's normal."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 199.08,
      "end_seconds": 201.63,
      "duration_seconds": 2.55,
      "text": "What about operations, anything like that?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 202.29,
      "end_seconds": 209.44,
      "duration_seconds": 7.15,
      "text": "Hmm, yes, I had my thyroid operated on, a long time ago."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 210.69,
      "end_seconds": 212.75,
      "duration_seconds": 2.06,
      "text": "What's your current medication list?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "CAREGIVER",
      "start_seconds": 217.21,
      "end_seconds": 231.1,
      "duration_seconds": 13.89,
      "text": "Um, she takes Asthalin inhaler, when needed for my asthma. It's, It's omeprazole, 20 milligrams, once a day for the reflux, doctor."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 233.02,
      "end_seconds": 237.39,
      "duration_seconds": 4.37,
      "text": "Moving on to your background, any past medical history?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 239.27,
      "end_seconds": 251.53,
      "duration_seconds": 12.26,
      "text": "Hmm, I've had asthma for nearly five years now. I have acid reflux. My sister suggested writing things down, but I forgot."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 253.18,
      "end_seconds": 254.94,
      "duration_seconds": 1.76,
      "text": "Okay, and what else?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 257.72,
      "end_seconds": 265.87,
      "duration_seconds": 8.15,
      "text": "Alright, asthma, that matches what I have here. Any relatives with health problems I should be aware of?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 267.88,
      "end_seconds": 273.78,
      "duration_seconds": 5.9,
      "text": "My sister has epilepsy. Hmm, my mother has diabetes."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 289.63,
      "end_seconds": 291.22,
      "duration_seconds": 1.59,
      "text": "What's your diet like?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 292.69,
      "end_seconds": 297.47,
      "duration_seconds": 4.78,
      "text": "I eat out quite a lot, to be honest."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 298.49,
      "end_seconds": 300.51,
      "duration_seconds": 2.02,
      "text": "Do you get any exercise?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 302.2,
      "end_seconds": 307.74,
      "duration_seconds": 5.54,
      "text": "I walk for about half an hour most days."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 309.49,
      "end_seconds": 311.93,
      "duration_seconds": 2.44,
      "text": "Tell me about your work."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 314.0,
      "end_seconds": 320.66,
      "duration_seconds": 6.66,
      "text": "I'm a software engineer, so I'm at a screen all day."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 336.77,
      "end_seconds": 346.57,
      "duration_seconds": 9.8,
      "text": "Having listened and examined, it fits best with possible polycystic ovary syndrome. I can't rule out a thyroid problem yet."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 347.48,
      "end_seconds": 349.94,
      "duration_seconds": 2.46,
      "text": "Doctor, is this dangerous?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 351.27,
      "end_seconds": 363.67,
      "duration_seconds": 12.4,
      "text": "It's reasonable to be concerned, but right now possible polycystic ovary syndrome is my leading thought, not anything worse. A pelvic ultrasound is what I'd like next, for irregular periods."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 364.85,
      "end_seconds": 366.92,
      "duration_seconds": 2.07,
      "text": "Mm, um, okay."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 368.35,
      "end_seconds": 372.29,
      "duration_seconds": 3.94,
      "text": "Let's book hormone blood tests to look into irregular periods."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 372.83,
      "end_seconds": 375.87,
      "duration_seconds": 3.04,
      "text": "Where do I go for that?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 377.64,
      "end_seconds": 381.95,
      "duration_seconds": 4.31,
      "text": "Regular exercise and modest weight loss can bring cycles back."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 383.49,
      "end_seconds": 389.85,
      "duration_seconds": 6.36,
      "text": "Could I get a thyroid test done? A friend had it."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 391.47,
      "end_seconds": 400.57,
      "duration_seconds": 9.1,
      "text": "Okay, I don't think that's needed at this stage, the history doesn't call for it. See me again in six weeks."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 401.85,
      "end_seconds": 406.84,
      "duration_seconds": 4.99,
      "text": "Alright, uh, I'll put it in my diary."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 407.8,
      "end_seconds": 413.79,
      "duration_seconds": 5.99,
      "text": "How would you describe the plan, so we're on the same page?"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 415.38,
      "end_seconds": 421.93,
      "duration_seconds": 6.55,
      "text": "So, you know, I come back in six weeks. Is that right?"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 423.3,
      "end_seconds": 428.88,
      "duration_seconds": 5.58,
      "text": "Yes, exactly right. Okay, I think we're finished. Is everything clear?"
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 430.23,
      "end_seconds": 434.48,
      "duration_seconds": 4.25,
      "text": "Oh, no, you've explained it well. Thanks."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 435.2,
      "end_seconds": 435.9,
      "duration_seconds": 0.7,
      "text": "Goodbye."
    }
  ]
}