{
  "schema_version": "1.0",
  "encounter_id": "00340",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.36,
      "end_seconds": 6.62,
      "duration_seconds": 5.26,
      "text": "Hello? Doctor? They told me to come straight in."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.57,
      "end_seconds": 12.47,
      "duration_seconds": 3.9,
      "text": "Yes, do sit. Tell me what's been happening."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 13.04,
      "end_seconds": 16.67,
      "duration_seconds": 3.63,
      "text": "So the thing is, I've got diarrhoea."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 18.52,
      "end_seconds": 21.05,
      "duration_seconds": 2.53,
      "text": "Let me check your vitals now."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 32.51,
      "end_seconds": 34.25,
      "duration_seconds": 1.74,
      "text": "Just relax your arm..."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 55.31,
      "end_seconds": 61.43,
      "duration_seconds": 6.12,
      "text": "Okay: temp 38.9 degrees, pressure 114 over 79, saturation 97 percent. And pulse 95."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 65.06,
      "end_seconds": 68.14,
      "duration_seconds": 3.08,
      "text": "Is that alright, uh, doctor?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 69.24,
      "end_seconds": 75.26,
      "duration_seconds": 6.02,
      "text": "We'll put it in context in a moment. Since when have you had this?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 75.91,
      "end_seconds": 81.61,
      "duration_seconds": 5.7,
      "text": "Around five days... no wait, it's more like ten days."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 83.36,
      "end_seconds": 87.59,
      "duration_seconds": 4.23,
      "text": "Is it constant, or does it come and go?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 89.11,
      "end_seconds": 101.35,
      "duration_seconds": 12.24,
      "text": "It happens a couple of times a week. And stomach cramps as well, since this morning. About stomach cramps, moderate, I'd say."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 109.64,
      "end_seconds": 111.57,
      "duration_seconds": 1.93,
      "text": "Nothing like recent antibiotics?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 112.5,
      "end_seconds": 114.87,
      "duration_seconds": 2.37,
      "text": "Definitely no recent antibiotics."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 115.75,
      "end_seconds": 120.35,
      "duration_seconds": 4.6,
      "text": "A few quick ones: vomiting, black stools or weight loss?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 123.36,
      "end_seconds": 126.98,
      "duration_seconds": 3.62,
      "text": "Uh, no, not any of them."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 127.9,
      "end_seconds": 130.82,
      "duration_seconds": 2.92,
      "text": "Alright, any rashes or skin problems otherwise?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 132.76,
      "end_seconds": 133.89,
      "duration_seconds": 1.13,
      "text": "Skin's normal."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 147.36,
      "end_seconds": 149.73,
      "duration_seconds": 2.37,
      "text": "Who's at home with you?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 151.45,
      "end_seconds": 156.05,
      "duration_seconds": 4.6,
      "text": "It's just me and my wife at home now."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 156.66,
      "end_seconds": 159.56,
      "duration_seconds": 2.9,
      "text": "What do you do to keep active?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 160.93,
      "end_seconds": 164.26,
      "duration_seconds": 3.33,
      "text": "I cycle to work most mornings."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 165.93,
      "end_seconds": 167.67,
      "duration_seconds": 1.74,
      "text": "Okay, how's your diet?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 168.26,
      "end_seconds": 169.84,
      "duration_seconds": 1.58,
      "text": "I'm mostly vegetarian."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 170.46,
      "end_seconds": 173.23,
      "duration_seconds": 2.77,
      "text": "What medicines do you take regularly?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 174.15,
      "end_seconds": 179.44,
      "duration_seconds": 5.29,
      "text": "Well, I'm on aspirin, 75 milligrams, once a day."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 195.8,
      "end_seconds": 198.34,
      "duration_seconds": 2.54,
      "text": "Any allergies I should know about?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 199.78,
      "end_seconds": 204.64,
      "duration_seconds": 4.86,
      "text": "Yes, sulfa drugs, it gives me a rash."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 208.6,
      "end_seconds": 211.06,
      "duration_seconds": 2.46,
      "text": "Have you had any surgery before?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 212.71,
      "end_seconds": 220.72,
      "duration_seconds": 8.01,
      "text": "So, you know, yes, I had a stent put in my heart, two years ago."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 221.99,
      "end_seconds": 226.8,
      "duration_seconds": 4.81,
      "text": "What about family history, any illnesses that run in the family?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 228.08,
      "end_seconds": 231.75,
      "duration_seconds": 3.67,
      "text": "Hmm, my grandmother had breast cancer."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 233.33,
      "end_seconds": 236.32,
      "duration_seconds": 2.99,
      "text": "Is there anything medical in your background?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 237.9,
      "end_seconds": 240.34,
      "duration_seconds": 2.44,
      "text": "I've had diabetes, yes."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 241.93,
      "end_seconds": 242.93,
      "duration_seconds": 1.0,
      "text": "Hm, okay."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 244.67,
      "end_seconds": 246.74,
      "duration_seconds": 2.07,
      "text": "I've got heart disease."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 248.74,
      "end_seconds": 252.89,
      "duration_seconds": 4.15,
      "text": "Alright, diabetes, that matches what I have here."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 254.73,
      "end_seconds": 258.04,
      "duration_seconds": 3.31,
      "text": "Let me have a look at you."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 259.59,
      "end_seconds": 262.31,
      "duration_seconds": 2.72,
      "text": "Stay still while I have a look."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 280.62,
      "end_seconds": 281.91,
      "duration_seconds": 1.29,
      "text": "You're mildly dehydrated."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 282.85,
      "end_seconds": 284.81,
      "duration_seconds": 1.96,
      "text": "Hold that position for me."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 292.42,
      "end_seconds": 298.3,
      "duration_seconds": 5.88,
      "text": "Bowel sounds are active, tummy is soft with mild tenderness all around."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 301.78,
      "end_seconds": 308.78,
      "duration_seconds": 7.0,
      "text": "That's fine, sit up. So, based on the history and the examination, it points towards acute gastroenteritis."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 309.62,
      "end_seconds": 313.8,
      "duration_seconds": 4.18,
      "text": "I mean, is this going to go away?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 315.16,
      "end_seconds": 346.62,
      "duration_seconds": 31.46,
      "text": "Nothing I've seen today points to an emergency. It looks like acute gastroenteritis, but I'd like to confirm. I'm sending you for blood salts because of dehydration. I'd rather check than guess, and this is the quickest way to know more. A stool test is what I'd like next, for diarrhoea. I'll start you on ORS, 1 sachet, after each loose stool, for three days. You take it by mouth. That's for dehydration."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 350.07,
      "end_seconds": 351.19,
      "duration_seconds": 1.12,
      "text": "Mm, okay."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 356.15,
      "end_seconds": 385.51,
      "duration_seconds": 29.36,
      "text": "Stick to bananas, rice, toast, curd, and avoid milk and oily food till it settles. Don't skip meals, and try to eat smaller portions more often through the day. If you pass blood or can't keep anything down, or you feel really unwell, please come to the emergency department. Let's plan a check if it's not better in three days. Okay, we're done for today. Take care."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 386.12,
      "end_seconds": 388.83,
      "duration_seconds": 2.71,
      "text": "Oh, okay, thank you. Bye."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 389.82,
      "end_seconds": 391.5,
      "duration_seconds": 1.68,
      "text": "Mind how you go."
    }
  ]
}