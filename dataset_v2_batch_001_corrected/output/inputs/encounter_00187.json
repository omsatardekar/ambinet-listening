{
  "schema_version": "1.0",
  "encounter_id": "00187",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.73,
      "end_seconds": 2.76,
      "duration_seconds": 2.03,
      "text": "Hello again. Come on in."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 3.32,
      "end_seconds": 4.55,
      "duration_seconds": 1.23,
      "text": "Evening, doctor."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 5.76,
      "end_seconds": 7.98,
      "duration_seconds": 2.22,
      "text": "So, what's been going on?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 9.98,
      "end_seconds": 20.86,
      "duration_seconds": 10.88,
      "text": "I wanted to get a thump in the chest at night looked at. My family kept telling me to get it checked."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 21.62,
      "end_seconds": 24.15,
      "duration_seconds": 2.53,
      "text": "When did you first notice it?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 24.8,
      "end_seconds": 32.35,
      "duration_seconds": 7.55,
      "text": "I mean, probably two days. Yeah. I took the morning off to come in today."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 32.67,
      "end_seconds": 42.08,
      "duration_seconds": 9.41,
      "text": "Right, right. Can you describe it a bit more for me? How strong it is, what the pattern is, what helps."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 45.1,
      "end_seconds": 71.06,
      "duration_seconds": 25.96,
      "text": "Okay, so it feels mild to me. It happens all the time. I looked a few things up online, and that probably didn't help. A neighbour of mine said I should see someone about it. I've also been feeling anxious about it, for about two weeks."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 72.86,
      "end_seconds": 75.68,
      "duration_seconds": 2.82,
      "text": "Has there been poor sleep too?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 77.53,
      "end_seconds": 80.11,
      "duration_seconds": 2.58,
      "text": "Yes, for about a month."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 81.95,
      "end_seconds": 86.02,
      "duration_seconds": 4.07,
      "text": "On a normal day, how strong is it?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 87.69,
      "end_seconds": 89.3,
      "duration_seconds": 1.61,
      "text": "I'd say severe."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 89.75,
      "end_seconds": 90.59,
      "duration_seconds": 0.84,
      "text": "Go on."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 95.57,
      "end_seconds": 101.38,
      "duration_seconds": 5.81,
      "text": "I did have skipped beats at one point, but that's gone now."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 103.03,
      "end_seconds": 106.59,
      "duration_seconds": 3.56,
      "text": "Do you have any known allergies at all?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 108.63,
      "end_seconds": 112.2,
      "duration_seconds": 3.57,
      "text": "I don't have any known medication allergies."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 113.12,
      "end_seconds": 115.33,
      "duration_seconds": 2.21,
      "text": "What's your current medication list?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 117.01,
      "end_seconds": 125.17,
      "duration_seconds": 8.16,
      "text": "Hmm, it's escitalopram, 10 milligrams, once a day for the anxiety. Thyroxine, 75 micrograms, every morning."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 126.74,
      "end_seconds": 131.5,
      "duration_seconds": 4.76,
      "text": "Doctor, our chart from the last visit lists it as 150 micrograms."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 133.16,
      "end_seconds": 136.2,
      "duration_seconds": 3.04,
      "text": "Alright. Did you bring the up-to-date prescription?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 136.96,
      "end_seconds": 145.06,
      "duration_seconds": 8.1,
      "text": "Not with me. I'll bring it next time. Well, I'm on apixaban, 5 milligrams, twice a day."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 145.81,
      "end_seconds": 148.76,
      "duration_seconds": 2.95,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 149.32,
      "end_seconds": 150.9,
      "duration_seconds": 1.58,
      "text": "No operations, no."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 162.1,
      "end_seconds": 166.55,
      "duration_seconds": 4.45,
      "text": "Anyone in the family with similar problems or other conditions?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 167.72,
      "end_seconds": 169.55,
      "duration_seconds": 1.83,
      "text": "My brother has asthma."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 184.1,
      "end_seconds": 188.88,
      "duration_seconds": 4.78,
      "text": "Let's talk a little about your daily life and habits."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 189.82,
      "end_seconds": 202.12,
      "duration_seconds": 12.3,
      "text": "I have a couple of drinks on the weekend. I cycle to work most mornings. I teach at a primary school. Yes, I live on my own."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 203.66,
      "end_seconds": 207.15,
      "duration_seconds": 3.49,
      "text": "Any long-term health problems I should know about?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 209.06,
      "end_seconds": 210.51,
      "duration_seconds": 1.45,
      "text": "I have anxiety."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 212.05,
      "end_seconds": 212.98,
      "duration_seconds": 0.93,
      "text": "Go on."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 216.27,
      "end_seconds": 218.78,
      "duration_seconds": 2.51,
      "text": "I've got an underactive thyroid."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 219.52,
      "end_seconds": 220.91,
      "duration_seconds": 1.39,
      "text": "Okay, anything else?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 222.52,
      "end_seconds": 227.89,
      "duration_seconds": 5.37,
      "text": "I've had an irregular heartbeat for nearly five years now."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 228.63,
      "end_seconds": 237.32,
      "duration_seconds": 8.69,
      "text": "Okay, so. Alright, anxiety, that matches what I have here. How about family history of sudden death?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 238.57,
      "end_seconds": 243.25,
      "duration_seconds": 4.68,
      "text": "I haven't noticed any family history of sudden death."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 244.08,
      "end_seconds": 248.03,
      "duration_seconds": 3.95,
      "text": "Have you noticed energy drinks, fainting or chest pain?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 248.91,
      "end_seconds": 254.79,
      "duration_seconds": 5.88,
      "text": "I haven't had energy drinks, fainting or chest pain, no."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 256.38,
      "end_seconds": 259.83,
      "duration_seconds": 3.45,
      "text": "Any muscle or joint problems besides this?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 261.15,
      "end_seconds": 262.7,
      "duration_seconds": 1.55,
      "text": "Nothing else aches."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 273.02,
      "end_seconds": 280.72,
      "duration_seconds": 7.7,
      "text": "Okay, so the vitals from earlier. Temp 37.0 degrees, pressure 110 over 74, saturation 98 percent, pulse 82."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 281.29,
      "end_seconds": 281.99,
      "duration_seconds": 0.7,
      "text": "Thanks."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 283.9,
      "end_seconds": 286.3,
      "duration_seconds": 2.4,
      "text": "Let's do the physical part now."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 287.79,
      "end_seconds": 289.87,
      "duration_seconds": 2.08,
      "text": "Tell me if anything hurts."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 297.19,
      "end_seconds": 300.28,
      "duration_seconds": 3.09,
      "text": "Heart sounds are normal with no murmur."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 302.11,
      "end_seconds": 304.77,
      "duration_seconds": 2.66,
      "text": "Let me look at this properly."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 321.3,
      "end_seconds": 328.46,
      "duration_seconds": 7.16,
      "text": "Pulse is regular at the moment, with a couple of early beats while I listened."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 331.85,
      "end_seconds": 350.3,
      "duration_seconds": 18.45,
      "text": "That's fine, sit up. Okay, so my impression is this: I'd lean towards benign extra heartbeats, though we should confirm. That's my thinking for now, and it may change as we learn more. We shouldn't forget a rhythm problem."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 352.29,
      "end_seconds": 357.99,
      "duration_seconds": 5.7,
      "text": "I've been thinking the worst, to be honest. Is it bad?"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 359.31,
      "end_seconds": 378.89,
      "duration_seconds": 19.58,
      "text": "I can't promise yet, but most people with benign extra heartbeats, though we should confirm do well once it's treated properly. Let me just check I've got this right. You've had a thump in the chest at night for two days, mild, and no chest pain or energy drinks."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 380.25,
      "end_seconds": 382.72,
      "duration_seconds": 2.47,
      "text": "Yes, um, that's right."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 383.59,
      "end_seconds": 386.61,
      "duration_seconds": 3.02,
      "text": "Any scans or blood work done already?"
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 388.67,
      "end_seconds": 398.35,
      "duration_seconds": 9.68,
      "text": "I had a thyroid test done at another clinic last year. I don't have the report with me."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 399.95,
      "end_seconds": 416.35,
      "duration_seconds": 16.4,
      "text": "Try cutting out caffeine for two weeks and see if the beats settle. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 417.37,
      "end_seconds": 418.07,
      "duration_seconds": 0.7,
      "text": "Understood."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 419.99,
      "end_seconds": 423.26,
      "duration_seconds": 3.27,
      "text": "I'll want another look in four weeks."
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 425.15,
      "end_seconds": 428.95,
      "duration_seconds": 3.8,
      "text": "Alright, I'll put it in my diary."
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 430.92,
      "end_seconds": 433.34,
      "duration_seconds": 2.42,
      "text": "Alright, I'll see you out."
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 434.05,
      "end_seconds": 436.18,
      "duration_seconds": 2.13,
      "text": "Okay, thank you. Bye."
    },
    {
      "segment_id": "SEG0059",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 436.87,
      "end_seconds": 437.57,
      "duration_seconds": 0.7,
      "text": "Goodbye."
    }
  ]
}