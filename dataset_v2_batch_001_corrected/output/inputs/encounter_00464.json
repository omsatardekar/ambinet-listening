{
  "schema_version": "1.0",
  "encounter_id": "00464",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.55,
      "end_seconds": 3.52,
      "duration_seconds": 2.97,
      "text": "Afternoon. Take the chair by the desk."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 4.15,
      "end_seconds": 8.65,
      "duration_seconds": 4.5,
      "text": "Thanks, doctor. It's been a long few days."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 10.38,
      "end_seconds": 14.2,
      "duration_seconds": 3.82,
      "text": "Tell me from the beginning, what's been happening?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 16.1,
      "end_seconds": 21.65,
      "duration_seconds": 5.55,
      "text": "So, I've been putting on weight over the last year, doctor."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 22.46,
      "end_seconds": 25.22,
      "duration_seconds": 2.76,
      "text": "How far back does it go?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 26.8,
      "end_seconds": 49.92,
      "duration_seconds": 23.12,
      "text": "I've had it for three weeks. As for feeling out of breath on stairs, I honestly can't say when that began. It might have been last month or the month before. About feeling out of breath on stairs, I'd call it moderate. I notice it more with stairs."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 50.89,
      "end_seconds": 58.34,
      "duration_seconds": 7.45,
      "text": "Okay, have you been putting on weight over the last year at any time before this?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 59.19,
      "end_seconds": 69.69,
      "duration_seconds": 10.5,
      "text": "Yes, um, something like this happened a couple of years ago, and it went away on its own."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 72.45,
      "end_seconds": 75.34,
      "duration_seconds": 2.89,
      "text": "A few measurements, then we'll continue."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 81.48,
      "end_seconds": 82.41,
      "duration_seconds": 0.93,
      "text": "One second..."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 103.53,
      "end_seconds": 113.07,
      "duration_seconds": 9.54,
      "text": "Okay: temp 36.9 degrees, respiratory rate 17, blood pressure 112 over 70. And pulse is 83 beats a minute."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 113.73,
      "end_seconds": 115.1,
      "duration_seconds": 1.37,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 115.77,
      "end_seconds": 119.92,
      "duration_seconds": 4.15,
      "text": "Don't worry, I'll go through it in a moment."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 121.42,
      "end_seconds": 124.51,
      "duration_seconds": 3.09,
      "text": "If you're comfortable, I'll examine you now."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 126.32,
      "end_seconds": 128.62,
      "duration_seconds": 2.3,
      "text": "Tell me if anything hurts."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 139.53,
      "end_seconds": 143.33,
      "duration_seconds": 3.8,
      "text": "Your waist measures about a hundred and four centimetres."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 148.71,
      "end_seconds": 151.27,
      "duration_seconds": 2.56,
      "text": "Thanks for that. Any irregular periods?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 152.64,
      "end_seconds": 156.28,
      "duration_seconds": 3.64,
      "text": "No, I haven't had any irregular periods."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 157.56,
      "end_seconds": 161.77,
      "duration_seconds": 4.21,
      "text": "Any palpitations, chest pain, heat intolerance or increased thirst?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 163.04,
      "end_seconds": 165.72,
      "duration_seconds": 2.68,
      "text": "No, I'd have mentioned it."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 167.13,
      "end_seconds": 169.69,
      "duration_seconds": 2.56,
      "text": "Is your urine normal, no changes?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 171.61,
      "end_seconds": 173.09,
      "duration_seconds": 1.48,
      "text": "Nothing there, no."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 183.4,
      "end_seconds": 187.86,
      "duration_seconds": 4.46,
      "text": "Alright, what medicines are you taking at the moment?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 188.68,
      "end_seconds": 192.78,
      "duration_seconds": 4.1,
      "text": "Rosuvastatin. I take it at night for my cholesterol."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 194.8,
      "end_seconds": 196.8,
      "duration_seconds": 2.0,
      "text": "And what strength is that?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 197.87,
      "end_seconds": 207.02,
      "duration_seconds": 9.15,
      "text": "10 milligrams, I think that's what's on the box. I'm on Glycomet, 500 milligrams, maybe, twice a day."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 207.93,
      "end_seconds": 211.07,
      "duration_seconds": 3.14,
      "text": "Is the packet here, or the prescription?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 212.31,
      "end_seconds": 214.56,
      "duration_seconds": 2.25,
      "text": "No, it's at home."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 230.34,
      "end_seconds": 232.87,
      "duration_seconds": 2.53,
      "text": "Before I prescribe anything, any allergies?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 234.74,
      "end_seconds": 238.18,
      "duration_seconds": 3.44,
      "text": "Not that I know, uh, no."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 239.53,
      "end_seconds": 242.59,
      "duration_seconds": 3.06,
      "text": "A few questions about your lifestyle now."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 244.54,
      "end_seconds": 252.88,
      "duration_seconds": 8.34,
      "text": "Not really, I don't get much exercise. I'm a self-employed electrician. I try to avoid too much sugar."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 254.63,
      "end_seconds": 257.14,
      "duration_seconds": 2.51,
      "text": "Any diagnoses you've been given before?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 259.0,
      "end_seconds": 261.0,
      "duration_seconds": 2.0,
      "text": "I have high cholesterol."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 261.76,
      "end_seconds": 262.71,
      "duration_seconds": 0.95,
      "text": "Anything more?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 263.73,
      "end_seconds": 267.4,
      "duration_seconds": 3.67,
      "text": "I've had diabetes for five years now."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 268.35,
      "end_seconds": 280.94,
      "duration_seconds": 12.59,
      "text": "Okay. Okay, I can see diabetes in your file as well. Having listened and examined, my working impression is weight gain with a metabolic cause that needs checking."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 291.88,
      "end_seconds": 300.64,
      "duration_seconds": 8.76,
      "text": "Let's get a sleep study, for snoring and sleepiness. An HbA1c is what I'd like next, for weight gain."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 301.56,
      "end_seconds": 304.26,
      "duration_seconds": 2.7,
      "text": "Where do I go for that?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 305.31,
      "end_seconds": 330.48,
      "duration_seconds": 25.17,
      "text": "Start with small, specific changes: smaller portions, no sugary drinks, a thirty-minute walk most days. Try to get to bed and wake up at the same time each day, and keep your phone away from the bed. We'll refer you to a dietitian. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 332.52,
      "end_seconds": 333.6,
      "duration_seconds": 1.08,
      "text": "That's clear."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 334.68,
      "end_seconds": 345.28,
      "duration_seconds": 10.6,
      "text": "Let's plan a check after the results are back. Can you run through the plan with me quickly, just to be certain?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 346.32,
      "end_seconds": 352.55,
      "duration_seconds": 6.23,
      "text": "So, I come back after the results are back. Is that right?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 354.6,
      "end_seconds": 358.98,
      "duration_seconds": 4.38,
      "text": "Yes, exactly right. Okay, we're done for today. Take care."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 360.56,
      "end_seconds": 364.93,
      "duration_seconds": 4.37,
      "text": "That's everything I wanted to ask. Thank you."
    }
  ]
}