{
  "schema_version": "1.0",
  "encounter_id": "00131",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.25,
      "end_seconds": 5.64,
      "duration_seconds": 4.39,
      "text": "Hello, doctor. Where would you like me?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.32,
      "end_seconds": 11.68,
      "duration_seconds": 4.36,
      "text": "No trouble at all, come in. What's been bothering you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 13.5,
      "end_seconds": 21.09,
      "duration_seconds": 7.59,
      "text": "Hmm, doctor, I've come along because I know the history, if it helps."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 21.63,
      "end_seconds": 26.69,
      "duration_seconds": 5.06,
      "text": "Of course, please stay. It's helpful to have you here."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 28.62,
      "end_seconds": 35.5,
      "duration_seconds": 6.88,
      "text": "Hmm, you know, I wanted to get it's got darker looked at."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 36.02,
      "end_seconds": 38.92,
      "duration_seconds": 2.9,
      "text": "Okay, how far back does it go?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 43.68,
      "end_seconds": 45.87,
      "duration_seconds": 2.19,
      "text": "Probably three days. Yeah."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 46.45,
      "end_seconds": 55.01,
      "duration_seconds": 8.56,
      "text": "Hmm, and the other thing I wanted to mention is that I can't really—"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 55.11,
      "end_seconds": 60.42,
      "duration_seconds": 5.31,
      "text": "Tell the doctor about the other thing, that's what worries me."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 60.94,
      "end_seconds": 64.25,
      "duration_seconds": 3.31,
      "text": "I, I was getting to that!"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 64.81,
      "end_seconds": 75.49,
      "duration_seconds": 10.68,
      "text": "So, that's fine, one at a time. I'll ask about everything. What about another new spot on your arm, have you noticed that?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 77.27,
      "end_seconds": 78.92,
      "duration_seconds": 1.65,
      "text": "Yes, since Monday."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 81.01,
      "end_seconds": 87.33,
      "duration_seconds": 6.32,
      "text": "Have you had it's got darker before, or is this the first time?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 88.1,
      "end_seconds": 94.78,
      "duration_seconds": 6.68,
      "text": "A bit, about six months ago. It settled by itself back then."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 109.95,
      "end_seconds": 113.49,
      "duration_seconds": 3.54,
      "text": "So, have you ever been under the knife?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 114.68,
      "end_seconds": 120.1,
      "duration_seconds": 5.42,
      "text": "I mean, I had my gallbladder removed in 2016."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 122.0,
      "end_seconds": 124.79,
      "duration_seconds": 2.79,
      "text": "Is there anything medical in your background?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 125.5,
      "end_seconds": 128.24,
      "duration_seconds": 2.74,
      "text": "Migraines, for about a year."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 129.85,
      "end_seconds": 130.68,
      "duration_seconds": 0.83,
      "text": "And then?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 132.44,
      "end_seconds": 136.1,
      "duration_seconds": 3.66,
      "text": "Okay, so I've had acid reflux, yes."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 142.57,
      "end_seconds": 151.09,
      "duration_seconds": 8.52,
      "text": "Alright, migraines and acid reflux, that matches what I have here. Any allergies I should know about?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 151.66,
      "end_seconds": 160.05,
      "duration_seconds": 8.39,
      "text": "Years back I got itching all over from sulfa drugs, so I stay away from it now."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 161.23,
      "end_seconds": 164.95,
      "duration_seconds": 3.72,
      "text": "Let's go through your medication. What are you taking?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 165.67,
      "end_seconds": 176.48,
      "duration_seconds": 10.81,
      "text": "Hmm, um, I take something called suma... sumatriptan, 50 milligrams, maybe, when needed for my migraines."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 177.21,
      "end_seconds": 182.01,
      "duration_seconds": 4.8,
      "text": "Okay, did you happen to bring the box or the paperwork?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 186.23,
      "end_seconds": 193.67,
      "duration_seconds": 7.44,
      "text": "Yeah, no, it's at home. Right, I'm on pantoprazole, 40 milligrams, before breakfast."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_4",
      "role": "FAMILY_MEMBER",
      "start_seconds": 195.58,
      "end_seconds": 204.25,
      "duration_seconds": 8.67,
      "text": "It's meant to be before breakfast, though I don't see he take it every time."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 206.03,
      "end_seconds": 209.48,
      "duration_seconds": 3.45,
      "text": "Is there a family history of anything significant?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 213.94,
      "end_seconds": 216.76,
      "duration_seconds": 2.82,
      "text": "My father had kidney stones."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 217.31,
      "end_seconds": 219.57,
      "duration_seconds": 2.26,
      "text": "Do you get any exercise?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 220.42,
      "end_seconds": 225.45,
      "duration_seconds": 5.03,
      "text": "I walk for about half an hour most days."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 242.51,
      "end_seconds": 247.9,
      "duration_seconds": 5.39,
      "text": "Have you noticed fever, pain, history of sunburn or weight loss?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 248.51,
      "end_seconds": 263.46,
      "duration_seconds": 14.95,
      "text": "No, no fever, no pain, no history of sunburn. I did have a bit of itching on it at one point, but that went away on its own."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 264.74,
      "end_seconds": 268.7,
      "duration_seconds": 3.96,
      "text": "So, have you had any history of skin cancer?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 270.43,
      "end_seconds": 275.74,
      "duration_seconds": 5.31,
      "text": "Oh, not that I've noticed, no history of skin cancer."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 280.74,
      "end_seconds": 284.1,
      "duration_seconds": 3.36,
      "text": "Has your heart given you any trouble?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 285.84,
      "end_seconds": 291.53,
      "duration_seconds": 5.69,
      "text": "Uh, my heart's been fine, as far as I know."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 292.65,
      "end_seconds": 295.47,
      "duration_seconds": 2.82,
      "text": "Any muscle or joint problems besides this?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 296.91,
      "end_seconds": 299.15,
      "duration_seconds": 2.24,
      "text": "No, joints are fine."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_5",
      "role": "NURSE",
      "start_seconds": 302.88,
      "end_seconds": 314.17,
      "duration_seconds": 11.29,
      "text": "Doctor, I've got the readings for you. Pulse 70, BP is 124 over 81, height 185 centimetres. Weight 89 kilos, respiratory rate 18, BMI works out to 26.0."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 315.02,
      "end_seconds": 316.32,
      "duration_seconds": 1.3,
      "text": "Good, thank you."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 318.52,
      "end_seconds": 321.74,
      "duration_seconds": 3.22,
      "text": "Let me have a look at you."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 322.67,
      "end_seconds": 324.73,
      "duration_seconds": 2.06,
      "text": "Take your time, no rush."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 342.17,
      "end_seconds": 345.56,
      "duration_seconds": 3.39,
      "text": "I can't feel any glands in the armpit."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 347.07,
      "end_seconds": 349.59,
      "duration_seconds": 2.52,
      "text": "Take your time, no rush."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 356.75,
      "end_seconds": 362.13,
      "duration_seconds": 5.38,
      "text": "It's about eight millimetres, with an uneven border and two shades of brown."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 365.77,
      "end_seconds": 390.93,
      "duration_seconds": 25.16,
      "text": "Okay, you can sit up. Let me tell you where I've got to. My working impression is a pigmented lesion that needs to be looked at more closely. I can't rule out a seborrhoeic keratosis yet. Let me repeat that back to make sure. You've had it's got darker for three days, and no pain or history of skin cancer."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 392.18,
      "end_seconds": 395.35,
      "duration_seconds": 3.17,
      "text": "That's it, you know, yes."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 396.3,
      "end_seconds": 422.93,
      "duration_seconds": 26.63,
      "text": "I want a dermoscopy done, that's for changing mole. A skin biopsy is what I'd like next, for changing mole. Please use sunscreen and cover up in the midday sun, and check your skin once a month. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 424.1,
      "end_seconds": 425.8,
      "duration_seconds": 1.7,
      "text": "Right, will do."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 427.87,
      "end_seconds": 433.53,
      "duration_seconds": 5.66,
      "text": "Please don't wait if the symptoms get worse. That's when to be seen urgently."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 435.4,
      "end_seconds": 437.16,
      "duration_seconds": 1.76,
      "text": "Okay, I understand."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 439.21,
      "end_seconds": 441.6,
      "duration_seconds": 2.39,
      "text": "Book a review in two weeks."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 443.69,
      "end_seconds": 446.85,
      "duration_seconds": 3.16,
      "text": "Yeah, okay, see you then."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 448.65,
      "end_seconds": 451.41,
      "duration_seconds": 2.76,
      "text": "Is there anything you wanted to ask?"
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 452.5,
      "end_seconds": 456.33,
      "duration_seconds": 3.83,
      "text": "Hmm, all good here. Thank you."
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 457.76,
      "end_seconds": 459.22,
      "duration_seconds": 1.46,
      "text": "Bye for now."
    }
  ]
}