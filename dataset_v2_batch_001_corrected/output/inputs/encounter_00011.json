  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.7,
      "end_seconds": 7.37,
      "duration_seconds": 6.67,
      "text": "Doctor, hello, I've got my papers here, where should I put them?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.79,
      "end_seconds": 13.29,
      "duration_seconds": 4.5,
      "text": "right on time. Sit, please. How can I help?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 14.6,
      "end_seconds": 19.02,
      "duration_seconds": 4.42,
      "text": "Well, I've been having itchy watery eyes."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 19.96,
      "end_seconds": 23.3,
      "duration_seconds": 3.34,
      "text": "how bad is it, would you say?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 26.15,
      "end_seconds": 27.9,
      "duration_seconds": 1.75,
      "text": "it's moderate, honestly"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 28.6,
      "end_seconds": 31.18,
      "duration_seconds": 2.58,
      "text": "Any a dry cough as well?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 32.81,
      "end_seconds": 34.71,
      "duration_seconds": 1.9,
      "text": "yes, since yesterday"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 36.34,
      "end_seconds": 40.28,
      "duration_seconds": 3.94,
      "text": "Does it happen all the time or in spells?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 42.13,
      "end_seconds": 57.29,
      "duration_seconds": 15.16,
      "text": "It comes and goes. Oh, and sneezing fits. That's been about the same, one week. Right, you know, with sneezing fits, yes, dust. That makes it worse."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 68.18,
      "end_seconds": 70.73,
      "duration_seconds": 2.55,
      "text": "Any rash or loss of smell?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 72.61,
      "end_seconds": 77.63,
      "duration_seconds": 5.02,
      "text": "No rash or loss of smell, none of it."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 78.86,
      "end_seconds": 85.67,
      "duration_seconds": 6.81,
      "text": "Let me check a few things. Any wheezing, shortness of breath or facial pain?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 87.85,
      "end_seconds": 91.46,
      "duration_seconds": 3.61,
      "text": "No, uh, not any of them."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 92.28,
      "end_seconds": 93.76,
      "duration_seconds": 1.48,
      "text": "Neurologically, anything strange?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 95.13,
      "end_seconds": 97.15,
      "duration_seconds": 2.02,
      "text": "No weakness or anything."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 98.0,
      "end_seconds": 102.86,
      "duration_seconds": 4.86,
      "text": "any medication at the moment, including things from the pharmacy?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 103.8,
      "end_seconds": 112.61,
      "duration_seconds": 8.81,
      "text": "Seretide inhaler, twice a day. Right, I'm supposed to take it regularly, but I don't always manage."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 119.69,
      "end_seconds": 125.49,
      "duration_seconds": 5.8,
      "text": "Right, do you have any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 126.83,
      "end_seconds": 129.15,
      "duration_seconds": 2.32,
      "text": "Asthma, for five years."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 130.97,
      "end_seconds": 139.02,
      "duration_seconds": 8.05,
      "text": "Alright, asthma, that matches what I have here. What about family history, any illnesses that run in the family?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 139.96,
      "end_seconds": 143.21,
      "duration_seconds": 3.25,
      "text": "Well, my father had a stroke."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 144.94,
      "end_seconds": 147.12,
      "duration_seconds": 2.18,
      "text": "any drug or food allergies?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 149.18,
      "end_seconds": 152.77,
      "duration_seconds": 3.59,
      "text": "no, um, no allergies to anything"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 153.95,
      "end_seconds": 157.36,
      "duration_seconds": 3.41,
      "text": "Okay, have you had any surgery before?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 158.45,
      "end_seconds": 164.58,
      "duration_seconds": 6.13,
      "text": "Okay, so I had a lump removed from my back years ago."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 168.77,
      "end_seconds": 171.28,
      "duration_seconds": 2.51,
      "text": "now some background about your lifestyle"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 172.29,
      "end_seconds": 183.78,
      "duration_seconds": 11.49,
      "text": "I live with my family, my husband and two kids. Retired. I stopped a few years back. I play badminton on Sundays."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 184.62,
      "end_seconds": 194.92,
      "duration_seconds": 10.3,
      "text": "okay, so so the vitals from earlier. Pulse 65, respiratory rate 17, pressure 112 over 75. SpO2 97 percent on room air, temperature 36.6."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 195.81,
      "end_seconds": 196.51,
      "duration_seconds": 0.7,
      "text": "thanks"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 197.91,
      "end_seconds": 200.23,
      "duration_seconds": 2.32,
      "text": "Can I examine you now?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 218.74,
      "end_seconds": 219.44,
      "duration_seconds": 0.7,
      "text": "Alright."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 221.03,
      "end_seconds": 223.41,
      "duration_seconds": 2.38,
      "text": "tell me if anything hurts"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 242.03,
      "end_seconds": 244.2,
      "duration_seconds": 2.17,
      "text": "Chest is clear, no wheeze."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 245.26,
      "end_seconds": 247.94,
      "duration_seconds": 2.68,
      "text": "let me look at this properly"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 260.81,
      "end_seconds": 264.42,
      "duration_seconds": 3.61,
      "text": "The inside of your nose is pale and swollen."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 268.6,
      "end_seconds": 279.12,
      "duration_seconds": 10.52,
      "text": "alright, thanks, please take a seat again right, here's what I'm thinking this is probably allergic rhinitis i'd also keep sinusitis in mind"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 279.78,
      "end_seconds": 283.26,
      "duration_seconds": 3.48,
      "text": "Yeah, do you think it's serious?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 283.79,
      "end_seconds": 312.22,
      "duration_seconds": 28.43,
      "text": "it's reasonable to be concerned, but right now allergic rhinitis is my leading thought, not anything worse let's book an allergy test to look into allergic rhinitis the treatment will be levocetirizine, 5 milligrams, at night, for two weeks you take it by mouth that's for allergy symptoms the treatment will be fluticasone nasal spray, 50 micrograms, one spray each side daily, for four weeks that's for allergic rhinitis"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 313.7,
      "end_seconds": 331.18,
      "duration_seconds": 17.48,
      "text": "keep the windows closed in the early morning and wash the bedsheets weekly in hot water. If the symptoms get worse, or you feel really unwell, please come to the emergency department. I'd like to see you again in a month. Any last questions?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 332.76,
      "end_seconds": 335.34,
      "duration_seconds": 2.58,
      "text": "Alright, thanks. Bye for now."
    }
  ]
}