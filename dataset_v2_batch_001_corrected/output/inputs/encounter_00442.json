{
  "schema_version": "1.0",
  "encounter_id": "00442",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 0.8,
      "end_seconds": 5.59,
      "duration_seconds": 4.79,
      "text": "Afternoon, doctor. They're in and comfortable, and I have the measurements ready."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.69,
      "end_seconds": 12.09,
      "duration_seconds": 5.4,
      "text": "Great. Hello, come in and sit down. How can I help?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 12.82,
      "end_seconds": 21.3,
      "duration_seconds": 8.48,
      "text": "Mainly I've been feeling a bit dizzy after taking all my tablets. That's why I came."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 23.16,
      "end_seconds": 26.4,
      "duration_seconds": 3.24,
      "text": "What medicines are you taking at the moment?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 27.95,
      "end_seconds": 41.28,
      "duration_seconds": 13.33,
      "text": "Yeah, um, I take atorvastatin, 20 milligrams, at night. Um, I take diclofenac, 50 milligrams, when needed for the joint pain."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 41.75,
      "end_seconds": 42.45,
      "duration_seconds": 0.7,
      "text": "Yes?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 43.32,
      "end_seconds": 50.76,
      "duration_seconds": 7.44,
      "text": "Aspirin. I take it 75 milligrams, once a day for my heart."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 68.75,
      "end_seconds": 71.21,
      "duration_seconds": 2.46,
      "text": "When did you first notice it?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 71.85,
      "end_seconds": 74.3,
      "duration_seconds": 2.45,
      "text": "Probably two days. Yeah."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 75.17,
      "end_seconds": 78.57,
      "duration_seconds": 3.4,
      "text": "On a normal day, how strong is it?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 84.56,
      "end_seconds": 90.52,
      "duration_seconds": 5.96,
      "text": "Severe, really. There was dry mouth, yes, but that went away."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 91.53,
      "end_seconds": 95.38,
      "duration_seconds": 3.85,
      "text": "Any chest pain, black stools, fainting or falls?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 96.47,
      "end_seconds": 100.37,
      "duration_seconds": 3.9,
      "text": "So, no, I'd have mentioned it."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 102.41,
      "end_seconds": 105.03,
      "duration_seconds": 2.62,
      "text": "So, your breathing, any trouble there?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 106.46,
      "end_seconds": 107.56,
      "duration_seconds": 1.1,
      "text": "Breathing's normal."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 108.15,
      "end_seconds": 110.14,
      "duration_seconds": 1.99,
      "text": "Any trouble with the waterworks?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 110.67,
      "end_seconds": 114.28,
      "duration_seconds": 3.61,
      "text": "That's normal as far as I know."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 116.25,
      "end_seconds": 119.13,
      "duration_seconds": 2.88,
      "text": "Before I prescribe anything, any allergies?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 120.44,
      "end_seconds": 126.1,
      "duration_seconds": 5.66,
      "text": "Right, uh, I'm allergic to aspirin, I get a rash."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 128.12,
      "end_seconds": 131.32,
      "duration_seconds": 3.2,
      "text": "Any long-term health problems I should know about?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 133.34,
      "end_seconds": 152.41,
      "duration_seconds": 19.07,
      "text": "High cholesterol, for two years. I have arthritis in my knees, for nearly five years. I'm hoping you can tell me something definite. I wasn't sure whether to come in at all, to be honest."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 154.05,
      "end_seconds": 154.75,
      "duration_seconds": 0.7,
      "text": "Mhm."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 156.51,
      "end_seconds": 160.53,
      "duration_seconds": 4.02,
      "text": "I have diabetes. I've had heart disease, yes."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 165.63,
      "end_seconds": 173.21,
      "duration_seconds": 7.58,
      "text": "Yes, arthritis in your knees and diabetes are known to us, good to have that clear."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 188.63,
      "end_seconds": 190.25,
      "duration_seconds": 1.62,
      "text": "Any procedures or operations?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 192.22,
      "end_seconds": 197.61,
      "duration_seconds": 5.39,
      "text": "I had a stent put in my heart two years ago."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 199.13,
      "end_seconds": 201.8,
      "duration_seconds": 2.67,
      "text": "Now some background about your lifestyle."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 202.64,
      "end_seconds": 214.85,
      "duration_seconds": 12.21,
      "text": "I work in an office, mostly sitting at a desk. It's just me and my wife at home now. I skip breakfast most days."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 216.82,
      "end_seconds": 225.76,
      "duration_seconds": 8.94,
      "text": "Okay, so the vitals from earlier. Blood pressure 112 over 73, pulse 70, temp 36.4 degrees, oxygen saturation is 97 percent."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 226.32,
      "end_seconds": 227.63,
      "duration_seconds": 1.31,
      "text": "Good, thank you."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 229.38,
      "end_seconds": 231.76,
      "duration_seconds": 2.38,
      "text": "Can I examine you now?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 233.48,
      "end_seconds": 234.18,
      "duration_seconds": 0.7,
      "text": "Sure."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 235.97,
      "end_seconds": 238.31,
      "duration_seconds": 2.34,
      "text": "Hold that position for me."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 256.41,
      "end_seconds": 260.05,
      "duration_seconds": 3.64,
      "text": "Your blood pressure falls a little when you stand."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 263.97,
      "end_seconds": 272.74,
      "duration_seconds": 8.77,
      "text": "Thanks for that. Having listened and examined, the most likely explanation is possible side effects from too many medicines."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 280.26,
      "end_seconds": 284.28,
      "duration_seconds": 4.02,
      "text": "I've already done an ECG, it's ready for you."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 285.74,
      "end_seconds": 298.61,
      "duration_seconds": 12.87,
      "text": "So, perfect. Bring every box and bottle you have at home to the next visit, even the herbal ones, and we'll sort them together. Is there anything you wanted to ask?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 299.22,
      "end_seconds": 305.6,
      "duration_seconds": 6.38,
      "text": "Hmm, um, no, I think that's everything. Thank you, doctor."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 310.57,
      "end_seconds": 311.49,
      "duration_seconds": 0.92,
      "text": "Take care."
    }
  ]
}