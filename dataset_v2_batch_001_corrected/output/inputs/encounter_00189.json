{
  "schema_version": "1.0",
  "encounter_id": "00189",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.54,
      "end_seconds": 4.81,
      "duration_seconds": 4.27,
      "text": "Sorry I'm a few minutes behind, doctor."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.92,
      "end_seconds": 10.11,
      "duration_seconds": 4.19,
      "text": "right on time sit, please how can I help?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 10.98,
      "end_seconds": 23.97,
      "duration_seconds": 12.99,
      "text": "Yeah, it's a dry cough that won't go away. I thought I'd wait, but it hasn't gone. I took the morning off to come in today."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 24.58,
      "end_seconds": 29.49,
      "duration_seconds": 4.91,
      "text": "any medication at the moment, including things from the pharmacy?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 31.08,
      "end_seconds": 48.89,
      "duration_seconds": 17.81,
      "text": "Ramipril. I take it 5 milligrams, every morning for my blood pressure. A neighbour of mine said I should see someone about it. Aspirin. I take it 75 milligrams, once a day."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 50.41,
      "end_seconds": 53.47,
      "duration_seconds": 3.06,
      "text": "How bad is it, would you say?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 54.07,
      "end_seconds": 58.07,
      "duration_seconds": 4.0,
      "text": "Hmm, about a four out of ten."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 60.0,
      "end_seconds": 64.23,
      "duration_seconds": 4.23,
      "text": "Have you been clearing your throat all the time?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 66.1,
      "end_seconds": 69.47,
      "duration_seconds": 3.37,
      "text": "Yes, about the same, two years."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 70.44,
      "end_seconds": 71.69,
      "duration_seconds": 1.25,
      "text": "Any night sweats?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 73.21,
      "end_seconds": 75.31,
      "duration_seconds": 2.1,
      "text": "No, no night sweats."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 79.01,
      "end_seconds": 83.69,
      "duration_seconds": 4.68,
      "text": "And what about weight loss, wheezing or shortness of breath?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 88.51,
      "end_seconds": 92.65,
      "duration_seconds": 4.14,
      "text": "Right, um, no, not any of them."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 93.69,
      "end_seconds": 95.71,
      "duration_seconds": 2.02,
      "text": "Any trouble with the waterworks?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 96.45,
      "end_seconds": 100.58,
      "duration_seconds": 4.13,
      "text": "That's normal as far as I know."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 101.52,
      "end_seconds": 103.45,
      "duration_seconds": 1.93,
      "text": "Any procedures or operations?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 104.37,
      "end_seconds": 110.99,
      "duration_seconds": 6.62,
      "text": "yeah, just a stent put in my heart, two years ago"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 112.8,
      "end_seconds": 115.41,
      "duration_seconds": 2.61,
      "text": "Any allergies I should know about?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 117.93,
      "end_seconds": 121.58,
      "duration_seconds": 3.65,
      "text": "No allergies that I know of, no."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 134.58,
      "end_seconds": 138.91,
      "duration_seconds": 4.33,
      "text": "Alright, moving on to your background, any past medical history?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 140.92,
      "end_seconds": 146.99,
      "duration_seconds": 6.07,
      "text": "Yes, acid reflux. I have high blood pressure. I have heart disease."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 151.13,
      "end_seconds": 156.52,
      "duration_seconds": 5.39,
      "text": "Alright, acid reflux and high blood pressure, that matches what I have here."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 172.59,
      "end_seconds": 176.51,
      "duration_seconds": 3.92,
      "text": "Any relatives with health problems I should be aware of?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 180.39,
      "end_seconds": 183.92,
      "duration_seconds": 3.53,
      "text": "My mother had high blood pressure."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 185.95,
      "end_seconds": 191.07,
      "duration_seconds": 5.12,
      "text": "Tell me about your routine, work, habits, that sort of thing."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 193.14,
      "end_seconds": 202.45,
      "duration_seconds": 9.31,
      "text": "I play badminton on Sundays. Yes, I live on my own. I try to avoid too much sugar."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 203.91,
      "end_seconds": 207.36,
      "duration_seconds": 3.45,
      "text": "First the numbers, if you don't mind."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 214.04,
      "end_seconds": 215.89,
      "duration_seconds": 1.85,
      "text": "Just relax your arm..."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 234.64,
      "end_seconds": 244.14,
      "duration_seconds": 9.5,
      "text": "Okay: temperature is 36.7 degrees, oxygen saturation is 98 percent, heart rate 85. And blood pressure 111 over 76, respiratory rate 18."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 245.6,
      "end_seconds": 247.13,
      "duration_seconds": 1.53,
      "text": "is that normal?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 248.34,
      "end_seconds": 252.34,
      "duration_seconds": 4.0,
      "text": "they help build the picture, I'll tell you more soon"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 254.89,
      "end_seconds": 256.93,
      "duration_seconds": 2.04,
      "text": "Can I examine you now?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 258.22,
      "end_seconds": 260.34,
      "duration_seconds": 2.12,
      "text": "Almost done with this part."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 275.41,
      "end_seconds": 280.55,
      "duration_seconds": 5.14,
      "text": "Chest is clear and the throat looks a little red at the back."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 282.67,
      "end_seconds": 284.35,
      "duration_seconds": 1.68,
      "text": "That's fine, sit up."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 298.28,
      "end_seconds": 305.17,
      "duration_seconds": 6.89,
      "text": "Right, here's what I'm thinking. The most likely explanation is a cough driven by acid reflux."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 306.52,
      "end_seconds": 309.57,
      "duration_seconds": 3.05,
      "text": "Is it something serious, doctor?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 314.7,
      "end_seconds": 328.4,
      "duration_seconds": 13.7,
      "text": "I can't promise yet, but most people with a cough driven by acid reflux do well once it's treated properly. We should do a chest X-ray for chronic cough"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 329.52,
      "end_seconds": 332.64,
      "duration_seconds": 3.12,
      "text": "The earliest is Friday, 3:30 pm."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 333.49,
      "end_seconds": 356.64,
      "duration_seconds": 23.15,
      "text": "What I'm giving you is pantoprazole, 40 milligrams, before breakfast, for four weeks. That's for reflux. Don't eat for two or three hours before lying down, and raise the head of the bed a little. Come back in a month. Good. Let us know how you get on."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 357.4,
      "end_seconds": 363.24,
      "duration_seconds": 5.84,
      "text": "I, I think that's clear thank you for being so thorough"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 364.26,
      "end_seconds": 365.05,
      "duration_seconds": 0.79,
      "text": "Take care."
    }
  ]
}