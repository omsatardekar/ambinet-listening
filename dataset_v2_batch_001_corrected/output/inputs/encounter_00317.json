{
  "schema_version": "1.0",
  "encounter_id": "00317",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.71,
      "end_seconds": 5.74,
      "duration_seconds": 5.03,
      "text": "Hello? Doctor? They told me to come straight in."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.62,
      "end_seconds": 10.8,
      "duration_seconds": 3.18,
      "text": "Yes do sit. Tell me what's been happening."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 12.0,
      "end_seconds": 16.92,
      "duration_seconds": 4.92,
      "text": "yeah, good morning, doctor i came along to help out"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 18.58,
      "end_seconds": 23.07,
      "duration_seconds": 4.49,
      "text": "That's fine, sit down. We'll go through it together."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 25.06,
      "end_seconds": 27.46,
      "duration_seconds": 2.4,
      "text": "she's been feeling lightheaded doctor"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_4",
      "role": "NURSE",
      "start_seconds": 28.96,
      "end_seconds": 39.8,
      "duration_seconds": 10.84,
      "text": "here are the numbers, doctor. Temperature is 36.7 degrees, SpO2 99 percent on room air, heart rate 96. Respiratory rate 18, pressure 96 over 66."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 40.41,
      "end_seconds": 44.39,
      "duration_seconds": 3.98,
      "text": "okay, noted so, roughly when did it start?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 45.7,
      "end_seconds": 49.68,
      "duration_seconds": 3.98,
      "text": "okay, so I'd say a week, maybe"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 50.93,
      "end_seconds": 55.7,
      "duration_seconds": 4.77,
      "text": "I, I think it's been nearer two weeks, actually."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 57.73,
      "end_seconds": 62.2,
      "duration_seconds": 4.47,
      "text": "Okay, so roughly one to two weeks. Is that right?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 63.63,
      "end_seconds": 65.95,
      "duration_seconds": 2.32,
      "text": "That sounds about right."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 67.15,
      "end_seconds": 69.18,
      "duration_seconds": 2.03,
      "text": "how intense does it get?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 70.31,
      "end_seconds": 71.32,
      "duration_seconds": 1.01,
      "text": "Mostly moderate."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 73.21,
      "end_seconds": 76.46,
      "duration_seconds": 3.25,
      "text": "Is there anything that takes the edge off?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 77.31,
      "end_seconds": 80.46,
      "duration_seconds": 3.15,
      "text": "Sitting down helps a a bit."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 80.99,
      "end_seconds": 84.62,
      "duration_seconds": 3.63,
      "text": "Does it happen all the time or in spells?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 86.61,
      "end_seconds": 90.56,
      "duration_seconds": 3.95,
      "text": "it's a couple of times a week"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 92.62,
      "end_seconds": 95.16,
      "duration_seconds": 2.54,
      "text": "Is there anything that triggers it?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 96.3,
      "end_seconds": 102.79,
      "duration_seconds": 6.49,
      "text": "I I notice it more with standing up and hot weather."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 103.37,
      "end_seconds": 107.31,
      "duration_seconds": 3.94,
      "text": "What about nearly passing out, have you noticed that?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 109.38,
      "end_seconds": 111.95,
      "duration_seconds": 2.57,
      "text": "Mm, you know, yes."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 113.72,
      "end_seconds": 117.79,
      "duration_seconds": 4.07,
      "text": "alright have you had blurred vision for a few seconds?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 118.41,
      "end_seconds": 128.38,
      "duration_seconds": 9.97,
      "text": "Mm yes. Uh as for blurred vision for a few seconds it feels severe to me."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 130.42,
      "end_seconds": 135.11,
      "duration_seconds": 4.69,
      "text": "Have you been feeling lightheaded at any time before this?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 136.29,
      "end_seconds": 144.79,
      "duration_seconds": 8.5,
      "text": "I mean, uh, a bit, about six months ago. It settled by itself back then"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 146.85,
      "end_seconds": 150.09,
      "duration_seconds": 3.24,
      "text": "did you get palpitations, weakness or slurred speech?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 151.02,
      "end_seconds": 155.26,
      "duration_seconds": 4.24,
      "text": "no, uh, none of that at all"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 157.28,
      "end_seconds": 161.05,
      "duration_seconds": 3.77,
      "text": "Did you get vomiting, fainting completely or chest pain?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 161.86,
      "end_seconds": 165.57,
      "duration_seconds": 3.71,
      "text": "no, none of that that at all"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 170.37,
      "end_seconds": 174.54,
      "duration_seconds": 4.17,
      "text": "What about your tummy and bowels, anything unusual there?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 178.28,
      "end_seconds": 179.88,
      "duration_seconds": 1.6,
      "text": "Nothing unusual, no."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 180.63,
      "end_seconds": 183.92,
      "duration_seconds": 3.29,
      "text": "so, has your heart given you any trouble?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 185.48,
      "end_seconds": 187.6,
      "duration_seconds": 2.12,
      "text": "nothing like that that"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 193.02,
      "end_seconds": 197.46,
      "duration_seconds": 4.44,
      "text": "let's talk a little about your daily life and habits"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 198.8,
      "end_seconds": 217.24,
      "duration_seconds": 18.44,
      "text": "A beer or two most evenings, to be honest. I've never smoked. I'm a software engineer, so I'm at a screen all day. I live with my family, my husband and two kids"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 233.46,
      "end_seconds": 236.01,
      "duration_seconds": 2.55,
      "text": "before I prescribe anything any allergies?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 237.73,
      "end_seconds": 245.72,
      "duration_seconds": 7.99,
      "text": "I had a reaction to aspirin when I was younger wheezing and I've avoided it since."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 257.09,
      "end_seconds": 260.73,
      "duration_seconds": 3.64,
      "text": "Which tablets or creams or inhalers do you use?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 262.66,
      "end_seconds": 270.47,
      "duration_seconds": 7.81,
      "text": "uh, I take metformin, 500 milligrams, maybe, twice a day for my sugar"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 271.27,
      "end_seconds": 276.1,
      "duration_seconds": 4.83,
      "text": "Did you happen to bring the box or the paperwork?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 276.69,
      "end_seconds": 279.72,
      "duration_seconds": 3.03,
      "text": "Right, no, it's at home."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 280.24,
      "end_seconds": 283.06,
      "duration_seconds": 2.82,
      "text": "have you got any chronic problems?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 284.5,
      "end_seconds": 290.15,
      "duration_seconds": 5.65,
      "text": "So, I've had diabetes for about ten years now."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 291.09,
      "end_seconds": 291.79,
      "duration_seconds": 0.7,
      "text": "yes?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 292.41,
      "end_seconds": 299.25,
      "duration_seconds": 6.84,
      "text": "right, so diabetes is already on your record we'll keep that in mind today"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 301.4,
      "end_seconds": 305.58,
      "duration_seconds": 4.18,
      "text": "Right, let me check a a few things physically."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 307.36,
      "end_seconds": 309.45,
      "duration_seconds": 2.09,
      "text": "Tell me if anything hurts."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 326.96,
      "end_seconds": 328.72,
      "duration_seconds": 1.76,
      "text": "Heart rhythm is regular."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 330.28,
      "end_seconds": 332.58,
      "duration_seconds": 2.3,
      "text": "tell me if anything hurts"
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 349.73,
      "end_seconds": 353.97,
      "duration_seconds": 4.24,
      "text": "Your blood pressure drops when you stand, I'll note that."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 358.59,
      "end_seconds": 361.43,
      "duration_seconds": 2.84,
      "text": "that's all I need, thank you"
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 377.53,
      "end_seconds": 388.23,
      "duration_seconds": 10.7,
      "text": "Okay, so so my impression is this: This is probably postural low blood pressure. I'd also keep a heart rhythm problem in mind."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 389.41,
      "end_seconds": 392.21,
      "duration_seconds": 2.8,
      "text": "do you think it's serious?"
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 393.14,
      "end_seconds": 425.85,
      "duration_seconds": 32.71,
      "text": "Nothing I've seen today points to an emergency. It looks like postural low blood pressure, but I'd like to confirm. We should do an ECG for dizziness. Let's get a blood sugar test, for dizziness. I'd rather check than guess, and this is the quickest way to know more. Get up in stages, sit on the edge of the bed for a minute first, and keep drinking water."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 427.92,
      "end_seconds": 438.19,
      "duration_seconds": 10.27,
      "text": "And And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 438.91,
      "end_seconds": 441.92,
      "duration_seconds": 3.01,
      "text": "Right, um, will do."
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 443.0,
      "end_seconds": 446.37,
      "duration_seconds": 3.37,
      "text": "That's it on my side. Anything unclear?"
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 447.35,
      "end_seconds": 450.65,
      "duration_seconds": 3.3,
      "text": "Hmm, no questions. Thank you."
    },
    {
      "segment_id": "SEG0059",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 454.86,
      "end_seconds": 455.56,
      "duration_seconds": 0.7,
      "text": "Goodbye."
    }
  ]
}