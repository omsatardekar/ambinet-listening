  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.63,
      "end_seconds": 4.07,
      "duration_seconds": 3.44,
      "text": "Good morning, doctor. Can I come in?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 4.78,
      "end_seconds": 9.5,
      "duration_seconds": 4.72,
      "text": "That's alright, take a seat. Tell me why you've come."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 11.33,
      "end_seconds": 19.55,
      "duration_seconds": 8.22,
      "text": "I mean, it's hot flushes, mostly. A neighbour of mine said I should see someone about it"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 20.78,
      "end_seconds": 23.47,
      "duration_seconds": 2.69,
      "text": "How long have you had it?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 24.78,
      "end_seconds": 28.06,
      "duration_seconds": 3.28,
      "text": "It's been six months, I'm fairly sure."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 29.34,
      "end_seconds": 31.28,
      "duration_seconds": 1.94,
      "text": "Does anything settle it?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 32.35,
      "end_seconds": 35.49,
      "duration_seconds": 3.14,
      "text": "It settles a little with a fan."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 36.09,
      "end_seconds": 40.46,
      "duration_seconds": 4.37,
      "text": "Does anything bring it on or make it worse?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 42.1,
      "end_seconds": 46.24,
      "duration_seconds": 4.14,
      "text": "Uh, I notice it more with warm rooms."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 46.84,
      "end_seconds": 48.64,
      "duration_seconds": 1.8,
      "text": "do you drink alcohol?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 50.66,
      "end_seconds": 54.4,
      "duration_seconds": 3.74,
      "text": "I gave up drinking about three years ago"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 56.44,
      "end_seconds": 58.61,
      "duration_seconds": 2.17,
      "text": "Okay, any sport or activity?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 59.5,
      "end_seconds": 62.12,
      "duration_seconds": 2.62,
      "text": "I play badminton on Sundays."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 63.35,
      "end_seconds": 66.07,
      "duration_seconds": 2.72,
      "text": "And what do you usually eat?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 67.98,
      "end_seconds": 71.33,
      "duration_seconds": 3.35,
      "text": "Mostly home-cooked food, rice and vegetables."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 77.22,
      "end_seconds": 79.64,
      "duration_seconds": 2.42,
      "text": "What do you do for work?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 81.58,
      "end_seconds": 86.93,
      "duration_seconds": 5.35,
      "text": "I work in an office, mostly sitting at a desk"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 96.67,
      "end_seconds": 99.43,
      "duration_seconds": 2.76,
      "text": "are you on any regular medication?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 100.37,
      "end_seconds": 104.26,
      "duration_seconds": 3.89,
      "text": "No, you know, I don't take anything regularly."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 105.22,
      "end_seconds": 106.5,
      "duration_seconds": 1.28,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 107.76,
      "end_seconds": 109.47,
      "duration_seconds": 1.71,
      "text": "No operations, no."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 117.02,
      "end_seconds": 121.13,
      "duration_seconds": 4.11,
      "text": "do you have any medical conditions I should know about?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 121.92,
      "end_seconds": 125.13,
      "duration_seconds": 3.21,
      "text": "No, nothing, I've generally been healthy."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 126.12,
      "end_seconds": 129.59,
      "duration_seconds": 3.47,
      "text": "Do you have any known allergies at all?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 131.55,
      "end_seconds": 136.44,
      "duration_seconds": 4.89,
      "text": "yes, sulfa drugs, it gives me itching all over"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 138.41,
      "end_seconds": 143.32,
      "duration_seconds": 4.91,
      "text": "Have you noticed bleeding after sex, palpitations or heavy bleeding?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 144.88,
      "end_seconds": 147.5,
      "duration_seconds": 2.62,
      "text": "No, I'd have mentioned it."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 148.58,
      "end_seconds": 152.4,
      "duration_seconds": 3.82,
      "text": "On the the cardiac side, anything I should know?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 152.98,
      "end_seconds": 155.78,
      "duration_seconds": 2.8,
      "text": "No, nothing with my heart."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 171.27,
      "end_seconds": 174.1,
      "duration_seconds": 2.83,
      "text": "Let me measure a few things."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 184.21,
      "end_seconds": 184.99,
      "duration_seconds": 0.78,
      "text": "Almost there..."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 195.61,
      "end_seconds": 207.87,
      "duration_seconds": 12.26,
      "text": "Okay: BMI works out to 26.8, pulse 64, oxygen saturation is 97 percent. And pressure 127 over 71, weight 72 kilos, height 164 centimetres, temperature 36.8."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 209.21,
      "end_seconds": 210.75,
      "duration_seconds": 1.54,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 212.49,
      "end_seconds": 215.73,
      "duration_seconds": 3.24,
      "text": "we'll put it in context in a moment"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 217.63,
      "end_seconds": 219.8,
      "duration_seconds": 2.17,
      "text": "Shall we do the examination?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 221.7,
      "end_seconds": 224.5,
      "duration_seconds": 2.8,
      "text": "Right, bear with me a second."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 243.09,
      "end_seconds": 249.42,
      "duration_seconds": 6.33,
      "text": "Blood pressure and pulse are fine, and there are no breast lumps on examination."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 252.88,
      "end_seconds": 254.11,
      "duration_seconds": 1.23,
      "text": "thanks for that"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 271.4,
      "end_seconds": 283.26,
      "duration_seconds": 11.86,
      "text": "Let me tell you where I've got to. My working impression is perimenopausal symptoms. The reason I say that is that your story and my examination fit together."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 283.78,
      "end_seconds": 289.56,
      "duration_seconds": 5.78,
      "text": "um, um, is this something I'll have for good?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 290.16,
      "end_seconds": 306.52,
      "duration_seconds": 16.36,
      "text": "I understand the worry. At the moment I'd say it's perimenopausal symptoms, and we'll know more once the a bone density scan is back. I'm sending you for a bone density scan because of menopause."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 308.5,
      "end_seconds": 311.32,
      "duration_seconds": 2.82,
      "text": "How long does that take?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 312.59,
      "end_seconds": 315.98,
      "duration_seconds": 3.39,
      "text": "Let's review you after the results are back."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 317.24,
      "end_seconds": 317.94,
      "duration_seconds": 0.7,
      "text": "fine"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 318.64,
      "end_seconds": 322.06,
      "duration_seconds": 3.42,
      "text": "That's it on my side. Anything unclear?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 323.04,
      "end_seconds": 325.65,
      "duration_seconds": 2.61,
      "text": "Thank you for your time."
    }
  ]
