    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 74.64,
      "end_seconds": 80.33,
      "duration_seconds": 5.69,
      "text": "Five days, I think... sorry, three days, I got that wrong."
