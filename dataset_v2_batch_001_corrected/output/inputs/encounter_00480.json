    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 82.16,
      "end_seconds": 85.04,
      "duration_seconds": 2.88,
      "text": "would you call it mild or bad?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 86.85,
      "end_seconds": 88.27,
      "duration_seconds": 1.42,
      "text": "Severe I'd say"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 89.33,
      "end_seconds": 93.76,
      "duration_seconds": 4.43,
      "text": "Have you been feeling hot and sweaty before it?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 98.29,
      "end_seconds": 109.12,
      "duration_seconds": 10.83,
      "text": "yeah. Five days, I'd say as for feeling hot and sweaty before it, a seven out of ten, I suppose"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 115.45,
      "end_seconds": 117.2,
      "duration_seconds": 1.75,
      "text": "any shaking or jerking?"
