    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 117.88,
      "end_seconds": 122.62,
      "duration_seconds": 4.74,
      "text": "not at all, uh, no shaking or jerking"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 123.36,
      "end_seconds": 127.57,
      "duration_seconds": 4.21,
      "text": "A few quick ones: tongue biting, confusion afterwards or palpitations?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 128.8,
      "end_seconds": 131.69,
      "duration_seconds": 2.89,
      "text": "no, not any of them"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 132.97,
      "end_seconds": 137.45,
      "duration_seconds": 4.48,
      "text": "anything with your heart, like skipped beats or fainting?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 138.0,
      "end_seconds": 142.76,
      "duration_seconds": 4.76,
      "text": "Right, my heart's been fine, as far as I know."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 150.3,
      "end_seconds": 152.97,
      "duration_seconds": 2.67,
      "text": "have you got any chronic problems?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 154.12,
      "end_seconds": 156.69,
      "duration_seconds": 2.57,
      "text": "I've got high blood pressure"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 165.01,
      "end_seconds": 169.77,
      "duration_seconds": 4.76,
      "text": "what about allergies to to medicines or foods or anything else?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 171.86,
      "end_seconds": 175.43,
      "duration_seconds": 3.57,
      "text": "I don't have any known medication allergies."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 182.91,
      "end_seconds": 187.2,
      "duration_seconds": 4.29,
      "text": "let's go through your medication what are you taking?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 188.42,
      "end_seconds": 194.68,
      "duration_seconds": 6.26,
      "text": "I take amlodipine, 5 milligrams, once a day for my pressure."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 196.7,
      "end_seconds": 200.2,
      "duration_seconds": 3.5,
      "text": "have you had to have anything operated on?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 201.35,
      "end_seconds": 207.24,
      "duration_seconds": 5.89,
      "text": "uh I had my tonsils out when I was a child"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 208.2,
      "end_seconds": 210.86,
      "duration_seconds": 2.66,
      "text": "so, do you get any exercise?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 211.72,
      "end_seconds": 216.07,
      "duration_seconds": 4.35,
      "text": "I walk for about half an hour most days."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 217.57,
      "end_seconds": 220.87,
      "duration_seconds": 3.3,
      "text": "What kind of work do you do?"
