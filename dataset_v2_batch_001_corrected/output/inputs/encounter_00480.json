    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 55.57,
      "end_seconds": 63.4,
      "duration_seconds": 7.83,
      "text": "okay: temperature 36.6, pulse 73, BP is 114 over 81. And SpO2 97 percent on room air"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 64.06,
      "end_seconds": 66.06,
      "duration_seconds": 2.0,
      "text": "is that alright, doctor?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 66.57,
      "end_seconds": 73.66,
      "duration_seconds": 7.09,
      "text": "They help build the picture, I'll tell you more soon. Since when have you had this?"
