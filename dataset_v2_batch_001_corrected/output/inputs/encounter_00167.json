{
  "schema_version": "1.0",
  "encounter_id": "00167",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.83,
      "end_seconds": 5.64,
      "duration_seconds": 4.81,
      "text": "Hello? Doctor? They told me to come straight in."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.94,
      "end_seconds": 11.05,
      "duration_seconds": 4.11,
      "text": "Right on time. Sit, please. How can I help?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 12.74,
      "end_seconds": 23.05,
      "duration_seconds": 10.31,
      "text": "Thank you for fitting us in, doctor. It's been passing out once last week, doctor. He didn't want to come, but I insisted."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 24.35,
      "end_seconds": 26.7,
      "duration_seconds": 2.35,
      "text": "Let me check your vitals now."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 34.5,
      "end_seconds": 35.39,
      "duration_seconds": 0.89,
      "text": "One second..."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 51.54,
      "end_seconds": 60.63,
      "duration_seconds": 9.09,
      "text": "Okay: BP is 124 over 78, pulse is 82 beats a minute, respiratory rate 14, saturation 97 percent."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 62.17,
      "end_seconds": 63.82,
      "duration_seconds": 1.65,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 64.87,
      "end_seconds": 70.42,
      "duration_seconds": 5.55,
      "text": "I'll explain what that means shortly. How long have you had it?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 71.16,
      "end_seconds": 73.71,
      "duration_seconds": 2.55,
      "text": "Around three days, I think."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 75.6,
      "end_seconds": 79.31,
      "duration_seconds": 3.71,
      "text": "I think it's been nearer five days, actually."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 80.74,
      "end_seconds": 85.19,
      "duration_seconds": 4.45,
      "text": "Okay, so roughly three to five days. Is that right?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 85.75,
      "end_seconds": 86.99,
      "duration_seconds": 1.24,
      "text": "Yeah, roughly."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 88.48,
      "end_seconds": 96.71,
      "duration_seconds": 8.23,
      "text": "Can you describe it a bit more for me? How strong it is, what the pattern is, what helps."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 97.69,
      "end_seconds": 118.61,
      "duration_seconds": 20.92,
      "text": "A six out of ten, I suppose. Standing for long definitely sets it off. I've, I've had a bump on my head after too, for five days. Okay, so I did have a bit of lightheadedness since then at one point, but that's gone now."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 120.43,
      "end_seconds": 123.67,
      "duration_seconds": 3.24,
      "text": "Any loss of bladder control or chest pain?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 125.55,
      "end_seconds": 127.53,
      "duration_seconds": 1.98,
      "text": "No. None of those."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 127.78,
      "end_seconds": 132.74,
      "duration_seconds": 4.96,
      "text": "Mhm. Any tongue biting, confusion afterwards or shaking or jerking?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 134.29,
      "end_seconds": 137.55,
      "duration_seconds": 3.26,
      "text": "No, none of that at all."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 138.89,
      "end_seconds": 141.72,
      "duration_seconds": 2.83,
      "text": "And your skin, any changes there?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 142.25,
      "end_seconds": 143.2,
      "duration_seconds": 0.95,
      "text": "Skin's normal."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 159.52,
      "end_seconds": 161.85,
      "duration_seconds": 2.33,
      "text": "Any drug or food allergies?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 163.06,
      "end_seconds": 167.27,
      "duration_seconds": 4.21,
      "text": "Yes, codeine, it gives me feeling very drowsy."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 168.17,
      "end_seconds": 176.53,
      "duration_seconds": 8.36,
      "text": "What about your general health, any conditions you're being treated for? I'm asking so that we don't miss anything."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 181.15,
      "end_seconds": 188.51,
      "duration_seconds": 7.36,
      "text": "High blood pressure, for nearly five years. Acid reflux, for nearly five years."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 189.56,
      "end_seconds": 200.99,
      "duration_seconds": 11.43,
      "text": "Mhm. Yes, high blood pressure and acid reflux are known to us, good to have that clear. Any medication at the moment, including things from the pharmacy?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 202.76,
      "end_seconds": 204.91,
      "duration_seconds": 2.15,
      "text": "Telmisartan, once a day."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 206.25,
      "end_seconds": 208.98,
      "duration_seconds": 2.73,
      "text": "Alright, and what strength is that?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 210.64,
      "end_seconds": 218.61,
      "duration_seconds": 7.97,
      "text": "40 milligrams, I think that's what's on the box. Omeprazole, 20 milligrams, maybe, once a day."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 219.53,
      "end_seconds": 224.06,
      "duration_seconds": 4.53,
      "text": "Do you have the packet or the prescription with you?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 225.1,
      "end_seconds": 227.18,
      "duration_seconds": 2.08,
      "text": "No, it's at home."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 235.2,
      "end_seconds": 237.44,
      "duration_seconds": 2.24,
      "text": "Who's at home with you?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 238.61,
      "end_seconds": 243.16,
      "duration_seconds": 4.55,
      "text": "It's just me and my wife at home now."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 244.43,
      "end_seconds": 247.84,
      "duration_seconds": 3.41,
      "text": "And what do you do for a living?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 248.97,
      "end_seconds": 252.48,
      "duration_seconds": 3.51,
      "text": "I work night shifts at a warehouse."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 254.39,
      "end_seconds": 256.37,
      "duration_seconds": 1.98,
      "text": "Do you exercise at all?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 258.42,
      "end_seconds": 264.3,
      "duration_seconds": 5.88,
      "text": "I go to the gym a couple of times a week."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 275.07,
      "end_seconds": 305.74,
      "duration_seconds": 30.67,
      "text": "Listening to the whole story, my working impression is a simple faint, probably reflex-related. I want to be honest that this is an impression, not a final answer. Dehydration is also on my list. I want an echocardiogram done, that's for syncope. That will help us see what's going on underneath and decide the next step. I'm going to order a Holter monitor, for syncope."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 307.1,
      "end_seconds": 329.77,
      "duration_seconds": 22.67,
      "text": "Drink enough water and avoid standing still for long stretches, and sit if you feel it coming. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose. We'll catch up in two weeks. Okay, I think we're finished. Is everything clear?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 330.99,
      "end_seconds": 334.5,
      "duration_seconds": 3.51,
      "text": "So, no, you've explained it well. Thanks."
    }
  ]
}