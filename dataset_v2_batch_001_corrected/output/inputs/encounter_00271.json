{
  "schema_version": "1.0",
  "encounter_id": "00271",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.04,
      "end_seconds": 4.65,
      "duration_seconds": 3.61,
      "text": "Hi, doctor. Is this the right room?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.55,
      "end_seconds": 9.49,
      "duration_seconds": 3.94,
      "text": "Right on time. Sit, please. How can I help?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 10.61,
      "end_seconds": 14.1,
      "duration_seconds": 3.49,
      "text": "Thank you for fitting us in, doctor."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 15.49,
      "end_seconds": 19.39,
      "duration_seconds": 3.9,
      "text": "Good, that'll be useful. Pull up a chair."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 20.61,
      "end_seconds": 26.77,
      "duration_seconds": 6.16,
      "text": "Doctor, it's a sore throat. It's getting on my nerves now."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 27.36,
      "end_seconds": 29.77,
      "duration_seconds": 2.41,
      "text": "How long have you had it?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 31.58,
      "end_seconds": 46.72,
      "duration_seconds": 15.14,
      "text": "Probably about a month. Yeah. I looked a few things up online, and that probably didn't help. A neighbour of mine said I should see someone about it."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 47.37,
      "end_seconds": 49.98,
      "duration_seconds": 2.61,
      "text": "Is it mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 52.05,
      "end_seconds": 55.87,
      "duration_seconds": 3.82,
      "text": "Pretty mild, if I'm being honest."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 56.65,
      "end_seconds": 62.68,
      "duration_seconds": 6.03,
      "text": "I was just going to say that the main thing is—"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_4",
      "role": "NURSE",
      "start_seconds": 62.78,
      "end_seconds": 68.88,
      "duration_seconds": 6.1,
      "text": "Sorry to cut in, doctor, quick question: shall I bring the trolley in now or later?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 70.78,
      "end_seconds": 72.85,
      "duration_seconds": 2.07,
      "text": "Later, thanks. Please go on."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 74.93,
      "end_seconds": 78.82,
      "duration_seconds": 3.89,
      "text": "And a dry cough and fever, too."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 79.82,
      "end_seconds": 89.41,
      "duration_seconds": 9.59,
      "text": "Alright, can you describe it a bit more for me? How strong it is, what the pattern is, what helps."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 89.92,
      "end_seconds": 98.7,
      "duration_seconds": 8.78,
      "text": "Maybe a three out of ten on a bad day. Honestly, a couple of times a week."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_5",
      "role": "UNKNOWN",
      "start_seconds": 100.58,
      "end_seconds": 104.64,
      "duration_seconds": 4.06,
      "text": "Yes, that's right, that's how it was."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_4",
      "role": "NURSE",
      "start_seconds": 106.6,
      "end_seconds": 116.71,
      "duration_seconds": 10.11,
      "text": "Okay, so the vitals from earlier. Saturation 97 percent, pressure 104 over 67, pulse is 89 beats a minute. Temperature is 38.9 degrees."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 118.54,
      "end_seconds": 122.35,
      "duration_seconds": 3.81,
      "text": "Thanks. Have you had confusion, by any chance?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 123.23,
      "end_seconds": 127.88,
      "duration_seconds": 4.65,
      "text": "Not that I've noticed, uh, no confusion."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 129.94,
      "end_seconds": 133.89,
      "duration_seconds": 3.95,
      "text": "Any diarrhoea, rash or chest pain at all?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 134.97,
      "end_seconds": 147.39,
      "duration_seconds": 12.42,
      "text": "Yeah, no, no diarrhoea, no rash, no chest pain. I did have body aches at one point, but that went away on its own."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 148.98,
      "end_seconds": 150.6,
      "duration_seconds": 1.62,
      "text": "Any sign of vomiting?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 151.51,
      "end_seconds": 153.02,
      "duration_seconds": 1.51,
      "text": "No. No vomiting."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 154.18,
      "end_seconds": 160.21,
      "duration_seconds": 6.03,
      "text": "Well, actually, doctor, I did notice vomiting. She doesn't always say."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 160.99,
      "end_seconds": 167.11,
      "duration_seconds": 6.12,
      "text": "No, I don't think I did. Maybe a little, I'm not sure."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 169.01,
      "end_seconds": 175.85,
      "duration_seconds": 6.84,
      "text": "Alright, I'll note both what you've said and what you've noticed. So, is your digestion otherwise okay?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 176.98,
      "end_seconds": 179.79,
      "duration_seconds": 2.81,
      "text": "Bowels are regular, nothing odd."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 181.37,
      "end_seconds": 184.78,
      "duration_seconds": 3.41,
      "text": "Anything with your nerves, like weakness or numbness?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 185.66,
      "end_seconds": 188.51,
      "duration_seconds": 2.85,
      "text": "Right, no, that's all normal."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 190.2,
      "end_seconds": 191.4,
      "duration_seconds": 1.2,
      "text": "Do you smoke?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 195.01,
      "end_seconds": 198.98,
      "duration_seconds": 3.97,
      "text": "I stopped smoking about two years back."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 200.41,
      "end_seconds": 202.15,
      "duration_seconds": 1.74,
      "text": "And alcohol, how much?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 203.44,
      "end_seconds": 208.92,
      "duration_seconds": 5.48,
      "text": "I have a couple of drinks on the weekend."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 210.13,
      "end_seconds": 212.29,
      "duration_seconds": 2.16,
      "text": "Tell me about your work."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 213.57,
      "end_seconds": 220.25,
      "duration_seconds": 6.68,
      "text": "I'm a software engineer, so I'm at a screen all day."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 237.47,
      "end_seconds": 243.49,
      "duration_seconds": 6.02,
      "text": "Right, are there any allergies on your record that I should check?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 244.33,
      "end_seconds": 252.08,
      "duration_seconds": 7.75,
      "text": "Oh, not currently, but as a youngster sulfa drugs gave me a rash."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 253.42,
      "end_seconds": 257.71,
      "duration_seconds": 4.29,
      "text": "Tell me about your health in general, any ongoing conditions?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 259.27,
      "end_seconds": 264.91,
      "duration_seconds": 5.64,
      "text": "I have high blood pressure, for about a year."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 266.14,
      "end_seconds": 267.52,
      "duration_seconds": 1.38,
      "text": "Right, any more?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 269.34,
      "end_seconds": 270.6,
      "duration_seconds": 1.26,
      "text": "Yes, asthma."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 272.5,
      "end_seconds": 282.51,
      "duration_seconds": 10.01,
      "text": "Yes, high blood pressure and asthma are known to us, good to have that clear. What medicines are you taking at the moment?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 283.84,
      "end_seconds": 292.12,
      "duration_seconds": 8.28,
      "text": "It's, It's a... um, I can't remember what it's called. It's a round yellow one."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 292.63,
      "end_seconds": 295.5,
      "duration_seconds": 2.87,
      "text": "Do you remember what it's for?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 296.42,
      "end_seconds": 309.91,
      "duration_seconds": 13.49,
      "text": "For my pressure, I believe. My son sets them out for me, I just take what I'm given. I take paracetamol, 500 milligrams, maybe, when needed."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 311.68,
      "end_seconds": 314.7,
      "duration_seconds": 3.02,
      "text": "Is the packet here, or the prescription?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 315.26,
      "end_seconds": 323.46,
      "duration_seconds": 8.2,
      "text": "No, it's at home. I was on Seretide inhaler before. I stopped taking it."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 337.52,
      "end_seconds": 338.79,
      "duration_seconds": 1.27,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 340.46,
      "end_seconds": 342.37,
      "duration_seconds": 1.91,
      "text": "No operations, no."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 343.75,
      "end_seconds": 346.13,
      "duration_seconds": 2.38,
      "text": "Does anything run in the family?"
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 347.28,
      "end_seconds": 354.58,
      "duration_seconds": 7.3,
      "text": "Okay, so my father was diabetic. My mother had high blood pressure."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 355.75,
      "end_seconds": 389.78,
      "duration_seconds": 34.03,
      "text": "A COVID test is what I'd like next, for viral respiratory illness. I want a pulse oximeter reading done, that's for respiratory symptoms. Stay home until you're fever-free and wear a mask around others for a few days. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose. Come back or go to emergency straight away if you become short of breath."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 390.98,
      "end_seconds": 400.88,
      "duration_seconds": 9.9,
      "text": "Please come and see me if it's not better in five days. Right, call the clinic if you need us."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 402.07,
      "end_seconds": 404.97,
      "duration_seconds": 2.9,
      "text": "Oh, thanks, that was helpful."
    }
  ]
}