{
  "schema_version": "1.0",
  "encounter_id": "00072",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.65,
      "end_seconds": 5.46,
      "duration_seconds": 4.81,
      "text": "I mean, excuse me, doctor, should I sit here?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.28,
      "end_seconds": 10.03,
      "duration_seconds": 3.75,
      "text": "Not at all, please sit. What's the problem?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 11.21,
      "end_seconds": 16.82,
      "duration_seconds": 5.61,
      "text": "Good morning, uh, doctor. I came along to help out."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 17.33,
      "end_seconds": 21.36,
      "duration_seconds": 4.03,
      "text": "Good, that'll be useful. Pull up a chair."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 23.27,
      "end_seconds": 28.43,
      "duration_seconds": 5.16,
      "text": "We came because of pain in the lower right tummy."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 29.75,
      "end_seconds": 32.47,
      "duration_seconds": 2.72,
      "text": "What medicines do you take regularly?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 33.18,
      "end_seconds": 38.24,
      "duration_seconds": 5.06,
      "text": "It's apixaban, 5 milligrams, maybe, twice a day."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 39.09,
      "end_seconds": 43.99,
      "duration_seconds": 4.9,
      "text": "do you have the packet or the prescription with you?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 44.56,
      "end_seconds": 53.19,
      "duration_seconds": 8.63,
      "text": "Not with me. I'll bring it next time. Before this I was on losartan; that's been stopped."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 67.2,
      "end_seconds": 69.83,
      "duration_seconds": 2.63,
      "text": "How long have you had it?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 71.78,
      "end_seconds": 73.97,
      "duration_seconds": 2.19,
      "text": "probably two weeks yeah"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 77.49,
      "end_seconds": 82.12,
      "duration_seconds": 4.63,
      "text": "okay, give me more detail on it, whatever comes to mind"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 87.49,
      "end_seconds": 95.63,
      "duration_seconds": 8.14,
      "text": "I'd say a few times a day. It settles a little with lying still. Moderate, really."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 97.15,
      "end_seconds": 100.33,
      "duration_seconds": 3.18,
      "text": "does it come along with anything else?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 105.24,
      "end_seconds": 128.09,
      "duration_seconds": 22.85,
      "text": "When it starts I tend to get nausea as well. Oh, um, and a low fever. That's been about the same, five days. About low fever, about a six out of ten. The, The nausea? That's been since Friday."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 128.69,
      "end_seconds": 132.57,
      "duration_seconds": 3.88,
      "text": "What's the pattern, is it there all day?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 133.98,
      "end_seconds": 136.3,
      "duration_seconds": 2.32,
      "text": "It's every other day."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 137.27,
      "end_seconds": 141.16,
      "duration_seconds": 3.89,
      "text": "and what about diarrhoea, hernia bulge, jaundice or constipation?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 145.46,
      "end_seconds": 148.42,
      "duration_seconds": 2.96,
      "text": "No, um, nothing there."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 150.03,
      "end_seconds": 155.46,
      "duration_seconds": 5.43,
      "text": "Right, and what about burning when passing urine or blood in the stool?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 157.44,
      "end_seconds": 160.23,
      "duration_seconds": 2.79,
      "text": "No, um, nothing there."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 160.91,
      "end_seconds": 162.81,
      "duration_seconds": 1.9,
      "text": "How's your breathing otherwise?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 164.63,
      "end_seconds": 167.93,
      "duration_seconds": 3.3,
      "text": "Oh, no, my breathing's been fine."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 169.17,
      "end_seconds": 172.13,
      "duration_seconds": 2.96,
      "text": "And your skin, any changes there?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 173.98,
      "end_seconds": 178.04,
      "duration_seconds": 4.06,
      "text": "right, um, no, skin's been fine"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 179.38,
      "end_seconds": 183.95,
      "duration_seconds": 4.57,
      "text": "tell me about your health in general, any ongoing conditions?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 185.05,
      "end_seconds": 194.17,
      "duration_seconds": 9.12,
      "text": "I have an irregular heartbeat, for about a year. I didn't want to make a fuss, you know."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 195.8,
      "end_seconds": 196.65,
      "duration_seconds": 0.85,
      "text": "I see"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 198.43,
      "end_seconds": 203.05,
      "duration_seconds": 4.62,
      "text": "I've had high blood pressure for two years now."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 205.71,
      "end_seconds": 212.69,
      "duration_seconds": 6.98,
      "text": "Okay, I can see high blood pressure in your file as well. Any drug or food allergies?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 214.51,
      "end_seconds": 218.38,
      "duration_seconds": 3.87,
      "text": "Shellfish. I come out in... well, hives."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 220.12,
      "end_seconds": 224.13,
      "duration_seconds": 4.01,
      "text": "So, is there a family history of anything significant?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 225.65,
      "end_seconds": 233.03,
      "duration_seconds": 7.38,
      "text": "Oh, uh, my sister has thyroid problems. My mother has diabetes."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 233.69,
      "end_seconds": 235.59,
      "duration_seconds": 1.9,
      "text": "do you drink alcohol?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 237.34,
      "end_seconds": 242.02,
      "duration_seconds": 4.68,
      "text": "I have a couple of drinks on the weekend."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 243.64,
      "end_seconds": 246.07,
      "duration_seconds": 2.43,
      "text": "And what do you usually eat?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 247.89,
      "end_seconds": 251.41,
      "duration_seconds": 3.52,
      "text": "Mostly home-cooked food, rice and vegetables."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 253.39,
      "end_seconds": 255.3,
      "duration_seconds": 1.91,
      "text": "Are you still working?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 256.68,
      "end_seconds": 262.24,
      "duration_seconds": 5.56,
      "text": "I'm retired now, I was a clerk for years."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 278.43,
      "end_seconds": 281.03,
      "duration_seconds": 2.6,
      "text": "What about operations, anything like that?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 281.59,
      "end_seconds": 284.94,
      "duration_seconds": 3.35,
      "text": "Just my gallbladder removed, in 2016."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 285.99,
      "end_seconds": 288.55,
      "duration_seconds": 2.56,
      "text": "Can I take your vitals now?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 296.24,
      "end_seconds": 297.83,
      "duration_seconds": 1.59,
      "text": "Just relax your arm..."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 310.81,
      "end_seconds": 318.55,
      "duration_seconds": 7.74,
      "text": "Okay: pulse 94, SpO2 97 percent on room air, temperature 39.3, blood pressure 106 over 77."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 319.25,
      "end_seconds": 321.52,
      "duration_seconds": 2.27,
      "text": "is that alright, doctor?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 325.39,
      "end_seconds": 328.67,
      "duration_seconds": 3.28,
      "text": "We'll put it in context in a moment."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 331.04,
      "end_seconds": 334.41,
      "duration_seconds": 3.37,
      "text": "Okay, I'd like to to examine you now."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 335.76,
      "end_seconds": 337.78,
      "duration_seconds": 2.02,
      "text": "tell me if anything hurts"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 345.67,
      "end_seconds": 347.41,
      "duration_seconds": 1.74,
      "text": "Bowel sounds are present."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 348.78,
      "end_seconds": 351.02,
      "duration_seconds": 2.24,
      "text": "Bear with me a second."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 369.46,
      "end_seconds": 376.11,
      "duration_seconds": 6.65,
      "text": "there's tenderness in the right lower part and it hurts when I let go suddenly"
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 390.53,
      "end_seconds": 391.23,
      "duration_seconds": 0.7,
      "text": "Sure."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 394.01,
      "end_seconds": 403.72,
      "duration_seconds": 9.71,
      "text": "That's fine, sit up. Having listened and examined, this is probably possible appendicitis. I'd also keep a gastroenteritis in mind."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 405.04,
      "end_seconds": 408.41,
      "duration_seconds": 3.37,
      "text": "Should I be worried about this?"
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 409.4,
      "end_seconds": 423.79,
      "duration_seconds": 14.39,
      "text": "I can't promise yet, but most people with possible appendicitis do well once it's treated properly. An ultrasound of the abdomen is what I'd like next, for right lower abdominal pain."
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 424.32,
      "end_seconds": 428.18,
      "duration_seconds": 3.86,
      "text": "oh, where do I go for that?"
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 430.02,
      "end_seconds": 444.43,
      "duration_seconds": 14.41,
      "text": "I want a urine test done, that's for abdominal pain. It's a routine test and it'll give us a much clearer picture. I want blood tests done, that's for abdominal pain."
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 446.13,
      "end_seconds": 447.79,
      "duration_seconds": 1.66,
      "text": "Okay, that's fine."
    },
    {
      "segment_id": "SEG0059",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 452.51,
      "end_seconds": 485.55,
      "duration_seconds": 33.04,
      "text": "please don't eat or drink anything until the surgeons have seen you please take the tablets with food so they don't upset your stomach and please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose if the pain gets sharper or spreads across the tummy, or you feel really unwell, please come to the emergency department book a review today after the results"
    },
    {
      "segment_id": "SEG0060",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 486.71,
      "end_seconds": 489.48,
      "duration_seconds": 2.77,
      "text": "Is there anything you wanted to ask?"
    },
    {
      "segment_id": "SEG0061",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 490.69,
      "end_seconds": 493.77,
      "duration_seconds": 3.08,
      "text": "Okay, so no questions. Thank you."
    },
    {
      "segment_id": "SEG0062",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 495.42,
      "end_seconds": 496.63,
      "duration_seconds": 1.21,
      "text": "Bye for now."
    }
  ]
}