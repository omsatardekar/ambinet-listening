{
  "schema_version": "1.0",
  "encounter_id": "00328",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.01,
      "end_seconds": 6.56,
      "duration_seconds": 5.55,
      "text": "Yeah, hello? Doctor? They told me to come straight in."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.13,
      "end_seconds": 12.77,
      "duration_seconds": 4.64,
      "text": "Okay, that's alright, take a seat. Tell me why you've come."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 14.34,
      "end_seconds": 19.45,
      "duration_seconds": 5.11,
      "text": "Yeah, doctor, I'm just here to help with the details."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 21.5,
      "end_seconds": 24.6,
      "duration_seconds": 3.1,
      "text": "Okay, absolutely, come and sit beside them."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 27.74,
      "end_seconds": 33.24,
      "duration_seconds": 5.5,
      "text": "Doctor, it's an itchy bottom. That's what we're worried about."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 33.97,
      "end_seconds": 38.03,
      "duration_seconds": 4.06,
      "text": "Is this recent, or has it been a while?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 39.81,
      "end_seconds": 47.56,
      "duration_seconds": 7.75,
      "text": "Right, for three weeks, I'd say. I did try to ignore it for a while."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 49.46,
      "end_seconds": 52.25,
      "duration_seconds": 2.79,
      "text": "would you call it mild or bad?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 53.28,
      "end_seconds": 57.46,
      "duration_seconds": 4.18,
      "text": "I'd give it a four, out of ten."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 58.6,
      "end_seconds": 61.89,
      "duration_seconds": 3.29,
      "text": "does it come along with anything else?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 63.1,
      "end_seconds": 93.82,
      "duration_seconds": 30.72,
      "text": "Uh, uh, it usually comes with a small lump near the back passage. Hmm, the small lump near the back passage? That's been for about a month. So, uh, as for small lump near the back passage, I'd call it moderate. And pain when I pass stool, too."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 95.91,
      "end_seconds": 97.69,
      "duration_seconds": 1.78,
      "text": "Let's do your observations."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 105.2,
      "end_seconds": 107.04,
      "duration_seconds": 1.84,
      "text": "Just relax your arm..."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 128.27,
      "end_seconds": 135.19,
      "duration_seconds": 6.92,
      "text": "Okay: BP is 124 over 80, pulse is 85 beats a minute, respiratory rate 17."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 136.69,
      "end_seconds": 139.68,
      "duration_seconds": 2.99,
      "text": "Let me have a look at you."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 141.43,
      "end_seconds": 142.69,
      "duration_seconds": 1.26,
      "text": "yes, doctor"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 144.17,
      "end_seconds": 146.2,
      "duration_seconds": 2.03,
      "text": "Tell me if anything hurts."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 165.05,
      "end_seconds": 167.01,
      "duration_seconds": 1.96,
      "text": "Tummy is soft and non-tender."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 168.04,
      "end_seconds": 170.09,
      "duration_seconds": 2.05,
      "text": "Almost done with this part."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 184.1,
      "end_seconds": 189.67,
      "duration_seconds": 5.57,
      "text": "there's a small external pile at the edge, and I don't see any fissure"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 192.52,
      "end_seconds": 195.0,
      "duration_seconds": 2.48,
      "text": "Okay, you can sit up."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 203.19,
      "end_seconds": 206.09,
      "duration_seconds": 2.9,
      "text": "Have you had any black stools?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 207.26,
      "end_seconds": 210.74,
      "duration_seconds": 3.48,
      "text": "not at all, no black stools"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 211.25,
      "end_seconds": 216.91,
      "duration_seconds": 5.66,
      "text": "A few quick ones: fever, weight loss or family history of bowel cancer?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 218.41,
      "end_seconds": 222.51,
      "duration_seconds": 4.1,
      "text": "uh, no, I'd have mentioned it"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 224.57,
      "end_seconds": 228.65,
      "duration_seconds": 4.08,
      "text": "Anything with your heart, like skipped beats or fainting?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 232.82,
      "end_seconds": 234.92,
      "duration_seconds": 2.1,
      "text": "no, that's been fine"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 239.1,
      "end_seconds": 243.53,
      "duration_seconds": 4.43,
      "text": "so, any pins and needles or loss of strength anywhere?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 244.31,
      "end_seconds": 245.99,
      "duration_seconds": 1.68,
      "text": "Nothing odd there."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 247.41,
      "end_seconds": 250.16,
      "duration_seconds": 2.75,
      "text": "before I prescribe anything, any allergies?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 251.75,
      "end_seconds": 255.52,
      "duration_seconds": 3.77,
      "text": "No, none that I know of."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 257.04,
      "end_seconds": 258.77,
      "duration_seconds": 1.73,
      "text": "any sport or activity?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 259.99,
      "end_seconds": 262.68,
      "duration_seconds": 2.69,
      "text": "I play badminton on Sundays"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 263.21,
      "end_seconds": 265.59,
      "duration_seconds": 2.38,
      "text": "what kinda work do you do?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 267.62,
      "end_seconds": 272.55,
      "duration_seconds": 4.93,
      "text": "I work on a farm, it's quite physical."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 274.1,
      "end_seconds": 276.18,
      "duration_seconds": 2.08,
      "text": "Who's at home with you?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 278.14,
      "end_seconds": 282.65,
      "duration_seconds": 4.51,
      "text": "It's just me and my wife at home now"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 283.28,
      "end_seconds": 287.49,
      "duration_seconds": 4.21,
      "text": "Do your parents or siblings have any long-term illnesses?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 288.79,
      "end_seconds": 291.68,
      "duration_seconds": 2.89,
      "text": "My father had kidney stones."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 305.62,
      "end_seconds": 309.52,
      "duration_seconds": 3.9,
      "text": "Moving on to your background, any past medical history?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 310.04,
      "end_seconds": 313.61,
      "duration_seconds": 3.57,
      "text": "I have low haemoglobin, for two years."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 314.23,
      "end_seconds": 320.31,
      "duration_seconds": 6.08,
      "text": "Alright, low haemoglobin, that matches what I have here. Any regular medication?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 321.3,
      "end_seconds": 323.99,
      "duration_seconds": 2.69,
      "text": "No, um, nothing regular."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 328.06,
      "end_seconds": 340.62,
      "duration_seconds": 12.56,
      "text": "From what you've told me and what I found, it's hard to say. Haemorrhoids is one possibility and an anal fissure another, and I'd rather not commit yet."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 341.28,
      "end_seconds": 343.96,
      "duration_seconds": 2.68,
      "text": "yeah, doctor, is this dangerous?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 345.8,
      "end_seconds": 350.99,
      "duration_seconds": 5.19,
      "text": "Nothing I've seen today points to an emergency. It looks like haemorrhoids."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 359.72,
      "end_seconds": 373.74,
      "duration_seconds": 14.02,
      "text": "You'll be taking a soothing cream, twice a day, for one week. That's for haemorrhoids. I'd like to see you again in three weeks. Call the clinic if you need us."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 375.14,
      "end_seconds": 377.75,
      "duration_seconds": 2.61,
      "text": "Thank you for your time."
    }
  ]
}