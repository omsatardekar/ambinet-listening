{
  "schema_version": "1.0",
  "encounter_id": "00250",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 0.94,
      "end_seconds": 6.28,
      "duration_seconds": 5.34,
      "text": "Doctor, I've brought them through. The observations are done, whenever you need them."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.08,
      "end_seconds": 11.3,
      "duration_seconds": 4.22,
      "text": "Alright, perfect, thanks. Hello there, so what's the trouble?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 12.67,
      "end_seconds": 15.98,
      "duration_seconds": 3.31,
      "text": "Thank you for fitting us in, doctor."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 16.9,
      "end_seconds": 20.73,
      "duration_seconds": 3.83,
      "text": "That's fine, sit down. We'll go through it together."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 21.92,
      "end_seconds": 26.91,
      "duration_seconds": 4.99,
      "text": "She's been having trouble hearing in my left ear, doctor."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 27.17,
      "end_seconds": 30.95,
      "duration_seconds": 3.78,
      "text": "Mm-hm. Alright, would you call it mild or bad?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 32.83,
      "end_seconds": 36.87,
      "duration_seconds": 4.04,
      "text": "I'd give it a three, out of ten."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 37.57,
      "end_seconds": 43.65,
      "duration_seconds": 6.08,
      "text": "I was just going to say that the main thing is—"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 43.75,
      "end_seconds": 49.78,
      "duration_seconds": 6.03,
      "text": "Sorry to cut in, doctor, quick question: shall I bring the trolley in now or later?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 51.2,
      "end_seconds": 57.2,
      "duration_seconds": 6.0,
      "text": "Later, thanks. Please go on. Have you had a feeling of fullness in the ear?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 58.61,
      "end_seconds": 62.28,
      "duration_seconds": 3.67,
      "text": "Yes, about the same, about a month."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 64.33,
      "end_seconds": 67.49,
      "duration_seconds": 3.16,
      "text": "Would you call it mild or bad?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 68.49,
      "end_seconds": 76.75,
      "duration_seconds": 8.26,
      "text": "Pretty moderate, if I'm being honest. And there's a ringing noise as well, four weeks now."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 78.32,
      "end_seconds": 81.58,
      "duration_seconds": 3.26,
      "text": "What's the pattern, is it there all day?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 83.77,
      "end_seconds": 90.01,
      "duration_seconds": 6.24,
      "text": "It's, um... not exactly... well, hard to explain, I mean—"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 91.96,
      "end_seconds": 99.13,
      "duration_seconds": 7.17,
      "text": "Let me put it another way: how many times in a typical day or week?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 99.64,
      "end_seconds": 103.47,
      "duration_seconds": 3.83,
      "text": "I'd say a few times a day."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 106.91,
      "end_seconds": 110.31,
      "duration_seconds": 3.4,
      "text": "A few quick ones: discharge or ear pain?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 112.01,
      "end_seconds": 115.97,
      "duration_seconds": 3.96,
      "text": "No, uh, none of that at all."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 116.19,
      "end_seconds": 116.89,
      "duration_seconds": 0.7,
      "text": "Yes?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 118.33,
      "end_seconds": 122.02,
      "duration_seconds": 3.69,
      "text": "A few quick ones: dizziness or facial weakness?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 123.52,
      "end_seconds": 127.02,
      "duration_seconds": 3.5,
      "text": "None, as far as I know."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 128.34,
      "end_seconds": 130.68,
      "duration_seconds": 2.34,
      "text": "Has there been any headache?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 134.77,
      "end_seconds": 136.51,
      "duration_seconds": 1.74,
      "text": "No headache, thankfully."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 138.48,
      "end_seconds": 143.17,
      "duration_seconds": 4.69,
      "text": "Actually, doctor, I did notice headache. She doesn't always say."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 144.12,
      "end_seconds": 149.91,
      "duration_seconds": 5.79,
      "text": "No, I don't think I did. Maybe a little, I'm not sure."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 150.74,
      "end_seconds": 158.13,
      "duration_seconds": 7.39,
      "text": "Alright, I'll note both what you've said and what you've noticed. How's your breathing otherwise?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 159.09,
      "end_seconds": 160.6,
      "duration_seconds": 1.51,
      "text": "No, nothing there."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 162.6,
      "end_seconds": 164.58,
      "duration_seconds": 1.98,
      "text": "Any trouble with the waterworks?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 169.49,
      "end_seconds": 171.83,
      "duration_seconds": 2.34,
      "text": "No, that's all fine."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 173.21,
      "end_seconds": 174.57,
      "duration_seconds": 1.36,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 176.16,
      "end_seconds": 177.85,
      "duration_seconds": 1.69,
      "text": "No operations, no."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 188.72,
      "end_seconds": 191.56,
      "duration_seconds": 2.84,
      "text": "Now some background about your lifestyle."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 192.45,
      "end_seconds": 207.04,
      "duration_seconds": 14.59,
      "text": "I stopped smoking about two years back. I gave up drinking about three years ago. I work night shifts at a warehouse. I try to avoid too much sugar."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 207.89,
      "end_seconds": 210.8,
      "duration_seconds": 2.91,
      "text": "Before I prescribe anything, any allergies?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 212.2,
      "end_seconds": 214.55,
      "duration_seconds": 2.35,
      "text": "No, no allergies to anything."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 215.85,
      "end_seconds": 218.41,
      "duration_seconds": 2.56,
      "text": "Have you got any chronic problems?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 219.46,
      "end_seconds": 228.23,
      "duration_seconds": 8.77,
      "text": "I have high blood pressure, for nearly five years. Diabetes, for nearly five years. Yes, COPD."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 229.34,
      "end_seconds": 230.33,
      "duration_seconds": 0.99,
      "text": "And then?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 231.0,
      "end_seconds": 243.42,
      "duration_seconds": 12.42,
      "text": "Right, so diabetes and COPD are already on your record. We'll keep that in mind today. Anyone in the family with similar problems or other conditions?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 244.47,
      "end_seconds": 248.59,
      "duration_seconds": 4.12,
      "text": "My mother has migraines. My brother has asthma."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 250.5,
      "end_seconds": 252.96,
      "duration_seconds": 2.46,
      "text": "What medicines do you take regularly?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 255.1,
      "end_seconds": 261.84,
      "duration_seconds": 6.74,
      "text": "It's a... um, I can't remember what it's called. It's a small white one."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 263.16,
      "end_seconds": 265.56,
      "duration_seconds": 2.4,
      "text": "Do you remember what it's for?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 267.53,
      "end_seconds": 287.74,
      "duration_seconds": 20.21,
      "text": "For my pressure, I believe. My husband sets them out for me, I just take what I'm given. Glimepiride. I take it 2 milligrams, before breakfast for my sugar. Tiotropium inhaler. I take it once a day. Metformin I don't take anymore."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 303.45,
      "end_seconds": 318.06,
      "duration_seconds": 14.61,
      "text": "Here are the numbers, doctor. Temperature is 36.9 degrees, saturation 99 percent, pulse 80, BP is 108 over 77, weight 70 kilos, height 150 centimetres, BMI works out to 31.1."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 320.11,
      "end_seconds": 321.12,
      "duration_seconds": 1.01,
      "text": "Okay, noted."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 323.03,
      "end_seconds": 326.21,
      "duration_seconds": 3.18,
      "text": "If you're comfortable, I'll examine you now."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 327.65,
      "end_seconds": 329.6,
      "duration_seconds": 1.95,
      "text": "Almost done with this part."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 345.02,
      "end_seconds": 350.97,
      "duration_seconds": 5.95,
      "text": "There's a lot of wax in the left ear canal, I can't see the drum."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 352.67,
      "end_seconds": 356.96,
      "duration_seconds": 4.29,
      "text": "A little pressure here, tell me if it's tender."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 367.31,
      "end_seconds": 370.77,
      "duration_seconds": 3.46,
      "text": "The right ear canal and drum are normal."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 373.7,
      "end_seconds": 404.16,
      "duration_seconds": 30.46,
      "text": "That's all I need, thank you. So, based on the history and the examination, I don't have a clear answer today: hearing loss from wax is possible, and so is an inner ear problem. Let's get a hearing test, for hearing loss. The treatment will be ear drops, three times a day, for five days. That's for wax softening. Please don't use cotton buds or ear candles, they push the wax in further."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 404.99,
      "end_seconds": 420.81,
      "duration_seconds": 15.82,
      "text": "Avoid taking any extra painkillers on top of what I'm prescribing without checking with us. One warning sign to remember: the symptoms get worse. In that case don't wait. Let's review you in a week. Right, that's all. Go gently."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 422.16,
      "end_seconds": 424.71,
      "duration_seconds": 2.55,
      "text": "Alright, thanks. Bye for now."
    }
  ]
}