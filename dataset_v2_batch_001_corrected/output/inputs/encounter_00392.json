{
  "schema_version": "1.0",
  "encounter_id": "00392",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.02,
      "end_seconds": 5.29,
      "duration_seconds": 4.27,
      "text": "Sorry I'm a few minutes behind, doctor."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.55,
      "end_seconds": 11.96,
      "duration_seconds": 5.41,
      "text": "Yes, come in, take a seat. What can I do for you today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 13.13,
      "end_seconds": 29.6,
      "duration_seconds": 16.47,
      "text": "Yeah, it's fever with chills. I don't know what's causing it. I've never really been one for hospitals. My sister suggested writing things down, but I forgot."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 30.67,
      "end_seconds": 32.49,
      "duration_seconds": 1.82,
      "text": "Let's do your observations."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 40.79,
      "end_seconds": 42.7,
      "duration_seconds": 1.91,
      "text": "Just relax your arm..."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 58.48,
      "end_seconds": 67.99,
      "duration_seconds": 9.51,
      "text": "Okay: blood pressure 104 over 76, oxygen saturation is 96 percent, pulse is 89 beats a minute. How far back does it go?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 70.88,
      "end_seconds": 76.72,
      "duration_seconds": 5.84,
      "text": "Well, around five days... no wait, it's more like three days."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 78.61,
      "end_seconds": 81.07,
      "duration_seconds": 2.46,
      "text": "And how severe is it?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 86.98,
      "end_seconds": 88.44,
      "duration_seconds": 1.46,
      "text": "I'd say moderate."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 90.38,
      "end_seconds": 93.77,
      "duration_seconds": 3.39,
      "text": "Does it come along with anything else?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 94.6,
      "end_seconds": 106.54,
      "duration_seconds": 11.94,
      "text": "Terrible shaking and sweating goes along with it, most of the time. And I've been feeling very weak as well."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 108.13,
      "end_seconds": 112.83,
      "duration_seconds": 4.7,
      "text": "Let me check a few things. Any rash, diarrhoea or cough?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 114.44,
      "end_seconds": 121.05,
      "duration_seconds": 6.61,
      "text": "Okay, um, so no rash, diarrhoea or cough, none of it."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 123.02,
      "end_seconds": 125.26,
      "duration_seconds": 2.24,
      "text": "And vomiting, any of that?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 129.8,
      "end_seconds": 133.74,
      "duration_seconds": 3.94,
      "text": "Okay, so I haven't noticed any vomiting."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 134.75,
      "end_seconds": 136.85,
      "duration_seconds": 2.1,
      "text": "Is your mobility otherwise okay?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 137.93,
      "end_seconds": 139.84,
      "duration_seconds": 1.91,
      "text": "No, nothing there."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 140.5,
      "end_seconds": 143.99,
      "duration_seconds": 3.49,
      "text": "Anything with your nerves, like weakness or numbness?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 145.82,
      "end_seconds": 149.48,
      "duration_seconds": 3.66,
      "text": "Um, no, nothing like that."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 150.59,
      "end_seconds": 153.44,
      "duration_seconds": 2.85,
      "text": "Is there anything medical in your background?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 154.29,
      "end_seconds": 158.31,
      "duration_seconds": 4.02,
      "text": "An enlarged prostate, for about a year."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 159.44,
      "end_seconds": 164.96,
      "duration_seconds": 5.52,
      "text": "Mm. Do you have any allergies to medicines, food, anything at all?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 166.93,
      "end_seconds": 170.4,
      "duration_seconds": 3.47,
      "text": "Right, no, no allergies to anything."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 183.78,
      "end_seconds": 185.0,
      "duration_seconds": 1.22,
      "text": "How about smoking?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 186.27,
      "end_seconds": 189.91,
      "duration_seconds": 3.64,
      "text": "No, I don't smoke and never have."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 191.6,
      "end_seconds": 195.0,
      "duration_seconds": 3.4,
      "text": "Alright, and what do you usually eat?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 195.74,
      "end_seconds": 198.95,
      "duration_seconds": 3.21,
      "text": "Mostly home-cooked food, rice and vegetables."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 200.66,
      "end_seconds": 201.9,
      "duration_seconds": 1.24,
      "text": "What's your job?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 203.5,
      "end_seconds": 206.51,
      "duration_seconds": 3.01,
      "text": "I teach at a primary school."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 208.57,
      "end_seconds": 210.38,
      "duration_seconds": 1.81,
      "text": "Any sport or activity?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 210.99,
      "end_seconds": 214.0,
      "duration_seconds": 3.01,
      "text": "I play badminton on Sundays."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 215.82,
      "end_seconds": 220.23,
      "duration_seconds": 4.41,
      "text": "Alright, have you had to have anything operated on?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 221.99,
      "end_seconds": 228.56,
      "duration_seconds": 6.57,
      "text": "I mean, yes, I had a hernia repair, about five years back."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 240.86,
      "end_seconds": 243.21,
      "duration_seconds": 2.35,
      "text": "What's your current medication list?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 244.09,
      "end_seconds": 249.19,
      "duration_seconds": 5.1,
      "text": "Um, it's tamsulosin, 0.4 milligrams, at night."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 249.72,
      "end_seconds": 252.33,
      "duration_seconds": 2.61,
      "text": "Roughly how long on that one?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 253.51,
      "end_seconds": 259.51,
      "duration_seconds": 6.0,
      "text": "Two years now. I'm on paracetamol, 500 milligrams, when needed."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 262.0,
      "end_seconds": 265.78,
      "duration_seconds": 3.78,
      "text": "Okay, I need to examine you for this."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 270.37,
      "end_seconds": 271.49,
      "duration_seconds": 1.12,
      "text": "Go ahead."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 273.01,
      "end_seconds": 275.24,
      "duration_seconds": 2.23,
      "text": "Tell me if anything hurts."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 285.01,
      "end_seconds": 289.48,
      "duration_seconds": 4.47,
      "text": "No rash anywhere on your body that I can see."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 293.11,
      "end_seconds": 295.85,
      "duration_seconds": 2.74,
      "text": "Right, you can sit back down."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 309.47,
      "end_seconds": 341.91,
      "duration_seconds": 32.44,
      "text": "Having listened and examined, I don't have a clear answer today: malaria until proven otherwise is possible, and so is a viral illness. Let's get a malaria test, for fever after travel. I'll request blood tests, it'll help with fever. Let the lab know you travelled recently, that's important for the tests. Come back or go to emergency straight away if you get confused, very drowsy, or the shaking returns. See me again in two days."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 344.02,
      "end_seconds": 346.2,
      "duration_seconds": 2.18,
      "text": "Alright, I'll see you out."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 346.83,
      "end_seconds": 350.73,
      "duration_seconds": 3.9,
      "text": "Alright, you know, thanks. Bye for now."
    }
  ]
}