{
  "schema_version": "1.0",
  "encounter_id": "00239",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.58,
      "end_seconds": 3.89,
      "duration_seconds": 3.31,
      "text": "Hello, doctor. Where would you like me?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.4,
      "end_seconds": 9.41,
      "duration_seconds": 4.01,
      "text": "That's alright, take a seat. Tell me why you've come."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 10.08,
      "end_seconds": 16.81,
      "duration_seconds": 6.73,
      "text": "I wanted to get a heavy feeling in the left arm looked at."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 17.25,
      "end_seconds": 18.0,
      "duration_seconds": 0.75,
      "text": "Uh-huh."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 19.86,
      "end_seconds": 25.4,
      "duration_seconds": 5.54,
      "text": "Oh, and tiredness. That's been about the same, two weeks."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 26.33,
      "end_seconds": 28.77,
      "duration_seconds": 2.44,
      "text": "Have you had breathlessness on exertion?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 30.38,
      "end_seconds": 41.65,
      "duration_seconds": 11.27,
      "text": "Yes, for three weeks. About breathlessness on exertion, a four out of ten, I suppose. Honestly, a few times a day."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 43.44,
      "end_seconds": 52.42,
      "duration_seconds": 8.98,
      "text": "So, have you had a heavy feeling in the left arm before, or is this the first time?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 57.51,
      "end_seconds": 64.15,
      "duration_seconds": 6.64,
      "text": "A bit, about six months ago. It settled by itself back then."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 68.76,
      "end_seconds": 72.92,
      "duration_seconds": 4.16,
      "text": "A few quick ones: swelling in the ankles or fainting?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 74.14,
      "end_seconds": 77.07,
      "duration_seconds": 2.93,
      "text": "No, none of that at all."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 78.04,
      "end_seconds": 80.42,
      "duration_seconds": 2.38,
      "text": "Did you get cough or fever?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 81.4,
      "end_seconds": 83.65,
      "duration_seconds": 2.25,
      "text": "No, none of those."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 84.32,
      "end_seconds": 87.97,
      "duration_seconds": 3.65,
      "text": "Have you had pain at rest, by any chance?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 88.61,
      "end_seconds": 91.33,
      "duration_seconds": 2.72,
      "text": "Nope, no pain at rest."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 95.63,
      "end_seconds": 100.34,
      "duration_seconds": 4.71,
      "text": "Any change in your bowel habit or your stomach generally?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 101.25,
      "end_seconds": 103.31,
      "duration_seconds": 2.06,
      "text": "No, all normal there."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 104.18,
      "end_seconds": 108.22,
      "duration_seconds": 4.04,
      "text": "Let's talk a little about your daily life and habits."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 110.26,
      "end_seconds": 121.52,
      "duration_seconds": 11.26,
      "text": "I skip breakfast most days. Yes, I'm a nurse on a busy ward. I stay with my daughter and her family."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 128.69,
      "end_seconds": 129.91,
      "duration_seconds": 1.22,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 131.54,
      "end_seconds": 133.95,
      "duration_seconds": 2.41,
      "text": "No, never had any surgery."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 150.35,
      "end_seconds": 152.94,
      "duration_seconds": 2.59,
      "text": "What medicines do you take regularly?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 154.95,
      "end_seconds": 175.85,
      "duration_seconds": 20.9,
      "text": "I take clopidogrel, 75 milligrams, once a day. Though honestly, some days I forget to take it. I'm on amlodipine, 5 milligrams, once a day for my pressure. I had ramipril at one point, uh, but I'm off it now."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 177.46,
      "end_seconds": 182.69,
      "duration_seconds": 5.23,
      "text": "Have you ever reacted badly to a medicine or food? Any allergies?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 184.6,
      "end_seconds": 187.65,
      "duration_seconds": 3.05,
      "text": "Yes, eggs. I get stomach cramps."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 188.34,
      "end_seconds": 192.99,
      "duration_seconds": 4.65,
      "text": "What about family history, any illnesses that run in the family?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 194.13,
      "end_seconds": 196.56,
      "duration_seconds": 2.43,
      "text": "My father had kidney stones."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 197.47,
      "end_seconds": 200.35,
      "duration_seconds": 2.88,
      "text": "Have you got any chronic problems?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 201.63,
      "end_seconds": 208.41,
      "duration_seconds": 6.78,
      "text": "Heart disease, for nearly five years. High blood pressure, for about a year."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 209.38,
      "end_seconds": 216.94,
      "duration_seconds": 7.56,
      "text": "Alright, heart disease, that matches what I have here. A few measurements, then we'll continue."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 223.28,
      "end_seconds": 224.17,
      "duration_seconds": 0.89,
      "text": "One second..."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 235.4,
      "end_seconds": 241.93,
      "duration_seconds": 6.53,
      "text": "Okay: pulse is 73 beats a minute, blood pressure 171 over 92, saturation 96 percent."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 243.98,
      "end_seconds": 245.52,
      "duration_seconds": 1.54,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 246.95,
      "end_seconds": 249.53,
      "duration_seconds": 2.58,
      "text": "I'll explain what that means shortly."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 251.79,
      "end_seconds": 254.21,
      "duration_seconds": 2.42,
      "text": "Shall we do the examination?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 264.56,
      "end_seconds": 265.26,
      "duration_seconds": 0.7,
      "text": "Okay."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 266.3,
      "end_seconds": 268.58,
      "duration_seconds": 2.28,
      "text": "Hold that position for me."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 277.51,
      "end_seconds": 280.45,
      "duration_seconds": 2.94,
      "text": "Heart sounds are normal, no murmurs."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 281.69,
      "end_seconds": 284.08,
      "duration_seconds": 2.39,
      "text": "Just relax, I'll be quick."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 294.41,
      "end_seconds": 298.54,
      "duration_seconds": 4.13,
      "text": "Lungs are clear and there's no swelling in your ankles."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 301.6,
      "end_seconds": 334.38,
      "duration_seconds": 32.78,
      "text": "That's fine, sit up. So, based on the history and the examination, this is probably angina-type chest pain. I can't rule out a musculoskeletal cause yet. An ECG is what I'd like next, for chest tightness. I'm sending you for an echocardiogram because of chest tightness. I'd rather check than guess, and this is the quickest way to know more. I'll start you on atorvastatin, 40 milligrams, at night, long term. That should help with cardiovascular risk."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 335.4,
      "end_seconds": 336.44,
      "duration_seconds": 1.04,
      "text": "Mm, okay."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 338.37,
      "end_seconds": 370.69,
      "duration_seconds": 32.32,
      "text": "What I'm giving you is GTN spray, 0.4 milligrams, when the chest tightness comes, as needed. That should help with chest tightness. Don't push through the chest tightness, stop, sit down, and use the spray if I've given it to you. I'm going to send a referral to a cardiologist. One warning sign to remember: the chest tightness comes at rest or lasts more than fifteen minutes. In that case don't wait. Book a review in two weeks."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 372.16,
      "end_seconds": 374.83,
      "duration_seconds": 2.67,
      "text": "Ask me anything before you go."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 375.8,
      "end_seconds": 379.27,
      "duration_seconds": 3.47,
      "text": "No, you've explained it well. Thanks."
    }
  ]
}