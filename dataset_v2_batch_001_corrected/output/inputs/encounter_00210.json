{
  "schema_version": "1.0",
  "encounter_id": "00210",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.05,
      "end_seconds": 5.54,
      "duration_seconds": 4.49,
      "text": "Doctor? Hi. I hope I've got the right time."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.61,
      "end_seconds": 11.95,
      "duration_seconds": 5.34,
      "text": "Of course, put it down anywhere. So, how can I help?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 12.62,
      "end_seconds": 19.33,
      "duration_seconds": 6.71,
      "text": "Doctor, I've come along because I know the history, if it helps."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 20.9,
      "end_seconds": 24.59,
      "duration_seconds": 3.69,
      "text": "Good, that'll be useful. Pull up a chair."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 26.52,
      "end_seconds": 30.53,
      "duration_seconds": 4.01,
      "text": "He's been having breathlessness when I lie flat, doctor."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 31.84,
      "end_seconds": 34.77,
      "duration_seconds": 2.93,
      "text": "How far back does it go?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 35.7,
      "end_seconds": 40.35,
      "duration_seconds": 4.65,
      "text": "It's been about a week, I'm fairly sure."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 41.39,
      "end_seconds": 44.61,
      "duration_seconds": 3.22,
      "text": "Would you call it mild or bad?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 45.57,
      "end_seconds": 48.35,
      "duration_seconds": 2.78,
      "text": "About a five out of ten."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 54.23,
      "end_seconds": 56.37,
      "duration_seconds": 2.14,
      "text": "Does anything make it better?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 57.02,
      "end_seconds": 60.3,
      "duration_seconds": 3.28,
      "text": "Sitting up on pillows helps a bit."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 61.89,
      "end_seconds": 66.28,
      "duration_seconds": 4.39,
      "text": "Is it constant, or does it come and go?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 68.22,
      "end_seconds": 70.15,
      "duration_seconds": 1.93,
      "text": "Honestly, every other day."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 72.03,
      "end_seconds": 75.09,
      "duration_seconds": 3.06,
      "text": "Does it come along with anything else?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 76.02,
      "end_seconds": 92.34,
      "duration_seconds": 16.32,
      "text": "Tiredness goes along with it, most of the time. The tiredness? That's been for six months. Oh, and swelling in both ankles. That's been about the same, six months."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 93.44,
      "end_seconds": 98.5,
      "duration_seconds": 5.06,
      "text": "Okay, give me more detail on it, whatever comes to mind."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 99.66,
      "end_seconds": 124.29,
      "duration_seconds": 24.63,
      "text": "Honestly, every other day. Maybe a four out of ten on a bad day. And I've been waking up at night short of breath as well. As for waking up at night short of breath, I'd say a couple of times a week."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 126.04,
      "end_seconds": 128.97,
      "duration_seconds": 2.93,
      "text": "First the numbers, if you don't mind."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 137.44,
      "end_seconds": 138.43,
      "duration_seconds": 0.99,
      "text": "One second..."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 159.79,
      "end_seconds": 167.21,
      "duration_seconds": 7.42,
      "text": "Okay: blood pressure 129 over 77, pulse is 85 beats a minute, saturation 92 percent."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 167.75,
      "end_seconds": 169.11,
      "duration_seconds": 1.36,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 170.09,
      "end_seconds": 173.93,
      "duration_seconds": 3.84,
      "text": "Let's look at it together in a minute."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 176.07,
      "end_seconds": 179.18,
      "duration_seconds": 3.11,
      "text": "Let me examine, it won't take long."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 180.39,
      "end_seconds": 184.51,
      "duration_seconds": 4.12,
      "text": "A little pressure here, tell me if it's tender."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 196.58,
      "end_seconds": 198.5,
      "duration_seconds": 1.92,
      "text": "Neck veins are raised."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 199.44,
      "end_seconds": 200.52,
      "duration_seconds": 1.08,
      "text": "Yes, doctor."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 201.35,
      "end_seconds": 203.85,
      "duration_seconds": 2.5,
      "text": "Okay, tell me if anything hurts."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 211.47,
      "end_seconds": 216.16,
      "duration_seconds": 4.69,
      "text": "I can hear crackles at the bases of both lungs."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 217.21,
      "end_seconds": 219.22,
      "duration_seconds": 2.01,
      "text": "Let me just check something."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 235.03,
      "end_seconds": 239.79,
      "duration_seconds": 4.76,
      "text": "There's pitting oedema up to the shins on both legs."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 244.89,
      "end_seconds": 245.59,
      "duration_seconds": 0.7,
      "text": "Sure."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 249.44,
      "end_seconds": 253.02,
      "duration_seconds": 3.58,
      "text": "Okay, you can sit up. How about fainting?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 257.54,
      "end_seconds": 259.04,
      "duration_seconds": 1.5,
      "text": "No fainting, thankfully."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 260.09,
      "end_seconds": 265.07,
      "duration_seconds": 4.98,
      "text": "Any calf pain, coughing up blood, fever or chest pain at all?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 265.89,
      "end_seconds": 268.76,
      "duration_seconds": 2.87,
      "text": "No, not any of them."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 269.46,
      "end_seconds": 271.87,
      "duration_seconds": 2.41,
      "text": "Is your mobility otherwise okay?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 273.36,
      "end_seconds": 275.02,
      "duration_seconds": 1.66,
      "text": "No, nothing there."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 276.18,
      "end_seconds": 278.93,
      "duration_seconds": 2.75,
      "text": "How are your bowels, any trouble?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 279.59,
      "end_seconds": 281.72,
      "duration_seconds": 2.13,
      "text": "No, all normal there."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 290.96,
      "end_seconds": 295.53,
      "duration_seconds": 4.57,
      "text": "Any medication at the moment, including things from the pharmacy?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 296.72,
      "end_seconds": 304.32,
      "duration_seconds": 7.6,
      "text": "He is on spironolactone, 25 milligrams, once a day for my heart, I give it to him."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 306.32,
      "end_seconds": 308.93,
      "duration_seconds": 2.61,
      "text": "Any allergies I should know about?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 313.54,
      "end_seconds": 325.54,
      "duration_seconds": 12.0,
      "text": "Hmm, there was some antibiotic, I was told I was allergic. But I couldn't tell you what it was called or what it did."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 333.64,
      "end_seconds": 336.03,
      "duration_seconds": 2.39,
      "text": "Any diagnoses you've been given before?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 337.71,
      "end_seconds": 339.91,
      "duration_seconds": 2.2,
      "text": "I've got heart failure."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 343.17,
      "end_seconds": 348.61,
      "duration_seconds": 5.44,
      "text": "Tell me about your routine, work, habits, that sort of thing."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 349.9,
      "end_seconds": 369.58,
      "duration_seconds": 19.68,
      "text": "I've never smoked. I have a couple of drinks on the weekend. I run a small shop, so I'm on my feet a lot. I eat out quite a lot, to be honest. I play badminton on Sundays."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 380.81,
      "end_seconds": 383.33,
      "duration_seconds": 2.52,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 385.16,
      "end_seconds": 386.89,
      "duration_seconds": 1.73,
      "text": "No operations, no."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 387.45,
      "end_seconds": 397.51,
      "duration_seconds": 10.06,
      "text": "Taking everything into account, this is probably fluid overload related to the heart. It could also be a kidney problem, so we'll keep that open."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 398.12,
      "end_seconds": 400.11,
      "duration_seconds": 1.99,
      "text": "Doctor, is this dangerous?"
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 400.96,
      "end_seconds": 419.65,
      "duration_seconds": 18.69,
      "text": "I can't promise yet, but most people with fluid overload related to the heart do well once it's treated properly. Just to be sure I understood. You've had breathlessness when you lie flat for about a week, and no coughing up blood or fainting."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 421.7,
      "end_seconds": 423.17,
      "duration_seconds": 1.47,
      "text": "Yes, that's right."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 424.78,
      "end_seconds": 429.4,
      "duration_seconds": 4.62,
      "text": "Let's book an echocardiogram to look into breathlessness and swelling."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 430.26,
      "end_seconds": 431.63,
      "duration_seconds": 1.37,
      "text": "Will it hurt?"
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 433.53,
      "end_seconds": 457.16,
      "duration_seconds": 23.63,
      "text": "I'm sending you for blood tests because of heart failure review. Let's book a chest X-ray to look into breathlessness. Weigh yourself every morning, and tell us if you put on more than two kilos in a few days. Keep the salt and the fluids moderate, no more than about one and a half litres a day."
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 458.14,
      "end_seconds": 468.63,
      "duration_seconds": 10.49,
      "text": "The thing that would worry me is if the breathlessness gets worse or you can't lie down at all. If that happens, go to emergency."
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 470.13,
      "end_seconds": 472.53,
      "duration_seconds": 2.4,
      "text": "Yes, I'll watch for that."
    },
    {
      "segment_id": "SEG0059",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 473.08,
      "end_seconds": 479.59,
      "duration_seconds": 6.51,
      "text": "I'd like you back in one week. Good. Let us know how you get on."
    },
    {
      "segment_id": "SEG0060",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 480.37,
      "end_seconds": 486.03,
      "duration_seconds": 5.66,
      "text": "I think that's clear. Thank you for being so thorough."
    },
    {
      "segment_id": "SEG0061",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 487.18,
      "end_seconds": 488.53,
      "duration_seconds": 1.35,
      "text": "All the best."
    }
  ]
}