{
  "schema_version": "1.0",
  "encounter_id": "00158",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.2,
      "end_seconds": 11.9,
      "duration_seconds": 10.7,
      "text": "Uh, um, hi doctor, sorry, the lift was out and I had to take the stairs."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 12.8,
      "end_seconds": 16.88,
      "duration_seconds": 4.08,
      "text": "You're fine, sit down. So, what brings you in?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 18.25,
      "end_seconds": 26.31,
      "duration_seconds": 8.06,
      "text": "Mainly sensitivity to light. There's a couple of other things, but that's the main one."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 27.09,
      "end_seconds": 29.77,
      "duration_seconds": 2.68,
      "text": "How long have you had it?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 31.02,
      "end_seconds": 34.06,
      "duration_seconds": 3.04,
      "text": "Yeah, it's been two days now."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 34.78,
      "end_seconds": 38.12,
      "duration_seconds": 3.34,
      "text": "On a normal day, how strong is it?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 40.08,
      "end_seconds": 57.09,
      "duration_seconds": 17.01,
      "text": "I'd give it a six, um, out of ten. So, you know, there's flashing lights before it starts as well. And there's vomiting as well, three days now."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 66.76,
      "end_seconds": 71.36,
      "duration_seconds": 4.6,
      "text": "Any weakness in the arms or legs or slurred speech?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 73.43,
      "end_seconds": 81.75,
      "duration_seconds": 8.32,
      "text": "Uh, uh, no, no weakness in the arms or legs or slurred speech."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 82.84,
      "end_seconds": 85.26,
      "duration_seconds": 2.42,
      "text": "Any double vision or neck stiffness?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 87.07,
      "end_seconds": 92.76,
      "duration_seconds": 5.69,
      "text": "Well, I haven't had double vision or neck stiffness, no."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 98.75,
      "end_seconds": 101.61,
      "duration_seconds": 2.86,
      "text": "Any rashes or skin problems otherwise?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 103.49,
      "end_seconds": 107.1,
      "duration_seconds": 3.61,
      "text": "Well, nothing on the skin, no."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 109.19,
      "end_seconds": 112.66,
      "duration_seconds": 3.47,
      "text": "What medicines are you taking at the moment?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 114.18,
      "end_seconds": 127.18,
      "duration_seconds": 13.0,
      "text": "Sumatriptan. I take it 50 milligrams, when needed for my migraines. Right, you know, it's Disprin, 325 milligrams, maybe, when it starts."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 128.24,
      "end_seconds": 131.44,
      "duration_seconds": 3.2,
      "text": "Is the packet here, or the prescription?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 132.77,
      "end_seconds": 135.95,
      "duration_seconds": 3.18,
      "text": "No, you know, it's at home."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 137.2,
      "end_seconds": 139.67,
      "duration_seconds": 2.47,
      "text": "Are you working at the moment?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 141.77,
      "end_seconds": 146.04,
      "duration_seconds": 4.27,
      "text": "Yes, I'm a nurse on a busy ward."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 146.7,
      "end_seconds": 147.98,
      "duration_seconds": 1.28,
      "text": "How about exercise?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 149.78,
      "end_seconds": 153.91,
      "duration_seconds": 4.13,
      "text": "Not really, I don't get much exercise."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 156.58,
      "end_seconds": 159.08,
      "duration_seconds": 2.5,
      "text": "Have you had any surgery before?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 160.44,
      "end_seconds": 165.23,
      "duration_seconds": 4.79,
      "text": "Yes, I had a C-section, about ten years ago."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 180.35,
      "end_seconds": 186.5,
      "duration_seconds": 6.15,
      "text": "Any diagnoses you've been given before? It helps to be thorough at this stage."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 188.24,
      "end_seconds": 189.8,
      "duration_seconds": 1.56,
      "text": "I've got migraines."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 191.08,
      "end_seconds": 191.78,
      "duration_seconds": 0.7,
      "text": "Yes?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 192.3,
      "end_seconds": 194.25,
      "duration_seconds": 1.95,
      "text": "Any drug or food allergies?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 195.58,
      "end_seconds": 205.2,
      "duration_seconds": 9.62,
      "text": "I had a reaction to ibuprofen when I was younger, a rash, and I've avoided it since."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 206.82,
      "end_seconds": 210.38,
      "duration_seconds": 3.56,
      "text": "Let's get your blood pressure and the other basics."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 218.08,
      "end_seconds": 220.55,
      "duration_seconds": 2.47,
      "text": "Okay, give me a moment..."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 233.67,
      "end_seconds": 245.69,
      "duration_seconds": 12.02,
      "text": "Okay: weight 83 kilos, saturation 99 percent. And BMI works out to 31.6, temp 36.4 degrees, heart rate 69, pressure 127 over 73, height 162 centimetres."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 246.83,
      "end_seconds": 249.98,
      "duration_seconds": 3.15,
      "text": "Let me have a look at you."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 251.83,
      "end_seconds": 254.11,
      "duration_seconds": 2.28,
      "text": "Tell me if anything hurts."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 266.86,
      "end_seconds": 270.1,
      "duration_seconds": 3.24,
      "text": "Cranial nerves look normal, eye movements are full."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 271.56,
      "end_seconds": 273.98,
      "duration_seconds": 2.42,
      "text": "Hold that position for me."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 287.7,
      "end_seconds": 290.58,
      "duration_seconds": 2.88,
      "text": "Neck is supple, no stiffness at all."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 291.5,
      "end_seconds": 292.2,
      "duration_seconds": 0.7,
      "text": "Alright."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 297.63,
      "end_seconds": 298.6,
      "duration_seconds": 0.97,
      "text": "Okay, finished."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 306.01,
      "end_seconds": 336.99,
      "duration_seconds": 30.98,
      "text": "Taking everything into account, it fits best with a migraine pattern. Let's get an MRI of the brain, for recurrent headaches. I'd like you to take propranolol, 20 milligrams, twice a day, for three months. You take it by mouth. That's for migraine prevention. What I'm giving you is domperidone, 10 milligrams, when nauseous, as needed. You take it by mouth. That should help with migraine nausea."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 337.8,
      "end_seconds": 341.85,
      "duration_seconds": 4.05,
      "text": "Can I get that from the usual pharmacy?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 343.73,
      "end_seconds": 362.62,
      "duration_seconds": 18.89,
      "text": "Keep a headache diary, things like skipped meals, poor sleep, certain foods and the weather. Try not to skip meals and keep your sleep regular. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 364.0,
      "end_seconds": 365.89,
      "duration_seconds": 1.89,
      "text": "Okay, fair enough."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 366.89,
      "end_seconds": 379.94,
      "duration_seconds": 13.05,
      "text": "Do get help quickly if you have the worst headache of your life or any weakness. Come back in a month. What are the next steps as you understand them?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 380.64,
      "end_seconds": 392.45,
      "duration_seconds": 11.81,
      "text": "So, I take the propranolol, 20 milligrams, twice a day and take the domperidone, 10 milligrams, when nauseous. Is that right?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 394.36,
      "end_seconds": 398.06,
      "duration_seconds": 3.7,
      "text": "Yes, exactly right. Alright, I'll see you out."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 399.95,
      "end_seconds": 405.9,
      "duration_seconds": 5.95,
      "text": "I think that's clear. Thank you for being so thorough."
    }
  ]
}