{
  "schema_version": "1.0",
  "encounter_id": "00030",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.83,
      "end_seconds": 4.12,
      "duration_seconds": 3.29,
      "text": "Good afternoon. Have a seat and we'll begin."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 5.82,
      "end_seconds": 10.5,
      "duration_seconds": 4.68,
      "text": "Hmm, hello. Is it okay if I sit here?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 12.57,
      "end_seconds": 15.37,
      "duration_seconds": 2.8,
      "text": "Go ahead, tell me what's happening."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 16.42,
      "end_seconds": 29.28,
      "duration_seconds": 12.86,
      "text": "It's, It's a painful band of blisters on the left side of my chest, mostly. I thought it would sort itself out, but it hasn't."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 31.14,
      "end_seconds": 33.49,
      "duration_seconds": 2.35,
      "text": "When did you first notice it?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 34.75,
      "end_seconds": 38.27,
      "duration_seconds": 3.52,
      "text": "Since last night, that's when it began."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 44.57,
      "end_seconds": 48.72,
      "duration_seconds": 4.15,
      "text": "Does it happen all the time or in spells?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 50.78,
      "end_seconds": 53.23,
      "duration_seconds": 2.45,
      "text": "I'd say every other day."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 54.76,
      "end_seconds": 56.23,
      "duration_seconds": 1.47,
      "text": "Anything that helps?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 57.63,
      "end_seconds": 62.13,
      "duration_seconds": 4.5,
      "text": "It, It settles a little with cool cloths."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 65.35,
      "end_seconds": 67.7,
      "duration_seconds": 2.35,
      "text": "How much is it bothering you?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 68.99,
      "end_seconds": 73.78,
      "duration_seconds": 4.79,
      "text": "Maybe a five out of ten on a bad day."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 74.34,
      "end_seconds": 78.06,
      "duration_seconds": 3.72,
      "text": "Have you had burning pain before the rash came?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 80.04,
      "end_seconds": 86.96,
      "duration_seconds": 6.92,
      "text": "Yes, about the same, about four days. There's a mild fever as well."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 102.44,
      "end_seconds": 109.83,
      "duration_seconds": 7.39,
      "text": "Did you get rash on the other side, immune problems, blurred vision or rash on the face?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 110.69,
      "end_seconds": 112.73,
      "duration_seconds": 2.04,
      "text": "Nothing like that, no."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 113.5,
      "end_seconds": 115.64,
      "duration_seconds": 2.14,
      "text": "Is your mobility otherwise okay?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 117.1,
      "end_seconds": 119.07,
      "duration_seconds": 1.97,
      "text": "No, joints are fine."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 129.25,
      "end_seconds": 131.46,
      "duration_seconds": 2.21,
      "text": "Are you active at all?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 132.93,
      "end_seconds": 135.86,
      "duration_seconds": 2.93,
      "text": "Barely, I'm mostly sedentary these days."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 137.01,
      "end_seconds": 139.04,
      "duration_seconds": 2.03,
      "text": "Who's at home with you?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 140.26,
      "end_seconds": 144.54,
      "duration_seconds": 4.28,
      "text": "It's just me and my wife at home now."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 146.27,
      "end_seconds": 150.92,
      "duration_seconds": 4.65,
      "text": "Tell me about your health in general, any ongoing conditions?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 152.44,
      "end_seconds": 159.92,
      "duration_seconds": 7.48,
      "text": "I've, I've had diabetes for about a year now. High blood pressure, for about a year."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 161.51,
      "end_seconds": 162.21,
      "duration_seconds": 0.7,
      "text": "Mm."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 163.97,
      "end_seconds": 165.14,
      "duration_seconds": 1.17,
      "text": "Yes, anxiety."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 166.05,
      "end_seconds": 174.47,
      "duration_seconds": 8.42,
      "text": "I follow. Yes, diabetes and anxiety are known to us, good to have that clear. What medicines do you take regularly?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 176.09,
      "end_seconds": 192.38,
      "duration_seconds": 16.29,
      "text": "I'm on Glycomet, 500 milligrams, twice a day. I'm not great at remembering details, so bear with me. I, I take ramipril, 5 milligrams, every morning. It's escitalopram, 10 milligrams, once a day."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 197.29,
      "end_seconds": 200.82,
      "duration_seconds": 3.53,
      "text": "Alright, have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 201.5,
      "end_seconds": 204.45,
      "duration_seconds": 2.95,
      "text": "I mean, no, nothing like that."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 205.7,
      "end_seconds": 215.88,
      "duration_seconds": 10.18,
      "text": "Here are the numbers, doctor. Oxygen saturation is 97 percent, temperature 36.9, BP is 124 over 68. Heart rate 84, respiratory rate 14."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 217.17,
      "end_seconds": 218.55,
      "duration_seconds": 1.38,
      "text": "Good, thank you."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 220.69,
      "end_seconds": 224.0,
      "duration_seconds": 3.31,
      "text": "If you're comfortable, I'll examine you now."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 225.55,
      "end_seconds": 228.52,
      "duration_seconds": 2.97,
      "text": "Alright, almost done with this part."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 236.31,
      "end_seconds": 243.63,
      "duration_seconds": 7.32,
      "text": "Grouped blisters on a red base along one rib on the left, not crossing the midline."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 248.02,
      "end_seconds": 250.53,
      "duration_seconds": 2.51,
      "text": "Okay, you can sit up."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 262.77,
      "end_seconds": 267.21,
      "duration_seconds": 4.44,
      "text": "Okay, thinking it through, the most likely explanation is shingles."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 268.61,
      "end_seconds": 271.04,
      "duration_seconds": 2.43,
      "text": "Do you think it's serious?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 272.64,
      "end_seconds": 297.37,
      "duration_seconds": 24.73,
      "text": "I understand the worry. At the moment I'd say it's shingles, and we'll watch how it goes. For this, paracetamol, 1 gram, every six hours if needed, for five days. It's for pain. For this, aciclovir, 800 milligrams, five times a day, for seven days. That should help with shingles."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 299.23,
      "end_seconds": 303.63,
      "duration_seconds": 4.4,
      "text": "Hmm, is that safe with my other things?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 305.16,
      "end_seconds": 323.17,
      "duration_seconds": 18.01,
      "text": "Keep the blisters clean and covered, and avoid contact with anyone pregnant or newborn until they crust. If the rash spreads to your face or eye, that's the point to come in urgently. Okay, I think we're finished. Is everything clear?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 325.15,
      "end_seconds": 329.12,
      "duration_seconds": 3.97,
      "text": "No, I think that's everything. Thank you, doctor."
    }
  ]
}