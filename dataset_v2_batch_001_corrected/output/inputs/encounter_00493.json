{
  "schema_version": "1.0",
  "encounter_id": "00493",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.51,
      "end_seconds": 5.69,
      "duration_seconds": 5.18,
      "text": "oh, good evening, doctor, thank you for staying late"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.23,
      "end_seconds": 10.48,
      "duration_seconds": 4.25,
      "text": "Right on time. Sit, please. How can I help?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 11.94,
      "end_seconds": 15.16,
      "duration_seconds": 3.22,
      "text": "I've been dealing with a pounding headache."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 17.04,
      "end_seconds": 19.49,
      "duration_seconds": 2.45,
      "text": "how long have you had it?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 20.29,
      "end_seconds": 23.02,
      "duration_seconds": 2.73,
      "text": "I've had it for three days"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 24.31,
      "end_seconds": 32.76,
      "duration_seconds": 8.45,
      "text": "Can you describe it a bit more for me? How strong it is, what the pattern is, what helps."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 33.32,
      "end_seconds": 48.42,
      "duration_seconds": 15.1,
      "text": "It happens a couple of times a week. About a five out of ten. I'm hoping you can tell me something definite. I've never really been one for hospitals."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 66.69,
      "end_seconds": 70.43,
      "duration_seconds": 3.74,
      "text": "Let's get your blood pressure and the other basics."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 82.41,
      "end_seconds": 84.32,
      "duration_seconds": 1.91,
      "text": "Hold still for me..."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 97.07,
      "end_seconds": 103.91,
      "duration_seconds": 6.84,
      "text": "Okay: pulse is 64 beats a minute, blood pressure 117 over 81, temp 36.8 degrees."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 105.91,
      "end_seconds": 107.99,
      "duration_seconds": 2.08,
      "text": "Shall we do the examination?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 109.87,
      "end_seconds": 112.25,
      "duration_seconds": 2.38,
      "text": "almost done with this part"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 122.44,
      "end_seconds": 125.77,
      "duration_seconds": 3.33,
      "text": "Neck is supple, no stiffness at all."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 142.16,
      "end_seconds": 142.86,
      "duration_seconds": 0.7,
      "text": "Alright."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 144.58,
      "end_seconds": 146.98,
      "duration_seconds": 2.4,
      "text": "Almost done with this part."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 157.85,
      "end_seconds": 161.31,
      "duration_seconds": 3.46,
      "text": "Cranial nerves look normal, eye movements are full."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 165.81,
      "end_seconds": 168.77,
      "duration_seconds": 2.96,
      "text": "Thanks for that. What about slurred speech?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 170.66,
      "end_seconds": 172.89,
      "duration_seconds": 2.23,
      "text": "no slurred speech, thankfully"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 173.55,
      "end_seconds": 181.06,
      "duration_seconds": 7.51,
      "text": "and what about weakness in the arms or legs, double vision or loss of consciousness?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 182.14,
      "end_seconds": 185.09,
      "duration_seconds": 2.95,
      "text": "None, as far as I know."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 186.05,
      "end_seconds": 188.04,
      "duration_seconds": 1.99,
      "text": "Is your mobility otherwise okay?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 190.0,
      "end_seconds": 191.65,
      "duration_seconds": 1.65,
      "text": "No, nothing there."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 192.55,
      "end_seconds": 193.92,
      "duration_seconds": 1.37,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 195.27,
      "end_seconds": 196.94,
      "duration_seconds": 1.67,
      "text": "No operations, no."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 198.35,
      "end_seconds": 200.7,
      "duration_seconds": 2.35,
      "text": "Are you on any regular medication?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 202.07,
      "end_seconds": 205.11,
      "duration_seconds": 3.04,
      "text": "no, I don't take anything regularly"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 206.43,
      "end_seconds": 207.9,
      "duration_seconds": 1.47,
      "text": "And your work?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 209.83,
      "end_seconds": 213.7,
      "duration_seconds": 3.87,
      "text": "I drive a delivery van all day"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 214.89,
      "end_seconds": 216.72,
      "duration_seconds": 1.83,
      "text": "Any sport or activity?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 217.36,
      "end_seconds": 220.08,
      "duration_seconds": 2.72,
      "text": "I play badminton on Sundays."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 237.48,
      "end_seconds": 241.89,
      "duration_seconds": 4.41,
      "text": "Do you have any medical conditions I should know about?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 246.59,
      "end_seconds": 249.95,
      "duration_seconds": 3.36,
      "text": "No, none that I know of."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 252.03,
      "end_seconds": 260.45,
      "duration_seconds": 8.42,
      "text": "From what you've told me and and what I found, this looks most like migraine with aura."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 266.74,
      "end_seconds": 269.64,
      "duration_seconds": 2.9,
      "text": "Is it something serious, doctor?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 270.15,
      "end_seconds": 303.51,
      "duration_seconds": 33.36,
      "text": "I understand the worry. At the moment I'd say it's migraine with aura, and we'll know more once the an MRI of the brain is back. I think an MRI of the brain makes sense here, for recurrent headaches. It's a routine test and it'll give us a much clearer picture. We'll begin with propranolol, 20 milligrams, twice a day, for three months. That's for migraine prevention."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 305.55,
      "end_seconds": 310.28,
      "duration_seconds": 4.73,
      "text": "Should I keep taking it if I feel better?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 311.2,
      "end_seconds": 321.81,
      "duration_seconds": 10.61,
      "text": "Keep a headache diary, things like skipped meals, poor sleep, certain foods and the weather. We'll catch up in a month. Alright, I'll see you out."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 323.35,
      "end_seconds": 324.78,
      "duration_seconds": 1.43,
      "text": "Right. Thanks again."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 326.09,
      "end_seconds": 326.79,
      "duration_seconds": 0.7,
      "text": "goodbye"
    }
  ]
}