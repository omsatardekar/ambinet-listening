{
  "schema_version": "1.0",
  "encounter_id": "00446",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.27,
      "end_seconds": 3.42,
      "duration_seconds": 2.15,
      "text": "Hi there, come on in."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 4.97,
      "end_seconds": 6.54,
      "duration_seconds": 1.57,
      "text": "Good morning, doctor."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 12.79,
      "end_seconds": 14.46,
      "duration_seconds": 1.67,
      "text": "What's been bothering you?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 16.03,
      "end_seconds": 19.46,
      "duration_seconds": 3.43,
      "text": "Well, I've been having fever with chills."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 21.42,
      "end_seconds": 24.02,
      "duration_seconds": 2.6,
      "text": "Since when have you had this?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 25.22,
      "end_seconds": 28.97,
      "duration_seconds": 3.75,
      "text": "It's been like this since last weekend."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 29.81,
      "end_seconds": 32.65,
      "duration_seconds": 2.84,
      "text": "Have you found anything that eases it?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 34.6,
      "end_seconds": 38.36,
      "duration_seconds": 3.76,
      "text": "Well, I get some relief from paracetamol."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 44.57,
      "end_seconds": 47.43,
      "duration_seconds": 2.86,
      "text": "How much is it bothering you?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 49.5,
      "end_seconds": 54.52,
      "duration_seconds": 5.02,
      "text": "Maybe a four out of ten on a bad day."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 55.74,
      "end_seconds": 57.99,
      "duration_seconds": 2.25,
      "text": "Has there been nausea too?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 61.84,
      "end_seconds": 66.97,
      "duration_seconds": 5.13,
      "text": "Mm, yes. With nausea, it happens on and off."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 67.97,
      "end_seconds": 70.4,
      "duration_seconds": 2.43,
      "text": "Have you been feeling very weak?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 71.66,
      "end_seconds": 73.41,
      "duration_seconds": 1.75,
      "text": "Yeah, that too."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 74.4,
      "end_seconds": 77.83,
      "duration_seconds": 3.43,
      "text": "Any terrible shaking and sweating as well?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 79.19,
      "end_seconds": 85.4,
      "duration_seconds": 6.21,
      "text": "Yes, actually. About terrible shaking and sweating, it's all the time."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 86.64,
      "end_seconds": 92.92,
      "duration_seconds": 6.28,
      "text": "Have you had fever with chills before, or is this the first time?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 94.49,
      "end_seconds": 100.03,
      "duration_seconds": 5.54,
      "text": "A bit, about six months ago. It settled by itself back then."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 101.28,
      "end_seconds": 102.98,
      "duration_seconds": 1.7,
      "text": "Let's do your observations."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 113.8,
      "end_seconds": 114.66,
      "duration_seconds": 0.86,
      "text": "One second..."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 126.77,
      "end_seconds": 133.29,
      "duration_seconds": 6.52,
      "text": "Okay: blood pressure 122 over 74, respiratory rate 22, temperature 38.7, heart rate 104."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 134.96,
      "end_seconds": 137.1,
      "duration_seconds": 2.14,
      "text": "Can I examine you now?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 138.28,
      "end_seconds": 140.58,
      "duration_seconds": 2.3,
      "text": "Bear with me a second."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 151.46,
      "end_seconds": 155.72,
      "duration_seconds": 4.26,
      "text": "No rash anywhere on your body that I can see."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 161.09,
      "end_seconds": 161.79,
      "duration_seconds": 0.7,
      "text": "Sure."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 163.34,
      "end_seconds": 164.82,
      "duration_seconds": 1.48,
      "text": "I'll go gently."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 180.19,
      "end_seconds": 184.31,
      "duration_seconds": 4.12,
      "text": "Your spleen tip is just palpable under the ribs."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 186.93,
      "end_seconds": 192.22,
      "duration_seconds": 5.29,
      "text": "That's fine, sit up. Have you had any breathlessness or stiff neck?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 193.16,
      "end_seconds": 195.15,
      "duration_seconds": 1.99,
      "text": "No, none of those."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 195.85,
      "end_seconds": 200.1,
      "duration_seconds": 4.25,
      "text": "Let me check a few things. Any cough or diarrhoea?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 201.84,
      "end_seconds": 205.91,
      "duration_seconds": 4.07,
      "text": "Oh, no cough or diarrhoea, none of it."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 206.46,
      "end_seconds": 209.34,
      "duration_seconds": 2.88,
      "text": "Any breathing difficulties apart from this?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 211.22,
      "end_seconds": 213.42,
      "duration_seconds": 2.2,
      "text": "No problems with breathing."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 214.91,
      "end_seconds": 217.75,
      "duration_seconds": 2.84,
      "text": "Anything different when you pass water?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 218.47,
      "end_seconds": 221.6,
      "duration_seconds": 3.13,
      "text": "That's normal as far as I know."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 233.4,
      "end_seconds": 238.49,
      "duration_seconds": 5.09,
      "text": "Do you have any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 239.65,
      "end_seconds": 248.0,
      "duration_seconds": 8.35,
      "text": "I've had high blood pressure for about a year now. I've, I've had thin bones, yes."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 248.63,
      "end_seconds": 250.28,
      "duration_seconds": 1.65,
      "text": "And apart from that?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 251.11,
      "end_seconds": 253.74,
      "duration_seconds": 2.63,
      "text": "Gout, for about a year."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 257.69,
      "end_seconds": 269.31,
      "duration_seconds": 11.62,
      "text": "Right, so high blood pressure and gout are already on your record. We'll keep that in mind today. Let's go through your medication. What are you taking?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 269.83,
      "end_seconds": 288.48,
      "duration_seconds": 18.65,
      "text": "I'm on amlodipine, 5 milligrams, once a day for my pressure. Well, I'm supposed to take it regularly, but I don't always manage. I take alendronate, 70 milligrams, once a week. It's allopurinol, once a day for the gout."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 290.05,
      "end_seconds": 292.08,
      "duration_seconds": 2.03,
      "text": "Do you know the dose?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 292.98,
      "end_seconds": 302.28,
      "duration_seconds": 9.3,
      "text": "100 milligrams, I think that's what's on the box. I take paracetamol, 500 milligrams, when needed."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 318.79,
      "end_seconds": 321.2,
      "duration_seconds": 2.41,
      "text": "Does anything run in the family?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 322.7,
      "end_seconds": 324.94,
      "duration_seconds": 2.24,
      "text": "My father had a stroke."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 326.06,
      "end_seconds": 329.18,
      "duration_seconds": 3.12,
      "text": "Do you have any known allergies at all?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 330.75,
      "end_seconds": 336.97,
      "duration_seconds": 6.22,
      "text": "Yes, sulfa drugs. I get a rash. Yes, I'm allergic to codeine."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 337.71,
      "end_seconds": 339.63,
      "duration_seconds": 1.92,
      "text": "Are you still working?"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 341.39,
      "end_seconds": 345.84,
      "duration_seconds": 4.45,
      "text": "I'm retired now, I was a clerk for years."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 347.46,
      "end_seconds": 349.79,
      "duration_seconds": 2.33,
      "text": "Are you living with family?"
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 350.74,
      "end_seconds": 354.65,
      "duration_seconds": 3.91,
      "text": "I stay with my daughter and her family."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 355.58,
      "end_seconds": 375.98,
      "duration_seconds": 20.4,
      "text": "So where does that leave us? The most likely explanation is malaria until proven otherwise. Another possibility is dengue fever. Stop me if I've got anything wrong. You've had fever with chills, since last weekend, and no stiff neck or diarrhoea."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 377.65,
      "end_seconds": 379.41,
      "duration_seconds": 1.76,
      "text": "That's it, yes."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 387.17,
      "end_seconds": 404.45,
      "duration_seconds": 17.28,
      "text": "We should do a malaria test for fever after travel. We should do a dengue test for fever. Let the lab know you travelled recently, that's important for the tests. Let's review you in two days."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 405.31,
      "end_seconds": 407.49,
      "duration_seconds": 2.18,
      "text": "Okay, I'll book that."
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 408.35,
      "end_seconds": 411.67,
      "duration_seconds": 3.32,
      "text": "Call the clinic if you need us."
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 412.75,
      "end_seconds": 415.93,
      "duration_seconds": 3.18,
      "text": "Uh, no questions. Thank you."
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 417.47,
      "end_seconds": 418.17,
      "duration_seconds": 0.7,
      "text": "Goodbye."
    }
  ]
}