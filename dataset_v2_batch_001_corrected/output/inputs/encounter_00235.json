      "start_seconds": 293.36,
      "end_seconds": 302.11,
      "duration_seconds": 8.75,
      "text": "Okay: oxygen saturation is 98 percent, pressure 118 over 79, temp 36.4 degrees, heart rate 81, respiratory rate 18."
    },
