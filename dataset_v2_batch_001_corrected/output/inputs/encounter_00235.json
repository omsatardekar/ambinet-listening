      "role": "DOCTOR",
      "start_seconds": 211.88,
      "end_seconds": 214.23,
      "duration_seconds": 2.35,
      "text": "now some background about your lifestyle"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 217.35,
      "end_seconds": 246.11,
      "duration_seconds": 28.76,
      "text": "I used to smoke but I quit five years ago. I have a couple of drinks on the weekend. I go to the gym a couple of times a week. I try to avoid too much sugar. I run a small shop, so I'm on my feet a lot."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 264.8,
      "end_seconds": 267.29,
      "duration_seconds": 2.49,
