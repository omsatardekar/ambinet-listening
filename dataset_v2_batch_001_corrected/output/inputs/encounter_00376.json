      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 295.79,
      "end_seconds": 306.54,
      "duration_seconds": 10.75,
      "text": "one warning sign to remember: the symptoms get worse. In that case don't wait. Let's review you after the scan. Any last questions?"
