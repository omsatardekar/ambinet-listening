{
  "schema_version": "1.0",
  "encounter_id": "00020",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 0.87,
      "end_seconds": 6.85,
      "duration_seconds": 5.98,
      "text": "Okay, doctor, we're all set in here. I'll give you the numbers when you want them."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.78,
      "end_seconds": 12.5,
      "duration_seconds": 3.72,
      "text": "Right, thank you. Right, hello, what's the problem?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 13.08,
      "end_seconds": 24.45,
      "duration_seconds": 11.37,
      "text": "Mainly pain in the lower right tummy. There's a couple of other things, you know, but that's the main one."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 25.08,
      "end_seconds": 34.96,
      "duration_seconds": 9.88,
      "text": "Doctor, I've got the readings for you. BP is 108 over 77, pulse is 88 beats a minute, saturation 96 percent."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 35.47,
      "end_seconds": 39.44,
      "duration_seconds": 3.97,
      "text": "Good, thank you. How far back does it go?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 40.09,
      "end_seconds": 43.05,
      "duration_seconds": 2.96,
      "text": "I've had it for one week."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 44.77,
      "end_seconds": 49.5,
      "duration_seconds": 4.73,
      "text": "Okay, give me more detail on it, whatever comes to mind."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 51.02,
      "end_seconds": 64.57,
      "duration_seconds": 13.55,
      "text": "Uh, you know, honestly, a couple of times a week. I notice it more with coughing and moving. Severe, I'd say. And no appetite, too."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 65.1,
      "end_seconds": 68.72,
      "duration_seconds": 3.62,
      "text": "And what about hernia bulge, jaundice or constipation?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 75.19,
      "end_seconds": 76.98,
      "duration_seconds": 1.79,
      "text": "No, nothing there."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 80.6,
      "end_seconds": 84.55,
      "duration_seconds": 3.95,
      "text": "And what about burning when passing urine or diarrhoea?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 85.36,
      "end_seconds": 89.49,
      "duration_seconds": 4.13,
      "text": "Um, none, as far as I know."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 90.45,
      "end_seconds": 93.54,
      "duration_seconds": 3.09,
      "text": "Any problems with your joints or muscles?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 94.11,
      "end_seconds": 95.72,
      "duration_seconds": 1.61,
      "text": "Nothing else aches."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 97.24,
      "end_seconds": 99.62,
      "duration_seconds": 2.38,
      "text": "Any operations in the past?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 100.42,
      "end_seconds": 104.61,
      "duration_seconds": 4.19,
      "text": "Just a hernia repair, about five years back."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 106.52,
      "end_seconds": 108.37,
      "duration_seconds": 1.85,
      "text": "Right, what's your job?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 109.17,
      "end_seconds": 112.15,
      "duration_seconds": 2.98,
      "text": "I teach at a primary school."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 112.67,
      "end_seconds": 114.93,
      "duration_seconds": 2.26,
      "text": "Do you exercise at all?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 116.76,
      "end_seconds": 122.36,
      "duration_seconds": 5.6,
      "text": "I go to the gym a couple of times a week."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 123.57,
      "end_seconds": 126.16,
      "duration_seconds": 2.59,
      "text": "Is anyone at home with you?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 128.13,
      "end_seconds": 131.29,
      "duration_seconds": 3.16,
      "text": "I share a flat with two friends."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 133.0,
      "end_seconds": 138.36,
      "duration_seconds": 5.36,
      "text": "What about your general health, any conditions you're being treated for?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 140.23,
      "end_seconds": 143.54,
      "duration_seconds": 3.31,
      "text": "I've had migraines for two years now."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 145.12,
      "end_seconds": 146.02,
      "duration_seconds": 0.9,
      "text": "Right, right."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 146.95,
      "end_seconds": 156.8,
      "duration_seconds": 9.85,
      "text": "I have high blood pressure, for nearly five years. A neighbour of mine said I should see someone about it."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 158.49,
      "end_seconds": 164.82,
      "duration_seconds": 6.33,
      "text": "Okay, I can see migraines and high blood pressure in your file as well."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 175.39,
      "end_seconds": 180.2,
      "duration_seconds": 4.81,
      "text": "Have you ever reacted badly to a medicine or food? Any allergies?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 181.84,
      "end_seconds": 182.9,
      "duration_seconds": 1.06,
      "text": "No allergies."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 191.21,
      "end_seconds": 194.71,
      "duration_seconds": 3.5,
      "text": "Which tablets or creams or inhalers do you use?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 196.77,
      "end_seconds": 201.04,
      "duration_seconds": 4.27,
      "text": "It's, It's losartan, 50 milligrams, once a day."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 202.94,
      "end_seconds": 204.78,
      "duration_seconds": 1.84,
      "text": "And for how long?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 206.88,
      "end_seconds": 209.01,
      "duration_seconds": 2.13,
      "text": "About about three months."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 211.08,
      "end_seconds": 214.43,
      "duration_seconds": 3.35,
      "text": "Right, let me check a few things physically."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 215.53,
      "end_seconds": 216.57,
      "duration_seconds": 1.04,
      "text": "Go ahead."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 218.05,
      "end_seconds": 220.04,
      "duration_seconds": 1.99,
      "text": "Bear with me a second."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 234.14,
      "end_seconds": 240.33,
      "duration_seconds": 6.19,
      "text": "There's tenderness in the right lower part and it hurts when I let go suddenly."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 244.74,
      "end_seconds": 246.42,
      "duration_seconds": 1.68,
      "text": "That's fine, sit up."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 257.41,
      "end_seconds": 284.9,
      "duration_seconds": 27.49,
      "text": "Okay, so my impression is this: I think we're dealing with possible appendicitis at this stage. I'm sending you for an ultrasound of the abdomen because of right lower abdominal pain. I want blood tests done, that's for abdominal pain. Please don't eat or drink anything until the surgeons have seen you. Avoid taking any extra painkillers on top of what I'm prescribing without checking with us."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 285.27,
      "end_seconds": 289.46,
      "duration_seconds": 4.19,
      "text": "Uh-huh. I'll also refer you to the surgical team."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 291.49,
      "end_seconds": 294.12,
      "duration_seconds": 2.63,
      "text": "Sure, where do I go?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 295.33,
      "end_seconds": 315.98,
      "duration_seconds": 20.65,
      "text": "I'm not ordering a urine test today. If things carry on in two weeks, we'll consider it. If the pain gets sharper or spreads across the tummy, or you feel really unwell, please come to the emergency department. We'll catch up today after the results. Ask me anything before you go."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 316.65,
      "end_seconds": 321.17,
      "duration_seconds": 4.52,
      "text": "No, I think that's everything. Thank you, doctor."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 322.1,
      "end_seconds": 323.48,
      "duration_seconds": 1.38,
      "text": "Bye for now."
    }
  ]
}