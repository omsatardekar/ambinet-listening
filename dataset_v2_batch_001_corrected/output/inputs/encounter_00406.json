{
  "schema_version": "1.0",
  "encounter_id": "00406",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.61,
      "end_seconds": 1.76,
      "duration_seconds": 1.15,
      "text": "Afternoon, doctor."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 2.61,
      "end_seconds": 8.55,
      "duration_seconds": 5.94,
      "text": "Yes, come in, take a seat. What can I do for you today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 9.32,
      "end_seconds": 16.84,
      "duration_seconds": 7.52,
      "text": "Yeah, you know, it's a very painful, swollen big toe. I don't know what's causing it."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 18.62,
      "end_seconds": 20.9,
      "duration_seconds": 2.28,
      "text": "And when did that start?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 21.72,
      "end_seconds": 25.97,
      "duration_seconds": 4.25,
      "text": "It's been going on for about four days."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 26.54,
      "end_seconds": 37.44,
      "duration_seconds": 10.9,
      "text": "Alright, tell me a bit more about it: how bad it gets, how often, and whether anything makes it better or worse."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 39.16,
      "end_seconds": 58.11,
      "duration_seconds": 18.95,
      "text": "I mean, it's worse with the bedsheet touching it. Ice helps a bit. It just comes and goes. I'd rather know what's going on than keep guessing. I'm not great at remembering details, so bear with me."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 70.49,
      "end_seconds": 73.42,
      "duration_seconds": 2.93,
      "text": "Right, I'll take a few measurements first."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 82.39,
      "end_seconds": 84.31,
      "duration_seconds": 1.92,
      "text": "Hold still for me..."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 98.89,
      "end_seconds": 108.67,
      "duration_seconds": 9.78,
      "text": "Okay: respiratory rate 14, pressure 125 over 76, pulse is 76 beats a minute, SpO2 97 percent on room air."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 111.58,
      "end_seconds": 114.5,
      "duration_seconds": 2.92,
      "text": "Let me have a look at you."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 116.18,
      "end_seconds": 118.46,
      "duration_seconds": 2.28,
      "text": "Mm, you know, okay."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 119.68,
      "end_seconds": 121.84,
      "duration_seconds": 2.16,
      "text": "Hold that position for me."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 138.69,
      "end_seconds": 144.21,
      "duration_seconds": 5.52,
      "text": "The big toe joint is red, hot, swollen and extremely tender to touch."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 149.34,
      "end_seconds": 155.74,
      "duration_seconds": 6.4,
      "text": "That's fine, sit up. Did you get kidney problems, rash or trauma to the toe?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 160.52,
      "end_seconds": 166.84,
      "duration_seconds": 6.32,
      "text": "Right, I haven't had kidney problems, rash or trauma to the toe, no."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 168.24,
      "end_seconds": 171.05,
      "duration_seconds": 2.81,
      "text": "Has your heart given you any trouble?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 172.05,
      "end_seconds": 177.97,
      "duration_seconds": 5.92,
      "text": "Uh, my heart's been fine, as far as I know."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 193.6,
      "end_seconds": 196.27,
      "duration_seconds": 2.67,
      "text": "Does anything run in the family?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 198.22,
      "end_seconds": 202.46,
      "duration_seconds": 4.24,
      "text": "Well, you know, my father had a stroke."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 203.91,
      "end_seconds": 209.08,
      "duration_seconds": 5.17,
      "text": "Do you have any allergies to medicines, food, anything at all?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 210.26,
      "end_seconds": 212.89,
      "duration_seconds": 2.63,
      "text": "No, nothing I'm aware of."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 214.08,
      "end_seconds": 217.83,
      "duration_seconds": 3.75,
      "text": "Any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 221.56,
      "end_seconds": 226.23,
      "duration_seconds": 4.67,
      "text": "No, you know, I've never had anything serious."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 244.12,
      "end_seconds": 245.52,
      "duration_seconds": 1.4,
      "text": "Any regular medication?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 246.28,
      "end_seconds": 250.8,
      "duration_seconds": 4.52,
      "text": "So, you know, no, I don't take anything regularly."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 252.18,
      "end_seconds": 254.21,
      "duration_seconds": 2.03,
      "text": "So, any previous surgeries?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 254.89,
      "end_seconds": 257.72,
      "duration_seconds": 2.83,
      "text": "Oh, no, nothing like that."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 258.79,
      "end_seconds": 262.82,
      "duration_seconds": 4.03,
      "text": "Let's talk a little about your daily life and habits."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 263.35,
      "end_seconds": 278.06,
      "duration_seconds": 14.71,
      "text": "I stopped smoking about two years back. I run a small shop, so I'm on my feet a lot. It's just me and my wife at home now."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 278.88,
      "end_seconds": 292.46,
      "duration_seconds": 13.58,
      "text": "Okay, so my impression is this: I think we're dealing with an acute gout flare at this stage. That's my thinking for now, and it may change as we learn more."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 294.49,
      "end_seconds": 296.78,
      "duration_seconds": 2.29,
      "text": "Doctor, is this dangerous?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 301.51,
      "end_seconds": 308.73,
      "duration_seconds": 7.22,
      "text": "I can't promise yet, but most people with an acute gout flare do well once it's treated properly."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 322.42,
      "end_seconds": 330.55,
      "duration_seconds": 8.13,
      "text": "Let's book kidney function tests to look into gout. Let's book a uric acid level to look into suspected gout."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 331.91,
      "end_seconds": 333.46,
      "duration_seconds": 1.55,
      "text": "Okay, that's fine."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 335.15,
      "end_seconds": 363.38,
      "duration_seconds": 28.23,
      "text": "We'll begin with naproxen, 500 milligrams, twice a day after food, for five days. It's for gout flare. Cut right back on red meat, organ meats, beer and sugary drinks, and drink plenty of water. One warning sign to remember: the joint gets hotter or you develop a fever. In that case don't wait. See me again in two weeks. Call the clinic if you need us."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 365.26,
      "end_seconds": 368.21,
      "duration_seconds": 2.95,
      "text": "Thanks, you know, that was helpful."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 368.84,
      "end_seconds": 370.01,
      "duration_seconds": 1.17,
      "text": "Safe journey home."
    }
  ]
}