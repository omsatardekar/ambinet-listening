{
  "schema_version": "1.0",
  "encounter_id": "00218",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.07,
      "end_seconds": 5.14,
      "duration_seconds": 4.07,
      "text": "Hello there. Please, sit. What seems to be the problem?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 6.15,
      "end_seconds": 11.62,
      "duration_seconds": 5.47,
      "text": "Um, so... swelling in both ankles. That's why I came."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 13.3,
      "end_seconds": 16.57,
      "duration_seconds": 3.27,
      "text": "How long has this been going on?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 17.24,
      "end_seconds": 21.02,
      "duration_seconds": 3.78,
      "text": "It's been going on for four weeks."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 21.59,
      "end_seconds": 28.01,
      "duration_seconds": 6.42,
      "text": "Uh-huh. Okay, give me more detail on it, whatever comes to mind."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 33.5,
      "end_seconds": 40.68,
      "duration_seconds": 7.18,
      "text": "Okay, so it's every other day. Only raising the legs, and it's not much."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 45.75,
      "end_seconds": 49.67,
      "duration_seconds": 3.92,
      "text": "Anything that tends to go along with it?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 51.14,
      "end_seconds": 55.67,
      "duration_seconds": 4.53,
      "text": "Tiredness goes along with it, most of the time."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 73.97,
      "end_seconds": 77.93,
      "duration_seconds": 3.96,
      "text": "Before we go on, a few quick readings."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 89.76,
      "end_seconds": 91.7,
      "duration_seconds": 1.94,
      "text": "Hold still for me..."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 101.4,
      "end_seconds": 111.3,
      "duration_seconds": 9.9,
      "text": "Okay: pulse 90, respiratory rate 25. And temp 37.1 degrees, blood pressure 122 over 73, SpO2 92 percent on room air."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 115.47,
      "end_seconds": 118.88,
      "duration_seconds": 3.41,
      "text": "Is that alright, um, doctor?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 120.25,
      "end_seconds": 125.13,
      "duration_seconds": 4.88,
      "text": "They help build the picture, I'll tell you more soon."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 127.62,
      "end_seconds": 130.45,
      "duration_seconds": 2.83,
      "text": "Let me have a look at you."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 131.88,
      "end_seconds": 133.6,
      "duration_seconds": 1.72,
      "text": "Let me press here."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 146.47,
      "end_seconds": 150.88,
      "duration_seconds": 4.41,
      "text": "I can hear crackles at the bases of both lungs."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 156.24,
      "end_seconds": 163.11,
      "duration_seconds": 6.87,
      "text": "Okay, you can sit up. Have you noticed fainting, calf pain or coughing up blood?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 163.91,
      "end_seconds": 170.47,
      "duration_seconds": 6.56,
      "text": "I, I haven't had fainting, calf pain or coughing up blood, no."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 171.03,
      "end_seconds": 173.59,
      "duration_seconds": 2.56,
      "text": "I see. So, nothing like palpitations?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 174.87,
      "end_seconds": 177.41,
      "duration_seconds": 2.54,
      "text": "I haven't noticed any palpitations."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 177.75,
      "end_seconds": 181.44,
      "duration_seconds": 3.69,
      "text": "Uh-huh. Any problems with your joints or muscles?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 183.18,
      "end_seconds": 184.93,
      "duration_seconds": 1.75,
      "text": "Nothing else aches."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 185.75,
      "end_seconds": 187.31,
      "duration_seconds": 1.56,
      "text": "How's your breathing otherwise?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 189.29,
      "end_seconds": 191.14,
      "duration_seconds": 1.85,
      "text": "No, nothing there."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 192.33,
      "end_seconds": 195.6,
      "duration_seconds": 3.27,
      "text": "Is there a family history of anything significant?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 196.25,
      "end_seconds": 199.7,
      "duration_seconds": 3.45,
      "text": "My father had a heart attack."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 200.71,
      "end_seconds": 201.89,
      "duration_seconds": 1.18,
      "text": "Any regular medication?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 202.84,
      "end_seconds": 204.76,
      "duration_seconds": 1.92,
      "text": "No, nothing regular."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 206.03,
      "end_seconds": 210.42,
      "duration_seconds": 4.39,
      "text": "Are there any allergies on your record that I should check?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 211.38,
      "end_seconds": 220.16,
      "duration_seconds": 8.78,
      "text": "I was told I'm allergic to pollen, but I don't remember what reaction I had."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 221.64,
      "end_seconds": 224.49,
      "duration_seconds": 2.85,
      "text": "Have you got any chronic problems?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 225.39,
      "end_seconds": 230.58,
      "duration_seconds": 5.19,
      "text": "I, I have heart failure. I have high blood pressure."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 232.58,
      "end_seconds": 233.65,
      "duration_seconds": 1.07,
      "text": "Hm, okay."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 234.66,
      "end_seconds": 239.77,
      "duration_seconds": 5.11,
      "text": "Um, I have heart disease, for five years."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 240.61,
      "end_seconds": 248.5,
      "duration_seconds": 7.89,
      "text": "Alright, high blood pressure and heart disease, that matches what I have here. Who do you live with?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 249.73,
      "end_seconds": 255.14,
      "duration_seconds": 5.41,
      "text": "I live with my family, my husband and two kids."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 255.87,
      "end_seconds": 257.68,
      "duration_seconds": 1.81,
      "text": "Any sport or activity?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 258.53,
      "end_seconds": 261.51,
      "duration_seconds": 2.98,
      "text": "I play badminton on Sundays."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 280.21,
      "end_seconds": 283.08,
      "duration_seconds": 2.87,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 284.55,
      "end_seconds": 287.38,
      "duration_seconds": 2.83,
      "text": "No, never had any surgery."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 303.19,
      "end_seconds": 335.08,
      "duration_seconds": 31.89,
      "text": "So, based on the history and the examination, this looks most like fluid overload related to the heart. I'd also keep a kidney problem in mind. I think an ECG makes sense here, for breathlessness. I'd like you to take furosemide, 40 milligrams, every morning, until we review. That should help with fluid overload. Keep the salt and the fluids moderate, no more than about one and a half litres a day."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 335.96,
      "end_seconds": 342.5,
      "duration_seconds": 6.54,
      "text": "Come back after the results are back. That's it on my side. Anything unclear?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 344.29,
      "end_seconds": 351.01,
      "duration_seconds": 6.72,
      "text": "Uh, I think that's clear. Thank you for being so thorough."
    }
  ]
}