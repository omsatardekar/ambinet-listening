  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.91,
      "end_seconds": 4.15,
      "duration_seconds": 3.24,
      "text": "hello doctor, sorry, am I early?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.61,
      "end_seconds": 9.06,
      "duration_seconds": 3.45,
      "text": "yes do sit. Tell me what's been happening"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 9.84,
      "end_seconds": 13.87,
      "duration_seconds": 4.03,
      "text": "Mainly I've been feeling drowsy. That's why I came."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 15.07,
      "end_seconds": 18.92,
      "duration_seconds": 3.85,
      "text": "alright tell me what you take day to day"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 20.26,
      "end_seconds": 30.29,
      "duration_seconds": 10.03,
      "text": "Sodium valproate i take it 500 milligrams twice a day for the fits i'm on escitalopram 10 milligrams once a day"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 32.3,
      "end_seconds": 34.93,
      "duration_seconds": 2.63,
      "text": "how long have you taken that?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 36.58,
      "end_seconds": 38.38,
      "duration_seconds": 1.8,
      "text": "For about a month."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 39.64,
      "end_seconds": 42.13,
      "duration_seconds": 2.49,
      "text": "how long have you had it?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 42.76,
      "end_seconds": 45.68,
      "duration_seconds": 2.92,
      "text": "I've had it for one week"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 46.63,
      "end_seconds": 50.24,
      "duration_seconds": 3.61,
      "text": "How would you describe it, mild, moderate, severe?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 52.07,
      "end_seconds": 69.58,
      "duration_seconds": 17.51,
      "text": "A four out of ten I suppose. Oh and a bit of confusion afterwards. That's been about the same three days. I did have a fit last month at one point but that's gone now."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 80.04,
      "end_seconds": 87.13,
      "duration_seconds": 7.09,
      "text": "Any loss of bladder control, fever, headache or weakness on one side at all?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 88.72,
      "end_seconds": 90.73,
      "duration_seconds": 2.01,
      "text": "Nothing like that, no."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 94.22,
      "end_seconds": 97.45,
      "duration_seconds": 3.23,
      "text": "Have you had head injury, by any chance?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 98.2,
      "end_seconds": 103.01,
      "duration_seconds": 4.81,
      "text": "no, uh, I haven't had any head injury"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 103.52,
      "end_seconds": 106.93,
      "duration_seconds": 3.41,
      "text": "any muscle or joint problems besides this?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 108.0,
      "end_seconds": 110.36,
      "duration_seconds": 2.36,
      "text": "no, joints are fine"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 112.36,
      "end_seconds": 117.52,
      "duration_seconds": 5.16,
      "text": "So, anyone in the the family with similar problems or other conditions?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 118.75,
      "end_seconds": 121.72,
      "duration_seconds": 2.97,
      "text": "Yeah, my uncle had colon cancer."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 126.02,
      "end_seconds": 127.34,
      "duration_seconds": 1.32,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 128.01,
      "end_seconds": 130.83,
      "duration_seconds": 2.82,
      "text": "just my gallbladder removed, in 2016"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 148.64,
      "end_seconds": 150.33,
      "duration_seconds": 1.69,
      "text": "Any sport or activity?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 151.63,
      "end_seconds": 154.3,
      "duration_seconds": 2.67,
      "text": "I play badminton on Sundays"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 155.33,
      "end_seconds": 156.91,
      "duration_seconds": 1.58,
      "text": "Okay do you work?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 158.57,
      "end_seconds": 164.79,
      "duration_seconds": 6.22,
      "text": "I run a small shop, so I'm on my feet a lot"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 166.0,
      "end_seconds": 168.93,
      "duration_seconds": 2.93,
      "text": "is anyone at home with you?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 170.11,
      "end_seconds": 174.07,
      "duration_seconds": 3.96,
      "text": "I share a flat with two friends"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 175.88,
      "end_seconds": 180.18,
      "duration_seconds": 4.3,
      "text": "Okay, any long-term health problems I should know about?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 182.01,
      "end_seconds": 187.53,
      "duration_seconds": 5.52,
      "text": "hmm you know I've had epilepsy for two years now"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 188.37,
      "end_seconds": 189.84,
      "duration_seconds": 1.47,
      "text": "Okay, anything else?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 191.78,
      "end_seconds": 193.18,
      "duration_seconds": 1.4,
      "text": "I have anxiety."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 203.47,
      "end_seconds": 207.44,
      "duration_seconds": 3.97,
      "text": "before we go on, a few quick readings"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 218.92,
      "end_seconds": 219.76,
      "duration_seconds": 0.84,
      "text": "almost there.."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 231.09,
      "end_seconds": 244.81,
      "duration_seconds": 13.72,
      "text": "Okay: temp 36.9 degrees, weight 79 kilos, pulse is 71 beats a minute, pressure 116 over 73, oxygen saturation is 99 percent, height 156 centimetres, BMI works out to to 32.5."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 247.71,
      "end_seconds": 250.41,
      "duration_seconds": 2.7,
      "text": "Let's do the physical part now."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 251.86,
      "end_seconds": 255.04,
      "duration_seconds": 3.18,
      "text": "stay still while I have a a look"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 269.2,
      "end_seconds": 272.1,
      "duration_seconds": 2.9,
      "text": "you're alert and orientated, speech is clear"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 273.33,
      "end_seconds": 275.6,
      "duration_seconds": 2.27,
      "text": "Just relax, I'll be quick."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 293.39,
      "end_seconds": 296.54,
      "duration_seconds": 3.15,
      "text": "reflexes and power are symmetrical on both sides"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 302.1,
      "end_seconds": 314.46,
      "duration_seconds": 12.36,
      "text": "Good, that's the examination. Putting it all together, this is probably breakthrough seizure on known epilepsy. I'd also keep a provoked seizure from missed medication in mind."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 315.96,
      "end_seconds": 319.25,
      "duration_seconds": 3.29,
      "text": "Should I be worried about this?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 320.25,
      "end_seconds": 337.41,
      "duration_seconds": 17.16,
      "text": "It's reasonable to be concerned, but right now breakthrough seizure on known epilepsy is my leading thought, not anything worse. Let me just check I've got this right. You've been feeling drowsy for one week, and no fever or headache."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 339.08,
      "end_seconds": 340.75,
      "duration_seconds": 1.67,
      "text": "mm, that's right"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 345.92,
      "end_seconds": 371.96,
      "duration_seconds": 26.04,
      "text": "let's get an EEG, for seizure i'll request a blood level of the tablet, it'll help with adherence check no driving until we've reviewed you again, I'm sorry, but that's the rule never skip the tablets, and set a phone alarm if it helps please take the tablets with food so they don't upset your stomach we'll refer you to the epilepsy clinic"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 372.64,
      "end_seconds": 392.93,
      "duration_seconds": 20.29,
      "text": "An MRI of the brain is something we might do if this doesn't improve next month if you have another seizure lasting more than five minutes, that's the point to come in urgently let's review you in four weeks thanks for coming in"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 394.11,
      "end_seconds": 396.78,
      "duration_seconds": 2.67,
      "text": "all good here. Thank you"
    }
  ]
}