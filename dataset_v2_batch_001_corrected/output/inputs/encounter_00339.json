{
  "schema_version": "1.0",
  "encounter_id": "00339",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.11,
      "end_seconds": 5.15,
      "duration_seconds": 4.04,
      "text": "Sorry I'm a few minutes behind, doctor."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.86,
      "end_seconds": 11.22,
      "duration_seconds": 4.36,
      "text": "That's alright, take a seat. Tell me why you've come."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 11.85,
      "end_seconds": 17.22,
      "duration_seconds": 5.37,
      "text": "Doctor, I'm just here to to help with the details."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 18.58,
      "end_seconds": 23.63,
      "duration_seconds": 5.05,
      "text": "Of course, please stay. It's helpful to to have you here."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 24.17,
      "end_seconds": 32.66,
      "duration_seconds": 8.49,
      "text": "I wanted to to get severe pain in my right side that comes in waves looked at."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 34.14,
      "end_seconds": 37.29,
      "duration_seconds": 3.15,
      "text": "Tell me what you take day to day."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 38.78,
      "end_seconds": 46.59,
      "duration_seconds": 7.81,
      "text": "It's allopurinol, 100 milligrams, once a day. I'm on telmisartan, 40 milligrams, once a day."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 47.54,
      "end_seconds": 49.9,
      "duration_seconds": 2.36,
      "text": "How long are we talking about?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 51.53,
      "end_seconds": 54.44,
      "duration_seconds": 2.91,
      "text": "around a week, I think"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 55.39,
      "end_seconds": 58.83,
      "duration_seconds": 3.44,
      "text": "It was closer to two weeks, doctor."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 59.4,
      "end_seconds": 64.24,
      "duration_seconds": 4.84,
      "text": "Okay, so roughly one to two weeks. Is that right?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 66.27,
      "end_seconds": 68.31,
      "duration_seconds": 2.04,
      "text": "That sounds about right."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 69.16,
      "end_seconds": 73.91,
      "duration_seconds": 4.75,
      "text": "Okay, give me more detail on it, whatever comes to mind."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 74.76,
      "end_seconds": 87.95,
      "duration_seconds": 13.19,
      "text": "It feels moderate to me. A hot water bottle helps a bit. Honestly, on and off. I thought it would sort itself out, but it hasn't."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 89.9,
      "end_seconds": 93.7,
      "duration_seconds": 3.8,
      "text": "Anything that tends to go along with it?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 99.11,
      "end_seconds": 103.26,
      "duration_seconds": 4.15,
      "text": "Nausea goes along with it, most of the time."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 104.5,
      "end_seconds": 108.12,
      "duration_seconds": 3.62,
      "text": "Any restlessness, you can't sit still as well?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 112.17,
      "end_seconds": 125.52,
      "duration_seconds": 13.35,
      "text": "yes, about the same, about a week as for nausea, I honestly can't say when that began it might have been last month or the month before"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 126.65,
      "end_seconds": 135.54,
      "duration_seconds": 8.89,
      "text": "have you had severe pain in your right side that comes in waves before, or is this the first time?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 139.36,
      "end_seconds": 146.21,
      "duration_seconds": 6.85,
      "text": "right, uh, I had a similar thing last year it went away"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 153.28,
      "end_seconds": 157.7,
      "duration_seconds": 4.42,
      "text": "right, and what about previous kidney stones or vomiting?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 159.14,
      "end_seconds": 163.7,
      "duration_seconds": 4.56,
      "text": "No previous kidney stones or vomiting, none of it."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 167.63,
      "end_seconds": 172.01,
      "duration_seconds": 4.38,
      "text": "have you had any testicular pain or burning when passing urine?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 176.64,
      "end_seconds": 179.8,
      "duration_seconds": 3.16,
      "text": "Nothing like that, you know, no."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 180.79,
      "end_seconds": 184.04,
      "duration_seconds": 3.25,
      "text": "anything with your nerves, like weakness or numbness?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 185.4,
      "end_seconds": 187.36,
      "duration_seconds": 1.96,
      "text": "no, that's all normal"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 188.95,
      "end_seconds": 190.92,
      "duration_seconds": 1.97,
      "text": "Alright, do you smoke?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 192.77,
      "end_seconds": 196.47,
      "duration_seconds": 3.7,
      "text": "I smoke, yes, around five a day."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 197.38,
      "end_seconds": 199.14,
      "duration_seconds": 1.76,
      "text": "alright, how about exercise?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 199.96,
      "end_seconds": 203.54,
      "duration_seconds": 3.58,
      "text": "Not really, I don't get much exercise."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 204.19,
      "end_seconds": 207.03,
      "duration_seconds": 2.84,
      "text": "What kind of work do you do?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 207.82,
      "end_seconds": 212.41,
      "duration_seconds": 4.59,
      "text": "I work on a farm, it's quite physical."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 213.28,
      "end_seconds": 215.87,
      "duration_seconds": 2.59,
      "text": "So, how do you eat, generally?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 217.33,
      "end_seconds": 219.67,
      "duration_seconds": 2.34,
      "text": "I skip breakfast most days"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 220.25,
      "end_seconds": 226.75,
      "duration_seconds": 6.5,
      "text": "Right, have you ever reacted badly to a medicine or food? Any allergies?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 228.24,
      "end_seconds": 231.49,
      "duration_seconds": 3.25,
      "text": "No allergies that I know of, no."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 232.37,
      "end_seconds": 235.44,
      "duration_seconds": 3.07,
      "text": "alright, any diagnoses you've been given before?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 237.22,
      "end_seconds": 243.43,
      "duration_seconds": 6.21,
      "text": "I've had gout for two years now. I've had high blood pressure, yes."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 243.95,
      "end_seconds": 251.48,
      "duration_seconds": 7.53,
      "text": "okay, I can see gout in your file as well is there a family history of anything significant?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 253.56,
      "end_seconds": 255.53,
      "duration_seconds": 1.97,
      "text": "my mother has migraines"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 257.38,
      "end_seconds": 260.73,
      "duration_seconds": 3.35,
      "text": "First the numbers, if you don't mind."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 272.35,
      "end_seconds": 273.31,
      "duration_seconds": 0.96,
      "text": "Almost there..."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 283.03,
      "end_seconds": 292.35,
      "duration_seconds": 9.32,
      "text": "Okay: oxygen saturation is 96 percent, temperature 37.0, respiratory rate 17. And pulse is 115 beats a minute, pressure 117 over 74."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 297.4,
      "end_seconds": 298.87,
      "duration_seconds": 1.47,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 299.96,
      "end_seconds": 302.51,
      "duration_seconds": 2.55,
      "text": "I'll explain what that means shortly."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 305.41,
      "end_seconds": 308.37,
      "duration_seconds": 2.96,
      "text": "If you're comfortable, I'll examine you now."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 325.54,
      "end_seconds": 326.24,
      "duration_seconds": 0.7,
      "text": "sure"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 327.34,
      "end_seconds": 330.49,
      "duration_seconds": 3.15,
      "text": "Stay still while I have a look."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 345.14,
      "end_seconds": 351.27,
      "duration_seconds": 6.13,
      "text": "There's tenderness in the right loin when I tap, and your tummy is soft."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 356.14,
      "end_seconds": 372.35,
      "duration_seconds": 16.21,
      "text": "Okay, you can sit up. Stop me if I've got anything wrong. You've had severe pain in your right side that comes in waves, moderate, and no previous kidney stones or testicular pain."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 373.39,
      "end_seconds": 375.52,
      "duration_seconds": 2.13,
      "text": "That's what happened, yes."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 393.62,
      "end_seconds": 396.59,
      "duration_seconds": 2.97,
      "text": "Any scans or blood work done already?"
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 397.32,
      "end_seconds": 406.31,
      "duration_seconds": 8.99,
      "text": "I did have an ultrasound of the kidneys done last year, but the paper's at home."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 407.87,
      "end_seconds": 415.68,
      "duration_seconds": 7.81,
      "text": "I'd like to arrange a CT scan of the kidneys and bladder for suspected renal colic."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 417.7,
      "end_seconds": 418.78,
      "duration_seconds": 1.08,
      "text": "Mm, okay."
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 419.79,
      "end_seconds": 439.38,
      "duration_seconds": 19.59,
      "text": "I think kidney function tests makes sense here, for renal colic. I'd like you to take paracetamol, 1 gram, every six hours if needed, for three days. That's for pain. You'll be taking tamsulosin, 0.4 milligrams, at night, for two weeks. That's for stone passage."
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 440.41,
      "end_seconds": 442.49,
      "duration_seconds": 2.08,
      "text": "Fine, I'll start it."
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 443.63,
      "end_seconds": 467.0,
      "duration_seconds": 23.37,
      "text": "Drink three litres of water a day and try to strain your urine so we can catch the stone if it passes. Cut back on tea, coffee and fizzy drinks for a couple of weeks and see how things settle. I'm gonna send a referral to the urology team."
    },
    {
      "segment_id": "SEG0059",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 469.02,
      "end_seconds": 469.72,
      "duration_seconds": 0.7,
      "text": "okay"
    },
    {
      "segment_id": "SEG0060",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 470.4,
      "end_seconds": 472.84,
      "duration_seconds": 2.44,
      "text": "We'll catch up after the scan."
    },
    {
      "segment_id": "SEG0061",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 473.63,
      "end_seconds": 476.32,
      "duration_seconds": 2.69,
      "text": "Yes, I can do that."
    },
    {
      "segment_id": "SEG0062",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 478.28,
      "end_seconds": 480.71,
      "duration_seconds": 2.43,
      "text": "alright, I'll see you out"
    },
    {
      "segment_id": "SEG0063",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 481.64,
      "end_seconds": 485.13,
      "duration_seconds": 3.49,
      "text": "Right, no, you've explained it well. Thanks."
    },
    {
      "segment_id": "SEG0064",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 486.42,
      "end_seconds": 487.61,
      "duration_seconds": 1.19,
      "text": "see you then"
    }
  ]
}