{
  "schema_version": "1.0",
  "encounter_id": "00004",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.9,
      "end_seconds": 4.98,
      "duration_seconds": 4.08,
      "text": "Morning, doctor, I hope I'm not interrupting."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.24,
      "end_seconds": 12.15,
      "duration_seconds": 3.91,
      "text": "Yes, do sit. Tell me what's been happening."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 13.51,
      "end_seconds": 17.29,
      "duration_seconds": 3.78,
      "text": "Uh, I'm here because of constipation."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 18.24,
      "end_seconds": 21.62,
      "duration_seconds": 3.38,
      "text": "Are you on any tablets or medication?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 22.82,
      "end_seconds": 26.68,
      "duration_seconds": 3.86,
      "text": "I take metformin, 500 milligrams, twice a day."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 28.59,
      "end_seconds": 32.5,
      "duration_seconds": 3.91,
      "text": "Is this recent, or has it been a while?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 33.7,
      "end_seconds": 35.59,
      "duration_seconds": 1.89,
      "text": "Probably four weeks. Yeah."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 37.38,
      "end_seconds": 40.33,
      "duration_seconds": 2.95,
      "text": "Does it come along with anything else?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 42.4,
      "end_seconds": 67.73,
      "duration_seconds": 25.33,
      "text": "When it starts I tend to get a heavy feeling in the lower tummy as well. And straining to pass stool, too. The heavy feeling in the lower tummy? That's been for two years. Hmm, I had a little bright blood on the paper before. That's settled now, though."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 69.01,
      "end_seconds": 74.3,
      "duration_seconds": 5.29,
      "text": "Have you had constipation before, or is this the first time?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 74.82,
      "end_seconds": 80.14,
      "duration_seconds": 5.32,
      "text": "A bit, last year. It settled by itself back then."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 81.96,
      "end_seconds": 84.67,
      "duration_seconds": 2.71,
      "text": "And abdominal swelling, any of that?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 85.68,
      "end_seconds": 87.72,
      "duration_seconds": 2.04,
      "text": "No. No abdominal swelling."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 89.53,
      "end_seconds": 94.43,
      "duration_seconds": 4.9,
      "text": "A few quick ones: pain on passing stool or vomiting?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 96.08,
      "end_seconds": 101.5,
      "duration_seconds": 5.42,
      "text": "I haven't had pain on passing stool or vomiting, no."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 103.15,
      "end_seconds": 107.85,
      "duration_seconds": 4.7,
      "text": "A few quick ones: black stools, weight loss or fever?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 111.85,
      "end_seconds": 116.49,
      "duration_seconds": 4.64,
      "text": "No, no black stools, weight loss or fever."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 117.71,
      "end_seconds": 121.59,
      "duration_seconds": 3.88,
      "text": "On the cardiac side, anything I should know?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 125.71,
      "end_seconds": 129.16,
      "duration_seconds": 3.45,
      "text": "Um, no, nothing with my heart."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 130.72,
      "end_seconds": 133.38,
      "duration_seconds": 2.66,
      "text": "Anything different when you pass water?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 135.41,
      "end_seconds": 136.93,
      "duration_seconds": 1.52,
      "text": "No changes there."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 137.79,
      "end_seconds": 141.3,
      "duration_seconds": 3.51,
      "text": "Is there a family history of anything significant?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 142.36,
      "end_seconds": 147.44,
      "duration_seconds": 5.08,
      "text": "Yeah, um, my sister has epilepsy. My mother has diabetes."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 149.42,
      "end_seconds": 154.47,
      "duration_seconds": 5.05,
      "text": "Tell me about your routine, work, habits, that sort of thing."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 156.2,
      "end_seconds": 169.55,
      "duration_seconds": 13.35,
      "text": "I stopped smoking about two years back. Yes, I'm a nurse on a busy ward. It's just me and my wife at home now."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 170.12,
      "end_seconds": 173.03,
      "duration_seconds": 2.91,
      "text": "Have you got any chronic problems?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 173.78,
      "end_seconds": 180.82,
      "duration_seconds": 7.04,
      "text": "I have diabetes, for nearly five years. An underactive thyroid, for nearly five years."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 181.77,
      "end_seconds": 185.29,
      "duration_seconds": 3.52,
      "text": "Alright, diabetes, that matches what I have here."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 203.64,
      "end_seconds": 206.89,
      "duration_seconds": 3.25,
      "text": "Okay, what about operations, anything like that?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 211.75,
      "end_seconds": 216.27,
      "duration_seconds": 4.52,
      "text": "I had my thyroid operated on a long time ago."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 217.96,
      "end_seconds": 221.8,
      "duration_seconds": 3.84,
      "text": "Before we go on, a few quick readings."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 233.6,
      "end_seconds": 234.42,
      "duration_seconds": 0.82,
      "text": "Almost there..."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 249.83,
      "end_seconds": 257.2,
      "duration_seconds": 7.37,
      "text": "Okay: heart rate 71, temperature is 36.7 degrees, respiratory rate 17, pressure 118 over 77."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 258.58,
      "end_seconds": 262.45,
      "duration_seconds": 3.87,
      "text": "Okay, I need to examine you for this."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 264.3,
      "end_seconds": 267.35,
      "duration_seconds": 3.05,
      "text": "Stay still while I have a look."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 281.01,
      "end_seconds": 283.75,
      "duration_seconds": 2.74,
      "text": "There's no mass in the tummy."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 285.18,
      "end_seconds": 287.55,
      "duration_seconds": 2.37,
      "text": "Let me just check something."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 298.7,
      "end_seconds": 303.49,
      "duration_seconds": 4.79,
      "text": "I can feel firm stool in the left lower abdomen."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 309.27,
      "end_seconds": 311.57,
      "duration_seconds": 2.3,
      "text": "Okay, you can sit up."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 320.56,
      "end_seconds": 325.05,
      "duration_seconds": 4.49,
      "text": "Today I'm not changing anything. Ask me anything before you go."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 326.41,
      "end_seconds": 328.2,
      "duration_seconds": 1.79,
      "text": "No questions. Thank you."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 329.32,
      "end_seconds": 330.99,
      "duration_seconds": 1.67,
      "text": "Mind how you go."
    }
  ]
}