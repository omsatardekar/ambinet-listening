{
  "schema_version": "1.0",
  "encounter_id": "00236",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.63,
      "end_seconds": 3.68,
      "duration_seconds": 3.05,
      "text": "Okay, welcome. Let's see what's going on."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 8.66,
      "end_seconds": 11.12,
      "duration_seconds": 2.46,
      "text": "Hello, doctor, thank you."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 12.13,
      "end_seconds": 13.98,
      "duration_seconds": 1.85,
      "text": "Right, what's the trouble?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 15.19,
      "end_seconds": 19.05,
      "duration_seconds": 3.86,
      "text": "I've been dealing with a pounding headache."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 19.73,
      "end_seconds": 21.71,
      "duration_seconds": 1.98,
      "text": "And when did that start?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 22.36,
      "end_seconds": 29.83,
      "duration_seconds": 7.47,
      "text": "It's been going on for three days. I did try to ignore it for a while."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 31.09,
      "end_seconds": 39.65,
      "duration_seconds": 8.56,
      "text": "Tell me a bit more about it: how bad it gets, how often, and whether anything makes it better or worse."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 40.41,
      "end_seconds": 46.1,
      "duration_seconds": 5.69,
      "text": "It's once or twice a day. It feels moderate to me."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 46.67,
      "end_seconds": 48.83,
      "duration_seconds": 2.16,
      "text": "Has there been nausea too?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 49.54,
      "end_seconds": 57.94,
      "duration_seconds": 8.4,
      "text": "Yes, about the same, five days. I was feeling faint at one point, but that's gone now."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 59.69,
      "end_seconds": 64.5,
      "duration_seconds": 4.81,
      "text": "Let me check a few things. Any fainting or confusion?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 70.93,
      "end_seconds": 73.86,
      "duration_seconds": 2.93,
      "text": "No, not any of them."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 75.49,
      "end_seconds": 81.62,
      "duration_seconds": 6.13,
      "text": "Let me check a few things. Any fever, passing no urine or vomiting?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 82.21,
      "end_seconds": 87.7,
      "duration_seconds": 5.49,
      "text": "I, I haven't had fever, passing no urine or vomiting, no."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 89.4,
      "end_seconds": 92.9,
      "duration_seconds": 3.5,
      "text": "So, is your urine normal, no changes?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 94.16,
      "end_seconds": 97.7,
      "duration_seconds": 3.54,
      "text": "That's normal as far as I know."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 98.49,
      "end_seconds": 103.76,
      "duration_seconds": 5.27,
      "text": "Do you have any allergies to medicines, food, anything at all?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 105.68,
      "end_seconds": 108.64,
      "duration_seconds": 2.96,
      "text": "Yes, eggs. I get stomach cramps."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 110.13,
      "end_seconds": 113.0,
      "duration_seconds": 2.87,
      "text": "Have you ever been under the knife?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 114.52,
      "end_seconds": 119.81,
      "duration_seconds": 5.29,
      "text": "Yes, I had my thyroid operated on, a long time ago."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 131.13,
      "end_seconds": 134.11,
      "duration_seconds": 2.98,
      "text": "Are you on any tablets or medication?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 135.25,
      "end_seconds": 139.22,
      "duration_seconds": 3.97,
      "text": "I take amlodipine, 5 milligrams, once a day."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 156.19,
      "end_seconds": 159.12,
      "duration_seconds": 2.93,
      "text": "Is there anything medical in your background?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 159.95,
      "end_seconds": 167.54,
      "duration_seconds": 7.59,
      "text": "Yes, high blood pressure. I kept putting it off, which I know isn't sensible."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 169.29,
      "end_seconds": 174.07,
      "duration_seconds": 4.78,
      "text": "Mm. Okay, any relatives with health problems I should be aware of?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 176.04,
      "end_seconds": 178.1,
      "duration_seconds": 2.06,
      "text": "My mother has diabetes."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 188.75,
      "end_seconds": 194.05,
      "duration_seconds": 5.3,
      "text": "Tell me about your routine, work, habits, that sort of thing."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 196.09,
      "end_seconds": 208.02,
      "duration_seconds": 11.93,
      "text": "A beer or two most evenings, to be honest. I live with my family, my husband and two kids. I cycle to work most mornings."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 209.0,
      "end_seconds": 217.32,
      "duration_seconds": 8.32,
      "text": "Okay, so the vitals from earlier. Pulse is 106 beats a minute, blood pressure 100 over 59, temperature is 36.7 degrees."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 218.24,
      "end_seconds": 219.74,
      "duration_seconds": 1.5,
      "text": "Good, thank you."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 220.96,
      "end_seconds": 224.55,
      "duration_seconds": 3.59,
      "text": "Okay, I need to examine you for this."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 226.38,
      "end_seconds": 228.54,
      "duration_seconds": 2.16,
      "text": "Tell me if anything hurts."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 247.38,
      "end_seconds": 250.84,
      "duration_seconds": 3.46,
      "text": "Your skin is warm and a bit clammy."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 252.16,
      "end_seconds": 254.09,
      "duration_seconds": 1.93,
      "text": "Let me press here."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 263.24,
      "end_seconds": 264.94,
      "duration_seconds": 1.7,
      "text": "Capillary refill is normal."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 267.33,
      "end_seconds": 302.83,
      "duration_seconds": 35.5,
      "text": "Okay, finished. Okay, thinking it through, I think we're dealing with heat exhaustion with some dehydration at this stage. I'd like to arrange blood salts for dehydration. The result will help us decide whether anything more is needed. The treatment will be ORS, 1 sachet, three times a day, for two days. That should help with dehydration. Avoid the midday sun for a few days and keep a water bottle with you."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 304.05,
      "end_seconds": 307.42,
      "duration_seconds": 3.37,
      "text": "Let's plan a check in three days."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 308.79,
      "end_seconds": 311.22,
      "duration_seconds": 2.43,
      "text": "Yes, I can do that."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 312.85,
      "end_seconds": 315.71,
      "duration_seconds": 2.86,
      "text": "That's everything from me. Any other questions?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 316.79,
      "end_seconds": 319.09,
      "duration_seconds": 2.3,
      "text": "I appreciate it, doctor."
    }
  ]
}