{
  "schema_version": "1.0",
  "encounter_id": "00298",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.68,
      "end_seconds": 5.87,
      "duration_seconds": 5.19,
      "text": "Morning. Nice to finally see you, you know, doctor."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.5,
      "end_seconds": 12.05,
      "duration_seconds": 4.55,
      "text": "Of course, put it down anywhere. So, how can I help?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 15.1,
      "end_seconds": 20.46,
      "duration_seconds": 5.36,
      "text": "I mean, um, thank you for fitting us in, doctor"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 20.98,
      "end_seconds": 25.14,
      "duration_seconds": 4.16,
      "text": "That's fine, sit down. We'll go through it together."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 27.04,
      "end_seconds": 33.39,
      "duration_seconds": 6.35,
      "text": "Yeah, it's a pounding headache. I don't know what's causing it."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 34.66,
      "end_seconds": 37.51,
      "duration_seconds": 2.85,
      "text": "how long are we talking about?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 38.82,
      "end_seconds": 42.47,
      "duration_seconds": 3.65,
      "text": "It's been about a week now."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 44.49,
      "end_seconds": 49.0,
      "duration_seconds": 4.51,
      "text": "Is it constant, or does it come and go?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 50.76,
      "end_seconds": 53.48,
      "duration_seconds": 2.72,
      "text": "It, It comes and goes."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 54.07,
      "end_seconds": 57.37,
      "duration_seconds": 3.3,
      "text": "On a normal day, how strong is it?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 57.92,
      "end_seconds": 62.05,
      "duration_seconds": 4.13,
      "text": "I'd give it a four, out of ten."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 63.0,
      "end_seconds": 67.08,
      "duration_seconds": 4.08,
      "text": "Is there anything that takes the the edge off?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 67.98,
      "end_seconds": 71.51,
      "duration_seconds": 3.53,
      "text": "I get some relief from sleep."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 73.15,
      "end_seconds": 76.26,
      "duration_seconds": 3.11,
      "text": "Anything you do that brings it on?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 77.68,
      "end_seconds": 82.88,
      "duration_seconds": 5.2,
      "text": "I notice it more with loud noise and bright lights."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 84.44,
      "end_seconds": 87.56,
      "duration_seconds": 3.12,
      "text": "Does it come along with anything else?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 89.46,
      "end_seconds": 100.27,
      "duration_seconds": 10.81,
      "text": "When it starts I tend to get sensitivity to light as well. The, The sensitivity to light? That's been for five days."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 101.02,
      "end_seconds": 104.23,
      "duration_seconds": 3.21,
      "text": "How bad is it, would you say?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 108.38,
      "end_seconds": 117.91,
      "duration_seconds": 9.53,
      "text": "about a four out of ten. Nausea was there, but it's gone away on its own"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 118.62,
      "end_seconds": 122.86,
      "duration_seconds": 4.24,
      "text": "Let's get your blood pressure and the the other basics."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 133.79,
      "end_seconds": 135.4,
      "duration_seconds": 1.61,
      "text": "Just relax your arm..."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 145.28,
      "end_seconds": 152.85,
      "duration_seconds": 7.57,
      "text": "okay: BP is 121 over 79, pulse 67, temp 36.6 degrees, oxygen saturation is 99 percent"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 154.15,
      "end_seconds": 157.65,
      "duration_seconds": 3.5,
      "text": "Right, I'll examine you now, bear with me."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 158.83,
      "end_seconds": 161.0,
      "duration_seconds": 2.17,
      "text": "Almost done with this part."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 178.3,
      "end_seconds": 181.09,
      "duration_seconds": 2.79,
      "text": "Power in all four limbs is normal"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 182.45,
      "end_seconds": 184.54,
      "duration_seconds": 2.09,
      "text": "almost done with this part"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 195.34,
      "end_seconds": 198.24,
      "duration_seconds": 2.9,
      "text": "Neck is supple, no stiffness at all."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 203.59,
      "end_seconds": 213.31,
      "duration_seconds": 9.72,
      "text": "okay, finished have you noticed loss of consciousness, double vision, neck stiffness or weakness in the arms or legs?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 213.83,
      "end_seconds": 217.19,
      "duration_seconds": 3.36,
      "text": "So, no, not any of them."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 217.78,
      "end_seconds": 222.19,
      "duration_seconds": 4.41,
      "text": "Anything with your heart, like skipped beats or fainting?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 223.36,
      "end_seconds": 226.14,
      "duration_seconds": 2.78,
      "text": "So, no, that's been fine."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 228.02,
      "end_seconds": 229.76,
      "duration_seconds": 1.74,
      "text": "And alcohol, how much?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 231.05,
      "end_seconds": 233.64,
      "duration_seconds": 2.59,
      "text": "I don't drink at all."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 234.37,
      "end_seconds": 237.6,
      "duration_seconds": 3.23,
      "text": "So, what do you do for work?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 238.75,
      "end_seconds": 244.18,
      "duration_seconds": 5.43,
      "text": "I work in an office, mostly sitting at a desk."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 245.23,
      "end_seconds": 248.4,
      "duration_seconds": 3.17,
      "text": "What do you do to keep active?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 249.98,
      "end_seconds": 253.08,
      "duration_seconds": 3.1,
      "text": "I cycle to work most mornings"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 258.19,
      "end_seconds": 260.37,
      "duration_seconds": 2.18,
      "text": "Right, what's your diet like?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 261.78,
      "end_seconds": 266.29,
      "duration_seconds": 4.51,
      "text": "I eat out quite a lot, to be honest."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 268.26,
      "end_seconds": 272.16,
      "duration_seconds": 3.9,
      "text": "Any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 274.0,
      "end_seconds": 277.08,
      "duration_seconds": 3.08,
      "text": "No, none that I know of."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 278.0,
      "end_seconds": 280.76,
      "duration_seconds": 2.76,
      "text": "Any allergies I should know about?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 282.33,
      "end_seconds": 287.91,
      "duration_seconds": 5.58,
      "text": "Um, um, no, none that that I know of."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 305.05,
      "end_seconds": 306.26,
      "duration_seconds": 1.21,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 307.69,
      "end_seconds": 312.47,
      "duration_seconds": 4.78,
      "text": "Well, just my appendix out, about eight years ago."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 329.92,
      "end_seconds": 334.02,
      "duration_seconds": 4.1,
      "text": "let's go through your medication. What are you taking?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 335.94,
      "end_seconds": 339.96,
      "duration_seconds": 4.02,
      "text": "It's Disprin, 325 milligrams, when it starts."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 354.47,
      "end_seconds": 371.86,
      "duration_seconds": 17.39,
      "text": "let me tell you where I've got to. This is probably migraine with aura. I want to be honest that this is an impression, not a final answer. Tension-type headache is also on my list"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 375.98,
      "end_seconds": 382.83,
      "duration_seconds": 6.85,
      "text": "I've been thinking the worst, to be honest. Is it bad?"
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 384.66,
      "end_seconds": 399.16,
      "duration_seconds": 14.5,
      "text": "Nothing I've seen today points to an emergency. It looks like migraine with aura. Okay, for now, no new medicines or tests are needed. Take care, and call us if anything changes."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 400.62,
      "end_seconds": 403.62,
      "duration_seconds": 3.0,
      "text": "alright, thanks bye for now"
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 404.88,
      "end_seconds": 406.11,
      "duration_seconds": 1.23,
      "text": "Bye for now."
    }
  ]
}