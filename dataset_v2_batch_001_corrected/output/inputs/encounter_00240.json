      "role": "DOCTOR",
      "start_seconds": 205.28,
      "end_seconds": 208.34,
      "duration_seconds": 3.06,
      "text": "Before I prescribe anything, any allergies?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 208.87,
      "end_seconds": 212.4,
      "duration_seconds": 3.53,
      "text": "Yes, dust, it gives me itchy eyes."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 213.67,
      "end_seconds": 217.05,
      "duration_seconds": 3.38,
      "text": "any long-term health problems I should know about?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 218.42,
      "end_seconds": 227.11,
      "duration_seconds": 8.69,
      "text": "I've had thin bones, yes. A neighbour of mine said I should see someone about it."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 229.17,
      "end_seconds": 231.78,
      "duration_seconds": 2.61,
      "text": "Have you had any previous surgeries?"
