{
  "schema_version": "1.0",
  "encounter_id": "00457",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.04,
      "end_seconds": 7.35,
      "duration_seconds": 6.31,
      "text": "Good afternoon, you know, doctor, the receptionist said you'd see me now."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.99,
      "end_seconds": 14.47,
      "duration_seconds": 6.48,
      "text": "Yes, come in, take a seat. What can I do for you today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 16.17,
      "end_seconds": 27.97,
      "duration_seconds": 11.8,
      "text": "Um, um, so... blood on the toilet paper. That's why I came. I wasn't sure whether to come in at all, to be honest."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 28.8,
      "end_seconds": 32.69,
      "duration_seconds": 3.89,
      "text": "Is this recent, or has it been a while?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 33.58,
      "end_seconds": 39.23,
      "duration_seconds": 5.65,
      "text": "I'd say about four days. Actually, no, closer to two days."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 40.14,
      "end_seconds": 43.49,
      "duration_seconds": 3.35,
      "text": "Is it worse with anything in particular?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 44.21,
      "end_seconds": 66.27,
      "duration_seconds": 22.06,
      "text": "I notice it more with hard stools. Oh, you know, and pain when I pass stool. That's been about the same, four weeks. As for pain when I pass stool, honestly, all the time. And a small lump near the back passage, too."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 67.77,
      "end_seconds": 71.33,
      "duration_seconds": 3.56,
      "text": "Any fever or change in bowel habit at all?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 72.37,
      "end_seconds": 78.07,
      "duration_seconds": 5.7,
      "text": "I, I haven't had fever or change in bowel habit, no."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 79.52,
      "end_seconds": 84.62,
      "duration_seconds": 5.1,
      "text": "Any black stools, abdominal pain or family history of bowel cancer?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 85.85,
      "end_seconds": 88.82,
      "duration_seconds": 2.97,
      "text": "No, none of that at all."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 90.55,
      "end_seconds": 92.88,
      "duration_seconds": 2.33,
      "text": "Any breathing difficulties apart from this?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 94.54,
      "end_seconds": 96.17,
      "duration_seconds": 1.63,
      "text": "No, nothing there."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 97.99,
      "end_seconds": 102.04,
      "duration_seconds": 4.05,
      "text": "Anything with your nerves, like weakness or numbness?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 103.05,
      "end_seconds": 104.69,
      "duration_seconds": 1.64,
      "text": "Nothing odd there."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 105.65,
      "end_seconds": 108.38,
      "duration_seconds": 2.73,
      "text": "Are you on any tablets or medication?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 111.53,
      "end_seconds": 115.03,
      "duration_seconds": 3.5,
      "text": "I take iron tablets, once a day."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 116.95,
      "end_seconds": 121.37,
      "duration_seconds": 4.42,
      "text": "Do your parents or siblings have any long-term illnesses?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 122.22,
      "end_seconds": 124.41,
      "duration_seconds": 2.19,
      "text": "My brother has asthma."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 126.35,
      "end_seconds": 130.1,
      "duration_seconds": 3.75,
      "text": "Do you have any known allergies at all?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 131.78,
      "end_seconds": 134.54,
      "duration_seconds": 2.76,
      "text": "Yes, I'm allergic to penicillin."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 142.18,
      "end_seconds": 144.01,
      "duration_seconds": 1.83,
      "text": "Do you drink alcohol?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 145.49,
      "end_seconds": 150.38,
      "duration_seconds": 4.89,
      "text": "A beer or two most evenings, to be honest."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 151.56,
      "end_seconds": 153.81,
      "duration_seconds": 2.25,
      "text": "Okay, any sport or activity?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 154.91,
      "end_seconds": 157.2,
      "duration_seconds": 2.29,
      "text": "I play badminton on Sundays."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 158.08,
      "end_seconds": 159.76,
      "duration_seconds": 1.68,
      "text": "Do you live alone?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 161.24,
      "end_seconds": 164.44,
      "duration_seconds": 3.2,
      "text": "Yes, I live on my own."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 165.42,
      "end_seconds": 168.01,
      "duration_seconds": 2.59,
      "text": "Alright, tell me about your work."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 169.35,
      "end_seconds": 174.93,
      "duration_seconds": 5.58,
      "text": "I'm a software engineer, so I'm at a screen all day."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 176.2,
      "end_seconds": 180.49,
      "duration_seconds": 4.29,
      "text": "Tell me about your health in general, any ongoing conditions?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 184.4,
      "end_seconds": 192.45,
      "duration_seconds": 8.05,
      "text": "I have low haemoglobin. I'm not great at remembering details, so bear with me."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 194.3,
      "end_seconds": 200.53,
      "duration_seconds": 6.23,
      "text": "Right, so low haemoglobin is already on your record. We'll keep that in mind today."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 218.29,
      "end_seconds": 220.79,
      "duration_seconds": 2.5,
      "text": "A few measurements, then we'll continue."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 229.82,
      "end_seconds": 231.9,
      "duration_seconds": 2.08,
      "text": "Okay, give me a moment..."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 243.77,
      "end_seconds": 251.06,
      "duration_seconds": 7.29,
      "text": "Okay: pulse 69, temperature 36.5, oxygen saturation is 97 percent, blood pressure 123 over 75."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 254.01,
      "end_seconds": 257.88,
      "duration_seconds": 3.87,
      "text": "Right, if you're comfortable, I'll examine you now."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 258.69,
      "end_seconds": 259.77,
      "duration_seconds": 1.08,
      "text": "Mm, okay."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 261.5,
      "end_seconds": 263.7,
      "duration_seconds": 2.2,
      "text": "Almost done with this part."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 280.86,
      "end_seconds": 286.61,
      "duration_seconds": 5.75,
      "text": "There's a small external pile at the edge, and I don't see any fissure."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 291.14,
      "end_seconds": 291.84,
      "duration_seconds": 0.7,
      "text": "Okay."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 297.01,
      "end_seconds": 298.24,
      "duration_seconds": 1.23,
      "text": "Thanks for that."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 316.24,
      "end_seconds": 325.3,
      "duration_seconds": 9.06,
      "text": "Putting it all together, it points towards haemorrhoids. Something higher up in the bowel that we shouldn't miss is still possible."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 326.33,
      "end_seconds": 330.15,
      "duration_seconds": 3.82,
      "text": "What are the chances it's something bad?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 331.8,
      "end_seconds": 341.38,
      "duration_seconds": 9.58,
      "text": "I can't promise yet, but most people with haemorrhoids do well once it's treated properly. I want a colonoscopy done, that's for rectal bleeding."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 342.29,
      "end_seconds": 343.9,
      "duration_seconds": 1.61,
      "text": "Okay, that's fine."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 345.8,
      "end_seconds": 354.25,
      "duration_seconds": 8.45,
      "text": "I'll start you on lactulose, 15 ml, at night, for two weeks. That should help with constipation."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 356.31,
      "end_seconds": 357.44,
      "duration_seconds": 1.13,
      "text": "Right, understood."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 359.43,
      "end_seconds": 374.7,
      "duration_seconds": 15.27,
      "text": "Soak in a warm bath for ten minutes after you pass stool, and don't strain. A colorectal surgeon would be the right next step, I'll refer you. See me again in three weeks."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 376.63,
      "end_seconds": 379.79,
      "duration_seconds": 3.16,
      "text": "So, yes, I can do that."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 381.73,
      "end_seconds": 388.38,
      "duration_seconds": 6.65,
      "text": "Let me check I've been clear. What will you do once you get home?"
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 388.99,
      "end_seconds": 398.19,
      "duration_seconds": 9.2,
      "text": "So, I take the lactulose, 15 ml, at night and come back in three weeks. Is that right?"
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 400.12,
      "end_seconds": 405.75,
      "duration_seconds": 5.63,
      "text": "Yes, exactly right. Okay, good. Let us know how you get on."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 406.4,
      "end_seconds": 408.44,
      "duration_seconds": 2.04,
      "text": "Okay, thank you. Bye."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 412.77,
      "end_seconds": 414.63,
      "duration_seconds": 1.86,
      "text": "Mind how you go."
    }
  ]
}