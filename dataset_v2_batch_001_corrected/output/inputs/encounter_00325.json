{
  "schema_version": "1.0",
  "encounter_id": "00325",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.4,
      "end_seconds": 4.79,
      "duration_seconds": 3.39,
      "text": "Good morning, how are you doing today?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 6.4,
      "end_seconds": 10.98,
      "duration_seconds": 4.58,
      "text": "Thanks, doctor. It's been a long few days."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 12.28,
      "end_seconds": 17.0,
      "duration_seconds": 4.72,
      "text": "Doctor, I'm just here to help with the details."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 17.71,
      "end_seconds": 20.08,
      "duration_seconds": 2.37,
      "text": "Okay. Start wherever you like."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 21.43,
      "end_seconds": 27.13,
      "duration_seconds": 5.7,
      "text": "Um, so... pain low in the pelvis. That's why I came."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 28.48,
      "end_seconds": 30.92,
      "duration_seconds": 2.44,
      "text": "Roughly when did it start?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 31.93,
      "end_seconds": 35.72,
      "duration_seconds": 3.79,
      "text": "It's been one week, I'm fairly sure."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 36.35,
      "end_seconds": 43.97,
      "duration_seconds": 7.62,
      "text": "Okay, give me more detail on it, whatever comes to mind. It helps to be thorough at this stage."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 45.09,
      "end_seconds": 51.89,
      "duration_seconds": 6.8,
      "text": "I'd say severe. I get some relief from a hot water bottle."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 52.74,
      "end_seconds": 60.35,
      "duration_seconds": 7.61,
      "text": "And the other thing I wanted to mention is that I can't really—"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 60.45,
      "end_seconds": 65.68,
      "duration_seconds": 5.23,
      "text": "Tell the doctor about the other thing, that's what worries me."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 66.83,
      "end_seconds": 73.34,
      "duration_seconds": 6.51,
      "text": "I was getting to that! Oh, and bloating. Had that since last Tuesday."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 74.11,
      "end_seconds": 76.54,
      "duration_seconds": 2.43,
      "text": "And how severe is it?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 78.24,
      "end_seconds": 79.82,
      "duration_seconds": 1.58,
      "text": "Moderate, I'd say."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 81.65,
      "end_seconds": 86.34,
      "duration_seconds": 4.69,
      "text": "Right, what about pain around your period, have you noticed that?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 86.98,
      "end_seconds": 89.9,
      "duration_seconds": 2.92,
      "text": "Yes, about the same, three days."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 91.15,
      "end_seconds": 93.74,
      "duration_seconds": 2.59,
      "text": "Okay, and how severe is it?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 94.5,
      "end_seconds": 98.52,
      "duration_seconds": 4.02,
      "text": "I'd give it a six, out of ten."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 99.68,
      "end_seconds": 103.95,
      "duration_seconds": 4.27,
      "text": "Is it constant, or does it come and go?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 105.17,
      "end_seconds": 111.35,
      "duration_seconds": 6.18,
      "text": "It's, um... not exactly... well, hard to explain, I mean—"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 113.42,
      "end_seconds": 119.25,
      "duration_seconds": 5.83,
      "text": "Let me put it another way: how many times in a typical day or week?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 119.8,
      "end_seconds": 122.73,
      "duration_seconds": 2.93,
      "text": "It sort of comes and goes."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 124.54,
      "end_seconds": 125.71,
      "duration_seconds": 1.17,
      "text": "What about alcohol?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 128.89,
      "end_seconds": 131.58,
      "duration_seconds": 2.69,
      "text": "I don't drink at all."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 132.89,
      "end_seconds": 133.77,
      "duration_seconds": 0.88,
      "text": "Any smoking?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 134.52,
      "end_seconds": 138.1,
      "duration_seconds": 3.58,
      "text": "I stopped smoking about two years back."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 142.75,
      "end_seconds": 144.23,
      "duration_seconds": 1.48,
      "text": "How about exercise?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 145.39,
      "end_seconds": 149.44,
      "duration_seconds": 4.05,
      "text": "Not really, I don't get much exercise."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 150.41,
      "end_seconds": 154.62,
      "duration_seconds": 4.21,
      "text": "Let's go through your medication. What are you taking?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 155.52,
      "end_seconds": 163.51,
      "duration_seconds": 7.99,
      "text": "It's escitalopram, 10 milligrams, once a day, doctor. She takes mefenamic acid, 500 milligrams, when it hurts."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 176.83,
      "end_seconds": 179.84,
      "duration_seconds": 3.01,
      "text": "Okay, any diagnoses you've been given before?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 181.05,
      "end_seconds": 184.38,
      "duration_seconds": 3.33,
      "text": "I have depression, for five years."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 185.88,
      "end_seconds": 187.24,
      "duration_seconds": 1.36,
      "text": "Right, any more?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 190.7,
      "end_seconds": 193.63,
      "duration_seconds": 2.93,
      "text": "I've had acid reflux, yes."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 194.97,
      "end_seconds": 206.15,
      "duration_seconds": 11.18,
      "text": "Right, so acid reflux is already on your record. We'll keep that in mind today. Do you have any allergies to medicines, food, anything at all?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 211.3,
      "end_seconds": 224.08,
      "duration_seconds": 12.78,
      "text": "Hmm, there was some antibiotic, I was told I was allergic. But I couldn't tell you what it was called or what it did."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 225.84,
      "end_seconds": 231.82,
      "duration_seconds": 5.98,
      "text": "Let me check a few things. Any fever, vaginal discharge or burning when passing urine?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 233.36,
      "end_seconds": 249.02,
      "duration_seconds": 15.66,
      "text": "Okay, so no, no fever, no vaginal discharge, no burning when passing urine. I did have pain during sex at one point, but that went away on its own."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 250.36,
      "end_seconds": 254.46,
      "duration_seconds": 4.1,
      "text": "Okay, have you noticed bleeding between periods or vomiting?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 255.74,
      "end_seconds": 260.8,
      "duration_seconds": 5.06,
      "text": "I haven't had bleeding between periods or vomiting, no."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 262.2,
      "end_seconds": 264.28,
      "duration_seconds": 2.08,
      "text": "Is your mobility otherwise okay?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 265.85,
      "end_seconds": 267.21,
      "duration_seconds": 1.36,
      "text": "Nothing else aches."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 276.58,
      "end_seconds": 278.98,
      "duration_seconds": 2.4,
      "text": "I'll take a few measurements first."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 292.67,
      "end_seconds": 294.3,
      "duration_seconds": 1.63,
      "text": "Just relax your arm..."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 305.62,
      "end_seconds": 317.57,
      "duration_seconds": 11.95,
      "text": "Okay: weight 65 kilos, blood pressure 109 over 68. And height 182 centimetres, heart rate 67, BMI works out to 19.6, temp 36.5 degrees."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 318.94,
      "end_seconds": 320.29,
      "duration_seconds": 1.35,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 321.31,
      "end_seconds": 323.86,
      "duration_seconds": 2.55,
      "text": "That's fine, we'll come to it."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 325.05,
      "end_seconds": 328.0,
      "duration_seconds": 2.95,
      "text": "Let me examine, it won't take long."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 329.03,
      "end_seconds": 331.31,
      "duration_seconds": 2.28,
      "text": "Take your time, no rush."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 344.41,
      "end_seconds": 349.73,
      "duration_seconds": 5.32,
      "text": "There's tenderness in the lower tummy on the left, and no guarding."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 352.36,
      "end_seconds": 353.06,
      "duration_seconds": 0.7,
      "text": "Okay."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 359.05,
      "end_seconds": 366.24,
      "duration_seconds": 7.19,
      "text": "Right, you can sit back down. I think a pregnancy test makes sense here, for pelvic pain."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_4",
      "role": "CLINICAL_STAFF",
      "start_seconds": 367.27,
      "end_seconds": 369.87,
      "duration_seconds": 2.6,
      "text": "The earliest is Friday, 9 am."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 371.04,
      "end_seconds": 393.07,
      "duration_seconds": 22.03,
      "text": "I'd like to arrange a swab test for pelvic pain. Let's get a pelvic ultrasound, for pelvic pain. A heat pad and some gentle movement help many people, and a pain diary helps me see a pattern. I'll also refer you to a gynaecologist. Thanks for coming in."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 394.3,
      "end_seconds": 396.44,
      "duration_seconds": 2.14,
      "text": "Thanks, that was helpful."
    }
  ]
}