{
  "schema_version": "1.0",
  "encounter_id": "00032",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.78,
      "end_seconds": 5.56,
      "duration_seconds": 4.78,
      "text": "Morning. Nice to finally see you, uh, doctor."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.39,
      "end_seconds": 11.5,
      "duration_seconds": 4.11,
      "text": "Right on time. Sit, please. How can I help?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 12.75,
      "end_seconds": 17.48,
      "duration_seconds": 4.73,
      "text": "I'm here because of thick yellow discharge from the nose."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 19.46,
      "end_seconds": 21.56,
      "duration_seconds": 2.1,
      "text": "Roughly when did it start?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 22.67,
      "end_seconds": 42.42,
      "duration_seconds": 19.75,
      "text": "Hm. It was either the end of last month or earlier than that. I couldn't tell you the date. Oh, and pressure in the face. Had that since Friday. Oh, with pressure in the face, only steam, and it's not much."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 43.24,
      "end_seconds": 49.61,
      "duration_seconds": 6.37,
      "text": "Any long-term health problems I should know about? I'm asking so that we don't miss anything."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 51.71,
      "end_seconds": 54.5,
      "duration_seconds": 2.79,
      "text": "Eczema, for nearly five years."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 73.49,
      "end_seconds": 76.52,
      "duration_seconds": 3.03,
      "text": "Before I prescribe anything, any allergies?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 77.07,
      "end_seconds": 80.78,
      "duration_seconds": 3.71,
      "text": "I've never been told I have allergies."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 81.93,
      "end_seconds": 85.63,
      "duration_seconds": 3.7,
      "text": "Alright, have you ever been under the knife?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 87.6,
      "end_seconds": 90.73,
      "duration_seconds": 3.13,
      "text": "I had my gallbladder removed in 2016."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 91.92,
      "end_seconds": 96.41,
      "duration_seconds": 4.49,
      "text": "Right, tell me what you take day to day."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 97.86,
      "end_seconds": 105.64,
      "duration_seconds": 7.78,
      "text": "I take hydrocortisone cream, when needed. Yeah, I'm on paracetamol, 500 milligrams, when needed."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 107.62,
      "end_seconds": 110.6,
      "duration_seconds": 2.98,
      "text": "Okay, what do you do for work?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 111.55,
      "end_seconds": 116.57,
      "duration_seconds": 5.02,
      "text": "I work in an office, mostly sitting at a desk."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 117.29,
      "end_seconds": 118.56,
      "duration_seconds": 1.27,
      "text": "How about exercise?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 119.13,
      "end_seconds": 123.07,
      "duration_seconds": 3.94,
      "text": "Not really, I don't get much exercise."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 124.7,
      "end_seconds": 126.7,
      "duration_seconds": 2.0,
      "text": "Any swelling around the eyes?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 127.39,
      "end_seconds": 131.4,
      "duration_seconds": 4.01,
      "text": "Not at all, no swelling around the eyes."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 131.94,
      "end_seconds": 135.75,
      "duration_seconds": 3.81,
      "text": "Any fever, nosebleeds or ear pain at all?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 136.38,
      "end_seconds": 138.79,
      "duration_seconds": 2.41,
      "text": "No, I'd have mentioned it."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 139.94,
      "end_seconds": 141.96,
      "duration_seconds": 2.02,
      "text": "Anything unusual with passing urine?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 142.49,
      "end_seconds": 145.41,
      "duration_seconds": 2.92,
      "text": "Well, no, that's all fine."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 147.01,
      "end_seconds": 150.97,
      "duration_seconds": 3.96,
      "text": "Any change in your bowel habit or your stomach generally?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 151.87,
      "end_seconds": 153.42,
      "duration_seconds": 1.55,
      "text": "Nothing unusual, no."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 161.67,
      "end_seconds": 165.33,
      "duration_seconds": 3.66,
      "text": "Before we go on, a few quick readings."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 175.87,
      "end_seconds": 177.72,
      "duration_seconds": 1.85,
      "text": "Hold still for me..."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 194.68,
      "end_seconds": 201.84,
      "duration_seconds": 7.16,
      "text": "Okay: temperature is 36.8 degrees, BP is 123 over 68, pulse is 75 beats a minute."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 203.43,
      "end_seconds": 205.48,
      "duration_seconds": 2.05,
      "text": "Shall we do the examination?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 206.8,
      "end_seconds": 208.14,
      "duration_seconds": 1.34,
      "text": "I'll go gently."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 224.91,
      "end_seconds": 229.82,
      "duration_seconds": 4.91,
      "text": "There's tenderness when I press over the cheeks and above the eyebrows."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 234.45,
      "end_seconds": 236.72,
      "duration_seconds": 2.27,
      "text": "Alright, good, that's the examination."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 255.4,
      "end_seconds": 261.93,
      "duration_seconds": 6.53,
      "text": "Okay, so my impression is this: This is probably sinusitis. A viral cold is still possible."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 263.24,
      "end_seconds": 266.19,
      "duration_seconds": 2.95,
      "text": "Is this going to go away?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 268.17,
      "end_seconds": 285.33,
      "duration_seconds": 17.16,
      "text": "Nothing I've seen today points to an emergency. It looks like sinusitis, but I'd like to confirm. So, to recap quickly. You've had thick yellow discharge from the nose, and no swelling around the eyes or ear pain."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 287.4,
      "end_seconds": 289.37,
      "duration_seconds": 1.97,
      "text": "That's what happened, yes."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 290.61,
      "end_seconds": 313.07,
      "duration_seconds": 22.46,
      "text": "I'm sending you for an X-ray of the sinuses because of sinusitis. I'd like you to take saline nasal spray, three times a day, for one week. That's for nasal congestion. Steam a couple of times a day and saline rinses will help clear things. That's it on my side. Anything unclear?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 314.97,
      "end_seconds": 317.91,
      "duration_seconds": 2.94,
      "text": "Alright, thanks. Bye for now."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 321.35,
      "end_seconds": 323.43,
      "duration_seconds": 2.08,
      "text": "So, see you then."
    }
  ]
}