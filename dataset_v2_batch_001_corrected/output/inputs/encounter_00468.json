{
  "schema_version": "1.0",
  "encounter_id": "00468",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.13,
      "end_seconds": 5.55,
      "duration_seconds": 4.42,
      "text": "Hello? Doctor? They told me to come straight in."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.78,
      "end_seconds": 10.72,
      "duration_seconds": 3.94,
      "text": "Yes, do sit. Tell me what's been happening."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 12.34,
      "end_seconds": 18.46,
      "duration_seconds": 6.12,
      "text": "Doctor, I've come along because I know the history, if it helps."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 19.23,
      "end_seconds": 21.94,
      "duration_seconds": 2.71,
      "text": "Absolutely, come and sit beside them."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 23.96,
      "end_seconds": 31.09,
      "duration_seconds": 7.13,
      "text": "Mainly I've been putting on weight over the last year. That's why I came."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 32.34,
      "end_seconds": 34.88,
      "duration_seconds": 2.54,
      "text": "How long have you had it?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 36.49,
      "end_seconds": 38.85,
      "duration_seconds": 2.36,
      "text": "About... well, two months."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 39.41,
      "end_seconds": 41.99,
      "duration_seconds": 2.58,
      "text": "Has there been sore knees too?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 44.01,
      "end_seconds": 45.02,
      "duration_seconds": 1.01,
      "text": "Yes, actually."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 45.94,
      "end_seconds": 49.09,
      "duration_seconds": 3.15,
      "text": "Have you been feeling sleepy in the day?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 50.96,
      "end_seconds": 55.36,
      "duration_seconds": 4.4,
      "text": "Oh, um, yes, for about a month."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 56.92,
      "end_seconds": 61.01,
      "duration_seconds": 4.09,
      "text": "And what about low mood, chest pain or heat intolerance?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 61.58,
      "end_seconds": 64.51,
      "duration_seconds": 2.93,
      "text": "Hmm, nothing like that, no."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 66.61,
      "end_seconds": 67.99,
      "duration_seconds": 1.38,
      "text": "What about palpitations?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 69.12,
      "end_seconds": 72.69,
      "duration_seconds": 3.57,
      "text": "Right, not at all, no palpitations."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 74.11,
      "end_seconds": 78.94,
      "duration_seconds": 4.83,
      "text": "Actually, doctor, I did notice palpitations. He doesn't always say."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 80.06,
      "end_seconds": 87.09,
      "duration_seconds": 7.03,
      "text": "No, I don't think I did. Maybe a little, I'm not sure."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 87.77,
      "end_seconds": 95.3,
      "duration_seconds": 7.53,
      "text": "Alright, I'll note both what you've said and what you've noticed. Has your skin been okay?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 97.11,
      "end_seconds": 98.14,
      "duration_seconds": 1.03,
      "text": "Skin's normal."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 99.63,
      "end_seconds": 103.16,
      "duration_seconds": 3.53,
      "text": "What medicines are you taking at the moment?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 104.86,
      "end_seconds": 120.54,
      "duration_seconds": 15.68,
      "text": "Okay, so he is on amlodipine, 5 milligrams, once a day for my pressure, I give it to him. He is on Glycomet, 500 milligrams, twice a day, I give it to him."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 121.44,
      "end_seconds": 124.25,
      "duration_seconds": 2.81,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 125.33,
      "end_seconds": 128.02,
      "duration_seconds": 2.69,
      "text": "No operations, you know, no."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 143.94,
      "end_seconds": 146.85,
      "duration_seconds": 2.91,
      "text": "Are you working at the moment?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 150.67,
      "end_seconds": 154.83,
      "duration_seconds": 4.16,
      "text": "Yes, I'm a nurse on a busy ward."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 155.81,
      "end_seconds": 158.33,
      "duration_seconds": 2.52,
      "text": "And what do you usually eat?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 159.01,
      "end_seconds": 162.33,
      "duration_seconds": 3.32,
      "text": "Mostly home-cooked food, rice and vegetables."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 176.84,
      "end_seconds": 182.38,
      "duration_seconds": 5.54,
      "text": "Do you have any allergies to medicines, food, anything at all?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 183.1,
      "end_seconds": 186.85,
      "duration_seconds": 3.75,
      "text": "Right, none, as far as I'm aware."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 188.63,
      "end_seconds": 197.03,
      "duration_seconds": 8.4,
      "text": "Actually, you know, I remember he had some kind of reaction to aspirin before. I couldn't swear to it."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 198.8,
      "end_seconds": 200.65,
      "duration_seconds": 1.85,
      "text": "I don't remember that."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 201.76,
      "end_seconds": 206.92,
      "duration_seconds": 5.16,
      "text": "Okay, I'll note both of those. Any diagnoses you've been given before?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 208.02,
      "end_seconds": 217.44,
      "duration_seconds": 9.42,
      "text": "I have high cholesterol, for about ten years. I mean, I have high blood pressure, for about ten years."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 219.29,
      "end_seconds": 220.27,
      "duration_seconds": 0.98,
      "text": "Hm, okay."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 222.07,
      "end_seconds": 228.71,
      "duration_seconds": 6.64,
      "text": "I have diabetes, for about ten years. I've never really been one for hospitals."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 230.39,
      "end_seconds": 235.98,
      "duration_seconds": 5.59,
      "text": "Yes, high blood pressure is known to us, good to have that clear."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 245.01,
      "end_seconds": 248.52,
      "duration_seconds": 3.51,
      "text": "Let's get your blood pressure and the other basics."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 257.96,
      "end_seconds": 258.91,
      "duration_seconds": 0.95,
      "text": "Almost there..."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 280.68,
      "end_seconds": 294.38,
      "duration_seconds": 13.7,
      "text": "Okay: height 179 centimetres, SpO2 97 percent on room air, heart rate 64, temperature 37.0, respiratory rate 14, weight 65 kilos, BMI works out to 20.3, BP is 115 over 71."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 295.67,
      "end_seconds": 297.29,
      "duration_seconds": 1.62,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 298.35,
      "end_seconds": 301.28,
      "duration_seconds": 2.93,
      "text": "Right, I'll explain what that means shortly."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 303.11,
      "end_seconds": 305.65,
      "duration_seconds": 2.54,
      "text": "Okay, a quick examination now."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 306.8,
      "end_seconds": 309.06,
      "duration_seconds": 2.26,
      "text": "Just relax, I'll be quick."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 327.82,
      "end_seconds": 332.16,
      "duration_seconds": 4.34,
      "text": "Your waist measures about a hundred and four centimetres."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 337.55,
      "end_seconds": 367.7,
      "duration_seconds": 30.15,
      "text": "Right, good, that's the examination. Having listened and examined, I think we're dealing with weight gain with a metabolic cause that needs checking at this stage. I want to be honest that this is an impression, not a final answer. Sleep apnoea is also on my list. I want a sleep study done, that's for snoring and sleepiness. Let's get a lipid profile, for metabolic risk. I'll request an HbA1c, it'll help with weight gain."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 368.43,
      "end_seconds": 393.37,
      "duration_seconds": 24.94,
      "text": "Start with small, specific changes: smaller portions, no sugary drinks, a thirty-minute walk most days. A dietitian would be the right next step, I'll refer you. Let's hold off on a thyroid test for now, and if there's no change in a month we can revisit it. One warning sign to remember: the symptoms get worse. In that case don't wait."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 393.97,
      "end_seconds": 394.87,
      "duration_seconds": 0.9,
      "text": "That's clear."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 396.03,
      "end_seconds": 401.08,
      "duration_seconds": 5.05,
      "text": "We'll catch up after the results are back. Thanks for coming in."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 402.92,
      "end_seconds": 405.24,
      "duration_seconds": 2.32,
      "text": "Thank you for your time."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 406.59,
      "end_seconds": 408.05,
      "duration_seconds": 1.46,
      "text": "See you then."
    }
  ]
}