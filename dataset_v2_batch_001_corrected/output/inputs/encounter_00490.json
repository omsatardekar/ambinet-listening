{
  "schema_version": "1.0",
  "encounter_id": "00490",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.66,
      "end_seconds": 2.42,
      "duration_seconds": 1.76,
      "text": "Hello there. Please, sit."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 4.11,
      "end_seconds": 4.81,
      "duration_seconds": 0.7,
      "text": "morning"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 6.3,
      "end_seconds": 8.85,
      "duration_seconds": 2.55,
      "text": "How can I help you today?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 9.38,
      "end_seconds": 16.66,
      "duration_seconds": 7.28,
      "text": "Mainly a ring-shaped itchy patch. There's a couple of other things, but that's the main one."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 17.38,
      "end_seconds": 27.64,
      "duration_seconds": 10.26,
      "text": "okay, so the vitals from earlier respiratory rate 17, pressure 126 over 82, pulse is 71 beats a minute spO2 98 percent on room air"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 29.02,
      "end_seconds": 29.92,
      "duration_seconds": 0.9,
      "text": "Okay, noted."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 42.55,
      "end_seconds": 46.19,
      "duration_seconds": 3.64,
      "text": "is this recent, or has it been a while?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 47.82,
      "end_seconds": 51.78,
      "duration_seconds": 3.96,
      "text": "Right, it's been going on for two months."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 52.3,
      "end_seconds": 56.83,
      "duration_seconds": 4.53,
      "text": "Right, on a normal day, how strong is it?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 57.47,
      "end_seconds": 59.39,
      "duration_seconds": 1.92,
      "text": "I, I'd say severe."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 61.32,
      "end_seconds": 64.62,
      "duration_seconds": 3.3,
      "text": "alright, do you notice anything setting it off?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 66.23,
      "end_seconds": 69.48,
      "duration_seconds": 3.25,
      "text": "I notice it it more with sweating"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 70.36,
      "end_seconds": 77.07,
      "duration_seconds": 6.71,
      "text": "I was just going to say that the main thing is—"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 77.17,
      "end_seconds": 83.66,
      "duration_seconds": 6.49,
      "text": "Sorry to cut in, doctor, quick question: shall I bring the trolley in now or later?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 84.18,
      "end_seconds": 86.59,
      "duration_seconds": 2.41,
      "text": "Later, thanks. Please go on."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 87.34,
      "end_seconds": 94.21,
      "duration_seconds": 6.87,
      "text": "I've also had darker skin around the patch, for about two weeks."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 95.53,
      "end_seconds": 98.45,
      "duration_seconds": 2.92,
      "text": "How bad is it, would you say?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 100.48,
      "end_seconds": 106.76,
      "duration_seconds": 6.28,
      "text": "Well, it's... hard to say, it's kind of... I don't know—"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 107.32,
      "end_seconds": 112.45,
      "duration_seconds": 5.13,
      "text": "Take your time. Mild, moderate, or severe, if you had to pick?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 113.8,
      "end_seconds": 117.04,
      "duration_seconds": 3.24,
      "text": "well, it feels moderate to me"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 118.39,
      "end_seconds": 123.3,
      "duration_seconds": 4.91,
      "text": "Any pain, similar rash on the scalp, new partner or fever?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 124.63,
      "end_seconds": 140.47,
      "duration_seconds": 15.84,
      "text": "Hmm, no, no pain, no similar rash on the scalp, no new partner. I did have itching between the toes at one point, but that went away on its own."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 141.84,
      "end_seconds": 145.54,
      "duration_seconds": 3.7,
      "text": "Did you notice any rash on the palms?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 146.13,
      "end_seconds": 149.65,
      "duration_seconds": 3.52,
      "text": "No, no rash on the palms."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 150.41,
      "end_seconds": 153.88,
      "duration_seconds": 3.47,
      "text": "How are your joints, any aches elsewhere?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 155.16,
      "end_seconds": 156.63,
      "duration_seconds": 1.47,
      "text": "no, nothing there"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 158.67,
      "end_seconds": 161.88,
      "duration_seconds": 3.21,
      "text": "any long-term health problems I should know about?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 162.77,
      "end_seconds": 167.9,
      "duration_seconds": 5.13,
      "text": "I've got diabetes. I've got gout. I've had high cholesterol, yes."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 168.55,
      "end_seconds": 170.12,
      "duration_seconds": 1.57,
      "text": "Any procedures or operations?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 171.26,
      "end_seconds": 183.88,
      "duration_seconds": 12.62,
      "text": "Yes, I had my appendix out, about eight years ago. I wasn't sure whether to come in at all, to be honest."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 185.83,
      "end_seconds": 189.18,
      "duration_seconds": 3.35,
      "text": "A few questions about your lifestyle now."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 190.45,
      "end_seconds": 205.03,
      "duration_seconds": 14.58,
      "text": "I have a couple of drinks on the weekend. I smoke about ten cigarettes a day. I eat out quite a lot, to be honest. Barely, I'm mostly sedentary these days"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 211.36,
      "end_seconds": 214.49,
      "duration_seconds": 3.13,
      "text": "What medicines are you taking at the moment?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 215.91,
      "end_seconds": 220.82,
      "duration_seconds": 4.91,
      "text": "Allopurinol, 100 milligrams, once a day for the gout."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 222.48,
      "end_seconds": 227.38,
      "duration_seconds": 4.9,
      "text": "Doctor, our chart from the last visit lists it it as 200 milligrams."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 228.92,
      "end_seconds": 232.74,
      "duration_seconds": 3.82,
      "text": "hm do you have the latest prescription with you?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 233.69,
      "end_seconds": 243.7,
      "duration_seconds": 10.01,
      "text": "Not with me. I'll bring it next time. Rosuvastatin. I take it 10 milligrams, maybe, at night for my cholesterol."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 244.88,
      "end_seconds": 249.43,
      "duration_seconds": 4.55,
      "text": "Right, did you happen to bring the box or the paperwork?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 251.36,
      "end_seconds": 260.55,
      "duration_seconds": 9.19,
      "text": "Yeah, not with me. I'll bring it next time. I take Candid cream, twice a day."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 262.46,
      "end_seconds": 264.9,
      "duration_seconds": 2.44,
      "text": "How long have you taken that?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 265.44,
      "end_seconds": 267.52,
      "duration_seconds": 2.08,
      "text": "For about a month."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 269.45,
      "end_seconds": 272.38,
      "duration_seconds": 2.93,
      "text": "Right, any allergies I should know about?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 274.1,
      "end_seconds": 276.58,
      "duration_seconds": 2.48,
      "text": "No, no allergies to anything."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 279.1,
      "end_seconds": 282.65,
      "duration_seconds": 3.55,
      "text": "Let me examine, it won't take long."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 290.53,
      "end_seconds": 291.6,
      "duration_seconds": 1.07,
      "text": "That's fine."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 293.14,
      "end_seconds": 295.1,
      "duration_seconds": 1.96,
      "text": "Almost done with this part."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 310.41,
      "end_seconds": 316.75,
      "duration_seconds": 6.34,
      "text": "There's a red ring-shaped scaly patch with a clearer centre in the groin crease."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 318.34,
      "end_seconds": 320.6,
      "duration_seconds": 2.26,
      "text": "Just relax, I'll be quick."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 327.88,
      "end_seconds": 332.15,
      "duration_seconds": 4.27,
      "text": "Skin between the the toes is white and peeling."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 335.11,
      "end_seconds": 346.91,
      "duration_seconds": 11.8,
      "text": "Okay, finished. Right, here's what I'm thinking. It fits best with a fungal skin infection. Psoriasis is also on my list. I can't rule out eczema yet."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 348.22,
      "end_seconds": 352.52,
      "duration_seconds": 4.3,
      "text": "Um, is this something I'll have for good?"
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 353.18,
      "end_seconds": 373.42,
      "duration_seconds": 20.24,
      "text": "I can't promise yet, but most people with a fungal skin infection do well once it's treated properly. Just to be sure I understood. You've had a ring-shaped itchy patch for two months, severe, and no new partner or rash on the palms."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 374.5,
      "end_seconds": 377.01,
      "duration_seconds": 2.51,
      "text": "That's it, uh, yes."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 378.44,
      "end_seconds": 383.55,
      "duration_seconds": 5.11,
      "text": "I'd like to arrange a skin scraping for suspected fungal infection."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_4",
      "role": "CLINICAL_STAFF",
      "start_seconds": 384.61,
      "end_seconds": 388.56,
      "duration_seconds": 3.95,
      "text": "I can book that for Tuesday at 2 pm."
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 390.46,
      "end_seconds": 392.68,
      "duration_seconds": 2.22,
      "text": "Okay, I'll be there."
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 394.73,
      "end_seconds": 401.84,
      "duration_seconds": 7.11,
      "text": "the treatment will be terbinafine cream, once a day, for two weeks it's for fungal infection"
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 403.84,
      "end_seconds": 407.43,
      "duration_seconds": 3.59,
      "text": "Is that safe with my other things?"
    },
    {
      "segment_id": "SEG0059",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 408.08,
      "end_seconds": 426.16,
      "duration_seconds": 18.08,
      "text": "keep the area dry, wear loose cotton, and don't share towels. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose. Come back in three weeks. Good. Let us know how you get on"
    },
    {
      "segment_id": "SEG0060",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 427.8,
      "end_seconds": 431.49,
      "duration_seconds": 3.69,
      "text": "alright, um, thanks bye for now"
    }
  ]
}