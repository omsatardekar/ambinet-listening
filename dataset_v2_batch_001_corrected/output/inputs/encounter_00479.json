      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 317.19,
      "end_seconds": 326.95,
      "duration_seconds": 9.76,
      "text": "So I take the prednisolone 30 milligrams once a day and come back in one week. Is that right?"
    },
