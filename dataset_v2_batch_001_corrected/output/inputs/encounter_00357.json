  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.29,
      "end_seconds": 7.28,
      "duration_seconds": 5.99,
      "text": "So, you know, hello, doctor. It's my turn, I think."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.08,
      "end_seconds": 12.01,
      "duration_seconds": 3.93,
      "text": "So, not at all, please sit. What's the problem?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 13.31,
      "end_seconds": 19.32,
      "duration_seconds": 6.01,
      "text": "Doctor, it's a very dry mouth. It's getting on my nerves now."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 21.32,
      "end_seconds": 24.54,
      "duration_seconds": 3.22,
      "text": "What medicines are you taking at the moment?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 26.37,
      "end_seconds": 36.14,
      "duration_seconds": 9.77,
      "text": "Glycomet i take it 500 milligrams, twice a day for my sugar it's clopidogrel, 75 milligrams, once a day"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 37.56,
      "end_seconds": 43.09,
      "duration_seconds": 5.53,
      "text": "Okay, give me more detail on it, whatever comes to mind."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 43.95,
      "end_seconds": 59.19,
      "duration_seconds": 15.24,
      "text": "Hmm, I get some relief from drinking water. Mild, really. And, And muscle cramps, too. Right, you know, with muscle cramps, it happens once or twice a day."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 61.27,
      "end_seconds": 65.2,
      "duration_seconds": 3.93,
      "text": "have you had dizziness when you stand up?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 66.73,
      "end_seconds": 68.88,
      "duration_seconds": 2.15,
      "text": "Mm, uh, yes."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 70.07,
      "end_seconds": 73.03,
      "duration_seconds": 2.96,
      "text": "how bad is it, would you say?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 74.73,
      "end_seconds": 80.71,
      "duration_seconds": 5.98,
      "text": "I'd give it a five, you know, out of ten."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 98.7,
      "end_seconds": 102.92,
      "duration_seconds": 4.22,
      "text": "Have you had any chest pain, vomiting, fever or confusion?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 104.32,
      "end_seconds": 106.31,
      "duration_seconds": 1.99,
      "text": "no. None of those"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 108.13,
      "end_seconds": 110.25,
      "duration_seconds": 2.12,
      "text": "is your digestion otherwise okay?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 111.89,
      "end_seconds": 116.25,
      "duration_seconds": 4.36,
      "text": "So, uh, bowels are regular, nothing odd."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 117.98,
      "end_seconds": 121.85,
      "duration_seconds": 3.87,
      "text": "Do you have any known allergies at all?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 122.61,
      "end_seconds": 126.32,
      "duration_seconds": 3.71,
      "text": "I'm allergic to dust, I get sneezing."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 142.02,
      "end_seconds": 143.92,
      "duration_seconds": 1.9,
      "text": "Any procedures or operations?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 145.93,
      "end_seconds": 150.62,
      "duration_seconds": 4.69,
      "text": "Hmm, just a bypass operation, six years ago."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 151.52,
      "end_seconds": 155.57,
      "duration_seconds": 4.05,
      "text": "Anyone in the family with similar problems or other conditions?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 157.16,
      "end_seconds": 160.03,
      "duration_seconds": 2.87,
      "text": "my grandmother had breast cancer"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 160.95,
      "end_seconds": 166.17,
      "duration_seconds": 5.22,
      "text": "Do you have any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 167.49,
      "end_seconds": 169.02,
      "duration_seconds": 1.53,
      "text": "I've got diabetes."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 174.21,
      "end_seconds": 175.63,
      "duration_seconds": 1.42,
      "text": "Okay, keep going."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 177.41,
      "end_seconds": 181.22,
      "duration_seconds": 3.81,
      "text": "Hmm, I've had heart disease, yes."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 183.14,
      "end_seconds": 188.79,
      "duration_seconds": 5.65,
      "text": "Right, so diabetes is already on your record. We'll keep that in mind today."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 204.75,
      "end_seconds": 207.06,
      "duration_seconds": 2.31,
      "text": "Are you active at all?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 208.12,
      "end_seconds": 211.64,
      "duration_seconds": 3.52,
      "text": "Barely, I'm mostly sedentary these days"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 215.51,
      "end_seconds": 217.67,
      "duration_seconds": 2.16,
      "text": "How do you eat, generally?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 219.26,
      "end_seconds": 222.08,
      "duration_seconds": 2.82,
      "text": "I skip breakfast most days."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 222.8,
      "end_seconds": 225.26,
      "duration_seconds": 2.46,
      "text": "Is anyone at home with you?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 229.16,
      "end_seconds": 232.82,
      "duration_seconds": 3.66,
      "text": "I share a flat with two friends."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 234.87,
      "end_seconds": 238.24,
      "duration_seconds": 3.37,
      "text": "first the numbers, if you don't mind"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 244.96,
      "end_seconds": 246.79,
      "duration_seconds": 1.83,
      "text": "Rest your hand here..."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 258.71,
      "end_seconds": 275.99,
      "duration_seconds": 17.28,
      "text": "okay: BP is 101 over 64, oxygen saturation is 97 percent, temp 36.6 degrees, pulse 109. Putting together what you've described, this is probably mild dehydration i can't rule out an electrolyte imbalance yet"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 276.8,
      "end_seconds": 281.73,
      "duration_seconds": 4.93,
      "text": "okay, so is this going to go away?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 283.65,
      "end_seconds": 302.9,
      "duration_seconds": 19.25,
      "text": "I can't promise yet, but most people with mild dehydration do well once it's treated properly. I'm sending you for a kidney function test because of dehydration. That That will help us see what's going on underneath and decide the next step."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 304.44,
      "end_seconds": 307.09,
      "duration_seconds": 2.65,
      "text": "Okay, uh, that's fine."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 308.5,
      "end_seconds": 312.23,
      "duration_seconds": 3.73,
      "text": "I'm sending you for blood salts because of dehydration"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 313.31,
      "end_seconds": 314.94,
      "duration_seconds": 1.63,
      "text": "will it hurt?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 316.59,
      "end_seconds": 341.55,
      "duration_seconds": 24.96,
      "text": "What I'm giving you is ORS, 1 sachet, after each loose motion, for two days. You take it by mouth. That's for dehydration. Small, frequent sips are better than a big glass at once, and keep going even if you don't feel thirsty. Do get help quickly if you faint or can't keep any fluids down."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 342.07,
      "end_seconds": 346.16,
      "duration_seconds": 4.09,
      "text": "Okay, so yes, I'll watch for that."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 347.47,
      "end_seconds": 354.53,
      "duration_seconds": 7.06,
      "text": "I'll want another look in three days. Right, call the clinic if you need us."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 355.72,
      "end_seconds": 359.69,
      "duration_seconds": 3.97,
      "text": "Yeah, you know, I appreciate it, doctor."
    }
  ]
}