      "role": "PATIENT",
      "start_seconds": 114.96,
      "end_seconds": 122.84,
      "duration_seconds": 7.88,
      "text": "I'm mostly vegetarian. Barely, I'm mostly sedentary these days. Retired. I stopped a few years back."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 135.94,
      "end_seconds": 139.47,
      "duration_seconds": 3.53,
      "text": "Did you get black stools, confusion or fever?"
