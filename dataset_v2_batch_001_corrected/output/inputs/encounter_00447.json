      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 189.8,
      "end_seconds": 192.14,
      "duration_seconds": 2.34,
      "text": "Okay, a quick examination now."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 193.91,
      "end_seconds": 195.63,
      "duration_seconds": 1.72,
