    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 140.93,
      "end_seconds": 146.22,
      "duration_seconds": 5.29,
      "text": "I haven't had black stools, confusion or fever, no"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 148.25,
      "end_seconds": 149.42,
      "duration_seconds": 1.17,
      "text": "any vomiting blood?"
