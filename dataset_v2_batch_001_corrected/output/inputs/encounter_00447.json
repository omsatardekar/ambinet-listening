      "start_seconds": 169.49,
      "end_seconds": 184.25,
      "duration_seconds": 14.76,
      "text": "Here are the numbers, doctor. Height 181 centimetres, weight 68 kilos. Saturation 99 percent, pulse is 77 beats a minute, BP is 115 over 74, temperature is 36.6 degrees, respiratory rate 14."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 185.47,
      "end_seconds": 186.97,
      "duration_seconds": 1.5,
      "text": "Good, thank you."
