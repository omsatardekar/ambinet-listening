{
  "schema_version": "1.0",
  "encounter_id": "00263",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.12,
      "end_seconds": 7.13,
      "duration_seconds": 6.01,
      "text": "Doctor, hello, I've got my papers here, where should I put them?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.63,
      "end_seconds": 13.08,
      "duration_seconds": 4.45,
      "text": "No trouble at all, come in. What's been bothering you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 14.37,
      "end_seconds": 17.31,
      "duration_seconds": 2.94,
      "text": "I'm here because of yellow eyes."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 17.89,
      "end_seconds": 20.27,
      "duration_seconds": 2.38,
      "text": "Let me check your vitals now."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 31.67,
      "end_seconds": 33.88,
      "duration_seconds": 2.21,
      "text": "Okay, give me a moment..."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 43.85,
      "end_seconds": 53.67,
      "duration_seconds": 9.82,
      "text": "Okay: BP is 112 over 80, temperature is 36.9 degrees, oxygen saturation is 97 percent. And pulse is 77 beats a minute."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 54.64,
      "end_seconds": 56.88,
      "duration_seconds": 2.24,
      "text": "Is that alright, doctor?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 58.81,
      "end_seconds": 66.86,
      "duration_seconds": 8.05,
      "text": "Let's look at it together in a minute. Is this recent, or has it been a while?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 72.44,
      "end_seconds": 93.91,
      "duration_seconds": 21.47,
      "text": "It's been going on for three weeks. And a dull ache on the right side of the tummy, too. About dull ache on the right side of the tummy, fatty food definitely sets it off. And there's dark urine as well, about three months now."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 95.07,
      "end_seconds": 99.85,
      "duration_seconds": 4.78,
      "text": "Have you had yellow eyes before, or is this the first time?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 101.05,
      "end_seconds": 108.92,
      "duration_seconds": 7.87,
      "text": "Yes, something like this happened about six months ago, and it went away on its own."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 119.47,
      "end_seconds": 124.71,
      "duration_seconds": 5.24,
      "text": "so, and what about weight loss, swelling of the tummy or fever?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 125.7,
      "end_seconds": 131.36,
      "duration_seconds": 5.66,
      "text": "No weight loss, swelling of the tummy or fever, none of it."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 132.99,
      "end_seconds": 138.25,
      "duration_seconds": 5.26,
      "text": "Let me check a few things. Any black stools, vomiting blood or confusion?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 139.51,
      "end_seconds": 141.72,
      "duration_seconds": 2.21,
      "text": "Nothing like that, no."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 145.52,
      "end_seconds": 147.67,
      "duration_seconds": 2.15,
      "text": "Is your chest okay generally?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 153.47,
      "end_seconds": 155.12,
      "duration_seconds": 1.65,
      "text": "No, nothing there."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 155.98,
      "end_seconds": 159.39,
      "duration_seconds": 3.41,
      "text": "What medicines are you taking at the moment?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 160.19,
      "end_seconds": 166.0,
      "duration_seconds": 5.81,
      "text": "Hmm, I take glimepiride, 2 milligrams, before breakfast for my sugar."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 167.99,
      "end_seconds": 170.43,
      "duration_seconds": 2.44,
      "text": "How long have you taken that?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 171.51,
      "end_seconds": 181.03,
      "duration_seconds": 9.52,
      "text": "About about a year. Uh, I had metformin at one point, but I'm off it now."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 183.09,
      "end_seconds": 187.45,
      "duration_seconds": 4.36,
      "text": "tell me about your health in general, any ongoing conditions?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 188.19,
      "end_seconds": 189.91,
      "duration_seconds": 1.72,
      "text": "yes, high cholesterol"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 191.65,
      "end_seconds": 192.35,
      "duration_seconds": 0.7,
      "text": "right"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 194.16,
      "end_seconds": 195.25,
      "duration_seconds": 1.09,
      "text": "Yes, diabetes."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 207.6,
      "end_seconds": 209.66,
      "duration_seconds": 2.06,
      "text": "Are you active at all?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 211.26,
      "end_seconds": 214.22,
      "duration_seconds": 2.96,
      "text": "Barely, I'm mostly sedentary these days"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 215.39,
      "end_seconds": 218.8,
      "duration_seconds": 3.41,
      "text": "What kind of work do you do?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 220.53,
      "end_seconds": 224.89,
      "duration_seconds": 4.36,
      "text": "I work on a farm, it's quite physical."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 227.27,
      "end_seconds": 230.53,
      "duration_seconds": 3.26,
      "text": "Right, let me check a few things physically."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 231.5,
      "end_seconds": 234.32,
      "duration_seconds": 2.82,
      "text": "Bear with me a a second."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 249.06,
      "end_seconds": 252.5,
      "duration_seconds": 3.44,
      "text": "The whites of your eyes are yellow."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 253.33,
      "end_seconds": 254.98,
      "duration_seconds": 1.65,
      "text": "Let me press here."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 266.73,
      "end_seconds": 270.53,
      "duration_seconds": 3.8,
      "text": "Liver edge is just palpable and mildly tender."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 275.59,
      "end_seconds": 292.53,
      "duration_seconds": 16.94,
      "text": "Right, you can sit back down. Let me tell you where I've got to. This is probably jaundice with a cause we still need to find. That's my thinking for now, and it may change as we learn more. We shouldn't forget hepatitis."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 299.86,
      "end_seconds": 317.78,
      "duration_seconds": 17.92,
      "text": "Let's book a hepatitis screen to look into jaundice. Let's get an ultrasound of the abdomen, for jaundice. That will help us see what's going on underneath and decide the next step. Let's book liver function tests to look into jaundice."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 318.5,
      "end_seconds": 321.24,
      "duration_seconds": 2.74,
      "text": "Where do I go for that?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 322.92,
      "end_seconds": 339.03,
      "duration_seconds": 16.11,
      "text": "Please avoid alcohol completely and don't take any painkillers except paracetamol, and not much of that. If you vomit blood or become drowsy or confused, or you feel really unwell, please come to the emergency department. Look after yourself."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 340.92,
      "end_seconds": 343.06,
      "duration_seconds": 2.14,
      "text": "no questions. Thank you"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 343.82,
      "end_seconds": 345.08,
      "duration_seconds": 1.26,
      "text": "Safe journey home."
    }
  ]
}