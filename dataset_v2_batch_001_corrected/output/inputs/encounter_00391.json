{
  "schema_version": "1.0",
  "encounter_id": "00391",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.03,
      "end_seconds": 9.67,
      "duration_seconds": 8.64,
      "text": "Well, hi doctor, sorry, the lift was out and I had to take the stairs."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 11.61,
      "end_seconds": 15.59,
      "duration_seconds": 3.98,
      "text": "Not at all, please sit. What's the problem?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 17.36,
      "end_seconds": 21.75,
      "duration_seconds": 4.39,
      "text": "I've been dealing with pain in both knees."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 22.7,
      "end_seconds": 30.36,
      "duration_seconds": 7.66,
      "text": "Let's go through your medication. What are you taking? These questions might sound routine, but they matter."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 31.82,
      "end_seconds": 40.7,
      "duration_seconds": 8.88,
      "text": "Okay, so I'm on losartan, 50 milligrams, maybe, once a day for my blood pressure."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 41.35,
      "end_seconds": 45.48,
      "duration_seconds": 4.13,
      "text": "Did you happen to bring the box or the paperwork?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 47.06,
      "end_seconds": 59.72,
      "duration_seconds": 12.66,
      "text": "Yeah, not with me. I'll bring it next time. Okay, uh, so I'm on Glycomet, 500 milligrams, twice a day for my sugar."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 60.07,
      "end_seconds": 60.77,
      "duration_seconds": 0.7,
      "text": "Right."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 61.88,
      "end_seconds": 67.05,
      "duration_seconds": 5.17,
      "text": "I'd been on glimepiride, not any more though, I stopped."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 68.61,
      "end_seconds": 71.36,
      "duration_seconds": 2.75,
      "text": "How far back does it go?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 71.91,
      "end_seconds": 75.87,
      "duration_seconds": 3.96,
      "text": "It's been about three months, I'm fairly sure."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 76.38,
      "end_seconds": 82.5,
      "duration_seconds": 6.12,
      "text": "Ah. Okay, give me more detail on it, whatever comes to mind."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 86.39,
      "end_seconds": 113.07,
      "duration_seconds": 26.68,
      "text": "Honestly, a couple of times a week. I notice it more with squatting. Maybe a three out of ten on a bad day. I've also had swelling in the right knee, for two months. As for swelling in the right knee, it feels severe to me. It settles a little with elevation."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 114.01,
      "end_seconds": 120.54,
      "duration_seconds": 6.53,
      "text": "Have you had pain in both knees before, or is this the first time?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 122.46,
      "end_seconds": 132.76,
      "duration_seconds": 10.3,
      "text": "Yes, uh, something like this happened about six months ago, and it went away on its own."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 134.07,
      "end_seconds": 139.38,
      "duration_seconds": 5.31,
      "text": "Any fall, pain in other joints or locking of the knee at all?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 140.36,
      "end_seconds": 148.42,
      "duration_seconds": 8.06,
      "text": "No fall, pain in other joints or locking of the knee, none of it."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 150.36,
      "end_seconds": 155.26,
      "duration_seconds": 4.9,
      "text": "Let me check a few things. Any fever or back pain?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 155.91,
      "end_seconds": 160.35,
      "duration_seconds": 4.44,
      "text": "No fever or back pain, none of it."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 161.02,
      "end_seconds": 163.44,
      "duration_seconds": 2.42,
      "text": "Anything different when you pass water?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 165.36,
      "end_seconds": 166.79,
      "duration_seconds": 1.43,
      "text": "No changes there."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 168.47,
      "end_seconds": 169.89,
      "duration_seconds": 1.42,
      "text": "Neurologically, anything strange?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 170.97,
      "end_seconds": 173.77,
      "duration_seconds": 2.8,
      "text": "Oh, no, nothing like that."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 177.84,
      "end_seconds": 183.15,
      "duration_seconds": 5.31,
      "text": "Are there any allergies on your record that I should check?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 185.07,
      "end_seconds": 191.33,
      "duration_seconds": 6.26,
      "text": "Hmm, I'm allergic to peanuts, I get my lips swelling."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 205.75,
      "end_seconds": 209.63,
      "duration_seconds": 3.88,
      "text": "Okay, is there anything medical in your background?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 210.84,
      "end_seconds": 219.97,
      "duration_seconds": 9.13,
      "text": "I have high blood pressure, for nearly five years. I have diabetes, for about a year."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 231.32,
      "end_seconds": 233.08,
      "duration_seconds": 1.76,
      "text": "Do you live alone?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 234.47,
      "end_seconds": 237.56,
      "duration_seconds": 3.09,
      "text": "Yes, I live on my own."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 239.61,
      "end_seconds": 241.48,
      "duration_seconds": 1.87,
      "text": "Okay, what's your job?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 242.38,
      "end_seconds": 245.63,
      "duration_seconds": 3.25,
      "text": "I teach at a primary school."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 247.77,
      "end_seconds": 251.05,
      "duration_seconds": 3.28,
      "text": "Let me examine, it won't take long."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 252.0,
      "end_seconds": 254.08,
      "duration_seconds": 2.08,
      "text": "Take your time, no rush."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 262.48,
      "end_seconds": 269.35,
      "duration_seconds": 6.87,
      "text": "Bending is limited to about a right angle, and it hurts at the end."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 272.09,
      "end_seconds": 287.06,
      "duration_seconds": 14.97,
      "text": "Right, that's all I need, thank you. From what you've told me and what I found, it points towards osteoarthritis of the knees. I want to be honest that this is an impression, not a final answer."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 287.8,
      "end_seconds": 290.27,
      "duration_seconds": 2.47,
      "text": "Do you think it's serious?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 292.31,
      "end_seconds": 301.81,
      "duration_seconds": 9.5,
      "text": "It's reasonable to be concerned, but right now osteoarthritis of the knees is my leading thought, not anything worse."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 315.29,
      "end_seconds": 350.11,
      "duration_seconds": 34.82,
      "text": "I'll request an X-ray of both knees, it'll help with knee pain. I want blood tests done, that's for joint pain. You'll be taking paracetamol, 650 milligrams, three times a day, for two weeks. You take it by mouth. That's for knee pain. Losing even a few kilos takes a lot of load off the knees, and I'd like you to do the strengthening exercises. I'd like you to see physiotherapy as well, and I'll write the referral."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 352.01,
      "end_seconds": 361.89,
      "duration_seconds": 9.88,
      "text": "And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 363.71,
      "end_seconds": 365.37,
      "duration_seconds": 1.66,
      "text": "Okay, I understand."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 366.72,
      "end_seconds": 379.68,
      "duration_seconds": 12.96,
      "text": "Please don't wait if the symptoms get worse. That's when to be seen urgently. See me again in four weeks. That's everything from me. Any other questions?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 380.91,
      "end_seconds": 385.37,
      "duration_seconds": 4.46,
      "text": "That's everything I wanted to ask. Thank you."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 386.89,
      "end_seconds": 388.07,
      "duration_seconds": 1.18,
      "text": "All the best."
    }
  ]
}