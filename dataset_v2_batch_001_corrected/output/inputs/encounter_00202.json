{
  "schema_version": "1.0",
  "encounter_id": "00202",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.0,
      "end_seconds": 5.3,
      "duration_seconds": 4.3,
      "text": "Oh, hi, doctor. Is this the right room?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.27,
      "end_seconds": 10.78,
      "duration_seconds": 4.51,
      "text": "You're fine, sit down. So, what brings you in?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 11.39,
      "end_seconds": 22.77,
      "duration_seconds": 11.38,
      "text": "it's a fit last month i thought I'd wait, but it hasn't gone i told myself I'd wait and see, and here I am"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 23.91,
      "end_seconds": 26.76,
      "duration_seconds": 2.85,
      "text": "Are you on any tablets or medication?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 28.58,
      "end_seconds": 34.39,
      "duration_seconds": 5.81,
      "text": "Right, I'm on sodium valproate, 500 milligrams, twice a day."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 41.41,
      "end_seconds": 47.01,
      "duration_seconds": 5.6,
      "text": "When did you first notice it? I'm asking so that we don't miss anything."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 47.73,
      "end_seconds": 50.05,
      "duration_seconds": 2.32,
      "text": "Probably about four days. Yeah."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 51.16,
      "end_seconds": 54.67,
      "duration_seconds": 3.51,
      "text": "Do you notice anything setting it it off?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 56.1,
      "end_seconds": 69.92,
      "duration_seconds": 13.82,
      "text": "So, it's worse with missing tablets. As for biting my tongue, I honestly can't say when that began. It might have been last month or the month before."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 70.61,
      "end_seconds": 77.45,
      "duration_seconds": 6.84,
      "text": "have you had a fit last month before, or is this the first time?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 79.11,
      "end_seconds": 88.98,
      "duration_seconds": 9.87,
      "text": "Yes, something like this happened a couple of years ago, and it went away on its own."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 89.5,
      "end_seconds": 91.66,
      "duration_seconds": 2.16,
      "text": "Any head injury or headache?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 92.46,
      "end_seconds": 95.23,
      "duration_seconds": 2.77,
      "text": "No, not any of them."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 96.66,
      "end_seconds": 102.21,
      "duration_seconds": 5.55,
      "text": "Did you get weakness on one side or loss of bladder control?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 103.5,
      "end_seconds": 106.85,
      "duration_seconds": 3.35,
      "text": "Oh, no, not any of them."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 107.88,
      "end_seconds": 110.72,
      "duration_seconds": 2.84,
      "text": "how are your joints, any aches elsewhere?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 111.7,
      "end_seconds": 114.83,
      "duration_seconds": 3.13,
      "text": "Hmm, no, joints are fine."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 116.09,
      "end_seconds": 118.64,
      "duration_seconds": 2.55,
      "text": "Your breathing, any trouble there?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 120.69,
      "end_seconds": 121.78,
      "duration_seconds": 1.09,
      "text": "Breathing's normal."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 138.8,
      "end_seconds": 141.54,
      "duration_seconds": 2.74,
      "text": "Have you got any chronic problems?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 143.2,
      "end_seconds": 145.14,
      "duration_seconds": 1.94,
      "text": "I've had epilepsy, yes"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 147.02,
      "end_seconds": 151.71,
      "duration_seconds": 4.69,
      "text": "Tell me about your routine, work, habits, that sort of thing."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 153.2,
      "end_seconds": 170.11,
      "duration_seconds": 16.91,
      "text": "I run a small shop, so I'm on my feet a lot. I eat out quite a lot, to be honest. It's just me and my wife at home now."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 171.86,
      "end_seconds": 175.66,
      "duration_seconds": 3.8,
      "text": "Have you had to have anything operated on?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 177.43,
      "end_seconds": 182.97,
      "duration_seconds": 5.54,
      "text": "So, I had a lump removed from my back years ago."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 183.65,
      "end_seconds": 188.46,
      "duration_seconds": 4.81,
      "text": "Have you ever reacted badly to a medicine or food? Any allergies?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 190.1,
      "end_seconds": 193.64,
      "duration_seconds": 3.54,
      "text": "I don't have any known medication allergies."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 195.63,
      "end_seconds": 199.19,
      "duration_seconds": 3.56,
      "text": "a a few measurements, then we'll continue"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 207.66,
      "end_seconds": 210.18,
      "duration_seconds": 2.52,
      "text": "Okay, give me a moment..."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 228.72,
      "end_seconds": 237.32,
      "duration_seconds": 8.6,
      "text": "Okay: heart rate 80, respiratory rate 18, BP is 113 over 73, temperature is 36.8 degrees."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 242.31,
      "end_seconds": 244.5,
      "duration_seconds": 2.19,
      "text": "Is that alright, doctor?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 245.55,
      "end_seconds": 248.97,
      "duration_seconds": 3.42,
      "text": "Alright, I'll explain what that means shortly."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 250.73,
      "end_seconds": 254.73,
      "duration_seconds": 4.0,
      "text": "Okay, if you're comfortable, I'll examine you now."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 255.92,
      "end_seconds": 258.1,
      "duration_seconds": 2.18,
      "text": "Let me just check something."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 270.38,
      "end_seconds": 273.4,
      "duration_seconds": 3.02,
      "text": "You're alert and orientated, speech is clear."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 274.96,
      "end_seconds": 276.26,
      "duration_seconds": 1.3,
      "text": "I'll go gently"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 289.99,
      "end_seconds": 293.48,
      "duration_seconds": 3.49,
      "text": "Reflexes and power are symmetrical on both sides."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 297.85,
      "end_seconds": 300.34,
      "duration_seconds": 2.49,
      "text": "All done, you can get dressed."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 317.81,
      "end_seconds": 323.14,
      "duration_seconds": 5.33,
      "text": "Putting it all together, this looks most like breakthrough seizure on known epilepsy."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 324.32,
      "end_seconds": 327.05,
      "duration_seconds": 2.73,
      "text": "Do you think it's serious?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 331.77,
      "end_seconds": 357.17,
      "duration_seconds": 25.4,
      "text": "it's reasonable to to be concerned, but right now breakthrough seizure on known epilepsy is my leading thought, not anything worse we should do an MRI of the brain for seizure we should do an EEG for seizure i want a blood level of the tablet done, that's for adherence check"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 358.49,
      "end_seconds": 359.97,
      "duration_seconds": 1.48,
      "text": "Okay, that's fine."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 361.45,
      "end_seconds": 385.51,
      "duration_seconds": 24.06,
      "text": "No driving until we've reviewed you again, I'm sorry, but that's the rule. Never skip the tablets, and set a phone alarm if it helps. If you have another seizure lasting more than five minutes, or you feel really unwell, please come to the emergency department. I'd like you back in four weeks. Thanks for coming in."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 386.13,
      "end_seconds": 389.52,
      "duration_seconds": 3.39,
      "text": "I appreciate it, um, doctor"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 390.12,
      "end_seconds": 391.84,
      "duration_seconds": 1.72,
      "text": "mind how you go"
    }
  ]
}