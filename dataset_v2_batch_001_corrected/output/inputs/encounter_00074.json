  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.53,
      "end_seconds": 3.69,
      "duration_seconds": 3.16,
      "text": "Good afternoon. Have a seat and we'll begin."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 5.12,
      "end_seconds": 8.08,
      "duration_seconds": 2.96,
      "text": "Hello, doctor. Thanks for seeing me."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 13.11,
      "end_seconds": 14.95,
      "duration_seconds": 1.84,
      "text": "Weather's turned, hasn't it?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 16.27,
      "end_seconds": 21.37,
      "duration_seconds": 5.1,
      "text": "Yeah, it has. I got caught in the rain walking over."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 22.81,
      "end_seconds": 26.78,
      "duration_seconds": 3.97,
      "text": "What was the main thing you wanted to talk about?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 28.66,
      "end_seconds": 35.58,
      "duration_seconds": 6.92,
      "text": "Mainly yellow eyes. There's a couple of other things, but that's the main one."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 36.17,
      "end_seconds": 38.6,
      "duration_seconds": 2.43,
      "text": "Are you on any regular medication?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 39.24,
      "end_seconds": 41.01,
      "duration_seconds": 1.77,
      "text": "No, nothing regular."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 52.92,
      "end_seconds": 56.59,
      "duration_seconds": 3.67,
      "text": "Is this recent, or has it been a while?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 57.59,
      "end_seconds": 60.94,
      "duration_seconds": 3.35,
      "text": "It's been ten days, I'm fairly sure."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 74.06,
      "end_seconds": 75.35,
      "duration_seconds": 1.29,
      "text": "Nothing like fever?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 80.88,
      "end_seconds": 82.4,
      "duration_seconds": 1.52,
      "text": "Nope, no fever."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 83.21,
      "end_seconds": 89.75,
      "duration_seconds": 6.54,
      "text": "Let me check a few things. Any vomiting blood, confusion or weight loss?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 93.41,
      "end_seconds": 98.94,
      "duration_seconds": 5.53,
      "text": "I haven't had vomiting blood, confusion or weight loss, no."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 100.64,
      "end_seconds": 103.15,
      "duration_seconds": 2.51,
      "text": "Is your urine normal, no changes?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 104.46,
      "end_seconds": 106.67,
      "duration_seconds": 2.21,
      "text": "No, that's all fine."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 108.45,
      "end_seconds": 112.1,
      "duration_seconds": 3.65,
      "text": "Anything with your nerves, like weakness or numbness?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 113.2,
      "end_seconds": 115.22,
      "duration_seconds": 2.02,
      "text": "No weakness or anything."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 133.69,
      "end_seconds": 135.67,
      "duration_seconds": 1.98,
      "text": "Any drug or food allergies?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 136.32,
      "end_seconds": 143.74,
      "duration_seconds": 7.42,
      "text": "Years back I got a rash from ibuprofen, so I stay away from it now."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 145.41,
      "end_seconds": 148.69,
      "duration_seconds": 3.28,
      "text": "Any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 150.53,
      "end_seconds": 153.39,
      "duration_seconds": 2.86,
      "text": "No, none that I know of."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 155.46,
      "end_seconds": 160.09,
      "duration_seconds": 4.63,
      "text": "Let's talk a little about your daily life and habits."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 164.91,
      "end_seconds": 179.77,
      "duration_seconds": 14.86,
      "text": "I have a couple of drinks on the weekend. I stopped smoking about two years back. I'm a self-employed electrician. Barely, I'm mostly sedentary these days."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 181.26,
      "end_seconds": 183.88,
      "duration_seconds": 2.62,
      "text": "I'll take a few measurements first."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 194.58,
      "end_seconds": 196.78,
      "duration_seconds": 2.2,
      "text": "So, just relax your arm..."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 215.2,
      "end_seconds": 227.93,
      "duration_seconds": 12.73,
      "text": "Okay: temperature 36.6, weight 88 kilos, pressure 121 over 80, oxygen saturation is 97 percent, height 155 centimetres, pulse is 68 beats a minute."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 229.68,
      "end_seconds": 231.3,
      "duration_seconds": 1.62,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 233.24,
      "end_seconds": 235.95,
      "duration_seconds": 2.71,
      "text": "That's fine, we'll come to it."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 237.48,
      "end_seconds": 241.39,
      "duration_seconds": 3.91,
      "text": "Right, let me check a few things physically."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 252.93,
      "end_seconds": 253.63,
      "duration_seconds": 0.7,
      "text": "Sure."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 255.31,
      "end_seconds": 257.53,
      "duration_seconds": 2.22,
      "text": "Bear with me a second."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 267.41,
      "end_seconds": 270.34,
      "duration_seconds": 2.93,
      "text": "The whites of your eyes are yellow."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 272.16,
      "end_seconds": 273.91,
      "duration_seconds": 1.75,
      "text": "Let me press here."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 285.9,
      "end_seconds": 289.46,
      "duration_seconds": 3.56,
      "text": "Liver edge is just palpable and mildly tender."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 293.67,
      "end_seconds": 309.39,
      "duration_seconds": 15.72,
      "text": "Okay, finished. So, based on the history and the examination, this looks most like jaundice with a cause we still need to find. I want an ultrasound of the abdomen done, that's for jaundice."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 315.74,
      "end_seconds": 320.76,
      "duration_seconds": 5.02,
      "text": "We have a slot Wednesday at 10 am, if that works."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 322.45,
      "end_seconds": 331.73,
      "duration_seconds": 9.28,
      "text": "Please avoid alcohol completely and don't take any painkillers except paracetamol, and not much of that. That's it on my side. Anything unclear?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 333.42,
      "end_seconds": 336.66,
      "duration_seconds": 3.24,
      "text": "So, alright, thanks. Bye for now."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 338.5,
      "end_seconds": 340.4,
      "duration_seconds": 1.9,
      "text": "Mind how you go."
    }
  ]
}