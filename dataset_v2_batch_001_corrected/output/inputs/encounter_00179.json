{
  "schema_version": "1.0",
  "encounter_id": "00179",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.91,
      "end_seconds": 4.53,
      "duration_seconds": 3.62,
      "text": "Alright, good morning. Come in, have a seat."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 5.64,
      "end_seconds": 6.34,
      "duration_seconds": 0.7,
      "text": "Hi."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 8.01,
      "end_seconds": 12.42,
      "duration_seconds": 4.41,
      "text": "What was the main thing you wanted to talk about?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 13.84,
      "end_seconds": 17.91,
      "duration_seconds": 4.07,
      "text": "So the thing is, I've got bruising."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 19.97,
      "end_seconds": 22.57,
      "duration_seconds": 2.6,
      "text": "What medicines do you take regularly?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 23.84,
      "end_seconds": 28.64,
      "duration_seconds": 4.8,
      "text": "It's alendronate, 70 milligrams, once a week for my bones."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 30.36,
      "end_seconds": 33.01,
      "duration_seconds": 2.65,
      "text": "How long have you had it?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 34.0,
      "end_seconds": 41.99,
      "duration_seconds": 7.99,
      "text": "It's been five days, I'm fairly sure. I've also had tingling in the fingers."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 42.75,
      "end_seconds": 46.72,
      "duration_seconds": 3.97,
      "text": "Does it happen all the time or in spells?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 47.88,
      "end_seconds": 52.07,
      "duration_seconds": 4.19,
      "text": "I'd say a couple of times a week."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 53.06,
      "end_seconds": 55.39,
      "duration_seconds": 2.33,
      "text": "And how severe is it?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 61.3,
      "end_seconds": 74.12,
      "duration_seconds": 12.82,
      "text": "I mean, it feels mild to me. And there's pain in my left wrist after a fall as well, about a week now."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 76.0,
      "end_seconds": 84.94,
      "duration_seconds": 8.94,
      "text": "Can you describe it a bit more for me? How strong it is, what the pattern is, what helps."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 88.36,
      "end_seconds": 92.98,
      "duration_seconds": 4.62,
      "text": "I'd call it mild. I'd say on and off."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 100.82,
      "end_seconds": 108.69,
      "duration_seconds": 7.87,
      "text": "Any bump to the head, loss of consciousness, deformity or pain in the elbow at all?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 110.05,
      "end_seconds": 118.69,
      "duration_seconds": 8.64,
      "text": "I haven't had bump to the head, loss of consciousness, deformity or pain in the elbow, no."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 119.87,
      "end_seconds": 123.13,
      "duration_seconds": 3.26,
      "text": "Has your heart given you any trouble?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 123.66,
      "end_seconds": 125.7,
      "duration_seconds": 2.04,
      "text": "No, that's been fine."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 126.98,
      "end_seconds": 129.39,
      "duration_seconds": 2.41,
      "text": "Anything different when you pass water?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 134.69,
      "end_seconds": 136.48,
      "duration_seconds": 1.79,
      "text": "Nothing there, no."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 146.14,
      "end_seconds": 148.73,
      "duration_seconds": 2.59,
      "text": "Have you got any chronic problems?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 150.59,
      "end_seconds": 152.5,
      "duration_seconds": 1.91,
      "text": "I've got thin bones."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 156.32,
      "end_seconds": 168.52,
      "duration_seconds": 12.2,
      "text": "Mm. Right, so thin bones is already on your record. We'll keep that in mind today. Let's talk a little about your daily life and habits."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 173.29,
      "end_seconds": 188.3,
      "duration_seconds": 15.01,
      "text": "I run a small shop, so I'm on my feet a lot. Not really, I don't get much exercise. It's just me and my wife at home now."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 189.92,
      "end_seconds": 192.55,
      "duration_seconds": 2.63,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 194.2,
      "end_seconds": 196.56,
      "duration_seconds": 2.36,
      "text": "No, never had any surgery."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 210.43,
      "end_seconds": 215.41,
      "duration_seconds": 4.98,
      "text": "Do you have any allergies to medicines, food, anything at all?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 216.0,
      "end_seconds": 224.41,
      "duration_seconds": 8.41,
      "text": "Yeah, I was told I'm allergic to peanuts, but I don't remember what reaction I had."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 225.12,
      "end_seconds": 229.05,
      "duration_seconds": 3.93,
      "text": "Any relatives with health problems I should be aware of?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 230.61,
      "end_seconds": 233.29,
      "duration_seconds": 2.68,
      "text": "My father had a stroke."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 234.04,
      "end_seconds": 236.41,
      "duration_seconds": 2.37,
      "text": "I'll take a few measurements first."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 247.09,
      "end_seconds": 249.01,
      "duration_seconds": 1.92,
      "text": "Hold still for me..."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 258.18,
      "end_seconds": 267.85,
      "duration_seconds": 9.67,
      "text": "Okay: respiratory rate 18, SpO2 97 percent on room air, pressure 127 over 69, heart rate 77, temp 36.7 degrees."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 268.84,
      "end_seconds": 271.53,
      "duration_seconds": 2.69,
      "text": "So, is that alright, doctor?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 272.55,
      "end_seconds": 275.7,
      "duration_seconds": 3.15,
      "text": "I'll interpret it once I've examined you."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 278.28,
      "end_seconds": 281.52,
      "duration_seconds": 3.24,
      "text": "If you're comfortable, I'll examine you now."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 282.75,
      "end_seconds": 283.45,
      "duration_seconds": 0.7,
      "text": "Okay."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 284.86,
      "end_seconds": 287.6,
      "duration_seconds": 2.74,
      "text": "Let me look at this properly."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 304.72,
      "end_seconds": 311.56,
      "duration_seconds": 6.84,
      "text": "There's swelling and tenderness at the base of the thumb side of the wrist."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 316.8,
      "end_seconds": 350.2,
      "duration_seconds": 33.4,
      "text": "Thanks for that. I think an X-ray of the wrist makes sense here, for wrist injury. I'll start you on paracetamol, 650 milligrams, three times a day, for five days. That should help with wrist pain. I'd like you to wear a splint until the X-ray result is confirmed and keep the hand raised. Try to get to bed and wake up at the same time each day, and keep your phone away from the bed."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 350.91,
      "end_seconds": 356.36,
      "duration_seconds": 5.45,
      "text": "Book a review in a week. Alright, I'll see you out."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 356.87,
      "end_seconds": 359.06,
      "duration_seconds": 2.19,
      "text": "I appreciate it, doctor."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 359.96,
      "end_seconds": 360.91,
      "duration_seconds": 0.95,
      "text": "Right, goodbye."
    }
  ]
}