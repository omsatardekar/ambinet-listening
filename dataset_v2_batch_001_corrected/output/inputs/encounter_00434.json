{
  "schema_version": "1.0",
  "encounter_id": "00434",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 0.68,
      "end_seconds": 4.85,
      "duration_seconds": 4.17,
      "text": "Doctor, we're ready in room two, I've already taken the observations."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.23,
      "end_seconds": 10.46,
      "duration_seconds": 4.23,
      "text": "Thank you. Good morning, tell me what's been going on."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 12.53,
      "end_seconds": 19.45,
      "duration_seconds": 6.92,
      "text": "Oh, you know, good morning, doctor. I came along to help out."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 21.04,
      "end_seconds": 25.58,
      "duration_seconds": 4.54,
      "text": "It's, It's tiredness all the time, mostly."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 26.13,
      "end_seconds": 31.85,
      "duration_seconds": 5.72,
      "text": "how far back does it go? Just so I get the full picture"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 36.76,
      "end_seconds": 41.37,
      "duration_seconds": 4.61,
      "text": "Well, I've had it it for about three months."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 42.97,
      "end_seconds": 45.32,
      "duration_seconds": 2.35,
      "text": "Does anything make it better?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 46.28,
      "end_seconds": 53.32,
      "duration_seconds": 7.04,
      "text": "Okay, you know, so I get some relief from a good night's sleep."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 54.27,
      "end_seconds": 60.6,
      "duration_seconds": 6.33,
      "text": "I was just going to say that the main thing is—"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 60.7,
      "end_seconds": 67.67,
      "duration_seconds": 6.97,
      "text": "Sorry to cut in, doctor, quick question: shall I bring the trolley in now or later?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 69.41,
      "end_seconds": 72.1,
      "duration_seconds": 2.69,
      "text": "Okay, later, thanks. Please go on."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 76.61,
      "end_seconds": 80.63,
      "duration_seconds": 4.02,
      "text": "Oh, and a bit of weight gain."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 98.23,
      "end_seconds": 104.53,
      "duration_seconds": 6.3,
      "text": "let me check a few things. Any blood in the stool or night sweats?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 106.35,
      "end_seconds": 120.31,
      "duration_seconds": 13.96,
      "text": "No, no blood in the stool, no night sweats. I did have hair falling out at one point, but that went away on its own."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 120.56,
      "end_seconds": 125.72,
      "duration_seconds": 5.16,
      "text": "Go on. Any fever, shortness of breath or low mood at all?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 126.71,
      "end_seconds": 132.54,
      "duration_seconds": 5.83,
      "text": "No, uh, no fever, shortness of breath or low mood."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 133.54,
      "end_seconds": 138.45,
      "duration_seconds": 4.91,
      "text": "Have you noticed any weakness, or anything odd with your balance?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 139.25,
      "end_seconds": 140.75,
      "duration_seconds": 1.5,
      "text": "Nothing odd there."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 141.99,
      "end_seconds": 145.31,
      "duration_seconds": 3.32,
      "text": "Any problems with your joints or muscles?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 146.23,
      "end_seconds": 147.95,
      "duration_seconds": 1.72,
      "text": "No, nothing there."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 149.3,
      "end_seconds": 152.29,
      "duration_seconds": 2.99,
      "text": "Okay, any diagnoses you've been given before?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 152.95,
      "end_seconds": 154.3,
      "duration_seconds": 1.35,
      "text": "Yes, diabetes."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 159.73,
      "end_seconds": 161.56,
      "duration_seconds": 1.83,
      "text": "do you drink alcohol?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 164.01,
      "end_seconds": 166.94,
      "duration_seconds": 2.93,
      "text": "I don't drink at all."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 168.14,
      "end_seconds": 171.06,
      "duration_seconds": 2.92,
      "text": "What kind of work do you do?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 172.31,
      "end_seconds": 176.76,
      "duration_seconds": 4.45,
      "text": "I work on a farm, it's quite physical."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 177.3,
      "end_seconds": 182.18,
      "duration_seconds": 4.88,
      "text": "What about family history, any illnesses that run in the family?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 183.01,
      "end_seconds": 186.74,
      "duration_seconds": 3.73,
      "text": "Uh, my uncle had colon cancer."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 200.08,
      "end_seconds": 202.35,
      "duration_seconds": 2.27,
      "text": "Any surgery in your history?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 203.07,
      "end_seconds": 208.07,
      "duration_seconds": 5.0,
      "text": "I had my appendix out about eight years ago."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 212.81,
      "end_seconds": 215.41,
      "duration_seconds": 2.6,
      "text": "Before I prescribe anything, any allergies?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 217.03,
      "end_seconds": 221.87,
      "duration_seconds": 4.84,
      "text": "No allergies that that I know of, no."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 223.06,
      "end_seconds": 230.09,
      "duration_seconds": 7.03,
      "text": "I'm not sure that's right. I seem to recall a problem with codeine."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 233.68,
      "end_seconds": 236.65,
      "duration_seconds": 2.97,
      "text": "Really? I don't think so."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 238.42,
      "end_seconds": 242.8,
      "duration_seconds": 4.38,
      "text": "fair enough, I'll write down both versions any regular medication?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 244.51,
      "end_seconds": 245.62,
      "duration_seconds": 1.11,
      "text": "nothing, no"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 247.48,
      "end_seconds": 255.78,
      "duration_seconds": 8.3,
      "text": "here are the numbers, doctor. BP is 113 over 72, heart rate 84, oxygen saturation is 97 percent"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 257.1,
      "end_seconds": 258.0,
      "duration_seconds": 0.9,
      "text": "Okay, noted."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 259.67,
      "end_seconds": 262.02,
      "duration_seconds": 2.35,
      "text": "Okay, a quick examination now."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 263.84,
      "end_seconds": 266.29,
      "duration_seconds": 2.45,
      "text": "just relax, I'll be quick"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 278.64,
      "end_seconds": 282.54,
      "duration_seconds": 3.9,
      "text": "You look a little pale in the the eyelids."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 284.15,
      "end_seconds": 285.14,
      "duration_seconds": 0.99,
      "text": "no problem"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 286.48,
      "end_seconds": 288.92,
      "duration_seconds": 2.44,
      "text": "Bear with me a second."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 299.16,
      "end_seconds": 304.4,
      "duration_seconds": 5.24,
      "text": "your thyroid isn't enlarged, I can't feel any lumps in your neck"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 308.59,
      "end_seconds": 325.17,
      "duration_seconds": 16.58,
      "text": "Right, you can sit back down. So where does that leave us? It fits best with fatigue with no clear cause yet. We shouldn't forget an underactive thyroid. Anaemia is also on my list."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 327.24,
      "end_seconds": 330.63,
      "duration_seconds": 3.39,
      "text": "Is this going to go away?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 332.34,
      "end_seconds": 344.87,
      "duration_seconds": 12.53,
      "text": "Nothing I've seen today points to an emergency. It looks like fatigue with no clear cause yet, but I'd like to confirm. Have you had any tests for this so far?"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 346.31,
      "end_seconds": 358.26,
      "duration_seconds": 11.95,
      "text": "I had a ferritin level done at another clinic a few months ago. I don't have the report with me."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 359.11,
      "end_seconds": 362.53,
      "duration_seconds": 3.42,
      "text": "I'm going to order blood tests, for fatigue."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 363.07,
      "end_seconds": 365.53,
      "duration_seconds": 2.46,
      "text": "Mm, you know, okay."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 367.32,
      "end_seconds": 401.16,
      "duration_seconds": 33.84,
      "text": "I'm sending you for a thyroid test because of fatigue. Let's use vitamin D, 60000 units, once a week, for eight weeks. That's for low energy. Try to keep a regular sleep time and get some daylight in the morning. If the symptoms get worse, or you feel really unwell, please come to the emergency department. Come back in two weeks. That's everything from me. Any other questions?"
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 403.25,
      "end_seconds": 407.43,
      "duration_seconds": 4.18,
      "text": "hmm, uh, no questions thank you"
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 408.21,
      "end_seconds": 409.92,
      "duration_seconds": 1.71,
      "text": "Mind how you go."
    }
  ]
}