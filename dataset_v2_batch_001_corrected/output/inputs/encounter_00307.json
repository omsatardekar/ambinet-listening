{
  "schema_version": "1.0",
  "encounter_id": "00307",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.99,
      "end_seconds": 3.97,
      "duration_seconds": 2.98,
      "text": "good afternoon. Take a seat, please"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 5.55,
      "end_seconds": 6.25,
      "duration_seconds": 0.7,
      "text": "morning"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 7.38,
      "end_seconds": 10.07,
      "duration_seconds": 2.69,
      "text": "How can I help you today?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 11.08,
      "end_seconds": 16.55,
      "duration_seconds": 5.47,
      "text": "Doctor, it's a missed period. It's getting on my nerves now."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 17.05,
      "end_seconds": 19.8,
      "duration_seconds": 2.75,
      "text": "How long are we talking about?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 21.31,
      "end_seconds": 23.38,
      "duration_seconds": 2.07,
      "text": "Probably ten days. Yeah."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 24.55,
      "end_seconds": 26.73,
      "duration_seconds": 2.18,
      "text": "how intense does it get?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 27.24,
      "end_seconds": 40.48,
      "duration_seconds": 13.24,
      "text": "Moderate, really. As for needing to pass urine more, I honestly can't say when that began. It might have been last month or the month before."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 42.36,
      "end_seconds": 45.16,
      "duration_seconds": 2.8,
      "text": "any nausea in the mornings as well?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 46.54,
      "end_seconds": 48.29,
      "duration_seconds": 1.75,
      "text": "yes, I have"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 53.7,
      "end_seconds": 55.01,
      "duration_seconds": 1.31,
      "text": "anything that helps?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 55.97,
      "end_seconds": 59.52,
      "duration_seconds": 3.55,
      "text": "It settles a little with dry biscuits."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 60.75,
      "end_seconds": 64.71,
      "duration_seconds": 3.96,
      "text": "on a a normal day, how strong is it?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 66.22,
      "end_seconds": 71.72,
      "duration_seconds": 5.5,
      "text": "Maybe a five out of ten on a bad day."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 77.01,
      "end_seconds": 79.17,
      "duration_seconds": 2.16,
      "text": "have you been feeling tired?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 80.29,
      "end_seconds": 81.46,
      "duration_seconds": 1.17,
      "text": "Yes, actually."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 96.68,
      "end_seconds": 110.12,
      "duration_seconds": 13.44,
      "text": "Here are the numbers, doctor. Heart rate 77, height 177 centimetres, blood pressure 115 over 70, weight 69 kilos, BMI works out to 22.0, respiratory rate 18, SpO2 97 percent on room air."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 111.43,
      "end_seconds": 112.4,
      "duration_seconds": 0.97,
      "text": "okay, noted"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 114.47,
      "end_seconds": 117.03,
      "duration_seconds": 2.56,
      "text": "Okay, a a quick examination now."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 126.18,
      "end_seconds": 127.24,
      "duration_seconds": 1.06,
      "text": "that's fine"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 128.26,
      "end_seconds": 130.52,
      "duration_seconds": 2.26,
      "text": "just relax I'll be quick"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 144.06,
      "end_seconds": 149.81,
      "duration_seconds": 5.75,
      "text": "tummy is soft, non-tender, and the uterus isn't palpable above the pelvic bone yet"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 153.14,
      "end_seconds": 160.78,
      "duration_seconds": 7.64,
      "text": "All done, you can get dressed. And what about burning when passing urine, severe abdominal pain or dizziness?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 162.76,
      "end_seconds": 170.04,
      "duration_seconds": 7.28,
      "text": "no burning when passing urine, severe abdominal pain or dizziness, none of it"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 171.67,
      "end_seconds": 175.13,
      "duration_seconds": 3.46,
      "text": "a few quick ones: vomiting everything or fever?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 176.16,
      "end_seconds": 179.45,
      "duration_seconds": 3.29,
      "text": "none, as far as I know"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 180.07,
      "end_seconds": 183.54,
      "duration_seconds": 3.47,
      "text": "How about your heart, any problems like that?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 184.42,
      "end_seconds": 188.73,
      "duration_seconds": 4.31,
      "text": "My heart's been fine, as far as I know."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 190.09,
      "end_seconds": 194.36,
      "duration_seconds": 4.27,
      "text": "do you have any allergies to medicines food anything at all?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 199.49,
      "end_seconds": 203.42,
      "duration_seconds": 3.93,
      "text": "no allergies that I know of, no"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 204.29,
      "end_seconds": 205.55,
      "duration_seconds": 1.26,
      "text": "What about alcohol?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 206.52,
      "end_seconds": 210.61,
      "duration_seconds": 4.09,
      "text": "I gave up drinking about three years ago"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 212.18,
      "end_seconds": 213.47,
      "duration_seconds": 1.29,
      "text": "do you smoke?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 215.48,
      "end_seconds": 217.09,
      "duration_seconds": 1.61,
      "text": "I've never smoked"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 218.93,
      "end_seconds": 221.16,
      "duration_seconds": 2.23,
      "text": "Anything special about your diet?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 223.04,
      "end_seconds": 226.92,
      "duration_seconds": 3.88,
      "text": "I try to avoid too much sugar"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 227.8,
      "end_seconds": 230.02,
      "duration_seconds": 2.22,
      "text": "do you have a job?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 231.8,
      "end_seconds": 234.0,
      "duration_seconds": 2.2,
      "text": "I'm a self-employed electrician."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 239.41,
      "end_seconds": 242.28,
      "duration_seconds": 2.87,
      "text": "what about operations, anything like that?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 243.08,
      "end_seconds": 248.97,
      "duration_seconds": 5.89,
      "text": "well I had my thyroid operated on a long time ago"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 250.02,
      "end_seconds": 255.49,
      "duration_seconds": 5.47,
      "text": "what medicines do you take regularly? Take your time, there's no rush"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 256.08,
      "end_seconds": 258.91,
      "duration_seconds": 2.83,
      "text": "Thyronorm, 50 micrograms, every morning"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 259.61,
      "end_seconds": 264.79,
      "duration_seconds": 5.18,
      "text": "Doctor, our chart from the last visit lists it as 100 micrograms."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 266.54,
      "end_seconds": 270.83,
      "duration_seconds": 4.29,
      "text": "hm that's different is the latest prescription anywhere near you?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 271.62,
      "end_seconds": 279.85,
      "duration_seconds": 8.23,
      "text": "Not with me. I'll bring it next time. Sumatriptan, 50 milligrams, maybe, when needed for my migraines."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 281.8,
      "end_seconds": 285.85,
      "duration_seconds": 4.05,
      "text": "Have you got the box or the prescription on you?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 286.91,
      "end_seconds": 295.03,
      "duration_seconds": 8.12,
      "text": "not with me. I'll bring it next time. It's apixaban, 5 milligrams, twice a day"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 295.44,
      "end_seconds": 299.49,
      "duration_seconds": 4.05,
      "text": "I see any long-term health problems I should know about?"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 300.47,
      "end_seconds": 303.03,
      "duration_seconds": 2.56,
      "text": "I have an underactive thyroid"
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 304.59,
      "end_seconds": 305.37,
      "duration_seconds": 0.78,
      "text": "I see."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 307.26,
      "end_seconds": 308.39,
      "duration_seconds": 1.13,
      "text": "yes migraines"
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 310.31,
      "end_seconds": 311.01,
      "duration_seconds": 0.7,
      "text": "Okay."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 312.39,
      "end_seconds": 314.18,
      "duration_seconds": 1.79,
      "text": "Yes an irregular heartbeat."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 316.68,
      "end_seconds": 327.71,
      "duration_seconds": 11.03,
      "text": "mm-hm right, yes, an underactive thyroid is known to us, good to have that clear is there a family history of anything significant?"
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 329.36,
      "end_seconds": 332.32,
      "duration_seconds": 2.96,
      "text": "my father had a heart attack"
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 333.86,
      "end_seconds": 352.45,
      "duration_seconds": 18.59,
      "text": "Okay so my impression is this: This looks most like an early pregnancy. Another possibility is a late period for another reason. So to recap quickly. You've had a missed period for ten days moderate and no fever or severe abdominal pain."
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 353.43,
      "end_seconds": 355.03,
      "duration_seconds": 1.6,
      "text": "That's it, yes."
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 369.51,
      "end_seconds": 373.3,
      "duration_seconds": 3.79,
      "text": "I've already done a pregnancy test, it's ready for you"
    },
    {
      "segment_id": "SEG0059",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 374.77,
      "end_seconds": 378.84,
      "duration_seconds": 4.07,
      "text": "Okay, noted. We should do blood tests for antenatal screening."
    },
    {
      "segment_id": "SEG0060",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 384.77,
      "end_seconds": 388.06,
      "duration_seconds": 3.29,
      "text": "Where do I go for that?"
    },
    {
      "segment_id": "SEG0061",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 389.03,
      "end_seconds": 420.91,
      "duration_seconds": 31.88,
      "text": "Let's get an early scan, for early pregnancy. The treatment will be folic acid, 5 milligrams, once a day, until twelve weeks. It's for pregnancy. The pharmacy will go through the details again when you pick it up. Small, frequent meals and dry crackers before getting out of bed can calm the morning nausea. If you smoke, this is a good moment to think about stopping, and we can help you with that."
    },
    {
      "segment_id": "SEG0062",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 422.39,
      "end_seconds": 430.57,
      "duration_seconds": 8.18,
      "text": "and please bring the latest prescription or the medicine boxes to the next visit so we can settle the dose"
    },
    {
      "segment_id": "SEG0063",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 431.17,
      "end_seconds": 434.56,
      "duration_seconds": 3.39,
      "text": "alright, I know what to look for"
    },
    {
      "segment_id": "SEG0064",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 435.26,
      "end_seconds": 438.17,
      "duration_seconds": 2.91,
      "text": "see me again in four weeks"
    },
    {
      "segment_id": "SEG0065",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 438.97,
      "end_seconds": 441.3,
      "duration_seconds": 2.33,
      "text": "okay, see you then"
    },
    {
      "segment_id": "SEG0066",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 442.89,
      "end_seconds": 445.72,
      "duration_seconds": 2.83,
      "text": "ask me anything before you go"
    },
    {
      "segment_id": "SEG0067",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 447.58,
      "end_seconds": 448.98,
      "duration_seconds": 1.4,
      "text": "right thanks again"
    }
  ]
}