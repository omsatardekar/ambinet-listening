{
  "schema_version": "1.0",
  "encounter_id": "00142",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.15,
      "end_seconds": 4.16,
      "duration_seconds": 3.01,
      "text": "Good evening. Sorry to keep you waiting."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 5.08,
      "end_seconds": 8.68,
      "duration_seconds": 3.6,
      "text": "Hello. Is it okay if I sit here?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 9.24,
      "end_seconds": 11.34,
      "duration_seconds": 2.1,
      "text": "Okay. Start wherever you like."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 11.98,
      "end_seconds": 18.47,
      "duration_seconds": 6.49,
      "text": "mainly blurry vision there's a couple of other things, but that's the main one"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 20.07,
      "end_seconds": 23.72,
      "duration_seconds": 3.65,
      "text": "Before we go on, a a few quick readings."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 32.97,
      "end_seconds": 34.74,
      "duration_seconds": 1.77,
      "text": "Hold still for me..."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 50.5,
      "end_seconds": 56.77,
      "duration_seconds": 6.27,
      "text": "okay: pulse is 64 beats a minute, temperature 36.4, pressure 112 over 75."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 71.18,
      "end_seconds": 72.87,
      "duration_seconds": 1.69,
      "text": "When did it begin?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 74.55,
      "end_seconds": 77.71,
      "duration_seconds": 3.16,
      "text": "for about a month, I'd say"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 78.16,
      "end_seconds": 80.27,
      "duration_seconds": 2.11,
      "text": "ah. Anything that that helps?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 83.66,
      "end_seconds": 86.75,
      "duration_seconds": 3.09,
      "text": "It settles a little with squinting."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 88.4,
      "end_seconds": 90.94,
      "duration_seconds": 2.54,
      "text": "what makes it worse, if anything?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 91.71,
      "end_seconds": 93.89,
      "duration_seconds": 2.18,
      "text": "It's worse with reading."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 95.3,
      "end_seconds": 99.99,
      "duration_seconds": 4.69,
      "text": "Have you had any redness, flashes of light or eye pain?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 101.77,
      "end_seconds": 107.25,
      "duration_seconds": 5.48,
      "text": "I haven't had redness, flashes of light or eye pain, no."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 108.19,
      "end_seconds": 111.66,
      "duration_seconds": 3.47,
      "text": "Anything with your nerves, like weakness or numbness?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 113.18,
      "end_seconds": 115.22,
      "duration_seconds": 2.04,
      "text": "No, nothing like that."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 129.71,
      "end_seconds": 132.1,
      "duration_seconds": 2.39,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 132.62,
      "end_seconds": 135.41,
      "duration_seconds": 2.79,
      "text": "No, never had any surgery."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 137.38,
      "end_seconds": 142.37,
      "duration_seconds": 4.99,
      "text": "What about your general health, any conditions you're being treated for?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 144.37,
      "end_seconds": 152.81,
      "duration_seconds": 8.44,
      "text": "I've had diabetes, yes. I wasn't sure whether to come in at all, to be honest."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 154.39,
      "end_seconds": 157.65,
      "duration_seconds": 3.26,
      "text": "I follow. What medicines do you take regularly?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 159.0,
      "end_seconds": 163.47,
      "duration_seconds": 4.47,
      "text": "Glycomet, 500 milligrams, twice a day for my sugar."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 165.46,
      "end_seconds": 167.2,
      "duration_seconds": 1.74,
      "text": "Do you drink alcohol?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 167.96,
      "end_seconds": 173.0,
      "duration_seconds": 5.04,
      "text": "A beer or two most evenings, to be honest."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 173.55,
      "end_seconds": 174.78,
      "duration_seconds": 1.23,
      "text": "Do you smoke?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 175.35,
      "end_seconds": 179.39,
      "duration_seconds": 4.04,
      "text": "No, I don't smoke and never have."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 180.65,
      "end_seconds": 182.92,
      "duration_seconds": 2.27,
      "text": "do you get any exercise?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 184.09,
      "end_seconds": 189.19,
      "duration_seconds": 5.1,
      "text": "I walk for about half an hour most days."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 190.38,
      "end_seconds": 192.49,
      "duration_seconds": 2.11,
      "text": "Right, are you still working?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 193.28,
      "end_seconds": 198.03,
      "duration_seconds": 4.75,
      "text": "I'm retired now, I was a clerk for years"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 201.73,
      "end_seconds": 204.32,
      "duration_seconds": 2.59,
      "text": "before I prescribe anything, any allergies?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 205.48,
      "end_seconds": 208.68,
      "duration_seconds": 3.2,
      "text": "Yeah, not that I know, no."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 210.82,
      "end_seconds": 213.27,
      "duration_seconds": 2.45,
      "text": "I'd like to examine you now"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 214.33,
      "end_seconds": 217.15,
      "duration_seconds": 2.82,
      "text": "stay still while I have a look"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 233.13,
      "end_seconds": 237.45,
      "duration_seconds": 4.32,
      "text": "the lens looks a little cloudy on both sides"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 238.92,
      "end_seconds": 240.6,
      "duration_seconds": 1.68,
      "text": "Let me press here."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 252.78,
      "end_seconds": 257.35,
      "duration_seconds": 4.57,
      "text": "Vision without glasses is six over twelve in both eyes."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 257.88,
      "end_seconds": 259.0,
      "duration_seconds": 1.12,
      "text": "Okay, ready."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 262.44,
      "end_seconds": 265.44,
      "duration_seconds": 3.0,
      "text": "all done, you can get dressed"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 273.42,
      "end_seconds": 280.18,
      "duration_seconds": 6.76,
      "text": "So where does that leave us? It points towards a refractive problem or early cataracts."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 296.16,
      "end_seconds": 314.31,
      "duration_seconds": 18.15,
      "text": "I'd like to arrange a dilated eye examination for blurred vision. Get a proper glasses test, and keep your sugar and blood pressure well controlled for your eyes. Let's plan a check in four weeks. Look after yourself."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 318.29,
      "end_seconds": 323.25,
      "duration_seconds": 4.96,
      "text": "one thing: no, you know, actually that's all thanks"
    }
  ]
}