{
  "schema_version": "1.0",
  "encounter_id": "00359",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.74,
      "end_seconds": 4.5,
      "duration_seconds": 3.76,
      "text": "Hi, doctor. Is this the right room?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.13,
      "end_seconds": 10.58,
      "duration_seconds": 5.45,
      "text": "Yes, come in, take a seat. What can I do for you today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 11.31,
      "end_seconds": 24.21,
      "duration_seconds": 12.9,
      "text": "Oh, it's numbness on the left side of my face. I thought I'd wait, but it hasn't gone. I've never really been one for hospitals."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 28.57,
      "end_seconds": 31.33,
      "duration_seconds": 2.76,
      "text": "How long has this been going on?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 32.53,
      "end_seconds": 44.74,
      "duration_seconds": 12.21,
      "text": "Yeah, it's been going on for about two weeks. I'd rather not end up on lots of tablets if I can avoid it."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 46.43,
      "end_seconds": 50.05,
      "duration_seconds": 3.62,
      "text": "right, anything that tends to go along with it?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 51.56,
      "end_seconds": 58.0,
      "duration_seconds": 6.44,
      "text": "It usually comes with tiredness. The tiredness? That's been for about two weeks."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 59.64,
      "end_seconds": 65.21,
      "duration_seconds": 5.57,
      "text": "any trouble swallowing, confusion, loss of vision or chest pain at all?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 65.9,
      "end_seconds": 68.8,
      "duration_seconds": 2.9,
      "text": "No, none of that at all."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 75.24,
      "end_seconds": 77.72,
      "duration_seconds": 2.48,
      "text": "any rashes or skin problems otherwise?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 79.22,
      "end_seconds": 81.22,
      "duration_seconds": 2.0,
      "text": "No, skin's been fine."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 86.17,
      "end_seconds": 89.55,
      "duration_seconds": 3.38,
      "text": "on the cardiac side, anything I should know?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 91.24,
      "end_seconds": 92.9,
      "duration_seconds": 1.66,
      "text": "nothing like that"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 108.76,
      "end_seconds": 111.1,
      "duration_seconds": 2.34,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 112.2,
      "end_seconds": 113.78,
      "duration_seconds": 1.58,
      "text": "No operations, no."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 115.15,
      "end_seconds": 120.74,
      "duration_seconds": 5.59,
      "text": "Have you ever reacted badly to a medicine or food? Any allergies?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 121.97,
      "end_seconds": 126.7,
      "duration_seconds": 4.73,
      "text": "None, you know, as far as I'm aware."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 127.39,
      "end_seconds": 132.68,
      "duration_seconds": 5.29,
      "text": "Any diagnoses you've been given before? Take your time, there's no rush."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 134.0,
      "end_seconds": 136.08,
      "duration_seconds": 2.08,
      "text": "Yes, high blood pressure."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 137.45,
      "end_seconds": 147.73,
      "duration_seconds": 10.28,
      "text": "I follow. Yes, high blood pressure is known to to us, good to have that clear. Which tablets or creams or inhalers do you use?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 148.62,
      "end_seconds": 156.0,
      "duration_seconds": 7.38,
      "text": "Oh, you know, I take losartan, 50 milligrams, once a day for my blood pressure."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 173.75,
      "end_seconds": 175.31,
      "duration_seconds": 1.56,
      "text": "Do you drink alcohol?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 176.74,
      "end_seconds": 181.36,
      "duration_seconds": 4.62,
      "text": "I have a couple of drinks on the weekend."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 182.82,
      "end_seconds": 185.76,
      "duration_seconds": 2.94,
      "text": "what do you do to keep active?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 187.2,
      "end_seconds": 190.57,
      "duration_seconds": 3.37,
      "text": "I cycle to work most mornings"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 192.01,
      "end_seconds": 194.33,
      "duration_seconds": 2.32,
      "text": "are you working or retired?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 196.26,
      "end_seconds": 199.64,
      "duration_seconds": 3.38,
      "text": "Retired. I stopped a few years back."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 201.01,
      "end_seconds": 203.1,
      "duration_seconds": 2.09,
      "text": "How do you eat, generally?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 203.76,
      "end_seconds": 206.36,
      "duration_seconds": 2.6,
      "text": "I skip breakfast most days."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 207.83,
      "end_seconds": 211.68,
      "duration_seconds": 3.85,
      "text": "Is there a family history of anything significant?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 213.19,
      "end_seconds": 215.11,
      "duration_seconds": 1.92,
      "text": "My brother has asthma."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 226.87,
      "end_seconds": 229.61,
      "duration_seconds": 2.74,
      "text": "Let me check your vitals now."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 240.86,
      "end_seconds": 241.81,
      "duration_seconds": 0.95,
      "text": "One second..."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 258.7,
      "end_seconds": 267.55,
      "duration_seconds": 8.85,
      "text": "Okay: pulse is 86 beats a minute, SpO2 97 percent on room air, BP is 164 over 93."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 269.05,
      "end_seconds": 270.66,
      "duration_seconds": 1.61,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 275.63,
      "end_seconds": 279.4,
      "duration_seconds": 3.77,
      "text": "let's look at it together in a minute"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 281.76,
      "end_seconds": 283.94,
      "duration_seconds": 2.18,
      "text": "Shall we do the examination?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 285.82,
      "end_seconds": 287.0,
      "duration_seconds": 1.18,
      "text": "Okay, ready."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 288.86,
      "end_seconds": 291.3,
      "duration_seconds": 2.44,
      "text": "Almost done with this part."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 304.06,
      "end_seconds": 308.08,
      "duration_seconds": 4.02,
      "text": "there's mild drooping at the left corner of your mouth"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 308.69,
      "end_seconds": 309.79,
      "duration_seconds": 1.1,
      "text": "go ahead"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 314.11,
      "end_seconds": 326.37,
      "duration_seconds": 12.26,
      "text": "All done, you can get dressed. So, based on the history and the examination, this looks most like a possible mini-stroke, which we need to investigate urgently."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 342.41,
      "end_seconds": 354.75,
      "duration_seconds": 12.34,
      "text": "Let's book an ECG to look into possible stroke. Let's use clopidogrel, 75 milligrams, once a day, until we review. You take it by mouth. That's for stroke prevention."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 355.45,
      "end_seconds": 357.71,
      "duration_seconds": 2.26,
      "text": "That's easy enough to remember."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 362.45,
      "end_seconds": 380.87,
      "duration_seconds": 18.42,
      "text": "don't drive for now, and bring someone with you to the next visit. If the numbness, weakness or speech problem returns, or you feel really unwell, please come to the emergency department. I'd like you back in one week. Thanks for coming in"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 386.27,
      "end_seconds": 390.23,
      "duration_seconds": 3.96,
      "text": "no, um, you've explained it well. Thanks"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 391.5,
      "end_seconds": 393.97,
      "duration_seconds": 2.47,
      "text": "So, mind how you go."
    }
  ]
}