{
  "schema_version": "1.0",
  "encounter_id": "00405",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.5,
      "end_seconds": 5.49,
      "duration_seconds": 4.99,
      "text": "Hmm, sorry I'm a few minutes behind, doctor."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.06,
      "end_seconds": 11.79,
      "duration_seconds": 5.73,
      "text": "Yes, come in, take a seat. What can I do for you today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 12.67,
      "end_seconds": 16.39,
      "duration_seconds": 3.72,
      "text": "Thank you for fitting us in, doctor."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 18.42,
      "end_seconds": 21.8,
      "duration_seconds": 3.38,
      "text": "Yes, that's no problem at all. Please sit."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 23.85,
      "end_seconds": 28.13,
      "duration_seconds": 4.28,
      "text": "I'm here because of a tight chest."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 29.06,
      "end_seconds": 31.93,
      "duration_seconds": 2.87,
      "text": "Right, since when have you had this?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 33.55,
      "end_seconds": 37.73,
      "duration_seconds": 4.18,
      "text": "Yesterday, it came on out of nowhere."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 38.48,
      "end_seconds": 47.49,
      "duration_seconds": 9.01,
      "text": "Tell me a bit more about it: how bad it gets, how often, and whether anything makes it better or worse."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 48.54,
      "end_seconds": 56.43,
      "duration_seconds": 7.89,
      "text": "It settles a little with the inhaler. Severe, really. It happens once or twice a day."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 60.93,
      "end_seconds": 63.69,
      "duration_seconds": 2.76,
      "text": "Does it come along with anything else?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 64.59,
      "end_seconds": 69.34,
      "duration_seconds": 4.75,
      "text": "It usually comes with shortness of breath on walking."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 70.29,
      "end_seconds": 77.82,
      "duration_seconds": 7.53,
      "text": "And the other thing I wanted to mention is that I can't really—"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 77.92,
      "end_seconds": 84.65,
      "duration_seconds": 6.73,
      "text": "Okay, so tell the doctor about the other thing, that's what worries me."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 86.34,
      "end_seconds": 98.14,
      "duration_seconds": 11.8,
      "text": "I was getting to that! About shortness of breath on walking, it happens on and off. Yes, walking fast. That makes it worse."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_4",
      "role": "UNKNOWN",
      "start_seconds": 99.55,
      "end_seconds": 101.78,
      "duration_seconds": 2.23,
      "text": "Yes, exactly like that."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 102.63,
      "end_seconds": 105.47,
      "duration_seconds": 2.84,
      "text": "A few measurements, then we'll continue."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 115.85,
      "end_seconds": 116.69,
      "duration_seconds": 0.84,
      "text": "One second..."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 136.84,
      "end_seconds": 149.07,
      "duration_seconds": 12.23,
      "text": "Okay: weight 58 kilos, respiratory rate 26. And oxygen saturation is 92 percent, height 174 centimetres, heart rate 84, pressure 125 over 88, temperature is 37.0 degrees."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 151.98,
      "end_seconds": 155.97,
      "duration_seconds": 3.99,
      "text": "Okay, I need to examine you for this."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 156.99,
      "end_seconds": 157.99,
      "duration_seconds": 1.0,
      "text": "No problem."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 159.62,
      "end_seconds": 161.63,
      "duration_seconds": 2.01,
      "text": "Let me just check something."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 169.36,
      "end_seconds": 174.7,
      "duration_seconds": 5.34,
      "text": "I can hear a widespread wheeze on both sides when you breathe out."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 175.99,
      "end_seconds": 177.16,
      "duration_seconds": 1.17,
      "text": "I'll go gently."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 195.96,
      "end_seconds": 199.94,
      "duration_seconds": 3.98,
      "text": "You're speaking in full sentences, which is reassuring."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 203.41,
      "end_seconds": 206.82,
      "duration_seconds": 3.41,
      "text": "Okay, you can sit up. What about fever?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 207.96,
      "end_seconds": 209.44,
      "duration_seconds": 1.48,
      "text": "No. No fever."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 211.16,
      "end_seconds": 217.14,
      "duration_seconds": 5.98,
      "text": "A few quick ones: weight loss, coughing up phlegm, leg swelling or runny nose?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 219.12,
      "end_seconds": 234.33,
      "duration_seconds": 15.21,
      "text": "No, uh, no weight loss, no coughing up phlegm, no leg swelling. I was using my blue inhaler more at one point, but that went away on its own."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 236.19,
      "end_seconds": 238.33,
      "duration_seconds": 2.14,
      "text": "Any trouble with the waterworks?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 239.6,
      "end_seconds": 243.71,
      "duration_seconds": 4.11,
      "text": "That's normal as far as I know."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 244.45,
      "end_seconds": 246.68,
      "duration_seconds": 2.23,
      "text": "Is your digestion otherwise okay?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 248.44,
      "end_seconds": 251.97,
      "duration_seconds": 3.53,
      "text": "So, bowels are regular, nothing odd."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 253.45,
      "end_seconds": 257.38,
      "duration_seconds": 3.93,
      "text": "What medicines are you taking at the moment?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 259.22,
      "end_seconds": 268.97,
      "duration_seconds": 9.75,
      "text": "I'm on Seretide inhaler, twice a day. Paracetamol. I take it 650 milligrams, when needed for the knee pain."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 282.28,
      "end_seconds": 283.91,
      "duration_seconds": 1.63,
      "text": "Do you drink alcohol?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 284.42,
      "end_seconds": 287.12,
      "duration_seconds": 2.7,
      "text": "I don't drink at all."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 287.89,
      "end_seconds": 290.33,
      "duration_seconds": 2.44,
      "text": "Anything special about your diet?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 292.03,
      "end_seconds": 296.16,
      "duration_seconds": 4.13,
      "text": "I try to avoid too much sugar."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 296.94,
      "end_seconds": 301.32,
      "duration_seconds": 4.38,
      "text": "Are there any allergies on your record that I should check?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 301.95,
      "end_seconds": 314.25,
      "duration_seconds": 12.3,
      "text": "Oh, I think I reacted to some antibiotic once, years ago. I don't remember which one, or what happened exactly."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 315.41,
      "end_seconds": 320.56,
      "duration_seconds": 5.15,
      "text": "What about family history, any illnesses that run in the family?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 321.78,
      "end_seconds": 323.74,
      "duration_seconds": 1.96,
      "text": "My mother has diabetes."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 325.12,
      "end_seconds": 330.02,
      "duration_seconds": 4.9,
      "text": "Do you have any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 330.8,
      "end_seconds": 335.09,
      "duration_seconds": 4.29,
      "text": "I have asthma, for about a year."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 337.23,
      "end_seconds": 337.93,
      "duration_seconds": 0.7,
      "text": "Okay."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 339.72,
      "end_seconds": 344.32,
      "duration_seconds": 4.6,
      "text": "Arthritis in my knees, for about a year."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 345.3,
      "end_seconds": 360.59,
      "duration_seconds": 15.29,
      "text": "Yes, arthritis in your knees is known to us, good to have that clear. Having listened and examined, this looks most like an asthma flare-up. A chest infection is still possible."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 376.82,
      "end_seconds": 381.37,
      "duration_seconds": 4.55,
      "text": "I'm going to order a peak flow reading, for asthma control."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_5",
      "role": "CLINICAL_STAFF",
      "start_seconds": 383.18,
      "end_seconds": 385.68,
      "duration_seconds": 2.5,
      "text": "The earliest is Friday, 2 pm."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 386.31,
      "end_seconds": 388.61,
      "duration_seconds": 2.3,
      "text": "Okay, I'll be there."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 389.88,
      "end_seconds": 399.97,
      "duration_seconds": 10.09,
      "text": "I'm sending you for a chest X-ray because of wheeze. I'd rather check than guess, and this is the quickest way to know more."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 400.73,
      "end_seconds": 403.05,
      "duration_seconds": 2.32,
      "text": "Is that done here?"
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 404.75,
      "end_seconds": 412.46,
      "duration_seconds": 7.71,
      "text": "I'm prescribing prednisolone, 30 milligrams, once a day, for five days. It's for asthma flare-up."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 413.14,
      "end_seconds": 415.42,
      "duration_seconds": 2.28,
      "text": "Fine, I'll start it."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 416.58,
      "end_seconds": 419.88,
      "duration_seconds": 3.3,
      "text": "Rinse your mouth after the steroid inhaler."
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 421.06,
      "end_seconds": 427.17,
      "duration_seconds": 6.11,
      "text": "Oh, do I need breathing tests? I read it might help."
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 428.51,
      "end_seconds": 441.92,
      "duration_seconds": 13.41,
      "text": "I wouldn't order it today. If anything changes, we'll reconsider. If the inhaler isn't helping or you can't speak in full sentences, or you feel really unwell, please come to the emergency department."
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 442.67,
      "end_seconds": 443.37,
      "duration_seconds": 0.7,
      "text": "Understood."
    },
    {
      "segment_id": "SEG0059",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 444.81,
      "end_seconds": 449.32,
      "duration_seconds": 4.51,
      "text": "Come back in two weeks. Do you have any questions?"
    },
    {
      "segment_id": "SEG0060",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 450.19,
      "end_seconds": 453.02,
      "duration_seconds": 2.83,
      "text": "Thank you for your time."
    },
    {
      "segment_id": "SEG0061",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 454.85,
      "end_seconds": 456.77,
      "duration_seconds": 1.92,
      "text": "So, all the best."
    }
  ]
}