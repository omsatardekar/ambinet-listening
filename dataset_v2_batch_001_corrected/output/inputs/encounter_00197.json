{
  "schema_version": "1.0",
  "encounter_id": "00197",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.86,
      "end_seconds": 5.04,
      "duration_seconds": 4.18,
      "text": "morning, doctor, I hope I'm not interrupting"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.5,
      "end_seconds": 10.79,
      "duration_seconds": 4.29,
      "text": "That's alright, take a seat. Tell me why you've come."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 11.4,
      "end_seconds": 14.2,
      "duration_seconds": 2.8,
      "text": "doctor, thank you for seeing us"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 16.22,
      "end_seconds": 19.55,
      "duration_seconds": 3.33,
      "text": "Yes, that's no problem at all. Please sit."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 20.44,
      "end_seconds": 22.23,
      "duration_seconds": 1.79,
      "text": "I've been feeling drowsy."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_4",
      "role": "NURSE",
      "start_seconds": 22.9,
      "end_seconds": 31.03,
      "duration_seconds": 8.13,
      "text": "Okay, so the vitals from earlier. BP is 117 over 75, pulse 70, oxygen saturation is 97 percent."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 32.19,
      "end_seconds": 33.55,
      "duration_seconds": 1.36,
      "text": "Good, thank you."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 34.02,
      "end_seconds": 40.53,
      "duration_seconds": 6.51,
      "text": "I was just gonna say that that the main thing is—"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_4",
      "role": "NURSE",
      "start_seconds": 40.63,
      "end_seconds": 47.38,
      "duration_seconds": 6.75,
      "text": "sorry to cut in, doctor, quick question: shall I bring the trolley in now or later?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 62.87,
      "end_seconds": 65.78,
      "duration_seconds": 2.91,
      "text": "so, later, thanks please go on"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 68.64,
      "end_seconds": 74.12,
      "duration_seconds": 5.48,
      "text": "I've also had a fit last month, for three days."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 75.98,
      "end_seconds": 78.36,
      "duration_seconds": 2.38,
      "text": "how much is it bothering you?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 81.06,
      "end_seconds": 82.66,
      "duration_seconds": 1.6,
      "text": "Mild, I'd say."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 83.45,
      "end_seconds": 88.31,
      "duration_seconds": 4.86,
      "text": "okay, have you been feeling drowsy at any time before this?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 90.37,
      "end_seconds": 97.95,
      "duration_seconds": 7.58,
      "text": "Yes, something like this happened last winter, and it went away on its own."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_5",
      "role": "UNKNOWN",
      "start_seconds": 99.67,
      "end_seconds": 101.79,
      "duration_seconds": 2.12,
      "text": "Yes, exactly like that."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 102.58,
      "end_seconds": 108.55,
      "duration_seconds": 5.97,
      "text": "Let me check a few things. Any head injury, fever or weakness on one side?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 109.65,
      "end_seconds": 121.88,
      "duration_seconds": 12.23,
      "text": "No, no head injury, no fever, no weakness on one side. I was biting my tongue at one point, but that went away on its own."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 123.58,
      "end_seconds": 127.69,
      "duration_seconds": 4.11,
      "text": "Have you noticed loss of bladder control or headache?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 128.51,
      "end_seconds": 130.67,
      "duration_seconds": 2.16,
      "text": "Nothing like that, no."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 131.38,
      "end_seconds": 135.81,
      "duration_seconds": 4.43,
      "text": "any change in your bowel habit or your stomach generally?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 136.44,
      "end_seconds": 139.36,
      "duration_seconds": 2.92,
      "text": "Bowels are regular, nothing odd."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 140.89,
      "end_seconds": 145.67,
      "duration_seconds": 4.78,
      "text": "Tell me about your health in general, any ongoing conditions?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 146.77,
      "end_seconds": 148.24,
      "duration_seconds": 1.47,
      "text": "I have epilepsy"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 149.72,
      "end_seconds": 150.75,
      "duration_seconds": 1.03,
      "text": "Right, right."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 152.38,
      "end_seconds": 155.26,
      "duration_seconds": 2.88,
      "text": "Acid reflux, for about a year"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 156.97,
      "end_seconds": 167.25,
      "duration_seconds": 10.28,
      "text": "Alright, acid reflux, that matches what I have here. Alright, any medication at the moment, including things from the pharmacy?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_6",
      "role": "FAMILY_MEMBER",
      "start_seconds": 169.09,
      "end_seconds": 175.62,
      "duration_seconds": 6.53,
      "text": "Um, he takes sodium valproate, 500 milligrams, twice a day for the fits."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 176.83,
      "end_seconds": 178.46,
      "duration_seconds": 1.63,
      "text": "And for how long?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_6",
      "role": "FAMILY_MEMBER",
      "start_seconds": 179.1,
      "end_seconds": 189.3,
      "duration_seconds": 10.2,
      "text": "Nearly five years now. He is on omeprazole, 20 milligrams, once a day for the reflux, I give it to him"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 190.8,
      "end_seconds": 195.21,
      "duration_seconds": 4.41,
      "text": "I was on levetiracetam before. I stopped taking it."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 196.46,
      "end_seconds": 199.48,
      "duration_seconds": 3.02,
      "text": "Before I prescribe anything, any allergies?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 205.41,
      "end_seconds": 208.63,
      "duration_seconds": 3.22,
      "text": "No, none that I know of."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 209.88,
      "end_seconds": 218.48,
      "duration_seconds": 8.6,
      "text": "Actually, I remember he had some kind of reaction to penicillin before. I couldn't swear to it."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 219.92,
      "end_seconds": 222.84,
      "duration_seconds": 2.92,
      "text": "Maybe, but I don't recall it."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 223.39,
      "end_seconds": 226.24,
      "duration_seconds": 2.85,
      "text": "okay, I'll note both of those"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 235.92,
      "end_seconds": 237.39,
      "duration_seconds": 1.47,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 238.03,
      "end_seconds": 240.19,
      "duration_seconds": 2.16,
      "text": "No, nothing like that."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 240.71,
      "end_seconds": 242.51,
      "duration_seconds": 1.8,
      "text": "And alcohol, how much?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 243.76,
      "end_seconds": 246.05,
      "duration_seconds": 2.29,
      "text": "I don't drink at all"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 246.97,
      "end_seconds": 248.77,
      "duration_seconds": 1.8,
      "text": "okay, how about smoking?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 249.68,
      "end_seconds": 254.52,
      "duration_seconds": 4.84,
      "text": "I used to smoke but I quit five years ago."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 258.41,
      "end_seconds": 259.7,
      "duration_seconds": 1.29,
      "text": "How's your diet?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 260.41,
      "end_seconds": 261.99,
      "duration_seconds": 1.58,
      "text": "I'm mostly vegetarian."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 263.83,
      "end_seconds": 266.24,
      "duration_seconds": 2.41,
      "text": "Are you working at the moment?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 267.35,
      "end_seconds": 271.59,
      "duration_seconds": 4.24,
      "text": "Yes, I'm a nurse on a busy ward"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 273.85,
      "end_seconds": 276.77,
      "duration_seconds": 2.92,
      "text": "okay, I'd like to examine you now"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 278.41,
      "end_seconds": 280.94,
      "duration_seconds": 2.53,
      "text": "Alright, bear with me a second."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 288.01,
      "end_seconds": 291.85,
      "duration_seconds": 3.84,
      "text": "reflexes and power are symmetrical on both sides"
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 293.73,
      "end_seconds": 296.28,
      "duration_seconds": 2.55,
      "text": "Right, bear with me a second."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 306.19,
      "end_seconds": 309.49,
      "duration_seconds": 3.3,
      "text": "You're alert and orientated, speech is clear."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 310.94,
      "end_seconds": 311.64,
      "duration_seconds": 0.7,
      "text": "Fine."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 316.97,
      "end_seconds": 346.05,
      "duration_seconds": 29.08,
      "text": "Okay, finished. I'm sending you for an EEG because of seizure. Let's get a blood level of the tablet, for adherence check. Never skip the tablets, and set a phone alarm if it helps. If you smoke, this is a good moment to think about stopping, and we can help you with that. Book a review after the results are back. Right, that's it on my side. Anything unclear?"
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 350.23,
      "end_seconds": 352.42,
      "duration_seconds": 2.19,
      "text": "thanks so much, doctor"
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 354.42,
      "end_seconds": 355.22,
      "duration_seconds": 0.8,
      "text": "Take care."
    }
  ]
}