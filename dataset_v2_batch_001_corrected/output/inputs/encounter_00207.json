{
  "schema_version": "1.0",
  "encounter_id": "00207",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 0.98,
      "end_seconds": 6.86,
      "duration_seconds": 5.88,
      "text": "All set here, doctor. Chart's updated, and I'll read the readings out when you're ready."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 11.75,
      "end_seconds": 15.42,
      "duration_seconds": 3.67,
      "text": "Okay, thanks. Hi, how can I help today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 16.6,
      "end_seconds": 22.09,
      "duration_seconds": 5.49,
      "text": "Morning, doctor. I'll stay and fill in anything that's missed."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 22.97,
      "end_seconds": 29.07,
      "duration_seconds": 6.1,
      "text": "I've been feeling faint, and I wanted to get it checked."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 30.35,
      "end_seconds": 32.89,
      "duration_seconds": 2.54,
      "text": "When did you first notice it?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 34.03,
      "end_seconds": 36.96,
      "duration_seconds": 2.93,
      "text": "I'd say a week, maybe."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 41.59,
      "end_seconds": 45.41,
      "duration_seconds": 3.82,
      "text": "I think it's been nearer two weeks, actually."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 46.71,
      "end_seconds": 51.25,
      "duration_seconds": 4.54,
      "text": "Okay, so roughly one to two weeks. Is that right?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 51.86,
      "end_seconds": 53.85,
      "duration_seconds": 1.99,
      "text": "I suppose so, yes."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 54.91,
      "end_seconds": 65.28,
      "duration_seconds": 10.37,
      "text": "Tell me a bit more about it: how bad it gets, how often, and whether anything makes it better or worse."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 67.32,
      "end_seconds": 74.82,
      "duration_seconds": 7.5,
      "text": "Honestly, on and off. Moderate, really. Only sitting in the shade, and it's not much."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 75.41,
      "end_seconds": 79.41,
      "duration_seconds": 4.0,
      "text": "What about a pounding headache, have you noticed that?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 80.73,
      "end_seconds": 91.36,
      "duration_seconds": 10.63,
      "text": "Yes, for ten days. With pounding headache, I'd call it moderate. Uh, I had heavy sweating before. That's settled now, though."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 92.91,
      "end_seconds": 97.39,
      "duration_seconds": 4.48,
      "text": "Have you been feeling faint at any time before this?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 99.41,
      "end_seconds": 104.69,
      "duration_seconds": 5.28,
      "text": "Yeah, I had a similar thing last year. It went away."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 106.49,
      "end_seconds": 109.41,
      "duration_seconds": 2.92,
      "text": "Any chest pain or passing no urine?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 110.82,
      "end_seconds": 113.56,
      "duration_seconds": 2.74,
      "text": "No, not any of them."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 114.62,
      "end_seconds": 118.9,
      "duration_seconds": 4.28,
      "text": "Let me check a few things. Any confusion or vomiting?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 122.76,
      "end_seconds": 125.69,
      "duration_seconds": 2.93,
      "text": "No, not any of them."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 130.33,
      "end_seconds": 132.7,
      "duration_seconds": 2.37,
      "text": "Is your digestion otherwise okay?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 133.49,
      "end_seconds": 135.96,
      "duration_seconds": 2.47,
      "text": "Bowels are regular, nothing odd."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 137.62,
      "end_seconds": 139.59,
      "duration_seconds": 1.97,
      "text": "Any trouble with the waterworks?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 141.59,
      "end_seconds": 143.7,
      "duration_seconds": 2.11,
      "text": "No, that's all fine."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 144.49,
      "end_seconds": 148.26,
      "duration_seconds": 3.77,
      "text": "Do your parents or siblings have any long-term illnesses?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 148.96,
      "end_seconds": 154.45,
      "duration_seconds": 5.49,
      "text": "My mother had high blood pressure. My father had kidney stones."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 156.35,
      "end_seconds": 157.67,
      "duration_seconds": 1.32,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 158.74,
      "end_seconds": 161.38,
      "duration_seconds": 2.64,
      "text": "No, never had any surgery."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 171.89,
      "end_seconds": 174.16,
      "duration_seconds": 2.27,
      "text": "Any drug or food allergies?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 175.75,
      "end_seconds": 182.94,
      "duration_seconds": 7.19,
      "text": "Yes, shellfish, it gives me vomiting. Yes, pollen, it gives me a runny nose."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 192.08,
      "end_seconds": 194.56,
      "duration_seconds": 2.48,
      "text": "Any diagnoses you've been given before?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 195.26,
      "end_seconds": 199.36,
      "duration_seconds": 4.1,
      "text": "I've had high blood pressure for two years now."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 201.43,
      "end_seconds": 202.46,
      "duration_seconds": 1.03,
      "text": "Hm, okay."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 203.99,
      "end_seconds": 210.37,
      "duration_seconds": 6.38,
      "text": "I have epilepsy. Well, you know, I've had arthritis in my knees, yes."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 211.98,
      "end_seconds": 223.08,
      "duration_seconds": 11.1,
      "text": "Yes, high blood pressure and epilepsy are known to us, good to have that clear. What medicines are you taking at the moment?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 226.48,
      "end_seconds": 249.54,
      "duration_seconds": 23.06,
      "text": "He is on losartan, 50 milligrams, once a day, I give it to him. He is on sodium valproate, 500 milligrams, twice a day for the fits, I give it to him. It's diclofenac, 50 milligrams, when needed for the joint pain, doctor."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 251.04,
      "end_seconds": 253.96,
      "duration_seconds": 2.92,
      "text": "Roughly how long on that one?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 259.83,
      "end_seconds": 261.85,
      "duration_seconds": 2.02,
      "text": "About three months now."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 263.4,
      "end_seconds": 268.19,
      "duration_seconds": 4.79,
      "text": "Let's talk a little about your daily life and habits."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 269.96,
      "end_seconds": 286.45,
      "duration_seconds": 16.49,
      "text": "I have a couple of drinks on the weekend. I stopped smoking about two years back. I cycle to work most mornings. I stay with my daughter and her family."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 297.96,
      "end_seconds": 305.32,
      "duration_seconds": 7.36,
      "text": "Doctor, I've got the readings for you. Pulse 95, SpO2 97 percent on room air, pressure 93 over 65."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 310.14,
      "end_seconds": 310.84,
      "duration_seconds": 0.7,
      "text": "Thanks."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 313.67,
      "end_seconds": 317.6,
      "duration_seconds": 3.93,
      "text": "Okay, I need to examine you for this."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 319.56,
      "end_seconds": 320.86,
      "duration_seconds": 1.3,
      "text": "I'll go gently."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 328.92,
      "end_seconds": 332.33,
      "duration_seconds": 3.41,
      "text": "Your skin is warm and a bit clammy."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 333.92,
      "end_seconds": 336.2,
      "duration_seconds": 2.28,
      "text": "Almost done with this part."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 343.72,
      "end_seconds": 345.67,
      "duration_seconds": 1.95,
      "text": "Capillary refill is normal."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 349.65,
      "end_seconds": 372.94,
      "duration_seconds": 23.29,
      "text": "All done, you can get dressed. Putting it all together, the most likely explanation is heat exhaustion with some dehydration. I'd also keep an electrolyte imbalance in mind. I think blood salts makes sense here, for dehydration. Let's use ORS, 1 sachet, three times a day, for two days. That should help with dehydration."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 374.04,
      "end_seconds": 376.54,
      "duration_seconds": 2.5,
      "text": "That's easy enough to remember."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 377.06,
      "end_seconds": 389.12,
      "duration_seconds": 12.06,
      "text": "Avoid the midday sun for a few days and keep a water bottle with you. Come back in three days. Alright, I'll see you out."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 390.39,
      "end_seconds": 393.66,
      "duration_seconds": 3.27,
      "text": "No, you've explained it well. Thanks."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 395.24,
      "end_seconds": 396.51,
      "duration_seconds": 1.27,
      "text": "Safe journey home."
    }
  ]
}