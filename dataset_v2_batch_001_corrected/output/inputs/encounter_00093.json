{
  "schema_version": "1.0",
  "encounter_id": "00093",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.54,
      "end_seconds": 6.11,
      "duration_seconds": 5.57,
      "text": "Right, hi, doctor. Long queue outside, but here I am."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 11.7,
      "end_seconds": 17.86,
      "duration_seconds": 6.16,
      "text": "Yes, come in, take a seat. What can I do for you today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 18.96,
      "end_seconds": 31.67,
      "duration_seconds": 12.71,
      "text": "Doctor, I've come along because I know the history, if it helps. Doctor, uh, it's acne. That's what we're worried about."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 33.37,
      "end_seconds": 36.7,
      "duration_seconds": 3.33,
      "text": "How bad is it, would you say?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 37.94,
      "end_seconds": 41.99,
      "duration_seconds": 4.05,
      "text": "Well, pretty severe, if I'm being honest."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 42.59,
      "end_seconds": 45.95,
      "duration_seconds": 3.36,
      "text": "Anything that tends to go along with it?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 47.28,
      "end_seconds": 60.14,
      "duration_seconds": 12.86,
      "text": "Oily skin goes along with it, you know, most of the time. The Oily skin? That's been for about three months."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 61.59,
      "end_seconds": 64.35,
      "duration_seconds": 2.76,
      "text": "Any flare-ups before your period as well?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 65.11,
      "end_seconds": 66.72,
      "duration_seconds": 1.61,
      "text": "Yeah, that too."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 68.2,
      "end_seconds": 72.95,
      "duration_seconds": 4.75,
      "text": "Let me check a few things. Any new face cream or scarring?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 75.02,
      "end_seconds": 81.25,
      "duration_seconds": 6.23,
      "text": "Okay, so no new face cream or scarring, none of it."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 83.6,
      "end_seconds": 87.76,
      "duration_seconds": 4.16,
      "text": "Have you had any pregnancy, excess hair growth or fever?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 89.28,
      "end_seconds": 91.99,
      "duration_seconds": 2.71,
      "text": "so, no, none of those"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 94.05,
      "end_seconds": 97.02,
      "duration_seconds": 2.97,
      "text": "Has your heart given you any trouble?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 98.15,
      "end_seconds": 100.84,
      "duration_seconds": 2.69,
      "text": "No, nothing with my heart."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 102.89,
      "end_seconds": 105.87,
      "duration_seconds": 2.98,
      "text": "Are you on any tablets or medication?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 110.57,
      "end_seconds": 117.33,
      "duration_seconds": 6.76,
      "text": "I'm on something called omep... omeprazole, 20 milligrams, maybe, once a day."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 118.09,
      "end_seconds": 121.42,
      "duration_seconds": 3.33,
      "text": "is the packet here, or the prescription?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 122.3,
      "end_seconds": 128.68,
      "duration_seconds": 6.38,
      "text": "Not with me. I'll bring it next time. Pantoprazole I don't take anymore."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 143.83,
      "end_seconds": 148.66,
      "duration_seconds": 4.83,
      "text": "Do you have any allergies to medicines, food, anything at all?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 149.79,
      "end_seconds": 152.57,
      "duration_seconds": 2.78,
      "text": "No, no allergies to anything."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 153.95,
      "end_seconds": 156.64,
      "duration_seconds": 2.69,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 157.96,
      "end_seconds": 161.58,
      "duration_seconds": 3.62,
      "text": "no, you know, nothing like that"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 162.69,
      "end_seconds": 165.62,
      "duration_seconds": 2.93,
      "text": "any diagnoses you've been given before?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 171.45,
      "end_seconds": 175.33,
      "duration_seconds": 3.88,
      "text": "I have acid reflux, for five years"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 176.54,
      "end_seconds": 178.55,
      "duration_seconds": 2.01,
      "text": "Anything special about your diet?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 179.5,
      "end_seconds": 183.5,
      "duration_seconds": 4.0,
      "text": "I try to avoid too much sugar."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 184.31,
      "end_seconds": 185.89,
      "duration_seconds": 1.58,
      "text": "Do you live alone?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 187.29,
      "end_seconds": 190.87,
      "duration_seconds": 3.58,
      "text": "Yes, I live on my own."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 202.03,
      "end_seconds": 204.81,
      "duration_seconds": 2.78,
      "text": "Does anything run in the family?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 205.38,
      "end_seconds": 208.06,
      "duration_seconds": 2.68,
      "text": "My uncle had colon cancer."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 209.53,
      "end_seconds": 213.45,
      "duration_seconds": 3.92,
      "text": "Before we go on, a few quick readings."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 223.86,
      "end_seconds": 225.58,
      "duration_seconds": 1.72,
      "text": "Rest your hand here..."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 237.31,
      "end_seconds": 244.69,
      "duration_seconds": 7.38,
      "text": "Okay: temp 37.0 degrees, blood pressure 112 over 71, pulse is 75 beats a minute."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 246.67,
      "end_seconds": 249.47,
      "duration_seconds": 2.8,
      "text": "Let me have a look at you."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 250.93,
      "end_seconds": 253.69,
      "duration_seconds": 2.76,
      "text": "Stay still while I have a look."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 270.75,
      "end_seconds": 278.07,
      "duration_seconds": 7.32,
      "text": "There are red papules and a few pustules over the cheeks and chin, with some blackheads."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 280.57,
      "end_seconds": 283.98,
      "duration_seconds": 3.41,
      "text": "So, all done, you can get dressed."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 294.25,
      "end_seconds": 307.03,
      "duration_seconds": 12.78,
      "text": "let me tell you where I've got to it's hard to say. Moderate acne is one possibility and rosacea another, and I'd rather not commit yet"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 308.79,
      "end_seconds": 314.35,
      "duration_seconds": 5.56,
      "text": "I've been thinking the worst, to be honest. Is it bad?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 315.5,
      "end_seconds": 331.13,
      "duration_seconds": 15.63,
      "text": "I understand the worry. At the moment I'd say it's moderate acne, and we'll watch how it goes. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 331.93,
      "end_seconds": 332.63,
      "duration_seconds": 0.7,
      "text": "Understood."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 333.84,
      "end_seconds": 341.98,
      "duration_seconds": 8.14,
      "text": "There's nothing new for me to start or arrange today. Take care, and call us if anything changes."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 346.06,
      "end_seconds": 348.47,
      "duration_seconds": 2.41,
      "text": "Thanks, that was helpful."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 350.02,
      "end_seconds": 350.72,
      "duration_seconds": 0.7,
      "text": "goodbye"
    }
  ]
}