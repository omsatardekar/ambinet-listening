{
  "schema_version": "1.0",
  "encounter_id": "00182",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.05,
      "end_seconds": 4.07,
      "duration_seconds": 3.02,
      "text": "Evening. Long day, I imagine. Sit down."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 5.05,
      "end_seconds": 6.08,
      "duration_seconds": 1.03,
      "text": "Thank you."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 7.63,
      "end_seconds": 10.8,
      "duration_seconds": 3.17,
      "text": "Okay, how can I help you today?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 12.22,
      "end_seconds": 19.97,
      "duration_seconds": 7.75,
      "text": "It's cramping pain in the lower tummy. I thought I'd wait, but it hasn't gone."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 24.77,
      "end_seconds": 27.44,
      "duration_seconds": 2.67,
      "text": "Is there anything that triggers it?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 28.56,
      "end_seconds": 46.47,
      "duration_seconds": 17.91,
      "text": "It's worse with stress and certain foods. I've had alternating constipation and loose stools too, for about three months. Oh, and bloating. That's been about the same, six months."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 47.02,
      "end_seconds": 49.58,
      "duration_seconds": 2.56,
      "text": "Let me check your vitals now."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 57.4,
      "end_seconds": 58.21,
      "duration_seconds": 0.81,
      "text": "Almost there..."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 69.69,
      "end_seconds": 77.04,
      "duration_seconds": 7.35,
      "text": "Okay: heart rate 84, oxygen saturation is 98 percent, BP is 118 over 81, respiratory rate 18."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 78.96,
      "end_seconds": 82.59,
      "duration_seconds": 3.63,
      "text": "Come over here and I'll have a look."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 83.71,
      "end_seconds": 85.76,
      "duration_seconds": 2.05,
      "text": "Tell me if anything hurts."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 92.97,
      "end_seconds": 98.64,
      "duration_seconds": 5.67,
      "text": "Soft tummy, a bit tender on the left lower side, no masses."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 101.49,
      "end_seconds": 104.05,
      "duration_seconds": 2.56,
      "text": "That's all I need, thank you."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 115.5,
      "end_seconds": 121.12,
      "duration_seconds": 5.62,
      "text": "Alright, and what about night-time diarrhoea, anaemia, fever or blood in the stool?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 123.03,
      "end_seconds": 130.53,
      "duration_seconds": 7.5,
      "text": "No night-time diarrhoea, anaemia, fever or blood in the stool, none of it."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 132.46,
      "end_seconds": 135.03,
      "duration_seconds": 2.57,
      "text": "Is your urine normal, no changes?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 135.54,
      "end_seconds": 138.8,
      "duration_seconds": 3.26,
      "text": "Hmm, no, that's all fine."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 140.88,
      "end_seconds": 143.09,
      "duration_seconds": 2.21,
      "text": "Right, any procedures or operations?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 144.65,
      "end_seconds": 152.96,
      "duration_seconds": 8.31,
      "text": "I had a knee arthroscopy three years ago. I did try to ignore it for a while."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 154.98,
      "end_seconds": 159.82,
      "duration_seconds": 4.84,
      "text": "What about allergies, to medicines or foods or anything else?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 161.46,
      "end_seconds": 162.6,
      "duration_seconds": 1.14,
      "text": "No allergies."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 163.33,
      "end_seconds": 167.89,
      "duration_seconds": 4.56,
      "text": "Any relatives with health problems I should be aware of?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 168.77,
      "end_seconds": 171.62,
      "duration_seconds": 2.85,
      "text": "My father had kidney stones."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 188.57,
      "end_seconds": 192.57,
      "duration_seconds": 4.0,
      "text": "Any medication at the moment, including things from the pharmacy?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 193.82,
      "end_seconds": 199.07,
      "duration_seconds": 5.25,
      "text": "Right, it's escitalopram, 10 milligrams, once a day."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 200.83,
      "end_seconds": 203.58,
      "duration_seconds": 2.75,
      "text": "Since when have you been taking it?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 205.6,
      "end_seconds": 207.4,
      "duration_seconds": 1.8,
      "text": "Two months now."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 208.27,
      "end_seconds": 209.99,
      "duration_seconds": 1.72,
      "text": "And alcohol, how much?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 210.9,
      "end_seconds": 213.85,
      "duration_seconds": 2.95,
      "text": "I don't drink at all."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 215.13,
      "end_seconds": 216.54,
      "duration_seconds": 1.41,
      "text": "Do you work?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 218.46,
      "end_seconds": 225.47,
      "duration_seconds": 7.01,
      "text": "I run a small shop, so I'm on my feet a lot."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 227.16,
      "end_seconds": 229.75,
      "duration_seconds": 2.59,
      "text": "And what do you usually eat?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 230.86,
      "end_seconds": 234.3,
      "duration_seconds": 3.44,
      "text": "Mostly home-cooked food, rice and vegetables."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 236.05,
      "end_seconds": 238.35,
      "duration_seconds": 2.3,
      "text": "Are you active at all?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 239.03,
      "end_seconds": 242.68,
      "duration_seconds": 3.65,
      "text": "Barely, I'm mostly sedentary these days."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 243.75,
      "end_seconds": 247.35,
      "duration_seconds": 3.6,
      "text": "Any long-term health problems I should know about?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 249.16,
      "end_seconds": 253.05,
      "duration_seconds": 3.89,
      "text": "I have anxiety, for nearly five years."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 254.85,
      "end_seconds": 255.69,
      "duration_seconds": 0.84,
      "text": "And then?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 257.39,
      "end_seconds": 265.5,
      "duration_seconds": 8.11,
      "text": "Having listened and examined, this is probably irritable bowel syndrome as a working diagnosis. Another possibility is coeliac disease."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 267.48,
      "end_seconds": 272.8,
      "duration_seconds": 5.32,
      "text": "So, uh, is this going to go away?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 274.68,
      "end_seconds": 297.77,
      "duration_seconds": 23.09,
      "text": "Nothing I've seen today points to an emergency. It looks like irritable bowel syndrome as a working diagnosis, but I'd like to confirm. I'd like to arrange a coeliac test for bloating. It's a routine test and it'll give us a much clearer picture. I'm going to order a stool calprotectin, for bowel symptoms."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 299.44,
      "end_seconds": 312.41,
      "duration_seconds": 12.97,
      "text": "Let's use mebeverine, 135 milligrams, three times a day, for four weeks. You take it by mouth. That's for abdominal cramps. It's a commonly used medicine and most people tolerate it well."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 318.02,
      "end_seconds": 319.83,
      "duration_seconds": 1.81,
      "text": "Okay, thank you."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 320.99,
      "end_seconds": 340.38,
      "duration_seconds": 19.39,
      "text": "Regular meals and a bit more fibre, and don't rush your toilet time. Note down what you ate before the bad days, it often reveals a pattern. If the symptoms get worse, or you feel really unwell, please come to the emergency department."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 341.32,
      "end_seconds": 344.02,
      "duration_seconds": 2.7,
      "text": "Yes, I'll watch for that."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 345.29,
      "end_seconds": 348.53,
      "duration_seconds": 3.24,
      "text": "Take care, and call us if anything changes."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 349.17,
      "end_seconds": 351.81,
      "duration_seconds": 2.64,
      "text": "Alright, thanks. Bye for now."
    }
  ]
}