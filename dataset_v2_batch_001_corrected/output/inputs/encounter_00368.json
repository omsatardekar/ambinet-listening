{
  "schema_version": "1.0",
  "encounter_id": "00368",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.71,
      "end_seconds": 3.6,
      "duration_seconds": 2.89,
      "text": "Evening. Long day, I imagine. Sit down."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 4.82,
      "end_seconds": 7.03,
      "duration_seconds": 2.21,
      "text": "Hello, doctor, thank you."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 7.81,
      "end_seconds": 10.19,
      "duration_seconds": 2.38,
      "text": "What brings you in today?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 10.69,
      "end_seconds": 14.53,
      "duration_seconds": 3.84,
      "text": "I've been dealing with fever and chills."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 15.07,
      "end_seconds": 17.72,
      "duration_seconds": 2.65,
      "text": "Since when have you had this?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 18.72,
      "end_seconds": 21.23,
      "duration_seconds": 2.51,
      "text": "About... well, about two weeks."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 22.76,
      "end_seconds": 32.4,
      "duration_seconds": 9.64,
      "text": "Tell me a bit more about it: how bad it gets, how often, and whether anything makes it better or worse."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 33.0,
      "end_seconds": 41.12,
      "duration_seconds": 8.12,
      "text": "I get some relief from paracetamol. I'd say a few times a day. I'd call it moderate."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 42.22,
      "end_seconds": 44.62,
      "duration_seconds": 2.4,
      "text": "Have you been feeling very weak?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 46.72,
      "end_seconds": 53.63,
      "duration_seconds": 6.91,
      "text": "Yes, I have. About feeling very weak, a five out of ten, I suppose."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 67.9,
      "end_seconds": 83.06,
      "duration_seconds": 15.16,
      "text": "Okay, so the vitals from earlier. BMI works out to 28.7, oxygen saturation is 91 percent, blood pressure 122 over 78, temp 37.5 degrees, weight 94 kilos, height 181 centimetres, pulse 101, respiratory rate 20."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 83.8,
      "end_seconds": 84.82,
      "duration_seconds": 1.02,
      "text": "Okay, noted."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 87.61,
      "end_seconds": 90.98,
      "duration_seconds": 3.37,
      "text": "Right, if you're comfortable, I'll examine you now."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 92.95,
      "end_seconds": 95.29,
      "duration_seconds": 2.34,
      "text": "Take your time, no rush."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 102.64,
      "end_seconds": 105.25,
      "duration_seconds": 2.61,
      "text": "Breathing rate is a bit fast."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 107.88,
      "end_seconds": 109.26,
      "duration_seconds": 1.38,
      "text": "Thanks for that."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 125.09,
      "end_seconds": 129.6,
      "duration_seconds": 4.51,
      "text": "Any recent travel, palpitations, confusion or coughing up blood at all?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 131.49,
      "end_seconds": 137.96,
      "duration_seconds": 6.47,
      "text": "No recent travel, palpitations, confusion or coughing up blood, none of it."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 139.14,
      "end_seconds": 141.86,
      "duration_seconds": 2.72,
      "text": "Any breathing difficulties apart from this?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 143.46,
      "end_seconds": 145.82,
      "duration_seconds": 2.36,
      "text": "No, my breathing's been fine."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 147.83,
      "end_seconds": 149.78,
      "duration_seconds": 1.95,
      "text": "Is your mobility otherwise okay?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 150.74,
      "end_seconds": 152.49,
      "duration_seconds": 1.75,
      "text": "No, nothing there."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 153.28,
      "end_seconds": 156.52,
      "duration_seconds": 3.24,
      "text": "Alright, now some background about your lifestyle."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 157.56,
      "end_seconds": 171.34,
      "duration_seconds": 13.78,
      "text": "I gave up drinking about three years ago. I'm a self-employed electrician. I stay with my daughter and her family. I try to avoid too much sugar."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 172.95,
      "end_seconds": 176.53,
      "duration_seconds": 3.58,
      "text": "Which tablets or creams or inhalers do you use?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 178.17,
      "end_seconds": 188.54,
      "duration_seconds": 10.37,
      "text": "Tiotropium inhaler. I take it once a day for my chest. I'm on Dolo, 650 milligrams, when I get the fever."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 189.23,
      "end_seconds": 191.83,
      "duration_seconds": 2.6,
      "text": "What about operations, anything like that?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 193.03,
      "end_seconds": 197.29,
      "duration_seconds": 4.26,
      "text": "I had a knee arthroscopy three years ago."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 199.3,
      "end_seconds": 204.88,
      "duration_seconds": 5.58,
      "text": "Have you ever reacted badly to a medicine or food? Any allergies?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 206.76,
      "end_seconds": 210.18,
      "duration_seconds": 3.42,
      "text": "Yes, aspirin, it gives me a rash."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 229.08,
      "end_seconds": 233.47,
      "duration_seconds": 4.39,
      "text": "Moving on to your background, any past medical history?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 234.86,
      "end_seconds": 240.55,
      "duration_seconds": 5.69,
      "text": "I have COPD, for about ten years. Diabetes, for nearly five years."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 241.35,
      "end_seconds": 242.25,
      "duration_seconds": 0.9,
      "text": "Any others?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 246.13,
      "end_seconds": 256.03,
      "duration_seconds": 9.9,
      "text": "From what you've told me and what I found, the most likely explanation is a possible pneumonia on the right side."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 256.53,
      "end_seconds": 259.73,
      "duration_seconds": 3.2,
      "text": "What are the chances it's something bad?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 261.38,
      "end_seconds": 284.41,
      "duration_seconds": 23.03,
      "text": "It's reasonable to be concerned, but right now a possible pneumonia on the right side is my leading thought, not anything worse. I'm going to order a chest X-ray, for suspected pneumonia. The result will help us decide whether anything more is needed. I think a sputum culture makes sense here, for pneumonia."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 289.63,
      "end_seconds": 293.16,
      "duration_seconds": 3.53,
      "text": "Oh, where do I go for that?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 294.11,
      "end_seconds": 323.6,
      "duration_seconds": 29.49,
      "text": "I'm going to order blood tests, for infection. I'd like you to take levofloxacin, 500 milligrams, once a day, for five days. It's for chest infection. Rest and fluids, and finish every dose of the antibiotic. Try to get to bed and wake up at the same time each day, and keep your phone away from the bed. I'd like you back after the X-ray."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 325.16,
      "end_seconds": 326.96,
      "duration_seconds": 1.8,
      "text": "That works for me."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 331.7,
      "end_seconds": 336.31,
      "duration_seconds": 4.61,
      "text": "Okay, take care, and call us if anything changes."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 337.35,
      "end_seconds": 338.96,
      "duration_seconds": 1.61,
      "text": "Right. Thanks again."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 340.67,
      "end_seconds": 341.56,
      "duration_seconds": 0.89,
      "text": "Take care."
    }
  ]
}