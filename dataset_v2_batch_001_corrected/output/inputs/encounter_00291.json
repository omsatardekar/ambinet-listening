{
  "schema_version": "1.0",
  "encounter_id": "00291",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 0.93,
      "end_seconds": 7.53,
      "duration_seconds": 6.6,
      "text": "Okay, doctor, we're all set in here. I'll give you the numbers when you want them."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.35,
      "end_seconds": 13.17,
      "duration_seconds": 4.82,
      "text": "Good, thank you. Welcome, tell me what's brought you in."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 17.52,
      "end_seconds": 22.58,
      "duration_seconds": 5.06,
      "text": "Morning, doctor. I'll stay and fill in anything that's missed."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 25.73,
      "end_seconds": 28.54,
      "duration_seconds": 2.81,
      "text": "Please do. Extra information is always welcome."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 29.55,
      "end_seconds": 31.99,
      "duration_seconds": 2.44,
      "text": "We came because of tiredness."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 33.22,
      "end_seconds": 35.29,
      "duration_seconds": 2.07,
      "text": "Roughly when did it start?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 36.26,
      "end_seconds": 39.45,
      "duration_seconds": 3.19,
      "text": "About three weeks, give or take."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 41.45,
      "end_seconds": 44.61,
      "duration_seconds": 3.16,
      "text": "It was closer to a month, doctor."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 45.39,
      "end_seconds": 49.59,
      "duration_seconds": 4.2,
      "text": "Okay, so roughly three to four weeks. Is that right?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 50.65,
      "end_seconds": 51.71,
      "duration_seconds": 1.06,
      "text": "Yeah, roughly."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 53.57,
      "end_seconds": 56.96,
      "duration_seconds": 3.39,
      "text": "Does it come along with anything else?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 57.86,
      "end_seconds": 65.77,
      "duration_seconds": 7.91,
      "text": "It usually comes with dry skin. The dry skin? That's been for about three months."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 67.24,
      "end_seconds": 70.96,
      "duration_seconds": 3.72,
      "text": "Is there anything that takes the edge off?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 72.1,
      "end_seconds": 77.64,
      "duration_seconds": 5.54,
      "text": "Oh, it settles a little with moisturiser. There's constipation as well."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 79.4,
      "end_seconds": 83.34,
      "duration_seconds": 3.94,
      "text": "Did you get low mood or hair loss?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 84.69,
      "end_seconds": 88.96,
      "duration_seconds": 4.27,
      "text": "No low mood or hair loss, none of it."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 90.68,
      "end_seconds": 94.39,
      "duration_seconds": 3.71,
      "text": "Have you had any trouble swallowing or heavy periods?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 96.33,
      "end_seconds": 99.45,
      "duration_seconds": 3.12,
      "text": "None, as far as I know."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 101.09,
      "end_seconds": 104.87,
      "duration_seconds": 3.78,
      "text": "Right, on the cardiac side, anything I should know?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 106.18,
      "end_seconds": 108.36,
      "duration_seconds": 2.18,
      "text": "No, that's been fine."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 109.81,
      "end_seconds": 112.83,
      "duration_seconds": 3.02,
      "text": "Any muscle or joint problems besides this?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 113.34,
      "end_seconds": 114.73,
      "duration_seconds": 1.39,
      "text": "Nothing else aches."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 115.53,
      "end_seconds": 116.91,
      "duration_seconds": 1.38,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 121.13,
      "end_seconds": 124.94,
      "duration_seconds": 3.81,
      "text": "I had a knee arthroscopy three years ago."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 136.55,
      "end_seconds": 141.41,
      "duration_seconds": 4.86,
      "text": "Do you have any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 142.31,
      "end_seconds": 145.1,
      "duration_seconds": 2.79,
      "text": "Low haemoglobin, for five years."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 147.11,
      "end_seconds": 147.81,
      "duration_seconds": 0.7,
      "text": "Okay."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 152.87,
      "end_seconds": 158.94,
      "duration_seconds": 6.07,
      "text": "I've had migraines, yes. I've had asthma for about a year now."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 160.22,
      "end_seconds": 170.1,
      "duration_seconds": 9.88,
      "text": "Yes, migraines and asthma are known to us, good to have that clear. What about allergies, to medicines or foods or anything else?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 171.46,
      "end_seconds": 174.3,
      "duration_seconds": 2.84,
      "text": "Not that I know, no."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 175.58,
      "end_seconds": 181.54,
      "duration_seconds": 5.96,
      "text": "I'm not sure that's right. I seem to recall a problem with aspirin."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 182.72,
      "end_seconds": 184.57,
      "duration_seconds": 1.85,
      "text": "I don't remember that."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 185.73,
      "end_seconds": 196.04,
      "duration_seconds": 10.31,
      "text": "Alright, so that's unclear. I'll record what each of you said. Alright, any medication at the moment, including things from the pharmacy?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 197.24,
      "end_seconds": 206.68,
      "duration_seconds": 9.44,
      "text": "It's iron tablets, once a day. Sumatriptan. I take it 50 milligrams, when needed. I'm on Asthalin inhaler, when needed."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 207.4,
      "end_seconds": 208.57,
      "duration_seconds": 1.17,
      "text": "Do you smoke?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 210.3,
      "end_seconds": 214.28,
      "duration_seconds": 3.98,
      "text": "I smoke, yes, around five a day."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 216.27,
      "end_seconds": 218.13,
      "duration_seconds": 1.86,
      "text": "Do you drink alcohol?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 220.01,
      "end_seconds": 222.49,
      "duration_seconds": 2.48,
      "text": "I don't drink at all."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 224.21,
      "end_seconds": 225.94,
      "duration_seconds": 1.73,
      "text": "Do you live alone?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 227.48,
      "end_seconds": 230.64,
      "duration_seconds": 3.16,
      "text": "Yes, I live on my own."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 232.66,
      "end_seconds": 235.06,
      "duration_seconds": 2.4,
      "text": "Anything special about your diet?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 235.6,
      "end_seconds": 239.3,
      "duration_seconds": 3.7,
      "text": "I try to avoid too much sugar."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 240.66,
      "end_seconds": 241.91,
      "duration_seconds": 1.25,
      "text": "What's your job?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 243.03,
      "end_seconds": 245.78,
      "duration_seconds": 2.75,
      "text": "I teach at a primary school."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 254.57,
      "end_seconds": 266.19,
      "duration_seconds": 11.62,
      "text": "Doctor, I've got the readings for you. Temperature is 36.9 degrees, SpO2 97 percent on room air, respiratory rate 18. Pulse is 81 beats a minute, pressure 117 over 76."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 267.96,
      "end_seconds": 268.93,
      "duration_seconds": 0.97,
      "text": "So, thanks."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 271.61,
      "end_seconds": 274.53,
      "duration_seconds": 2.92,
      "text": "I'll examine you now, bear with me."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 276.47,
      "end_seconds": 277.17,
      "duration_seconds": 0.7,
      "text": "Okay."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 279.07,
      "end_seconds": 280.76,
      "duration_seconds": 1.69,
      "text": "Let me press here."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 294.21,
      "end_seconds": 298.96,
      "duration_seconds": 4.75,
      "text": "Your pulse is slow, about fifty-six, and the thyroid isn't enlarged."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 299.83,
      "end_seconds": 300.91,
      "duration_seconds": 1.08,
      "text": "Go ahead."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 302.82,
      "end_seconds": 305.04,
      "duration_seconds": 2.22,
      "text": "Almost done with this part."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 318.01,
      "end_seconds": 320.78,
      "duration_seconds": 2.77,
      "text": "Reflexes are a bit slow to relax."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 324.67,
      "end_seconds": 335.76,
      "duration_seconds": 11.09,
      "text": "Okay, finished. So where does that leave us? The most likely explanation is an underactive thyroid. It could also be anaemia, so we'll keep that open."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 344.01,
      "end_seconds": 376.99,
      "duration_seconds": 32.98,
      "text": "I'd like to arrange blood tests for fatigue. We should do a thyroid test for hypothyroid symptoms. I'll start you on levothyroxine, 50 micrograms, every morning on an empty stomach, until we review. That's for hypothyroidism. Take the thyroid tablet on an empty stomach, half an hour before breakfast, and not with calcium or iron. Don't skip meals, and try to eat smaller portions more often through the day. Book a review in six weeks."
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 378.15,
      "end_seconds": 379.97,
      "duration_seconds": 1.82,
      "text": "That works for me."
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 381.89,
      "end_seconds": 384.15,
      "duration_seconds": 2.26,
      "text": "Alright, I'll see you out."
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 385.18,
      "end_seconds": 387.86,
      "duration_seconds": 2.68,
      "text": "Thank you for your time."
    },
    {
      "segment_id": "SEG0059",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 389.06,
      "end_seconds": 390.83,
      "duration_seconds": 1.77,
      "text": "Mind how you go."
    }
  ]
}