{
  "schema_version": "1.0",
  "encounter_id": "00035",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.98,
      "end_seconds": 6.17,
      "duration_seconds": 5.19,
      "text": "Hi there, is it alright if I come in now?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.22,
      "end_seconds": 11.16,
      "duration_seconds": 3.94,
      "text": "You're fine, sit down. So, what brings you in?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 15.77,
      "end_seconds": 26.37,
      "duration_seconds": 10.6,
      "text": "Yeah, it's a slight slur in my speech. I don't know what's causing it. I didn't want to make a fuss, you know."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 27.15,
      "end_seconds": 29.54,
      "duration_seconds": 2.39,
      "text": "And when did that start?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 30.13,
      "end_seconds": 33.04,
      "duration_seconds": 2.91,
      "text": "For ten days, I'd say."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 35.08,
      "end_seconds": 38.92,
      "duration_seconds": 3.84,
      "text": "So, how bad is it, would you say?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 42.65,
      "end_seconds": 44.03,
      "duration_seconds": 1.38,
      "text": "I'd say severe."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 60.22,
      "end_seconds": 63.76,
      "duration_seconds": 3.54,
      "text": "Any palpitations, chest pain or confusion at all?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 66.86,
      "end_seconds": 71.95,
      "duration_seconds": 5.09,
      "text": "I haven't had palpitations, chest pain or confusion, no."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 73.94,
      "end_seconds": 76.89,
      "duration_seconds": 2.95,
      "text": "Okay, is your mobility otherwise okay?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 78.79,
      "end_seconds": 80.72,
      "duration_seconds": 1.93,
      "text": "I move fine otherwise."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 91.16,
      "end_seconds": 94.93,
      "duration_seconds": 3.77,
      "text": "Okay, any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 96.67,
      "end_seconds": 100.47,
      "duration_seconds": 3.8,
      "text": "No, uh, none that I know of."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 101.14,
      "end_seconds": 105.88,
      "duration_seconds": 4.74,
      "text": "Are there any allergies on your record that I should check?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 107.22,
      "end_seconds": 109.75,
      "duration_seconds": 2.53,
      "text": "No, no allergies to anything."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 110.88,
      "end_seconds": 113.48,
      "duration_seconds": 2.6,
      "text": "Have you had any surgery before?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 114.65,
      "end_seconds": 119.54,
      "duration_seconds": 4.89,
      "text": "Just a lump removed from my back, years ago."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 120.42,
      "end_seconds": 122.68,
      "duration_seconds": 2.26,
      "text": "Who's at home with you?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 123.34,
      "end_seconds": 127.95,
      "duration_seconds": 4.61,
      "text": "It's just me and my wife at home now."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 129.95,
      "end_seconds": 132.0,
      "duration_seconds": 2.05,
      "text": "Tell me about your work."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 133.15,
      "end_seconds": 138.74,
      "duration_seconds": 5.59,
      "text": "I'm a software engineer, so I'm at a screen all day."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 143.26,
      "end_seconds": 147.33,
      "duration_seconds": 4.07,
      "text": "Any relatives with health problems I should be aware of?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 148.8,
      "end_seconds": 154.13,
      "duration_seconds": 5.33,
      "text": "Uh, you know, my father had a heart attack."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 155.39,
      "end_seconds": 159.53,
      "duration_seconds": 4.14,
      "text": "Let's go through your medication. What are you taking?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 160.15,
      "end_seconds": 163.53,
      "duration_seconds": 3.38,
      "text": "It's aspirin, 75 milligrams, once a day."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 178.46,
      "end_seconds": 180.83,
      "duration_seconds": 2.37,
      "text": "Let me measure a few things."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 190.6,
      "end_seconds": 192.28,
      "duration_seconds": 1.68,
      "text": "Hold still for me..."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 209.43,
      "end_seconds": 217.47,
      "duration_seconds": 8.04,
      "text": "Okay: heart rate 79, temp 36.7 degrees, pressure 167 over 90. And oxygen saturation is 96 percent."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 218.8,
      "end_seconds": 220.14,
      "duration_seconds": 1.34,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 221.05,
      "end_seconds": 223.83,
      "duration_seconds": 2.78,
      "text": "That's fine, we'll come to it."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 237.82,
      "end_seconds": 246.81,
      "duration_seconds": 8.99,
      "text": "Let me tell you where I've got to. It points towards a possible mini-stroke, which we need to investigate urgently."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 248.41,
      "end_seconds": 255.65,
      "duration_seconds": 7.24,
      "text": "I've been thinking the worst, uh, to be honest. Is it bad?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 256.32,
      "end_seconds": 278.48,
      "duration_seconds": 22.16,
      "text": "I can't promise yet, but most people with a possible mini-stroke, which we need to investigate urgently do well once it's treated properly. Just to be sure I understood. You've had a slight slur in your speech for ten days, severe, and no palpitations or chest pain."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 279.65,
      "end_seconds": 282.32,
      "duration_seconds": 2.67,
      "text": "So, that's what happened, yes."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 283.07,
      "end_seconds": 309.45,
      "duration_seconds": 26.38,
      "text": "I'd like to arrange an ECG for possible stroke. I'd rather check than guess, and this is the quickest way to know more. Don't drive for now, and bring someone with you to the next visit. If the numbness, weakness or speech problem returns, that's the point to come in urgently. We'll catch up after the results are back."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 310.19,
      "end_seconds": 310.89,
      "duration_seconds": 0.7,
      "text": "Okay."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 312.67,
      "end_seconds": 316.55,
      "duration_seconds": 3.88,
      "text": "Alright, take care, and call us if anything changes."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 317.05,
      "end_seconds": 319.05,
      "duration_seconds": 2.0,
      "text": "Thanks so much, doctor."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 320.5,
      "end_seconds": 321.88,
      "duration_seconds": 1.38,
      "text": "All the best."
    }
  ]
}