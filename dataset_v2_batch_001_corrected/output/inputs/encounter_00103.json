{
  "schema_version": "1.0",
  "encounter_id": "00103",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.52,
      "end_seconds": 2.0,
      "duration_seconds": 1.48,
      "text": "Hello, come through."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 2.95,
      "end_seconds": 4.68,
      "duration_seconds": 1.73,
      "text": "Good morning, doctor."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 6.56,
      "end_seconds": 14.33,
      "duration_seconds": 7.77,
      "text": "Okay, so hello, doctor. I hope it's alright if I stay in for this."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 15.97,
      "end_seconds": 19.02,
      "duration_seconds": 3.05,
      "text": "Go ahead, tell me what's happening."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 22.21,
      "end_seconds": 26.32,
      "duration_seconds": 4.11,
      "text": "We came because of swollen ankles in the evening."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 26.84,
      "end_seconds": 29.47,
      "duration_seconds": 2.63,
      "text": "When did you first notice it?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 34.24,
      "end_seconds": 36.77,
      "duration_seconds": 2.53,
      "text": "For two months, I'd say."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 38.52,
      "end_seconds": 42.3,
      "duration_seconds": 3.78,
      "text": "Is there anything that takes the edge off?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 43.14,
      "end_seconds": 47.2,
      "duration_seconds": 4.06,
      "text": "It settles a little with raising the legs."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 49.21,
      "end_seconds": 51.76,
      "duration_seconds": 2.55,
      "text": "Is it mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 52.92,
      "end_seconds": 54.73,
      "duration_seconds": 1.81,
      "text": "Mild, I'd say."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 55.54,
      "end_seconds": 59.61,
      "duration_seconds": 4.07,
      "text": "Does anything bring it on or make it worse?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 61.63,
      "end_seconds": 64.96,
      "duration_seconds": 3.33,
      "text": "Standing all day definitely sets it off."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 65.74,
      "end_seconds": 69.5,
      "duration_seconds": 3.76,
      "text": "Anything that tends to go along with it?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 71.31,
      "end_seconds": 87.73,
      "duration_seconds": 16.42,
      "text": "When it starts I tend to get a heavy feeling in the legs as well. I've also had a flushed face sometimes. As for flushed face sometimes, a seven out of ten, I suppose."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 89.71,
      "end_seconds": 92.04,
      "duration_seconds": 2.33,
      "text": "What's your current medication list?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 97.17,
      "end_seconds": 102.01,
      "duration_seconds": 4.84,
      "text": "Glycomet, 500 milligrams, twice a day for my sugar."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 102.93,
      "end_seconds": 111.14,
      "duration_seconds": 8.21,
      "text": "It's meant to be twice a day, though I don't see he take it every time."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 112.12,
      "end_seconds": 116.86,
      "duration_seconds": 4.74,
      "text": "Do you have any allergies to medicines, food, anything at all?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 118.49,
      "end_seconds": 121.63,
      "duration_seconds": 3.14,
      "text": "I've never been told I have allergies."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 122.48,
      "end_seconds": 128.53,
      "duration_seconds": 6.05,
      "text": "I'm not sure that's right. I seem to recall a problem with ibuprofen."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 130.06,
      "end_seconds": 133.28,
      "duration_seconds": 3.22,
      "text": "Maybe, but I don't recall it."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 134.19,
      "end_seconds": 143.17,
      "duration_seconds": 8.98,
      "text": "Alright, so that's unclear. I'll record what each of you said. Moving on to your background, any past medical history?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 144.33,
      "end_seconds": 149.52,
      "duration_seconds": 5.19,
      "text": "High blood pressure, for nearly five years. Diabetes, for two years."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 151.23,
      "end_seconds": 159.21,
      "duration_seconds": 7.98,
      "text": "Right, so high blood pressure is already on your record. We'll keep that in mind today. Do you live alone?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 160.32,
      "end_seconds": 163.32,
      "duration_seconds": 3.0,
      "text": "Yes, I live on my own."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 164.41,
      "end_seconds": 166.23,
      "duration_seconds": 1.82,
      "text": "Okay, how's your diet?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 167.47,
      "end_seconds": 168.84,
      "duration_seconds": 1.37,
      "text": "I'm mostly vegetarian."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 169.4,
      "end_seconds": 172.45,
      "duration_seconds": 3.05,
      "text": "Have you ever been under the knife?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 175.94,
      "end_seconds": 180.18,
      "duration_seconds": 4.24,
      "text": "I had my appendix out about eight years ago."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 181.23,
      "end_seconds": 185.9,
      "duration_seconds": 4.67,
      "text": "Any chest pain, weight gain or breathlessness lying flat at all?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 186.48,
      "end_seconds": 188.42,
      "duration_seconds": 1.94,
      "text": "No, none of those."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 190.21,
      "end_seconds": 193.97,
      "duration_seconds": 3.76,
      "text": "Alright, did you get reduced urine or calf pain?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 196.0,
      "end_seconds": 197.7,
      "duration_seconds": 1.7,
      "text": "No, nothing there."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 199.19,
      "end_seconds": 203.39,
      "duration_seconds": 4.2,
      "text": "What about one leg more swollen than the other?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 204.26,
      "end_seconds": 210.36,
      "duration_seconds": 6.1,
      "text": "Nope, uh, no one leg more swollen than the other."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 211.78,
      "end_seconds": 216.03,
      "duration_seconds": 4.25,
      "text": "Any change in your bowel habit or your stomach generally?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 217.16,
      "end_seconds": 218.62,
      "duration_seconds": 1.46,
      "text": "Nothing unusual, no."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 219.18,
      "end_seconds": 222.88,
      "duration_seconds": 3.7,
      "text": "Anything with your nerves, like weakness or numbness?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 226.39,
      "end_seconds": 228.41,
      "duration_seconds": 2.02,
      "text": "No, that's all normal."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_4",
      "role": "NURSE",
      "start_seconds": 237.81,
      "end_seconds": 248.2,
      "duration_seconds": 10.39,
      "text": "Here are the numbers, doctor. Pulse 77, SpO2 98 percent on room air, pressure 164 over 99, respiratory rate 17, temperature is 36.7 degrees."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 248.99,
      "end_seconds": 249.69,
      "duration_seconds": 0.7,
      "text": "Thanks."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 252.24,
      "end_seconds": 255.36,
      "duration_seconds": 3.12,
      "text": "Let me examine, it won't take long."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 262.64,
      "end_seconds": 263.34,
      "duration_seconds": 0.7,
      "text": "Fine."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 265.12,
      "end_seconds": 267.47,
      "duration_seconds": 2.35,
      "text": "Let me look at this properly."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 281.15,
      "end_seconds": 285.42,
      "duration_seconds": 4.27,
      "text": "Chest is clear and the neck veins aren't raised."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 287.04,
      "end_seconds": 289.86,
      "duration_seconds": 2.82,
      "text": "Let me look at this properly."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 306.84,
      "end_seconds": 311.23,
      "duration_seconds": 4.39,
      "text": "Mild pitting swelling around both ankles, equal on both sides."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 313.91,
      "end_seconds": 316.93,
      "duration_seconds": 3.02,
      "text": "That's all I need, thank you."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 328.55,
      "end_seconds": 351.96,
      "duration_seconds": 23.41,
      "text": "Okay, so my impression is this: It fits best with ankle swelling possibly from a blood pressure tablet. We shouldn't forget heart-related fluid retention. Let me repeat that back to make sure. You've had swollen ankles in the evening for two months, mild, and no breathlessness lying flat or reduced urine."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 352.63,
      "end_seconds": 354.77,
      "duration_seconds": 2.14,
      "text": "Yes, you've got it."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 355.37,
      "end_seconds": 373.03,
      "duration_seconds": 17.66,
      "text": "Let's get kidney function tests, for leg swelling. I think a urine protein test makes sense here, for leg swelling. Raise your legs when you're sitting and try compression socks. Let's review you in three weeks. Right, that's all. Go gently."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 373.74,
      "end_seconds": 375.85,
      "duration_seconds": 2.11,
      "text": "Thanks, that was helpful."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 376.99,
      "end_seconds": 378.2,
      "duration_seconds": 1.21,
      "text": "Bye for now."
    }
  ]
}