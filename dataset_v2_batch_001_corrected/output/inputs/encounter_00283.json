{
  "schema_version": "1.0",
  "encounter_id": "00283",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.39,
      "end_seconds": 9.66,
      "duration_seconds": 8.27,
      "text": "Hi, doctor, I brought my bag, is it fine to leave it here?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 10.76,
      "end_seconds": 15.41,
      "duration_seconds": 4.65,
      "text": "No trouble at all, come in. What's been bothering you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 18.21,
      "end_seconds": 24.65,
      "duration_seconds": 6.44,
      "text": "I've been dealing with a lump on the side of my neck."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 30.45,
      "end_seconds": 32.65,
      "duration_seconds": 2.2,
      "text": "What's your current medication list?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 33.74,
      "end_seconds": 37.79,
      "duration_seconds": 4.05,
      "text": "Amlodipine, 5 milligrams, maybe, once a day."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 42.76,
      "end_seconds": 47.67,
      "duration_seconds": 4.91,
      "text": "Did you happen to bring the box or the paperwork?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 49.66,
      "end_seconds": 55.94,
      "duration_seconds": 6.28,
      "text": "No, it's at home. I take clopidogrel, 75 milligrams, once a day."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 57.3,
      "end_seconds": 59.72,
      "duration_seconds": 2.42,
      "text": "How far back does it go?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 60.79,
      "end_seconds": 65.94,
      "duration_seconds": 5.15,
      "text": "Okay, you know, so it's been about four days now."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 67.69,
      "end_seconds": 70.51,
      "duration_seconds": 2.82,
      "text": "Would you call it mild or bad?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 71.72,
      "end_seconds": 74.4,
      "duration_seconds": 2.68,
      "text": "I, I'd call it severe."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 76.08,
      "end_seconds": 78.68,
      "duration_seconds": 2.6,
      "text": "Has there been night sweats too?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 79.59,
      "end_seconds": 88.64,
      "duration_seconds": 9.05,
      "text": "Yes, about the same, ten days. Well, you know, with night sweats, I'd call it mild."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 90.41,
      "end_seconds": 93.96,
      "duration_seconds": 3.55,
      "text": "Have you been feeling feverish in the evenings?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 95.41,
      "end_seconds": 102.64,
      "duration_seconds": 7.23,
      "text": "Yes, I have. With feeling feverish in the evenings, it happens every other day."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 103.38,
      "end_seconds": 111.4,
      "duration_seconds": 8.02,
      "text": "Have you had a lump on the side of your neck before, or is this the first time?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 113.37,
      "end_seconds": 122.34,
      "duration_seconds": 8.97,
      "text": "Yes, something like this happened about six months ago, and it went away on its own."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 138.79,
      "end_seconds": 145.6,
      "duration_seconds": 6.81,
      "text": "Let me check a few things. Any difficulty swallowing, pain in the lump or weight loss?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 146.97,
      "end_seconds": 150.21,
      "duration_seconds": 3.24,
      "text": "No, you know, none of those."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 152.28,
      "end_seconds": 153.85,
      "duration_seconds": 1.57,
      "text": "How about tooth problems?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 155.19,
      "end_seconds": 157.29,
      "duration_seconds": 2.1,
      "text": "No tooth problems, thankfully."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 158.7,
      "end_seconds": 160.35,
      "duration_seconds": 1.65,
      "text": "How's your breathing otherwise?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 160.87,
      "end_seconds": 162.94,
      "duration_seconds": 2.07,
      "text": "No problems with breathing."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 164.59,
      "end_seconds": 167.53,
      "duration_seconds": 2.94,
      "text": "Have you ever been under the knife?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 169.1,
      "end_seconds": 174.48,
      "duration_seconds": 5.38,
      "text": "I mean, I had my gallbladder removed in 2016."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 186.4,
      "end_seconds": 188.44,
      "duration_seconds": 2.04,
      "text": "Who do you live with?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 189.81,
      "end_seconds": 195.98,
      "duration_seconds": 6.17,
      "text": "I live with my family, my husband and two kids."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 197.95,
      "end_seconds": 199.24,
      "duration_seconds": 1.29,
      "text": "How about exercise?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 200.44,
      "end_seconds": 203.99,
      "duration_seconds": 3.55,
      "text": "Not really, I don't get much exercise."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 205.75,
      "end_seconds": 207.31,
      "duration_seconds": 1.56,
      "text": "Are you still working?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 208.02,
      "end_seconds": 213.13,
      "duration_seconds": 5.11,
      "text": "I'm retired now, I was a clerk for years."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 228.65,
      "end_seconds": 234.17,
      "duration_seconds": 5.52,
      "text": "Do you have any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 234.94,
      "end_seconds": 240.67,
      "duration_seconds": 5.73,
      "text": "I've got high blood pressure. Heart disease, for nearly five years."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 246.65,
      "end_seconds": 254.63,
      "duration_seconds": 7.98,
      "text": "Okay, yes, heart disease is known to us, good to have that clear. I'll check your pressure and pulse."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 261.03,
      "end_seconds": 261.93,
      "duration_seconds": 0.9,
      "text": "One second..."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 281.0,
      "end_seconds": 293.2,
      "duration_seconds": 12.2,
      "text": "Okay: weight 58 kilos, respiratory rate 16. And height 161 centimetres, temperature is 36.9 degrees, oxygen saturation is 99 percent, pressure 114 over 74, pulse 66."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 294.58,
      "end_seconds": 297.76,
      "duration_seconds": 3.18,
      "text": "I'll examine you now, bear with me."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 299.17,
      "end_seconds": 301.49,
      "duration_seconds": 2.32,
      "text": "Take your time, no rush."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 312.57,
      "end_seconds": 317.48,
      "duration_seconds": 4.91,
      "text": "I can't feel other glands in the neck, armpits or groin."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 320.07,
      "end_seconds": 334.4,
      "duration_seconds": 14.33,
      "text": "Okay, finished. Having listened and examined, I think we're dealing with a reactive lymph node after a throat infection at this stage. It could also be a persistent infection, so we'll keep that open."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 335.46,
      "end_seconds": 341.24,
      "duration_seconds": 5.78,
      "text": "I've been thinking the worst, to be honest. Is it bad?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 342.07,
      "end_seconds": 360.3,
      "duration_seconds": 18.23,
      "text": "I understand the worry. At the moment I'd say it's a reactive lymph node after a throat infection, and we'll know more once the blood tests is back. I'll request blood tests, it'll help with neck lump."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 361.18,
      "end_seconds": 362.85,
      "duration_seconds": 1.67,
      "text": "That sounds sensible."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 364.28,
      "end_seconds": 384.36,
      "duration_seconds": 20.08,
      "text": "Let's get an ultrasound of the neck, for neck lump. Check the lump once a week and let me know if it grows or becomes hard. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 388.16,
      "end_seconds": 392.41,
      "duration_seconds": 4.25,
      "text": "Hmm, yes, I'll keep that in mind."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 393.14,
      "end_seconds": 402.9,
      "duration_seconds": 9.76,
      "text": "One warning sign to remember: the symptoms get worse. In that case don't wait. I'll want another look in three weeks."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 404.71,
      "end_seconds": 410.22,
      "duration_seconds": 5.51,
      "text": "Hmm, you know, yes, I can do that."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 411.42,
      "end_seconds": 413.58,
      "duration_seconds": 2.16,
      "text": "Do you have any questions?"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 414.65,
      "end_seconds": 419.66,
      "duration_seconds": 5.01,
      "text": "I mean, uh, nothing more from me, thanks."
    }
  ]
}