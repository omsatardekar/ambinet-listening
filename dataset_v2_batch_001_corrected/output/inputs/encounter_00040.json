{
  "schema_version": "1.0",
  "encounter_id": "00040",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.3,
      "end_seconds": 6.82,
      "duration_seconds": 5.52,
      "text": "Good afternoon, doctor, the receptionist said you'd see me now."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.56,
      "end_seconds": 12.06,
      "duration_seconds": 3.5,
      "text": "Yes, do sit. Tell me what's been happening."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 14.03,
      "end_seconds": 18.96,
      "duration_seconds": 4.93,
      "text": "So the thing is, I've got tingling in my fingers."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 20.35,
      "end_seconds": 21.91,
      "duration_seconds": 1.56,
      "text": "When did it begin?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 22.62,
      "end_seconds": 25.16,
      "duration_seconds": 2.54,
      "text": "It's been five days now."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 26.01,
      "end_seconds": 30.66,
      "duration_seconds": 4.65,
      "text": "What about an ache in the wrist, have you noticed that?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 31.85,
      "end_seconds": 48.94,
      "duration_seconds": 17.09,
      "text": "Yes, about the same, six months. With ache in the wrist, I'd say moderate. It's a couple of times a week. Oh, and numbness in the thumb and first two fingers."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 50.61,
      "end_seconds": 54.19,
      "duration_seconds": 3.58,
      "text": "Does it happen all the time or in spells?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 54.83,
      "end_seconds": 66.56,
      "duration_seconds": 11.73,
      "text": "Honestly, once or twice a day. I've been waking up at night with pins and needles too, you know, since Monday."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 67.94,
      "end_seconds": 71.63,
      "duration_seconds": 3.69,
      "text": "Let's go through your medication. What are you taking?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 73.68,
      "end_seconds": 76.13,
      "duration_seconds": 2.45,
      "text": "I'm on thyroxine, every morning."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 77.41,
      "end_seconds": 79.88,
      "duration_seconds": 2.47,
      "text": "And what strength is that?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 81.7,
      "end_seconds": 83.2,
      "duration_seconds": 1.5,
      "text": "It's 75 micrograms."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 85.29,
      "end_seconds": 88.03,
      "duration_seconds": 2.74,
      "text": "Since when have you been taking it?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 88.84,
      "end_seconds": 92.38,
      "duration_seconds": 3.54,
      "text": "For two months. Metformin, twice a day."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 93.05,
      "end_seconds": 95.1,
      "duration_seconds": 2.05,
      "text": "How much do you take?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 96.1,
      "end_seconds": 115.26,
      "duration_seconds": 19.16,
      "text": "500 milligrams, I think that's what's on the box. Atorvastatin. I take it 20 milligrams, at night. I do miss it now and then, to be fair. I'd been on rosuvastatin, not any more though, I stopped."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 131.23,
      "end_seconds": 133.4,
      "duration_seconds": 2.17,
      "text": "Do you get any exercise?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 135.25,
      "end_seconds": 139.78,
      "duration_seconds": 4.53,
      "text": "I walk for about half an hour most days."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 141.4,
      "end_seconds": 142.97,
      "duration_seconds": 1.57,
      "text": "What's your diet like?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 144.31,
      "end_seconds": 148.76,
      "duration_seconds": 4.45,
      "text": "I eat out quite a lot, to be honest."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 157.16,
      "end_seconds": 160.21,
      "duration_seconds": 3.05,
      "text": "Before I prescribe anything, any allergies?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 162.16,
      "end_seconds": 173.07,
      "duration_seconds": 10.91,
      "text": "Right, I think I reacted to some antibiotic once, years ago. I don't remember which one, or what happened exactly."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 174.43,
      "end_seconds": 178.95,
      "duration_seconds": 4.52,
      "text": "Any relatives with health problems I should be aware of?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 181.03,
      "end_seconds": 187.11,
      "duration_seconds": 6.08,
      "text": "My uncle had colon cancer. Okay, you know, so my mother has migraines."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 200.93,
      "end_seconds": 203.36,
      "duration_seconds": 2.43,
      "text": "Any surgery in your history?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 204.77,
      "end_seconds": 209.05,
      "duration_seconds": 4.28,
      "text": "I had my appendix out about eight years ago."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 209.94,
      "end_seconds": 218.42,
      "duration_seconds": 8.48,
      "text": "What about your general health, any conditions you're being treated for? I ask because it helps me narrow things down."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 220.23,
      "end_seconds": 225.21,
      "duration_seconds": 4.98,
      "text": "I have an underactive thyroid, for about ten years."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 226.8,
      "end_seconds": 227.5,
      "duration_seconds": 0.7,
      "text": "Understood."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 231.48,
      "end_seconds": 232.9,
      "duration_seconds": 1.42,
      "text": "I've got diabetes."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 234.38,
      "end_seconds": 235.26,
      "duration_seconds": 0.88,
      "text": "Anything more?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 236.86,
      "end_seconds": 238.81,
      "duration_seconds": 1.95,
      "text": "I've got high cholesterol."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 240.69,
      "end_seconds": 250.0,
      "duration_seconds": 9.31,
      "text": "Understood. Alright, diabetes and high cholesterol, that matches what I have here. Any headache or weakness in the legs at all?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 250.71,
      "end_seconds": 255.49,
      "duration_seconds": 4.78,
      "text": "No headache or weakness in the legs, none of it."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 257.3,
      "end_seconds": 262.04,
      "duration_seconds": 4.74,
      "text": "Have you had any neck pain, trouble walking or bladder problems?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 263.81,
      "end_seconds": 269.25,
      "duration_seconds": 5.44,
      "text": "No neck pain, trouble walking or bladder problems, none of it."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 270.52,
      "end_seconds": 272.72,
      "duration_seconds": 2.2,
      "text": "Any swelling in the joints?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 274.31,
      "end_seconds": 277.01,
      "duration_seconds": 2.7,
      "text": "No. No swelling in the joints."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 278.69,
      "end_seconds": 281.97,
      "duration_seconds": 3.28,
      "text": "How about your heart, any problems like that?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 283.15,
      "end_seconds": 284.5,
      "duration_seconds": 1.35,
      "text": "Nothing like that."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 286.11,
      "end_seconds": 288.56,
      "duration_seconds": 2.45,
      "text": "Any breathing difficulties apart from this?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 289.2,
      "end_seconds": 292.49,
      "duration_seconds": 3.29,
      "text": "Okay, so no problems with breathing."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 293.99,
      "end_seconds": 296.37,
      "duration_seconds": 2.38,
      "text": "Let me measure a few things."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 303.64,
      "end_seconds": 305.22,
      "duration_seconds": 1.58,
      "text": "Rest your hand here..."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 319.84,
      "end_seconds": 328.53,
      "duration_seconds": 8.69,
      "text": "Okay: temperature 36.7, BP is 123 over 70. And heart rate 64, SpO2 97 percent on room air."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 330.2,
      "end_seconds": 332.7,
      "duration_seconds": 2.5,
      "text": "Let's do the physical part now."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 334.26,
      "end_seconds": 334.96,
      "duration_seconds": 0.7,
      "text": "Fine."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 336.84,
      "end_seconds": 339.02,
      "duration_seconds": 2.18,
      "text": "Take your time, no rush."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 356.5,
      "end_seconds": 360.76,
      "duration_seconds": 4.26,
      "text": "Bending the wrist for a minute brings on the numbness."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 362.25,
      "end_seconds": 364.58,
      "duration_seconds": 2.33,
      "text": "Let me look at this properly."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 372.26,
      "end_seconds": 375.04,
      "duration_seconds": 2.78,
      "text": "Tapping over the wrist reproduces the tingling."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 378.46,
      "end_seconds": 414.35,
      "duration_seconds": 35.89,
      "text": "That's all I need, thank you. Right, here's what I'm thinking. The most likely explanation is carpal tunnel syndrome. I can't rule out a pinched nerve in the neck yet. I think a blood sugar test makes sense here, for neuropathy screen. I'd like to arrange a nerve conduction study for hand numbness. Take short breaks from typing and keep the wrist straight. Do get help quickly if the symptoms get worse."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 416.3,
      "end_seconds": 420.11,
      "duration_seconds": 3.81,
      "text": "See me again after the results are back."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 420.95,
      "end_seconds": 424.68,
      "duration_seconds": 3.73,
      "text": "Alright, I'll put it in my diary."
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 428.11,
      "end_seconds": 431.4,
      "duration_seconds": 3.29,
      "text": "Okay, I think we're finished. Is everything clear?"
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 432.18,
      "end_seconds": 435.63,
      "duration_seconds": 3.45,
      "text": "One thing: no, actually that's all. Thanks."
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 437.67,
      "end_seconds": 438.97,
      "duration_seconds": 1.3,
      "text": "See you then."
    }
  ]
}