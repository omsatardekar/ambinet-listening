{
  "schema_version": "1.0",
  "encounter_id": "00364",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.76,
      "end_seconds": 8.88,
      "duration_seconds": 8.12,
      "text": "Hi doctor, sorry, the lift was out and I had to take the stairs."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 10.14,
      "end_seconds": 14.37,
      "duration_seconds": 4.23,
      "text": "Right on time. Sit, please. How can I help?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 15.92,
      "end_seconds": 19.56,
      "duration_seconds": 3.64,
      "text": "Thank you for fitting us in, doctor."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 21.21,
      "end_seconds": 25.91,
      "duration_seconds": 4.7,
      "text": "Of course, please stay. It's helpful to have you here."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 27.8,
      "end_seconds": 34.68,
      "duration_seconds": 6.88,
      "text": "Um, so... my face drooping on the right side. That's why I came."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 38.44,
      "end_seconds": 41.04,
      "duration_seconds": 2.6,
      "text": "I'll take a few measurements first."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 53.83,
      "end_seconds": 55.44,
      "duration_seconds": 1.61,
      "text": "Hold still for me..."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 75.42,
      "end_seconds": 83.03,
      "duration_seconds": 7.61,
      "text": "Okay: BP is 113 over 73, saturation 98 percent, heart rate 86, temp 36.8 degrees."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 84.83,
      "end_seconds": 86.34,
      "duration_seconds": 1.51,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 87.62,
      "end_seconds": 90.68,
      "duration_seconds": 3.06,
      "text": "I'll interpret it once I've examined you."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 103.11,
      "end_seconds": 105.78,
      "duration_seconds": 2.67,
      "text": "Since when have you had this?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 107.87,
      "end_seconds": 111.57,
      "duration_seconds": 3.7,
      "text": "About about a month, give or take."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 113.57,
      "end_seconds": 117.84,
      "duration_seconds": 4.27,
      "text": "It was closer to about two months, doctor."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 119.41,
      "end_seconds": 124.25,
      "duration_seconds": 4.84,
      "text": "Okay, so roughly one to two months. Is that right?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 125.97,
      "end_seconds": 127.08,
      "duration_seconds": 1.11,
      "text": "Yeah, roughly."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 127.71,
      "end_seconds": 132.0,
      "duration_seconds": 4.29,
      "text": "Okay, what about food tasting odd, have you noticed that?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 134.07,
      "end_seconds": 140.01,
      "duration_seconds": 5.94,
      "text": "Yes, for three weeks. About food tasting odd, I'd call it severe."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 142.02,
      "end_seconds": 144.66,
      "duration_seconds": 2.64,
      "text": "Any a watery eye as well?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 145.9,
      "end_seconds": 147.99,
      "duration_seconds": 2.09,
      "text": "Yes, for two weeks."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 148.96,
      "end_seconds": 151.16,
      "duration_seconds": 2.2,
      "text": "Have you had any headache?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 151.83,
      "end_seconds": 155.12,
      "duration_seconds": 3.29,
      "text": "Uh, not at all, no headache."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 156.14,
      "end_seconds": 161.17,
      "duration_seconds": 5.03,
      "text": "Actually, doctor, I did notice headache. He doesn't always say."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 161.78,
      "end_seconds": 168.69,
      "duration_seconds": 6.91,
      "text": "No, I don't think I did. Maybe a little, I'm not sure."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 169.22,
      "end_seconds": 174.43,
      "duration_seconds": 5.21,
      "text": "Alright, I'll note both what you've said and what you've noticed."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 174.74,
      "end_seconds": 180.07,
      "duration_seconds": 5.33,
      "text": "Hm, okay. Did you get slurred speech, hearing changes or recent tick bite?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 181.23,
      "end_seconds": 183.79,
      "duration_seconds": 2.56,
      "text": "No, I'd have mentioned it."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 184.62,
      "end_seconds": 188.46,
      "duration_seconds": 3.84,
      "text": "Have you had any rash around the ear?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 190.08,
      "end_seconds": 192.93,
      "duration_seconds": 2.85,
      "text": "No rash around the ear, thankfully."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 194.67,
      "end_seconds": 198.02,
      "duration_seconds": 3.35,
      "text": "On the cardiac side, anything I should know?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 202.96,
      "end_seconds": 205.62,
      "duration_seconds": 2.66,
      "text": "No, nothing with my heart."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 206.66,
      "end_seconds": 209.39,
      "duration_seconds": 2.73,
      "text": "Any problems with your joints or muscles?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 209.91,
      "end_seconds": 212.26,
      "duration_seconds": 2.35,
      "text": "No, joints are fine."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 212.92,
      "end_seconds": 214.67,
      "duration_seconds": 1.75,
      "text": "So, any previous surgeries?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 215.74,
      "end_seconds": 219.42,
      "duration_seconds": 3.68,
      "text": "Uh, no, never had any surgery."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 220.48,
      "end_seconds": 222.93,
      "duration_seconds": 2.45,
      "text": "What medicines do you take regularly?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 223.96,
      "end_seconds": 230.37,
      "duration_seconds": 6.41,
      "text": "Glimepiride. I take it 2 milligrams, maybe, before breakfast for my sugar."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 232.21,
      "end_seconds": 236.74,
      "duration_seconds": 4.53,
      "text": "Have you got the box or the prescription on you?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 238.2,
      "end_seconds": 245.92,
      "duration_seconds": 7.72,
      "text": "No, um, it's at home. I take amlodipine, 5 milligrams, once a day."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 247.4,
      "end_seconds": 249.77,
      "duration_seconds": 2.37,
      "text": "How long have you taken that?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 251.3,
      "end_seconds": 252.67,
      "duration_seconds": 1.37,
      "text": "About six months."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 254.17,
      "end_seconds": 258.01,
      "duration_seconds": 3.84,
      "text": "Any long-term health problems I should know about?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 259.2,
      "end_seconds": 273.04,
      "duration_seconds": 13.84,
      "text": "I have diabetes, for nearly five years. I have high blood pressure, for two years. I told myself I'd wait and see, and here I am."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 274.69,
      "end_seconds": 275.73,
      "duration_seconds": 1.04,
      "text": "Right, right."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 280.96,
      "end_seconds": 290.91,
      "duration_seconds": 9.95,
      "text": "Okay, so I've had an enlarged prostate for five years now. I'd rather know what's going on than keep guessing."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 294.28,
      "end_seconds": 295.79,
      "duration_seconds": 1.51,
      "text": "Right, any more?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 297.05,
      "end_seconds": 303.69,
      "duration_seconds": 6.64,
      "text": "Yes, diabetes and high blood pressure are known to us, good to have that clear."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 319.28,
      "end_seconds": 329.18,
      "duration_seconds": 9.9,
      "text": "Do you have any allergies to medicines, food, anything at all? Bear with me, I'm just building up the picture."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 330.85,
      "end_seconds": 335.46,
      "duration_seconds": 4.61,
      "text": "Yeah, no allergies that I know of, no."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 337.09,
      "end_seconds": 341.95,
      "duration_seconds": 4.86,
      "text": "What about family history, any illnesses that run in the family?"
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 343.6,
      "end_seconds": 348.37,
      "duration_seconds": 4.77,
      "text": "Well, my uncle had colon cancer. My brother has asthma."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 349.09,
      "end_seconds": 351.36,
      "duration_seconds": 2.27,
      "text": "Do you get any exercise?"
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 352.66,
      "end_seconds": 357.1,
      "duration_seconds": 4.44,
      "text": "I walk for about half an hour most days."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 358.59,
      "end_seconds": 360.53,
      "duration_seconds": 1.94,
      "text": "Do you live alone?"
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 361.51,
      "end_seconds": 364.49,
      "duration_seconds": 2.98,
      "text": "Yes, I live on my own."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 366.8,
      "end_seconds": 370.22,
      "duration_seconds": 3.42,
      "text": "Come over here and I'll have a look."
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 371.58,
      "end_seconds": 373.65,
      "duration_seconds": 2.07,
      "text": "Hold that position for me."
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 386.65,
      "end_seconds": 392.95,
      "duration_seconds": 6.3,
      "text": "Left side of the face moves normally, and arm and leg strength is normal."
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 393.89,
      "end_seconds": 395.84,
      "duration_seconds": 1.95,
      "text": "Hold that position for me."
    },
    {
      "segment_id": "SEG0059",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 403.16,
      "end_seconds": 408.42,
      "duration_seconds": 5.26,
      "text": "You can't wrinkle the right forehead or puff out the right cheek."
    },
    {
      "segment_id": "SEG0060",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 411.74,
      "end_seconds": 433.64,
      "duration_seconds": 21.9,
      "text": "Thanks, please take a seat again. Putting it all together, my working impression is a Bell's palsy pattern. I'd also keep a stroke in mind. Just to be sure I understood. You've had your face drooping on the right side, and no hearing changes."
    },
    {
      "segment_id": "SEG0061",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 434.72,
      "end_seconds": 436.32,
      "duration_seconds": 1.6,
      "text": "Mm, that's right."
    },
    {
      "segment_id": "SEG0062",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 450.55,
      "end_seconds": 461.9,
      "duration_seconds": 11.35,
      "text": "I'm sending you for blood sugar testing because of facial palsy. I'm prescribing prednisolone, 50 milligrams, once a day, for seven days. It's for facial weakness."
    },
    {
      "segment_id": "SEG0063",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 462.89,
      "end_seconds": 465.07,
      "duration_seconds": 2.18,
      "text": "Fine, I'll start it."
    },
    {
      "segment_id": "SEG0064",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 465.89,
      "end_seconds": 490.17,
      "duration_seconds": 24.28,
      "text": "Use lubricating drops through the day and tape the eye shut at night. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose. If the weakness spreads to your arm or leg, or your speech changes, that's the point to come in urgently."
    },
    {
      "segment_id": "SEG0065",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 492.24,
      "end_seconds": 495.08,
      "duration_seconds": 2.84,
      "text": "Yes, I'll watch for that."
    },
    {
      "segment_id": "SEG0066",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 495.84,
      "end_seconds": 503.17,
      "duration_seconds": 7.33,
      "text": "Please come and see me in a week. Good. Let us know how you get on."
    },
    {
      "segment_id": "SEG0067",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 505.24,
      "end_seconds": 507.9,
      "duration_seconds": 2.66,
      "text": "Alright, thanks. Bye for now."
    },
    {
      "segment_id": "SEG0068",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 508.56,
      "end_seconds": 509.26,
      "duration_seconds": 0.7,
      "text": "Goodbye."
    }
  ]
}