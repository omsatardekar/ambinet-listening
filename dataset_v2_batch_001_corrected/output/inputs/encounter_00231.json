{
  "schema_version": "1.0",
  "encounter_id": "00231",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.18,
      "end_seconds": 3.04,
      "duration_seconds": 1.86,
      "text": "Morning! Make yourself comfortable."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 3.74,
      "end_seconds": 4.44,
      "duration_seconds": 0.7,
      "text": "Hi."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 5.19,
      "end_seconds": 9.34,
      "duration_seconds": 4.15,
      "text": "Doctor, I'm just here to help with the details."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 9.98,
      "end_seconds": 14.87,
      "duration_seconds": 4.89,
      "text": "Absolutely, come and sit beside them. Right, what's the trouble?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 16.56,
      "end_seconds": 28.77,
      "duration_seconds": 12.21,
      "text": "Um, so... a dry cough and fever. That's why I came. I kept putting it off, which I know isn't sensible."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 29.37,
      "end_seconds": 32.3,
      "duration_seconds": 2.93,
      "text": "How far back does it go?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 33.56,
      "end_seconds": 36.69,
      "duration_seconds": 3.13,
      "text": "About three weeks, give or take."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 37.43,
      "end_seconds": 40.95,
      "duration_seconds": 3.52,
      "text": "Hm, I'd say more like a month."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 41.67,
      "end_seconds": 46.22,
      "duration_seconds": 4.55,
      "text": "Okay, so roughly three to four weeks. Is that right?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 50.03,
      "end_seconds": 52.08,
      "duration_seconds": 2.05,
      "text": "That sounds about right."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 53.55,
      "end_seconds": 58.58,
      "duration_seconds": 5.03,
      "text": "Okay, give me more detail on it, whatever comes to mind."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 59.25,
      "end_seconds": 64.38,
      "duration_seconds": 5.13,
      "text": "I'd say a few times a day. Paracetamol helps a bit."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 64.97,
      "end_seconds": 71.6,
      "duration_seconds": 6.63,
      "text": "I was just going to say that the main thing is—"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_4",
      "role": "NURSE",
      "start_seconds": 71.7,
      "end_seconds": 78.57,
      "duration_seconds": 6.87,
      "text": "Sorry to cut in, doctor, quick question: shall I bring the trolley in now or later?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 80.39,
      "end_seconds": 82.79,
      "duration_seconds": 2.4,
      "text": "Later, thanks. Please go on."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 84.77,
      "end_seconds": 93.96,
      "duration_seconds": 9.19,
      "text": "So, I've also had tiredness. I've also been losing my sense of smell, for four weeks."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 94.91,
      "end_seconds": 97.31,
      "duration_seconds": 2.4,
      "text": "How much is it bothering you?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 98.62,
      "end_seconds": 105.43,
      "duration_seconds": 6.81,
      "text": "I'd say severe. Oh, and a sore throat. Had that since last weekend."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 106.94,
      "end_seconds": 109.53,
      "duration_seconds": 2.59,
      "text": "How much is it bothering you?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 110.62,
      "end_seconds": 114.31,
      "duration_seconds": 3.69,
      "text": "A seven out of ten, I suppose."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 115.33,
      "end_seconds": 117.68,
      "duration_seconds": 2.35,
      "text": "What's your current medication list?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 118.64,
      "end_seconds": 121.6,
      "duration_seconds": 2.96,
      "text": "I'm on Asthalin inhaler, when needed."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 123.09,
      "end_seconds": 130.67,
      "duration_seconds": 7.58,
      "text": "She is supposed to take it when needed, but I can't say she always does."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 132.16,
      "end_seconds": 136.83,
      "duration_seconds": 4.67,
      "text": "Telmisartan, 40 milligrams, once a day for my pressure."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 138.29,
      "end_seconds": 146.32,
      "duration_seconds": 8.03,
      "text": "Right, it's a... um, I can't remember what it's called. It's a small white one."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 146.91,
      "end_seconds": 149.42,
      "duration_seconds": 2.51,
      "text": "Do you remember what it's for?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 151.08,
      "end_seconds": 170.05,
      "duration_seconds": 18.97,
      "text": "For the stent, I believe. My wife sets them out for me, I just take what I'm given. It's paracetamol, 500 milligrams, when needed. I was on aspirin before. I stopped taking it."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 171.52,
      "end_seconds": 174.27,
      "duration_seconds": 2.75,
      "text": "Any diagnoses you've been given before?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 174.85,
      "end_seconds": 184.56,
      "duration_seconds": 9.71,
      "text": "I have asthma, for about ten years. I've got high blood pressure. I've had heart disease, yes."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 186.07,
      "end_seconds": 193.71,
      "duration_seconds": 7.64,
      "text": "Okay. Okay, I can see asthma and high blood pressure in your file as well. What about alcohol?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 194.88,
      "end_seconds": 197.18,
      "duration_seconds": 2.3,
      "text": "I don't drink at all."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 198.65,
      "end_seconds": 201.81,
      "duration_seconds": 3.16,
      "text": "Okay, and what do you usually eat?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 206.97,
      "end_seconds": 210.29,
      "duration_seconds": 3.32,
      "text": "Mostly home-cooked food, rice and vegetables."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 211.76,
      "end_seconds": 216.56,
      "duration_seconds": 4.8,
      "text": "Are there any allergies on your record that I should check?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 217.93,
      "end_seconds": 227.21,
      "duration_seconds": 9.28,
      "text": "I think I reacted to some antibiotic once, years ago. I don't remember which one, or what happened exactly."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 229.1,
      "end_seconds": 230.28,
      "duration_seconds": 1.18,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 232.11,
      "end_seconds": 237.27,
      "duration_seconds": 5.16,
      "text": "Hmm, I had a bypass operation six years ago."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 238.33,
      "end_seconds": 243.35,
      "duration_seconds": 5.02,
      "text": "So, have you noticed chest pain, vomiting, confusion or diarrhoea?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 244.47,
      "end_seconds": 245.99,
      "duration_seconds": 1.52,
      "text": "No, nothing there."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 247.89,
      "end_seconds": 251.01,
      "duration_seconds": 3.12,
      "text": "Have you had rash, by any chance?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 255.21,
      "end_seconds": 256.95,
      "duration_seconds": 1.74,
      "text": "No, no rash."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 257.74,
      "end_seconds": 261.29,
      "duration_seconds": 3.55,
      "text": "Anything on the skin I should know about?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 262.31,
      "end_seconds": 264.5,
      "duration_seconds": 2.19,
      "text": "No, skin's been fine."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 266.13,
      "end_seconds": 269.48,
      "duration_seconds": 3.35,
      "text": "Okay, anything different when you pass water?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 270.95,
      "end_seconds": 273.17,
      "duration_seconds": 2.22,
      "text": "No, that's all fine."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_4",
      "role": "NURSE",
      "start_seconds": 291.32,
      "end_seconds": 296.99,
      "duration_seconds": 5.67,
      "text": "Okay, so the vitals from earlier. Heart rate 99, BP is 112 over 72."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 300.85,
      "end_seconds": 301.75,
      "duration_seconds": 0.9,
      "text": "Okay, noted."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 303.5,
      "end_seconds": 307.14,
      "duration_seconds": 3.64,
      "text": "Come over here and I'll have a look."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 308.33,
      "end_seconds": 309.53,
      "duration_seconds": 1.2,
      "text": "Mm, okay."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 311.29,
      "end_seconds": 312.56,
      "duration_seconds": 1.27,
      "text": "I'll go gently."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 319.74,
      "end_seconds": 321.49,
      "duration_seconds": 1.75,
      "text": "Throat is mildly red."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 322.74,
      "end_seconds": 324.44,
      "duration_seconds": 1.7,
      "text": "Let me press here."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 338.44,
      "end_seconds": 341.94,
      "duration_seconds": 3.5,
      "text": "Chest is clear, no crackles or wheeze."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 346.05,
      "end_seconds": 371.28,
      "duration_seconds": 25.23,
      "text": "Okay, you can sit up. Having listened and examined, this looks most like a viral respiratory illness, possibly COVID-19. It could also be a common cold, so we'll keep that open. I'd also keep influenza in mind. Just to be sure I understood. You've had a dry cough and fever, and no vomiting or chest pain."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 372.32,
      "end_seconds": 374.25,
      "duration_seconds": 1.93,
      "text": "That's what happened, yes."
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 384.25,
      "end_seconds": 409.12,
      "duration_seconds": 24.87,
      "text": "I want a COVID test done, that's for viral respiratory illness. I think a pulse oximeter reading makes sense here, for respiratory symptoms. Stay home until you're fever-free and wear a mask around others for a few days. Let's plan a check in a week. That's everything from me. Any other questions?"
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 414.92,
      "end_seconds": 417.51,
      "duration_seconds": 2.59,
      "text": "All good here. Thank you."
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 419.14,
      "end_seconds": 420.98,
      "duration_seconds": 1.84,
      "text": "Mind how you go."
    }
  ]
}