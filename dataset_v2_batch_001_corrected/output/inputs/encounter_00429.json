{
  "schema_version": "1.0",
  "encounter_id": "00429",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.32,
      "end_seconds": 4.5,
      "duration_seconds": 3.18,
      "text": "Good afternoon. Have a seat and we'll begin."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 5.82,
      "end_seconds": 6.52,
      "duration_seconds": 0.7,
      "text": "Morning."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 8.55,
      "end_seconds": 11.18,
      "duration_seconds": 2.63,
      "text": "In your own words, what's happened?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 11.98,
      "end_seconds": 15.74,
      "duration_seconds": 3.76,
      "text": "Oh, I've been dealing with skipped beats."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 16.96,
      "end_seconds": 19.92,
      "duration_seconds": 2.96,
      "text": "When did you first notice it?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 22.01,
      "end_seconds": 25.81,
      "duration_seconds": 3.8,
      "text": "I've, I've had it since last Tuesday."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 26.33,
      "end_seconds": 31.86,
      "duration_seconds": 5.53,
      "text": "Okay, give me more detail on it, whatever comes to mind."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 32.86,
      "end_seconds": 44.17,
      "duration_seconds": 11.31,
      "text": "Um, it sort of comes and goes. Mostly mild. Right, I've also been feeling anxious about it, for about three months."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 46.21,
      "end_seconds": 50.93,
      "duration_seconds": 4.72,
      "text": "So, any fainting, leg swelling or family history of sudden death?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 52.79,
      "end_seconds": 61.72,
      "duration_seconds": 8.93,
      "text": "Um, I haven't had fainting, leg swelling or family history of sudden death, no."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 63.72,
      "end_seconds": 65.4,
      "duration_seconds": 1.68,
      "text": "Right, what about breathlessness?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 66.99,
      "end_seconds": 70.65,
      "duration_seconds": 3.66,
      "text": "Not that I've noticed, no breathlessness."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 71.96,
      "end_seconds": 73.32,
      "duration_seconds": 1.36,
      "text": "Neurologically, anything strange?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 74.85,
      "end_seconds": 77.9,
      "duration_seconds": 3.05,
      "text": "Oh, no, that's all normal."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 79.61,
      "end_seconds": 81.79,
      "duration_seconds": 2.18,
      "text": "Has your skin been okay?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 82.3,
      "end_seconds": 83.44,
      "duration_seconds": 1.14,
      "text": "No rashes."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 85.41,
      "end_seconds": 92.22,
      "duration_seconds": 6.81,
      "text": "What medicines are you taking at the moment? It helps to be thorough at this stage."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 93.13,
      "end_seconds": 98.52,
      "duration_seconds": 5.39,
      "text": "I'm on thyroxine, 75 micrograms, every morning for my thyroid."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 99.64,
      "end_seconds": 104.12,
      "duration_seconds": 4.48,
      "text": "Any relatives with health problems I should be aware of?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 105.04,
      "end_seconds": 108.09,
      "duration_seconds": 3.05,
      "text": "Um, my mother has diabetes."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 119.19,
      "end_seconds": 122.43,
      "duration_seconds": 3.24,
      "text": "So, a few questions about your lifestyle now."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 124.21,
      "end_seconds": 138.56,
      "duration_seconds": 14.35,
      "text": "I've never smoked. Yes, I'm a nurse on a busy ward. I share a flat with two friends. I go to the gym a couple of times a week."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 149.15,
      "end_seconds": 151.79,
      "duration_seconds": 2.64,
      "text": "Any allergies I should know about?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 153.34,
      "end_seconds": 157.16,
      "duration_seconds": 3.82,
      "text": "No, none that I know of."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 158.04,
      "end_seconds": 166.9,
      "duration_seconds": 8.86,
      "text": "Do you have any medical conditions, anything you've been treated for? I ask because it helps me narrow things down."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 171.28,
      "end_seconds": 179.67,
      "duration_seconds": 8.39,
      "text": "Yeah, yes, an underactive thyroid. I didn't want to make a fuss, you know."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 180.81,
      "end_seconds": 191.57,
      "duration_seconds": 10.76,
      "text": "Okay, so. Right, so an underactive thyroid is already on your record. We'll keep that in mind today. Have you had to have anything operated on?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 193.64,
      "end_seconds": 201.16,
      "duration_seconds": 7.52,
      "text": "Oh, uh, I had a lump removed from my back years ago."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 202.64,
      "end_seconds": 206.56,
      "duration_seconds": 3.92,
      "text": "Let's get your blood pressure and the other basics."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 213.52,
      "end_seconds": 214.36,
      "duration_seconds": 0.84,
      "text": "One second..."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 234.61,
      "end_seconds": 243.51,
      "duration_seconds": 8.9,
      "text": "Okay: pressure 122 over 74, temp 36.9 degrees, pulse is 83 beats a minute. And SpO2 98 percent on room air."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 245.28,
      "end_seconds": 246.76,
      "duration_seconds": 1.48,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 248.82,
      "end_seconds": 251.88,
      "duration_seconds": 3.06,
      "text": "So, I'll come back to those numbers."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 253.75,
      "end_seconds": 256.62,
      "duration_seconds": 2.87,
      "text": "Let me have a look at you."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 258.03,
      "end_seconds": 262.16,
      "duration_seconds": 4.13,
      "text": "So, a little pressure here, tell me if it's tender."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 278.92,
      "end_seconds": 285.54,
      "duration_seconds": 6.62,
      "text": "Pulse is regular at the moment, with a couple of early beats while I listened."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 287.88,
      "end_seconds": 290.86,
      "duration_seconds": 2.98,
      "text": "Alright, all done, you can get dressed."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 299.43,
      "end_seconds": 321.11,
      "duration_seconds": 21.68,
      "text": "Okay, thinking it through, I'm honestly not certain yet. It could be benign extra heartbeats, though we should confirm, or it might be a thyroid cause. Let's book a thyroid test to look into palpitations. I want an ECG done, that's for palpitations."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 321.99,
      "end_seconds": 324.27,
      "duration_seconds": 2.28,
      "text": "Mm, uh, okay."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 325.39,
      "end_seconds": 337.53,
      "duration_seconds": 12.14,
      "text": "Try cutting out caffeine for two weeks and see if the beats settle. See me again in four weeks. That's everything from me. Any other questions?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 339.05,
      "end_seconds": 342.25,
      "duration_seconds": 3.2,
      "text": "So, nothing more from me, thanks."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 346.56,
      "end_seconds": 347.89,
      "duration_seconds": 1.33,
      "text": "See you then."
    }
  ]
}