{
  "schema_version": "1.0",
  "encounter_id": "00215",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.62,
      "end_seconds": 3.93,
      "duration_seconds": 3.31,
      "text": "Hello, doctor. Where would you like me?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.42,
      "end_seconds": 10.57,
      "duration_seconds": 5.15,
      "text": "Of course, put it down anywhere. So, how can I help?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 11.94,
      "end_seconds": 27.76,
      "duration_seconds": 15.82,
      "text": "Well, you know, honestly, it's headaches in the mornings, and my family pushed me to come. My family kept telling me to get it checked. I'd rather know what's going on than keep guessing."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 28.7,
      "end_seconds": 32.03,
      "duration_seconds": 3.33,
      "text": "How long has this been going on?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 33.33,
      "end_seconds": 40.08,
      "duration_seconds": 6.75,
      "text": "About a year, I think... sorry, nearly five years, I got that wrong."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 42.02,
      "end_seconds": 49.74,
      "duration_seconds": 7.72,
      "text": "Can you describe it a bit more for me? How strong it is, what the pattern is, what helps."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 55.07,
      "end_seconds": 60.69,
      "duration_seconds": 5.62,
      "text": "I'd call it severe. Honestly, a couple of times a week."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 74.51,
      "end_seconds": 78.33,
      "duration_seconds": 3.82,
      "text": "Which tablets or creams or inhalers do you use?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 80.33,
      "end_seconds": 83.75,
      "duration_seconds": 3.42,
      "text": "Amlodipine, 5 milligrams, once a day."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 84.73,
      "end_seconds": 87.25,
      "duration_seconds": 2.52,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 87.82,
      "end_seconds": 90.34,
      "duration_seconds": 2.52,
      "text": "No, never had any surgery."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 91.42,
      "end_seconds": 96.56,
      "duration_seconds": 5.14,
      "text": "Do you have any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 98.19,
      "end_seconds": 104.02,
      "duration_seconds": 5.83,
      "text": "Um, I have high blood pressure, for nearly five years."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 104.71,
      "end_seconds": 105.97,
      "duration_seconds": 1.26,
      "text": "Do you smoke?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 107.17,
      "end_seconds": 108.7,
      "duration_seconds": 1.53,
      "text": "I've never smoked."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 109.76,
      "end_seconds": 112.35,
      "duration_seconds": 2.59,
      "text": "Is anyone at home with you?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 113.55,
      "end_seconds": 117.1,
      "duration_seconds": 3.55,
      "text": "I share a flat with two friends."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 119.18,
      "end_seconds": 121.34,
      "duration_seconds": 2.16,
      "text": "How do you eat, generally?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 122.78,
      "end_seconds": 125.17,
      "duration_seconds": 2.39,
      "text": "I skip breakfast most days."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 128.23,
      "end_seconds": 130.63,
      "duration_seconds": 2.4,
      "text": "Any allergies I should know about?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 131.81,
      "end_seconds": 137.06,
      "duration_seconds": 5.25,
      "text": "Um, yes, ibuprofen, it gives me a rash."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 146.22,
      "end_seconds": 150.64,
      "duration_seconds": 4.42,
      "text": "Okay, and what about nosebleeds, chest pain or palpitations?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 155.17,
      "end_seconds": 158.4,
      "duration_seconds": 3.23,
      "text": "No, none of that at all."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 160.0,
      "end_seconds": 160.81,
      "duration_seconds": 0.81,
      "text": "Any weakness?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 165.96,
      "end_seconds": 167.42,
      "duration_seconds": 1.46,
      "text": "No, no weakness."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 169.33,
      "end_seconds": 172.16,
      "duration_seconds": 2.83,
      "text": "Any muscle or joint problems besides this?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 172.69,
      "end_seconds": 174.99,
      "duration_seconds": 2.3,
      "text": "No, joints are fine."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 176.08,
      "end_seconds": 179.97,
      "duration_seconds": 3.89,
      "text": "Right, before we go on, a few quick readings."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 189.14,
      "end_seconds": 189.97,
      "duration_seconds": 0.83,
      "text": "Almost there..."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 210.05,
      "end_seconds": 214.94,
      "duration_seconds": 4.89,
      "text": "Okay: pulse 89, temperature 36.8, BP is 152 over 97."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 215.88,
      "end_seconds": 217.38,
      "duration_seconds": 1.5,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 219.38,
      "end_seconds": 223.75,
      "duration_seconds": 4.37,
      "text": "They help build the picture, I'll tell you more soon."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 226.41,
      "end_seconds": 229.39,
      "duration_seconds": 2.98,
      "text": "If you're comfortable, I'll examine you now."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 240.44,
      "end_seconds": 241.5,
      "duration_seconds": 1.06,
      "text": "Go ahead."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 243.37,
      "end_seconds": 245.12,
      "duration_seconds": 1.75,
      "text": "Let me press here."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 256.2,
      "end_seconds": 259.08,
      "duration_seconds": 2.88,
      "text": "There's mild pitting swelling at both ankles."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 260.16,
      "end_seconds": 261.15,
      "duration_seconds": 0.99,
      "text": "Go ahead."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 263.5,
      "end_seconds": 266.36,
      "duration_seconds": 2.86,
      "text": "All done, you can get dressed."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 275.25,
      "end_seconds": 286.39,
      "duration_seconds": 11.14,
      "text": "From what you've told me and what I found, I'd lean towards hypertension that isn't well controlled. I'd like to arrange a lipid profile for cardiovascular risk."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 287.09,
      "end_seconds": 289.64,
      "duration_seconds": 2.55,
      "text": "Alright, when would that be?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 290.97,
      "end_seconds": 301.49,
      "duration_seconds": 10.52,
      "text": "I'm going to put you on telmisartan, 40 milligrams, once a day, long term. You take it by mouth. That's for high blood pressure."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 303.03,
      "end_seconds": 304.61,
      "duration_seconds": 1.58,
      "text": "Okay, thank you."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 305.31,
      "end_seconds": 328.6,
      "duration_seconds": 23.29,
      "text": "Salt is the big one, try to keep it low even though it's hard. Cut down on salt and fried food for now, it really does make a difference. Come back or go to emergency straight away if the symptoms get worse. Let me check I've been clear. What will you do once you get home?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 330.44,
      "end_seconds": 336.7,
      "duration_seconds": 6.26,
      "text": "So, I take the telmisartan, 40 milligrams, once a day. Is that right?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 337.22,
      "end_seconds": 342.52,
      "duration_seconds": 5.3,
      "text": "Okay, yes, exactly right. Okay, I think we're finished. Is everything clear?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 343.38,
      "end_seconds": 346.02,
      "duration_seconds": 2.64,
      "text": "Well, okay, thank you. Bye."
    }
  ]
}