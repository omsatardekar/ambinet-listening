{
  "schema_version": "1.0",
  "encounter_id": "00361",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.09,
      "end_seconds": 5.84,
      "duration_seconds": 4.75,
      "text": "Hi, um, doctor. Is this the right room?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.38,
      "end_seconds": 11.0,
      "duration_seconds": 4.62,
      "text": "So, no trouble at all, come in. What's been bothering you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 11.57,
      "end_seconds": 16.93,
      "duration_seconds": 5.36,
      "text": "Honestly, it's nausea, and my family pushed me to come."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 17.78,
      "end_seconds": 20.58,
      "duration_seconds": 2.8,
      "text": "How long has this been going on?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 22.07,
      "end_seconds": 29.4,
      "duration_seconds": 7.33,
      "text": "I've had it for five days. My sister suggested writing things down, but I forgot."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 31.17,
      "end_seconds": 41.17,
      "duration_seconds": 10.0,
      "text": "Tell me a bit more about it: how bad it gets, how often, and whether anything makes it better or worse."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 42.65,
      "end_seconds": 56.88,
      "duration_seconds": 14.23,
      "text": "I, I'd say every other day. It feels mild to me. There's loose motions as well. With loose motions, it's on and off. And I've been feeling weak as well."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 58.22,
      "end_seconds": 61.04,
      "duration_seconds": 2.82,
      "text": "Can I take your vitals now?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 67.5,
      "end_seconds": 68.45,
      "duration_seconds": 0.95,
      "text": "Almost there..."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 90.43,
      "end_seconds": 98.48,
      "duration_seconds": 8.05,
      "text": "Okay: oxygen saturation is 96 percent, pulse is 93 beats a minute, BP is 113 over 76."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 99.2,
      "end_seconds": 101.39,
      "duration_seconds": 2.19,
      "text": "Is that alright, doctor?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 102.14,
      "end_seconds": 105.58,
      "duration_seconds": 3.44,
      "text": "I'll interpret it once I've examined you."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 115.79,
      "end_seconds": 120.88,
      "duration_seconds": 5.09,
      "text": "Did you get black stools, weight loss or blood in the stool?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 124.47,
      "end_seconds": 133.62,
      "duration_seconds": 9.15,
      "text": "Uh, you know, I haven't had black stools, weight loss or blood in the stool, no."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 134.07,
      "end_seconds": 138.2,
      "duration_seconds": 4.13,
      "text": "Uh-huh. A few quick ones: vomiting or rash?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 138.72,
      "end_seconds": 141.35,
      "duration_seconds": 2.63,
      "text": "No, not any of them."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 142.7,
      "end_seconds": 146.25,
      "duration_seconds": 3.55,
      "text": "Any pins and needles or loss of strength anywhere?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 147.26,
      "end_seconds": 151.6,
      "duration_seconds": 4.34,
      "text": "I mean, uh, no, that's all normal."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 152.14,
      "end_seconds": 154.9,
      "duration_seconds": 2.76,
      "text": "Any rashes or skin problems otherwise?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 155.67,
      "end_seconds": 156.63,
      "duration_seconds": 0.96,
      "text": "Skin's normal."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 167.97,
      "end_seconds": 170.56,
      "duration_seconds": 2.59,
      "text": "Have you got any chronic problems?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 171.58,
      "end_seconds": 173.1,
      "duration_seconds": 1.52,
      "text": "I've got diabetes."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 174.21,
      "end_seconds": 180.6,
      "duration_seconds": 6.39,
      "text": "Ah. Okay, I can see diabetes in your file as well. Any operations in the past?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 182.12,
      "end_seconds": 186.17,
      "duration_seconds": 4.05,
      "text": "Just a knee arthroscopy, three years ago."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 187.18,
      "end_seconds": 190.74,
      "duration_seconds": 3.56,
      "text": "Which tablets or creams or inhalers do you use?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 192.01,
      "end_seconds": 198.89,
      "duration_seconds": 6.88,
      "text": "Glycomet. I take it 500 milligrams, twice a day for my sugar."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 200.68,
      "end_seconds": 203.53,
      "duration_seconds": 2.85,
      "text": "Is anyone at home with you?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 204.82,
      "end_seconds": 208.34,
      "duration_seconds": 3.52,
      "text": "I share a flat with two friends."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 209.66,
      "end_seconds": 210.83,
      "duration_seconds": 1.17,
      "text": "Do you work?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 212.37,
      "end_seconds": 218.79,
      "duration_seconds": 6.42,
      "text": "I run a small shop, so I'm on my feet a lot."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 220.51,
      "end_seconds": 222.53,
      "duration_seconds": 2.02,
      "text": "Anything special about your diet?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 223.5,
      "end_seconds": 227.15,
      "duration_seconds": 3.65,
      "text": "I try to avoid too much sugar."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 228.97,
      "end_seconds": 233.01,
      "duration_seconds": 4.04,
      "text": "What about allergies, to medicines or foods or anything else?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 237.68,
      "end_seconds": 240.64,
      "duration_seconds": 2.96,
      "text": "Yeah, no, nothing I'm aware of."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 250.54,
      "end_seconds": 261.52,
      "duration_seconds": 10.98,
      "text": "So, based on your history, it's hard to say. Acute gastroenteritis is one possibility and an infective colitis another, and I'd rather not commit yet."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 265.06,
      "end_seconds": 270.66,
      "duration_seconds": 5.6,
      "text": "I've been thinking the worst, to be honest. Is it bad?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 271.77,
      "end_seconds": 288.72,
      "duration_seconds": 16.95,
      "text": "Nothing I've seen today points to an emergency. It looks like acute gastroenteritis, but I'd like to confirm. Just to be sure I understood. You've had nausea for five days, mild, and no blood in the stool or black stools."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 289.77,
      "end_seconds": 291.95,
      "duration_seconds": 2.18,
      "text": "Yes, you've got it."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 293.63,
      "end_seconds": 297.57,
      "duration_seconds": 3.94,
      "text": "Blood salts is what I'd like next, for dehydration."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 299.08,
      "end_seconds": 300.76,
      "duration_seconds": 1.68,
      "text": "That sounds sensible."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 302.64,
      "end_seconds": 326.51,
      "duration_seconds": 23.87,
      "text": "Let's get a stool test, for diarrhoea. I'd rather check than guess, and this is the quickest way to know more. I'm prescribing zinc, 20 milligrams, once a day, for ten days. That should help with diarrhoea. I'm going to put you on ORS, 1 sachet, after each loose stool, for three days. That should help with dehydration."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 328.6,
      "end_seconds": 329.68,
      "duration_seconds": 1.08,
      "text": "Right, understood."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 331.34,
      "end_seconds": 355.61,
      "duration_seconds": 24.27,
      "text": "Stick to bananas, rice, toast, curd, and avoid milk and oily food till it settles. Please take the tablets with food so they don't upset your stomach. Please don't wait if you pass blood or can't keep anything down. That's when to be seen urgently. See me again in three days. That's it on my side. Anything unclear?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 357.04,
      "end_seconds": 361.57,
      "duration_seconds": 4.53,
      "text": "That's everything I wanted to ask. Thank you."
    }
  ]
}