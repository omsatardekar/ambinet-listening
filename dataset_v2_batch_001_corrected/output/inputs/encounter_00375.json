  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.84,
      "end_seconds": 5.82,
      "duration_seconds": 4.98,
      "text": "Well, hi, doctor. Is this the right room?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.17,
      "end_seconds": 12.01,
      "duration_seconds": 4.84,
      "text": "Alright, that's alright, take a seat. Tell me why you've come."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 12.91,
      "end_seconds": 18.31,
      "duration_seconds": 5.4,
      "text": "Yeah, good morning, doctor. I came along to help out."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 22.84,
      "end_seconds": 34.91,
      "duration_seconds": 12.07,
      "text": "so the thing is, um, I've got a strange episode where I blanked out. I took the morning off to come in today"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 36.6,
      "end_seconds": 39.42,
      "duration_seconds": 2.82,
      "text": "How far back does it go?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 44.33,
      "end_seconds": 48.8,
      "duration_seconds": 4.47,
      "text": "Hmm, for about two weeks, I'd say."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 52.75,
      "end_seconds": 55.06,
      "duration_seconds": 2.31,
      "text": "how intense does it get?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 55.62,
      "end_seconds": 58.67,
      "duration_seconds": 3.05,
      "text": "Yeah, it feels moderate to me."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 59.46,
      "end_seconds": 63.1,
      "duration_seconds": 3.64,
      "text": "Does anything bring it on or make it worse?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 63.71,
      "end_seconds": 81.59,
      "duration_seconds": 17.88,
      "text": "I mean, yes, lack of sleep. That makes it worse. Uh, you know, I've been feeling groggy afterwards too. Hmm, as for feeling groggy afterwards, it feels severe to me."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 82.5,
      "end_seconds": 85.91,
      "duration_seconds": 3.41,
      "text": "has there been any alcohol before it?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 86.95,
      "end_seconds": 91.62,
      "duration_seconds": 4.67,
      "text": "Um, no, none, no alcohol before it."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 97.03,
      "end_seconds": 103.22,
      "duration_seconds": 6.19,
      "text": "a few quick ones: tongue biting, fever or losing control of the bladder?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 106.65,
      "end_seconds": 116.14,
      "duration_seconds": 9.49,
      "text": "Okay, uh, so I haven't had tongue biting, fever or losing control of the bladder, no."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 117.24,
      "end_seconds": 120.16,
      "duration_seconds": 2.92,
      "text": "any muscle or joint problems besides this?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 122.18,
      "end_seconds": 123.79,
      "duration_seconds": 1.61,
      "text": "Nothing else aches."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 125.05,
      "end_seconds": 128.98,
      "duration_seconds": 3.93,
      "text": "alright, how about your heart, any problems like that?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 130.33,
      "end_seconds": 134.28,
      "duration_seconds": 3.95,
      "text": "No, uh, nothing with my heart."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 152.95,
      "end_seconds": 155.43,
      "duration_seconds": 2.48,
      "text": "What do you do for work?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 156.42,
      "end_seconds": 162.71,
      "duration_seconds": 6.29,
      "text": "I work in an office, mostly sitting at a desk."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 163.94,
      "end_seconds": 165.22,
      "duration_seconds": 1.28,
      "text": "How's your diet?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 166.04,
      "end_seconds": 167.71,
      "duration_seconds": 1.67,
      "text": "I'm mostly vegetarian."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 180.76,
      "end_seconds": 184.81,
      "duration_seconds": 4.05,
      "text": "okay, tell me what you take day to day"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 185.79,
      "end_seconds": 190.54,
      "duration_seconds": 4.75,
      "text": "Escitalopram i take it 10 milligrams, once a day"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 192.01,
      "end_seconds": 197.52,
      "duration_seconds": 5.51,
      "text": "What about your general health, any conditions you're being treated for?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 198.49,
      "end_seconds": 205.19,
      "duration_seconds": 6.7,
      "text": "Uh, uh, I've had anxiety for about a year now."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 216.74,
      "end_seconds": 222.2,
      "duration_seconds": 5.46,
      "text": "What about family history, any illnesses that run in the family?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 223.74,
      "end_seconds": 227.45,
      "duration_seconds": 3.71,
      "text": "oh, um, my brother has asthma"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 228.81,
      "end_seconds": 232.54,
      "duration_seconds": 3.73,
      "text": "Let's get your blood pressure and the other basics."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 246.1,
      "end_seconds": 247.84,
      "duration_seconds": 1.74,
      "text": "Just relax your arm..."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 265.22,
      "end_seconds": 274.18,
      "duration_seconds": 8.96,
      "text": "Okay: SpO2 99 percent on room air, temp 36.5 degrees, pressure 108 over 72, pulse 69, respiratory rate 14."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 275.21,
      "end_seconds": 278.8,
      "duration_seconds": 3.59,
      "text": "Right, let me check a few things physically."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 280.51,
      "end_seconds": 283.27,
      "duration_seconds": 2.76,
      "text": "stay still while I have a look"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 296.84,
      "end_seconds": 301.53,
      "duration_seconds": 4.69,
      "text": "you're alert, speech is normal and cranial nerves are intact"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 304.98,
      "end_seconds": 306.15,
      "duration_seconds": 1.17,
      "text": "No problem."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 312.04,
      "end_seconds": 337.88,
      "duration_seconds": 25.84,
      "text": "All done, you can get dressed. Okay, so my impression is this: This looks most like a possible focal seizure that needs investigating. The reason I say that is that your story and my examination fit together. It could also be a faint, so we'll keep that open. Let's book an MRI of the brain to look into possible seizure."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 339.12,
      "end_seconds": 370.77,
      "duration_seconds": 31.65,
      "text": "I'll request an EEG, it'll help with possible seizure. That will help us see what's going on underneath and decide the next step. Don't drive until we've looked into this. I'd like you to see the neurology clinic as well, and I'll write the referral. Blood tests is something we might do if this doesn't improve next month. I'd like to see you again after the results are back"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 372.04,
      "end_seconds": 374.81,
      "duration_seconds": 2.77,
      "text": "Sure, um, that's doable."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 376.18,
      "end_seconds": 377.93,
      "duration_seconds": 1.75,
      "text": "Thanks for coming in."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 379.31,
      "end_seconds": 382.05,
      "duration_seconds": 2.74,
      "text": "Alright, thanks. Bye for now."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 383.69,
      "end_seconds": 384.87,
      "duration_seconds": 1.18,
      "text": "All the best."
    }
  ]
