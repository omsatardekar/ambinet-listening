{
  "schema_version": "1.0",
  "encounter_id": "00080",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.2,
      "end_seconds": 3.64,
      "duration_seconds": 2.44,
      "text": "Hi. Thanks for coming in today."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 5.64,
      "end_seconds": 6.61,
      "duration_seconds": 0.97,
      "text": "Hi. Thanks."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 7.19,
      "end_seconds": 12.32,
      "duration_seconds": 5.13,
      "text": "Hello, doctor, I came in with them, if that's okay."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 13.49,
      "end_seconds": 20.57,
      "duration_seconds": 7.08,
      "text": "Yes, that's no problem at all. Please sit. Sorry about the wait, we're running a bit behind."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 21.78,
      "end_seconds": 28.27,
      "duration_seconds": 6.49,
      "text": "Oh, that's fine. I was just reading something on my phone."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 29.9,
      "end_seconds": 32.36,
      "duration_seconds": 2.46,
      "text": "Okay. Start wherever you like."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 33.84,
      "end_seconds": 51.04,
      "duration_seconds": 17.2,
      "text": "Um, so... pain in my lower back. That's why I came. I kept putting it off, which I know isn't sensible. I thought it would sort itself out, but it hasn't."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 52.8,
      "end_seconds": 56.91,
      "duration_seconds": 4.11,
      "text": "Which tablets or creams or inhalers do you use?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 58.25,
      "end_seconds": 70.08,
      "duration_seconds": 11.83,
      "text": "Yeah, he takes losartan, 50 milligrams, once a day for my blood pressure. It's paracetamol, 650 milligrams, when needed, doctor."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 71.97,
      "end_seconds": 75.29,
      "duration_seconds": 3.32,
      "text": "How long has that been going on?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 76.83,
      "end_seconds": 78.27,
      "duration_seconds": 1.44,
      "text": "For two months."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 80.04,
      "end_seconds": 85.48,
      "duration_seconds": 5.44,
      "text": "Before this I was on amlodipine; that's been stopped."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 86.09,
      "end_seconds": 87.68,
      "duration_seconds": 1.59,
      "text": "When did it begin?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 89.55,
      "end_seconds": 92.41,
      "duration_seconds": 2.86,
      "text": "For three weeks, I'd say."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 93.62,
      "end_seconds": 96.0,
      "duration_seconds": 2.38,
      "text": "Is there anything that triggers it?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 96.92,
      "end_seconds": 101.78,
      "duration_seconds": 4.86,
      "text": "I mean, it's worse with sitting for long."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 102.7,
      "end_seconds": 106.21,
      "duration_seconds": 3.51,
      "text": "Does it happen all the time or in spells?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 110.25,
      "end_seconds": 113.84,
      "duration_seconds": 3.59,
      "text": "Honestly, a few times a day."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 115.04,
      "end_seconds": 118.61,
      "duration_seconds": 3.57,
      "text": "How would you describe it, mild, moderate, severe?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 120.47,
      "end_seconds": 126.78,
      "duration_seconds": 6.31,
      "text": "Well, it's... hard to say, it's kind of... I don't know—"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 127.68,
      "end_seconds": 133.39,
      "duration_seconds": 5.71,
      "text": "Right, take your time. Mild, moderate, or severe, if you had to pick?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 134.23,
      "end_seconds": 147.04,
      "duration_seconds": 12.81,
      "text": "I mean, um, I'd give it a eight, out of ten. Um, uh, there's a muscle spasm as well."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 147.87,
      "end_seconds": 151.55,
      "duration_seconds": 3.68,
      "text": "On a normal day, how strong is it?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 153.36,
      "end_seconds": 160.85,
      "duration_seconds": 7.49,
      "text": "Well, it's... hard to say, it's kind of... I don't know—"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 161.4,
      "end_seconds": 166.43,
      "duration_seconds": 5.03,
      "text": "Take your time. Mild, moderate, or severe, if you had to pick?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 167.01,
      "end_seconds": 168.62,
      "duration_seconds": 1.61,
      "text": "It's severe, honestly."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 170.33,
      "end_seconds": 174.34,
      "duration_seconds": 4.01,
      "text": "What's the pattern, is it there all day?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 176.29,
      "end_seconds": 183.35,
      "duration_seconds": 7.06,
      "text": "It's, um... not exactly... well, hard to explain, I mean—"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 186.09,
      "end_seconds": 192.21,
      "duration_seconds": 6.12,
      "text": "Let me put it another way: how many times in a typical day or week?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 193.19,
      "end_seconds": 197.22,
      "duration_seconds": 4.03,
      "text": "It happens a couple of times a week."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 198.42,
      "end_seconds": 203.11,
      "duration_seconds": 4.69,
      "text": "Did you get fever, weight loss or weakness in the legs?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 204.27,
      "end_seconds": 222.56,
      "duration_seconds": 18.29,
      "text": "Yeah, no, no fever, no weight loss, no weakness in the legs. I did have pain going into the buttock at one point, but that went away on its own."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 223.41,
      "end_seconds": 228.24,
      "duration_seconds": 4.83,
      "text": "Did you get bladder problems or numbness in the legs?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 229.31,
      "end_seconds": 232.62,
      "duration_seconds": 3.31,
      "text": "No, none of that at all."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 234.59,
      "end_seconds": 236.85,
      "duration_seconds": 2.26,
      "text": "Anything unusual with passing urine?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 237.87,
      "end_seconds": 239.47,
      "duration_seconds": 1.6,
      "text": "Nothing there, no."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 240.72,
      "end_seconds": 245.21,
      "duration_seconds": 4.49,
      "text": "Are there any allergies on your record that I should check?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 245.94,
      "end_seconds": 248.77,
      "duration_seconds": 2.83,
      "text": "No, nothing I'm aware of."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 262.51,
      "end_seconds": 264.72,
      "duration_seconds": 2.21,
      "text": "Are you living with family?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 269.38,
      "end_seconds": 273.83,
      "duration_seconds": 4.45,
      "text": "I stay with my daughter and her family."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 277.21,
      "end_seconds": 281.21,
      "duration_seconds": 4.0,
      "text": "Moving on to your background, any past medical history?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 283.04,
      "end_seconds": 291.81,
      "duration_seconds": 8.77,
      "text": "I've had high blood pressure, yes. I've had arthritis in my knees for two years now."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 293.33,
      "end_seconds": 294.73,
      "duration_seconds": 1.4,
      "text": "Is there more?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 296.07,
      "end_seconds": 308.32,
      "duration_seconds": 12.25,
      "text": "Right, so high blood pressure and arthritis in your knees are already on your record. We'll keep that in mind today. Right, have you ever been under the knife?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 310.19,
      "end_seconds": 315.3,
      "duration_seconds": 5.11,
      "text": "I had my thyroid operated on a long time ago."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 316.06,
      "end_seconds": 320.6,
      "duration_seconds": 4.54,
      "text": "What about family history, any illnesses that run in the family?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 321.7,
      "end_seconds": 324.77,
      "duration_seconds": 3.07,
      "text": "Yeah, my father was diabetic."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_4",
      "role": "NURSE",
      "start_seconds": 326.34,
      "end_seconds": 333.33,
      "duration_seconds": 6.99,
      "text": "Doctor, I've got the readings for you. Blood pressure 128 over 80, temp 36.9 degrees, pulse 79."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 335.27,
      "end_seconds": 336.34,
      "duration_seconds": 1.07,
      "text": "Okay, noted."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 337.74,
      "end_seconds": 341.49,
      "duration_seconds": 3.75,
      "text": "Right, let me check a few things physically."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 342.99,
      "end_seconds": 346.72,
      "duration_seconds": 3.73,
      "text": "A little pressure here, tell me if it's tender."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 362.02,
      "end_seconds": 367.35,
      "duration_seconds": 5.33,
      "text": "There's tenderness over the muscles on the right of the lower back."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 385.76,
      "end_seconds": 386.75,
      "duration_seconds": 0.99,
      "text": "No problem."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 388.73,
      "end_seconds": 391.03,
      "duration_seconds": 2.3,
      "text": "Tell me if anything hurts."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 406.95,
      "end_seconds": 413.97,
      "duration_seconds": 7.02,
      "text": "Straight leg raise is negative on both sides and power in the legs is normal."
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 418.67,
      "end_seconds": 429.8,
      "duration_seconds": 11.13,
      "text": "Thanks for that. Staying gently active heals back pain faster than bed rest, so keep moving. That's everything from me. Any other questions?"
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 431.09,
      "end_seconds": 434.18,
      "duration_seconds": 3.09,
      "text": "So, okay, thank you. Bye."
    }
  ]
}