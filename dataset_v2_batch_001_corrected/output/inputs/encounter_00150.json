{
  "schema_version": "1.0",
  "encounter_id": "00150",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.85,
      "end_seconds": 7.89,
      "duration_seconds": 7.04,
      "text": "Uh, doctor, hello, I've got my papers here, where should I put them?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 9.93,
      "end_seconds": 13.64,
      "duration_seconds": 3.71,
      "text": "Right on time. Sit, please. How can I help?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 17.1,
      "end_seconds": 21.1,
      "duration_seconds": 4.0,
      "text": "Doctor, I'm just here to help with the details."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 25.53,
      "end_seconds": 30.43,
      "duration_seconds": 4.9,
      "text": "Of course, please stay. It's helpful to have you here."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 31.87,
      "end_seconds": 34.71,
      "duration_seconds": 2.84,
      "text": "It's fever and chills, mostly."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 36.68,
      "end_seconds": 39.56,
      "duration_seconds": 2.88,
      "text": "So, how far back does it go?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 41.0,
      "end_seconds": 43.79,
      "duration_seconds": 2.79,
      "text": "Around two weeks, I think."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 45.8,
      "end_seconds": 49.83,
      "duration_seconds": 4.03,
      "text": "I think it's been nearer three weeks, actually."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 54.91,
      "end_seconds": 59.24,
      "duration_seconds": 4.33,
      "text": "Okay, so roughly two to three weeks. Is that right?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 61.13,
      "end_seconds": 63.52,
      "duration_seconds": 2.39,
      "text": "I suppose so, yes."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 64.09,
      "end_seconds": 64.79,
      "duration_seconds": 0.7,
      "text": "Mm."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 65.69,
      "end_seconds": 76.97,
      "duration_seconds": 11.28,
      "text": "Okay, so as for feeling very weak, I honestly can't say when that began. It might have been last month or the month before."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 78.63,
      "end_seconds": 82.48,
      "duration_seconds": 3.85,
      "text": "Alright, on a normal day, how strong is it?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 84.22,
      "end_seconds": 93.58,
      "duration_seconds": 9.36,
      "text": "About a six out of ten. I had a cough with phlegm before. That's settled now, though."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 94.54,
      "end_seconds": 98.94,
      "duration_seconds": 4.4,
      "text": "Any recent travel, leg swelling or vomiting at all?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 99.83,
      "end_seconds": 101.96,
      "duration_seconds": 2.13,
      "text": "Nothing like that, no."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 102.32,
      "end_seconds": 104.29,
      "duration_seconds": 1.97,
      "text": "Right. Any sign of palpitations?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 105.93,
      "end_seconds": 108.7,
      "duration_seconds": 2.77,
      "text": "Not at all, no palpitations."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 109.4,
      "end_seconds": 113.57,
      "duration_seconds": 4.17,
      "text": "What about your tummy and bowels, anything unusual there?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 115.32,
      "end_seconds": 117.71,
      "duration_seconds": 2.39,
      "text": "No, all normal there."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 118.93,
      "end_seconds": 121.55,
      "duration_seconds": 2.62,
      "text": "Have you had any surgery before?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 122.94,
      "end_seconds": 129.06,
      "duration_seconds": 6.12,
      "text": "Yes, um, I had a C-section, about ten years ago."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 130.83,
      "end_seconds": 133.1,
      "duration_seconds": 2.27,
      "text": "How do you eat, generally?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 134.14,
      "end_seconds": 136.44,
      "duration_seconds": 2.3,
      "text": "I skip breakfast most days."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 137.91,
      "end_seconds": 139.86,
      "duration_seconds": 1.95,
      "text": "Who do you live with?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 144.56,
      "end_seconds": 149.54,
      "duration_seconds": 4.98,
      "text": "I live with my family, my husband and two kids."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 150.31,
      "end_seconds": 152.5,
      "duration_seconds": 2.19,
      "text": "Tell me about your work."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 154.44,
      "end_seconds": 160.56,
      "duration_seconds": 6.12,
      "text": "I'm a software engineer, so I'm at a screen all day."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 161.84,
      "end_seconds": 167.16,
      "duration_seconds": 5.32,
      "text": "Have you ever reacted badly to a medicine or food? Any allergies?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 168.83,
      "end_seconds": 175.89,
      "duration_seconds": 7.06,
      "text": "I was told I'm allergic to eggs, but I don't remember what reaction I had."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 177.44,
      "end_seconds": 180.57,
      "duration_seconds": 3.13,
      "text": "Alright, any diagnoses you've been given before?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 182.22,
      "end_seconds": 183.78,
      "duration_seconds": 1.56,
      "text": "I have diabetes."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 185.35,
      "end_seconds": 195.79,
      "duration_seconds": 10.44,
      "text": "Sure. Okay, I can see diabetes in your file as well. What about family history, any illnesses that run in the family?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 197.46,
      "end_seconds": 200.18,
      "duration_seconds": 2.72,
      "text": "My grandmother had breast cancer."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 200.71,
      "end_seconds": 206.18,
      "duration_seconds": 5.47,
      "text": "Okay, any medication at the moment, including things from the pharmacy?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 207.03,
      "end_seconds": 211.42,
      "duration_seconds": 4.39,
      "text": "Um, it's glimepiride, 2 milligrams, before breakfast, doctor."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 212.16,
      "end_seconds": 217.21,
      "duration_seconds": 5.05,
      "text": "I had Glycomet at one point, but I'm off it now."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 226.35,
      "end_seconds": 230.56,
      "duration_seconds": 4.21,
      "text": "Let's get your blood pressure and the other basics."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 239.95,
      "end_seconds": 242.25,
      "duration_seconds": 2.3,
      "text": "Okay, give me a moment..."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 251.65,
      "end_seconds": 262.31,
      "duration_seconds": 10.66,
      "text": "Okay: respiratory rate 20, saturation 91 percent. And pulse is 89 beats a minute, temperature is 36.7 degrees, blood pressure 134 over 79."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 263.95,
      "end_seconds": 266.25,
      "duration_seconds": 2.3,
      "text": "Okay, a quick examination now."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 268.1,
      "end_seconds": 270.43,
      "duration_seconds": 2.33,
      "text": "Tell me if anything hurts."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 282.85,
      "end_seconds": 287.02,
      "duration_seconds": 4.17,
      "text": "There's bronchial breathing and crackles at the right lower zone."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 289.99,
      "end_seconds": 292.1,
      "duration_seconds": 2.11,
      "text": "Okay, you can sit up."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 310.52,
      "end_seconds": 317.29,
      "duration_seconds": 6.77,
      "text": "Stop me if I've got anything wrong. You've had fever and chills, and no palpitations or vomiting."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 318.78,
      "end_seconds": 320.73,
      "duration_seconds": 1.95,
      "text": "Yes, you've got it."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 331.55,
      "end_seconds": 350.42,
      "duration_seconds": 18.87,
      "text": "I think a sputum culture makes sense here, for pneumonia. That will help us see what's going on underneath and decide the next step. The treatment will be paracetamol, 500 milligrams, every six hours if needed, for three days. It's for fever and body aches."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 352.28,
      "end_seconds": 354.72,
      "duration_seconds": 2.44,
      "text": "Alright, I'll collect it today."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 355.37,
      "end_seconds": 364.46,
      "duration_seconds": 9.09,
      "text": "Rest and fluids, and finish every dose of the antibiotic. Book a review in three days. Alright, I'll see you out."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 365.25,
      "end_seconds": 370.58,
      "duration_seconds": 5.33,
      "text": "Um, no, I think that's everything. Thank you, doctor."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 371.49,
      "end_seconds": 373.02,
      "duration_seconds": 1.53,
      "text": "So, take care."
    }
  ]
}