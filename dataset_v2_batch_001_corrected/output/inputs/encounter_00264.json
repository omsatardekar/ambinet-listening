{
  "schema_version": "1.0",
  "encounter_id": "00264",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.12,
      "end_seconds": 7.16,
      "duration_seconds": 6.04,
      "text": "Oh, sorry, doctor, I couldn't find the door at first."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.57,
      "end_seconds": 14.92,
      "duration_seconds": 6.35,
      "text": "Okay, yes, come in, take a seat. What can I do for you today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 16.56,
      "end_seconds": 24.43,
      "duration_seconds": 7.87,
      "text": "Honestly, it's blood on the toilet paper, and my family pushed me to come."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 25.68,
      "end_seconds": 28.42,
      "duration_seconds": 2.74,
      "text": "Since when have you had this?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 29.86,
      "end_seconds": 34.72,
      "duration_seconds": 4.86,
      "text": "Hmm, I've had it for about two weeks."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 36.27,
      "end_seconds": 39.71,
      "duration_seconds": 3.44,
      "text": "On a normal day, how strong is it?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 40.89,
      "end_seconds": 44.75,
      "duration_seconds": 3.86,
      "text": "Oh, pretty severe, if I'm being honest."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 46.34,
      "end_seconds": 49.7,
      "duration_seconds": 3.36,
      "text": "Does it come along with anything else?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 54.56,
      "end_seconds": 76.61,
      "duration_seconds": 22.05,
      "text": "Um, you know, it usually comes with an itchy bottom. The itchy bottom? That's been for four weeks. Okay, so about itchy bottom, pretty severe, if I'm being honest. And pain when I pass stool as well, since Friday."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 77.52,
      "end_seconds": 84.5,
      "duration_seconds": 6.98,
      "text": "Have you had blood on the toilet paper before, or is this the first time?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 85.79,
      "end_seconds": 92.95,
      "duration_seconds": 7.16,
      "text": "I had a similar thing about six months ago. It went away."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 94.09,
      "end_seconds": 103.61,
      "duration_seconds": 9.52,
      "text": "Doctor, I've got the readings for you. Heart rate 71, oxygen saturation is 99 percent, temperature is 36.9 degrees. Blood pressure 124 over 77."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 105.66,
      "end_seconds": 106.36,
      "duration_seconds": 0.7,
      "text": "Thanks."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 108.32,
      "end_seconds": 111.52,
      "duration_seconds": 3.2,
      "text": "If you're comfortable, I'll examine you now."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 112.68,
      "end_seconds": 113.82,
      "duration_seconds": 1.14,
      "text": "That's fine."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 114.83,
      "end_seconds": 118.73,
      "duration_seconds": 3.9,
      "text": "A little pressure here, tell me if it's tender."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 127.49,
      "end_seconds": 134.03,
      "duration_seconds": 6.54,
      "text": "There's a small external pile at the edge, and I don't see any fissure."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 135.52,
      "end_seconds": 137.18,
      "duration_seconds": 1.66,
      "text": "Let me press here."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 146.0,
      "end_seconds": 148.44,
      "duration_seconds": 2.44,
      "text": "Tummy is soft and non-tender."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 151.03,
      "end_seconds": 161.12,
      "duration_seconds": 10.09,
      "text": "Right, all done, you can get dressed. Let me check a few things. Any fever, black stools or abdominal pain?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 162.14,
      "end_seconds": 168.29,
      "duration_seconds": 6.15,
      "text": "No fever, black stools or abdominal pain, none of it."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 169.64,
      "end_seconds": 175.64,
      "duration_seconds": 6.0,
      "text": "Let me check a few things. Any weight loss or family history of bowel cancer?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 176.39,
      "end_seconds": 183.29,
      "duration_seconds": 6.9,
      "text": "I haven't had weight loss or family history of bowel cancer, no."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 184.71,
      "end_seconds": 187.99,
      "duration_seconds": 3.28,
      "text": "How are your joints, any aches elsewhere?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 189.57,
      "end_seconds": 191.18,
      "duration_seconds": 1.61,
      "text": "Nothing else aches."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 192.42,
      "end_seconds": 197.39,
      "duration_seconds": 4.97,
      "text": "Tell me about your health in general, any ongoing conditions?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 203.51,
      "end_seconds": 210.83,
      "duration_seconds": 7.32,
      "text": "I have low haemoglobin. I have an irregular heartbeat, for nearly five years."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 222.06,
      "end_seconds": 224.52,
      "duration_seconds": 2.46,
      "text": "Have you had any surgery before?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 225.37,
      "end_seconds": 232.23,
      "duration_seconds": 6.86,
      "text": "Right, yes, I had my appendix out, about eight years ago."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 236.28,
      "end_seconds": 239.14,
      "duration_seconds": 2.86,
      "text": "What medicines do you take regularly?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 240.39,
      "end_seconds": 243.5,
      "duration_seconds": 3.11,
      "text": "Iron tablets, once a day."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 243.87,
      "end_seconds": 244.57,
      "duration_seconds": 0.7,
      "text": "Right."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 246.27,
      "end_seconds": 255.05,
      "duration_seconds": 8.78,
      "text": "Apixaban. I take it 5 milligrams, twice a day. I take Anovate cream, twice a day."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 256.71,
      "end_seconds": 258.91,
      "duration_seconds": 2.2,
      "text": "Right, do you drink alcohol?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 260.25,
      "end_seconds": 264.41,
      "duration_seconds": 4.16,
      "text": "I gave up drinking about three years ago."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 265.19,
      "end_seconds": 267.4,
      "duration_seconds": 2.21,
      "text": "Anything special about your diet?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 268.13,
      "end_seconds": 271.7,
      "duration_seconds": 3.57,
      "text": "I try to avoid too much sugar."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 272.56,
      "end_seconds": 274.64,
      "duration_seconds": 2.08,
      "text": "Who's at home with you?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 275.2,
      "end_seconds": 279.68,
      "duration_seconds": 4.48,
      "text": "It's just me and my wife at home now."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 297.01,
      "end_seconds": 312.86,
      "duration_seconds": 15.85,
      "text": "Taking everything into account, I think we're dealing with haemorrhoids at this stage. That's my thinking for now, and it may change as we learn more. An anal fissure is still possible."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 331.67,
      "end_seconds": 360.29,
      "duration_seconds": 28.62,
      "text": "A colonoscopy is what I'd like next, for rectal bleeding. You'll be taking a soothing cream, twice a day, for one week. That's for haemorrhoids. Soak in a warm bath for ten minutes after you pass stool, and don't strain. Do get help quickly if you pass a lot of blood or feel faint. I'd like you back after the results are back."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 361.95,
      "end_seconds": 365.04,
      "duration_seconds": 3.09,
      "text": "Okay, uh, see you then."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 366.89,
      "end_seconds": 370.95,
      "duration_seconds": 4.06,
      "text": "Okay, I think we're finished. Is everything clear?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 371.49,
      "end_seconds": 375.02,
      "duration_seconds": 3.53,
      "text": "Thanks so much, you know, doctor."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 376.76,
      "end_seconds": 378.12,
      "duration_seconds": 1.36,
      "text": "All the best."
    }
  ]
}