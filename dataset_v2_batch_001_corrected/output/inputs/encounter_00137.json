{
  "schema_version": "1.0",
  "encounter_id": "00137",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.91,
      "end_seconds": 4.38,
      "duration_seconds": 3.47,
      "text": "Good morning. Come in, have a seat."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 5.73,
      "end_seconds": 10.26,
      "duration_seconds": 4.53,
      "text": "Thanks, doctor. It's been a a long few days."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 11.16,
      "end_seconds": 13.27,
      "duration_seconds": 2.11,
      "text": "so, what's been going on?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 17.3,
      "end_seconds": 32.68,
      "duration_seconds": 15.38,
      "text": "Mainly a high fever. There's a couple of other things, uh, but that's the main one. I told myself I'd wait and see, and here I am."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 33.94,
      "end_seconds": 36.45,
      "duration_seconds": 2.51,
      "text": "how long are we talking about?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 37.3,
      "end_seconds": 41.93,
      "duration_seconds": 4.63,
      "text": "I mean, it's been ten days, I'm fairly sure."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 43.66,
      "end_seconds": 46.37,
      "duration_seconds": 2.71,
      "text": "how much is it bothering you?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 48.14,
      "end_seconds": 49.75,
      "duration_seconds": 1.61,
      "text": "I'd say moderate."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 66.23,
      "end_seconds": 70.42,
      "duration_seconds": 4.19,
      "text": "Any vomiting, cough or blood in the stool at all?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 71.95,
      "end_seconds": 75.96,
      "duration_seconds": 4.01,
      "text": "No, um, none of that at all."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 76.95,
      "end_seconds": 80.67,
      "duration_seconds": 3.72,
      "text": "anything on the the skin I should know about?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 82.68,
      "end_seconds": 83.73,
      "duration_seconds": 1.05,
      "text": "no rashes"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 85.23,
      "end_seconds": 86.55,
      "duration_seconds": 1.32,
      "text": "Neurologically, anything strange?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 88.37,
      "end_seconds": 90.31,
      "duration_seconds": 1.94,
      "text": "no, nothing like that"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 90.83,
      "end_seconds": 94.74,
      "duration_seconds": 3.91,
      "text": "Any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 96.37,
      "end_seconds": 99.75,
      "duration_seconds": 3.38,
      "text": "no, none that I know of"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 109.7,
      "end_seconds": 110.94,
      "duration_seconds": 1.24,
      "text": "how about smoking?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 111.79,
      "end_seconds": 115.25,
      "duration_seconds": 3.46,
      "text": "I smoke, yes, around five a day."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 121.37,
      "end_seconds": 123.45,
      "duration_seconds": 2.08,
      "text": "And alcohol, how much?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 125.43,
      "end_seconds": 130.18,
      "duration_seconds": 4.75,
      "text": "A beer or two most evenings, to be honest"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 131.43,
      "end_seconds": 133.14,
      "duration_seconds": 1.71,
      "text": "do you live alone?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 134.59,
      "end_seconds": 138.03,
      "duration_seconds": 3.44,
      "text": "Yes, I live on my own"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 139.13,
      "end_seconds": 140.52,
      "duration_seconds": 1.39,
      "text": "What's your job?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 142.47,
      "end_seconds": 145.19,
      "duration_seconds": 2.72,
      "text": "I teach at a primary school"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 146.7,
      "end_seconds": 149.04,
      "duration_seconds": 2.34,
      "text": "Are you on any regular medication?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 150.34,
      "end_seconds": 152.1,
      "duration_seconds": 1.76,
      "text": "no, nothing regular"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 166.92,
      "end_seconds": 169.53,
      "duration_seconds": 2.61,
      "text": "Before I prescribe anything, any allergies?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 171.55,
      "end_seconds": 175.35,
      "duration_seconds": 3.8,
      "text": "I don't have any known medication allergies."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 176.51,
      "end_seconds": 179.3,
      "duration_seconds": 2.79,
      "text": "Let's do the physical part now."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 180.99,
      "end_seconds": 182.58,
      "duration_seconds": 1.59,
      "text": "Let me press here."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 193.53,
      "end_seconds": 199.14,
      "duration_seconds": 5.61,
      "text": "Your tummy is soft, a little tender under the ribs on the right."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 200.87,
      "end_seconds": 204.55,
      "duration_seconds": 3.68,
      "text": "A little pressure here, tell me if it's tender."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 218.23,
      "end_seconds": 223.49,
      "duration_seconds": 5.26,
      "text": "There's a faint rash on your forearms, it blanches when I press."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 227.42,
      "end_seconds": 228.72,
      "duration_seconds": 1.3,
      "text": "Thanks for that."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 244.43,
      "end_seconds": 267.48,
      "duration_seconds": 23.05,
      "text": "So where does that leave us? It points towards a viral fever, possibly dengue. I'm sending you for a full blood count because of platelet count. We'll begin with paracetamol, 500 milligrams, every six hours if needed, for three days. You take it by mouth. That's for fever and body aches."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 269.14,
      "end_seconds": 272.22,
      "duration_seconds": 3.08,
      "text": "fine, uh, I'll start it"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 276.2,
      "end_seconds": 281.48,
      "duration_seconds": 5.28,
      "text": "Drink a lot, coconut water, ORS, whatever you can manage."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 281.69,
      "end_seconds": 304.76,
      "duration_seconds": 23.07,
      "text": "Hm, okay. Avoid taking any extra painkillers on top of what I'm prescribing without checking with us. One warning sign to remember: you notice any bleeding or you can't keep fluids down. In that case don't wait. I'll want another look after the results are back. That's it on my side. Anything unclear?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 305.46,
      "end_seconds": 308.21,
      "duration_seconds": 2.75,
      "text": "Alright, thanks. Bye for now."
    }
  ]
}