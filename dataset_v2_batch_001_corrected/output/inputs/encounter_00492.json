      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 254.14,
      "end_seconds": 256.21,
      "duration_seconds": 2.07,
      "text": "I've, I've got asthma."
