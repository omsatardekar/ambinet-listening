      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 315.4,
      "end_seconds": 323.48,
      "duration_seconds": 8.08,
      "text": "I'll want another look in a month. Before we finish, can you repeat the plan back to to me?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 324.98,
      "end_seconds": 329.88,
      "duration_seconds": 4.9,
      "text": "So, I come back in a month. Is that right?"
    },
