      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 330.71,
      "end_seconds": 334.08,
      "duration_seconds": 3.37,
      "text": "Yes, exactly right. Alright, I'll see you out."
    },
