{
  "schema_version": "1.0",
  "encounter_id": "00487",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.19,
      "end_seconds": 4.2,
      "duration_seconds": 3.01,
      "text": "Afternoon. Take the chair by the desk."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 5.74,
      "end_seconds": 6.44,
      "duration_seconds": 0.7,
      "text": "Morning."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 7.18,
      "end_seconds": 9.64,
      "duration_seconds": 2.46,
      "text": "So, what's been going on?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 11.69,
      "end_seconds": 18.07,
      "duration_seconds": 6.38,
      "text": "Mainly I've been getting out of puff on the stairs. That's why I came."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 19.83,
      "end_seconds": 24.26,
      "duration_seconds": 4.43,
      "text": "Is this recent, or has it been a while?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 25.35,
      "end_seconds": 27.81,
      "duration_seconds": 2.46,
      "text": "It's been ten days now."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 29.62,
      "end_seconds": 34.42,
      "duration_seconds": 4.8,
      "text": "Okay, give me more detail on it, whatever comes to mind."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 35.07,
      "end_seconds": 46.78,
      "duration_seconds": 11.71,
      "text": "I notice it more with carrying shopping and stairs. Mostly severe. It's a couple of times a week. I've been having put on weight too."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 48.66,
      "end_seconds": 50.9,
      "duration_seconds": 2.24,
      "text": "Have you been feeling tired?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 52.92,
      "end_seconds": 62.66,
      "duration_seconds": 9.74,
      "text": "Yes, actually. I did have a dry cough at night at one point, but that's gone now."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 78.54,
      "end_seconds": 84.0,
      "duration_seconds": 5.46,
      "text": "Do you have any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 85.7,
      "end_seconds": 87.24,
      "duration_seconds": 1.54,
      "text": "I've got diabetes."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 89.2,
      "end_seconds": 90.01,
      "duration_seconds": 0.81,
      "text": "Go on."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 91.31,
      "end_seconds": 94.79,
      "duration_seconds": 3.48,
      "text": "Yes, high blood pressure. Yes, low haemoglobin."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 95.69,
      "end_seconds": 100.65,
      "duration_seconds": 4.96,
      "text": "Alright, diabetes and high blood pressure, that matches what I have here."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 114.37,
      "end_seconds": 119.51,
      "duration_seconds": 5.14,
      "text": "Okay, any medication at the moment, including things from the pharmacy?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 120.9,
      "end_seconds": 124.99,
      "duration_seconds": 4.09,
      "text": "Glimepiride, 2 milligrams, before breakfast for my sugar."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 126.86,
      "end_seconds": 131.34,
      "duration_seconds": 4.48,
      "text": "Doctor, our chart from the last visit lists it as 4 milligrams."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 131.87,
      "end_seconds": 136.55,
      "duration_seconds": 4.68,
      "text": "Okay. Have you got the newest prescription or the box with you?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 138.47,
      "end_seconds": 147.21,
      "duration_seconds": 8.74,
      "text": "Well, not with me. I'll bring it next time. Telmisartan. I take it once a day for my pressure."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 148.85,
      "end_seconds": 151.1,
      "duration_seconds": 2.25,
      "text": "How much do you take?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 152.83,
      "end_seconds": 171.03,
      "duration_seconds": 18.2,
      "text": "40 milligrams, I think that's what's on the box. Iron tablets. I take it once a day for my blood count. I'm supposed to take it regularly, but I don't always manage."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 172.34,
      "end_seconds": 176.87,
      "duration_seconds": 4.53,
      "text": "Let's talk a little about your daily life and habits."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 177.7,
      "end_seconds": 189.73,
      "duration_seconds": 12.03,
      "text": "I work night shifts at a warehouse. I skip breakfast most days. I go to the gym a couple of times a week."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 194.65,
      "end_seconds": 197.53,
      "duration_seconds": 2.88,
      "text": "Before I prescribe anything, any allergies?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 198.73,
      "end_seconds": 201.84,
      "duration_seconds": 3.11,
      "text": "None, as far as I'm aware."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 203.75,
      "end_seconds": 205.97,
      "duration_seconds": 2.22,
      "text": "Have you had any wheezing?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 206.66,
      "end_seconds": 208.22,
      "duration_seconds": 1.56,
      "text": "No wheezing, thankfully."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 210.3,
      "end_seconds": 213.88,
      "duration_seconds": 3.58,
      "text": "A few quick ones: chest pain or fever?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 215.77,
      "end_seconds": 217.53,
      "duration_seconds": 1.76,
      "text": "No, nothing there."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 219.44,
      "end_seconds": 224.15,
      "duration_seconds": 4.71,
      "text": "And what about coughing up blood, calf swelling or palpitations?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 224.98,
      "end_seconds": 231.81,
      "duration_seconds": 6.83,
      "text": "Right, uh, I haven't had coughing up blood, calf swelling or palpitations, no."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 232.42,
      "end_seconds": 235.29,
      "duration_seconds": 2.87,
      "text": "How are your joints, any aches elsewhere?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 241.09,
      "end_seconds": 242.6,
      "duration_seconds": 1.51,
      "text": "Nothing else aches."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 243.33,
      "end_seconds": 253.06,
      "duration_seconds": 9.73,
      "text": "Here are the numbers, doctor. Blood pressure 119 over 74, pulse is 82 beats a minute, oxygen saturation is 97 percent. Temperature 36.6."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 255.13,
      "end_seconds": 256.49,
      "duration_seconds": 1.36,
      "text": "Good, thank you."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 258.3,
      "end_seconds": 261.15,
      "duration_seconds": 2.85,
      "text": "Let me have a look at you."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 273.37,
      "end_seconds": 274.07,
      "duration_seconds": 0.7,
      "text": "Sure."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 275.36,
      "end_seconds": 279.02,
      "duration_seconds": 3.66,
      "text": "A little pressure here, tell me if it's tender."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 294.68,
      "end_seconds": 298.31,
      "duration_seconds": 3.63,
      "text": "Heart sounds are normal and the chest is clear."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 300.24,
      "end_seconds": 304.68,
      "duration_seconds": 4.44,
      "text": "A little pressure here, tell me if it's tender."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 317.37,
      "end_seconds": 323.09,
      "duration_seconds": 5.72,
      "text": "Your BMI is on the high side and you look a little pale."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 328.59,
      "end_seconds": 360.53,
      "duration_seconds": 31.94,
      "text": "Thanks for that. From what you've told me and what I found, I think we're dealing with breathlessness with several possible contributors at this stage. Another possibility is anaemia. We should do a chest X-ray for breathlessness. I'd like to arrange blood tests for breathlessness. An echocardiogram is what I'd like next, for breathlessness. That will help us see what's going on underneath and decide the next step."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 362.13,
      "end_seconds": 363.28,
      "duration_seconds": 1.15,
      "text": "Mm, okay."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 368.37,
      "end_seconds": 401.45,
      "duration_seconds": 33.08,
      "text": "A short daily walk, building up slowly, is a sensible start. Cut back on tea, coffee and fizzy drinks for a couple of weeks and see how things settle. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose. Do get help quickly if the symptoms get worse. Book a review after the results are back."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 403.27,
      "end_seconds": 403.97,
      "duration_seconds": 0.7,
      "text": "Fine."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 405.68,
      "end_seconds": 409.26,
      "duration_seconds": 3.58,
      "text": "Good. Let us know how you get on."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 410.04,
      "end_seconds": 412.68,
      "duration_seconds": 2.64,
      "text": "Thank you for your time."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 414.77,
      "end_seconds": 415.59,
      "duration_seconds": 0.82,
      "text": "Take care."
    }
  ]
}