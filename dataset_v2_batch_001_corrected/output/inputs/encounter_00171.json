{
  "schema_version": "1.0",
  "encounter_id": "00171",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.9,
      "end_seconds": 5.09,
      "duration_seconds": 4.19,
      "text": "Oh, hello, doctor. It's my turn, I think."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.92,
      "end_seconds": 11.2,
      "duration_seconds": 4.28,
      "text": "That's alright, take a seat. Tell me why you've come."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 11.92,
      "end_seconds": 17.77,
      "duration_seconds": 5.85,
      "text": "Okay, so hello, doctor, I came in with them, if that's okay."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 18.57,
      "end_seconds": 21.89,
      "duration_seconds": 3.32,
      "text": "Well, I've been having a routine check-up."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 22.85,
      "end_seconds": 29.04,
      "duration_seconds": 6.19,
      "text": "I was just going to say that the main thing is—"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_4",
      "role": "NURSE",
      "start_seconds": 29.14,
      "end_seconds": 35.39,
      "duration_seconds": 6.25,
      "text": "Sorry to cut in, doctor, quick question: shall I bring the trolley in now or later?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 36.02,
      "end_seconds": 38.54,
      "duration_seconds": 2.52,
      "text": "Later, thanks. Please go on."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 39.48,
      "end_seconds": 44.82,
      "duration_seconds": 5.34,
      "text": "Oh, and mild headaches now and then. Had that since yesterday."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 46.55,
      "end_seconds": 49.64,
      "duration_seconds": 3.09,
      "text": "How bad is it, would you say?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 51.46,
      "end_seconds": 57.28,
      "duration_seconds": 5.82,
      "text": "Mostly moderate. I've also had a bit of back stiffness, since Monday."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 58.08,
      "end_seconds": 63.47,
      "duration_seconds": 5.39,
      "text": "Have you had any low mood, chest pain or persistent cough?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 69.37,
      "end_seconds": 83.24,
      "duration_seconds": 13.87,
      "text": "No, uh, no low mood, no chest pain, no persistent cough. I did have occasional tiredness at one point, but that went away on its own."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 84.96,
      "end_seconds": 89.17,
      "duration_seconds": 4.21,
      "text": "Have you had any weight loss or shortness of breath?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 91.06,
      "end_seconds": 92.75,
      "duration_seconds": 1.69,
      "text": "No, nothing there."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 93.29,
      "end_seconds": 95.55,
      "duration_seconds": 2.26,
      "text": "Has your skin been okay?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 96.17,
      "end_seconds": 99.01,
      "duration_seconds": 2.84,
      "text": "Nothing on the skin, no."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 100.1,
      "end_seconds": 103.61,
      "duration_seconds": 3.51,
      "text": "Any long-term health problems I should know about?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 105.05,
      "end_seconds": 110.61,
      "duration_seconds": 5.56,
      "text": "I've got high blood pressure. I have diabetes. I have high cholesterol."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 115.2,
      "end_seconds": 119.88,
      "duration_seconds": 4.68,
      "text": "Alright, high blood pressure, that matches what I have here."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 134.93,
      "end_seconds": 137.43,
      "duration_seconds": 2.5,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 138.23,
      "end_seconds": 140.58,
      "duration_seconds": 2.35,
      "text": "No, never had any surgery."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 156.26,
      "end_seconds": 160.19,
      "duration_seconds": 3.93,
      "text": "Tell me what you take day to day."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 160.9,
      "end_seconds": 176.03,
      "duration_seconds": 15.13,
      "text": "I'm on amlodipine, 5 milligrams, once a day. Uh, it's glimepiride, 2 milligrams, before breakfast for my sugar. I'm on atorvastatin, 20 milligrams, at night for my cholesterol."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 177.8,
      "end_seconds": 185.18,
      "duration_seconds": 7.38,
      "text": "It's meant to be at night, though I don't see he take it every time."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 185.71,
      "end_seconds": 188.15,
      "duration_seconds": 2.44,
      "text": "Any allergies I should know about?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 188.91,
      "end_seconds": 199.82,
      "duration_seconds": 10.91,
      "text": "I think I reacted to some antibiotic once, years ago. I don't remember which one, or what happened exactly."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 201.54,
      "end_seconds": 203.91,
      "duration_seconds": 2.37,
      "text": "Do you exercise at all?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 204.68,
      "end_seconds": 209.78,
      "duration_seconds": 5.1,
      "text": "I go to the gym a couple of times a week."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 210.31,
      "end_seconds": 212.07,
      "duration_seconds": 1.76,
      "text": "Do you live alone?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 212.86,
      "end_seconds": 215.82,
      "duration_seconds": 2.96,
      "text": "Yes, I live on my own."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_4",
      "role": "NURSE",
      "start_seconds": 217.7,
      "end_seconds": 226.1,
      "duration_seconds": 8.4,
      "text": "Doctor, I've got the readings for you. Pulse is 82 beats a minute, pressure 112 over 69, respiratory rate 18."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 226.91,
      "end_seconds": 228.74,
      "duration_seconds": 1.83,
      "text": "Alright, good, thank you."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 231.64,
      "end_seconds": 234.28,
      "duration_seconds": 2.64,
      "text": "I'd like to examine you now."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 235.1,
      "end_seconds": 239.25,
      "duration_seconds": 4.15,
      "text": "A little pressure here, tell me if it's tender."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 257.92,
      "end_seconds": 260.34,
      "duration_seconds": 2.42,
      "text": "Heart and lung sounds are normal."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 262.01,
      "end_seconds": 264.16,
      "duration_seconds": 2.15,
      "text": "Tell me if anything hurts."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 281.83,
      "end_seconds": 284.71,
      "duration_seconds": 2.88,
      "text": "Your tummy is soft with no tenderness."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 290.01,
      "end_seconds": 317.88,
      "duration_seconds": 27.87,
      "text": "All done, you can get dressed. From what you've told me and what I found, I'd lean towards generally well, nothing worrying today. The reason I say that is that your story and my examination fit together. A tendency towards high cholesterol is also on my list. I want blood tests done, that's for health screening. That will help us see what's going on underneath and decide the next step."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 318.61,
      "end_seconds": 325.96,
      "duration_seconds": 7.35,
      "text": "Let's get an HbA1c, for health screening. The result will help us decide whether anything more is needed."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 326.52,
      "end_seconds": 328.29,
      "duration_seconds": 1.77,
      "text": "Okay, that's fine."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 330.28,
      "end_seconds": 341.44,
      "duration_seconds": 11.16,
      "text": "Keep up regular exercise, around a hundred and fifty minutes a week, and go easy on processed food. Please come and see me after the results are back."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 343.12,
      "end_seconds": 346.99,
      "duration_seconds": 3.87,
      "text": "Alright, I'll put it in my diary."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 348.2,
      "end_seconds": 352.23,
      "duration_seconds": 4.03,
      "text": "Take care, and call us if anything changes."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 352.74,
      "end_seconds": 356.44,
      "duration_seconds": 3.7,
      "text": "That's everything I wanted to ask. Thank you."
    }
  ]
}