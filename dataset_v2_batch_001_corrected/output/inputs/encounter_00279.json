{
  "schema_version": "1.0",
  "encounter_id": "00279",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.29,
      "end_seconds": 4.35,
      "duration_seconds": 3.06,
      "text": "Good evening. Sorry to keep you waiting."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 6.01,
      "end_seconds": 6.71,
      "duration_seconds": 0.7,
      "text": "Hello."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 7.41,
      "end_seconds": 11.6,
      "duration_seconds": 4.19,
      "text": "good morning, doctor i came along to help out"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 14.06,
      "end_seconds": 17.57,
      "duration_seconds": 3.51,
      "text": "Alright, in your own words, what's happened?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 18.37,
      "end_seconds": 23.16,
      "duration_seconds": 4.79,
      "text": "we came because of pain moving down to the groin"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 24.07,
      "end_seconds": 26.83,
      "duration_seconds": 2.76,
      "text": "How long are we talking about?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 27.54,
      "end_seconds": 29.49,
      "duration_seconds": 1.95,
      "text": "about... well, two weeks"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 30.64,
      "end_seconds": 35.33,
      "duration_seconds": 4.69,
      "text": "Alright, does it happen all the time or in spells?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 36.36,
      "end_seconds": 40.36,
      "duration_seconds": 4.0,
      "text": "honestly, a couple of times a week"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 41.17,
      "end_seconds": 47.85,
      "duration_seconds": 6.68,
      "text": "And the other thing I wanted to mention is that I can't really—"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 47.95,
      "end_seconds": 54.52,
      "duration_seconds": 6.57,
      "text": "Tell the doctor about the the other thing, that's what worries me."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 56.39,
      "end_seconds": 67.16,
      "duration_seconds": 10.77,
      "text": "Well, I was getting to that! I've had severe pain in my right side that comes in waves too, for about two weeks."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 68.76,
      "end_seconds": 72.91,
      "duration_seconds": 4.15,
      "text": "So, how bad is it, would you say?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 76.01,
      "end_seconds": 77.51,
      "duration_seconds": 1.5,
      "text": "I'd say severe"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 78.34,
      "end_seconds": 81.83,
      "duration_seconds": 3.49,
      "text": "Which tablets or creams or inhalers do you use?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 83.89,
      "end_seconds": 90.12,
      "duration_seconds": 6.23,
      "text": "it's amlodipine, 5 milligrams, once a day for my pressure, doctor"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 91.31,
      "end_seconds": 97.3,
      "duration_seconds": 5.99,
      "text": "I had ramipril at one point, but I'm off it now."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 111.83,
      "end_seconds": 117.14,
      "duration_seconds": 5.31,
      "text": "Alright, any relatives with health problems I should be aware of?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 117.79,
      "end_seconds": 122.41,
      "duration_seconds": 4.62,
      "text": "My father had a stroke. My sister has thyroid problems."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 122.95,
      "end_seconds": 126.38,
      "duration_seconds": 3.43,
      "text": "alright, what about operations, anything like that?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 127.48,
      "end_seconds": 131.99,
      "duration_seconds": 4.51,
      "text": "Just a a hernia repair, about five years back."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 136.26,
      "end_seconds": 137.06,
      "duration_seconds": 0.8,
      "text": "Any smoking?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 141.99,
      "end_seconds": 145.51,
      "duration_seconds": 3.52,
      "text": "I stopped smoking about two years back."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 147.27,
      "end_seconds": 149.72,
      "duration_seconds": 2.45,
      "text": "So, and alcohol, how much?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 150.62,
      "end_seconds": 155.42,
      "duration_seconds": 4.8,
      "text": "A beer or two most evenings, to be honest."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 157.35,
      "end_seconds": 159.6,
      "duration_seconds": 2.25,
      "text": "So, do you live alone?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 164.08,
      "end_seconds": 167.12,
      "duration_seconds": 3.04,
      "text": "Yes, I live on my own."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 168.93,
      "end_seconds": 173.71,
      "duration_seconds": 4.78,
      "text": "What about allergies, to medicines or foods or anything else?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 174.89,
      "end_seconds": 175.87,
      "duration_seconds": 0.98,
      "text": "No allergies."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 177.01,
      "end_seconds": 180.76,
      "duration_seconds": 3.75,
      "text": "So, is there anything medical in your background?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 185.88,
      "end_seconds": 190.31,
      "duration_seconds": 4.43,
      "text": "I have gout. I've got high blood pressure."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 194.78,
      "end_seconds": 207.64,
      "duration_seconds": 12.86,
      "text": "Right, so gout is already on your record. We'll keep that in mind today. Have you had any fever, difficulty passing urine, previous kidney stones or burning when passing urine?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 209.32,
      "end_seconds": 223.53,
      "duration_seconds": 14.21,
      "text": "No, no fever, no difficulty passing urine, no previous kidney stones. I did have blood in the urine at one point, but that went away on its own."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 224.6,
      "end_seconds": 228.04,
      "duration_seconds": 3.44,
      "text": "did you get vomiting or testicular pain?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 230.69,
      "end_seconds": 232.32,
      "duration_seconds": 1.63,
      "text": "No, nothing there."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 233.63,
      "end_seconds": 236.17,
      "duration_seconds": 2.54,
      "text": "How are your bowels, any trouble?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 238.58,
      "end_seconds": 241.03,
      "duration_seconds": 2.45,
      "text": "Bowels are regular, nothing odd."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 243.01,
      "end_seconds": 248.31,
      "duration_seconds": 5.3,
      "text": "Have you noticed any weakness, or anything odd with your balance?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 251.43,
      "end_seconds": 253.24,
      "duration_seconds": 1.81,
      "text": "No weakness or anything."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_4",
      "role": "NURSE",
      "start_seconds": 259.35,
      "end_seconds": 270.52,
      "duration_seconds": 11.17,
      "text": "here are the numbers, doctor pulse is 108 beats a minute, temp 36.6 degrees, respiratory rate 16, blood pressure 113 over 79, oxygen saturation is 96 percent"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 271.94,
      "end_seconds": 272.94,
      "duration_seconds": 1.0,
      "text": "okay, noted"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 275.76,
      "end_seconds": 278.35,
      "duration_seconds": 2.59,
      "text": "Let's do the physical part now."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 280.17,
      "end_seconds": 282.45,
      "duration_seconds": 2.28,
      "text": "just relax, I'll be quick"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 289.46,
      "end_seconds": 296.35,
      "duration_seconds": 6.89,
      "text": "There's tenderness in the right loin when I tap, and your tummy is soft."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 301.47,
      "end_seconds": 302.79,
      "duration_seconds": 1.32,
      "text": "thanks for that"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 316.8,
      "end_seconds": 334.1,
      "duration_seconds": 17.3,
      "text": "Okay, thinking it through, the most likely explanation is a kidney stone. A muscular back pain is also on my list. I can't rule out a urine infection yet. Have you had any tests for this so far?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 334.63,
      "end_seconds": 345.4,
      "duration_seconds": 10.77,
      "text": "I had an ultrasound of the kidneys done at another clinic last year. I don't have the report with me"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 346.47,
      "end_seconds": 378.61,
      "duration_seconds": 32.14,
      "text": "I'm going to order a urine test, for flank pain. The result will help us decide whether anything more is needed. I think kidney function tests makes sense here, for renal colic. The treatment will be tamsulosin, 0.4 milligrams, at night, for two weeks. That should help with stone passage. The treatment will be diclofenac, 50 milligrams, twice a day after food, for three days. You take it by mouth. That should help with stone pain."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 379.32,
      "end_seconds": 400.4,
      "duration_seconds": 21.08,
      "text": "drink three litres of water a day and try to strain your urine so we can catch the stone if it passes. A CT scan of the kidneys and bladder is something we might do if this doesn't improve in two weeks. See me again after the scan"
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 400.98,
      "end_seconds": 403.1,
      "duration_seconds": 2.12,
      "text": "That works for me."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 403.91,
      "end_seconds": 405.27,
      "duration_seconds": 1.36,
      "text": "any last questions?"
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 407.2,
      "end_seconds": 409.39,
      "duration_seconds": 2.19,
      "text": "thanks, that was helpful"
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 409.99,
      "end_seconds": 411.72,
      "duration_seconds": 1.73,
      "text": "So, safe journey home."
    }
  ]
}