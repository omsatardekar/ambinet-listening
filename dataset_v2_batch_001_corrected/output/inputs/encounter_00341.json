{
  "schema_version": "1.0",
  "encounter_id": "00341",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.93,
      "end_seconds": 5.91,
      "duration_seconds": 4.98,
      "text": "Good afternoon, doctor, the receptionist said you'd see me now."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.8,
      "end_seconds": 11.0,
      "duration_seconds": 4.2,
      "text": "Right on time. Sit, please. How can I help?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 11.75,
      "end_seconds": 18.83,
      "duration_seconds": 7.08,
      "text": "It's, It's food coming back up. I thought I'd wait, but it hasn't gone."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 19.61,
      "end_seconds": 22.15,
      "duration_seconds": 2.54,
      "text": "How far back does it go?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 27.5,
      "end_seconds": 30.12,
      "duration_seconds": 2.62,
      "text": "Probably about four days. Yeah."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 31.94,
      "end_seconds": 34.76,
      "duration_seconds": 2.82,
      "text": "Do you notice anything setting it off?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 35.32,
      "end_seconds": 38.54,
      "duration_seconds": 3.22,
      "text": "I notice it more with bending over."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 38.98,
      "end_seconds": 40.96,
      "duration_seconds": 1.98,
      "text": "Mm. Any heartburn as well?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 41.67,
      "end_seconds": 43.88,
      "duration_seconds": 2.21,
      "text": "Yes, for two days."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 45.48,
      "end_seconds": 51.11,
      "duration_seconds": 5.63,
      "text": "Okay, give me more detail on it, whatever comes to mind."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 53.02,
      "end_seconds": 74.61,
      "duration_seconds": 21.59,
      "text": "It's worse with big meals and lying down. It settles a little with antacids. Maybe a six out of ten on a bad day. I'd say every other day. Oh, you know, and a lump feeling in the throat. That's been about the same, two days."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 74.88,
      "end_seconds": 75.73,
      "duration_seconds": 0.85,
      "text": "And then?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 77.21,
      "end_seconds": 82.81,
      "duration_seconds": 5.6,
      "text": "I had chest discomfort after eating before. That's settled now, though."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 84.11,
      "end_seconds": 89.95,
      "duration_seconds": 5.84,
      "text": "Have you had food coming back up before, or is this the first time?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 91.26,
      "end_seconds": 96.08,
      "duration_seconds": 4.82,
      "text": "A bit, last winter. It settled by itself back then."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 97.42,
      "end_seconds": 101.74,
      "duration_seconds": 4.32,
      "text": "And what about pain on exertion or weight loss?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 102.5,
      "end_seconds": 107.56,
      "duration_seconds": 5.06,
      "text": "I haven't had pain on exertion or weight loss, no."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 108.15,
      "end_seconds": 112.54,
      "duration_seconds": 4.39,
      "text": "Okay, and what about black stools, trouble swallowing or anaemia?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 113.29,
      "end_seconds": 117.09,
      "duration_seconds": 3.8,
      "text": "No, uh, not any of them."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 117.99,
      "end_seconds": 120.49,
      "duration_seconds": 2.5,
      "text": "Any breathing difficulties apart from this?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 121.7,
      "end_seconds": 124.2,
      "duration_seconds": 2.5,
      "text": "No, my breathing's been fine."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 125.91,
      "end_seconds": 128.73,
      "duration_seconds": 2.82,
      "text": "Is your urine normal, no changes?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 129.85,
      "end_seconds": 131.89,
      "duration_seconds": 2.04,
      "text": "No, that's all fine."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 134.97,
      "end_seconds": 139.09,
      "duration_seconds": 4.12,
      "text": "Anyone in the family with similar problems or other conditions?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 139.95,
      "end_seconds": 145.11,
      "duration_seconds": 5.16,
      "text": "My father had a stroke. Okay, so my sister has epilepsy."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 150.12,
      "end_seconds": 152.94,
      "duration_seconds": 2.82,
      "text": "Have you had any surgery before?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 154.57,
      "end_seconds": 159.94,
      "duration_seconds": 5.37,
      "text": "Yes, I had my thyroid operated on, a long time ago."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 161.43,
      "end_seconds": 165.83,
      "duration_seconds": 4.4,
      "text": "What about your general health, any conditions you're being treated for?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 167.06,
      "end_seconds": 172.06,
      "duration_seconds": 5.0,
      "text": "I've had acid reflux for nearly five years now."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 176.47,
      "end_seconds": 177.17,
      "duration_seconds": 0.7,
      "text": "Mm."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 178.23,
      "end_seconds": 182.71,
      "duration_seconds": 4.48,
      "text": "I've had asthma, yes. I've got high blood pressure."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 183.76,
      "end_seconds": 184.56,
      "duration_seconds": 0.8,
      "text": "I see."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 199.47,
      "end_seconds": 200.73,
      "duration_seconds": 1.26,
      "text": "Do you smoke?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 201.51,
      "end_seconds": 203.11,
      "duration_seconds": 1.6,
      "text": "I've never smoked."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 204.11,
      "end_seconds": 205.79,
      "duration_seconds": 1.68,
      "text": "Do you drink alcohol?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 207.74,
      "end_seconds": 212.7,
      "duration_seconds": 4.96,
      "text": "I have a couple of drinks on the weekend."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 214.65,
      "end_seconds": 217.57,
      "duration_seconds": 2.92,
      "text": "Are you working at the moment?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 219.3,
      "end_seconds": 223.72,
      "duration_seconds": 4.42,
      "text": "Yes, I'm a nurse on a busy ward."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 225.61,
      "end_seconds": 226.88,
      "duration_seconds": 1.27,
      "text": "How about exercise?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 227.5,
      "end_seconds": 231.43,
      "duration_seconds": 3.93,
      "text": "Not really, I don't get much exercise."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 235.46,
      "end_seconds": 239.96,
      "duration_seconds": 4.5,
      "text": "Any medication at the moment, including things from the pharmacy?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 241.23,
      "end_seconds": 252.25,
      "duration_seconds": 11.02,
      "text": "It's omeprazole, 20 milligrams, once a day for the reflux. Asthalin inhaler, when needed. I take losartan, once a day."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 257.06,
      "end_seconds": 259.52,
      "duration_seconds": 2.46,
      "text": "Right, and what strength is that?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 260.32,
      "end_seconds": 266.57,
      "duration_seconds": 6.25,
      "text": "It's 50 milligrams. Eno. I take it when I get it."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 271.67,
      "end_seconds": 274.24,
      "duration_seconds": 2.57,
      "text": "Roughly how long on that one?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 274.95,
      "end_seconds": 277.22,
      "duration_seconds": 2.27,
      "text": "About three months now."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 286.89,
      "end_seconds": 289.41,
      "duration_seconds": 2.52,
      "text": "I'll take a few measurements first."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 299.94,
      "end_seconds": 301.81,
      "duration_seconds": 1.87,
      "text": "Rest your hand here..."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 317.14,
      "end_seconds": 323.0,
      "duration_seconds": 5.86,
      "text": "Okay: blood pressure 125 over 75, heart rate 75, temperature 36.8."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 324.4,
      "end_seconds": 328.03,
      "duration_seconds": 3.63,
      "text": "Come over here and I'll have a look."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 329.3,
      "end_seconds": 330.0,
      "duration_seconds": 0.7,
      "text": "Sure."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 331.5,
      "end_seconds": 333.92,
      "duration_seconds": 2.42,
      "text": "Let me just check something."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 342.09,
      "end_seconds": 344.5,
      "duration_seconds": 2.41,
      "text": "Tummy is soft and non-tender."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 346.84,
      "end_seconds": 359.68,
      "duration_seconds": 12.84,
      "text": "Okay, you can sit up. Putting it all together, I think we're dealing with gastro-oesophageal reflux at this stage. I'd also keep a heart cause that we should rule out in mind."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 360.47,
      "end_seconds": 363.63,
      "duration_seconds": 3.16,
      "text": "Is this going to go away?"
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 364.25,
      "end_seconds": 375.01,
      "duration_seconds": 10.76,
      "text": "I can't promise yet, but most people with gastro-oesophageal reflux do well once it's treated properly. Let's book an upper endoscopy to look into persistent reflux."
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 376.75,
      "end_seconds": 380.37,
      "duration_seconds": 3.62,
      "text": "I can book that for Tuesday at 2 pm."
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 382.33,
      "end_seconds": 402.16,
      "duration_seconds": 19.83,
      "text": "I think an ECG makes sense here, for chest discomfort. Smaller dinners, earlier in the evening, and prop up the head of the bed with a couple of extra pillows. Book a review in six weeks. Thanks for coming in."
    },
    {
      "segment_id": "SEG0059",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 403.52,
      "end_seconds": 406.03,
      "duration_seconds": 2.51,
      "text": "Alright, thanks. Bye for now."
    },
    {
      "segment_id": "SEG0060",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 407.7,
      "end_seconds": 409.0,
      "duration_seconds": 1.3,
      "text": "See you then."
    }
  ]
}