{
  "schema_version": "1.0",
  "encounter_id": "00343",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 1.36,
      "end_seconds": 10.45,
      "duration_seconds": 9.09,
      "text": "Doctor, the patient's with us now. I did the usual checks at the front, so just say when you want them."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 15.01,
      "end_seconds": 19.1,
      "duration_seconds": 4.09,
      "text": "Perfect, thanks. Hello there, so what's the trouble?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 20.86,
      "end_seconds": 31.74,
      "duration_seconds": 10.88,
      "text": "Uh, morning, doctor. I'll stay and fill in anything that's missed. We came because of staring spells that others noticed."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 33.59,
      "end_seconds": 36.03,
      "duration_seconds": 2.44,
      "text": "When did you first notice it?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 37.96,
      "end_seconds": 40.8,
      "duration_seconds": 2.84,
      "text": "ever since... since last night, really"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 41.91,
      "end_seconds": 45.7,
      "duration_seconds": 3.79,
      "text": "On a normal day, how strong is it?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 47.27,
      "end_seconds": 49.23,
      "duration_seconds": 1.96,
      "text": "I'd call it moderate."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 49.73,
      "end_seconds": 56.14,
      "duration_seconds": 6.41,
      "text": "and the other thing I wanted to mention is that I can't really—"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 56.24,
      "end_seconds": 61.31,
      "duration_seconds": 5.07,
      "text": "Tell the doctor about the other thing, that's what worries me."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 62.37,
      "end_seconds": 72.22,
      "duration_seconds": 9.85,
      "text": "Oh, I was getting to that! I've also had a metallic taste before it, for two days."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 74.26,
      "end_seconds": 77.58,
      "duration_seconds": 3.32,
      "text": "Any an odd smell before it as well?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 82.32,
      "end_seconds": 83.82,
      "duration_seconds": 1.5,
      "text": "yes, I have"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 89.21,
      "end_seconds": 97.27,
      "duration_seconds": 8.06,
      "text": "Doctor, I've got the readings for you. Temperature 36.6, pressure 124 over 74, heart rate 84."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 98.42,
      "end_seconds": 99.87,
      "duration_seconds": 1.45,
      "text": "Good, thank you."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 100.9,
      "end_seconds": 104.56,
      "duration_seconds": 3.66,
      "text": "Right, let me check a few things physically."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 106.55,
      "end_seconds": 108.54,
      "duration_seconds": 1.99,
      "text": "Hold that position for me."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 116.73,
      "end_seconds": 119.13,
      "duration_seconds": 2.4,
      "text": "Coordination is normal on finger-to-nose testing."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 121.1,
      "end_seconds": 123.06,
      "duration_seconds": 1.96,
      "text": "Let me just check something."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 140.66,
      "end_seconds": 145.51,
      "duration_seconds": 4.85,
      "text": "You're alert, speech is normal and cranial nerves are intact."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 150.24,
      "end_seconds": 158.72,
      "duration_seconds": 8.48,
      "text": "all done, you can get dressed let me check a few things any alcohol before it or tongue biting?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 160.12,
      "end_seconds": 174.86,
      "duration_seconds": 14.74,
      "text": "No, no alcohol before it, no tongue biting. I did have a strange episode where I blanked out at one point, but that went away on its own."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 176.4,
      "end_seconds": 182.39,
      "duration_seconds": 5.99,
      "text": "Have you had any losing control of the bladder, jerking movements or head injury?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 182.93,
      "end_seconds": 188.98,
      "duration_seconds": 6.05,
      "text": "No, no losing control of the bladder, jerking movements or head injury."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 190.25,
      "end_seconds": 193.53,
      "duration_seconds": 3.28,
      "text": "How are your joints, any aches elsewhere?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 194.15,
      "end_seconds": 197.52,
      "duration_seconds": 3.37,
      "text": "okay, so no, joints are fine"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 199.54,
      "end_seconds": 203.11,
      "duration_seconds": 3.57,
      "text": "do you have any known allergies at all?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 204.65,
      "end_seconds": 207.48,
      "duration_seconds": 2.83,
      "text": "No, none that I know of."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 208.37,
      "end_seconds": 213.61,
      "duration_seconds": 5.24,
      "text": "What about family history, any illnesses that run in the family?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 215.13,
      "end_seconds": 217.03,
      "duration_seconds": 1.9,
      "text": "My mother has migraines."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 230.87,
      "end_seconds": 234.8,
      "duration_seconds": 3.93,
      "text": "Moving on to your background, any past medical history?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 235.96,
      "end_seconds": 238.3,
      "duration_seconds": 2.34,
      "text": "I've had anxiety, yes"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 240.06,
      "end_seconds": 240.76,
      "duration_seconds": 0.7,
      "text": "Sure."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 241.77,
      "end_seconds": 245.87,
      "duration_seconds": 4.1,
      "text": "I have heart disease, for about ten years"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 246.92,
      "end_seconds": 248.64,
      "duration_seconds": 1.72,
      "text": "And apart from that?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 250.08,
      "end_seconds": 256.73,
      "duration_seconds": 6.65,
      "text": "Yes, anxiety and heart disease are known to us, good to have that clear."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 273.74,
      "end_seconds": 278.41,
      "duration_seconds": 4.67,
      "text": "So, which tablets or creams or inhalers do you use?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 280.03,
      "end_seconds": 287.06,
      "duration_seconds": 7.03,
      "text": "Escitalopram, 10 milligrams, once a day. Clopidogrel, 75 milligrams, maybe, once a day."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 287.66,
      "end_seconds": 292.27,
      "duration_seconds": 4.61,
      "text": "did you happen to bring the box or the paperwork?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 293.74,
      "end_seconds": 298.97,
      "duration_seconds": 5.23,
      "text": "No, it's at home. Aspirin I don't take anymore."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 300.88,
      "end_seconds": 302.58,
      "duration_seconds": 1.7,
      "text": "Do you live alone?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 304.63,
      "end_seconds": 307.46,
      "duration_seconds": 2.83,
      "text": "Yes, I live on my own."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 309.26,
      "end_seconds": 311.25,
      "duration_seconds": 1.99,
      "text": "Do you get any exercise?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 312.86,
      "end_seconds": 317.89,
      "duration_seconds": 5.03,
      "text": "I walk for about half an hour most days."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 319.16,
      "end_seconds": 333.63,
      "duration_seconds": 14.47,
      "text": "so, based on the history and the examination, I don't have a clear answer today: a possible focal seizure that needs investigating is possible, and so is a faint. A panic episode is still possible"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 334.23,
      "end_seconds": 337.41,
      "duration_seconds": 3.18,
      "text": "Is this going to go away?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 339.46,
      "end_seconds": 357.86,
      "duration_seconds": 18.4,
      "text": "Nothing I've seen today points to an emergency. It looks like a possible focal seizure that needs investigating, but I'd like to confirm. I'm going to order blood tests, for episode of altered awareness. The result will help us decide whether anything more is needed."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 359.22,
      "end_seconds": 362.11,
      "duration_seconds": 2.89,
      "text": "where do I go for that?"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 365.88,
      "end_seconds": 381.66,
      "duration_seconds": 15.78,
      "text": "I'd like to arrange an MRI of the brain for possible seizure. I'm sending you for an EEG because of possible seizure. Don't drive until we've looked into this. We'll refer you to the neurology clinic."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 382.44,
      "end_seconds": 384.98,
      "duration_seconds": 2.54,
      "text": "sure, where do I go?"
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 385.56,
      "end_seconds": 394.2,
      "duration_seconds": 8.64,
      "text": "And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 394.91,
      "end_seconds": 396.39,
      "duration_seconds": 1.48,
      "text": "Right, will do."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 397.07,
      "end_seconds": 399.97,
      "duration_seconds": 2.9,
      "text": "That's it on my side. Anything unclear?"
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 400.48,
      "end_seconds": 404.87,
      "duration_seconds": 4.39,
      "text": "That's everything I wanted to to ask. Thank you."
    }
  ]
}