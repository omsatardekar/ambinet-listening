{
  "schema_version": "1.0",
  "encounter_id": "00265",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 1.13,
      "end_seconds": 7.56,
      "duration_seconds": 6.43,
      "text": "doctor, your next patient is here i've done the basics, I'll read them out in a moment"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 9.55,
      "end_seconds": 12.96,
      "duration_seconds": 3.41,
      "text": "Okay, thanks. Hi, how can I help today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 13.56,
      "end_seconds": 18.63,
      "duration_seconds": 5.07,
      "text": "I'm here because of it was red twice this week."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 20.33,
      "end_seconds": 22.24,
      "duration_seconds": 1.91,
      "text": "When did it begin?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 24.27,
      "end_seconds": 34.95,
      "duration_seconds": 10.68,
      "text": "It's been about two weeks now. I'd rather not end up on lots of tablets if I can avoid it."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 39.48,
      "end_seconds": 42.79,
      "duration_seconds": 3.31,
      "text": "what about tiredness, have you noticed that?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 45.8,
      "end_seconds": 56.66,
      "duration_seconds": 10.86,
      "text": "mm, yes oh, and a mild ache in the back as for mild ache in the back, it's once or twice a day"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 57.24,
      "end_seconds": 61.8,
      "duration_seconds": 4.56,
      "text": "Do you have any allergies to medicines, food, anything at all?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 62.39,
      "end_seconds": 65.85,
      "duration_seconds": 3.46,
      "text": "no allergies that I know of, no"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 66.83,
      "end_seconds": 69.22,
      "duration_seconds": 2.39,
      "text": "Does anything run in the family?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 71.07,
      "end_seconds": 73.88,
      "duration_seconds": 2.81,
      "text": "My father had a heart attack."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 83.82,
      "end_seconds": 85.76,
      "duration_seconds": 1.94,
      "text": "what's your current medication list?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 86.52,
      "end_seconds": 89.87,
      "duration_seconds": 3.35,
      "text": "Ramipril, 5 milligrams, maybe, every morning."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 90.98,
      "end_seconds": 96.43,
      "duration_seconds": 5.45,
      "text": "okay, do you have the packet or the prescription with you?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 97.42,
      "end_seconds": 109.25,
      "duration_seconds": 11.83,
      "text": "No, it's at home. Tiotropium inhaler. I take it once a day. I'm supposed to take it regularly, but I don't always manage."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 128.05,
      "end_seconds": 130.17,
      "duration_seconds": 2.12,
      "text": "How do you eat, generally?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 131.91,
      "end_seconds": 134.26,
      "duration_seconds": 2.35,
      "text": "I skip breakfast most days"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 140.2,
      "end_seconds": 143.16,
      "duration_seconds": 2.96,
      "text": "What kind of work do you do?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 146.08,
      "end_seconds": 150.66,
      "duration_seconds": 4.58,
      "text": "I work on a farm, it's quite physical"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 151.34,
      "end_seconds": 155.79,
      "duration_seconds": 4.45,
      "text": "Okay, moving on to your background, any past medical history?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 160.98,
      "end_seconds": 165.73,
      "duration_seconds": 4.75,
      "text": "I've had high blood pressure for about a year now."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 166.56,
      "end_seconds": 167.36,
      "duration_seconds": 0.8,
      "text": "Anything more?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 169.28,
      "end_seconds": 170.77,
      "duration_seconds": 1.49,
      "text": "I've got COPD."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 172.15,
      "end_seconds": 185.48,
      "duration_seconds": 13.33,
      "text": "Right, so high blood pressure and COPD are already on your record. We'll keep that that in mind today. A few quick ones: flank pain, recent injury or difficulty passing urine?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 186.31,
      "end_seconds": 192.51,
      "duration_seconds": 6.2,
      "text": "No flank pain, recent injury or difficulty passing urine, none of it."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 193.85,
      "end_seconds": 198.45,
      "duration_seconds": 4.6,
      "text": "and what about weight loss, fever or pain on passing urine?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 199.81,
      "end_seconds": 201.5,
      "duration_seconds": 1.69,
      "text": "No, nothing there."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 202.0,
      "end_seconds": 204.36,
      "duration_seconds": 2.36,
      "text": "Mm. Is your chest okay generally?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 205.83,
      "end_seconds": 207.93,
      "duration_seconds": 2.1,
      "text": "No problems with breathing."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 209.72,
      "end_seconds": 211.89,
      "duration_seconds": 2.17,
      "text": "is your digestion otherwise okay?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 213.15,
      "end_seconds": 217.05,
      "duration_seconds": 3.9,
      "text": "no, um, that side's been fine"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 218.4,
      "end_seconds": 229.89,
      "duration_seconds": 11.49,
      "text": "Here are the numbers, doctor. Height 161 centimetres, oxygen saturation is 97 percent. Pressure 124 over 80, weight 54 kilos, pulse is 70 beats a minute, temp 36.8 degrees."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 234.93,
      "end_seconds": 236.45,
      "duration_seconds": 1.52,
      "text": "good, thank you"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 237.64,
      "end_seconds": 240.41,
      "duration_seconds": 2.77,
      "text": "Okay, a a quick examination now."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 241.82,
      "end_seconds": 243.91,
      "duration_seconds": 2.09,
      "text": "take your time, no rush"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 255.73,
      "end_seconds": 260.65,
      "duration_seconds": 4.92,
      "text": "Abdomen is soft, no masses, and no tenderness in the loins."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 264.6,
      "end_seconds": 266.43,
      "duration_seconds": 1.83,
      "text": "That's fine, sit up."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 277.36,
      "end_seconds": 312.14,
      "duration_seconds": 34.78,
      "text": "Putting it all together, I think we're dealing with blood in the urine that needs full investigation at this stage. It could also be a urine infection, so we'll keep that open. I think a cystoscopy makes sense here, for haematuria. I'd rather check than guess, and this is the quickest way to know more. I think a CT scan of the kidneys and bladder makes sense here, for haematuria."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 313.72,
      "end_seconds": 314.93,
      "duration_seconds": 1.21,
      "text": "Okay, noted."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 316.0,
      "end_seconds": 331.09,
      "duration_seconds": 15.09,
      "text": "Keep drinking plenty of water, and let us know quickly if you pass clots or can't pass urine. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 335.57,
      "end_seconds": 337.35,
      "duration_seconds": 1.78,
      "text": "okay, I'll remember"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 338.78,
      "end_seconds": 360.83,
      "duration_seconds": 22.05,
      "text": "Let's hold off on a urine test for now, and if there's no change in two weeks we can revisit it. Keep an eye out, and if you can't pass urine or pass large clots, call us the same day or go to emergency. See me again after the results are back."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 361.34,
      "end_seconds": 363.47,
      "duration_seconds": 2.13,
      "text": "That works for me."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 366.7,
      "end_seconds": 370.04,
      "duration_seconds": 3.34,
      "text": "That's it on my side. Anything unclear?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 372.01,
      "end_seconds": 374.82,
      "duration_seconds": 2.81,
      "text": "all good here. Thank you"
    }
  ]
}