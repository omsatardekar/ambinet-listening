{
  "schema_version": "1.0",
  "encounter_id": "00306",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.35,
      "end_seconds": 4.75,
      "duration_seconds": 3.4,
      "text": "Hello doctor, sorry, am I early?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 10.02,
      "end_seconds": 14.84,
      "duration_seconds": 4.82,
      "text": "No trouble at all, come in. What's been bothering you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 16.35,
      "end_seconds": 21.19,
      "duration_seconds": 4.84,
      "text": "I've been dealing with a dry cough at night"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 26.05,
      "end_seconds": 28.86,
      "duration_seconds": 2.81,
      "text": "How far back does it go?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 30.47,
      "end_seconds": 46.99,
      "duration_seconds": 16.52,
      "text": "For five days, I'd say. And And there's a runny nose in the mornings as well, two months now. I did have a mild wheeze at times at one point, but that's gone now."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 47.71,
      "end_seconds": 54.93,
      "duration_seconds": 7.22,
      "text": "Have you had a dry cough at night before, or is this the first time?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 56.17,
      "end_seconds": 63.21,
      "duration_seconds": 7.04,
      "text": "A A bit, about six months ago. It settled by itself back then."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 64.77,
      "end_seconds": 68.8,
      "duration_seconds": 4.03,
      "text": "any heartburn, fever or weight loss at all?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 70.58,
      "end_seconds": 72.68,
      "duration_seconds": 2.1,
      "text": "No, none of those."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 74.43,
      "end_seconds": 77.04,
      "duration_seconds": 2.61,
      "text": "and your skin, any changes there?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 80.78,
      "end_seconds": 81.82,
      "duration_seconds": 1.04,
      "text": "Skin's normal."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 82.45,
      "end_seconds": 85.92,
      "duration_seconds": 3.47,
      "text": "How are your joints, any aches elsewhere?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 87.53,
      "end_seconds": 89.56,
      "duration_seconds": 2.03,
      "text": "no, joints are fine"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 108.34,
      "end_seconds": 112.83,
      "duration_seconds": 4.49,
      "text": "Do you have any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 114.81,
      "end_seconds": 118.3,
      "duration_seconds": 3.49,
      "text": "I have eczema, for nearly five years"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 119.08,
      "end_seconds": 126.05,
      "duration_seconds": 6.97,
      "text": "Yes, eczema is known to us, good to have that clear. What about alcohol?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 126.75,
      "end_seconds": 131.52,
      "duration_seconds": 4.77,
      "text": "I have a couple of drinks on the weekend"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 132.89,
      "end_seconds": 134.79,
      "duration_seconds": 1.9,
      "text": "What's your diet like?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 135.84,
      "end_seconds": 140.78,
      "duration_seconds": 4.94,
      "text": "I eat out quite a lot, to be honest"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 142.03,
      "end_seconds": 143.59,
      "duration_seconds": 1.56,
      "text": "Do you live alone?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 144.3,
      "end_seconds": 147.71,
      "duration_seconds": 3.41,
      "text": "Yes, I live on my own."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 148.38,
      "end_seconds": 150.8,
      "duration_seconds": 2.42,
      "text": "Are you working or retired?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 151.44,
      "end_seconds": 155.27,
      "duration_seconds": 3.83,
      "text": "Retired. I stopped a few years back"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 156.25,
      "end_seconds": 159.17,
      "duration_seconds": 2.92,
      "text": "Does anything run in the family?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 160.8,
      "end_seconds": 163.17,
      "duration_seconds": 2.37,
      "text": "My father had a stroke."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 164.96,
      "end_seconds": 167.44,
      "duration_seconds": 2.48,
      "text": "Before I prescribe anything, any allergies?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 168.87,
      "end_seconds": 172.48,
      "duration_seconds": 3.61,
      "text": "I've never been told I have allergies."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 174.47,
      "end_seconds": 176.72,
      "duration_seconds": 2.25,
      "text": "What's your current medication list?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 181.07,
      "end_seconds": 188.45,
      "duration_seconds": 7.38,
      "text": "I take hydrocortisone cream, when needed my family kept telling me to get it checked"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 199.89,
      "end_seconds": 210.51,
      "duration_seconds": 10.62,
      "text": "doctor, I've got the the readings for you. Respiratory rate 17, blood pressure 123 over 79, temperature 36.6. Pulse 77, saturation 97 percent"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 211.69,
      "end_seconds": 213.0,
      "duration_seconds": 1.31,
      "text": "Good, thank you."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 214.66,
      "end_seconds": 218.1,
      "duration_seconds": 3.44,
      "text": "If you're comfortable, I'll examine you now."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 219.79,
      "end_seconds": 221.75,
      "duration_seconds": 1.96,
      "text": "Let me press here."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 231.57,
      "end_seconds": 235.34,
      "duration_seconds": 3.77,
      "text": "a a faint wheeze when you breathe out forcefully"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 237.7,
      "end_seconds": 240.01,
      "duration_seconds": 2.31,
      "text": "Okay, good, that's the examination."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 251.51,
      "end_seconds": 267.43,
      "duration_seconds": 15.92,
      "text": "So, based on the history and the examination, this is probably cough-variant asthma. That's my thinking for now, and it may change as we learn more. I'd also keep post-nasal drip in mind."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 267.98,
      "end_seconds": 270.55,
      "duration_seconds": 2.57,
      "text": "Is it something serious, doctor?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 272.09,
      "end_seconds": 306.72,
      "duration_seconds": 34.63,
      "text": "nothing I've seen today points to an emergency it looks like cough-variant asthma, but I'd like to confirm let's get breathing tests, for chronic cough i'd rather check than guess, and this is the quickest way to know more we'll begin with salbutamol inhaler, 100 micrograms, two puffs when needed, for two weeks that should help with cough and wheeze try the inhaler before exercise and note whether the cough settles"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 307.28,
      "end_seconds": 326.84,
      "duration_seconds": 19.56,
      "text": "I follow. Cut down on salt and fried food for now, it really does make a difference. I'm not ordering a peak flow reading today. If things carry on in two weeks, we'll consider it. Alright, any last questions?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 327.45,
      "end_seconds": 332.03,
      "duration_seconds": 4.58,
      "text": "no, you know, you've explained it it well. Thanks"
    }
  ]
}