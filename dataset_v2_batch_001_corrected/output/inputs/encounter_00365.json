{
  "schema_version": "1.0",
  "encounter_id": "00365",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.04,
      "end_seconds": 5.7,
      "duration_seconds": 4.66,
      "text": "Hello? Doctor? They told me to come straight in."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.33,
      "end_seconds": 11.73,
      "duration_seconds": 4.4,
      "text": "Right on time. Sit, please. How can I help?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 12.49,
      "end_seconds": 17.55,
      "duration_seconds": 5.06,
      "text": "Okay, so I wanted to get a rattling chest looked at."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 18.7,
      "end_seconds": 24.6,
      "duration_seconds": 5.9,
      "text": "How far back does it go? Just so I get the full picture."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 25.53,
      "end_seconds": 35.77,
      "duration_seconds": 10.24,
      "text": "I mean, it's been three days, I'm fairly sure. And there's more breathlessness than usual as well, about a week now."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 37.49,
      "end_seconds": 40.45,
      "duration_seconds": 2.96,
      "text": "First the numbers, if you don't mind."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 52.64,
      "end_seconds": 54.6,
      "duration_seconds": 1.96,
      "text": "Rest your hand here..."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 71.03,
      "end_seconds": 81.31,
      "duration_seconds": 10.28,
      "text": "Okay: respiratory rate 23, blood pressure 136 over 72, pulse is 89 beats a minute, saturation 91 percent, temp 36.9 degrees."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 83.61,
      "end_seconds": 87.27,
      "duration_seconds": 3.66,
      "text": "Okay, I need to examine you for this."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 88.57,
      "end_seconds": 89.82,
      "duration_seconds": 1.25,
      "text": "Yes, doctor."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 91.79,
      "end_seconds": 94.52,
      "duration_seconds": 2.73,
      "text": "Let me look at this properly."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 107.77,
      "end_seconds": 112.9,
      "duration_seconds": 5.13,
      "text": "Air entry is reduced on both sides with a prolonged breathing out phase."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 118.72,
      "end_seconds": 121.28,
      "duration_seconds": 2.56,
      "text": "Thanks, please take a seat again."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 134.06,
      "end_seconds": 138.57,
      "duration_seconds": 4.51,
      "text": "Have you had any fever, chest pain or swollen ankles?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 139.22,
      "end_seconds": 140.79,
      "duration_seconds": 1.57,
      "text": "No, nothing there."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 144.77,
      "end_seconds": 148.52,
      "duration_seconds": 3.75,
      "text": "Alright, how are your joints, any aches elsewhere?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 149.89,
      "end_seconds": 152.03,
      "duration_seconds": 2.14,
      "text": "I move fine otherwise."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 153.66,
      "end_seconds": 156.95,
      "duration_seconds": 3.29,
      "text": "On the cardiac side, anything I should know?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 158.09,
      "end_seconds": 163.21,
      "duration_seconds": 5.12,
      "text": "My heart's been fine, as far as I know."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 168.08,
      "end_seconds": 170.59,
      "duration_seconds": 2.51,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 172.37,
      "end_seconds": 174.7,
      "duration_seconds": 2.33,
      "text": "No, nothing like that."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 181.85,
      "end_seconds": 184.56,
      "duration_seconds": 2.71,
      "text": "What medicines do you take regularly?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 186.23,
      "end_seconds": 192.39,
      "duration_seconds": 6.16,
      "text": "I, I take Tiotropium inhaler, once a day for my chest."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 205.32,
      "end_seconds": 212.64,
      "duration_seconds": 7.32,
      "text": "Moving on to your background, any past medical history? Bear with me, I'm just building up the picture."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 214.12,
      "end_seconds": 223.32,
      "duration_seconds": 9.2,
      "text": "I mean, I've had COPD for nearly five years now. I'm not great at remembering details, so bear with me."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 225.09,
      "end_seconds": 228.29,
      "duration_seconds": 3.2,
      "text": "Is there a family history of anything significant?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 229.62,
      "end_seconds": 231.72,
      "duration_seconds": 2.1,
      "text": "My mother has migraines."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 232.59,
      "end_seconds": 235.42,
      "duration_seconds": 2.83,
      "text": "Right, any drug or food allergies?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 236.36,
      "end_seconds": 239.26,
      "duration_seconds": 2.9,
      "text": "Yes, I'm allergic to dust."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 240.08,
      "end_seconds": 240.99,
      "duration_seconds": 0.91,
      "text": "Any smoking?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 242.53,
      "end_seconds": 246.26,
      "duration_seconds": 3.73,
      "text": "I stopped smoking about two years back."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 246.91,
      "end_seconds": 248.67,
      "duration_seconds": 1.76,
      "text": "And alcohol, how much?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 250.13,
      "end_seconds": 254.53,
      "duration_seconds": 4.4,
      "text": "A beer or two most evenings, to be honest."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 255.23,
      "end_seconds": 257.92,
      "duration_seconds": 2.69,
      "text": "Are you working at the moment?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 259.32,
      "end_seconds": 263.03,
      "duration_seconds": 3.71,
      "text": "Yes, I'm a nurse on a busy ward."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 263.57,
      "end_seconds": 266.0,
      "duration_seconds": 2.43,
      "text": "And what do you usually eat?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 268.04,
      "end_seconds": 271.29,
      "duration_seconds": 3.25,
      "text": "Mostly home-cooked food, rice and vegetables."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 281.31,
      "end_seconds": 287.4,
      "duration_seconds": 6.09,
      "text": "Okay, thinking it through, it fits best with a flare-up of COPD."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 288.44,
      "end_seconds": 291.31,
      "duration_seconds": 2.87,
      "text": "Is it something serious, doctor?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 292.91,
      "end_seconds": 305.41,
      "duration_seconds": 12.5,
      "text": "I can't promise yet, but most people with a flare-up of COPD do well once it's treated properly. I think a sputum culture makes sense here, for productive cough."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 306.4,
      "end_seconds": 307.81,
      "duration_seconds": 1.41,
      "text": "Fine by me."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 309.54,
      "end_seconds": 313.73,
      "duration_seconds": 4.19,
      "text": "I'd like to arrange a chest X-ray for breathlessness."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 318.46,
      "end_seconds": 320.15,
      "duration_seconds": 1.69,
      "text": "Fine by me."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 322.2,
      "end_seconds": 358.23,
      "duration_seconds": 36.03,
      "text": "I'm going to put you on doxycycline, 100 milligrams, twice a day, for five days. That's for chest infection. This is a good time to talk about stopping smoking if that's still an issue. If you smoke, this is a good moment to think about stopping, and we can help you with that. Let's hold off on blood tests for now, and if there's no change in a month we can revisit it."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 358.82,
      "end_seconds": 368.86,
      "duration_seconds": 10.04,
      "text": "One warning sign to remember: you become more breathless or your lips turn blue. In that case don't wait. Book a review in two weeks."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 369.42,
      "end_seconds": 372.79,
      "duration_seconds": 3.37,
      "text": "Uh, good, I'll come back then."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 374.74,
      "end_seconds": 378.03,
      "duration_seconds": 3.29,
      "text": "Is there anything you wanted to ask?"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 378.65,
      "end_seconds": 382.31,
      "duration_seconds": 3.66,
      "text": "Um, nothing more from me, thanks."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 384.29,
      "end_seconds": 385.49,
      "duration_seconds": 1.2,
      "text": "Safe journey home."
    }
  ]
}