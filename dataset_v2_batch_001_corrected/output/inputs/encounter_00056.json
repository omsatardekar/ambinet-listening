{
  "schema_version": "1.0",
  "encounter_id": "00056",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.73,
      "end_seconds": 6.66,
      "duration_seconds": 5.93,
      "text": "So, um, excuse me, doctor, should I sit here?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.75,
      "end_seconds": 12.69,
      "duration_seconds": 3.94,
      "text": "You're fine, sit down. So, what brings you in?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 13.78,
      "end_seconds": 32.07,
      "duration_seconds": 18.29,
      "text": "Honestly, it's a bad cough, and my family pushed me to come. I told myself I'd wait and see, and here I am. I thought it would sort itself out, but it hasn't."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 36.24,
      "end_seconds": 38.61,
      "duration_seconds": 2.37,
      "text": "Since when have you had this?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 39.61,
      "end_seconds": 42.39,
      "duration_seconds": 2.78,
      "text": "Probably about a week. Yeah."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 42.94,
      "end_seconds": 51.9,
      "duration_seconds": 8.96,
      "text": "Understood. Can you describe it a bit more for me? How strong it is, what the pattern is, what helps."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 53.75,
      "end_seconds": 73.15,
      "duration_seconds": 19.4,
      "text": "Mild, I'd say. Only honey and warm water, and it's not much. I just want to get back to normal, really. I had a sore throat before. That's settled now, though."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 89.18,
      "end_seconds": 91.2,
      "duration_seconds": 2.02,
      "text": "How about shortness of breath?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 92.97,
      "end_seconds": 95.93,
      "duration_seconds": 2.96,
      "text": "Definitely no shortness of breath."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 96.93,
      "end_seconds": 103.62,
      "duration_seconds": 6.69,
      "text": "Have you had any coughing up blood, chest pain, night sweats or leg swelling?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 104.91,
      "end_seconds": 108.81,
      "duration_seconds": 3.9,
      "text": "Okay, so no, none of those."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 109.93,
      "end_seconds": 113.14,
      "duration_seconds": 3.21,
      "text": "How are your joints, any aches elsewhere?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 113.74,
      "end_seconds": 115.2,
      "duration_seconds": 1.46,
      "text": "Nothing else aches."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 116.52,
      "end_seconds": 119.0,
      "duration_seconds": 2.48,
      "text": "Anything different when you pass water?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 120.51,
      "end_seconds": 122.12,
      "duration_seconds": 1.61,
      "text": "Nothing there, no."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 131.29,
      "end_seconds": 132.79,
      "duration_seconds": 1.5,
      "text": "So, any smoking?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 134.76,
      "end_seconds": 140.54,
      "duration_seconds": 5.78,
      "text": "I used to smoke but I quit five years ago."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 141.95,
      "end_seconds": 143.52,
      "duration_seconds": 1.57,
      "text": "Any sport or activity?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 144.82,
      "end_seconds": 147.36,
      "duration_seconds": 2.54,
      "text": "I play badminton on Sundays."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 147.9,
      "end_seconds": 149.87,
      "duration_seconds": 1.97,
      "text": "Who's at home with you?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 150.82,
      "end_seconds": 156.06,
      "duration_seconds": 5.24,
      "text": "It's just me and my wife at home now."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 157.87,
      "end_seconds": 159.58,
      "duration_seconds": 1.71,
      "text": "What's your diet like?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 160.11,
      "end_seconds": 165.17,
      "duration_seconds": 5.06,
      "text": "I eat out quite a lot, to be honest."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 183.67,
      "end_seconds": 185.32,
      "duration_seconds": 1.65,
      "text": "Any procedures or operations?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 190.15,
      "end_seconds": 196.23,
      "duration_seconds": 6.08,
      "text": "I had a lump removed from my back years ago."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 200.03,
      "end_seconds": 204.92,
      "duration_seconds": 4.89,
      "text": "What about your general health, any conditions you're being treated for?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 206.47,
      "end_seconds": 210.59,
      "duration_seconds": 4.12,
      "text": "I've got asthma. Yes, high blood pressure."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 211.39,
      "end_seconds": 219.42,
      "duration_seconds": 8.03,
      "text": "Right, so asthma is already on your record. We'll keep that in mind today. Any allergies I should know about?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 221.25,
      "end_seconds": 225.38,
      "duration_seconds": 4.13,
      "text": "Eggs. I come out in... well, stomach cramps."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 227.09,
      "end_seconds": 229.17,
      "duration_seconds": 2.08,
      "text": "What's your current medication list?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 231.23,
      "end_seconds": 236.38,
      "duration_seconds": 5.15,
      "text": "So, I'm on Seretide inhaler, twice a day."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 236.91,
      "end_seconds": 242.58,
      "duration_seconds": 5.67,
      "text": "Hm, okay. What about family history, any illnesses that run in the family?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 243.33,
      "end_seconds": 245.74,
      "duration_seconds": 2.41,
      "text": "My mother has diabetes."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 246.41,
      "end_seconds": 249.67,
      "duration_seconds": 3.26,
      "text": "First the numbers, if you don't mind."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 261.01,
      "end_seconds": 262.0,
      "duration_seconds": 0.99,
      "text": "Almost there..."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 283.47,
      "end_seconds": 294.56,
      "duration_seconds": 11.09,
      "text": "Okay: oxygen saturation is 96 percent, respiratory rate 16, heart rate 96. And temperature is 38.4 degrees, blood pressure 110 over 72."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 296.24,
      "end_seconds": 298.4,
      "duration_seconds": 2.16,
      "text": "Is that alright, doctor?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 300.09,
      "end_seconds": 302.82,
      "duration_seconds": 2.73,
      "text": "I'll come back to those numbers."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 305.04,
      "end_seconds": 308.38,
      "duration_seconds": 3.34,
      "text": "If you're comfortable, I'll examine you now."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 309.48,
      "end_seconds": 310.96,
      "duration_seconds": 1.48,
      "text": "I'll go gently."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 321.4,
      "end_seconds": 323.85,
      "duration_seconds": 2.45,
      "text": "No crackles at the bases."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 325.4,
      "end_seconds": 327.51,
      "duration_seconds": 2.11,
      "text": "Hold that position for me."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 336.39,
      "end_seconds": 340.03,
      "duration_seconds": 3.64,
      "text": "There are a few scattered wheezes on both sides."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 342.14,
      "end_seconds": 372.67,
      "duration_seconds": 30.53,
      "text": "That's all I need, thank you. So where does that leave us? The most likely explanation is a chest infection, probably viral. Pneumonia is still possible. Let's get a chest X-ray, for cough. I'm prescribing salbutamol inhaler, 100 micrograms, two puffs when needed, for one week. That should help with wheeze. Steam and warm fluids can ease the cough, and try to sleep with your head propped up. Please come and see me in a week."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 374.61,
      "end_seconds": 375.31,
      "duration_seconds": 0.7,
      "text": "Fine."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 377.07,
      "end_seconds": 379.9,
      "duration_seconds": 2.83,
      "text": "Ask me anything before you go."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 381.53,
      "end_seconds": 384.03,
      "duration_seconds": 2.5,
      "text": "Thanks so much, doctor."
    }
  ]
}