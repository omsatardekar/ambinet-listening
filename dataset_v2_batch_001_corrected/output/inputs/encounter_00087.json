  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.39,
      "end_seconds": 4.5,
      "duration_seconds": 3.11,
      "text": "hello doctor, sorry, am I early?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.06,
      "end_seconds": 8.31,
      "duration_seconds": 3.25,
      "text": "Yes, do sit. Tell me what's been happening."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 9.27,
      "end_seconds": 13.67,
      "duration_seconds": 4.4,
      "text": "good morning, doctor i came along to help out"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 15.6,
      "end_seconds": 19.55,
      "duration_seconds": 3.95,
      "text": "Good, that'll be useful. Pull up a chair."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 20.06,
      "end_seconds": 24.33,
      "duration_seconds": 4.27,
      "text": "I've been dealing with a tight band-like headache."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 25.35,
      "end_seconds": 28.57,
      "duration_seconds": 3.22,
      "text": "Is it worse with anything in particular?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 30.36,
      "end_seconds": 44.3,
      "duration_seconds": 13.94,
      "text": "I notice it more with long hours on the computer and stress. And there's pain in the neck and shoulders as well, uh, two years now."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 46.2,
      "end_seconds": 49.93,
      "duration_seconds": 3.73,
      "text": "What's the pattern, is it there all day?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 51.51,
      "end_seconds": 54.17,
      "duration_seconds": 2.66,
      "text": "It happens every other day."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 55.24,
      "end_seconds": 58.61,
      "duration_seconds": 3.37,
      "text": "Would you call it mild or bad?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 59.5,
      "end_seconds": 60.5,
      "duration_seconds": 1.0,
      "text": "Mostly severe."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 62.05,
      "end_seconds": 65.77,
      "duration_seconds": 3.72,
      "text": "What about trouble sleeping, have you noticed that?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 67.64,
      "end_seconds": 68.89,
      "duration_seconds": 1.25,
      "text": "mm, yes"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 69.82,
      "end_seconds": 73.21,
      "duration_seconds": 3.39,
      "text": "Alright, have you had any weakness or numbness?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 79.42,
      "end_seconds": 82.1,
      "duration_seconds": 2.68,
      "text": "No, not any of them."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 82.55,
      "end_seconds": 87.06,
      "duration_seconds": 4.51,
      "text": "Go on. Have you had any blurred vision or fever?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 87.83,
      "end_seconds": 92.99,
      "duration_seconds": 5.16,
      "text": "So, I haven't had blurred vision or fever, no."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 94.83,
      "end_seconds": 98.61,
      "duration_seconds": 3.78,
      "text": "Anything on the skin I should know about?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 99.94,
      "end_seconds": 103.31,
      "duration_seconds": 3.37,
      "text": "No, uh, skin's been fine."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 108.56,
      "end_seconds": 112.24,
      "duration_seconds": 3.68,
      "text": "What about your tummy and bowels, anything unusual there?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 113.34,
      "end_seconds": 115.06,
      "duration_seconds": 1.72,
      "text": "Nothing unusual, no."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 115.96,
      "end_seconds": 120.2,
      "duration_seconds": 4.24,
      "text": "Moving on to your background, any past medical history?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 121.77,
      "end_seconds": 129.33,
      "duration_seconds": 7.56,
      "text": "I've had anxiety, yes i wasn't sure whether to come in at all, to be honest"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 129.91,
      "end_seconds": 136.25,
      "duration_seconds": 6.34,
      "text": "Hm, okay. Okay, any medication at the moment, including things from the pharmacy?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 137.45,
      "end_seconds": 146.32,
      "duration_seconds": 8.87,
      "text": "I take escitalopram, 10 milligrams, once a day. I thought it would sort itself out, but it hasn't."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 160.53,
      "end_seconds": 165.07,
      "duration_seconds": 4.54,
      "text": "let's talk a little about your daily life and habits"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 165.89,
      "end_seconds": 181.59,
      "duration_seconds": 15.7,
      "text": "I've never smoked. I don't drink at all. It's just me and my wife at home now. I try to avoid too much sugar. I work on a farm, it's quite physical"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 194.12,
      "end_seconds": 196.84,
      "duration_seconds": 2.72,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 198.47,
      "end_seconds": 200.03,
      "duration_seconds": 1.56,
      "text": "no operations, no"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 209.6,
      "end_seconds": 212.83,
      "duration_seconds": 3.23,
      "text": "before we go on, a few quick readings"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 222.44,
      "end_seconds": 224.72,
      "duration_seconds": 2.28,
      "text": "Okay, give me a moment..."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 243.77,
      "end_seconds": 255.77,
      "duration_seconds": 12.0,
      "text": "Okay: height 163 centimetres, temperature is 36.9 degrees, BP is 128 over 73, pulse is 69 beats a minute, weight 61 kilos, BMI works out to 23.0."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 256.99,
      "end_seconds": 260.48,
      "duration_seconds": 3.49,
      "text": "Is that alright, you know, doctor?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 262.02,
      "end_seconds": 265.07,
      "duration_seconds": 3.05,
      "text": "I'll interpret it once I've examined you"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 266.85,
      "end_seconds": 270.34,
      "duration_seconds": 3.49,
      "text": "Let me examine, it won't take long."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 271.89,
      "end_seconds": 273.71,
      "duration_seconds": 1.82,
      "text": "let me press here"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 284.31,
      "end_seconds": 289.32,
      "duration_seconds": 5.01,
      "text": "The muscles at the back of your neck are tight and tender."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 293.67,
      "end_seconds": 302.24,
      "duration_seconds": 8.57,
      "text": "thanks, please take a seat again having listened and examined, this looks most like a tension-type headache another possibility is migraine"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 302.99,
      "end_seconds": 308.74,
      "duration_seconds": 5.75,
      "text": "I've been thinking the worst, to be honest. Is it bad?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 310.47,
      "end_seconds": 341.96,
      "duration_seconds": 31.49,
      "text": "I understand the worry. At the moment I'd say it's a tension-type headache, and we'll know more once the an eye check is back. I'm sending you for an eye check because of headache and eye strain. I'd like you to take amitriptyline, 10 milligrams, at night, for six weeks. That's for headache prevention. Painkillers on most days can actually make the headaches stick around. We'll refer you to physiotherapy."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 343.54,
      "end_seconds": 351.77,
      "duration_seconds": 8.23,
      "text": "One warning sign to remember: the symptoms get worse. In that case don't wait. Come back in a month."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 353.01,
      "end_seconds": 354.88,
      "duration_seconds": 1.87,
      "text": "That works for me."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 360.1,
      "end_seconds": 363.85,
      "duration_seconds": 3.75,
      "text": "okay, I think we're finished is everything clear?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 367.34,
      "end_seconds": 369.33,
      "duration_seconds": 1.99,
      "text": "No questions. Thank you."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 371.0,
      "end_seconds": 372.41,
      "duration_seconds": 1.41,
      "text": "All the best."
    }
  ]
