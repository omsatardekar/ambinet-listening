{
  "schema_version": "1.0",
  "encounter_id": "00347",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.01,
      "end_seconds": 6.4,
      "duration_seconds": 5.39,
      "text": "Doctor? Hi. I hope I've got the right time."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.77,
      "end_seconds": 12.64,
      "duration_seconds": 4.87,
      "text": "Of course, put it down anywhere. So, how can I help?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 13.89,
      "end_seconds": 17.48,
      "duration_seconds": 3.59,
      "text": "So, doctor, thank you for seeing us."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 19.46,
      "end_seconds": 22.06,
      "duration_seconds": 2.6,
      "text": "Absolutely, come and sit beside them."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 23.54,
      "end_seconds": 28.83,
      "duration_seconds": 5.29,
      "text": "Doctor, it's the room spinning. That's what we're worried about."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 29.34,
      "end_seconds": 31.69,
      "duration_seconds": 2.35,
      "text": "How long are we talking about?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 33.06,
      "end_seconds": 36.36,
      "duration_seconds": 3.3,
      "text": "Around about a month, I think."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 36.91,
      "end_seconds": 42.16,
      "duration_seconds": 5.25,
      "text": "Yeah, hm, I'd say more like about two months."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 43.26,
      "end_seconds": 47.71,
      "duration_seconds": 4.45,
      "text": "Okay, so roughly one to two months. Is that right?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 48.24,
      "end_seconds": 51.29,
      "duration_seconds": 3.05,
      "text": "Oh, yes, somewhere around that."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 52.59,
      "end_seconds": 56.24,
      "duration_seconds": 3.65,
      "text": "Is there anything that takes the edge off?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 58.21,
      "end_seconds": 63.39,
      "duration_seconds": 5.18,
      "text": "Okay, you know, so lying still helps a bit."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 65.04,
      "end_seconds": 69.54,
      "duration_seconds": 4.5,
      "text": "Alright, anything that tends to go along with it?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 74.73,
      "end_seconds": 80.26,
      "duration_seconds": 5.53,
      "text": "Well, when it starts I tend to get nausea as well."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 81.77,
      "end_seconds": 84.22,
      "duration_seconds": 2.45,
      "text": "So, have you been feeling unsteady?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 85.89,
      "end_seconds": 88.24,
      "duration_seconds": 2.35,
      "text": "Yes, for two days."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 89.12,
      "end_seconds": 93.38,
      "duration_seconds": 4.26,
      "text": "What about a bit of vomiting, have you noticed that?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 94.67,
      "end_seconds": 96.82,
      "duration_seconds": 2.15,
      "text": "Yes, since this morning."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 104.39,
      "end_seconds": 109.19,
      "duration_seconds": 4.8,
      "text": "Right, have you noticed headache, weakness or numbness in the face?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 110.07,
      "end_seconds": 117.57,
      "duration_seconds": 7.5,
      "text": "Right, I haven't had headache, weakness or numbness in the face, no."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 119.35,
      "end_seconds": 122.08,
      "duration_seconds": 2.73,
      "text": "And double vision, any of that?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 123.52,
      "end_seconds": 127.3,
      "duration_seconds": 3.78,
      "text": "I, I haven't noticed any double vision."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 128.23,
      "end_seconds": 131.04,
      "duration_seconds": 2.81,
      "text": "Any muscle or joint problems besides this?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 132.15,
      "end_seconds": 134.02,
      "duration_seconds": 1.87,
      "text": "No, nothing there."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 135.29,
      "end_seconds": 137.86,
      "duration_seconds": 2.57,
      "text": "Any breathing difficulties apart from this?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 139.57,
      "end_seconds": 140.61,
      "duration_seconds": 1.04,
      "text": "Breathing's normal."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 141.71,
      "end_seconds": 145.63,
      "duration_seconds": 3.92,
      "text": "Moving on to your background, any past medical history?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 146.89,
      "end_seconds": 154.36,
      "duration_seconds": 7.47,
      "text": "I have diabetes. I'm not great at remembering details, so bear with me."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 155.9,
      "end_seconds": 157.48,
      "duration_seconds": 1.58,
      "text": "And apart from that?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 159.47,
      "end_seconds": 166.6,
      "duration_seconds": 7.13,
      "text": "I've had high blood pressure for two years now. I have gout."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 167.32,
      "end_seconds": 170.15,
      "duration_seconds": 2.83,
      "text": "Does anything run in the family?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 171.79,
      "end_seconds": 174.07,
      "duration_seconds": 2.28,
      "text": "My mother has diabetes."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 175.85,
      "end_seconds": 179.4,
      "duration_seconds": 3.55,
      "text": "Tell me what you take day to day."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 180.87,
      "end_seconds": 188.6,
      "duration_seconds": 7.73,
      "text": "Well, she is on amlodipine, once a day, I give it to her."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 190.01,
      "end_seconds": 192.17,
      "duration_seconds": 2.16,
      "text": "And what strength is that?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 192.98,
      "end_seconds": 194.05,
      "duration_seconds": 1.07,
      "text": "5 milligrams."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 194.94,
      "end_seconds": 196.54,
      "duration_seconds": 1.6,
      "text": "And for how long?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 198.4,
      "end_seconds": 215.8,
      "duration_seconds": 17.4,
      "text": "Two months now. She is on allopurinol, 100 milligrams, once a day for the gout, I give it to her. Well, she is on Vertin, 16 milligrams, when it comes, I give it to her."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 216.66,
      "end_seconds": 221.96,
      "duration_seconds": 5.3,
      "text": "I was on glimepiride before. I stopped taking it."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 232.14,
      "end_seconds": 234.01,
      "duration_seconds": 1.87,
      "text": "And alcohol, how much?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 235.44,
      "end_seconds": 240.29,
      "duration_seconds": 4.85,
      "text": "I have a couple of drinks on the weekend."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 240.92,
      "end_seconds": 242.98,
      "duration_seconds": 2.06,
      "text": "Are you active at all?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 244.75,
      "end_seconds": 248.03,
      "duration_seconds": 3.28,
      "text": "Barely, I'm mostly sedentary these days."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 249.54,
      "end_seconds": 251.58,
      "duration_seconds": 2.04,
      "text": "Are you living with family?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 252.43,
      "end_seconds": 257.32,
      "duration_seconds": 4.89,
      "text": "I stay with my daughter and her family."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 257.89,
      "end_seconds": 259.67,
      "duration_seconds": 1.78,
      "text": "Let's do your observations."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 269.74,
      "end_seconds": 271.7,
      "duration_seconds": 1.96,
      "text": "Just relax your arm..."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 289.9,
      "end_seconds": 297.44,
      "duration_seconds": 7.54,
      "text": "Okay: blood pressure 116 over 72, respiratory rate 18, heart rate 78, temperature 36.5."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 298.81,
      "end_seconds": 302.12,
      "duration_seconds": 3.31,
      "text": "Um, is that alright, doctor?"
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 303.38,
      "end_seconds": 306.18,
      "duration_seconds": 2.8,
      "text": "I'll come back to those numbers."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 309.02,
      "end_seconds": 311.52,
      "duration_seconds": 2.5,
      "text": "Let's do the physical part now."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 313.19,
      "end_seconds": 316.08,
      "duration_seconds": 2.89,
      "text": "Stay still while I have a look."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 334.5,
      "end_seconds": 338.71,
      "duration_seconds": 4.21,
      "text": "Your walking is steady and the finger-nose test is normal."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 339.63,
      "end_seconds": 342.74,
      "duration_seconds": 3.11,
      "text": "Stay still while I have a look."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 359.9,
      "end_seconds": 367.03,
      "duration_seconds": 7.13,
      "text": "When I turn your head to the right, your eyes flick sideways, that's called nystagmus."
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 372.46,
      "end_seconds": 374.99,
      "duration_seconds": 2.53,
      "text": "Thanks, please take a seat again."
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 386.9,
      "end_seconds": 409.75,
      "duration_seconds": 22.85,
      "text": "We should do a hearing test for tinnitus and vertigo. Get up slowly from lying down and sit for a moment first. The thing that would worry me is if you get weakness, slurred speech or a severe headache with the dizziness. If that happens, go to emergency."
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 410.47,
      "end_seconds": 411.17,
      "duration_seconds": 0.7,
      "text": "Understood."
    },
    {
      "segment_id": "SEG0059",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 411.87,
      "end_seconds": 414.8,
      "duration_seconds": 2.93,
      "text": "I'd like you back in two weeks."
    },
    {
      "segment_id": "SEG0060",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 416.73,
      "end_seconds": 421.19,
      "duration_seconds": 4.46,
      "text": "I'll make the appointment on my way out."
    },
    {
      "segment_id": "SEG0061",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 422.72,
      "end_seconds": 426.11,
      "duration_seconds": 3.39,
      "text": "Okay, we're done for today. Take care."
    },
    {
      "segment_id": "SEG0062",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 426.94,
      "end_seconds": 432.12,
      "duration_seconds": 5.18,
      "text": "Okay, so no, you've explained it well. Thanks."
    }
  ]
}