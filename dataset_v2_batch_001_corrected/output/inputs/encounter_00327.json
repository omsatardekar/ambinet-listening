{
  "schema_version": "1.0",
  "encounter_id": "00327",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.87,
      "end_seconds": 3.75,
      "duration_seconds": 2.88,
      "text": "Morning. Just put your bag down anywhere."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 4.8,
      "end_seconds": 7.17,
      "duration_seconds": 2.37,
      "text": "Hello, doctor, thank you."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 9.01,
      "end_seconds": 11.56,
      "duration_seconds": 2.55,
      "text": "Tell me what's been troubling you."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 12.26,
      "end_seconds": 15.8,
      "duration_seconds": 3.54,
      "text": "It's pain after standing at work, mostly."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 16.12,
      "end_seconds": 23.19,
      "duration_seconds": 7.07,
      "text": "Okay, keep going. Okay, give me more detail on it, whatever comes to mind."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 25.12,
      "end_seconds": 39.53,
      "duration_seconds": 14.41,
      "text": "Standing definitely sets it off. It sort of comes and goes. There's a tender spot on the sole as well. Oh, and limping a bit by the evening."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 53.45,
      "end_seconds": 57.61,
      "duration_seconds": 4.16,
      "text": "Which tablets or creams or inhalers do you use?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 58.59,
      "end_seconds": 62.68,
      "duration_seconds": 4.09,
      "text": "It's alendronate, 70 milligrams, once a week."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 63.77,
      "end_seconds": 68.49,
      "duration_seconds": 4.72,
      "text": "Let's talk a little about your daily life and habits."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 69.13,
      "end_seconds": 78.74,
      "duration_seconds": 9.61,
      "text": "I cycle to work most mornings. I work on a farm, it's quite physical. I try to avoid too much sugar."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 80.15,
      "end_seconds": 85.87,
      "duration_seconds": 5.72,
      "text": "Have you ever reacted badly to a medicine or food? Any allergies?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 86.81,
      "end_seconds": 96.69,
      "duration_seconds": 9.88,
      "text": "I had a reaction to sulfa drugs when I was younger, a rash, and I've avoided it since."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 105.54,
      "end_seconds": 108.47,
      "duration_seconds": 2.93,
      "text": "Have you got any chronic problems?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 109.61,
      "end_seconds": 112.2,
      "duration_seconds": 2.59,
      "text": "I've had thin bones, yes."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 112.98,
      "end_seconds": 118.53,
      "duration_seconds": 5.55,
      "text": "Let me check a few things. Any fever or numbness in the foot?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 120.0,
      "end_seconds": 123.78,
      "duration_seconds": 3.78,
      "text": "Well, no, none of that at all."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 124.32,
      "end_seconds": 131.6,
      "duration_seconds": 7.28,
      "text": "Let me check a few things. Any recent injury, swelling or pain in other joints?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 133.21,
      "end_seconds": 139.8,
      "duration_seconds": 6.59,
      "text": "Right, I haven't had recent injury, swelling or pain in other joints, no."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 140.69,
      "end_seconds": 143.31,
      "duration_seconds": 2.62,
      "text": "So, your breathing, any trouble there?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 144.32,
      "end_seconds": 146.54,
      "duration_seconds": 2.22,
      "text": "No problems with breathing."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 160.82,
      "end_seconds": 163.47,
      "duration_seconds": 2.65,
      "text": "I'll take a few measurements first."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 169.5,
      "end_seconds": 170.44,
      "duration_seconds": 0.94,
      "text": "One second..."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 190.63,
      "end_seconds": 194.86,
      "duration_seconds": 4.23,
      "text": "Okay: heart rate 71, blood pressure 120 over 72."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 195.48,
      "end_seconds": 197.13,
      "duration_seconds": 1.65,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 198.75,
      "end_seconds": 202.1,
      "duration_seconds": 3.35,
      "text": "Let's look at it together in a minute."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 205.02,
      "end_seconds": 207.14,
      "duration_seconds": 2.12,
      "text": "Okay, a quick examination now."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 208.36,
      "end_seconds": 209.06,
      "duration_seconds": 0.7,
      "text": "Okay."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 210.57,
      "end_seconds": 212.58,
      "duration_seconds": 2.01,
      "text": "Bear with me a second."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 223.72,
      "end_seconds": 226.36,
      "duration_seconds": 2.64,
      "text": "The ankle and foot move fully."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 227.06,
      "end_seconds": 228.99,
      "duration_seconds": 1.93,
      "text": "Yes, um, doctor."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 230.19,
      "end_seconds": 232.63,
      "duration_seconds": 2.44,
      "text": "Bear with me a second."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 246.06,
      "end_seconds": 249.64,
      "duration_seconds": 3.58,
      "text": "Pressing on the inner heel brings on the pain."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 250.61,
      "end_seconds": 252.59,
      "duration_seconds": 1.98,
      "text": "Okay, um, ready."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 255.73,
      "end_seconds": 267.29,
      "duration_seconds": 11.56,
      "text": "Thanks, please take a seat again. Having listened and examined, it points towards plantar fasciitis. I can't rule out a stress reaction in the bone yet."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 269.09,
      "end_seconds": 271.66,
      "duration_seconds": 2.57,
      "text": "Do you think it's serious?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 274.74,
      "end_seconds": 305.7,
      "duration_seconds": 30.96,
      "text": "Nothing I've seen today points to an emergency. It looks like plantar fasciitis, but I'd like to confirm. I'd like to arrange an X-ray of the foot for heel pain. Roll the sole over a bottle and stretch the calf against a wall twice a day. Supportive shoes with a cushioned heel help. I'll want another look in six weeks. Call the clinic if you need us."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 306.81,
      "end_seconds": 311.26,
      "duration_seconds": 4.45,
      "text": "No, I think that's everything. Thank you, doctor."
    }
  ]
}