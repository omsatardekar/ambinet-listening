{
  "schema_version": "1.0",
  "encounter_id": "00117",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.63,
      "end_seconds": 4.51,
      "duration_seconds": 3.88,
      "text": "sorry I'm a few minutes behind, doctor"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.48,
      "end_seconds": 10.28,
      "duration_seconds": 3.8,
      "text": "Not at all, please sit. What's the problem?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 11.71,
      "end_seconds": 16.46,
      "duration_seconds": 4.75,
      "text": "Good morning, doctor. I came along to help out."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 18.17,
      "end_seconds": 24.04,
      "duration_seconds": 5.87,
      "text": "Honestly, it's gritty tired eyes, and my family pushed me to come."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 24.69,
      "end_seconds": 26.82,
      "duration_seconds": 2.13,
      "text": "And when did that start?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 27.61,
      "end_seconds": 31.64,
      "duration_seconds": 4.03,
      "text": "I, I'd say about a month, maybe."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 32.62,
      "end_seconds": 36.87,
      "duration_seconds": 4.25,
      "text": "Hm, I'd say more like about two months."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 41.37,
      "end_seconds": 45.42,
      "duration_seconds": 4.05,
      "text": "Okay, so roughly one to two months. Is that right?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 46.22,
      "end_seconds": 48.29,
      "duration_seconds": 2.07,
      "text": "yes, somewhere around that"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 49.23,
      "end_seconds": 52.37,
      "duration_seconds": 3.14,
      "text": "How bad is it, would you say?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 54.09,
      "end_seconds": 64.71,
      "duration_seconds": 10.62,
      "text": "Pretty severe, if I'm being honest. I've had blurry vision that clears when I blink too, for about four days."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 66.07,
      "end_seconds": 69.59,
      "duration_seconds": 3.52,
      "text": "has there been redness by the evening too?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 70.15,
      "end_seconds": 78.41,
      "duration_seconds": 8.26,
      "text": "mm, yes. I had burning at the end of the day before. That's settled now, though"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 92.7,
      "end_seconds": 96.58,
      "duration_seconds": 3.88,
      "text": "let's go through your medication what are you taking?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 98.31,
      "end_seconds": 117.83,
      "duration_seconds": 19.52,
      "text": "Furosemide. I take it 40 milligrams, every morning. I take artificial tears, when needed. I looked a few things up online, and that probably didn't help. I used to take spironolactone, but I stopped it."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 126.97,
      "end_seconds": 129.38,
      "duration_seconds": 2.41,
      "text": "Now some background about your lifestyle."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 131.14,
      "end_seconds": 146.67,
      "duration_seconds": 15.53,
      "text": "I stopped smoking about two years back. I have a couple of drinks on the weekend. I'm mostly vegetarian. I play badminton on Sundays. I teach at a primary school."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 148.55,
      "end_seconds": 151.32,
      "duration_seconds": 2.77,
      "text": "Is there anything medical in your background?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 153.01,
      "end_seconds": 157.65,
      "duration_seconds": 4.64,
      "text": "I've got an enlarged prostate. Yes, heart failure."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 158.56,
      "end_seconds": 165.81,
      "duration_seconds": 7.25,
      "text": "Right, so an enlarged prostate is already on your record. We'll keep that in mind today."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 179.65,
      "end_seconds": 183.59,
      "duration_seconds": 3.94,
      "text": "any relatives with health problems I should be aware of?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 184.89,
      "end_seconds": 189.97,
      "duration_seconds": 5.08,
      "text": "My father had a heart attack. Oh, my mother has migraines."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 191.83,
      "end_seconds": 194.85,
      "duration_seconds": 3.02,
      "text": "What about operations, anything like that?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 196.72,
      "end_seconds": 201.01,
      "duration_seconds": 4.29,
      "text": "Just my appendix out, about eight years ago."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 202.2,
      "end_seconds": 207.86,
      "duration_seconds": 5.66,
      "text": "Have you noticed dry mouth, sensitivity to light, discharge or loss of vision?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 208.82,
      "end_seconds": 210.77,
      "duration_seconds": 1.95,
      "text": "Nothing like that, no."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 211.61,
      "end_seconds": 214.11,
      "duration_seconds": 2.5,
      "text": "Did you notice any double vision?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 215.16,
      "end_seconds": 217.21,
      "duration_seconds": 2.05,
      "text": "Nope, no double vision."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 218.5,
      "end_seconds": 222.91,
      "duration_seconds": 4.41,
      "text": "Anything with your heart, like skipped beats or fainting?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 224.63,
      "end_seconds": 226.29,
      "duration_seconds": 1.66,
      "text": "nothing like that"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 228.54,
      "end_seconds": 230.67,
      "duration_seconds": 2.13,
      "text": "Okay, a quick examination now."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 231.52,
      "end_seconds": 232.51,
      "duration_seconds": 0.99,
      "text": "No problem."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 233.41,
      "end_seconds": 235.61,
      "duration_seconds": 2.2,
      "text": "just relax, I'll be quick"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 251.88,
      "end_seconds": 257.23,
      "duration_seconds": 5.35,
      "text": "the eyes look a little pink but the corneas are clear"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 259.11,
      "end_seconds": 260.04,
      "duration_seconds": 0.93,
      "text": "No problem."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 262.72,
      "end_seconds": 272.89,
      "duration_seconds": 10.17,
      "text": "that's all I need, thank you. So, based on the history and the examination, it points towards dry eye. Digital eye strain is still possible"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 273.61,
      "end_seconds": 276.62,
      "duration_seconds": 3.01,
      "text": "Is it it something serious, doctor?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 278.39,
      "end_seconds": 297.1,
      "duration_seconds": 18.71,
      "text": "nothing I've seen today points to an emergency it looks like dry eye, but I'd like to confirm let me just check I've got this right you've had gritty tired eyes, severe, and no discharge or sensitivity to light"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 297.72,
      "end_seconds": 298.42,
      "duration_seconds": 0.7,
      "text": "Exactly."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 300.34,
      "end_seconds": 304.96,
      "duration_seconds": 4.62,
      "text": "I think an eye check makes sense here, for gritty eyes"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 305.49,
      "end_seconds": 308.32,
      "duration_seconds": 2.83,
      "text": "Where do I go for that?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 309.07,
      "end_seconds": 316.2,
      "duration_seconds": 7.13,
      "text": "Look away from the screen every twenty minutes and blink fully. Come back in four weeks."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 317.95,
      "end_seconds": 320.21,
      "duration_seconds": 2.26,
      "text": "Okay, I'll book that."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 322.21,
      "end_seconds": 324.64,
      "duration_seconds": 2.43,
      "text": "do you have any questions?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 325.94,
      "end_seconds": 329.17,
      "duration_seconds": 3.23,
      "text": "No, you've explained it well. Thanks."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 331.15,
      "end_seconds": 331.85,
      "duration_seconds": 0.7,
      "text": "Goodbye."
    }
  ]
}