{
  "schema_version": "1.0",
  "encounter_id": "00310",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 0.59,
      "end_seconds": 5.32,
      "duration_seconds": 4.73,
      "text": "Doctor, we're ready in room two, I've already taken the observations."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.27,
      "end_seconds": 10.25,
      "duration_seconds": 3.98,
      "text": "Perfect, thanks. Hello there, so what's the trouble?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 15.6,
      "end_seconds": 19.73,
      "duration_seconds": 4.13,
      "text": "I've been feeling anxious most of the day."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 20.51,
      "end_seconds": 22.81,
      "duration_seconds": 2.3,
      "text": "And when did that start?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 27.43,
      "end_seconds": 30.61,
      "duration_seconds": 3.18,
      "text": "I've had it for one week."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 32.2,
      "end_seconds": 36.47,
      "duration_seconds": 4.27,
      "text": "How would you describe it, mild, moderate, severe?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 41.39,
      "end_seconds": 44.48,
      "duration_seconds": 3.09,
      "text": "Pretty severe, if I'm being honest."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 58.19,
      "end_seconds": 63.05,
      "duration_seconds": 4.86,
      "text": "And what about weight loss, thoughts of harming myself or low mood?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 63.99,
      "end_seconds": 71.04,
      "duration_seconds": 7.05,
      "text": "No weight loss, thoughts of harming myself or low mood, none of it."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 72.05,
      "end_seconds": 74.12,
      "duration_seconds": 2.07,
      "text": "Did you notice any fainting?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 76.02,
      "end_seconds": 78.16,
      "duration_seconds": 2.14,
      "text": "No, none, no fainting."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 79.82,
      "end_seconds": 83.99,
      "duration_seconds": 4.17,
      "text": "Any change in your bowel habit or your stomach generally?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 85.28,
      "end_seconds": 86.85,
      "duration_seconds": 1.57,
      "text": "Nothing unusual, no."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 95.02,
      "end_seconds": 98.61,
      "duration_seconds": 3.59,
      "text": "Tell me what you take day to day."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 100.27,
      "end_seconds": 104.15,
      "duration_seconds": 3.88,
      "text": "Hydrocortisone cream, when needed for the eczema."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 105.04,
      "end_seconds": 107.62,
      "duration_seconds": 2.58,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 109.35,
      "end_seconds": 111.05,
      "duration_seconds": 1.7,
      "text": "No operations, no."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 116.07,
      "end_seconds": 120.15,
      "duration_seconds": 4.08,
      "text": "Any relatives with health problems I should be aware of?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 123.67,
      "end_seconds": 125.48,
      "duration_seconds": 1.81,
      "text": "My mother has diabetes."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 131.09,
      "end_seconds": 134.39,
      "duration_seconds": 3.3,
      "text": "Right, now some background about your lifestyle."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 137.49,
      "end_seconds": 150.59,
      "duration_seconds": 13.1,
      "text": "Not really, I don't get much exercise. I run a small shop, so I'm on my feet a lot. I stay with my daughter and her family."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 151.86,
      "end_seconds": 155.31,
      "duration_seconds": 3.45,
      "text": "Any long-term health problems I should know about?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 155.87,
      "end_seconds": 173.19,
      "duration_seconds": 17.32,
      "text": "I have anxiety, for nearly five years. I've had eczema for about a year now. I kept putting it off, which I know isn't sensible. It's the not knowing that gets to me."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 173.74,
      "end_seconds": 184.88,
      "duration_seconds": 11.14,
      "text": "Here are the numbers, doctor. Temperature is 37.0 degrees, pulse is 76 beats a minute, oxygen saturation is 97 percent, pressure 128 over 68."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 186.96,
      "end_seconds": 188.28,
      "duration_seconds": 1.32,
      "text": "Good, thank you."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 190.77,
      "end_seconds": 194.42,
      "duration_seconds": 3.65,
      "text": "Okay, I need to examine you for this."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 203.12,
      "end_seconds": 203.82,
      "duration_seconds": 0.7,
      "text": "Fine."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 205.66,
      "end_seconds": 207.68,
      "duration_seconds": 2.02,
      "text": "Tell me if anything hurts."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 220.47,
      "end_seconds": 224.54,
      "duration_seconds": 4.07,
      "text": "Pulse is regular and you're breathing comfortably right now."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 225.79,
      "end_seconds": 226.49,
      "duration_seconds": 0.7,
      "text": "Fine."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 230.73,
      "end_seconds": 237.25,
      "duration_seconds": 6.52,
      "text": "Thanks, please take a seat again. Putting it all together, I'd lean towards an anxiety disorder."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 238.85,
      "end_seconds": 242.4,
      "duration_seconds": 3.55,
      "text": "Is this something I'll have for good?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 242.92,
      "end_seconds": 260.65,
      "duration_seconds": 17.73,
      "text": "It's reasonable to be concerned, but right now an anxiety disorder is my leading thought, not anything worse. Let me repeat that back to make sure. You've been feeling anxious most of the day for one week, severe, and no fainting or weight loss."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 262.37,
      "end_seconds": 264.11,
      "duration_seconds": 1.74,
      "text": "Yes, that's right."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 275.64,
      "end_seconds": 292.8,
      "duration_seconds": 17.16,
      "text": "I'm sending you for an ECG because of palpitations. You'll be taking escitalopram, 5 milligrams, once a day, for two weeks then review. That should help with anxiety. Regular exercise and less caffeine make a real difference. See me again in two weeks."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 293.88,
      "end_seconds": 295.79,
      "duration_seconds": 1.91,
      "text": "Okay, I'll book that."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 297.01,
      "end_seconds": 299.29,
      "duration_seconds": 2.28,
      "text": "Alright, I'll see you out."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 300.43,
      "end_seconds": 304.07,
      "duration_seconds": 3.64,
      "text": "That's everything I wanted to ask. Thank you."
    }
  ]
}