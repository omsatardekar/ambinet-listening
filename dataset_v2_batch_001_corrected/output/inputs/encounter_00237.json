{
  "schema_version": "1.0",
  "encounter_id": "00237",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.98,
      "end_seconds": 6.05,
      "duration_seconds": 5.07,
      "text": "Hi, doctor. Long queue outside, but here I am."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.71,
      "end_seconds": 10.85,
      "duration_seconds": 4.14,
      "text": "That's alright, take a seat. Tell me why you've come."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 15.68,
      "end_seconds": 18.71,
      "duration_seconds": 3.03,
      "text": "It's blood in my urine, mostly."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 20.74,
      "end_seconds": 23.68,
      "duration_seconds": 2.94,
      "text": "Since when have you had this?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 24.7,
      "end_seconds": 27.37,
      "duration_seconds": 2.67,
      "text": "It's been three days now."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 27.7,
      "end_seconds": 28.67,
      "duration_seconds": 0.97,
      "text": "Hm, okay."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 34.04,
      "end_seconds": 43.04,
      "duration_seconds": 9.0,
      "text": "Oh, and and it was red twice this week. That's been about the same, two months."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 44.97,
      "end_seconds": 51.64,
      "duration_seconds": 6.67,
      "text": "Have you had blood in your urine before, or is this the first time?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 52.72,
      "end_seconds": 58.36,
      "duration_seconds": 5.64,
      "text": "I, I had a similar thing last year. It went away."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 60.11,
      "end_seconds": 63.29,
      "duration_seconds": 3.18,
      "text": "So, I'll take a few measurements first."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 70.75,
      "end_seconds": 73.16,
      "duration_seconds": 2.41,
      "text": "Okay, give me a moment..."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 90.1,
      "end_seconds": 100.79,
      "duration_seconds": 10.69,
      "text": "Okay: SpO2 98 percent on room air, pressure 122 over 80, pulse is 75 beats a minute. And temperature is 36.4 degrees."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 103.57,
      "end_seconds": 107.34,
      "duration_seconds": 3.77,
      "text": "Okay, I need to examine you for this."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 108.83,
      "end_seconds": 112.48,
      "duration_seconds": 3.65,
      "text": "A little pressure here, tell me if it's tender."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 130.68,
      "end_seconds": 135.98,
      "duration_seconds": 5.3,
      "text": "Abdomen is soft, no masses, and and no tenderness in the loins."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 140.7,
      "end_seconds": 142.6,
      "duration_seconds": 1.9,
      "text": "Good, that's the examination."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 153.04,
      "end_seconds": 158.03,
      "duration_seconds": 4.99,
      "text": "Have you noticed recent injury, weight loss or difficulty passing urine?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 158.59,
      "end_seconds": 160.3,
      "duration_seconds": 1.71,
      "text": "No, nothing there."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 161.58,
      "end_seconds": 164.31,
      "duration_seconds": 2.73,
      "text": "Have you noticed flank pain or fever?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 165.17,
      "end_seconds": 166.94,
      "duration_seconds": 1.77,
      "text": "no, nothing there"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 168.99,
      "end_seconds": 172.43,
      "duration_seconds": 3.44,
      "text": "Anything with your nerves, like weakness or numbness?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 177.21,
      "end_seconds": 179.3,
      "duration_seconds": 2.09,
      "text": "No, nothing like that."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 195.35,
      "end_seconds": 202.55,
      "duration_seconds": 7.2,
      "text": "Tell me about your health in general, any ongoing conditions? Take your time, there's no rush."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 204.04,
      "end_seconds": 209.88,
      "duration_seconds": 5.84,
      "text": "High blood pressure, for about a year. I've got heart disease."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 210.58,
      "end_seconds": 218.63,
      "duration_seconds": 8.05,
      "text": "Okay, I can see high blood pressure in your file as well. Alright, do you exercise at all?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 219.73,
      "end_seconds": 225.53,
      "duration_seconds": 5.8,
      "text": "I go to the gym a couple of times a week."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 227.26,
      "end_seconds": 230.75,
      "duration_seconds": 3.49,
      "text": "Right, is anyone at home with you?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 232.01,
      "end_seconds": 235.8,
      "duration_seconds": 3.79,
      "text": "I share a flat with two friends."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 239.55,
      "end_seconds": 241.67,
      "duration_seconds": 2.12,
      "text": "Any surgery in your history?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 242.46,
      "end_seconds": 246.44,
      "duration_seconds": 3.98,
      "text": "I had a bypass operation six years ago."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 247.59,
      "end_seconds": 250.1,
      "duration_seconds": 2.51,
      "text": "Does anything run in the family?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 251.41,
      "end_seconds": 254.21,
      "duration_seconds": 2.8,
      "text": "my uncle had colon cancer"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 255.94,
      "end_seconds": 261.94,
      "duration_seconds": 6.0,
      "text": "Any drug or food allergies? I'm asking so that we don't miss anything."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 264.03,
      "end_seconds": 268.7,
      "duration_seconds": 4.67,
      "text": "Sulfa drugs. I come out in... well, itching all over."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 269.9,
      "end_seconds": 272.46,
      "duration_seconds": 2.56,
      "text": "What medicines do you take regularly?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 273.17,
      "end_seconds": 277.04,
      "duration_seconds": 3.87,
      "text": "Ramipril. I take it 5 milligrams, every morning."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 277.29,
      "end_seconds": 277.99,
      "duration_seconds": 0.7,
      "text": "ah"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 279.64,
      "end_seconds": 282.99,
      "duration_seconds": 3.35,
      "text": "Aspirin, 75 milligrams, once a day."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 284.72,
      "end_seconds": 299.58,
      "duration_seconds": 14.86,
      "text": "From what you've told me and what I found, the most likely explanation is blood in the urine that needs full investigation. I'd also keep a kidney stone in mind."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 300.95,
      "end_seconds": 303.56,
      "duration_seconds": 2.61,
      "text": "Well, doctor, is this dangerous?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 304.16,
      "end_seconds": 332.62,
      "duration_seconds": 28.46,
      "text": "nothing I've seen today points to an emergency it looks like blood in the urine that needs full investigation, but I'd like to confirm i'll request a urine culture, it'll help with haematuria i'd like to arrange a urine test for haematuria it's a routine test and it'll give us a much clearer picture keep drinking plenty of water, and let us know quickly if you pass clots or can't pass urine"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 333.68,
      "end_seconds": 336.74,
      "duration_seconds": 3.06,
      "text": "Let's plan a check in two weeks."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 338.41,
      "end_seconds": 339.11,
      "duration_seconds": 0.7,
      "text": "okay"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 339.86,
      "end_seconds": 341.32,
      "duration_seconds": 1.46,
      "text": "Any last questions?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 343.65,
      "end_seconds": 345.92,
      "duration_seconds": 2.27,
      "text": "I appreciate it, doctor."
    }
  ]
}