    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 18.9,
      "end_seconds": 21.4,
      "duration_seconds": 2.5,
      "text": "What seems to be the problem?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 22.83,
      "end_seconds": 28.18,
      "duration_seconds": 5.35,
      "text": "he's been waking up at night short of breath doctor"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 28.7,
      "end_seconds": 30.95,
      "duration_seconds": 2.25,
      "text": "and when did that start?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 32.13,
      "end_seconds": 34.56,
      "duration_seconds": 2.43,
      "text": "Probably about four days. Yeah."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 39.51,
      "end_seconds": 47.16,
      "duration_seconds": 7.65,
      "text": "Can you describe it a bit more for me? How strong it is, what the pattern is, what helps."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 47.92,
      "end_seconds": 75.12,
      "duration_seconds": 27.2,
      "text": "uh only sitting up and it's not much it feels mild to me i'd say every other day well I've also had a dry cough at night about dry cough at night moderate really it sort of comes and goes i've also had swelling in both ankles"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 77.02,
      "end_seconds": 80.83,
      "duration_seconds": 3.81,
      "text": "Any coughing up blood or fainting at all?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 82.07,
      "end_seconds": 86.58,
      "duration_seconds": 4.51,
      "text": "Hmm, no, none of that at all."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 87.77,
      "end_seconds": 91.64,
      "duration_seconds": 3.87,
      "text": "any fever chest pain or palpitations at all?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 92.6,
      "end_seconds": 94.72,
      "duration_seconds": 2.12,
      "text": "No none of those."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 96.48,
      "end_seconds": 99.7,
      "duration_seconds": 3.22,
      "text": "Anything with your nerves like weakness or numbness?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 100.92,
      "end_seconds": 103.26,
      "duration_seconds": 2.34,
      "text": "no, that's all normal"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 105.0,
      "end_seconds": 108.8,
      "duration_seconds": 3.8,
      "text": "so, anything on the skin I should know about?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 110.82,
      "end_seconds": 111.86,
      "duration_seconds": 1.04,
      "text": "No rashes."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 113.47,
      "end_seconds": 116.98,
      "duration_seconds": 3.51,
      "text": "so, have you got any chronic problems?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 117.87,
      "end_seconds": 123.99,
      "duration_seconds": 6.12,
      "text": "Well, I've had heart failure for nearly five years now."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 125.68,
      "end_seconds": 126.89,
      "duration_seconds": 1.21,
      "text": "is there more?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 128.11,
      "end_seconds": 134.97,
      "duration_seconds": 6.86,
      "text": "I've had heart disease for about a year now. Yes, high blood pressure."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 140.86,
      "end_seconds": 142.17,
      "duration_seconds": 1.31,
      "text": "is there more?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 143.56,
      "end_seconds": 145.72,
      "duration_seconds": 2.16,
      "text": "I've, I've got diabetes"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 148.7,
      "end_seconds": 156.65,
      "duration_seconds": 7.95,
      "text": "Ah. Okay I can see heart failure in your file as well. Any operations in the past?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 158.28,
      "end_seconds": 163.91,
      "duration_seconds": 5.63,
      "text": "Yes, I had a hernia repair, about five years back."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 165.25,
      "end_seconds": 169.42,
      "duration_seconds": 4.17,
      "text": "Let's go through your medication. What are you taking?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 171.26,
      "end_seconds": 182.13,
      "duration_seconds": 10.87,
      "text": "So I'm on furosemide 40 milligrams every morning. Aspirin. I take it 75 milligrams once a day for my heart."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 184.14,
      "end_seconds": 196.61,
      "duration_seconds": 12.47,
      "text": "I mean you know doctor I think the last prescription for the aspirin was 150 milligrams. We changed it at the last visit."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 198.27,
      "end_seconds": 203.31,
      "duration_seconds": 5.04,
      "text": "Okay. Have you got the newest prescription or the box with you?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 205.07,
      "end_seconds": 216.96,
      "duration_seconds": 11.89,
      "text": "I don't think I have it with me oh, um, I'm on ramipril, 5 milligrams, every morning for my blood pressure"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 225.99,
      "end_seconds": 228.5,
      "duration_seconds": 2.51,
      "text": "now some background about your lifestyle"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 229.78,
      "end_seconds": 244.94,
      "duration_seconds": 15.16,
      "text": "I walk for about half an hour most days. I work in an office, mostly sitting at a desk. It's just me and my wife at home now."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 246.29,
      "end_seconds": 249.93,
      "duration_seconds": 3.64,
      "text": "do you have any known allergies at all?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 251.83,
      "end_seconds": 256.07,
      "duration_seconds": 4.24,
      "text": "No allergies that I know of no."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 257.67,
      "end_seconds": 267.08,
      "duration_seconds": 9.41,
      "text": "actually I remember he had some kind of reaction to ibuprofen before i couldn't swear to it"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 268.04,
      "end_seconds": 270.56,
      "duration_seconds": 2.52,
      "text": "really? I don't think so"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 271.28,
      "end_seconds": 274.41,
      "duration_seconds": 3.13,
      "text": "fair enough I'll write down both versions"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_4",
      "role": "NURSE",
      "start_seconds": 285.51,
      "end_seconds": 293.04,
      "duration_seconds": 7.53,
      "text": "Doctor I've got the readings for you. Pulse 100 pressure 141 over 84 saturation 93 percent temp 36.8 degrees."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 298.92,
      "end_seconds": 300.18,
      "duration_seconds": 1.26,
      "text": "good thank you"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 302.4,
      "end_seconds": 305.42,
      "duration_seconds": 3.02,
      "text": "let me examine, it won't take long"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 310.16,
      "end_seconds": 310.86,
      "duration_seconds": 0.7,
      "text": "alright"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 312.72,
      "end_seconds": 314.4,
      "duration_seconds": 1.68,
      "text": "let me press here"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 327.71,
      "end_seconds": 332.52,
      "duration_seconds": 4.81,
      "text": "I can hear crackles at the bases of both lungs"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 333.6,
      "end_seconds": 336.4,
      "duration_seconds": 2.8,
      "text": "Let me look at this properly."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 353.46,
      "end_seconds": 355.22,
      "duration_seconds": 1.76,
      "text": "Neck veins are raised."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 357.17,
      "end_seconds": 359.55,
      "duration_seconds": 2.38,
      "text": "Tell me if anything hurts."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 377.68,
      "end_seconds": 382.75,
      "duration_seconds": 5.07,
      "text": "There's pitting oedema up to the the shins on both legs."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 383.86,
      "end_seconds": 384.56,
      "duration_seconds": 0.7,
      "text": "Okay."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 390.46,
      "end_seconds": 409.23,
      "duration_seconds": 18.77,
      "text": "okay, you can sit up. Right, here's what I'm thinking. I'd lean towards fluid overload related to the heart. The reason I say that is that your story and my examination fit together. A chest infection is still possible"
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 414.27,
      "end_seconds": 417.57,
      "duration_seconds": 3.3,
      "text": "Is it it something serious, doctor?"
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 419.01,
      "end_seconds": 428.73,
      "duration_seconds": 9.72,
      "text": "I can't promise yet, but most people with fluid overload related to the heart do well once it's treated properly."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_4",
      "role": "NURSE",
      "start_seconds": 445.49,
      "end_seconds": 448.89,
      "duration_seconds": 3.4,
      "text": "we've already done an ECG this morning, doctor"
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 450.86,
      "end_seconds": 464.74,
      "duration_seconds": 13.88,
      "text": "thanks, I'll check it i'm going to order an echocardiogram, for breathlessness and swelling i'd rather check than guess, and this is the quickest way to know more"
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 465.26,
      "end_seconds": 466.47,
      "duration_seconds": 1.21,
      "text": "mm okay"
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 467.52,
      "end_seconds": 494.34,
      "duration_seconds": 26.82,
      "text": "I want blood tests done that's for heart failure review keep the salt and the fluids moderate no more than about one and a half litres a day weigh yourself every morning and tell us if you put on more than two kilos in a few days and please bring the latest prescription or the medicine boxes to the next visit so we can settle the dose"
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 495.59,
      "end_seconds": 500.06,
      "duration_seconds": 4.47,
      "text": "oh, yes, I'll keep that in mind"
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 501.2,
      "end_seconds": 507.14,
      "duration_seconds": 5.94,
      "text": "book a review in one week call the clinic if you need us"
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 507.95,
      "end_seconds": 510.4,
      "duration_seconds": 2.45,
      "text": "Thanks, that was helpful."
    },
    {
      "segment_id": "SEG0059",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 512.27,
      "end_seconds": 514.04,
      "duration_seconds": 1.77,
      "text": "Mind how you go."
    }
