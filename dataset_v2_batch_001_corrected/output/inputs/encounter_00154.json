{
  "schema_version": "1.0",
  "encounter_id": "00154",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.03,
      "end_seconds": 9.31,
      "duration_seconds": 8.28,
      "text": "Hi doctor, you know, sorry, the lift was out and I had to take the stairs."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 11.27,
      "end_seconds": 17.78,
      "duration_seconds": 6.51,
      "text": "Yes, come in, take a seat. What can I do for you today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 19.29,
      "end_seconds": 24.17,
      "duration_seconds": 4.88,
      "text": "Good morning, doctor. I came along to help out."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 24.79,
      "end_seconds": 30.48,
      "duration_seconds": 5.69,
      "text": "I've been coughing after exercise, and I wanted to get it checked."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 31.36,
      "end_seconds": 34.52,
      "duration_seconds": 3.16,
      "text": "First the numbers, if you don't mind."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 46.92,
      "end_seconds": 48.88,
      "duration_seconds": 1.96,
      "text": "Just relax your arm..."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 59.23,
      "end_seconds": 69.42,
      "duration_seconds": 10.19,
      "text": "Okay: temperature 36.7, pressure 125 over 76, saturation 97 percent, respiratory rate 17, pulse is 82 beats a minute."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 69.98,
      "end_seconds": 71.64,
      "duration_seconds": 1.66,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 72.92,
      "end_seconds": 78.55,
      "duration_seconds": 5.63,
      "text": "I'll interpret it once I've examined you. How far back does it go?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 80.03,
      "end_seconds": 84.98,
      "duration_seconds": 4.95,
      "text": "I mean, uh, I'd say three days, maybe."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 85.59,
      "end_seconds": 89.83,
      "duration_seconds": 4.24,
      "text": "Um, it was closer to five days, doctor."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 93.69,
      "end_seconds": 98.71,
      "duration_seconds": 5.02,
      "text": "Okay, so roughly three to five days. Is that right?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 100.33,
      "end_seconds": 102.22,
      "duration_seconds": 1.89,
      "text": "That sounds about right."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 103.31,
      "end_seconds": 106.13,
      "duration_seconds": 2.82,
      "text": "Does it come along with anything else?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 107.82,
      "end_seconds": 115.76,
      "duration_seconds": 7.94,
      "text": "When it starts I tend to get a tickle in the chest as well."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 121.34,
      "end_seconds": 125.14,
      "duration_seconds": 3.8,
      "text": "Have you had a dry cough at night?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 125.98,
      "end_seconds": 145.14,
      "duration_seconds": 19.16,
      "text": "Yes, about the same, ten days. I mean, uh, about dry cough at night, a four out of ten, I suppose. It just comes and goes. Cold air definitely sets it off."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 145.6,
      "end_seconds": 146.3,
      "duration_seconds": 0.7,
      "text": "Mm."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 147.64,
      "end_seconds": 163.64,
      "duration_seconds": 16.0,
      "text": "The tickle in the chest? That's been for four weeks. Oh, uh, and a mild wheeze at times. About mild wheeze at times, I'd call it severe."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 165.36,
      "end_seconds": 169.71,
      "duration_seconds": 4.35,
      "text": "So, a few quick ones: chest pain or heartburn?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 171.74,
      "end_seconds": 176.22,
      "duration_seconds": 4.48,
      "text": "No, um, no chest pain or heartburn."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 177.25,
      "end_seconds": 181.19,
      "duration_seconds": 3.94,
      "text": "A few quick ones: fever or weight loss?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 187.35,
      "end_seconds": 192.35,
      "duration_seconds": 5.0,
      "text": "So, I haven't had fever or weight loss, no."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 194.28,
      "end_seconds": 200.05,
      "duration_seconds": 5.77,
      "text": "Right, have you noticed any weakness, or anything odd with your balance?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 200.91,
      "end_seconds": 203.3,
      "duration_seconds": 2.39,
      "text": "No, nothing like that."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 208.23,
      "end_seconds": 212.68,
      "duration_seconds": 4.45,
      "text": "Anything with your heart, like skipped beats or fainting?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 213.21,
      "end_seconds": 215.76,
      "duration_seconds": 2.55,
      "text": "No, nothing with my heart."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 218.33,
      "end_seconds": 222.26,
      "duration_seconds": 3.93,
      "text": "Let's talk a little about your daily life and habits."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 223.2,
      "end_seconds": 238.63,
      "duration_seconds": 15.43,
      "text": "I gave up drinking about three years ago. I stopped smoking about two years back. I go to the gym a couple of times a week. I'm mostly vegetarian."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 239.13,
      "end_seconds": 242.01,
      "duration_seconds": 2.88,
      "text": "Any allergies I should know about?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 242.66,
      "end_seconds": 245.79,
      "duration_seconds": 3.13,
      "text": "I don't have any known medication allergies."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 259.55,
      "end_seconds": 263.4,
      "duration_seconds": 3.85,
      "text": "Right, tell me what you take day to day."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 265.46,
      "end_seconds": 268.81,
      "duration_seconds": 3.35,
      "text": "Clopidogrel, 75 milligrams, once a day."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 270.0,
      "end_seconds": 280.96,
      "duration_seconds": 10.96,
      "text": "Yeah, you know, doctor, I think the last prescription for the clopidogrel was 37.5 milligrams. We changed it at the last visit."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 282.41,
      "end_seconds": 285.21,
      "duration_seconds": 2.8,
      "text": "Alright. Did you bring the up-to-date prescription?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 286.17,
      "end_seconds": 294.66,
      "duration_seconds": 8.49,
      "text": "Not with me. I'll bring it next time. Atorvastatin, 20 milligrams, at night for my cholesterol."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 295.4,
      "end_seconds": 301.18,
      "duration_seconds": 5.78,
      "text": "That's what's prescribed, but I'm not sure she takes it every day."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 314.71,
      "end_seconds": 317.06,
      "duration_seconds": 2.35,
      "text": "Does anything run in the family?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 319.14,
      "end_seconds": 322.48,
      "duration_seconds": 3.34,
      "text": "Okay, so my mother has diabetes."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 324.52,
      "end_seconds": 329.18,
      "duration_seconds": 4.66,
      "text": "Do you have any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 331.21,
      "end_seconds": 337.18,
      "duration_seconds": 5.97,
      "text": "I've got eczema. I have heart disease. I've got high cholesterol."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 338.01,
      "end_seconds": 345.06,
      "duration_seconds": 7.05,
      "text": "Okay, keep going. Yes, eczema is known to us, good to have that clear."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 363.58,
      "end_seconds": 366.65,
      "duration_seconds": 3.07,
      "text": "Right, have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 368.38,
      "end_seconds": 370.14,
      "duration_seconds": 1.76,
      "text": "No operations, no."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 371.17,
      "end_seconds": 386.74,
      "duration_seconds": 15.57,
      "text": "Putting together what you've described, the most likely explanation is cough-variant asthma. We shouldn't forget reflux-related cough. I'm sending you for breathing tests because of chronic cough. I'm sending you for a peak flow reading because of chronic cough."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 387.74,
      "end_seconds": 389.99,
      "duration_seconds": 2.25,
      "text": "Does it need any preparation?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 390.87,
      "end_seconds": 423.07,
      "duration_seconds": 32.2,
      "text": "What I'm giving you is salbutamol inhaler, 100 micrograms, two puffs when needed, for two weeks. It's for cough and wheeze. The pharmacy will go through the details again when you pick it up. Try the inhaler before exercise and note whether the cough settles. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 423.6,
      "end_seconds": 426.07,
      "duration_seconds": 2.47,
      "text": "Yes, I'll watch for that."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 427.57,
      "end_seconds": 443.77,
      "duration_seconds": 16.2,
      "text": "Keep an eye out, and if the symptoms get worse, call us the same day or go to emergency. I'd like to see you again in four weeks. Take care, and call us if anything changes."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 444.36,
      "end_seconds": 446.94,
      "duration_seconds": 2.58,
      "text": "So, I appreciate it, doctor."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 448.51,
      "end_seconds": 449.89,
      "duration_seconds": 1.38,
      "text": "Bye for now."
    }
  ]
}