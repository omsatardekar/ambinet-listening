{
  "schema_version": "1.0",
  "encounter_id": "00358",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 0.55,
      "end_seconds": 8.63,
      "duration_seconds": 8.08,
      "text": "Doctor, the patient's with us now. I did the usual checks at the front, so just say when you want them."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 9.48,
      "end_seconds": 14.56,
      "duration_seconds": 5.08,
      "text": "Thanks. Hello, come in, sit down. What brings you in today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 15.45,
      "end_seconds": 23.51,
      "duration_seconds": 8.06,
      "text": "I've been dealing with a sticky discharge in the morning. I'm hoping you can tell me something definite."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 25.39,
      "end_seconds": 27.93,
      "duration_seconds": 2.54,
      "text": "Since when have you had this?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 32.6,
      "end_seconds": 38.29,
      "duration_seconds": 5.69,
      "text": "For two weeks, I'd say. I've had watering too, for five days."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 39.06,
      "end_seconds": 42.88,
      "duration_seconds": 3.82,
      "text": "What about a red eye, have you noticed that?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 44.09,
      "end_seconds": 46.9,
      "duration_seconds": 2.81,
      "text": "Yeah. About two weeks, I'd say."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 48.06,
      "end_seconds": 55.82,
      "duration_seconds": 7.76,
      "text": "Have you had any sensitivity to light, foreign body in the eye, pain in the eye or cold?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 56.77,
      "end_seconds": 58.86,
      "duration_seconds": 2.09,
      "text": "No, none of those."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 59.86,
      "end_seconds": 63.47,
      "duration_seconds": 3.61,
      "text": "How about your heart, any problems like that?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 68.86,
      "end_seconds": 70.45,
      "duration_seconds": 1.59,
      "text": "Nothing like that."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 74.57,
      "end_seconds": 77.72,
      "duration_seconds": 3.15,
      "text": "Any problems with your joints or muscles?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 79.05,
      "end_seconds": 80.93,
      "duration_seconds": 1.88,
      "text": "I move fine otherwise."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 94.77,
      "end_seconds": 97.52,
      "duration_seconds": 2.75,
      "text": "Any diagnoses you've been given before?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 98.7,
      "end_seconds": 100.14,
      "duration_seconds": 1.44,
      "text": "I've got eczema."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 101.63,
      "end_seconds": 102.93,
      "duration_seconds": 1.3,
      "text": "Okay, anything else?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 104.36,
      "end_seconds": 108.22,
      "duration_seconds": 3.86,
      "text": "I've had asthma for five years now."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 108.93,
      "end_seconds": 117.39,
      "duration_seconds": 8.46,
      "text": "Okay, I can see asthma in your file as well. What about allergies, to medicines or foods or anything else?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 118.13,
      "end_seconds": 131.24,
      "duration_seconds": 13.11,
      "text": "Hmm, there was some antibiotic, I was told I was allergic. But I couldn't tell you what it was called or what it did."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 132.53,
      "end_seconds": 134.14,
      "duration_seconds": 1.61,
      "text": "Do you live alone?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 136.18,
      "end_seconds": 139.16,
      "duration_seconds": 2.98,
      "text": "Yes, I live on my own."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 140.95,
      "end_seconds": 142.93,
      "duration_seconds": 1.98,
      "text": "Okay, do you work?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 144.5,
      "end_seconds": 151.14,
      "duration_seconds": 6.64,
      "text": "I run a small shop, so I'm on my feet a lot."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 152.36,
      "end_seconds": 153.94,
      "duration_seconds": 1.58,
      "text": "Any sport or activity?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 155.35,
      "end_seconds": 157.66,
      "duration_seconds": 2.31,
      "text": "I play badminton on Sundays."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 159.06,
      "end_seconds": 161.85,
      "duration_seconds": 2.79,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 162.5,
      "end_seconds": 164.19,
      "duration_seconds": 1.69,
      "text": "No operations, no."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 167.91,
      "end_seconds": 171.15,
      "duration_seconds": 3.24,
      "text": "Tell me what you take day to day."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 171.8,
      "end_seconds": 183.29,
      "duration_seconds": 11.49,
      "text": "I take hydrocortisone cream, when needed for the eczema. Asthalin inhaler, when needed. I do miss it now and then, to be fair."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 196.58,
      "end_seconds": 202.92,
      "duration_seconds": 6.34,
      "text": "Here are the numbers, doctor. Pulse 83, blood pressure 111 over 74, respiratory rate 14."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 204.4,
      "end_seconds": 205.88,
      "duration_seconds": 1.48,
      "text": "Good, thank you."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 208.61,
      "end_seconds": 212.67,
      "duration_seconds": 4.06,
      "text": "Right, let me check a few things physically."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 216.8,
      "end_seconds": 217.5,
      "duration_seconds": 0.7,
      "text": "Sure."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 218.34,
      "end_seconds": 220.51,
      "duration_seconds": 2.17,
      "text": "Hold that position for me."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 235.09,
      "end_seconds": 239.99,
      "duration_seconds": 4.9,
      "text": "Your vision is normal on the chart and the pupil reacts well."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 241.04,
      "end_seconds": 243.04,
      "duration_seconds": 2.0,
      "text": "Hold that position for me."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 259.15,
      "end_seconds": 266.21,
      "duration_seconds": 7.06,
      "text": "The white of the eye is pink all over, and there's some sticky discharge on the lashes."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 267.68,
      "end_seconds": 268.38,
      "duration_seconds": 0.7,
      "text": "Alright."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 270.97,
      "end_seconds": 281.26,
      "duration_seconds": 10.29,
      "text": "Thanks, please take a seat again. Okay, so my impression is this: This is probably conjunctivitis. I can't rule out an allergic eye problem yet."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 291.5,
      "end_seconds": 302.26,
      "duration_seconds": 10.76,
      "text": "I'll request an eye swab, it'll help with red eye. I'm prescribing chloramphenicol eye drops, four times a day, for five days. That's for conjunctivitis."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 306.66,
      "end_seconds": 309.14,
      "duration_seconds": 2.48,
      "text": "Well, fine, I'll start it."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 309.83,
      "end_seconds": 327.03,
      "duration_seconds": 17.2,
      "text": "Wash your hands often, don't share towels, and don't rub the eye. The thing that would worry me is if your vision drops or the pain gets severe. If that happens, go to emergency. I'll want another look in a week."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 327.87,
      "end_seconds": 330.4,
      "duration_seconds": 2.53,
      "text": "Good, I'll come back then."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 332.24,
      "end_seconds": 334.17,
      "duration_seconds": 1.93,
      "text": "Alright, any last questions?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 334.96,
      "end_seconds": 337.9,
      "duration_seconds": 2.94,
      "text": "No, you've explained it well. Thanks."
    }
  ]
}