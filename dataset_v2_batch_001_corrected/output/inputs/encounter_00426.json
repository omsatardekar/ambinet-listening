      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 252.87,
      "end_seconds": 253.57,
      "duration_seconds": 0.7,
      "text": "Fine."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 257.09,
      "end_seconds": 259.35,
      "duration_seconds": 2.26,
      "text": "good, that's the the examination"
