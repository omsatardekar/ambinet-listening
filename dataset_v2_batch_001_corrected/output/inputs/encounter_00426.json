      "start_seconds": 210.98,
      "end_seconds": 225.26,
      "duration_seconds": 14.28,
      "text": "Okay: BMI works out to 18.1, heart rate 72. And temperature is 36.9 degrees, saturation 97 percent, pressure 115 over 80, respiratory rate 15, height 171 centimetres, weight 53 kilos."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 227.23,
      "end_seconds": 231.25,
      "duration_seconds": 4.02,
      "text": "Okay, I need to examine you for this."
