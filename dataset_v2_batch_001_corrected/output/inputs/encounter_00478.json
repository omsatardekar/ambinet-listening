{
  "schema_version": "1.0",
  "encounter_id": "00478",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 0.91,
      "end_seconds": 6.92,
      "duration_seconds": 6.01,
      "text": "Okay, doctor, we're all set in here. I'll give you the numbers when you want them."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.05,
      "end_seconds": 13.27,
      "duration_seconds": 5.22,
      "text": "Thanks. Hello, come in, sit down. What brings you in today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 14.8,
      "end_seconds": 26.3,
      "duration_seconds": 11.5,
      "text": "mainly a high fever. There's a couple of other things, but that's the main one. I've never really been one for hospitals"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 27.94,
      "end_seconds": 30.57,
      "duration_seconds": 2.63,
      "text": "How long are we talking about?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 32.27,
      "end_seconds": 46.38,
      "duration_seconds": 14.11,
      "text": "It's been five days, I'm fairly sure. I kept putting it off, which I know isn't sensible. I told myself I'd wait and see, and here I am."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 46.73,
      "end_seconds": 52.76,
      "duration_seconds": 6.03,
      "text": "right okay, give me more detail on it, whatever comes to to mind"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 54.05,
      "end_seconds": 60.42,
      "duration_seconds": 6.37,
      "text": "It settles a little with paracetamol. It's a few times a day."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 61.89,
      "end_seconds": 65.54,
      "duration_seconds": 3.65,
      "text": "What about no appetite, have you noticed that?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 66.55,
      "end_seconds": 67.73,
      "duration_seconds": 1.18,
      "text": "Yes, actually."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 69.4,
      "end_seconds": 76.38,
      "duration_seconds": 6.98,
      "text": "Let me check a few things. Any blood in the stool, cough or vomiting?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 78.3,
      "end_seconds": 81.03,
      "duration_seconds": 2.73,
      "text": "No, not any of them."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 81.27,
      "end_seconds": 84.46,
      "duration_seconds": 3.19,
      "text": "ah. Has there been any abdominal pain?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 86.19,
      "end_seconds": 89.0,
      "duration_seconds": 2.81,
      "text": "No, none, no abdominal pain."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 90.19,
      "end_seconds": 92.6,
      "duration_seconds": 2.41,
      "text": "Anything unusual with passing urine?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 94.01,
      "end_seconds": 95.58,
      "duration_seconds": 1.57,
      "text": "No changes there."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 97.13,
      "end_seconds": 100.69,
      "duration_seconds": 3.56,
      "text": "Anything on the skin I should know about?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 101.8,
      "end_seconds": 102.86,
      "duration_seconds": 1.06,
      "text": "Skin's normal."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 104.93,
      "end_seconds": 109.57,
      "duration_seconds": 4.64,
      "text": "What about allergies, to medicines or foods or anything else?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 110.51,
      "end_seconds": 112.93,
      "duration_seconds": 2.42,
      "text": "Not that I know, no."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 116.14,
      "end_seconds": 118.73,
      "duration_seconds": 2.59,
      "text": "Any diagnoses you've been given before?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 121.28,
      "end_seconds": 124.9,
      "duration_seconds": 3.62,
      "text": "I have diabetes, for about ten years"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 126.89,
      "end_seconds": 128.28,
      "duration_seconds": 1.39,
      "text": "Okay, anything else?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 128.94,
      "end_seconds": 138.82,
      "duration_seconds": 9.88,
      "text": "I've had high blood pressure for two years now. I'm not great at remembering details, so bear with me."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 140.07,
      "end_seconds": 145.47,
      "duration_seconds": 5.4,
      "text": "Yes, diabetes is known to us, good to have that clear."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 161.64,
      "end_seconds": 165.3,
      "duration_seconds": 3.66,
      "text": "Which tablets or creams or inhalers do you use?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 166.17,
      "end_seconds": 174.33,
      "duration_seconds": 8.16,
      "text": "It's, It's Glycomet, 500 milligrams, twice a day. Telmisartan, 40 milligrams, once a day."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 175.86,
      "end_seconds": 178.78,
      "duration_seconds": 2.92,
      "text": "Roughly how long on that one?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 179.52,
      "end_seconds": 186.02,
      "duration_seconds": 6.5,
      "text": "about two years. I take Dolo, 650 milligrams, when I get the fever"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 187.03,
      "end_seconds": 189.93,
      "duration_seconds": 2.9,
      "text": "How long has that been going on?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 191.48,
      "end_seconds": 193.42,
      "duration_seconds": 1.94,
      "text": "About about three months."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 194.75,
      "end_seconds": 197.99,
      "duration_seconds": 3.24,
      "text": "a few questions about your lifestyle now"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 199.45,
      "end_seconds": 214.98,
      "duration_seconds": 15.53,
      "text": "I don't drink at all. Mostly home-cooked food, rice and vegetables. I drive a delivery van all day. I go to the gym a couple of times a week"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 216.67,
      "end_seconds": 219.91,
      "duration_seconds": 3.24,
      "text": "have you ever been under the knife?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 220.44,
      "end_seconds": 224.96,
      "duration_seconds": 4.52,
      "text": "I had cataract surgery on my right eye last year."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 232.77,
      "end_seconds": 241.36,
      "duration_seconds": 8.59,
      "text": "Okay, so the vitals from earlier. Temperature 38.9, heart rate 93. Blood pressure 104 over 76, respiratory rate 18."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 247.16,
      "end_seconds": 248.74,
      "duration_seconds": 1.58,
      "text": "Good, thank you."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 250.78,
      "end_seconds": 253.44,
      "duration_seconds": 2.66,
      "text": "I'd like to examine you now."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 254.74,
      "end_seconds": 256.9,
      "duration_seconds": 2.16,
      "text": "Let me just check something."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 275.1,
      "end_seconds": 280.01,
      "duration_seconds": 4.91,
      "text": "There's a faint rash on your forearms, it blanches when I press."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 283.83,
      "end_seconds": 285.55,
      "duration_seconds": 1.72,
      "text": "Good, that's the examination."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 297.64,
      "end_seconds": 330.57,
      "duration_seconds": 32.93,
      "text": "Let me tell you where I've got to. It points towards a febrile illness that could be dengue. We shouldn't forget malaria. I'm going to order a dengue test, for fever. Drink a lot, coconut water, ORS, whatever you can manage. A malaria test is something we might do if this doesn't improve next month. Book a review in two days. That's it on my side. Anything unclear?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 331.95,
      "end_seconds": 334.12,
      "duration_seconds": 2.17,
      "text": "Okay, thank you. Bye."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 334.73,
      "end_seconds": 335.97,
      "duration_seconds": 1.24,
      "text": "Safe journey home."
    }
  ]
}