      "role": "DOCTOR",
      "start_seconds": 196.36,
      "end_seconds": 201.67,
      "duration_seconds": 5.31,
      "text": "So, tell me about your health in general, any ongoing conditions?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 202.91,
      "end_seconds": 205.27,
      "duration_seconds": 2.36,
      "text": "I've had low haemoglobin, yes."
