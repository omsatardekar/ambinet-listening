{
  "schema_version": "1.0",
  "encounter_id": "00224",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.28,
      "end_seconds": 9.15,
      "duration_seconds": 7.87,
      "text": "Uh, doctor, hello, I've got my papers here, where should I put them?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 10.86,
      "end_seconds": 17.5,
      "duration_seconds": 6.64,
      "text": "Yes, come in, take a seat. What can I do for you today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 19.03,
      "end_seconds": 31.39,
      "duration_seconds": 12.36,
      "text": "I've been feeling very thirsty. It's the not knowing that gets to me. My family kept telling me to get it checked."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 33.2,
      "end_seconds": 36.52,
      "duration_seconds": 3.32,
      "text": "What medicines are you taking at the moment?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 37.96,
      "end_seconds": 47.85,
      "duration_seconds": 9.89,
      "text": "Tiotropium inhaler. I take it once a day. Diclofenac. I take it 50 milligrams, when needed for the joint pain."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 48.52,
      "end_seconds": 51.61,
      "duration_seconds": 3.09,
      "text": "So, how long are we talking about?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 53.65,
      "end_seconds": 56.64,
      "duration_seconds": 2.99,
      "text": "Since Monday, that's when it began."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 56.99,
      "end_seconds": 59.76,
      "duration_seconds": 2.77,
      "text": "Okay. And how severe is it?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 61.48,
      "end_seconds": 62.53,
      "duration_seconds": 1.05,
      "text": "Severe, really."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 65.56,
      "end_seconds": 68.06,
      "duration_seconds": 2.5,
      "text": "Right, has there been tiredness too?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 69.26,
      "end_seconds": 78.4,
      "duration_seconds": 9.14,
      "text": "Yeah, I've had that since Friday. And there's itching around the private area as well, four weeks now."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 79.99,
      "end_seconds": 83.57,
      "duration_seconds": 3.58,
      "text": "Okay, would you call it mild or bad?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 84.29,
      "end_seconds": 85.87,
      "duration_seconds": 1.58,
      "text": "I'd say severe."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 94.7,
      "end_seconds": 98.83,
      "duration_seconds": 4.13,
      "text": "Any vomiting, fruity smell on the breath or blurred vision?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 100.85,
      "end_seconds": 103.3,
      "duration_seconds": 2.45,
      "text": "No, not any of them."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 104.18,
      "end_seconds": 106.21,
      "duration_seconds": 2.03,
      "text": "Have you had any breathlessness?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 106.8,
      "end_seconds": 108.27,
      "duration_seconds": 1.47,
      "text": "Definitely no breathlessness."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 108.58,
      "end_seconds": 113.39,
      "duration_seconds": 4.81,
      "text": "Okay, so. What about your tummy and bowels, anything unusual there?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 115.24,
      "end_seconds": 117.56,
      "duration_seconds": 2.32,
      "text": "No, all normal there."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 118.74,
      "end_seconds": 122.7,
      "duration_seconds": 3.96,
      "text": "Anything with your nerves, like weakness or numbness?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 123.47,
      "end_seconds": 124.84,
      "duration_seconds": 1.37,
      "text": "Nothing odd there."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 126.09,
      "end_seconds": 130.55,
      "duration_seconds": 4.46,
      "text": "What about family history, any illnesses that run in the family?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 132.12,
      "end_seconds": 134.04,
      "duration_seconds": 1.92,
      "text": "My brother has asthma."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 148.24,
      "end_seconds": 151.57,
      "duration_seconds": 3.33,
      "text": "Any long-term health problems I should know about?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 153.59,
      "end_seconds": 158.23,
      "duration_seconds": 4.64,
      "text": "I have COPD. I've had arthritis in my knees, yes."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 158.74,
      "end_seconds": 168.2,
      "duration_seconds": 9.46,
      "text": "Sure. Okay, I can see COPD and arthritis in your knees in your file as well. Who do you live with?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 170.25,
      "end_seconds": 174.85,
      "duration_seconds": 4.6,
      "text": "I live with my family, my husband and two kids."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 175.85,
      "end_seconds": 177.07,
      "duration_seconds": 1.22,
      "text": "How about exercise?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 178.38,
      "end_seconds": 182.05,
      "duration_seconds": 3.67,
      "text": "Not really, I don't get much exercise."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 183.89,
      "end_seconds": 185.51,
      "duration_seconds": 1.62,
      "text": "Are you still working?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 186.51,
      "end_seconds": 191.25,
      "duration_seconds": 4.74,
      "text": "I'm retired now, I was a clerk for years."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 192.5,
      "end_seconds": 196.35,
      "duration_seconds": 3.85,
      "text": "Let's get your blood pressure and the other basics."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 205.06,
      "end_seconds": 206.99,
      "duration_seconds": 1.93,
      "text": "Rest your hand here..."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 220.65,
      "end_seconds": 231.04,
      "duration_seconds": 10.39,
      "text": "Okay: SpO2 99 percent on room air, pulse 76, weight 56 kilos, height 153 centimetres, temperature is 36.9 degrees, blood pressure 111 over 71."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 231.7,
      "end_seconds": 233.12,
      "duration_seconds": 1.42,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 235.19,
      "end_seconds": 240.03,
      "duration_seconds": 4.84,
      "text": "They help build the picture, I'll tell you more soon."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 241.8,
      "end_seconds": 244.84,
      "duration_seconds": 3.04,
      "text": "So, I'd like to examine you now."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 246.83,
      "end_seconds": 248.92,
      "duration_seconds": 2.09,
      "text": "Let me just check something."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 260.59,
      "end_seconds": 265.91,
      "duration_seconds": 5.32,
      "text": "You're a little dry, but alert, and your breathing is normal."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 267.02,
      "end_seconds": 268.97,
      "duration_seconds": 1.95,
      "text": "Let me just check something."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 279.34,
      "end_seconds": 281.78,
      "duration_seconds": 2.44,
      "text": "Your tummy is soft and non-tender."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 284.52,
      "end_seconds": 293.33,
      "duration_seconds": 8.81,
      "text": "Thanks for that. Taking everything into account, I'd lean towards possible new-onset diabetes. A urine infection is still possible."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 294.13,
      "end_seconds": 297.03,
      "duration_seconds": 2.9,
      "text": "Is this going to go away?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 297.62,
      "end_seconds": 305.31,
      "duration_seconds": 7.69,
      "text": "Nothing I've seen today points to an emergency. It looks like possible new-onset diabetes, but I'd like to confirm."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 317.59,
      "end_seconds": 322.63,
      "duration_seconds": 5.04,
      "text": "I want a blood sugar test done, that's for polydipsia and polyuria."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 324.59,
      "end_seconds": 325.71,
      "duration_seconds": 1.12,
      "text": "Mm, okay."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 327.8,
      "end_seconds": 349.32,
      "duration_seconds": 21.52,
      "text": "I want an HbA1c done, that's for possible diabetes. Until we have the results, avoid sugary drinks and fruit juices, and keep drinking plain water. The thing that would worry me is if you start vomiting or become drowsy. If that happens, go to emergency. Let's plan a check tomorrow with the results."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 350.7,
      "end_seconds": 354.03,
      "duration_seconds": 3.33,
      "text": "I mean, okay, I'll book that."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 356.0,
      "end_seconds": 357.58,
      "duration_seconds": 1.58,
      "text": "Thanks for coming in."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 358.42,
      "end_seconds": 361.99,
      "duration_seconds": 3.57,
      "text": "One thing: no, actually that's all. Thanks."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 363.74,
      "end_seconds": 364.97,
      "duration_seconds": 1.23,
      "text": "Bye for now."
    }
  ]
}