{
  "schema_version": "1.0",
  "encounter_id": "00412",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.84,
      "end_seconds": 4.56,
      "duration_seconds": 3.72,
      "text": "Morning. Nice to finally see you, doctor."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.65,
      "end_seconds": 10.83,
      "duration_seconds": 4.18,
      "text": "That's alright, take a seat. Tell me why you've come."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 12.82,
      "end_seconds": 17.73,
      "duration_seconds": 4.91,
      "text": "I've been dealing with a very painful, swollen big toe."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 18.57,
      "end_seconds": 20.96,
      "duration_seconds": 2.39,
      "text": "And when did that start?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 24.56,
      "end_seconds": 27.7,
      "duration_seconds": 3.14,
      "text": "Since Friday, that's when it began."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 28.72,
      "end_seconds": 33.96,
      "duration_seconds": 5.24,
      "text": "Okay, give me more detail on it, whatever comes to mind."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 35.17,
      "end_seconds": 54.05,
      "duration_seconds": 18.88,
      "text": "It's, It's a couple of times a week. I notice it more with the bedsheet touching it. Mostly severe. And there's warmth in the toe as well, two weeks now. And a low fever as well, since this morning."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 55.16,
      "end_seconds": 60.14,
      "duration_seconds": 4.98,
      "text": "Did you get rash, trauma to the toe or recent illness?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 61.61,
      "end_seconds": 63.41,
      "duration_seconds": 1.8,
      "text": "No, nothing there."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 65.36,
      "end_seconds": 69.55,
      "duration_seconds": 4.19,
      "text": "So, anything with your heart, like skipped beats or fainting?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 73.42,
      "end_seconds": 75.71,
      "duration_seconds": 2.29,
      "text": "No, that's been fine."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 94.71,
      "end_seconds": 100.03,
      "duration_seconds": 5.32,
      "text": "Have you ever reacted badly to a medicine or food? Any allergies?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 101.14,
      "end_seconds": 109.04,
      "duration_seconds": 7.9,
      "text": "Years back I got a rash from ibuprofen, so I stay away from it now."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 110.27,
      "end_seconds": 113.27,
      "duration_seconds": 3.0,
      "text": "Alright, any diagnoses you've been given before?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 114.22,
      "end_seconds": 117.86,
      "duration_seconds": 3.64,
      "text": "High blood pressure, for about a year."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 118.56,
      "end_seconds": 120.25,
      "duration_seconds": 1.69,
      "text": "And apart from that?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 121.95,
      "end_seconds": 124.22,
      "duration_seconds": 2.27,
      "text": "I've got kidney disease."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 125.6,
      "end_seconds": 130.29,
      "duration_seconds": 4.69,
      "text": "Alright, high blood pressure, that matches what I have here."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 147.69,
      "end_seconds": 150.34,
      "duration_seconds": 2.65,
      "text": "Right, how do you eat, generally?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 151.36,
      "end_seconds": 154.2,
      "duration_seconds": 2.84,
      "text": "I skip breakfast most days."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 155.13,
      "end_seconds": 158.26,
      "duration_seconds": 3.13,
      "text": "And what do you do for a living?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 160.3,
      "end_seconds": 163.62,
      "duration_seconds": 3.32,
      "text": "I work night shifts at a warehouse."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 165.34,
      "end_seconds": 168.77,
      "duration_seconds": 3.43,
      "text": "What do you do to keep active?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 170.39,
      "end_seconds": 173.12,
      "duration_seconds": 2.73,
      "text": "I cycle to work most mornings."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 175.07,
      "end_seconds": 178.65,
      "duration_seconds": 3.58,
      "text": "Tell me what you take day to day."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 179.81,
      "end_seconds": 183.3,
      "duration_seconds": 3.49,
      "text": "I take losartan, once a day."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 185.33,
      "end_seconds": 188.22,
      "duration_seconds": 2.89,
      "text": "So, and what strength is that?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 189.02,
      "end_seconds": 189.92,
      "duration_seconds": 0.9,
      "text": "50 milligrams."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 191.43,
      "end_seconds": 196.09,
      "duration_seconds": 4.66,
      "text": "So, before we go on, a few quick readings."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 208.38,
      "end_seconds": 210.16,
      "duration_seconds": 1.78,
      "text": "Rest your hand here..."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 231.39,
      "end_seconds": 239.78,
      "duration_seconds": 8.39,
      "text": "Okay: BP is 125 over 73, SpO2 98 percent on room air, temp 36.6 degrees, heart rate 78."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 241.71,
      "end_seconds": 243.16,
      "duration_seconds": 1.45,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 244.98,
      "end_seconds": 247.36,
      "duration_seconds": 2.38,
      "text": "I'll explain what that means shortly."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 248.98,
      "end_seconds": 252.79,
      "duration_seconds": 3.81,
      "text": "Okay, I need to examine you for this."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 254.19,
      "end_seconds": 255.59,
      "duration_seconds": 1.4,
      "text": "I'll go gently."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 270.27,
      "end_seconds": 276.45,
      "duration_seconds": 6.18,
      "text": "The big toe joint is red, hot, swollen and extremely tender to touch."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 280.74,
      "end_seconds": 283.45,
      "duration_seconds": 2.71,
      "text": "That's all I need, thank you."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 300.56,
      "end_seconds": 332.96,
      "duration_seconds": 32.4,
      "text": "I'm sending you for kidney function tests because of gout. Let's get a uric acid level, for suspected gout. We'll begin with colchicine, 0.5 milligrams, twice a day, for five days. That should help with gout flare. Cut right back on red meat, organ meats, beer and sugary drinks, and drink plenty of water. Don't skip meals, and try to eat smaller portions more often through the day. Book a review in a week."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 334.69,
      "end_seconds": 338.16,
      "duration_seconds": 3.47,
      "text": "Okay, I think we're finished. Is everything clear?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 338.74,
      "end_seconds": 341.45,
      "duration_seconds": 2.71,
      "text": "Alright, thanks. Bye for now."
    }
  ]
}