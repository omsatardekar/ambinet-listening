    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 295.67,
      "end_seconds": 298.55,
      "duration_seconds": 2.88,
      "text": "Thanks please take a seat again."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 316.05,
      "end_seconds": 344.56,
      "duration_seconds": 28.51,
      "text": "So based on the history and the examination it fits best with chronic constipation. The reason I say that that is that your story and my examination fit together. I can't rule out an underactive thyroid yet. A colonoscopy is what I'd like next for constipation and rectal bleeding. The result will help us decide whether anything more is needed. Blood tests is what I'd like next for constipation."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 346.3,
      "end_seconds": 347.76,
      "duration_seconds": 1.46,
      "text": "will it hurt?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 348.86,
      "end_seconds": 373.31,
      "duration_seconds": 24.45,
      "text": "I'm going to put you on lactulose, 15 ml, at night, for two weeks. That's for constipation. More fibre, more water, and give yourself ten unhurried minutes after breakfast. If the symptoms get worse, that's the point to come in urgently. See me again in three weeks. Okay, I think we're finished. Is everything clear?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 374.57,
      "end_seconds": 376.02,
      "duration_seconds": 1.45,
      "text": "Right. Thanks again."
    },
