      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 243.09,
      "end_seconds": 246.1,
      "duration_seconds": 3.01,
      "text": "I'll explain what that that means shortly"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 248.42,
      "end_seconds": 250.68,
      "duration_seconds": 2.26,
      "text": "okay a quick examination now"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 252.09,
      "end_seconds": 254.44,
      "duration_seconds": 2.35,
      "text": "Just relax, I'll be quick."
    },
    {
