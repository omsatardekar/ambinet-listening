    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 139.63,
      "end_seconds": 144.04,
      "duration_seconds": 4.41,
      "text": "tell me about your health in general any ongoing conditions?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 145.83,
      "end_seconds": 162.36,
      "duration_seconds": 16.53,
      "text": "I have an underactive thyroid, for two years my family kept telling me to get it checked i'd rather not end up on lots of tablets if I can avoid it. Diabetes, for about a year"
    },
    {
      "segment_id": "SEG0025",
