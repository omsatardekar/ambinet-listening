    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 177.45,
      "end_seconds": 179.98,
      "duration_seconds": 2.53,
      "text": "now some background about your lifestyle"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 181.41,
      "end_seconds": 196.95,
      "duration_seconds": 15.54,
      "text": "No, I don't smoke and never have. I work in an office, mostly sitting at a desk. I skip breakfast most days. I share a flat with two friends"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 201.37,
      "end_seconds": 203.75,
      "duration_seconds": 2.38,
      "text": "Let me check your vitals now."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 210.87,
      "end_seconds": 211.84,
      "duration_seconds": 0.97,
      "text": "Almost there..."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 229.4,
      "end_seconds": 239.75,
      "duration_seconds": 10.35,
      "text": "Okay: respiratory rate 16, oxygen saturation is 98 percent, pulse is 74 beats a minute, BP is 111 over 76, temperature 36.7."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 240.28,
      "end_seconds": 241.77,
      "duration_seconds": 1.49,
      "text": "is that normal?"
