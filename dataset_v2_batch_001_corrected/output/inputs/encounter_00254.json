    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 286.31,
      "end_seconds": 290.46,
      "duration_seconds": 4.15,
      "text": "I can feel firm stool in the left lower abdomen"
