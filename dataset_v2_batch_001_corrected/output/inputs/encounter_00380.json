{
  "schema_version": "1.0",
  "encounter_id": "00380",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 0.94,
      "end_seconds": 5.2,
      "duration_seconds": 4.26,
      "text": "Morning, doctor. I've settled them in, ready when you are."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 10.58,
      "end_seconds": 16.01,
      "duration_seconds": 5.43,
      "text": "Alright, thanks. Hello, come in, sit down. What brings you in today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 17.54,
      "end_seconds": 27.62,
      "duration_seconds": 10.08,
      "text": "I've been going to the toilet a lot, even at night. I told myself I'd wait and see, and here I am."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 29.67,
      "end_seconds": 37.06,
      "duration_seconds": 7.39,
      "text": "What medicines are you taking at the moment? Just so I get the full picture."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 37.63,
      "end_seconds": 51.0,
      "duration_seconds": 13.37,
      "text": "Allopurinol. I take it 100 milligrams, once a day for the gout. It's something called biso... bisoprolol, 2.5 milligrams, maybe, once a day."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 52.22,
      "end_seconds": 55.64,
      "duration_seconds": 3.42,
      "text": "is the the packet here, or the prescription?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 56.79,
      "end_seconds": 64.22,
      "duration_seconds": 7.43,
      "text": "Not with me. I'll bring it next time. I take spironolactone, 25 milligrams, once a day."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 64.74,
      "end_seconds": 67.97,
      "duration_seconds": 3.23,
      "text": "How long has this been going on?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 69.74,
      "end_seconds": 72.53,
      "duration_seconds": 2.79,
      "text": "I've had it since last Tuesday."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 74.58,
      "end_seconds": 77.76,
      "duration_seconds": 3.18,
      "text": "Does it come along with anything else?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 79.07,
      "end_seconds": 83.85,
      "duration_seconds": 4.78,
      "text": "It usually comes with itching around the private area."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 85.42,
      "end_seconds": 87.18,
      "duration_seconds": 1.76,
      "text": "Have you had tiredness?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 88.36,
      "end_seconds": 101.8,
      "duration_seconds": 13.44,
      "text": "Yes, about the same, two days. Um, the the itching around the private area? That's been since Monday. With itching around the private area, I'd say severe."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 103.61,
      "end_seconds": 110.39,
      "duration_seconds": 6.78,
      "text": "Have you been going to the toilet a lot, even at night at any time before this?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 114.5,
      "end_seconds": 121.34,
      "duration_seconds": 6.84,
      "text": "A bit, about six months ago. It settled by itself back then."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 122.63,
      "end_seconds": 129.7,
      "duration_seconds": 7.07,
      "text": "A few quick ones: fruity smell on the breath, blurred vision, fever or abdominal pain?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 133.3,
      "end_seconds": 140.37,
      "duration_seconds": 7.07,
      "text": "I haven't had fruity smell on the breath, blurred vision, fever or abdominal pain, no"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 141.81,
      "end_seconds": 145.94,
      "duration_seconds": 4.13,
      "text": "what about your tummy and bowels, anything unusual there?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 146.57,
      "end_seconds": 149.81,
      "duration_seconds": 3.24,
      "text": "Yeah, no, that side's been fine."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 154.96,
      "end_seconds": 160.13,
      "duration_seconds": 5.17,
      "text": "Are there any allergies on your record that I should check?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 161.38,
      "end_seconds": 164.6,
      "duration_seconds": 3.22,
      "text": "I've never been told I have allergies."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 165.53,
      "end_seconds": 171.04,
      "duration_seconds": 5.51,
      "text": "Tell me about your routine, work, habits, that sort of thing."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 173.11,
      "end_seconds": 183.87,
      "duration_seconds": 10.76,
      "text": "I used to smoke but I quit five years ago. I try to avoid too much sugar. I teach at a primary school."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 188.39,
      "end_seconds": 189.62,
      "duration_seconds": 1.23,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 191.22,
      "end_seconds": 197.82,
      "duration_seconds": 6.6,
      "text": "So, yes, I had a lump removed from my back, years ago."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 209.48,
      "end_seconds": 217.91,
      "duration_seconds": 8.43,
      "text": "What about your general health, any conditions you're being treated for? Take your time, there's no rush."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 219.18,
      "end_seconds": 224.91,
      "duration_seconds": 5.73,
      "text": "Okay, so yes, gout. I didn't wanna make a fuss, you know."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 226.26,
      "end_seconds": 227.22,
      "duration_seconds": 0.96,
      "text": "and then?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 232.62,
      "end_seconds": 239.69,
      "duration_seconds": 7.07,
      "text": "I have an irregular heartbeat. I did try to ignore it for a while."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 240.61,
      "end_seconds": 241.84,
      "duration_seconds": 1.23,
      "text": "Is there more?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 242.79,
      "end_seconds": 246.34,
      "duration_seconds": 3.55,
      "text": "Yeah, I've had heart failure, yes."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 248.39,
      "end_seconds": 249.45,
      "duration_seconds": 1.06,
      "text": "Right, right."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 250.87,
      "end_seconds": 252.68,
      "duration_seconds": 1.81,
      "text": "I've got high cholesterol."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 253.56,
      "end_seconds": 261.27,
      "duration_seconds": 7.71,
      "text": "Right, so gout and an irregular heartbeat are already on your record. We'll keep that in mind today."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 270.12,
      "end_seconds": 274.16,
      "duration_seconds": 4.04,
      "text": "Any relatives with health problems I should be aware of?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 274.86,
      "end_seconds": 279.74,
      "duration_seconds": 4.88,
      "text": "My father was diabetic. My father had a heart attack."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 281.84,
      "end_seconds": 295.98,
      "duration_seconds": 14.14,
      "text": "Doctor, I've got the readings for you. Temperature is 36.4 degrees, oxygen saturation is 97 percent, weight 78 kilos, pressure 115 over 81, height 167 centimetres, pulse is 81 beats a minute."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 296.99,
      "end_seconds": 297.94,
      "duration_seconds": 0.95,
      "text": "Okay, noted."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 300.77,
      "end_seconds": 303.53,
      "duration_seconds": 2.76,
      "text": "I'd like to examine you now."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 305.33,
      "end_seconds": 307.8,
      "duration_seconds": 2.47,
      "text": "let me look at this properly"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 321.63,
      "end_seconds": 327.24,
      "duration_seconds": 5.61,
      "text": "You're a little dry, but alert, and your breathing is normal."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 328.52,
      "end_seconds": 330.66,
      "duration_seconds": 2.14,
      "text": "Just relax, I'll be quick."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 348.04,
      "end_seconds": 350.46,
      "duration_seconds": 2.42,
      "text": "Your tummy is soft and non-tender."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 352.77,
      "end_seconds": 354.78,
      "duration_seconds": 2.01,
      "text": "Good, that's the examination."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 367.94,
      "end_seconds": 376.06,
      "duration_seconds": 8.12,
      "text": "putting it all together, it fits best with possible new-onset diabetes a urine infection is also on my list"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 377.38,
      "end_seconds": 381.69,
      "duration_seconds": 4.31,
      "text": "I've already done a blood sugar test, it's ready for you."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 382.57,
      "end_seconds": 393.29,
      "duration_seconds": 10.72,
      "text": "Thanks, I'll look at that. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 395.02,
      "end_seconds": 396.5,
      "duration_seconds": 1.48,
      "text": "Okay, fair enough."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 397.6,
      "end_seconds": 406.72,
      "duration_seconds": 9.12,
      "text": "I don't need to add any tests or treatment at this point. Is there anything you wanted to ask?"
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 407.63,
      "end_seconds": 411.04,
      "duration_seconds": 3.41,
      "text": "nothing more from me, um, thanks"
    }
  ]
}