    },
    {
      "evidence_id": "EV_009",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "I've had acid reflux for about a year now. I have high blood pressure, for about ten years. I've been putting this off for weeks.",
