    {
      "evidence_id": "EV_026",
      "speaker_id": "person_1",
      "speaker_role": "doctor",
      "transcript_text": "Please sit back down. Okay, so my impression is this: My working impression is paroxysmal palpitations, possibly an atrial arrhythmia. I'd also keep an overactive thyroid in mind. Let's get a heart monitor for a few days, for palpitations.",
      "start_timestamp": "05:24",
      "end_timestamp": "05:42",
      "supports": [
