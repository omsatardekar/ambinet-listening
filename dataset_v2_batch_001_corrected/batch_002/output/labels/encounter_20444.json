        "clinical_assessment[1]"
      ]
    },
    {
      "evidence_id": "EV_027",
      "speaker_id": "person_1",
      "speaker_role": "doctor",
      "transcript_text": "Nothing I've seen today points to an emergency. It looks like an overactive thyroid, but I'd like to confirm. I'm sending you for a thyroid scan because of neck swelling.",
