      ]
    },
    {
      "evidence_id": "EV_026",
      "speaker_id": "person_1",
      "speaker_role": "doctor",
      "transcript_text": "That's all I needed to check. Taking everything into account, this looks most like an overactive thyroid. I can't rule out anxiety yet.",
