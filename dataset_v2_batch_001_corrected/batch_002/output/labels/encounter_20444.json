      "end_timestamp": "05:02",
      "supports": [
        "clinical_assessment[0]",
        "procedures_and_investigations[0]",
        "clinical_actions[0]"
      ]
    },
    {
      "evidence_id": "EV_028",
      "speaker_id": "person_1",
      "speaker_role": "doctor",
      "transcript_text": "What I'm giving you is propranolol, 20 milligrams, twice a day, until review. That's for racing heart and tremor. Try to avoid caffeine while we sort this out. Cut down on salt and fried food for now, it really does make a difference. I'll also refer you to the endocrine clinic. Come back in two weeks.",
