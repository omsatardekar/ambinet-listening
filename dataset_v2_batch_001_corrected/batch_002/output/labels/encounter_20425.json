        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_006",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Any being short of breath during an episode as well?",
      "start_timestamp": "00:56",
      "end_timestamp": "01:01",
      "supports": [
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_007",
      "speaker_id": "person_4",
      "speaker_role": "patient",
      "transcript_text": "Hmm, yes, about the same, six months.",
      "start_timestamp": "01:02",
      "end_timestamp": "01:07",
      "supports": [
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_008",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "How often do you get it?",
      "start_timestamp": "01:07",
      "end_timestamp": "01:10",
      "supports": [
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_009",
      "speaker_id": "person_4",
      "speaker_role": "patient",
      "transcript_text": "It happens a couple of times a week.",
      "start_timestamp": "01:11",
      "end_timestamp": "01:15",
      "supports": [
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_010",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Have you had a fluttering in your chest before, or is this the first time?",
      "start_timestamp": "01:16",
      "end_timestamp": "01:23",
      "supports": [
        "symptoms[2]"
      ]
    },
    {
      "evidence_id": "EV_011",
      "speaker_id": "person_4",
      "speaker_role": "patient",
      "transcript_text": "I had a similar thing a couple of years ago. It went away.",
      "start_timestamp": "01:25",
      "end_timestamp": "01:32",
      "supports": [
        "symptoms[2]"
      ]
    },
    {
      "evidence_id": "EV_012",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Let me check a few things. Any weight loss or sweating?",
      "start_timestamp": "01:41",
      "end_timestamp": "01:46",
      "supports": [
        "symptoms[3]",
        "negative_findings[0]",
        "negative_findings[1]"
      ]
    },
    {
      "evidence_id": "EV_013",
      "speaker_id": "person_4",
      "speaker_role": "patient",
      "transcript_text": "No, no weight loss, no sweating. I did have my heart racing at one point, but that went away on its own.",
      "start_timestamp": "01:52",
      "end_timestamp": "02:04",
      "supports": [
        "symptoms[3]",
        "negative_findings[0]",
        "negative_findings[1]"
      ]
    },
    {
      "evidence_id": "EV_014",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
