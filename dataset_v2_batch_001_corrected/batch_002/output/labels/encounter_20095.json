      "end_timestamp": "01:09",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_007",
      "speaker_id": "person_2",
      "speaker_role": "patient",
      "transcript_text": "Honestly, a few times a day.",
