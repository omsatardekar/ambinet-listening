      "end_timestamp": "00:59",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_005",
      "speaker_id": "person_2",
      "speaker_role": "patient",
      "transcript_text": "It, It settles a little with sitting up.",
