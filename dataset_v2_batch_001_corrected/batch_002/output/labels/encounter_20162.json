  "clinical_evidence": [
    {
      "evidence_id": "EV_001",
      "speaker_id": "person_3",
      "speaker_role": "caregiver",
      "transcript_text": "It's pain in my lower back, doctor. He didn't want to come, but I insisted.",
      "start_timestamp": "00:22",
      "end_timestamp": "00:30",
      "supports": [
        "chief_complaint",
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_002",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Can you tell me when it first started?",
      "start_timestamp": "00:30",
      "end_timestamp": "00:33",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_003",
      "speaker_id": "person_4",
      "speaker_role": "patient",
      "transcript_text": "It's been about a month now.",
      "start_timestamp": "00:37",
      "end_timestamp": "00:40",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_004",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Is it bearing on you a lot?",
      "start_timestamp": "00:42",
      "end_timestamp": "00:45",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_005",
      "speaker_id": "person_4",
      "speaker_role": "patient",
      "transcript_text": "Well, it's... hard to say, it's kind of... I don't know—",
      "start_timestamp": "00:47",
      "end_timestamp": "00:54",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_006",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Take your time. Mild, moderate, or severe, if you had to pick?",
      "start_timestamp": "00:55",
      "end_timestamp": "01:01",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_007",
      "speaker_id": "person_4",
      "speaker_role": "patient",
      "transcript_text": "Mild, I'd say.",
      "start_timestamp": "01:02",
      "end_timestamp": "01:04",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_008",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Later, thanks. Please go on. Have you been feeling unsteady?",
      "start_timestamp": "01:19",
      "end_timestamp": "01:23",
      "supports": [
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_009",
      "speaker_id": "person_4",
      "speaker_role": "patient",
      "transcript_text": "Yes, for about three months. There's a stooped back as well.",
      "start_timestamp": "01:24",
      "end_timestamp": "01:30",
      "supports": [
        "symptoms[1]",
        "symptoms[2]"
      ]
    },
    {
      "evidence_id": "EV_010",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Have you had pain in your lower back before, or is this the first time?",
      "start_timestamp": "01:32",
      "end_timestamp": "01:39",
      "supports": [
        "symptoms[3]"
      ]
    },
    {
      "evidence_id": "EV_011",
      "speaker_id": "person_4",
      "speaker_role": "patient",
      "transcript_text": "Yes, something like this happened last year, and it went away on its own.",
      "start_timestamp": "01:41",
      "end_timestamp": "01:48",
      "supports": [
        "symptoms[3]"
      ]
    },
    {
      "evidence_id": "EV_012",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Any night pain or chest pain at all?",
      "start_timestamp": "01:48",
      "end_timestamp": "01:52",
      "supports": [
        "symptoms[4]",
        "negative_findings[0]",
        "negative_findings[1]"
