      ]
    },
    {
      "evidence_id": "EV_026",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "It's reasonable to be concerned, but right now osteoarthritis of the right hip is my leading thought, not anything worse. I'd like to arrange a hip X-ray for hip pain. The result will help us decide whether anything more is needed. I'd like to arrange blood tests for joint pain.",
      "start_timestamp": "04:22",
      "end_timestamp": "04:47",
      "supports": [
        "clinical_assessment[0]",
        "procedures_and_investigations[0]",
