    {
      "evidence_id": "EV_023",
      "speaker_id": "person_3",
      "speaker_role": "nurse",
      "transcript_text": "Okay, so the vitals from earlier. Heart rate 78, blood pressure 115 over 72, temp 36.5 degrees.",
