  "clinical_evidence": [
    {
      "evidence_id": "EV_001",
      "speaker_id": "person_3",
      "speaker_role": "family_member",
      "transcript_text": "Doctor, I'll sit in if that's okay, I know what's been happening. Okay, so it's been feeling lightheaded, doctor. She didn't want to come, but I insisted.",
      "start_timestamp": "00:12",
      "end_timestamp": "00:27",
      "supports": [
        "chief_complaint",
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_002",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Did it come on recently? Bear with me, I'm just building up the picture.",
      "start_timestamp": "00:28",
      "end_timestamp": "00:35",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_003",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Two weeks, I think... sorry, four weeks, I got that wrong.",
      "start_timestamp": "00:37",
      "end_timestamp": "00:42",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_004",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Is it a lot or only a little?",
      "start_timestamp": "00:43",
      "end_timestamp": "00:47",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_005",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "I, I'd call it mild.",
      "start_timestamp": "00:49",
      "end_timestamp": "00:51",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_006",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "That's fine, one at a time. I'll ask about everything. Any being short of breath during an episode as well?",
      "start_timestamp": "01:09",
      "end_timestamp": "01:18",
      "supports": [
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_007",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Yes, about the same, about a month.",
      "start_timestamp": "01:20",
      "end_timestamp": "01:24",
      "supports": [
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_008",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Have you had your heart racing?",
      "start_timestamp": "01:25",
      "end_timestamp": "01:28",
      "supports": [
        "symptoms[2]"
      ]
    },
    {
      "evidence_id": "EV_009",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "So, yes, about the same, about three months. Oh, and a fluttering in my chest. That's been about the same, three weeks.",
      "start_timestamp": "01:32",
      "end_timestamp": "01:42",
      "supports": [
        "symptoms[2]",
        "symptoms[3]"
      ]
    },
    {
      "evidence_id": "EV_010",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "How much does it limit you?",
      "start_timestamp": "01:47",
      "end_timestamp": "01:50",
      "supports": [
        "symptoms[3]"
      ]
    },
    {
      "evidence_id": "EV_011",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Moderate, I'd say.",
      "start_timestamp": "01:52",
      "end_timestamp": "01:53",
      "supports": [
        "symptoms[3]"
      ]
    },
    {
      "evidence_id": "EV_012",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Have you been feeling lightheaded at any time before this?",
      "start_timestamp": "01:55",
