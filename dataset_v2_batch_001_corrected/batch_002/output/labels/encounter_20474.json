    {
      "evidence_id": "EV_002",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Right, how long has this been bothering you?",
      "start_timestamp": "00:32",
      "end_timestamp": "00:35",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_003",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "It's been nearly five years now.",
      "start_timestamp": "00:37",
      "end_timestamp": "00:40",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_004",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Have you been losing weight without trying?",
      "start_timestamp": "00:42",
      "end_timestamp": "00:46",
      "supports": [
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_005",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Yes, um, about the same, two years. And I've been feeling tired as well.",
      "start_timestamp": "00:46",
      "end_timestamp": "00:54",
      "supports": [
        "symptoms[1]",
        "symptoms[2]"
      ]
    },
    {
      "evidence_id": "EV_006",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "What about your parents, brothers or sisters, any conditions?",
      "start_timestamp": "00:56",
      "end_timestamp": "00:59",
      "supports": [
        "medical_history.family_history[0]",
        "medical_history.family_history[1]"
      ]
    },
    {
      "evidence_id": "EV_007",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "My father has Parkinson's disease. Well, my aunt has rheumatoid arthritis.",
      "start_timestamp": "01:00",
      "end_timestamp": "01:06",
      "supports": [
        "medical_history.family_history[0]",
        "medical_history.family_history[1]"
      ]
    },
    {
      "evidence_id": "EV_008",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "A few questions about your lifestyle now.",
      "start_timestamp": "01:07",
      "end_timestamp": "01:10",
      "supports": [
        "medical_history.social_history[0]",
        "medical_history.social_history[1]",
        "medical_history.social_history[2]"
      ]
    },
    {
      "evidence_id": "EV_009",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "My husband and I live above the shop. I do a yoga class on Thursdays. Lots of rice, lentils and some fruit.",
      "start_timestamp": "01:12",
      "end_timestamp": "01:23",
      "supports": [
        "medical_history.social_history[0]",
        "medical_history.social_history[1]",
        "medical_history.social_history[2]"
      ]
    },
    {
      "evidence_id": "EV_010",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "What about your medical history?",
      "start_timestamp": "01:24",
      "end_timestamp": "01:26",
      "supports": [
        "medical_history.past_medical_history[0]",
        "medical_history.past_medical_history[1]"
      ]
    },
    {
      "evidence_id": "EV_011",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "I've had high cholesterol for about a year now. I looked a few things up online, and that probably didn't help. I have high blood pressure.",
      "start_timestamp": "01:27",
      "end_timestamp": "01:41",
      "supports": [
        "medical_history.past_medical_history[0]",
        "medical_history.past_medical_history[1]",
        "clinical_conditions[0]",
        "clinical_conditions[1]"
      ]
    },
    {
      "evidence_id": "EV_012",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Right, so high cholesterol and high blood pressure are already on your record. We'll keep that in mind today. What operations have you had, if any?",
      "start_timestamp": "01:46",
      "end_timestamp": "01:58",
      "supports": [
