        "clinical_assessment[0]"
      ]
    },
    {
      "evidence_id": "EV_022",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "I understand the worry. At the moment I'd say it's an inner-ear balance problem such as vestibular neuritis, and we'll know more once the a positional test is back.",
      "start_timestamp": "04:13",
      "end_timestamp": "04:24",
      "supports": [
        "clinical_assessment[0]"
      ]
    },
    {
      "evidence_id": "EV_023",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "I want a positional test done, that's for vertigo.",
      "start_timestamp": "04:43",
      "end_timestamp": "04:47",
      "supports": [
        "procedures_and_investigations[0]",
        "clinical_actions[0]"
      ]
    },
    {
      "evidence_id": "EV_024",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Blood tests is what I'd like next, for dizziness. What I'm giving you is prochlorperazine, 5 milligrams, three times a day, for three days. It's for nausea and vertigo.",
      "start_timestamp": "04:52",
      "end_timestamp": "05:06",
      "supports": [
        "medications[1]",
        "procedures_and_investigations[1]",
        "clinical_actions[1]",
        "clinical_actions[2]"
      ]
    },
    {
      "evidence_id": "EV_025",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Start moving around gently as soon as you can, since resting too long slows recovery. Please don't wait if you get double vision, weakness or trouble speaking. That's when to be seen urgently.",
      "start_timestamp": "05:15",
      "end_timestamp": "05:28",
      "supports": [
        "clinical_actions[3]",
        "clinical_actions[4]"
      ]
    },
