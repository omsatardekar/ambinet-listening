    },
    {
      "evidence_id": "EV_019",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "I have high blood pressure, for about ten years. I'd rather know what's going on than keep guessing.",
      "start_timestamp": "03:05",
      "end_timestamp": "03:13",
      "supports": [
        "medical_history.past_medical_history[0]"
      ]
    },
    {
      "evidence_id": "EV_020",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "I can see a fine jerking of the eyes to the left and your walking is a little unsteady.",
