  "clinical_evidence": [
    {
      "evidence_id": "EV_001",
      "speaker_id": "person_3",
      "speaker_role": "caregiver",
      "transcript_text": "We came because of pain going down the back of my left leg.",
      "start_timestamp": "00:32",
      "end_timestamp": "00:40",
      "supports": [
        "chief_complaint",
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_002",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Can you tell me when it first started?",
      "start_timestamp": "00:41",
      "end_timestamp": "00:44",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_003",
      "speaker_id": "person_4",
      "speaker_role": "patient",
      "transcript_text": "it's been three weeks, I'm fairly sure",
      "start_timestamp": "00:45",
      "end_timestamp": "00:49",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_004",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Tell me a bit more about it: how bad it gets, how often, and whether anything makes it better or worse.",
      "start_timestamp": "00:51",
      "end_timestamp": "01:00",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_005",
      "speaker_id": "person_4",
      "speaker_role": "patient",
      "transcript_text": "about a eight out of ten i get some relief from lying flat it happens a couple of times a week",
      "start_timestamp": "01:02",
      "end_timestamp": "01:15",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_006",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "So, any other symptoms with it?",
      "start_timestamp": "01:16",
      "end_timestamp": "01:19",
      "supports": [
        "symptoms[0]",
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_007",
      "speaker_id": "person_4",
      "speaker_role": "patient",
      "transcript_text": "When it starts I tend to get trouble sleeping because of the pain as well.",
      "start_timestamp": "01:20",
      "end_timestamp": "01:28",
      "supports": [
        "symptoms[0]",
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_008",
      "speaker_id": "person_4",
      "speaker_role": "patient",
      "transcript_text": "Ah, as for stiffness in the morning, I honestly can't say when that began. It might have been last month or the month before. Actually, you know, as for stiffness in the morning, it sort of comes and goes. The trouble sleeping because of the pain? That's been for about three months. With trouble sleeping because of the pain, maybe a three out of ten on a bad day. I'd say on and off.",
      "start_timestamp": "01:47",
      "end_timestamp": "02:24",
      "supports": [
        "symptoms[1]",
        "symptoms[2]",
        "clinical_uncertainties[0]"
      ]
    },
    {
      "evidence_id": "EV_009",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Yes, carry on. Okay, have you had pain going down the back of your left leg before, or is this the first time?",
      "start_timestamp": "02:25",
      "end_timestamp": "02:35",
      "supports": [
        "symptoms[3]"
      ]
    },
    {
      "evidence_id": "EV_010",
      "speaker_id": "person_4",
      "speaker_role": "patient",
      "transcript_text": "Yes, um, something like this happened last winter, and it went away on its own.",
      "start_timestamp": "02:37",
      "end_timestamp": "02:47",
      "supports": [
        "symptoms[3]"
      ]
    },
    {
      "evidence_id": "EV_011",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Let's talk a little about your daily life and habits.",
      "start_timestamp": "02:48",
      "end_timestamp": "02:53",
      "supports": [
        "medical_history.social_history[0]",
        "medical_history.social_history[1]",
        "medical_history.social_history[2]"
      ]
    },
    {
      "evidence_id": "EV_012",
      "speaker_id": "person_4",
      "speaker_role": "patient",
      "transcript_text": "I used to drink heavily but I stopped four years ago. I do a yoga class on Thursdays. I'm a plumber, lots of bending and kneeling.",
      "start_timestamp": "02:54",
      "end_timestamp": "03:07",
      "supports": [
        "medical_history.social_history[0]",
        "medical_history.social_history[1]",
        "medical_history.social_history[2]"
      ]
    },
    {
      "evidence_id": "EV_013",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Any inherited conditions that you know of in the family?",
      "start_timestamp": "03:21",
      "end_timestamp": "03:25",
      "supports": [
        "medical_history.family_history[0]",
        "medical_history.family_history[1]"
      ]
    },
    {
      "evidence_id": "EV_014",
      "speaker_id": "person_4",
      "speaker_role": "patient",
      "transcript_text": "My father has Parkinson's disease. Ah, uh, my cousin has psoriasis.",
      "start_timestamp": "03:26",
      "end_timestamp": "03:32",
      "supports": [
        "medical_history.family_history[0]",
        "medical_history.family_history[1]"
      ]
    },
    {
      "evidence_id": "EV_015",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Are you allergic to anything? Any allergies to medicines or foods?",
      "start_timestamp": "03:34",
      "end_timestamp": "03:38",
      "supports": [
        "allergies[0]",
        "allergies[1]"
      ]
    },
    {
      "evidence_id": "EV_016",
      "speaker_id": "person_4",
      "speaker_role": "patient",
      "transcript_text": "I was told I'm allergic to naproxen, but I don't remember what reaction I had. Um, I'm allergic to cat fur, I get wheezing.",
      "start_timestamp": "03:40",
      "end_timestamp": "03:54",
      "supports": [
        "allergies[0]",
        "allergies[1]"
      ]
    },
    {
