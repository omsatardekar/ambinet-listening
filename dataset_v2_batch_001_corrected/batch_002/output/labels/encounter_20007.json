  "clinical_evidence": [
    {
      "evidence_id": "EV_001",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "I wanted to get a dry cough looked at. I wasn't sure whether to come in at all, um, to be honest.",
      "start_timestamp": "00:16",
      "end_timestamp": "00:27",
      "supports": [
        "chief_complaint",
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_002",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "How long has it been like this?",
      "start_timestamp": "00:29",
      "end_timestamp": "00:32",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_003",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Ah, it's been five days, I'm fairly sure.",
      "start_timestamp": "00:33",
      "end_timestamp": "00:38",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_004",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Tell me a bit more about it: how bad it gets, how often, and whether anything makes it better or worse.",
      "start_timestamp": "00:43",
      "end_timestamp": "00:53",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_005",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "It comes and goes. I'd call it severe. It's a relief to finally sit down and talk about it.",
      "start_timestamp": "00:54",
      "end_timestamp": "01:04",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_006",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Have you had aching all over?",
      "start_timestamp": "01:22",
      "end_timestamp": "01:24",
      "supports": [
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_007",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Yes, for about four days.",
      "start_timestamp": "01:26",
      "end_timestamp": "01:28",
      "supports": [
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_008",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "How strong would you say it is?",
      "start_timestamp": "01:29",
      "end_timestamp": "01:32",
      "supports": [
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_009",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Mild, I'd say. I've also been feeling short of breath, for ten days.",
      "start_timestamp": "01:37",
      "end_timestamp": "01:43",
      "supports": [
        "symptoms[1]",
        "symptoms[2]"
      ]
    },
    {
      "evidence_id": "EV_010",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Any vomiting or chest pain?",
      "start_timestamp": "01:44",
      "end_timestamp": "01:47",
      "supports": [
        "symptoms[3]",
        "negative_findings[0]",
        "negative_findings[1]"
      ]
    },
    {
      "evidence_id": "EV_011",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Ah, no, no vomiting, no chest pain. I did have loss of taste at one point, but that went away on its own.",
