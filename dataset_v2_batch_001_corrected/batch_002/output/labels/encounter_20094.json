      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_005",
      "speaker_id": "person_3",
      "speaker_role": "patient",
      "transcript_text": "I'd call it mild. I've had a bit of a sore throat too, for about a week. I've also been getting breathless on the stairs, for five days. As for getting breathless on the stairs, a six out of ten, I suppose.",
