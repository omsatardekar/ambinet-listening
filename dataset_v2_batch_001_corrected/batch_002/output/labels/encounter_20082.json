      "end_timestamp": "02:25",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_014",
      "speaker_id": "person_2",
      "speaker_role": "patient",
      "transcript_text": "As for blisters between my fingers, I honestly can't say when that began. It might have been last month or the month before.",
