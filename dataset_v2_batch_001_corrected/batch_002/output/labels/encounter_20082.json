      "end_timestamp": "02:11",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_013",
      "speaker_id": "person_2",
      "speaker_role": "patient",
      "transcript_text": "Well, um, I notice it more with gloves. Moisturiser helps a bit. A neighbour of mine said I should see someone about it.",
