  "clinical_evidence": [
    {
      "evidence_id": "EV_001",
      "speaker_id": "person_3",
      "speaker_role": "caregiver",
      "transcript_text": "It's red, cracked skin on my hands, doctor. She didn't want to come, but I insisted.",
