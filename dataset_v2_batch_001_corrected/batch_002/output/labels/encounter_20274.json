    {
      "evidence_id": "EV_020",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Having listened and examined, I can't pin this down yet. We're looking at a fever after travel that must be treated as possible malaria or dengue fever.",
