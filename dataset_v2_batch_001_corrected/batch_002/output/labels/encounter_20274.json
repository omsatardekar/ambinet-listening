    },
    {
      "evidence_id": "EV_017",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "I quit smoking around ten years ago. I'll have a glass of wine with dinner. Not much, I mostly stay in these days. My husband and I live above the shop.",
