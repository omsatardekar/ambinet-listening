  "clinical_evidence": [
    {
      "evidence_id": "EV_001",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "It's pain in the finger, mostly.",
      "start_timestamp": "00:12",
      "end_timestamp": "00:15",
      "supports": [
        "chief_complaint",
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_002",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Tell me a bit more about it: how bad it gets, how often, and whether anything makes it better or worse.",
      "start_timestamp": "00:16",
      "end_timestamp": "00:25",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_003",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Uh, honestly, a few times a day. A seven out of ten, I suppose. I'd rather not end up on lots of tablets if I can avoid it.",
      "start_timestamp": "00:26",
      "end_timestamp": "00:42",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_004",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Right, is there anything else with it?",
      "start_timestamp": "00:43",
      "end_timestamp": "00:47",
      "supports": [
        "symptoms[0]",
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_005",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Difficulty bending the finger goes along with it, most of the time. As for bleeding, I honestly can't say when that began. It might have been last month or the month before. Okay, um, so the difficulty bending the finger? That's been for about a week.",
      "start_timestamp": "00:49",
      "end_timestamp": "01:14",
      "supports": [
        "symptoms[0]",
        "symptoms[1]",
        "symptoms[2]",
        "clinical_uncertainties[0]"
      ]
    },
    {
      "evidence_id": "EV_006",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Have you had pain in the finger before, or is this the first time?",
      "start_timestamp": "01:15",
      "end_timestamp": "01:22",
      "supports": [
        "symptoms[3]"
      ]
    },
    {
      "evidence_id": "EV_007",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Uh, a bit, about six months ago. It settled by itself back then.",
      "start_timestamp": "01:23",
      "end_timestamp": "01:30",
      "supports": [
        "symptoms[3]"
      ]
    },
    {
      "evidence_id": "EV_008",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Are you allergic to anything? Any allergies to medicines or foods?",
      "start_timestamp": "01:39",
      "end_timestamp": "01:43",
      "supports": [
        "allergies[0]"
      ]
    },
    {
      "evidence_id": "EV_009",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Nickel. I come out in... well, a rash on my skin.",
      "start_timestamp": "01:44",
      "end_timestamp": "01:51",
      "supports": [
        "allergies[0]"
      ]
    },
    {
      "evidence_id": "EV_010",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Let's run through your medicines.",
      "start_timestamp": "01:53",
      "end_timestamp": "01:55",
      "supports": [
        "medications[0]",
        "medications[1]",
        "medications[2]"
      ]
    },
    {
      "evidence_id": "EV_011",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "I'm on Asthalin inhaler, when needed for my asthma. Sorry, what was I saying, I'm on propranolol, 40 milligrams, twice a day.",
      "start_timestamp": "01:56",
      "end_timestamp": "02:08",
      "supports": [
        "medications[0]",
        "medications[1]"
      ]
    },
    {
      "evidence_id": "EV_012",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "And for how long?",
      "start_timestamp": "02:10",
      "end_timestamp": "02:12",
      "supports": [
        "medications[1]"
      ]
    },
    {
      "evidence_id": "EV_013",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Two months now. I'm on alendronate, once a week.",
      "start_timestamp": "02:16",
      "end_timestamp": "02:22",
      "supports": [
        "medications[1]",
        "medications[2]"
      ]
    },
    {
      "evidence_id": "EV_014",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "How much do you take?",
      "start_timestamp": "02:23",
      "end_timestamp": "02:25",
      "supports": [
        "medications[2]"
      ]
    },
    {
      "evidence_id": "EV_015",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "It's 70 milligrams.",
      "start_timestamp": "02:26",
      "end_timestamp": "02:27",
      "supports": [
        "medications[2]"
      ]
    },
    {
      "evidence_id": "EV_016",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "How long have you taken that?",
      "start_timestamp": "02:28",
      "end_timestamp": "02:31",
      "supports": [
        "medications[2]"
      ]
    },
    {
      "evidence_id": "EV_017",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "About a month now.",
      "start_timestamp": "02:31",
      "end_timestamp": "02:34",
      "supports": [
        "medications[2]"
      ]
    },
    {
      "evidence_id": "EV_018",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Anything in your past medical history I should know?",
      "start_timestamp": "02:34",
      "end_timestamp": "02:38",
      "supports": [
        "medical_history.past_medical_history[0]"
      ]
    },
    {
      "evidence_id": "EV_019",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Hmm, I have asthma. My sister suggested writing things down, but I forgot. My family kept telling me to get it checked.",
      "start_timestamp": "02:40",
      "end_timestamp": "02:54",
      "supports": [
        "medical_history.past_medical_history[0]"
      ]
    },
    {
      "evidence_id": "EV_020",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Right, and anything else to add?",
      "start_timestamp": "02:56",
      "end_timestamp": "02:58",
      "supports": [
        "medical_history.past_medical_history[1]"
      ]
    },
    {
      "evidence_id": "EV_021",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Migraines, for about ten years. I kept putting it off, which I know isn't sensible.",
      "start_timestamp": "03:00",
