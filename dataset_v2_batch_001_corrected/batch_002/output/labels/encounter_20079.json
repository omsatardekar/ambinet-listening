      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_012",
      "speaker_id": "person_5",
      "speaker_role": "patient",
      "transcript_text": "It's worse with standing up quickly.",
      "start_timestamp": "01:21",
      "end_timestamp": "01:24",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_013",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Later, thanks. Please go on. Have you been feeling weak?",
