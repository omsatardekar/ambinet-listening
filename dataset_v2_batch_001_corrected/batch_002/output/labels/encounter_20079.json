      "end_timestamp": "02:20",
      "supports": [
        "symptoms[2]",
        "negative_findings[0]",
        "negative_findings[1]",
        "negative_findings[2]"
      ]
    },
    {
      "evidence_id": "EV_018",
      "speaker_id": "person_5",
      "speaker_role": "patient",
      "transcript_text": "No, no palpitations, no slurred speech, no fainting. I did have nearly blacking out at one point, but that went away on its own.",
      "start_timestamp": "02:21",
      "end_timestamp": "02:35",
