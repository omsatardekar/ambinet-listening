      "end_timestamp": "01:46",
      "supports": [
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_014",
      "speaker_id": "person_5",
      "speaker_role": "patient",
      "transcript_text": "Yes, about the same, about a week.",
      "start_timestamp": "01:48",
      "end_timestamp": "01:52",
      "supports": [
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_015",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "How troublesome is it day to day?",
      "start_timestamp": "01:52",
      "end_timestamp": "01:55",
      "supports": [
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_016",
      "speaker_id": "person_5",
      "speaker_role": "patient",
      "transcript_text": "Pretty severe, if I'm being honest.",
      "start_timestamp": "01:57",
      "end_timestamp": "02:00",
      "supports": [
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_017",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "A few quick ones: palpitations, slurred speech or fainting?",
