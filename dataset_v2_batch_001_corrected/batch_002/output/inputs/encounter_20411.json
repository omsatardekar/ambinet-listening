{
  "schema_version": "1.0",
  "encounter_id": "20411",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.36,
      "end_seconds": 4.45,
      "duration_seconds": 3.09,
      "text": "Hello, doctor. May I come in?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.81,
      "end_seconds": 10.29,
      "duration_seconds": 4.48,
      "text": "Not at all, please sit. What seems to be wrong?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 11.01,
      "end_seconds": 22.71,
      "duration_seconds": 11.7,
      "text": "It's drenching night sweats. I thought I'd wait, uh, but it hasn't gone. I just want to get back to normal, really."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 24.68,
      "end_seconds": 27.41,
      "duration_seconds": 2.73,
      "text": "Has this been going on for long?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 28.82,
      "end_seconds": 32.1,
      "duration_seconds": 3.28,
      "text": "I've had it for one week."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 33.49,
      "end_seconds": 41.25,
      "duration_seconds": 7.76,
      "text": "Can you describe it a bit more for me? How strong it is, what the pattern is, what helps."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 43.26,
      "end_seconds": 55.62,
      "duration_seconds": 12.36,
      "text": "Changing my clothes helps a bit. I'd say once or twice a day. I didn't want to make a fuss, you know."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 57.55,
      "end_seconds": 60.41,
      "duration_seconds": 2.86,
      "text": "Any recent travel, diarrhoea or chest pain?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 61.08,
      "end_seconds": 64.18,
      "duration_seconds": 3.1,
      "text": "None of those, um, no."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 64.53,
      "end_seconds": 69.03,
      "duration_seconds": 4.5,
      "text": "I see, go ahead. Okay, anything unusual with passing urine?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 70.52,
      "end_seconds": 73.04,
      "duration_seconds": 2.52,
      "text": "Actually, no, that's all fine."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 75.08,
      "end_seconds": 80.5,
      "duration_seconds": 5.42,
      "text": "Are you allergic to anything? Any allergies to medicines or foods?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 82.42,
      "end_seconds": 86.88,
      "duration_seconds": 4.46,
      "text": "No, um, nothing as far as I know."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 96.89,
      "end_seconds": 99.31,
      "duration_seconds": 2.42,
      "text": "Now some background about your lifestyle."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 100.17,
      "end_seconds": 111.49,
      "duration_seconds": 11.32,
      "text": "I hardly move around during the day. I grab fast food at lunch most days. Yes, I work in a bakery, early starts."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 112.78,
      "end_seconds": 115.66,
      "duration_seconds": 2.88,
      "text": "Do you have any long-term conditions?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 119.48,
      "end_seconds": 126.98,
      "duration_seconds": 7.5,
      "text": "Erm, you know, I have high blood pressure. I told my wife I'd come today."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 127.54,
      "end_seconds": 134.77,
      "duration_seconds": 7.23,
      "text": "Mm-hmm. Yes, high blood pressure is known to us, good to have that clear."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 146.0,
      "end_seconds": 148.06,
      "duration_seconds": 2.06,
      "text": "Let's run through your medicines."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 149.32,
      "end_seconds": 159.58,
      "duration_seconds": 10.26,
      "text": "Yeah, I'm on telmisartan, 40 milligrams, once a day. Dolo. I take it 650 milligrams, when I get the fever."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 173.78,
      "end_seconds": 178.15,
      "duration_seconds": 4.37,
      "text": "Let me get the readings out of the way."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 184.66,
      "end_seconds": 186.75,
      "duration_seconds": 2.09,
      "text": "Okay, this won't take long..."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 206.34,
      "end_seconds": 215.67,
      "duration_seconds": 9.33,
      "text": "Okay: pulse is 100 beats a minute, blood pressure 112 over 77, oxygen saturation is 95 percent, temp 39.3 degrees."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 218.44,
      "end_seconds": 223.91,
      "duration_seconds": 5.47,
      "text": "Alright, I'll need to examine you for this, it won't take long."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 225.31,
      "end_seconds": 227.02,
      "duration_seconds": 1.71,
      "text": "Right, does that hurt?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 236.31,
      "end_seconds": 242.46,
      "duration_seconds": 6.15,
      "text": "There's a firm, rubbery gland about two centimetres in the left armpit, not tender."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 244.12,
      "end_seconds": 245.79,
      "duration_seconds": 1.67,
      "text": "Let me feel here."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 260.77,
      "end_seconds": 262.79,
      "duration_seconds": 2.02,
      "text": "I can't feel your spleen."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 268.7,
      "end_seconds": 270.47,
      "duration_seconds": 1.77,
      "text": "Please sit back down."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 279.66,
      "end_seconds": 287.72,
      "duration_seconds": 8.06,
      "text": "Putting it all together, it fits best with an enlarged gland with night sweats that needs a proper work-up."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 288.26,
      "end_seconds": 289.77,
      "duration_seconds": 1.51,
      "text": "Is this permanent?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 291.04,
      "end_seconds": 329.95,
      "duration_seconds": 38.91,
      "text": "It's reasonable to be concerned, but right now an enlarged gland with night sweats that needs a proper work-up is my leading thought, not anything worse. Let's get an ultrasound of the armpit, for lymph node. Keep a note of your temperature each evening. Let's get you seen by the haematology clinic, I'll arrange the letter. Come back or go to emergency straight away if the symptoms get worse. I'd like you back after the results are back."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 331.11,
      "end_seconds": 335.42,
      "duration_seconds": 4.31,
      "text": "Is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 336.05,
      "end_seconds": 339.45,
      "duration_seconds": 3.4,
      "text": "I think I understand everything. Thanks."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 340.76,
      "end_seconds": 343.06,
      "duration_seconds": 2.3,
      "text": "Right, have a good day."
    }
  ]
}