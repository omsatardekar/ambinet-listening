{
  "schema_version": "1.0",
  "encounter_id": "20172",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.81,
      "end_seconds": 3.82,
      "duration_seconds": 3.01,
      "text": "Hello, doctor. May I come in?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 9.91,
      "end_seconds": 14.06,
      "duration_seconds": 4.15,
      "text": "Yes, have a seat. Tell me what's going on."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 15.16,
      "end_seconds": 21.17,
      "duration_seconds": 6.01,
      "text": "So the thing is, I've got burning pain in the upper tummy."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 23.22,
      "end_seconds": 25.63,
      "duration_seconds": 2.41,
      "text": "I'll do your observations first."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 33.31,
      "end_seconds": 35.6,
      "duration_seconds": 2.29,
      "text": "Sit still for a moment..."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 45.1,
      "end_seconds": 55.71,
      "duration_seconds": 10.61,
      "text": "Okay: pressure 128 over 70, oxygen saturation is 98 percent, pulse 67. Okay, when was the first time you noticed it?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 56.8,
      "end_seconds": 60.73,
      "duration_seconds": 3.93,
      "text": "Actually, it's been like this since last Tuesday."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 61.25,
      "end_seconds": 64.02,
      "duration_seconds": 2.77,
      "text": "Is it worse at certain times?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 65.91,
      "end_seconds": 70.62,
      "duration_seconds": 4.71,
      "text": "Yes, empty stomach and spicy food. That makes it worse."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 72.25,
      "end_seconds": 76.36,
      "duration_seconds": 4.11,
      "text": "Any jaundice, black stools or vomiting blood at all?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 77.78,
      "end_seconds": 82.49,
      "duration_seconds": 4.71,
      "text": "Well, no, no jaundice, black stools or vomiting blood."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 83.95,
      "end_seconds": 87.07,
      "duration_seconds": 3.12,
      "text": "Any muscle or joint problems besides this?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 87.93,
      "end_seconds": 89.65,
      "duration_seconds": 1.72,
      "text": "No, nothing there."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 91.6,
      "end_seconds": 96.2,
      "duration_seconds": 4.6,
      "text": "Do you have any medical conditions I should know about?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 97.05,
      "end_seconds": 100.36,
      "duration_seconds": 3.31,
      "text": "No, I've always been fairly healthy."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 111.05,
      "end_seconds": 113.76,
      "duration_seconds": 2.71,
      "text": "Before we go further, any allergies?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 115.69,
      "end_seconds": 118.12,
      "duration_seconds": 2.43,
      "text": "So, no allergies at all."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 119.14,
      "end_seconds": 122.21,
      "duration_seconds": 3.07,
      "text": "Any regular medication, tablets or creams?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 123.12,
      "end_seconds": 125.76,
      "duration_seconds": 2.64,
      "text": "No, I'm not on anything."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 143.69,
      "end_seconds": 145.04,
      "duration_seconds": 1.35,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 147.05,
      "end_seconds": 148.75,
      "duration_seconds": 1.7,
      "text": "No surgery, no."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 166.99,
      "end_seconds": 170.31,
      "duration_seconds": 3.32,
      "text": "A few questions about your lifestyle now."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 171.16,
      "end_seconds": 183.73,
      "duration_seconds": 12.57,
      "text": "I used to drink heavily but I stopped four years ago. I work in accounts at a hospital. I live with my elderly mother."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 185.78,
      "end_seconds": 189.82,
      "duration_seconds": 4.04,
      "text": "Let me look at the area, I'll be gentle."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 191.51,
      "end_seconds": 194.4,
      "duration_seconds": 2.89,
      "text": "Stay as you are for a moment."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 203.55,
      "end_seconds": 209.09,
      "duration_seconds": 5.54,
      "text": "Your tummy is soft with some tenderness in the upper middle part."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 214.63,
      "end_seconds": 226.8,
      "duration_seconds": 12.17,
      "text": "Okay, that's enough for me. Putting it all together, I can't pin this down yet. We're looking at dyspepsia possibly related to anti-inflammatory tablets or reflux."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 231.74,
      "end_seconds": 234.98,
      "duration_seconds": 3.24,
      "text": "Do you think it's something serious?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 236.33,
      "end_seconds": 255.51,
      "duration_seconds": 19.18,
      "text": "I understand the worry. At the moment I'd say it's dyspepsia possibly related to anti-inflammatory tablets, and we'll know more once the blood tests is back. So, to recap quickly. You've had burning pain in the upper tummy, since last Tuesday, and no vomiting blood or black stools."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 256.34,
      "end_seconds": 257.92,
      "duration_seconds": 1.58,
      "text": "Mm, that's right."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 275.35,
      "end_seconds": 311.18,
      "duration_seconds": 35.83,
      "text": "I'd like to arrange blood tests for dyspepsia. I'd like you to take omeprazole, 20 milligrams, once a day, for four weeks. That's for stomach acid. Please stop taking the anti-inflammatory tablets for now and use paracetamol for the pain. The thing that would worry me is if you pass black stools or vomit blood. If that happens, go to emergency. I'll want another look after the test result. So, I think we're done unless you have questions."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 312.0,
      "end_seconds": 315.17,
      "duration_seconds": 3.17,
      "text": "Good, thanks, I'll see you then."
    }
  ]
}