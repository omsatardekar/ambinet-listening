{
  "schema_version": "1.0",
  "encounter_id": "20428",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.84,
      "end_seconds": 5.45,
      "duration_seconds": 4.61,
      "text": "Doctor? Hello, I hope this is the right time."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.27,
      "end_seconds": 10.69,
      "duration_seconds": 4.42,
      "text": "Yes, come in and sit down. What brings you here today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 14.2,
      "end_seconds": 20.26,
      "duration_seconds": 6.06,
      "text": "Honestly, it's my heart racing, and my family pushed me to come."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 21.76,
      "end_seconds": 25.42,
      "duration_seconds": 3.66,
      "text": "How many days or weeks has it been?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 26.83,
      "end_seconds": 29.19,
      "duration_seconds": 2.36,
      "text": "About... well, about a month."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 30.27,
      "end_seconds": 35.39,
      "duration_seconds": 5.12,
      "text": "Okay, give me more detail on it, whatever comes to mind."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 37.11,
      "end_seconds": 41.9,
      "duration_seconds": 4.79,
      "text": "It's mild, honestly. It settles a little with slow breathing."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 43.78,
      "end_seconds": 47.51,
      "duration_seconds": 3.73,
      "text": "Okay, have you been feeling anxious during it?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 49.22,
      "end_seconds": 51.6,
      "duration_seconds": 2.38,
      "text": "Yeah. Four weeks, I'd say."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 60.35,
      "end_seconds": 63.75,
      "duration_seconds": 3.4,
      "text": "Any fainting or weight loss at all?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 64.26,
      "end_seconds": 66.88,
      "duration_seconds": 2.62,
      "text": "No, none that I've noticed."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 68.96,
      "end_seconds": 71.06,
      "duration_seconds": 2.1,
      "text": "Has there been any tremor?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 75.54,
      "end_seconds": 78.35,
      "duration_seconds": 2.81,
      "text": "Not at all, no tremor."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 79.09,
      "end_seconds": 81.94,
      "duration_seconds": 2.85,
      "text": "Right, anything different when you pass water?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 83.03,
      "end_seconds": 84.63,
      "duration_seconds": 1.6,
      "text": "Nothing there, no."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 85.32,
      "end_seconds": 88.46,
      "duration_seconds": 3.14,
      "text": "So, how are your bowels, any trouble?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 92.33,
      "end_seconds": 93.92,
      "duration_seconds": 1.59,
      "text": "Nothing unusual, no."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 95.98,
      "end_seconds": 99.77,
      "duration_seconds": 3.79,
      "text": "Do you take any prescribed or over-the-counter medicines?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 101.14,
      "end_seconds": 105.86,
      "duration_seconds": 4.72,
      "text": "Glycomet. I take it 500 milligrams, twice a day."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 115.78,
      "end_seconds": 118.61,
      "duration_seconds": 2.83,
      "text": "A few questions about your lifestyle now."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 119.19,
      "end_seconds": 138.24,
      "duration_seconds": 19.05,
      "text": "I used to drink heavily but I stopped four years ago. I hardly move around during the day. I drink a lot of tea and snack through the day. I look after my grandchildren most days."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 139.81,
      "end_seconds": 147.88,
      "duration_seconds": 8.07,
      "text": "Has anything ever caused you a reaction? I mean any allergies. I'll explain everything as we go along."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 148.6,
      "end_seconds": 151.08,
      "duration_seconds": 2.48,
      "text": "Not to my knowledge, no."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 152.43,
      "end_seconds": 155.32,
      "duration_seconds": 2.89,
      "text": "Has anyone ever diagnosed you with something?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 159.98,
      "end_seconds": 163.88,
      "duration_seconds": 3.9,
      "text": "I've had diabetes for two years now."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 164.99,
      "end_seconds": 173.7,
      "duration_seconds": 8.71,
      "text": "Yes. Yes, diabetes is known to us, good to have that clear. Right, any surgery in the past?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 174.7,
      "end_seconds": 179.57,
      "duration_seconds": 4.87,
      "text": "Just keyhole surgery on my gallbladder, two years back."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 190.36,
      "end_seconds": 193.11,
      "duration_seconds": 2.75,
      "text": "Let me take your readings now."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 200.64,
      "end_seconds": 203.54,
      "duration_seconds": 2.9,
      "text": "So, nearly done with the readings..."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 214.63,
      "end_seconds": 225.54,
      "duration_seconds": 10.91,
      "text": "Okay: respiratory rate 17, SpO2 97 percent on room air, blood pressure 135 over 79. And pulse is 112 beats a minute."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 227.89,
      "end_seconds": 232.06,
      "duration_seconds": 4.17,
      "text": "Let me look at the area, I'll be gentle."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 233.63,
      "end_seconds": 235.9,
      "duration_seconds": 2.27,
      "text": "Raise your arm for me."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 247.01,
      "end_seconds": 250.45,
      "duration_seconds": 3.44,
      "text": "Heart sounds are normal with no murmur."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 252.09,
      "end_seconds": 254.46,
      "duration_seconds": 2.37,
      "text": "Take a deep breath for me."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 272.68,
      "end_seconds": 276.61,
      "duration_seconds": 3.93,
      "text": "The pulse is irregular, around ninety beats a minute."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 280.88,
      "end_seconds": 282.57,
      "duration_seconds": 1.69,
      "text": "Please sit back down."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 295.53,
      "end_seconds": 312.28,
      "duration_seconds": 16.75,
      "text": "Having listened and examined, it points towards paroxysmal palpitations, possibly an atrial arrhythmia. Let me repeat that back to make sure. You've had your heart racing for about a month, mild, and no weight loss or fainting."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 313.65,
      "end_seconds": 315.41,
      "duration_seconds": 1.76,
      "text": "Yes, that's right."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 316.72,
      "end_seconds": 337.17,
      "duration_seconds": 20.45,
      "text": "I'm sending you for a heart monitor for a few days because of palpitations. I'd like you to take bisoprolol, 2.5 milligrams, once a day, until review. You take it by mouth. It's for heart rate control. The pharmacy will go through the details again when you pick it up."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 337.94,
      "end_seconds": 341.03,
      "duration_seconds": 3.09,
      "text": "Alright, I'll pick it up today."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 342.35,
      "end_seconds": 359.23,
      "duration_seconds": 16.88,
      "text": "Cut right back on coffee, tea and energy drinks for now. Let's hold off on a thyroid test for now, and if there's no change next month we can revisit it. That's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 360.29,
      "end_seconds": 363.85,
      "duration_seconds": 3.56,
      "text": "Right, I'll do that. Thank you, doctor."
    }
  ]
}