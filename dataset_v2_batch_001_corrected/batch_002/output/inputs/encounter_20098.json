{
  "schema_version": "1.0",
  "encounter_id": "20098",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.21,
      "end_seconds": 5.04,
      "duration_seconds": 3.83,
      "text": "hello, doctor i think it's my turn"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.63,
      "end_seconds": 11.5,
      "duration_seconds": 3.87,
      "text": "no problem at all, come in. What's troubling you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 13.22,
      "end_seconds": 19.08,
      "duration_seconds": 5.86,
      "text": "I wanted to get a bump on my head looked at"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 19.65,
      "end_seconds": 22.34,
      "duration_seconds": 2.69,
      "text": "Let me take your readings now."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 34.91,
      "end_seconds": 37.68,
      "duration_seconds": 2.77,
      "text": "Bear with me while this finishes..."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 52.88,
      "end_seconds": 65.98,
      "duration_seconds": 13.1,
      "text": "Okay: heart rate 78, oxygen saturation is 97 percent. And pressure 115 over 72, respiratory rate 15, temperature is 36.5 degrees. How long has it been like this?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 66.61,
      "end_seconds": 78.09,
      "duration_seconds": 11.48,
      "text": "Mm, it's been like this since last night. I'd rather know what's going on than keep guessing. I've been putting this off for weeks."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 78.66,
      "end_seconds": 79.6,
      "duration_seconds": 0.94,
      "text": "I follow"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 81.22,
      "end_seconds": 90.89,
      "duration_seconds": 9.67,
      "text": "Oh, and a bit of nausea. That's been about the same, two weeks. With bit of nausea, it's severe, honestly."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 105.57,
      "end_seconds": 108.2,
      "duration_seconds": 2.63,
      "text": "Any confusion, double vision or vomiting?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 109.47,
      "end_seconds": 114.26,
      "duration_seconds": 4.79,
      "text": "No confusion, double vision or vomiting, none of it."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 114.92,
      "end_seconds": 118.63,
      "duration_seconds": 3.71,
      "text": "Anything on the skin I should know about?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 120.22,
      "end_seconds": 122.35,
      "duration_seconds": 2.13,
      "text": "no, skin's been fine"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 124.1,
      "end_seconds": 127.24,
      "duration_seconds": 3.14,
      "text": "Is there any regular medication you use?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 129.02,
      "end_seconds": 130.15,
      "duration_seconds": 1.13,
      "text": "No, none."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 131.34,
      "end_seconds": 136.09,
      "duration_seconds": 4.75,
      "text": "Are you allergic to anything? Any allergies to medicines or foods?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 138.09,
      "end_seconds": 140.81,
      "duration_seconds": 2.72,
      "text": "not to my knowledge, no"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 158.82,
      "end_seconds": 163.23,
      "duration_seconds": 4.41,
      "text": "Do you have any medical conditions I should know about?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 164.54,
      "end_seconds": 167.75,
      "duration_seconds": 3.21,
      "text": "no, um, nothing at all"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 179.93,
      "end_seconds": 181.57,
      "duration_seconds": 1.64,
      "text": "How active are you?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 182.79,
      "end_seconds": 186.13,
      "duration_seconds": 3.34,
      "text": "I hardly move around during the day."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 187.37,
      "end_seconds": 189.59,
      "duration_seconds": 2.22,
      "text": "Is there someone at home?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 191.0,
      "end_seconds": 195.16,
      "duration_seconds": 4.16,
      "text": "My husband and I live above the shop."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 197.06,
      "end_seconds": 201.83,
      "duration_seconds": 4.77,
      "text": "I'll need to examine you for this, it won't take long."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 202.88,
      "end_seconds": 206.5,
      "duration_seconds": 3.62,
      "text": "alright, stay as you are for a moment"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 224.53,
      "end_seconds": 232.2,
      "duration_seconds": 7.67,
      "text": "There is a small bruise on the forehead, the pupils are equal and reactive, and you are walking steadily."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 237.83,
      "end_seconds": 239.37,
      "duration_seconds": 1.54,
      "text": "Yeah, no problem."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 242.82,
      "end_seconds": 252.84,
      "duration_seconds": 10.02,
      "text": "Thank you, you can get dressed. Okay, so my impression is this: The most likely explanation is a minor head injury without worrying signs."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 264.56,
      "end_seconds": 293.92,
      "duration_seconds": 29.36,
      "text": "I'm prescribing paracetamol, 1 gram, every six hours if needed, for three days. You take it by mouth. That should help with headache. Someone should stay with you tonight, and no alcohol or contact sport for now. Keep an eye out, and if you vomit repeatedly, become drowsy or confused, or have a fit, call us the same day or go to emergency."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 295.26,
      "end_seconds": 298.35,
      "duration_seconds": 3.09,
      "text": "Thank you, um, that's clear."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 299.24,
      "end_seconds": 307.02,
      "duration_seconds": 7.78,
      "text": "Come back if the headache gets worse. Okay, anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 308.02,
      "end_seconds": 311.75,
      "duration_seconds": 3.73,
      "text": "right, I'll do that thank you, doctor"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 312.52,
      "end_seconds": 313.89,
      "duration_seconds": 1.37,
      "text": "goodbye for now"
    }
  ]
}