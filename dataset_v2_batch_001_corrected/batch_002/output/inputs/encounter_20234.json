{
  "schema_version": "1.0",
  "encounter_id": "20234",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.55,
      "end_seconds": 5.42,
      "duration_seconds": 4.87,
      "text": "Welcome. Make yourself comfortable. Is this your first time with this clinic?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 7.17,
      "end_seconds": 13.37,
      "duration_seconds": 6.2,
      "text": "Mm, first time with this one, yes. A friend recommended it."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 15.09,
      "end_seconds": 17.6,
      "duration_seconds": 2.51,
      "text": "tell me what's brought you in"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 19.08,
      "end_seconds": 22.44,
      "duration_seconds": 3.36,
      "text": "I've been dealing with some bleeding."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 24.08,
      "end_seconds": 27.37,
      "duration_seconds": 3.29,
      "text": "when was the first time you noticed it?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 29.28,
      "end_seconds": 33.48,
      "duration_seconds": 4.2,
      "text": "I've, I've had it for one week."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 34.59,
      "end_seconds": 36.57,
      "duration_seconds": 1.98,
      "text": "Any other symptoms with it?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 38.45,
      "end_seconds": 45.25,
      "duration_seconds": 6.8,
      "text": "when it starts I tend to get cramping in my lower tummy as well"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 46.1,
      "end_seconds": 53.26,
      "duration_seconds": 7.16,
      "text": "I was just going to say that the main thing is—"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 53.36,
      "end_seconds": 59.88,
      "duration_seconds": 6.52,
      "text": "Sorry to cut in, doctor, quick question: shall I bring the trolley in now or later?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 60.94,
      "end_seconds": 63.3,
      "duration_seconds": 2.36,
      "text": "Later, thanks. Please go on."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 64.47,
      "end_seconds": 70.63,
      "duration_seconds": 6.16,
      "text": "hmm, and there's a missed period as well, three days now"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 74.98,
      "end_seconds": 80.89,
      "duration_seconds": 5.91,
      "text": "Have you had some bleeding before, or is this the first time?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 82.91,
      "end_seconds": 90.22,
      "duration_seconds": 7.31,
      "text": "Uh, a bit, last winter. It settled by itself back then."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_4",
      "role": "UNKNOWN",
      "start_seconds": 91.68,
      "end_seconds": 94.61,
      "duration_seconds": 2.93,
      "text": "Mm, that's what happened, yes."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 95.76,
      "end_seconds": 99.28,
      "duration_seconds": 3.52,
      "text": "any severe one-sided pain or shoulder tip pain?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 100.26,
      "end_seconds": 102.48,
      "duration_seconds": 2.22,
      "text": "none of those, no"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 104.48,
      "end_seconds": 107.02,
      "duration_seconds": 2.54,
      "text": "any fainting, passing tissue or fever?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 108.5,
      "end_seconds": 112.39,
      "duration_seconds": 3.89,
      "text": "Ah, uh, none of those, no."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 114.35,
      "end_seconds": 117.22,
      "duration_seconds": 2.87,
      "text": "Any muscle or joint problems besides this?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 118.08,
      "end_seconds": 122.19,
      "duration_seconds": 4.11,
      "text": "Hmm, uh, no, joints are fine."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 123.55,
      "end_seconds": 127.72,
      "duration_seconds": 4.17,
      "text": "Anything with your heart, like skipped beats or fainting?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 128.82,
      "end_seconds": 131.99,
      "duration_seconds": 3.17,
      "text": "Actually, no, that's been fine."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 146.23,
      "end_seconds": 151.19,
      "duration_seconds": 4.96,
      "text": "So, has anything ever caused you a reaction? I mean any allergies."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 151.91,
      "end_seconds": 164.44,
      "duration_seconds": 12.53,
      "text": "Ah, I think I reacted to some antibiotic once, years ago. I don't remember which one, or what happened exactly."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 167.92,
      "end_seconds": 169.29,
      "duration_seconds": 1.37,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 170.18,
      "end_seconds": 171.46,
      "duration_seconds": 1.28,
      "text": "No, never."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 172.63,
      "end_seconds": 175.55,
      "duration_seconds": 2.92,
      "text": "a few questions about your lifestyle now"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 179.62,
      "end_seconds": 189.32,
      "duration_seconds": 9.7,
      "text": "Nothing, I'm teetotal. No, I've never smoked in my life. I'm a hairdresser, on my feet all day"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 193.94,
      "end_seconds": 196.31,
      "duration_seconds": 2.37,
      "text": "what's on your current medicine list?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 197.68,
      "end_seconds": 206.37,
      "duration_seconds": 8.69,
      "text": "I'm on something called clop... clopidogrel, 75 milligrams, maybe, once a day for the stent."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 207.16,
      "end_seconds": 210.36,
      "duration_seconds": 3.2,
      "text": "Is the packet here, or the prescription?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 212.23,
      "end_seconds": 217.99,
      "duration_seconds": 5.76,
      "text": "no, it's at home. I'm on sumatriptan, 50 milligrams, when needed"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 219.79,
      "end_seconds": 224.87,
      "duration_seconds": 5.08,
      "text": "doctor, our chart from the last visit lists it as 100 milligrams"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 230.45,
      "end_seconds": 234.85,
      "duration_seconds": 4.4,
      "text": "Right. Do you happen to have the current prescription here?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 235.81,
      "end_seconds": 245.8,
      "duration_seconds": 9.99,
      "text": "Not with me. I'll bring it next time. Tiotropium inhaler, once a day. I take iron tablets, once a day."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 246.48,
      "end_seconds": 249.21,
      "duration_seconds": 2.73,
      "text": "since when have you been taking it?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 250.86,
      "end_seconds": 252.82,
      "duration_seconds": 1.96,
      "text": "about about a year"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 254.54,
      "end_seconds": 258.99,
      "duration_seconds": 4.45,
      "text": "Tell me about any past illnesses or ongoing conditions."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 260.16,
      "end_seconds": 268.39,
      "duration_seconds": 8.23,
      "text": "Heart disease, for five years ah, uh, I have migraines, for about ten years"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 268.97,
      "end_seconds": 270.87,
      "duration_seconds": 1.9,
      "text": "Is there anything more?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 272.08,
      "end_seconds": 287.04,
      "duration_seconds": 14.96,
      "text": "I have COPD. I've got low haemoglobin. My family kept telling me to get it checked. I told myself I'd wait and see, and here I am."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 287.58,
      "end_seconds": 294.74,
      "duration_seconds": 7.16,
      "text": "Yes, heart disease and migraines are known to us, good to have that clear."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 295.72,
      "end_seconds": 304.23,
      "duration_seconds": 8.51,
      "text": "okay, so the vitals from earlier respiratory rate 16, BP is 109 over 75. Heart rate 67, temperature 36.9."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 307.77,
      "end_seconds": 308.68,
      "duration_seconds": 0.91,
      "text": "Okay, noted."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 310.14,
      "end_seconds": 312.92,
      "duration_seconds": 2.78,
      "text": "Let's move on to the examination."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 314.69,
      "end_seconds": 316.76,
      "duration_seconds": 2.07,
      "text": "Tell me if that's sore."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 325.55,
      "end_seconds": 331.83,
      "duration_seconds": 6.28,
      "text": "your tummy is soft with mild tenderness low down and your blood pressure is normal"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 337.4,
      "end_seconds": 339.47,
      "duration_seconds": 2.07,
      "text": "You can sit up now."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 351.6,
      "end_seconds": 376.24,
      "duration_seconds": 24.64,
      "text": "From what you've told me and what I found, it fits best with bleeding in early pregnancy that needs a scan. That's my thinking for now, and it may change as we learn more. Another possibility is a threatened miscarriage. I think a pregnancy hormone level makes sense here, for bleeding in early pregnancy."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_5",
      "role": "CLINICAL_STAFF",
      "start_seconds": 377.56,
      "end_seconds": 381.99,
      "duration_seconds": 4.43,
      "text": "We have a slot Thursday at 11:30 am, if that works."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 383.08,
      "end_seconds": 384.12,
      "duration_seconds": 1.04,
      "text": "that's fine"
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 387.61,
      "end_seconds": 409.26,
      "duration_seconds": 21.65,
      "text": "I'm going to order an early pregnancy scan, for bleeding in early pregnancy. Use pads rather than tampons and avoid intercourse until the scan. We'll refer you to the early pregnancy unit. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 410.14,
      "end_seconds": 413.85,
      "duration_seconds": 3.71,
      "text": "Yes, I'll bear that in mind."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 414.7,
      "end_seconds": 430.47,
      "duration_seconds": 15.77,
      "text": "The thing that would worry me is if the bleeding becomes heavy or the pain becomes severe or one-sided. If that happens, go to emergency. I'd like you back after the scan. Have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 431.47,
      "end_seconds": 435.04,
      "duration_seconds": 3.57,
      "text": "I mean, thank you, that's helpful"
    }
  ]
}