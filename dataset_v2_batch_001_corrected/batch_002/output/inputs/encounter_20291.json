      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 198.75,
      "end_seconds": 201.16,
      "duration_seconds": 2.41,
      "text": "any trouble with the waterworks?"
