      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 234.14,
      "end_seconds": 238.32,
      "duration_seconds": 4.18,
      "text": "I take alendronate 70 milligrams once a week"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 240.39,
      "end_seconds": 243.05,
      "duration_seconds": 2.66,
      "text": "Have you had any previous surgeries?"
