      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 202.04,
      "end_seconds": 204.67,
      "duration_seconds": 2.63,
      "text": "actually, no, that's all fine"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 216.4,
      "end_seconds": 220.99,
      "duration_seconds": 4.59,
      "text": "Are you taking anything regularly, including from the the pharmacy?"
