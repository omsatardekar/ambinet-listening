      "text": "Losartan i take it 50 milligrams, once a day work has been very busy so I kept ignoring it"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 232.26,
      "end_seconds": 233.36,
      "duration_seconds": 1.1,
      "text": "Right, right."
