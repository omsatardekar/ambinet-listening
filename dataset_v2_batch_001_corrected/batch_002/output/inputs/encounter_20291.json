      "role": "DOCTOR",
      "start_seconds": 8.21,
      "end_seconds": 11.34,
      "duration_seconds": 3.13,
      "text": "so so what can I do for you?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 12.67,
      "end_seconds": 15.49,
      "duration_seconds": 2.82,
      "text": "it's It's my heart racing mostly"
