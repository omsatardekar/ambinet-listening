    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 140.95,
      "end_seconds": 147.78,
      "duration_seconds": 6.83,
      "text": "There is a fine tremor of the outstretched hands and the pulse is fast and regular."
    },
