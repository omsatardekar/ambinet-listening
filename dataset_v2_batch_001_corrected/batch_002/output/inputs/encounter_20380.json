{
  "schema_version": "1.0",
  "encounter_id": "20380",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.76,
      "end_seconds": 3.75,
      "duration_seconds": 2.99,
      "text": "Morning, doctor. Lovely to meet you."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.8,
      "end_seconds": 9.7,
      "duration_seconds": 3.9,
      "text": "That's fine, sit down. Tell me why you came."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 10.64,
      "end_seconds": 15.09,
      "duration_seconds": 4.45,
      "text": "I wanted to get loud snoring looked at."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 20.03,
      "end_seconds": 22.0,
      "duration_seconds": 1.97,
      "text": "Did it come on recently?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 22.76,
      "end_seconds": 25.9,
      "duration_seconds": 3.14,
      "text": "I've had it for two months."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 27.53,
      "end_seconds": 29.51,
      "duration_seconds": 1.98,
      "text": "Does anything set it off?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 30.52,
      "end_seconds": 35.56,
      "duration_seconds": 5.04,
      "text": "I notice it more with lying on my back."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 36.49,
      "end_seconds": 39.55,
      "duration_seconds": 3.06,
      "text": "Have you noticed anything else alongside it?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 40.2,
      "end_seconds": 45.03,
      "duration_seconds": 4.83,
      "text": "It usually comes with a dry mouth in the morning."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 52.99,
      "end_seconds": 56.53,
      "duration_seconds": 3.54,
      "text": "Let me get the readings out of the way."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 63.39,
      "end_seconds": 65.33,
      "duration_seconds": 1.94,
      "text": "Nearly done with the readings..."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 87.19,
      "end_seconds": 96.37,
      "duration_seconds": 9.18,
      "text": "Okay: respiratory rate 18, SpO2 98 percent on room air. And heart rate 76, temperature 36.8, blood pressure 172 over 88."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 97.72,
      "end_seconds": 103.77,
      "duration_seconds": 6.05,
      "text": "Alright, I'll need to examine you for this, it won't take long."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 105.2,
      "end_seconds": 107.38,
      "duration_seconds": 2.18,
      "text": "I'm just checking this side."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 121.24,
      "end_seconds": 126.64,
      "duration_seconds": 5.4,
      "text": "Your neck is thick and the back of the throat looks crowded."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 130.24,
      "end_seconds": 132.62,
      "duration_seconds": 2.38,
      "text": "Okay, all finished, thank you."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 140.92,
      "end_seconds": 147.23,
      "duration_seconds": 6.31,
      "text": "Let me check a few things. Any chest pain, low mood or leg swelling?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 149.26,
      "end_seconds": 153.07,
      "duration_seconds": 3.81,
      "text": "No, um, none of those at all."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 153.98,
      "end_seconds": 156.71,
      "duration_seconds": 2.73,
      "text": "Any muscle or joint problems besides this?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 158.7,
      "end_seconds": 160.89,
      "duration_seconds": 2.19,
      "text": "No, joints are fine."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 161.8,
      "end_seconds": 166.13,
      "duration_seconds": 4.33,
      "text": "Alright, anything with your heart, like skipped beats or fainting?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 167.32,
      "end_seconds": 168.85,
      "duration_seconds": 1.53,
      "text": "Nothing like that."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 173.8,
      "end_seconds": 176.28,
      "duration_seconds": 2.48,
      "text": "Do you have any chronic illnesses?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 178.05,
      "end_seconds": 183.02,
      "duration_seconds": 4.97,
      "text": "I've had high blood pressure for five years now."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 184.66,
      "end_seconds": 195.18,
      "duration_seconds": 10.52,
      "text": "Alright, high blood pressure, that matches what I have here. Has anything ever caused you a reaction? I mean any allergies."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 195.91,
      "end_seconds": 198.85,
      "duration_seconds": 2.94,
      "text": "No, not that I know of."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 199.68,
      "end_seconds": 203.62,
      "duration_seconds": 3.94,
      "text": "Are you taking anything regularly, including from the pharmacy?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 204.74,
      "end_seconds": 208.96,
      "duration_seconds": 4.22,
      "text": "Ramipril. I take it 5 milligrams, every morning."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 210.68,
      "end_seconds": 213.4,
      "duration_seconds": 2.72,
      "text": "Do you work outside the home?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 214.07,
      "end_seconds": 218.61,
      "duration_seconds": 4.54,
      "text": "I'm a hairdresser, on my feet all day."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 220.29,
      "end_seconds": 222.5,
      "duration_seconds": 2.21,
      "text": "Do you get out much?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 224.01,
      "end_seconds": 227.85,
      "duration_seconds": 3.84,
      "text": "Not much, I mostly stay in these days."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 229.55,
      "end_seconds": 233.08,
      "duration_seconds": 3.53,
      "text": "What does a normal day of food look like?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 234.18,
      "end_seconds": 237.5,
      "duration_seconds": 3.32,
      "text": "Lots of rice, lentils and some fruit."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 252.97,
      "end_seconds": 254.42,
      "duration_seconds": 1.45,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 255.66,
      "end_seconds": 258.75,
      "duration_seconds": 3.09,
      "text": "No, I've never been operated on."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 260.06,
      "end_seconds": 266.95,
      "duration_seconds": 6.89,
      "text": "So where does that leave us? This looks most like symptoms that suggest obstructive sleep apnoea."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 267.72,
      "end_seconds": 269.18,
      "duration_seconds": 1.46,
      "text": "Is this permanent?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 271.13,
      "end_seconds": 284.53,
      "duration_seconds": 13.4,
      "text": "I understand the worry. At the moment I'd say it's symptoms that suggest obstructive sleep apnoea, and we'll know more once the an overnight sleep study is back."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 299.24,
      "end_seconds": 304.18,
      "duration_seconds": 4.94,
      "text": "I want an overnight sleep study done, that's for suspected sleep apnoea."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 305.5,
      "end_seconds": 308.63,
      "duration_seconds": 3.13,
      "text": "Okay, um, I'll do it."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 310.48,
      "end_seconds": 341.69,
      "duration_seconds": 31.21,
      "text": "Try to sleep on your side and avoid alcohol close to bedtime. I'll also refer you to the sleep clinic. I'm not ordering a thyroid test today. If things carry on next month, we'll consider it. One warning sign to remember: you feel sleepy while driving. In that case don't wait. I'd like to see you again in six weeks. Anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 343.39,
      "end_seconds": 345.48,
      "duration_seconds": 2.09,
      "text": "Thank you, doctor, goodbye."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 346.12,
      "end_seconds": 347.84,
      "duration_seconds": 1.72,
      "text": "Have a good day."
    }
  ]
}