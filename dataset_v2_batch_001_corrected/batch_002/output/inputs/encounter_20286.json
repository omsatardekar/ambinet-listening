{
  "schema_version": "1.0",
  "encounter_id": "20286",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.72,
      "end_seconds": 4.17,
      "duration_seconds": 3.45,
      "text": "Morning, doctor. Is this the right room?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.57,
      "end_seconds": 9.94,
      "duration_seconds": 4.37,
      "text": "Come in. Please sit. How can I help you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 10.56,
      "end_seconds": 14.95,
      "duration_seconds": 4.39,
      "text": "I'm here because of small blisters in a band"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 16.72,
      "end_seconds": 20.88,
      "duration_seconds": 4.16,
      "text": "Are you taking anything regularly, including from the the pharmacy?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 22.05,
      "end_seconds": 26.06,
      "duration_seconds": 4.01,
      "text": "Amlodipine, once a day for my pressure."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 27.77,
      "end_seconds": 29.77,
      "duration_seconds": 2.0,
      "text": "how much do you take?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 31.41,
      "end_seconds": 35.78,
      "duration_seconds": 4.37,
      "text": "5 milligrams, I think that's what's on the box"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 37.51,
      "end_seconds": 41.46,
      "duration_seconds": 3.95,
      "text": "How many days or weeks has it been?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 43.14,
      "end_seconds": 47.02,
      "duration_seconds": 3.88,
      "text": "Since last weekend, that's when it began."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 48.28,
      "end_seconds": 51.27,
      "duration_seconds": 2.99,
      "text": "Have you noticed anything else alongside it?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 51.85,
      "end_seconds": 75.34,
      "duration_seconds": 23.49,
      "text": "it usually comes with a painful rash on one side of my chest the painful rash on one side of my chest? That's been since last night as for painful rash on one side of my chest, yes, clothes rubbing that makes it worse"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 76.44,
      "end_seconds": 83.13,
      "duration_seconds": 6.69,
      "text": "right, have you noticed weakness, rash near the eye or rash on the other side?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 84.41,
      "end_seconds": 93.16,
      "duration_seconds": 8.75,
      "text": "I haven't had weakness, rash near the eye or rash on the other side, no"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 94.51,
      "end_seconds": 96.97,
      "duration_seconds": 2.46,
      "text": "Is your chest okay generally?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 98.62,
      "end_seconds": 100.5,
      "duration_seconds": 1.88,
      "text": "No problems with breathing."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 112.06,
      "end_seconds": 116.4,
      "duration_seconds": 4.34,
      "text": "Are you allergic to anything? Any allergies to medicines or foods?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 117.47,
      "end_seconds": 121.78,
      "duration_seconds": 4.31,
      "text": "Erythromycin. I come out in... well, bad stomach cramps."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 140.61,
      "end_seconds": 143.16,
      "duration_seconds": 2.55,
      "text": "Have you ever had an operation?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 144.0,
      "end_seconds": 149.46,
      "duration_seconds": 5.46,
      "text": "I had a mole taken off my arm a few years ago."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 151.5,
      "end_seconds": 156.49,
      "duration_seconds": 4.99,
      "text": "Okay, what conditions have you been treated for in the past?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 157.57,
      "end_seconds": 160.15,
      "duration_seconds": 2.58,
      "text": "I've got high blood pressure."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 160.83,
      "end_seconds": 163.17,
      "duration_seconds": 2.34,
      "text": "I follow. Are you active?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 164.42,
      "end_seconds": 167.49,
      "duration_seconds": 3.07,
      "text": "I walk the dog every morning."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 171.87,
      "end_seconds": 174.87,
      "duration_seconds": 3.0,
      "text": "are you in work at the moment?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 175.69,
      "end_seconds": 180.3,
      "duration_seconds": 4.61,
      "text": "Yes, I work in a bakery, early starts."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 185.4,
      "end_seconds": 189.2,
      "duration_seconds": 3.8,
      "text": "What does a normal day of food look like?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 190.72,
      "end_seconds": 194.56,
      "duration_seconds": 3.84,
      "text": "Lots of rice, lentils and some fruit."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 196.51,
      "end_seconds": 199.13,
      "duration_seconds": 2.62,
      "text": "Let me take your readings now."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 206.76,
      "end_seconds": 209.36,
      "duration_seconds": 2.6,
      "text": "that's it, just a little longer.."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 230.2,
      "end_seconds": 239.04,
      "duration_seconds": 8.84,
      "text": "okay: pulse is 103 beats a minute, blood pressure 126 over 70, respiratory rate 21, oxygen saturation is 97 percent"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 239.84,
      "end_seconds": 241.79,
      "duration_seconds": 1.95,
      "text": "is that alright, doctor?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 243.37,
      "end_seconds": 246.22,
      "duration_seconds": 2.85,
      "text": "I'll come back to the numbers."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 248.38,
      "end_seconds": 253.19,
      "duration_seconds": 4.81,
      "text": "I'll need to examine you for this, it won't take long."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 254.9,
      "end_seconds": 257.52,
      "duration_seconds": 2.62,
      "text": "Take a deep breath for me."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 268.0,
      "end_seconds": 279.12,
      "duration_seconds": 11.12,
      "text": "There are clustered blisters on a red base in a band across the the right side of the chest, not crossing the midline."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 283.66,
      "end_seconds": 285.61,
      "duration_seconds": 1.95,
      "text": "please sit back down"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 295.57,
      "end_seconds": 301.81,
      "duration_seconds": 6.24,
      "text": "I think a swab from a blister makes sense here, for vesicular rash"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 303.27,
      "end_seconds": 307.2,
      "duration_seconds": 3.93,
      "text": "I can book that for Friday at 10 am."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 309.04,
      "end_seconds": 309.97,
      "duration_seconds": 0.93,
      "text": "that's fine"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 310.5,
      "end_seconds": 319.4,
      "duration_seconds": 8.9,
      "text": "I'd like you to take aciclovir, 800 milligrams, five times a day, for seven days that that should help with shingles"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 321.13,
      "end_seconds": 323.59,
      "duration_seconds": 2.46,
      "text": "How soon will it work?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 325.18,
      "end_seconds": 350.08,
      "duration_seconds": 24.9,
      "text": "keep the rash clean and dry and avoid contact with pregnant women or newborns until the blisters crust over. The thing that would worry me is if the rash spreads to the eye or face. If that happens, go to emergency. Please come and see me in one week. That's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 351.18,
      "end_seconds": 354.06,
      "duration_seconds": 2.88,
      "text": "oh, thank you, that's helpful"
    }
  ]
}