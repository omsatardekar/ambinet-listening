{
  "schema_version": "1.0",
  "encounter_id": "20237",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.75,
      "end_seconds": 4.77,
      "duration_seconds": 4.02,
      "text": "Hi, doctor, I hope I'm not disturbing you."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.85,
      "end_seconds": 10.54,
      "duration_seconds": 3.69,
      "text": "No problem at all, come in. What's troubling you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 12.28,
      "end_seconds": 15.74,
      "duration_seconds": 3.46,
      "text": "It's a mole that has changed, mostly."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 16.91,
      "end_seconds": 20.07,
      "duration_seconds": 3.16,
      "text": "When was the first time you noticed it?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 23.19,
      "end_seconds": 34.93,
      "duration_seconds": 11.74,
      "text": "It's been three weeks, I'm fairly sure. I'm hoping you can tell me something definite. Oh, and a crusty edge on the mole."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 52.47,
      "end_seconds": 58.07,
      "duration_seconds": 5.6,
      "text": "Tell me about your routine, work, habits, that sort of thing."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 59.32,
      "end_seconds": 71.38,
      "duration_seconds": 12.06,
      "text": "I'm a bus driver, so I sit for long hours. Lots of rice, lentils and some fruit. No, I share a house with my brother."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 89.78,
      "end_seconds": 97.35,
      "duration_seconds": 7.57,
      "text": "So, do you have any medical conditions I should know about? Just so I get the full picture."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 98.09,
      "end_seconds": 100.47,
      "duration_seconds": 2.38,
      "text": "No, nothing at all."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 106.13,
      "end_seconds": 108.16,
      "duration_seconds": 2.03,
      "text": "Any regular medication at all?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 110.33,
      "end_seconds": 112.11,
      "duration_seconds": 1.78,
      "text": "Nothing regular, no."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 119.24,
      "end_seconds": 125.66,
      "duration_seconds": 6.42,
      "text": "alright, and what about night sweats, other new moles, pain or lumps in the armpit?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 126.64,
      "end_seconds": 129.1,
      "duration_seconds": 2.46,
      "text": "No, I'd have said so."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 129.64,
      "end_seconds": 132.61,
      "duration_seconds": 2.97,
      "text": "Has your heart given you any trouble?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 134.24,
      "end_seconds": 136.72,
      "duration_seconds": 2.48,
      "text": "No, nothing with my heart."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 138.34,
      "end_seconds": 140.46,
      "duration_seconds": 2.12,
      "text": "anything unusual with passing urine?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 141.46,
      "end_seconds": 143.03,
      "duration_seconds": 1.57,
      "text": "no changes there"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 144.47,
      "end_seconds": 147.43,
      "duration_seconds": 2.96,
      "text": "Let's start with the basic checks."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 156.52,
      "end_seconds": 159.18,
      "duration_seconds": 2.66,
      "text": "Bear with me while this finishes..."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 169.83,
      "end_seconds": 174.14,
      "duration_seconds": 4.31,
      "text": "Okay: saturation 98 percent, pulse 66, pressure 124 over 78."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 176.28,
      "end_seconds": 179.47,
      "duration_seconds": 3.19,
      "text": "Okay, time for me to examine you."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 194.54,
      "end_seconds": 196.11,
      "duration_seconds": 1.57,
      "text": "Yes, that's fine."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 198.06,
      "end_seconds": 200.21,
      "duration_seconds": 2.15,
      "text": "raise your arm for me"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 215.32,
      "end_seconds": 223.46,
      "duration_seconds": 8.14,
      "text": "there is a dark, six-millimetre mole with an irregular border and two shades of brown on the upper back"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 226.63,
      "end_seconds": 236.81,
      "duration_seconds": 10.18,
      "text": "You can relax now. So, based on the history and the examination, this is probably a pigmented lesion that needs removal for a proper diagnosis."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 238.22,
      "end_seconds": 240.28,
      "duration_seconds": 2.06,
      "text": "Is this serious, doctor?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 241.68,
      "end_seconds": 256.01,
      "duration_seconds": 14.33,
      "text": "I can't promise yet, but most people with a pigmented lesion that needs removal for a proper diagnosis do well once it's treated properly. I think a skin biopsy makes sense here, for changing mole."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 257.05,
      "end_seconds": 258.08,
      "duration_seconds": 1.03,
      "text": "Right, understood."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 259.49,
      "end_seconds": 263.51,
      "duration_seconds": 4.02,
      "text": "A dermoscopy is what I'd like next, for changing mole."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 265.23,
      "end_seconds": 267.96,
      "duration_seconds": 2.73,
      "text": "when would that take place?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 268.86,
      "end_seconds": 287.17,
      "duration_seconds": 18.31,
      "text": "Cover up and use factor 50 sunscreen on exposed skin. A short walk every day, even twenty minutes, will help more than you'd think. Come back or go to emergency straight away if the mole bleeds or grows quickly."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 287.94,
      "end_seconds": 289.47,
      "duration_seconds": 1.53,
      "text": "Yes, will do."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 291.18,
      "end_seconds": 297.95,
      "duration_seconds": 6.77,
      "text": "Let's plan a check after the biopsy results. Anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 299.54,
      "end_seconds": 301.09,
      "duration_seconds": 1.55,
      "text": "that's clear, thanks"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 302.59,
      "end_seconds": 303.94,
      "duration_seconds": 1.35,
      "text": "All the best."
    }
  ]
}