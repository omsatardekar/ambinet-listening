{
  "schema_version": "1.0",
  "encounter_id": "20344",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.26,
      "end_seconds": 5.54,
      "duration_seconds": 4.28,
      "text": "Hello, um, doctor. I think it's my turn."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.7,
      "end_seconds": 11.73,
      "duration_seconds": 5.03,
      "text": "Okay, that's fine, sit down. Tell me why you came."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 13.62,
      "end_seconds": 18.53,
      "duration_seconds": 4.91,
      "text": "Morning, doctor. I'll stay and fill in anything that's missed."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 19.88,
      "end_seconds": 22.57,
      "duration_seconds": 2.69,
      "text": "absolutely, come and sit beside them"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 24.5,
      "end_seconds": 30.86,
      "duration_seconds": 6.36,
      "text": "It's a twisted ankle, doctor. She didn't want to come, but I insisted."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 31.72,
      "end_seconds": 33.18,
      "duration_seconds": 1.46,
      "text": "Since when exactly?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 33.83,
      "end_seconds": 39.38,
      "duration_seconds": 5.55,
      "text": "Three days, I think... sorry, ten days, I got that wrong."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 40.69,
      "end_seconds": 42.51,
      "duration_seconds": 1.82,
      "text": "Anything that improves it?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 43.96,
      "end_seconds": 69.5,
      "duration_seconds": 25.54,
      "text": "Only elevation, and it's not much. Well, I've had swelling around the ankle too, for about two weeks. I've had pain walking too, for about two weeks. With pain walking, mostly moderate. Sorry, what was I saying, I've also had bruising, for about four days."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 80.95,
      "end_seconds": 85.0,
      "duration_seconds": 4.05,
      "text": "Tell me about any past illnesses or ongoing conditions."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 86.52,
      "end_seconds": 90.21,
      "duration_seconds": 3.69,
      "text": "High blood pressure, for about a year."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 90.97,
      "end_seconds": 91.9,
      "duration_seconds": 0.93,
      "text": "right, right"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 93.41,
      "end_seconds": 94.65,
      "duration_seconds": 1.24,
      "text": "yes, anxiety"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 96.0,
      "end_seconds": 99.5,
      "duration_seconds": 3.5,
      "text": "right, and anything else to to add?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 100.7,
      "end_seconds": 109.33,
      "duration_seconds": 8.63,
      "text": "Okay, I can see high blood pressure in your file as well. What about your parents, brothers or sisters, any conditions?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 109.93,
      "end_seconds": 114.92,
      "duration_seconds": 4.99,
      "text": "my father has Parkinson's disease my father had bowel cancer"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 124.82,
      "end_seconds": 127.47,
      "duration_seconds": 2.65,
      "text": "have you got any known allergies?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 129.2,
      "end_seconds": 132.69,
      "duration_seconds": 3.49,
      "text": "no, nothing as far as I know"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 133.36,
      "end_seconds": 140.92,
      "duration_seconds": 7.56,
      "text": "Actually, I'm not sure that's right. I seem to recall a problem with naproxen."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 142.4,
      "end_seconds": 144.27,
      "duration_seconds": 1.87,
      "text": "I don't remember that."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 145.34,
      "end_seconds": 152.75,
      "duration_seconds": 7.41,
      "text": "Alright, so that's unclear. I'll record what each of you said. Anything surgical in your history?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 153.38,
      "end_seconds": 158.25,
      "duration_seconds": 4.87,
      "text": "Yes, I had my septum straightened, in my thirties."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 159.9,
      "end_seconds": 164.06,
      "duration_seconds": 4.16,
      "text": "Can you list what you take, tablets, creams or inhalers?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 167.72,
      "end_seconds": 175.26,
      "duration_seconds": 7.54,
      "text": "Hydrochlorothiazide, 12.5 milligrams, every morning. Escitalopram, 10 milligrams, once a day for the anxiety."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 177.1,
      "end_seconds": 179.98,
      "duration_seconds": 2.88,
      "text": "How long have you taken that?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 181.04,
      "end_seconds": 186.59,
      "duration_seconds": 5.55,
      "text": "For about three months. It's ibuprofen, 400 milligrams, when needed."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 188.64,
      "end_seconds": 199.0,
      "duration_seconds": 10.36,
      "text": "yeah, doctor, I think the last prescription for the the ibuprofen was 200 milligrams we changed it at the last visit"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 200.03,
      "end_seconds": 203.73,
      "duration_seconds": 3.7,
      "text": "I see. Is the most recent prescription on you?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 205.05,
      "end_seconds": 207.98,
      "duration_seconds": 2.93,
      "text": "No, I left it at home."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 208.71,
      "end_seconds": 212.09,
      "duration_seconds": 3.38,
      "text": "Are you in work at the the moment?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 213.44,
      "end_seconds": 217.34,
      "duration_seconds": 3.9,
      "text": "Yes, I work in a bakery, early starts."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 221.77,
      "end_seconds": 223.73,
      "duration_seconds": 1.96,
      "text": "Who lives with you?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 224.9,
      "end_seconds": 227.28,
      "duration_seconds": 2.38,
      "text": "My partner and our baby"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 227.91,
      "end_seconds": 232.82,
      "duration_seconds": 4.91,
      "text": "have you had numbness in the foot, by any chance?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 233.66,
      "end_seconds": 236.74,
      "duration_seconds": 3.08,
      "text": "nope, no numbness in the foot"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 239.47,
      "end_seconds": 248.5,
      "duration_seconds": 9.03,
      "text": "Have you noticed knee pain, previous fracture, cracking sound at the time or pain at the base of the fifth toe?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 249.54,
      "end_seconds": 253.03,
      "duration_seconds": 3.49,
      "text": "No, I haven't had any of them."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 258.69,
      "end_seconds": 261.87,
      "duration_seconds": 3.18,
      "text": "has your heart given you any trouble?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 263.93,
      "end_seconds": 265.89,
      "duration_seconds": 1.96,
      "text": "No, that's been fine."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 267.32,
      "end_seconds": 268.87,
      "duration_seconds": 1.55,
      "text": "Neurologically, anything strange?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 270.63,
      "end_seconds": 272.07,
      "duration_seconds": 1.44,
      "text": "Nothing odd there."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 273.84,
      "end_seconds": 277.12,
      "duration_seconds": 3.28,
      "text": "I'll note down your vital signs first."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 283.77,
      "end_seconds": 287.05,
      "duration_seconds": 3.28,
      "text": "okay, keep your arm relaxed for me.."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 300.8,
      "end_seconds": 308.46,
      "duration_seconds": 7.66,
      "text": "okay: heart rate 69, temperature 36.7. And BP is 120 over 68, respiratory rate 15."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 309.3,
      "end_seconds": 311.12,
      "duration_seconds": 1.82,
      "text": "is that that okay?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 311.98,
      "end_seconds": 314.36,
      "duration_seconds": 2.38,
      "text": "We'll go over that shortly."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 317.24,
      "end_seconds": 319.22,
      "duration_seconds": 1.98,
      "text": "shall I start the examination?"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 320.69,
      "end_seconds": 323.35,
      "duration_seconds": 2.66,
      "text": "Take a deep breath for me."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 333.57,
      "end_seconds": 344.69,
      "duration_seconds": 11.12,
      "text": "There is swelling and bruising over the outer ankle and I can't find any bony tenderness at the back of the ankle bone."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 349.98,
      "end_seconds": 351.59,
      "duration_seconds": 1.61,
      "text": "That's the examination finished."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 366.18,
      "end_seconds": 377.41,
      "duration_seconds": 11.23,
      "text": "just to be sure I understood you've had a twisted ankle for ten days, and no cracking sound at the time or numbness in the foot"
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 379.37,
      "end_seconds": 381.03,
      "duration_seconds": 1.66,
      "text": "Yes, that's right."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 382.89,
      "end_seconds": 412.16,
      "duration_seconds": 29.27,
      "text": "let's get an ankle X-ray, for ankle injury. You'll be taking paracetamol, 1 gram, every six hours if needed, for five days. That's for ankle pain. Rest, ice, a firm bandage and keep it raised, and start gentle movement after two days. I'm going to send a referral to physiotherapy. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose"
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 414.01,
      "end_seconds": 430.93,
      "duration_seconds": 16.92,
      "text": "Please don't wait if you cannot put any weight on it or the foot goes numb. That's when to be seen urgently. I'd like you back if it isn't better in a week. Have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 435.3,
      "end_seconds": 438.24,
      "duration_seconds": 2.94,
      "text": "Thank you, uh, doctor, goodbye."
    }
  ]
}