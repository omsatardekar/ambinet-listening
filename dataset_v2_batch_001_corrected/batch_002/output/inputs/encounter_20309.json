{
  "schema_version": "1.0",
  "encounter_id": "20309",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.32,
      "end_seconds": 8.0,
      "duration_seconds": 6.68,
      "text": "Hello doctor, sorry, I took a wrong turn on the way here."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 9.77,
      "end_seconds": 14.14,
      "duration_seconds": 4.37,
      "text": "come in please sit how can I help you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 15.9,
      "end_seconds": 22.29,
      "duration_seconds": 6.39,
      "text": "Hello, doctor. I hope it's alright if I stay in for this."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 23.86,
      "end_seconds": 26.88,
      "duration_seconds": 3.02,
      "text": "please do. Extra information is always welcome"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 28.75,
      "end_seconds": 36.03,
      "duration_seconds": 7.28,
      "text": "Doctor, you know, it's headaches in the morning. That's what we're worried about."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 36.97,
      "end_seconds": 38.34,
      "duration_seconds": 1.37,
      "text": "Since when exactly?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 40.29,
      "end_seconds": 42.98,
      "duration_seconds": 2.69,
      "text": "about... well, about a month"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 43.62,
      "end_seconds": 52.09,
      "duration_seconds": 8.47,
      "text": "Tell me a bit more about it: how bad it gets, how often, and whether anything makes it better or worse."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 54.09,
      "end_seconds": 78.15,
      "duration_seconds": 24.06,
      "text": "Maybe a six out of ten on a bad day. I get some relief from lying down. I looked a few things up online, uh, and that probably didn't help. Oh, um, and blurred vision at times. So, there's nosebleeds as well."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 79.45,
      "end_seconds": 83.22,
      "duration_seconds": 3.77,
      "text": "Have you had any ankle swelling or chest pain?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 84.0,
      "end_seconds": 87.63,
      "duration_seconds": 3.63,
      "text": "no, I haven't had any of them"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 88.24,
      "end_seconds": 96.35,
      "duration_seconds": 8.11,
      "text": "Have you had any passing less urine, weakness on one side, shortness of breath or slurred speech?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 97.58,
      "end_seconds": 107.89,
      "duration_seconds": 10.31,
      "text": "Hmm, no passing less urine, weakness on one side, shortness of breath or slurred speech, none of it."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 109.19,
      "end_seconds": 111.96,
      "duration_seconds": 2.77,
      "text": "Is your urine normal, no changes?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 113.63,
      "end_seconds": 117.08,
      "duration_seconds": 3.45,
      "text": "That's normal as far as I know."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 117.84,
      "end_seconds": 120.43,
      "duration_seconds": 2.59,
      "text": "Your breathing, any trouble there?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 121.72,
      "end_seconds": 122.79,
      "duration_seconds": 1.07,
      "text": "Breathing's normal."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 139.59,
      "end_seconds": 142.84,
      "duration_seconds": 3.25,
      "text": "what do you take on a normal day?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 143.67,
      "end_seconds": 153.98,
      "duration_seconds": 10.31,
      "text": "Simvastatin. I take it 20 milligrams, at night. Telmisartan, 40 milligrams, maybe, once a day for my pressure."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 156.05,
      "end_seconds": 160.64,
      "duration_seconds": 4.59,
      "text": "Do you have the packet or the prescription with you?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 161.51,
      "end_seconds": 172.61,
      "duration_seconds": 11.1,
      "text": "Erm, um, not with me. I'll bring it next time. I take gliclazide, 80 milligrams, twice a day."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 172.95,
      "end_seconds": 173.99,
      "duration_seconds": 1.04,
      "text": "mm, okay"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 192.23,
      "end_seconds": 195.89,
      "duration_seconds": 3.66,
      "text": "Are there any allergies I should be aware of?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 196.97,
      "end_seconds": 207.29,
      "duration_seconds": 10.32,
      "text": "I, I think I reacted to some antibiotic once, years ago i don't remember which one, or what happened exactly"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 209.76,
      "end_seconds": 212.65,
      "duration_seconds": 2.89,
      "text": "Does your family have any medical conditions?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 216.81,
      "end_seconds": 222.57,
      "duration_seconds": 5.76,
      "text": "My father had bowel cancer. Oh, my brother has epilepsy."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 223.24,
      "end_seconds": 226.45,
      "duration_seconds": 3.21,
      "text": "A few questions about your lifestyle now."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 228.51,
      "end_seconds": 240.42,
      "duration_seconds": 11.91,
      "text": "Not much, I mostly stay in these days. I'm vegetarian and have been for years. I live with my elderly mother."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 242.2,
      "end_seconds": 247.09,
      "duration_seconds": 4.89,
      "text": "What conditions have you been treated for in the past?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 248.53,
      "end_seconds": 253.86,
      "duration_seconds": 5.33,
      "text": "well, I have high cholesterol, for about a year"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 255.96,
      "end_seconds": 256.94,
      "duration_seconds": 0.98,
      "text": "Hm, okay."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 258.89,
      "end_seconds": 265.91,
      "duration_seconds": 7.02,
      "text": "Let me think, I've had high blood pressure for nearly five years now."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 266.81,
      "end_seconds": 267.51,
      "duration_seconds": 0.7,
      "text": "Understood."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 268.72,
      "end_seconds": 272.8,
      "duration_seconds": 4.08,
      "text": "I've had diabetes for nearly five years now."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 273.57,
      "end_seconds": 274.95,
      "duration_seconds": 1.38,
      "text": "Is that everything?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 275.46,
      "end_seconds": 282.5,
      "duration_seconds": 7.04,
      "text": "Alright, high cholesterol and diabetes, that matches what I have here. Any previous surgeries?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 284.75,
      "end_seconds": 285.97,
      "duration_seconds": 1.22,
      "text": "no, never"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 286.5,
      "end_seconds": 289.65,
      "duration_seconds": 3.15,
      "text": "Shall I check your blood pressure and pulse?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 301.07,
      "end_seconds": 303.57,
      "duration_seconds": 2.5,
      "text": "Okay, this won't take long..."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 325.13,
      "end_seconds": 332.93,
      "duration_seconds": 7.8,
      "text": "Okay: respiratory rate 18, oxygen saturation is 98 percent, pressure 167 over 104, pulse is 80 beats a minute."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 335.83,
      "end_seconds": 339.62,
      "duration_seconds": 3.79,
      "text": "Right, let's have a a proper look at you."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 340.44,
      "end_seconds": 341.44,
      "duration_seconds": 1.0,
      "text": "Of course."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 342.87,
      "end_seconds": 344.06,
      "duration_seconds": 1.19,
      "text": "Breathe out slowly."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 357.69,
      "end_seconds": 363.47,
      "duration_seconds": 5.78,
      "text": "The back of your eyes looks fine and your heart sounds are normal."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 365.39,
      "end_seconds": 366.39,
      "duration_seconds": 1.0,
      "text": "Sure thing."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 370.07,
      "end_seconds": 372.15,
      "duration_seconds": 2.08,
      "text": "You can sit up now."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 386.66,
      "end_seconds": 399.3,
      "duration_seconds": 12.64,
      "text": "Taking everything into account, it's hard to say. Poorly controlled high blood pressure is one possibility and a side effect of a medicine another, and I'd rather not commit yet."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 402.54,
      "end_seconds": 405.61,
      "duration_seconds": 3.07,
      "text": "Do you think it's something serious?"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 407.15,
      "end_seconds": 429.15,
      "duration_seconds": 22.0,
      "text": "I can't promise yet, but most people with poorly controlled high blood pressure do well once it's treated properly. Let me repeat that back to make sure. You've had headaches in the morning for about a month, and no weakness on one side or chest pain."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 431.86,
      "end_seconds": 433.75,
      "duration_seconds": 1.89,
      "text": "Mm, that's right."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 434.91,
      "end_seconds": 469.15,
      "duration_seconds": 34.24,
      "text": "Let's book a urine test to look into hypertension. I'll request blood tests, it'll help with hypertension. We'll begin with amlodipine, 5 milligrams, once a day, long term. That's for high blood pressure. Check your blood pressure at home twice a day for a week and bring the readings. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 470.23,
      "end_seconds": 480.35,
      "duration_seconds": 10.12,
      "text": "Thank you, you know, that's clear. Can you send me for a home blood pressure diary?"
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 484.71,
      "end_seconds": 493.14,
      "duration_seconds": 8.43,
      "text": "not right now, it wouldn't change what we do today let's plan a check in two weeks"
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 494.99,
      "end_seconds": 495.69,
      "duration_seconds": 0.7,
      "text": "sure"
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 500.66,
      "end_seconds": 503.82,
      "duration_seconds": 3.16,
      "text": "So, does all of that make sense?"
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 505.88,
      "end_seconds": 507.52,
      "duration_seconds": 1.64,
      "text": "That's clear, thanks."
    }
  ]
}