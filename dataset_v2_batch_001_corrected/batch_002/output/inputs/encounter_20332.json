{
  "schema_version": "1.0",
  "encounter_id": "20332",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 0.75,
      "end_seconds": 7.05,
      "duration_seconds": 6.3,
      "text": "Okay, doctor, we're all set in here. I'll give you the numbers when you want them."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.87,
      "end_seconds": 12.86,
      "duration_seconds": 4.99,
      "text": "Right, good, thank you. Welcome, tell me what's brought you in."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 13.75,
      "end_seconds": 22.98,
      "duration_seconds": 9.23,
      "text": "Hmm, mainly my heart racing. There's a couple of other things, but that's the main one."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 23.68,
      "end_seconds": 26.71,
      "duration_seconds": 3.03,
      "text": "What's the timeline, when did it begin?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 28.1,
      "end_seconds": 38.48,
      "duration_seconds": 10.38,
      "text": "Let me think, um, it's been two months now. I've been reading about it online and it worried me."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 39.58,
      "end_seconds": 41.84,
      "duration_seconds": 2.26,
      "text": "How frequently does it come?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 43.75,
      "end_seconds": 56.58,
      "duration_seconds": 12.83,
      "text": "Honestly, every other day. I mean, and I've been losing weight despite eating well as well. Oh, and a trembling in my hands."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 57.47,
      "end_seconds": 61.48,
      "duration_seconds": 4.01,
      "text": "Are there any allergies I should be aware of?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 62.58,
      "end_seconds": 66.38,
      "duration_seconds": 3.8,
      "text": "Yes, naproxen. I get stomach pain."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 82.37,
      "end_seconds": 85.52,
      "duration_seconds": 3.15,
      "text": "What operations have you had, if any?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 86.13,
      "end_seconds": 89.78,
      "duration_seconds": 3.65,
      "text": "Just a varicose vein procedure, last year."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 91.01,
      "end_seconds": 94.84,
      "duration_seconds": 3.83,
      "text": "Okay, any health conditions I should have on record?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 95.42,
      "end_seconds": 98.01,
      "duration_seconds": 2.59,
      "text": "I've got high blood pressure."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 99.14,
      "end_seconds": 100.54,
      "duration_seconds": 1.4,
      "text": "Yes, carry on."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 102.23,
      "end_seconds": 105.1,
      "duration_seconds": 2.87,
      "text": "Gout, for about ten years."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 107.06,
      "end_seconds": 112.16,
      "duration_seconds": 5.1,
      "text": "Tell me about your routine, work, habits, that sort of thing."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 113.61,
      "end_seconds": 127.63,
      "duration_seconds": 14.02,
      "text": "I'm a bus driver, so I sit for long hours. No, I share a house with my brother. I walk the dog every morning."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 128.32,
      "end_seconds": 131.9,
      "duration_seconds": 3.58,
      "text": "Which medicines do you take at the moment?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 132.86,
      "end_seconds": 145.31,
      "duration_seconds": 12.45,
      "text": "It's, It's losartan, 50 milligrams, once a day. Febuxostat. I take it 80 milligrams, once a day for the gout."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 155.14,
      "end_seconds": 158.13,
      "duration_seconds": 2.99,
      "text": "Any fainting or neck swelling at all?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 158.97,
      "end_seconds": 161.62,
      "duration_seconds": 2.65,
      "text": "No, not a single one."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 163.58,
      "end_seconds": 167.66,
      "duration_seconds": 4.08,
      "text": "Any chest pain, double vision or eye pain at all?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 168.58,
      "end_seconds": 171.54,
      "duration_seconds": 2.96,
      "text": "No, I'd have said so."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 172.47,
      "end_seconds": 174.5,
      "duration_seconds": 2.03,
      "text": "Is your chest okay generally?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 176.24,
      "end_seconds": 179.17,
      "duration_seconds": 2.93,
      "text": "No, um, nothing there."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 180.7,
      "end_seconds": 182.74,
      "duration_seconds": 2.04,
      "text": "Has your skin been okay?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 184.28,
      "end_seconds": 186.77,
      "duration_seconds": 2.49,
      "text": "No, skin's been fine."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 188.49,
      "end_seconds": 197.32,
      "duration_seconds": 8.83,
      "text": "Okay, so the vitals from earlier. Pulse 121, SpO2 98 percent on room air, BP is 137 over 73."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 198.51,
      "end_seconds": 199.21,
      "duration_seconds": 0.7,
      "text": "Thanks."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 201.18,
      "end_seconds": 204.51,
      "duration_seconds": 3.33,
      "text": "Okay, time for me to examine you."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 205.41,
      "end_seconds": 207.44,
      "duration_seconds": 2.03,
      "text": "Raise your arm for me."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 216.32,
      "end_seconds": 221.36,
      "duration_seconds": 5.04,
      "text": "There is a smooth, small swelling at the front of the neck."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 224.68,
      "end_seconds": 226.57,
      "duration_seconds": 1.89,
      "text": "Please sit back down."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 235.6,
      "end_seconds": 242.55,
      "duration_seconds": 6.95,
      "text": "Okay, thinking it through, it fits best with an overactive thyroid. Anxiety is also on my list."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 244.59,
      "end_seconds": 250.35,
      "duration_seconds": 5.76,
      "text": "Sorry, um, what was I saying, will it clear up?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 251.67,
      "end_seconds": 286.57,
      "duration_seconds": 34.9,
      "text": "I can't promise yet, but most people with an overactive thyroid do well once it's treated properly. I'm going to order an ECG, for palpitations. I'm going to put you on propranolol, 20 milligrams, twice a day, until review. You take it by mouth. It's for racing heart and tremor. The pharmacy will go through the details again when you pick it up. Try to avoid caffeine while we sort this out."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 287.25,
      "end_seconds": 291.97,
      "duration_seconds": 4.72,
      "text": "I'm going to send a referral to the endocrine clinic."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 292.59,
      "end_seconds": 294.51,
      "duration_seconds": 1.92,
      "text": "Alright, thank you."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 296.54,
      "end_seconds": 307.67,
      "duration_seconds": 11.13,
      "text": "Do get help quickly if the symptoms get worse. I'll want another look after the thyroid results. Okay, is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 313.18,
      "end_seconds": 316.2,
      "duration_seconds": 3.02,
      "text": "That's clear, uh, thanks."
    }
  ]
}