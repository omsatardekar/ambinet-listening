{
  "schema_version": "1.0",
  "encounter_id": "20003",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.09,
      "end_seconds": 6.15,
      "duration_seconds": 5.06,
      "text": "Hi, doctor, I came as soon as they called me."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.94,
      "end_seconds": 11.64,
      "duration_seconds": 4.7,
      "text": "Not at all, please sit. What seems to be wrong?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 12.3,
      "end_seconds": 16.48,
      "duration_seconds": 4.18,
      "text": "Mainly I've been feeling low. That's why I came."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 17.2,
      "end_seconds": 19.15,
      "duration_seconds": 1.95,
      "text": "Any regular medication at all?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 19.89,
      "end_seconds": 22.09,
      "duration_seconds": 2.2,
      "text": "No, um, none."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 22.61,
      "end_seconds": 28.79,
      "duration_seconds": 6.18,
      "text": "How long has it been like this? I'm asking so that we don't miss anything."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 31.94,
      "end_seconds": 38.35,
      "duration_seconds": 6.41,
      "text": "Sorry, what was I saying, it's been going on for about a year."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 40.13,
      "end_seconds": 41.72,
      "duration_seconds": 1.59,
      "text": "Anything that improves it?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 42.65,
      "end_seconds": 47.25,
      "duration_seconds": 4.6,
      "text": "It settles a little with talking to a friend."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 48.81,
      "end_seconds": 52.06,
      "duration_seconds": 3.25,
      "text": "Have you been losing interest in things?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 53.24,
      "end_seconds": 55.91,
      "duration_seconds": 2.67,
      "text": "Yes, for about three months."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 63.84,
      "end_seconds": 69.8,
      "duration_seconds": 5.96,
      "text": "A few quick ones: thoughts of harming myself, chest pain or panic attacks?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 71.66,
      "end_seconds": 74.22,
      "duration_seconds": 2.56,
      "text": "No, nothing to report there."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 74.76,
      "end_seconds": 78.63,
      "duration_seconds": 3.87,
      "text": "Have you had drinking more, by any chance?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 80.56,
      "end_seconds": 82.48,
      "duration_seconds": 1.92,
      "text": "Definitely no drinking more."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 84.49,
      "end_seconds": 86.46,
      "duration_seconds": 1.97,
      "text": "Has your skin been okay?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 88.12,
      "end_seconds": 89.03,
      "duration_seconds": 0.91,
      "text": "Skin's normal."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 91.98,
      "end_seconds": 94.81,
      "duration_seconds": 2.83,
      "text": "Before we go further, any allergies?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 95.47,
      "end_seconds": 99.2,
      "duration_seconds": 3.73,
      "text": "I don't think I have any, no."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 113.74,
      "end_seconds": 117.62,
      "duration_seconds": 3.88,
      "text": "Do you have any medical conditions I should know about?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 118.61,
      "end_seconds": 120.56,
      "duration_seconds": 1.95,
      "text": "No, nothing at all."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 121.57,
      "end_seconds": 123.26,
      "duration_seconds": 1.69,
      "text": "Okay, any previous surgeries?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 127.89,
      "end_seconds": 129.87,
      "duration_seconds": 1.98,
      "text": "No, uh, never."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 137.85,
      "end_seconds": 140.98,
      "duration_seconds": 3.13,
      "text": "Are there any illnesses in your family?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 144.19,
      "end_seconds": 146.72,
      "duration_seconds": 2.53,
      "text": "My father has Parkinson's disease."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 161.02,
      "end_seconds": 165.27,
      "duration_seconds": 4.25,
      "text": "Let's talk a little about your daily life and habits."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 166.77,
      "end_seconds": 181.99,
      "duration_seconds": 15.22,
      "text": "I quit smoking around ten years ago. I look after my grandchildren most days. Not much, I mostly stay in these days. Lots of rice, lentils and some fruit."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 182.56,
      "end_seconds": 185.07,
      "duration_seconds": 2.51,
      "text": "Let me quickly check your readings."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 197.63,
      "end_seconds": 200.17,
      "duration_seconds": 2.54,
      "text": "Okay, this won't take long..."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 214.99,
      "end_seconds": 225.14,
      "duration_seconds": 10.15,
      "text": "Okay: BP is 119 over 75, respiratory rate 14, pulse 66. And oxygen saturation is 99 percent, temperature is 36.9 degrees."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 228.0,
      "end_seconds": 230.24,
      "duration_seconds": 2.24,
      "text": "May I examine you now?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 231.9,
      "end_seconds": 232.85,
      "duration_seconds": 0.95,
      "text": "That's alright."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 234.84,
      "end_seconds": 236.18,
      "duration_seconds": 1.34,
      "text": "Breathe out slowly."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 254.59,
      "end_seconds": 260.74,
      "duration_seconds": 6.15,
      "text": "Your pulse and blood pressure are normal and you are tearful when talking about work."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 266.15,
      "end_seconds": 278.79,
      "duration_seconds": 12.64,
      "text": "You can relax now. Okay, thinking it through, I can't pin this down yet. We're looking at low mood linked to work stress or an under-active thyroid."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 280.17,
      "end_seconds": 283.07,
      "duration_seconds": 2.9,
      "text": "Yeah, is this serious, doctor?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 284.97,
      "end_seconds": 322.31,
      "duration_seconds": 37.34,
      "text": "Nothing I've seen today points to an emergency. It looks like low mood linked to work stress, but I'd like to confirm. I'll request a blood count, it'll help with fatigue. I'm prescribing sertraline, 50 milligrams, once a day, for six weeks then review. That should help with low mood. Try a short walk each day and keep a regular bedtime. Come back in two weeks. Right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 323.84,
      "end_seconds": 326.57,
      "duration_seconds": 2.73,
      "text": "I think I understand everything. Thanks."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 328.65,
      "end_seconds": 329.83,
      "duration_seconds": 1.18,
      "text": "See you soon."
    }
  ]
}