{
  "schema_version": "1.0",
  "encounter_id": "20206",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 1.29,
      "end_seconds": 9.23,
      "duration_seconds": 7.94,
      "text": "Doctor, I've checked them in and done the preliminary measurements, I'll hand them over when you ask."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 11.32,
      "end_seconds": 14.86,
      "duration_seconds": 3.54,
      "text": "Perfect, thanks. Hello there, so what's the trouble?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 16.04,
      "end_seconds": 19.08,
      "duration_seconds": 3.04,
      "text": "Well, I've been having irregular periods."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 20.82,
      "end_seconds": 27.67,
      "duration_seconds": 6.85,
      "text": "Here are the numbers, doctor. Heart rate 65, pressure 115 over 79, SpO2 99 percent on room air."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 28.43,
      "end_seconds": 32.92,
      "duration_seconds": 4.49,
      "text": "Thanks. Alright, how troublesome is it day to day?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 34.61,
      "end_seconds": 35.52,
      "duration_seconds": 0.91,
      "text": "Mostly severe."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 37.2,
      "end_seconds": 39.22,
      "duration_seconds": 2.02,
      "text": "Have you been feeling low?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 40.4,
      "end_seconds": 42.07,
      "duration_seconds": 1.67,
      "text": "Yes, I have."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 43.68,
      "end_seconds": 50.31,
      "duration_seconds": 6.63,
      "text": "Right, a few quick ones: pelvic pain, headaches with vision changes or being pregnant?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 51.82,
      "end_seconds": 53.84,
      "duration_seconds": 2.02,
      "text": "Nope, nothing like that."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 55.05,
      "end_seconds": 58.33,
      "duration_seconds": 3.28,
      "text": "And what about hot flushes or breast discharge?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 59.51,
      "end_seconds": 63.11,
      "duration_seconds": 3.6,
      "text": "No, no hot flushes or breast discharge."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 63.92,
      "end_seconds": 67.75,
      "duration_seconds": 3.83,
      "text": "On the cardiac side, anything I should know?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 69.79,
      "end_seconds": 74.07,
      "duration_seconds": 4.28,
      "text": "My heart's been fine, as far as I know."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 75.67,
      "end_seconds": 79.1,
      "duration_seconds": 3.43,
      "text": "Right, have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 80.17,
      "end_seconds": 83.5,
      "duration_seconds": 3.33,
      "text": "No, I've never been operated on."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 84.41,
      "end_seconds": 87.16,
      "duration_seconds": 2.75,
      "text": "Have you got any known allergies?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 88.79,
      "end_seconds": 91.55,
      "duration_seconds": 2.76,
      "text": "Not to my knowledge, no."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 93.17,
      "end_seconds": 96.83,
      "duration_seconds": 3.66,
      "text": "Has anyone in your family had anything serious?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 97.54,
      "end_seconds": 100.27,
      "duration_seconds": 2.73,
      "text": "My sister had breast cancer."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 108.99,
      "end_seconds": 112.2,
      "duration_seconds": 3.21,
      "text": "Do you take any prescribed or over-the-counter medicines?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 112.72,
      "end_seconds": 117.72,
      "duration_seconds": 5.0,
      "text": "I take escitalopram, once a day for the anxiety."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 118.54,
      "end_seconds": 120.56,
      "duration_seconds": 2.02,
      "text": "How much do you take?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 121.53,
      "end_seconds": 122.6,
      "duration_seconds": 1.07,
      "text": "10 milligrams."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 141.22,
      "end_seconds": 142.44,
      "duration_seconds": 1.22,
      "text": "Do you smoke?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 143.11,
      "end_seconds": 147.28,
      "duration_seconds": 4.17,
      "text": "I smoke roughly a pack every two days."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 147.86,
      "end_seconds": 150.58,
      "duration_seconds": 2.72,
      "text": "Alright, do you live by yourself?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 151.75,
      "end_seconds": 155.64,
      "duration_seconds": 3.89,
      "text": "No, I share a house with my brother."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 157.24,
      "end_seconds": 159.8,
      "duration_seconds": 2.56,
      "text": "Do you follow any particular diet?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 163.83,
      "end_seconds": 167.03,
      "duration_seconds": 3.2,
      "text": "I'm vegetarian and have been for years."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 168.03,
      "end_seconds": 170.29,
      "duration_seconds": 2.26,
      "text": "Do you get out much?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 171.44,
      "end_seconds": 175.5,
      "duration_seconds": 4.06,
      "text": "Not much, I mostly stay in these days."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 178.63,
      "end_seconds": 181.9,
      "duration_seconds": 3.27,
      "text": "Right, has anyone ever diagnosed you with something?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 183.75,
      "end_seconds": 186.82,
      "duration_seconds": 3.07,
      "text": "Erm, I've had anxiety, yes."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 188.74,
      "end_seconds": 189.58,
      "duration_seconds": 0.84,
      "text": "I follow."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 192.31,
      "end_seconds": 196.1,
      "duration_seconds": 3.79,
      "text": "Right, let's have a proper look at you."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 197.16,
      "end_seconds": 198.44,
      "duration_seconds": 1.28,
      "text": "Look straight ahead."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 208.64,
      "end_seconds": 217.06,
      "duration_seconds": 8.42,
      "text": "There is some acne on the face and extra hair on the chin, and your blood pressure is fine."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 222.19,
      "end_seconds": 224.87,
      "duration_seconds": 2.68,
      "text": "Good, you can sit up again."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 232.4,
      "end_seconds": 244.52,
      "duration_seconds": 12.12,
      "text": "Okay, thinking it through, I don't have a clear answer today: a pattern that fits polycystic ovary syndrome is possible, and so is raised prolactin."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 245.89,
      "end_seconds": 247.95,
      "duration_seconds": 2.06,
      "text": "Is it dangerous, doctor?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 248.78,
      "end_seconds": 265.94,
      "duration_seconds": 17.16,
      "text": "I can't promise yet, but most people with a pattern that fits polycystic ovary syndrome do well once it's treated properly. I'm going to order a pelvic ultrasound, for irregular periods. Let's get hormone blood tests, for irregular periods."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 267.42,
      "end_seconds": 297.03,
      "duration_seconds": 29.61,
      "text": "What I'm giving you is metformin, 500 milligrams, once a day with food, for three months. You take it by mouth. That should help with cycle regulation and weight. The pharmacy will go through the details again when you pick it up. Regular exercise and a small weight loss can make cycles more regular. I'd like you back in three months."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 299.08,
      "end_seconds": 300.96,
      "duration_seconds": 1.88,
      "text": "I can manage that."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 301.51,
      "end_seconds": 305.55,
      "duration_seconds": 4.04,
      "text": "That's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 307.18,
      "end_seconds": 311.51,
      "duration_seconds": 4.33,
      "text": "Hmm, I think I understand everything. Thanks."
    }
  ]
}