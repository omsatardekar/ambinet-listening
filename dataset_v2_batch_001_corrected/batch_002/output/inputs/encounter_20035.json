{
  "schema_version": "1.0",
  "encounter_id": "20035",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.52,
      "end_seconds": 4.75,
      "duration_seconds": 4.23,
      "text": "Um, sorry, doctor, shall I sit here?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.18,
      "end_seconds": 11.0,
      "duration_seconds": 4.82,
      "text": "Okay, come in. Please sit. How can I help you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 11.84,
      "end_seconds": 18.44,
      "duration_seconds": 6.6,
      "text": "Erm, um, so the thing is, I've got not opening my bowels."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 20.4,
      "end_seconds": 22.41,
      "duration_seconds": 2.01,
      "text": "Did it come on recently?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 27.06,
      "end_seconds": 38.35,
      "duration_seconds": 11.29,
      "text": "Well, it's been nearly five years, I'm fairly sure. I thought it would sort itself out, but it hasn't."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 40.2,
      "end_seconds": 48.65,
      "duration_seconds": 8.45,
      "text": "Tell me a bit more about it: how bad it gets, how often, and whether anything makes it better or worse."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 49.71,
      "end_seconds": 67.34,
      "duration_seconds": 17.63,
      "text": "Moderate, I'd say. It settles a little with prune juice. And, And there's a bloated tummy as well, four weeks now. Ah, I've also had hard small stools, for about three months."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 69.1,
      "end_seconds": 71.6,
      "duration_seconds": 2.5,
      "text": "Do you have any chronic illnesses?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 73.06,
      "end_seconds": 80.61,
      "duration_seconds": 7.55,
      "text": "An underactive thyroid, for nearly five years. Sorry, I know I'm rambling a bit."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 84.87,
      "end_seconds": 89.35,
      "duration_seconds": 4.48,
      "text": "Are you allergic to anything? Any allergies to medicines or foods?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 90.85,
      "end_seconds": 97.67,
      "duration_seconds": 6.82,
      "text": "Sorry, uh, what was I saying, yes, amoxicillin, it gives me hives."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 98.95,
      "end_seconds": 102.15,
      "duration_seconds": 3.2,
      "text": "Which medicines do you take at the moment?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 103.73,
      "end_seconds": 110.77,
      "duration_seconds": 7.04,
      "text": "Yeah, you know, I take Thyronorm, 50 micrograms, every morning for my thyroid."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 116.08,
      "end_seconds": 117.81,
      "duration_seconds": 1.73,
      "text": "Do you drink alcohol?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 119.72,
      "end_seconds": 123.35,
      "duration_seconds": 3.63,
      "text": "I only drink at family occasions."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 124.18,
      "end_seconds": 124.99,
      "duration_seconds": 0.81,
      "text": "Any smoking?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 125.94,
      "end_seconds": 130.39,
      "duration_seconds": 4.45,
      "text": "I have about eight cigarettes in a day."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 134.94,
      "end_seconds": 136.77,
      "duration_seconds": 1.83,
      "text": "How are your meals?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 137.99,
      "end_seconds": 142.85,
      "duration_seconds": 4.86,
      "text": "I grab fast food at lunch most days."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 144.0,
      "end_seconds": 146.54,
      "duration_seconds": 2.54,
      "text": "Okay, how active are you?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 147.87,
      "end_seconds": 151.48,
      "duration_seconds": 3.61,
      "text": "I hardly move around during the day."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 153.42,
      "end_seconds": 154.76,
      "duration_seconds": 1.34,
      "text": "And your job?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 157.27,
      "end_seconds": 160.78,
      "duration_seconds": 3.51,
      "text": "I work in accounts at a hospital."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 174.2,
      "end_seconds": 177.18,
      "duration_seconds": 2.98,
      "text": "What operations have you had, if any?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 178.1,
      "end_seconds": 186.33,
      "duration_seconds": 8.23,
      "text": "I mean, just my appendix taken out, when I was in my twenties."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 199.45,
      "end_seconds": 204.66,
      "duration_seconds": 5.21,
      "text": "Have you noticed weight loss, black stools or severe abdominal pain?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 205.88,
      "end_seconds": 208.6,
      "duration_seconds": 2.72,
      "text": "No, nothing to report there."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 209.83,
      "end_seconds": 211.95,
      "duration_seconds": 2.12,
      "text": "Has there been any vomiting?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 212.9,
      "end_seconds": 214.57,
      "duration_seconds": 1.67,
      "text": "Definitely no vomiting."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 215.16,
      "end_seconds": 217.32,
      "duration_seconds": 2.16,
      "text": "Any trouble with the waterworks?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 217.92,
      "end_seconds": 219.64,
      "duration_seconds": 1.72,
      "text": "No changes there."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 220.54,
      "end_seconds": 222.85,
      "duration_seconds": 2.31,
      "text": "Has your skin been okay?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 223.93,
      "end_seconds": 229.67,
      "duration_seconds": 5.74,
      "text": "Sorry, what was I saying, nothing on the skin, no."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 230.68,
      "end_seconds": 232.63,
      "duration_seconds": 1.95,
      "text": "May I examine you now?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 233.66,
      "end_seconds": 235.31,
      "duration_seconds": 1.65,
      "text": "Let me feel here."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 245.6,
      "end_seconds": 251.16,
      "duration_seconds": 5.56,
      "text": "There is firm stool in the left lower abdomen and no mass."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 255.66,
      "end_seconds": 258.16,
      "duration_seconds": 2.5,
      "text": "Thank you, you can get dressed."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 274.65,
      "end_seconds": 300.7,
      "duration_seconds": 26.05,
      "text": "From what you've told me and what I found, it points towards constipation, possibly related to diet or medicines. I'd also keep an under-active thyroid in mind. More fibre, plenty of water and a regular time on the toilet after breakfast. Book a review if it isn't working in a week. Okay, anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 302.74,
      "end_seconds": 304.49,
      "duration_seconds": 1.75,
      "text": "That's clear, thanks."
    }
  ]
}