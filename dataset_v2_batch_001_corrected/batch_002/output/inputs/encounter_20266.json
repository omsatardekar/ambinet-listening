{
  "schema_version": "1.0",
  "encounter_id": "20266",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.02,
      "end_seconds": 5.75,
      "duration_seconds": 4.73,
      "text": "Doctor? Hello, I hope this is the right time."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.36,
      "end_seconds": 10.48,
      "duration_seconds": 4.12,
      "text": "No problem at all, come in. What's troubling you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 12.22,
      "end_seconds": 17.62,
      "duration_seconds": 5.4,
      "text": "So, I've been passing out for a couple of minutes, doctor."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 19.2,
      "end_seconds": 20.37,
      "duration_seconds": 1.17,
      "text": "Since when exactly?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 20.96,
      "end_seconds": 24.4,
      "duration_seconds": 3.44,
      "text": "Right, I've had it for five days."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 26.26,
      "end_seconds": 29.46,
      "duration_seconds": 3.2,
      "text": "How troublesome is it day to day?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 31.55,
      "end_seconds": 38.22,
      "duration_seconds": 6.67,
      "text": "I'd call it mild. I had a bitten tongue before. That's settled now, though."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 56.56,
      "end_seconds": 60.09,
      "duration_seconds": 3.53,
      "text": "Shall I check your blood pressure and pulse?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 69.93,
      "end_seconds": 72.13,
      "duration_seconds": 2.2,
      "text": "Okay, this won't take long..."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 88.59,
      "end_seconds": 99.71,
      "duration_seconds": 11.12,
      "text": "Okay: oxygen saturation is 99 percent, BP is 124 over 68. And respiratory rate 16, heart rate 77, temp 37.0 degrees."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 101.76,
      "end_seconds": 103.42,
      "duration_seconds": 1.66,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 104.57,
      "end_seconds": 107.02,
      "duration_seconds": 2.45,
      "text": "I'll interpret them after the examination."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 109.06,
      "end_seconds": 113.01,
      "duration_seconds": 3.95,
      "text": "Now I'm going to do a short physical check."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 114.45,
      "end_seconds": 116.32,
      "duration_seconds": 1.87,
      "text": "Alright, does that hurt?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 135.29,
      "end_seconds": 140.61,
      "duration_seconds": 5.32,
      "text": "The neurological examination is normal, with steady walking and equal power."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 142.92,
      "end_seconds": 147.37,
      "duration_seconds": 4.45,
      "text": "All finished, thank you. So, have you had any palpitations?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 148.9,
      "end_seconds": 150.37,
      "duration_seconds": 1.47,
      "text": "Nope, no palpitations."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 152.05,
      "end_seconds": 157.1,
      "duration_seconds": 5.05,
      "text": "A few quick ones: chest pain, head injury or vomiting?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 158.35,
      "end_seconds": 164.18,
      "duration_seconds": 5.83,
      "text": "I, I haven't had chest pain, head injury or vomiting, no."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 165.46,
      "end_seconds": 168.28,
      "duration_seconds": 2.82,
      "text": "Any breathing difficulties apart from this?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 169.0,
      "end_seconds": 170.86,
      "duration_seconds": 1.86,
      "text": "No problems with breathing."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 171.42,
      "end_seconds": 174.28,
      "duration_seconds": 2.86,
      "text": "Any problems with your joints or muscles?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 174.94,
      "end_seconds": 176.35,
      "duration_seconds": 1.41,
      "text": "Nothing else aches."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 180.75,
      "end_seconds": 183.6,
      "duration_seconds": 2.85,
      "text": "Before we go further, any allergies?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 184.54,
      "end_seconds": 188.9,
      "duration_seconds": 4.36,
      "text": "Erythromycin. I come out in... well, a rash."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 190.78,
      "end_seconds": 193.4,
      "duration_seconds": 2.62,
      "text": "Do you have any long-term conditions?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 194.22,
      "end_seconds": 197.36,
      "duration_seconds": 3.14,
      "text": "High blood pressure, for two years."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 198.92,
      "end_seconds": 205.28,
      "duration_seconds": 6.36,
      "text": "Yes, high blood pressure is known to us, good to have that clear."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 221.64,
      "end_seconds": 223.43,
      "duration_seconds": 1.79,
      "text": "Right, any previous surgeries?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 225.38,
      "end_seconds": 227.69,
      "duration_seconds": 2.31,
      "text": "No, not at all."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 228.35,
      "end_seconds": 231.44,
      "duration_seconds": 3.09,
      "text": "Does your family have any medical conditions?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 235.56,
      "end_seconds": 237.87,
      "duration_seconds": 2.31,
      "text": "My uncle has high cholesterol."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 239.09,
      "end_seconds": 243.26,
      "duration_seconds": 4.17,
      "text": "Let's talk a little about your daily life and habits."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 245.13,
      "end_seconds": 257.15,
      "duration_seconds": 12.02,
      "text": "I've never touched a cigarette. I grab fast food at lunch most days. Not much, I mostly stay in these days. My partner and our baby."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 258.86,
      "end_seconds": 262.37,
      "duration_seconds": 3.51,
      "text": "Which medicines do you take at the moment?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 263.08,
      "end_seconds": 266.54,
      "duration_seconds": 3.46,
      "text": "Metoprolol, 50 milligrams, twice a day."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 273.8,
      "end_seconds": 304.68,
      "duration_seconds": 30.88,
      "text": "Having listened and examined, I can't pin this down yet. We're looking at a possible first seizure or a heart rhythm problem. I'm sending you for an ECG because of loss of consciousness. I'm sending you for a brain scan because of possible seizure. No driving until you have been seen in the clinic, and avoid swimming or climbing alone. We'll catch up after the scan."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 306.4,
      "end_seconds": 308.44,
      "duration_seconds": 2.04,
      "text": "I can manage that."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 310.17,
      "end_seconds": 312.61,
      "duration_seconds": 2.44,
      "text": "Does all of that make sense?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 314.06,
      "end_seconds": 316.2,
      "duration_seconds": 2.14,
      "text": "Thank you, doctor, goodbye."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 317.81,
      "end_seconds": 319.61,
      "duration_seconds": 1.8,
      "text": "Have a good day."
    }
  ]
}