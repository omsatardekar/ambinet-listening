{
  "schema_version": "1.0",
  "encounter_id": "20249",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.19,
      "end_seconds": 4.79,
      "duration_seconds": 3.6,
      "text": "Sorry, doctor, shall I sit here?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.83,
      "end_seconds": 9.75,
      "duration_seconds": 3.92,
      "text": "Of course, leave it there. How can I help?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 10.27,
      "end_seconds": 14.62,
      "duration_seconds": 4.35,
      "text": "Doctor, I'm just here to help with the details."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 16.52,
      "end_seconds": 20.23,
      "duration_seconds": 3.71,
      "text": "Yes, that's no problem at all. Please sit."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 21.03,
      "end_seconds": 27.71,
      "duration_seconds": 6.68,
      "text": "Uh, it's heavy periods, doctor. She didn't want to come, but I insisted."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 28.56,
      "end_seconds": 33.06,
      "duration_seconds": 4.5,
      "text": "Right, which medicines do you take at the moment?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 34.99,
      "end_seconds": 45.79,
      "duration_seconds": 10.8,
      "text": "It's Tiotropium inhaler, once a day for my chest, doctor. She is on iron tablets, once a day, I give it to her."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 63.36,
      "end_seconds": 66.88,
      "duration_seconds": 3.52,
      "text": "Can you tell me when it first started?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 68.75,
      "end_seconds": 72.55,
      "duration_seconds": 3.8,
      "text": "I've had it for about a month."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 73.68,
      "end_seconds": 76.07,
      "duration_seconds": 2.39,
      "text": "Have you been passing clots?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 77.65,
      "end_seconds": 80.28,
      "duration_seconds": 2.63,
      "text": "Yeah. Four weeks, I'd say."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 81.85,
      "end_seconds": 84.39,
      "duration_seconds": 2.54,
      "text": "Alright, have you been looking pale?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 86.14,
      "end_seconds": 87.62,
      "duration_seconds": 1.48,
      "text": "Yes, I have."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 88.71,
      "end_seconds": 92.67,
      "duration_seconds": 3.96,
      "text": "Alright, have you had fainting, by any chance?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 94.66,
      "end_seconds": 97.58,
      "duration_seconds": 2.92,
      "text": "Not at all, no fainting."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 103.87,
      "end_seconds": 107.67,
      "duration_seconds": 3.8,
      "text": "Okay, have you noticed weight loss or pelvic pain?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 109.03,
      "end_seconds": 112.4,
      "duration_seconds": 3.37,
      "text": "No, I haven't had any of them."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 113.53,
      "end_seconds": 117.25,
      "duration_seconds": 3.72,
      "text": "Anything with your nerves, like weakness or numbness?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 118.0,
      "end_seconds": 120.27,
      "duration_seconds": 2.27,
      "text": "No, nothing like that."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 125.17,
      "end_seconds": 129.14,
      "duration_seconds": 3.97,
      "text": "Anything in your past medical history I should know?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 130.54,
      "end_seconds": 138.29,
      "duration_seconds": 7.75,
      "text": "I've had COPD for nearly five years now. I've had eczema for two years now."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 139.61,
      "end_seconds": 141.14,
      "duration_seconds": 1.53,
      "text": "Okay, what else?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 142.56,
      "end_seconds": 145.14,
      "duration_seconds": 2.58,
      "text": "Okay, do you live by yourself?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 146.03,
      "end_seconds": 150.14,
      "duration_seconds": 4.11,
      "text": "No, I share a house with my brother."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 152.22,
      "end_seconds": 153.78,
      "duration_seconds": 1.56,
      "text": "How active are you?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 155.6,
      "end_seconds": 159.22,
      "duration_seconds": 3.62,
      "text": "I hardly move around during the day."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 159.84,
      "end_seconds": 161.3,
      "duration_seconds": 1.46,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 163.13,
      "end_seconds": 164.38,
      "duration_seconds": 1.25,
      "text": "No, never."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 164.93,
      "end_seconds": 168.7,
      "duration_seconds": 3.77,
      "text": "Let me ask about allergies, anything at all?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 170.4,
      "end_seconds": 179.89,
      "duration_seconds": 9.49,
      "text": "I think I reacted to some antibiotic once, years ago. I don't remember which one, or what happened exactly."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 180.5,
      "end_seconds": 183.75,
      "duration_seconds": 3.25,
      "text": "Does your family have any medical conditions?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 185.76,
      "end_seconds": 191.94,
      "duration_seconds": 6.18,
      "text": "My daughter has type 1 diabetes. My sister had breast cancer."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 199.71,
      "end_seconds": 202.22,
      "duration_seconds": 2.51,
      "text": "Let me take your readings now."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 209.88,
      "end_seconds": 212.51,
      "duration_seconds": 2.63,
      "text": "Keep your arm relaxed for me..."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 230.77,
      "end_seconds": 241.55,
      "duration_seconds": 10.78,
      "text": "Okay: SpO2 99 percent on room air, temp 36.5 degrees. And pulse is 66 beats a minute, BP is 110 over 71."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 243.13,
      "end_seconds": 244.56,
      "duration_seconds": 1.43,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 245.41,
      "end_seconds": 248.0,
      "duration_seconds": 2.59,
      "text": "We'll look at it together shortly."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 250.74,
      "end_seconds": 254.71,
      "duration_seconds": 3.97,
      "text": "Now I'm going to do a short physical check."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 256.1,
      "end_seconds": 258.95,
      "duration_seconds": 2.85,
      "text": "Take a deep breath for me."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 274.98,
      "end_seconds": 279.13,
      "duration_seconds": 4.15,
      "text": "Your eyelids and the palms of your hands look pale."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 283.09,
      "end_seconds": 285.48,
      "duration_seconds": 2.39,
      "text": "That's all I needed to check."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 300.48,
      "end_seconds": 312.44,
      "duration_seconds": 11.96,
      "text": "Let me tell you where I've got to. I think we're dealing with heavy periods with iron deficiency at this stage. We shouldn't forget fibroids."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 314.02,
      "end_seconds": 316.73,
      "duration_seconds": 2.71,
      "text": "What are the odds it's serious?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 317.63,
      "end_seconds": 339.05,
      "duration_seconds": 21.42,
      "text": "I understand the worry. At the moment I'd say it's heavy periods with iron deficiency, and we'll watch how it goes. Stop me if I've got anything wrong. You've had heavy periods for about a month, and no pelvic pain or weight loss."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 344.01,
      "end_seconds": 345.94,
      "duration_seconds": 1.93,
      "text": "That's what happened, yes."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 347.63,
      "end_seconds": 354.25,
      "duration_seconds": 6.62,
      "text": "Today I'm not changing anything. Right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 356.22,
      "end_seconds": 359.54,
      "duration_seconds": 3.32,
      "text": "Great, thank you for your help."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 360.39,
      "end_seconds": 361.86,
      "duration_seconds": 1.47,
      "text": "Take care now."
    }
  ]
}