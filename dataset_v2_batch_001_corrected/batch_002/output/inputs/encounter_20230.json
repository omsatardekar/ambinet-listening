{
  "schema_version": "1.0",
  "encounter_id": "20230",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.84,
      "end_seconds": 4.29,
      "duration_seconds": 3.45,
      "text": "Morning, doctor. Lovely to meet you."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.22,
      "end_seconds": 9.3,
      "duration_seconds": 4.08,
      "text": "Come in. Please sit. How can I help you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 10.12,
      "end_seconds": 17.57,
      "duration_seconds": 7.45,
      "text": "Um, so... sharp pain in the upper right of my tummy. That's why I came."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 18.78,
      "end_seconds": 22.37,
      "duration_seconds": 3.59,
      "text": "How many days or weeks has it been?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 23.03,
      "end_seconds": 31.44,
      "duration_seconds": 8.41,
      "text": "It's been ten days now. Okay, so there was bloating, yes, but that went away."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 32.93,
      "end_seconds": 37.59,
      "duration_seconds": 4.66,
      "text": "Alright, any fever, yellow eyes or pale stools at all?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 39.23,
      "end_seconds": 44.21,
      "duration_seconds": 4.98,
      "text": "No fever, yellow eyes or pale stools, none of it."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 45.3,
      "end_seconds": 47.65,
      "duration_seconds": 2.35,
      "text": "Did you notice any black stools?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 49.73,
      "end_seconds": 52.93,
      "duration_seconds": 3.2,
      "text": "I haven't noticed any black stools."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 57.02,
      "end_seconds": 59.13,
      "duration_seconds": 2.11,
      "text": "Any trouble with the waterworks?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 59.84,
      "end_seconds": 62.03,
      "duration_seconds": 2.19,
      "text": "No, that's all fine."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 62.65,
      "end_seconds": 65.85,
      "duration_seconds": 3.2,
      "text": "Anything on the skin I should know about?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 67.72,
      "end_seconds": 71.27,
      "duration_seconds": 3.55,
      "text": "So, nothing on the skin, no."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 84.58,
      "end_seconds": 88.25,
      "duration_seconds": 3.67,
      "text": "Let me ask about allergies, anything at all?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 89.18,
      "end_seconds": 93.57,
      "duration_seconds": 4.39,
      "text": "Ah, um, not to my knowledge, no."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 94.58,
      "end_seconds": 96.58,
      "duration_seconds": 2.0,
      "text": "Let's run through your medicines."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 98.58,
      "end_seconds": 109.63,
      "duration_seconds": 11.05,
      "text": "Oh, it's rosuvastatin, 10 milligrams, at night for my cholesterol. I had simvastatin at one point, but I'm off it now."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 117.64,
      "end_seconds": 120.4,
      "duration_seconds": 2.76,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 121.5,
      "end_seconds": 123.2,
      "duration_seconds": 1.7,
      "text": "No surgery, no."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 125.15,
      "end_seconds": 128.08,
      "duration_seconds": 2.93,
      "text": "What do you do during the day?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 132.66,
      "end_seconds": 135.92,
      "duration_seconds": 3.26,
      "text": "I look after my grandchildren most days."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 137.31,
      "end_seconds": 139.5,
      "duration_seconds": 2.19,
      "text": "Do you do any exercise?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 141.19,
      "end_seconds": 143.86,
      "duration_seconds": 2.67,
      "text": "I swim twice a week."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 144.97,
      "end_seconds": 149.22,
      "duration_seconds": 4.25,
      "text": "What conditions have you been treated for in the past?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 151.07,
      "end_seconds": 155.61,
      "duration_seconds": 4.54,
      "text": "I've had high cholesterol for about ten years now."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 160.85,
      "end_seconds": 163.91,
      "duration_seconds": 3.06,
      "text": "Ah. Let's start with the basic checks."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 175.96,
      "end_seconds": 178.45,
      "duration_seconds": 2.49,
      "text": "Keep your arm relaxed for me..."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 189.47,
      "end_seconds": 200.43,
      "duration_seconds": 10.96,
      "text": "Okay: pulse is 71 beats a minute, BP is 116 over 72, oxygen saturation is 99 percent, respiratory rate 16, temp 36.9 degrees."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 203.29,
      "end_seconds": 207.74,
      "duration_seconds": 4.45,
      "text": "I'll examine you in a second, make yourself comfortable."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 209.51,
      "end_seconds": 210.21,
      "duration_seconds": 0.7,
      "text": "Right."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 211.77,
      "end_seconds": 213.04,
      "duration_seconds": 1.27,
      "text": "Does that hurt?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 230.11,
      "end_seconds": 237.99,
      "duration_seconds": 7.88,
      "text": "There is tenderness under the right ribs when you breathe in, and no yellowing of the eyes."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 240.53,
      "end_seconds": 250.82,
      "duration_seconds": 10.29,
      "text": "That's all I needed to check. So, based on the history and the examination, I'd lean towards biliary colic from gallstones."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 263.08,
      "end_seconds": 300.37,
      "duration_seconds": 37.29,
      "text": "I want an ultrasound of the tummy done, that's for right upper quadrant pain. For this, diclofenac, 50 milligrams, three times a day if needed, for three days. You take it by mouth. That should help with gallbladder pain. Keep meals small and low in fat until we have the scan. I'm not ordering liver blood tests today. If things carry on in two weeks, we'll consider it. Anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 302.19,
      "end_seconds": 305.51,
      "duration_seconds": 3.32,
      "text": "Okay, that makes sense. Thanks for explaining."
    }
  ]
}