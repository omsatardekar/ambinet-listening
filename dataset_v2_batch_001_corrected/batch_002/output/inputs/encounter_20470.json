    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 207.7,
      "end_seconds": 210.8,
      "duration_seconds": 3.1,
      "text": "I live with my elderly mother"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 211.48,
      "end_seconds": 213.86,
      "duration_seconds": 2.38,
      "text": "Do you have any long-term conditions?"
