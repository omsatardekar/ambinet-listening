      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 186.79,
      "end_seconds": 191.05,
      "duration_seconds": 4.26,
      "text": "I do a yoga class on Thursdays"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 192.18,
      "end_seconds": 195.05,
      "duration_seconds": 2.87,
      "text": "What line of work are you in?"
