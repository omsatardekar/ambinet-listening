      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 288.06,
      "end_seconds": 292.45,
      "duration_seconds": 4.39,
      "text": "they help me see the whole picture, more shortly"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 294.93,
      "end_seconds": 298.74,
      "duration_seconds": 3.81,
      "text": "Alright, over here please and I'll take a look."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 309.31,
      "end_seconds": 310.52,
      "duration_seconds": 1.21,
      "text": "okay doctor"
