    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 130.82,
      "end_seconds": 134.21,
      "duration_seconds": 3.39,
      "text": "what do you take on a normal day?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 135.44,
      "end_seconds": 146.83,
      "duration_seconds": 11.39,
      "text": "I take atorvastatin, 20 milligrams, at night for my cholesterol. Ramipril, 5 milligrams, every morning for my blood pressure."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 165.44,
      "end_seconds": 168.05,
      "duration_seconds": 2.61,
      "text": "have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 169.47,
      "end_seconds": 171.6,
      "duration_seconds": 2.13,
      "text": "no, uh, never"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 183.52,
      "end_seconds": 186.24,
      "duration_seconds": 2.72,
      "text": "Anything you do to stay fit?"
