      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 250.74,
      "end_seconds": 253.11,
      "duration_seconds": 2.37,
      "text": "keep your arm relaxed for me.."
