      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 330.84,
      "end_seconds": 335.35,
      "duration_seconds": 4.51,
      "text": "Heart sounds are normal, no murmur, and the chest is clear."
