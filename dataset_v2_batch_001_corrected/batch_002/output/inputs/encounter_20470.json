    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 203.68,
      "end_seconds": 206.96,
      "duration_seconds": 3.28,
      "text": "are you on your own at home?"
