    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 215.39,
      "end_seconds": 221.98,
      "duration_seconds": 6.59,
      "text": "I have high cholesterol. I've, I've had high blood pressure, yes."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 223.33,
      "end_seconds": 229.03,
      "duration_seconds": 5.7,
      "text": "Mm-hmm. So, has anything ever caused you a reaction? I mean any allergies."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 230.94,
      "end_seconds": 235.49,
      "duration_seconds": 4.55,
      "text": "no uh I've never reacted to anything"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 236.52,
      "end_seconds": 240.0,
      "duration_seconds": 3.48,
      "text": "okay time for your numbers if that's okay"
    },
