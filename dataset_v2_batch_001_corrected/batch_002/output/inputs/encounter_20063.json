{
  "schema_version": "1.0",
  "encounter_id": "20063",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 0.91,
      "end_seconds": 7.65,
      "duration_seconds": 6.74,
      "text": "Doctor, this one's ready for you. Everything's on the chart, but I'll go through it."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.46,
      "end_seconds": 11.6,
      "duration_seconds": 3.14,
      "text": "Thank you. Right, hello, what's the problem?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 13.45,
      "end_seconds": 20.22,
      "duration_seconds": 6.77,
      "text": "right, doctor, I've come along because I know the history, if it helps"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 21.12,
      "end_seconds": 24.15,
      "duration_seconds": 3.03,
      "text": "Absolutely, come and sit beside them."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 25.24,
      "end_seconds": 34.31,
      "duration_seconds": 9.07,
      "text": "Mainly tingling in my thumb and first two fingers. There's a couple of other things, but that's the main one."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 35.49,
      "end_seconds": 38.87,
      "duration_seconds": 3.38,
      "text": "How long has this been bothering you?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 39.99,
      "end_seconds": 42.88,
      "duration_seconds": 2.89,
      "text": "For two years, I'd say."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 44.93,
      "end_seconds": 47.18,
      "duration_seconds": 2.25,
      "text": "how frequently does it come?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 48.17,
      "end_seconds": 61.34,
      "duration_seconds": 13.17,
      "text": "It's a couple of times a week. I mean, I've been waking at night with my hand numb too, for about a year."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 61.89,
      "end_seconds": 62.74,
      "duration_seconds": 0.85,
      "text": "I follow."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 63.59,
      "end_seconds": 85.59,
      "duration_seconds": 22.0,
      "text": "I've had an ache in my wrist too, um, for two years. About ache in my wrist, I'd say on and off. Oh, you know, and dropping things. That's been about the same, four weeks. Yeah, um, with dropping things, I'd say severe."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 86.47,
      "end_seconds": 94.43,
      "duration_seconds": 7.96,
      "text": "Have you had tingling in your thumb and first two fingers before, or is this the first time?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 95.64,
      "end_seconds": 100.36,
      "duration_seconds": 4.72,
      "text": "A bit, last winter. It settled by itself back then."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 101.22,
      "end_seconds": 105.7,
      "duration_seconds": 4.48,
      "text": "So, are you taking anything regularly, including from the pharmacy?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 110.45,
      "end_seconds": 121.8,
      "duration_seconds": 11.35,
      "text": "I take Eltroxin, 100 micrograms, every morning for my thyroid. Sitagliptin, 100 milligrams, once a day for my sugar. Glibenclamide I don't take anymore"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 122.67,
      "end_seconds": 125.77,
      "duration_seconds": 3.1,
      "text": "any past operations I should know about?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 127.02,
      "end_seconds": 131.41,
      "duration_seconds": 4.39,
      "text": "Just keyhole surgery on my gallbladder, two years back."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 149.82,
      "end_seconds": 153.29,
      "duration_seconds": 3.47,
      "text": "Has anyone in your family had anything serious?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 155.33,
      "end_seconds": 158.0,
      "duration_seconds": 2.67,
      "text": "my grandfather had a stroke"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 160.01,
      "end_seconds": 164.75,
      "duration_seconds": 4.74,
      "text": "do you react to to any medicines or foods? Any allergies?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 166.84,
      "end_seconds": 180.53,
      "duration_seconds": 13.69,
      "text": "hmm, uh, there was some antibiotic, I was told I was allergic. But I couldn't tell you what it it was called or what it did"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 182.18,
      "end_seconds": 185.53,
      "duration_seconds": 3.35,
      "text": "So, a few questions about your lifestyle now."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 186.95,
      "end_seconds": 198.66,
      "duration_seconds": 11.71,
      "text": "No, I share a house with my brother. I work in accounts at a hospital. I do a yoga class on Thursdays."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 200.36,
      "end_seconds": 202.31,
      "duration_seconds": 1.95,
      "text": "What about your medical history?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 203.44,
      "end_seconds": 206.35,
      "duration_seconds": 2.91,
      "text": "I've had an underactive thyroid, yes."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 207.35,
      "end_seconds": 208.05,
      "duration_seconds": 0.7,
      "text": "sure"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 208.82,
      "end_seconds": 211.69,
      "duration_seconds": 2.87,
      "text": "I have diabetes, for two years"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 220.87,
      "end_seconds": 224.19,
      "duration_seconds": 3.32,
      "text": "Any sign of weakness in the legs?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 225.72,
      "end_seconds": 232.11,
      "duration_seconds": 6.39,
      "text": "Sorry, what was I saying, no, none, no weakness in the legs."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 233.49,
      "end_seconds": 237.03,
      "duration_seconds": 3.54,
      "text": "A few quick ones: weight loss or neck pain?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 238.41,
      "end_seconds": 241.03,
      "duration_seconds": 2.62,
      "text": "ah, none of those, no"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 241.81,
      "end_seconds": 244.33,
      "duration_seconds": 2.52,
      "text": "Right, anything unusual with passing urine?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 246.28,
      "end_seconds": 249.23,
      "duration_seconds": 2.95,
      "text": "no, you know, that's all fine"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 263.99,
      "end_seconds": 272.98,
      "duration_seconds": 8.99,
      "text": "Okay, so the vitals from earlier. Temperature is 36.4 degrees, heart rate 79, BP is 110 over 74."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 274.36,
      "end_seconds": 275.06,
      "duration_seconds": 0.7,
      "text": "Thanks."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 277.54,
      "end_seconds": 279.74,
      "duration_seconds": 2.2,
      "text": "may I examine you now?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 280.95,
      "end_seconds": 282.4,
      "duration_seconds": 1.45,
      "text": "Breathe out slowly."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 299.73,
      "end_seconds": 307.67,
      "duration_seconds": 7.94,
      "text": "Tapping over the wrist brings on the tingling, and the muscle at the base of the thumb looks slightly thin"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 309.68,
      "end_seconds": 324.71,
      "duration_seconds": 15.03,
      "text": "that's all I needed to check. So, based on the history and the examination, I'm honestly not certain yet. It could be carpal tunnel syndrome, or it might be diabetic nerve damage"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 325.24,
      "end_seconds": 326.64,
      "duration_seconds": 1.4,
      "text": "is this permanent?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 327.81,
      "end_seconds": 347.58,
      "duration_seconds": 19.77,
      "text": "I can't promise yet, but most people with carpal tunnel syndrome do well once it's treated properly i think nerve conduction tests makes sense here, for hand numbness it's a routine test and it'll give us a much clearer picture"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 348.34,
      "end_seconds": 351.51,
      "duration_seconds": 3.17,
      "text": "Do I need to to prepare?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 353.34,
      "end_seconds": 361.63,
      "duration_seconds": 8.29,
      "text": "Please come and see me in six weeks. Right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 362.3,
      "end_seconds": 366.3,
      "duration_seconds": 4.0,
      "text": "Right, I'll do that. Thank you, doctor."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 367.94,
      "end_seconds": 369.27,
      "duration_seconds": 1.33,
      "text": "Look after yourself."
    }
  ]
}