{
  "schema_version": "1.0",
  "encounter_id": "20369",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.78,
      "end_seconds": 5.37,
      "duration_seconds": 4.59,
      "text": "Hi, doctor, I hope I'm not disturbing you."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.19,
      "end_seconds": 11.6,
      "duration_seconds": 4.41,
      "text": "Yes, come in and sit down. What brings you here today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 12.21,
      "end_seconds": 27.26,
      "duration_seconds": 15.05,
      "text": "Sorry, what was I saying, mainly a tight scalp. There's a couple of other things, but that's the main one. I didn't want to make a fuss, you know."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 29.35,
      "end_seconds": 32.64,
      "duration_seconds": 3.29,
      "text": "Has this been going on for long?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 33.36,
      "end_seconds": 37.53,
      "duration_seconds": 4.17,
      "text": "It's, It's been three weeks, I'm fairly sure."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 39.12,
      "end_seconds": 40.87,
      "duration_seconds": 1.75,
      "text": "Anything that improves it?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 42.97,
      "end_seconds": 47.93,
      "duration_seconds": 4.96,
      "text": "Right, only a head massage, and it's not much."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 49.17,
      "end_seconds": 52.03,
      "duration_seconds": 2.86,
      "text": "Has there been a stiff neck too?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 52.55,
      "end_seconds": 62.17,
      "duration_seconds": 9.62,
      "text": "Yeah. Nearly five years, I'd say. Right, as for stiff neck, mild, I'd say. Honestly, once or twice a day."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 75.13,
      "end_seconds": 79.57,
      "duration_seconds": 4.44,
      "text": "Have you noticed head injury, weakness or blurred vision?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 81.53,
      "end_seconds": 86.7,
      "duration_seconds": 5.17,
      "text": "So, no, no head injury, weakness or blurred vision."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 87.46,
      "end_seconds": 89.19,
      "duration_seconds": 1.73,
      "text": "Okay, nothing like fever?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 90.24,
      "end_seconds": 93.58,
      "duration_seconds": 3.34,
      "text": "Not that I've noticed, no fever."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 94.95,
      "end_seconds": 97.84,
      "duration_seconds": 2.89,
      "text": "Any breathing difficulties apart from this?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 98.46,
      "end_seconds": 99.59,
      "duration_seconds": 1.13,
      "text": "Breathing's normal."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 103.41,
      "end_seconds": 106.78,
      "duration_seconds": 3.37,
      "text": "How about your heart, any problems like that?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 107.28,
      "end_seconds": 110.47,
      "duration_seconds": 3.19,
      "text": "Right, no, nothing with my heart."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 124.65,
      "end_seconds": 127.45,
      "duration_seconds": 2.8,
      "text": "Did you ever have any procedures done?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 128.1,
      "end_seconds": 132.98,
      "duration_seconds": 4.88,
      "text": "I, I had an operation for a hernia last spring."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 151.48,
      "end_seconds": 154.3,
      "duration_seconds": 2.82,
      "text": "Have you got any known allergies?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 155.0,
      "end_seconds": 158.53,
      "duration_seconds": 3.53,
      "text": "No, nothing as far as I know."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 159.58,
      "end_seconds": 163.58,
      "duration_seconds": 4.0,
      "text": "Are you taking anything regularly, including from the pharmacy?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 165.6,
      "end_seconds": 169.62,
      "duration_seconds": 4.02,
      "text": "Ah, I take escitalopram, once a day."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 170.39,
      "end_seconds": 172.65,
      "duration_seconds": 2.26,
      "text": "And what strength is that?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 174.01,
      "end_seconds": 182.47,
      "duration_seconds": 8.46,
      "text": "10 milligrams. Propranolol, 40 milligrams, twice a day for the migraine prevention. Paracetamol, 500 milligrams, most days."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 183.36,
      "end_seconds": 186.98,
      "duration_seconds": 3.62,
      "text": "Any health conditions I should have on record?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 188.06,
      "end_seconds": 192.85,
      "duration_seconds": 4.79,
      "text": "Anxiety, for nearly five years. Migraines, for nearly five years."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 200.57,
      "end_seconds": 204.82,
      "duration_seconds": 4.25,
      "text": "Let's talk a little about your daily life and habits."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 205.91,
      "end_seconds": 217.67,
      "duration_seconds": 11.76,
      "text": "Not much, I mostly stay in these days. No, I share a house with my brother. I retired from the post office two years ago."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 218.23,
      "end_seconds": 235.39,
      "duration_seconds": 17.16,
      "text": "Doctor, I've got the readings for you. Respiratory rate 15, pulse 67, saturation 98 percent. Weight 68 kilos, height 151 centimetres, BP is 128 over 80, BMI works out to 29.8, temp 36.6 degrees."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 237.22,
      "end_seconds": 237.92,
      "duration_seconds": 0.7,
      "text": "Thanks."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 240.19,
      "end_seconds": 245.1,
      "duration_seconds": 4.91,
      "text": "I'll need to examine you for this, it won't take long."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 246.32,
      "end_seconds": 249.74,
      "duration_seconds": 3.42,
      "text": "So, stay as you are for a moment."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 259.8,
      "end_seconds": 266.55,
      "duration_seconds": 6.75,
      "text": "Neck muscles are tight and tender, and the eye and limb checks are normal."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 269.25,
      "end_seconds": 278.38,
      "duration_seconds": 9.13,
      "text": "All finished, thank you. Let me tell you where I've got to. My working impression is tension-type headaches with possible medication overuse."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 279.36,
      "end_seconds": 284.04,
      "duration_seconds": 4.68,
      "text": "Actually, you know, is there something to worry about?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 284.91,
      "end_seconds": 309.48,
      "duration_seconds": 24.57,
      "text": "It's reasonable to be concerned, but right now tension-type headaches with possible medication overuse is my leading thought, not anything worse. I'm going to order blood tests, for headache. Try to limit painkillers to two days a week and keep a diary of the headaches. So, does all of that make sense?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 310.05,
      "end_seconds": 313.64,
      "duration_seconds": 3.59,
      "text": "Okay, that makes sense. Thanks for explaining."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 314.71,
      "end_seconds": 316.17,
      "duration_seconds": 1.46,
      "text": "Goodbye for now."
    }
  ]
}