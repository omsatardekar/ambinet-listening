{
  "schema_version": "1.0",
  "encounter_id": "20107",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.3,
      "end_seconds": 4.54,
      "duration_seconds": 3.24,
      "text": "Sorry, doctor, shall I sit here?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.33,
      "end_seconds": 10.87,
      "duration_seconds": 4.54,
      "text": "Of course, leave it there. How can I help?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 11.94,
      "end_seconds": 18.48,
      "duration_seconds": 6.54,
      "text": "It's a sore tongue. I thought I'd wait, you know, but it hasn't gone."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 19.61,
      "end_seconds": 21.91,
      "duration_seconds": 2.3,
      "text": "Okay, when did this begin?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 23.93,
      "end_seconds": 26.31,
      "duration_seconds": 2.38,
      "text": "Probably nearly five years. Yeah."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 27.0,
      "end_seconds": 30.45,
      "duration_seconds": 3.45,
      "text": "Alright, how troublesome is it day to day?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 31.86,
      "end_seconds": 33.46,
      "duration_seconds": 1.6,
      "text": "It's moderate, honestly."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 35.22,
      "end_seconds": 37.44,
      "duration_seconds": 2.22,
      "text": "Have you been forgetting words?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 38.14,
      "end_seconds": 49.33,
      "duration_seconds": 11.19,
      "text": "Yes, for two months. Oh, and being unsteady on my feet. As for being unsteady on my feet, moderate, I'd say."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 49.98,
      "end_seconds": 55.92,
      "duration_seconds": 5.94,
      "text": "Right, have you had a sore tongue before, or is this the first time?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 57.96,
      "end_seconds": 62.51,
      "duration_seconds": 4.55,
      "text": "I had a similar thing last winter. It went away."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 73.92,
      "end_seconds": 75.99,
      "duration_seconds": 2.07,
      "text": "Tell me your medicines, please."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 77.25,
      "end_seconds": 87.84,
      "duration_seconds": 10.59,
      "text": "I mean, I'm on lansoprazole, 30 milligrams, before breakfast. I take something called glic... gliclazide, 80 milligrams, maybe, twice a day."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 89.56,
      "end_seconds": 93.58,
      "duration_seconds": 4.02,
      "text": "Do you have the packet or the prescription with you?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 95.01,
      "end_seconds": 96.98,
      "duration_seconds": 1.97,
      "text": "No, it's at home."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 102.45,
      "end_seconds": 104.17,
      "duration_seconds": 1.72,
      "text": "How active are you?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 104.88,
      "end_seconds": 108.54,
      "duration_seconds": 3.66,
      "text": "I hardly move around during the day."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 110.61,
      "end_seconds": 113.32,
      "duration_seconds": 2.71,
      "text": "Do you work outside the home?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 114.05,
      "end_seconds": 118.02,
      "duration_seconds": 3.97,
      "text": "I'm a hairdresser, on my feet all day."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 119.25,
      "end_seconds": 121.21,
      "duration_seconds": 1.96,
      "text": "Tell me about your eating."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 122.35,
      "end_seconds": 127.66,
      "duration_seconds": 5.31,
      "text": "I drink a lot of tea and snack through the day."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 128.23,
      "end_seconds": 131.17,
      "duration_seconds": 2.94,
      "text": "Any past operations I should know about?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 133.21,
      "end_seconds": 138.37,
      "duration_seconds": 5.16,
      "text": "Just a wisdom tooth extraction under sedation, five years ago."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 139.77,
      "end_seconds": 142.32,
      "duration_seconds": 2.55,
      "text": "Do you have any long-term conditions?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 147.8,
      "end_seconds": 152.64,
      "duration_seconds": 4.84,
      "text": "I've had acid reflux, yes. I've had diabetes, yes."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 153.49,
      "end_seconds": 163.13,
      "duration_seconds": 9.64,
      "text": "Yes. Okay, I can see diabetes in your file as well. Has anything ever caused you a reaction? I mean any allergies."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 167.77,
      "end_seconds": 171.0,
      "duration_seconds": 3.23,
      "text": "Uh, I've never had an allergy."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 172.08,
      "end_seconds": 176.85,
      "duration_seconds": 4.77,
      "text": "Have you had any weakness of one side or rash?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 178.08,
      "end_seconds": 180.91,
      "duration_seconds": 2.83,
      "text": "No, nothing to report there."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 182.55,
      "end_seconds": 189.01,
      "duration_seconds": 6.46,
      "text": "Let me check a few things. Any loss of vision, diarrhoea or bladder problems?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 189.81,
      "end_seconds": 196.24,
      "duration_seconds": 6.43,
      "text": "No, you know, no loss of vision, diarrhoea or bladder problems."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 197.71,
      "end_seconds": 199.83,
      "duration_seconds": 2.12,
      "text": "Your breathing, any trouble there?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 200.71,
      "end_seconds": 202.28,
      "duration_seconds": 1.57,
      "text": "No, nothing there."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 219.99,
      "end_seconds": 222.66,
      "duration_seconds": 2.67,
      "text": "Let me take your readings now."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 228.86,
      "end_seconds": 231.22,
      "duration_seconds": 2.36,
      "text": "Keep your arm relaxed for me..."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 245.08,
      "end_seconds": 252.37,
      "duration_seconds": 7.29,
      "text": "Okay: temperature 36.4, blood pressure 119 over 79, saturation 98 percent, heart rate 69."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 254.22,
      "end_seconds": 257.03,
      "duration_seconds": 2.81,
      "text": "Okay, may I examine you now?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 258.03,
      "end_seconds": 260.27,
      "duration_seconds": 2.24,
      "text": "I'm just checking this side."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 271.3,
      "end_seconds": 273.75,
      "duration_seconds": 2.45,
      "text": "The tongue looks smooth and red."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 274.9,
      "end_seconds": 276.88,
      "duration_seconds": 1.98,
      "text": "So, breathe out slowly."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 292.29,
      "end_seconds": 296.16,
      "duration_seconds": 3.87,
      "text": "Your vibration sense is reduced at the ankles."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 300.08,
      "end_seconds": 302.61,
      "duration_seconds": 2.53,
      "text": "Okay, that's enough for me."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 312.16,
      "end_seconds": 345.33,
      "duration_seconds": 33.17,
      "text": "Okay, thinking it through, I can't pin this down yet. We're looking at symptoms that fit a vitamin B12 deficiency or diabetic nerve damage. I'm going to order a vitamin B12 level, for tingling and tiredness. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose. Come back or go to emergency straight away if the symptoms get worse. Does all of that make sense?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 346.86,
      "end_seconds": 348.92,
      "duration_seconds": 2.06,
      "text": "Thank you, doctor, goodbye."
    }
  ]
}