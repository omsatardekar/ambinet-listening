{
  "schema_version": "1.0",
  "encounter_id": "20260",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.19,
      "end_seconds": 6.04,
      "duration_seconds": 4.85,
      "text": "Hi, doctor, I came as soon as they called me."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.99,
      "end_seconds": 12.13,
      "duration_seconds": 4.14,
      "text": "Of course, leave it there. How can I help?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 13.56,
      "end_seconds": 16.51,
      "duration_seconds": 2.95,
      "text": "Well, I've been having soreness."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 17.25,
      "end_seconds": 20.0,
      "duration_seconds": 2.75,
      "text": "Has this been going on for long?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 25.54,
      "end_seconds": 30.11,
      "duration_seconds": 4.57,
      "text": "Um, it's been two days, I'm fairly sure."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 30.95,
      "end_seconds": 34.94,
      "duration_seconds": 3.99,
      "text": "Okay, how strong would you say it is?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 36.23,
      "end_seconds": 40.49,
      "duration_seconds": 4.26,
      "text": "I'd give it a five, out of ten."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 41.71,
      "end_seconds": 45.98,
      "duration_seconds": 4.27,
      "text": "And what about fever, being pregnant or new partner?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 47.22,
      "end_seconds": 50.7,
      "duration_seconds": 3.48,
      "text": "Oh, no, none that I've noticed."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 52.59,
      "end_seconds": 55.33,
      "duration_seconds": 2.74,
      "text": "Okay, nothing like bleeding between periods?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 57.01,
      "end_seconds": 59.66,
      "duration_seconds": 2.65,
      "text": "No. No bleeding between periods."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 63.65,
      "end_seconds": 67.57,
      "duration_seconds": 3.92,
      "text": "How about your heart, any problems like that?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 68.46,
      "end_seconds": 70.77,
      "duration_seconds": 2.31,
      "text": "No, that's been fine."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 71.68,
      "end_seconds": 74.08,
      "duration_seconds": 2.4,
      "text": "Has your skin been okay?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 75.8,
      "end_seconds": 76.72,
      "duration_seconds": 0.92,
      "text": "Skin's normal."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 77.65,
      "end_seconds": 82.34,
      "duration_seconds": 4.69,
      "text": "Any inherited conditions that you know of in the family?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 83.2,
      "end_seconds": 85.2,
      "duration_seconds": 2.0,
      "text": "My cousin has psoriasis."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 96.02,
      "end_seconds": 98.56,
      "duration_seconds": 2.54,
      "text": "Have you got any known allergies?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 99.3,
      "end_seconds": 102.25,
      "duration_seconds": 2.95,
      "text": "Not to my knowledge, no."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 103.21,
      "end_seconds": 108.28,
      "duration_seconds": 5.07,
      "text": "Okay, do you have any medical conditions I should know about?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 109.87,
      "end_seconds": 112.04,
      "duration_seconds": 2.17,
      "text": "No, nothing at all."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 130.02,
      "end_seconds": 132.6,
      "duration_seconds": 2.58,
      "text": "Do you take any regular medication?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 134.65,
      "end_seconds": 136.19,
      "duration_seconds": 1.54,
      "text": "Nothing regular, no."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 151.54,
      "end_seconds": 154.36,
      "duration_seconds": 2.82,
      "text": "Now some background about your lifestyle."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 155.45,
      "end_seconds": 171.5,
      "duration_seconds": 16.05,
      "text": "I smoke roughly a pack every two days. I'll have a glass of wine with dinner. Not much, I mostly stay in these days. I'm a plumber, lots of bending and kneeling."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 172.86,
      "end_seconds": 174.19,
      "duration_seconds": 1.33,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 175.74,
      "end_seconds": 179.07,
      "duration_seconds": 3.33,
      "text": "Nothing, I haven't had any operations."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 196.21,
      "end_seconds": 198.95,
      "duration_seconds": 2.74,
      "text": "Let me quickly check your readings."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 208.3,
      "end_seconds": 210.65,
      "duration_seconds": 2.35,
      "text": "Sit still for a moment..."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 227.02,
      "end_seconds": 235.91,
      "duration_seconds": 8.89,
      "text": "Okay: temperature is 36.7 degrees, BP is 111 over 68, saturation 97 percent. And heart rate 75."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 238.84,
      "end_seconds": 242.49,
      "duration_seconds": 3.65,
      "text": "Let me look at the area, I'll be gentle."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 244.35,
      "end_seconds": 245.42,
      "duration_seconds": 1.07,
      "text": "That's alright."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 246.41,
      "end_seconds": 249.27,
      "duration_seconds": 2.86,
      "text": "Take a deep breath for me."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 265.12,
      "end_seconds": 271.57,
      "duration_seconds": 6.45,
      "text": "There is a thick white discharge with redness of the vulva and no ulcers."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 276.58,
      "end_seconds": 283.88,
      "duration_seconds": 7.3,
      "text": "Okay, that's enough for me. So where does that leave us? My working impression is vaginal thrush."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 285.33,
      "end_seconds": 286.74,
      "duration_seconds": 1.41,
      "text": "Is this permanent?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 288.67,
      "end_seconds": 301.01,
      "duration_seconds": 12.34,
      "text": "I understand the worry. At the moment I'd say it's vaginal thrush, and we'll know more once the a swab is back. I'm going to order a swab, for vaginal discharge."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 301.85,
      "end_seconds": 302.91,
      "duration_seconds": 1.06,
      "text": "Right, understood."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 304.77,
      "end_seconds": 323.22,
      "duration_seconds": 18.45,
      "text": "Let's book a urine test to look into dysuria. For this, clotrimazole pessary, 500 milligrams, once at night, for one day. That should help with thrush. It's a commonly used medicine and most people tolerate it well."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 324.06,
      "end_seconds": 326.89,
      "duration_seconds": 2.83,
      "text": "Alright, I'll pick it up today."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 327.67,
      "end_seconds": 341.5,
      "duration_seconds": 13.83,
      "text": "Wear cotton underwear and avoid scented soaps or washes. One warning sign to remember: the symptoms get worse. In that case don't wait. We'll catch up if it isn't better in a week."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 342.69,
      "end_seconds": 345.49,
      "duration_seconds": 2.8,
      "text": "Yes, um, that's manageable."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 347.27,
      "end_seconds": 353.23,
      "duration_seconds": 5.96,
      "text": "How would you describe the plan, so we're on the same page?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 355.2,
      "end_seconds": 367.29,
      "duration_seconds": 12.09,
      "text": "So, I take the clotrimazole pessary, 500 milligrams, once at night and come back if it isn't better in a week. Is that right?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 369.15,
      "end_seconds": 375.62,
      "duration_seconds": 6.47,
      "text": "Yes, exactly right. Is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 377.65,
      "end_seconds": 379.86,
      "duration_seconds": 2.21,
      "text": "Alright, thanks, take care."
    }
  ]
}