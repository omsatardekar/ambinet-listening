{
  "schema_version": "1.0",
  "encounter_id": "20408",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.59,
      "end_seconds": 4.23,
      "duration_seconds": 3.64,
      "text": "Sorry, doctor, shall I sit here?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.51,
      "end_seconds": 9.91,
      "duration_seconds": 4.4,
      "text": "Of course, leave it there. How can I help?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 11.51,
      "end_seconds": 29.14,
      "duration_seconds": 17.63,
      "text": "It's, It's a twisted ankle. I thought I'd wait, you know, but it hasn't gone. I'm not great at remembering details, so bear with me. My neighbour said I should get it looked at."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 29.89,
      "end_seconds": 33.31,
      "duration_seconds": 3.42,
      "text": "Has this been going on for long?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 35.06,
      "end_seconds": 47.72,
      "duration_seconds": 12.66,
      "text": "honestly I can't say exactly when it started it might have been last month or the month before, I really can't pin it down"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 48.48,
      "end_seconds": 51.18,
      "duration_seconds": 2.7,
      "text": "Right, is anything making it worse?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 52.91,
      "end_seconds": 70.56,
      "duration_seconds": 17.65,
      "text": "It's worse with putting weight on it. I've also had bruising, for five days. I've had pain walking too, for five days. Um, um, about pain walking, I'd call it mild."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 71.96,
      "end_seconds": 74.71,
      "duration_seconds": 2.75,
      "text": "I'll note down your vital signs first."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 88.15,
      "end_seconds": 90.68,
      "duration_seconds": 2.53,
      "text": "okay, this won't take long.."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 110.56,
      "end_seconds": 115.93,
      "duration_seconds": 5.37,
      "text": "okay: pressure 110 over 74, pulse is 66 beats a minute"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 117.59,
      "end_seconds": 122.0,
      "duration_seconds": 4.41,
      "text": "Alright, I'll examine you in a second, make yourself comfortable."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 123.0,
      "end_seconds": 125.88,
      "duration_seconds": 2.88,
      "text": "I'll listen to your chest now."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 136.45,
      "end_seconds": 147.64,
      "duration_seconds": 11.19,
      "text": "There is swelling and bruising over the outer ankle and I can't find any bony tenderness at the back of the ankle bone."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 150.46,
      "end_seconds": 152.17,
      "duration_seconds": 1.71,
      "text": "All finished, thank you."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 167.4,
      "end_seconds": 172.55,
      "duration_seconds": 5.15,
      "text": "Any pain at the base of the fifth toe or previous fracture?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 173.69,
      "end_seconds": 181.48,
      "duration_seconds": 7.79,
      "text": "no pain at the base of the fifth toe or previous fracture, none of it"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 182.23,
      "end_seconds": 186.96,
      "duration_seconds": 4.73,
      "text": "Have you noticed knee pain or cracking sound at the time?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 191.12,
      "end_seconds": 197.96,
      "duration_seconds": 6.84,
      "text": "no knee pain or cracking sound at the time, none of it"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 199.39,
      "end_seconds": 201.88,
      "duration_seconds": 2.49,
      "text": "Okay, any trouble with the waterworks?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 202.48,
      "end_seconds": 205.29,
      "duration_seconds": 2.81,
      "text": "Ah, no, that's all fine."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 206.12,
      "end_seconds": 208.63,
      "duration_seconds": 2.51,
      "text": "Have you been to theatre before?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 209.16,
      "end_seconds": 214.19,
      "duration_seconds": 5.03,
      "text": "Just a wisdom tooth extraction under sedation, five years ago."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 229.23,
      "end_seconds": 236.91,
      "duration_seconds": 7.68,
      "text": "Alright, which medicines do you take at the moment? It helps to be thorough at this stage."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 238.47,
      "end_seconds": 261.79,
      "duration_seconds": 23.32,
      "text": "I'm on Asthalin inhaler, when needed for my asthma. My family kept telling me to get it checked. Hydrocortisone cream. I take it when needed for the eczema. I'm on something called thyr... Thyronorm, 50 micrograms, maybe, every morning for my thyroid."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 262.45,
      "end_seconds": 267.05,
      "duration_seconds": 4.6,
      "text": "did you happen to bring the box or the paperwork?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 267.56,
      "end_seconds": 273.52,
      "duration_seconds": 5.96,
      "text": "no, it's at home. Ibuprofen i take it 400 milligrams, when needed"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 274.58,
      "end_seconds": 277.39,
      "duration_seconds": 2.81,
      "text": "Since when have you been taking it?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 282.07,
      "end_seconds": 284.25,
      "duration_seconds": 2.18,
      "text": "About three months now"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 285.19,
      "end_seconds": 287.56,
      "duration_seconds": 2.37,
      "text": "Do you have any long-term conditions?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 288.65,
      "end_seconds": 306.06,
      "duration_seconds": 17.41,
      "text": "I've had asthma for nearly five years now. I'd rather not end up on lots of tablets if I can avoid it. I have eczema. I've never really been one for hospitals."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 307.74,
      "end_seconds": 308.66,
      "duration_seconds": 0.92,
      "text": "mm, okay"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 310.25,
      "end_seconds": 322.05,
      "duration_seconds": 11.8,
      "text": "Well, yes, an underactive thyroid. I'm hoping you can tell me something definite. I didn't want to make a fuss, you know."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 324.03,
      "end_seconds": 325.4,
      "duration_seconds": 1.37,
      "text": "Okay, what else?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 329.11,
      "end_seconds": 337.92,
      "duration_seconds": 8.81,
      "text": "right, so asthma is already on your record we'll keep that in mind today now some background about your lifestyle"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 340.99,
      "end_seconds": 357.75,
      "duration_seconds": 16.76,
      "text": "I've never touched a cigarette. I'll have a glass of wine with dinner. I'm vegetarian and have been for years. I'm a bus driver, so I sit for long hours."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 358.84,
      "end_seconds": 362.17,
      "duration_seconds": 3.33,
      "text": "Okay, are there any illnesses in your family?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 363.86,
      "end_seconds": 370.95,
      "duration_seconds": 7.09,
      "text": "um, um, my father has Parkinson's disease my uncle has high cholesterol"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 378.01,
      "end_seconds": 381.38,
      "duration_seconds": 3.37,
      "text": "let me ask about allergies, anything at all?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 381.89,
      "end_seconds": 386.02,
      "duration_seconds": 4.13,
      "text": "Yes, diclofenac. I get swelling of my lips."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 387.63,
      "end_seconds": 413.68,
      "duration_seconds": 26.05,
      "text": "Right, here's what I'm thinking. I don't have a clear answer today: an ankle sprain without signs of a fracture is possible, and so is a small fracture. Stop me if I've got anything wrong. You've had a twisted ankle, and no pain at the base of the fifth toe or knee pain."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 415.38,
      "end_seconds": 416.08,
      "duration_seconds": 0.7,
      "text": "Correct."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 417.43,
      "end_seconds": 421.93,
      "duration_seconds": 4.5,
      "text": "I'll request an ankle X-ray, it'll help with ankle injury"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 423.18,
      "end_seconds": 427.21,
      "duration_seconds": 4.03,
      "text": "I can book that that for Thursday at 9 am"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 428.7,
      "end_seconds": 460.83,
      "duration_seconds": 32.13,
      "text": "we'll begin with paracetamol, 1 gram, every six hours if needed, for five days. You take it by mouth. That should help with ankle pain. Rest, ice, a firm bandage and keep it raised, and start gentle movement after two days. I think physiotherapy should see you too. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose. See me again if it isn't better in a week"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 462.41,
      "end_seconds": 464.55,
      "duration_seconds": 2.14,
      "text": "alright, I'll be back"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 466.02,
      "end_seconds": 470.63,
      "duration_seconds": 4.61,
      "text": "right, that's the plan do you wanna ask me anything?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 471.4,
      "end_seconds": 475.27,
      "duration_seconds": 3.87,
      "text": "right, no, that's all. Thanks a lot"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 476.72,
      "end_seconds": 477.89,
      "duration_seconds": 1.17,
      "text": "See you soon."
    }
  ]
}