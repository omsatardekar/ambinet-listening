{
  "schema_version": "1.0",
  "encounter_id": "20298",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.26,
      "end_seconds": 4.2,
      "duration_seconds": 2.94,
      "text": "Okay, afternoon, thanks for coming in."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 5.73,
      "end_seconds": 6.8,
      "duration_seconds": 1.07,
      "text": "Hello, doctor."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 8.63,
      "end_seconds": 11.27,
      "duration_seconds": 2.64,
      "text": "Tell me what's brought you in."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 14.95,
      "end_seconds": 31.22,
      "duration_seconds": 16.27,
      "text": "Right, um, mainly burning pain in the upper tummy. There's a couple of other things, but that's the main one. I just want to get back to normal, really."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 32.22,
      "end_seconds": 34.46,
      "duration_seconds": 2.24,
      "text": "How frequently does it come?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 36.05,
      "end_seconds": 39.02,
      "duration_seconds": 2.97,
      "text": "It, It happens every other day."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 40.25,
      "end_seconds": 42.59,
      "duration_seconds": 2.34,
      "text": "Any other symptoms with it?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 43.53,
      "end_seconds": 46.41,
      "duration_seconds": 2.88,
      "text": "It usually comes with mild nausea."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 46.93,
      "end_seconds": 47.74,
      "duration_seconds": 0.81,
      "text": "Mm-hmm."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 48.74,
      "end_seconds": 52.56,
      "duration_seconds": 3.82,
      "text": "I'd been belching, but that went away."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 56.6,
      "end_seconds": 64.13,
      "duration_seconds": 7.53,
      "text": "Have you had burning pain in the upper tummy before, or is this the first time?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 64.85,
      "end_seconds": 69.85,
      "duration_seconds": 5.0,
      "text": "I had a similar thing last year. It went away."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 71.8,
      "end_seconds": 73.82,
      "duration_seconds": 2.02,
      "text": "Any surgery in the past?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 74.89,
      "end_seconds": 80.15,
      "duration_seconds": 5.26,
      "text": "I had a meniscus repair on my knee four years ago."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 81.98,
      "end_seconds": 83.45,
      "duration_seconds": 1.47,
      "text": "Do you smoke?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 84.84,
      "end_seconds": 88.34,
      "duration_seconds": 3.5,
      "text": "I quit smoking around ten years ago."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 89.48,
      "end_seconds": 90.93,
      "duration_seconds": 1.45,
      "text": "What's your work?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 91.66,
      "end_seconds": 96.25,
      "duration_seconds": 4.59,
      "text": "I'm a plumber, lots of bending and kneeling."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 97.7,
      "end_seconds": 99.61,
      "duration_seconds": 1.91,
      "text": "Who lives with you?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 101.22,
      "end_seconds": 103.73,
      "duration_seconds": 2.51,
      "text": "My partner and our baby."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 104.89,
      "end_seconds": 108.79,
      "duration_seconds": 3.9,
      "text": "Which medicines do you take at the moment?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 109.93,
      "end_seconds": 116.46,
      "duration_seconds": 6.53,
      "text": "Pantoprazole, 40 milligrams, before breakfast for my acidity. Antacid, when needed."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 134.86,
      "end_seconds": 138.97,
      "duration_seconds": 4.11,
      "text": "Are there any allergies I should be aware of?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 139.62,
      "end_seconds": 145.28,
      "duration_seconds": 5.66,
      "text": "Yes, nickel, it gives me a rash on my skin."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 146.35,
      "end_seconds": 150.11,
      "duration_seconds": 3.76,
      "text": "So, has anyone ever diagnosed you with something?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 151.72,
      "end_seconds": 156.11,
      "duration_seconds": 4.39,
      "text": "Yeah, I have acid reflux, for about a year."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 157.2,
      "end_seconds": 162.5,
      "duration_seconds": 5.3,
      "text": "Okay, I can see acid reflux in your file as well."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 175.15,
      "end_seconds": 179.91,
      "duration_seconds": 4.76,
      "text": "Alright, any difficulty swallowing, weight loss or vomiting blood at all?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 180.97,
      "end_seconds": 187.3,
      "duration_seconds": 6.33,
      "text": "I haven't had difficulty swallowing, weight loss or vomiting blood, no."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 188.77,
      "end_seconds": 190.06,
      "duration_seconds": 1.29,
      "text": "Any chest pain?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 191.32,
      "end_seconds": 194.34,
      "duration_seconds": 3.02,
      "text": "Not at all, no chest pain."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 196.03,
      "end_seconds": 198.47,
      "duration_seconds": 2.44,
      "text": "Anything different when you pass water?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 199.26,
      "end_seconds": 202.51,
      "duration_seconds": 3.25,
      "text": "That's normal as far as I know."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 203.31,
      "end_seconds": 205.82,
      "duration_seconds": 2.51,
      "text": "And your skin, any changes there?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 207.51,
      "end_seconds": 208.45,
      "duration_seconds": 0.94,
      "text": "Skin's normal."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 210.1,
      "end_seconds": 213.64,
      "duration_seconds": 3.54,
      "text": "Time for your numbers, if that's okay."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 220.8,
      "end_seconds": 223.38,
      "duration_seconds": 2.58,
      "text": "Okay, this won't take long..."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 240.95,
      "end_seconds": 250.68,
      "duration_seconds": 9.73,
      "text": "Okay: temperature 36.8, saturation 97 percent, blood pressure 127 over 76. And heart rate 67, respiratory rate 18."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 252.49,
      "end_seconds": 254.45,
      "duration_seconds": 1.96,
      "text": "Shall I start the examination?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 256.24,
      "end_seconds": 259.47,
      "duration_seconds": 3.23,
      "text": "Stay as you are for a moment."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 270.83,
      "end_seconds": 276.58,
      "duration_seconds": 5.75,
      "text": "Your tummy is soft with some tenderness in the upper middle part."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 278.84,
      "end_seconds": 280.44,
      "duration_seconds": 1.6,
      "text": "That's the examination finished."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 298.14,
      "end_seconds": 308.03,
      "duration_seconds": 9.89,
      "text": "Let me tell you where I've got to. This looks most like dyspepsia possibly related to anti-inflammatory tablets. We shouldn't forget a stomach ulcer."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 309.27,
      "end_seconds": 313.65,
      "duration_seconds": 4.38,
      "text": "I mean, what are the odds it's serious?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 315.07,
      "end_seconds": 335.05,
      "duration_seconds": 19.98,
      "text": "I understand the worry. At the moment I'd say it's dyspepsia possibly related to anti-inflammatory tablets, and we'll know more once the blood tests is back. We should do blood tests for dyspepsia. Please stop taking the anti-inflammatory tablets for now and use paracetamol for the pain."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 335.26,
      "end_seconds": 349.23,
      "duration_seconds": 13.97,
      "text": "Mm-hmm. Don't skip meals, and try to eat smaller portions more often through the day. See me again after the test result. Does all of that make sense?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 350.73,
      "end_seconds": 352.81,
      "duration_seconds": 2.08,
      "text": "Thank you, doctor, goodbye."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 353.59,
      "end_seconds": 355.34,
      "duration_seconds": 1.75,
      "text": "Okay, look after yourself."
    }
  ]
}