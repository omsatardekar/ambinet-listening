{
  "schema_version": "1.0",
  "encounter_id": "20433",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.6,
      "end_seconds": 5.72,
      "duration_seconds": 5.12,
      "text": "I mean, hi, is it okay to come in now?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.05,
      "end_seconds": 12.07,
      "duration_seconds": 5.02,
      "text": "You're alright, take a seat. What can I do for you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 14.61,
      "end_seconds": 22.98,
      "duration_seconds": 8.37,
      "text": "Mainly nausea and vomiting. There's a couple of other things, but that's the main one."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 23.75,
      "end_seconds": 26.55,
      "duration_seconds": 2.8,
      "text": "How long has it been like this?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 27.45,
      "end_seconds": 29.65,
      "duration_seconds": 2.2,
      "text": "Probably three days. Yeah."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 31.1,
      "end_seconds": 34.42,
      "duration_seconds": 3.32,
      "text": "Would you say mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 35.99,
      "end_seconds": 39.25,
      "duration_seconds": 3.26,
      "text": "Hmm, I'd call it severe."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 39.45,
      "end_seconds": 45.32,
      "duration_seconds": 5.87,
      "text": "Mm, okay. Is it there all the time or does it come and go?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 47.26,
      "end_seconds": 49.23,
      "duration_seconds": 1.97,
      "text": "Honestly, every other day."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 53.69,
      "end_seconds": 56.67,
      "duration_seconds": 2.98,
      "text": "Any weakness, slurred speech or double vision?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 60.29,
      "end_seconds": 64.32,
      "duration_seconds": 4.03,
      "text": "No, no weakness, slurred speech or double vision."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 67.91,
      "end_seconds": 72.4,
      "duration_seconds": 4.49,
      "text": "Alright, anything on the skin I should know about?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 74.19,
      "end_seconds": 75.17,
      "duration_seconds": 0.98,
      "text": "Skin's normal."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 77.23,
      "end_seconds": 80.9,
      "duration_seconds": 3.67,
      "text": "Any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 82.22,
      "end_seconds": 83.99,
      "duration_seconds": 1.77,
      "text": "No, no conditions."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 94.66,
      "end_seconds": 98.49,
      "duration_seconds": 3.83,
      "text": "Is there anything relevant on the family side?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 100.09,
      "end_seconds": 102.48,
      "duration_seconds": 2.39,
      "text": "My uncle has high cholesterol."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 107.81,
      "end_seconds": 110.11,
      "duration_seconds": 2.3,
      "text": "Do you live by yourself?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 111.18,
      "end_seconds": 115.02,
      "duration_seconds": 3.84,
      "text": "No, I share a house with my brother."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 116.89,
      "end_seconds": 121.1,
      "duration_seconds": 4.21,
      "text": "What does a normal day of food look like?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 123.11,
      "end_seconds": 126.81,
      "duration_seconds": 3.7,
      "text": "Lots of rice, lentils and some fruit."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 140.92,
      "end_seconds": 144.38,
      "duration_seconds": 3.46,
      "text": "Okay, are you on any regular medication?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 145.06,
      "end_seconds": 148.62,
      "duration_seconds": 3.56,
      "text": "I mean, no, nothing at the moment."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 149.66,
      "end_seconds": 152.19,
      "duration_seconds": 2.53,
      "text": "Have you got any known allergies?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 158.5,
      "end_seconds": 160.54,
      "duration_seconds": 2.04,
      "text": "No allergies at all."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 173.97,
      "end_seconds": 177.81,
      "duration_seconds": 3.84,
      "text": "Alright, shall I check your blood pressure and pulse?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 184.17,
      "end_seconds": 186.88,
      "duration_seconds": 2.71,
      "text": "Keep your arm relaxed for me..."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 198.72,
      "end_seconds": 207.95,
      "duration_seconds": 9.23,
      "text": "Okay: blood pressure 114 over 79, SpO2 97 percent on room air, pulse 65, temperature is 36.5 degrees."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 209.15,
      "end_seconds": 210.78,
      "duration_seconds": 1.63,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 215.01,
      "end_seconds": 217.6,
      "duration_seconds": 2.59,
      "text": "I'll come back to the numbers."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 219.43,
      "end_seconds": 223.16,
      "duration_seconds": 3.73,
      "text": "I'll examine you in a second, make yourself comfortable."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 224.33,
      "end_seconds": 225.6,
      "duration_seconds": 1.27,
      "text": "Does that hurt?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 236.44,
      "end_seconds": 244.61,
      "duration_seconds": 8.17,
      "text": "I can see a fine jerking of the eyes to the left and your walking is a little unsteady."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 245.43,
      "end_seconds": 246.33,
      "duration_seconds": 0.9,
      "text": "That's alright."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 251.0,
      "end_seconds": 252.58,
      "duration_seconds": 1.58,
      "text": "Please sit back down."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 265.81,
      "end_seconds": 294.78,
      "duration_seconds": 28.97,
      "text": "Let me tell you where I've got to. It points towards an inner-ear balance problem such as vestibular neuritis. Blood tests is what I'd like next, for dizziness. For this, prochlorperazine, 5 milligrams, three times a day, for three days. It's for nausea and vertigo. Start moving around gently as soon as you can, since resting too long slows recovery."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 295.52,
      "end_seconds": 315.54,
      "duration_seconds": 20.02,
      "text": "Let's hold off on a positional test for now, and if there's no change in two weeks we can revisit it. We'll catch up if it isn't settling in five days. Is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 317.41,
      "end_seconds": 318.94,
      "duration_seconds": 1.53,
      "text": "That's clear, thanks."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 320.59,
      "end_seconds": 321.89,
      "duration_seconds": 1.3,
      "text": "See you soon."
    }
  ]
}