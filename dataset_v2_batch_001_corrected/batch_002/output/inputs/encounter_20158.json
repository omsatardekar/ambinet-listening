{
  "schema_version": "1.0",
  "encounter_id": "20158",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.24,
      "end_seconds": 5.09,
      "duration_seconds": 3.85,
      "text": "Oh, hi doctor, am I too early?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.91,
      "end_seconds": 11.11,
      "duration_seconds": 4.2,
      "text": "That's fine, sit down. Tell me why you came."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 12.71,
      "end_seconds": 26.2,
      "duration_seconds": 13.49,
      "text": "Okay, uh, so mainly swollen ankles. There's a couple of other things, but that's the main one. I thought it would sort itself out, but it hasn't."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 28.03,
      "end_seconds": 29.81,
      "duration_seconds": 1.78,
      "text": "When did this begin?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 31.11,
      "end_seconds": 33.91,
      "duration_seconds": 2.8,
      "text": "Probably about a year. Yeah."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 34.46,
      "end_seconds": 44.2,
      "duration_seconds": 9.74,
      "text": "Tell me a bit more about it: how bad it gets, how often, and whether anything makes it better or worse."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 44.77,
      "end_seconds": 54.01,
      "duration_seconds": 9.24,
      "text": "Mostly moderate. Honestly, once or twice a day. I didn't want to make a fuss, you know."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 54.62,
      "end_seconds": 57.57,
      "duration_seconds": 2.95,
      "text": "Do you have any chronic illnesses?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 58.59,
      "end_seconds": 61.45,
      "duration_seconds": 2.86,
      "text": "I, I have heart failure."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 62.23,
      "end_seconds": 63.04,
      "duration_seconds": 0.81,
      "text": "Any smoking?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 63.88,
      "end_seconds": 66.13,
      "duration_seconds": 2.25,
      "text": "I've never touched a cigarette."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 68.08,
      "end_seconds": 70.07,
      "duration_seconds": 1.99,
      "text": "And alcohol, how much?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 72.08,
      "end_seconds": 73.55,
      "duration_seconds": 1.47,
      "text": "Nothing, I'm teetotal."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 74.77,
      "end_seconds": 76.25,
      "duration_seconds": 1.48,
      "text": "And your job?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 77.49,
      "end_seconds": 81.18,
      "duration_seconds": 3.69,
      "text": "I work in accounts at a hospital."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 81.73,
      "end_seconds": 83.45,
      "duration_seconds": 1.72,
      "text": "Who lives with you?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 84.97,
      "end_seconds": 87.48,
      "duration_seconds": 2.51,
      "text": "My partner and our baby."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 88.3,
      "end_seconds": 90.98,
      "duration_seconds": 2.68,
      "text": "Do you follow any particular diet?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 92.88,
      "end_seconds": 96.63,
      "duration_seconds": 3.75,
      "text": "I'm vegetarian and have been for years."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 97.31,
      "end_seconds": 102.11,
      "duration_seconds": 4.8,
      "text": "Are you allergic to anything? Any allergies to medicines or foods?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 103.13,
      "end_seconds": 106.08,
      "duration_seconds": 2.95,
      "text": "Yes, kiwi, it gives me hives."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 116.64,
      "end_seconds": 119.06,
      "duration_seconds": 2.42,
      "text": "Let's run through your medicines."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 120.73,
      "end_seconds": 125.73,
      "duration_seconds": 5.0,
      "text": "Metoprolol. I take it 50 milligrams, twice a day."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 144.0,
      "end_seconds": 148.6,
      "duration_seconds": 4.6,
      "text": "And what about cough with blood, fever, fainting or calf pain?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 150.44,
      "end_seconds": 156.35,
      "duration_seconds": 5.91,
      "text": "I haven't had cough with blood, fever, fainting or calf pain, no."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 158.12,
      "end_seconds": 160.08,
      "duration_seconds": 1.96,
      "text": "Anything unusual with passing urine?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 161.19,
      "end_seconds": 163.19,
      "duration_seconds": 2.0,
      "text": "No, that's all fine."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 165.36,
      "end_seconds": 169.44,
      "duration_seconds": 4.08,
      "text": "Alright, over here please and I'll take a look."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 170.91,
      "end_seconds": 173.85,
      "duration_seconds": 2.94,
      "text": "Stay as you are for a moment."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 182.13,
      "end_seconds": 184.3,
      "duration_seconds": 2.17,
      "text": "Your neck veins look raised."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 186.18,
      "end_seconds": 189.16,
      "duration_seconds": 2.98,
      "text": "Stay as you are for a moment."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 202.7,
      "end_seconds": 206.84,
      "duration_seconds": 4.14,
      "text": "I can hear crackles at the bases of both lungs."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 210.3,
      "end_seconds": 212.69,
      "duration_seconds": 2.39,
      "text": "Okay, all finished, thank you."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 228.99,
      "end_seconds": 234.36,
      "duration_seconds": 5.37,
      "text": "Putting it all together, it points towards fluid overload from heart failure."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 249.73,
      "end_seconds": 281.09,
      "duration_seconds": 31.36,
      "text": "Let's book blood tests to look into fluid overload. For this, furosemide, 40 milligrams, every morning, long term. That's for fluid retention. Keep the salt low and avoid adding it at the table. If you smoke, this is a good moment to think about stopping, and we can help you with that. Let's hold off on a chest X-ray for now, and if there's no change next month we can revisit it."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 281.6,
      "end_seconds": 289.98,
      "duration_seconds": 8.38,
      "text": "Come back or go to emergency straight away if you become more breathless or gain weight quickly."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 291.01,
      "end_seconds": 292.03,
      "duration_seconds": 1.02,
      "text": "I understand."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 297.2,
      "end_seconds": 300.44,
      "duration_seconds": 3.24,
      "text": "Let's plan a check after the heart scan."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 301.45,
      "end_seconds": 303.69,
      "duration_seconds": 2.24,
      "text": "Alright, I'll be back."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 305.07,
      "end_seconds": 309.5,
      "duration_seconds": 4.43,
      "text": "Is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 310.98,
      "end_seconds": 314.05,
      "duration_seconds": 3.07,
      "text": "No, that's all. Thanks a lot."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 315.44,
      "end_seconds": 316.62,
      "duration_seconds": 1.18,
      "text": "Look after yourself."
    }
  ]
}