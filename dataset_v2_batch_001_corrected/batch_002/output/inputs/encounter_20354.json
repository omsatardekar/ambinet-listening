{
  "schema_version": "1.0",
  "encounter_id": "20354",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.1,
      "end_seconds": 3.64,
      "duration_seconds": 2.54,
      "text": "Good afternoon, how are you today?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 4.48,
      "end_seconds": 5.72,
      "duration_seconds": 1.24,
      "text": "Hi, thanks."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 6.63,
      "end_seconds": 8.84,
      "duration_seconds": 2.21,
      "text": "What's the main thing today?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 10.09,
      "end_seconds": 16.68,
      "duration_seconds": 6.59,
      "text": "Yeah, I'm here because of some chest discomfort when I climb stairs."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 17.45,
      "end_seconds": 20.16,
      "duration_seconds": 2.71,
      "text": "Let me quickly check your readings."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 29.56,
      "end_seconds": 31.69,
      "duration_seconds": 2.13,
      "text": "Nearly done with the readings..."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 52.82,
      "end_seconds": 61.19,
      "duration_seconds": 8.37,
      "text": "Okay: pressure 108 over 76, saturation 97 percent, heart rate 77. How long has this been bothering you?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 62.67,
      "end_seconds": 69.43,
      "duration_seconds": 6.76,
      "text": "About three months, I think... sorry, six months, I got that wrong."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 71.01,
      "end_seconds": 79.29,
      "duration_seconds": 8.28,
      "text": "Can you describe it a bit more for me? How strong it is, what the pattern is, what helps."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 80.42,
      "end_seconds": 87.12,
      "duration_seconds": 6.7,
      "text": "I notice it more with stairs. I get some relief from resting. Mild, really."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 101.82,
      "end_seconds": 105.84,
      "duration_seconds": 4.02,
      "text": "Any pain at rest, breathlessness or blood in the urine?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 107.14,
      "end_seconds": 110.47,
      "duration_seconds": 3.33,
      "text": "No, I haven't had any of them."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 110.73,
      "end_seconds": 115.65,
      "duration_seconds": 4.92,
      "text": "Yes, carry on. Any muscle or joint problems besides this?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 117.04,
      "end_seconds": 118.57,
      "duration_seconds": 1.53,
      "text": "No, nothing there."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 127.99,
      "end_seconds": 130.42,
      "duration_seconds": 2.43,
      "text": "What's on your current medicine list?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 132.12,
      "end_seconds": 135.8,
      "duration_seconds": 3.68,
      "text": "It's clopidogrel, 75 milligrams, once a day."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 136.33,
      "end_seconds": 139.82,
      "duration_seconds": 3.49,
      "text": "I follow. Before we go further, any allergies?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 141.31,
      "end_seconds": 144.36,
      "duration_seconds": 3.05,
      "text": "No, I'm not allergic to anything."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 156.57,
      "end_seconds": 158.98,
      "duration_seconds": 2.41,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 159.72,
      "end_seconds": 162.01,
      "duration_seconds": 2.29,
      "text": "No, not at all."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 166.31,
      "end_seconds": 169.58,
      "duration_seconds": 3.27,
      "text": "Any health conditions I should have on record?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 170.81,
      "end_seconds": 172.9,
      "duration_seconds": 2.09,
      "text": "I have heart disease."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 174.69,
      "end_seconds": 177.51,
      "duration_seconds": 2.82,
      "text": "What do you do during the day?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 182.33,
      "end_seconds": 186.3,
      "duration_seconds": 3.97,
      "text": "I look after my grandchildren most days."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 187.12,
      "end_seconds": 188.74,
      "duration_seconds": 1.62,
      "text": "How are your meals?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 189.24,
      "end_seconds": 193.53,
      "duration_seconds": 4.29,
      "text": "I grab fast food at lunch most days."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 195.16,
      "end_seconds": 199.46,
      "duration_seconds": 4.3,
      "text": "I'd like to check you over now, if that's alright."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 200.65,
      "end_seconds": 202.73,
      "duration_seconds": 2.08,
      "text": "So, breathe out slowly."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 218.81,
      "end_seconds": 222.59,
      "duration_seconds": 3.78,
      "text": "There are a few small bruises on your forearms."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 223.71,
      "end_seconds": 226.25,
      "duration_seconds": 2.54,
      "text": "Take a deep breath for me."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 242.4,
      "end_seconds": 246.36,
      "duration_seconds": 3.96,
      "text": "Heart sounds are normal and your chest is clear."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 252.33,
      "end_seconds": 254.15,
      "duration_seconds": 1.82,
      "text": "You can relax now."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 261.33,
      "end_seconds": 274.39,
      "duration_seconds": 13.06,
      "text": "Okay, thinking it through, my working impression is stable coronary disease on antiplatelet treatment, with minor bleeding. The reason I say that is that your story and my examination fit together."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 275.02,
      "end_seconds": 277.06,
      "duration_seconds": 2.04,
      "text": "Is this serious, doctor?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 277.82,
      "end_seconds": 306.29,
      "duration_seconds": 28.47,
      "text": "Nothing I've seen today points to an emergency. It looks like stable coronary disease on antiplatelet treatment, with minor bleeding. Let's use pantoprazole, 40 milligrams, before breakfast, long term. That should help with stomach protection. One warning sign to remember: you pass black stools or have prolonged bleeding. In that case don't wait. Come back in six weeks. So, that's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 307.04,
      "end_seconds": 310.1,
      "duration_seconds": 3.06,
      "text": "Great, thank you for your help."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 311.39,
      "end_seconds": 312.65,
      "duration_seconds": 1.26,
      "text": "See you soon."
    }
  ]
}