{
  "schema_version": "1.0",
  "encounter_id": "20338",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.07,
      "end_seconds": 6.0,
      "duration_seconds": 4.93,
      "text": "Hi, doctor, I came as soon as they called me."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.04,
      "end_seconds": 11.66,
      "duration_seconds": 3.62,
      "text": "No problem at all, come in. What's troubling you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 12.22,
      "end_seconds": 15.1,
      "duration_seconds": 2.88,
      "text": "I'm here because of night sweats."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 17.11,
      "end_seconds": 19.1,
      "duration_seconds": 1.99,
      "text": "Did it come on recently?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 19.6,
      "end_seconds": 24.84,
      "duration_seconds": 5.24,
      "text": "Around two years... no wait, it's more like nearly five years."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 26.85,
      "end_seconds": 34.57,
      "duration_seconds": 7.72,
      "text": "Can you describe it a bit more for me? How strong it is, what the pattern is, what helps."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 36.56,
      "end_seconds": 43.94,
      "duration_seconds": 7.38,
      "text": "it's all the time i'd call it moderate i've also had irregular periods, for two years"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 45.51,
      "end_seconds": 49.42,
      "duration_seconds": 3.91,
      "text": "Let me get the readings out of the way."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 63.01,
      "end_seconds": 65.95,
      "duration_seconds": 2.94,
      "text": "That's it, just a little longer..."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 87.31,
      "end_seconds": 97.56,
      "duration_seconds": 10.25,
      "text": "Okay: temp 36.7 degrees, pulse 74. And BP is 126 over 71, respiratory rate 18, SpO2 99 percent on room air."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 98.77,
      "end_seconds": 102.71,
      "duration_seconds": 3.94,
      "text": "Alright, could you come over to the couch, please?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 104.62,
      "end_seconds": 106.03,
      "duration_seconds": 1.41,
      "text": "does that hurt?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 122.65,
      "end_seconds": 128.89,
      "duration_seconds": 6.24,
      "text": "Blood pressure and pulse are fine and there are no breast lumps on examination"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 132.02,
      "end_seconds": 138.67,
      "duration_seconds": 6.65,
      "text": "Thank you, you can get dressed. A few quick ones: weight loss, chest pain or palpitations?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 143.44,
      "end_seconds": 146.12,
      "duration_seconds": 2.68,
      "text": "no, nothing to report there"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 147.22,
      "end_seconds": 150.15,
      "duration_seconds": 2.93,
      "text": "Any breathing difficulties apart from this?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 154.76,
      "end_seconds": 155.7,
      "duration_seconds": 0.94,
      "text": "Breathing's normal."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 157.48,
      "end_seconds": 161.32,
      "duration_seconds": 3.84,
      "text": "How about your heart, any problems like that?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 163.17,
      "end_seconds": 169.24,
      "duration_seconds": 6.07,
      "text": "my heart's been fine, you know, as far as I know"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 183.0,
      "end_seconds": 188.06,
      "duration_seconds": 5.06,
      "text": "Alright, any inherited conditions that you know of in the family?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 189.87,
      "end_seconds": 193.37,
      "duration_seconds": 3.5,
      "text": "hmm, my grandfather had a stroke"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 195.18,
      "end_seconds": 197.0,
      "duration_seconds": 1.82,
      "text": "Who lives with you?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 198.09,
      "end_seconds": 200.58,
      "duration_seconds": 2.49,
      "text": "My partner and our baby."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 202.64,
      "end_seconds": 206.57,
      "duration_seconds": 3.93,
      "text": "What does a normal day of food look like?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 207.72,
      "end_seconds": 211.66,
      "duration_seconds": 3.94,
      "text": "Lots of rice, lentils and some fruit"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 221.58,
      "end_seconds": 224.9,
      "duration_seconds": 3.32,
      "text": "is there any regular medication you use?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 226.01,
      "end_seconds": 227.22,
      "duration_seconds": 1.21,
      "text": "No, none."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 227.99,
      "end_seconds": 231.95,
      "duration_seconds": 3.96,
      "text": "Tell me about any past illnesses or ongoing conditions."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 233.01,
      "end_seconds": 234.63,
      "duration_seconds": 1.62,
      "text": "Yes, thin bones."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 245.86,
      "end_seconds": 258.66,
      "duration_seconds": 12.8,
      "text": "okay, thinking it through, I think we're dealing with perimenopausal symptoms at this stage. That's my thinking for now, and it may change as we learn more"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 271.88,
      "end_seconds": 299.59,
      "duration_seconds": 27.71,
      "text": "I'd like to arrange a bone density scan for menopause bone health. I'd rather check than guess, and this is the quickest way to know more. Layers of clothing, a fan by the bed, and cutting down on caffeine and spicy food can help the flushes. Cut back on tea, coffee and fizzy drinks for a couple of weeks and see how things settle."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 299.99,
      "end_seconds": 302.8,
      "duration_seconds": 2.81,
      "text": "ah come back after the blood tests"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 304.18,
      "end_seconds": 304.88,
      "duration_seconds": 0.7,
      "text": "Right."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 305.87,
      "end_seconds": 308.77,
      "duration_seconds": 2.9,
      "text": "have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 310.39,
      "end_seconds": 312.66,
      "duration_seconds": 2.27,
      "text": "Thank you, doctor, goodbye."
    }
  ]
}