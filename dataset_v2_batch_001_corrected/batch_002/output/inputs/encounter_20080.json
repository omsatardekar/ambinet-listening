{
  "schema_version": "1.0",
  "encounter_id": "20080",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.05,
      "end_seconds": 6.21,
      "duration_seconds": 5.16,
      "text": "Ah, hello? Doctor? I was told to come in."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.6,
      "end_seconds": 12.66,
      "duration_seconds": 5.06,
      "text": "Yes, come in and sit down. What brings you here today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 14.33,
      "end_seconds": 19.92,
      "duration_seconds": 5.59,
      "text": "So, I've been losing weight despite eating well, doctor."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 21.35,
      "end_seconds": 25.04,
      "duration_seconds": 3.69,
      "text": "So, has this been going on for long?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 28.59,
      "end_seconds": 42.54,
      "duration_seconds": 13.95,
      "text": "Hmm, for about a year, I'd say. I mean, uh, I did have loose stools at one point, but that's gone now."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 44.34,
      "end_seconds": 50.63,
      "duration_seconds": 6.29,
      "text": "Have you got any known allergies? It helps to be thorough at this stage."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 52.34,
      "end_seconds": 56.36,
      "duration_seconds": 4.02,
      "text": "Diclofenac. I come out in... well, wheezing."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 67.68,
      "end_seconds": 71.76,
      "duration_seconds": 4.08,
      "text": "Let's talk a little about your daily life and habits."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 72.59,
      "end_seconds": 98.26,
      "duration_seconds": 25.67,
      "text": "No, I've never smoked in my life. I used to drink heavily but I stopped four years ago. I grab fast food at lunch most days. I do a yoga class on Thursdays. I retired from the post office two years ago."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 99.5,
      "end_seconds": 100.7,
      "duration_seconds": 1.2,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 102.76,
      "end_seconds": 107.85,
      "duration_seconds": 5.09,
      "text": "Nothing, you know, I haven't had any operations."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 109.3,
      "end_seconds": 113.2,
      "duration_seconds": 3.9,
      "text": "Has anyone in your family had anything serious?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 114.74,
      "end_seconds": 117.25,
      "duration_seconds": 2.51,
      "text": "My grandfather had a stroke."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 126.18,
      "end_seconds": 129.41,
      "duration_seconds": 3.23,
      "text": "Has anyone ever diagnosed you with something?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 130.04,
      "end_seconds": 133.42,
      "duration_seconds": 3.38,
      "text": "I've had high blood pressure, yes."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 134.29,
      "end_seconds": 137.65,
      "duration_seconds": 3.36,
      "text": "What do you take on a normal day?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 138.81,
      "end_seconds": 144.16,
      "duration_seconds": 5.35,
      "text": "Actually, I'm on lisinopril, 10 milligrams, once a day."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 159.6,
      "end_seconds": 164.6,
      "duration_seconds": 5.0,
      "text": "Have you had any double vision, neck swelling or eye pain?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 170.13,
      "end_seconds": 178.25,
      "duration_seconds": 8.12,
      "text": "Erm, you know, no double vision, neck swelling or eye pain, none of it."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 179.7,
      "end_seconds": 182.17,
      "duration_seconds": 2.47,
      "text": "Has there been any fainting?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 183.62,
      "end_seconds": 187.06,
      "duration_seconds": 3.44,
      "text": "Erm, no, none, no fainting."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 187.36,
      "end_seconds": 189.91,
      "duration_seconds": 2.55,
      "text": "Yes. Is your mobility otherwise okay?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 190.63,
      "end_seconds": 193.6,
      "duration_seconds": 2.97,
      "text": "No, you know, nothing there."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 194.3,
      "end_seconds": 196.68,
      "duration_seconds": 2.38,
      "text": "I'll do your observations first."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 207.91,
      "end_seconds": 210.69,
      "duration_seconds": 2.78,
      "text": "Bear with me while this finishes..."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 224.88,
      "end_seconds": 233.59,
      "duration_seconds": 8.71,
      "text": "Okay: pulse 104, pressure 122 over 88. And respiratory rate 17, SpO2 99 percent on room air, temperature 36.6."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 235.29,
      "end_seconds": 236.75,
      "duration_seconds": 1.46,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 238.05,
      "end_seconds": 241.98,
      "duration_seconds": 3.93,
      "text": "Alright, I'll explain what these mean in a moment."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 244.56,
      "end_seconds": 248.56,
      "duration_seconds": 4.0,
      "text": "Let me look at the area, I'll be gentle."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 250.08,
      "end_seconds": 252.21,
      "duration_seconds": 2.13,
      "text": "Tell me if that's sore."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 270.57,
      "end_seconds": 275.62,
      "duration_seconds": 5.05,
      "text": "There is a smooth, small swelling at the front of the neck."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 277.58,
      "end_seconds": 279.73,
      "duration_seconds": 2.15,
      "text": "Tell me if that's sore."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 294.17,
      "end_seconds": 301.83,
      "duration_seconds": 7.66,
      "text": "There is a fine tremor of the outstretched hands and the pulse is fast and regular."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 302.72,
      "end_seconds": 304.31,
      "duration_seconds": 1.59,
      "text": "Yeah, no problem."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 306.61,
      "end_seconds": 325.06,
      "duration_seconds": 18.45,
      "text": "All finished, thank you. Taking everything into account, this looks most like an overactive thyroid. Let me just check I've got this right. You've been losing weight despite eating well for about a year, and no double vision or neck swelling."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 326.56,
      "end_seconds": 327.26,
      "duration_seconds": 0.7,
      "text": "Correct."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 333.36,
      "end_seconds": 366.47,
      "duration_seconds": 33.11,
      "text": "I'm sending you for a thyroid scan because of neck swelling. I'm going to order an ECG, for palpitations. I'd like to arrange thyroid blood tests for palpitations and weight loss. I'll start you on propranolol, 20 milligrams, twice a day, until review. That's for racing heart and tremor. Try to avoid caffeine while we sort this out. I'm going to send a referral to the endocrine clinic."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 367.44,
      "end_seconds": 379.31,
      "duration_seconds": 11.87,
      "text": "Please don't wait if the symptoms get worse. That's when to be seen urgently. I'd like you back after the thyroid results. I think we're done unless you have questions."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 380.39,
      "end_seconds": 383.62,
      "duration_seconds": 3.23,
      "text": "So, thank you, that's helpful."
    }
  ]
}