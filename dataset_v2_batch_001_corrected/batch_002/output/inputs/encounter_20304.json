{
  "schema_version": "1.0",
  "encounter_id": "20304",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.52,
      "end_seconds": 3.83,
      "duration_seconds": 3.31,
      "text": "Hello, doctor. May I come in?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.09,
      "end_seconds": 9.4,
      "duration_seconds": 4.31,
      "text": "Not at all, please sit. What seems to be wrong?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 11.43,
      "end_seconds": 20.25,
      "duration_seconds": 8.82,
      "text": "Mainly a dry tickly cough. There's a couple of other things, but that's the main one."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 22.19,
      "end_seconds": 25.84,
      "duration_seconds": 3.65,
      "text": "Can you tell me when it first started?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 26.36,
      "end_seconds": 30.31,
      "duration_seconds": 3.95,
      "text": "I've had it for nearly five years."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 47.06,
      "end_seconds": 50.33,
      "duration_seconds": 3.27,
      "text": "Have you had weight loss, by any chance?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 53.67,
      "end_seconds": 57.01,
      "duration_seconds": 3.34,
      "text": "No, I haven't had any weight loss."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 57.24,
      "end_seconds": 62.72,
      "duration_seconds": 5.48,
      "text": "Sure. A few quick ones: fever, wheeze or coughing up blood?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 63.68,
      "end_seconds": 68.81,
      "duration_seconds": 5.13,
      "text": "No fever, wheeze or coughing up blood, none of it."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 69.39,
      "end_seconds": 74.52,
      "duration_seconds": 5.13,
      "text": "Right, right. On the cardiac side, anything I should know?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 76.52,
      "end_seconds": 78.8,
      "duration_seconds": 2.28,
      "text": "No, that's been fine."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 79.64,
      "end_seconds": 81.83,
      "duration_seconds": 2.19,
      "text": "Any regular medication at all?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 83.38,
      "end_seconds": 85.1,
      "duration_seconds": 1.72,
      "text": "Nothing regular, no."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 97.42,
      "end_seconds": 98.63,
      "duration_seconds": 1.21,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 100.5,
      "end_seconds": 101.72,
      "duration_seconds": 1.22,
      "text": "No, never."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 103.14,
      "end_seconds": 106.64,
      "duration_seconds": 3.5,
      "text": "Let me ask about allergies, anything at all?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 107.15,
      "end_seconds": 110.69,
      "duration_seconds": 3.54,
      "text": "Amoxicillin. I come out in... well, hives."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 112.47,
      "end_seconds": 115.52,
      "duration_seconds": 3.05,
      "text": "Alright, is there someone at home?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 116.07,
      "end_seconds": 120.1,
      "duration_seconds": 4.03,
      "text": "My husband and I live above the shop."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 121.81,
      "end_seconds": 124.18,
      "duration_seconds": 2.37,
      "text": "Do you follow any particular diet?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 125.45,
      "end_seconds": 129.22,
      "duration_seconds": 3.77,
      "text": "I'm vegetarian and have been for years."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 130.77,
      "end_seconds": 134.3,
      "duration_seconds": 3.53,
      "text": "Any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 135.1,
      "end_seconds": 137.91,
      "duration_seconds": 2.81,
      "text": "No, I've always been fairly healthy."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 139.22,
      "end_seconds": 143.05,
      "duration_seconds": 3.83,
      "text": "Alright, shall I check your blood pressure and pulse?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 153.28,
      "end_seconds": 155.58,
      "duration_seconds": 2.3,
      "text": "Nearly done with the readings..."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 174.94,
      "end_seconds": 183.04,
      "duration_seconds": 8.1,
      "text": "Okay: saturation 97 percent, BP is 128 over 81. And respiratory rate 18, temperature 36.9, heart rate 65."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 184.38,
      "end_seconds": 185.75,
      "duration_seconds": 1.37,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 186.26,
      "end_seconds": 188.31,
      "duration_seconds": 2.05,
      "text": "We'll go over that shortly."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 191.25,
      "end_seconds": 194.1,
      "duration_seconds": 2.85,
      "text": "Let's move on to the examination."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 195.09,
      "end_seconds": 198.01,
      "duration_seconds": 2.92,
      "text": "Stay as you are for a moment."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 213.07,
      "end_seconds": 216.57,
      "duration_seconds": 3.5,
      "text": "Your chest is clear and there is no wheeze."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 221.9,
      "end_seconds": 224.0,
      "duration_seconds": 2.1,
      "text": "You can sit up now."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 241.94,
      "end_seconds": 252.01,
      "duration_seconds": 10.07,
      "text": "So, based on the history and the examination, this looks most like a persistent dry cough without a clear cause so far."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 253.74,
      "end_seconds": 256.44,
      "duration_seconds": 2.7,
      "text": "Is there something to worry about?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 258.33,
      "end_seconds": 282.63,
      "duration_seconds": 24.3,
      "text": "I can't promise yet, but most people with a persistent dry cough without a clear cause so far do well once it's treated properly. Let me repeat that back to make sure. You've had a dry tickly cough for nearly five years, and no coughing up blood or wheeze."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 283.57,
      "end_seconds": 285.28,
      "duration_seconds": 1.71,
      "text": "Yes, that's right."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 285.85,
      "end_seconds": 298.34,
      "duration_seconds": 12.49,
      "text": "I'd like to arrange a chest X-ray for chronic cough. We will review your tablets and see whether the cough settles over a month. I'll want another look in six weeks."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 299.61,
      "end_seconds": 304.22,
      "duration_seconds": 4.61,
      "text": "I, I'll book it on my way out."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 305.95,
      "end_seconds": 308.58,
      "duration_seconds": 2.63,
      "text": "That's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 310.4,
      "end_seconds": 314.29,
      "duration_seconds": 3.89,
      "text": "Erm, I think I understand everything. Thanks."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 315.6,
      "end_seconds": 317.52,
      "duration_seconds": 1.92,
      "text": "Okay, see you soon."
    }
  ]
}