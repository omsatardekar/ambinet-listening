{
  "schema_version": "1.0",
  "encounter_id": "20440",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.15,
      "end_seconds": 6.94,
      "duration_seconds": 5.79,
      "text": "Hello doctor, sorry, I took a wrong turn on the way here."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.66,
      "end_seconds": 11.91,
      "duration_seconds": 4.25,
      "text": "No problem at all, come in. What's troubling you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 13.77,
      "end_seconds": 18.39,
      "duration_seconds": 4.62,
      "text": "I wanted to get an itch down below looked at."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 19.78,
      "end_seconds": 22.97,
      "duration_seconds": 3.19,
      "text": "Can you tell me when it first started?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 24.16,
      "end_seconds": 28.6,
      "duration_seconds": 4.44,
      "text": "It's been going on for about four days."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 32.34,
      "end_seconds": 35.24,
      "duration_seconds": 2.9,
      "text": "How much does it limit you?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 35.75,
      "end_seconds": 37.95,
      "duration_seconds": 2.2,
      "text": "I'd call it severe."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 38.56,
      "end_seconds": 41.37,
      "duration_seconds": 2.81,
      "text": "Does anything else come with it?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 43.21,
      "end_seconds": 55.4,
      "duration_seconds": 12.19,
      "text": "When it starts I tend to get a thick white discharge as well. The thick white discharge? That's been for two weeks."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 56.6,
      "end_seconds": 59.54,
      "duration_seconds": 2.94,
      "text": "Let me quickly check your readings."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 70.13,
      "end_seconds": 72.8,
      "duration_seconds": 2.67,
      "text": "That's it, just a little longer..."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 88.49,
      "end_seconds": 96.58,
      "duration_seconds": 8.09,
      "text": "Okay: blood pressure 123 over 75, oxygen saturation is 98 percent. And heart rate 68, temperature is 36.9 degrees."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 100.61,
      "end_seconds": 102.06,
      "duration_seconds": 1.45,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 102.62,
      "end_seconds": 106.84,
      "duration_seconds": 4.22,
      "text": "They help me see the whole picture, more shortly."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 108.41,
      "end_seconds": 112.68,
      "duration_seconds": 4.27,
      "text": "I'll examine you in a second, make yourself comfortable."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 114.68,
      "end_seconds": 117.97,
      "duration_seconds": 3.29,
      "text": "Stay as you are for a moment."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 136.02,
      "end_seconds": 142.65,
      "duration_seconds": 6.63,
      "text": "There is a thick white discharge with redness of the vulva and no ulcers."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 145.59,
      "end_seconds": 147.79,
      "duration_seconds": 2.2,
      "text": "Okay, that's enough for me."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 161.57,
      "end_seconds": 167.04,
      "duration_seconds": 5.47,
      "text": "Let me check a few things. Any pelvic pain, new partner or smell?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 167.82,
      "end_seconds": 173.6,
      "duration_seconds": 5.78,
      "text": "I haven't had pelvic pain, new partner or smell, no."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 175.07,
      "end_seconds": 179.05,
      "duration_seconds": 3.98,
      "text": "Alright, how are your joints, any aches elsewhere?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 181.01,
      "end_seconds": 182.84,
      "duration_seconds": 1.83,
      "text": "I move fine otherwise."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 195.8,
      "end_seconds": 200.25,
      "duration_seconds": 4.45,
      "text": "Do you have any medical conditions I should know about?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 204.69,
      "end_seconds": 207.06,
      "duration_seconds": 2.37,
      "text": "No, nothing at all."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 208.98,
      "end_seconds": 211.7,
      "duration_seconds": 2.72,
      "text": "Any regular medication, tablets or creams?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 217.09,
      "end_seconds": 219.5,
      "duration_seconds": 2.41,
      "text": "No, nothing at the moment."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 234.5,
      "end_seconds": 237.36,
      "duration_seconds": 2.86,
      "text": "Right, now some background about your lifestyle."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 238.23,
      "end_seconds": 249.26,
      "duration_seconds": 11.03,
      "text": "I'm a plumber, lots of bending and kneeling. I swim twice a week. Lots of rice, lentils and some fruit."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 250.9,
      "end_seconds": 253.38,
      "duration_seconds": 2.48,
      "text": "Before we go further, any allergies?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 259.33,
      "end_seconds": 267.46,
      "duration_seconds": 8.13,
      "text": "Years back I got swelling of my lips from diclofenac, so I stay away from it now."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 270.38,
      "end_seconds": 274.39,
      "duration_seconds": 4.01,
      "text": "Okay, thinking it through, I'd lean towards vaginal thrush."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 286.09,
      "end_seconds": 305.8,
      "duration_seconds": 19.71,
      "text": "I think a urine test makes sense here, for dysuria. For this, fluconazole, 150 milligrams, once, for one day. That's for thrush. Wear cotton underwear and avoid scented soaps or washes. If the symptoms get worse, that's the point to come in urgently."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 306.98,
      "end_seconds": 308.52,
      "duration_seconds": 1.54,
      "text": "Alright, I follow."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 310.13,
      "end_seconds": 312.91,
      "duration_seconds": 2.78,
      "text": "Does all of that make sense?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 313.9,
      "end_seconds": 317.52,
      "duration_seconds": 3.62,
      "text": "Erm, great, thank you for your help."
    }
  ]
}