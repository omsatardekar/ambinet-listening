{
  "schema_version": "1.0",
  "encounter_id": "20394",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.56,
      "end_seconds": 5.04,
      "duration_seconds": 4.48,
      "text": "hi, is it okay to come in now?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.66,
      "end_seconds": 10.24,
      "duration_seconds": 4.58,
      "text": "yes, come in and sit down. What brings you here today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 11.17,
      "end_seconds": 16.68,
      "duration_seconds": 5.51,
      "text": "well, uh, I wanted to get a dry cough looked at"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 18.49,
      "end_seconds": 21.23,
      "duration_seconds": 2.74,
      "text": "How long has this been bothering you?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 23.28,
      "end_seconds": 26.08,
      "duration_seconds": 2.8,
      "text": "It's been about a week now."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 27.1,
      "end_seconds": 30.09,
      "duration_seconds": 2.99,
      "text": "how strong would you say it is?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 31.07,
      "end_seconds": 33.98,
      "duration_seconds": 2.91,
      "text": "Pretty moderate, if I'm being honest."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 34.85,
      "end_seconds": 37.27,
      "duration_seconds": 2.42,
      "text": "How often do you get it?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 39.36,
      "end_seconds": 41.57,
      "duration_seconds": 2.21,
      "text": "It's all the time."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 52.96,
      "end_seconds": 55.74,
      "duration_seconds": 2.78,
      "text": "Any vomiting, blue lips or confusion?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 56.78,
      "end_seconds": 60.73,
      "duration_seconds": 3.95,
      "text": "No, you know, none that I've noticed."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 62.64,
      "end_seconds": 65.1,
      "duration_seconds": 2.46,
      "text": "Is your digestion otherwise okay?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 66.38,
      "end_seconds": 68.96,
      "duration_seconds": 2.58,
      "text": "bowels are regular, nothing odd"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 70.31,
      "end_seconds": 73.37,
      "duration_seconds": 3.06,
      "text": "Has your heart given you any trouble?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 75.13,
      "end_seconds": 77.49,
      "duration_seconds": 2.36,
      "text": "No, that's been fine."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 88.24,
      "end_seconds": 91.69,
      "duration_seconds": 3.45,
      "text": "A few questions about your lifestyle now."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 93.74,
      "end_seconds": 108.18,
      "duration_seconds": 14.44,
      "text": "I have about eight cigarettes in a day. I only drink at family occasions. I grab fast food at lunch most days. Not much, I mostly stay in these days."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 108.91,
      "end_seconds": 111.5,
      "duration_seconds": 2.59,
      "text": "are you on any regular medication?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 112.3,
      "end_seconds": 114.71,
      "duration_seconds": 2.41,
      "text": "no, nothing at the moment"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 119.28,
      "end_seconds": 125.08,
      "duration_seconds": 5.8,
      "text": "Okay, has anything ever caused you a reaction? I mean any allergies."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 126.92,
      "end_seconds": 130.36,
      "duration_seconds": 3.44,
      "text": "Not to my knowledge, uh, no."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 132.37,
      "end_seconds": 135.8,
      "duration_seconds": 3.43,
      "text": "are there any illnesses in your family?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 137.19,
      "end_seconds": 140.96,
      "duration_seconds": 3.77,
      "text": "Ah, uh, my cousin has psoriasis."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 142.47,
      "end_seconds": 143.67,
      "duration_seconds": 1.2,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 145.68,
      "end_seconds": 146.77,
      "duration_seconds": 1.09,
      "text": "no, never"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 161.35,
      "end_seconds": 165.28,
      "duration_seconds": 3.93,
      "text": "Any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 166.11,
      "end_seconds": 170.24,
      "duration_seconds": 4.13,
      "text": "Hmm, no, nothing I can think of."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 180.06,
      "end_seconds": 183.17,
      "duration_seconds": 3.11,
      "text": "I'll note down your vital signs first."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 194.6,
      "end_seconds": 196.96,
      "duration_seconds": 2.36,
      "text": "Bear with me while this finishes..."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 213.74,
      "end_seconds": 223.83,
      "duration_seconds": 10.09,
      "text": "okay: respiratory rate 26, SpO2 92 percent on room air, temperature 37.1, heart rate 92, pressure 127 over 86."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 225.8,
      "end_seconds": 229.63,
      "duration_seconds": 3.83,
      "text": "Alright, over here please and I'll take a look."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 231.1,
      "end_seconds": 234.17,
      "duration_seconds": 3.07,
      "text": "Stay as you are for a moment."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 249.5,
      "end_seconds": 259.63,
      "duration_seconds": 10.13,
      "text": "Your chest is clear apart from a few crackles at the right base and your oxygen level is a bit low."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 260.63,
      "end_seconds": 261.7,
      "duration_seconds": 1.07,
      "text": "Sure thing."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 265.96,
      "end_seconds": 275.77,
      "duration_seconds": 9.81,
      "text": "you can relax now. Let me tell you where I've got to. The most likely explanation is a viral chest infection with mildly low oxygen"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 279.02,
      "end_seconds": 282.41,
      "duration_seconds": 3.39,
      "text": "is there something to worry about?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 283.22,
      "end_seconds": 314.71,
      "duration_seconds": 31.49,
      "text": "I understand the worry. At the moment I'd say it's a viral chest infection with mildly low oxygen, and we'll know more once the a viral swab is back. I'm going to order a viral swab, for fever and cough. It's a routine test and it'll give us a much clearer picture. Rest, keep your fluids up and lie on your tummy or side to help your breathing."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 316.59,
      "end_seconds": 329.45,
      "duration_seconds": 12.86,
      "text": "A chest X-ray is something we might do if this doesn't improve in a month. I'd like to see you again in two days. I think we're done unless you have questions."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 330.52,
      "end_seconds": 333.95,
      "duration_seconds": 3.43,
      "text": "Great, thank you for your help."
    }
  ]
}