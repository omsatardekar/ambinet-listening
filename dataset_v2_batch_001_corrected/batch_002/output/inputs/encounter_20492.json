{
  "schema_version": "1.0",
  "encounter_id": "20492",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.26,
      "end_seconds": 7.93,
      "duration_seconds": 6.67,
      "text": "hello doctor, uh, sorry, I took a wrong turn on the way here"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.88,
      "end_seconds": 14.04,
      "duration_seconds": 5.16,
      "text": "Yes, come in and sit down. What brings you here today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 15.28,
      "end_seconds": 22.24,
      "duration_seconds": 6.96,
      "text": "Doctor, it's pain in my right groin. It's getting on my nerves now."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 23.92,
      "end_seconds": 26.89,
      "duration_seconds": 2.97,
      "text": "Has this been going on for long?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 28.3,
      "end_seconds": 31.25,
      "duration_seconds": 2.95,
      "text": "About... well, about a month."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 31.83,
      "end_seconds": 36.13,
      "duration_seconds": 4.3,
      "text": "I see, go ahead. Alright, does anything set it off?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 37.98,
      "end_seconds": 41.8,
      "duration_seconds": 3.82,
      "text": "Stairs and walking definitely sets it off."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 43.88,
      "end_seconds": 46.6,
      "duration_seconds": 2.72,
      "text": "Have you noticed anything else alongside it?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 47.81,
      "end_seconds": 53.1,
      "duration_seconds": 5.29,
      "text": "it usually comes with stiffness in the hip after sitting"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 54.09,
      "end_seconds": 56.25,
      "duration_seconds": 2.16,
      "text": "How frequently does it come?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 61.75,
      "end_seconds": 63.95,
      "duration_seconds": 2.2,
      "text": "Honestly, all the time."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 66.46,
      "end_seconds": 72.3,
      "duration_seconds": 5.84,
      "text": "Let me check a few things. Any weight loss, fall or back pain?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 73.81,
      "end_seconds": 76.69,
      "duration_seconds": 2.88,
      "text": "No, not a single one."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 78.05,
      "end_seconds": 79.46,
      "duration_seconds": 1.41,
      "text": "Nothing like fever?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 80.85,
      "end_seconds": 83.35,
      "duration_seconds": 2.5,
      "text": "I haven't noticed any fever"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 84.15,
      "end_seconds": 88.82,
      "duration_seconds": 4.67,
      "text": "Any change in your bowel habit or your stomach generally?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 90.18,
      "end_seconds": 92.45,
      "duration_seconds": 2.27,
      "text": "No, all normal there."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 94.14,
      "end_seconds": 97.39,
      "duration_seconds": 3.25,
      "text": "Let me ask about allergies, anything at all?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 98.61,
      "end_seconds": 102.23,
      "duration_seconds": 3.62,
      "text": "Yes, wheat, it gives me bloating."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 103.46,
      "end_seconds": 106.5,
      "duration_seconds": 3.04,
      "text": "Is there any regular medication you use?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 108.26,
      "end_seconds": 111.08,
      "duration_seconds": 2.82,
      "text": "no, I'm not on anything"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 120.32,
      "end_seconds": 123.61,
      "duration_seconds": 3.29,
      "text": "Anything you do to to stay fit?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 125.38,
      "end_seconds": 128.55,
      "duration_seconds": 3.17,
      "text": "I do a yoga class on Thursdays"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 130.46,
      "end_seconds": 132.47,
      "duration_seconds": 2.01,
      "text": "Do you live by yourself?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 134.19,
      "end_seconds": 138.11,
      "duration_seconds": 3.92,
      "text": "No, I share a house with my brother."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 153.52,
      "end_seconds": 154.77,
      "duration_seconds": 1.25,
      "text": "any previous surgeries?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 156.12,
      "end_seconds": 157.23,
      "duration_seconds": 1.11,
      "text": "No, never."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 169.6,
      "end_seconds": 172.84,
      "duration_seconds": 3.24,
      "text": "Any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 174.61,
      "end_seconds": 176.65,
      "duration_seconds": 2.04,
      "text": "No, nothing at all."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 187.71,
      "end_seconds": 190.73,
      "duration_seconds": 3.02,
      "text": "I'll note down your vital signs first."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 200.81,
      "end_seconds": 203.49,
      "duration_seconds": 2.68,
      "text": "That's it, just a little longer..."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 220.36,
      "end_seconds": 226.89,
      "duration_seconds": 6.53,
      "text": "Okay: pulse 76, oxygen saturation is 97 percent, blood pressure 109 over 81."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 227.56,
      "end_seconds": 229.67,
      "duration_seconds": 2.11,
      "text": "Is that that normal?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 231.43,
      "end_seconds": 233.46,
      "duration_seconds": 2.03,
      "text": "we'll go over that shortly"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 235.71,
      "end_seconds": 241.32,
      "duration_seconds": 5.61,
      "text": "so, I'll need to examine you for this, it won't take long"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 242.84,
      "end_seconds": 243.54,
      "duration_seconds": 0.7,
      "text": "Right."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 245.36,
      "end_seconds": 247.12,
      "duration_seconds": 1.76,
      "text": "right, breathe out slowly"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 263.04,
      "end_seconds": 268.57,
      "duration_seconds": 5.53,
      "text": "Rotation of the right hip is painful and limited compared with the left."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 271.24,
      "end_seconds": 280.49,
      "duration_seconds": 9.25,
      "text": "Good, you can sit up again. Putting it it all together, the most likely explanation is osteoarthritis of the right hip."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 281.52,
      "end_seconds": 284.23,
      "duration_seconds": 2.71,
      "text": "What are the odds it's serious?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 286.33,
      "end_seconds": 298.1,
      "duration_seconds": 11.77,
      "text": "nothing I've seen today points to an emergency it looks like osteoarthritis of the right hip, but I'd like to confirm let's get blood tests, for joint pain"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 299.6,
      "end_seconds": 301.03,
      "duration_seconds": 1.43,
      "text": "Does it hurt?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 305.86,
      "end_seconds": 331.86,
      "duration_seconds": 26.0,
      "text": "The treatment will be paracetamol, 1 gram, up to four times a day, long term. You take it by mouth. That should help with hip pain. Keep walking in short regular bursts and use a stick in the opposite hand. The thing that would worry me is if the symptoms get worse. If that happens, go to emergency."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 332.79,
      "end_seconds": 334.32,
      "duration_seconds": 1.53,
      "text": "yes, will do"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 336.15,
      "end_seconds": 339.49,
      "duration_seconds": 3.34,
      "text": "I'd like you back after the X-ray."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 340.12,
      "end_seconds": 343.34,
      "duration_seconds": 3.22,
      "text": "I'll book it on my way out"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 346.99,
      "end_seconds": 350.54,
      "duration_seconds": 3.55,
      "text": "Okay, have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 352.16,
      "end_seconds": 356.02,
      "duration_seconds": 3.86,
      "text": "Um, great, thank you for your help."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 360.05,
      "end_seconds": 361.27,
      "duration_seconds": 1.22,
      "text": "Look after yourself."
    }
  ]
}