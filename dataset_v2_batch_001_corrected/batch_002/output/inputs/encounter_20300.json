{
  "schema_version": "1.0",
  "encounter_id": "20300",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.88,
      "end_seconds": 5.98,
      "duration_seconds": 5.1,
      "text": "Hi, doctor, I hope I'm not disturbing you."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.64,
      "end_seconds": 11.58,
      "duration_seconds": 3.94,
      "text": "Yes, have a seat. Tell me what's going on."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 12.17,
      "end_seconds": 18.34,
      "duration_seconds": 6.17,
      "text": "Doctor, thank you for seeing us. We came because of chest tightness."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 19.81,
      "end_seconds": 22.19,
      "duration_seconds": 2.38,
      "text": "So, when did this begin?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 23.91,
      "end_seconds": 26.67,
      "duration_seconds": 2.76,
      "text": "I'd say two weeks, maybe."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 27.9,
      "end_seconds": 35.63,
      "duration_seconds": 7.73,
      "text": "Let me think, uh, I think it's been nearer three weeks, actually."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 39.18,
      "end_seconds": 43.37,
      "duration_seconds": 4.19,
      "text": "Okay, so roughly two to three weeks. Is that right?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 44.08,
      "end_seconds": 46.36,
      "duration_seconds": 2.28,
      "text": "That sounds about right."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 47.06,
      "end_seconds": 55.97,
      "duration_seconds": 8.91,
      "text": "Tell me a bit more about it: how bad it gets, how often, and whether anything makes it better or worse."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 57.43,
      "end_seconds": 68.07,
      "duration_seconds": 10.64,
      "text": "Hmm, mostly moderate. I notice it more with pollen season. And, And a cough at night, too."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 68.97,
      "end_seconds": 73.7,
      "duration_seconds": 4.73,
      "text": "Okay, rate it for me, mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 75.44,
      "end_seconds": 76.53,
      "duration_seconds": 1.09,
      "text": "Mostly severe."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 92.05,
      "end_seconds": 94.99,
      "duration_seconds": 2.94,
      "text": "So, any weight loss or ankle swelling?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 96.44,
      "end_seconds": 100.49,
      "duration_seconds": 4.05,
      "text": "No, no weight loss or ankle swelling."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 104.51,
      "end_seconds": 108.2,
      "duration_seconds": 3.69,
      "text": "And what about chest pain, fever or blue lips?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 108.83,
      "end_seconds": 112.93,
      "duration_seconds": 4.1,
      "text": "No, you know, none that I've noticed."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 113.55,
      "end_seconds": 116.32,
      "duration_seconds": 2.77,
      "text": "How are your bowels, any trouble?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 118.79,
      "end_seconds": 122.57,
      "duration_seconds": 3.78,
      "text": "Yeah, no, that side's been fine."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 124.26,
      "end_seconds": 127.27,
      "duration_seconds": 3.01,
      "text": "Has your heart given you any trouble?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 131.56,
      "end_seconds": 137.23,
      "duration_seconds": 5.67,
      "text": "My heart's been fine, as far as I know."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 140.54,
      "end_seconds": 142.63,
      "duration_seconds": 2.09,
      "text": "Let's run through your medicines."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 143.87,
      "end_seconds": 152.26,
      "duration_seconds": 8.39,
      "text": "I'm on hydrocortisone cream, when needed. I take cetirizine, 10 milligrams, maybe, when it flares."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 153.41,
      "end_seconds": 156.51,
      "duration_seconds": 3.1,
      "text": "Is the packet here, or the prescription?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 157.52,
      "end_seconds": 162.18,
      "duration_seconds": 4.66,
      "text": "Not with me. I'll bring it next time."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 163.82,
      "end_seconds": 166.59,
      "duration_seconds": 2.77,
      "text": "What do you do during the day?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 167.66,
      "end_seconds": 171.47,
      "duration_seconds": 3.81,
      "text": "I look after my grandchildren most days."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 173.83,
      "end_seconds": 176.45,
      "duration_seconds": 2.62,
      "text": "Do you follow any particular diet?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 178.14,
      "end_seconds": 181.78,
      "duration_seconds": 3.64,
      "text": "I'm vegetarian and have been for years."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 183.06,
      "end_seconds": 186.12,
      "duration_seconds": 3.06,
      "text": "Are you on your own at home?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 188.09,
      "end_seconds": 191.45,
      "duration_seconds": 3.36,
      "text": "I live with my elderly mother."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 203.8,
      "end_seconds": 207.49,
      "duration_seconds": 3.69,
      "text": "Is there anything relevant on the family side?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 208.31,
      "end_seconds": 211.38,
      "duration_seconds": 3.07,
      "text": "My father had bowel cancer."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 212.27,
      "end_seconds": 220.46,
      "duration_seconds": 8.19,
      "text": "Has anything ever caused you a reaction? I mean any allergies. Just so I get the full picture."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 221.53,
      "end_seconds": 229.65,
      "duration_seconds": 8.12,
      "text": "I mean, you know, I'm allergic to nickel, I get a rash on my skin."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 230.95,
      "end_seconds": 234.3,
      "duration_seconds": 3.35,
      "text": "Did you ever have any procedures done?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 235.36,
      "end_seconds": 241.27,
      "duration_seconds": 5.91,
      "text": "I mean, I had a bunion operation six years ago."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 241.87,
      "end_seconds": 249.09,
      "duration_seconds": 7.22,
      "text": "Alright, has anyone ever diagnosed you with something? I'll explain everything as we go along."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 249.7,
      "end_seconds": 262.49,
      "duration_seconds": 12.79,
      "text": "I mean, I have eczema, for about ten years. My sister suggested writing things down, but I forgot. I've never really been one for hospitals."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 263.92,
      "end_seconds": 264.75,
      "duration_seconds": 0.83,
      "text": "I follow."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 266.27,
      "end_seconds": 270.46,
      "duration_seconds": 4.19,
      "text": "I've had asthma for five years now."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 271.08,
      "end_seconds": 281.39,
      "duration_seconds": 10.31,
      "text": "Right, so eczema and asthma are already on your record. We'll keep that in mind today. Shall I check your blood pressure and pulse?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 295.33,
      "end_seconds": 297.5,
      "duration_seconds": 2.17,
      "text": "Okay, this won't take long..."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 315.19,
      "end_seconds": 322.64,
      "duration_seconds": 7.45,
      "text": "Okay: heart rate 85, BP is 111 over 81, respiratory rate 15, SpO2 97 percent on room air."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 324.41,
      "end_seconds": 325.92,
      "duration_seconds": 1.51,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 327.78,
      "end_seconds": 330.32,
      "duration_seconds": 2.54,
      "text": "We'll look at it together shortly."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 332.51,
      "end_seconds": 335.79,
      "duration_seconds": 3.28,
      "text": "Could you come over to the couch, please?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 353.13,
      "end_seconds": 354.85,
      "duration_seconds": 1.72,
      "text": "Yeah, no problem."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 356.38,
      "end_seconds": 358.73,
      "duration_seconds": 2.35,
      "text": "Hold that for a second."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 367.5,
      "end_seconds": 375.62,
      "duration_seconds": 8.12,
      "text": "I can hear a faint wheeze at the end of breathing out, otherwise the chest is clear."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 378.52,
      "end_seconds": 402.63,
      "duration_seconds": 24.11,
      "text": "Please sit back down. So where does that leave us? This is probably exercise-triggered asthma with seasonal allergy. I want to be honest that this is an impression, not a final answer. I want a breathing test done, that's for wheeze. I'm sending you for an allergy test because of seasonal symptoms."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 403.71,
      "end_seconds": 405.8,
      "duration_seconds": 2.09,
      "text": "Right, uh, understood."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 407.75,
      "end_seconds": 418.98,
      "duration_seconds": 11.23,
      "text": "I'm prescribing budesonide-formoterol inhaler, 200 micrograms, one puff twice a day, long term. That's for asthma control. Rinse your mouth after the preventer inhaler and use the spacer."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 419.41,
      "end_seconds": 429.02,
      "duration_seconds": 9.61,
      "text": "Yes. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 430.65,
      "end_seconds": 437.67,
      "duration_seconds": 7.02,
      "text": "Could I get a peak flow diary done? A friend had it."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 438.85,
      "end_seconds": 450.04,
      "duration_seconds": 11.19,
      "text": "Right, not right now, it wouldn't change what we do today. I'd like you back after the breathing test. Anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 450.73,
      "end_seconds": 457.09,
      "duration_seconds": 6.36,
      "text": "Hmm, you know, good, thanks, I'll see you then."
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 458.91,
      "end_seconds": 460.23,
      "duration_seconds": 1.32,
      "text": "All the best."
    }
  ]
}