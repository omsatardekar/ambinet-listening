{
  "schema_version": "1.0",
  "encounter_id": "20134",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.97,
      "end_seconds": 4.02,
      "duration_seconds": 3.05,
      "text": "Right, thanks for waiting, come in."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 4.82,
      "end_seconds": 5.88,
      "duration_seconds": 1.06,
      "text": "Hi there."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 7.54,
      "end_seconds": 9.18,
      "duration_seconds": 1.64,
      "text": "Where shall we begin?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 10.55,
      "end_seconds": 18.82,
      "duration_seconds": 8.27,
      "text": "Mainly cramping tummy pain. There's a couple of other things, but that's the main one."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 20.27,
      "end_seconds": 24.48,
      "duration_seconds": 4.21,
      "text": "When did this begin? Take your time, there's no rush."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 26.02,
      "end_seconds": 29.09,
      "duration_seconds": 3.07,
      "text": "For about two weeks, I'd say."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 29.73,
      "end_seconds": 33.08,
      "duration_seconds": 3.35,
      "text": "Rate it for me, mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 33.97,
      "end_seconds": 45.6,
      "duration_seconds": 11.63,
      "text": "It's mild, honestly. I've had nausea too, for about a week. And there's a low fever as well, you know, five days now."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 46.11,
      "end_seconds": 51.8,
      "duration_seconds": 5.69,
      "text": "Have you had cramping tummy pain before, or is this the first time?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 53.69,
      "end_seconds": 60.04,
      "duration_seconds": 6.35,
      "text": "A bit, about six months ago. It settled by itself back then."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 70.89,
      "end_seconds": 74.78,
      "duration_seconds": 3.89,
      "text": "Anything in your past medical history I should know?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 76.11,
      "end_seconds": 79.56,
      "duration_seconds": 3.45,
      "text": "High blood pressure, for about a year."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 81.5,
      "end_seconds": 85.16,
      "duration_seconds": 3.66,
      "text": "Are you taking anything regularly, including from the pharmacy?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 86.33,
      "end_seconds": 88.36,
      "duration_seconds": 2.03,
      "text": "It's hydrochlorothiazide, every morning."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 89.63,
      "end_seconds": 91.92,
      "duration_seconds": 2.29,
      "text": "And what strength is that?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 92.96,
      "end_seconds": 94.95,
      "duration_seconds": 1.99,
      "text": "It's 12.5 milligrams."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 95.95,
      "end_seconds": 98.17,
      "duration_seconds": 2.22,
      "text": "When did you start it?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 99.14,
      "end_seconds": 101.24,
      "duration_seconds": 2.1,
      "text": "About a year now."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 101.8,
      "end_seconds": 103.2,
      "duration_seconds": 1.4,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 104.16,
      "end_seconds": 105.65,
      "duration_seconds": 1.49,
      "text": "No surgery, no."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 107.26,
      "end_seconds": 108.07,
      "duration_seconds": 0.81,
      "text": "Any smoking?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 110.03,
      "end_seconds": 113.13,
      "duration_seconds": 3.1,
      "text": "I gave up cigarettes last spring."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 114.84,
      "end_seconds": 117.41,
      "duration_seconds": 2.57,
      "text": "Right, and alcohol, how much?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 118.31,
      "end_seconds": 121.09,
      "duration_seconds": 2.78,
      "text": "I only drink at family occasions."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 122.32,
      "end_seconds": 124.68,
      "duration_seconds": 2.36,
      "text": "Do you get out much?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 125.99,
      "end_seconds": 130.12,
      "duration_seconds": 4.13,
      "text": "Not much, I mostly stay in these days."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 131.88,
      "end_seconds": 134.64,
      "duration_seconds": 2.76,
      "text": "What do you do during the day?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 135.93,
      "end_seconds": 139.73,
      "duration_seconds": 3.8,
      "text": "I look after my grandchildren most days."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 155.59,
      "end_seconds": 159.14,
      "duration_seconds": 3.55,
      "text": "Are there any allergies I should be aware of?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 160.94,
      "end_seconds": 163.04,
      "duration_seconds": 2.1,
      "text": "No allergies at all."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 164.16,
      "end_seconds": 166.96,
      "duration_seconds": 2.8,
      "text": "Any severe abdominal pain or dizziness?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 169.02,
      "end_seconds": 172.39,
      "duration_seconds": 3.37,
      "text": "No, none of those at all."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 173.43,
      "end_seconds": 177.56,
      "duration_seconds": 4.13,
      "text": "Any confusion, black stools or blood in the stool?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 179.08,
      "end_seconds": 181.98,
      "duration_seconds": 2.9,
      "text": "No, none of those at all."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 183.49,
      "end_seconds": 186.37,
      "duration_seconds": 2.88,
      "text": "Anything different when you pass water?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 187.14,
      "end_seconds": 188.73,
      "duration_seconds": 1.59,
      "text": "Nothing there, no."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 193.41,
      "end_seconds": 196.3,
      "duration_seconds": 2.89,
      "text": "Okay, any breathing difficulties apart from this?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 198.04,
      "end_seconds": 199.89,
      "duration_seconds": 1.85,
      "text": "No problems with breathing."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 200.42,
      "end_seconds": 208.13,
      "duration_seconds": 7.71,
      "text": "Here are the numbers, doctor. Temperature 38.4, respiratory rate 18. Pressure 113 over 70, pulse 90."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 208.77,
      "end_seconds": 209.8,
      "duration_seconds": 1.03,
      "text": "Okay, noted."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 211.96,
      "end_seconds": 214.56,
      "duration_seconds": 2.6,
      "text": "Let's move on to the examination."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 216.55,
      "end_seconds": 219.16,
      "duration_seconds": 2.61,
      "text": "Right, tell me if that's sore."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 235.83,
      "end_seconds": 243.26,
      "duration_seconds": 7.43,
      "text": "Your mouth is a bit dry and your tummy is soft with mild tenderness all over."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 245.54,
      "end_seconds": 253.33,
      "duration_seconds": 7.79,
      "text": "You can relax now. Having listened and examined, the most likely explanation is infective gastroenteritis, likely after recent travel."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 254.45,
      "end_seconds": 257.16,
      "duration_seconds": 2.71,
      "text": "Do you think it's something serious?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 258.2,
      "end_seconds": 267.7,
      "duration_seconds": 9.5,
      "text": "Nothing I've seen today points to an emergency. It looks like infective gastroenteritis, likely after recent travel, but I'd like to confirm."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 279.23,
      "end_seconds": 310.92,
      "duration_seconds": 31.69,
      "text": "We should do blood tests for dehydration. You'll be taking oral rehydration salts, 1 sachet, after each loose stool, for three days. You take it by mouth. That's for dehydration. Small sips often are better than large drinks, and eat plain food as soon as you can. The thing that would worry me is if you see blood in the stool or cannot keep fluids down. If that happens, go to emergency."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 312.43,
      "end_seconds": 319.8,
      "duration_seconds": 7.37,
      "text": "Come back if it isn't better in three days. Anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 321.34,
      "end_seconds": 324.51,
      "duration_seconds": 3.17,
      "text": "No, that's all. Thanks a lot."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 325.97,
      "end_seconds": 327.25,
      "duration_seconds": 1.28,
      "text": "Goodbye for now."
    }
  ]
}