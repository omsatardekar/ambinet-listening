{
  "schema_version": "1.0",
  "encounter_id": "20412",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.16,
      "end_seconds": 4.5,
      "duration_seconds": 3.34,
      "text": "Hello, good to see you. Please sit."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 6.1,
      "end_seconds": 9.35,
      "duration_seconds": 3.25,
      "text": "Hello, thanks for fitting me in."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 10.55,
      "end_seconds": 13.22,
      "duration_seconds": 2.67,
      "text": "What do you need help with?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 15.0,
      "end_seconds": 33.37,
      "duration_seconds": 18.37,
      "text": "Um, you know, mainly pain in my lower back. There's a couple of other things, but that's the main one. My neighbour said I should get it looked at. I told my wife I'd come today."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 34.17,
      "end_seconds": 40.55,
      "duration_seconds": 6.38,
      "text": "Okay, so the vitals from earlier. Saturation 97 percent, BP is 125 over 75, pulse 65."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 41.8,
      "end_seconds": 42.78,
      "duration_seconds": 0.98,
      "text": "Okay, noted."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 51.74,
      "end_seconds": 54.71,
      "duration_seconds": 2.97,
      "text": "What's the timeline, when did it begin?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 55.99,
      "end_seconds": 59.79,
      "duration_seconds": 3.8,
      "text": "It's, It's been going on for two months."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 61.51,
      "end_seconds": 66.78,
      "duration_seconds": 5.27,
      "text": "Okay, give me more detail on it, whatever comes to mind."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 67.53,
      "end_seconds": 80.49,
      "duration_seconds": 12.96,
      "text": "Let me think, it feels mild to me. I'd say once or twice a day. Lifting definitely sets it off. I've also been feeling unsteady."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 82.21,
      "end_seconds": 85.3,
      "duration_seconds": 3.09,
      "text": "Is it bearing on you a lot?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 86.53,
      "end_seconds": 89.0,
      "duration_seconds": 2.47,
      "text": "It feels mild to me."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 89.69,
      "end_seconds": 92.41,
      "duration_seconds": 2.72,
      "text": "Have you had a stooped back?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 93.61,
      "end_seconds": 109.07,
      "duration_seconds": 15.46,
      "text": "Yes, about the same, four weeks. Right, and I've been losing height as well. Ah, with losing height, maybe a eight out of ten on a bad day."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 110.46,
      "end_seconds": 115.3,
      "duration_seconds": 4.84,
      "text": "Did you get bladder problems, numbness in the legs or weight loss?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 116.65,
      "end_seconds": 118.77,
      "duration_seconds": 2.12,
      "text": "None of those, no."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 120.27,
      "end_seconds": 124.32,
      "duration_seconds": 4.05,
      "text": "And what about chest pain, night pain or fever?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 125.71,
      "end_seconds": 130.9,
      "duration_seconds": 5.19,
      "text": "No chest pain, night pain or fever, none of it."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 132.45,
      "end_seconds": 136.4,
      "duration_seconds": 3.95,
      "text": "On the cardiac side, anything I should know?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 136.91,
      "end_seconds": 140.79,
      "duration_seconds": 3.88,
      "text": "Uh, no, nothing with my heart."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 141.92,
      "end_seconds": 143.78,
      "duration_seconds": 1.86,
      "text": "How's your breathing otherwise?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 145.21,
      "end_seconds": 146.77,
      "duration_seconds": 1.56,
      "text": "No, nothing there."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 148.46,
      "end_seconds": 152.68,
      "duration_seconds": 4.22,
      "text": "Can you list what you take, tablets, creams or inhalers?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 153.29,
      "end_seconds": 169.82,
      "duration_seconds": 16.53,
      "text": "I'm on Thyronorm, 50 micrograms, every morning. Though honestly, uh, some days I forget to take it. I take alendronate, 70 milligrams, once a week for my bones."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 170.99,
      "end_seconds": 176.38,
      "duration_seconds": 5.39,
      "text": "Doctor, our chart from the last visit lists it as 140 milligrams."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 178.32,
      "end_seconds": 182.14,
      "duration_seconds": 3.82,
      "text": "I see. Is the most recent prescription on you?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 182.85,
      "end_seconds": 187.05,
      "duration_seconds": 4.2,
      "text": "Not with me. I'll bring it next time."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 201.38,
      "end_seconds": 204.13,
      "duration_seconds": 2.75,
      "text": "Did you ever have any procedures done?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 205.11,
      "end_seconds": 209.95,
      "duration_seconds": 4.84,
      "text": "I had an operation for a hernia last spring."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 210.72,
      "end_seconds": 216.18,
      "duration_seconds": 5.46,
      "text": "Okay, tell me about your routine, work, habits, that sort of thing."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 217.52,
      "end_seconds": 230.35,
      "duration_seconds": 12.83,
      "text": "Lots of rice, lentils and some fruit. My husband and I live above the shop. Not much, I mostly stay in these days."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 231.38,
      "end_seconds": 234.86,
      "duration_seconds": 3.48,
      "text": "Let me ask about allergies, anything at all?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 236.08,
      "end_seconds": 251.12,
      "duration_seconds": 15.04,
      "text": "Okay, so I was told I'm allergic to walnuts, but I don't remember what reaction I had. I'm, I'm allergic to wheat, I get itchy skin."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 252.56,
      "end_seconds": 256.38,
      "duration_seconds": 3.82,
      "text": "Any health conditions I should have on record?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 258.15,
      "end_seconds": 268.47,
      "duration_seconds": 10.32,
      "text": "Yes, an underactive thyroid. Yeah, I have thin bones. I took the morning off to come in today."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 275.93,
      "end_seconds": 279.0,
      "duration_seconds": 3.07,
      "text": "Are there any illnesses in your family?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 279.68,
      "end_seconds": 285.01,
      "duration_seconds": 5.33,
      "text": "Erm, my sister had breast cancer. My grandmother had dementia."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 287.11,
      "end_seconds": 291.78,
      "duration_seconds": 4.67,
      "text": "I'll need to examine you for this, it won't take long."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 292.62,
      "end_seconds": 294.71,
      "duration_seconds": 2.09,
      "text": "Raise your arm for me."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 312.42,
      "end_seconds": 318.11,
      "duration_seconds": 5.69,
      "text": "There is tenderness over the mid lower spine and no weakness in the legs."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 320.16,
      "end_seconds": 321.27,
      "duration_seconds": 1.11,
      "text": "Of course."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 323.54,
      "end_seconds": 338.68,
      "duration_seconds": 15.14,
      "text": "You can sit up now. Let me tell you where I've got to. My working impression is thin bones with a fragility fracture and back pain. We shouldn't forget a muscle strain."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 339.83,
      "end_seconds": 341.89,
      "duration_seconds": 2.06,
      "text": "Is it dangerous, doctor?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 343.8,
      "end_seconds": 363.65,
      "duration_seconds": 19.85,
      "text": "Nothing I've seen today points to an emergency. It looks like thin bones with a fragility fracture and back pain, but I'd like to confirm. So, to recap quickly. You've had pain in your lower back for two months, mild, and no bladder problems or weight loss."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 367.64,
      "end_seconds": 369.3,
      "duration_seconds": 1.66,
      "text": "Mm, that's right."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 374.68,
      "end_seconds": 378.94,
      "duration_seconds": 4.26,
      "text": "I'd like to arrange blood tests for bone health."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 382.68,
      "end_seconds": 385.2,
      "duration_seconds": 2.52,
      "text": "Actually, that's fine with me."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 386.83,
      "end_seconds": 392.15,
      "duration_seconds": 5.32,
      "text": "I'm sending you for a bone density scan because of fracture risk."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 393.87,
      "end_seconds": 396.2,
      "duration_seconds": 2.33,
      "text": "How long will it take?"
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 397.44,
      "end_seconds": 414.65,
      "duration_seconds": 17.21,
      "text": "Let's get a spine X-ray, for back pain. Take the weekly tablet first thing with a full glass of water and stay upright for half an hour. Avoid taking any extra painkillers on top of what I'm prescribing without checking with us."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 415.01,
      "end_seconds": 424.13,
      "duration_seconds": 9.12,
      "text": "Yes. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 425.07,
      "end_seconds": 427.94,
      "duration_seconds": 2.87,
      "text": "Okay, I'll look out for that."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 429.38,
      "end_seconds": 437.33,
      "duration_seconds": 7.95,
      "text": "Please don't wait if you have new weakness or numbness in your legs. That's when to be seen urgently."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 441.38,
      "end_seconds": 443.06,
      "duration_seconds": 1.68,
      "text": "Yes, will do."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 443.71,
      "end_seconds": 447.08,
      "duration_seconds": 3.37,
      "text": "I'll want another look in six weeks."
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 448.9,
      "end_seconds": 452.24,
      "duration_seconds": 3.34,
      "text": "I'll book it on my way out."
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 453.94,
      "end_seconds": 458.42,
      "duration_seconds": 4.48,
      "text": "Right, that's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 459.6,
      "end_seconds": 463.67,
      "duration_seconds": 4.07,
      "text": "Good, you know, thanks, I'll see you then."
    }
  ]
}