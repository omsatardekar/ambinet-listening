    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 70.1,
      "end_seconds": 72.48,
      "duration_seconds": 2.38,
      "text": "Has your skin been okay?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 73.15,
      "end_seconds": 74.28,
      "duration_seconds": 1.13,
      "text": "No rashes."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 75.33,
      "end_seconds": 78.54,
      "duration_seconds": 3.21,
      "text": "What line of work are you in?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 79.81,
      "end_seconds": 85.56,
      "duration_seconds": 5.75,
      "text": "I'm a bus driver, so I sit for long hours."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 86.77,
      "end_seconds": 89.02,
      "duration_seconds": 2.25,
      "text": "Do you do any exercise?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 89.7,
      "end_seconds": 92.18,
      "duration_seconds": 2.48,
      "text": "I swim twice a week"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 94.69,
      "end_seconds": 97.23,
      "duration_seconds": 2.54,
      "text": "do you follow any particular diet?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 98.84,
      "end_seconds": 102.4,
      "duration_seconds": 3.56,
      "text": "I'm vegetarian and have been for years."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 104.04,
      "end_seconds": 107.8,
      "duration_seconds": 3.76,
      "text": "Are you taking anything regularly, including from the pharmacy?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 110.97,
      "end_seconds": 115.32,
      "duration_seconds": 4.35,
      "text": "Dolo, 650 milligrams, when I get the fever."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 116.42,
      "end_seconds": 121.87,
      "duration_seconds": 5.45,
      "text": "alright, do you react to any medicines or foods? Any allergies?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 122.53,
      "end_seconds": 127.17,
      "duration_seconds": 4.64,
      "text": "No, uh, I've never reacted to to anything."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 129.0,
      "end_seconds": 132.36,
      "duration_seconds": 3.36,
      "text": "any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 133.57,
      "end_seconds": 135.09,
      "duration_seconds": 1.52,
      "text": "no, no conditions"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 140.2,
      "end_seconds": 144.2,
      "duration_seconds": 4.0,
      "text": "any inherited conditions that you know of in the family?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 145.12,
      "end_seconds": 148.33,
      "duration_seconds": 3.21,
      "text": "My mother has an underactive thyroid."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 152.46,
      "end_seconds": 154.89,
      "duration_seconds": 2.43,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 156.36,
      "end_seconds": 157.55,
      "duration_seconds": 1.19,
      "text": "no, never"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 168.52,
      "end_seconds": 171.36,
      "duration_seconds": 2.84,
      "text": "Let me quickly check your readings."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 181.8,
      "end_seconds": 184.15,
      "duration_seconds": 2.35,
      "text": "sit still for a moment.."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 196.35,
      "end_seconds": 203.03,
      "duration_seconds": 6.68,
      "text": "Okay: respiratory rate 17 pressure 112 over 76 pulse is 103 beats a minute."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 205.93,
      "end_seconds": 209.98,
      "duration_seconds": 4.05,
      "text": "alright, over here please and I'll take a look"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 211.53,
      "end_seconds": 213.59,
      "duration_seconds": 2.06,
      "text": "raise your arm for me"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 225.72,
      "end_seconds": 231.75,
      "duration_seconds": 6.03,
      "text": "both tonsils are red and enlarged with white patches and the neck glands are tender"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 235.07,
      "end_seconds": 237.52,
      "duration_seconds": 2.45,
      "text": "okay, that's enough for me"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 255.08,
      "end_seconds": 281.05,
      "duration_seconds": 25.97,
      "text": "I'd like to arrange a throat swab for sore throat. I'd rather check than guess, and this is the quickest way to know more. I'd like you to take phenoxymethylpenicillin, 500 milligrams, four times a day, for ten days. You take it by mouth. That should help with tonsillitis. Gargle with warm salt water and drink plenty of fluids"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 281.42,
      "end_seconds": 302.6,
      "duration_seconds": 21.18,
      "text": "mm, okay. Keep an eye out, and if you cannot swallow your saliva or have trouble breathing, call us the same day or go to emergency. Come back if it isn't better in three days. Right, that's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 306.86,
      "end_seconds": 310.28,
      "duration_seconds": 3.42,
      "text": "great, thank you for your help"
    }
  ]
