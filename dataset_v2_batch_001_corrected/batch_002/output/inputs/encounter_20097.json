      "role": "DOCTOR",
      "start_seconds": 4.79,
      "end_seconds": 10.25,
      "duration_seconds": 5.46,
      "text": "Yes, come in and sit down. What brings you here today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 11.08,
      "end_seconds": 15.36,
      "duration_seconds": 4.28,
      "text": "um I'm here because of pain on swallowing"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 16.72,
      "end_seconds": 18.1,
      "duration_seconds": 1.38,
      "text": "since when exactly?"
