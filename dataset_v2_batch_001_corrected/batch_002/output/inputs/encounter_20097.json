    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 19.59,
      "end_seconds": 22.1,
      "duration_seconds": 2.51,
      "text": "About... well, about a week."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 23.4,
      "end_seconds": 33.49,
      "duration_seconds": 10.09,
      "text": "Tell me a bit more about it: how bad it gets how often and whether anything makes it better or worse."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 34.77,
      "end_seconds": 50.47,
      "duration_seconds": 15.7,
      "text": "it happens once or twice a day maybe a seven out of ten on a bad day i did try to ignore it for a while i've never really been one for hospitals"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 51.94,
      "end_seconds": 55.9,
      "duration_seconds": 3.96,
      "text": "any trouble opening the mouth, drooling or difficulty breathing?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 57.63,
      "end_seconds": 61.41,
      "duration_seconds": 3.78,
      "text": "no, you know, none that I've noticed"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 63.29,
      "end_seconds": 64.93,
      "duration_seconds": 1.64,
