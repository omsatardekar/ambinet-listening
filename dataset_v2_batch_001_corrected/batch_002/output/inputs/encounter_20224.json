{
  "schema_version": "1.0",
  "encounter_id": "20224",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.83,
      "end_seconds": 4.38,
      "duration_seconds": 3.55,
      "text": "Hello, doctor. I think it's my turn."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.08,
      "end_seconds": 10.02,
      "duration_seconds": 3.94,
      "text": "That's fine, sit down. Tell me why you came."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 11.56,
      "end_seconds": 19.05,
      "duration_seconds": 7.49,
      "text": "Hello, um, doctor. I hope it's alright if I stay in for this."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 20.19,
      "end_seconds": 22.65,
      "duration_seconds": 2.46,
      "text": "absolutely, come and sit beside them"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 23.76,
      "end_seconds": 27.26,
      "duration_seconds": 3.5,
      "text": "She's been having the room spinning, doctor."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 28.82,
      "end_seconds": 33.79,
      "duration_seconds": 4.97,
      "text": "Okay, give me more detail on it, whatever comes to mind."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 35.37,
      "end_seconds": 41.36,
      "duration_seconds": 5.99,
      "text": "honestly, a few times a day pretty severe, if I'm being honest"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 43.45,
      "end_seconds": 46.49,
      "duration_seconds": 3.04,
      "text": "alright, is it accompanied by anything?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 47.49,
      "end_seconds": 52.95,
      "duration_seconds": 5.46,
      "text": "when it starts I tend to get a recent cold as well"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 53.92,
      "end_seconds": 61.75,
      "duration_seconds": 7.83,
      "text": "mm, and the other thing I wanted to mention is that that I can't really—"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 61.85,
      "end_seconds": 66.85,
      "duration_seconds": 5.0,
      "text": "Tell the doctor about the other thing, that's what worries me."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 68.82,
      "end_seconds": 71.12,
      "duration_seconds": 2.3,
      "text": "I was getting to that!"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 72.14,
      "end_seconds": 82.41,
      "duration_seconds": 10.27,
      "text": "That's fine, one at a time. I'll ask about everything. What about a blocked feeling in your ear, have you noticed that?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 83.21,
      "end_seconds": 89.98,
      "duration_seconds": 6.77,
      "text": "Yeah. Ten days, I'd say. As for recent cold, I'd call it severe."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 90.92,
      "end_seconds": 96.9,
      "duration_seconds": 5.98,
      "text": "Have you had the room spinning before, or is this the first time?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 97.85,
      "end_seconds": 108.14,
      "duration_seconds": 10.29,
      "text": "Sorry, what was I saying, yes, something like this happened last winter, and it went away on its own."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 108.73,
      "end_seconds": 109.68,
      "duration_seconds": 0.95,
      "text": "Any smoking?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 113.13,
      "end_seconds": 116.49,
      "duration_seconds": 3.36,
      "text": "I quit smoking around ten years ago."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 118.53,
      "end_seconds": 119.92,
      "duration_seconds": 1.39,
      "text": "What about alcohol?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 121.67,
      "end_seconds": 127.12,
      "duration_seconds": 5.45,
      "text": "I used to drink heavily but I stopped four years ago."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 128.2,
      "end_seconds": 131.19,
      "duration_seconds": 2.99,
      "text": "Are you in work at the moment?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 132.08,
      "end_seconds": 136.4,
      "duration_seconds": 4.32,
      "text": "Yes, I work in a bakery, early starts."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 137.01,
      "end_seconds": 138.57,
      "duration_seconds": 1.56,
      "text": "how active are you?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 140.1,
      "end_seconds": 143.34,
      "duration_seconds": 3.24,
      "text": "I hardly move around during the day."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 143.87,
      "end_seconds": 146.53,
      "duration_seconds": 2.66,
      "text": "Before we go further, any allergies?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 147.29,
      "end_seconds": 149.81,
      "duration_seconds": 2.52,
      "text": "not to my knowledge, no"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 150.39,
      "end_seconds": 153.84,
      "duration_seconds": 3.45,
      "text": "Are there any illnesses in your family?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 156.87,
      "end_seconds": 159.45,
      "duration_seconds": 2.58,
      "text": "My father has Parkinson's disease."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 161.12,
      "end_seconds": 163.7,
      "duration_seconds": 2.58,
      "text": "have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 165.32,
      "end_seconds": 168.37,
      "duration_seconds": 3.05,
      "text": "No, I've never been operated on."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 169.81,
      "end_seconds": 171.78,
      "duration_seconds": 1.97,
      "text": "What about your medical history?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 172.31,
      "end_seconds": 176.33,
      "duration_seconds": 4.02,
      "text": "I've got high blood pressure. Yes, heart disease."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 178.08,
      "end_seconds": 179.05,
      "duration_seconds": 0.97,
      "text": "Right, right."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 181.03,
      "end_seconds": 185.3,
      "duration_seconds": 4.27,
      "text": "I've had COPD for about a year now."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 186.44,
      "end_seconds": 191.7,
      "duration_seconds": 5.26,
      "text": "yes, COPD is known to us, good to have that clear"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 199.81,
      "end_seconds": 203.67,
      "duration_seconds": 3.86,
      "text": "What do you take on a normal day?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 204.93,
      "end_seconds": 212.82,
      "duration_seconds": 7.89,
      "text": "I take hydrochlorothiazide, 12.5 milligrams, every morning. It's aspirin, 75 milligrams, maybe, once a day."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 214.27,
      "end_seconds": 218.63,
      "duration_seconds": 4.36,
      "text": "Have you got the box or the prescription on you?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 220.63,
      "end_seconds": 228.65,
      "duration_seconds": 8.02,
      "text": "So, not with me. I'll bring it next time. It's Tiotropium inhaler, once a day."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 229.81,
      "end_seconds": 234.98,
      "duration_seconds": 5.17,
      "text": "Have you had any weakness, headache or ringing in the ears?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 236.68,
      "end_seconds": 250.99,
      "duration_seconds": 14.31,
      "text": "No, no weakness, no headache, no ringing in the ears. I did have being unsteady at one point, but that went away on its own."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 251.63,
      "end_seconds": 256.44,
      "duration_seconds": 4.81,
      "text": "Have you had any slurred speech, hearing loss or double vision?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 257.75,
      "end_seconds": 262.88,
      "duration_seconds": 5.13,
      "text": "actually, no, no slurred speech, hearing loss or double vision"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 263.52,
      "end_seconds": 266.4,
      "duration_seconds": 2.88,
      "text": "Any problems with your joints or muscles?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 267.07,
      "end_seconds": 269.3,
      "duration_seconds": 2.23,
      "text": "I move fine otherwise"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 271.2,
      "end_seconds": 273.32,
      "duration_seconds": 2.12,
      "text": "Is your chest okay generally?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 274.42,
      "end_seconds": 276.54,
      "duration_seconds": 2.12,
      "text": "No problems with breathing."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 278.22,
      "end_seconds": 281.61,
      "duration_seconds": 3.39,
      "text": "Shall I check your blood pressure and pulse?"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 289.15,
      "end_seconds": 292.27,
      "duration_seconds": 3.12,
      "text": "right, bear with me while this finishes.."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 312.5,
      "end_seconds": 319.3,
      "duration_seconds": 6.8,
      "text": "Okay: blood pressure 127 over 68, saturation 97 percent, pulse 67, respiratory rate 15."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 320.52,
      "end_seconds": 322.05,
      "duration_seconds": 1.53,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 323.39,
      "end_seconds": 325.5,
      "duration_seconds": 2.11,
      "text": "We'll go over that shortly."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 327.98,
      "end_seconds": 331.43,
      "duration_seconds": 3.45,
      "text": "could you come over to the couch, please?"
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 332.23,
      "end_seconds": 333.56,
      "duration_seconds": 1.33,
      "text": "does that hurt?"
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 343.38,
      "end_seconds": 352.32,
      "duration_seconds": 8.94,
      "text": "I can see a fine jerking of the eyes to the left and your walking is a little unsteady"
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 354.41,
      "end_seconds": 355.82,
      "duration_seconds": 1.41,
      "text": "Fine by me."
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 358.83,
      "end_seconds": 381.49,
      "duration_seconds": 22.66,
      "text": "that's the examination finished. From what you've told me and what I found, it fits best with an inner-ear balance problem such as vestibular neuritis. I want to be honest that that this is an impression, not a final answer. I can't rule out benign positional vertigo yet"
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 383.3,
      "end_seconds": 386.56,
      "duration_seconds": 3.26,
      "text": "Do you think it's something serious?"
    },
    {
      "segment_id": "SEG0059",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 388.36,
      "end_seconds": 399.15,
      "duration_seconds": 10.79,
      "text": "Nothing I've seen today points to an emergency. It looks like an inner-ear balance problem such as vestibular neuritis, but I'd like to confirm."
    },
    {
      "segment_id": "SEG0060",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 414.88,
      "end_seconds": 418.48,
      "duration_seconds": 3.6,
      "text": "I'm sending you for blood tests because of dizziness"
    },
    {
      "segment_id": "SEG0061",
      "speaker_id": "person_4",
      "role": "CLINICAL_STAFF",
      "start_seconds": 419.1,
      "end_seconds": 424.22,
      "duration_seconds": 5.12,
      "text": "We have a slot Friday at 11:30 am, if that works."
    },
    {
      "segment_id": "SEG0062",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 427.93,
      "end_seconds": 452.0,
      "duration_seconds": 24.07,
      "text": "Let's book a positional test to look into vertigo. We'll begin with prochlorperazine, 5 milligrams, three times a day, for three days. That's for nausea and vertigo. Start moving around gently as soon as you can, since resting too long slows recovery. Let's get you seen by the balance clinic, I'll arrange the letter."
    },
    {
      "segment_id": "SEG0063",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 452.68,
      "end_seconds": 453.38,
      "duration_seconds": 0.7,
      "text": "okay"
    },
    {
      "segment_id": "SEG0064",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 454.29,
      "end_seconds": 478.86,
      "duration_seconds": 24.57,
      "text": "And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose. Keep an eye out, and and if you get double vision, weakness or trouble speaking, call us the same day or go to emergency. See me again in a week."
    },
    {
      "segment_id": "SEG0065",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 479.79,
      "end_seconds": 481.92,
      "duration_seconds": 2.13,
      "text": "alright, I'll be back"
    },
    {
      "segment_id": "SEG0066",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 483.54,
      "end_seconds": 488.47,
      "duration_seconds": 4.93,
      "text": "Right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0067",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 490.39,
      "end_seconds": 493.59,
      "duration_seconds": 3.2,
      "text": "I think I understand everything. Thanks."
    }
  ]
}