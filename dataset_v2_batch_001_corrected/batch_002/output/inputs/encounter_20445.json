{
  "schema_version": "1.0",
  "encounter_id": "20445",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.68,
      "end_seconds": 4.45,
      "duration_seconds": 3.77,
      "text": "Hello, doctor. May I come in?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.98,
      "end_seconds": 12.8,
      "duration_seconds": 3.82,
      "text": "Come in. Please sit. How can I help you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 15.21,
      "end_seconds": 22.62,
      "duration_seconds": 7.41,
      "text": "Um, uh, I wanted to get numbness in my fingers looked at."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 23.95,
      "end_seconds": 26.03,
      "duration_seconds": 2.08,
      "text": "Did it come on recently?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 27.81,
      "end_seconds": 35.98,
      "duration_seconds": 8.17,
      "text": "Oh, you know, probably six months. Yeah. My family kept telling me to get it checked."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 36.65,
      "end_seconds": 41.88,
      "duration_seconds": 5.23,
      "text": "Okay, give me more detail on it, whatever comes to mind."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 42.66,
      "end_seconds": 66.59,
      "duration_seconds": 23.93,
      "text": "About a four out of ten. It's once or twice a day. I've, I've had an ache in my wrist too, for six months. As for ache in my wrist, mostly severe. And I've been waking at night with my hand numb as well."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 68.39,
      "end_seconds": 71.42,
      "duration_seconds": 3.03,
      "text": "Right, have you had dropping things?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 73.34,
      "end_seconds": 77.88,
      "duration_seconds": 4.54,
      "text": "Yeah, yeah. About a month, I'd say."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 78.7,
      "end_seconds": 82.27,
      "duration_seconds": 3.57,
      "text": "Is it a lot or only a little?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 84.11,
      "end_seconds": 87.01,
      "duration_seconds": 2.9,
      "text": "I, I'd call it mild."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 87.68,
      "end_seconds": 93.36,
      "duration_seconds": 5.68,
      "text": "Have you had numbness in your fingers before, or is this the first time?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 96.4,
      "end_seconds": 104.84,
      "duration_seconds": 8.44,
      "text": "Yes, something like this happened last winter, and it went away on its own."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 106.76,
      "end_seconds": 109.48,
      "duration_seconds": 2.72,
      "text": "A few questions about your lifestyle now."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 111.02,
      "end_seconds": 128.07,
      "duration_seconds": 17.05,
      "text": "Nothing, I'm teetotal. I smoke roughly a pack every two days. I live with my elderly mother. I work in accounts at a hospital. Lots of rice, lentils and some fruit."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 145.53,
      "end_seconds": 148.66,
      "duration_seconds": 3.13,
      "text": "Are there any illnesses in your family?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 150.18,
      "end_seconds": 152.64,
      "duration_seconds": 2.46,
      "text": "My son has asthma."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 154.57,
      "end_seconds": 156.91,
      "duration_seconds": 2.34,
      "text": "What's on your current medicine list?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 157.45,
      "end_seconds": 167.62,
      "duration_seconds": 10.17,
      "text": "It's glimepiride, 2 milligrams, before breakfast for my sugar. It's Eltroxin, 100 micrograms, every morning for my thyroid."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 167.83,
      "end_seconds": 168.78,
      "duration_seconds": 0.95,
      "text": "Mm, okay."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 169.87,
      "end_seconds": 189.34,
      "duration_seconds": 19.47,
      "text": "Uh, uh, I take amlodipine, 5 milligrams, once a day for my pressure. I do miss it now and then, to be fair. Actually, um, I was on ramipril before. I stopped taking it."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 199.64,
      "end_seconds": 202.6,
      "duration_seconds": 2.96,
      "text": "Before we go further, any allergies?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 203.26,
      "end_seconds": 207.37,
      "duration_seconds": 4.11,
      "text": "No, nothing as far as I know."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 208.46,
      "end_seconds": 212.29,
      "duration_seconds": 3.83,
      "text": "Any health conditions I should have on record?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 213.88,
      "end_seconds": 228.05,
      "duration_seconds": 14.17,
      "text": "Erm, I've had diabetes for five years now. I've had an underactive thyroid for about ten years now. High blood pressure, for about ten years."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 229.62,
      "end_seconds": 244.24,
      "duration_seconds": 14.62,
      "text": "Right, so an underactive thyroid and high blood pressure are already on your record. We'll keep that in mind today. And what about weakness in the legs, fever, weight loss or neck pain?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 246.05,
      "end_seconds": 249.71,
      "duration_seconds": 3.66,
      "text": "Well, no, none of those at all."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 250.65,
      "end_seconds": 253.77,
      "duration_seconds": 3.12,
      "text": "Has your heart given you any trouble?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 255.12,
      "end_seconds": 258.04,
      "duration_seconds": 2.92,
      "text": "No, nothing with my heart."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 259.85,
      "end_seconds": 262.66,
      "duration_seconds": 2.81,
      "text": "Let me take your readings now."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 273.51,
      "end_seconds": 275.86,
      "duration_seconds": 2.35,
      "text": "Bear with me while this finishes..."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 285.36,
      "end_seconds": 293.2,
      "duration_seconds": 7.84,
      "text": "Okay: respiratory rate 15, heart rate 75, BP is 110 over 78. And saturation 98 percent."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 294.49,
      "end_seconds": 298.31,
      "duration_seconds": 3.82,
      "text": "Alright, over here please and I'll take a look."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 311.18,
      "end_seconds": 312.23,
      "duration_seconds": 1.05,
      "text": "Sure thing."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 313.05,
      "end_seconds": 315.09,
      "duration_seconds": 2.04,
      "text": "Tell me if that's sore."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 333.25,
      "end_seconds": 343.11,
      "duration_seconds": 9.86,
      "text": "Tapping over the wrist brings on the tingling, and the muscle at the base of the thumb looks slightly thin."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 346.95,
      "end_seconds": 370.51,
      "duration_seconds": 23.56,
      "text": "You can relax now. I want nerve conduction tests done, that's for hand numbness. Let's get blood tests, for numbness. A wrist splint at night will often settle it. Cut back on tea, coffee and fizzy drinks for a couple of weeks and see how things settle. I'm going to send a referral to occupational therapy."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 371.56,
      "end_seconds": 373.3,
      "duration_seconds": 1.74,
      "text": "Alright, thank you."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 374.11,
      "end_seconds": 391.78,
      "duration_seconds": 17.67,
      "text": "Please don't wait if the numbness spreads or you notice more weakness. That's when to be seen urgently. I'll want another look in six weeks. Right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 392.87,
      "end_seconds": 396.37,
      "duration_seconds": 3.5,
      "text": "Alright, uh, thanks, take care."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 397.33,
      "end_seconds": 399.01,
      "duration_seconds": 1.68,
      "text": "Alright, look after yourself."
    }
  ]
}