{
  "schema_version": "1.0",
  "encounter_id": "20490",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 1.36,
      "end_seconds": 5.98,
      "duration_seconds": 4.62,
      "text": "Afternoon, doctor. They're in and comfortable, and I have the measurements ready."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 11.13,
      "end_seconds": 17.29,
      "duration_seconds": 6.16,
      "text": "Right, thanks. Hello, come in, sit down. What brings you in today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 17.98,
      "end_seconds": 22.21,
      "duration_seconds": 4.23,
      "text": "Well, I've been having an itch down below."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 24.0,
      "end_seconds": 27.23,
      "duration_seconds": 3.23,
      "text": "Has this been going on for long?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 28.92,
      "end_seconds": 38.15,
      "duration_seconds": 9.23,
      "text": "well, I'm not sure when it began, to be honest. Some weeks ago, but I can't say how many"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 39.64,
      "end_seconds": 42.51,
      "duration_seconds": 2.87,
      "text": "is it bearing on you a lot?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 44.19,
      "end_seconds": 47.53,
      "duration_seconds": 3.34,
      "text": "Yeah, about a seven out of ten."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 48.92,
      "end_seconds": 51.19,
      "duration_seconds": 2.27,
      "text": "What eases it, if anything?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 52.7,
      "end_seconds": 58.83,
      "duration_seconds": 6.13,
      "text": "A cool compress helps a bit. And pain when passing urine, too."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 60.04,
      "end_seconds": 62.89,
      "duration_seconds": 2.85,
      "text": "Has there been any being pregnant?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 64.12,
      "end_seconds": 66.17,
      "duration_seconds": 2.05,
      "text": "no, no being pregnant"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 67.52,
      "end_seconds": 72.19,
      "duration_seconds": 4.67,
      "text": "right, did you get fever, smell or new partner?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 73.16,
      "end_seconds": 76.67,
      "duration_seconds": 3.51,
      "text": "no, no fever, smell or new partner"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 78.41,
      "end_seconds": 81.71,
      "duration_seconds": 3.3,
      "text": "Anything with your nerves, like weakness or numbness?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 82.34,
      "end_seconds": 85.69,
      "duration_seconds": 3.35,
      "text": "No, um, that's all normal."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 86.73,
      "end_seconds": 91.35,
      "duration_seconds": 4.62,
      "text": "can you list what you take, tablets, creams or inhalers?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 92.75,
      "end_seconds": 102.64,
      "duration_seconds": 9.89,
      "text": "Glycomet, 500 milligrams, twice a day. So, uh, I take clopidogrel, 75 milligrams, once a day for the stent."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 104.04,
      "end_seconds": 108.41,
      "duration_seconds": 4.37,
      "text": "Do you react to any medicines or foods? Any allergies?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 109.52,
      "end_seconds": 114.83,
      "duration_seconds": 5.31,
      "text": "Actually, you know, I'm allergic to grass pollen, I get sneezing."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 115.99,
      "end_seconds": 118.89,
      "duration_seconds": 2.9,
      "text": "A few questions about your lifestyle now."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 119.61,
      "end_seconds": 130.19,
      "duration_seconds": 10.58,
      "text": "I'm vegetarian and have been for years. I look after my grandchildren most days. Not much, I mostly stay in these days."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 141.43,
      "end_seconds": 144.17,
      "duration_seconds": 2.74,
      "text": "Have you had any surgical procedures?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 145.88,
      "end_seconds": 152.77,
      "duration_seconds": 6.89,
      "text": "Yes, I had two stents put in my heart, three years ago."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 170.72,
      "end_seconds": 173.79,
      "duration_seconds": 3.07,
      "text": "Are there any illnesses in your family?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 175.01,
      "end_seconds": 177.24,
      "duration_seconds": 2.23,
      "text": "my father has Parkinson's disease"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 178.95,
      "end_seconds": 182.0,
      "duration_seconds": 3.05,
      "text": "has anyone ever diagnosed you with something?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 184.07,
      "end_seconds": 186.55,
      "duration_seconds": 2.48,
      "text": "Yes, diabetes. Yes, heart disease."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 187.43,
      "end_seconds": 194.12,
      "duration_seconds": 6.69,
      "text": "right, so diabetes is already on your record. We'll keep that in mind today"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 194.75,
      "end_seconds": 205.21,
      "duration_seconds": 10.46,
      "text": "doctor, I've got the readings for you. Temperature is 36.7 degrees, oxygen saturation is 99 percent, pressure 111 over 69, pulse is 80 beats a minute"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 209.89,
      "end_seconds": 210.59,
      "duration_seconds": 0.7,
      "text": "thanks"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 212.69,
      "end_seconds": 216.82,
      "duration_seconds": 4.13,
      "text": "Alright, over here please and I'll take a look."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 218.18,
      "end_seconds": 219.79,
      "duration_seconds": 1.61,
      "text": "yeah, no problem"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 221.08,
      "end_seconds": 223.93,
      "duration_seconds": 2.85,
      "text": "I'll listen to to your chest now"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 231.15,
      "end_seconds": 237.18,
      "duration_seconds": 6.03,
      "text": "there is a thick white discharge with redness of the vulva and no ulcers"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 240.98,
      "end_seconds": 243.8,
      "duration_seconds": 2.82,
      "text": "Good, you can sit up again."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 255.77,
      "end_seconds": 264.93,
      "duration_seconds": 9.16,
      "text": "So, based on the history and the examination, this is probably vaginal thrush. Another possibility is a urine infection."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 265.66,
      "end_seconds": 268.0,
      "duration_seconds": 2.34,
      "text": "Is this serious, doctor?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 268.66,
      "end_seconds": 278.37,
      "duration_seconds": 9.71,
      "text": "I understand the worry at the moment I'd say it's vaginal thrush, and we'll know more once the a urine test is back"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 279.62,
      "end_seconds": 284.05,
      "duration_seconds": 4.43,
      "text": "I've already done a urine test, it's ready for you."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 284.99,
      "end_seconds": 297.29,
      "duration_seconds": 12.3,
      "text": "thanks, I'll have a look. I'll request a swab, it'll help with vaginal discharge. I'd rather check than guess, and this is the quickest way to know more"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 298.84,
      "end_seconds": 301.36,
      "duration_seconds": 2.52,
      "text": "How long will it take?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 303.39,
      "end_seconds": 313.98,
      "duration_seconds": 10.59,
      "text": "I'd like you to take fluconazole, 150 milligrams, once, for one day. You take it by mouth. That should help with thrush."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 314.86,
      "end_seconds": 318.59,
      "duration_seconds": 3.73,
      "text": "is that safe with my other medicines?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 319.94,
      "end_seconds": 323.51,
      "duration_seconds": 3.57,
      "text": "Wear cotton underwear and avoid scented soaps or washes."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 323.85,
      "end_seconds": 334.52,
      "duration_seconds": 10.67,
      "text": "Okay, go on. Come back if it isn't better in a week. Is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 335.94,
      "end_seconds": 337.52,
      "duration_seconds": 1.58,
      "text": "That's clear, thanks."
    }
  ]
}