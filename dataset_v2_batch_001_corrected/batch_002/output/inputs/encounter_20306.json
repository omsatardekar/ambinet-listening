{
  "schema_version": "1.0",
  "encounter_id": "20306",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.76,
      "end_seconds": 4.12,
      "duration_seconds": 3.36,
      "text": "Hi doctor, am I too early?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.68,
      "end_seconds": 9.69,
      "duration_seconds": 4.01,
      "text": "Not at all, please sit. What seems to be wrong?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 14.39,
      "end_seconds": 19.07,
      "duration_seconds": 4.68,
      "text": "Doctor, I'm just here to help with the details."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 20.13,
      "end_seconds": 23.81,
      "duration_seconds": 3.68,
      "text": "That's fine, sit down. We'll go through it together."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 24.38,
      "end_seconds": 34.11,
      "duration_seconds": 9.73,
      "text": "Um, so... a twisted ankle. That's why I came. It's the not knowing that gets to me."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 34.85,
      "end_seconds": 37.38,
      "duration_seconds": 2.53,
      "text": "Tell me your medicines, please."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 40.66,
      "end_seconds": 47.7,
      "duration_seconds": 7.04,
      "text": "She is on Glycomet, 500 milligrams, twice a day, I give it to her."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 66.54,
      "end_seconds": 69.52,
      "duration_seconds": 2.98,
      "text": "What's the timeline, when did it begin?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 70.33,
      "end_seconds": 73.63,
      "duration_seconds": 3.3,
      "text": "Ever since... since last weekend, really."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 74.75,
      "end_seconds": 78.61,
      "duration_seconds": 3.86,
      "text": "What do you do to make it better?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 80.32,
      "end_seconds": 94.34,
      "duration_seconds": 14.02,
      "text": "Only ice, and it's not much. Oh, and swelling around the ankle. With swelling around the ankle, pretty mild, if I'm being honest. It's all the time."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 105.03,
      "end_seconds": 107.44,
      "duration_seconds": 2.41,
      "text": "Nothing like numbness in the foot?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 109.3,
      "end_seconds": 112.14,
      "duration_seconds": 2.84,
      "text": "No numbness in the foot, thankfully."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 113.99,
      "end_seconds": 121.31,
      "duration_seconds": 7.32,
      "text": "And what about calf pain, pain at the base of the fifth toe or previous fracture?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 122.32,
      "end_seconds": 131.96,
      "duration_seconds": 9.64,
      "text": "No calf pain, pain at the base of the fifth toe or previous fracture, none of it."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 133.3,
      "end_seconds": 135.94,
      "duration_seconds": 2.64,
      "text": "And your skin, any changes there?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 138.43,
      "end_seconds": 140.8,
      "duration_seconds": 2.37,
      "text": "Nothing on the skin, no."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 142.43,
      "end_seconds": 144.84,
      "duration_seconds": 2.41,
      "text": "Anything different when you pass water?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 145.96,
      "end_seconds": 147.51,
      "duration_seconds": 1.55,
      "text": "Nothing there, no."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 149.15,
      "end_seconds": 153.57,
      "duration_seconds": 4.42,
      "text": "Anything in your past medical history I should know?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 155.29,
      "end_seconds": 156.52,
      "duration_seconds": 1.23,
      "text": "Yes, diabetes."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 158.55,
      "end_seconds": 160.68,
      "duration_seconds": 2.13,
      "text": "Anything surgical in your history?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 162.68,
      "end_seconds": 168.59,
      "duration_seconds": 5.91,
      "text": "I had a mole taken off my arm a few years ago."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 169.86,
      "end_seconds": 173.46,
      "duration_seconds": 3.6,
      "text": "Let me ask about allergies, anything at all?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 174.25,
      "end_seconds": 178.0,
      "duration_seconds": 3.75,
      "text": "Amoxicillin. I come out in... well, hives."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 179.77,
      "end_seconds": 182.15,
      "duration_seconds": 2.38,
      "text": "Do you live by yourself?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 183.82,
      "end_seconds": 187.85,
      "duration_seconds": 4.03,
      "text": "No, I share a house with my brother."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 188.65,
      "end_seconds": 189.89,
      "duration_seconds": 1.24,
      "text": "Are you active?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 191.28,
      "end_seconds": 194.04,
      "duration_seconds": 2.76,
      "text": "I walk the dog every morning."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 201.36,
      "end_seconds": 204.29,
      "duration_seconds": 2.93,
      "text": "Let's start with the basic checks."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 212.3,
      "end_seconds": 214.88,
      "duration_seconds": 2.58,
      "text": "Okay, this won't take long..."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 226.24,
      "end_seconds": 237.13,
      "duration_seconds": 10.89,
      "text": "Okay: temperature is 36.6 degrees, heart rate 80. And weight 58 kilos, height 180 centimetres, pressure 126 over 78, respiratory rate 16."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 239.85,
      "end_seconds": 242.23,
      "duration_seconds": 2.38,
      "text": "Shall I start the examination?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 244.03,
      "end_seconds": 244.94,
      "duration_seconds": 0.91,
      "text": "Sure thing."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 246.67,
      "end_seconds": 249.76,
      "duration_seconds": 3.09,
      "text": "Stay as you are for a moment."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 257.29,
      "end_seconds": 268.3,
      "duration_seconds": 11.01,
      "text": "There is swelling and bruising over the outer ankle and I can't find any bony tenderness at the back of the ankle bone."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 272.97,
      "end_seconds": 289.57,
      "duration_seconds": 16.6,
      "text": "You can sit up now. I'd like to arrange an ankle X-ray for ankle injury. We'll begin with paracetamol, 1 gram, every six hours if needed, for five days. That's for ankle pain."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 290.27,
      "end_seconds": 294.29,
      "duration_seconds": 4.02,
      "text": "Should I carry on if I feel better?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 295.51,
      "end_seconds": 313.01,
      "duration_seconds": 17.5,
      "text": "Rest, ice, a firm bandage and keep it raised, and start gentle movement after two days. I think physiotherapy should see you too. Let's plan a check in two weeks. Have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 318.68,
      "end_seconds": 322.14,
      "duration_seconds": 3.46,
      "text": "No, that's all. Thanks a lot."
    }
  ]
}