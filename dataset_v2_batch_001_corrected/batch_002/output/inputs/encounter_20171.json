{
  "schema_version": "1.0",
  "encounter_id": "20171",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.02,
      "end_seconds": 7.11,
      "duration_seconds": 6.09,
      "text": "hello doctor, sorry, I took a a wrong turn on the way here"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.2,
      "end_seconds": 12.81,
      "duration_seconds": 4.61,
      "text": "Yes, come in and sit down. What brings you here today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 13.81,
      "end_seconds": 20.12,
      "duration_seconds": 6.31,
      "text": "good afternoon, doctor i look after them so I thought I'd come"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 21.49,
      "end_seconds": 26.02,
      "duration_seconds": 4.53,
      "text": "Alright, yes, that's no problem at all. Please sit."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 27.61,
      "end_seconds": 30.55,
      "duration_seconds": 2.94,
      "text": "She's been having hot flushes, doctor."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 31.1,
      "end_seconds": 34.19,
      "duration_seconds": 3.09,
      "text": "How long has it been like this?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 36.02,
      "end_seconds": 41.77,
      "duration_seconds": 5.75,
      "text": "Around nearly five years... no wait, it's more like two years."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 42.96,
      "end_seconds": 52.02,
      "duration_seconds": 9.06,
      "text": "Can you describe it a a bit more for me? How strong it is, what the pattern is, what helps."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 53.04,
      "end_seconds": 69.26,
      "duration_seconds": 16.22,
      "text": "Pretty severe, if I'm being honest. It settles a a little with a fan. It's a couple of times a week. I did have night sweats at one point, but that's gone now."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 70.18,
      "end_seconds": 75.2,
      "duration_seconds": 5.02,
      "text": "Have you had hot flushes before, or is this the first time?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 75.98,
      "end_seconds": 81.9,
      "duration_seconds": 5.92,
      "text": "a a bit, last winter it settled by itself back then"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 83.48,
      "end_seconds": 85.26,
      "duration_seconds": 1.78,
      "text": "How about heavy bleeding?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 86.13,
      "end_seconds": 88.85,
      "duration_seconds": 2.72,
      "text": "No, none, no heavy bleeding."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 89.08,
      "end_seconds": 94.68,
      "duration_seconds": 5.6,
      "text": "sure. Have you noticed palpitations, breast lumps, weight loss or bleeding after sex?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 95.4,
      "end_seconds": 102.99,
      "duration_seconds": 7.59,
      "text": "I haven't had palpitations, breast lumps, weight loss or bleeding after sex, no."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 103.87,
      "end_seconds": 105.84,
      "duration_seconds": 1.97,
      "text": "Is your mobility otherwise okay?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 107.42,
      "end_seconds": 109.41,
      "duration_seconds": 1.99,
      "text": "No, joints are fine."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 111.02,
      "end_seconds": 114.24,
      "duration_seconds": 3.22,
      "text": "Alright, and your skin, any changes there?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 115.09,
      "end_seconds": 118.35,
      "duration_seconds": 3.26,
      "text": "Erm, nothing on the skin, no."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 122.3,
      "end_seconds": 126.45,
      "duration_seconds": 4.15,
      "text": "What about your parents, brothers or sisters, any conditions?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 127.72,
      "end_seconds": 130.99,
      "duration_seconds": 3.27,
      "text": "My mother has an underactive thyroid."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 149.38,
      "end_seconds": 152.46,
      "duration_seconds": 3.08,
      "text": "Right, have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 154.36,
      "end_seconds": 156.42,
      "duration_seconds": 2.06,
      "text": "no, not at all"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 173.31,
      "end_seconds": 177.29,
      "duration_seconds": 3.98,
      "text": "anything in your past medical history I should know?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 179.11,
      "end_seconds": 186.12,
      "duration_seconds": 7.01,
      "text": "I've got thin bones. I've had high blood pressure for nearly five years now."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 188.08,
      "end_seconds": 197.47,
      "duration_seconds": 9.39,
      "text": "Alright, high blood pressure, that matches what I have here. Are you taking anything regularly, including from the pharmacy?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 199.38,
      "end_seconds": 205.92,
      "duration_seconds": 6.54,
      "text": "Amlodipine. I take it 5 milligrams, maybe, once a day for my pressure"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 206.85,
      "end_seconds": 210.99,
      "duration_seconds": 4.14,
      "text": "Do you have the packet or the prescription with you?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 211.71,
      "end_seconds": 215.58,
      "duration_seconds": 3.87,
      "text": "Not with me. I'll bring it next time."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 230.02,
      "end_seconds": 231.5,
      "duration_seconds": 1.48,
      "text": "okay, any smoking?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 233.15,
      "end_seconds": 236.36,
      "duration_seconds": 3.21,
      "text": "I quit smoking around ten years ago."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 237.4,
      "end_seconds": 238.74,
      "duration_seconds": 1.34,
      "text": "Are you active?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 240.69,
      "end_seconds": 244.06,
      "duration_seconds": 3.37,
      "text": "I walk the dog every morning."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 248.33,
      "end_seconds": 250.08,
      "duration_seconds": 1.75,
      "text": "How are your meals?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 250.65,
      "end_seconds": 254.92,
      "duration_seconds": 4.27,
      "text": "I grab fast food at lunch most days."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 259.26,
      "end_seconds": 261.05,
      "duration_seconds": 1.79,
      "text": "Who lives with you?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 261.99,
      "end_seconds": 264.82,
      "duration_seconds": 2.83,
      "text": "My partner and our baby."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 266.82,
      "end_seconds": 270.09,
      "duration_seconds": 3.27,
      "text": "I'll note down your vital signs first."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 277.82,
      "end_seconds": 280.11,
      "duration_seconds": 2.29,
      "text": "sit still for a moment.."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 290.15,
      "end_seconds": 299.59,
      "duration_seconds": 9.44,
      "text": "Okay: pulse 70, SpO2 98 percent on room air, temperature is 36.8 degrees, respiratory rate 16, BP is 118 over 72."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 301.97,
      "end_seconds": 305.31,
      "duration_seconds": 3.34,
      "text": "right, let's have a proper look at you"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 306.16,
      "end_seconds": 307.38,
      "duration_seconds": 1.22,
      "text": "okay, doctor"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 309.24,
      "end_seconds": 311.88,
      "duration_seconds": 2.64,
      "text": "I'll listen to your chest now"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 324.8,
      "end_seconds": 330.25,
      "duration_seconds": 5.45,
      "text": "Blood pressure and pulse are fine and there are no breast lumps on examination."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 335.3,
      "end_seconds": 343.4,
      "duration_seconds": 8.1,
      "text": "okay, you can relax now from what you've told me and what I found, it fits best with perimenopausal symptoms"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 343.91,
      "end_seconds": 345.94,
      "duration_seconds": 2.03,
      "text": "is this serious, doctor?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 347.56,
      "end_seconds": 362.56,
      "duration_seconds": 15.0,
      "text": "It's reasonable to be concerned, but right now perimenopausal symptoms is my leading thought, not anything worse. Let's book a bone density scan to look into menopause bone health. Let's get blood tests, for hot flushes."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 363.62,
      "end_seconds": 365.72,
      "duration_seconds": 2.1,
      "text": "Is that done today?"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 367.34,
      "end_seconds": 388.78,
      "duration_seconds": 21.44,
      "text": "Layers of clothing, a fan by the bed, and cutting down on caffeine and spicy food can help the flushes. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose. Let's plan a check in three months. Does all of that make sense?"
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 390.83,
      "end_seconds": 395.37,
      "duration_seconds": 4.54,
      "text": "no, um, that's all thanks a lot"
    }
  ]
}