{
  "schema_version": "1.0",
  "encounter_id": "20218",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.59,
      "end_seconds": 3.71,
      "duration_seconds": 3.12,
      "text": "Right, good morning, grab a seat."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 5.12,
      "end_seconds": 6.44,
      "duration_seconds": 1.32,
      "text": "Hi, thanks."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 7.32,
      "end_seconds": 13.46,
      "duration_seconds": 6.14,
      "text": "So, hello, doctor, I came in with them, if that's okay."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 14.76,
      "end_seconds": 20.48,
      "duration_seconds": 5.72,
      "text": "Good, that'll be useful. Pull up a chair. Lovely day outside, isn't it?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 22.16,
      "end_seconds": 28.02,
      "duration_seconds": 5.86,
      "text": "Hmm, it is, I almost forgot I was coming here."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 29.43,
      "end_seconds": 31.9,
      "duration_seconds": 2.47,
      "text": "Start wherever you like, I'm listening."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 33.5,
      "end_seconds": 37.8,
      "duration_seconds": 4.3,
      "text": "We came because of spots on my face."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 38.43,
      "end_seconds": 40.13,
      "duration_seconds": 1.7,
      "text": "When did this begin?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 41.41,
      "end_seconds": 44.96,
      "duration_seconds": 3.55,
      "text": "Actually, around a week, I think."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 45.98,
      "end_seconds": 52.64,
      "duration_seconds": 6.66,
      "text": "Let me think, uh, hm, I'd say more like two weeks."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 54.03,
      "end_seconds": 58.99,
      "duration_seconds": 4.96,
      "text": "Okay, so roughly one to two weeks. Is that right?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 60.77,
      "end_seconds": 63.29,
      "duration_seconds": 2.52,
      "text": "Yes, somewhere around that."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 64.27,
      "end_seconds": 67.83,
      "duration_seconds": 3.56,
      "text": "Is it a lot or only a little?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 68.54,
      "end_seconds": 72.76,
      "duration_seconds": 4.22,
      "text": "Yeah, about a three out of ten."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 73.67,
      "end_seconds": 76.11,
      "duration_seconds": 2.44,
      "text": "Is it accompanied by anything?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 77.03,
      "end_seconds": 85.33,
      "duration_seconds": 8.3,
      "text": "It usually comes with sore red lumps. Oh, uh, and spots on my back."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 87.01,
      "end_seconds": 90.11,
      "duration_seconds": 3.1,
      "text": "How strong would you say it is?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 91.88,
      "end_seconds": 98.34,
      "duration_seconds": 6.46,
      "text": "It's severe, honestly. And I've been feeling low about my skin as well."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 99.52,
      "end_seconds": 102.58,
      "duration_seconds": 3.06,
      "text": "How strong would you say it is?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 103.49,
      "end_seconds": 114.39,
      "duration_seconds": 10.9,
      "text": "Actually, I'd give it a seven, out of ten. The sore red lumps? That's been for four weeks."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 133.18,
      "end_seconds": 138.21,
      "duration_seconds": 5.03,
      "text": "Have you noticed irregular periods, joint pain or being pregnant?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 139.73,
      "end_seconds": 145.23,
      "duration_seconds": 5.5,
      "text": "Sorry, what was I saying, no, not a single one."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 147.18,
      "end_seconds": 150.62,
      "duration_seconds": 3.44,
      "text": "Any excess hair growth, fever or headaches?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 152.28,
      "end_seconds": 157.61,
      "duration_seconds": 5.33,
      "text": "No excess hair growth, fever or headaches, none of it."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 159.26,
      "end_seconds": 163.46,
      "duration_seconds": 4.2,
      "text": "Any pins and needles or loss of strength anywhere?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 164.37,
      "end_seconds": 165.84,
      "duration_seconds": 1.47,
      "text": "Nothing odd there."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 167.19,
      "end_seconds": 169.76,
      "duration_seconds": 2.57,
      "text": "Is your urine normal, no changes?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 170.77,
      "end_seconds": 174.15,
      "duration_seconds": 3.38,
      "text": "No, uh, that's all fine."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 175.79,
      "end_seconds": 180.31,
      "duration_seconds": 4.52,
      "text": "Any inherited conditions that you know of in the family?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 181.41,
      "end_seconds": 186.66,
      "duration_seconds": 5.25,
      "text": "My father had bowel cancer. My father has Parkinson's disease."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 187.79,
      "end_seconds": 192.07,
      "duration_seconds": 4.28,
      "text": "So, any health conditions I should have on record?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 194.06,
      "end_seconds": 209.38,
      "duration_seconds": 15.32,
      "text": "I've had anxiety, yes. I'd rather not end up on lots of tablets if I can avoid it. So, I've had eczema for five years now. I, I have depression."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 211.13,
      "end_seconds": 222.78,
      "duration_seconds": 11.65,
      "text": "Right, so anxiety and eczema are already on your record. We'll keep that in mind today. What do you take on a normal day?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 224.66,
      "end_seconds": 233.92,
      "duration_seconds": 9.26,
      "text": "I mean, um, I take something called esci... escitalopram, 10 milligrams, maybe, once a day."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 235.77,
      "end_seconds": 239.16,
      "duration_seconds": 3.39,
      "text": "Is the packet here, or the prescription?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 240.43,
      "end_seconds": 242.65,
      "duration_seconds": 2.22,
      "text": "No, it's at home."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 244.52,
      "end_seconds": 249.96,
      "duration_seconds": 5.44,
      "text": "Okay, tell me about your routine, work, habits, that sort of thing."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 251.51,
      "end_seconds": 266.51,
      "duration_seconds": 15.0,
      "text": "I hardly move around during the day. I'm a bus driver, so I sit for long hours. I drink a lot of tea and snack through the day."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 267.51,
      "end_seconds": 271.87,
      "duration_seconds": 4.36,
      "text": "Has anything ever caused you a reaction? I mean any allergies."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 272.6,
      "end_seconds": 275.73,
      "duration_seconds": 3.13,
      "text": "No, not that I know of."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 286.77,
      "end_seconds": 290.4,
      "duration_seconds": 3.63,
      "text": "Shall I check your blood pressure and pulse?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 299.63,
      "end_seconds": 301.63,
      "duration_seconds": 2.0,
      "text": "Sit still for a moment..."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 311.97,
      "end_seconds": 320.11,
      "duration_seconds": 8.14,
      "text": "Okay: oxygen saturation is 98 percent, pulse 74, pressure 120 over 73. And temperature 36.8."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 322.19,
      "end_seconds": 326.27,
      "duration_seconds": 4.08,
      "text": "Alright, over here please and I'll take a look."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 328.25,
      "end_seconds": 329.64,
      "duration_seconds": 1.39,
      "text": "Does that hurt?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 345.13,
      "end_seconds": 352.66,
      "duration_seconds": 7.53,
      "text": "There are red inflamed lumps and blackheads over both cheeks and the forehead, and a few scars."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 354.77,
      "end_seconds": 364.8,
      "duration_seconds": 10.03,
      "text": "Good, you can sit up again. Having listened and examined, my working impression is moderate inflammatory acne. Rosacea is still possible."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 365.64,
      "end_seconds": 371.79,
      "duration_seconds": 6.15,
      "text": "Hmm, you know, I'm scared it's something bad. Is it?"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 372.62,
      "end_seconds": 381.49,
      "duration_seconds": 8.87,
      "text": "Nothing I've seen today points to an emergency. It looks like moderate inflammatory acne, but I'd like to confirm."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 393.3,
      "end_seconds": 423.08,
      "duration_seconds": 29.78,
      "text": "We should do blood tests for acne treatment baseline. We'll begin with adapalene gel, 0.1 percent, once a night, for twelve weeks. That's for acne. Use sunscreen daily, and the gel can sting for the first couple of weeks. Avoid taking any extra painkillers on top of what I'm prescribing without checking with us. I think the dermatology clinic should see you too."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 425.12,
      "end_seconds": 438.48,
      "duration_seconds": 13.36,
      "text": "And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose. Please don't wait if the symptoms get worse. That's when to be seen urgently."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 439.02,
      "end_seconds": 440.62,
      "duration_seconds": 1.6,
      "text": "Okay, makes sense."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 441.56,
      "end_seconds": 450.27,
      "duration_seconds": 8.71,
      "text": "Please come and see me in twelve weeks. Is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 453.68,
      "end_seconds": 457.37,
      "duration_seconds": 3.69,
      "text": "Mm, no, that's all. Thanks a lot."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 458.86,
      "end_seconds": 460.08,
      "duration_seconds": 1.22,
      "text": "Goodbye for now."
    }
  ]
}