{
  "schema_version": "1.0",
  "encounter_id": "20296",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.85,
      "end_seconds": 5.58,
      "duration_seconds": 4.73,
      "text": "Doctor? Hello, I hope this is the right time."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.57,
      "end_seconds": 11.62,
      "duration_seconds": 4.05,
      "text": "That's fine, sit down. Tell me why you came."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 13.28,
      "end_seconds": 29.61,
      "duration_seconds": 16.33,
      "text": "So the thing is, I've got a lump in my armpit. I'm hoping you can tell me something definite. I kept putting it off, which I know isn't sensible."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 30.45,
      "end_seconds": 33.81,
      "duration_seconds": 3.36,
      "text": "Can you tell me when it first started?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 34.51,
      "end_seconds": 42.5,
      "duration_seconds": 7.99,
      "text": "Since Monday, that's when it began. I didn't want to bother you but it keeps coming back."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 43.69,
      "end_seconds": 45.88,
      "duration_seconds": 2.19,
      "text": "Any regular medication at all?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 46.53,
      "end_seconds": 50.13,
      "duration_seconds": 3.6,
      "text": "So, no, I don't take any tablets."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 64.58,
      "end_seconds": 68.17,
      "duration_seconds": 3.59,
      "text": "Let me ask about allergies, anything at all?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 69.28,
      "end_seconds": 72.47,
      "duration_seconds": 3.19,
      "text": "Yes, cat fur. I get wheezing."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 83.97,
      "end_seconds": 86.58,
      "duration_seconds": 2.61,
      "text": "Now some background about your lifestyle."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 87.09,
      "end_seconds": 109.57,
      "duration_seconds": 22.48,
      "text": "I have about eight cigarettes in a day. I used to drink heavily but I stopped four years ago. I'm a hairdresser, on my feet all day. I grab fast food at lunch most days. Not much, I mostly stay in these days."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 126.09,
      "end_seconds": 129.48,
      "duration_seconds": 3.39,
      "text": "Any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 130.39,
      "end_seconds": 132.5,
      "duration_seconds": 2.11,
      "text": "No, nothing at all."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 134.37,
      "end_seconds": 135.68,
      "duration_seconds": 1.31,
      "text": "Any recent travel?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 137.2,
      "end_seconds": 139.4,
      "duration_seconds": 2.2,
      "text": "No recent travel, thankfully."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 140.08,
      "end_seconds": 144.4,
      "duration_seconds": 4.32,
      "text": "Have you had any diarrhoea, joint pain or weight loss?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 147.74,
      "end_seconds": 151.64,
      "duration_seconds": 3.9,
      "text": "No, no diarrhoea, joint pain or weight loss."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 152.55,
      "end_seconds": 155.41,
      "duration_seconds": 2.86,
      "text": "Okay, anything unusual with passing urine?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 156.14,
      "end_seconds": 157.55,
      "duration_seconds": 1.41,
      "text": "No changes there."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 170.72,
      "end_seconds": 173.08,
      "duration_seconds": 2.36,
      "text": "Let me take your readings now."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 185.27,
      "end_seconds": 187.51,
      "duration_seconds": 2.24,
      "text": "Okay, this won't take long..."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 202.08,
      "end_seconds": 211.15,
      "duration_seconds": 9.07,
      "text": "Okay: SpO2 98 percent on room air, pulse 92, blood pressure 111 over 66, temperature is 38.7 degrees."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 211.67,
      "end_seconds": 213.12,
      "duration_seconds": 1.45,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 214.54,
      "end_seconds": 216.56,
      "duration_seconds": 2.02,
      "text": "We'll go over that shortly."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 217.76,
      "end_seconds": 222.28,
      "duration_seconds": 4.52,
      "text": "Let me look at the area, I'll be gentle."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 223.49,
      "end_seconds": 224.19,
      "duration_seconds": 0.7,
      "text": "Right."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 225.94,
      "end_seconds": 227.63,
      "duration_seconds": 1.69,
      "text": "Let me feel here."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 243.23,
      "end_seconds": 250.0,
      "duration_seconds": 6.77,
      "text": "There's a firm, rubbery gland about two centimetres in the left armpit, not tender."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 251.26,
      "end_seconds": 254.26,
      "duration_seconds": 3.0,
      "text": "Stay as you are for a moment."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 264.97,
      "end_seconds": 267.05,
      "duration_seconds": 2.08,
      "text": "I can't feel your spleen."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 271.1,
      "end_seconds": 288.95,
      "duration_seconds": 17.85,
      "text": "That's all I needed to check. So where does that leave us? My working impression is an enlarged gland with night sweats that needs a proper work-up. I'm sending you for a chest X-ray because of night sweats."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 290.64,
      "end_seconds": 295.35,
      "duration_seconds": 4.71,
      "text": "We have a slot Friday at 10 am, if that works."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 299.16,
      "end_seconds": 302.59,
      "duration_seconds": 3.43,
      "text": "Okay, you know, I'll be there."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 303.52,
      "end_seconds": 318.36,
      "duration_seconds": 14.84,
      "text": "Keep a note of your temperature each evening. I'm not ordering blood tests today. If things carry on in a month, we'll consider it. We'll catch up after the results are back."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 320.28,
      "end_seconds": 320.98,
      "duration_seconds": 0.7,
      "text": "Right."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 322.52,
      "end_seconds": 325.04,
      "duration_seconds": 2.52,
      "text": "Have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 326.03,
      "end_seconds": 330.47,
      "duration_seconds": 4.44,
      "text": "Good, uh, thanks, I'll see you then."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 331.59,
      "end_seconds": 333.57,
      "duration_seconds": 1.98,
      "text": "Right, look after yourself."
    }
  ]
}