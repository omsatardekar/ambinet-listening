{
  "schema_version": "1.0",
  "encounter_id": "20474",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.06,
      "end_seconds": 4.09,
      "duration_seconds": 3.03,
      "text": "Sorry, doctor, shall I sit here?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.97,
      "end_seconds": 11.42,
      "duration_seconds": 5.45,
      "text": "Okay, you're alright, take a seat. What can I do for you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 13.39,
      "end_seconds": 17.32,
      "duration_seconds": 3.93,
      "text": "Uh, doctor, thank you for seeing us."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 18.51,
      "end_seconds": 22.28,
      "duration_seconds": 3.77,
      "text": "That's fine, sit down. We'll go through it together."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 24.36,
      "end_seconds": 31.56,
      "duration_seconds": 7.2,
      "text": "It's no real appetite, doctor. She didn't want to come, but I insisted."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 32.42,
      "end_seconds": 35.93,
      "duration_seconds": 3.51,
      "text": "Right, how long has this been bothering you?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 37.81,
      "end_seconds": 40.84,
      "duration_seconds": 3.03,
      "text": "It's been nearly five years now."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 42.77,
      "end_seconds": 46.08,
      "duration_seconds": 3.31,
      "text": "Have you been losing weight without trying?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 46.93,
      "end_seconds": 54.53,
      "duration_seconds": 7.6,
      "text": "Yes, um, about the same, two years. And I've been feeling tired as well."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 56.08,
      "end_seconds": 59.83,
      "duration_seconds": 3.75,
      "text": "What about your parents, brothers or sisters, any conditions?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 60.84,
      "end_seconds": 66.07,
      "duration_seconds": 5.23,
      "text": "My father has Parkinson's disease. Well, my aunt has rheumatoid arthritis."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 67.63,
      "end_seconds": 70.89,
      "duration_seconds": 3.26,
      "text": "A few questions about your lifestyle now."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 72.72,
      "end_seconds": 83.07,
      "duration_seconds": 10.35,
      "text": "My husband and I live above the shop. I do a yoga class on Thursdays. Lots of rice, lentils and some fruit."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 84.7,
      "end_seconds": 86.88,
      "duration_seconds": 2.18,
      "text": "What about your medical history?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 87.41,
      "end_seconds": 101.22,
      "duration_seconds": 13.81,
      "text": "I've had high cholesterol for about a year now. I looked a few things up online, and that probably didn't help. I have high blood pressure."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 103.01,
      "end_seconds": 105.11,
      "duration_seconds": 2.1,
      "text": "Right, is there anything more?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 106.86,
      "end_seconds": 118.33,
      "duration_seconds": 11.47,
      "text": "Right, so high cholesterol and high blood pressure are already on your record. We'll keep that in mind today. What operations have you had, if any?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 120.32,
      "end_seconds": 126.25,
      "duration_seconds": 5.93,
      "text": "Yes, I had a wisdom tooth extraction under sedation, five years ago."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 145.14,
      "end_seconds": 147.28,
      "duration_seconds": 2.14,
      "text": "Tell me your medicines, please."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 149.25,
      "end_seconds": 152.9,
      "duration_seconds": 3.65,
      "text": "Atorvastatin, 20 milligrams, maybe, at night."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 154.23,
      "end_seconds": 158.14,
      "duration_seconds": 3.91,
      "text": "Did you happen to bring the box or the paperwork?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 159.54,
      "end_seconds": 168.89,
      "duration_seconds": 9.35,
      "text": "Uh, um, not with me. I'll bring it next time. Ramipril. I take it 5 milligrams, every morning."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 170.38,
      "end_seconds": 176.38,
      "duration_seconds": 6.0,
      "text": "That's what's prescribed, but I'm not sure she takes it every day."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 187.89,
      "end_seconds": 193.69,
      "duration_seconds": 5.8,
      "text": "Did you get blood in the stool, coughing up blood or itching?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 194.75,
      "end_seconds": 199.19,
      "duration_seconds": 4.44,
      "text": "Right, uh, no, not a single one."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 200.83,
      "end_seconds": 202.73,
      "duration_seconds": 1.9,
      "text": "So, what about vomiting?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 203.8,
      "end_seconds": 208.85,
      "duration_seconds": 5.05,
      "text": "Sorry, what was I saying, I haven't noticed any vomiting."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 211.62,
      "end_seconds": 216.39,
      "duration_seconds": 4.77,
      "text": "Actually, doctor, I did notice vomiting. She doesn't always say."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 218.3,
      "end_seconds": 225.11,
      "duration_seconds": 6.81,
      "text": "Um, no, I don't think I did. Maybe a little, I'm not sure."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 225.64,
      "end_seconds": 234.03,
      "duration_seconds": 8.39,
      "text": "Alright, I'll note both what you've said and what you've noticed. Anything different when you pass water?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 235.76,
      "end_seconds": 237.76,
      "duration_seconds": 2.0,
      "text": "No, that's all fine."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 241.6,
      "end_seconds": 242.91,
      "duration_seconds": 1.31,
      "text": "Neurologically, anything strange?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 243.91,
      "end_seconds": 246.8,
      "duration_seconds": 2.89,
      "text": "No, uh, that's all normal."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 247.65,
      "end_seconds": 250.23,
      "duration_seconds": 2.58,
      "text": "Let's start with the basic checks."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 260.47,
      "end_seconds": 262.45,
      "duration_seconds": 1.98,
      "text": "Sit still for a moment..."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 281.17,
      "end_seconds": 291.38,
      "duration_seconds": 10.21,
      "text": "Okay: oxygen saturation is 99 percent, blood pressure 128 over 80. And pulse is 74 beats a minute, temp 36.8 degrees."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 294.2,
      "end_seconds": 295.76,
      "duration_seconds": 1.56,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 297.71,
      "end_seconds": 300.38,
      "duration_seconds": 2.67,
      "text": "We'll look at it together shortly."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 301.38,
      "end_seconds": 305.47,
      "duration_seconds": 4.09,
      "text": "Alright, over here please and I'll take a look."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 306.29,
      "end_seconds": 308.65,
      "duration_seconds": 2.36,
      "text": "Hold that for a second."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 322.27,
      "end_seconds": 327.66,
      "duration_seconds": 5.39,
      "text": "I can feel a couple of small glands in your neck, not tender."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 329.23,
      "end_seconds": 330.83,
      "duration_seconds": 1.6,
      "text": "Yeah, no problem."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 332.51,
      "end_seconds": 334.78,
      "duration_seconds": 2.27,
      "text": "Hold that for a second."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 343.52,
      "end_seconds": 348.25,
      "duration_seconds": 4.73,
      "text": "Your tummy is soft and I can't feel any lumps."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 351.07,
      "end_seconds": 364.67,
      "duration_seconds": 13.6,
      "text": "Okay, that's enough for me. So where does that leave us? The most likely explanation is an unexplained weight loss that needs a proper work-up. I can't rule out a chronic infection yet."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 365.71,
      "end_seconds": 368.4,
      "duration_seconds": 2.69,
      "text": "What are the odds it's serious?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 369.72,
      "end_seconds": 391.7,
      "duration_seconds": 21.98,
      "text": "I understand the worry. At the moment I'd say it's an unexplained weight loss that needs a proper work-up, and we'll know more once the a chest X-ray is back. Stop me if I've got anything wrong. You've had no real appetite for nearly five years, and no itching or blood in the stool."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 393.77,
      "end_seconds": 395.35,
      "duration_seconds": 1.58,
      "text": "That's it, yes."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 397.13,
      "end_seconds": 404.97,
      "duration_seconds": 7.84,
      "text": "We should do a chest X-ray for cough and weight loss. I'd like to arrange blood tests for weight loss."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 405.8,
      "end_seconds": 408.59,
      "duration_seconds": 2.79,
      "text": "Do I need to prepare?"
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 410.16,
      "end_seconds": 418.36,
      "duration_seconds": 8.2,
      "text": "Weigh yourself once a week at the same time and note it down. We'll refer you to the chest clinic."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 423.07,
      "end_seconds": 426.11,
      "duration_seconds": 3.04,
      "text": "So, sure, where do I go?"
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 428.03,
      "end_seconds": 437.4,
      "duration_seconds": 9.37,
      "text": "And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 439.21,
      "end_seconds": 440.88,
      "duration_seconds": 1.67,
      "text": "Yes, will do."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 442.05,
      "end_seconds": 449.93,
      "duration_seconds": 7.88,
      "text": "If the symptoms get worse, or you feel really unwell, please come to the emergency department."
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 454.69,
      "end_seconds": 458.08,
      "duration_seconds": 3.39,
      "text": "Mm, yes, I'll bear that in mind."
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 459.57,
      "end_seconds": 465.12,
      "duration_seconds": 5.55,
      "text": "Come back in two weeks. I think we're done unless you have questions."
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 465.96,
      "end_seconds": 469.47,
      "duration_seconds": 3.51,
      "text": "Good, thanks, I'll see you then."
    },
    {
      "segment_id": "SEG0059",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 471.37,
      "end_seconds": 472.76,
      "duration_seconds": 1.39,
      "text": "See you soon."
    }
  ]
}