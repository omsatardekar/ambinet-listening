{
  "schema_version": "1.0",
  "encounter_id": "20352",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.04,
      "end_seconds": 2.87,
      "duration_seconds": 1.83,
      "text": "Welcome. Make yourself comfortable."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 3.95,
      "end_seconds": 6.3,
      "duration_seconds": 2.35,
      "text": "Evening, you know, doctor."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 7.47,
      "end_seconds": 8.92,
      "duration_seconds": 1.45,
      "text": "What's the problem?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 10.29,
      "end_seconds": 13.92,
      "duration_seconds": 3.63,
      "text": "I've been dealing with irregular periods."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 15.17,
      "end_seconds": 17.29,
      "duration_seconds": 2.12,
      "text": "did it come on recently?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 20.99,
      "end_seconds": 24.74,
      "duration_seconds": 3.75,
      "text": "It's been two years, I'm fairly sure."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 25.3,
      "end_seconds": 28.07,
      "duration_seconds": 2.77,
      "text": "How troublesome is it day to day?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 28.64,
      "end_seconds": 30.23,
      "duration_seconds": 1.59,
      "text": "I'd say mild."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 31.19,
      "end_seconds": 38.59,
      "duration_seconds": 7.4,
      "text": "Actually, I was just going to say that the main thing is—"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 38.69,
      "end_seconds": 44.65,
      "duration_seconds": 5.96,
      "text": "Sorry to cut in, doctor, quick question: shall I bring the trolley in now or later?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 46.25,
      "end_seconds": 48.39,
      "duration_seconds": 2.14,
      "text": "later, thanks. Please go on"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 49.51,
      "end_seconds": 62.79,
      "duration_seconds": 13.28,
      "text": "I've also been feeling low, for about a month. I've had extra hair on my chin too, you know, for two years."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_4",
      "role": "UNKNOWN",
      "start_seconds": 64.12,
      "end_seconds": 66.3,
      "duration_seconds": 2.18,
      "text": "Yes, exactly like that."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 68.56,
      "end_seconds": 74.47,
      "duration_seconds": 5.91,
      "text": "have you noticed headaches with vision changes, pelvic pain, heavy bleeding or hot flushes?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 75.12,
      "end_seconds": 77.98,
      "duration_seconds": 2.86,
      "text": "No, nothing to report there."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 82.94,
      "end_seconds": 87.4,
      "duration_seconds": 4.46,
      "text": "so, have you noticed breast discharge or being pregnant?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 89.32,
      "end_seconds": 94.62,
      "duration_seconds": 5.3,
      "text": "No breast discharge or being pregnant, none of it."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 96.3,
      "end_seconds": 99.02,
      "duration_seconds": 2.72,
      "text": "Alright, is your digestion otherwise okay?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 99.94,
      "end_seconds": 102.96,
      "duration_seconds": 3.02,
      "text": "Nothing unusual, um, no."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 103.65,
      "end_seconds": 106.04,
      "duration_seconds": 2.39,
      "text": "What's on your current medicine list?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 107.71,
      "end_seconds": 114.08,
      "duration_seconds": 6.37,
      "text": "I take escitalopram, 10 milligrams, once a day for the anxiety."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 116.14,
      "end_seconds": 121.05,
      "duration_seconds": 4.91,
      "text": "Doctor, our chart from the last visit lists it as 20 milligrams."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 122.1,
      "end_seconds": 125.45,
      "duration_seconds": 3.35,
      "text": "Alright. Did you bring the up-to-date prescription?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 126.82,
      "end_seconds": 135.31,
      "duration_seconds": 8.49,
      "text": "Not with me. I'll bring it next time. I'm on sumatriptan, 50 milligrams, maybe, when needed."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 136.44,
      "end_seconds": 140.36,
      "duration_seconds": 3.92,
      "text": "Have you got the box or the prescription on you?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 142.43,
      "end_seconds": 157.25,
      "duration_seconds": 14.82,
      "text": "Not with me. I'll bring it next time. It's fluoxetine, 20 milligrams, every morning for my mood. Uh, I used to take mirtazapine, but I stopped it."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 158.43,
      "end_seconds": 162.79,
      "duration_seconds": 4.36,
      "text": "So, is there anything relevant on the family side?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 164.1,
      "end_seconds": 168.67,
      "duration_seconds": 4.57,
      "text": "my cousin has psoriasis right, my brother has epilepsy"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 169.79,
      "end_seconds": 172.2,
      "duration_seconds": 2.41,
      "text": "Now some background about your lifestyle."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 173.95,
      "end_seconds": 189.54,
      "duration_seconds": 15.59,
      "text": "Nothing, I'm teetotal. I smoke roughly a pack every two days. I live with my elderly mother. I'm a hairdresser, on my feet all day."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 198.28,
      "end_seconds": 201.58,
      "duration_seconds": 3.3,
      "text": "Any past operations I should know about?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 205.8,
      "end_seconds": 211.57,
      "duration_seconds": 5.77,
      "text": "I had a wisdom tooth extraction under sedation five years ago."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 215.19,
      "end_seconds": 217.92,
      "duration_seconds": 2.73,
      "text": "has anyone ever diagnosed you with something?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 219.41,
      "end_seconds": 231.14,
      "duration_seconds": 11.73,
      "text": "Sorry, what was I saying, I've had anxiety for about a year now. I've been reading about it online and it worried me."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 232.49,
      "end_seconds": 233.85,
      "duration_seconds": 1.36,
      "text": "okay, go on"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 234.51,
      "end_seconds": 248.37,
      "duration_seconds": 13.86,
      "text": "Erm, I've had migraines, yes. Right, I've had depression for about a year now. It's the not knowing that gets to me."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 249.8,
      "end_seconds": 255.1,
      "duration_seconds": 5.3,
      "text": "Sure. Has anything ever caused you a reaction? I mean any allergies."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 256.46,
      "end_seconds": 268.95,
      "duration_seconds": 12.49,
      "text": "Let me think, I think I reacted to some antibiotic once, years ago. I don't remember which one, or what happened exactly."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 284.71,
      "end_seconds": 299.59,
      "duration_seconds": 14.88,
      "text": "Doctor, I've got the readings for you. BMI works out to 24.2, weight 81 kilos, temperature is 36.4 degrees. BP is 110 over 74, respiratory rate 17, oxygen saturation is 99 percent, pulse 67, height 183 centimetres."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 300.85,
      "end_seconds": 301.55,
      "duration_seconds": 0.7,
      "text": "thanks"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 302.57,
      "end_seconds": 304.69,
      "duration_seconds": 2.12,
      "text": "May I examine you now?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 306.47,
      "end_seconds": 309.08,
      "duration_seconds": 2.61,
      "text": "take a deep breath for me"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 323.09,
      "end_seconds": 332.09,
      "duration_seconds": 9.0,
      "text": "there is some acne on the face and extra hair on the chin, and your blood pressure is fine"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 334.0,
      "end_seconds": 335.08,
      "duration_seconds": 1.08,
      "text": "Of course."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 337.52,
      "end_seconds": 360.05,
      "duration_seconds": 22.53,
      "text": "Alright, that's all I needed to check. Right, here's what I'm thinking. This looks most like a pattern that fits polycystic ovary syndrome. The reason I say that is that your story and my examination fit together. I can't rule out a thyroid problem yet. Hormone blood tests is what I'd like next, for irregular periods."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_5",
      "role": "CLINICAL_STAFF",
      "start_seconds": 361.6,
      "end_seconds": 365.37,
      "duration_seconds": 3.77,
      "text": "I can book that for Thursday at 3:30 pm."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 365.96,
      "end_seconds": 377.06,
      "duration_seconds": 11.1,
      "text": "Let's get a pelvic ultrasound, for irregular periods. For this, metformin, 500 milligrams, once a day with food, for three months. That's for cycle regulation and weight."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 378.24,
      "end_seconds": 379.38,
      "duration_seconds": 1.14,
      "text": "Mm, alright."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 380.18,
      "end_seconds": 393.6,
      "duration_seconds": 13.42,
      "text": "regular exercise and a small weight loss can make cycles more regular and please bring the latest prescription or the medicine boxes to the the next visit, so we can settle the dose"
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 394.15,
      "end_seconds": 399.03,
      "duration_seconds": 4.88,
      "text": "Okay, uh, I'll look out for that."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 400.8,
      "end_seconds": 414.21,
      "duration_seconds": 13.41,
      "text": "Keep an eye out, and if you get very heavy bleeding or severe pelvic pain, call us the same day or go to emergency. I'd like you back in three months."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 415.04,
      "end_seconds": 418.81,
      "duration_seconds": 3.77,
      "text": "I'll book it on my way out."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 423.65,
      "end_seconds": 427.26,
      "duration_seconds": 3.61,
      "text": "Anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 427.78,
      "end_seconds": 429.97,
      "duration_seconds": 2.19,
      "text": "thank you, doctor, goodbye"
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 431.71,
      "end_seconds": 433.04,
      "duration_seconds": 1.33,
      "text": "look after yourself"
    }
  ]
}