{
  "schema_version": "1.0",
  "encounter_id": "20198",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.75,
      "end_seconds": 4.62,
      "duration_seconds": 3.87,
      "text": "Hi, doctor, I hope I'm not disturbing you."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.09,
      "end_seconds": 11.11,
      "duration_seconds": 5.02,
      "text": "Okay, yes, come in and sit down. What brings you here today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 13.07,
      "end_seconds": 19.85,
      "duration_seconds": 6.78,
      "text": "Mainly I've been passing out for a couple of minutes. That's why I came."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 21.4,
      "end_seconds": 23.27,
      "duration_seconds": 1.87,
      "text": "When did this begin?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 24.13,
      "end_seconds": 27.98,
      "duration_seconds": 3.85,
      "text": "it's been going on for one week"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 44.64,
      "end_seconds": 48.3,
      "duration_seconds": 3.66,
      "text": "Shall I check your blood pressure and pulse?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 60.71,
      "end_seconds": 63.27,
      "duration_seconds": 2.56,
      "text": "That's it, just a little longer..."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 82.3,
      "end_seconds": 95.14,
      "duration_seconds": 12.84,
      "text": "Okay: SpO2 99 percent on room air, weight 80 kilos, pressure 117 over 71. And pulse is 68 beats a minute, height 161 centimetres, temperature 36.9."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 96.31,
      "end_seconds": 101.75,
      "duration_seconds": 5.44,
      "text": "I'll need to examine you for this, it won't take long."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 103.73,
      "end_seconds": 104.43,
      "duration_seconds": 0.7,
      "text": "Right."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 106.19,
      "end_seconds": 107.52,
      "duration_seconds": 1.33,
      "text": "look straight ahead"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 115.38,
      "end_seconds": 120.48,
      "duration_seconds": 5.1,
      "text": "The neurological examination is normal, with steady walking and equal power."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 125.51,
      "end_seconds": 130.44,
      "duration_seconds": 4.93,
      "text": "Thank you, you can get dressed. Any fever or palpitations?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 131.43,
      "end_seconds": 134.14,
      "duration_seconds": 2.71,
      "text": "No, nothing to report there."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 135.37,
      "end_seconds": 137.68,
      "duration_seconds": 2.31,
      "text": "Any chest pain or vomiting?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 139.23,
      "end_seconds": 142.03,
      "duration_seconds": 2.8,
      "text": "No, not a single one."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 146.7,
      "end_seconds": 148.7,
      "duration_seconds": 2.0,
      "text": "Has your skin been okay?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 150.07,
      "end_seconds": 151.06,
      "duration_seconds": 0.99,
      "text": "No rashes."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 152.22,
      "end_seconds": 154.29,
      "duration_seconds": 2.07,
      "text": "alright, and your job?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 155.79,
      "end_seconds": 159.71,
      "duration_seconds": 3.92,
      "text": "I work in accounts at a hospital."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 161.78,
      "end_seconds": 163.88,
      "duration_seconds": 2.1,
      "text": "tell me about your eating"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 165.03,
      "end_seconds": 171.16,
      "duration_seconds": 6.13,
      "text": "I drink a lot of tea and snack through the day."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 173.18,
      "end_seconds": 176.99,
      "duration_seconds": 3.81,
      "text": "Anything in your past medical history I should know?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 178.96,
      "end_seconds": 181.68,
      "duration_seconds": 2.72,
      "text": "I have high blood pressure."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 183.01,
      "end_seconds": 189.17,
      "duration_seconds": 6.16,
      "text": "Yes, high blood pressure is known to us, good to have that clear."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 203.5,
      "end_seconds": 206.64,
      "duration_seconds": 3.14,
      "text": "does your family have any medical conditions?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 208.5,
      "end_seconds": 213.05,
      "duration_seconds": 4.55,
      "text": "Let me think, my father has Parkinson's disease."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 214.32,
      "end_seconds": 216.88,
      "duration_seconds": 2.56,
      "text": "Are you on any regular medication?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 217.65,
      "end_seconds": 221.56,
      "duration_seconds": 3.91,
      "text": "Um, no, I'm not on anything."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 236.13,
      "end_seconds": 245.98,
      "duration_seconds": 9.85,
      "text": "Are you allergic to anything? Any allergies to medicines or foods? I ask because it helps me narrow things down."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 246.97,
      "end_seconds": 248.63,
      "duration_seconds": 1.66,
      "text": "No known allergies."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 249.57,
      "end_seconds": 252.06,
      "duration_seconds": 2.49,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 253.46,
      "end_seconds": 255.07,
      "duration_seconds": 1.61,
      "text": "no surgery, no"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 256.68,
      "end_seconds": 271.21,
      "duration_seconds": 14.53,
      "text": "from what you've told me and what I found, it points towards a possible first seizure that's my thinking for now, and it may change as we learn more"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 281.35,
      "end_seconds": 310.32,
      "duration_seconds": 28.97,
      "text": "I'm going to order an ECG, for loss of consciousness. No driving until you have been seen in the clinic, and avoid swimming or climbing alone. Let's get you seen by the epilepsy clinic, I'll arrange the letter. The thing that would worry me is if you have another episode or one lasts more than five minutes. If that happens, go to emergency. Let's plan a check in four weeks"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 312.05,
      "end_seconds": 312.75,
      "duration_seconds": 0.7,
      "text": "sure"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 313.3,
      "end_seconds": 316.16,
      "duration_seconds": 2.86,
      "text": "Have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 316.94,
      "end_seconds": 318.97,
      "duration_seconds": 2.03,
      "text": "Thank you, doctor, goodbye."
    }
  ]
}