{
  "schema_version": "1.0",
  "encounter_id": "20207",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.02,
      "end_seconds": 2.59,
      "duration_seconds": 1.57,
      "text": "Welcome. Make yourself comfortable."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 3.32,
      "end_seconds": 6.28,
      "duration_seconds": 2.96,
      "text": "Hello. I hope I'm not late."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 7.5,
      "end_seconds": 12.88,
      "duration_seconds": 5.38,
      "text": "Doctor, I'll sit in if that's okay, I know what's been happening."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 14.36,
      "end_seconds": 20.24,
      "duration_seconds": 5.88,
      "text": "Good, that'll be useful. Pull up a chair. What's been worrying you?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 20.98,
      "end_seconds": 35.18,
      "duration_seconds": 14.2,
      "text": "Yeah, it's sudden hearing loss in my left ear. I don't know what's causing it. I didn't want to bother you but it keeps coming back."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 35.8,
      "end_seconds": 39.37,
      "duration_seconds": 3.57,
      "text": "When was the first time you noticed it?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 40.91,
      "end_seconds": 44.65,
      "duration_seconds": 3.74,
      "text": "It's, It's been like this since last weekend."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 45.39,
      "end_seconds": 53.36,
      "duration_seconds": 7.97,
      "text": "And, And the other thing I wanted to mention is that I can't really—"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 53.46,
      "end_seconds": 59.93,
      "duration_seconds": 6.47,
      "text": "Erm, um, tell the doctor about the other thing, that's what worries me."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 61.37,
      "end_seconds": 64.14,
      "duration_seconds": 2.77,
      "text": "I was getting to that!"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 65.59,
      "end_seconds": 68.9,
      "duration_seconds": 3.31,
      "text": "Has there been trouble following conversations too?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 69.67,
      "end_seconds": 92.39,
      "duration_seconds": 22.72,
      "text": "Yeah, that too. With trouble following conversations, yes, noisy places. That makes it worse. And a ringing in the ear as well, since last Tuesday. Sorry, what was I saying, there was a feeling of fullness, yes, but that went away."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_4",
      "role": "UNKNOWN",
      "start_seconds": 93.25,
      "end_seconds": 95.76,
      "duration_seconds": 2.51,
      "text": "Mm, that's what happened, yes."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 96.49,
      "end_seconds": 101.55,
      "duration_seconds": 5.06,
      "text": "Okay, are you allergic to anything? Any allergies to medicines or foods?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 102.78,
      "end_seconds": 106.15,
      "duration_seconds": 3.37,
      "text": "I mean, I've never had an allergy."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 108.17,
      "end_seconds": 111.12,
      "duration_seconds": 2.95,
      "text": "Do you have any chronic illnesses?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 112.6,
      "end_seconds": 116.68,
      "duration_seconds": 4.08,
      "text": "Yes, high blood pressure. I've got asthma."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 118.52,
      "end_seconds": 123.06,
      "duration_seconds": 4.54,
      "text": "Any inherited conditions that you know of in the family?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 123.76,
      "end_seconds": 127.49,
      "duration_seconds": 3.73,
      "text": "Well, my mother has an underactive thyroid."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 136.48,
      "end_seconds": 138.07,
      "duration_seconds": 1.59,
      "text": "Do you drink alcohol?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 139.91,
      "end_seconds": 145.0,
      "duration_seconds": 5.09,
      "text": "I used to drink heavily but I stopped four years ago."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 145.82,
      "end_seconds": 147.18,
      "duration_seconds": 1.36,
      "text": "Do you smoke?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 148.36,
      "end_seconds": 152.65,
      "duration_seconds": 4.29,
      "text": "I have about eight cigarettes in a day."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 154.09,
      "end_seconds": 156.36,
      "duration_seconds": 2.27,
      "text": "Do you do any exercise?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 157.6,
      "end_seconds": 160.27,
      "duration_seconds": 2.67,
      "text": "I swim twice a week."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 161.83,
      "end_seconds": 164.89,
      "duration_seconds": 3.06,
      "text": "Right, do you follow any particular diet?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 166.47,
      "end_seconds": 170.17,
      "duration_seconds": 3.7,
      "text": "I'm vegetarian and have been for years."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 171.46,
      "end_seconds": 175.72,
      "duration_seconds": 4.26,
      "text": "So, are you taking anything regularly, including from the pharmacy?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 177.3,
      "end_seconds": 184.32,
      "duration_seconds": 7.02,
      "text": "Actually, uh, I'm on losartan, 50 milligrams, maybe, once a day."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 185.68,
      "end_seconds": 188.85,
      "duration_seconds": 3.17,
      "text": "Is the packet here, or the prescription?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 190.59,
      "end_seconds": 199.17,
      "duration_seconds": 8.58,
      "text": "Erm, not with me. I'll bring it next time. Before this I was on hydrochlorothiazide; that's been stopped."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 215.91,
      "end_seconds": 220.82,
      "duration_seconds": 4.91,
      "text": "Have you noticed facial weakness, ear pain or recent flying?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 222.51,
      "end_seconds": 226.31,
      "duration_seconds": 3.8,
      "text": "No, I haven't had any of them."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 228.17,
      "end_seconds": 232.41,
      "duration_seconds": 4.24,
      "text": "Let me check a few things. Any discharge or headache?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 234.38,
      "end_seconds": 237.85,
      "duration_seconds": 3.47,
      "text": "I haven't had discharge or headache, no."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 238.53,
      "end_seconds": 240.65,
      "duration_seconds": 2.12,
      "text": "Any trouble with the waterworks?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 241.83,
      "end_seconds": 243.43,
      "duration_seconds": 1.6,
      "text": "No changes there."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 245.41,
      "end_seconds": 248.91,
      "duration_seconds": 3.5,
      "text": "Let me get the readings out of the way."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 257.47,
      "end_seconds": 260.05,
      "duration_seconds": 2.58,
      "text": "That's it, just a little longer..."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 270.05,
      "end_seconds": 276.45,
      "duration_seconds": 6.4,
      "text": "Okay: SpO2 99 percent on room air, pulse 65, blood pressure 124 over 74."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 278.78,
      "end_seconds": 281.43,
      "duration_seconds": 2.65,
      "text": "Let's move on to the examination."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 287.27,
      "end_seconds": 288.4,
      "duration_seconds": 1.13,
      "text": "That's alright."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 290.39,
      "end_seconds": 293.32,
      "duration_seconds": 2.93,
      "text": "Take a deep breath for me."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 307.45,
      "end_seconds": 314.37,
      "duration_seconds": 6.92,
      "text": "Both eardrums look normal and a tuning fork is heard better in the right ear."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 317.53,
      "end_seconds": 324.26,
      "duration_seconds": 6.73,
      "text": "That's the examination finished. I want a hearing test done, that's for sudden hearing loss."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_5",
      "role": "CLINICAL_STAFF",
      "start_seconds": 328.47,
      "end_seconds": 332.06,
      "duration_seconds": 3.59,
      "text": "I can book that for Thursday at 3:30 pm."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 333.64,
      "end_seconds": 349.0,
      "duration_seconds": 15.36,
      "text": "I think an MRI scan makes sense here, for unilateral hearing loss. I'm going to put you on prednisolone, 60 milligrams, once a day in the morning, for seven days. That's for sudden hearing loss."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 349.87,
      "end_seconds": 353.75,
      "duration_seconds": 3.88,
      "text": "Can I collect it from my own pharmacy?"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 355.68,
      "end_seconds": 369.52,
      "duration_seconds": 13.84,
      "text": "Please attend the hearing test today if you can, as timing matters. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 371.48,
      "end_seconds": 373.09,
      "duration_seconds": 1.61,
      "text": "I'll remember that."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 374.94,
      "end_seconds": 381.91,
      "duration_seconds": 6.97,
      "text": "If the dizziness gets worse or you develop facial weakness, that's the point to come in urgently."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 382.68,
      "end_seconds": 384.83,
      "duration_seconds": 2.15,
      "text": "I, I'll remember that."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 385.65,
      "end_seconds": 391.67,
      "duration_seconds": 6.02,
      "text": "We'll catch up after the hearing test. I think we're done unless you have questions."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 395.0,
      "end_seconds": 398.17,
      "duration_seconds": 3.17,
      "text": "Good, thanks, I'll see you then."
    }
  ]
}