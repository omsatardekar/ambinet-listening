{
  "schema_version": "1.0",
  "encounter_id": "20321",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.02,
      "end_seconds": 8.66,
      "duration_seconds": 7.64,
      "text": "erm, um, hello doctor, sorry, I took a wrong turn on the way here"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 14.01,
      "end_seconds": 18.06,
      "duration_seconds": 4.05,
      "text": "No problem at all, come in. What's troubling you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 20.15,
      "end_seconds": 26.54,
      "duration_seconds": 6.39,
      "text": "Good afternoon, doctor. I look after them so so I thought I'd come."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 27.72,
      "end_seconds": 31.86,
      "duration_seconds": 4.14,
      "text": "Of course, please stay. It's helpful to have you here."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 33.28,
      "end_seconds": 42.39,
      "duration_seconds": 9.11,
      "text": "Ah, mainly pain in my right groin. There's a couple of other things, but that's the main one."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 43.0,
      "end_seconds": 45.98,
      "duration_seconds": 2.98,
      "text": "Has this been going on for long?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 47.08,
      "end_seconds": 57.73,
      "duration_seconds": 10.65,
      "text": "Actually, hm. It was either the end of last month or earlier than that. I couldn't tell you the date."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 59.31,
      "end_seconds": 64.6,
      "duration_seconds": 5.29,
      "text": "Okay, give me more detail on it, whatever comes to mind."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 65.92,
      "end_seconds": 75.2,
      "duration_seconds": 9.28,
      "text": "It feels severe to me. I notice it more with stairs. I'm hoping you can tell me something definite."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 76.64,
      "end_seconds": 79.34,
      "duration_seconds": 2.7,
      "text": "is it it accompanied by anything?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 80.59,
      "end_seconds": 126.53,
      "duration_seconds": 45.94,
      "text": "When it starts I tend to get pain at night as well. Well, as for pain at night, pretty moderate, if I'm being honest. It happens a few times a day. Oh, and a limp. That's been about the same, three weeks. As for limp, I'd say moderate. Yeah, um, I've also had difficulty putting on my socks, for about three months. About difficulty putting on my socks, pretty severe, if I'm being honest."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 139.29,
      "end_seconds": 143.04,
      "duration_seconds": 3.75,
      "text": "Shall I check your blood pressure and and pulse?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 155.2,
      "end_seconds": 157.3,
      "duration_seconds": 2.1,
      "text": "Sit still for a moment..."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 167.37,
      "end_seconds": 172.98,
      "duration_seconds": 5.61,
      "text": "okay: temp 36.5 degrees, pressure 118 over 73, pulse 85."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 173.57,
      "end_seconds": 177.82,
      "duration_seconds": 4.25,
      "text": "hmm, uh, is that alright, doctor?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 178.98,
      "end_seconds": 181.41,
      "duration_seconds": 2.43,
      "text": "I'll interpret them after the examination"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 183.68,
      "end_seconds": 187.36,
      "duration_seconds": 3.68,
      "text": "Alright, over here please and I'll take a look."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 205.59,
      "end_seconds": 207.21,
      "duration_seconds": 1.62,
      "text": "Yeah, no problem."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 209.1,
      "end_seconds": 210.35,
      "duration_seconds": 1.25,
      "text": "Nearly finished here."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 227.47,
      "end_seconds": 233.17,
      "duration_seconds": 5.7,
      "text": "Rotation of the right hip is painful and limited compared with the left."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 237.65,
      "end_seconds": 241.36,
      "duration_seconds": 3.71,
      "text": "You can relax now. Has there been any fall?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 242.31,
      "end_seconds": 245.0,
      "duration_seconds": 2.69,
      "text": "I haven't noticed any fall."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 246.89,
      "end_seconds": 251.6,
      "duration_seconds": 4.71,
      "text": "did you get back pain, swelling of the leg or fever?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 253.51,
      "end_seconds": 256.78,
      "duration_seconds": 3.27,
      "text": "So, no, none that I've noticed."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 257.9,
      "end_seconds": 262.31,
      "duration_seconds": 4.41,
      "text": "Any weight loss or numbness in the leg at all?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 264.05,
      "end_seconds": 270.02,
      "duration_seconds": 5.97,
      "text": "Hmm, no, no weight loss or numbness in the leg."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 271.36,
      "end_seconds": 275.33,
      "duration_seconds": 3.97,
      "text": "Anything with your heart, like skipped beats or fainting?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 276.52,
      "end_seconds": 279.99,
      "duration_seconds": 3.47,
      "text": "Hmm, no, that's been fine."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 281.66,
      "end_seconds": 284.02,
      "duration_seconds": 2.36,
      "text": "Anything different when you pass water?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 285.18,
      "end_seconds": 288.99,
      "duration_seconds": 3.81,
      "text": "that's normal as far as I know"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 290.44,
      "end_seconds": 294.45,
      "duration_seconds": 4.01,
      "text": "Do you react to any medicines or foods? Any allergies?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 295.03,
      "end_seconds": 308.72,
      "duration_seconds": 13.69,
      "text": "Hmm, uh, there was some antibiotic, I was told I was allergic. But I couldn't tell you what it was called or what it did."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 309.23,
      "end_seconds": 312.62,
      "duration_seconds": 3.39,
      "text": "What do you do during the day?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 314.05,
      "end_seconds": 317.74,
      "duration_seconds": 3.69,
      "text": "I look after my grandchildren most days."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 318.58,
      "end_seconds": 320.92,
      "duration_seconds": 2.34,
      "text": "do you do any exercise?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 326.21,
      "end_seconds": 329.06,
      "duration_seconds": 2.85,
      "text": "I swim twice a week."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 330.6,
      "end_seconds": 334.38,
      "duration_seconds": 3.78,
      "text": "Any health conditions I should have on record?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 335.37,
      "end_seconds": 339.55,
      "duration_seconds": 4.18,
      "text": "Arthritis in my knees, for five years."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 340.58,
      "end_seconds": 342.31,
      "duration_seconds": 1.73,
      "text": "is there anything more?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 343.15,
      "end_seconds": 352.83,
      "duration_seconds": 9.68,
      "text": "Ah, um, I have high blood pressure, for about a year. I've had diabetes, yes."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 353.61,
      "end_seconds": 355.57,
      "duration_seconds": 1.96,
      "text": "Is there anything more?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 357.3,
      "end_seconds": 361.19,
      "duration_seconds": 3.89,
      "text": "I've, I've had heart disease, yes"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 362.09,
      "end_seconds": 373.67,
      "duration_seconds": 11.58,
      "text": "Mm, okay. Okay, I can see high blood pressure and diabetes in your file as well. Which medicines do you take at the moment?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 375.77,
      "end_seconds": 384.42,
      "duration_seconds": 8.65,
      "text": "She is on paracetamol, when needed for the knee pain, I give it to her."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 390.49,
      "end_seconds": 392.92,
      "duration_seconds": 2.43,
      "text": "And what strength is that?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 394.62,
      "end_seconds": 404.98,
      "duration_seconds": 10.36,
      "text": "It's 650 milligrams. She is on glimepiride, 2 milligrams, before breakfast for my sugar, I give it to her."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 405.48,
      "end_seconds": 406.18,
      "duration_seconds": 0.7,
      "text": "sure"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 407.07,
      "end_seconds": 412.26,
      "duration_seconds": 5.19,
      "text": "Uh, it's clopidogrel, 75 milligrams, once a day, doctor."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 413.8,
      "end_seconds": 418.53,
      "duration_seconds": 4.73,
      "text": "So, what about your parents, brothers or sisters, any conditions?"
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 420.45,
      "end_seconds": 422.74,
      "duration_seconds": 2.29,
      "text": "My brother has epilepsy."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 424.78,
      "end_seconds": 428.18,
      "duration_seconds": 3.4,
      "text": "what operations have you had, if any?"
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 429.57,
      "end_seconds": 435.36,
      "duration_seconds": 5.79,
      "text": "Just two stents put in my heart, three years ago."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 437.89,
      "end_seconds": 448.47,
      "duration_seconds": 10.58,
      "text": "Okay, thinking it through, I think we're dealing with osteoarthritis of the right hip at this stage. Another possibility is bursitis."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 464.17,
      "end_seconds": 468.67,
      "duration_seconds": 4.5,
      "text": "I want a hip X-ray done, that's for hip pain."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 469.77,
      "end_seconds": 475.77,
      "duration_seconds": 6.0,
      "text": "sorry, what was I saying, where would I go for that?"
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 476.56,
      "end_seconds": 480.58,
      "duration_seconds": 4.02,
      "text": "I think blood tests makes sense here, for joint pain"
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 481.28,
      "end_seconds": 484.43,
      "duration_seconds": 3.15,
      "text": "Where would I go for that?"
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 487.92,
      "end_seconds": 497.77,
      "duration_seconds": 9.85,
      "text": "Keep walking in short regular bursts and use a stick in the opposite hand. Book a review in six weeks."
    },
    {
      "segment_id": "SEG0059",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 500.23,
      "end_seconds": 500.93,
      "duration_seconds": 0.7,
      "text": "sure"
    },
    {
      "segment_id": "SEG0060",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 504.56,
      "end_seconds": 507.26,
      "duration_seconds": 2.7,
      "text": "does all of that make sense?"
    },
    {
      "segment_id": "SEG0061",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 507.97,
      "end_seconds": 511.4,
      "duration_seconds": 3.43,
      "text": "good, thanks, I'll see you then"
    }
  ]
}