{
  "schema_version": "1.0",
  "encounter_id": "20413",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.4,
      "end_seconds": 6.05,
      "duration_seconds": 4.65,
      "text": "Let me think, sorry, doctor, shall I sit here?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.28,
      "end_seconds": 11.28,
      "duration_seconds": 4.0,
      "text": "No problem at all, come in. What's troubling you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 13.35,
      "end_seconds": 17.85,
      "duration_seconds": 4.5,
      "text": "Well, you know, I've been having loud snoring."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 19.24,
      "end_seconds": 23.7,
      "duration_seconds": 4.46,
      "text": "Since when exactly? These questions might sound routine, but they matter."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 24.89,
      "end_seconds": 28.17,
      "duration_seconds": 3.28,
      "text": "It's been about a month now."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 30.92,
      "end_seconds": 33.77,
      "duration_seconds": 2.85,
      "text": "Okay, is anything making it worse?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 35.38,
      "end_seconds": 39.98,
      "duration_seconds": 4.6,
      "text": "yes, lying on my back that makes it worse"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 45.8,
      "end_seconds": 49.37,
      "duration_seconds": 3.57,
      "text": "Alright, does anything else come with it?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 51.38,
      "end_seconds": 58.61,
      "duration_seconds": 7.23,
      "text": "My partner noticing pauses in my breathing goes along with it, most of the time."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 64.01,
      "end_seconds": 67.78,
      "duration_seconds": 3.77,
      "text": "Have you been feeling sleepy during the day?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 68.83,
      "end_seconds": 84.39,
      "duration_seconds": 15.56,
      "text": "Yes, for two months. About feeling sleepy during the day, a three out of ten, I suppose. The my partner noticing pauses in my breathing? That's been for two months."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 86.86,
      "end_seconds": 92.03,
      "duration_seconds": 5.17,
      "text": "Have you had loud snoring before, or is this the first time?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 93.02,
      "end_seconds": 99.43,
      "duration_seconds": 6.41,
      "text": "Let me think, I had a similar thing last winter. It went away."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 116.46,
      "end_seconds": 119.83,
      "duration_seconds": 3.37,
      "text": "alright, and chest pain, any of that?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 121.03,
      "end_seconds": 125.53,
      "duration_seconds": 4.5,
      "text": "not at all, uh, no chest pain"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 127.45,
      "end_seconds": 131.7,
      "duration_seconds": 4.25,
      "text": "and what about low mood, leg swelling or palpitations?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 132.45,
      "end_seconds": 139.5,
      "duration_seconds": 7.05,
      "text": "I mean, I haven't had low mood, leg swelling or palpitations, no"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 141.27,
      "end_seconds": 143.62,
      "duration_seconds": 2.35,
      "text": "Any rashes or skin problems otherwise?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 145.25,
      "end_seconds": 146.2,
      "duration_seconds": 0.95,
      "text": "Skin's normal."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 147.16,
      "end_seconds": 150.44,
      "duration_seconds": 3.28,
      "text": "has your heart given you any trouble?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 151.66,
      "end_seconds": 154.67,
      "duration_seconds": 3.01,
      "text": "Mm, no, that's been fine."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 155.95,
      "end_seconds": 158.52,
      "duration_seconds": 2.57,
      "text": "Do you have any long-term conditions?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 159.15,
      "end_seconds": 160.31,
      "duration_seconds": 1.16,
      "text": "Yes, diabetes."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 161.48,
      "end_seconds": 172.65,
      "duration_seconds": 11.17,
      "text": "Yes, carry on. Yes, diabetes is known to us, good to have that clear. Has anyone in your family had anything serious?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 173.43,
      "end_seconds": 176.47,
      "duration_seconds": 3.04,
      "text": "Yeah, my aunt has rheumatoid arthritis."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 177.76,
      "end_seconds": 182.71,
      "duration_seconds": 4.95,
      "text": "Has anything ever caused you a reaction? I mean any allergies."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 183.95,
      "end_seconds": 187.46,
      "duration_seconds": 3.51,
      "text": "No, nothing as far as I know."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 198.77,
      "end_seconds": 200.76,
      "duration_seconds": 1.99,
      "text": "Let's run through your medicines."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 201.93,
      "end_seconds": 206.12,
      "duration_seconds": 4.19,
      "text": "I'm on glimepiride, 2 milligrams, before breakfast."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 209.84,
      "end_seconds": 212.3,
      "duration_seconds": 2.46,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 212.99,
      "end_seconds": 217.45,
      "duration_seconds": 4.46,
      "text": "I mean, nothing, I haven't had any operations."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 223.5,
      "end_seconds": 226.69,
      "duration_seconds": 3.19,
      "text": "What line of work are you in?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 228.6,
      "end_seconds": 233.74,
      "duration_seconds": 5.14,
      "text": "I'm a bus driver, so I sit for long hours."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 234.25,
      "end_seconds": 235.48,
      "duration_seconds": 1.23,
      "text": "are you active?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 236.43,
      "end_seconds": 239.45,
      "duration_seconds": 3.02,
      "text": "I walk the dog every morning."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 241.29,
      "end_seconds": 243.53,
      "duration_seconds": 2.24,
      "text": "I'll do your observations first."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 256.64,
      "end_seconds": 259.53,
      "duration_seconds": 2.89,
      "text": "That's it, just a little longer..."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 280.13,
      "end_seconds": 294.01,
      "duration_seconds": 13.88,
      "text": "Okay: SpO2 97 percent on room air, temperature is 36.8 degrees, height 182 centimetres, BMI works out to 29.0, respiratory rate 16, weight 96 kilos, pressure 151 over 88, pulse 94."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 308.76,
      "end_seconds": 330.45,
      "duration_seconds": 21.69,
      "text": "Let me tell you where I've got to. The most likely explanation is symptoms that suggest obstructive sleep apnoea. It could also be an under-active thyroid, so we'll keep that open. Try to sleep on your side and avoid alcohol close to bedtime. I think we're done unless you have questions."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 331.15,
      "end_seconds": 335.18,
      "duration_seconds": 4.03,
      "text": "Right, I'll do that. Thank you, doctor."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 336.27,
      "end_seconds": 337.59,
      "duration_seconds": 1.32,
      "text": "All the best."
    }
  ]
}