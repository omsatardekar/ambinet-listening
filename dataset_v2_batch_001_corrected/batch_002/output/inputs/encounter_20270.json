  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.68,
      "end_seconds": 6.38,
      "duration_seconds": 5.7,
      "text": "Hello doctor, sorry, I took a wrong turn on the way here."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.35,
      "end_seconds": 11.88,
      "duration_seconds": 4.53,
      "text": "That's fine, sit down. Tell me why you came."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 13.52,
      "end_seconds": 20.72,
      "duration_seconds": 7.2,
      "text": "doctor, it's an itchy rash all over it's getting on my nerves now"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 23.55,
      "end_seconds": 25.41,
      "duration_seconds": 1.86,
      "text": "when did this begin?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 26.55,
      "end_seconds": 34.24,
      "duration_seconds": 7.69,
      "text": "I've had it for about four days. I've been feeling a bit lightheaded too, since yesterday."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 36.15,
      "end_seconds": 39.27,
      "duration_seconds": 3.12,
      "text": "Any throat tightness, vomiting or trouble breathing?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 40.84,
      "end_seconds": 43.49,
      "duration_seconds": 2.65,
      "text": "No, nothing to report there."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 47.53,
      "end_seconds": 50.55,
      "duration_seconds": 3.02,
      "text": "okay, anything different when you pass water?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 52.33,
      "end_seconds": 53.8,
      "duration_seconds": 1.47,
      "text": "No changes there."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 63.01,
      "end_seconds": 67.67,
      "duration_seconds": 4.66,
      "text": "Can you list what you take, tablets, creams or inhalers?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 69.39,
      "end_seconds": 73.89,
      "duration_seconds": 4.5,
      "text": "Seretide inhaler, twice a day for my asthma."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 74.24,
      "end_seconds": 80.85,
      "duration_seconds": 6.61,
      "text": "Okay, go on. Any allergies to tablets, food or anything in the environment?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 82.24,
      "end_seconds": 85.79,
      "duration_seconds": 3.55,
      "text": "I mean, not to my knowledge, no."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 87.26,
      "end_seconds": 91.77,
      "duration_seconds": 4.51,
      "text": "What conditions have you been treated for in the past?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 93.07,
      "end_seconds": 95.26,
      "duration_seconds": 2.19,
      "text": "Asthma, for two years."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 96.5,
      "end_seconds": 100.84,
      "duration_seconds": 4.34,
      "text": "alright, asthma, that that matches what I have here"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 111.72,
      "end_seconds": 112.9,
      "duration_seconds": 1.18,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 114.32,
      "end_seconds": 116.14,
      "duration_seconds": 1.82,
      "text": "No surgery, no."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 117.41,
      "end_seconds": 119.64,
      "duration_seconds": 2.23,
      "text": "do you get out much?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 123.65,
      "end_seconds": 127.62,
      "duration_seconds": 3.97,
      "text": "Not much, I mostly stay in these days."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 128.62,
      "end_seconds": 133.51,
      "duration_seconds": 4.89,
      "text": "so, what does a normal day of food look like?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 134.64,
      "end_seconds": 138.02,
      "duration_seconds": 3.38,
      "text": "Lots of rice, lentils and some fruit."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 139.22,
      "end_seconds": 143.71,
      "duration_seconds": 4.49,
      "text": "Any inherited conditions that you know of in the family?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 145.64,
      "end_seconds": 147.89,
      "duration_seconds": 2.25,
      "text": "My mother had a stroke."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 148.79,
      "end_seconds": 151.75,
      "duration_seconds": 2.96,
      "text": "I'll just record a few vital signs."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 163.93,
      "end_seconds": 166.34,
      "duration_seconds": 2.41,
      "text": "keep your arm relaxed for me.."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 177.79,
      "end_seconds": 187.67,
      "duration_seconds": 9.88,
      "text": "Okay: SpO2 98 percent on room air, heart rate 66. And temp 36.6 degrees, BP is 116 over 75."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 189.82,
      "end_seconds": 194.05,
      "duration_seconds": 4.23,
      "text": "I'd like to check you over now, if that's alright"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 204.69,
      "end_seconds": 205.66,
      "duration_seconds": 0.97,
      "text": "Sure thing."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 206.55,
      "end_seconds": 209.02,
      "duration_seconds": 2.47,
      "text": "Right, I'm just checking this side."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 224.31,
      "end_seconds": 233.71,
      "duration_seconds": 9.4,
      "text": "there are raised pink welts on the trunk and arms, the lips are a little puffy, and the tongue and throat look normal"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 239.7,
      "end_seconds": 241.48,
      "duration_seconds": 1.78,
      "text": "all finished, thank you"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 259.33,
      "end_seconds": 273.81,
      "duration_seconds": 14.48,
      "text": "okay, thinking it through, this looks most like an allergic reaction, possibly to a recently started medicine let's use chlorphenamine, 4 milligrams, every six hours, for three days it's for allergic rash"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 278.75,
      "end_seconds": 280.83,
      "duration_seconds": 2.08,
      "text": "Fine, I'll begin it."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 282.27,
      "end_seconds": 300.96,
      "duration_seconds": 18.69,
      "text": "Stop the new tablet until we know what caused it and write down every medicine you took in the last week. The thing that would worry me is if your throat tightens, your lips swell further or you get breathless. If that happens, go to emergency."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 302.25,
      "end_seconds": 305.48,
      "duration_seconds": 3.23,
      "text": "thank you, um, that's clear"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 307.53,
      "end_seconds": 311.03,
      "duration_seconds": 3.5,
      "text": "What are the next steps as you understand them?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 312.44,
      "end_seconds": 319.67,
      "duration_seconds": 7.23,
      "text": "So, I take the chlorphenamine, 4 milligrams, every six hours. Is that right?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 321.38,
      "end_seconds": 325.19,
      "duration_seconds": 3.81,
      "text": "Yes, exactly right. Does all of that make sense?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 330.03,
      "end_seconds": 333.85,
      "duration_seconds": 3.82,
      "text": "Uh, I think I understand everything. Thanks."
    }
  ]
}