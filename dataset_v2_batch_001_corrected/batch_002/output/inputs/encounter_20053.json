{
  "schema_version": "1.0",
  "encounter_id": "20053",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.58,
      "end_seconds": 3.19,
      "duration_seconds": 2.61,
      "text": "Good afternoon, you know, doctor."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.16,
      "end_seconds": 10.06,
      "duration_seconds": 4.9,
      "text": "Yes, come in and sit down. What brings you here today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 11.47,
      "end_seconds": 17.98,
      "duration_seconds": 6.51,
      "text": "Yeah, it's pain in my heel. I don't know what's causing it."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 18.95,
      "end_seconds": 22.61,
      "duration_seconds": 3.66,
      "text": "Alright, has this been going on for long?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 24.7,
      "end_seconds": 27.45,
      "duration_seconds": 2.75,
      "text": "It's been about three months now."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 28.89,
      "end_seconds": 39.14,
      "duration_seconds": 10.25,
      "text": "Tell me a bit more about it: how bad it gets, how often, and whether anything makes it better or worse."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 40.85,
      "end_seconds": 50.65,
      "duration_seconds": 9.8,
      "text": "Honestly, on and off. Yes, standing long and first steps in the morning. That makes it worse."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 62.82,
      "end_seconds": 67.27,
      "duration_seconds": 4.45,
      "text": "Any numbness in the foot, joint pain elsewhere or back pain?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 69.03,
      "end_seconds": 75.88,
      "duration_seconds": 6.85,
      "text": "No, no numbness in the foot, joint pain elsewhere or back pain."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 76.38,
      "end_seconds": 78.73,
      "duration_seconds": 2.35,
      "text": "Right, right. So, any injury?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 80.35,
      "end_seconds": 81.99,
      "duration_seconds": 1.64,
      "text": "No. No injury."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 82.98,
      "end_seconds": 85.14,
      "duration_seconds": 2.16,
      "text": "Any trouble with the waterworks?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 85.85,
      "end_seconds": 87.89,
      "duration_seconds": 2.04,
      "text": "No, that's all fine."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 88.49,
      "end_seconds": 92.8,
      "duration_seconds": 4.31,
      "text": "Do you have any medical conditions I should know about?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 93.38,
      "end_seconds": 96.64,
      "duration_seconds": 3.26,
      "text": "No, nothing I can think of."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 108.31,
      "end_seconds": 109.55,
      "duration_seconds": 1.24,
      "text": "Do you smoke?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 110.29,
      "end_seconds": 114.35,
      "duration_seconds": 4.06,
      "text": "I smoke roughly a pack every two days."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 116.39,
      "end_seconds": 118.27,
      "duration_seconds": 1.88,
      "text": "And alcohol, how much?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 120.02,
      "end_seconds": 125.48,
      "duration_seconds": 5.46,
      "text": "I used to drink heavily but I stopped four years ago."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 126.24,
      "end_seconds": 127.82,
      "duration_seconds": 1.58,
      "text": "How active are you?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 129.8,
      "end_seconds": 132.98,
      "duration_seconds": 3.18,
      "text": "I hardly move around during the day."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 134.85,
      "end_seconds": 137.02,
      "duration_seconds": 2.17,
      "text": "Is there someone at home?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 137.58,
      "end_seconds": 141.21,
      "duration_seconds": 3.63,
      "text": "My husband and I live above the shop."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 142.71,
      "end_seconds": 145.78,
      "duration_seconds": 3.07,
      "text": "What do you do during the day?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 147.68,
      "end_seconds": 150.98,
      "duration_seconds": 3.3,
      "text": "I look after my grandchildren most days."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 152.74,
      "end_seconds": 155.65,
      "duration_seconds": 2.91,
      "text": "Do you take any regular medication?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 156.56,
      "end_seconds": 159.11,
      "duration_seconds": 2.55,
      "text": "No, I'm not on anything."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 164.28,
      "end_seconds": 167.15,
      "duration_seconds": 2.87,
      "text": "I'll just record a few vital signs."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 175.07,
      "end_seconds": 177.83,
      "duration_seconds": 2.76,
      "text": "Keep your arm relaxed for me..."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 193.31,
      "end_seconds": 198.44,
      "duration_seconds": 5.13,
      "text": "Okay: temperature 36.7, pressure 114 over 79, heart rate 78."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 199.41,
      "end_seconds": 200.95,
      "duration_seconds": 1.54,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 201.56,
      "end_seconds": 205.38,
      "duration_seconds": 3.82,
      "text": "They help me see the whole picture, more shortly."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 207.68,
      "end_seconds": 210.07,
      "duration_seconds": 2.39,
      "text": "May I examine you now?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 219.5,
      "end_seconds": 220.44,
      "duration_seconds": 0.94,
      "text": "Sure thing."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 222.37,
      "end_seconds": 223.8,
      "duration_seconds": 1.43,
      "text": "Does that hurt?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 234.45,
      "end_seconds": 243.2,
      "duration_seconds": 8.75,
      "text": "There is a sore spot at the inner front of the heel bone and pulling the toes back makes it worse."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 248.46,
      "end_seconds": 254.07,
      "duration_seconds": 5.61,
      "text": "Please sit back down. Okay, thinking it through, this is probably plantar fasciitis."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 255.95,
      "end_seconds": 259.38,
      "duration_seconds": 3.43,
      "text": "Is this serious, uh, doctor?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 260.9,
      "end_seconds": 267.6,
      "duration_seconds": 6.7,
      "text": "I can't promise yet, but most people with plantar fasciitis do well once it's treated properly."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 284.44,
      "end_seconds": 288.32,
      "duration_seconds": 3.88,
      "text": "Let's get a foot X-ray, for heel pain."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 289.08,
      "end_seconds": 291.34,
      "duration_seconds": 2.26,
      "text": "When would that take place?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 292.94,
      "end_seconds": 312.68,
      "duration_seconds": 19.74,
      "text": "You'll be taking ibuprofen gel, three times a day, for two weeks. It's for heel pain. Stretch the calf and the sole of the foot before getting out of bed and wear cushioned shoes. I'll also refer you to podiatry."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 313.44,
      "end_seconds": 315.24,
      "duration_seconds": 1.8,
      "text": "Alright, thank you."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 316.91,
      "end_seconds": 319.14,
      "duration_seconds": 2.23,
      "text": "Come back in six weeks."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 320.9,
      "end_seconds": 323.59,
      "duration_seconds": 2.69,
      "text": "Yes, um, that's manageable."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 324.84,
      "end_seconds": 328.72,
      "duration_seconds": 3.88,
      "text": "That's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 329.55,
      "end_seconds": 331.56,
      "duration_seconds": 2.01,
      "text": "Thank you, that's helpful."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 333.25,
      "end_seconds": 334.7,
      "duration_seconds": 1.45,
      "text": "Goodbye for now."
    }
  ]
}