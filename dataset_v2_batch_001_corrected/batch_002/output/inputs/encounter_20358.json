{
  "schema_version": "1.0",
  "encounter_id": "20358",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.96,
      "end_seconds": 4.43,
      "duration_seconds": 3.47,
      "text": "Good evening, doctor, thanks for seeing me."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.7,
      "end_seconds": 10.34,
      "duration_seconds": 4.64,
      "text": "Yes, come in and sit down. What brings you here today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 11.52,
      "end_seconds": 19.99,
      "duration_seconds": 8.47,
      "text": "Doctor, it's a painful rash on one side of my chest. It's getting on my nerves now."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 21.6,
      "end_seconds": 25.82,
      "duration_seconds": 4.22,
      "text": "Let me get the readings out of the way."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 39.05,
      "end_seconds": 41.52,
      "duration_seconds": 2.47,
      "text": "Keep your arm relaxed for me..."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 57.36,
      "end_seconds": 69.46,
      "duration_seconds": 12.1,
      "text": "Okay: temperature 38.4, respiratory rate 18, SpO2 96 percent on room air, pressure 117 over 71, pulse 91. Has this been going on for long?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 71.15,
      "end_seconds": 83.46,
      "duration_seconds": 12.31,
      "text": "Honestly I can't say exactly when it started. It might have been last month or the month before, I really can't pin it down."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 84.68,
      "end_seconds": 93.46,
      "duration_seconds": 8.78,
      "text": "Can you describe it a bit more for me? How strong it is, what the pattern is, what helps."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 95.08,
      "end_seconds": 99.66,
      "duration_seconds": 4.58,
      "text": "Moderate, really. Clothes rubbing definitely sets it off."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 101.53,
      "end_seconds": 105.69,
      "duration_seconds": 4.16,
      "text": "Has there been small blisters in a band too?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 106.61,
      "end_seconds": 115.27,
      "duration_seconds": 8.66,
      "text": "Yes, for about two weeks. I had burning pain before the rash before. That's settled now, though."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 125.16,
      "end_seconds": 127.52,
      "duration_seconds": 2.36,
      "text": "Any rash near the eye?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 128.44,
      "end_seconds": 131.7,
      "duration_seconds": 3.26,
      "text": "No, no rash near the eye."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 132.81,
      "end_seconds": 137.68,
      "duration_seconds": 4.87,
      "text": "Have you had any contact with chickenpox, vision changes or confusion?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 141.37,
      "end_seconds": 147.26,
      "duration_seconds": 5.89,
      "text": "Uh, no, no contact with chickenpox, vision changes or confusion."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 149.17,
      "end_seconds": 152.21,
      "duration_seconds": 3.04,
      "text": "Any problems with your joints or muscles?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 153.53,
      "end_seconds": 155.32,
      "duration_seconds": 1.79,
      "text": "I move fine otherwise."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 157.31,
      "end_seconds": 161.09,
      "duration_seconds": 3.78,
      "text": "Anything with your heart, like skipped beats or fainting?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 161.95,
      "end_seconds": 163.89,
      "duration_seconds": 1.94,
      "text": "No, that's been fine."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 177.24,
      "end_seconds": 178.44,
      "duration_seconds": 1.2,
      "text": "Do you smoke?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 179.16,
      "end_seconds": 182.56,
      "duration_seconds": 3.4,
      "text": "I quit smoking around ten years ago."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 183.41,
      "end_seconds": 185.02,
      "duration_seconds": 1.61,
      "text": "How active are you?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 186.33,
      "end_seconds": 189.58,
      "duration_seconds": 3.25,
      "text": "I hardly move around during the day."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 191.27,
      "end_seconds": 195.4,
      "duration_seconds": 4.13,
      "text": "Okay, what does a normal day of food look like?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 198.62,
      "end_seconds": 201.9,
      "duration_seconds": 3.28,
      "text": "Lots of rice, lentils and some fruit."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 203.03,
      "end_seconds": 205.98,
      "duration_seconds": 2.95,
      "text": "Do you have any long-term conditions?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 206.87,
      "end_seconds": 221.21,
      "duration_seconds": 14.34,
      "text": "High blood pressure, for about a year. High cholesterol, for about ten years. I'm not great at remembering details, so bear with me. An irregular heartbeat, for two years."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 223.06,
      "end_seconds": 233.34,
      "duration_seconds": 10.28,
      "text": "Yes, carry on. Yes, an irregular heartbeat is known to us, good to have that clear. Any past operations I should know about?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 234.16,
      "end_seconds": 239.0,
      "duration_seconds": 4.84,
      "text": "Yes, I had my septum straightened, in my thirties."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 239.99,
      "end_seconds": 242.89,
      "duration_seconds": 2.9,
      "text": "Before we go further, any allergies?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 243.47,
      "end_seconds": 246.74,
      "duration_seconds": 3.27,
      "text": "Tramadol. I come out in... well, vomiting."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 255.74,
      "end_seconds": 259.99,
      "duration_seconds": 4.25,
      "text": "Can you list what you take, tablets, creams or inhalers?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 261.12,
      "end_seconds": 274.4,
      "duration_seconds": 13.28,
      "text": "I'm on hydrochlorothiazide, 12.5 milligrams, every morning for my pressure. Rosuvastatin. I take it 10 milligrams, maybe, at night for my cholesterol."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 275.58,
      "end_seconds": 280.16,
      "duration_seconds": 4.58,
      "text": "Do you have the packet or the prescription with you?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 280.71,
      "end_seconds": 287.34,
      "duration_seconds": 6.63,
      "text": "Right, no, it's at home. I'm on warfarin, 3 milligrams, in the evening."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 289.44,
      "end_seconds": 292.95,
      "duration_seconds": 3.51,
      "text": "Now I'm going to do a short physical check."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 293.96,
      "end_seconds": 296.38,
      "duration_seconds": 2.42,
      "text": "I'll listen to your chest now."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 305.86,
      "end_seconds": 314.83,
      "duration_seconds": 8.97,
      "text": "There are clustered blisters on a red base in a band across the right side of the chest, not crossing the midline."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 319.62,
      "end_seconds": 356.01,
      "duration_seconds": 36.39,
      "text": "You can sit up now. Let me tell you where I've got to. The most likely explanation is shingles. Contact dermatitis is also on my list. Let's book a swab from a blister to look into vesicular rash. The treatment will be aciclovir, 800 milligrams, five times a day, for seven days. It's for shingles. Keep the rash clean and dry and avoid contact with pregnant women or newborns until the blisters crust over."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 360.13,
      "end_seconds": 376.23,
      "duration_seconds": 16.1,
      "text": "And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose. See me again in one week. What are the next steps as you understand them?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 376.82,
      "end_seconds": 386.57,
      "duration_seconds": 9.75,
      "text": "So, I take the aciclovir, 800 milligrams, five times a day and come back in one week. Is that right?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 388.57,
      "end_seconds": 394.83,
      "duration_seconds": 6.26,
      "text": "Yes, exactly right. Is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 395.93,
      "end_seconds": 400.94,
      "duration_seconds": 5.01,
      "text": "Let me think, I think I understand everything. Thanks."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 401.8,
      "end_seconds": 403.01,
      "duration_seconds": 1.21,
      "text": "See you soon."
    }
  ]
}