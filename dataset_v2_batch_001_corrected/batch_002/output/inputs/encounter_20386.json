{
  "schema_version": "1.0",
  "encounter_id": "20386",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.81,
      "end_seconds": 3.88,
      "duration_seconds": 3.07,
      "text": "Hello, sorry about the delay, do sit."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 4.64,
      "end_seconds": 5.78,
      "duration_seconds": 1.14,
      "text": "Evening, doctor."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 7.85,
      "end_seconds": 12.95,
      "duration_seconds": 5.1,
      "text": "Okay, so thank you for fitting us in, doctor."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 14.35,
      "end_seconds": 15.56,
      "duration_seconds": 1.21,
      "text": "What's the problem?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 16.93,
      "end_seconds": 19.4,
      "duration_seconds": 2.47,
      "text": "She's been having itching, doctor."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 20.2,
      "end_seconds": 23.43,
      "duration_seconds": 3.23,
      "text": "When was the first time you noticed it?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 29.43,
      "end_seconds": 32.09,
      "duration_seconds": 2.66,
      "text": "I'd say a week, maybe."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 33.35,
      "end_seconds": 37.03,
      "duration_seconds": 3.68,
      "text": "I think it's been nearer two weeks, actually."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 38.62,
      "end_seconds": 43.44,
      "duration_seconds": 4.82,
      "text": "Okay, so roughly one to two weeks. Is that right?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 44.92,
      "end_seconds": 47.25,
      "duration_seconds": 2.33,
      "text": "Yes, somewhere around that."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 52.25,
      "end_seconds": 62.0,
      "duration_seconds": 9.75,
      "text": "Tell me a bit more about it: how bad it gets, how often, and whether anything makes it better or worse."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 62.97,
      "end_seconds": 76.94,
      "duration_seconds": 13.97,
      "text": "It happens a couple of times a week. Pretty moderate, if I'm being honest. Oh, and red, cracked skin on my hands. That's been about the same, four weeks."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 77.68,
      "end_seconds": 79.51,
      "duration_seconds": 1.83,
      "text": "Anything that improves it?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 80.77,
      "end_seconds": 86.23,
      "duration_seconds": 5.46,
      "text": "Moisturiser helps a bit. I've also had dry flaky skin."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 87.07,
      "end_seconds": 90.38,
      "duration_seconds": 3.31,
      "text": "Would you say mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 92.09,
      "end_seconds": 93.53,
      "duration_seconds": 1.44,
      "text": "I'd say severe."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 94.86,
      "end_seconds": 97.32,
      "duration_seconds": 2.46,
      "text": "Tell me about your eating."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 98.2,
      "end_seconds": 103.34,
      "duration_seconds": 5.14,
      "text": "I drink a lot of tea and snack through the day."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 105.25,
      "end_seconds": 109.11,
      "duration_seconds": 3.86,
      "text": "Right, are you in work at the moment?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 110.83,
      "end_seconds": 115.27,
      "duration_seconds": 4.44,
      "text": "Yes, I work in a bakery, early starts."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 116.02,
      "end_seconds": 119.63,
      "duration_seconds": 3.61,
      "text": "Right, are there any illnesses in your family?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 120.68,
      "end_seconds": 125.86,
      "duration_seconds": 5.18,
      "text": "My mother had a stroke. My grandfather had a stroke."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 127.35,
      "end_seconds": 131.13,
      "duration_seconds": 3.78,
      "text": "Any health conditions I should have on record?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 135.37,
      "end_seconds": 147.28,
      "duration_seconds": 11.91,
      "text": "I have eczema. I've got anxiety. I have high blood pressure, for nearly five years. An irregular heartbeat, for nearly five years."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 149.24,
      "end_seconds": 155.16,
      "duration_seconds": 5.92,
      "text": "Okay, I can see anxiety and an irregular heartbeat in your file as well."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 168.35,
      "end_seconds": 172.28,
      "duration_seconds": 3.93,
      "text": "What do you take on a normal day?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 173.25,
      "end_seconds": 178.39,
      "duration_seconds": 5.14,
      "text": "Hydrocortisone cream. I take it when needed for the eczema."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 178.96,
      "end_seconds": 179.96,
      "duration_seconds": 1.0,
      "text": "Mm, okay."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 181.94,
      "end_seconds": 187.27,
      "duration_seconds": 5.33,
      "text": "I take escitalopram, 10 milligrams, once a day for the anxiety."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_4",
      "role": "NURSE",
      "start_seconds": 187.86,
      "end_seconds": 192.37,
      "duration_seconds": 4.51,
      "text": "Doctor, our chart from the last visit lists it as 20 milligrams."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 193.1,
      "end_seconds": 198.03,
      "duration_seconds": 4.93,
      "text": "Okay. Have you got the newest prescription or the box with you?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 199.12,
      "end_seconds": 209.59,
      "duration_seconds": 10.47,
      "text": "Not with me. I'll bring it next time. I'm on ramipril, 5 milligrams, maybe, every morning for my blood pressure."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 210.35,
      "end_seconds": 214.57,
      "duration_seconds": 4.22,
      "text": "Did you happen to bring the box or the paperwork?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 216.49,
      "end_seconds": 220.79,
      "duration_seconds": 4.3,
      "text": "Not with me. I'll bring it next time."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 221.89,
      "end_seconds": 229.47,
      "duration_seconds": 7.58,
      "text": "It's a... um, I can't remember what it's called. It's a little pink tablet."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 231.28,
      "end_seconds": 234.07,
      "duration_seconds": 2.79,
      "text": "Do you remember what it's for?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 234.65,
      "end_seconds": 248.57,
      "duration_seconds": 13.92,
      "text": "For the heart rhythm, I believe. My wife sets them out for me, I just take what I'm given. I had hydrochlorothiazide at one point, but I'm off it now."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 249.95,
      "end_seconds": 254.16,
      "duration_seconds": 4.21,
      "text": "Are there any allergies I should be aware of?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 255.07,
      "end_seconds": 257.55,
      "duration_seconds": 2.48,
      "text": "I've never had an allergy."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 258.83,
      "end_seconds": 261.63,
      "duration_seconds": 2.8,
      "text": "Did you get rash elsewhere or fever?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 262.3,
      "end_seconds": 265.58,
      "duration_seconds": 3.28,
      "text": "No, no rash elsewhere or fever."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 265.93,
      "end_seconds": 275.65,
      "duration_seconds": 9.72,
      "text": "I see, go ahead. Okay, a few quick ones: new soap or cream, joint pain, nail changes or oozing?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 276.17,
      "end_seconds": 278.54,
      "duration_seconds": 2.37,
      "text": "No, none that I've noticed."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 279.33,
      "end_seconds": 283.17,
      "duration_seconds": 3.84,
      "text": "Any pins and needles or loss of strength anywhere?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 286.63,
      "end_seconds": 288.8,
      "duration_seconds": 2.17,
      "text": "No, that's all normal."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_4",
      "role": "NURSE",
      "start_seconds": 290.1,
      "end_seconds": 297.24,
      "duration_seconds": 7.14,
      "text": "Here are the numbers, doctor. Pressure 110 over 70, saturation 98 percent, heart rate 78, temperature 36.5."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 297.79,
      "end_seconds": 298.83,
      "duration_seconds": 1.04,
      "text": "Okay, noted."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 301.37,
      "end_seconds": 305.22,
      "duration_seconds": 3.85,
      "text": "Alright, over here please and I'll take a look."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 306.87,
      "end_seconds": 307.83,
      "duration_seconds": 0.96,
      "text": "That's alright."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 308.69,
      "end_seconds": 310.12,
      "duration_seconds": 1.43,
      "text": "Look straight ahead."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 318.48,
      "end_seconds": 326.18,
      "duration_seconds": 7.7,
      "text": "The skin on both hands is red, dry and cracked in the finger creases, with no weeping."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 328.24,
      "end_seconds": 329.28,
      "duration_seconds": 1.04,
      "text": "Of course."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 334.0,
      "end_seconds": 335.96,
      "duration_seconds": 1.96,
      "text": "You can sit up now."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 349.78,
      "end_seconds": 360.59,
      "duration_seconds": 10.81,
      "text": "Having listened and examined, the most likely explanation is irritant hand dermatitis. Another possibility is a fungal skin infection. Allergic contact dermatitis is still possible."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 361.86,
      "end_seconds": 363.37,
      "duration_seconds": 1.51,
      "text": "Is this permanent?"
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 364.53,
      "end_seconds": 388.69,
      "duration_seconds": 24.16,
      "text": "It's reasonable to be concerned, but right now irritant hand dermatitis is my leading thought, not anything worse. I'm sending you for a patch test because of dermatitis. Use gloves for washing up and moisturise straight after you dry your hands. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 389.95,
      "end_seconds": 393.28,
      "duration_seconds": 3.33,
      "text": "Okay, I'll look out for that."
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 393.8,
      "end_seconds": 406.66,
      "duration_seconds": 12.86,
      "text": "Please don't wait if the symptoms get worse. That's when to be seen urgently. I'd like to see you again if it hasn't settled in two weeks."
    },
    {
      "segment_id": "SEG0059",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 407.51,
      "end_seconds": 408.21,
      "duration_seconds": 0.7,
      "text": "Sure."
    },
    {
      "segment_id": "SEG0060",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 408.75,
      "end_seconds": 413.63,
      "duration_seconds": 4.88,
      "text": "Right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0061",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 414.78,
      "end_seconds": 418.67,
      "duration_seconds": 3.89,
      "text": "Great, you know, thank you for your help."
    }
  ]
}