{
  "schema_version": "1.0",
  "encounter_id": "20146",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.8,
      "end_seconds": 7.06,
      "duration_seconds": 6.26,
      "text": "Doctor, hi, where would you like me to put my coat?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.94,
      "end_seconds": 13.75,
      "duration_seconds": 4.81,
      "text": "Not at all, please sit. What seems to be wrong?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 19.53,
      "end_seconds": 24.84,
      "duration_seconds": 5.31,
      "text": "Um, so... a chesty cough. That's why I came."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 25.85,
      "end_seconds": 28.73,
      "duration_seconds": 2.88,
      "text": "How long has it been like this?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 30.58,
      "end_seconds": 32.88,
      "duration_seconds": 2.3,
      "text": "About... well, ten days."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 34.71,
      "end_seconds": 37.46,
      "duration_seconds": 2.75,
      "text": "So, how frequently does it come?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 39.26,
      "end_seconds": 41.27,
      "duration_seconds": 2.01,
      "text": "Honestly, every other day."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 42.5,
      "end_seconds": 44.88,
      "duration_seconds": 2.38,
      "text": "Is it worse at certain times?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 46.22,
      "end_seconds": 49.73,
      "duration_seconds": 3.51,
      "text": "It's worse with mornings and cold air."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 51.76,
      "end_seconds": 54.61,
      "duration_seconds": 2.85,
      "text": "How much trouble does it give you?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 56.61,
      "end_seconds": 60.39,
      "duration_seconds": 3.78,
      "text": "Um, about a six out of ten."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 61.74,
      "end_seconds": 63.4,
      "duration_seconds": 1.66,
      "text": "Does anything help it?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 64.35,
      "end_seconds": 69.69,
      "duration_seconds": 5.34,
      "text": "Only warm drinks, and it's not much. And yellow phlegm, too."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 71.22,
      "end_seconds": 74.15,
      "duration_seconds": 2.93,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 75.63,
      "end_seconds": 76.88,
      "duration_seconds": 1.25,
      "text": "No, never."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 78.44,
      "end_seconds": 82.92,
      "duration_seconds": 4.48,
      "text": "Any allergies to tablets, food or anything in the environment?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 83.64,
      "end_seconds": 85.13,
      "duration_seconds": 1.49,
      "text": "No known allergies."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 98.1,
      "end_seconds": 99.85,
      "duration_seconds": 1.75,
      "text": "Do you drink alcohol?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 101.05,
      "end_seconds": 104.98,
      "duration_seconds": 3.93,
      "text": "I'll have a glass of wine with dinner."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 106.45,
      "end_seconds": 107.65,
      "duration_seconds": 1.2,
      "text": "What's your work?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 109.5,
      "end_seconds": 114.03,
      "duration_seconds": 4.53,
      "text": "I'm a plumber, lots of bending and kneeling."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 114.94,
      "end_seconds": 118.28,
      "duration_seconds": 3.34,
      "text": "Are you on your own at home?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 119.13,
      "end_seconds": 121.99,
      "duration_seconds": 2.86,
      "text": "I live with my elderly mother."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 123.53,
      "end_seconds": 127.08,
      "duration_seconds": 3.55,
      "text": "What does a normal day of food look like?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 129.03,
      "end_seconds": 132.58,
      "duration_seconds": 3.55,
      "text": "Lots of rice, lentils and some fruit."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 136.9,
      "end_seconds": 140.34,
      "duration_seconds": 3.44,
      "text": "Has anyone ever diagnosed you with something?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 141.89,
      "end_seconds": 152.3,
      "duration_seconds": 10.41,
      "text": "Hmm, I have COPD. I've never really been one for hospitals. I didn't want to bother you but it keeps coming back."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 152.98,
      "end_seconds": 158.53,
      "duration_seconds": 5.55,
      "text": "Okay, can you list what you take, tablets, creams or inhalers?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 159.44,
      "end_seconds": 165.91,
      "duration_seconds": 6.47,
      "text": "Tiotropium inhaler, once a day. Dolo, 650 milligrams, when I get the fever."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 170.62,
      "end_seconds": 172.5,
      "duration_seconds": 1.88,
      "text": "Nothing like leg swelling?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 173.33,
      "end_seconds": 175.31,
      "duration_seconds": 1.98,
      "text": "Nope, no leg swelling."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 176.36,
      "end_seconds": 182.24,
      "duration_seconds": 5.88,
      "text": "Have you noticed weight loss, coughing up blood or sharp chest pain?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 184.17,
      "end_seconds": 186.78,
      "duration_seconds": 2.61,
      "text": "No, none that I've noticed."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 187.73,
      "end_seconds": 189.93,
      "duration_seconds": 2.2,
      "text": "Any trouble with the waterworks?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 191.45,
      "end_seconds": 193.82,
      "duration_seconds": 2.37,
      "text": "No, that's all fine."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 195.23,
      "end_seconds": 205.99,
      "duration_seconds": 10.76,
      "text": "Doctor, I've got the readings for you. Respiratory rate 26, SpO2 94 percent on room air, heart rate 87, pressure 124 over 72."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 207.59,
      "end_seconds": 208.69,
      "duration_seconds": 1.1,
      "text": "Okay, noted."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 211.25,
      "end_seconds": 213.63,
      "duration_seconds": 2.38,
      "text": "Let's move on to the examination."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 227.14,
      "end_seconds": 228.09,
      "duration_seconds": 0.95,
      "text": "Of course."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 230.03,
      "end_seconds": 232.23,
      "duration_seconds": 2.2,
      "text": "Raise your arm for me."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 247.4,
      "end_seconds": 252.33,
      "duration_seconds": 4.93,
      "text": "There are scattered wheezes on both sides and no crackles."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 254.37,
      "end_seconds": 255.93,
      "duration_seconds": 1.56,
      "text": "Yes, that's fine."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 260.92,
      "end_seconds": 279.73,
      "duration_seconds": 18.81,
      "text": "Good, you can sit up again. Right, here's what I'm thinking. My working impression is an infective exacerbation of chronic lung disease. Let me just check I've got this right. You've had a chesty cough for ten days, and no weight loss or sharp chest pain."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 280.32,
      "end_seconds": 281.02,
      "duration_seconds": 0.7,
      "text": "Exactly."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 298.97,
      "end_seconds": 308.12,
      "duration_seconds": 9.15,
      "text": "I want a chest X-ray done, that's for productive cough. I think a sputum sample makes sense here, for purulent sputum."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 309.66,
      "end_seconds": 311.92,
      "duration_seconds": 2.26,
      "text": "When would that take place?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 313.27,
      "end_seconds": 337.55,
      "duration_seconds": 24.28,
      "text": "I'd like you to take doxycycline, 100 milligrams, twice a day, for five days. It's for chest infection. Please don't wait if you become more breathless or your lips turn blue. That's when to be seen urgently. Please come and see me in two weeks. I think we're done unless you have questions."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 338.16,
      "end_seconds": 341.15,
      "duration_seconds": 2.99,
      "text": "Good, thanks, I'll see you then."
    }
  ]
}