{
  "schema_version": "1.0",
  "encounter_id": "20182",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.72,
      "end_seconds": 2.5,
      "duration_seconds": 1.78,
      "text": "Welcome. Make yourself comfortable."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 3.36,
      "end_seconds": 5.66,
      "duration_seconds": 2.3,
      "text": "Hello, uh, doctor."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 7.18,
      "end_seconds": 14.01,
      "duration_seconds": 6.83,
      "text": "Doctor, I'll sit in if that's okay, I know what's been happening."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 15.71,
      "end_seconds": 22.38,
      "duration_seconds": 6.67,
      "text": "Okay, yes, that's no problem at all. Please sit. You came on your own today?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 23.2,
      "end_seconds": 29.08,
      "duration_seconds": 5.88,
      "text": "Um, um, yes, I managed on my own."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 30.56,
      "end_seconds": 34.02,
      "duration_seconds": 3.46,
      "text": "So what can I do for you?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 34.7,
      "end_seconds": 42.69,
      "duration_seconds": 7.99,
      "text": "Yeah, uh, it's thick green mucus. I don't know what's causing it."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 44.28,
      "end_seconds": 47.77,
      "duration_seconds": 3.49,
      "text": "So, how long has it been like this?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 49.16,
      "end_seconds": 59.76,
      "duration_seconds": 10.6,
      "text": "It's, It's been about two weeks, I'm fairly sure. I told myself I'd wait and see, and here I am."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 60.49,
      "end_seconds": 67.37,
      "duration_seconds": 6.88,
      "text": "Actually, I was just going to say that the main thing is—"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_4",
      "role": "NURSE",
      "start_seconds": 67.47,
      "end_seconds": 74.44,
      "duration_seconds": 6.97,
      "text": "Sorry to cut in, doctor, quick question: shall I bring the trolley in now or later?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 75.71,
      "end_seconds": 80.44,
      "duration_seconds": 4.73,
      "text": "So, later, thanks. Please go on. Have you had a headache?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 81.16,
      "end_seconds": 85.06,
      "duration_seconds": 3.9,
      "text": "Okay, so yeah. Three days, I'd say."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 85.87,
      "end_seconds": 88.78,
      "duration_seconds": 2.91,
      "text": "How much trouble does it give you?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 89.87,
      "end_seconds": 102.42,
      "duration_seconds": 12.55,
      "text": "Mostly mild. Oh, and a blocked nose. Sorry, what was I saying, with blocked nose, I'd say moderate. I get some relief from steam."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 102.96,
      "end_seconds": 109.08,
      "duration_seconds": 6.12,
      "text": "So, have you had thick green mucus before, or is this the first time?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 109.61,
      "end_seconds": 119.1,
      "duration_seconds": 9.49,
      "text": "Yes, something like this happened a couple of years ago, and it went away on its own."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_5",
      "role": "UNKNOWN",
      "start_seconds": 120.51,
      "end_seconds": 123.95,
      "duration_seconds": 3.44,
      "text": "Yes, that's right, that's how it was."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 126.03,
      "end_seconds": 130.69,
      "duration_seconds": 4.66,
      "text": "Right, did you get double vision or swelling around the eyes?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 134.57,
      "end_seconds": 149.91,
      "duration_seconds": 15.34,
      "text": "Uh, no, no double vision, no swelling around the eyes. I did have a reduced sense of smell at one point, but that went away on its own."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 153.69,
      "end_seconds": 157.56,
      "duration_seconds": 3.87,
      "text": "Okay, did you get fever, toothache or nosebleeds?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 159.37,
      "end_seconds": 162.41,
      "duration_seconds": 3.04,
      "text": "Uh, none of those, no."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 163.53,
      "end_seconds": 166.35,
      "duration_seconds": 2.82,
      "text": "And your skin, any changes there?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 168.0,
      "end_seconds": 170.88,
      "duration_seconds": 2.88,
      "text": "Nothing on the skin, no."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 188.66,
      "end_seconds": 192.02,
      "duration_seconds": 3.36,
      "text": "Do you take any prescribed or over-the-counter medicines?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 193.35,
      "end_seconds": 199.76,
      "duration_seconds": 6.41,
      "text": "Foracort inhaler. I take it twice a day for my asthma."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 201.1,
      "end_seconds": 211.13,
      "duration_seconds": 10.03,
      "text": "Hmm, it's a... um, I can't remember what it's called. It's a round yellow one."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 212.56,
      "end_seconds": 215.0,
      "duration_seconds": 2.44,
      "text": "Do you remember what it's for?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 215.85,
      "end_seconds": 237.61,
      "duration_seconds": 21.76,
      "text": "For my thyroid, I believe. My daughter sets them out for me, I just take what I'm given. It's metoprolol, 50 milligrams, twice a day for my pressure. Rosuvastatin, 10 milligrams, maybe, at night."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 238.16,
      "end_seconds": 242.21,
      "duration_seconds": 4.05,
      "text": "Did you happen to bring the box or the paperwork?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 242.94,
      "end_seconds": 247.51,
      "duration_seconds": 4.57,
      "text": "Mm, not with me. I'll bring it next time."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 249.3,
      "end_seconds": 252.03,
      "duration_seconds": 2.73,
      "text": "Now some background about your lifestyle."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 253.28,
      "end_seconds": 264.72,
      "duration_seconds": 11.44,
      "text": "I have about eight cigarettes in a day. I'll have a glass of wine with dinner. I'm vegetarian and have been for years."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 269.16,
      "end_seconds": 271.71,
      "duration_seconds": 2.55,
      "text": "Before we go further, any allergies?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 272.68,
      "end_seconds": 280.87,
      "duration_seconds": 8.19,
      "text": "Walnuts. I come out in... well, hives. Erm, yes, erythromycin. I get bad stomach cramps."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 282.23,
      "end_seconds": 288.49,
      "duration_seconds": 6.26,
      "text": "Tell me about any past illnesses or ongoing conditions. Just so I get the full picture."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 289.72,
      "end_seconds": 311.25,
      "duration_seconds": 21.53,
      "text": "Sorry, what was I saying, I have asthma, for five years. I have an underactive thyroid, for two years. Right, you know, I've got high blood pressure. I kept putting it off, which I know isn't sensible."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 312.54,
      "end_seconds": 313.74,
      "duration_seconds": 1.2,
      "text": "Any other things?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 315.74,
      "end_seconds": 329.17,
      "duration_seconds": 13.43,
      "text": "High cholesterol, for about ten years. I mean, I've got heart disease. I'm not great at remembering details, so bear with me."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 329.96,
      "end_seconds": 339.49,
      "duration_seconds": 9.53,
      "text": "Mm, okay. Right, so an underactive thyroid and high blood pressure are already on your record. We'll keep that in mind today."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_4",
      "role": "NURSE",
      "start_seconds": 347.06,
      "end_seconds": 356.98,
      "duration_seconds": 9.92,
      "text": "Okay, so the vitals from earlier. Oxygen saturation is 95 percent, BP is 120 over 68, pulse is 103 beats a minute. Temp 38.6 degrees."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 358.56,
      "end_seconds": 359.26,
      "duration_seconds": 0.7,
      "text": "Thanks."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 360.94,
      "end_seconds": 363.3,
      "duration_seconds": 2.36,
      "text": "Shall I start the examination?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 364.87,
      "end_seconds": 366.91,
      "duration_seconds": 2.04,
      "text": "Tell me if that's sore."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 385.82,
      "end_seconds": 392.1,
      "duration_seconds": 6.28,
      "text": "There is tenderness over both cheeks and the nose is blocked with swollen lining."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 395.48,
      "end_seconds": 432.08,
      "duration_seconds": 36.6,
      "text": "Right, please sit back down. Okay, thinking it through, this looks most like acute sinusitis. I'd also keep a viral cold in mind. I'm prescribing fluticasone nasal spray, 50 micrograms, two sprays each side once a day, for two weeks. That should help with sinus congestion. Steam inhalation and saline rinses can help clear the nose. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 434.09,
      "end_seconds": 439.12,
      "duration_seconds": 5.03,
      "text": "Let me think, um, thank you, that's clear."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 440.43,
      "end_seconds": 443.53,
      "duration_seconds": 3.1,
      "text": "Let's plan a check in two weeks."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 445.34,
      "end_seconds": 452.06,
      "duration_seconds": 6.72,
      "text": "Sorry, um, what was I saying, good, I'll return then."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 453.53,
      "end_seconds": 457.25,
      "duration_seconds": 3.72,
      "text": "That's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 458.56,
      "end_seconds": 462.43,
      "duration_seconds": 3.87,
      "text": "Mm, no, that's all. Thanks a lot."
    }
  ]
}