{
  "schema_version": "1.0",
  "encounter_id": "20378",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.73,
      "end_seconds": 3.42,
      "duration_seconds": 2.69,
      "text": "Good afternoon, you know, doctor."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 4.84,
      "end_seconds": 9.26,
      "duration_seconds": 4.42,
      "text": "Come in. Please sit. How can I help you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 10.21,
      "end_seconds": 19.05,
      "duration_seconds": 8.84,
      "text": "I mean, uh, I've been dealing with a red, hot area on my lower leg."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 19.91,
      "end_seconds": 22.84,
      "duration_seconds": 2.93,
      "text": "How long has this been bothering you?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 23.59,
      "end_seconds": 38.62,
      "duration_seconds": 15.03,
      "text": "I've had it since last weekend. I've also had a swollen leg. I had a bite mark on the shin before. That's settled now, uh, though."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 39.3,
      "end_seconds": 42.68,
      "duration_seconds": 3.38,
      "text": "I'll just record a few vital signs."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 51.96,
      "end_seconds": 54.69,
      "duration_seconds": 2.73,
      "text": "That's it, just a little longer..."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 73.13,
      "end_seconds": 82.48,
      "duration_seconds": 9.35,
      "text": "Okay: pulse 91, respiratory rate 22. And pressure 111 over 74, temperature is 39.2 degrees, oxygen saturation is 95 percent."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 83.5,
      "end_seconds": 87.24,
      "duration_seconds": 3.74,
      "text": "I'll examine you in a second, make yourself comfortable."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 88.55,
      "end_seconds": 90.6,
      "duration_seconds": 2.05,
      "text": "Okay, does that hurt?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 99.5,
      "end_seconds": 108.39,
      "duration_seconds": 8.89,
      "text": "There is a warm, red, tender patch about ten centimetres across on the right shin with mild swelling."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 114.12,
      "end_seconds": 119.6,
      "duration_seconds": 5.48,
      "text": "Please sit back down. Have you had any vomiting, breathlessness, wound or pus?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 125.43,
      "end_seconds": 130.36,
      "duration_seconds": 4.93,
      "text": "I haven't had vomiting, breathlessness, wound or pus, no."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 131.85,
      "end_seconds": 133.99,
      "duration_seconds": 2.14,
      "text": "Any trouble with the waterworks?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 135.07,
      "end_seconds": 136.53,
      "duration_seconds": 1.46,
      "text": "No changes there."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 138.46,
      "end_seconds": 141.72,
      "duration_seconds": 3.26,
      "text": "Anything with your nerves, like weakness or numbness?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 143.14,
      "end_seconds": 146.17,
      "duration_seconds": 3.03,
      "text": "Hmm, no, nothing like that."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 158.03,
      "end_seconds": 160.76,
      "duration_seconds": 2.73,
      "text": "Have you got any known allergies?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 161.3,
      "end_seconds": 171.97,
      "duration_seconds": 10.67,
      "text": "I mean, um, I think I reacted to some antibiotic once, years ago. I don't remember which one, or what happened exactly."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 183.35,
      "end_seconds": 187.07,
      "duration_seconds": 3.72,
      "text": "Okay, what do you take on a normal day?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 192.82,
      "end_seconds": 196.4,
      "duration_seconds": 3.58,
      "text": "Metformin, 500 milligrams, twice a day."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 197.31,
      "end_seconds": 199.84,
      "duration_seconds": 2.53,
      "text": "How long have you taken that?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 201.68,
      "end_seconds": 219.18,
      "duration_seconds": 17.5,
      "text": "For about three months. Telmisartan. I take it 40 milligrams, once a day for my pressure. Metoprolol. I take it 50 milligrams, twice a day. My neighbour said I should get it looked at."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 221.06,
      "end_seconds": 223.86,
      "duration_seconds": 2.8,
      "text": "How long have you been on it?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 224.95,
      "end_seconds": 226.5,
      "duration_seconds": 1.55,
      "text": "Two months now."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 228.11,
      "end_seconds": 230.98,
      "duration_seconds": 2.87,
      "text": "Do you have any chronic illnesses?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 231.98,
      "end_seconds": 234.29,
      "duration_seconds": 2.31,
      "text": "I've had diabetes, yes."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 234.88,
      "end_seconds": 236.3,
      "duration_seconds": 1.42,
      "text": "Yes, carry on."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 238.09,
      "end_seconds": 246.68,
      "duration_seconds": 8.59,
      "text": "I have high blood pressure. I told myself I'd wait and see, and here I am."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 251.48,
      "end_seconds": 252.89,
      "duration_seconds": 1.41,
      "text": "Is that everything?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 255.74,
      "end_seconds": 257.66,
      "duration_seconds": 1.92,
      "text": "I have heart disease."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 258.4,
      "end_seconds": 267.36,
      "duration_seconds": 8.96,
      "text": "Yes, diabetes is known to us, good to have that clear. Any past operations I should know about?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 268.48,
      "end_seconds": 272.16,
      "duration_seconds": 3.68,
      "text": "I had a triple bypass eight years ago."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 273.91,
      "end_seconds": 277.32,
      "duration_seconds": 3.41,
      "text": "A few questions about your lifestyle now."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 279.3,
      "end_seconds": 293.72,
      "duration_seconds": 14.42,
      "text": "I gave up cigarettes last spring. I walk the dog every morning. My partner and our baby. I'm a bus driver, so I sit for long hours."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 305.13,
      "end_seconds": 314.24,
      "duration_seconds": 9.11,
      "text": "From what you've told me and what I found, it fits best with cellulitis of the right leg. Stasis dermatitis is still possible."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 316.18,
      "end_seconds": 318.1,
      "duration_seconds": 1.92,
      "text": "Is this serious, doctor?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 319.73,
      "end_seconds": 332.76,
      "duration_seconds": 13.03,
      "text": "It's reasonable to be concerned, but right now cellulitis of the right leg is my leading thought, not anything worse. I think blood tests makes sense here, for skin infection."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 334.85,
      "end_seconds": 336.34,
      "duration_seconds": 1.49,
      "text": "Does it hurt?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 337.03,
      "end_seconds": 365.78,
      "duration_seconds": 28.75,
      "text": "I think an ultrasound of the leg veins makes sense here, for leg swelling. The result will help us decide whether anything more is needed. For this, flucloxacillin, 500 milligrams, four times a day, for seven days. You take it by mouth. That should help with cellulitis. Mark the edge of the redness with a pen and keep the leg raised when sitting."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 367.47,
      "end_seconds": 383.37,
      "duration_seconds": 15.9,
      "text": "Come back or go to emergency straight away if the redness spreads quickly or you get a high fever. See me again in two days. How would you describe the plan, so we're on the same page?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 385.16,
      "end_seconds": 395.62,
      "duration_seconds": 10.46,
      "text": "So, uh, I take the flucloxacillin, 500 milligrams, four times a day and come back in two days. Is that right?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 397.53,
      "end_seconds": 403.3,
      "duration_seconds": 5.77,
      "text": "Yes, exactly right. Is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 408.73,
      "end_seconds": 412.37,
      "duration_seconds": 3.64,
      "text": "Okay, so thank you, that's helpful."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 414.88,
      "end_seconds": 416.16,
      "duration_seconds": 1.28,
      "text": "See you soon."
    }
  ]
}