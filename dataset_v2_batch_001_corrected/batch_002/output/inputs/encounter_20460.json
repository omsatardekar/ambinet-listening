{
  "schema_version": "1.0",
  "encounter_id": "20460",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 0.8,
      "end_seconds": 8.58,
      "duration_seconds": 7.78,
      "text": "Doctor, your next patient is here. I've done the basics, I'll read them out in a moment."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 9.66,
      "end_seconds": 13.34,
      "duration_seconds": 3.68,
      "text": "Perfect, thanks. Hello there, so what's the trouble?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 15.17,
      "end_seconds": 19.57,
      "duration_seconds": 4.4,
      "text": "Well, I've been having pain in my right ear."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 20.81,
      "end_seconds": 24.21,
      "duration_seconds": 3.4,
      "text": "How long has it been like this?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 24.84,
      "end_seconds": 35.05,
      "duration_seconds": 10.21,
      "text": "It's been about four days, I'm fairly sure. I told myself I'd wait and see, and here I am."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 36.1,
      "end_seconds": 38.76,
      "duration_seconds": 2.66,
      "text": "How often do you get it?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 39.39,
      "end_seconds": 46.39,
      "duration_seconds": 7.0,
      "text": "Honestly, once or twice a day. Oh, I've also had itching in the ear canal."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 47.51,
      "end_seconds": 57.08,
      "duration_seconds": 9.57,
      "text": "Doctor, I've got the readings for you. Pulse 64, temp 36.5 degrees, BP is 110 over 71, respiratory rate 18."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 61.34,
      "end_seconds": 62.44,
      "duration_seconds": 1.1,
      "text": "Okay, noted."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 65.1,
      "end_seconds": 68.99,
      "duration_seconds": 3.89,
      "text": "I'll examine you in a second, make yourself comfortable."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 70.1,
      "end_seconds": 71.03,
      "duration_seconds": 0.93,
      "text": "Of course."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 72.72,
      "end_seconds": 74.8,
      "duration_seconds": 2.08,
      "text": "I'm just checking this side."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 87.49,
      "end_seconds": 96.36,
      "duration_seconds": 8.87,
      "text": "The ear canal is red and swollen with some debris, and it's painful when I pull the ear."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 100.9,
      "end_seconds": 103.07,
      "duration_seconds": 2.17,
      "text": "So, that's the examination finished."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 116.83,
      "end_seconds": 121.29,
      "duration_seconds": 4.46,
      "text": "Let me check a few things. Any recent swimming or dizziness?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 124.92,
      "end_seconds": 129.49,
      "duration_seconds": 4.57,
      "text": "I haven't had recent swimming or dizziness, no."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 131.2,
      "end_seconds": 136.08,
      "duration_seconds": 4.88,
      "text": "Have you had any fever or ringing in the ear?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 137.64,
      "end_seconds": 141.3,
      "duration_seconds": 3.66,
      "text": "Hmm, no, nothing to report there."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 142.86,
      "end_seconds": 146.57,
      "duration_seconds": 3.71,
      "text": "Any pins and needles or loss of strength anywhere?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 152.07,
      "end_seconds": 153.53,
      "duration_seconds": 1.46,
      "text": "Nothing odd there."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 154.11,
      "end_seconds": 156.85,
      "duration_seconds": 2.74,
      "text": "Alright, tell me about your eating."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 157.38,
      "end_seconds": 163.35,
      "duration_seconds": 5.97,
      "text": "I drink a lot of tea and snack through the day."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 164.43,
      "end_seconds": 167.37,
      "duration_seconds": 2.94,
      "text": "Are you on your own at home?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 168.31,
      "end_seconds": 171.15,
      "duration_seconds": 2.84,
      "text": "I live with my elderly mother."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 186.45,
      "end_seconds": 189.0,
      "duration_seconds": 2.55,
      "text": "Have you been to theatre before?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 190.11,
      "end_seconds": 193.42,
      "duration_seconds": 3.31,
      "text": "Just my septum straightened, in my thirties."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 198.69,
      "end_seconds": 202.14,
      "duration_seconds": 3.45,
      "text": "Any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 204.19,
      "end_seconds": 207.65,
      "duration_seconds": 3.46,
      "text": "No, nothing I can think of."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 208.87,
      "end_seconds": 211.55,
      "duration_seconds": 2.68,
      "text": "Do you take any regular medication?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 216.89,
      "end_seconds": 218.44,
      "duration_seconds": 1.55,
      "text": "Nothing regular, no."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 235.39,
      "end_seconds": 238.28,
      "duration_seconds": 2.89,
      "text": "Have you got any known allergies?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 238.81,
      "end_seconds": 240.99,
      "duration_seconds": 2.18,
      "text": "No allergies at all."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 250.25,
      "end_seconds": 256.15,
      "duration_seconds": 5.9,
      "text": "So where does that leave us? It points towards an outer ear canal infection."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 257.67,
      "end_seconds": 261.06,
      "duration_seconds": 3.39,
      "text": "Do you think it's something serious?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 262.75,
      "end_seconds": 295.82,
      "duration_seconds": 33.07,
      "text": "I understand the worry. At the moment I'd say it's an outer ear canal infection, and we'll watch how it goes. We'll begin with antibiotic and steroid ear drops, 3 drops, twice a day, for seven days. That should help with ear canal infection. Keep the ear dry, no swimming, and don't poke anything into it. Avoid taking any extra painkillers on top of what I'm prescribing without checking with us."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 296.6,
      "end_seconds": 312.43,
      "duration_seconds": 15.83,
      "text": "Come back or go to emergency straight away if the ear swells or you get dizzy or feverish. Let's review you in a week. That's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 313.74,
      "end_seconds": 317.51,
      "duration_seconds": 3.77,
      "text": "Um, no, that's all. Thanks a lot."
    }
  ]
}