{
  "schema_version": "1.0",
  "encounter_id": "20005",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.5,
      "end_seconds": 4.9,
      "duration_seconds": 4.4,
      "text": "Right then, come on in. Tell me what's brought you in."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 5.66,
      "end_seconds": 11.75,
      "duration_seconds": 6.09,
      "text": "I wanted to get difficulty putting on my socks looked at."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 13.36,
      "end_seconds": 16.89,
      "duration_seconds": 3.53,
      "text": "What's the timeline, when did it begin?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 17.52,
      "end_seconds": 20.39,
      "duration_seconds": 2.87,
      "text": "About... well, about a month."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 21.37,
      "end_seconds": 24.19,
      "duration_seconds": 2.82,
      "text": "How much trouble does it give you?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 25.18,
      "end_seconds": 33.25,
      "duration_seconds": 8.07,
      "text": "Moderate, really. Sorry, what was I saying, there's pain at night as well."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 34.09,
      "end_seconds": 42.87,
      "duration_seconds": 8.78,
      "text": "Tell me a bit more about it: how bad it gets, how often, and whether anything makes it better or worse."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 43.75,
      "end_seconds": 61.01,
      "duration_seconds": 17.26,
      "text": "oh, um, it's a few times a day i'd give it a five, out of ten i looked a few things up online, and that probably didn't help"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 62.84,
      "end_seconds": 67.18,
      "duration_seconds": 4.34,
      "text": "Has there been stiffness in the hip after sitting too?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 72.71,
      "end_seconds": 82.32,
      "duration_seconds": 9.61,
      "text": "Ah, yes, about the same, three weeks. As for stiffness in the hip after sitting, moderate, I'd say."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 83.78,
      "end_seconds": 94.48,
      "duration_seconds": 10.7,
      "text": "okay, so the vitals from earlier. BP is 111 over 77, respiratory rate 16. Pulse is 71 beats a minute, saturation 97 percent, temperature is 36.7 degrees"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 95.98,
      "end_seconds": 97.53,
      "duration_seconds": 1.55,
      "text": "good, thank you"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 98.9,
      "end_seconds": 102.49,
      "duration_seconds": 3.59,
      "text": "Could you come over to the couch, please?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 103.67,
      "end_seconds": 107.01,
      "duration_seconds": 3.34,
      "text": "Stay as you are for a moment."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 123.67,
      "end_seconds": 128.75,
      "duration_seconds": 5.08,
      "text": "Rotation of the right hip is painful and limited compared with the left."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 130.28,
      "end_seconds": 131.3,
      "duration_seconds": 1.02,
      "text": "Of course."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 133.76,
      "end_seconds": 136.64,
      "duration_seconds": 2.88,
      "text": "Thank you, you can get dressed."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 144.33,
      "end_seconds": 147.56,
      "duration_seconds": 3.23,
      "text": "So, how about numbness in the leg?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 148.39,
      "end_seconds": 152.19,
      "duration_seconds": 3.8,
      "text": "No, none, no numbness in the leg."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 153.81,
      "end_seconds": 157.41,
      "duration_seconds": 3.6,
      "text": "Any fever, fall or back pain at all?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 159.05,
      "end_seconds": 163.4,
      "duration_seconds": 4.35,
      "text": "Well, you know, no, nothing to report there."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 164.66,
      "end_seconds": 168.27,
      "duration_seconds": 3.61,
      "text": "any pins and needles or loss of strength anywhere?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 169.0,
      "end_seconds": 170.6,
      "duration_seconds": 1.6,
      "text": "nothing odd there"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 187.22,
      "end_seconds": 189.78,
      "duration_seconds": 2.56,
      "text": "Do you have any chronic illnesses?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 191.86,
      "end_seconds": 194.91,
      "duration_seconds": 3.05,
      "text": "I've had high blood pressure, yes."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 196.58,
      "end_seconds": 199.22,
      "duration_seconds": 2.64,
      "text": "have you ever had an operation?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 200.32,
      "end_seconds": 205.36,
      "duration_seconds": 5.04,
      "text": "Just part of my thyroid removed, years back."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 206.45,
      "end_seconds": 210.28,
      "duration_seconds": 3.83,
      "text": "Which medicines do you take at the moment?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 212.0,
      "end_seconds": 224.47,
      "duration_seconds": 12.47,
      "text": "Erm, uh, it's telmisartan, 40 milligrams, once a day for my pressure. Uh, I take paracetamol, 1 gram, when needed."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 225.9,
      "end_seconds": 229.09,
      "duration_seconds": 3.19,
      "text": "Is there anything relevant on the family side?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 230.91,
      "end_seconds": 233.84,
      "duration_seconds": 2.93,
      "text": "my sister had breast cancer"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 235.26,
      "end_seconds": 238.64,
      "duration_seconds": 3.38,
      "text": "What do you do during the day?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 239.17,
      "end_seconds": 243.03,
      "duration_seconds": 3.86,
      "text": "I look after my grandchildren most days."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 244.08,
      "end_seconds": 246.24,
      "duration_seconds": 2.16,
      "text": "do you do any exercise?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 247.57,
      "end_seconds": 250.36,
      "duration_seconds": 2.79,
      "text": "I swim twice a week"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 251.31,
      "end_seconds": 256.1,
      "duration_seconds": 4.79,
      "text": "Has anything ever caused you a reaction? I mean any allergies."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 258.19,
      "end_seconds": 262.95,
      "duration_seconds": 4.76,
      "text": "so, no, nothing as far as I know"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 264.07,
      "end_seconds": 278.6,
      "duration_seconds": 14.53,
      "text": "putting it all together, it points towards osteoarthritis of the right hip. I want to be honest that this is an impression, not a final answer. Another possibility is bursitis"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 280.22,
      "end_seconds": 283.8,
      "duration_seconds": 3.58,
      "text": "So, what are the odds it's serious?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 284.68,
      "end_seconds": 292.86,
      "duration_seconds": 8.18,
      "text": "It's reasonable to be concerned, but right now osteoarthritis of the right hip is my leading thought, not anything worse."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 301.74,
      "end_seconds": 311.62,
      "duration_seconds": 9.88,
      "text": "I think blood tests makes sense here, for joint pain. A hip X-ray is what I'd like next, for hip pain."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 312.25,
      "end_seconds": 314.65,
      "duration_seconds": 2.4,
      "text": "Okay, I'll do it."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 318.15,
      "end_seconds": 331.82,
      "duration_seconds": 13.67,
      "text": "Losing even a few kilos takes a lot of load off the hip. I'll want another look after the X-ray. Let me check I've been clear. What will you do once you get home?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 332.51,
      "end_seconds": 337.59,
      "duration_seconds": 5.08,
      "text": "so, I come back after the X-ray is that right?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 341.03,
      "end_seconds": 346.95,
      "duration_seconds": 5.92,
      "text": "Yes, exactly right. That's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 348.62,
      "end_seconds": 353.78,
      "duration_seconds": 5.16,
      "text": "right, um, I'll do that thank you, doctor"
    }
  ]
}