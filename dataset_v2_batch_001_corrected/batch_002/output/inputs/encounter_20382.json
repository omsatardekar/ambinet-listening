{
  "schema_version": "1.0",
  "encounter_id": "20382",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.91,
      "end_seconds": 4.47,
      "duration_seconds": 3.56,
      "text": "Hello, good to see you. Please sit."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 6.05,
      "end_seconds": 8.53,
      "duration_seconds": 2.48,
      "text": "Afternoon, is this seat fine?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 9.14,
      "end_seconds": 13.03,
      "duration_seconds": 3.89,
      "text": "What would you like to start with today?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 14.63,
      "end_seconds": 20.74,
      "duration_seconds": 6.11,
      "text": "It's a band-like headache. I thought I'd wait, but it hasn't gone."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 22.57,
      "end_seconds": 25.44,
      "duration_seconds": 2.87,
      "text": "How long has it been like this?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 31.5,
      "end_seconds": 34.23,
      "duration_seconds": 2.73,
      "text": "It's been four weeks now."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 36.22,
      "end_seconds": 45.83,
      "duration_seconds": 9.61,
      "text": "So, tell me a bit more about it: how bad it gets, how often, and whether anything makes it better or worse."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 46.96,
      "end_seconds": 53.02,
      "duration_seconds": 6.06,
      "text": "I'd say every other day. Paracetamol and a head massage helps a bit."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 54.53,
      "end_seconds": 57.63,
      "duration_seconds": 3.1,
      "text": "Have you noticed anything else alongside it?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 58.3,
      "end_seconds": 71.69,
      "duration_seconds": 13.39,
      "text": "When it starts I tend to get a tight scalp as well. The tight scalp? That's been for about three months. As for tight scalp, it comes and goes."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 75.57,
      "end_seconds": 79.37,
      "duration_seconds": 3.8,
      "text": "Did you get blurred vision, weakness or fever?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 80.98,
      "end_seconds": 85.31,
      "duration_seconds": 4.33,
      "text": "No blurred vision, weakness or fever, none of it."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 85.82,
      "end_seconds": 87.8,
      "duration_seconds": 1.98,
      "text": "Is your chest okay generally?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 90.42,
      "end_seconds": 92.92,
      "duration_seconds": 2.5,
      "text": "No, my breathing's been fine."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 98.95,
      "end_seconds": 103.45,
      "duration_seconds": 4.5,
      "text": "Anything with your heart, like skipped beats or fainting?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 105.44,
      "end_seconds": 110.27,
      "duration_seconds": 4.83,
      "text": "My heart's been fine, as far as I know."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 122.58,
      "end_seconds": 126.11,
      "duration_seconds": 3.53,
      "text": "Any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 126.68,
      "end_seconds": 131.41,
      "duration_seconds": 4.73,
      "text": "I mean, no, I've always been fairly healthy."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 138.55,
      "end_seconds": 142.69,
      "duration_seconds": 4.14,
      "text": "Okay, which medicines do you take at the moment?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 145.14,
      "end_seconds": 147.95,
      "duration_seconds": 2.81,
      "text": "Paracetamol. I take it most days."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 149.89,
      "end_seconds": 152.07,
      "duration_seconds": 2.18,
      "text": "Do you know the dose?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 152.67,
      "end_seconds": 154.15,
      "duration_seconds": 1.48,
      "text": "It's 500 milligrams."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 158.73,
      "end_seconds": 159.51,
      "duration_seconds": 0.78,
      "text": "Any smoking?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 161.03,
      "end_seconds": 164.19,
      "duration_seconds": 3.16,
      "text": "I gave up cigarettes last spring."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 165.88,
      "end_seconds": 169.54,
      "duration_seconds": 3.66,
      "text": "Okay, are you on your own at home?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 175.39,
      "end_seconds": 178.22,
      "duration_seconds": 2.83,
      "text": "I live with my elderly mother."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 179.07,
      "end_seconds": 181.82,
      "duration_seconds": 2.75,
      "text": "What line of work are you in?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 182.67,
      "end_seconds": 187.68,
      "duration_seconds": 5.01,
      "text": "I'm a bus driver, so I sit for long hours."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 188.21,
      "end_seconds": 192.11,
      "duration_seconds": 3.9,
      "text": "Do you react to any medicines or foods? Any allergies?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 193.13,
      "end_seconds": 197.12,
      "duration_seconds": 3.99,
      "text": "Yes, wheat, it gives me itchy skin."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 207.2,
      "end_seconds": 210.63,
      "duration_seconds": 3.43,
      "text": "I'll note down your vital signs first."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 223.81,
      "end_seconds": 226.49,
      "duration_seconds": 2.68,
      "text": "Keep your arm relaxed for me..."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 247.39,
      "end_seconds": 253.29,
      "duration_seconds": 5.9,
      "text": "Okay: pulse 72, pressure 111 over 73, temp 36.7 degrees, saturation 99 percent."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 254.85,
      "end_seconds": 256.3,
      "duration_seconds": 1.45,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 258.01,
      "end_seconds": 260.55,
      "duration_seconds": 2.54,
      "text": "We'll look at it together shortly."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 263.12,
      "end_seconds": 266.83,
      "duration_seconds": 3.71,
      "text": "Right, let's have a proper look at you."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 267.99,
      "end_seconds": 269.81,
      "duration_seconds": 1.82,
      "text": "Yeah, no problem."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 271.45,
      "end_seconds": 273.78,
      "duration_seconds": 2.33,
      "text": "Hold that for a second."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 288.11,
      "end_seconds": 293.96,
      "duration_seconds": 5.85,
      "text": "Neck muscles are tight and tender, and the eye and limb checks are normal."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 299.53,
      "end_seconds": 301.44,
      "duration_seconds": 1.91,
      "text": "Please sit back down."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 311.73,
      "end_seconds": 329.99,
      "duration_seconds": 18.26,
      "text": "Let me tell you where I've got to. I don't have a clear answer today: tension-type headaches with possible medication overuse is possible, and so is migraine. Alright, today I'm not changing anything. Is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 331.37,
      "end_seconds": 334.61,
      "duration_seconds": 3.24,
      "text": "No, that's all. Thanks a lot."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 336.15,
      "end_seconds": 337.47,
      "duration_seconds": 1.32,
      "text": "Look after yourself."
    }
  ]
}