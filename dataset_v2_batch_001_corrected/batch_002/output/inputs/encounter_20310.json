  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.59,
      "end_seconds": 4.98,
      "duration_seconds": 4.39,
      "text": "hi, is it okay to come in now?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.65,
      "end_seconds": 10.62,
      "duration_seconds": 4.97,
      "text": "So, yes, come in and sit down. What brings you here today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 11.67,
      "end_seconds": 14.42,
      "duration_seconds": 2.75,
      "text": "I'm here because of irregular periods."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 15.88,
      "end_seconds": 17.06,
      "duration_seconds": 1.18,
      "text": "Since when exactly?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 18.14,
      "end_seconds": 20.66,
      "duration_seconds": 2.52,
      "text": "about... well, nearly five years"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 21.25,
      "end_seconds": 24.2,
      "duration_seconds": 2.95,
      "text": "Would you say mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 26.21,
      "end_seconds": 27.2,
      "duration_seconds": 0.99,
      "text": "Mostly severe."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 27.77,
      "end_seconds": 32.22,
      "duration_seconds": 4.45,
      "text": "What about spots on your face, have you noticed that?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 33.32,
      "end_seconds": 34.45,
      "duration_seconds": 1.13,
      "text": "Mm, yes."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 44.33,
      "end_seconds": 46.83,
      "duration_seconds": 2.5,
      "text": "Has there been any hot flushes?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 48.21,
      "end_seconds": 50.22,
      "duration_seconds": 2.01,
      "text": "Nope, no hot flushes."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 51.3,
      "end_seconds": 57.95,
      "duration_seconds": 6.65,
      "text": "Let me check a few things. Any pelvic pain, being pregnant or heavy bleeding?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 59.9,
      "end_seconds": 64.52,
      "duration_seconds": 4.62,
      "text": "erm, no, I haven't had any of them"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 65.09,
      "end_seconds": 68.78,
      "duration_seconds": 3.69,
      "text": "On the cardiac side, anything I should know?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 70.65,
      "end_seconds": 74.82,
      "duration_seconds": 4.17,
      "text": "Let me think, no, nothing with my heart."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 76.47,
      "end_seconds": 81.05,
      "duration_seconds": 4.58,
      "text": "Do you have any medical conditions I should know about?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 82.29,
      "end_seconds": 84.47,
      "duration_seconds": 2.18,
      "text": "No, nothing at all."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 85.68,
      "end_seconds": 92.2,
      "duration_seconds": 6.52,
      "text": "Let me ask about allergies, anything at all? These questions might sound routine, but they matter."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 94.18,
      "end_seconds": 95.53,
      "duration_seconds": 1.35,
      "text": "No known allergies."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 96.81,
      "end_seconds": 99.58,
      "duration_seconds": 2.77,
      "text": "Is there any regular medication you use?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 100.26,
      "end_seconds": 103.12,
      "duration_seconds": 2.86,
      "text": "no, nothing at the moment"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 105.04,
      "end_seconds": 106.41,
      "duration_seconds": 1.37,
      "text": "any previous surgeries?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 106.94,
      "end_seconds": 108.63,
      "duration_seconds": 1.69,
      "text": "No surgery, no."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 125.89,
      "end_seconds": 128.08,
      "duration_seconds": 2.19,
      "text": "Do you do any exercise?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 128.98,
      "end_seconds": 131.35,
      "duration_seconds": 2.37,
      "text": "I swim twice a week."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 132.53,
      "end_seconds": 134.57,
      "duration_seconds": 2.04,
      "text": "Do you live by yourself?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 137.37,
      "end_seconds": 141.48,
      "duration_seconds": 4.11,
      "text": "No, I share a house with my brother."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 156.56,
      "end_seconds": 159.71,
      "duration_seconds": 3.15,
      "text": "time for your numbers, if that's okay"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 166.59,
      "end_seconds": 169.05,
      "duration_seconds": 2.46,
      "text": "Okay, this won't take long..."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 190.66,
      "end_seconds": 198.58,
      "duration_seconds": 7.92,
      "text": "okay: temperature is 36.6 degrees, SpO2 99 percent on room air, pressure 121 over 70, heart rate 79."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 200.57,
      "end_seconds": 202.09,
      "duration_seconds": 1.52,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 206.35,
      "end_seconds": 209.52,
      "duration_seconds": 3.17,
      "text": "So, that's fine, I'll explain it soon."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 211.17,
      "end_seconds": 215.2,
      "duration_seconds": 4.03,
      "text": "I'll examine you in a second, make yourself comfortable."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 216.49,
      "end_seconds": 218.3,
      "duration_seconds": 1.81,
      "text": "Let me feel here."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 235.89,
      "end_seconds": 244.17,
      "duration_seconds": 8.28,
      "text": "There is some acne on the face and extra hair on the chin, and your blood pressure is fine."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 248.55,
      "end_seconds": 251.11,
      "duration_seconds": 2.56,
      "text": "Thank you, you can get dressed."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 269.15,
      "end_seconds": 296.75,
      "duration_seconds": 27.6,
      "text": "I think a pelvic ultrasound makes sense here, for irregular periods. I think hormone blood tests makes sense here, for irregular periods. I'll start you on metformin, 500 milligrams, once a day with food, for three months. It's for cycle regulation and weight. Regular exercise and a small weight loss can make cycles more regular"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 298.8,
      "end_seconds": 312.81,
      "duration_seconds": 14.01,
      "text": "keep an eye out, and if you get very heavy bleeding or severe pelvic pain, call us the same day or go to emergency book a review after the scan"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 313.96,
      "end_seconds": 317.02,
      "duration_seconds": 3.06,
      "text": "I mean, that's fine with me."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 320.91,
      "end_seconds": 326.16,
      "duration_seconds": 5.25,
      "text": "so, is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 328.13,
      "end_seconds": 331.32,
      "duration_seconds": 3.19,
      "text": "good, thanks, I'll see you then"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 331.88,
      "end_seconds": 333.11,
      "duration_seconds": 1.23,
      "text": "Goodbye for now."
    }
  ]
