{
  "schema_version": "1.0",
  "encounter_id": "20126",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.96,
      "end_seconds": 6.01,
      "duration_seconds": 5.05,
      "text": "Hmm, hi, is it okay to come in now?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.16,
      "end_seconds": 12.08,
      "duration_seconds": 4.92,
      "text": "Alright, that's fine, sit down. Tell me why you came."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 13.97,
      "end_seconds": 18.17,
      "duration_seconds": 4.2,
      "text": "I've been dealing with pain in my right groin."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 19.08,
      "end_seconds": 25.97,
      "duration_seconds": 6.89,
      "text": "When was the first time you noticed it? Take your time, there's no rush."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 27.11,
      "end_seconds": 33.72,
      "duration_seconds": 6.61,
      "text": "I'd say nearly five years. Actually, no, closer to about a year."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 35.65,
      "end_seconds": 40.87,
      "duration_seconds": 5.22,
      "text": "Okay, give me more detail on it, whatever comes to mind."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 41.49,
      "end_seconds": 52.47,
      "duration_seconds": 10.98,
      "text": "Walking and stairs definitely sets it off. It's all the time. I had a limp before. That's settled now, though."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 53.98,
      "end_seconds": 62.55,
      "duration_seconds": 8.57,
      "text": "Let me check a few things. Any back pain, fall, weight loss or numbness in the leg?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 63.97,
      "end_seconds": 71.44,
      "duration_seconds": 7.47,
      "text": "No back pain, fall, weight loss or numbness in the leg, none of it."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 72.46,
      "end_seconds": 75.87,
      "duration_seconds": 3.41,
      "text": "On the cardiac side, anything I should know?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 77.18,
      "end_seconds": 82.07,
      "duration_seconds": 4.89,
      "text": "My heart's been fine, as far as I know."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 82.93,
      "end_seconds": 87.42,
      "duration_seconds": 4.49,
      "text": "Are you taking anything regularly, including from the pharmacy?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 89.2,
      "end_seconds": 95.01,
      "duration_seconds": 5.81,
      "text": "It's paracetamol, 650 milligrams, when needed for the knee pain."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 95.68,
      "end_seconds": 99.2,
      "duration_seconds": 3.52,
      "text": "Right, are you in work at the moment?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 99.76,
      "end_seconds": 103.73,
      "duration_seconds": 3.97,
      "text": "Yes, I work in a bakery, early starts."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 104.35,
      "end_seconds": 107.05,
      "duration_seconds": 2.7,
      "text": "Do you follow any particular diet?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 108.95,
      "end_seconds": 112.13,
      "duration_seconds": 3.18,
      "text": "I'm vegetarian and have been for years."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 113.96,
      "end_seconds": 115.8,
      "duration_seconds": 1.84,
      "text": "Who lives with you?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 117.14,
      "end_seconds": 119.96,
      "duration_seconds": 2.82,
      "text": "My partner and our baby."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 124.48,
      "end_seconds": 127.31,
      "duration_seconds": 2.83,
      "text": "Have you got any known allergies?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 130.39,
      "end_seconds": 135.39,
      "duration_seconds": 5.0,
      "text": "Yes, nickel. I get a rash on my skin."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 136.76,
      "end_seconds": 139.98,
      "duration_seconds": 3.22,
      "text": "Any health conditions I should have on record?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 141.19,
      "end_seconds": 144.52,
      "duration_seconds": 3.33,
      "text": "I have arthritis in my knees."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 146.5,
      "end_seconds": 152.12,
      "duration_seconds": 5.62,
      "text": "Okay, I can see arthritis in your knees in your file as well."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 167.12,
      "end_seconds": 174.34,
      "duration_seconds": 7.22,
      "text": "Okay, so the vitals from earlier. Heart rate 78, blood pressure 115 over 72, temp 36.5 degrees."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 175.4,
      "end_seconds": 176.44,
      "duration_seconds": 1.04,
      "text": "Okay, noted."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 177.92,
      "end_seconds": 182.37,
      "duration_seconds": 4.45,
      "text": "I'll need to examine you for this, it won't take long."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 200.38,
      "end_seconds": 201.86,
      "duration_seconds": 1.48,
      "text": "Yes, that's fine."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 202.99,
      "end_seconds": 205.45,
      "duration_seconds": 2.46,
      "text": "Tell me if that's sore."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 220.7,
      "end_seconds": 226.94,
      "duration_seconds": 6.24,
      "text": "Rotation of the right hip is painful and limited compared with the left."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 229.09,
      "end_seconds": 231.16,
      "duration_seconds": 2.07,
      "text": "Okay, that's enough for me."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 241.22,
      "end_seconds": 256.12,
      "duration_seconds": 14.9,
      "text": "Right, here's what I'm thinking. The most likely explanation is osteoarthritis of the right hip. That's my thinking for now, and it may change as we learn more. Another possibility is a pinched nerve in the back."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 257.85,
      "end_seconds": 261.68,
      "duration_seconds": 3.83,
      "text": "I'm scared it's something bad. Is it?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 262.67,
      "end_seconds": 287.27,
      "duration_seconds": 24.6,
      "text": "It's reasonable to be concerned, but right now osteoarthritis of the right hip is my leading thought, not anything worse. I'd like to arrange a hip X-ray for hip pain. The result will help us decide whether anything more is needed. I'd like to arrange blood tests for joint pain."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 288.53,
      "end_seconds": 289.75,
      "duration_seconds": 1.22,
      "text": "Right, understood."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 290.89,
      "end_seconds": 310.18,
      "duration_seconds": 19.29,
      "text": "Losing even a few kilos takes a lot of load off the hip. Keep walking in short regular bursts and use a stick in the opposite hand. Keep an eye out, and if the symptoms get worse, call us the same day or go to emergency."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 311.42,
      "end_seconds": 314.54,
      "duration_seconds": 3.12,
      "text": "Yes, I'll bear that in mind."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 319.18,
      "end_seconds": 326.92,
      "duration_seconds": 7.74,
      "text": "Come back in six weeks. Right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 327.91,
      "end_seconds": 330.06,
      "duration_seconds": 2.15,
      "text": "Thank you, that's helpful."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 331.9,
      "end_seconds": 333.32,
      "duration_seconds": 1.42,
      "text": "All the best."
    }
  ]
}