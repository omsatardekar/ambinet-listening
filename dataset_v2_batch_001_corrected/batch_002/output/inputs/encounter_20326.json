{
  "schema_version": "1.0",
  "encounter_id": "20326",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.73,
      "end_seconds": 6.43,
      "duration_seconds": 5.7,
      "text": "Doctor, hi, where would you like me to put my coat?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.13,
      "end_seconds": 11.73,
      "duration_seconds": 4.6,
      "text": "Of course, leave it it there. How can I help?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 12.37,
      "end_seconds": 27.5,
      "duration_seconds": 15.13,
      "text": "I've been passing a lot of urine, and I wanted to get it checked. I'd rather know what's going on than keep guessing. I kept putting it off, which I know isn't sensible"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 28.49,
      "end_seconds": 31.79,
      "duration_seconds": 3.3,
      "text": "has this been going on for long?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 32.7,
      "end_seconds": 36.06,
      "duration_seconds": 3.36,
      "text": "I've had it for four weeks."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 37.48,
      "end_seconds": 41.29,
      "duration_seconds": 3.81,
      "text": "rate it for me, mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 46.01,
      "end_seconds": 48.48,
      "duration_seconds": 2.47,
      "text": "It feels severe to me."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 50.01,
      "end_seconds": 52.47,
      "duration_seconds": 2.46,
      "text": "Does anything else come with it?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 53.93,
      "end_seconds": 78.34,
      "duration_seconds": 24.41,
      "text": "When it starts I tend to get recurrent thrush as well. The recurrent thrush? That's been for nearly five years. I've had being very thirsty too, um, for about a year. About being very thirsty, it feels moderate to me. I've been losing some weight too."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 83.07,
      "end_seconds": 88.31,
      "duration_seconds": 5.24,
      "text": "Have you been passing a lot of urine at any time before this?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 90.25,
      "end_seconds": 95.43,
      "duration_seconds": 5.18,
      "text": "A A bit, last winter. It settled by itself back then."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 106.79,
      "end_seconds": 110.75,
      "duration_seconds": 3.96,
      "text": "Let me get the readings out of the way."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 119.05,
      "end_seconds": 121.55,
      "duration_seconds": 2.5,
      "text": "Keep your arm relaxed for me..."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 132.78,
      "end_seconds": 142.83,
      "duration_seconds": 10.05,
      "text": "Okay: weight 84 kilos, heart rate 94, temp 36.9 degrees. And blood pressure 164 over 98, height 156 centimetres."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 143.83,
      "end_seconds": 146.23,
      "duration_seconds": 2.4,
      "text": "Let's move on to the examination."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 148.17,
      "end_seconds": 149.58,
      "duration_seconds": 1.41,
      "text": "Breathe out slowly."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 163.96,
      "end_seconds": 170.91,
      "duration_seconds": 6.95,
      "text": "Your fingerprick sugar here is high, and your feet have good pulses and normal feeling."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 174.52,
      "end_seconds": 181.27,
      "duration_seconds": 6.75,
      "text": "Alright, good, you can sit up again. Alright, have you noticed chest pain or fever?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 186.44,
      "end_seconds": 190.81,
      "duration_seconds": 4.37,
      "text": "I haven't had chest pain or fever, no."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 191.32,
      "end_seconds": 194.45,
      "duration_seconds": 3.13,
      "text": "sure and what about vomiting or confusion?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 198.3,
      "end_seconds": 201.58,
      "duration_seconds": 3.28,
      "text": "No, uh, no vomiting or confusion."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 204.78,
      "end_seconds": 208.15,
      "duration_seconds": 3.37,
      "text": "How are your joints, any aches elsewhere?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 209.8,
      "end_seconds": 211.8,
      "duration_seconds": 2.0,
      "text": "I move fine otherwise."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 212.67,
      "end_seconds": 215.94,
      "duration_seconds": 3.27,
      "text": "How about your heart, any problems like that?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 217.61,
      "end_seconds": 221.85,
      "duration_seconds": 4.24,
      "text": "My heart's been fine, as far as I know."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 223.93,
      "end_seconds": 226.34,
      "duration_seconds": 2.41,
      "text": "Have you got any known allergies?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 228.02,
      "end_seconds": 235.8,
      "duration_seconds": 7.78,
      "text": "I'm, I'm allergic to erythromycin, I get a rash yes, grass pollen i get itchy eyes"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 244.79,
      "end_seconds": 249.11,
      "duration_seconds": 4.32,
      "text": "Okay, what about your parents, brothers or sisters, any conditions?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 252.04,
      "end_seconds": 256.46,
      "duration_seconds": 4.42,
      "text": "My brother has epilepsy. My grandfather had a stroke."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 271.27,
      "end_seconds": 274.03,
      "duration_seconds": 2.76,
      "text": "do you follow any particular diet?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 274.61,
      "end_seconds": 278.23,
      "duration_seconds": 3.62,
      "text": "I'm vegetarian and have been for years"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 280.0,
      "end_seconds": 281.94,
      "duration_seconds": 1.94,
      "text": "have you retired yet?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 287.55,
      "end_seconds": 291.73,
      "duration_seconds": 4.18,
      "text": "I retired from the post office two years ago."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 292.3,
      "end_seconds": 294.71,
      "duration_seconds": 2.41,
      "text": "what's on your current medicine list?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 296.26,
      "end_seconds": 305.42,
      "duration_seconds": 9.16,
      "text": "Simvastatin i take it 20 milligrams, at night it's telmisartan, 40 milligrams, maybe, once a day for my pressure"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 307.51,
      "end_seconds": 311.01,
      "duration_seconds": 3.5,
      "text": "Is the packet here, or the prescription?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 312.46,
      "end_seconds": 320.19,
      "duration_seconds": 7.73,
      "text": "No, uh, it's at home. I, I take metoprolol, 50 milligrams, twice a day."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 321.04,
      "end_seconds": 325.36,
      "duration_seconds": 4.32,
      "text": "Anything in your past medical history I should know?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 326.95,
      "end_seconds": 328.59,
      "duration_seconds": 1.64,
      "text": "Yes, high cholesterol."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 329.78,
      "end_seconds": 331.21,
      "duration_seconds": 1.43,
      "text": "Yes, carry on."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 332.83,
      "end_seconds": 339.74,
      "duration_seconds": 6.91,
      "text": "Ah, I've had high blood pressure for about a year now. Yes, heart disease."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 341.2,
      "end_seconds": 364.36,
      "duration_seconds": 23.16,
      "text": "Alright, high cholesterol and high blood pressure, that matches what I have here. So where does that leave us? It's hard to say. Symptoms that point to newly developed type 2 diabetes is one possibility and an overactive thyroid another, and I'd rather not commit yet. Let's get a urine test, for polyuria."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 368.1,
      "end_seconds": 371.5,
      "duration_seconds": 3.4,
      "text": "I can book that for Wednesday at 2 pm."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 372.8,
      "end_seconds": 403.85,
      "duration_seconds": 31.05,
      "text": "I want an HbA1c done, that's for suspected diabetes. It's a routine test and it'll give us a much clearer picture. I'd like you to take metformin, 500 milligrams, once a day with food, long term. You take it by mouth. It's for high blood sugar. Cut right down on sugary drinks and keep water with you. Let's get you seen by the diabetes educator, I'll arrange the letter."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 404.6,
      "end_seconds": 416.9,
      "duration_seconds": 12.3,
      "text": "And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose. Okay, anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 418.57,
      "end_seconds": 420.35,
      "duration_seconds": 1.78,
      "text": "That's clear, thanks."
    }
  ]
}