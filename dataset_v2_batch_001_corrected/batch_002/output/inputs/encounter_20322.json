{
  "schema_version": "1.0",
  "encounter_id": "20322",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.62,
      "end_seconds": 3.88,
      "duration_seconds": 3.26,
      "text": "Hi doctor, am I too early?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 9.1,
      "end_seconds": 13.1,
      "duration_seconds": 4.0,
      "text": "Yes, have a seat. Tell me what's going on."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 13.97,
      "end_seconds": 25.78,
      "duration_seconds": 11.81,
      "text": "I've been misplacing things, and I wanted to get it it checked. Work has been very busy so I kept ignoring it."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 26.6,
      "end_seconds": 29.98,
      "duration_seconds": 3.38,
      "text": "okay, how long has this been bothering you?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 31.92,
      "end_seconds": 40.57,
      "duration_seconds": 8.65,
      "text": "oh, it's been going on for about a year. My sister suggested writing things down, but I forgot"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 41.04,
      "end_seconds": 42.1,
      "duration_seconds": 1.06,
      "text": "Right, right."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 43.51,
      "end_seconds": 46.24,
      "duration_seconds": 2.73,
      "text": "There's a low mood as well."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 55.32,
      "end_seconds": 58.23,
      "duration_seconds": 2.91,
      "text": "And what about head injury or hallucinations?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 59.46,
      "end_seconds": 61.82,
      "duration_seconds": 2.36,
      "text": "no, nothing to report there"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 63.84,
      "end_seconds": 70.54,
      "duration_seconds": 6.7,
      "text": "Let me check a few things. Any weakness on one side, bladder problems or falls?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 72.3,
      "end_seconds": 74.35,
      "duration_seconds": 2.05,
      "text": "None of those, no."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 75.66,
      "end_seconds": 79.72,
      "duration_seconds": 4.06,
      "text": "On the cardiac side, anything I should know?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 83.61,
      "end_seconds": 85.27,
      "duration_seconds": 1.66,
      "text": "nothing like that"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 86.54,
      "end_seconds": 88.53,
      "duration_seconds": 1.99,
      "text": "Let's run through your medicines."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 90.33,
      "end_seconds": 100.87,
      "duration_seconds": 10.54,
      "text": "Ramipril. I take it 5 milligrams, every morning for my blood pressure. Simvastatin. I take it 20 milligrams, at night for my cholesterol."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 102.18,
      "end_seconds": 106.14,
      "duration_seconds": 3.96,
      "text": "Are there any allergies I should be aware of?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 111.25,
      "end_seconds": 114.83,
      "duration_seconds": 3.58,
      "text": "Yes, kiwi, it gives me hives."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 115.51,
      "end_seconds": 118.3,
      "duration_seconds": 2.79,
      "text": "Does your family have any medical conditions?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 119.97,
      "end_seconds": 122.47,
      "duration_seconds": 2.5,
      "text": "My uncle has high cholesterol."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 123.46,
      "end_seconds": 126.04,
      "duration_seconds": 2.58,
      "text": "Do you follow any particular diet?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 127.86,
      "end_seconds": 131.27,
      "duration_seconds": 3.41,
      "text": "I'm vegetarian and have been for years."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 133.09,
      "end_seconds": 135.15,
      "duration_seconds": 2.06,
      "text": "Do you do any exercise?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 135.65,
      "end_seconds": 137.95,
      "duration_seconds": 2.3,
      "text": "I swim twice a week"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 139.74,
      "end_seconds": 142.87,
      "duration_seconds": 3.13,
      "text": "are you on your own at home?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 144.39,
      "end_seconds": 147.35,
      "duration_seconds": 2.96,
      "text": "I live with my elderly mother."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 158.22,
      "end_seconds": 161.13,
      "duration_seconds": 2.91,
      "text": "Did you ever have any procedures done?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 163.16,
      "end_seconds": 169.4,
      "duration_seconds": 6.24,
      "text": "Yes, I had a caesarean for my second baby, nine years ago."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 179.33,
      "end_seconds": 182.86,
      "duration_seconds": 3.53,
      "text": "Tell me about any past illnesses or ongoing conditions."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 183.9,
      "end_seconds": 192.23,
      "duration_seconds": 8.33,
      "text": "I've got high blood pressure i've had high cholesterol, yes i told my wife I'd come today"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 193.51,
      "end_seconds": 196.46,
      "duration_seconds": 2.95,
      "text": "I'll just record a few vital signs."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 208.51,
      "end_seconds": 210.91,
      "duration_seconds": 2.4,
      "text": "Sit still for a moment..."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 228.06,
      "end_seconds": 234.79,
      "duration_seconds": 6.73,
      "text": "Okay: pressure 116 over 77, temperature 36.8, saturation 97 percent, heart rate 79."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 236.75,
      "end_seconds": 238.45,
      "duration_seconds": 1.7,
      "text": "is that okay?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 239.0,
      "end_seconds": 243.41,
      "duration_seconds": 4.41,
      "text": "They help me see the whole picture, more shortly."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 246.16,
      "end_seconds": 248.24,
      "duration_seconds": 2.08,
      "text": "May I examine you now?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 249.18,
      "end_seconds": 251.56,
      "duration_seconds": 2.38,
      "text": "Raise your arm for me."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 264.38,
      "end_seconds": 271.79,
      "duration_seconds": 7.41,
      "text": "The memory test score is a little low today and the rest of the neurological check is normal."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 275.72,
      "end_seconds": 291.69,
      "duration_seconds": 15.97,
      "text": "Okay, that's enough for me. So where does that leave us? The most likely explanation is a gradual memory problem that needs further assessment. It could also be a vitamin deficiency, so we'll keep that open."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 293.5,
      "end_seconds": 296.56,
      "duration_seconds": 3.06,
      "text": "Do you think it's something serious?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 301.56,
      "end_seconds": 318.53,
      "duration_seconds": 16.97,
      "text": "I understand the worry at the moment I'd say it's a gradual memory problem that needs further assessment, and we'll know more once the blood tests is back i want blood tests done, that's for memory loss"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 319.83,
      "end_seconds": 324.06,
      "duration_seconds": 4.23,
      "text": "Erm, uh, where would I go for that?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 325.5,
      "end_seconds": 329.99,
      "duration_seconds": 4.49,
      "text": "I want a brain scan done, that's for memory loss."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 331.14,
      "end_seconds": 335.33,
      "duration_seconds": 4.19,
      "text": "um, um, is that done today?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 336.72,
      "end_seconds": 368.9,
      "duration_seconds": 32.18,
      "text": "Keep a daily routine and write things down, a notebook by the door works well. Don't skip meals, and try to eat smaller portions more often through the day. I'd like you to see the older adults' assessment service as well, and I'll write the referral. I'm not ordering a memory test today. If things carry on next month, we'll consider it. See me again in six weeks."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 369.43,
      "end_seconds": 376.29,
      "duration_seconds": 6.86,
      "text": "Let me check I've been clear. What will you do once you get home?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 376.98,
      "end_seconds": 383.63,
      "duration_seconds": 6.65,
      "text": "So, um, I come back in six weeks. Is that right?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 384.47,
      "end_seconds": 388.4,
      "duration_seconds": 3.93,
      "text": "yes, exactly right. That's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 389.44,
      "end_seconds": 392.98,
      "duration_seconds": 3.54,
      "text": "Actually, good, thanks, I'll see you then."
    }
  ]
}