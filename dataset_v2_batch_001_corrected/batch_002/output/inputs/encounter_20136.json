  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.37,
      "end_seconds": 4.4,
      "duration_seconds": 3.03,
      "text": "Hello, sorry about the delay, do sit."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 5.27,
      "end_seconds": 8.77,
      "duration_seconds": 3.5,
      "text": "morning, doctor, sorry about the rush"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 10.02,
      "end_seconds": 16.42,
      "duration_seconds": 6.4,
      "text": "Doctor, I've come along because I know the history, if it helps."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 18.2,
      "end_seconds": 20.46,
      "duration_seconds": 2.26,
      "text": "What's the main thing today?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 21.5,
      "end_seconds": 27.22,
      "duration_seconds": 5.72,
      "text": "Yeah, it's an itch down below. I don't know what's causing it."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_4",
      "role": "NURSE",
      "start_seconds": 28.6,
      "end_seconds": 37.33,
      "duration_seconds": 8.73,
      "text": "Here are the numbers, doctor. Pulse 65, temperature is 36.5 degrees. BP is 122 over 70, SpO2 97 percent on room air."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 38.85,
      "end_seconds": 41.38,
      "duration_seconds": 2.53,
      "text": "Thanks. Did it come on recently?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 43.13,
      "end_seconds": 46.52,
      "duration_seconds": 3.39,
      "text": "It's been about a week now."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 47.72,
      "end_seconds": 51.25,
      "duration_seconds": 3.53,
      "text": "Rate it for me, mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 52.83,
      "end_seconds": 54.97,
      "duration_seconds": 2.14,
      "text": "I'd call it severe."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 55.61,
      "end_seconds": 57.65,
      "duration_seconds": 2.04,
      "text": "How frequently does it come?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 61.59,
      "end_seconds": 64.41,
      "duration_seconds": 2.82,
      "text": "It's, It's every other day."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 65.35,
      "end_seconds": 67.95,
      "duration_seconds": 2.6,
      "text": "So, is it accompanied by anything?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 69.18,
      "end_seconds": 85.25,
      "duration_seconds": 16.07,
      "text": "When it starts I tend to get discomfort during sex as well. The discomfort during sex? That's been since last Tuesday. Oh, and soreness. That's been about the same, three days. About soreness, mostly moderate."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 86.79,
      "end_seconds": 93.1,
      "duration_seconds": 6.31,
      "text": "so, have you had an itch down below before, or is this the first time?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 94.91,
      "end_seconds": 102.1,
      "duration_seconds": 7.19,
      "text": "Yes, something like this happened last year, and it went away on its own."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 117.43,
      "end_seconds": 122.3,
      "duration_seconds": 4.87,
      "text": "a few quick ones: being pregnant, bleeding between periods or smell?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 123.8,
      "end_seconds": 128.39,
      "duration_seconds": 4.59,
      "text": "No, no being pregnant, bleeding between periods or smell."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 130.06,
      "end_seconds": 134.28,
      "duration_seconds": 4.22,
      "text": "A few quick ones: pelvic pain or new partner?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 136.27,
      "end_seconds": 139.43,
      "duration_seconds": 3.16,
      "text": "No, none of those at all."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 141.5,
      "end_seconds": 143.55,
      "duration_seconds": 2.05,
      "text": "Is your chest okay generally?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 144.73,
      "end_seconds": 146.86,
      "duration_seconds": 2.13,
      "text": "No problems with breathing."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 147.98,
      "end_seconds": 151.01,
      "duration_seconds": 3.03,
      "text": "Did you ever have any procedures done?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 152.29,
      "end_seconds": 156.4,
      "duration_seconds": 4.11,
      "text": "Ah, just my septum straightened, in my thirties."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 157.35,
      "end_seconds": 160.17,
      "duration_seconds": 2.82,
      "text": "A few questions about your lifestyle now."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 160.81,
      "end_seconds": 172.74,
      "duration_seconds": 11.93,
      "text": "I grab fast food at lunch most days. I walk the dog every morning. I'm a bus driver, so I sit for long hours."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 188.03,
      "end_seconds": 190.81,
      "duration_seconds": 2.78,
      "text": "Alright, any regular medication at all?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 192.58,
      "end_seconds": 196.07,
      "duration_seconds": 3.49,
      "text": "No, I don't take any tablets."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 203.26,
      "end_seconds": 205.89,
      "duration_seconds": 2.63,
      "text": "Before we go further, any allergies?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 207.51,
      "end_seconds": 210.53,
      "duration_seconds": 3.02,
      "text": "No, not that I know of."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 212.08,
      "end_seconds": 215.8,
      "duration_seconds": 3.72,
      "text": "anything in your past medical history I should know?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 217.69,
      "end_seconds": 224.11,
      "duration_seconds": 6.42,
      "text": "I have diabetes, for two years. High cholesterol, for about a year."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 224.63,
      "end_seconds": 225.71,
      "duration_seconds": 1.08,
      "text": "Hm, okay."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 228.47,
      "end_seconds": 231.29,
      "duration_seconds": 2.82,
      "text": "I have depression, for five years."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 232.53,
      "end_seconds": 237.05,
      "duration_seconds": 4.52,
      "text": "Yes, diabetes is known to us, good to have that clear."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 239.56,
      "end_seconds": 242.82,
      "duration_seconds": 3.26,
      "text": "Right, let's have a proper look at you."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 247.32,
      "end_seconds": 248.29,
      "duration_seconds": 0.97,
      "text": "Of course."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 249.39,
      "end_seconds": 251.43,
      "duration_seconds": 2.04,
      "text": "tell me if that's sore"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 262.01,
      "end_seconds": 267.94,
      "duration_seconds": 5.93,
      "text": "There is a thick white discharge with redness of the vulva and no ulcers."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 270.91,
      "end_seconds": 292.06,
      "duration_seconds": 21.15,
      "text": "Okay, that's enough for me. Putting it all together, the most likely explanation is vaginal thrush. Bacterial vaginosis is also on my list. Let me repeat that back to make sure. You've had an itch down below for about a week, severe, and no pelvic pain or bleeding between periods."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 292.84,
      "end_seconds": 295.17,
      "duration_seconds": 2.33,
      "text": "Yes, you've got it."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 295.74,
      "end_seconds": 299.96,
      "duration_seconds": 4.22,
      "text": "I'll request a swab, it'll help with vaginal discharge."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 300.67,
      "end_seconds": 303.74,
      "duration_seconds": 3.07,
      "text": "Where would I go for that?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 304.35,
      "end_seconds": 323.27,
      "duration_seconds": 18.92,
      "text": "I'll request a urine test, it'll help with dysuria. I'll start you on clotrimazole pessary, 500 milligrams, once at night, for one day. That's for thrush. Wear cotton underwear and avoid scented soaps or washes. See me again if it isn't better in a week."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 324.33,
      "end_seconds": 326.3,
      "duration_seconds": 1.97,
      "text": "I can manage that."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 330.73,
      "end_seconds": 333.4,
      "duration_seconds": 2.67,
      "text": "does all of that make sense?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 335.39,
      "end_seconds": 337.54,
      "duration_seconds": 2.15,
      "text": "Alright, thanks, take care."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 338.93,
      "end_seconds": 340.76,
      "duration_seconds": 1.83,
      "text": "Have a good day."
    }
  ]
