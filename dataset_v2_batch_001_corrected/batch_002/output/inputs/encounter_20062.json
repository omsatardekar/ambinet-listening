{
  "schema_version": "1.0",
  "encounter_id": "20062",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.53,
      "end_seconds": 4.03,
      "duration_seconds": 3.5,
      "text": "Morning, doctor. Lovely to meet you."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 4.99,
      "end_seconds": 8.68,
      "duration_seconds": 3.69,
      "text": "Come in. Please sit. How can I help you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 9.28,
      "end_seconds": 13.43,
      "duration_seconds": 4.15,
      "text": "I'm, I'm here because of difficulty combing my hair."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 18.72,
      "end_seconds": 19.99,
      "duration_seconds": 1.27,
      "text": "Since when exactly?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 21.3,
      "end_seconds": 29.33,
      "duration_seconds": 8.03,
      "text": "Oh, it's been about three months now. And pain at night when I lie on it, too."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 30.19,
      "end_seconds": 33.16,
      "duration_seconds": 2.97,
      "text": "How troublesome is it day to day?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 34.27,
      "end_seconds": 49.08,
      "duration_seconds": 14.81,
      "text": "Severe, really. I've also had an ache down the upper arm, for nearly five years. As for ache down the upper arm, I'd say a couple of times a week."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 51.04,
      "end_seconds": 57.85,
      "duration_seconds": 6.81,
      "text": "Have you had difficulty combing your hair before, or is this the first time?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 58.73,
      "end_seconds": 64.67,
      "duration_seconds": 5.94,
      "text": "I had a similar thing about six months ago. It went away."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 78.35,
      "end_seconds": 79.69,
      "duration_seconds": 1.34,
      "text": "Nothing like fever?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 81.37,
      "end_seconds": 83.81,
      "duration_seconds": 2.44,
      "text": "Not at all, no fever."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 84.51,
      "end_seconds": 87.86,
      "duration_seconds": 3.35,
      "text": "Any neck pain, swelling or chest pain?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 89.81,
      "end_seconds": 93.42,
      "duration_seconds": 3.61,
      "text": "No, I haven't had any of them."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 95.2,
      "end_seconds": 97.25,
      "duration_seconds": 2.05,
      "text": "Any trouble with the waterworks?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 97.96,
      "end_seconds": 99.57,
      "duration_seconds": 1.61,
      "text": "No changes there."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 101.64,
      "end_seconds": 102.81,
      "duration_seconds": 1.17,
      "text": "How about smoking?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 103.45,
      "end_seconds": 106.23,
      "duration_seconds": 2.78,
      "text": "I've never touched a cigarette."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 107.05,
      "end_seconds": 109.71,
      "duration_seconds": 2.66,
      "text": "Anything you do to stay fit?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 110.92,
      "end_seconds": 114.42,
      "duration_seconds": 3.5,
      "text": "I do a yoga class on Thursdays."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 115.53,
      "end_seconds": 117.8,
      "duration_seconds": 2.27,
      "text": "Tell me about your eating."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 118.58,
      "end_seconds": 124.55,
      "duration_seconds": 5.97,
      "text": "I drink a lot of tea and snack through the day."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 125.37,
      "end_seconds": 128.42,
      "duration_seconds": 3.05,
      "text": "Are you on your own at home?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 131.45,
      "end_seconds": 134.27,
      "duration_seconds": 2.82,
      "text": "I live with my elderly mother."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 136.03,
      "end_seconds": 139.82,
      "duration_seconds": 3.79,
      "text": "Alright, which medicines do you take at the moment?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 144.02,
      "end_seconds": 153.2,
      "duration_seconds": 9.18,
      "text": "I'm on metoprolol, 50 milligrams, twice a day. Simvastatin. I take it 20 milligrams, at night for my cholesterol."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 153.46,
      "end_seconds": 154.28,
      "duration_seconds": 0.82,
      "text": "I follow."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 155.21,
      "end_seconds": 158.29,
      "duration_seconds": 3.08,
      "text": "Clopidogrel, 75 milligrams, once a day."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 159.44,
      "end_seconds": 162.73,
      "duration_seconds": 3.29,
      "text": "Any health conditions I should have on record?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 167.37,
      "end_seconds": 177.72,
      "duration_seconds": 10.35,
      "text": "Yes, high blood pressure. I've had high cholesterol for two years now. I didn't want to make a fuss, you know."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 182.54,
      "end_seconds": 184.01,
      "duration_seconds": 1.47,
      "text": "And besides that?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 184.92,
      "end_seconds": 188.88,
      "duration_seconds": 3.96,
      "text": "I've got gout. I've had heart disease, yes."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 190.57,
      "end_seconds": 200.55,
      "duration_seconds": 9.98,
      "text": "Yes, high blood pressure and gout are known to us, good to have that clear. Anything surgical in your history?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 204.6,
      "end_seconds": 208.02,
      "duration_seconds": 3.42,
      "text": "Just a triple bypass, eight years ago."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 222.65,
      "end_seconds": 226.83,
      "duration_seconds": 4.18,
      "text": "Let me get the readings out of the way."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 233.13,
      "end_seconds": 235.72,
      "duration_seconds": 2.59,
      "text": "Bear with me while this finishes..."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 251.06,
      "end_seconds": 258.65,
      "duration_seconds": 7.59,
      "text": "Okay: pulse 64, blood pressure 119 over 74, temperature is 36.7 degrees, saturation 97 percent."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 259.81,
      "end_seconds": 263.62,
      "duration_seconds": 3.81,
      "text": "Let me look at the area, I'll be gentle."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 264.62,
      "end_seconds": 265.85,
      "duration_seconds": 1.23,
      "text": "Okay, doctor."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 266.66,
      "end_seconds": 269.59,
      "duration_seconds": 2.93,
      "text": "Right, raise your arm for me."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 277.08,
      "end_seconds": 288.05,
      "duration_seconds": 10.97,
      "text": "There is pain when you lift the arm out to the side between about sixty and one hundred and twenty degrees, and the grip strength is normal."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 289.81,
      "end_seconds": 291.28,
      "duration_seconds": 1.47,
      "text": "Yeah, no problem."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 294.27,
      "end_seconds": 306.01,
      "duration_seconds": 11.74,
      "text": "Alright, good, you can sit up again. Putting it all together, I think we're dealing with a rotator cuff tendon problem at this stage."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 307.86,
      "end_seconds": 313.73,
      "duration_seconds": 5.87,
      "text": "Sorry, what was I saying, what are the odds it's serious?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 315.16,
      "end_seconds": 335.6,
      "duration_seconds": 20.44,
      "text": "I understand the worry. At the moment I'd say it's a rotator cuff tendon problem, and we'll know more once the an ultrasound of the shoulder is back. Stop me if I've got anything wrong. You've had difficulty combing your hair for about three months, and no fever or chest pain."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 336.87,
      "end_seconds": 338.49,
      "duration_seconds": 1.62,
      "text": "That's it, yes."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 352.42,
      "end_seconds": 370.47,
      "duration_seconds": 18.05,
      "text": "I'll request an ultrasound of the shoulder, it'll help with shoulder pain. I'll request a shoulder X-ray, it'll help with shoulder pain. For this, naproxen, 250 milligrams, twice a day with food, for one week. That should help with shoulder pain."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 371.09,
      "end_seconds": 375.16,
      "duration_seconds": 4.07,
      "text": "Should I carry on if I feel better?"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 376.06,
      "end_seconds": 385.48,
      "duration_seconds": 9.42,
      "text": "Keep the shoulder moving gently within comfort and avoid heavy overhead lifting. Please take the tablets with food so they don't upset your stomach."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 385.86,
      "end_seconds": 391.61,
      "duration_seconds": 5.75,
      "text": "Hm, okay. Let's get you seen by physiotherapy, I'll arrange the letter."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 393.67,
      "end_seconds": 396.34,
      "duration_seconds": 2.67,
      "text": "Sure, where do I go?"
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 397.83,
      "end_seconds": 405.84,
      "duration_seconds": 8.01,
      "text": "I'd like to see you again in four weeks. Right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 407.77,
      "end_seconds": 410.01,
      "duration_seconds": 2.24,
      "text": "Alright, thanks, take care."
    }
  ]
}