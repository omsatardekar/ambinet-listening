{
  "schema_version": "1.0",
  "encounter_id": "20274",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.18,
      "end_seconds": 6.42,
      "duration_seconds": 5.24,
      "text": "Hi, doctor, I came as soon as they called me."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.33,
      "end_seconds": 12.38,
      "duration_seconds": 4.05,
      "text": "No problem at all, come in. What's troubling you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 13.29,
      "end_seconds": 34.48,
      "duration_seconds": 21.19,
      "text": "Yeah, you know, it's a high fever with shaking chills. I don't know what's causing it. Work has been very busy so I kept ignoring it. It's a relief to finally sit down and talk about it."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 35.17,
      "end_seconds": 38.98,
      "duration_seconds": 3.81,
      "text": "Can you tell me when it first started?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 40.62,
      "end_seconds": 48.38,
      "duration_seconds": 7.76,
      "text": "It's been two weeks now. I'd rather know what's going on than keep guessing."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 48.94,
      "end_seconds": 51.82,
      "duration_seconds": 2.88,
      "text": "Time for your numbers, if that's okay."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 57.97,
      "end_seconds": 61.04,
      "duration_seconds": 3.07,
      "text": "That's it, just a little longer..."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 72.29,
      "end_seconds": 79.26,
      "duration_seconds": 6.97,
      "text": "Okay: saturation 96 percent, temperature 38.9, blood pressure 111 over 69, pulse 99."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 80.67,
      "end_seconds": 82.13,
      "duration_seconds": 1.46,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 83.88,
      "end_seconds": 87.81,
      "duration_seconds": 3.93,
      "text": "They help me see the whole picture, more shortly."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 90.07,
      "end_seconds": 95.2,
      "duration_seconds": 5.13,
      "text": "Alright, I'll need to examine you for this, it won't take long."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 96.91,
      "end_seconds": 98.33,
      "duration_seconds": 1.42,
      "text": "Does that hurt?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 115.42,
      "end_seconds": 120.01,
      "duration_seconds": 4.59,
      "text": "The spleen tip is just palpable and the chest is clear."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 127.16,
      "end_seconds": 128.11,
      "duration_seconds": 0.95,
      "text": "Of course."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 133.54,
      "end_seconds": 140.0,
      "duration_seconds": 6.46,
      "text": "All finished, thank you. Right, a few quick ones: yellow eyes, rash or neck stiffness?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 141.32,
      "end_seconds": 143.81,
      "duration_seconds": 2.49,
      "text": "No, I'd have said so."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 144.44,
      "end_seconds": 147.22,
      "duration_seconds": 2.78,
      "text": "Has your heart given you any trouble?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 148.64,
      "end_seconds": 150.74,
      "duration_seconds": 2.1,
      "text": "No, that's been fine."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 151.71,
      "end_seconds": 153.92,
      "duration_seconds": 2.21,
      "text": "Is your digestion otherwise okay?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 155.44,
      "end_seconds": 158.18,
      "duration_seconds": 2.74,
      "text": "No, that side's been fine."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 171.75,
      "end_seconds": 175.73,
      "duration_seconds": 3.98,
      "text": "Any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 177.29,
      "end_seconds": 180.61,
      "duration_seconds": 3.32,
      "text": "No, nothing I can think of."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 182.05,
      "end_seconds": 184.55,
      "duration_seconds": 2.5,
      "text": "Before we go further, any allergies?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 186.36,
      "end_seconds": 188.91,
      "duration_seconds": 2.55,
      "text": "Not to my knowledge, no."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 190.66,
      "end_seconds": 193.01,
      "duration_seconds": 2.35,
      "text": "Now some background about your lifestyle."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 194.13,
      "end_seconds": 209.19,
      "duration_seconds": 15.06,
      "text": "I quit smoking around ten years ago. I'll have a glass of wine with dinner. Not much, I mostly stay in these days. My husband and I live above the shop."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 217.84,
      "end_seconds": 219.92,
      "duration_seconds": 2.08,
      "text": "Let's run through your medicines."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 220.75,
      "end_seconds": 226.05,
      "duration_seconds": 5.3,
      "text": "I'm on Dolo, 650 milligrams, when I get the fever."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 227.53,
      "end_seconds": 238.35,
      "duration_seconds": 10.82,
      "text": "Having listened and examined, I can't pin this down yet. We're looking at a fever after travel that must be treated as possible malaria or dengue fever."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 239.21,
      "end_seconds": 241.44,
      "duration_seconds": 2.23,
      "text": "Will it clear up?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 242.54,
      "end_seconds": 264.49,
      "duration_seconds": 21.95,
      "text": "I understand the worry. At the moment I'd say it's a fever after travel that must be treated as possible malaria, and we'll know more once the blood tests is back. Stop me if I've got anything wrong. You've had a high fever with shaking chills for two weeks, and no yellow eyes or rash."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 265.18,
      "end_seconds": 266.98,
      "duration_seconds": 1.8,
      "text": "Yes, that's right."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 274.17,
      "end_seconds": 288.41,
      "duration_seconds": 14.24,
      "text": "Blood tests is what I'd like next, for fever. Avoid anti-inflammatory painkillers and keep drinking. If you become confused or cannot keep fluids down, or you feel really unwell, please come to the emergency department."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 289.99,
      "end_seconds": 291.46,
      "duration_seconds": 1.47,
      "text": "Yes, will do."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 293.06,
      "end_seconds": 295.72,
      "duration_seconds": 2.66,
      "text": "That's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 296.75,
      "end_seconds": 299.63,
      "duration_seconds": 2.88,
      "text": "Great, thank you for your help."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 301.31,
      "end_seconds": 302.77,
      "duration_seconds": 1.46,
      "text": "See you soon."
    }
  ]
}