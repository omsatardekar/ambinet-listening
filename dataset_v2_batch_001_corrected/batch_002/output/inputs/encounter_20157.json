{
  "schema_version": "1.0",
  "encounter_id": "20157",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.52,
      "end_seconds": 3.71,
      "duration_seconds": 3.19,
      "text": "Morning, doctor. Lovely to meet you."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.65,
      "end_seconds": 9.66,
      "duration_seconds": 4.01,
      "text": "No problem at all, come in. What's troubling you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 14.84,
      "end_seconds": 20.18,
      "duration_seconds": 5.34,
      "text": "Good afternoon, doctor. I look after them so I thought I'd come."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 21.5,
      "end_seconds": 25.15,
      "duration_seconds": 3.65,
      "text": "I'm here because of tingling in my feet."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 26.03,
      "end_seconds": 29.71,
      "duration_seconds": 3.68,
      "text": "Can you tell me when it first started?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 31.06,
      "end_seconds": 36.38,
      "duration_seconds": 5.32,
      "text": "I'd say about a week. Actually, no, closer to four weeks."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 36.9,
      "end_seconds": 46.1,
      "duration_seconds": 9.2,
      "text": "Can you describe it a bit more for me? How strong it is, what the pattern is, what helps."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 47.99,
      "end_seconds": 52.94,
      "duration_seconds": 4.95,
      "text": "Honestly, on and off. About a four out of ten."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 53.95,
      "end_seconds": 56.04,
      "duration_seconds": 2.09,
      "text": "Is it accompanied by anything?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 57.93,
      "end_seconds": 73.74,
      "duration_seconds": 15.81,
      "text": "Trouble sleeping goes along with it, most of the time. As for trouble sleeping, I honestly can't say when that began. It might have been last month or the month before."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 75.54,
      "end_seconds": 78.77,
      "duration_seconds": 3.23,
      "text": "How much trouble does it give you?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 80.69,
      "end_seconds": 82.76,
      "duration_seconds": 2.07,
      "text": "I'd call it severe."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 83.8,
      "end_seconds": 87.6,
      "duration_seconds": 3.8,
      "text": "What does a normal day of food look like?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 88.65,
      "end_seconds": 92.58,
      "duration_seconds": 3.93,
      "text": "Lots of rice, lentils and some fruit."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 96.85,
      "end_seconds": 99.69,
      "duration_seconds": 2.84,
      "text": "Are you on your own at home?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 104.19,
      "end_seconds": 107.5,
      "duration_seconds": 3.31,
      "text": "I live with my elderly mother."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 109.17,
      "end_seconds": 110.97,
      "duration_seconds": 1.8,
      "text": "How active are you?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 113.03,
      "end_seconds": 116.6,
      "duration_seconds": 3.57,
      "text": "I hardly move around during the day."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 117.35,
      "end_seconds": 119.91,
      "duration_seconds": 2.56,
      "text": "Do you have any chronic illnesses?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 120.64,
      "end_seconds": 130.15,
      "duration_seconds": 9.51,
      "text": "I have high blood pressure, for two years. Yes, diabetes. I have an underactive thyroid, for nearly five years."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 145.07,
      "end_seconds": 147.91,
      "duration_seconds": 2.84,
      "text": "Have you ever had an operation?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 149.29,
      "end_seconds": 155.92,
      "duration_seconds": 6.63,
      "text": "Yes, I had a wisdom tooth extraction under sedation, five years ago."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 156.93,
      "end_seconds": 159.44,
      "duration_seconds": 2.51,
      "text": "Have you got any known allergies?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 160.48,
      "end_seconds": 164.28,
      "duration_seconds": 3.8,
      "text": "No, nothing as far as I know."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 167.86,
      "end_seconds": 171.71,
      "duration_seconds": 3.85,
      "text": "Do you take any prescribed or over-the-counter medicines?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 173.45,
      "end_seconds": 179.09,
      "duration_seconds": 5.64,
      "text": "He takes thyroxine, 75 micrograms, every morning for my thyroid."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 179.7,
      "end_seconds": 186.49,
      "duration_seconds": 6.79,
      "text": "Have you noticed shortness of breath, swelling of the legs or weakness in the legs?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 188.15,
      "end_seconds": 191.02,
      "duration_seconds": 2.87,
      "text": "No, none of those at all."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 191.3,
      "end_seconds": 194.87,
      "duration_seconds": 3.57,
      "text": "Ah. And what about back pain or chest pain?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 196.8,
      "end_seconds": 200.31,
      "duration_seconds": 3.51,
      "text": "No, none of those at all."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 201.43,
      "end_seconds": 204.01,
      "duration_seconds": 2.58,
      "text": "Any breathing difficulties apart from this?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 205.87,
      "end_seconds": 208.66,
      "duration_seconds": 2.79,
      "text": "No, my breathing's been fine."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 210.71,
      "end_seconds": 213.92,
      "duration_seconds": 3.21,
      "text": "Alright, and your skin, any changes there?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 214.45,
      "end_seconds": 217.99,
      "duration_seconds": 3.54,
      "text": "No, you know, skin's been fine."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 234.88,
      "end_seconds": 238.17,
      "duration_seconds": 3.29,
      "text": "I'll note down your vital signs first."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 245.06,
      "end_seconds": 247.48,
      "duration_seconds": 2.42,
      "text": "Nearly done with the readings..."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 265.86,
      "end_seconds": 274.27,
      "duration_seconds": 8.41,
      "text": "Okay: pulse 85, height 172 centimetres, blood pressure 127 over 81, temperature 36.8, weight 73 kilos."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 276.1,
      "end_seconds": 279.2,
      "duration_seconds": 3.1,
      "text": "Okay, time for me to examine you."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 280.42,
      "end_seconds": 281.88,
      "duration_seconds": 1.46,
      "text": "Yes, that's fine."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 282.96,
      "end_seconds": 285.38,
      "duration_seconds": 2.42,
      "text": "I'm just checking this side."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 301.75,
      "end_seconds": 308.95,
      "duration_seconds": 7.2,
      "text": "Both calves are soft and not tender, and the pulses at your feet are good."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 313.18,
      "end_seconds": 314.98,
      "duration_seconds": 1.8,
      "text": "All finished, thank you."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 330.62,
      "end_seconds": 337.12,
      "duration_seconds": 6.5,
      "text": "Today I'm not changing anything. Right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 338.75,
      "end_seconds": 342.13,
      "duration_seconds": 3.38,
      "text": "No, that's all. Thanks a lot."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 343.5,
      "end_seconds": 344.87,
      "duration_seconds": 1.37,
      "text": "Take care now."
    }
  ]
}