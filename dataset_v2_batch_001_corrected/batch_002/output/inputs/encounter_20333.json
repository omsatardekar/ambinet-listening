  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.82,
      "end_seconds": 2.51,
      "duration_seconds": 1.69,
      "text": "Good afternoon, doctor."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 4.19,
      "end_seconds": 8.38,
      "duration_seconds": 4.19,
      "text": "Come in. Please sit. How can I help you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 9.81,
      "end_seconds": 14.69,
      "duration_seconds": 4.88,
      "text": "So the thing is, I've got a high temperature."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 18.06,
      "end_seconds": 20.19,
      "duration_seconds": 2.13,
      "text": "Did it come on recently?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 22.09,
      "end_seconds": 24.87,
      "duration_seconds": 2.78,
      "text": "Probably about a week. Yeah."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 26.59,
      "end_seconds": 35.04,
      "duration_seconds": 8.45,
      "text": "Can you describe it a bit more for me? How strong it is, what the pattern is, what helps."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 36.29,
      "end_seconds": 50.41,
      "duration_seconds": 14.12,
      "text": "Mostly severe. It happens a few times a day. Only paracetamol, and it's not much. I thought it would sort itself out, but it hasn't."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 52.32,
      "end_seconds": 55.41,
      "duration_seconds": 3.09,
      "text": "Have you been feeling short of breath?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 57.15,
      "end_seconds": 60.53,
      "duration_seconds": 3.38,
      "text": "Yeah, I've had that since this morning."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 62.33,
      "end_seconds": 65.83,
      "duration_seconds": 3.5,
      "text": "Any vomiting, blue lips or leg swelling?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 67.62,
      "end_seconds": 72.47,
      "duration_seconds": 4.85,
      "text": "I mean, no, I haven't had any of them."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 73.21,
      "end_seconds": 76.12,
      "duration_seconds": 2.91,
      "text": "Okay, has there been any confusion?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 78.07,
      "end_seconds": 80.91,
      "duration_seconds": 2.84,
      "text": "Not at all, no confusion."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 81.68,
      "end_seconds": 85.14,
      "duration_seconds": 3.46,
      "text": "So, any problems with your joints or muscles?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 86.52,
      "end_seconds": 87.95,
      "duration_seconds": 1.43,
      "text": "Nothing else aches."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 89.74,
      "end_seconds": 93.45,
      "duration_seconds": 3.71,
      "text": "Any health conditions I should have on record?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 99.58,
      "end_seconds": 101.83,
      "duration_seconds": 2.25,
      "text": "I've got high blood pressure."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 102.75,
      "end_seconds": 108.75,
      "duration_seconds": 6.0,
      "text": "Mm-hmm. Can you list what you take, tablets, creams or inhalers?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 109.74,
      "end_seconds": 117.45,
      "duration_seconds": 7.71,
      "text": "Ramipril, 5 milligrams, every morning. I take Dolo, 650 milligrams, when I get the fever."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 117.66,
      "end_seconds": 122.67,
      "duration_seconds": 5.01,
      "text": "Mm, okay. Do you react to any medicines or foods? Any allergies?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 124.29,
      "end_seconds": 130.0,
      "duration_seconds": 5.71,
      "text": "I'm allergic to diclofenac, I get swelling of my lips."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 130.54,
      "end_seconds": 133.7,
      "duration_seconds": 3.16,
      "text": "What operations have you had, if any?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 135.55,
      "end_seconds": 142.46,
      "duration_seconds": 6.91,
      "text": "I had a cataract operation in my left eye about a year ago."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 154.62,
      "end_seconds": 157.51,
      "duration_seconds": 2.89,
      "text": "Do you follow any particular diet?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 158.05,
      "end_seconds": 161.24,
      "duration_seconds": 3.19,
      "text": "I'm vegetarian and have been for years."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 163.26,
      "end_seconds": 165.71,
      "duration_seconds": 2.45,
      "text": "Anything you do to stay fit?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 167.26,
      "end_seconds": 170.45,
      "duration_seconds": 3.19,
      "text": "I do a yoga class on Thursdays."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 171.94,
      "end_seconds": 175.43,
      "duration_seconds": 3.49,
      "text": "Shall I check your blood pressure and pulse?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 186.55,
      "end_seconds": 189.29,
      "duration_seconds": 2.74,
      "text": "Keep your arm relaxed for me..."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 209.08,
      "end_seconds": 217.29,
      "duration_seconds": 8.21,
      "text": "Okay: BP is 128 over 85, oxygen saturation is 91 percent, pulse is 102 beats a minute."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 220.21,
      "end_seconds": 224.01,
      "duration_seconds": 3.8,
      "text": "Right, let's have a proper look at you."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 224.98,
      "end_seconds": 226.29,
      "duration_seconds": 1.31,
      "text": "Breathe out slowly."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 236.37,
      "end_seconds": 245.74,
      "duration_seconds": 9.37,
      "text": "Your chest is clear apart from a few crackles at the right base and your oxygen level is a bit low."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 249.32,
      "end_seconds": 251.44,
      "duration_seconds": 2.12,
      "text": "Okay, that's enough for me."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 268.63,
      "end_seconds": 275.4,
      "duration_seconds": 6.77,
      "text": "Okay, so my impression is this: This is probably a viral chest infection with mildly low oxygen."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 287.59,
      "end_seconds": 318.47,
      "duration_seconds": 30.88,
      "text": "I want a chest X-ray done, that's for low oxygen and crackles. Rest, keep your fluids up and lie on your tummy or side to help your breathing. Let's hold off on a viral swab for now, and if there's no change in two weeks we can revisit it. Let's review you in two days. What are the next steps as you understand them?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 319.46,
      "end_seconds": 324.98,
      "duration_seconds": 5.52,
      "text": "So, I come back in two days. Is that right?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 327.03,
      "end_seconds": 332.59,
      "duration_seconds": 5.56,
      "text": "Yes, exactly right. Is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 334.42,
      "end_seconds": 338.14,
      "duration_seconds": 3.72,
      "text": "Okay, that makes sense. Thanks for explaining."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 342.71,
      "end_seconds": 344.31,
      "duration_seconds": 1.6,
      "text": "Have a good day."
    }
  ]
}