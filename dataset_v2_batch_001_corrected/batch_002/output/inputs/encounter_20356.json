{
  "schema_version": "1.0",
  "encounter_id": "20356",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.9,
      "end_seconds": 3.19,
      "duration_seconds": 2.29,
      "text": "Alright, welcome. Make yourself comfortable."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 4.54,
      "end_seconds": 6.79,
      "duration_seconds": 2.25,
      "text": "Hi, um, thanks."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 8.46,
      "end_seconds": 11.19,
      "duration_seconds": 2.73,
      "text": "What do you need help with?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 12.75,
      "end_seconds": 23.01,
      "duration_seconds": 10.26,
      "text": "Oh, you know, mainly pain in my lower back. There's a couple of other things, but that's the main one."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 24.47,
      "end_seconds": 28.38,
      "duration_seconds": 3.91,
      "text": "Are you taking anything regularly, including from the pharmacy?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 30.44,
      "end_seconds": 40.09,
      "duration_seconds": 9.65,
      "text": "Yeah, I'm on thyroxine, 75 micrograms, every morning. It's, It's calcium tablets, 500 milligrams, twice a day."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 41.05,
      "end_seconds": 42.84,
      "duration_seconds": 1.79,
      "text": "When did this begin?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 47.48,
      "end_seconds": 63.5,
      "duration_seconds": 16.02,
      "text": "Probably four weeks. Yeah. I wasn't sure whether to come in at all, um, to be honest. I thought it would sort itself out, but it hasn't."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 64.4,
      "end_seconds": 68.24,
      "duration_seconds": 3.84,
      "text": "Right, is it bearing on you a lot?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 68.81,
      "end_seconds": 70.35,
      "duration_seconds": 1.54,
      "text": "I'd say mild."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 72.03,
      "end_seconds": 74.49,
      "duration_seconds": 2.46,
      "text": "Is it worse at certain times?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 78.07,
      "end_seconds": 82.64,
      "duration_seconds": 4.57,
      "text": "Yes, bending and lifting. That makes it worse."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 83.66,
      "end_seconds": 86.7,
      "duration_seconds": 3.04,
      "text": "Right, is there something that settles it?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 87.55,
      "end_seconds": 93.72,
      "duration_seconds": 6.17,
      "text": "Lying flat helps a bit. I've, I've been losing height too."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 94.34,
      "end_seconds": 99.08,
      "duration_seconds": 4.74,
      "text": "Any fever, night pain, bladder problems or numbness in the legs?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 100.58,
      "end_seconds": 104.15,
      "duration_seconds": 3.57,
      "text": "Yeah, no, none that I've noticed."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 105.91,
      "end_seconds": 107.95,
      "duration_seconds": 2.04,
      "text": "Is your chest okay generally?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 108.96,
      "end_seconds": 111.29,
      "duration_seconds": 2.33,
      "text": "No problems with breathing."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 123.29,
      "end_seconds": 126.74,
      "duration_seconds": 3.45,
      "text": "Is there anything relevant on the family side?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 128.04,
      "end_seconds": 131.17,
      "duration_seconds": 3.13,
      "text": "My mother has an underactive thyroid."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 133.07,
      "end_seconds": 135.82,
      "duration_seconds": 2.75,
      "text": "Have you got any known allergies?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 137.5,
      "end_seconds": 140.19,
      "duration_seconds": 2.69,
      "text": "Not to my knowledge, no."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 152.76,
      "end_seconds": 155.14,
      "duration_seconds": 2.38,
      "text": "Do you have any chronic illnesses?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 156.92,
      "end_seconds": 164.35,
      "duration_seconds": 7.43,
      "text": "I've had thin bones for about a year now. I have an underactive thyroid."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 165.22,
      "end_seconds": 167.42,
      "duration_seconds": 2.2,
      "text": "Sure. Do you drink alcohol?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 169.2,
      "end_seconds": 172.26,
      "duration_seconds": 3.06,
      "text": "I only drink at family occasions."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 172.88,
      "end_seconds": 173.75,
      "duration_seconds": 0.87,
      "text": "Any smoking?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 174.76,
      "end_seconds": 178.83,
      "duration_seconds": 4.07,
      "text": "I have about eight cigarettes in a day."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 180.22,
      "end_seconds": 183.07,
      "duration_seconds": 2.85,
      "text": "Are you in work at the moment?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 183.75,
      "end_seconds": 188.88,
      "duration_seconds": 5.13,
      "text": "Yes, I work in a bakery, early starts."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 192.7,
      "end_seconds": 195.45,
      "duration_seconds": 2.75,
      "text": "Anything you do to stay fit?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 196.25,
      "end_seconds": 200.09,
      "duration_seconds": 3.84,
      "text": "I do a yoga class on Thursdays."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 203.31,
      "end_seconds": 205.51,
      "duration_seconds": 2.2,
      "text": "Do you live by yourself?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 207.31,
      "end_seconds": 212.16,
      "duration_seconds": 4.85,
      "text": "No, I share a house with my brother."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 222.26,
      "end_seconds": 225.43,
      "duration_seconds": 3.17,
      "text": "Any past operations I should know about?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 229.1,
      "end_seconds": 235.19,
      "duration_seconds": 6.09,
      "text": "Ah, yes, I had my womb taken out, fifteen years ago."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 236.02,
      "end_seconds": 238.87,
      "duration_seconds": 2.85,
      "text": "Let me take your readings now."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 247.99,
      "end_seconds": 250.5,
      "duration_seconds": 2.51,
      "text": "Keep your arm relaxed for me..."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 259.52,
      "end_seconds": 270.19,
      "duration_seconds": 10.67,
      "text": "Okay: saturation 98 percent, blood pressure 128 over 76, respiratory rate 18. And temperature 36.6, pulse is 70 beats a minute."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 272.01,
      "end_seconds": 274.21,
      "duration_seconds": 2.2,
      "text": "Is that alright, doctor?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 275.8,
      "end_seconds": 278.47,
      "duration_seconds": 2.67,
      "text": "We'll look at it together shortly."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 280.03,
      "end_seconds": 282.13,
      "duration_seconds": 2.1,
      "text": "Shall I start the examination?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 284.14,
      "end_seconds": 285.22,
      "duration_seconds": 1.08,
      "text": "That's alright."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 286.89,
      "end_seconds": 289.13,
      "duration_seconds": 2.24,
      "text": "Hold that for a second."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 303.24,
      "end_seconds": 309.78,
      "duration_seconds": 6.54,
      "text": "There is tenderness over the mid lower spine and no weakness in the legs."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 314.35,
      "end_seconds": 331.71,
      "duration_seconds": 17.36,
      "text": "You can relax now. Right, here's what I'm thinking. This looks most like thin bones with a fragility fracture and back pain. I want blood tests done, that's for bone health. I'm going to order a spine X-ray, for back pain."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 333.13,
      "end_seconds": 336.64,
      "duration_seconds": 3.51,
      "text": "Where would I go for that?"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 337.6,
      "end_seconds": 375.43,
      "duration_seconds": 37.83,
      "text": "We'll begin with alendronate, 70 milligrams, once a week, long term. You take it by mouth. It's for bone strengthening. Take the weekly tablet first thing with a full glass of water and stay upright for half an hour. We'll refer you to the falls clinic. I'm not ordering a bone density scan today. If things carry on in two weeks, we'll consider it. Book a review after the scan. Anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 377.17,
      "end_seconds": 381.97,
      "duration_seconds": 4.8,
      "text": "I mean, I think I understand everything. Thanks."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 383.39,
      "end_seconds": 384.58,
      "duration_seconds": 1.19,
      "text": "Look after yourself."
    }
  ]
}