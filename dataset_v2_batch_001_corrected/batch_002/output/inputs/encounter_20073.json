{
  "schema_version": "1.0",
  "encounter_id": "20073",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 0.61,
      "end_seconds": 7.27,
      "duration_seconds": 6.66,
      "text": "Doctor, this one's ready for you. Everything's on the chart, but I'll go through it."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.08,
      "end_seconds": 12.2,
      "duration_seconds": 4.12,
      "text": "Thank you. Good morning, tell me what's been going on."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 13.18,
      "end_seconds": 20.24,
      "duration_seconds": 7.06,
      "text": "Mainly chest tightness. There's a couple of other things, but that's the main one."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 22.1,
      "end_seconds": 24.98,
      "duration_seconds": 2.88,
      "text": "How long has this been bothering you?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 26.46,
      "end_seconds": 28.97,
      "duration_seconds": 2.51,
      "text": "For one week, I'd say."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 29.5,
      "end_seconds": 34.8,
      "duration_seconds": 5.3,
      "text": "Okay, give me more detail on it, whatever comes to mind."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 36.49,
      "end_seconds": 44.04,
      "duration_seconds": 7.55,
      "text": "I, I notice it more with pollen season. It's once or twice a day."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 44.57,
      "end_seconds": 48.87,
      "duration_seconds": 4.3,
      "text": "What about a cough at night, have you noticed that?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 53.34,
      "end_seconds": 56.28,
      "duration_seconds": 2.94,
      "text": "Yeah. Five days, I'd say."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 57.68,
      "end_seconds": 60.22,
      "duration_seconds": 2.54,
      "text": "How much does it limit you?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 61.71,
      "end_seconds": 62.96,
      "duration_seconds": 1.25,
      "text": "Severe, really."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 63.72,
      "end_seconds": 69.41,
      "duration_seconds": 5.69,
      "text": "So, have you had chest tightness before, or is this the first time?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 74.94,
      "end_seconds": 80.99,
      "duration_seconds": 6.05,
      "text": "A bit, about six months ago. It settled by itself back then."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 99.84,
      "end_seconds": 111.46,
      "duration_seconds": 11.62,
      "text": "Doctor, I've got the readings for you. Heart rate 64, pressure 127 over 82, oxygen saturation is 99 percent. Temperature is 36.7 degrees, respiratory rate 14."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 113.02,
      "end_seconds": 114.62,
      "duration_seconds": 1.6,
      "text": "Good, thank you."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 116.35,
      "end_seconds": 119.31,
      "duration_seconds": 2.96,
      "text": "Okay, time for me to examine you."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 129.19,
      "end_seconds": 130.79,
      "duration_seconds": 1.6,
      "text": "Yeah, no problem."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 132.23,
      "end_seconds": 134.43,
      "duration_seconds": 2.2,
      "text": "Hold that for a second."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 143.17,
      "end_seconds": 151.03,
      "duration_seconds": 7.86,
      "text": "I can hear a faint wheeze at the end of breathing out, otherwise the chest is clear."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 153.82,
      "end_seconds": 159.66,
      "duration_seconds": 5.84,
      "text": "All finished, thank you. So, any chest pain, fever or weight loss?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 161.19,
      "end_seconds": 163.94,
      "duration_seconds": 2.75,
      "text": "No, not a single one."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 165.49,
      "end_seconds": 167.73,
      "duration_seconds": 2.24,
      "text": "Any trouble with the waterworks?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 169.24,
      "end_seconds": 170.67,
      "duration_seconds": 1.43,
      "text": "No changes there."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 176.14,
      "end_seconds": 180.4,
      "duration_seconds": 4.26,
      "text": "Okay, what about your tummy and bowels, anything unusual there?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 181.84,
      "end_seconds": 184.91,
      "duration_seconds": 3.07,
      "text": "So, no, all normal there."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 186.32,
      "end_seconds": 189.72,
      "duration_seconds": 3.4,
      "text": "Which medicines do you take at the moment?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 191.31,
      "end_seconds": 198.18,
      "duration_seconds": 6.87,
      "text": "I take Asthalin inhaler, when needed. I take hydrocortisone cream, when needed."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 199.63,
      "end_seconds": 202.44,
      "duration_seconds": 2.81,
      "text": "Has anyone ever diagnosed you with something?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 203.2,
      "end_seconds": 207.07,
      "duration_seconds": 3.87,
      "text": "Asthma, for two years. I, I have eczema."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 208.76,
      "end_seconds": 217.85,
      "duration_seconds": 9.09,
      "text": "Mm, okay. So, yes, eczema is known to us, good to have that clear. A few questions about your lifestyle now."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 219.23,
      "end_seconds": 236.35,
      "duration_seconds": 17.12,
      "text": "I gave up cigarettes last spring. Nothing, I'm teetotal. My husband and I live above the shop. I'm a plumber, lots of bending and kneeling. I grab fast food at lunch most days."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 238.01,
      "end_seconds": 239.99,
      "duration_seconds": 1.98,
      "text": "Any surgery in the past?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 241.54,
      "end_seconds": 245.45,
      "duration_seconds": 3.91,
      "text": "Just a bunion operation, six years ago."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 245.99,
      "end_seconds": 250.36,
      "duration_seconds": 4.37,
      "text": "Are there any allergies I should be aware of?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 251.22,
      "end_seconds": 255.06,
      "duration_seconds": 3.84,
      "text": "Right, no, I've never reacted to anything."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 270.09,
      "end_seconds": 290.47,
      "duration_seconds": 20.38,
      "text": "So, based on the history and the examination, I don't have a clear answer today: exercise-triggered asthma with seasonal allergy is possible, and so is reflux. Let's use budesonide-formoterol inhaler, 200 micrograms, one puff twice a day, long term. That's for asthma control. Let's plan a check in six weeks."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 292.24,
      "end_seconds": 294.0,
      "duration_seconds": 1.76,
      "text": "Yes, that's manageable."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 294.89,
      "end_seconds": 298.45,
      "duration_seconds": 3.56,
      "text": "Anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 299.12,
      "end_seconds": 302.72,
      "duration_seconds": 3.6,
      "text": "Good, thanks, I'll see you then."
    }
  ]
}