{
  "schema_version": "1.0",
  "encounter_id": "20376",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 1.09,
      "end_seconds": 5.3,
      "duration_seconds": 4.21,
      "text": "Ready for you, doctor. I'll stay in case you need anything."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.42,
      "end_seconds": 10.57,
      "duration_seconds": 4.15,
      "text": "Thanks, that's helpful. Hello, please sit. What's been happening?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 12.02,
      "end_seconds": 15.42,
      "duration_seconds": 3.4,
      "text": "I've been dealing with a chesty cough."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 16.07,
      "end_seconds": 18.27,
      "duration_seconds": 2.2,
      "text": "Did it come on recently?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 19.45,
      "end_seconds": 23.17,
      "duration_seconds": 3.72,
      "text": "Erm, it's been like this since Monday."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 24.95,
      "end_seconds": 28.3,
      "duration_seconds": 3.35,
      "text": "So, is it bearing on you a lot?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 29.47,
      "end_seconds": 30.48,
      "duration_seconds": 1.01,
      "text": "Mostly mild."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 31.05,
      "end_seconds": 33.09,
      "duration_seconds": 2.04,
      "text": "Have you noticed any triggers?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 33.95,
      "end_seconds": 41.14,
      "duration_seconds": 7.19,
      "text": "Yes, mornings. That makes it worse. I've had wheezing too, for about four days."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 42.22,
      "end_seconds": 45.48,
      "duration_seconds": 3.26,
      "text": "Is it bearing on you a lot?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 46.62,
      "end_seconds": 50.04,
      "duration_seconds": 3.42,
      "text": "Pretty mild, if I'm being honest."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 53.11,
      "end_seconds": 57.0,
      "duration_seconds": 3.89,
      "text": "Let me ask about allergies, anything at all?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 57.86,
      "end_seconds": 61.97,
      "duration_seconds": 4.11,
      "text": "Naproxen. I come out in... well, stomach pain."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 80.11,
      "end_seconds": 85.13,
      "duration_seconds": 5.02,
      "text": "Tell me about your routine, work, habits, that sort of thing."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 86.23,
      "end_seconds": 100.5,
      "duration_seconds": 14.27,
      "text": "I quit smoking around ten years ago. I'm vegetarian and have been for years. No, I share a house with my brother. Yes, I work in a bakery, early starts."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 101.64,
      "end_seconds": 104.42,
      "duration_seconds": 2.78,
      "text": "Has anyone ever diagnosed you with something?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 107.79,
      "end_seconds": 108.82,
      "duration_seconds": 1.03,
      "text": "Yes, COPD."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 110.4,
      "end_seconds": 116.46,
      "duration_seconds": 6.06,
      "text": "Right, so COPD is already on your record. We'll keep that in mind today."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 133.24,
      "end_seconds": 135.76,
      "duration_seconds": 2.52,
      "text": "Tell me your medicines, please."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 137.04,
      "end_seconds": 139.87,
      "duration_seconds": 2.83,
      "text": "Tiotropium inhaler, once a day."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 142.76,
      "end_seconds": 148.34,
      "duration_seconds": 5.58,
      "text": "Okay, have you had any sharp chest pain, night sweats or ankle swelling?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 150.24,
      "end_seconds": 156.23,
      "duration_seconds": 5.99,
      "text": "I haven't had sharp chest pain, night sweats or ankle swelling, no."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 159.97,
      "end_seconds": 162.0,
      "duration_seconds": 2.03,
      "text": "Is your mobility otherwise okay?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 162.93,
      "end_seconds": 164.34,
      "duration_seconds": 1.41,
      "text": "Nothing else aches."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 173.06,
      "end_seconds": 183.02,
      "duration_seconds": 9.96,
      "text": "Okay, so the vitals from earlier. Respiratory rate 22, pressure 120 over 90, SpO2 89 percent on room air, pulse is 92 beats a minute."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 188.36,
      "end_seconds": 189.06,
      "duration_seconds": 0.7,
      "text": "Thanks."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 191.38,
      "end_seconds": 195.15,
      "duration_seconds": 3.77,
      "text": "I'll examine you in a second, make yourself comfortable."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 197.18,
      "end_seconds": 198.23,
      "duration_seconds": 1.05,
      "text": "Okay, doctor."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 199.37,
      "end_seconds": 201.35,
      "duration_seconds": 1.98,
      "text": "I'm just checking this side."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 210.22,
      "end_seconds": 214.12,
      "duration_seconds": 3.9,
      "text": "There are scattered wheezes on both sides and no crackles."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 217.03,
      "end_seconds": 226.86,
      "duration_seconds": 9.83,
      "text": "You can sit up now. Okay, so my impression is this: It points towards an infective exacerbation of chronic lung disease."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 231.82,
      "end_seconds": 233.49,
      "duration_seconds": 1.67,
      "text": "Is this permanent?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 238.97,
      "end_seconds": 250.21,
      "duration_seconds": 11.24,
      "text": "I understand the worry. At the moment I'd say it's an infective exacerbation of chronic lung disease, and we'll know more once the a sputum sample is back."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 268.78,
      "end_seconds": 273.72,
      "duration_seconds": 4.94,
      "text": "I think a sputum sample makes sense here, for purulent sputum."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 275.68,
      "end_seconds": 278.18,
      "duration_seconds": 2.5,
      "text": "How long will it take?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 280.16,
      "end_seconds": 287.54,
      "duration_seconds": 7.38,
      "text": "You'll be taking prednisolone, 30 milligrams, once a day, for five days. That's for flare of lung disease."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 288.82,
      "end_seconds": 292.22,
      "duration_seconds": 3.4,
      "text": "Alright, I'll pick it up today."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 293.07,
      "end_seconds": 309.89,
      "duration_seconds": 16.82,
      "text": "Keep using your inhaler as before and drink plenty of fluids. Cut down on salt and fried food for now, it really does make a difference. Come back if it hasn't settled in a week. Anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 311.19,
      "end_seconds": 314.43,
      "duration_seconds": 3.24,
      "text": "No, that's all. Thanks a lot."
    }
  ]
}