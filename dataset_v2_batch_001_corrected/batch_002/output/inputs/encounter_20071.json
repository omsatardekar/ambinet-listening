{
  "schema_version": "1.0",
  "encounter_id": "20071",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.98,
      "end_seconds": 6.76,
      "duration_seconds": 5.78,
      "text": "hello doctor, sorry, I took a wrong turn on the way here"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.62,
      "end_seconds": 13.91,
      "duration_seconds": 5.29,
      "text": "okay, you're alright, take a seat. What can I do for you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 15.9,
      "end_seconds": 20.05,
      "duration_seconds": 4.15,
      "text": "Okay, so I've been dealing with my heart racing."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 21.3,
      "end_seconds": 23.02,
      "duration_seconds": 1.72,
      "text": "right, since when exactly?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 23.94,
      "end_seconds": 28.83,
      "duration_seconds": 4.89,
      "text": "Uh, it's been going on for two years."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 29.23,
      "end_seconds": 32.94,
      "duration_seconds": 3.71,
      "text": "yes. How much trouble does it give you?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 34.8,
      "end_seconds": 35.88,
      "duration_seconds": 1.08,
      "text": "mostly mild"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 37.8,
      "end_seconds": 42.25,
      "duration_seconds": 4.45,
      "text": "Have you had any fainting, double vision or fever?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 44.23,
      "end_seconds": 48.79,
      "duration_seconds": 4.56,
      "text": "actually, no, no fainting, double vision or fever"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 50.49,
      "end_seconds": 52.59,
      "duration_seconds": 2.1,
      "text": "Anything unusual with passing urine?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 53.97,
      "end_seconds": 55.34,
      "duration_seconds": 1.37,
      "text": "Nothing there no."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 66.69,
      "end_seconds": 71.92,
      "duration_seconds": 5.23,
      "text": "do you react to to any medicines or foods? Any allergies?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 73.82,
      "end_seconds": 76.41,
      "duration_seconds": 2.59,
      "text": "I've never had an allergy"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 94.73,
      "end_seconds": 98.25,
      "duration_seconds": 3.52,
      "text": "alright, do you take any regular medication?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 99.52,
      "end_seconds": 100.71,
      "duration_seconds": 1.19,
      "text": "no, none"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 114.8,
      "end_seconds": 117.93,
      "duration_seconds": 3.13,
      "text": "What line of work are you in?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 118.63,
      "end_seconds": 124.09,
      "duration_seconds": 5.46,
      "text": "I'm a bus driver, so I sit for long hours"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 125.0,
      "end_seconds": 126.6,
      "duration_seconds": 1.6,
      "text": "Who lives with you?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 128.26,
      "end_seconds": 130.69,
      "duration_seconds": 2.43,
      "text": "My partner and our baby."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 131.51,
      "end_seconds": 133.54,
      "duration_seconds": 2.03,
      "text": "do you do any exercise?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 134.79,
      "end_seconds": 137.11,
      "duration_seconds": 2.32,
      "text": "I swim twice a week"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 137.86,
      "end_seconds": 140.6,
      "duration_seconds": 2.74,
      "text": "are there any illnesses in your family?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 141.83,
      "end_seconds": 144.29,
      "duration_seconds": 2.46,
      "text": "my uncle has high cholesterol"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 145.1,
      "end_seconds": 149.37,
      "duration_seconds": 4.27,
      "text": "Okay, any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 151.39,
      "end_seconds": 155.78,
      "duration_seconds": 4.39,
      "text": "okay, um, so no, nothing at all"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 168.47,
      "end_seconds": 172.7,
      "duration_seconds": 4.23,
      "text": "can I check a few measurements before we carry on?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 179.77,
      "end_seconds": 182.26,
      "duration_seconds": 2.49,
      "text": "That's it, just a little longer..."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 194.16,
      "end_seconds": 201.11,
      "duration_seconds": 6.95,
      "text": "okay: temp 36.9 degrees pulse is 124 beats a minute blood pressure 115 over 71."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 203.02,
      "end_seconds": 206.13,
      "duration_seconds": 3.11,
      "text": "Is that alright, uh, doctor?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 206.88,
      "end_seconds": 209.49,
      "duration_seconds": 2.61,
      "text": "I'll come back to the numbers."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 211.79,
      "end_seconds": 215.28,
      "duration_seconds": 3.49,
      "text": "Alright over here please and I'll take a look."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 216.56,
      "end_seconds": 218.39,
      "duration_seconds": 1.83,
      "text": "let me feel here"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 228.09,
      "end_seconds": 234.0,
      "duration_seconds": 5.91,
      "text": "there is a smooth, small swelling at the front of the neck"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 235.99,
      "end_seconds": 237.19,
      "duration_seconds": 1.2,
      "text": "does that hurt?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 245.31,
      "end_seconds": 252.68,
      "duration_seconds": 7.37,
      "text": "There is a fine tremor of the outstretched hands and the pulse is fast and regular."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 254.93,
      "end_seconds": 263.8,
      "duration_seconds": 8.87,
      "text": "That's all I needed to check. So where does that leave us? It points towards an overactive thyroid."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 265.73,
      "end_seconds": 268.74,
      "duration_seconds": 3.01,
      "text": "What are the odds it's serious?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 270.7,
      "end_seconds": 288.79,
      "duration_seconds": 18.09,
      "text": "I can't promise yet but most people with an overactive thyroid do well once it's treated properly. A thyroid scan is what I'd like next for neck swelling. That will help us see what's going on underneath and decide the the next step"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 290.42,
      "end_seconds": 291.83,
      "duration_seconds": 1.41,
      "text": "That makes sense."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 292.69,
      "end_seconds": 318.15,
      "duration_seconds": 25.46,
      "text": "The treatment will be propranolol, 20 milligrams, twice a day, until review. That's for racing heart and tremor. Try to avoid caffeine while we sort this out. Try to keep a simple diary of when it happens and what you were doing, and bring it to the next visit. I'd like to see you again after the thyroid results."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 319.03,
      "end_seconds": 322.94,
      "duration_seconds": 3.91,
      "text": "I I'll note it in my calendar."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 326.67,
      "end_seconds": 332.04,
      "duration_seconds": 5.37,
      "text": "right that's the plan do you wanna to ask me anything?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 337.87,
      "end_seconds": 341.15,
      "duration_seconds": 3.28,
      "text": "Uh, thank you, doctor, goodbye."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 342.44,
      "end_seconds": 343.75,
      "duration_seconds": 1.31,
      "text": "Take care now."
    }
  ]
}