{
  "schema_version": "1.0",
  "encounter_id": "20371",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.21,
      "end_seconds": 7.97,
      "duration_seconds": 6.76,
      "text": "hello doctor, sorry, I took a wrong turn on the way here"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 9.14,
      "end_seconds": 13.53,
      "duration_seconds": 4.39,
      "text": "come in. Please sit. How can I help you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 15.62,
      "end_seconds": 23.6,
      "duration_seconds": 7.98,
      "text": "Okay so so doctor I'll sit in if that's okay I know what's been happening."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 25.5,
      "end_seconds": 43.25,
      "duration_seconds": 17.75,
      "text": "I wanted to get burning when I pass urine looked at a neighbour of mine said I should see someone about it i took the morning off to come in today"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 44.8,
      "end_seconds": 47.14,
      "duration_seconds": 2.34,
      "text": "Let me take your readings now."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 56.43,
      "end_seconds": 59.2,
      "duration_seconds": 2.77,
      "text": "Bear with me while this finishes..."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 75.04,
      "end_seconds": 84.59,
      "duration_seconds": 9.55,
      "text": "okay: blood pressure 123 over 69, temperature is 37.0 degrees, SpO2 97 percent on room air, pulse 81."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 85.86,
      "end_seconds": 87.65,
      "duration_seconds": 1.79,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 89.08,
      "end_seconds": 94.58,
      "duration_seconds": 5.5,
      "text": "That's fine, I'll explain it soon. Did it come on recently?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 96.05,
      "end_seconds": 98.73,
      "duration_seconds": 2.68,
      "text": "For two days, I'd say."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 100.64,
      "end_seconds": 102.95,
      "duration_seconds": 2.31,
      "text": "okay does anything help it?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 104.28,
      "end_seconds": 115.38,
      "duration_seconds": 11.1,
      "text": "Let me think, only drinking water, and it's not much. I've also been needing to go all the time, since Monday."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 115.91,
      "end_seconds": 120.29,
      "duration_seconds": 4.38,
      "text": "have you had a sudden urgent need to go?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 121.76,
      "end_seconds": 122.88,
      "duration_seconds": 1.12,
      "text": "Yes, actually."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 131.88,
      "end_seconds": 133.54,
      "duration_seconds": 1.66,
      "text": "How about new partner?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 135.0,
      "end_seconds": 137.58,
      "duration_seconds": 2.58,
      "text": "Nope, no new partner."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 139.28,
      "end_seconds": 145.96,
      "duration_seconds": 6.68,
      "text": "a few quick ones: vaginal discharge, fever, blood in the urine or loin pain?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 147.06,
      "end_seconds": 152.94,
      "duration_seconds": 5.88,
      "text": "No no vaginal discharge fever blood in the urine or loin pain."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 153.98,
      "end_seconds": 157.4,
      "duration_seconds": 3.42,
      "text": "anything on the skin I should know about?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 158.97,
      "end_seconds": 160.13,
      "duration_seconds": 1.16,
      "text": "Skin's normal."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 160.81,
      "end_seconds": 165.25,
      "duration_seconds": 4.44,
      "text": "what about your tummy and bowels, anything unusual there?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 167.17,
      "end_seconds": 170.05,
      "duration_seconds": 2.88,
      "text": "No, that side's been fine."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 186.48,
      "end_seconds": 189.62,
      "duration_seconds": 3.14,
      "text": "which medicines do you take at the moment?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 191.21,
      "end_seconds": 195.22,
      "duration_seconds": 4.01,
      "text": "It's, It's cranberry juice, every day, doctor."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 201.17,
      "end_seconds": 205.18,
      "duration_seconds": 4.01,
      "text": "Do you have any medical conditions I should know about?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 205.86,
      "end_seconds": 207.59,
      "duration_seconds": 1.73,
      "text": "not really no"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 208.75,
      "end_seconds": 211.65,
      "duration_seconds": 2.9,
      "text": "right before we go further any allergies?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 212.62,
      "end_seconds": 220.92,
      "duration_seconds": 8.3,
      "text": "I had a reaction to erythromycin when I was younger a rash and I've avoided it since"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 222.91,
      "end_seconds": 224.72,
      "duration_seconds": 1.81,
      "text": "Who lives with you?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 226.05,
      "end_seconds": 228.98,
      "duration_seconds": 2.93,
      "text": "My partner and our baby"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 229.81,
      "end_seconds": 231.95,
      "duration_seconds": 2.14,
      "text": "do you get out much?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 233.3,
      "end_seconds": 237.55,
      "duration_seconds": 4.25,
      "text": "Not much, I mostly stay in these days"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 238.21,
      "end_seconds": 241.15,
      "duration_seconds": 2.94,
      "text": "do you work outside the home?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 241.97,
      "end_seconds": 246.31,
      "duration_seconds": 4.34,
      "text": "I'm a hairdresser, on my feet all day."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 261.27,
      "end_seconds": 263.25,
      "duration_seconds": 1.98,
      "text": "anything surgical in your history?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 264.89,
      "end_seconds": 268.44,
      "duration_seconds": 3.55,
      "text": "just a bunion operation, six years ago"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 270.45,
      "end_seconds": 272.66,
      "duration_seconds": 2.21,
      "text": "shall I start the examination?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 273.5,
      "end_seconds": 275.2,
      "duration_seconds": 1.7,
      "text": "Does that that hurt?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 292.2,
      "end_seconds": 298.85,
      "duration_seconds": 6.65,
      "text": "your tummy is soft with mild tenderness low down and no pain in the loins"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 300.35,
      "end_seconds": 301.88,
      "duration_seconds": 1.53,
      "text": "fine by me"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 304.8,
      "end_seconds": 321.11,
      "duration_seconds": 16.31,
      "text": "Please sit back down. So where does that leave us? I think we're dealing with a lower urinary tract infection at this stage. That's my thinking for now, and it may change as we learn more. Vaginal irritation is still possible."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 322.79,
      "end_seconds": 326.71,
      "duration_seconds": 3.92,
      "text": "Um, what are the odds it's serious?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 327.69,
      "end_seconds": 358.73,
      "duration_seconds": 31.04,
      "text": "I can't promise yet, but most people with a lower urinary tract infection do well once it's treated properly. I'm sending you for a urine culture because of recurrent urinary infection. I'd like to arrange a urine test for dysuria. I'm prescribing nitrofurantoin, 100 milligrams, twice a day, for three days. That should help with urinary infection. Drink plenty of water and don't hold on when you need to go"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 359.23,
      "end_seconds": 363.83,
      "duration_seconds": 4.6,
      "text": "I follow. I'd like you back after the culture result."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 365.32,
      "end_seconds": 367.64,
      "duration_seconds": 2.32,
      "text": "yes uh that's manageable"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 368.26,
      "end_seconds": 372.43,
      "duration_seconds": 4.17,
      "text": "that's everything on my side anything you're unsure about?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 373.47,
      "end_seconds": 376.71,
      "duration_seconds": 3.24,
      "text": "No, that's all. Thanks a lot."
    }
  ]
}