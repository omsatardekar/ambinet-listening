{
  "schema_version": "1.0",
  "encounter_id": "20447",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.2,
      "end_seconds": 8.4,
      "duration_seconds": 7.2,
      "text": "Sorry, what was I saying, hi, is it okay to come in now?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 10.24,
      "end_seconds": 14.2,
      "duration_seconds": 3.96,
      "text": "Of course, leave it there. How can I help?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 15.22,
      "end_seconds": 19.86,
      "duration_seconds": 4.64,
      "text": "Morning, doctor. I'll stay and fill in anything that's missed."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 20.85,
      "end_seconds": 27.63,
      "duration_seconds": 6.78,
      "text": "It's a hoarse voice. I thought I'd wait, but it hasn't gone."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 29.12,
      "end_seconds": 31.9,
      "duration_seconds": 2.78,
      "text": "How long has it been like this?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 32.77,
      "end_seconds": 46.15,
      "duration_seconds": 13.38,
      "text": "It's been two years, I'm fairly sure. And there's a little breathlessness as well, um, three weeks now. With little breathlessness, it comes and goes."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 47.06,
      "end_seconds": 51.17,
      "duration_seconds": 4.11,
      "text": "What about a dry tickly cough, have you noticed that?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 53.11,
      "end_seconds": 66.64,
      "duration_seconds": 13.53,
      "text": "Yes, about the same, about a month. With dry tickly cough, maybe a seven out of ten on a bad day. It's worse with talking and lying down."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 67.89,
      "end_seconds": 70.74,
      "duration_seconds": 2.85,
      "text": "Any past operations I should know about?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 72.45,
      "end_seconds": 77.4,
      "duration_seconds": 4.95,
      "text": "Yes, I had a varicose vein procedure, last year."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 91.85,
      "end_seconds": 95.51,
      "duration_seconds": 3.66,
      "text": "Any health conditions I should have on record?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 96.24,
      "end_seconds": 107.86,
      "duration_seconds": 11.62,
      "text": "I've had acid reflux for about a year now. I have high blood pressure, for about ten years. I've been putting this off for weeks."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 108.89,
      "end_seconds": 110.25,
      "duration_seconds": 1.36,
      "text": "Do you smoke?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 110.82,
      "end_seconds": 114.73,
      "duration_seconds": 3.91,
      "text": "I quit smoking around ten years ago."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 115.71,
      "end_seconds": 117.75,
      "duration_seconds": 2.04,
      "text": "Is there someone at home?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 119.31,
      "end_seconds": 122.92,
      "duration_seconds": 3.61,
      "text": "My husband and I live above the shop."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 124.96,
      "end_seconds": 126.39,
      "duration_seconds": 1.43,
      "text": "What's your work?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 128.41,
      "end_seconds": 132.73,
      "duration_seconds": 4.32,
      "text": "I'm a plumber, lots of bending and kneeling."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 133.3,
      "end_seconds": 136.16,
      "duration_seconds": 2.86,
      "text": "Do you follow any particular diet?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 138.17,
      "end_seconds": 141.41,
      "duration_seconds": 3.24,
      "text": "I'm vegetarian and have been for years."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 142.69,
      "end_seconds": 146.12,
      "duration_seconds": 3.43,
      "text": "Which medicines do you take at the moment?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 150.97,
      "end_seconds": 183.77,
      "duration_seconds": 32.8,
      "text": "Pantoprazole. I take it 40 milligrams, before breakfast for my acidity. I didn't want to make a fuss, you know. I just want to get back to normal, really. I'm on valsartan, 80 milligrams, once a day for my blood pressure. It's cough syrup, at night. I thought it would sort itself out, but it hasn't. Sorry, I know I'm rambling a bit."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 184.82,
      "end_seconds": 189.4,
      "duration_seconds": 4.58,
      "text": "Any inherited conditions that you know of in the family?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 191.23,
      "end_seconds": 193.52,
      "duration_seconds": 2.29,
      "text": "My sister had breast cancer."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 194.29,
      "end_seconds": 199.65,
      "duration_seconds": 5.36,
      "text": "Are you allergic to anything? Any allergies to medicines or foods?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 200.89,
      "end_seconds": 202.46,
      "duration_seconds": 1.57,
      "text": "Plasters, I'd say."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 203.46,
      "end_seconds": 206.8,
      "duration_seconds": 3.34,
      "text": "And what about heartburn or coughing up blood?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 208.49,
      "end_seconds": 212.84,
      "duration_seconds": 4.35,
      "text": "No heartburn or coughing up blood, none of it."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 217.44,
      "end_seconds": 221.5,
      "duration_seconds": 4.06,
      "text": "Have you had any wheeze, chest pain or weight loss?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 222.98,
      "end_seconds": 225.18,
      "duration_seconds": 2.2,
      "text": "None of those, no."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 226.78,
      "end_seconds": 228.07,
      "duration_seconds": 1.29,
      "text": "Neurologically, anything strange?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 229.56,
      "end_seconds": 231.73,
      "duration_seconds": 2.17,
      "text": "No, nothing like that."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 233.68,
      "end_seconds": 236.38,
      "duration_seconds": 2.7,
      "text": "Is your urine normal, no changes?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 237.56,
      "end_seconds": 239.13,
      "duration_seconds": 1.57,
      "text": "No changes there."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 240.5,
      "end_seconds": 243.62,
      "duration_seconds": 3.12,
      "text": "I'll just record a few vital signs."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 254.22,
      "end_seconds": 257.08,
      "duration_seconds": 2.86,
      "text": "Keep your arm relaxed for me..."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 275.7,
      "end_seconds": 292.21,
      "duration_seconds": 16.51,
      "text": "Okay: pulse 74, height 150 centimetres, respiratory rate 15. And oxygen saturation is 97 percent, BMI works out to 25.8, weight 58 kilos, temperature 36.8, BP is 108 over 80."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 293.29,
      "end_seconds": 297.37,
      "duration_seconds": 4.08,
      "text": "Let me look at the area, I'll be gentle."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 298.39,
      "end_seconds": 299.86,
      "duration_seconds": 1.47,
      "text": "Breathe out slowly."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 314.37,
      "end_seconds": 318.48,
      "duration_seconds": 4.11,
      "text": "Your chest is clear and there is no wheeze."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 320.72,
      "end_seconds": 322.6,
      "duration_seconds": 1.88,
      "text": "That's the examination finished."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 340.06,
      "end_seconds": 352.29,
      "duration_seconds": 12.23,
      "text": "So, based on the history and the examination, I'd lean towards a persistent dry cough without a clear cause so far. We shouldn't forget post-nasal drip."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 354.02,
      "end_seconds": 356.28,
      "duration_seconds": 2.26,
      "text": "Will it clear up?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 357.38,
      "end_seconds": 368.54,
      "duration_seconds": 11.16,
      "text": "I can't promise yet, but most people with a persistent dry cough without a clear cause so far do well once it's treated properly."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 382.59,
      "end_seconds": 387.89,
      "duration_seconds": 5.3,
      "text": "I'm sending you for a chest X-ray because of chronic cough."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 388.77,
      "end_seconds": 391.47,
      "duration_seconds": 2.7,
      "text": "Where would I go for that?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 393.35,
      "end_seconds": 398.19,
      "duration_seconds": 4.84,
      "text": "A breathing test is what I'd like next, for cough."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 398.8,
      "end_seconds": 401.18,
      "duration_seconds": 2.38,
      "text": "When would that take place?"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 402.39,
      "end_seconds": 411.5,
      "duration_seconds": 9.11,
      "text": "We will review your tablets and see whether the cough settles over a month. We'll catch up in four weeks."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 412.5,
      "end_seconds": 415.71,
      "duration_seconds": 3.21,
      "text": "I'll note it in my calendar."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 416.82,
      "end_seconds": 420.23,
      "duration_seconds": 3.41,
      "text": "So, does all of that make sense?"
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 421.89,
      "end_seconds": 424.92,
      "duration_seconds": 3.03,
      "text": "Great, thank you for your help."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 426.23,
      "end_seconds": 428.22,
      "duration_seconds": 1.99,
      "text": "Right, all the best."
    }
  ]
}