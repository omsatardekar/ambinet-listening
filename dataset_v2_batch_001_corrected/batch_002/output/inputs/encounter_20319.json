{
  "schema_version": "1.0",
  "encounter_id": "20319",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.34,
      "end_seconds": 3.66,
      "duration_seconds": 2.32,
      "text": "Hi, sit anywhere you like."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 4.3,
      "end_seconds": 9.11,
      "duration_seconds": 4.81,
      "text": "Hi doctor, I got here as fast as I could."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 9.86,
      "end_seconds": 13.03,
      "duration_seconds": 3.17,
      "text": "What would you like to start with today?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 14.35,
      "end_seconds": 20.06,
      "duration_seconds": 5.71,
      "text": "Uh, I've been dealing with a rash between my fingers."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 20.75,
      "end_seconds": 25.72,
      "duration_seconds": 4.97,
      "text": "Can you list what you take, tablets, creams or inhalers?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 27.69,
      "end_seconds": 34.54,
      "duration_seconds": 6.85,
      "text": "Calamine lotion, when needed. I've been reading about it online and it worried me."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 36.14,
      "end_seconds": 39.4,
      "duration_seconds": 3.26,
      "text": "How many days or weeks has it been?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 41.0,
      "end_seconds": 52.59,
      "duration_seconds": 11.59,
      "text": "Oh, for three weeks, I'd say. It's the not knowing that gets to me. I've never really been one for hospitals."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 54.11,
      "end_seconds": 56.1,
      "duration_seconds": 1.99,
      "text": "have you had trouble sleeping?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 57.33,
      "end_seconds": 62.48,
      "duration_seconds": 5.15,
      "text": "Um, you know, yes, about the same, two years."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 78.79,
      "end_seconds": 85.78,
      "duration_seconds": 6.99,
      "text": "Let me check a few things. Any swollen glands, rash on the face, joint pain or oozing?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 91.68,
      "end_seconds": 94.98,
      "duration_seconds": 3.3,
      "text": "no, I haven't had any of them"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 96.71,
      "end_seconds": 98.93,
      "duration_seconds": 2.22,
      "text": "Is your chest okay generally?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 99.72,
      "end_seconds": 100.71,
      "duration_seconds": 0.99,
      "text": "Breathing's normal."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 114.35,
      "end_seconds": 117.59,
      "duration_seconds": 3.24,
      "text": "Okay, are you in work at the moment?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 119.24,
      "end_seconds": 123.14,
      "duration_seconds": 3.9,
      "text": "Yes, I work in a bakery, early starts."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 123.98,
      "end_seconds": 128.2,
      "duration_seconds": 4.22,
      "text": "what does a a normal day of food look like?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 129.73,
      "end_seconds": 133.54,
      "duration_seconds": 3.81,
      "text": "Lots of rice, lentils and some fruit"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 134.97,
      "end_seconds": 136.96,
      "duration_seconds": 1.99,
      "text": "Do you do any exercise?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 138.33,
      "end_seconds": 140.99,
      "duration_seconds": 2.66,
      "text": "I swim twice a week."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 141.8,
      "end_seconds": 144.71,
      "duration_seconds": 2.91,
      "text": "has anyone ever diagnosed you with something?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 146.67,
      "end_seconds": 154.88,
      "duration_seconds": 8.21,
      "text": "I've had arthritis in my knees for about ten years now. Sorry, I know I'm rambling a bit."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 155.44,
      "end_seconds": 158.19,
      "duration_seconds": 2.75,
      "text": "Sure. Have you got any known allergies?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 159.38,
      "end_seconds": 162.03,
      "duration_seconds": 2.65,
      "text": "not to my knowledge, no"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 178.91,
      "end_seconds": 182.52,
      "duration_seconds": 3.61,
      "text": "Let me get the readings out of the way."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 190.02,
      "end_seconds": 192.88,
      "duration_seconds": 2.86,
      "text": "That's it, just a little longer..."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 212.01,
      "end_seconds": 221.23,
      "duration_seconds": 9.22,
      "text": "okay: pulse is 64 beats a minute, temp 36.5 degrees, blood pressure 110 over 69, respiratory rate 18."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 236.81,
      "end_seconds": 240.76,
      "duration_seconds": 3.95,
      "text": "listening to the whole story, this is probably scabies"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 241.89,
      "end_seconds": 243.72,
      "duration_seconds": 1.83,
      "text": "will it clear up?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 244.65,
      "end_seconds": 261.32,
      "duration_seconds": 16.67,
      "text": "I understand the worry. At the moment I'd say it's scabies, and we'll watch how it goes. Stop me if I've got anything wrong. You've had a rash between your fingers for three weeks, and no swollen glands or oozing."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 262.47,
      "end_seconds": 265.32,
      "duration_seconds": 2.85,
      "text": "Yes, uh, you've got it."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 267.24,
      "end_seconds": 291.3,
      "duration_seconds": 24.06,
      "text": "for this, permethrin cream, 5 percent, once, then again after a week, for two weeks that's for scabies everyone at home should be treated at the same time, and wash bedding and clothes at a high temperature i'd like you back if the itching continues after four weeks"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 292.67,
      "end_seconds": 294.69,
      "duration_seconds": 2.02,
      "text": "I can manage that."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 295.27,
      "end_seconds": 297.67,
      "duration_seconds": 2.4,
      "text": "Have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 298.46,
      "end_seconds": 301.69,
      "duration_seconds": 3.23,
      "text": "No, that's all. Thanks a lot."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 302.62,
      "end_seconds": 303.81,
      "duration_seconds": 1.19,
      "text": "Take care now."
    }
  ]
}