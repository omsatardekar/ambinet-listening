{
  "schema_version": "1.0",
  "encounter_id": "20471",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.96,
      "end_seconds": 3.03,
      "duration_seconds": 2.07,
      "text": "Morning, come on through."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 3.79,
      "end_seconds": 4.98,
      "duration_seconds": 1.19,
      "text": "Hi, thanks."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 6.45,
      "end_seconds": 9.82,
      "duration_seconds": 3.37,
      "text": "So, did you find the place alright?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 11.57,
      "end_seconds": 17.7,
      "duration_seconds": 6.13,
      "text": "Yes, it was easy enough. The parking was the hard part."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 19.02,
      "end_seconds": 22.16,
      "duration_seconds": 3.14,
      "text": "Okay, tell me what's brought you in."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 25.67,
      "end_seconds": 28.78,
      "duration_seconds": 3.11,
      "text": "So, I've been feeling lightheaded, doctor."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 30.36,
      "end_seconds": 32.49,
      "duration_seconds": 2.13,
      "text": "Tell me your medicines, please."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 33.92,
      "end_seconds": 39.24,
      "duration_seconds": 5.32,
      "text": "It's ramipril, 5 milligrams, every morning for my blood pressure."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 50.42,
      "end_seconds": 52.0,
      "duration_seconds": 1.58,
      "text": "When did this begin?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 53.98,
      "end_seconds": 57.73,
      "duration_seconds": 3.75,
      "text": "It's been going on for about a year."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 59.18,
      "end_seconds": 64.07,
      "duration_seconds": 4.89,
      "text": "Okay, give me more detail on it, whatever comes to mind."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 64.73,
      "end_seconds": 69.25,
      "duration_seconds": 4.52,
      "text": "Severe, really. Honestly, a couple of times a week."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 71.27,
      "end_seconds": 74.83,
      "duration_seconds": 3.56,
      "text": "A few quick ones: fainting or chest pain?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 75.96,
      "end_seconds": 77.97,
      "duration_seconds": 2.01,
      "text": "Nope, nothing like that."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 79.1,
      "end_seconds": 84.19,
      "duration_seconds": 5.09,
      "text": "Let me check a few things. Any weight loss or sweating?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 85.51,
      "end_seconds": 89.29,
      "duration_seconds": 3.78,
      "text": "No weight loss or sweating, none of it."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 90.96,
      "end_seconds": 92.93,
      "duration_seconds": 1.97,
      "text": "Has your skin been okay?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 94.61,
      "end_seconds": 95.64,
      "duration_seconds": 1.03,
      "text": "Skin's normal."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 97.26,
      "end_seconds": 100.78,
      "duration_seconds": 3.52,
      "text": "Alright, has anyone ever diagnosed you with something?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 101.87,
      "end_seconds": 103.85,
      "duration_seconds": 1.98,
      "text": "Yes, high blood pressure."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 120.07,
      "end_seconds": 124.07,
      "duration_seconds": 4.0,
      "text": "Are there any allergies I should be aware of?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 125.97,
      "end_seconds": 127.32,
      "duration_seconds": 1.35,
      "text": "No known allergies."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 128.03,
      "end_seconds": 130.41,
      "duration_seconds": 2.38,
      "text": "Do you follow any particular diet?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 131.49,
      "end_seconds": 135.18,
      "duration_seconds": 3.69,
      "text": "I'm vegetarian and have been for years."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 136.87,
      "end_seconds": 140.24,
      "duration_seconds": 3.37,
      "text": "What do you do during the day?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 141.53,
      "end_seconds": 144.95,
      "duration_seconds": 3.42,
      "text": "I look after my grandchildren most days."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 146.84,
      "end_seconds": 149.53,
      "duration_seconds": 2.69,
      "text": "Let me take your readings now."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 159.38,
      "end_seconds": 161.46,
      "duration_seconds": 2.08,
      "text": "Nearly done with the readings..."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 175.93,
      "end_seconds": 181.84,
      "duration_seconds": 5.91,
      "text": "Okay: blood pressure 131 over 80, pulse 113, oxygen saturation is 97 percent."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 185.71,
      "end_seconds": 187.37,
      "duration_seconds": 1.66,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 188.98,
      "end_seconds": 192.47,
      "duration_seconds": 3.49,
      "text": "Right, that's fine, I'll explain it soon."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 194.47,
      "end_seconds": 200.14,
      "duration_seconds": 5.67,
      "text": "Alright, I'd like to check you over now, if that's alright."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 207.92,
      "end_seconds": 208.93,
      "duration_seconds": 1.01,
      "text": "Of course."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 209.97,
      "end_seconds": 212.74,
      "duration_seconds": 2.77,
      "text": "Stay as you are for a moment."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 222.22,
      "end_seconds": 225.06,
      "duration_seconds": 2.84,
      "text": "Heart sounds are normal with no murmur."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 226.35,
      "end_seconds": 227.73,
      "duration_seconds": 1.38,
      "text": "Fine by me."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 229.56,
      "end_seconds": 230.84,
      "duration_seconds": 1.28,
      "text": "Does that hurt?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 237.94,
      "end_seconds": 241.8,
      "duration_seconds": 3.86,
      "text": "The pulse is irregular, around ninety beats a minute."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 247.4,
      "end_seconds": 249.77,
      "duration_seconds": 2.37,
      "text": "That's all I needed to check."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 262.28,
      "end_seconds": 269.07,
      "duration_seconds": 6.79,
      "text": "Okay, so my impression is this: It fits best with paroxysmal palpitations, possibly an atrial arrhythmia."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 270.78,
      "end_seconds": 274.09,
      "duration_seconds": 3.31,
      "text": "I'm scared it's something bad. Is it?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 275.34,
      "end_seconds": 303.7,
      "duration_seconds": 28.36,
      "text": "I understand the worry. At the moment I'd say it's paroxysmal palpitations, possibly an atrial arrhythmia, and we'll know more once the a heart monitor for a few days is back. I'd like to arrange a heart monitor for a few days for palpitations. An ECG is what I'd like next, for palpitations. Let's use bisoprolol, 2.5 milligrams, once a day, until review. That should help with heart rate control."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 305.53,
      "end_seconds": 322.99,
      "duration_seconds": 17.46,
      "text": "Cut right back on coffee, tea and energy drinks for now. If you faint or get chest pain with the racing, or you feel really unwell, please come to the emergency department. Please come and see me after the monitor results are back."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 325.03,
      "end_seconds": 325.73,
      "duration_seconds": 0.7,
      "text": "Sure."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 328.38,
      "end_seconds": 333.55,
      "duration_seconds": 5.17,
      "text": "Right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 335.09,
      "end_seconds": 338.16,
      "duration_seconds": 3.07,
      "text": "Thank you, you know, doctor, goodbye."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 339.91,
      "end_seconds": 341.18,
      "duration_seconds": 1.27,
      "text": "See you soon."
    }
  ]
}