{
  "schema_version": "1.0",
  "encounter_id": "20151",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.56,
      "end_seconds": 4.89,
      "duration_seconds": 4.33,
      "text": "Doctor? Hello, I hope this is the right time."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.69,
      "end_seconds": 10.32,
      "duration_seconds": 3.63,
      "text": "Come in. Please sit. How can I help you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 12.0,
      "end_seconds": 17.78,
      "duration_seconds": 5.78,
      "text": "Doctor, I'll sit in if that's okay, I know what's been happening."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 18.35,
      "end_seconds": 20.87,
      "duration_seconds": 2.52,
      "text": "Absolutely, come and sit beside them."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 21.81,
      "end_seconds": 26.53,
      "duration_seconds": 4.72,
      "text": "So, I've been needing to go all the time, doctor."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 28.21,
      "end_seconds": 30.65,
      "duration_seconds": 2.44,
      "text": "I'll do your observations first."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 39.26,
      "end_seconds": 42.03,
      "duration_seconds": 2.77,
      "text": "That's it, just a little longer..."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 52.02,
      "end_seconds": 59.14,
      "duration_seconds": 7.12,
      "text": "Okay: pressure 125 over 74, oxygen saturation is 98 percent, pulse 68, temperature 36.6."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 75.29,
      "end_seconds": 76.72,
      "duration_seconds": 1.43,
      "text": "Since when exactly?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 78.48,
      "end_seconds": 80.81,
      "duration_seconds": 2.33,
      "text": "It's been two days now."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 82.29,
      "end_seconds": 87.18,
      "duration_seconds": 4.89,
      "text": "Any a dull ache above the pubic bone as well?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 87.97,
      "end_seconds": 98.69,
      "duration_seconds": 10.72,
      "text": "Mm, yes. With dull ache above the pubic bone, pretty severe, if I'm being honest. I'd say every other day."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 99.29,
      "end_seconds": 104.48,
      "duration_seconds": 5.19,
      "text": "What about a sudden urgent need to go, have you noticed that?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 105.02,
      "end_seconds": 107.56,
      "duration_seconds": 2.54,
      "text": "Yeah. Two weeks, I'd say."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 108.12,
      "end_seconds": 110.4,
      "duration_seconds": 2.28,
      "text": "Any vomiting or new partner?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 111.2,
      "end_seconds": 115.92,
      "duration_seconds": 4.72,
      "text": "I mean, no, I haven't had any of them."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 116.86,
      "end_seconds": 121.54,
      "duration_seconds": 4.68,
      "text": "Did you get vaginal discharge or blood in the urine?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 122.21,
      "end_seconds": 125.13,
      "duration_seconds": 2.92,
      "text": "No, none of those at all."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 125.81,
      "end_seconds": 127.42,
      "duration_seconds": 1.61,
      "text": "How's your breathing otherwise?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 132.09,
      "end_seconds": 134.26,
      "duration_seconds": 2.17,
      "text": "No problems with breathing."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 135.7,
      "end_seconds": 137.79,
      "duration_seconds": 2.09,
      "text": "Has your skin been okay?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 139.87,
      "end_seconds": 143.56,
      "duration_seconds": 3.69,
      "text": "Ah, um, no, skin's been fine."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 151.1,
      "end_seconds": 155.68,
      "duration_seconds": 4.58,
      "text": "What conditions have you been treated for in the past?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 157.3,
      "end_seconds": 160.91,
      "duration_seconds": 3.61,
      "text": "I have diabetes, for about a year."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 161.59,
      "end_seconds": 165.56,
      "duration_seconds": 3.97,
      "text": "I see, go ahead. How are your meals?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 167.2,
      "end_seconds": 171.56,
      "duration_seconds": 4.36,
      "text": "I grab fast food at lunch most days."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 172.83,
      "end_seconds": 175.38,
      "duration_seconds": 2.55,
      "text": "Do you work outside the home?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 177.35,
      "end_seconds": 181.57,
      "duration_seconds": 4.22,
      "text": "I'm a hairdresser, on my feet all day."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 183.12,
      "end_seconds": 184.68,
      "duration_seconds": 1.56,
      "text": "Who lives with you?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 185.8,
      "end_seconds": 188.37,
      "duration_seconds": 2.57,
      "text": "My partner and our baby."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 189.77,
      "end_seconds": 193.02,
      "duration_seconds": 3.25,
      "text": "Is there anything relevant on the family side?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 193.53,
      "end_seconds": 195.47,
      "duration_seconds": 1.94,
      "text": "My cousin has psoriasis."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 197.47,
      "end_seconds": 204.8,
      "duration_seconds": 7.33,
      "text": "Have you got any known allergies? I ask because it helps me narrow things down."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 207.7,
      "end_seconds": 210.14,
      "duration_seconds": 2.44,
      "text": "Right, no allergies at all."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 212.14,
      "end_seconds": 214.99,
      "duration_seconds": 2.85,
      "text": "Any regular medication, tablets or creams?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 217.92,
      "end_seconds": 219.47,
      "duration_seconds": 1.55,
      "text": "Nothing regular, no."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 221.46,
      "end_seconds": 225.54,
      "duration_seconds": 4.08,
      "text": "Let me look at the area, I'll be gentle."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 239.97,
      "end_seconds": 240.9,
      "duration_seconds": 0.93,
      "text": "Sure thing."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 242.88,
      "end_seconds": 244.12,
      "duration_seconds": 1.24,
      "text": "Does that hurt?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 257.04,
      "end_seconds": 263.07,
      "duration_seconds": 6.03,
      "text": "Your tummy is soft with mild tenderness low down and no pain in the loins."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 265.66,
      "end_seconds": 296.52,
      "duration_seconds": 30.86,
      "text": "You can sit up now. Right, here's what I'm thinking. I'd lean towards a lower urinary tract infection. A urine test is what I'd like next, for dysuria. I'll request a urine culture, it'll help with recurrent urinary infection. The result will help us decide whether anything more is needed. You'll be taking nitrofurantoin, 100 milligrams, twice a day, for three days. You take it by mouth. It's for urinary infection."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 298.57,
      "end_seconds": 302.54,
      "duration_seconds": 3.97,
      "text": "Is that safe with my other medicines?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 303.61,
      "end_seconds": 322.6,
      "duration_seconds": 18.99,
      "text": "Drink plenty of water and don't hold on when you need to go. If you get fever, loin pain or vomiting, that's the point to come in urgently. I'd like to see you again after the culture result. Is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 324.37,
      "end_seconds": 328.58,
      "duration_seconds": 4.21,
      "text": "Right, I'll do that. Thank you, doctor."
    }
  ]
}