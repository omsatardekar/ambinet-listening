  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 1.05,
      "end_seconds": 6.16,
      "duration_seconds": 5.11,
      "text": "Doctor, I've brought them through. The observations are done, whenever you need them."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.63,
      "end_seconds": 10.99,
      "duration_seconds": 3.36,
      "text": "Okay, thanks. Hi, how can I help today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 12.86,
      "end_seconds": 18.3,
      "duration_seconds": 5.44,
      "text": "Yeah it's a tight scalp. I don't know what's causing it."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 20.23,
      "end_seconds": 23.54,
      "duration_seconds": 3.31,
      "text": "Is there any regular medication you use?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 24.59,
      "end_seconds": 27.25,
      "duration_seconds": 2.66,
      "text": "Nothing regular um no."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 29.0,
      "end_seconds": 31.43,
      "duration_seconds": 2.43,
      "text": "did it come on recently?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 35.41,
      "end_seconds": 38.66,
      "duration_seconds": 3.25,
      "text": "I've had it for two months"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 39.17,
      "end_seconds": 47.57,
      "duration_seconds": 8.4,
      "text": "tell me a bit more about it: how bad it gets, how often, and whether anything makes it better or worse"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 48.85,
      "end_seconds": 61.9,
      "duration_seconds": 13.05,
      "text": "Mild really. I get some relief from a head massage. I wasn't sure whether to come in at all to be honest."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 62.48,
      "end_seconds": 65.37,
      "duration_seconds": 2.89,
      "text": "Is there anything else with it?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 69.28,
      "end_seconds": 83.5,
      "duration_seconds": 14.22,
      "text": "so, when it starts I tend to get a stiff neck as well. As for stiff neck, moderate, really. It sort of comes and goes"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 98.15,
      "end_seconds": 100.05,
      "duration_seconds": 1.9,
      "text": "nothing like head injury?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 101.15,
      "end_seconds": 103.27,
      "duration_seconds": 2.12,
      "text": "no no head injury"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 105.04,
      "end_seconds": 107.38,
      "duration_seconds": 2.34,
      "text": "Did you get fever or vomiting?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 109.29,
      "end_seconds": 114.95,
      "duration_seconds": 5.66,
      "text": "well, you know, I haven't had fever or vomiting, no"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 116.58,
      "end_seconds": 119.86,
      "duration_seconds": 3.28,
      "text": "okay, have you noticed weakness or blurred vision?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 121.22,
      "end_seconds": 124.63,
      "duration_seconds": 3.41,
      "text": "no, no weakness or blurred vision"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 126.5,
      "end_seconds": 130.6,
      "duration_seconds": 4.1,
      "text": "any change in your bowel habit or your stomach generally?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 131.44,
      "end_seconds": 133.1,
      "duration_seconds": 1.66,
      "text": "Nothing unusual, no."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 133.71,
      "end_seconds": 136.18,
      "duration_seconds": 2.47,
      "text": "have you had any surgical procedures?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 137.56,
      "end_seconds": 144.2,
      "duration_seconds": 6.64,
      "text": "yeah, just my appendix taken out, when I was in my twenties"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 145.04,
      "end_seconds": 147.54,
      "duration_seconds": 2.5,
      "text": "have you got any known allergies?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 148.44,
      "end_seconds": 152.57,
      "duration_seconds": 4.13,
      "text": "Right, no, not that I know of."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 157.23,
      "end_seconds": 159.89,
      "duration_seconds": 2.66,
      "text": "do you have any chronic illnesses?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 160.46,
      "end_seconds": 164.52,
      "duration_seconds": 4.06,
      "text": "I've had anxiety for two years now"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 169.81,
      "end_seconds": 180.79,
      "duration_seconds": 10.98,
      "text": "Right, so so anxiety is already on your record. We'll keep that in mind today. A few questions about your lifestyle now."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 181.75,
      "end_seconds": 194.99,
      "duration_seconds": 13.24,
      "text": "Yes, I work in a bakery, early starts. Not much, I mostly stay in these days. I live with my elderly mother."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 196.78,
      "end_seconds": 210.45,
      "duration_seconds": 13.67,
      "text": "Here are the numbers, doctor. Respiratory rate 18, blood pressure 128 over 68, temperature is 36.5 degrees, pulse is 78 beats a minute, SpO2 97 percent on room air."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 211.11,
      "end_seconds": 212.03,
      "duration_seconds": 0.92,
      "text": "okay, noted"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 213.08,
      "end_seconds": 215.48,
      "duration_seconds": 2.4,
      "text": "May I examine you now?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 217.09,
      "end_seconds": 219.81,
      "duration_seconds": 2.72,
      "text": "so I'll listen to your chest now"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 230.83,
      "end_seconds": 237.21,
      "duration_seconds": 6.38,
      "text": "Neck muscles are tight and tender, and the eye and limb checks are normal"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 242.61,
      "end_seconds": 244.27,
      "duration_seconds": 1.66,
      "text": "Please sit back down."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 257.97,
      "end_seconds": 271.08,
      "duration_seconds": 13.11,
      "text": "let me tell you where I've got to. It's hard to say. Tension-type headaches with possible medication overuse is one possibility and migraine another, and I'd rather not commit yet"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 286.8,
      "end_seconds": 290.47,
      "duration_seconds": 3.67,
      "text": "I'll request blood tests, it'll help with headache."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 292.32,
      "end_seconds": 294.7,
      "duration_seconds": 2.38,
      "text": "that's fine with me"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 295.63,
      "end_seconds": 312.46,
      "duration_seconds": 16.83,
      "text": "we should do a headache diary for frequent headaches. Try to limit painkillers to two days a week and keep a diary of the headaches. I'd like you back after the diary. That's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 312.97,
      "end_seconds": 316.68,
      "duration_seconds": 3.71,
      "text": "great, thank you for your help"
    }
  ]
}