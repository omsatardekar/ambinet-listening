{
  "schema_version": "1.0",
  "encounter_id": "20240",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.66,
      "end_seconds": 8.77,
      "duration_seconds": 8.11,
      "text": "Hello, sorry about the delay, do sit. So, what would you like to start with today?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 10.08,
      "end_seconds": 18.19,
      "duration_seconds": 8.11,
      "text": "Um, it's a bump on my head. I thought I'd wait, but it it hasn't gone."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 19.42,
      "end_seconds": 20.76,
      "duration_seconds": 1.34,
      "text": "Since when exactly?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 21.57,
      "end_seconds": 36.12,
      "duration_seconds": 14.55,
      "text": "It's been ten days now. It's the not knowing that gets to me. Sorry, I know I'm rambling a bit. And I've been feeling dizzy as well, for three days."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 37.03,
      "end_seconds": 39.77,
      "duration_seconds": 2.74,
      "text": "how much trouble does it give you?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 41.68,
      "end_seconds": 42.79,
      "duration_seconds": 1.11,
      "text": "Moderate, really."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 44.44,
      "end_seconds": 48.42,
      "duration_seconds": 3.98,
      "text": "alright, any a headache since the fall as well?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 50.17,
      "end_seconds": 60.51,
      "duration_seconds": 10.34,
      "text": "Yeah, I've had that since this morning. Okay, so as for headache since the fall, honestly, a couple of times a week."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 62.25,
      "end_seconds": 65.28,
      "duration_seconds": 3.03,
      "text": "Time for your numbers, if that's okay."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 73.02,
      "end_seconds": 75.79,
      "duration_seconds": 2.77,
      "text": "Keep your arm relaxed for me..."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 95.66,
      "end_seconds": 103.22,
      "duration_seconds": 7.56,
      "text": "Okay: saturation 98 percent, heart rate 76. And temperature 36.9, respiratory rate 15, pressure 109 over 78."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 104.61,
      "end_seconds": 106.28,
      "duration_seconds": 1.67,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 107.75,
      "end_seconds": 110.68,
      "duration_seconds": 2.93,
      "text": "I'll come back to the numbers"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 112.78,
      "end_seconds": 116.09,
      "duration_seconds": 3.31,
      "text": "okay, time for me to examine you"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 117.17,
      "end_seconds": 118.55,
      "duration_seconds": 1.38,
      "text": "fine by me"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 120.21,
      "end_seconds": 122.5,
      "duration_seconds": 2.29,
      "text": "Hold that for a second."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 141.09,
      "end_seconds": 149.51,
      "duration_seconds": 8.42,
      "text": "There is a small bruise on the forehead, the pupils are equal and reactive, and you are walking steadily."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 153.29,
      "end_seconds": 158.26,
      "duration_seconds": 4.97,
      "text": "Good, you can sit up again. And double vision, any of that?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 161.82,
      "end_seconds": 165.24,
      "duration_seconds": 3.42,
      "text": "No, uh, none, no double vision."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 165.82,
      "end_seconds": 171.64,
      "duration_seconds": 5.82,
      "text": "A few quick ones: clear fluid from the nose or ear, weakness or confusion?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 172.65,
      "end_seconds": 179.98,
      "duration_seconds": 7.33,
      "text": "I haven't had clear fluid from the nose or ear, weakness or confusion, no."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 180.78,
      "end_seconds": 184.72,
      "duration_seconds": 3.94,
      "text": "Any change in your bowel habit or your stomach generally?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 185.9,
      "end_seconds": 187.41,
      "duration_seconds": 1.51,
      "text": "Nothing unusual, no."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 198.17,
      "end_seconds": 201.46,
      "duration_seconds": 3.29,
      "text": "right, do you have any long-term conditions?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 202.8,
      "end_seconds": 208.57,
      "duration_seconds": 5.77,
      "text": "yes, high blood pressure. I have eczema, for about a year"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 210.45,
      "end_seconds": 211.75,
      "duration_seconds": 1.3,
      "text": "Okay, what else?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 213.76,
      "end_seconds": 221.28,
      "duration_seconds": 7.52,
      "text": "Alright, eczema, that matches what I have here. Does your family have any medical conditions?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 222.65,
      "end_seconds": 224.85,
      "duration_seconds": 2.2,
      "text": "My brother has epilepsy."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 226.13,
      "end_seconds": 232.93,
      "duration_seconds": 6.8,
      "text": "what do you take on a normal day? I ask because it helps me narrow things down"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 234.61,
      "end_seconds": 237.26,
      "duration_seconds": 2.65,
      "text": "It's hydrocortisone cream, when needed."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 240.43,
      "end_seconds": 245.35,
      "duration_seconds": 4.92,
      "text": "Do you react to any medicines or foods? Any allergies?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 247.34,
      "end_seconds": 252.07,
      "duration_seconds": 4.73,
      "text": "let me think, yes, trimethoprim, it gives me itching"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 259.14,
      "end_seconds": 261.44,
      "duration_seconds": 2.3,
      "text": "do you get out much?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 262.33,
      "end_seconds": 266.8,
      "duration_seconds": 4.47,
      "text": "Not much, I mostly stay in these days"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 270.47,
      "end_seconds": 272.88,
      "duration_seconds": 2.41,
      "text": "Is there someone at home?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 274.28,
      "end_seconds": 277.92,
      "duration_seconds": 3.64,
      "text": "My husband and I live above the shop."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 291.54,
      "end_seconds": 300.55,
      "duration_seconds": 9.01,
      "text": "So where does that leave us? I think we're dealing with a minor head injury without worrying signs at this stage."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 302.15,
      "end_seconds": 305.02,
      "duration_seconds": 2.87,
      "text": "What are the odds it's serious?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 305.78,
      "end_seconds": 334.96,
      "duration_seconds": 29.18,
      "text": "I understand the worry. At the moment I'd say it's a minor head injury without worrying signs, and we'll watch how it goes. For this, paracetamol, 1 gram, every six hours if needed, for three days. It's for headache. Someone should stay with you tonight, and no alcohol or contact sport for now. I'll want another look if the headache gets worse"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 335.63,
      "end_seconds": 338.35,
      "duration_seconds": 2.72,
      "text": "I'll note it in my calendar"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 339.13,
      "end_seconds": 342.26,
      "duration_seconds": 3.13,
      "text": "Anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 344.12,
      "end_seconds": 347.17,
      "duration_seconds": 3.05,
      "text": "Great, thank you for your help."
    }
  ]
}