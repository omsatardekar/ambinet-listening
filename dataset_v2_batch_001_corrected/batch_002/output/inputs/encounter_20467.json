{
  "schema_version": "1.0",
  "encounter_id": "20467",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.7,
      "end_seconds": 4.18,
      "duration_seconds": 3.48,
      "text": "Sorry I'm a little late, doctor."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.18,
      "end_seconds": 10.3,
      "duration_seconds": 4.12,
      "text": "Not at all, please sit. What seems to be wrong?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 10.8,
      "end_seconds": 27.72,
      "duration_seconds": 16.92,
      "text": "I've been passing clots, and I wanted to get it checked. It's the not knowing that gets to me. I told myself I'd wait and see, and here I am."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 32.68,
      "end_seconds": 35.89,
      "duration_seconds": 3.21,
      "text": "Can you tell me when it first started?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 37.95,
      "end_seconds": 58.3,
      "duration_seconds": 20.35,
      "text": "I'd say six months. Actually, no, closer to about a month. I've also had being breathless on the stairs, for nearly five years. About being breathless on the stairs, I'd say a few times a day."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 64.66,
      "end_seconds": 67.9,
      "duration_seconds": 3.24,
      "text": "What about heavy periods, have you noticed that?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 72.1,
      "end_seconds": 74.74,
      "duration_seconds": 2.64,
      "text": "Yes, for about a year."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 75.54,
      "end_seconds": 80.92,
      "duration_seconds": 5.38,
      "text": "So, have you been passing clots at any time before this?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 81.49,
      "end_seconds": 88.98,
      "duration_seconds": 7.49,
      "text": "Yes, something like this happened about six months ago, and it went away on its own."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 90.3,
      "end_seconds": 92.25,
      "duration_seconds": 1.95,
      "text": "Any pelvic pain or fainting?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 92.98,
      "end_seconds": 95.85,
      "duration_seconds": 2.87,
      "text": "No, no pelvic pain or fainting."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 97.7,
      "end_seconds": 101.88,
      "duration_seconds": 4.18,
      "text": "Any pins and needles or loss of strength anywhere?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 102.76,
      "end_seconds": 104.75,
      "duration_seconds": 1.99,
      "text": "No, that's all normal."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 105.93,
      "end_seconds": 108.85,
      "duration_seconds": 2.92,
      "text": "Any problems with your joints or muscles?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 113.39,
      "end_seconds": 115.01,
      "duration_seconds": 1.62,
      "text": "No, nothing there."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 120.35,
      "end_seconds": 122.65,
      "duration_seconds": 2.3,
      "text": "Let's run through your medicines."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 124.43,
      "end_seconds": 126.8,
      "duration_seconds": 2.37,
      "text": "Hydrocortisone cream, when needed."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 128.56,
      "end_seconds": 131.35,
      "duration_seconds": 2.79,
      "text": "How long has that been going on?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 132.58,
      "end_seconds": 139.68,
      "duration_seconds": 7.1,
      "text": "For nearly five years. Uh, you know, I'm on iron tablets, once a day."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 143.11,
      "end_seconds": 146.3,
      "duration_seconds": 3.19,
      "text": "Has anyone ever diagnosed you with something?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 148.11,
      "end_seconds": 150.93,
      "duration_seconds": 2.82,
      "text": "Eczema, for about ten years."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 152.32,
      "end_seconds": 154.74,
      "duration_seconds": 2.42,
      "text": "Have you got any known allergies?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 155.78,
      "end_seconds": 162.0,
      "duration_seconds": 6.22,
      "text": "Not currently, but as a youngster amoxicillin gave me a rash all over."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 163.86,
      "end_seconds": 167.08,
      "duration_seconds": 3.22,
      "text": "Are there any illnesses in your family?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 168.49,
      "end_seconds": 170.44,
      "duration_seconds": 1.95,
      "text": "My cousin has psoriasis."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 178.73,
      "end_seconds": 181.61,
      "duration_seconds": 2.88,
      "text": "A few questions about your lifestyle now."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 183.04,
      "end_seconds": 193.82,
      "duration_seconds": 10.78,
      "text": "I'm vegetarian and have been for years. My husband and I live above the shop. Yes, I work in a bakery, early starts."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 195.05,
      "end_seconds": 198.81,
      "duration_seconds": 3.76,
      "text": "Shall I check your blood pressure and pulse?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 210.28,
      "end_seconds": 212.86,
      "duration_seconds": 2.58,
      "text": "Okay, this won't take long..."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 228.12,
      "end_seconds": 235.76,
      "duration_seconds": 7.64,
      "text": "Okay: temp 36.4 degrees, pulse is 71 beats a minute, BP is 124 over 77."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 236.72,
      "end_seconds": 238.14,
      "duration_seconds": 1.42,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 239.67,
      "end_seconds": 243.05,
      "duration_seconds": 3.38,
      "text": "I'll explain what these mean in a moment."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 244.38,
      "end_seconds": 248.18,
      "duration_seconds": 3.8,
      "text": "I'll examine you in a second, make yourself comfortable."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 266.02,
      "end_seconds": 267.8,
      "duration_seconds": 1.78,
      "text": "Yeah, no problem."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 268.92,
      "end_seconds": 271.21,
      "duration_seconds": 2.29,
      "text": "Tell me if that's sore."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 285.72,
      "end_seconds": 290.05,
      "duration_seconds": 4.33,
      "text": "Your eyelids and the palms of your hands look pale."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 295.47,
      "end_seconds": 297.54,
      "duration_seconds": 2.07,
      "text": "All finished, thank you."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 309.02,
      "end_seconds": 323.19,
      "duration_seconds": 14.17,
      "text": "Okay, thinking it through, the most likely explanation is heavy periods with iron deficiency. The reason I say that is that your story and my examination fit together. We shouldn't forget a thyroid problem."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 325.08,
      "end_seconds": 328.22,
      "duration_seconds": 3.14,
      "text": "Do you think it's something serious?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 328.8,
      "end_seconds": 366.32,
      "duration_seconds": 37.52,
      "text": "I can't promise yet, but most people with heavy periods with iron deficiency do well once it's treated properly. A pelvic ultrasound is what I'd like next, for heavy periods. I'll start you on tranexamic acid, 1 gram, three times a day during periods, for four days each cycle. It's for heavy periods. Iron can darken the stools and bother the stomach, so take it after food. I'm going to send a referral to the gynaecology clinic."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 367.37,
      "end_seconds": 373.71,
      "duration_seconds": 6.34,
      "text": "Please come and see me after the results. Alright, have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 375.48,
      "end_seconds": 377.03,
      "duration_seconds": 1.55,
      "text": "That's clear, thanks."
    }
  ]
}