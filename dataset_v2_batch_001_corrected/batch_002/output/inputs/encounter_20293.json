      "segment_id": "SEG0044",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 319.4,
      "end_seconds": 325.44,
      "duration_seconds": 6.04,
      "text": "Mm, can I collect it it from my own pharmacy?"
