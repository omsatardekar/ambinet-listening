    {
      "segment_id": "SEG0041",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 273.6,
      "end_seconds": 277.71,
      "duration_seconds": 4.11,
      "text": "I'm scared it's something bad is it?"
