      "start_seconds": 1.2,
      "end_seconds": 6.79,
      "duration_seconds": 5.59,
      "text": "I mean, hi, is it okay to come in now?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.02,
      "end_seconds": 12.38,
      "duration_seconds": 4.36,
      "text": "Yes, have a seat. Tell me what's going on."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 13.85,
      "end_seconds": 23.88,
      "duration_seconds": 10.03,
      "text": "I wanted to get a mole that has changed looked at. It's the not knowing that gets to me"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 25.27,
      "end_seconds": 28.4,
      "duration_seconds": 3.13,
      "text": "How many days or weeks has it been?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 29.06,
      "end_seconds": 31.08,
      "duration_seconds": 2.02,
      "text": "Probably six months. Yeah."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 32.8,
      "end_seconds": 36.06,
      "duration_seconds": 3.26,
      "text": "Time for your numbers, if that's okay."
