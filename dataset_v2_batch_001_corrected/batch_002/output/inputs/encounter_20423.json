{
  "schema_version": "1.0",
  "encounter_id": "20423",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.63,
      "end_seconds": 6.53,
      "duration_seconds": 5.9,
      "text": "Mm, you know, hello, doctor. I think it's my turn."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.25,
      "end_seconds": 11.94,
      "duration_seconds": 4.69,
      "text": "Not at all, please sit. What seems to be wrong?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 13.99,
      "end_seconds": 21.18,
      "duration_seconds": 7.19,
      "text": "Mainly I've been passing a lot of urine. That's why I came."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 21.43,
      "end_seconds": 25.81,
      "duration_seconds": 4.38,
      "text": "Right, right. Rate it for me, mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 26.84,
      "end_seconds": 30.29,
      "duration_seconds": 3.45,
      "text": "Mostly moderate. There's recurrent thrush as well."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 35.43,
      "end_seconds": 38.17,
      "duration_seconds": 2.74,
      "text": "Have you been losing some weight?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 40.0,
      "end_seconds": 44.36,
      "duration_seconds": 4.36,
      "text": "Oh, yes, about the same, about a year."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 45.03,
      "end_seconds": 49.47,
      "duration_seconds": 4.44,
      "text": "Let me get the readings out of the way."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 61.86,
      "end_seconds": 63.92,
      "duration_seconds": 2.06,
      "text": "Okay, this won't take long..."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 76.56,
      "end_seconds": 88.46,
      "duration_seconds": 11.9,
      "text": "Okay: temp 36.9 degrees, saturation 99 percent. And pressure 156 over 91, pulse is 79 beats a minute, height 184 centimetres, weight 80 kilos."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 89.24,
      "end_seconds": 90.8,
      "duration_seconds": 1.56,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 95.12,
      "end_seconds": 97.23,
      "duration_seconds": 2.11,
      "text": "We'll go over that shortly."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 98.73,
      "end_seconds": 100.84,
      "duration_seconds": 2.11,
      "text": "May I examine you now?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 102.2,
      "end_seconds": 105.4,
      "duration_seconds": 3.2,
      "text": "Stay as you are for a moment."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 117.3,
      "end_seconds": 124.15,
      "duration_seconds": 6.85,
      "text": "Your fingerprick sugar here is high, and your feet have good pulses and normal feeling."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 127.44,
      "end_seconds": 134.58,
      "duration_seconds": 7.14,
      "text": "So, all finished, thank you. Any abdominal pain or fruity smelling breath at all?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 136.24,
      "end_seconds": 139.33,
      "duration_seconds": 3.09,
      "text": "No, none of those at all."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 139.82,
      "end_seconds": 143.73,
      "duration_seconds": 3.91,
      "text": "Right, right. Any fever or chest pain at all?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 144.74,
      "end_seconds": 149.69,
      "duration_seconds": 4.95,
      "text": "I haven't had fever or chest pain, no."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 150.64,
      "end_seconds": 153.5,
      "duration_seconds": 2.86,
      "text": "Has your heart given you any trouble?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 155.24,
      "end_seconds": 160.91,
      "duration_seconds": 5.67,
      "text": "Sorry, what was I saying, no, that's been fine."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 171.29,
      "end_seconds": 175.98,
      "duration_seconds": 4.69,
      "text": "Alright, any inherited conditions that you know of in the family?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 176.57,
      "end_seconds": 181.86,
      "duration_seconds": 5.29,
      "text": "Sorry, what was I saying, my grandfather had a stroke."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 183.92,
      "end_seconds": 187.34,
      "duration_seconds": 3.42,
      "text": "What line of work are you in?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 188.1,
      "end_seconds": 193.17,
      "duration_seconds": 5.07,
      "text": "I'm a bus driver, so I sit for long hours."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 194.23,
      "end_seconds": 196.78,
      "duration_seconds": 2.55,
      "text": "Anything you do to stay fit?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 198.86,
      "end_seconds": 202.43,
      "duration_seconds": 3.57,
      "text": "I do a yoga class on Thursdays."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 203.0,
      "end_seconds": 204.95,
      "duration_seconds": 1.95,
      "text": "How are your meals?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 206.1,
      "end_seconds": 210.33,
      "duration_seconds": 4.23,
      "text": "I grab fast food at lunch most days."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 225.73,
      "end_seconds": 229.77,
      "duration_seconds": 4.04,
      "text": "Do you react to any medicines or foods? Any allergies?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 230.91,
      "end_seconds": 236.17,
      "duration_seconds": 5.26,
      "text": "Yes, diclofenac, it gives me swelling of my lips."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 252.83,
      "end_seconds": 254.95,
      "duration_seconds": 2.12,
      "text": "Let's run through your medicines."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 256.24,
      "end_seconds": 272.89,
      "duration_seconds": 16.65,
      "text": "Losartan, 50 milligrams, once a day. Atorvastatin. I take it 20 milligrams, at night. Mm, I'm on something called aspi... aspirin, 75 milligrams, maybe, once a day for my heart."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 274.52,
      "end_seconds": 278.47,
      "duration_seconds": 3.95,
      "text": "Did you happen to bring the box or the paperwork?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 280.19,
      "end_seconds": 285.29,
      "duration_seconds": 5.1,
      "text": "No, it's at home. Amlodipine I don't take anymore."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 286.03,
      "end_seconds": 288.99,
      "duration_seconds": 2.96,
      "text": "Have you ever had an operation?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 290.1,
      "end_seconds": 295.66,
      "duration_seconds": 5.56,
      "text": "Okay, so I had a triple bypass eight years ago."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 299.55,
      "end_seconds": 303.37,
      "duration_seconds": 3.82,
      "text": "Tell me about any past illnesses or ongoing conditions."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 305.06,
      "end_seconds": 312.6,
      "duration_seconds": 7.54,
      "text": "Yes, high blood pressure. Hmm, I have high cholesterol, for five years."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 314.43,
      "end_seconds": 315.81,
      "duration_seconds": 1.38,
      "text": "Okay, go on."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 316.64,
      "end_seconds": 320.67,
      "duration_seconds": 4.03,
      "text": "Okay, so I've had heart disease, yes."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 326.76,
      "end_seconds": 360.15,
      "duration_seconds": 33.39,
      "text": "Right, so high blood pressure and high cholesterol are already on your record. We'll keep that in mind today. Having listened and examined, it points towards symptoms that point to newly developed type 2 diabetes. I want to be honest that this is an impression, not a final answer. It could also be an overactive thyroid, so we'll keep that open. Let's get a urine test, for polyuria. I'm sending you for an HbA1c because of suspected diabetes."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 362.2,
      "end_seconds": 375.84,
      "duration_seconds": 13.64,
      "text": "I'm prescribing metformin, 500 milligrams, once a day with food, long term. That's for high blood sugar. It's a commonly used medicine and most people tolerate it well."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 377.86,
      "end_seconds": 379.57,
      "duration_seconds": 1.71,
      "text": "Thank you, doctor."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 384.75,
      "end_seconds": 397.84,
      "duration_seconds": 13.09,
      "text": "Cut right down on sugary drinks and keep water with you. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 399.51,
      "end_seconds": 403.82,
      "duration_seconds": 4.31,
      "text": "Okay, so I know what to watch for."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 404.57,
      "end_seconds": 411.96,
      "duration_seconds": 7.39,
      "text": "Book a review in two weeks. Right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 413.47,
      "end_seconds": 416.05,
      "duration_seconds": 2.58,
      "text": "Thank you, that's helpful."
    }
  ]
}