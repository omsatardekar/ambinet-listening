  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.31,
      "end_seconds": 2.93,
      "duration_seconds": 1.62,
      "text": "Welcome. Make yourself comfortable."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 3.59,
      "end_seconds": 6.46,
      "duration_seconds": 2.87,
      "text": "Afternoon, is this seat fine?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 7.52,
      "end_seconds": 10.06,
      "duration_seconds": 2.54,
      "text": "Start wherever you like, I'm listening."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 10.82,
      "end_seconds": 22.26,
      "duration_seconds": 11.44,
      "text": "so the thing is, I've got bright red blood on the paper i wasn't sure whether to come in at all, to be honest"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 24.33,
      "end_seconds": 28.07,
      "duration_seconds": 3.74,
      "text": "Right, can you tell me when it first started?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 29.64,
      "end_seconds": 31.91,
      "duration_seconds": 2.27,
      "text": "about... well, ten days"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 32.59,
      "end_seconds": 34.73,
      "duration_seconds": 2.14,
      "text": "Have you noticed any triggers?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 35.43,
      "end_seconds": 38.91,
      "duration_seconds": 3.48,
      "text": "Yes, straining. That makes it worse."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 49.7,
      "end_seconds": 55.16,
      "duration_seconds": 5.46,
      "text": "any dizziness, severe pain, black stools or change in bowel habit at all?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 57.09,
      "end_seconds": 59.88,
      "duration_seconds": 2.79,
      "text": "No, nothing to report there."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 61.02,
      "end_seconds": 64.43,
      "duration_seconds": 3.41,
      "text": "Any muscle or joint problems besides this?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 65.21,
      "end_seconds": 68.11,
      "duration_seconds": 2.9,
      "text": "no, um, joints are fine"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 69.89,
      "end_seconds": 73.14,
      "duration_seconds": 3.25,
      "text": "How about your heart, any problems like that?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 75.07,
      "end_seconds": 79.65,
      "duration_seconds": 4.58,
      "text": "my heart's been fine, as far as I know"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 80.91,
      "end_seconds": 83.52,
      "duration_seconds": 2.61,
      "text": "Do you take any regular medication?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 85.26,
      "end_seconds": 86.93,
      "duration_seconds": 1.67,
      "text": "Nothing regular, no."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 88.31,
      "end_seconds": 92.37,
      "duration_seconds": 4.06,
      "text": "are there any allergies I should be aware of?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 92.97,
      "end_seconds": 98.85,
      "duration_seconds": 5.88,
      "text": "Sorry, what was I saying, yes, kiwi. I get hives."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 100.9,
      "end_seconds": 104.76,
      "duration_seconds": 3.86,
      "text": "Any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 105.53,
      "end_seconds": 107.71,
      "duration_seconds": 2.18,
      "text": "No, nothing at all."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 109.62,
      "end_seconds": 110.84,
      "duration_seconds": 1.22,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 112.57,
      "end_seconds": 114.59,
      "duration_seconds": 2.02,
      "text": "No, uh, never."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 122.16,
      "end_seconds": 123.72,
      "duration_seconds": 1.56,
      "text": "who lives with you?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 125.38,
      "end_seconds": 127.96,
      "duration_seconds": 2.58,
      "text": "My partner and our baby."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 129.62,
      "end_seconds": 131.39,
      "duration_seconds": 1.77,
      "text": "how are your meals?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 132.87,
      "end_seconds": 136.67,
      "duration_seconds": 3.8,
      "text": "I grab fast food at lunch most days"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 137.96,
      "end_seconds": 140.98,
      "duration_seconds": 3.02,
      "text": "I'll note down your vital signs first."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 154.31,
      "end_seconds": 156.84,
      "duration_seconds": 2.53,
      "text": "Okay, this won't take long..."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 170.0,
      "end_seconds": 177.56,
      "duration_seconds": 7.56,
      "text": "Okay: respiratory rate 17, saturation 98 percent. And pressure 114 over 73, pulse is 84 beats a minute."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 182.11,
      "end_seconds": 183.7,
      "duration_seconds": 1.59,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 188.5,
      "end_seconds": 192.4,
      "duration_seconds": 3.9,
      "text": "Don't worry, we'll discuss it in a second."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 194.5,
      "end_seconds": 197.75,
      "duration_seconds": 3.25,
      "text": "okay, time for me to examine you"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 198.93,
      "end_seconds": 201.1,
      "duration_seconds": 2.17,
      "text": "Raise your arm for me."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 211.45,
      "end_seconds": 219.81,
      "duration_seconds": 8.36,
      "text": "There is a small soft lump at the edge of the anus and no tear that I can see."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 222.63,
      "end_seconds": 224.56,
      "duration_seconds": 1.93,
      "text": "All finished, thank you."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 241.84,
      "end_seconds": 252.73,
      "duration_seconds": 10.89,
      "text": "taking everything into account, it's hard to say. Haemorrhoids is one possibility and a polyp in the bowel another, and I'd rather not commit yet"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 271.4,
      "end_seconds": 297.51,
      "duration_seconds": 26.11,
      "text": "I think a camera test of the bowel makes sense here, for rectal bleeding. What I'm giving you is haemorrhoid cream, twice a day, for a week. That should help with haemorrhoids. Fibre, plenty of water, and don't sit on the toilet for long. I think the colorectal clinic should see you too."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 301.59,
      "end_seconds": 304.39,
      "duration_seconds": 2.8,
      "text": "Sure, where do I go?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 309.8,
      "end_seconds": 319.09,
      "duration_seconds": 9.29,
      "text": "A blood count is something we might do if this doesn't improve in two weeks. Come back after the camera test."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 319.59,
      "end_seconds": 321.54,
      "duration_seconds": 1.95,
      "text": "okay, I'll arrange it"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 322.97,
      "end_seconds": 327.4,
      "duration_seconds": 4.43,
      "text": "That's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 328.2,
      "end_seconds": 331.68,
      "duration_seconds": 3.48,
      "text": "Good, thanks, I'll see you then."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 332.78,
      "end_seconds": 334.1,
      "duration_seconds": 1.32,
      "text": "goodbye for now"
    }
  ]
