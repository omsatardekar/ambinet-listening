{
  "schema_version": "1.0",
  "encounter_id": "20214",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.67,
      "end_seconds": 3.75,
      "duration_seconds": 3.08,
      "text": "Good morning. I've just opened your notes."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 5.55,
      "end_seconds": 10.47,
      "duration_seconds": 4.92,
      "text": "Hi doctor, I got here as fast as I could."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 11.95,
      "end_seconds": 13.74,
      "duration_seconds": 1.79,
      "text": "Where shall we begin?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 15.67,
      "end_seconds": 20.03,
      "duration_seconds": 4.36,
      "text": "I've been passing out for a couple of minutes."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 21.4,
      "end_seconds": 24.8,
      "duration_seconds": 3.4,
      "text": "Can you tell me when it first started?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 25.76,
      "end_seconds": 28.35,
      "duration_seconds": 2.59,
      "text": "For five days, I'd say."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 30.11,
      "end_seconds": 33.43,
      "duration_seconds": 3.32,
      "text": "How much trouble does it give you?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 35.49,
      "end_seconds": 36.84,
      "duration_seconds": 1.35,
      "text": "I'd say moderate."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 37.77,
      "end_seconds": 41.16,
      "duration_seconds": 3.39,
      "text": "Has there been a headache afterwards too?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 43.02,
      "end_seconds": 49.77,
      "duration_seconds": 6.75,
      "text": "Mm, uh, yes. I've also had a bitten tongue, for about two weeks."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 50.49,
      "end_seconds": 57.8,
      "duration_seconds": 7.31,
      "text": "Have you been passing out for a couple of minutes at any time before this?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 59.25,
      "end_seconds": 64.1,
      "duration_seconds": 4.85,
      "text": "I had a similar thing last winter. It went away."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 72.85,
      "end_seconds": 81.62,
      "duration_seconds": 8.77,
      "text": "Has anything ever caused you a reaction? I mean any allergies. It helps to be thorough at this stage."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 82.58,
      "end_seconds": 86.42,
      "duration_seconds": 3.84,
      "text": "I don't think I have any, no."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 103.73,
      "end_seconds": 106.39,
      "duration_seconds": 2.66,
      "text": "Do you have any chronic illnesses?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 108.43,
      "end_seconds": 113.93,
      "duration_seconds": 5.5,
      "text": "I've had high blood pressure for about a year now."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 114.82,
      "end_seconds": 117.65,
      "duration_seconds": 2.83,
      "text": "Now some background about your lifestyle."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 118.23,
      "end_seconds": 128.15,
      "duration_seconds": 9.92,
      "text": "I'm a hairdresser, on my feet all day. I swim twice a week. I live with my elderly mother."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 130.22,
      "end_seconds": 133.01,
      "duration_seconds": 2.79,
      "text": "What's on your current medicine list?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 135.01,
      "end_seconds": 141.46,
      "duration_seconds": 6.45,
      "text": "I take metoprolol, 50 milligrams, maybe, twice a day for my pressure."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 142.49,
      "end_seconds": 146.38,
      "duration_seconds": 3.89,
      "text": "Have you got the box or the prescription on you?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 147.24,
      "end_seconds": 149.24,
      "duration_seconds": 2.0,
      "text": "No, it's at home."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 151.01,
      "end_seconds": 154.7,
      "duration_seconds": 3.69,
      "text": "And what about vomiting, weakness or head injury?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 155.6,
      "end_seconds": 159.61,
      "duration_seconds": 4.01,
      "text": "No, no vomiting, weakness or head injury."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 160.24,
      "end_seconds": 163.14,
      "duration_seconds": 2.9,
      "text": "Have you had any fever or palpitations?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 165.95,
      "end_seconds": 169.82,
      "duration_seconds": 3.87,
      "text": "No fever or palpitations, none of it."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 171.2,
      "end_seconds": 173.95,
      "duration_seconds": 2.75,
      "text": "Anything different when you pass water?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 175.33,
      "end_seconds": 176.78,
      "duration_seconds": 1.45,
      "text": "No changes there."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 177.43,
      "end_seconds": 180.35,
      "duration_seconds": 2.92,
      "text": "Has your heart given you any trouble?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 181.8,
      "end_seconds": 185.96,
      "duration_seconds": 4.16,
      "text": "My heart's been fine, as far as I know."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 203.43,
      "end_seconds": 211.05,
      "duration_seconds": 7.62,
      "text": "Okay, so the vitals from earlier. Pulse 86, temperature 36.6, respiratory rate 15, BP is 118 over 77."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 211.66,
      "end_seconds": 212.56,
      "duration_seconds": 0.9,
      "text": "Okay, noted."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 213.78,
      "end_seconds": 216.21,
      "duration_seconds": 2.43,
      "text": "Let's move on to the examination."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 217.24,
      "end_seconds": 219.3,
      "duration_seconds": 2.06,
      "text": "Hold that for a second."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 229.86,
      "end_seconds": 235.38,
      "duration_seconds": 5.52,
      "text": "The neurological examination is normal, with steady walking and equal power."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 239.99,
      "end_seconds": 252.59,
      "duration_seconds": 12.6,
      "text": "Okay, that's enough for me. Let me tell you where I've got to. I can't pin this down yet. We're looking at a possible first seizure or a faint with some jerking."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 254.62,
      "end_seconds": 258.02,
      "duration_seconds": 3.4,
      "text": "I've already done an ECG, it's ready for you."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 259.44,
      "end_seconds": 269.83,
      "duration_seconds": 10.39,
      "text": "Thanks, that helps. I'm sending you for a brain scan because of possible seizure. It's a routine test and it'll give us a much clearer picture."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 271.06,
      "end_seconds": 273.19,
      "duration_seconds": 2.13,
      "text": "That's fine with me."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 273.95,
      "end_seconds": 296.55,
      "duration_seconds": 22.6,
      "text": "No driving until you have been seen in the clinic, and avoid swimming or climbing alone. I'll also refer you to the epilepsy clinic. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose. I'd like you back after the scan."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 297.68,
      "end_seconds": 298.38,
      "duration_seconds": 0.7,
      "text": "Sure."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 299.29,
      "end_seconds": 302.58,
      "duration_seconds": 3.29,
      "text": "I think we're done unless you have questions."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 304.28,
      "end_seconds": 307.77,
      "duration_seconds": 3.49,
      "text": "Good, thanks, I'll see you then."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 309.38,
      "end_seconds": 310.7,
      "duration_seconds": 1.32,
      "text": "Look after yourself."
    }
  ]
}