{
  "schema_version": "1.0",
  "encounter_id": "20241",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.57,
      "end_seconds": 6.45,
      "duration_seconds": 5.88,
      "text": "Okay, so hi, doctor, I came as soon as they called me."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 11.27,
      "end_seconds": 15.8,
      "duration_seconds": 4.53,
      "text": "yes, come in and sit down what brings you here today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 17.68,
      "end_seconds": 25.56,
      "duration_seconds": 7.88,
      "text": "Honestly, it's pain in my right shoulder, and my family pushed me to come."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 26.43,
      "end_seconds": 29.29,
      "duration_seconds": 2.86,
      "text": "let me quickly check your readings"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 42.38,
      "end_seconds": 44.48,
      "duration_seconds": 2.1,
      "text": "Okay, this won't take long..."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 65.44,
      "end_seconds": 76.55,
      "duration_seconds": 11.11,
      "text": "Okay: temperature is 36.7 degrees, blood pressure 111 over 74, oxygen saturation is 97 percent, pulse is 72 beats a minute."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 92.08,
      "end_seconds": 98.93,
      "duration_seconds": 6.85,
      "text": "Okay, did it come on recently? I'm asking so that that we don't miss anything."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 99.69,
      "end_seconds": 101.94,
      "duration_seconds": 2.25,
      "text": "Probably three weeks. Yeah."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 102.29,
      "end_seconds": 108.53,
      "duration_seconds": 6.24,
      "text": "Right, right. Okay, give me more detail on it, whatever comes to mind."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 109.2,
      "end_seconds": 116.47,
      "duration_seconds": 7.27,
      "text": "I'd say severe. Honestly, all the time. I've also had difficulty combing my hair."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 134.03,
      "end_seconds": 136.51,
      "duration_seconds": 2.48,
      "text": "and what about swelling or numbness?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 140.28,
      "end_seconds": 142.75,
      "duration_seconds": 2.47,
      "text": "No, I'd have said so."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 143.5,
      "end_seconds": 147.57,
      "duration_seconds": 4.07,
      "text": "have you had chest pain, by any chance?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 149.65,
      "end_seconds": 151.63,
      "duration_seconds": 1.98,
      "text": "No chest pain, thankfully."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 152.01,
      "end_seconds": 156.15,
      "duration_seconds": 4.14,
      "text": "Right, right. So, any trouble with the the waterworks?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 158.13,
      "end_seconds": 159.92,
      "duration_seconds": 1.79,
      "text": "Nothing there, no."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 161.85,
      "end_seconds": 164.97,
      "duration_seconds": 3.12,
      "text": "Any health conditions I should have on record?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 166.04,
      "end_seconds": 168.41,
      "duration_seconds": 2.37,
      "text": "I have high blood pressure."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 181.23,
      "end_seconds": 184.27,
      "duration_seconds": 3.04,
      "text": "Are there any illnesses in your family?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 186.07,
      "end_seconds": 188.54,
      "duration_seconds": 2.47,
      "text": "My uncle has high cholesterol."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 189.19,
      "end_seconds": 193.11,
      "duration_seconds": 3.92,
      "text": "which medicines do you take at the moment?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 194.77,
      "end_seconds": 202.65,
      "duration_seconds": 7.88,
      "text": "I take ramipril, 5 milligrams, every morning for my blood pressure. Diclofenac gel, twice a day"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 204.27,
      "end_seconds": 207.82,
      "duration_seconds": 3.55,
      "text": "right, a few questions about your lifestyle now"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 209.44,
      "end_seconds": 223.75,
      "duration_seconds": 14.31,
      "text": "No, I've never smoked in my life. I swim twice a week. I work in accounts at a hospital. I live with my elderly mother."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 224.76,
      "end_seconds": 228.97,
      "duration_seconds": 4.21,
      "text": "Are there any allergies I should be aware of?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 230.97,
      "end_seconds": 232.46,
      "duration_seconds": 1.49,
      "text": "No known allergies."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 233.53,
      "end_seconds": 236.1,
      "duration_seconds": 2.57,
      "text": "Let's move on to the examination."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 237.34,
      "end_seconds": 239.43,
      "duration_seconds": 2.09,
      "text": "tell me if that's sore"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 256.54,
      "end_seconds": 268.51,
      "duration_seconds": 11.97,
      "text": "There is pain when you lift the arm out to the side between about sixty and one hundred and twenty degrees, and the grip strength is normal."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 273.35,
      "end_seconds": 283.46,
      "duration_seconds": 10.11,
      "text": "You can relax now. From what you've told me and what I found, this is probably a rotator cuff tendon problem."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 284.74,
      "end_seconds": 288.25,
      "duration_seconds": 3.51,
      "text": "I'm scared it's something bad. Is it?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 289.87,
      "end_seconds": 300.32,
      "duration_seconds": 10.45,
      "text": "I understand the worry. At the moment I'd say it's a rotator cuff tendon problem, and we'll watch how it goes"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 318.38,
      "end_seconds": 325.3,
      "duration_seconds": 6.92,
      "text": "For now, no new medicines or tests are needed. That's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 326.47,
      "end_seconds": 330.06,
      "duration_seconds": 3.59,
      "text": "yeah, good, thanks, I'll see you then"
    }
  ]
}