{
  "schema_version": "1.0",
  "encounter_id": "20463",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.02,
      "end_seconds": 4.86,
      "duration_seconds": 3.84,
      "text": "Hi, is it okay to come in now?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.62,
      "end_seconds": 9.36,
      "duration_seconds": 3.74,
      "text": "Yes, have a seat. Tell me what's going on."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 11.42,
      "end_seconds": 27.75,
      "duration_seconds": 16.33,
      "text": "It's some chest discomfort when I climb stairs. I thought I'd wait, but it hasn't gone. It's the not knowing that gets to me. I took the morning off to come in today."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 28.84,
      "end_seconds": 31.97,
      "duration_seconds": 3.13,
      "text": "Has this been going on for long?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 33.01,
      "end_seconds": 34.99,
      "duration_seconds": 1.98,
      "text": "Probably two months. Yeah."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 36.44,
      "end_seconds": 45.0,
      "duration_seconds": 8.56,
      "text": "Can you describe it a bit more for me? How strong it is, what the pattern is, what helps."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 46.95,
      "end_seconds": 51.51,
      "duration_seconds": 4.56,
      "text": "I'd say moderate. Yes, stairs. That makes it worse."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 52.49,
      "end_seconds": 55.47,
      "duration_seconds": 2.98,
      "text": "Has there been indigestion after tablets too?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 56.09,
      "end_seconds": 66.46,
      "duration_seconds": 10.37,
      "text": "Yes, for two years. As for indigestion after tablets, yes, tablets on an empty stomach. That makes it worse."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 67.54,
      "end_seconds": 71.06,
      "duration_seconds": 3.52,
      "text": "So, I'll note down your vital signs first."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 79.71,
      "end_seconds": 83.27,
      "duration_seconds": 3.56,
      "text": "Alright, that's it, just a little longer..."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 99.2,
      "end_seconds": 103.75,
      "duration_seconds": 4.55,
      "text": "Okay: pulse 74, pressure 122 over 71, saturation 99 percent."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 105.56,
      "end_seconds": 110.44,
      "duration_seconds": 4.88,
      "text": "I'd like to check you over now, if that's alright."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 111.91,
      "end_seconds": 114.41,
      "duration_seconds": 2.5,
      "text": "I'll listen to your chest now."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 129.83,
      "end_seconds": 133.34,
      "duration_seconds": 3.51,
      "text": "Heart sounds are normal and your chest is clear."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 137.37,
      "end_seconds": 139.72,
      "duration_seconds": 2.35,
      "text": "You can sit up now."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 150.33,
      "end_seconds": 152.14,
      "duration_seconds": 1.81,
      "text": "Any sign of palpitations?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 152.8,
      "end_seconds": 154.53,
      "duration_seconds": 1.73,
      "text": "No, no palpitations."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 156.38,
      "end_seconds": 162.36,
      "duration_seconds": 5.98,
      "text": "Did you get fainting, pain at rest or blood in the urine?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 165.66,
      "end_seconds": 168.32,
      "duration_seconds": 2.66,
      "text": "No, none that I've noticed."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 169.7,
      "end_seconds": 172.84,
      "duration_seconds": 3.14,
      "text": "Right, any breathing difficulties apart from this?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 173.37,
      "end_seconds": 175.3,
      "duration_seconds": 1.93,
      "text": "No problems with breathing."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 177.23,
      "end_seconds": 179.11,
      "duration_seconds": 1.88,
      "text": "Okay, neurologically, anything strange?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 180.57,
      "end_seconds": 182.24,
      "duration_seconds": 1.67,
      "text": "Nothing odd there."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 183.51,
      "end_seconds": 188.56,
      "duration_seconds": 5.05,
      "text": "Tell me your medicines, please. Just so I get the full picture."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 193.6,
      "end_seconds": 202.08,
      "duration_seconds": 8.48,
      "text": "I take metoprolol, 50 milligrams, twice a day. I've been reading about it online and it worried me."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 210.22,
      "end_seconds": 213.81,
      "duration_seconds": 3.59,
      "text": "Has anyone in your family had anything serious?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 215.56,
      "end_seconds": 218.26,
      "duration_seconds": 2.7,
      "text": "My father had bowel cancer."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 219.64,
      "end_seconds": 221.64,
      "duration_seconds": 2.0,
      "text": "What about your medical history?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 222.37,
      "end_seconds": 225.62,
      "duration_seconds": 3.25,
      "text": "Heart disease, for nearly five years."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 226.8,
      "end_seconds": 232.33,
      "duration_seconds": 5.53,
      "text": "Ah. Okay, are you allergic to anything? Any allergies to medicines or foods?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 233.15,
      "end_seconds": 237.58,
      "duration_seconds": 4.43,
      "text": "I'm allergic to erythromycin, I get bad stomach cramps."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 248.9,
      "end_seconds": 251.4,
      "duration_seconds": 2.5,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 252.45,
      "end_seconds": 254.47,
      "duration_seconds": 2.02,
      "text": "No, not at all."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 256.27,
      "end_seconds": 257.47,
      "duration_seconds": 1.2,
      "text": "Do you smoke?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 258.81,
      "end_seconds": 262.7,
      "duration_seconds": 3.89,
      "text": "No, I've never smoked in my life."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 264.68,
      "end_seconds": 266.98,
      "duration_seconds": 2.3,
      "text": "Alright, do you drink alcohol?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 267.53,
      "end_seconds": 273.08,
      "duration_seconds": 5.55,
      "text": "I used to drink heavily but I stopped four years ago."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 274.3,
      "end_seconds": 276.05,
      "duration_seconds": 1.75,
      "text": "How are your meals?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 276.95,
      "end_seconds": 280.7,
      "duration_seconds": 3.75,
      "text": "I grab fast food at lunch most days."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 282.13,
      "end_seconds": 284.11,
      "duration_seconds": 1.98,
      "text": "Is there someone at home?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 285.63,
      "end_seconds": 289.65,
      "duration_seconds": 4.02,
      "text": "My husband and I live above the shop."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 291.66,
      "end_seconds": 298.93,
      "duration_seconds": 7.27,
      "text": "Having listened and examined, this is probably stable coronary disease on antiplatelet treatment, with minor bleeding."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 303.7,
      "end_seconds": 306.83,
      "duration_seconds": 3.13,
      "text": "I'm scared it's something bad. Is it?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 308.67,
      "end_seconds": 345.84,
      "duration_seconds": 37.17,
      "text": "Nothing I've seen today points to an emergency. It looks like stable coronary disease on antiplatelet treatment, with minor bleeding, but I'd like to confirm. I want a lipid profile done, that's for cardiovascular risk. Let's use pantoprazole, 40 milligrams, before breakfast, long term. That's for stomach protection. Take your blood-thinning tablets after food and do not stop them on your own. Please take the tablets with food so they don't upset your stomach."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 346.12,
      "end_seconds": 351.8,
      "duration_seconds": 5.68,
      "text": "Right, right. We'll catch up in six weeks. That's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 352.74,
      "end_seconds": 356.32,
      "duration_seconds": 3.58,
      "text": "Alright, you know, thanks, take care."
    }
  ]
}