{
  "schema_version": "1.0",
  "encounter_id": "20179",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.62,
      "end_seconds": 2.78,
      "duration_seconds": 2.16,
      "text": "Afternoon, thanks for coming in."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "FAMILY_MEMBER",
      "start_seconds": 4.27,
      "end_seconds": 9.49,
      "duration_seconds": 5.22,
      "text": "Hello, doctor. I'm here with them in case I can help."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 10.22,
      "end_seconds": 12.79,
      "duration_seconds": 2.57,
      "text": "What do you need help with?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 13.38,
      "end_seconds": 20.76,
      "duration_seconds": 7.38,
      "text": "sorry, what was I saying, so the thing is, I've got a high temperature"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 21.38,
      "end_seconds": 23.53,
      "duration_seconds": 2.15,
      "text": "Did it come on recently?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 24.46,
      "end_seconds": 35.07,
      "duration_seconds": 10.61,
      "text": "Hm. It was either the end of last month or earlier than that. I couldn't tell you the date."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 36.42,
      "end_seconds": 39.17,
      "duration_seconds": 2.75,
      "text": "How strong would you say it is?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 41.02,
      "end_seconds": 42.84,
      "duration_seconds": 1.82,
      "text": "I'd call it mild."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 43.86,
      "end_seconds": 45.49,
      "duration_seconds": 1.63,
      "text": "Does anything help it?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 47.04,
      "end_seconds": 50.65,
      "duration_seconds": 3.61,
      "text": "I, I get some relief from paracetamol"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 51.57,
      "end_seconds": 54.7,
      "duration_seconds": 3.13,
      "text": "Is it it constant or in episodes?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 56.57,
      "end_seconds": 60.4,
      "duration_seconds": 3.83,
      "text": "It's a couple of times a week."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 61.34,
      "end_seconds": 68.61,
      "duration_seconds": 7.27,
      "text": "And the other thing I wanted to mention is that I can't really—"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "FAMILY_MEMBER",
      "start_seconds": 68.71,
      "end_seconds": 73.8,
      "duration_seconds": 5.09,
      "text": "Tell the doctor about the other thing, that's what worries me."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 74.9,
      "end_seconds": 81.2,
      "duration_seconds": 6.3,
      "text": "I was getting to that! Actually, I've also been feeling short of breath."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 82.73,
      "end_seconds": 85.92,
      "duration_seconds": 3.19,
      "text": "Okay, have you had any chest pain?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 87.46,
      "end_seconds": 89.66,
      "duration_seconds": 2.2,
      "text": "Definitely no chest pain."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 93.61,
      "end_seconds": 97.9,
      "duration_seconds": 4.29,
      "text": "Have you had any vomiting, leg swelling or confusion?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 99.21,
      "end_seconds": 113.24,
      "duration_seconds": 14.03,
      "text": "no, no vomiting, no leg swelling, no confusion i did have a dry cough at one point, but that went away on its own"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 114.45,
      "end_seconds": 115.85,
      "duration_seconds": 1.4,
      "text": "Nothing like diarrhoea?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 117.72,
      "end_seconds": 119.12,
      "duration_seconds": 1.4,
      "text": "Definitely no diarrhoea."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "FAMILY_MEMBER",
      "start_seconds": 121.16,
      "end_seconds": 127.18,
      "duration_seconds": 6.02,
      "text": "Actually, um, doctor, I did notice diarrhoea. He doesn't always say."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 128.97,
      "end_seconds": 135.73,
      "duration_seconds": 6.76,
      "text": "no, um, I don't think I did. Maybe a little, I'm not sure"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 140.99,
      "end_seconds": 148.16,
      "duration_seconds": 7.17,
      "text": "Alright, I'll note both what you've said and what you've noticed. Alright, anything unusual with passing urine?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 150.13,
      "end_seconds": 151.62,
      "duration_seconds": 1.49,
      "text": "Nothing there, no."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 153.54,
      "end_seconds": 158.73,
      "duration_seconds": 5.19,
      "text": "Tell me about your routine, work, habits, that sort of thing."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 160.8,
      "end_seconds": 172.11,
      "duration_seconds": 11.31,
      "text": "I've never touched a cigarette. I only drink at family occasions. I retired from the post office two years ago."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 174.1,
      "end_seconds": 178.96,
      "duration_seconds": 4.86,
      "text": "Can you list what you take, tablets, creams or inhalers?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 179.51,
      "end_seconds": 189.05,
      "duration_seconds": 9.54,
      "text": "I'm on glimepiride, 2 milligrams, before breakfast. It's telmisartan, 40 milligrams, once a day for my pressure."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "FAMILY_MEMBER",
      "start_seconds": 190.17,
      "end_seconds": 199.16,
      "duration_seconds": 8.99,
      "text": "Doctor, I think the last prescription for the telmisartan was 20 milligrams. We changed it at the last visit."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 199.73,
      "end_seconds": 204.19,
      "duration_seconds": 4.46,
      "text": "Hm, that's different. Is the latest prescription anywhere near you?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 208.59,
      "end_seconds": 220.55,
      "duration_seconds": 11.96,
      "text": "No, I left it at home. Thyroxine, 75 micrograms, every morning for my thyroid. Sorry, I know I'm rambling a bit."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 221.09,
      "end_seconds": 221.79,
      "duration_seconds": 0.7,
      "text": "sure"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 223.76,
      "end_seconds": 231.59,
      "duration_seconds": 7.83,
      "text": "It's a... um, I can't remember what it's called. It's a a round yellow one."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 232.94,
      "end_seconds": 235.48,
      "duration_seconds": 2.54,
      "text": "Do you remember what it's for?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 237.46,
      "end_seconds": 247.64,
      "duration_seconds": 10.18,
      "text": "For the heart rhythm, I believe. My son sets them out for me, I just take what I'm given."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 249.21,
      "end_seconds": 252.1,
      "duration_seconds": 2.89,
      "text": "have you had any surgical procedures?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 253.51,
      "end_seconds": 257.45,
      "duration_seconds": 3.94,
      "text": "I had a varicose vein procedure last year"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 259.21,
      "end_seconds": 262.35,
      "duration_seconds": 3.14,
      "text": "Has anyone in your family had anything serious?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 264.02,
      "end_seconds": 268.71,
      "duration_seconds": 4.69,
      "text": "Right, my aunt has rheumatoid arthritis. My grandmother had dementia."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 269.68,
      "end_seconds": 273.19,
      "duration_seconds": 3.51,
      "text": "Anything in your past medical history I should know?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 274.38,
      "end_seconds": 275.78,
      "duration_seconds": 1.4,
      "text": "I have diabetes."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 279.86,
      "end_seconds": 280.56,
      "duration_seconds": 0.7,
      "text": "sure"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 282.37,
      "end_seconds": 296.23,
      "duration_seconds": 13.86,
      "text": "I've had high blood pressure, yes. I've had an underactive thyroid for about ten years now. I've, I've had an irregular heartbeat for two years now."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 297.69,
      "end_seconds": 310.0,
      "duration_seconds": 12.31,
      "text": "mm, okay right, so diabetes and high blood pressure are already on your record we'll keep that in mind today are there any allergies I should be aware of?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 311.94,
      "end_seconds": 323.9,
      "duration_seconds": 11.96,
      "text": "hmm, there was some antibiotic, I was told I was allergic but I couldn't tell you what it was called or what it did"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 328.38,
      "end_seconds": 331.15,
      "duration_seconds": 2.77,
      "text": "let's start with the basic checks"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 344.11,
      "end_seconds": 346.07,
      "duration_seconds": 1.96,
      "text": "Nearly done with the readings..."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 356.32,
      "end_seconds": 373.15,
      "duration_seconds": 16.83,
      "text": "Okay: temperature is 37.5 degrees, height 164 centimetres. And BMI works out to 23.4, oxygen saturation is 92 percent, BP is 118 over 82, weight 63 kilos, heart rate 98, respiratory rate 22."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 375.52,
      "end_seconds": 379.51,
      "duration_seconds": 3.99,
      "text": "Let me look at the area, I'll be gentle."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 380.64,
      "end_seconds": 381.9,
      "duration_seconds": 1.26,
      "text": "Nearly finished here."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 396.08,
      "end_seconds": 404.68,
      "duration_seconds": 8.6,
      "text": "your chest is clear apart from a few crackles at the right base and your oxygen level is a bit low"
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 414.66,
      "end_seconds": 416.33,
      "duration_seconds": 1.67,
      "text": "Fine by me."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 422.16,
      "end_seconds": 432.77,
      "duration_seconds": 10.61,
      "text": "Thank you, you can get dressed. Let me repeat that back to make sure. You've had a high temperature, mild, and no confusion or chest pain."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 434.59,
      "end_seconds": 435.29,
      "duration_seconds": 0.7,
      "text": "Exactly."
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 448.58,
      "end_seconds": 453.3,
      "duration_seconds": 4.72,
      "text": "Let's book a viral swab to look into fever and cough."
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_4",
      "role": "CLINICAL_STAFF",
      "start_seconds": 454.37,
      "end_seconds": 458.43,
      "duration_seconds": 4.06,
      "text": "We have a slot Wednesday at 9 am, if that works."
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 460.18,
      "end_seconds": 462.18,
      "duration_seconds": 2.0,
      "text": "Okay, I'll be there."
    },
    {
      "segment_id": "SEG0059",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 466.97,
      "end_seconds": 472.3,
      "duration_seconds": 5.33,
      "text": "I'll request a chest X-ray, it'll help with low oxygen and crackles"
    },
    {
      "segment_id": "SEG0060",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 474.12,
      "end_seconds": 475.64,
      "duration_seconds": 1.52,
      "text": "That makes sense."
    },
    {
      "segment_id": "SEG0061",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 476.45,
      "end_seconds": 501.13,
      "duration_seconds": 24.68,
      "text": "Rest, keep your fluids up and lie on your tummy or side to help your breathing. Avoid taking any extra painkillers on top of what I'm prescribing without checking with us. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0062",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 506.42,
      "end_seconds": 507.88,
      "duration_seconds": 1.46,
      "text": "I, I understand."
    },
    {
      "segment_id": "SEG0063",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 509.82,
      "end_seconds": 519.63,
      "duration_seconds": 9.81,
      "text": "The thing that would worry me is if you become more breathless or confused. If that happens, go to emergency."
    },
    {
      "segment_id": "SEG0064",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 521.47,
      "end_seconds": 523.16,
      "duration_seconds": 1.69,
      "text": "alright, I follow"
    },
    {
      "segment_id": "SEG0065",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 525.19,
      "end_seconds": 531.24,
      "duration_seconds": 6.05,
      "text": "see me again after the chest X-ray have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0066",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 532.63,
      "end_seconds": 535.78,
      "duration_seconds": 3.15,
      "text": "I think I understand everything thanks"
    }
  ]
}