{
  "schema_version": "1.0",
  "encounter_id": "20398",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.27,
      "end_seconds": 3.46,
      "duration_seconds": 2.19,
      "text": "hi, sit anywhere you like"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 5.54,
      "end_seconds": 8.29,
      "duration_seconds": 2.75,
      "text": "morning doctor sorry about the rush"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 10.12,
      "end_seconds": 12.89,
      "duration_seconds": 2.77,
      "text": "how are things, what's been happening?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 17.95,
      "end_seconds": 23.54,
      "duration_seconds": 5.59,
      "text": "honestly it's the room spinning and my family pushed me to come"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 25.15,
      "end_seconds": 26.39,
      "duration_seconds": 1.24,
      "text": "since when exactly?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 27.45,
      "end_seconds": 31.1,
      "duration_seconds": 3.65,
      "text": "Since last Tuesday, that's when it began."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 32.64,
      "end_seconds": 42.15,
      "duration_seconds": 9.51,
      "text": "alright, can you describe it a bit more for me? How strong it is, what the pattern is, what helps"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 43.86,
      "end_seconds": 60.52,
      "duration_seconds": 16.66,
      "text": "Only lying still and it's not much. It comes and goes. About a five out of ten. Oh and a blocked feeling in my ear. And there's a recent cold as well two days now."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 62.35,
      "end_seconds": 65.36,
      "duration_seconds": 3.01,
      "text": "Would you say mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 67.26,
      "end_seconds": 70.21,
      "duration_seconds": 2.95,
      "text": "Pretty moderate if I'm being honest."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 71.95,
      "end_seconds": 77.63,
      "duration_seconds": 5.68,
      "text": "have you had the room spinning before, or is this the first time?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 81.97,
      "end_seconds": 87.17,
      "duration_seconds": 5.2,
      "text": "I had a similar thing last winter. It went away."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 89.38,
      "end_seconds": 93.71,
      "duration_seconds": 4.33,
      "text": "And what about weakness slurred speech or ringing in the ears?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 95.61,
      "end_seconds": 97.73,
      "duration_seconds": 2.12,
      "text": "Nope, nothing like that."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 98.69,
      "end_seconds": 102.51,
      "duration_seconds": 3.82,
      "text": "have you had any hearing loss or headache?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 103.32,
      "end_seconds": 107.36,
      "duration_seconds": 4.04,
      "text": "No hearing loss or headache, none of it."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 108.3,
      "end_seconds": 109.93,
      "duration_seconds": 1.63,
      "text": "how about double vision?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 111.65,
      "end_seconds": 113.65,
      "duration_seconds": 2.0,
      "text": "No double vision thankfully."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 114.86,
      "end_seconds": 116.9,
      "duration_seconds": 2.04,
      "text": "any trouble with the waterworks?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 118.63,
      "end_seconds": 119.98,
      "duration_seconds": 1.35,
      "text": "No changes there."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 121.39,
      "end_seconds": 125.16,
      "duration_seconds": 3.77,
      "text": "On the cardiac side, anything I should know?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 130.1,
      "end_seconds": 132.41,
      "duration_seconds": 2.31,
      "text": "no, that's been fine"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 133.63,
      "end_seconds": 134.92,
      "duration_seconds": 1.29,
      "text": "Do you smoke?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 136.42,
      "end_seconds": 139.83,
      "duration_seconds": 3.41,
      "text": "I quit smoking around ten years ago"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 141.15,
      "end_seconds": 142.88,
      "duration_seconds": 1.73,
      "text": "And alcohol, how much?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 147.73,
      "end_seconds": 151.56,
      "duration_seconds": 3.83,
      "text": "I'll have a glass of wine with dinner"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 152.1,
      "end_seconds": 153.53,
      "duration_seconds": 1.43,
      "text": "are you active?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 154.4,
      "end_seconds": 157.09,
      "duration_seconds": 2.69,
      "text": "I walk the dog every morning."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 157.83,
      "end_seconds": 161.72,
      "duration_seconds": 3.89,
      "text": "What does a a normal day of food look like?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 163.57,
      "end_seconds": 167.34,
      "duration_seconds": 3.77,
      "text": "Lots of rice, lentils and some fruit"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 169.3,
      "end_seconds": 171.73,
      "duration_seconds": 2.43,
      "text": "do you work outside the home?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 175.04,
      "end_seconds": 179.7,
      "duration_seconds": 4.66,
      "text": "I'm a hairdresser, on my feet all day"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 197.3,
      "end_seconds": 199.52,
      "duration_seconds": 2.22,
      "text": "let's run through your medicines"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 200.91,
      "end_seconds": 207.97,
      "duration_seconds": 7.06,
      "text": "Um, I'm on metoprolol, 50 milligrams, twice a day for my pressure."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 209.11,
      "end_seconds": 211.92,
      "duration_seconds": 2.81,
      "text": "how long have you been on it?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 213.7,
      "end_seconds": 223.9,
      "duration_seconds": 10.2,
      "text": "Nearly five years now. I take mirtazapine, 15 milligrams, at night. Though honestly, some days I forget to take it."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 225.81,
      "end_seconds": 228.17,
      "duration_seconds": 2.36,
      "text": "Have you got any known allergies?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 229.55,
      "end_seconds": 233.02,
      "duration_seconds": 3.47,
      "text": "I don't think I have any, no."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 234.83,
      "end_seconds": 237.67,
      "duration_seconds": 2.84,
      "text": "Do you have any chronic illnesses?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 239.03,
      "end_seconds": 251.49,
      "duration_seconds": 12.46,
      "text": "I've had high blood pressure for two years now i have depression i've been reading about it online and it worried me"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 253.28,
      "end_seconds": 259.98,
      "duration_seconds": 6.7,
      "text": "Right, so high blood pressure is already on your record. We'll keep that in mind today."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 268.17,
      "end_seconds": 271.3,
      "duration_seconds": 3.13,
      "text": "Time for your numbers, if that's okay."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 283.97,
      "end_seconds": 286.41,
      "duration_seconds": 2.44,
      "text": "Bear with me while this finishes..."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 296.08,
      "end_seconds": 306.8,
      "duration_seconds": 10.72,
      "text": "okay: heart rate 83 temperature is 37.0 degrees SpO2 98 percent on room air. And blood pressure 114 over 81 respiratory rate 16."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 309.25,
      "end_seconds": 312.98,
      "duration_seconds": 3.73,
      "text": "I'll examine you in a second make yourself comfortable"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 314.62,
      "end_seconds": 316.56,
      "duration_seconds": 1.94,
      "text": "Alright breathe out slowly."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 332.22,
      "end_seconds": 340.91,
      "duration_seconds": 8.69,
      "text": "I can see a fine jerking of the eyes to the left and your walking is a little unsteady."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 342.36,
      "end_seconds": 344.03,
      "duration_seconds": 1.67,
      "text": "Fine by me."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 346.15,
      "end_seconds": 349.11,
      "duration_seconds": 2.96,
      "text": "that's all I needed to check"
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 359.17,
      "end_seconds": 388.98,
      "duration_seconds": 29.81,
      "text": "from what you've told me and what I found, it fits best with an inner-ear balance problem such as vestibular neuritis. The reason I say that is that your story and and my examination fit together. We shouldn't forget a problem in the brain stem. Let me just check I've got this right. You've had the room spinning, since last Tuesday, and no headache or hearing loss"
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 389.78,
      "end_seconds": 390.48,
      "duration_seconds": 0.7,
      "text": "Exactly."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 392.22,
      "end_seconds": 396.28,
      "duration_seconds": 4.06,
      "text": "I'm sending you for a positional test because of vertigo"
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 397.45,
      "end_seconds": 401.88,
      "duration_seconds": 4.43,
      "text": "I can book that for Thursday at 3:30 pm"
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 403.04,
      "end_seconds": 406.33,
      "duration_seconds": 3.29,
      "text": "Thursday that that works for me."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 408.27,
      "end_seconds": 419.15,
      "duration_seconds": 10.88,
      "text": "I'm going to order blood tests for dizziness what I'm giving you is prochlorperazine 5 milligrams three times a day for three days it's for nausea and vertigo"
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 420.63,
      "end_seconds": 421.76,
      "duration_seconds": 1.13,
      "text": "mm alright"
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 423.12,
      "end_seconds": 442.7,
      "duration_seconds": 19.58,
      "text": "Start moving around gently as soon as you can, since resting too long slows recovery. One warning sign to remember: you get double vision, weakness or trouble speaking. In that case don't wait. I'd like you back in a week."
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 443.22,
      "end_seconds": 445.51,
      "duration_seconds": 2.29,
      "text": "Okay, I'll arrange it."
    },
    {
      "segment_id": "SEG0059",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 447.06,
      "end_seconds": 450.64,
      "duration_seconds": 3.58,
      "text": "anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0060",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 451.65,
      "end_seconds": 453.15,
      "duration_seconds": 1.5,
      "text": "that's clear, thanks"
    }
  ]
}