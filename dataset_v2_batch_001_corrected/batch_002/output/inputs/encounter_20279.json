  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 0.92,
      "end_seconds": 8.37,
      "duration_seconds": 7.45,
      "text": "Doctor, I've checked them in and done the preliminary measurements, I'll hand them over when you ask."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 9.3,
      "end_seconds": 14.18,
      "duration_seconds": 4.88,
      "text": "Thanks. Hello, come in, sit down. What brings you in today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 14.96,
      "end_seconds": 21.55,
      "duration_seconds": 6.59,
      "text": "ah, I wanted to get a cough that won't go away looked at"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 22.8,
      "end_seconds": 28.64,
      "duration_seconds": 5.84,
      "text": "Has this been going on for long? It helps to be thorough at this stage."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 29.22,
      "end_seconds": 34.59,
      "duration_seconds": 5.37,
      "text": "Let me think, ever since... since last weekend, really."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 35.45,
      "end_seconds": 38.3,
      "duration_seconds": 2.85,
      "text": "how much trouble does it give you?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 40.23,
      "end_seconds": 50.38,
      "duration_seconds": 10.15,
      "text": "Hmm you know it feels mild to me. Yeah there's a tight chest in the morning as well."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 51.07,
      "end_seconds": 53.72,
      "duration_seconds": 2.65,
      "text": "how much does it limit you?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 54.88,
      "end_seconds": 69.05,
      "duration_seconds": 14.17,
      "text": "Moderate, really. I've, I've also been getting breathless on the stairs. As for getting breathless on the stairs, honestly, once or twice a day."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 69.82,
      "end_seconds": 73.04,
      "duration_seconds": 3.22,
      "text": "right, any sign of coughing up blood?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 75.1,
      "end_seconds": 78.11,
      "duration_seconds": 3.01,
      "text": "no coughing up blood thankfully"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 79.65,
      "end_seconds": 84.84,
      "duration_seconds": 5.19,
      "text": "and what about leg swelling, fever, sharp chest pain or night sweats?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 86.06,
      "end_seconds": 91.29,
      "duration_seconds": 5.23,
      "text": "let me think no none of those at all"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 92.06,
      "end_seconds": 94.65,
      "duration_seconds": 2.59,
      "text": "right, is your mobility otherwise okay?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 95.5,
      "end_seconds": 98.4,
      "duration_seconds": 2.9,
      "text": "I, I move fine otherwise"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 99.65,
      "end_seconds": 101.58,
      "duration_seconds": 1.93,
      "text": "how active are you?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 103.26,
      "end_seconds": 107.26,
      "duration_seconds": 4.0,
      "text": "I hardly move around during the day"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 107.94,
      "end_seconds": 109.86,
      "duration_seconds": 1.92,
      "text": "how are your meals?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 111.3,
      "end_seconds": 115.37,
      "duration_seconds": 4.07,
      "text": "I grab fast food at lunch most days."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 131.85,
      "end_seconds": 134.36,
      "duration_seconds": 2.51,
      "text": "Have you been to theatre before?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 134.87,
      "end_seconds": 139.46,
      "duration_seconds": 4.59,
      "text": "Yeah, just a varicose vein procedure, last year."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 144.5,
      "end_seconds": 147.31,
      "duration_seconds": 2.81,
      "text": "Before we go further, any allergies?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 152.78,
      "end_seconds": 154.98,
      "duration_seconds": 2.2,
      "text": "No allergies at all."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 156.73,
      "end_seconds": 161.15,
      "duration_seconds": 4.42,
      "text": "tell me about any past illnesses or ongoing conditions"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 162.84,
      "end_seconds": 172.62,
      "duration_seconds": 9.78,
      "text": "mm I've had acid reflux for five years now i've had asthma for nearly five years now"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 174.2,
      "end_seconds": 177.26,
      "duration_seconds": 3.06,
      "text": "understood tell me your medicines, please"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 177.9,
      "end_seconds": 187.98,
      "duration_seconds": 10.08,
      "text": "Omeprazole. I take it 20 milligrams once a day. Right it's Seretide inhaler twice a day for my asthma"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 205.03,
      "end_seconds": 208.64,
      "duration_seconds": 3.61,
      "text": "What about your parents brothers or sisters any conditions?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 211.72,
      "end_seconds": 216.22,
      "duration_seconds": 4.5,
      "text": "hmm, my daughter has type 1 diabetes"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 217.97,
      "end_seconds": 233.71,
      "duration_seconds": 15.74,
      "text": "Okay so the vitals from earlier. Oxygen saturation is 99 percent pulse is 81 beats a minute height 178 centimetres respiratory rate 18 temperature is 36.9 degrees weight 67 kilos pressure 113 over 68 BMI works out to 21.1."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 235.04,
      "end_seconds": 235.74,
      "duration_seconds": 0.7,
      "text": "Thanks."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 238.05,
      "end_seconds": 241.1,
      "duration_seconds": 3.05,
      "text": "okay time for me to examine you"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 242.93,
      "end_seconds": 244.7,
      "duration_seconds": 1.77,
      "text": "let me feel here"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 262.46,
      "end_seconds": 266.7,
      "duration_seconds": 4.24,
      "text": "The chest is clear and your oxygen level is normal."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 270.24,
      "end_seconds": 273.19,
      "duration_seconds": 2.95,
      "text": "good, you can sit up again"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 288.77,
      "end_seconds": 307.28,
      "duration_seconds": 18.51,
      "text": "Putting it all together, my working impression is a lingering cough after a viral infection. That's my thinking for now, and it may change as we learn more. It could also be cough-variant asthma, so we'll keep that open. Let's get a breathing test, for breathlessness."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 308.13,
      "end_seconds": 330.02,
      "duration_seconds": 21.89,
      "text": "The treatment will be salbutamol inhaler, 100 micrograms, two puffs when needed, for two weeks. That's for wheeze and cough. The pharmacy will go through the details again when you pick it up. Honey and lemon in warm water can ease it, and and avoid smoky rooms."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 330.31,
      "end_seconds": 336.22,
      "duration_seconds": 5.91,
      "text": "ah come back in three weeks anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 337.51,
      "end_seconds": 340.84,
      "duration_seconds": 3.33,
      "text": "Alright, you know, thanks, take care."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 341.44,
      "end_seconds": 343.33,
      "duration_seconds": 1.89,
      "text": "have a good day"
    }
  ]
