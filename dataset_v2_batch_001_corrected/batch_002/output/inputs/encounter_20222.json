{
  "schema_version": "1.0",
  "encounter_id": "20222",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.13,
      "end_seconds": 4.55,
      "duration_seconds": 3.42,
      "text": "Hello, doctor. May I come in?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.24,
      "end_seconds": 9.46,
      "duration_seconds": 4.22,
      "text": "Okay, of course, leave it there. How can I help?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 11.25,
      "end_seconds": 16.45,
      "duration_seconds": 5.2,
      "text": "Hello, doctor, I came in with them, if that's okay."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 17.36,
      "end_seconds": 22.84,
      "duration_seconds": 5.48,
      "text": "It's a bloated tummy. I thought I'd wait, but it hasn't gone."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 24.44,
      "end_seconds": 27.79,
      "duration_seconds": 3.35,
      "text": "Can you tell me when it first started?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 28.8,
      "end_seconds": 32.87,
      "duration_seconds": 4.07,
      "text": "It's, It's been going on for four weeks."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 33.41,
      "end_seconds": 37.47,
      "duration_seconds": 4.06,
      "text": "Rate it for me, mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 39.3,
      "end_seconds": 47.46,
      "duration_seconds": 8.16,
      "text": "Mostly moderate. Okay, so and there's a lack of appetite as well, two months now."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 49.44,
      "end_seconds": 52.81,
      "duration_seconds": 3.37,
      "text": "Right, do you have any long-term conditions?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 54.39,
      "end_seconds": 59.34,
      "duration_seconds": 4.95,
      "text": "I've had an underactive thyroid for two years now."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 61.33,
      "end_seconds": 66.91,
      "duration_seconds": 5.58,
      "text": "Yes, an underactive thyroid is known to us, good to have that clear."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 75.75,
      "end_seconds": 78.0,
      "duration_seconds": 2.25,
      "text": "Any surgery in the past?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 81.09,
      "end_seconds": 85.22,
      "duration_seconds": 4.13,
      "text": "Just my womb taken out, fifteen years ago."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 86.13,
      "end_seconds": 89.96,
      "duration_seconds": 3.83,
      "text": "What do you take on a normal day?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 91.73,
      "end_seconds": 98.11,
      "duration_seconds": 6.38,
      "text": "She is on thyroxine, 75 micrograms, every morning, I give it to her."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 98.36,
      "end_seconds": 99.06,
      "duration_seconds": 0.7,
      "text": "Sure."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 117.13,
      "end_seconds": 119.02,
      "duration_seconds": 1.89,
      "text": "Who lives with you?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 120.08,
      "end_seconds": 122.52,
      "duration_seconds": 2.44,
      "text": "My partner and our baby."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 123.93,
      "end_seconds": 126.2,
      "duration_seconds": 2.27,
      "text": "Do you do any exercise?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 127.87,
      "end_seconds": 130.41,
      "duration_seconds": 2.54,
      "text": "I swim twice a week."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 134.2,
      "end_seconds": 136.84,
      "duration_seconds": 2.64,
      "text": "Alright, tell me about your eating."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 137.69,
      "end_seconds": 143.16,
      "duration_seconds": 5.47,
      "text": "I drink a lot of tea and snack through the day."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 144.42,
      "end_seconds": 149.98,
      "duration_seconds": 5.56,
      "text": "Let me check a few things. Any vomiting, severe abdominal pain or black stools?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 151.73,
      "end_seconds": 153.7,
      "duration_seconds": 1.97,
      "text": "Nope, nothing like that."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 155.38,
      "end_seconds": 159.42,
      "duration_seconds": 4.04,
      "text": "So, and blood in the stool, any of that?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 160.92,
      "end_seconds": 163.96,
      "duration_seconds": 3.04,
      "text": "No, no blood in the stool."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 164.49,
      "end_seconds": 167.86,
      "duration_seconds": 3.37,
      "text": "How about your heart, any problems like that?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 172.28,
      "end_seconds": 174.79,
      "duration_seconds": 2.51,
      "text": "No, nothing with my heart."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 175.35,
      "end_seconds": 177.7,
      "duration_seconds": 2.35,
      "text": "I'll do your observations first."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 189.07,
      "end_seconds": 191.17,
      "duration_seconds": 2.1,
      "text": "Nearly done with the readings..."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 213.04,
      "end_seconds": 218.17,
      "duration_seconds": 5.13,
      "text": "Okay: blood pressure 111 over 78, heart rate 67, saturation 99 percent."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 218.94,
      "end_seconds": 221.32,
      "duration_seconds": 2.38,
      "text": "Is that alright, doctor?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 221.91,
      "end_seconds": 224.38,
      "duration_seconds": 2.47,
      "text": "We'll look at it together shortly."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 226.67,
      "end_seconds": 229.06,
      "duration_seconds": 2.39,
      "text": "Let's move on to the examination."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 230.52,
      "end_seconds": 232.23,
      "duration_seconds": 1.71,
      "text": "Yes, that's fine."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 233.32,
      "end_seconds": 236.28,
      "duration_seconds": 2.96,
      "text": "Stay as you are for a moment."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 254.82,
      "end_seconds": 259.58,
      "duration_seconds": 4.76,
      "text": "There is firm stool in the left lower abdomen and no mass."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 260.09,
      "end_seconds": 260.79,
      "duration_seconds": 0.7,
      "text": "Right."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 265.76,
      "end_seconds": 274.65,
      "duration_seconds": 8.89,
      "text": "That's all I needed to check. Having listened and examined, this looks most like constipation, possibly related to diet or medicines."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 281.88,
      "end_seconds": 307.05,
      "duration_seconds": 25.17,
      "text": "I'll request a blood count, it'll help with constipation. It's a routine test and it'll give us a much clearer picture. I'd like to arrange blood tests for constipation. I'd rather check than guess, and this is the quickest way to know more. We'll begin with macrogol, 1 sachet, once a day, for two weeks. That should help with constipation."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 308.72,
      "end_seconds": 313.92,
      "duration_seconds": 5.2,
      "text": "Um, uh, alright, I'll pick it up today."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 314.51,
      "end_seconds": 330.57,
      "duration_seconds": 16.06,
      "text": "More fibre, plenty of water and a regular time on the toilet after breakfast. Come back or go to emergency straight away if you are unable to pass wind or have severe tummy pain."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 331.54,
      "end_seconds": 332.92,
      "duration_seconds": 1.38,
      "text": "I'll remember that."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 334.66,
      "end_seconds": 338.98,
      "duration_seconds": 4.32,
      "text": "Come back in three weeks. Does all of that make sense?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 340.87,
      "end_seconds": 345.8,
      "duration_seconds": 4.93,
      "text": "Right, uh, I'll do that. Thank you, doctor."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 347.1,
      "end_seconds": 348.27,
      "duration_seconds": 1.17,
      "text": "See you soon."
    }
  ]
}