{
  "schema_version": "1.0",
  "encounter_id": "20121",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.7,
      "end_seconds": 5.83,
      "duration_seconds": 5.13,
      "text": "Welcome. Make yourself comfortable. So what can I do for you?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 7.92,
      "end_seconds": 11.66,
      "duration_seconds": 3.74,
      "text": "I'm here because of a pounding headache."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 13.34,
      "end_seconds": 17.09,
      "duration_seconds": 3.75,
      "text": "which medicines do you take at the moment?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 18.58,
      "end_seconds": 23.27,
      "duration_seconds": 4.69,
      "text": "Glimepiride, 2 milligrams, before breakfast for my sugar."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 24.62,
      "end_seconds": 27.74,
      "duration_seconds": 3.12,
      "text": "How troublesome is it day to day?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 29.83,
      "end_seconds": 36.35,
      "duration_seconds": 6.52,
      "text": "Moderate, really. I've had a high fever with shaking chills too, for two weeks."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 38.26,
      "end_seconds": 42.3,
      "duration_seconds": 4.04,
      "text": "let me check a few things any confusion or diarrhoea?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 43.88,
      "end_seconds": 45.82,
      "duration_seconds": 1.94,
      "text": "None of those, no."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 47.4,
      "end_seconds": 51.69,
      "duration_seconds": 4.29,
      "text": "a few quick ones: cough, rash or yellow eyes?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 53.1,
      "end_seconds": 58.18,
      "duration_seconds": 5.08,
      "text": "no cough, rash or yellow eyes, none of it"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 59.9,
      "end_seconds": 63.08,
      "duration_seconds": 3.18,
      "text": "has your heart given you any trouble?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 64.23,
      "end_seconds": 65.61,
      "duration_seconds": 1.38,
      "text": "Nothing like that."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 67.3,
      "end_seconds": 70.52,
      "duration_seconds": 3.22,
      "text": "alright, do you have any long-term conditions?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 72.06,
      "end_seconds": 74.79,
      "duration_seconds": 2.73,
      "text": "Diabetes, for about ten years"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 78.2,
      "end_seconds": 83.37,
      "duration_seconds": 5.17,
      "text": "Yes, diabetes is known to us, good to have that clear."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 99.66,
      "end_seconds": 103.94,
      "duration_seconds": 4.28,
      "text": "What does a normal day of food look like?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 105.34,
      "end_seconds": 108.88,
      "duration_seconds": 3.54,
      "text": "Lots of rice, lentils and some fruit"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 109.76,
      "end_seconds": 111.72,
      "duration_seconds": 1.96,
      "text": "Do you do any exercise?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 112.25,
      "end_seconds": 114.6,
      "duration_seconds": 2.35,
      "text": "I swim twice a week."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 116.31,
      "end_seconds": 118.22,
      "duration_seconds": 1.91,
      "text": "Who lives with you?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 122.42,
      "end_seconds": 125.1,
      "duration_seconds": 2.68,
      "text": "My partner and our baby"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 125.71,
      "end_seconds": 128.88,
      "duration_seconds": 3.17,
      "text": "Any past operations I should know about?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 134.7,
      "end_seconds": 138.62,
      "duration_seconds": 3.92,
      "text": "just my womb taken out, fifteen years ago"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 149.4,
      "end_seconds": 152.64,
      "duration_seconds": 3.24,
      "text": "are there any illnesses in your family?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 153.47,
      "end_seconds": 155.83,
      "duration_seconds": 2.36,
      "text": "My sister had breast cancer."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 157.3,
      "end_seconds": 162.6,
      "duration_seconds": 5.3,
      "text": "Right, can I check a few measurements before we carry on?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 175.05,
      "end_seconds": 178.03,
      "duration_seconds": 2.98,
      "text": "That's it, just a little longer..."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 199.06,
      "end_seconds": 204.12,
      "duration_seconds": 5.06,
      "text": "Okay: respiratory rate 19, heart rate 100, BP is 124 over 66."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 210.12,
      "end_seconds": 212.24,
      "duration_seconds": 2.12,
      "text": "Is that that normal?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 213.21,
      "end_seconds": 215.83,
      "duration_seconds": 2.62,
      "text": "I'll come back to the numbers."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 217.19,
      "end_seconds": 220.99,
      "duration_seconds": 3.8,
      "text": "I'll examine you in a second, make yourself comfortable."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 222.0,
      "end_seconds": 223.24,
      "duration_seconds": 1.24,
      "text": "Okay, doctor."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 224.79,
      "end_seconds": 226.74,
      "duration_seconds": 1.95,
      "text": "Tell me if that's sore."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 237.41,
      "end_seconds": 242.71,
      "duration_seconds": 5.3,
      "text": "the spleen tip is just palpable and the chest is clear"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 244.79,
      "end_seconds": 258.75,
      "duration_seconds": 13.96,
      "text": "Thank you, you can get dressed. Having listened and examined, I'm honestly not certain yet. It could be a fever after travel that must be treated as possible malaria, or it might be dengue fever."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 260.44,
      "end_seconds": 262.45,
      "duration_seconds": 2.01,
      "text": "Is it dangerous, doctor?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 263.53,
      "end_seconds": 278.22,
      "duration_seconds": 14.69,
      "text": "I understand the worry. At the moment I'd say it's a fever after travel that must be treated as possible malaria, and we'll know more once the blood tests is back."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 292.28,
      "end_seconds": 312.48,
      "duration_seconds": 20.2,
      "text": "Let's book blood tests to look into fever. We should do blood cultures for fever. Avoid anti-inflammatory painkillers and keep drinking. Please take the tablets with food so they don't upset your stomach. I'd like you to see the tropical diseases unit as well, and I'll write the referral."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 314.45,
      "end_seconds": 317.11,
      "duration_seconds": 2.66,
      "text": "Sure, where do I go?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 317.79,
      "end_seconds": 323.36,
      "duration_seconds": 5.57,
      "text": "Could I get a malaria test done? A friend had it."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 324.7,
      "end_seconds": 334.36,
      "duration_seconds": 9.66,
      "text": "Not at this point, no. It isn't indicated yet. Let's review you in two days. That's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 336.34,
      "end_seconds": 339.68,
      "duration_seconds": 3.34,
      "text": "okay, that makes sense. Thanks for explaining"
    }
  ]
}