{
  "schema_version": "1.0",
  "encounter_id": "20114",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.26,
      "end_seconds": 4.74,
      "duration_seconds": 3.48,
      "text": "Hello, doctor. May I come in?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.85,
      "end_seconds": 10.1,
      "duration_seconds": 4.25,
      "text": "Not at all, please sit. What seems to be wrong?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 11.97,
      "end_seconds": 19.58,
      "duration_seconds": 7.61,
      "text": "I've been passing out for a couple of minutes, and I wanted to get it checked."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 20.97,
      "end_seconds": 24.34,
      "duration_seconds": 3.37,
      "text": "Can you tell me when it first started?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 25.54,
      "end_seconds": 35.87,
      "duration_seconds": 10.33,
      "text": "I'm not sure when it began, uh, to be honest. Some weeks ago, but I can't say how many."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 37.24,
      "end_seconds": 39.8,
      "duration_seconds": 2.56,
      "text": "How much does it limit you?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 41.32,
      "end_seconds": 44.17,
      "duration_seconds": 2.85,
      "text": "Pretty mild, if I'm being honest."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 45.89,
      "end_seconds": 48.35,
      "duration_seconds": 2.46,
      "text": "Have you been feeling drowsy afterwards?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 48.89,
      "end_seconds": 60.07,
      "duration_seconds": 11.18,
      "text": "Yeah, um, I've had that since Monday. And a bitten tongue as well, since yesterday. About bitten tongue, it feels mild to me."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 60.92,
      "end_seconds": 64.84,
      "duration_seconds": 3.92,
      "text": "So, has anyone ever diagnosed you with something?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 65.73,
      "end_seconds": 69.16,
      "duration_seconds": 3.43,
      "text": "High blood pressure, for nearly five years."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 70.94,
      "end_seconds": 78.53,
      "duration_seconds": 7.59,
      "text": "Alright, high blood pressure, that matches what I have here. Do you follow any particular diet?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 80.03,
      "end_seconds": 83.17,
      "duration_seconds": 3.14,
      "text": "I'm vegetarian and have been for years."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 84.8,
      "end_seconds": 87.13,
      "duration_seconds": 2.33,
      "text": "Anything you do to stay fit?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 88.43,
      "end_seconds": 92.15,
      "duration_seconds": 3.72,
      "text": "I do a yoga class on Thursdays."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 93.61,
      "end_seconds": 97.08,
      "duration_seconds": 3.47,
      "text": "Right, what's on your current medicine list?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 98.33,
      "end_seconds": 101.26,
      "duration_seconds": 2.93,
      "text": "I'm on amlodipine, once a day."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 102.19,
      "end_seconds": 104.19,
      "duration_seconds": 2.0,
      "text": "Do you know the dose?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 105.18,
      "end_seconds": 109.73,
      "duration_seconds": 4.55,
      "text": "5 milligrams, I think that's what's on the box."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 111.19,
      "end_seconds": 115.95,
      "duration_seconds": 4.76,
      "text": "Okay, are there any allergies I should be aware of?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 116.63,
      "end_seconds": 119.98,
      "duration_seconds": 3.35,
      "text": "No, I'm not allergic to anything."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 120.58,
      "end_seconds": 124.01,
      "duration_seconds": 3.43,
      "text": "Did you ever have any procedures done?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 125.32,
      "end_seconds": 130.74,
      "duration_seconds": 5.42,
      "text": "Right, yes, I had my septum straightened, in my thirties."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 131.91,
      "end_seconds": 134.54,
      "duration_seconds": 2.63,
      "text": "Any fever or palpitations at all?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 136.45,
      "end_seconds": 138.89,
      "duration_seconds": 2.44,
      "text": "No, not a single one."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 140.65,
      "end_seconds": 144.85,
      "duration_seconds": 4.2,
      "text": "Any chest pain, head injury or vomiting at all?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 146.2,
      "end_seconds": 150.79,
      "duration_seconds": 4.59,
      "text": "No, no chest pain, head injury or vomiting."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 152.19,
      "end_seconds": 156.79,
      "duration_seconds": 4.6,
      "text": "Right, on the cardiac side, anything I should know?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 158.49,
      "end_seconds": 160.93,
      "duration_seconds": 2.44,
      "text": "No, nothing with my heart."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 175.02,
      "end_seconds": 178.51,
      "duration_seconds": 3.49,
      "text": "So, time for your numbers, if that's okay."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 191.65,
      "end_seconds": 194.55,
      "duration_seconds": 2.9,
      "text": "So, bear with me while this finishes..."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 211.82,
      "end_seconds": 221.79,
      "duration_seconds": 9.97,
      "text": "Okay: saturation 97 percent, heart rate 83, respiratory rate 16, temperature is 36.6 degrees, blood pressure 126 over 74."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 240.32,
      "end_seconds": 246.13,
      "duration_seconds": 5.81,
      "text": "Going by what you've described, it fits best with a possible first seizure."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 251.19,
      "end_seconds": 252.56,
      "duration_seconds": 1.37,
      "text": "Is this permanent?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 253.36,
      "end_seconds": 263.2,
      "duration_seconds": 9.84,
      "text": "I understand the worry. At the moment I'd say it's a possible first seizure, and we'll know more once the a brain scan is back."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 274.25,
      "end_seconds": 278.67,
      "duration_seconds": 4.42,
      "text": "We should do a brain scan for possible seizure."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 280.11,
      "end_seconds": 281.33,
      "duration_seconds": 1.22,
      "text": "Right, understood."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 283.08,
      "end_seconds": 308.63,
      "duration_seconds": 25.55,
      "text": "We should do an ECG for loss of consciousness. No driving until you have been seen in the clinic, and avoid swimming or climbing alone. If you have another episode or one lasts more than five minutes, or you feel really unwell, please come to the emergency department. I'd like you back in four weeks."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 309.59,
      "end_seconds": 313.37,
      "duration_seconds": 3.78,
      "text": "I'll book it on my way out."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 317.14,
      "end_seconds": 320.37,
      "duration_seconds": 3.23,
      "text": "I think we're done unless you have questions."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 321.67,
      "end_seconds": 325.69,
      "duration_seconds": 4.02,
      "text": "Right, I'll do that. Thank you, doctor."
    }
  ]
}