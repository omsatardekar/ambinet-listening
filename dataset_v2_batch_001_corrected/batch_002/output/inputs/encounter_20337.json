{
  "schema_version": "1.0",
  "encounter_id": "20337",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.52,
      "end_seconds": 3.39,
      "duration_seconds": 2.87,
      "text": "Morning, doctor. Lovely to meet you."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 4.79,
      "end_seconds": 8.96,
      "duration_seconds": 4.17,
      "text": "Yes, have a seat. Tell me what's going on."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 9.89,
      "end_seconds": 12.25,
      "duration_seconds": 2.36,
      "text": "It's a sore tongue, mostly."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 13.83,
      "end_seconds": 16.55,
      "duration_seconds": 2.72,
      "text": "Any regular medication, tablets or creams?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 19.98,
      "end_seconds": 23.21,
      "duration_seconds": 3.23,
      "text": "No, I don't take any tablets."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 24.89,
      "end_seconds": 26.51,
      "duration_seconds": 1.62,
      "text": "When did this begin?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 32.04,
      "end_seconds": 34.57,
      "duration_seconds": 2.53,
      "text": "About... well, nearly five years."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 35.54,
      "end_seconds": 44.36,
      "duration_seconds": 8.82,
      "text": "Tell me a bit more about it: how bad it gets, how often, and whether anything makes it better or worse."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 45.53,
      "end_seconds": 49.88,
      "duration_seconds": 4.35,
      "text": "Mostly severe. I notice it more with spicy food."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 63.11,
      "end_seconds": 67.85,
      "duration_seconds": 4.74,
      "text": "A few quick ones: diarrhoea, bladder problems or loss of vision?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 69.77,
      "end_seconds": 76.75,
      "duration_seconds": 6.98,
      "text": "So, no diarrhoea, bladder problems or loss of vision, none of it."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 77.33,
      "end_seconds": 80.05,
      "duration_seconds": 2.72,
      "text": "Any breathing difficulties apart from this?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 82.1,
      "end_seconds": 83.73,
      "duration_seconds": 1.63,
      "text": "No, nothing there."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 84.29,
      "end_seconds": 88.93,
      "duration_seconds": 4.64,
      "text": "Any inherited conditions that you know of in the family?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 90.18,
      "end_seconds": 92.91,
      "duration_seconds": 2.73,
      "text": "My father had bowel cancer."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 93.57,
      "end_seconds": 97.53,
      "duration_seconds": 3.96,
      "text": "Any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 98.04,
      "end_seconds": 99.6,
      "duration_seconds": 1.56,
      "text": "Not really, no."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 100.77,
      "end_seconds": 102.17,
      "duration_seconds": 1.4,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 103.99,
      "end_seconds": 106.26,
      "duration_seconds": 2.27,
      "text": "No, not at all."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 107.36,
      "end_seconds": 112.23,
      "duration_seconds": 4.87,
      "text": "Do you react to any medicines or foods? Any allergies?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 112.82,
      "end_seconds": 116.81,
      "duration_seconds": 3.99,
      "text": "No, nothing as far as I know."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 127.71,
      "end_seconds": 130.94,
      "duration_seconds": 3.23,
      "text": "A few questions about your lifestyle now."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 132.35,
      "end_seconds": 143.29,
      "duration_seconds": 10.94,
      "text": "Lots of rice, lentils and some fruit. I walk the dog every morning. I'm a hairdresser, on my feet all day."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 144.91,
      "end_seconds": 147.64,
      "duration_seconds": 2.73,
      "text": "I'll just record a few vital signs."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 158.29,
      "end_seconds": 160.7,
      "duration_seconds": 2.41,
      "text": "Bear with me while this finishes..."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 173.97,
      "end_seconds": 180.23,
      "duration_seconds": 6.26,
      "text": "Okay: respiratory rate 15, pressure 115 over 79, pulse 66, temperature is 36.7 degrees."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 182.88,
      "end_seconds": 187.3,
      "duration_seconds": 4.42,
      "text": "I'll examine you in a second, make yourself comfortable."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 191.8,
      "end_seconds": 192.91,
      "duration_seconds": 1.11,
      "text": "Of course."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 194.44,
      "end_seconds": 195.84,
      "duration_seconds": 1.4,
      "text": "Does that hurt?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 211.16,
      "end_seconds": 213.91,
      "duration_seconds": 2.75,
      "text": "The tongue looks smooth and red."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 215.52,
      "end_seconds": 218.08,
      "duration_seconds": 2.56,
      "text": "Take a deep breath for me."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 233.94,
      "end_seconds": 237.37,
      "duration_seconds": 3.43,
      "text": "Your vibration sense is reduced at the ankles."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 241.13,
      "end_seconds": 244.11,
      "duration_seconds": 2.98,
      "text": "So, thank you, you can get dressed."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 263.0,
      "end_seconds": 271.66,
      "duration_seconds": 8.66,
      "text": "Okay, thinking it through, I think we're dealing with symptoms that fit a vitamin B12 deficiency at this stage."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 272.97,
      "end_seconds": 275.02,
      "duration_seconds": 2.05,
      "text": "Is this serious, doctor?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 275.52,
      "end_seconds": 287.44,
      "duration_seconds": 11.92,
      "text": "I understand the worry. At the moment I'd say it's symptoms that fit a vitamin B12 deficiency, and we'll know more once the a vitamin B12 level is back."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 298.47,
      "end_seconds": 319.7,
      "duration_seconds": 21.23,
      "text": "I'd like to arrange a vitamin B12 level for tingling and tiredness. What I'm giving you is cyanocobalamin, 1000 micrograms, every other day, for two weeks. It's for low vitamin B12. Eating more eggs, dairy and fortified cereals will help over time. We'll catch up after the results are back."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 321.29,
      "end_seconds": 321.99,
      "duration_seconds": 0.7,
      "text": "Right."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 327.85,
      "end_seconds": 331.73,
      "duration_seconds": 3.88,
      "text": "That's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 333.04,
      "end_seconds": 334.58,
      "duration_seconds": 1.54,
      "text": "That's clear, thanks."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 335.94,
      "end_seconds": 337.96,
      "duration_seconds": 2.02,
      "text": "Okay, all the best."
    }
  ]
}