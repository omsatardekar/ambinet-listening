{
  "schema_version": "1.0",
  "encounter_id": "20301",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.1,
      "end_seconds": 8.2,
      "duration_seconds": 7.1,
      "text": "yeah, hello doctor, sorry, I took a wrong turn on the way here"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 9.57,
      "end_seconds": 14.29,
      "duration_seconds": 4.72,
      "text": "You're alright, take a seat. What can I do for you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 16.05,
      "end_seconds": 18.9,
      "duration_seconds": 2.85,
      "text": "It's drenching night sweats, mostly."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 21.96,
      "end_seconds": 24.24,
      "duration_seconds": 2.28,
      "text": "Did it come on recently?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 25.43,
      "end_seconds": 27.79,
      "duration_seconds": 2.36,
      "text": "For ten days, I'd say."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 29.6,
      "end_seconds": 38.66,
      "duration_seconds": 9.06,
      "text": "can you describe it a bit more for me? How strong it is, what the pattern is, what helps"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 39.94,
      "end_seconds": 45.92,
      "duration_seconds": 5.98,
      "text": "Only changing my clothes, and it's not much. I'd call it moderate."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 54.36,
      "end_seconds": 57.9,
      "duration_seconds": 3.54,
      "text": "What do you take on a normal day?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 59.56,
      "end_seconds": 62.56,
      "duration_seconds": 3.0,
      "text": "Dolo, when I get the fever."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 63.43,
      "end_seconds": 66.33,
      "duration_seconds": 2.9,
      "text": "Alright, do you know the dose?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 67.17,
      "end_seconds": 68.86,
      "duration_seconds": 1.69,
      "text": "It's 650 milligrams."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 72.01,
      "end_seconds": 75.25,
      "duration_seconds": 3.24,
      "text": "Any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 76.62,
      "end_seconds": 78.75,
      "duration_seconds": 2.13,
      "text": "No, nothing at all."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 80.27,
      "end_seconds": 86.0,
      "duration_seconds": 5.73,
      "text": "Tell me about your routine, work, habits, that sort of thing."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 87.92,
      "end_seconds": 105.85,
      "duration_seconds": 17.93,
      "text": "I used to drink heavily but I stopped four years ago. I grab fast food at lunch most days. I live with my elderly mother. I do a yoga class on Thursdays."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 119.21,
      "end_seconds": 125.22,
      "duration_seconds": 6.01,
      "text": "Let me check a few things. Any chest pain, cough or diarrhoea?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 128.77,
      "end_seconds": 133.65,
      "duration_seconds": 4.88,
      "text": "I haven't had chest pain, cough or diarrhoea, no."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 134.94,
      "end_seconds": 137.83,
      "duration_seconds": 2.89,
      "text": "Any problems with your joints or muscles?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 139.65,
      "end_seconds": 142.55,
      "duration_seconds": 2.9,
      "text": "No, uh, joints are fine."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 143.31,
      "end_seconds": 147.94,
      "duration_seconds": 4.63,
      "text": "Can I check a few measurements before we carry on?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 161.06,
      "end_seconds": 163.78,
      "duration_seconds": 2.72,
      "text": "Bear with me while this finishes..."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 178.81,
      "end_seconds": 187.35,
      "duration_seconds": 8.54,
      "text": "Okay: temp 38.3 degrees, pulse 107. And pressure 125 over 67, saturation 96 percent, respiratory rate 20."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 188.78,
      "end_seconds": 192.55,
      "duration_seconds": 3.77,
      "text": "Right, let's have a proper look at you."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 199.96,
      "end_seconds": 201.47,
      "duration_seconds": 1.51,
      "text": "yes, that's fine"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 203.31,
      "end_seconds": 204.59,
      "duration_seconds": 1.28,
      "text": "Breathe out slowly."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 215.74,
      "end_seconds": 217.73,
      "duration_seconds": 1.99,
      "text": "I can't feel your spleen."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 218.62,
      "end_seconds": 219.84,
      "duration_seconds": 1.22,
      "text": "look straight ahead"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 236.43,
      "end_seconds": 242.66,
      "duration_seconds": 6.23,
      "text": "There's a firm, rubbery gland about two centimetres in the left armpit, not tender."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 246.18,
      "end_seconds": 247.75,
      "duration_seconds": 1.57,
      "text": "You can relax now."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 265.21,
      "end_seconds": 275.64,
      "duration_seconds": 10.43,
      "text": "Let me tell you where I've got to. It points towards an enlarged gland with night sweats that needs a proper work-up."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 277.6,
      "end_seconds": 280.45,
      "duration_seconds": 2.85,
      "text": "is there something to worry about?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 281.31,
      "end_seconds": 307.72,
      "duration_seconds": 26.41,
      "text": "I understand the worry at the moment I'd say it's an enlarged gland with night sweats that needs a proper work-up, and we'll know more once the a chest X-ray is back i think a chest X-ray makes sense here, for night sweats keep a note of your temperature each evening avoid taking any extra painkillers on top of what I'm prescribing without checking with us"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 309.7,
      "end_seconds": 319.67,
      "duration_seconds": 9.97,
      "text": "I'd like you to see the haematology clinic as well, and I'll write the referral. We'll catch up after the results are back."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 321.01,
      "end_seconds": 323.25,
      "duration_seconds": 2.24,
      "text": "Okay, I'll arrange it."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 324.05,
      "end_seconds": 330.33,
      "duration_seconds": 6.28,
      "text": "Tell me what you've taken from all that, so I can fill in any gaps."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 334.56,
      "end_seconds": 341.37,
      "duration_seconds": 6.81,
      "text": "so, I come back after the results are back. Is that right?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 342.28,
      "end_seconds": 348.14,
      "duration_seconds": 5.86,
      "text": "Yes, exactly right. That's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 349.62,
      "end_seconds": 352.7,
      "duration_seconds": 3.08,
      "text": "no, that's all thanks a lot"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 354.69,
      "end_seconds": 356.13,
      "duration_seconds": 1.44,
      "text": "See you soon."
    }
  ]
}