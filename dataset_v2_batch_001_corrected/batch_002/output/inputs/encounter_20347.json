{
  "schema_version": "1.0",
  "encounter_id": "20347",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.03,
      "end_seconds": 4.81,
      "duration_seconds": 3.78,
      "text": "Come in, have a seat by the desk."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "FAMILY_MEMBER",
      "start_seconds": 5.87,
      "end_seconds": 11.15,
      "duration_seconds": 5.28,
      "text": "Hello, doctor. I'm here with them in case I can help."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 13.05,
      "end_seconds": 15.73,
      "duration_seconds": 2.68,
      "text": "How are things, what's been happening?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "FAMILY_MEMBER",
      "start_seconds": 16.25,
      "end_seconds": 24.55,
      "duration_seconds": 8.3,
      "text": "Erm, um, doctor, it's a cough at night. That's what we're worried about."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 25.63,
      "end_seconds": 26.82,
      "duration_seconds": 1.19,
      "text": "Since when exactly?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 27.36,
      "end_seconds": 37.99,
      "duration_seconds": 10.63,
      "text": "Hm. It was either the end of last month or earlier than that. I couldn't tell you the date."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 40.04,
      "end_seconds": 48.8,
      "duration_seconds": 8.76,
      "text": "Can you describe it a bit more for me? How strong it is, what the pattern is, what helps."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 49.72,
      "end_seconds": 54.3,
      "duration_seconds": 4.58,
      "text": "So, honestly, all the time. It's moderate, honestly."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 55.0,
      "end_seconds": 63.21,
      "duration_seconds": 8.21,
      "text": "And the other thing I wanted to mention is that I can't really—"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "FAMILY_MEMBER",
      "start_seconds": 63.31,
      "end_seconds": 70.45,
      "duration_seconds": 7.14,
      "text": "Right, tell the doctor about the other thing, that's what worries me."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 71.03,
      "end_seconds": 78.87,
      "duration_seconds": 7.84,
      "text": "I, I was getting to that! I've, I've had chest tightness too, for three weeks."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 80.45,
      "end_seconds": 82.86,
      "duration_seconds": 2.41,
      "text": "How much does it limit you?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 84.56,
      "end_seconds": 88.46,
      "duration_seconds": 3.9,
      "text": "Actually, about a five out of ten."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 88.99,
      "end_seconds": 92.75,
      "duration_seconds": 3.76,
      "text": "Right, any wheezing when you exercise as well?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 93.94,
      "end_seconds": 107.79,
      "duration_seconds": 13.85,
      "text": "Let me think, yes, for five days. As for wheezing when I exercise, severe, I'd say. I get some relief from my inhaler."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 109.14,
      "end_seconds": 115.78,
      "duration_seconds": 6.64,
      "text": "A few quick ones: blue lips, chest pain, ankle swelling or weight loss?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 117.39,
      "end_seconds": 122.33,
      "duration_seconds": 4.94,
      "text": "Um, no, I haven't had any of them."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 124.17,
      "end_seconds": 126.51,
      "duration_seconds": 2.34,
      "text": "Has there been any fever?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 127.56,
      "end_seconds": 130.2,
      "duration_seconds": 2.64,
      "text": "I haven't noticed any fever."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "FAMILY_MEMBER",
      "start_seconds": 131.29,
      "end_seconds": 138.44,
      "duration_seconds": 7.15,
      "text": "Actually, you know, doctor, I did notice fever. She doesn't always say."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 139.76,
      "end_seconds": 147.95,
      "duration_seconds": 8.19,
      "text": "Actually, no, I don't think I did. Maybe a little, I'm not sure."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 150.02,
      "end_seconds": 158.43,
      "duration_seconds": 8.41,
      "text": "Alright, I'll note both what you've said and what you've noticed. What about your tummy and bowels, anything unusual there?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 159.28,
      "end_seconds": 163.08,
      "duration_seconds": 3.8,
      "text": "Yeah, bowels are regular, nothing odd."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 164.01,
      "end_seconds": 167.04,
      "duration_seconds": 3.03,
      "text": "Does your family have any medical conditions?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 168.0,
      "end_seconds": 172.89,
      "duration_seconds": 4.89,
      "text": "My brother has epilepsy. Oh, my son has asthma."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 188.91,
      "end_seconds": 191.35,
      "duration_seconds": 2.44,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 193.37,
      "end_seconds": 199.41,
      "duration_seconds": 6.04,
      "text": "Let me think, uh, no, I've never been operated on."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 200.91,
      "end_seconds": 202.7,
      "duration_seconds": 1.79,
      "text": "How active are you?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 203.64,
      "end_seconds": 207.18,
      "duration_seconds": 3.54,
      "text": "I hardly move around during the day."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 222.26,
      "end_seconds": 227.03,
      "duration_seconds": 4.77,
      "text": "Has anything ever caused you a reaction? I mean any allergies."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 228.39,
      "end_seconds": 233.85,
      "duration_seconds": 5.46,
      "text": "Let me think, yes, cat fur. I get sneezing."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 235.68,
      "end_seconds": 237.73,
      "duration_seconds": 2.05,
      "text": "Let's run through your medicines."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 238.96,
      "end_seconds": 244.64,
      "duration_seconds": 5.68,
      "text": "Asthalin inhaler. I take it when needed for my asthma."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "FAMILY_MEMBER",
      "start_seconds": 245.39,
      "end_seconds": 252.98,
      "duration_seconds": 7.59,
      "text": "It's meant to be when needed, though I don't see she take it every time."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 255.19,
      "end_seconds": 258.85,
      "duration_seconds": 3.66,
      "text": "It's cetirizine, 10 milligrams, when it flares."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 259.52,
      "end_seconds": 263.38,
      "duration_seconds": 3.86,
      "text": "Any health conditions I should have on record?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 265.02,
      "end_seconds": 267.14,
      "duration_seconds": 2.12,
      "text": "Asthma, for two years."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 267.81,
      "end_seconds": 287.55,
      "duration_seconds": 19.74,
      "text": "Listening to the whole story, this looks most like exercise-triggered asthma with seasonal allergy. I want to be honest that this is an impression, not a final answer. Another possibility is a viral chest infection. We shouldn't forget reflux. I'm sending you for a peak flow diary because of asthma."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_4",
      "role": "CLINICAL_STAFF",
      "start_seconds": 288.39,
      "end_seconds": 293.26,
      "duration_seconds": 4.87,
      "text": "We have a slot Monday at 11:30 am, if that works."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 294.03,
      "end_seconds": 298.69,
      "duration_seconds": 4.66,
      "text": "I'm sending you for an allergy test because of seasonal symptoms."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 303.8,
      "end_seconds": 306.18,
      "duration_seconds": 2.38,
      "text": "That's fine with me."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 306.71,
      "end_seconds": 321.83,
      "duration_seconds": 15.12,
      "text": "I'm prescribing budesonide-formoterol inhaler, 200 micrograms, one puff twice a day, long term. That's for asthma control. I'll put all of this in writing so you don't have to remember it."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 324.82,
      "end_seconds": 331.1,
      "duration_seconds": 6.28,
      "text": "Sorry, what was I saying, should I take that with food?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 332.23,
      "end_seconds": 337.03,
      "duration_seconds": 4.8,
      "text": "Rinse your mouth after the preventer inhaler and use the spacer."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 337.4,
      "end_seconds": 347.75,
      "duration_seconds": 10.35,
      "text": "Yes. I'd like to see you again in six weeks. Right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 349.1,
      "end_seconds": 352.77,
      "duration_seconds": 3.67,
      "text": "Good, thanks, I'll see you then."
    }
  ]
}