{
  "schema_version": "1.0",
  "encounter_id": "20351",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.35,
      "end_seconds": 4.21,
      "duration_seconds": 2.86,
      "text": "Morning, doctor. Lovely to meet you."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.09,
      "end_seconds": 11.04,
      "duration_seconds": 4.95,
      "text": "you're alright, take a seat. What can I do for you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 13.06,
      "end_seconds": 20.09,
      "duration_seconds": 7.03,
      "text": "Yeah, good afternoon, doctor. I look after them so I thought I'd come."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 21.87,
      "end_seconds": 24.86,
      "duration_seconds": 2.99,
      "text": "Alright, absolutely, come and sit beside them."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 26.02,
      "end_seconds": 28.3,
      "duration_seconds": 2.28,
      "text": "It's no energy, mostly."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 29.65,
      "end_seconds": 32.61,
      "duration_seconds": 2.96,
      "text": "okay, tell me your medicines, please"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 34.61,
      "end_seconds": 40.47,
      "duration_seconds": 5.86,
      "text": "Hmm, it's atorvastatin, 20 milligrams, maybe, at night for my cholesterol."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 41.7,
      "end_seconds": 46.3,
      "duration_seconds": 4.6,
      "text": "Did you happen to bring the box or the paperwork?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 46.87,
      "end_seconds": 54.25,
      "duration_seconds": 7.38,
      "text": "No, it's at home. Before this I was on sertraline; that's been stopped."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 55.63,
      "end_seconds": 58.52,
      "duration_seconds": 2.89,
      "text": "how long has it been like this?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 59.82,
      "end_seconds": 71.46,
      "duration_seconds": 11.64,
      "text": "Honestly I can't say exactly when it started. It might have been last month or the month before, I really can't pin it down."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 72.01,
      "end_seconds": 76.46,
      "duration_seconds": 4.45,
      "text": "yes, carry on. How troublesome is it day to day?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 77.99,
      "end_seconds": 82.05,
      "duration_seconds": 4.06,
      "text": "A seven out of ten, I suppose."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 82.88,
      "end_seconds": 89.93,
      "duration_seconds": 7.05,
      "text": "I, I was just going to say that the main thing is—"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_4",
      "role": "NURSE",
      "start_seconds": 90.03,
      "end_seconds": 96.07,
      "duration_seconds": 6.04,
      "text": "Sorry to cut in, doctor, quick question: shall I bring the trolley in now or later?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 98.12,
      "end_seconds": 103.23,
      "duration_seconds": 5.11,
      "text": "Later, thanks. Please go on. Have you been losing interest in things?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 103.95,
      "end_seconds": 107.15,
      "duration_seconds": 3.2,
      "text": "Yes, about the same, three weeks."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_5",
      "role": "UNKNOWN",
      "start_seconds": 108.81,
      "end_seconds": 110.85,
      "duration_seconds": 2.04,
      "text": "Yes, exactly like that."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 111.65,
      "end_seconds": 116.46,
      "duration_seconds": 4.81,
      "text": "Any panic attacks or thoughts of harming myself at all?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 117.41,
      "end_seconds": 132.09,
      "duration_seconds": 14.68,
      "text": "No, no panic attacks, no thoughts of harming myself. I did have a tight chest when stressed at one point, but that went away on its own."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 132.71,
      "end_seconds": 137.7,
      "duration_seconds": 4.99,
      "text": "and what about hearing voices, chest pain or weight loss?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 138.7,
      "end_seconds": 144.31,
      "duration_seconds": 5.61,
      "text": "I haven't had hearing voices, chest pain or weight loss, no."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 145.94,
      "end_seconds": 148.28,
      "duration_seconds": 2.34,
      "text": "Is your mobility otherwise okay?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 149.39,
      "end_seconds": 155.81,
      "duration_seconds": 6.42,
      "text": "Sorry, um, what was I saying, no, joints are fine."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 156.85,
      "end_seconds": 161.74,
      "duration_seconds": 4.89,
      "text": "Let's talk a little about your daily life and habits."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 163.08,
      "end_seconds": 176.69,
      "duration_seconds": 13.61,
      "text": "I gave up cigarettes last spring. Not much, I mostly stay in these days. I drink a lot of tea and snack through the day."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 181.34,
      "end_seconds": 185.8,
      "duration_seconds": 4.46,
      "text": "Do you react to to any medicines or foods? Any allergies?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 189.66,
      "end_seconds": 193.88,
      "duration_seconds": 4.22,
      "text": "Okay, so no, I'm not allergic to anything."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 195.43,
      "end_seconds": 202.11,
      "duration_seconds": 6.68,
      "text": "I'm not sure that's right. I seem to recall a problem with diclofenac."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 206.35,
      "end_seconds": 208.62,
      "duration_seconds": 2.27,
      "text": "I don't remember that that"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 210.56,
      "end_seconds": 215.91,
      "duration_seconds": 5.35,
      "text": "Alright, so that's unclear. I'll record what each of you said."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 233.96,
      "end_seconds": 235.15,
      "duration_seconds": 1.19,
      "text": "any previous surgeries?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 239.12,
      "end_seconds": 240.18,
      "duration_seconds": 1.06,
      "text": "No, never."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 241.23,
      "end_seconds": 244.48,
      "duration_seconds": 3.25,
      "text": "Any health conditions I should have on record?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 246.41,
      "end_seconds": 256.71,
      "duration_seconds": 10.3,
      "text": "I have anxiety, for five years. I've, I've got depression. I've had high cholesterol for about ten years now."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 258.24,
      "end_seconds": 262.29,
      "duration_seconds": 4.05,
      "text": "Alright, depression, that that matches what I have here."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_4",
      "role": "NURSE",
      "start_seconds": 263.67,
      "end_seconds": 272.3,
      "duration_seconds": 8.63,
      "text": "okay, so the vitals from earlier pulse 75, SpO2 98 percent on room air, blood pressure 124 over 79."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 276.86,
      "end_seconds": 277.56,
      "duration_seconds": 0.7,
      "text": "Thanks."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 278.66,
      "end_seconds": 283.2,
      "duration_seconds": 4.54,
      "text": "alright, over here please and I'll take a look"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 284.17,
      "end_seconds": 286.64,
      "duration_seconds": 2.47,
      "text": "hold that for a second"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 297.42,
      "end_seconds": 303.94,
      "duration_seconds": 6.52,
      "text": "your pulse and blood pressure are normal and you are tearful when talking about work"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 305.65,
      "end_seconds": 306.57,
      "duration_seconds": 0.92,
      "text": "sure thing"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 309.01,
      "end_seconds": 311.45,
      "duration_seconds": 2.44,
      "text": "Okay, that's enough for me."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 328.75,
      "end_seconds": 344.91,
      "duration_seconds": 16.16,
      "text": "try a short walk each day and keep a regular bedtime. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose. Is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 345.89,
      "end_seconds": 349.34,
      "duration_seconds": 3.45,
      "text": "Good, thanks, I'll see you then."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 350.46,
      "end_seconds": 351.77,
      "duration_seconds": 1.31,
      "text": "see you soon"
    }
  ]
}