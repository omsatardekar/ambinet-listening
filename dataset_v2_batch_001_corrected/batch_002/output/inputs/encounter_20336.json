  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.21,
      "end_seconds": 6.37,
      "duration_seconds": 5.16,
      "text": "Erm, hi, is it okay to come in now?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.97,
      "end_seconds": 13.48,
      "duration_seconds": 5.51,
      "text": "you're alright, take a seat what can I do for you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 14.2,
      "end_seconds": 21.25,
      "duration_seconds": 7.05,
      "text": "I've been repeating the same question, and I wanted to get it checked."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 22.83,
      "end_seconds": 26.25,
      "duration_seconds": 3.42,
      "text": "has this been going on for long?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 27.53,
      "end_seconds": 31.34,
      "duration_seconds": 3.81,
      "text": "It's, It's been going on for six months."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 32.83,
      "end_seconds": 35.99,
      "duration_seconds": 3.16,
      "text": "Which medicines do you take at the moment?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 39.95,
      "end_seconds": 45.63,
      "duration_seconds": 5.68,
      "text": "I'm on gliclazide, 80 milligrams, twice a day for my sugar."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 49.54,
      "end_seconds": 52.19,
      "duration_seconds": 2.65,
      "text": "Now some background about your lifestyle."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 53.52,
      "end_seconds": 65.95,
      "duration_seconds": 12.43,
      "text": "I drink a lot of tea and snack through the day. My husband and I live above the shop. I work in accounts at a hospital."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 67.83,
      "end_seconds": 73.18,
      "duration_seconds": 5.35,
      "text": "Are you allergic to anything? Any allergies to to medicines or foods?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 75.12,
      "end_seconds": 78.44,
      "duration_seconds": 3.32,
      "text": "No, I've never reacted to anything."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 94.86,
      "end_seconds": 98.03,
      "duration_seconds": 3.17,
      "text": "Has anyone ever diagnosed you with something?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 98.84,
      "end_seconds": 99.91,
      "duration_seconds": 1.07,
      "text": "Yes, diabetes."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 100.79,
      "end_seconds": 101.49,
      "duration_seconds": 0.7,
      "text": "yes"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 118.06,
      "end_seconds": 121.75,
      "duration_seconds": 3.69,
      "text": "A few quick ones: bladder problems, falls or headache?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 123.22,
      "end_seconds": 125.13,
      "duration_seconds": 1.91,
      "text": "Nope, nothing like that."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 125.9,
      "end_seconds": 127.87,
      "duration_seconds": 1.97,
      "text": "Did you notice any hallucinations?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 129.05,
      "end_seconds": 130.52,
      "duration_seconds": 1.47,
      "text": "No hallucinations, thankfully."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 131.34,
      "end_seconds": 134.23,
      "duration_seconds": 2.89,
      "text": "Has your heart given you any trouble?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 135.94,
      "end_seconds": 137.5,
      "duration_seconds": 1.56,
      "text": "nothing like that"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 138.52,
      "end_seconds": 141.38,
      "duration_seconds": 2.86,
      "text": "Any muscle or joint problems besides this?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 142.55,
      "end_seconds": 144.71,
      "duration_seconds": 2.16,
      "text": "I move fine otherwise"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 145.59,
      "end_seconds": 147.97,
      "duration_seconds": 2.38,
      "text": "Let's start with the basic checks."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 159.01,
      "end_seconds": 161.51,
      "duration_seconds": 2.5,
      "text": "That's it, just a little longer..."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 181.37,
      "end_seconds": 188.48,
      "duration_seconds": 7.11,
      "text": "Okay: pressure 114 over 68, pulse 80, temperature is 36.7 degrees, oxygen saturation is 99 percent."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 190.83,
      "end_seconds": 195.73,
      "duration_seconds": 4.9,
      "text": "I'll need to examine you for this, it won't take long."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 197.19,
      "end_seconds": 200.0,
      "duration_seconds": 2.81,
      "text": "I'll listen to your chest now."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 212.76,
      "end_seconds": 220.74,
      "duration_seconds": 7.98,
      "text": "The memory test score is a little low today and the rest of the neurological check is normal."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 223.75,
      "end_seconds": 226.62,
      "duration_seconds": 2.87,
      "text": "Thank you, you can get dressed."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 237.75,
      "end_seconds": 252.4,
      "duration_seconds": 14.65,
      "text": "Right, here's what I'm thinking. This looks most like a gradual memory problem that needs further assessment. The reason I say that is that your story and my examination fit together."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 252.93,
      "end_seconds": 254.32,
      "duration_seconds": 1.39,
      "text": "is this permanent?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 255.22,
      "end_seconds": 265.64,
      "duration_seconds": 10.42,
      "text": "It's reasonable to be concerned, but right now a gradual memory problem that needs further assessment is my leading thought, not anything worse."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 282.22,
      "end_seconds": 300.87,
      "duration_seconds": 18.65,
      "text": "I'm going to to order blood tests, for memory loss. The result will help us decide whether anything more is needed. Keep a daily routine and write things down, a notebook by the door works well. I think the older adults' assessment service should see you too."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 302.45,
      "end_seconds": 303.92,
      "duration_seconds": 1.47,
      "text": "Alright, thank you."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 305.66,
      "end_seconds": 311.97,
      "duration_seconds": 6.31,
      "text": "Please don't wait if you become suddenly confused. That's when to be seen urgently."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 313.2,
      "end_seconds": 314.76,
      "duration_seconds": 1.56,
      "text": "Okay, makes sense."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 315.68,
      "end_seconds": 321.55,
      "duration_seconds": 5.87,
      "text": "Book a review after the results. I think we're done unless you have questions."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 322.25,
      "end_seconds": 325.32,
      "duration_seconds": 3.07,
      "text": "I think I understand everything. Thanks."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 327.12,
      "end_seconds": 328.32,
      "duration_seconds": 1.2,
      "text": "see you soon"
    }
  ]
}