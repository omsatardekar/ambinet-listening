  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.36,
      "end_seconds": 3.48,
      "duration_seconds": 2.12,
      "text": "afternoon, thanks for coming in"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 4.43,
      "end_seconds": 7.71,
      "duration_seconds": 3.28,
      "text": "Good morning, doctor, thank you."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 8.9,
      "end_seconds": 12.2,
      "duration_seconds": 3.3,
      "text": "so, start wherever you like, I'm listening"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 13.96,
      "end_seconds": 21.34,
      "duration_seconds": 7.38,
      "text": "Oh, I've been dealing with a dark patch with an uneven edge."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 23.35,
      "end_seconds": 27.09,
      "duration_seconds": 3.74,
      "text": "Can you tell me when it first started?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 28.52,
      "end_seconds": 32.16,
      "duration_seconds": 3.64,
      "text": "It's been four weeks, I'm fairly sure."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 33.11,
      "end_seconds": 36.42,
      "duration_seconds": 3.31,
      "text": "Have you noticed anything else alongside it?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 38.28,
      "end_seconds": 47.67,
      "duration_seconds": 9.39,
      "text": "Um, when it starts I tend to get a mole that is itching as well."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 61.48,
      "end_seconds": 69.32,
      "duration_seconds": 7.84,
      "text": "Have you noticed lumps in the armpit, other new moles, pain or family history of melanoma?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 70.7,
      "end_seconds": 79.95,
      "duration_seconds": 9.25,
      "text": "So, no, no lumps in the armpit, other new moles, pain or family history of melanoma."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 81.94,
      "end_seconds": 84.67,
      "duration_seconds": 2.73,
      "text": "How are your bowels, any trouble?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 86.15,
      "end_seconds": 87.87,
      "duration_seconds": 1.72,
      "text": "nothing unusual, no"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 89.39,
      "end_seconds": 91.85,
      "duration_seconds": 2.46,
      "text": "is your urine normal, no changes?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 93.94,
      "end_seconds": 95.67,
      "duration_seconds": 1.73,
      "text": "nothing there, no"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 96.8,
      "end_seconds": 100.67,
      "duration_seconds": 3.87,
      "text": "Are you taking anything regularly, including from the pharmacy?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 101.53,
      "end_seconds": 109.33,
      "duration_seconds": 7.8,
      "text": "It's something called napr... naproxen, 250 milligrams, maybe, twice a day for the knee pain."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 111.13,
      "end_seconds": 114.21,
      "duration_seconds": 3.08,
      "text": "Is the packet here, or the prescription?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 115.22,
      "end_seconds": 134.59,
      "duration_seconds": 19.37,
      "text": "so, uh, not with me. I'll bring it next time. Uh, I'm on bisoprolol, 2.5 milligrams, once a day for the heart rhythm. Yeah, I do miss it now and then, to be fair"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 138.28,
      "end_seconds": 139.21,
      "duration_seconds": 0.93,
      "text": "Any smoking?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 140.06,
      "end_seconds": 143.33,
      "duration_seconds": 3.27,
      "text": "I gave up cigarettes last spring"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 144.63,
      "end_seconds": 146.3,
      "duration_seconds": 1.67,
      "text": "do you drink alcohol?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 148.15,
      "end_seconds": 153.76,
      "duration_seconds": 5.61,
      "text": "I used to drink heavily but I stopped four years ago."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 155.28,
      "end_seconds": 158.11,
      "duration_seconds": 2.83,
      "text": "Do you work outside the the home?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 159.73,
      "end_seconds": 164.25,
      "duration_seconds": 4.52,
      "text": "I'm a hairdresser, on my feet all day"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 165.82,
      "end_seconds": 167.16,
      "duration_seconds": 1.34,
      "text": "Are you active?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 169.0,
      "end_seconds": 172.34,
      "duration_seconds": 3.34,
      "text": "I walk the dog every morning."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 173.02,
      "end_seconds": 174.8,
      "duration_seconds": 1.78,
      "text": "Who lives with you?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 175.53,
      "end_seconds": 178.02,
      "duration_seconds": 2.49,
      "text": "My partner and our baby."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 183.85,
      "end_seconds": 188.54,
      "duration_seconds": 4.69,
      "text": "Do you react to any medicines or foods? Any allergies?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 190.35,
      "end_seconds": 194.65,
      "duration_seconds": 4.3,
      "text": "I don't think I have any, no."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 204.93,
      "end_seconds": 209.52,
      "duration_seconds": 4.59,
      "text": "Any inherited conditions that you know of in the family?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 210.04,
      "end_seconds": 212.39,
      "duration_seconds": 2.35,
      "text": "My cousin has psoriasis."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 213.79,
      "end_seconds": 217.56,
      "duration_seconds": 3.77,
      "text": "any health conditions I should have on record?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 218.48,
      "end_seconds": 221.54,
      "duration_seconds": 3.06,
      "text": "I've got arthritis in my knees"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 223.57,
      "end_seconds": 224.31,
      "duration_seconds": 0.74,
      "text": "Mm-hmm."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 225.12,
      "end_seconds": 227.71,
      "duration_seconds": 2.59,
      "text": "I have an irregular heartbeat"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 229.66,
      "end_seconds": 238.68,
      "duration_seconds": 9.02,
      "text": "Right, so an irregular heartbeat is already on your record. We'll keep that in mind today. Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 243.46,
      "end_seconds": 245.94,
      "duration_seconds": 2.48,
      "text": "no, you know, never"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 247.73,
      "end_seconds": 256.98,
      "duration_seconds": 9.25,
      "text": "Okay, so the vitals from earlier. Temp 36.7 degrees, pressure 111 over 81, pulse is 70 beats a minute."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 258.25,
      "end_seconds": 258.95,
      "duration_seconds": 0.7,
      "text": "Thanks."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 261.08,
      "end_seconds": 265.82,
      "duration_seconds": 4.74,
      "text": "I'll need to examine you for this, it won't take long."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 266.72,
      "end_seconds": 269.47,
      "duration_seconds": 2.75,
      "text": "Stay as you are for a moment."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 286.94,
      "end_seconds": 291.43,
      "duration_seconds": 4.49,
      "text": "I can't feel any glands in the armpit or neck"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 295.67,
      "end_seconds": 309.64,
      "duration_seconds": 13.97,
      "text": "That's the examination finished. Okay, so my impression is this: This looks most like a pigmented lesion that needs removal for a proper diagnosis. An atypical mole is also on my list."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 311.16,
      "end_seconds": 315.9,
      "duration_seconds": 4.74,
      "text": "Mm, you know, what are the odds it's serious?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 317.58,
      "end_seconds": 331.56,
      "duration_seconds": 13.98,
      "text": "I understand the worry. At the moment I'd say it's a pigmented lesion that needs removal for a proper diagnosis, and we'll know more once the a skin biopsy is back."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 338.78,
      "end_seconds": 343.28,
      "duration_seconds": 4.5,
      "text": "Let's book a skin biopsy to look into changing mole."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 348.59,
      "end_seconds": 352.13,
      "duration_seconds": 3.54,
      "text": "Ah, when would that take place?"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 352.8,
      "end_seconds": 365.13,
      "duration_seconds": 12.33,
      "text": "Cover up and use factor 50 sunscreen on exposed skin. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 366.56,
      "end_seconds": 368.51,
      "duration_seconds": 1.95,
      "text": "I, I understand"
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 369.7,
      "end_seconds": 379.37,
      "duration_seconds": 9.67,
      "text": "Please don't wait if the mole bleeds or grows quickly. That's when to be seen urgently. Book a review after the biopsy results."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 381.0,
      "end_seconds": 383.55,
      "duration_seconds": 2.55,
      "text": "Yes, uh, that's manageable."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 384.66,
      "end_seconds": 389.17,
      "duration_seconds": 4.51,
      "text": "Right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 391.67,
      "end_seconds": 395.17,
      "duration_seconds": 3.5,
      "text": "thank you, uh, doctor, goodbye"
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 396.49,
      "end_seconds": 398.21,
      "duration_seconds": 1.72,
      "text": "Have a good day."
    }
  ]
}