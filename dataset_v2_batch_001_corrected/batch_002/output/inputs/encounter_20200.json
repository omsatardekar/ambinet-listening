{
  "schema_version": "1.0",
  "encounter_id": "20200",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.22,
      "end_seconds": 2.97,
      "duration_seconds": 1.75,
      "text": "Good afternoon, doctor."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 4.62,
      "end_seconds": 9.26,
      "duration_seconds": 4.64,
      "text": "Not at all, please sit. What seems to be wrong?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 10.49,
      "end_seconds": 13.84,
      "duration_seconds": 3.35,
      "text": "I've been dealing with a twisted ankle."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 14.64,
      "end_seconds": 18.14,
      "duration_seconds": 3.5,
      "text": "How many days or weeks has it been?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 20.13,
      "end_seconds": 24.01,
      "duration_seconds": 3.88,
      "text": "I've had it for about two weeks."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 24.57,
      "end_seconds": 26.87,
      "duration_seconds": 2.3,
      "text": "Does anything set it off?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 27.39,
      "end_seconds": 41.04,
      "duration_seconds": 13.65,
      "text": "Putting weight on it definitely sets it off. I've also had pain walking. With pain walking, it happens a couple of times a week."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 43.82,
      "end_seconds": 45.88,
      "duration_seconds": 2.06,
      "text": "May I examine you now?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 47.87,
      "end_seconds": 50.72,
      "duration_seconds": 2.85,
      "text": "I'll listen to your chest now."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 66.36,
      "end_seconds": 75.29,
      "duration_seconds": 8.93,
      "text": "There is swelling and bruising over the outer ankle and I can't find any bony tenderness at the back of the ankle bone."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 78.91,
      "end_seconds": 80.64,
      "duration_seconds": 1.73,
      "text": "That's the examination finished."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 89.03,
      "end_seconds": 96.92,
      "duration_seconds": 7.89,
      "text": "Did you get pain at the base of the fifth toe, previous fracture or cracking sound at the time?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 98.67,
      "end_seconds": 102.81,
      "duration_seconds": 4.14,
      "text": "No, um, none of those at all."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 104.59,
      "end_seconds": 107.9,
      "duration_seconds": 3.31,
      "text": "Anything with your nerves, like weakness or numbness?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 109.79,
      "end_seconds": 111.22,
      "duration_seconds": 1.43,
      "text": "Nothing odd there."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 123.11,
      "end_seconds": 126.94,
      "duration_seconds": 3.83,
      "text": "Let me ask about allergies, anything at all?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 127.64,
      "end_seconds": 130.89,
      "duration_seconds": 3.25,
      "text": "I don't think I have any, no."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 132.93,
      "end_seconds": 136.57,
      "duration_seconds": 3.64,
      "text": "Okay, any regular medication, tablets or creams?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 137.3,
      "end_seconds": 140.23,
      "duration_seconds": 2.93,
      "text": "No, I'm not on anything."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 140.86,
      "end_seconds": 144.79,
      "duration_seconds": 3.93,
      "text": "Do you have any medical conditions I should know about?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 146.65,
      "end_seconds": 150.12,
      "duration_seconds": 3.47,
      "text": "No, I've always been fairly healthy."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 151.53,
      "end_seconds": 153.58,
      "duration_seconds": 2.05,
      "text": "Do you get out much?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 155.48,
      "end_seconds": 160.1,
      "duration_seconds": 4.62,
      "text": "Not much, I mostly stay in these days."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 160.89,
      "end_seconds": 164.2,
      "duration_seconds": 3.31,
      "text": "Are you in work at the moment?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 166.27,
      "end_seconds": 170.5,
      "duration_seconds": 4.23,
      "text": "Yes, I work in a bakery, early starts."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 173.26,
      "end_seconds": 176.44,
      "duration_seconds": 3.18,
      "text": "Does your family have any medical conditions?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 177.74,
      "end_seconds": 180.4,
      "duration_seconds": 2.66,
      "text": "My grandfather had a stroke."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 181.29,
      "end_seconds": 189.21,
      "duration_seconds": 7.92,
      "text": "Okay, thinking it through, the most likely explanation is an ankle sprain without signs of a fracture."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 190.62,
      "end_seconds": 192.74,
      "duration_seconds": 2.12,
      "text": "Will it clear up?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 193.73,
      "end_seconds": 221.05,
      "duration_seconds": 27.32,
      "text": "I understand the worry. At the moment I'd say it's an ankle sprain without signs of a fracture, and we'll know more once the an ankle X-ray is back. Let me repeat that back to make sure. You've had a twisted ankle for about two weeks, and no pain at the base of the fifth toe or cracking sound at the time."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 222.55,
      "end_seconds": 224.51,
      "duration_seconds": 1.96,
      "text": "That's what happened, yes."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 238.96,
      "end_seconds": 243.65,
      "duration_seconds": 4.69,
      "text": "Let's book an ankle X-ray to look into ankle injury."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 247.55,
      "end_seconds": 249.87,
      "duration_seconds": 2.32,
      "text": "Do I need to prepare?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 251.45,
      "end_seconds": 279.73,
      "duration_seconds": 28.28,
      "text": "You'll be taking paracetamol, 1 gram, every six hours if needed, for five days. You take it by mouth. It's for ankle pain. Rest, ice, a firm bandage and keep it raised, and start gentle movement after two days. If you cannot put any weight on it or the foot goes numb, or you feel really unwell, please come to the emergency department."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 281.12,
      "end_seconds": 284.12,
      "duration_seconds": 3.0,
      "text": "I know what to watch for."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 286.01,
      "end_seconds": 288.52,
      "duration_seconds": 2.51,
      "text": "We'll catch up in two weeks."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 290.21,
      "end_seconds": 291.84,
      "duration_seconds": 1.63,
      "text": "Yes, that's manageable."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 292.37,
      "end_seconds": 295.96,
      "duration_seconds": 3.59,
      "text": "Anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 297.82,
      "end_seconds": 301.59,
      "duration_seconds": 3.77,
      "text": "Okay, that makes sense. Thanks for explaining."
    }
  ]
}