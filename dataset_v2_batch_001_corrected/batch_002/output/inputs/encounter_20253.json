{
  "schema_version": "1.0",
  "encounter_id": "20253",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.98,
      "end_seconds": 3.72,
      "duration_seconds": 2.74,
      "text": "Hello, come in. Mind the step."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 5.77,
      "end_seconds": 6.93,
      "duration_seconds": 1.16,
      "text": "Hi, thanks."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 8.85,
      "end_seconds": 10.29,
      "duration_seconds": 1.44,
      "text": "What's the problem?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 11.15,
      "end_seconds": 14.31,
      "duration_seconds": 3.16,
      "text": "It's a band-like headache, mostly."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 15.25,
      "end_seconds": 18.79,
      "duration_seconds": 3.54,
      "text": "Shall I check your blood pressure and pulse?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 31.08,
      "end_seconds": 34.64,
      "duration_seconds": 3.56,
      "text": "Right, bear with me while this finishes..."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 53.24,
      "end_seconds": 61.57,
      "duration_seconds": 8.33,
      "text": "Okay: blood pressure 128 over 77, pulse 84, SpO2 97 percent on room air. Alright, did it come on recently?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 63.39,
      "end_seconds": 71.0,
      "duration_seconds": 7.61,
      "text": "It's been three weeks now. I thought it would sort itself out, but it hasn't."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 72.55,
      "end_seconds": 82.85,
      "duration_seconds": 10.3,
      "text": "Tell me a bit more about it: how bad it gets, how often, and whether anything makes it better or worse."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 86.92,
      "end_seconds": 101.88,
      "duration_seconds": 14.96,
      "text": "I get some relief from paracetamol. It sort of comes and goes. Oh, um, and a stiff neck. That's been about the same, about a month."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 105.52,
      "end_seconds": 109.36,
      "duration_seconds": 3.84,
      "text": "Alright, have you had a bit of nausea?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 111.29,
      "end_seconds": 115.91,
      "duration_seconds": 4.62,
      "text": "Oh, yes, about the same, about a year."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 117.96,
      "end_seconds": 121.06,
      "duration_seconds": 3.1,
      "text": "How much trouble does it give you?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 122.13,
      "end_seconds": 123.86,
      "duration_seconds": 1.73,
      "text": "I'd say severe."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 124.38,
      "end_seconds": 129.34,
      "duration_seconds": 4.96,
      "text": "I follow. Any weakness, head injury, vomiting or fever at all?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 131.15,
      "end_seconds": 137.22,
      "duration_seconds": 6.07,
      "text": "I, I haven't had weakness, head injury, vomiting or fever, no."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 141.55,
      "end_seconds": 145.37,
      "duration_seconds": 3.82,
      "text": "And jaw pain on chewing, any of that?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 146.36,
      "end_seconds": 150.18,
      "duration_seconds": 3.82,
      "text": "Nope, no jaw pain on chewing."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 151.41,
      "end_seconds": 155.01,
      "duration_seconds": 3.6,
      "text": "Anything on the skin I should know about?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 156.63,
      "end_seconds": 157.72,
      "duration_seconds": 1.09,
      "text": "No rashes."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 158.22,
      "end_seconds": 160.66,
      "duration_seconds": 2.44,
      "text": "Is your chest okay generally?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 161.83,
      "end_seconds": 165.81,
      "duration_seconds": 3.98,
      "text": "Let me think, no problems with breathing."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 166.92,
      "end_seconds": 169.65,
      "duration_seconds": 2.73,
      "text": "Before we go further, any allergies?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 170.87,
      "end_seconds": 175.89,
      "duration_seconds": 5.02,
      "text": "No, you know, not that I know of."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 177.97,
      "end_seconds": 179.95,
      "duration_seconds": 1.98,
      "text": "Any surgery in the past?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 181.84,
      "end_seconds": 186.94,
      "duration_seconds": 5.1,
      "text": "Yes, I had a varicose vein procedure, last year."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 197.31,
      "end_seconds": 201.68,
      "duration_seconds": 4.37,
      "text": "Tell me about any past illnesses or ongoing conditions."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 203.34,
      "end_seconds": 205.74,
      "duration_seconds": 2.4,
      "text": "I've had anxiety, yes."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 222.41,
      "end_seconds": 225.36,
      "duration_seconds": 2.95,
      "text": "Are there any illnesses in your family?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 227.37,
      "end_seconds": 229.93,
      "duration_seconds": 2.56,
      "text": "My aunt has rheumatoid arthritis."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 230.6,
      "end_seconds": 232.86,
      "duration_seconds": 2.26,
      "text": "Do you get out much?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 236.74,
      "end_seconds": 241.11,
      "duration_seconds": 4.37,
      "text": "Not much, I mostly stay in these days."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 242.99,
      "end_seconds": 244.16,
      "duration_seconds": 1.17,
      "text": "What's your work?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 245.54,
      "end_seconds": 250.18,
      "duration_seconds": 4.64,
      "text": "I'm a plumber, lots of bending and kneeling."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 255.62,
      "end_seconds": 258.91,
      "duration_seconds": 3.29,
      "text": "Alright, are you on your own at home?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 260.75,
      "end_seconds": 263.96,
      "duration_seconds": 3.21,
      "text": "I live with my elderly mother."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 271.3,
      "end_seconds": 275.26,
      "duration_seconds": 3.96,
      "text": "Are you taking anything regularly, including from the pharmacy?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 276.15,
      "end_seconds": 280.79,
      "duration_seconds": 4.64,
      "text": "Escitalopram. I take it 10 milligrams, once a day."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 281.05,
      "end_seconds": 281.75,
      "duration_seconds": 0.7,
      "text": "Yes."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 283.23,
      "end_seconds": 287.73,
      "duration_seconds": 4.5,
      "text": "I'll need to examine you for this, it won't take long."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 288.4,
      "end_seconds": 289.61,
      "duration_seconds": 1.21,
      "text": "Of course."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 290.42,
      "end_seconds": 292.41,
      "duration_seconds": 1.99,
      "text": "Tell me if that's sore."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 300.44,
      "end_seconds": 306.28,
      "duration_seconds": 5.84,
      "text": "Neck muscles are tight and tender, and the eye and limb checks are normal."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 312.02,
      "end_seconds": 323.02,
      "duration_seconds": 11.0,
      "text": "Please sit back down. I think a headache diary makes sense here, for frequent headaches. Okay, have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 326.63,
      "end_seconds": 330.14,
      "duration_seconds": 3.51,
      "text": "Great, thank you for your help."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 331.66,
      "end_seconds": 333.46,
      "duration_seconds": 1.8,
      "text": "Okay, see you soon."
    }
  ]
}