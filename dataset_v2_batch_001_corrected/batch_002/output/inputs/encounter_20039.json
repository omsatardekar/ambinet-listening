{
  "schema_version": "1.0",
  "encounter_id": "20039",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.15,
      "end_seconds": 4.47,
      "duration_seconds": 3.32,
      "text": "hi doctor, am I too early?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.02,
      "end_seconds": 11.81,
      "duration_seconds": 3.79,
      "text": "Come in. Please sit. How can I help you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 12.62,
      "end_seconds": 17.27,
      "duration_seconds": 4.65,
      "text": "Hello, doctor, I came in with them, if that's okay."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 20.6,
      "end_seconds": 24.37,
      "duration_seconds": 3.77,
      "text": "Good, that'll be useful. Pull up a chair."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 24.88,
      "end_seconds": 28.28,
      "duration_seconds": 3.4,
      "text": "I'm here cos of the room spinning."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 29.59,
      "end_seconds": 32.86,
      "duration_seconds": 3.27,
      "text": "how many days or weeks has it been?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 34.66,
      "end_seconds": 37.31,
      "duration_seconds": 2.65,
      "text": "I'd say a week, maybe"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_4",
      "role": "FAMILY_MEMBER",
      "start_seconds": 39.32,
      "end_seconds": 43.74,
      "duration_seconds": 4.42,
      "text": "I think it's been nearer two weeks, actually"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 45.55,
      "end_seconds": 49.82,
      "duration_seconds": 4.27,
      "text": "okay, so roughly one to two weeks is that right?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 51.6,
      "end_seconds": 54.76,
      "duration_seconds": 3.16,
      "text": "Yes, uh, somewhere around that."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 56.68,
      "end_seconds": 59.83,
      "duration_seconds": 3.15,
      "text": "What do you do to make it better?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 60.66,
      "end_seconds": 64.37,
      "duration_seconds": 3.71,
      "text": "It It settles a little with lying still."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 66.17,
      "end_seconds": 71.29,
      "duration_seconds": 5.12,
      "text": "Is it there all the time or does it come and go?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 72.99,
      "end_seconds": 76.15,
      "duration_seconds": 3.16,
      "text": "honestly, a few times a day"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 76.84,
      "end_seconds": 79.0,
      "duration_seconds": 2.16,
      "text": "Does anything set it off?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 79.86,
      "end_seconds": 84.6,
      "duration_seconds": 4.74,
      "text": "It's worse with lying down and turning my head."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 86.42,
      "end_seconds": 89.16,
      "duration_seconds": 2.74,
      "text": "How much does it limit you?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 89.95,
      "end_seconds": 93.5,
      "duration_seconds": 3.55,
      "text": "A five out of ten, I suppose."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 93.95,
      "end_seconds": 100.26,
      "duration_seconds": 6.31,
      "text": "And the other thing I wanted to mention is that I can't really—"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 100.36,
      "end_seconds": 105.24,
      "duration_seconds": 4.88,
      "text": "Tell the doctor about the other thing, that's what worries me."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 106.13,
      "end_seconds": 113.58,
      "duration_seconds": 7.45,
      "text": "Yeah, you know, I was getting to that! And And a recent cold, too."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 114.37,
      "end_seconds": 120.32,
      "duration_seconds": 5.95,
      "text": "have you had the room spinning before, or is this the first time?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 125.59,
      "end_seconds": 131.93,
      "duration_seconds": 6.34,
      "text": "a bit, about six months ago it it settled by itself back then"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_5",
      "role": "UNKNOWN",
      "start_seconds": 132.68,
      "end_seconds": 135.69,
      "duration_seconds": 3.01,
      "text": "Mm, that's what happened, yes."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 136.76,
      "end_seconds": 140.99,
      "duration_seconds": 4.23,
      "text": "Any hearing loss, weakness, headache or slurred speech at all?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 142.35,
      "end_seconds": 153.68,
      "duration_seconds": 11.33,
      "text": "No, no hearing loss, no weakness, no headache. I did have being unsteady at one point, but that went away on its own."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 154.2,
      "end_seconds": 159.07,
      "duration_seconds": 4.87,
      "text": "Have you had any ringing in the ears or double vision?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 159.75,
      "end_seconds": 162.69,
      "duration_seconds": 2.94,
      "text": "No, none that I've noticed."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 164.15,
      "end_seconds": 167.73,
      "duration_seconds": 3.58,
      "text": "How about your heart, any problems like that?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 168.58,
      "end_seconds": 172.8,
      "duration_seconds": 4.22,
      "text": "My heart's been fine, as far as I know."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 174.76,
      "end_seconds": 178.64,
      "duration_seconds": 3.88,
      "text": "Alright, any muscle or joint problems besides this?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 180.23,
      "end_seconds": 181.79,
      "duration_seconds": 1.56,
      "text": "Nothing else aches."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 195.11,
      "end_seconds": 197.65,
      "duration_seconds": 2.54,
      "text": "Do you have any long-term conditions?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 198.53,
      "end_seconds": 211.56,
      "duration_seconds": 13.03,
      "text": "High blood pressure, for about a year. I have diabetes, for about ten years. I have arthritis in my knees, for about a year."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 221.32,
      "end_seconds": 226.25,
      "duration_seconds": 4.93,
      "text": "Do you react to any medicines or foods? Any allergies?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 227.45,
      "end_seconds": 229.24,
      "duration_seconds": 1.79,
      "text": "No allergies at all."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 231.23,
      "end_seconds": 234.0,
      "duration_seconds": 2.77,
      "text": "What's on your current medicine list?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 235.94,
      "end_seconds": 240.13,
      "duration_seconds": 4.19,
      "text": "I take telmisartan, 40 milligrams, once a day."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 242.33,
      "end_seconds": 250.23,
      "duration_seconds": 7.9,
      "text": "It's meant to be once a day, though I don't see she take it every time."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 253.84,
      "end_seconds": 259.64,
      "duration_seconds": 5.8,
      "text": "I'm on metformin, 500 milligrams, twice a day for my sugar."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 264.56,
      "end_seconds": 268.95,
      "duration_seconds": 4.39,
      "text": "What about your parents, brothers or sisters, any conditions?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 270.97,
      "end_seconds": 273.12,
      "duration_seconds": 2.15,
      "text": "My brother has epilepsy."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 274.21,
      "end_seconds": 277.0,
      "duration_seconds": 2.79,
      "text": "A few questions about your lifestyle now."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 278.2,
      "end_seconds": 292.18,
      "duration_seconds": 13.98,
      "text": "I'll have a glass of wine with dinner. No, I've never smoked in my life. I hardly move around during the day. I work in accounts at a hospital"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 292.78,
      "end_seconds": 295.3,
      "duration_seconds": 2.52,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 297.1,
      "end_seconds": 299.63,
      "duration_seconds": 2.53,
      "text": "No surgery, um, no."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 300.23,
      "end_seconds": 303.32,
      "duration_seconds": 3.09,
      "text": "Time for your numbers, if that's okay."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 316.47,
      "end_seconds": 318.78,
      "duration_seconds": 2.31,
      "text": "Okay, this won't take long..."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 333.82,
      "end_seconds": 341.62,
      "duration_seconds": 7.8,
      "text": "Okay: pulse 71, SpO2 99 percent on room air, BP is 112 over 75, temperature 36.7."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 343.1,
      "end_seconds": 345.52,
      "duration_seconds": 2.42,
      "text": "Shall I start the examination?"
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 346.71,
      "end_seconds": 348.73,
      "duration_seconds": 2.02,
      "text": "Okay, does that hurt?"
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 364.96,
      "end_seconds": 373.71,
      "duration_seconds": 8.75,
      "text": "I can see a fine jerking of the eyes to the left and your walking is a little unsteady"
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 374.22,
      "end_seconds": 375.8,
      "duration_seconds": 1.58,
      "text": "Yeah, no problem."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 379.47,
      "end_seconds": 405.07,
      "duration_seconds": 25.6,
      "text": "that's the examination finished putting it all together, this is probably an inner-ear balance problem such as vestibular neuritis we shouldn't forget a problem in the brain stem i'll request blood tests, it'll help with dizziness i want a positional test done, that's for vertigo i'm prescribing prochlorperazine, 5 milligrams, three times a day, for three days that should help with nausea and vertigo"
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 407.12,
      "end_seconds": 419.66,
      "duration_seconds": 12.54,
      "text": "Start moving around gently as soon as you can, since resting too long slows recovery. I'd like you to see the balance clinic as well, and I'll write the referral."
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 421.2,
      "end_seconds": 421.9,
      "duration_seconds": 0.7,
      "text": "Okay."
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 423.44,
      "end_seconds": 435.51,
      "duration_seconds": 12.07,
      "text": "the thing that would worry me is if you get double vision, weakness or trouble speaking. If that happens, go to emergency. Does all of that make sense?"
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 436.59,
      "end_seconds": 439.68,
      "duration_seconds": 3.09,
      "text": "thank you, um, doctor, goodbye"
    }
  ]
}