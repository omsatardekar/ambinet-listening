{
  "schema_version": "1.0",
  "encounter_id": "20403",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.87,
      "end_seconds": 2.6,
      "duration_seconds": 1.73,
      "text": "Good afternoon, doctor."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 3.26,
      "end_seconds": 7.74,
      "duration_seconds": 4.48,
      "text": "Right, come in. Please sit. How can I help you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 9.51,
      "end_seconds": 13.37,
      "duration_seconds": 3.86,
      "text": "Well, I've been having swelling of my lips."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 14.59,
      "end_seconds": 17.72,
      "duration_seconds": 3.13,
      "text": "Would you say mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 18.99,
      "end_seconds": 29.88,
      "duration_seconds": 10.89,
      "text": "A five out of ten, I suppose. There was an itchy rash all over, yes, but that went away."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 31.23,
      "end_seconds": 37.19,
      "duration_seconds": 5.96,
      "text": "Have you had swelling of your lips before, or is this the first time?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 38.56,
      "end_seconds": 44.93,
      "duration_seconds": 6.37,
      "text": "A bit, a couple of years ago. It settled by itself back then."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 45.78,
      "end_seconds": 59.24,
      "duration_seconds": 13.46,
      "text": "Okay, so the vitals from earlier. Height 180 centimetres, weight 70 kilos. Blood pressure 108 over 79, heart rate 65, BMI works out to 21.6, SpO2 99 percent on room air."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 59.86,
      "end_seconds": 60.56,
      "duration_seconds": 0.7,
      "text": "Thanks."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 62.89,
      "end_seconds": 66.42,
      "duration_seconds": 3.53,
      "text": "Could you come over to the couch, please?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 67.36,
      "end_seconds": 69.32,
      "duration_seconds": 1.96,
      "text": "Let me feel here."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 85.51,
      "end_seconds": 94.93,
      "duration_seconds": 9.42,
      "text": "There are raised pink welts on the trunk and arms, the lips are a little puffy, and the tongue and throat look normal."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 98.94,
      "end_seconds": 103.72,
      "duration_seconds": 4.78,
      "text": "Please sit back down. Have you had any wheeze or fainting?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 108.5,
      "end_seconds": 112.58,
      "duration_seconds": 4.08,
      "text": "No wheeze or fainting, none of it."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 113.96,
      "end_seconds": 118.2,
      "duration_seconds": 4.24,
      "text": "And what about throat tightness, trouble breathing or vomiting?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 119.08,
      "end_seconds": 121.74,
      "duration_seconds": 2.66,
      "text": "No, none that I've noticed."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 122.01,
      "end_seconds": 126.24,
      "duration_seconds": 4.23,
      "text": "I see, go ahead. Is your urine normal, no changes?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 126.78,
      "end_seconds": 128.15,
      "duration_seconds": 1.37,
      "text": "No changes there."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 129.54,
      "end_seconds": 131.72,
      "duration_seconds": 2.18,
      "text": "Is your mobility otherwise okay?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 136.75,
      "end_seconds": 138.56,
      "duration_seconds": 1.81,
      "text": "I move fine otherwise."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 139.96,
      "end_seconds": 142.73,
      "duration_seconds": 2.77,
      "text": "Do you have any chronic illnesses?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 143.66,
      "end_seconds": 147.4,
      "duration_seconds": 3.74,
      "text": "I've had asthma for about a year now."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 149.18,
      "end_seconds": 155.55,
      "duration_seconds": 6.37,
      "text": "Mm-hmm. Right, so asthma is already on your record. We'll keep that in mind today."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 169.1,
      "end_seconds": 172.82,
      "duration_seconds": 3.72,
      "text": "What do you take on a normal day?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 173.93,
      "end_seconds": 177.22,
      "duration_seconds": 3.29,
      "text": "I take Seretide inhaler, twice a day."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 178.71,
      "end_seconds": 181.69,
      "duration_seconds": 2.98,
      "text": "How long has that been going on?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 182.97,
      "end_seconds": 190.31,
      "duration_seconds": 7.34,
      "text": "For nearly five years. Cetirizine. I take it 10 milligrams, when it flares."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 190.84,
      "end_seconds": 195.94,
      "duration_seconds": 5.1,
      "text": "Sure. What about your parents, brothers or sisters, any conditions?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 201.98,
      "end_seconds": 204.08,
      "duration_seconds": 2.1,
      "text": "My brother has epilepsy."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 204.88,
      "end_seconds": 208.19,
      "duration_seconds": 3.31,
      "text": "Let me ask about allergies, anything at all?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 209.91,
      "end_seconds": 219.62,
      "duration_seconds": 9.71,
      "text": "Yes, cat fur. I've no idea what the reaction was, only that I'm not supposed to have it."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 220.68,
      "end_seconds": 225.17,
      "duration_seconds": 4.49,
      "text": "Let's talk a little about your daily life and habits."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 226.33,
      "end_seconds": 236.99,
      "duration_seconds": 10.66,
      "text": "Not much, I mostly stay in these days. My husband and I live above the shop. I look after my grandchildren most days."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 247.89,
      "end_seconds": 250.33,
      "duration_seconds": 2.44,
      "text": "Anything surgical in your history?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 251.71,
      "end_seconds": 258.36,
      "duration_seconds": 6.65,
      "text": "I had a mole taken off my arm a few years ago."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 273.74,
      "end_seconds": 301.56,
      "duration_seconds": 27.82,
      "text": "What I'm giving you is chlorphenamine, 4 milligrams, every six hours, for three days. You take it by mouth. It's for allergic rash. I'm going to put you on prednisolone, 30 milligrams, once a day, for three days. That's for allergic reaction. Stop the new tablet until we know what caused it and write down every medicine you took in the last week. We'll catch up in two days."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 303.51,
      "end_seconds": 305.53,
      "duration_seconds": 2.02,
      "text": "I can manage that."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 306.84,
      "end_seconds": 310.48,
      "duration_seconds": 3.64,
      "text": "That's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 312.05,
      "end_seconds": 314.31,
      "duration_seconds": 2.26,
      "text": "Alright, thanks, take care."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 315.28,
      "end_seconds": 317.17,
      "duration_seconds": 1.89,
      "text": "So, see you soon."
    }
  ]
}