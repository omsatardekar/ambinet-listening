{
  "schema_version": "1.0",
  "encounter_id": "20256",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.6,
      "end_seconds": 7.98,
      "duration_seconds": 7.38,
      "text": "Hello doctor, sorry, I took a wrong turn on the way here."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.87,
      "end_seconds": 12.87,
      "duration_seconds": 4.0,
      "text": "Yes, have a seat. Tell me what's going on."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 14.39,
      "end_seconds": 26.89,
      "duration_seconds": 12.5,
      "text": "Ah, so the thing is, I've got sharp pain in the upper right of my tummy. My sister suggested writing things down, but I forgot."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 28.2,
      "end_seconds": 31.58,
      "duration_seconds": 3.38,
      "text": "Shall I check your blood pressure and pulse?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 42.06,
      "end_seconds": 44.23,
      "duration_seconds": 2.17,
      "text": "Nearly done with the readings..."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 60.89,
      "end_seconds": 67.49,
      "duration_seconds": 6.6,
      "text": "Okay: pulse 72, saturation 97 percent. And BP is 114 over 72, temperature 36.7."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 68.45,
      "end_seconds": 70.25,
      "duration_seconds": 1.8,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 72.08,
      "end_seconds": 78.68,
      "duration_seconds": 6.6,
      "text": "We'll look at it together shortly. Right, has this been going on for long?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 79.41,
      "end_seconds": 82.62,
      "duration_seconds": 3.21,
      "text": "Ever since... since last night, really."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 84.54,
      "end_seconds": 89.33,
      "duration_seconds": 4.79,
      "text": "Okay, give me more detail on it, whatever comes to mind."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 91.22,
      "end_seconds": 104.99,
      "duration_seconds": 13.77,
      "text": "Hmm, yes, fatty meals. That makes it worse. Severe, I'd say. Let me think, I've also had nausea after meals. And a bit of vomiting, too."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 106.26,
      "end_seconds": 107.94,
      "duration_seconds": 1.68,
      "text": "How about yellow eyes?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 109.15,
      "end_seconds": 111.26,
      "duration_seconds": 2.11,
      "text": "No, no yellow eyes."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 112.67,
      "end_seconds": 116.8,
      "duration_seconds": 4.13,
      "text": "Did you get dark urine, black stools or fever?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 117.37,
      "end_seconds": 121.6,
      "duration_seconds": 4.23,
      "text": "No, no dark urine, black stools or fever."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 125.33,
      "end_seconds": 128.34,
      "duration_seconds": 3.01,
      "text": "Has your heart given you any trouble?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 129.09,
      "end_seconds": 133.22,
      "duration_seconds": 4.13,
      "text": "Okay, so no, nothing with my heart."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 133.95,
      "end_seconds": 138.46,
      "duration_seconds": 4.51,
      "text": "Are you taking anything regularly, including from the pharmacy?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 139.77,
      "end_seconds": 144.05,
      "duration_seconds": 4.28,
      "text": "Atorvastatin. I take it 20 milligrams, at night."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 145.25,
      "end_seconds": 147.61,
      "duration_seconds": 2.36,
      "text": "When did you start it?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 149.02,
      "end_seconds": 157.79,
      "duration_seconds": 8.77,
      "text": "For about three months. Yeah, I had simvastatin at one point, but I'm off it now."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 173.06,
      "end_seconds": 175.52,
      "duration_seconds": 2.46,
      "text": "Do you have any long-term conditions?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 176.75,
      "end_seconds": 179.8,
      "duration_seconds": 3.05,
      "text": "High cholesterol, for five years."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 181.01,
      "end_seconds": 194.8,
      "duration_seconds": 13.79,
      "text": "I see, go ahead. Right, so high cholesterol is already on your record. We'll keep that in mind today. Let's talk a little about your daily life and habits."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 195.97,
      "end_seconds": 214.44,
      "duration_seconds": 18.47,
      "text": "I used to drink heavily but I stopped four years ago. I work in accounts at a hospital. I drink a lot of tea and snack through the day. No, I share a house with my brother."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 216.26,
      "end_seconds": 219.13,
      "duration_seconds": 2.87,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 220.85,
      "end_seconds": 225.91,
      "duration_seconds": 5.06,
      "text": "Let me think, no, I've never been operated on."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 227.02,
      "end_seconds": 230.53,
      "duration_seconds": 3.51,
      "text": "Okay, time for me to examine you."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 232.47,
      "end_seconds": 235.09,
      "duration_seconds": 2.62,
      "text": "Take a deep breath for me."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 244.77,
      "end_seconds": 252.76,
      "duration_seconds": 7.99,
      "text": "There is tenderness under the right ribs when you breathe in, and no yellowing of the eyes."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 256.02,
      "end_seconds": 259.47,
      "duration_seconds": 3.45,
      "text": "Alright, that's all I needed to check."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 271.67,
      "end_seconds": 281.23,
      "duration_seconds": 9.56,
      "text": "So, based on the history and the examination, I think we're dealing with biliary colic from gallstones at this stage."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 291.25,
      "end_seconds": 320.61,
      "duration_seconds": 29.36,
      "text": "I want an ultrasound of the tummy done, that's for right upper quadrant pain. Let's get liver blood tests, for upper abdominal pain. For this, diclofenac, 50 milligrams, three times a day if needed, for three days. You take it by mouth. That's for gallbladder pain. Keep meals small and low in fat until we have the scan. The surgeons would be the right next step, I'll refer you."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 326.27,
      "end_seconds": 338.11,
      "duration_seconds": 11.84,
      "text": "If you develop a fever, yellow eyes or severe constant pain, that's the point to come in urgently. Come back in two weeks. That's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 339.71,
      "end_seconds": 342.57,
      "duration_seconds": 2.86,
      "text": "So, alright, thanks, take care."
    }
  ]
}