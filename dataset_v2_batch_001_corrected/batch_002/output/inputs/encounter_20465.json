{
  "schema_version": "1.0",
  "encounter_id": "20465",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.07,
      "end_seconds": 4.98,
      "duration_seconds": 3.91,
      "text": "Ah, morning, doctor. Lovely to meet you."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.32,
      "end_seconds": 10.62,
      "duration_seconds": 4.3,
      "text": "No problem at all, come in. What's troubling you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 12.17,
      "end_seconds": 19.83,
      "duration_seconds": 7.66,
      "text": "Let me think, so the thing is, I've got red, cracked skin on my hands."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 20.4,
      "end_seconds": 24.17,
      "duration_seconds": 3.77,
      "text": "Right, can you tell me when it first started?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 26.17,
      "end_seconds": 29.58,
      "duration_seconds": 3.41,
      "text": "For about a month, I'd say."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 29.8,
      "end_seconds": 34.72,
      "duration_seconds": 4.92,
      "text": "Okay, go on. How troublesome is it day to day?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 35.45,
      "end_seconds": 39.57,
      "duration_seconds": 4.12,
      "text": "I'd give it a four, out of ten."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 40.4,
      "end_seconds": 42.47,
      "duration_seconds": 2.07,
      "text": "Have you noticed any triggers?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 43.99,
      "end_seconds": 47.9,
      "duration_seconds": 3.91,
      "text": "Washing hands and gloves definitely sets it off."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 48.63,
      "end_seconds": 52.74,
      "duration_seconds": 4.11,
      "text": "What about dry flaky skin, have you noticed that?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 53.54,
      "end_seconds": 59.19,
      "duration_seconds": 5.65,
      "text": "Yes, I have. As for dry flaky skin, moisturiser helps a bit."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 75.94,
      "end_seconds": 80.55,
      "duration_seconds": 4.61,
      "text": "Any new soap or cream, rash elsewhere or oozing at all?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 81.95,
      "end_seconds": 86.84,
      "duration_seconds": 4.89,
      "text": "No, no new soap or cream, rash elsewhere or oozing."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 87.74,
      "end_seconds": 91.62,
      "duration_seconds": 3.88,
      "text": "On the cardiac side, anything I should know?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 93.7,
      "end_seconds": 95.63,
      "duration_seconds": 1.93,
      "text": "No, that's been fine."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 97.27,
      "end_seconds": 100.33,
      "duration_seconds": 3.06,
      "text": "Any muscle or joint problems besides this?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 102.03,
      "end_seconds": 104.15,
      "duration_seconds": 2.12,
      "text": "No, joints are fine."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 121.67,
      "end_seconds": 126.79,
      "duration_seconds": 5.12,
      "text": "So, are you allergic to anything? Any allergies to medicines or foods?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 127.95,
      "end_seconds": 131.46,
      "duration_seconds": 3.51,
      "text": "No, I'm not allergic to anything."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 133.21,
      "end_seconds": 138.19,
      "duration_seconds": 4.98,
      "text": "So, do you have any medical conditions I should know about?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 143.37,
      "end_seconds": 144.95,
      "duration_seconds": 1.58,
      "text": "No, no conditions."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 146.65,
      "end_seconds": 148.05,
      "duration_seconds": 1.4,
      "text": "Do you smoke?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 152.86,
      "end_seconds": 155.96,
      "duration_seconds": 3.1,
      "text": "I gave up cigarettes last spring."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 156.81,
      "end_seconds": 158.16,
      "duration_seconds": 1.35,
      "text": "Are you active?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 159.19,
      "end_seconds": 162.12,
      "duration_seconds": 2.93,
      "text": "I walk the dog every morning."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 162.88,
      "end_seconds": 165.25,
      "duration_seconds": 2.37,
      "text": "Do you follow any particular diet?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 166.63,
      "end_seconds": 170.14,
      "duration_seconds": 3.51,
      "text": "I'm vegetarian and have been for years."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 171.46,
      "end_seconds": 173.6,
      "duration_seconds": 2.14,
      "text": "Any regular medication at all?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 174.12,
      "end_seconds": 176.5,
      "duration_seconds": 2.38,
      "text": "No, nothing at the moment."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 177.42,
      "end_seconds": 180.33,
      "duration_seconds": 2.91,
      "text": "I'll note down your vital signs first."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 189.58,
      "end_seconds": 191.66,
      "duration_seconds": 2.08,
      "text": "Okay, this won't take long..."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 202.56,
      "end_seconds": 212.43,
      "duration_seconds": 9.87,
      "text": "Okay: pulse is 64 beats a minute, pressure 121 over 71, saturation 98 percent, temperature 36.6, respiratory rate 16."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 214.18,
      "end_seconds": 215.87,
      "duration_seconds": 1.69,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 220.38,
      "end_seconds": 222.5,
      "duration_seconds": 2.12,
      "text": "We'll go over that shortly."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 223.76,
      "end_seconds": 227.79,
      "duration_seconds": 4.03,
      "text": "Let me look at the area, I'll be gentle."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 229.22,
      "end_seconds": 231.18,
      "duration_seconds": 1.96,
      "text": "Raise your arm for me."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 239.77,
      "end_seconds": 247.37,
      "duration_seconds": 7.6,
      "text": "The skin on both hands is red, dry and cracked in the finger creases, with no weeping."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 252.01,
      "end_seconds": 253.71,
      "duration_seconds": 1.7,
      "text": "Please sit back down."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 261.9,
      "end_seconds": 286.63,
      "duration_seconds": 24.73,
      "text": "Right, here's what I'm thinking. I don't have a clear answer today: irritant hand dermatitis is possible, and so is a fungal skin infection. Just to be sure I understood. You've had red, cracked skin on your hands for about a month, and no oozing or new soap or cream."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 287.58,
      "end_seconds": 288.28,
      "duration_seconds": 0.7,
      "text": "Exactly."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 302.43,
      "end_seconds": 311.9,
      "duration_seconds": 9.47,
      "text": "I'd like to arrange a patch test for dermatitis. I'd rather check than guess, and this is the quickest way to know more."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 312.72,
      "end_seconds": 315.9,
      "duration_seconds": 3.18,
      "text": "Where would I go for that?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 316.47,
      "end_seconds": 318.86,
      "duration_seconds": 2.39,
      "text": "That's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 320.36,
      "end_seconds": 323.82,
      "duration_seconds": 3.46,
      "text": "Great, thank you for your help."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 325.48,
      "end_seconds": 326.72,
      "duration_seconds": 1.24,
      "text": "Look after yourself."
    }
  ]
}