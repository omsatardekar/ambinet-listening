{
  "schema_version": "1.0",
  "encounter_id": "20405",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.21,
      "end_seconds": 3.87,
      "duration_seconds": 2.66,
      "text": "Hello, come in. Mind the step."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "CAREGIVER",
      "start_seconds": 4.71,
      "end_seconds": 10.45,
      "duration_seconds": 5.74,
      "text": "Hello, doctor. I'm here with them in case I can help."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 12.3,
      "end_seconds": 19.64,
      "duration_seconds": 7.34,
      "text": "Of course, please stay. It's helpful to have you here. So what can I do for you?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 21.46,
      "end_seconds": 26.1,
      "duration_seconds": 4.64,
      "text": "Well, I've been having cramps in my calves at night."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 27.15,
      "end_seconds": 29.1,
      "duration_seconds": 1.95,
      "text": "When did this begin?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 30.75,
      "end_seconds": 39.61,
      "duration_seconds": 8.86,
      "text": "Hm. It was either the end of last month or earlier than that. I couldn't tell you the date."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 40.21,
      "end_seconds": 45.6,
      "duration_seconds": 5.39,
      "text": "Okay, give me more detail on it, whatever comes to mind."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 46.9,
      "end_seconds": 58.36,
      "duration_seconds": 11.46,
      "text": "So, about a four out of ten. It's worse with lying in bed. It happens once or twice a day."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 59.0,
      "end_seconds": 61.31,
      "duration_seconds": 2.31,
      "text": "Is it accompanied by anything?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 63.25,
      "end_seconds": 74.72,
      "duration_seconds": 11.47,
      "text": "It usually comes with a dull ache after the cramp. The dull ache after the cramp? That's been for about a month."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 76.69,
      "end_seconds": 81.71,
      "duration_seconds": 5.02,
      "text": "What about tingling in your feet, have you noticed that?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 82.82,
      "end_seconds": 85.2,
      "duration_seconds": 2.38,
      "text": "Yes, for about three months."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 86.35,
      "end_seconds": 89.57,
      "duration_seconds": 3.22,
      "text": "Has there been tired legs by evening too?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 90.68,
      "end_seconds": 93.85,
      "duration_seconds": 3.17,
      "text": "Yes, um, for four weeks."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 94.59,
      "end_seconds": 97.73,
      "duration_seconds": 3.14,
      "text": "Has anyone in your family had anything serious?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 98.7,
      "end_seconds": 103.23,
      "duration_seconds": 4.53,
      "text": "Sorry, what was I saying, my son has asthma."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 104.63,
      "end_seconds": 109.26,
      "duration_seconds": 4.63,
      "text": "Any allergies to tablets, food or anything in the environment?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 110.46,
      "end_seconds": 124.56,
      "duration_seconds": 14.1,
      "text": "Hmm, there was some antibiotic, I was told I was allergic. But I couldn't tell you what it was called or what it did."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 125.61,
      "end_seconds": 129.13,
      "duration_seconds": 3.52,
      "text": "Tell me about any past illnesses or ongoing conditions."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 131.15,
      "end_seconds": 139.44,
      "duration_seconds": 8.29,
      "text": "I have high blood pressure. It's a relief to finally sit down and talk about it."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 141.23,
      "end_seconds": 141.93,
      "duration_seconds": 0.7,
      "text": "Ah."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 143.21,
      "end_seconds": 147.32,
      "duration_seconds": 4.11,
      "text": "I, I have diabetes, for about a year."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 148.34,
      "end_seconds": 154.35,
      "duration_seconds": 6.01,
      "text": "Yes. Okay, I can see diabetes in your file as well. Any previous surgeries?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 156.34,
      "end_seconds": 160.62,
      "duration_seconds": 4.28,
      "text": "Nothing, uh, I haven't had any operations."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 162.17,
      "end_seconds": 166.28,
      "duration_seconds": 4.11,
      "text": "Are you taking anything regularly, including from the pharmacy?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 167.61,
      "end_seconds": 173.49,
      "duration_seconds": 5.88,
      "text": "I take lisinopril, 10 milligrams, once a day for my pressure."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 173.79,
      "end_seconds": 174.49,
      "duration_seconds": 0.7,
      "text": "Ah."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 175.69,
      "end_seconds": 180.24,
      "duration_seconds": 4.55,
      "text": "Glycomet, 500 milligrams, twice a day for my sugar."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 196.24,
      "end_seconds": 198.69,
      "duration_seconds": 2.45,
      "text": "Do you live by yourself?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 199.29,
      "end_seconds": 203.79,
      "duration_seconds": 4.5,
      "text": "No, I share a house with my brother."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 204.96,
      "end_seconds": 207.56,
      "duration_seconds": 2.6,
      "text": "Anything you do to stay fit?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 209.59,
      "end_seconds": 213.3,
      "duration_seconds": 3.71,
      "text": "I do a yoga class on Thursdays."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 215.25,
      "end_seconds": 220.59,
      "duration_seconds": 5.34,
      "text": "Did you get shortness of breath, swelling of the legs or back pain?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 221.97,
      "end_seconds": 229.74,
      "duration_seconds": 7.77,
      "text": "I haven't had shortness of breath, swelling of the legs or back pain, no."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 231.46,
      "end_seconds": 236.1,
      "duration_seconds": 4.64,
      "text": "Did you get chest pain or redness of the leg?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 237.11,
      "end_seconds": 242.22,
      "duration_seconds": 5.11,
      "text": "No, no chest pain or redness of the leg."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 243.45,
      "end_seconds": 247.5,
      "duration_seconds": 4.05,
      "text": "On the cardiac side, anything I should know?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 248.23,
      "end_seconds": 249.89,
      "duration_seconds": 1.66,
      "text": "Nothing like that."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 252.75,
      "end_seconds": 254.82,
      "duration_seconds": 2.07,
      "text": "Anything unusual with passing urine?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 256.0,
      "end_seconds": 259.39,
      "duration_seconds": 3.39,
      "text": "No, um, that's all fine."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 277.07,
      "end_seconds": 281.95,
      "duration_seconds": 4.88,
      "text": "Can I check a few measurements before we carry on?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 288.82,
      "end_seconds": 291.78,
      "duration_seconds": 2.96,
      "text": "Bear with me while this finishes..."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 304.33,
      "end_seconds": 314.88,
      "duration_seconds": 10.55,
      "text": "Okay: oxygen saturation is 99 percent, blood pressure 125 over 74, temperature is 36.9 degrees, pulse is 69 beats a minute."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 316.21,
      "end_seconds": 319.51,
      "duration_seconds": 3.3,
      "text": "Could you come over to the couch, please?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 320.56,
      "end_seconds": 322.17,
      "duration_seconds": 1.61,
      "text": "Let me feel here."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 336.68,
      "end_seconds": 343.6,
      "duration_seconds": 6.92,
      "text": "Both calves are soft and not tender, and the pulses at your feet are good."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 347.24,
      "end_seconds": 348.99,
      "duration_seconds": 1.75,
      "text": "That's the examination finished."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 366.8,
      "end_seconds": 372.41,
      "duration_seconds": 5.61,
      "text": "Today I'm not changing anything. Anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 372.99,
      "end_seconds": 376.35,
      "duration_seconds": 3.36,
      "text": "Great, thank you for your help."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 381.36,
      "end_seconds": 382.69,
      "duration_seconds": 1.33,
      "text": "Look after yourself."
    }
  ]
}