{
  "schema_version": "1.0",
  "encounter_id": "20317",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.85,
      "end_seconds": 5.05,
      "duration_seconds": 4.2,
      "text": "Hello, uh, doctor. I think it's my turn."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.24,
      "end_seconds": 10.06,
      "duration_seconds": 3.82,
      "text": "Of course, leave it there. How can I help?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 11.69,
      "end_seconds": 21.58,
      "duration_seconds": 9.89,
      "text": "Hello, uh, doctor, I came in with them, if that's okay. She's been having a high fever with shaking chills, doctor."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 22.89,
      "end_seconds": 24.73,
      "duration_seconds": 1.84,
      "text": "when did this begin?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 25.84,
      "end_seconds": 28.25,
      "duration_seconds": 2.41,
      "text": "I'd say three weeks, maybe."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 28.99,
      "end_seconds": 32.79,
      "duration_seconds": 3.8,
      "text": "I think it's been nearer a month, actually."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 33.79,
      "end_seconds": 38.48,
      "duration_seconds": 4.69,
      "text": "Okay, so roughly three to four weeks. Is that right?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 40.27,
      "end_seconds": 43.82,
      "duration_seconds": 3.55,
      "text": "yes, you know, somewhere around that"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 45.41,
      "end_seconds": 51.19,
      "duration_seconds": 5.78,
      "text": "Alright, is it there all the time or does it come and go?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 51.96,
      "end_seconds": 60.41,
      "duration_seconds": 8.45,
      "text": "Honestly, a couple of times a week. And, And there's muscle aches as well, ten days now."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 60.82,
      "end_seconds": 64.23,
      "duration_seconds": 3.41,
      "text": "I follow. Alright, have you been feeling sick?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 65.0,
      "end_seconds": 70.9,
      "duration_seconds": 5.9,
      "text": "Yeah. Five days, I'd say. Ah, as for feeling sick, mostly severe."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 71.62,
      "end_seconds": 76.78,
      "duration_seconds": 5.16,
      "text": "have you noticed yellow eyes, cough, neck stiffness or diarrhoea?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 78.53,
      "end_seconds": 82.63,
      "duration_seconds": 4.1,
      "text": "No, you know, I'd have said so."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 83.98,
      "end_seconds": 88.41,
      "duration_seconds": 4.43,
      "text": "Have you noticed any weakness, or anything odd with your balance?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 89.83,
      "end_seconds": 91.31,
      "duration_seconds": 1.48,
      "text": "nothing odd there"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 93.29,
      "end_seconds": 95.54,
      "duration_seconds": 2.25,
      "text": "Anything unusual with passing urine?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 96.16,
      "end_seconds": 97.57,
      "duration_seconds": 1.41,
      "text": "No changes there."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 108.45,
      "end_seconds": 111.34,
      "duration_seconds": 2.89,
      "text": "Okay, now some background about your lifestyle."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 112.84,
      "end_seconds": 124.02,
      "duration_seconds": 11.18,
      "text": "I retired from the post office two years ago. I swim twice a week. My husband and I live above the shop."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 125.45,
      "end_seconds": 129.1,
      "duration_seconds": 3.65,
      "text": "Which medicines do you take at the moment?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 130.21,
      "end_seconds": 134.47,
      "duration_seconds": 4.26,
      "text": "I'm on telmisartan, 40 milligrams, once a day"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 136.37,
      "end_seconds": 146.97,
      "duration_seconds": 10.6,
      "text": "yeah, doctor, I think the last prescription for the telmisartan was 20 milligrams. We changed it at the last visit"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 148.88,
      "end_seconds": 153.75,
      "duration_seconds": 4.87,
      "text": "Okay. Have you got the newest prescription or the box with you?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 155.34,
      "end_seconds": 162.56,
      "duration_seconds": 7.22,
      "text": "Not with me. I'll bring it next time. It's Glycomet, twice a day."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 163.39,
      "end_seconds": 165.64,
      "duration_seconds": 2.25,
      "text": "how much do you take?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 167.11,
      "end_seconds": 173.08,
      "duration_seconds": 5.97,
      "text": "500 milligrams. I'm on rosuvastatin, 10 milligrams, at night for my cholesterol."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 183.52,
      "end_seconds": 186.52,
      "duration_seconds": 3.0,
      "text": "Any past operations I should know about?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 187.33,
      "end_seconds": 191.9,
      "duration_seconds": 4.57,
      "text": "Yes, I had a varicose vein procedure, last year."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 209.12,
      "end_seconds": 212.63,
      "duration_seconds": 3.51,
      "text": "Anything in your past medical history I should know?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 217.87,
      "end_seconds": 221.0,
      "duration_seconds": 3.13,
      "text": "High blood pressure, for five years."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 225.24,
      "end_seconds": 226.05,
      "duration_seconds": 0.81,
      "text": "Mm-hmm."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 227.33,
      "end_seconds": 228.78,
      "duration_seconds": 1.45,
      "text": "I have diabetes."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 230.01,
      "end_seconds": 230.71,
      "duration_seconds": 0.7,
      "text": "Sure."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 231.48,
      "end_seconds": 233.67,
      "duration_seconds": 2.19,
      "text": "I've got high cholesterol"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 235.09,
      "end_seconds": 236.79,
      "duration_seconds": 1.7,
      "text": "I see, go ahead."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 237.47,
      "end_seconds": 240.46,
      "duration_seconds": 2.99,
      "text": "I have asthma, for two years"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 241.19,
      "end_seconds": 252.34,
      "duration_seconds": 11.15,
      "text": "I see, go ahead. Alright, high cholesterol, that matches what I have here. Do you react to any medicines or foods? Any allergies?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 253.41,
      "end_seconds": 257.47,
      "duration_seconds": 4.06,
      "text": "Well, yes, I'm allergic to to wheat."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 259.36,
      "end_seconds": 262.56,
      "duration_seconds": 3.2,
      "text": "Are there any illnesses in your family?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 264.4,
      "end_seconds": 266.38,
      "duration_seconds": 1.98,
      "text": "My son has asthma."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 267.11,
      "end_seconds": 270.46,
      "duration_seconds": 3.35,
      "text": "I'll note down your vital signs first."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 278.38,
      "end_seconds": 280.54,
      "duration_seconds": 2.16,
      "text": "Okay, this won't take long..."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 291.66,
      "end_seconds": 299.1,
      "duration_seconds": 7.44,
      "text": "Okay: oxygen saturation is 98 percent, heart rate 91, pressure 116 over 67, respiratory rate 21."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 300.31,
      "end_seconds": 304.32,
      "duration_seconds": 4.01,
      "text": "I'd like to check you over now, if that's alright."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 306.25,
      "end_seconds": 307.49,
      "duration_seconds": 1.24,
      "text": "Okay, doctor."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 309.05,
      "end_seconds": 310.39,
      "duration_seconds": 1.34,
      "text": "Look straight ahead."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 325.2,
      "end_seconds": 329.62,
      "duration_seconds": 4.42,
      "text": "The spleen tip is just palpable and the chest is clear."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 333.62,
      "end_seconds": 348.96,
      "duration_seconds": 15.34,
      "text": "Thank you, you can get dressed. Let me tell you where I've got to. I'd lean towards a fever after travel that must be treated as possible malaria. I'd also keep dengue fever in mind."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 350.61,
      "end_seconds": 354.23,
      "duration_seconds": 3.62,
      "text": "I'm scared it's something bad. Is it?"
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 356.29,
      "end_seconds": 381.99,
      "duration_seconds": 25.7,
      "text": "I understand the worry. At the moment I'd say it's a fever after travel that must be treated as possible malaria, and we'll know more once the a malaria test is back. Let me just check I've got this right. You've had a high fever with shaking chills, and no neck stiffness or diarrhoea."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 382.69,
      "end_seconds": 384.26,
      "duration_seconds": 1.57,
      "text": "Yes, that's right."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 385.21,
      "end_seconds": 397.07,
      "duration_seconds": 11.86,
      "text": "I want a malaria test done, that's for fever after travel. I'm sending you for blood cultures because of fever. Avoid anti-inflammatory painkillers and keep drinking."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 397.44,
      "end_seconds": 411.29,
      "duration_seconds": 13.85,
      "text": "Sure. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose. Is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 415.6,
      "end_seconds": 419.38,
      "duration_seconds": 3.78,
      "text": "Right, I'll do that. Thank you, doctor."
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 420.64,
      "end_seconds": 422.47,
      "duration_seconds": 1.83,
      "text": "Have a good day."
    }
  ]
}