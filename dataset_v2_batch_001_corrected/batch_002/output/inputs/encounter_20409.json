{
  "schema_version": "1.0",
  "encounter_id": "20409",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.26,
      "end_seconds": 4.41,
      "duration_seconds": 3.15,
      "text": "Hello, doctor. May I come in?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.03,
      "end_seconds": 8.71,
      "duration_seconds": 3.68,
      "text": "Come in. Please sit. How can I help you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 12.74,
      "end_seconds": 17.29,
      "duration_seconds": 4.55,
      "text": "Well, I've been having an itchy rash all over."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 18.73,
      "end_seconds": 22.46,
      "duration_seconds": 3.73,
      "text": "When was the first time you noticed it?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 24.04,
      "end_seconds": 27.01,
      "duration_seconds": 2.97,
      "text": "Mm, it's been ten days now."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 28.48,
      "end_seconds": 33.8,
      "duration_seconds": 5.32,
      "text": "Okay, give me more detail on it, whatever comes to mind."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 35.85,
      "end_seconds": 45.06,
      "duration_seconds": 9.21,
      "text": "It's all the time. I get some relief from an antihistamine. Pretty moderate, if I'm being honest. Oh, and hives."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 46.01,
      "end_seconds": 49.55,
      "duration_seconds": 3.54,
      "text": "Is it a lot or only a little?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 51.47,
      "end_seconds": 53.01,
      "duration_seconds": 1.54,
      "text": "Severe, I'd say."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 71.31,
      "end_seconds": 75.09,
      "duration_seconds": 3.78,
      "text": "What do you take on a normal day?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 79.88,
      "end_seconds": 83.77,
      "duration_seconds": 3.89,
      "text": "It's cetirizine, 10 milligrams, when it flares."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 84.28,
      "end_seconds": 87.71,
      "duration_seconds": 3.43,
      "text": "Any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 88.38,
      "end_seconds": 89.86,
      "duration_seconds": 1.48,
      "text": "No, no conditions."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 91.17,
      "end_seconds": 93.52,
      "duration_seconds": 2.35,
      "text": "Have you been to theatre before?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 97.41,
      "end_seconds": 102.79,
      "duration_seconds": 5.38,
      "text": "Just a meniscus repair on my knee, four years ago."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 106.34,
      "end_seconds": 110.19,
      "duration_seconds": 3.85,
      "text": "Has anyone in your family had anything serious?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 111.11,
      "end_seconds": 113.27,
      "duration_seconds": 2.16,
      "text": "My brother has epilepsy."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 128.05,
      "end_seconds": 133.36,
      "duration_seconds": 5.31,
      "text": "Are you allergic to anything? Any allergies to medicines or foods?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 134.24,
      "end_seconds": 138.17,
      "duration_seconds": 3.93,
      "text": "I, I don't think I have any, no."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 142.21,
      "end_seconds": 144.55,
      "duration_seconds": 2.34,
      "text": "Now some background about your lifestyle."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 145.46,
      "end_seconds": 156.47,
      "duration_seconds": 11.01,
      "text": "I'm a bus driver, so I sit for long hours. Lots of rice, lentils and some fruit. I swim twice a week."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 157.61,
      "end_seconds": 162.06,
      "duration_seconds": 4.45,
      "text": "Any fainting, throat tightness or new food at all?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 163.1,
      "end_seconds": 165.91,
      "duration_seconds": 2.81,
      "text": "No, nothing to report there."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 166.49,
      "end_seconds": 167.82,
      "duration_seconds": 1.33,
      "text": "Neurologically, anything strange?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 171.22,
      "end_seconds": 174.19,
      "duration_seconds": 2.97,
      "text": "So, no, nothing like that."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 188.4,
      "end_seconds": 190.8,
      "duration_seconds": 2.4,
      "text": "Let me take your readings now."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 204.72,
      "end_seconds": 206.77,
      "duration_seconds": 2.05,
      "text": "Nearly done with the readings..."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 222.73,
      "end_seconds": 232.27,
      "duration_seconds": 9.54,
      "text": "Okay: temp 36.7 degrees, respiratory rate 14, blood pressure 111 over 70, pulse is 70 beats a minute."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 233.97,
      "end_seconds": 235.49,
      "duration_seconds": 1.52,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 236.51,
      "end_seconds": 239.71,
      "duration_seconds": 3.2,
      "text": "Right, that's fine, I'll explain it soon."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 241.57,
      "end_seconds": 245.06,
      "duration_seconds": 3.49,
      "text": "Right, let's have a proper look at you."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 246.45,
      "end_seconds": 249.38,
      "duration_seconds": 2.93,
      "text": "Stay as you are for a moment."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 265.1,
      "end_seconds": 274.33,
      "duration_seconds": 9.23,
      "text": "There are raised pink welts on the trunk and arms, the lips are a little puffy, and the tongue and throat look normal."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 280.32,
      "end_seconds": 282.42,
      "duration_seconds": 2.1,
      "text": "All finished, thank you."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 296.21,
      "end_seconds": 304.77,
      "duration_seconds": 8.56,
      "text": "Okay, so my impression is this: It fits best with an allergic reaction, possibly to a recently started medicine."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 305.48,
      "end_seconds": 308.63,
      "duration_seconds": 3.15,
      "text": "I'm scared it's something bad. Is it?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 313.92,
      "end_seconds": 331.2,
      "duration_seconds": 17.28,
      "text": "Nothing I've seen today points to an emergency. It looks like an allergic reaction, possibly to a recently started medicine. I'm going to put you on chlorphenamine, 4 milligrams, every six hours, for three days. It's for allergic rash."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 333.14,
      "end_seconds": 335.07,
      "duration_seconds": 1.93,
      "text": "Fine, I'll begin it."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 337.0,
      "end_seconds": 353.81,
      "duration_seconds": 16.81,
      "text": "Stop the new tablet until we know what caused it and write down every medicine you took in the last week. Avoid taking any extra painkillers on top of what I'm prescribing without checking with us. Book a review in two days."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 354.64,
      "end_seconds": 356.85,
      "duration_seconds": 2.21,
      "text": "Good, I'll return then."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 357.57,
      "end_seconds": 360.25,
      "duration_seconds": 2.68,
      "text": "Does all of that make sense?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 360.88,
      "end_seconds": 363.21,
      "duration_seconds": 2.33,
      "text": "Thank you, that's helpful."
    }
  ]
}