{
  "schema_version": "1.0",
  "encounter_id": "20262",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.23,
      "end_seconds": 3.05,
      "duration_seconds": 1.82,
      "text": "Evening. Let's get started."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "CAREGIVER",
      "start_seconds": 4.4,
      "end_seconds": 7.17,
      "duration_seconds": 2.77,
      "text": "Doctor, thank you for seeing us."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 10.24,
      "end_seconds": 13.04,
      "duration_seconds": 2.8,
      "text": "What do you need help with?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 15.1,
      "end_seconds": 20.43,
      "duration_seconds": 5.33,
      "text": "She's been having pins and needles in my hands and feet, doctor."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 22.18,
      "end_seconds": 24.93,
      "duration_seconds": 2.75,
      "text": "How long has this been bothering you?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 26.33,
      "end_seconds": 32.71,
      "duration_seconds": 6.38,
      "text": "Six months, I think... sorry, two months, I got that wrong."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 33.99,
      "end_seconds": 37.81,
      "duration_seconds": 3.82,
      "text": "Is it a lot or only a little?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 39.12,
      "end_seconds": 43.91,
      "duration_seconds": 4.79,
      "text": "Maybe a three out of ten on a bad day."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 44.47,
      "end_seconds": 52.78,
      "duration_seconds": 8.31,
      "text": "Well, and the other thing I wanted to mention is that I can't really—"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "CAREGIVER",
      "start_seconds": 52.88,
      "end_seconds": 58.54,
      "duration_seconds": 5.66,
      "text": "Tell the doctor about the other thing, that's what worries me."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 59.6,
      "end_seconds": 61.83,
      "duration_seconds": 2.23,
      "text": "I was getting to that!"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 62.43,
      "end_seconds": 64.61,
      "duration_seconds": 2.18,
      "text": "Have you been forgetting words?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 65.98,
      "end_seconds": 72.16,
      "duration_seconds": 6.18,
      "text": "Yes, for six months. And I've been feeling very tired as well."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 73.11,
      "end_seconds": 80.35,
      "duration_seconds": 7.24,
      "text": "Right, any weight loss, weakness of one side, bladder problems or loss of vision?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 82.06,
      "end_seconds": 96.91,
      "duration_seconds": 14.85,
      "text": "No, no weight loss, no weakness of one side, no bladder problems. I did have being unsteady on my feet at one point, but that went away on its own."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 97.7,
      "end_seconds": 99.86,
      "duration_seconds": 2.16,
      "text": "Have you had any diarrhoea?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 101.93,
      "end_seconds": 105.72,
      "duration_seconds": 3.79,
      "text": "Um, not that I've noticed, no diarrhoea."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 107.22,
      "end_seconds": 111.91,
      "duration_seconds": 4.69,
      "text": "Actually, doctor, I did notice diarrhoea. She doesn't always say."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 113.82,
      "end_seconds": 121.6,
      "duration_seconds": 7.78,
      "text": "Hmm, uh, no, I don't think I did. Maybe a little, I'm not sure."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 125.11,
      "end_seconds": 133.57,
      "duration_seconds": 8.46,
      "text": "Alright, I'll note both what you've said and what you've noticed. Is your urine normal, no changes?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 134.28,
      "end_seconds": 136.26,
      "duration_seconds": 1.98,
      "text": "No, that's all fine."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 137.65,
      "end_seconds": 141.55,
      "duration_seconds": 3.9,
      "text": "How about your heart, any problems like that?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 142.74,
      "end_seconds": 144.41,
      "duration_seconds": 1.67,
      "text": "Nothing like that."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 145.42,
      "end_seconds": 147.82,
      "duration_seconds": 2.4,
      "text": "What about your medical history?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 149.1,
      "end_seconds": 153.07,
      "duration_seconds": 3.97,
      "text": "Yes, acid reflux. Diabetes, for five years."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 154.59,
      "end_seconds": 163.32,
      "duration_seconds": 8.73,
      "text": "Hm, okay. Right, so acid reflux and diabetes are already on your record. We'll keep that in mind today."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 182.05,
      "end_seconds": 185.9,
      "duration_seconds": 3.85,
      "text": "What do you take on a normal day?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 187.51,
      "end_seconds": 200.27,
      "duration_seconds": 12.76,
      "text": "Um, you know, I'm on pantoprazole, 40 milligrams, before breakfast. I'm on sitagliptin, 100 milligrams, maybe, once a day for my sugar."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 200.81,
      "end_seconds": 203.88,
      "duration_seconds": 3.07,
      "text": "Is the packet here, or the prescription?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 204.89,
      "end_seconds": 209.89,
      "duration_seconds": 5.0,
      "text": "Right, not with me. I'll bring it next time."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 211.05,
      "end_seconds": 216.34,
      "duration_seconds": 5.29,
      "text": "Has anything ever caused you a reaction? I mean any allergies."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 217.64,
      "end_seconds": 221.0,
      "duration_seconds": 3.36,
      "text": "I don't think I have any, no."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "CAREGIVER",
      "start_seconds": 222.7,
      "end_seconds": 228.63,
      "duration_seconds": 5.93,
      "text": "I'm not sure that's right. I seem to recall a problem with naproxen."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 233.63,
      "end_seconds": 236.81,
      "duration_seconds": 3.18,
      "text": "Maybe, but I don't recall it."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 237.43,
      "end_seconds": 245.0,
      "duration_seconds": 7.57,
      "text": "Fair enough, I'll write down both versions. Tell me about your routine, work, habits, that sort of thing."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 246.75,
      "end_seconds": 258.63,
      "duration_seconds": 11.88,
      "text": "I only drink at family occasions. I quit smoking around ten years ago. I drink a lot of tea and snack through the day."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 260.04,
      "end_seconds": 262.47,
      "duration_seconds": 2.43,
      "text": "Let me quickly check your readings."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 268.97,
      "end_seconds": 271.11,
      "duration_seconds": 2.14,
      "text": "Sit still for a moment..."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 292.18,
      "end_seconds": 301.15,
      "duration_seconds": 8.97,
      "text": "Okay: blood pressure 125 over 82, heart rate 72, temperature is 36.9 degrees, SpO2 99 percent on room air."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 303.58,
      "end_seconds": 307.49,
      "duration_seconds": 3.91,
      "text": "Now I'm going to do a short physical check."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 308.64,
      "end_seconds": 311.14,
      "duration_seconds": 2.5,
      "text": "I'll listen to your chest now."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 326.95,
      "end_seconds": 329.71,
      "duration_seconds": 2.76,
      "text": "The tongue looks smooth and red."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 331.64,
      "end_seconds": 333.4,
      "duration_seconds": 1.76,
      "text": "Let me feel here."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 349.56,
      "end_seconds": 353.08,
      "duration_seconds": 3.52,
      "text": "Your vibration sense is reduced at the ankles."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 358.74,
      "end_seconds": 377.75,
      "duration_seconds": 19.01,
      "text": "Right, good, you can sit up again. Let me tell you where I've got to. This is probably symptoms that fit a vitamin B12 deficiency. That's my thinking for now, and it may change as we learn more. I'd also keep diabetic nerve damage in mind."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 379.23,
      "end_seconds": 382.33,
      "duration_seconds": 3.1,
      "text": "Do you think it's something serious?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 383.14,
      "end_seconds": 403.29,
      "duration_seconds": 20.15,
      "text": "Nothing I've seen today points to an emergency. It looks like symptoms that fit a vitamin B12 deficiency, but I'd like to confirm. So, to recap quickly. You've had pins and needles in your hands and feet for two months, and no bladder problems or weakness of one side."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 404.67,
      "end_seconds": 406.28,
      "duration_seconds": 1.61,
      "text": "Mm, that's right."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 421.93,
      "end_seconds": 425.52,
      "duration_seconds": 3.59,
      "text": "We should do a full blood count for tiredness."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 426.12,
      "end_seconds": 429.17,
      "duration_seconds": 3.05,
      "text": "Where would I go for that?"
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 430.51,
      "end_seconds": 436.65,
      "duration_seconds": 6.14,
      "text": "A vitamin B12 level is what I'd like next, for tingling and tiredness."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 437.85,
      "end_seconds": 441.72,
      "duration_seconds": 3.87,
      "text": "Well, where would I go for that?"
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 442.23,
      "end_seconds": 454.45,
      "duration_seconds": 12.22,
      "text": "I want a thyroid test done, that's for tiredness. I'd like you to take cyanocobalamin, 1000 micrograms, every other day, for two weeks. That's for low vitamin B12."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 455.81,
      "end_seconds": 457.4,
      "duration_seconds": 1.59,
      "text": "That's simple enough."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 458.12,
      "end_seconds": 471.67,
      "duration_seconds": 13.55,
      "text": "Eating more eggs, dairy and fortified cereals will help over time. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 473.31,
      "end_seconds": 476.75,
      "duration_seconds": 3.44,
      "text": "Okay, I'll look out for that."
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 478.09,
      "end_seconds": 480.22,
      "duration_seconds": 2.13,
      "text": "Come back in two weeks."
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 481.02,
      "end_seconds": 483.76,
      "duration_seconds": 2.74,
      "text": "Yes, you know, that's manageable."
    },
    {
      "segment_id": "SEG0059",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 485.72,
      "end_seconds": 488.54,
      "duration_seconds": 2.82,
      "text": "That's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0060",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 489.93,
      "end_seconds": 492.07,
      "duration_seconds": 2.14,
      "text": "Thank you, doctor, goodbye."
    }
  ]
}