{
  "schema_version": "1.0",
  "encounter_id": "20388",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.01,
      "end_seconds": 4.22,
      "duration_seconds": 3.21,
      "text": "Hello, doctor. May I come in?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.0,
      "end_seconds": 11.56,
      "duration_seconds": 4.56,
      "text": "Yes, come in and sit down. What brings you here today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 12.95,
      "end_seconds": 17.44,
      "duration_seconds": 4.49,
      "text": "I wanted to get my heart racing looked at."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 19.17,
      "end_seconds": 22.31,
      "duration_seconds": 3.14,
      "text": "How many days or weeks has it been?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 24.31,
      "end_seconds": 27.66,
      "duration_seconds": 3.35,
      "text": "It's been about a year now."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 29.42,
      "end_seconds": 32.27,
      "duration_seconds": 2.85,
      "text": "How much does it limit you?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 33.47,
      "end_seconds": 37.88,
      "duration_seconds": 4.41,
      "text": "I'd give it a four, out of ten."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 38.75,
      "end_seconds": 40.36,
      "duration_seconds": 1.61,
      "text": "How about chest pain?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 42.38,
      "end_seconds": 45.64,
      "duration_seconds": 3.26,
      "text": "I haven't noticed any chest pain."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 46.21,
      "end_seconds": 48.95,
      "duration_seconds": 2.74,
      "text": "And what about eye pain or fever?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 50.29,
      "end_seconds": 52.83,
      "duration_seconds": 2.54,
      "text": "No, none that I've noticed."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 54.14,
      "end_seconds": 56.81,
      "duration_seconds": 2.67,
      "text": "And your skin, any changes there?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 57.77,
      "end_seconds": 58.72,
      "duration_seconds": 0.95,
      "text": "Skin's normal."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 63.38,
      "end_seconds": 67.31,
      "duration_seconds": 3.93,
      "text": "Do you take any prescribed or over-the-counter medicines?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 67.87,
      "end_seconds": 71.69,
      "duration_seconds": 3.82,
      "text": "It's valsartan, 80 milligrams, once a day."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 81.53,
      "end_seconds": 84.24,
      "duration_seconds": 2.71,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 89.18,
      "end_seconds": 91.28,
      "duration_seconds": 2.1,
      "text": "No, not at all."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 92.14,
      "end_seconds": 96.74,
      "duration_seconds": 4.6,
      "text": "What conditions have you been treated for in the past?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 98.26,
      "end_seconds": 100.36,
      "duration_seconds": 2.1,
      "text": "Yes, high blood pressure."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 101.7,
      "end_seconds": 109.41,
      "duration_seconds": 7.71,
      "text": "Alright, high blood pressure, that matches what I have here. Before we go further, any allergies?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 111.34,
      "end_seconds": 114.29,
      "duration_seconds": 2.95,
      "text": "No, I've never reacted to anything."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 115.74,
      "end_seconds": 119.96,
      "duration_seconds": 4.22,
      "text": "What about your parents, brothers or sisters, any conditions?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 123.81,
      "end_seconds": 127.12,
      "duration_seconds": 3.31,
      "text": "My mother has an underactive thyroid."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 136.04,
      "end_seconds": 138.75,
      "duration_seconds": 2.71,
      "text": "Do you follow any particular diet?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 139.72,
      "end_seconds": 143.61,
      "duration_seconds": 3.89,
      "text": "I'm vegetarian and have been for years."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 149.85,
      "end_seconds": 151.55,
      "duration_seconds": 1.7,
      "text": "How active are you?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 153.52,
      "end_seconds": 156.83,
      "duration_seconds": 3.31,
      "text": "I hardly move around during the day."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 157.36,
      "end_seconds": 159.35,
      "duration_seconds": 1.99,
      "text": "Is there someone at home?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 160.34,
      "end_seconds": 164.84,
      "duration_seconds": 4.5,
      "text": "My husband and I live above the shop."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 166.36,
      "end_seconds": 168.73,
      "duration_seconds": 2.37,
      "text": "Let me take your readings now."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 177.28,
      "end_seconds": 180.36,
      "duration_seconds": 3.08,
      "text": "That's it, just a little longer..."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 199.24,
      "end_seconds": 208.7,
      "duration_seconds": 9.46,
      "text": "Okay: weight 86 kilos, height 169 centimetres, SpO2 98 percent on room air. And pulse 109, blood pressure 130 over 86."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 210.34,
      "end_seconds": 214.3,
      "duration_seconds": 3.96,
      "text": "Let me look at the area, I'll be gentle."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 215.34,
      "end_seconds": 218.83,
      "duration_seconds": 3.49,
      "text": "So, stay as you are for a moment."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 236.63,
      "end_seconds": 241.41,
      "duration_seconds": 4.78,
      "text": "There is a smooth, small swelling at the front of the neck."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 247.29,
      "end_seconds": 250.22,
      "duration_seconds": 2.93,
      "text": "Good, you can sit up again."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 264.17,
      "end_seconds": 283.04,
      "duration_seconds": 18.87,
      "text": "Taking everything into account, I don't have a clear answer today: an overactive thyroid is possible, and so is an abnormal heart rhythm. Just to be sure I understood. You've had your heart racing for about a year, and no eye pain or chest pain."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 284.33,
      "end_seconds": 285.03,
      "duration_seconds": 0.7,
      "text": "Exactly."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 293.13,
      "end_seconds": 310.92,
      "duration_seconds": 17.79,
      "text": "I want thyroid blood tests done, that's for palpitations and weight loss. I'm prescribing propranolol, 20 milligrams, twice a day, until review. You take it by mouth. That's for racing heart and tremor. It's a commonly used medicine and most people tolerate it well."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 316.36,
      "end_seconds": 320.61,
      "duration_seconds": 4.25,
      "text": "Can I collect it from my own pharmacy?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 322.38,
      "end_seconds": 342.71,
      "duration_seconds": 20.33,
      "text": "Try to avoid caffeine while we sort this out. I'd like you to see the endocrine clinic as well, and I'll write the referral. If it hasn't settled next month, we'd think about an ECG, but not now. How would you describe the plan, so we're on the same page?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 344.23,
      "end_seconds": 351.23,
      "duration_seconds": 7.0,
      "text": "So, I take the propranolol, 20 milligrams, twice a day. Is that right?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 352.74,
      "end_seconds": 358.09,
      "duration_seconds": 5.35,
      "text": "Yes, exactly right. Right, that's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 359.08,
      "end_seconds": 360.68,
      "duration_seconds": 1.6,
      "text": "That's clear, thanks."
    }
  ]
}