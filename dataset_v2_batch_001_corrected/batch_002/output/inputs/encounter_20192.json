    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 25.0,
      "end_seconds": 28.51,
      "duration_seconds": 3.51,
      "text": "I've been losing weight without trying"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 29.57,
      "end_seconds": 32.8,
      "duration_seconds": 3.23,
      "text": "Right, what's on your current medicine list?"
    },
