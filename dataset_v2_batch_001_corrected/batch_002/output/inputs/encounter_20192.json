      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 33.89,
      "end_seconds": 38.93,
      "duration_seconds": 5.04,
      "text": "Yeah, you know, it's atorvastatin, 20 milligrams, at night."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 39.62,
      "end_seconds": 41.62,
      "duration_seconds": 2.0,
      "text": "Any other symptoms with it?"
