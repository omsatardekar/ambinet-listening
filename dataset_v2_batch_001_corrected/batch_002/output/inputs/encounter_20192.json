    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 79.39,
      "end_seconds": 83.15,
      "duration_seconds": 3.76,
      "text": "Yeah, uh, I move fine otherwise."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 83.98,
      "end_seconds": 86.08,
      "duration_seconds": 2.1,
      "text": "Is your chest okay generally?"
