      "role": "FAMILY_MEMBER",
      "start_seconds": 12.22,
      "end_seconds": 19.37,
      "duration_seconds": 7.15,
      "text": "So, uh, good morning, doctor. I came along to help out."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 20.66,
      "end_seconds": 23.12,
