{
  "schema_version": "1.0",
  "encounter_id": "20277",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.02,
      "end_seconds": 6.07,
      "duration_seconds": 5.05,
      "text": "Good evening, you know, doctor, thanks for seeing me."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.39,
      "end_seconds": 11.57,
      "duration_seconds": 4.18,
      "text": "Not at all, please sit. What seems to be wrong?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 12.45,
      "end_seconds": 15.61,
      "duration_seconds": 3.16,
      "text": "I'm here because of hot flushes."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 16.56,
      "end_seconds": 20.27,
      "duration_seconds": 3.71,
      "text": "How long has it it been like this?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 21.26,
      "end_seconds": 23.62,
      "duration_seconds": 2.36,
      "text": "it's been six months now"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 24.68,
      "end_seconds": 33.28,
      "duration_seconds": 8.6,
      "text": "Tell me a bit more about it: how bad it gets, how often, and whether anything makes it better or worse."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 34.39,
      "end_seconds": 38.72,
      "duration_seconds": 4.33,
      "text": "I'd call it mild. Honestly, every other day"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 41.38,
      "end_seconds": 45.16,
      "duration_seconds": 3.78,
      "text": "Alright, what about night sweats, have you noticed that?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 46.65,
      "end_seconds": 53.23,
      "duration_seconds": 6.58,
      "text": "Mm, yes. Poor sleep was there, but it's gone away on its own."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 54.59,
      "end_seconds": 59.85,
      "duration_seconds": 5.26,
      "text": "Are you allergic to anything? Any allergies to medicines or foods?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 61.01,
      "end_seconds": 64.55,
      "duration_seconds": 3.54,
      "text": "Yes, tramadol, it gives me vomiting."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 69.43,
      "end_seconds": 71.38,
      "duration_seconds": 1.95,
      "text": "Do you live by yourself?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 73.32,
      "end_seconds": 77.11,
      "duration_seconds": 3.79,
      "text": "No, I share a house with my brother"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 79.16,
      "end_seconds": 83.55,
      "duration_seconds": 4.39,
      "text": "What does a normal day of food look like?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 85.61,
      "end_seconds": 89.09,
      "duration_seconds": 3.48,
      "text": "Lots of rice, lentils and some fruit."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 90.72,
      "end_seconds": 93.07,
      "duration_seconds": 2.35,
      "text": "What about your medical history?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 94.17,
      "end_seconds": 97.23,
      "duration_seconds": 3.06,
      "text": "Thin bones, for nearly five years."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 97.75,
      "end_seconds": 98.45,
      "duration_seconds": 0.7,
      "text": "Ah."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 99.06,
      "end_seconds": 101.5,
      "duration_seconds": 2.44,
      "text": "Anxiety, for about ten years"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 102.18,
      "end_seconds": 110.08,
      "duration_seconds": 7.9,
      "text": "Alright, anxiety, that matches what I have here. Are you taking anything regularly, including from the pharmacy?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 115.32,
      "end_seconds": 120.42,
      "duration_seconds": 5.1,
      "text": "Alendronate. I take it 70 milligrams, once a week."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 138.96,
      "end_seconds": 142.31,
      "duration_seconds": 3.35,
      "text": "Did you ever have any procedures done?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 142.94,
      "end_seconds": 147.8,
      "duration_seconds": 4.86,
      "text": "yes, I had part of my thyroid removed, years back"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 148.31,
      "end_seconds": 154.47,
      "duration_seconds": 6.16,
      "text": "Have you noticed breast lumps, heavy bleeding, weight loss or bleeding after sex?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 154.99,
      "end_seconds": 157.69,
      "duration_seconds": 2.7,
      "text": "No, not a single one."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 158.39,
      "end_seconds": 163.1,
      "duration_seconds": 4.71,
      "text": "Have you noticed any weakness, or anything odd with your balance?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 163.71,
      "end_seconds": 165.92,
      "duration_seconds": 2.21,
      "text": "No, that's all normal."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 166.68,
      "end_seconds": 169.35,
      "duration_seconds": 2.67,
      "text": "How are your bowels, any trouble?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 170.74,
      "end_seconds": 172.49,
      "duration_seconds": 1.75,
      "text": "Nothing unusual, no."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 173.92,
      "end_seconds": 176.53,
      "duration_seconds": 2.61,
      "text": "So, I'll do your observations first."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 184.62,
      "end_seconds": 187.54,
      "duration_seconds": 2.92,
      "text": "Keep your arm relaxed for me..."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 198.88,
      "end_seconds": 209.94,
      "duration_seconds": 11.06,
      "text": "okay: temperature 36.8, respiratory rate 18. And pulse is 86 beats a minute, SpO2 99 percent on room air, blood pressure 112 over 69."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 211.81,
      "end_seconds": 213.34,
      "duration_seconds": 1.53,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 214.43,
      "end_seconds": 218.32,
      "duration_seconds": 3.89,
      "text": "They help me see the whole picture, more shortly."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 219.89,
      "end_seconds": 224.11,
      "duration_seconds": 4.22,
      "text": "Let me look at the area, I'll be gentle."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 231.8,
      "end_seconds": 232.75,
      "duration_seconds": 0.95,
      "text": "Of course."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 233.55,
      "end_seconds": 235.24,
      "duration_seconds": 1.69,
      "text": "let me feel here"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 246.58,
      "end_seconds": 253.42,
      "duration_seconds": 6.84,
      "text": "Blood pressure and pulse are fine and there are no breast lumps on examination"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 255.01,
      "end_seconds": 255.91,
      "duration_seconds": 0.9,
      "text": "That's alright."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 259.41,
      "end_seconds": 262.48,
      "duration_seconds": 3.07,
      "text": "Thank you, you can get dressed."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 275.14,
      "end_seconds": 287.47,
      "duration_seconds": 12.33,
      "text": "Let's get blood tests, for hot flushes. Layers of clothing, a fan by the bed, and cutting down on caffeine and spicy food can help the flushes."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 289.46,
      "end_seconds": 294.97,
      "duration_seconds": 5.51,
      "text": "could I get a bone density scan done? A friend had it"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 296.47,
      "end_seconds": 303.5,
      "duration_seconds": 7.03,
      "text": "I wouldn't order it today. If anything changes, we'll reconsider. Book a review after the blood tests."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 304.15,
      "end_seconds": 306.13,
      "duration_seconds": 1.98,
      "text": "Alright, I'll be back."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 306.91,
      "end_seconds": 310.52,
      "duration_seconds": 3.61,
      "text": "that's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 311.5,
      "end_seconds": 313.3,
      "duration_seconds": 1.8,
      "text": "that's clear, thanks"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 314.84,
      "end_seconds": 316.63,
      "duration_seconds": 1.79,
      "text": "All the the best."
    }
  ]
}