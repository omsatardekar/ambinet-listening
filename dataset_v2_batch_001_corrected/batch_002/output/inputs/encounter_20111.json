{
  "schema_version": "1.0",
  "encounter_id": "20111",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.24,
      "end_seconds": 4.92,
      "duration_seconds": 3.68,
      "text": "Come in, have a seat by the desk."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "CAREGIVER",
      "start_seconds": 5.51,
      "end_seconds": 11.14,
      "duration_seconds": 5.63,
      "text": "Good morning, uh, doctor. I came along to help out."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 12.01,
      "end_seconds": 16.66,
      "duration_seconds": 4.65,
      "text": "Please do. Extra information is always welcome. What's the problem?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 17.56,
      "end_seconds": 23.37,
      "duration_seconds": 5.81,
      "text": "I've been feeling very tired, and I wanted to get it checked."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 25.08,
      "end_seconds": 28.27,
      "duration_seconds": 3.19,
      "text": "Can you tell me when it first started?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 30.17,
      "end_seconds": 33.56,
      "duration_seconds": 3.39,
      "text": "I've had it for nearly five years."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 34.15,
      "end_seconds": 37.31,
      "duration_seconds": 3.16,
      "text": "How much trouble does it give you?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 38.25,
      "end_seconds": 47.85,
      "duration_seconds": 9.6,
      "text": "Mostly moderate. I did have being unsteady on my feet at one point, you know, but that's gone now."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 48.94,
      "end_seconds": 56.56,
      "duration_seconds": 7.62,
      "text": "Let me check a few things. Any rash, loss of vision, weight loss or bladder problems?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 57.99,
      "end_seconds": 60.46,
      "duration_seconds": 2.47,
      "text": "No, not a single one."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 62.07,
      "end_seconds": 64.76,
      "duration_seconds": 2.69,
      "text": "Anything different when you pass water?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 69.02,
      "end_seconds": 70.94,
      "duration_seconds": 1.92,
      "text": "No, that's all fine."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 71.52,
      "end_seconds": 74.45,
      "duration_seconds": 2.93,
      "text": "Any past operations I should know about?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 76.25,
      "end_seconds": 80.44,
      "duration_seconds": 4.19,
      "text": "Just an operation for a hernia, last spring."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 81.67,
      "end_seconds": 84.2,
      "duration_seconds": 2.53,
      "text": "Before we go further, any allergies?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 85.36,
      "end_seconds": 88.64,
      "duration_seconds": 3.28,
      "text": "No, not that I know of."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 89.67,
      "end_seconds": 93.75,
      "duration_seconds": 4.08,
      "text": "Are you taking anything regularly, including from the pharmacy?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 94.72,
      "end_seconds": 96.98,
      "duration_seconds": 2.26,
      "text": "It's lansoprazole, before breakfast."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 98.07,
      "end_seconds": 100.35,
      "duration_seconds": 2.28,
      "text": "How much do you take?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 102.21,
      "end_seconds": 103.59,
      "duration_seconds": 1.38,
      "text": "It's 30 milligrams."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 114.08,
      "end_seconds": 118.54,
      "duration_seconds": 4.46,
      "text": "Any inherited conditions that you know of in the family?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 119.17,
      "end_seconds": 121.4,
      "duration_seconds": 2.23,
      "text": "My cousin has psoriasis."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 123.78,
      "end_seconds": 126.08,
      "duration_seconds": 2.3,
      "text": "What about your medical history?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 127.72,
      "end_seconds": 134.62,
      "duration_seconds": 6.9,
      "text": "I've got acid reflux. I didn't want to make a fuss, uh, you know."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 136.22,
      "end_seconds": 142.64,
      "duration_seconds": 6.42,
      "text": "Right, so acid reflux is already on your record. We'll keep that in mind today."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 158.96,
      "end_seconds": 161.57,
      "duration_seconds": 2.61,
      "text": "Okay, is there someone at home?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 165.29,
      "end_seconds": 169.01,
      "duration_seconds": 3.72,
      "text": "My husband and I live above the shop."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 169.88,
      "end_seconds": 171.67,
      "duration_seconds": 1.79,
      "text": "How active are you?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 172.83,
      "end_seconds": 176.22,
      "duration_seconds": 3.39,
      "text": "I hardly move around during the day."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 177.9,
      "end_seconds": 180.52,
      "duration_seconds": 2.62,
      "text": "Do you follow any particular diet?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 181.35,
      "end_seconds": 185.22,
      "duration_seconds": 3.87,
      "text": "I'm vegetarian and have been for years."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 185.81,
      "end_seconds": 188.26,
      "duration_seconds": 2.45,
      "text": "Let me quickly check your readings."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 198.84,
      "end_seconds": 201.03,
      "duration_seconds": 2.19,
      "text": "Okay, this won't take long..."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 214.85,
      "end_seconds": 223.4,
      "duration_seconds": 8.55,
      "text": "Okay: heart rate 70, pressure 123 over 81, respiratory rate 15, temperature is 36.7 degrees, saturation 98 percent."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 227.1,
      "end_seconds": 229.05,
      "duration_seconds": 1.95,
      "text": "Is that alright, doctor?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 229.75,
      "end_seconds": 232.45,
      "duration_seconds": 2.7,
      "text": "I'll interpret them after the examination."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 233.92,
      "end_seconds": 236.78,
      "duration_seconds": 2.86,
      "text": "Let's move on to the examination."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 238.57,
      "end_seconds": 241.09,
      "duration_seconds": 2.52,
      "text": "Alright, tell me if that's sore."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 249.72,
      "end_seconds": 252.37,
      "duration_seconds": 2.65,
      "text": "The tongue looks smooth and red."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 253.53,
      "end_seconds": 254.55,
      "duration_seconds": 1.02,
      "text": "Sure thing."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 256.22,
      "end_seconds": 258.69,
      "duration_seconds": 2.47,
      "text": "Okay, I'm just checking this side."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 273.8,
      "end_seconds": 277.54,
      "duration_seconds": 3.74,
      "text": "Your vibration sense is reduced at the ankles."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 281.05,
      "end_seconds": 283.32,
      "duration_seconds": 2.27,
      "text": "Okay, that's enough for me."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 296.79,
      "end_seconds": 328.84,
      "duration_seconds": 32.05,
      "text": "So, based on the history and the examination, I think we're dealing with symptoms that fit a vitamin B12 deficiency at this stage. Let's book a thyroid test to look into tiredness. You'll be taking cyanocobalamin, 1000 micrograms, every other day, for two weeks. That's for low vitamin B12. The pharmacy will go through the details again when you pick it up. Eating more eggs, dairy and fortified cereals will help over time."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 329.95,
      "end_seconds": 347.57,
      "duration_seconds": 17.62,
      "text": "Try to keep a simple diary of when it happens and what you were doing, and bring it to the next visit. A vitamin B12 level is something we might do if this doesn't improve in two weeks."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 349.51,
      "end_seconds": 355.59,
      "duration_seconds": 6.08,
      "text": "Could I get a full blood count done? A friend had it."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 357.38,
      "end_seconds": 369.62,
      "duration_seconds": 12.24,
      "text": "Not right now, it wouldn't change what we do today. Book a review after the results are back. Right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 371.44,
      "end_seconds": 374.28,
      "duration_seconds": 2.84,
      "text": "Great, thank you for your help."
    }
  ]
}