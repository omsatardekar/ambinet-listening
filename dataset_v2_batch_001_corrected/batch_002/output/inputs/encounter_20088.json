{
  "schema_version": "1.0",
  "encounter_id": "20088",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.76,
      "end_seconds": 3.5,
      "duration_seconds": 2.74,
      "text": "Hello, come in. Mind the step."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 4.27,
      "end_seconds": 7.88,
      "duration_seconds": 3.61,
      "text": "Ah, good morning, doctor, thank you."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 8.9,
      "end_seconds": 10.67,
      "duration_seconds": 1.77,
      "text": "Where shall we begin?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 15.13,
      "end_seconds": 25.87,
      "duration_seconds": 10.74,
      "text": "Mainly a pounding heart. There's a couple of other things, you know, but that's the main one."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 26.85,
      "end_seconds": 29.81,
      "duration_seconds": 2.96,
      "text": "How long has this been bothering you?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 31.78,
      "end_seconds": 34.38,
      "duration_seconds": 2.6,
      "text": "Ever since... since Friday, really."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 35.74,
      "end_seconds": 39.34,
      "duration_seconds": 3.6,
      "text": "Right, would you say mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 39.91,
      "end_seconds": 48.13,
      "duration_seconds": 8.22,
      "text": "I, I'd call it severe. I've also had sudden hunger, for one week."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 48.79,
      "end_seconds": 54.41,
      "duration_seconds": 5.62,
      "text": "Have you had a pounding heart before, or is this the first time?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 59.94,
      "end_seconds": 66.5,
      "duration_seconds": 6.56,
      "text": "I had a similar thing about six months ago. It went away."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 67.39,
      "end_seconds": 73.12,
      "duration_seconds": 5.73,
      "text": "let me check a few things any slurred speech, vomiting or chest pain?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 74.38,
      "end_seconds": 80.59,
      "duration_seconds": 6.21,
      "text": "I haven't had slurred speech, vomiting or chest pain, no."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 81.38,
      "end_seconds": 83.82,
      "duration_seconds": 2.44,
      "text": "any fainting or blurred vision?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 84.71,
      "end_seconds": 88.44,
      "duration_seconds": 3.73,
      "text": "No, I haven't had any of them."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 90.36,
      "end_seconds": 92.57,
      "duration_seconds": 2.21,
      "text": "your breathing, any trouble there?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 94.14,
      "end_seconds": 96.94,
      "duration_seconds": 2.8,
      "text": "no, uh, nothing there"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 100.06,
      "end_seconds": 102.95,
      "duration_seconds": 2.89,
      "text": "Is your urine normal, no changes?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 103.79,
      "end_seconds": 105.38,
      "duration_seconds": 1.59,
      "text": "no changes there"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 107.32,
      "end_seconds": 108.23,
      "duration_seconds": 0.91,
      "text": "Any smoking?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 108.8,
      "end_seconds": 112.42,
      "duration_seconds": 3.62,
      "text": "I gave up cigarettes last spring."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 114.18,
      "end_seconds": 115.56,
      "duration_seconds": 1.38,
      "text": "what about alcohol?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 117.53,
      "end_seconds": 123.64,
      "duration_seconds": 6.11,
      "text": "I used to drink heavily but I stopped four years ago."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 124.18,
      "end_seconds": 125.63,
      "duration_seconds": 1.45,
      "text": "Are you active?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 126.83,
      "end_seconds": 129.77,
      "duration_seconds": 2.94,
      "text": "I walk the dog every morning."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 131.73,
      "end_seconds": 133.94,
      "duration_seconds": 2.21,
      "text": "Tell me about your eating."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 135.9,
      "end_seconds": 141.68,
      "duration_seconds": 5.78,
      "text": "I drink a lot of tea and snack through the day."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 142.33,
      "end_seconds": 145.38,
      "duration_seconds": 3.05,
      "text": "Are you in work at the moment?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 146.97,
      "end_seconds": 151.25,
      "duration_seconds": 4.28,
      "text": "Yes, I work in a bakery, early starts."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 163.86,
      "end_seconds": 166.75,
      "duration_seconds": 2.89,
      "text": "Before we go further, any allergies?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 167.38,
      "end_seconds": 170.09,
      "duration_seconds": 2.71,
      "text": "Erm, no allergies at all."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 172.1,
      "end_seconds": 174.23,
      "duration_seconds": 2.13,
      "text": "What about your medical history?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 174.74,
      "end_seconds": 186.88,
      "duration_seconds": 12.14,
      "text": "well, I've had diabetes for about ten years now okay, so I've had kidney disease for about a year now"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 187.93,
      "end_seconds": 188.91,
      "duration_seconds": 0.98,
      "text": "I follow"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 190.98,
      "end_seconds": 197.4,
      "duration_seconds": 6.42,
      "text": "Erm, you know, I have high blood pressure, for about a year."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 198.63,
      "end_seconds": 205.0,
      "duration_seconds": 6.37,
      "text": "yes okay, I can see diabetes and kidney disease in your file as well"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 217.5,
      "end_seconds": 219.84,
      "duration_seconds": 2.34,
      "text": "anything surgical in your history?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 220.35,
      "end_seconds": 226.52,
      "duration_seconds": 6.17,
      "text": "Yes, I had my womb taken out, fifteen years ago."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 227.35,
      "end_seconds": 230.68,
      "duration_seconds": 3.33,
      "text": "What do you take on a normal day?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 232.04,
      "end_seconds": 242.14,
      "duration_seconds": 10.1,
      "text": "Glimepiride, 2 milligrams, before breakfast. Hydrochlorothiazide. I take it 12.5 milligrams, every morning for my pressure."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 243.34,
      "end_seconds": 253.57,
      "duration_seconds": 10.23,
      "text": "Doctor, I've got the readings for you. SpO2 99 percent on room air, pressure 119 over 68, temp 36.6 degrees, heart rate 65."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 254.57,
      "end_seconds": 256.14,
      "duration_seconds": 1.57,
      "text": "Good, thank you."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 258.4,
      "end_seconds": 263.43,
      "duration_seconds": 5.03,
      "text": "I'd like to check you over now, if that's alright"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 264.25,
      "end_seconds": 265.73,
      "duration_seconds": 1.48,
      "text": "Look straight ahead."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 275.11,
      "end_seconds": 279.88,
      "duration_seconds": 4.77,
      "text": "Your fingerprick sugar now is normal and your heart rate is steady."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 289.43,
      "end_seconds": 291.08,
      "duration_seconds": 1.65,
      "text": "yes, that's fine"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 294.17,
      "end_seconds": 311.26,
      "duration_seconds": 17.09,
      "text": "So, that's the examination finished. Taking everything into account, it's hard to say. Episodes of low blood sugar related to diabetes treatment is one possibility and and an anxiety attack another, and I'd rather not commit yet."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 312.59,
      "end_seconds": 317.36,
      "duration_seconds": 4.77,
      "text": "I'm, I'm scared it's something bad. Is it?"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 319.01,
      "end_seconds": 334.32,
      "duration_seconds": 15.31,
      "text": "it's reasonable to to be concerned, but right now episodes of low blood sugar related to diabetes treatment is my leading thought, not anything worse i'll request an HbA1c, it'll help with diabetes control"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 335.37,
      "end_seconds": 337.16,
      "duration_seconds": 1.79,
      "text": "That makes sense."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 341.63,
      "end_seconds": 345.87,
      "duration_seconds": 4.24,
      "text": "I'll request a home sugar diary, it'll help with hypoglycaemia."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 347.35,
      "end_seconds": 348.97,
      "duration_seconds": 1.62,
      "text": "that makes sense"
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 350.67,
      "end_seconds": 365.59,
      "duration_seconds": 14.92,
      "text": "I'll request blood tests, it'll help with low sugar. Never skip meals when you take the sugar tablet, and keep glucose tablets or juice with you. Let's plan a check after the blood tests"
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 370.67,
      "end_seconds": 374.39,
      "duration_seconds": 3.72,
      "text": "Okay, so that's fine with me."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 375.23,
      "end_seconds": 379.3,
      "duration_seconds": 4.07,
      "text": "Okay, anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 379.81,
      "end_seconds": 381.73,
      "duration_seconds": 1.92,
      "text": "That's clear, thanks."
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 382.55,
      "end_seconds": 383.83,
      "duration_seconds": 1.28,
      "text": "Take care now."
    }
  ]
}