{
  "schema_version": "1.0",
  "encounter_id": "20162",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 1.26,
      "end_seconds": 5.58,
      "duration_seconds": 4.32,
      "text": "Doctor, we're ready in room two, I've already taken the observations."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.6,
      "end_seconds": 10.03,
      "duration_seconds": 3.43,
      "text": "Okay, thanks. Hi, how can I help today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 11.31,
      "end_seconds": 15.32,
      "duration_seconds": 4.01,
      "text": "Doctor, I'm just here to help with the details."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 17.26,
      "end_seconds": 21.01,
      "duration_seconds": 3.75,
      "text": "That's fine, sit down. We'll go through it together."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 22.29,
      "end_seconds": 30.19,
      "duration_seconds": 7.9,
      "text": "It's pain in my lower back, doctor. He didn't want to come, but I insisted."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 30.74,
      "end_seconds": 33.89,
      "duration_seconds": 3.15,
      "text": "Can you tell me when it first started?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 37.6,
      "end_seconds": 40.65,
      "duration_seconds": 3.05,
      "text": "It's been about a month now."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 42.56,
      "end_seconds": 45.33,
      "duration_seconds": 2.77,
      "text": "Is it bearing on you a lot?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 47.69,
      "end_seconds": 54.54,
      "duration_seconds": 6.85,
      "text": "Well, it's... hard to say, it's kind of... I don't know—"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 55.81,
      "end_seconds": 61.95,
      "duration_seconds": 6.14,
      "text": "Take your time. Mild, moderate, or severe, if you had to pick?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 62.76,
      "end_seconds": 64.41,
      "duration_seconds": 1.65,
      "text": "Mild, I'd say."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 65.2,
      "end_seconds": 71.63,
      "duration_seconds": 6.43,
      "text": "I was just going to say that the main thing is—"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 71.73,
      "end_seconds": 78.09,
      "duration_seconds": 6.36,
      "text": "Sorry to cut in, doctor, quick question: shall I bring the trolley in now or later?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 79.36,
      "end_seconds": 83.97,
      "duration_seconds": 4.61,
      "text": "Later, thanks. Please go on. Have you been feeling unsteady?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 84.98,
      "end_seconds": 90.69,
      "duration_seconds": 5.71,
      "text": "Yes, for about three months. There's a stooped back as well."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 92.67,
      "end_seconds": 99.31,
      "duration_seconds": 6.64,
      "text": "Have you had pain in your lower back before, or is this the first time?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 101.16,
      "end_seconds": 108.24,
      "duration_seconds": 7.08,
      "text": "Yes, something like this happened last year, and it went away on its own."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 108.83,
      "end_seconds": 112.49,
      "duration_seconds": 3.66,
      "text": "Any night pain or chest pain at all?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 113.2,
      "end_seconds": 123.89,
      "duration_seconds": 10.69,
      "text": "No, no night pain, no chest pain. I did have a painful wrist at one point, but that went away on its own."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 125.12,
      "end_seconds": 130.57,
      "duration_seconds": 5.45,
      "text": "Have you had any fever, numbness in the legs or bladder problems?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 131.27,
      "end_seconds": 138.08,
      "duration_seconds": 6.81,
      "text": "No fever, numbness in the legs or bladder problems, none of it."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 139.46,
      "end_seconds": 142.33,
      "duration_seconds": 2.87,
      "text": "Any breathing difficulties apart from this?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 142.89,
      "end_seconds": 144.6,
      "duration_seconds": 1.71,
      "text": "No, nothing there."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 146.32,
      "end_seconds": 149.65,
      "duration_seconds": 3.33,
      "text": "Alright, are there any illnesses in your family?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 150.94,
      "end_seconds": 158.18,
      "duration_seconds": 7.24,
      "text": "Actually, uh, my uncle has high cholesterol. My daughter has type 1 diabetes."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 160.25,
      "end_seconds": 165.52,
      "duration_seconds": 5.27,
      "text": "Tell me about your routine, work, habits, that sort of thing."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 167.61,
      "end_seconds": 175.71,
      "duration_seconds": 8.1,
      "text": "I quit smoking around ten years ago. I live with my elderly mother. I swim twice a week."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 177.44,
      "end_seconds": 180.15,
      "duration_seconds": 2.71,
      "text": "Have you had any surgical procedures?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 181.93,
      "end_seconds": 187.73,
      "duration_seconds": 5.8,
      "text": "I had my appendix taken out when I was in my twenties."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 189.47,
      "end_seconds": 192.77,
      "duration_seconds": 3.3,
      "text": "Alright, has anyone ever diagnosed you with something?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 194.74,
      "end_seconds": 206.25,
      "duration_seconds": 11.51,
      "text": "I've got thin bones. I have an underactive thyroid, for five years. Let me think, I've had an enlarged prostate for about a year now."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 208.11,
      "end_seconds": 216.39,
      "duration_seconds": 8.28,
      "text": "Okay, I can see an enlarged prostate in your file as well. Do you take any prescribed or over-the-counter medicines?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 218.43,
      "end_seconds": 225.2,
      "duration_seconds": 6.77,
      "text": "It's a... um, I can't remember what it's called. It's a little pink tablet."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 226.24,
      "end_seconds": 228.77,
      "duration_seconds": 2.53,
      "text": "Do you remember what it's for?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 229.93,
      "end_seconds": 247.96,
      "duration_seconds": 18.03,
      "text": "For my bones, I believe. My son sets them out for me, I just take what I'm given. Thyroxine, 75 micrograms, every morning for my thyroid. Tamsulosin. I take it 0.4 milligrams, at night for the prostate."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 248.61,
      "end_seconds": 256.52,
      "duration_seconds": 7.91,
      "text": "He is supposed to take it at night, but I can't say he always does."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 257.26,
      "end_seconds": 264.0,
      "duration_seconds": 6.74,
      "text": "I take something called calc... calcium tablets, 500 milligrams, maybe, twice a day."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 265.41,
      "end_seconds": 270.18,
      "duration_seconds": 4.77,
      "text": "Do you have the packet or the prescription with you?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 275.3,
      "end_seconds": 277.21,
      "duration_seconds": 1.91,
      "text": "No, it's at home."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 279.05,
      "end_seconds": 288.6,
      "duration_seconds": 9.55,
      "text": "Here are the numbers, doctor. BP is 123 over 80, temp 36.9 degrees, SpO2 97 percent on room air, heart rate 73."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 289.4,
      "end_seconds": 290.1,
      "duration_seconds": 0.7,
      "text": "Thanks."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 291.69,
      "end_seconds": 293.72,
      "duration_seconds": 2.03,
      "text": "May I examine you now?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 295.18,
      "end_seconds": 296.91,
      "duration_seconds": 1.73,
      "text": "Let me feel here."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 310.47,
      "end_seconds": 316.94,
      "duration_seconds": 6.47,
      "text": "There is tenderness over the mid lower spine and no weakness in the legs."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 319.11,
      "end_seconds": 320.98,
      "duration_seconds": 1.87,
      "text": "Please sit back down."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 337.94,
      "end_seconds": 354.51,
      "duration_seconds": 16.57,
      "text": "Let me tell you where I've got to. It points towards thin bones with a fragility fracture and back pain. I can't rule out a muscle strain yet. A spinal compression fracture is still possible."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 355.55,
      "end_seconds": 358.36,
      "duration_seconds": 2.81,
      "text": "Is there something to worry about?"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 359.48,
      "end_seconds": 382.28,
      "duration_seconds": 22.8,
      "text": "Nothing I've seen today points to an emergency. It looks like thin bones with a fragility fracture and back pain, but I'd like to confirm. So, to recap quickly. You've had pain in your lower back for about a month, mild, and no bladder problems or fever."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 384.36,
      "end_seconds": 386.56,
      "duration_seconds": 2.2,
      "text": "That's what happened, yes."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 404.17,
      "end_seconds": 408.4,
      "duration_seconds": 4.23,
      "text": "I'd like to arrange a spine X-ray for back pain."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_5",
      "role": "CLINICAL_STAFF",
      "start_seconds": 409.77,
      "end_seconds": 414.13,
      "duration_seconds": 4.36,
      "text": "We have a slot Monday at 2 pm, if that works."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 414.78,
      "end_seconds": 420.25,
      "duration_seconds": 5.47,
      "text": "A bone density scan is what I'd like next, for fracture risk."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 421.04,
      "end_seconds": 423.03,
      "duration_seconds": 1.99,
      "text": "Okay, I'll do it."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 423.89,
      "end_seconds": 444.86,
      "duration_seconds": 20.97,
      "text": "Take the weekly tablet first thing with a full glass of water and stay upright for half an hour. We'll refer you to the falls clinic. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 446.55,
      "end_seconds": 448.64,
      "duration_seconds": 2.09,
      "text": "Thank you, that's clear."
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 450.43,
      "end_seconds": 460.66,
      "duration_seconds": 10.23,
      "text": "If you have new weakness or numbness in your legs, that's the point to come in urgently. Okay, have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 462.2,
      "end_seconds": 466.38,
      "duration_seconds": 4.18,
      "text": "Right, I'll do that. Thank you, doctor."
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 467.6,
      "end_seconds": 468.78,
      "duration_seconds": 1.18,
      "text": "Look after yourself."
    }
  ]
}