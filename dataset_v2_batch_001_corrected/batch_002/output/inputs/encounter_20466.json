    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 251.7,
      "end_seconds": 253.91,
      "duration_seconds": 2.21,
      "text": "May I examine you now?"
