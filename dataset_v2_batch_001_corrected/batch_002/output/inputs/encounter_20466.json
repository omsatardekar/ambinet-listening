      "segment_id": "SEG0011",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 78.31,
      "end_seconds": 79.81,
      "duration_seconds": 1.5,
      "text": "no surgery no"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 80.46,
      "end_seconds": 87.2,
      "duration_seconds": 6.74,
      "text": "Are there any allergies I should be aware of? Just so I get the full picture."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 89.18,
      "end_seconds": 98.82,
      "duration_seconds": 9.64,
      "text": "Yes, diclofenac. I get wheezing. I was told I'm allergic to naproxen, but I don't remember what reaction I had."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
