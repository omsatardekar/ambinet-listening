      "role": "NURSE",
      "start_seconds": 44.78,
      "end_seconds": 51.2,
      "duration_seconds": 6.42,
      "text": "sorry to to cut in doctor quick question: shall I bring the trolley in now or later?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 52.79,
      "end_seconds": 54.97,
      "duration_seconds": 2.18,
      "text": "later, thanks. Please go on"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 55.77,
      "end_seconds": 60.21,
      "duration_seconds": 4.44,
      "text": "I've also had a sore tongue, for two months."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 74.0,
      "end_seconds": 76.89,
      "duration_seconds": 2.89,
      "text": "Have you had any previous surgeries?"
