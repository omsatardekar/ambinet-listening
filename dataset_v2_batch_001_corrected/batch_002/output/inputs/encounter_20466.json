      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 21.32,
      "end_seconds": 29.92,
      "duration_seconds": 8.6,
      "text": "can you describe it a bit more for me? How strong it is what the pattern is what helps"
