      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 166.74,
      "end_seconds": 170.63,
      "duration_seconds": 3.89,
      "text": "okay, any health conditions I should have on record?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 172.02,
      "end_seconds": 175.76,
      "duration_seconds": 3.74,
      "text": "I've got diabetes. Acid reflux for two years."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 177.38,
      "end_seconds": 178.08,
      "duration_seconds": 0.7,
      "text": "yes"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 180.08,
      "end_seconds": 183.43,
      "duration_seconds": 3.35,
      "text": "I have heart failure, for five years."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 189.44,
      "end_seconds": 197.93,
      "duration_seconds": 8.49,
      "text": "yes, heart failure is known to us, good to have that clear. Any rash or weight loss?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 201.11,
      "end_seconds": 212.99,
      "duration_seconds": 11.88,
      "text": "no no rash no weight loss. I did have being unsteady on my feet at one point but that went away on its own"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 214.68,
      "end_seconds": 219.12,
      "duration_seconds": 4.44,
      "text": "Any bladder problems, diarrhoea or loss of vision at all?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 220.03,
      "end_seconds": 224.89,
      "duration_seconds": 4.86,
      "text": "no no bladder problems diarrhoea or loss of vision"
    },
    {
      "segment_id": "SEG0031",
