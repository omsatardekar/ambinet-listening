      "role": "DOCTOR",
      "start_seconds": 144.95,
      "end_seconds": 150.36,
      "duration_seconds": 5.41,
      "text": "let's talk a a little about your daily life and habits"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 151.53,
      "end_seconds": 165.95,
      "duration_seconds": 14.42,
      "text": "I gave up cigarettes last spring. I used to drink heavily but I stopped four years ago. I retired from the post office two years ago."
