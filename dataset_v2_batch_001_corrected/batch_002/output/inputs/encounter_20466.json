      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 240.5,
      "end_seconds": 248.62,
      "duration_seconds": 8.12,
      "text": "here are the numbers, doctor bP is 120 over 69, heart rate 83. Respiratory rate 16, oxygen saturation is 97 percent"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 249.81,
      "end_seconds": 250.51,
      "duration_seconds": 0.7,
      "text": "Thanks."
