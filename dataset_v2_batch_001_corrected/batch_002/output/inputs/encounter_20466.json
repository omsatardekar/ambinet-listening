      "segment_id": "SEG0032",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 229.71,
      "end_seconds": 233.64,
      "duration_seconds": 3.93,
      "text": "not at all, no weakness of one side"
