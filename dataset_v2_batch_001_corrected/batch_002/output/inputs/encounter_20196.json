{
  "schema_version": "1.0",
  "encounter_id": "20196",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.04,
      "end_seconds": 5.23,
      "duration_seconds": 4.19,
      "text": "well, good evening, doctor, thanks for seeing me"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.29,
      "end_seconds": 11.47,
      "duration_seconds": 5.18,
      "text": "right, that's fine, sit down tell me why you came"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 12.41,
      "end_seconds": 19.58,
      "duration_seconds": 7.17,
      "text": "Uh, honestly, it's loss of taste, and my family pushed me to come."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 24.71,
      "end_seconds": 27.98,
      "duration_seconds": 3.27,
      "text": "How many days or weeks has it been?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 29.65,
      "end_seconds": 33.57,
      "duration_seconds": 3.92,
      "text": "I've had it for about a week"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 34.08,
      "end_seconds": 36.78,
      "duration_seconds": 2.7,
      "text": "is there anything else with it?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 38.0,
      "end_seconds": 47.96,
      "duration_seconds": 9.96,
      "text": "Aching all over goes along with it, most of the time. The Aching all over? That's been for ten days."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 48.42,
      "end_seconds": 52.43,
      "duration_seconds": 4.01,
      "text": "Ah. Any confusion, blue lips or chest pain at all?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 56.98,
      "end_seconds": 60.99,
      "duration_seconds": 4.01,
      "text": "No, I haven't had any of them."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 62.14,
      "end_seconds": 64.43,
      "duration_seconds": 2.29,
      "text": "anything unusual with passing urine?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 66.26,
      "end_seconds": 67.95,
      "duration_seconds": 1.69,
      "text": "No changes there."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 69.57,
      "end_seconds": 72.53,
      "duration_seconds": 2.96,
      "text": "Any rashes or skin problems otherwise?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 73.26,
      "end_seconds": 75.92,
      "duration_seconds": 2.66,
      "text": "nothing on the skin, no"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 88.55,
      "end_seconds": 91.39,
      "duration_seconds": 2.84,
      "text": "A few questions about your lifestyle now."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 93.48,
      "end_seconds": 111.41,
      "duration_seconds": 17.93,
      "text": "I have about eight cigarettes in a day. Nothing, I'm teetotal. I retired from the post office two years ago. I walk the dog every morning. I grab fast food at lunch most days"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 123.73,
      "end_seconds": 126.14,
      "duration_seconds": 2.41,
      "text": "Are you on any regular medication?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 130.36,
      "end_seconds": 132.16,
      "duration_seconds": 1.8,
      "text": "Nothing regular, no."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 141.34,
      "end_seconds": 143.68,
      "duration_seconds": 2.34,
      "text": "Have you got any known allergies?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 144.18,
      "end_seconds": 145.83,
      "duration_seconds": 1.65,
      "text": "Erythromycin, I'd say."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 157.69,
      "end_seconds": 161.6,
      "duration_seconds": 3.91,
      "text": "Any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 163.15,
      "end_seconds": 164.72,
      "duration_seconds": 1.57,
      "text": "no, no conditions"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 169.09,
      "end_seconds": 173.44,
      "duration_seconds": 4.35,
      "text": "can I check a few measurements before we carry on?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 185.69,
      "end_seconds": 188.4,
      "duration_seconds": 2.71,
      "text": "keep your arm relaxed for me.."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 205.44,
      "end_seconds": 214.96,
      "duration_seconds": 9.52,
      "text": "Okay: oxygen saturation is 93 percent, blood pressure 123 over 80. And pulse is 98 beats a minute, temperature 37.3."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 215.56,
      "end_seconds": 217.16,
      "duration_seconds": 1.6,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 218.17,
      "end_seconds": 222.67,
      "duration_seconds": 4.5,
      "text": "alright, don't worry, we'll discuss it in a second"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 225.33,
      "end_seconds": 228.03,
      "duration_seconds": 2.7,
      "text": "let's move on to the examination"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 229.26,
      "end_seconds": 230.24,
      "duration_seconds": 0.98,
      "text": "of course"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 232.14,
      "end_seconds": 233.62,
      "duration_seconds": 1.48,
      "text": "Nearly finished here."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 245.57,
      "end_seconds": 254.56,
      "duration_seconds": 8.99,
      "text": "Your chest is clear apart from a few crackles at the right base and your oxygen level is a bit low."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 256.46,
      "end_seconds": 257.42,
      "duration_seconds": 0.96,
      "text": "Of course."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 261.66,
      "end_seconds": 275.54,
      "duration_seconds": 13.88,
      "text": "That's all I needed to check. Having listened and examined, this is probably a viral chest infection with mildly low oxygen. The reason I say that is that your story and my examination fit together."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 276.43,
      "end_seconds": 279.36,
      "duration_seconds": 2.93,
      "text": "do you think it's something serious?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 280.74,
      "end_seconds": 311.1,
      "duration_seconds": 30.36,
      "text": "It's reasonable to be concerned, but right now a viral chest infection with mildly low oxygen is my leading thought, not anything worse. I'll request a viral swab, it'll help with fever and cough. It's a routine test and it'll give us a much clearer picture. Rest, keep your fluids up and lie on your tummy or side to help your breathing."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 312.42,
      "end_seconds": 336.35,
      "duration_seconds": 23.93,
      "text": "I'm not ordering a chest X-ray today. If things carry on in two weeks, we'll consider it. If you become more breathless or confused, or you feel really unwell, please come to the emergency department. Let's plan a check after the chest X-ray. Have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 338.42,
      "end_seconds": 340.21,
      "duration_seconds": 1.79,
      "text": "That's clear, thanks."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 341.45,
      "end_seconds": 342.74,
      "duration_seconds": 1.29,
      "text": "All the best."
    }
  ]
}