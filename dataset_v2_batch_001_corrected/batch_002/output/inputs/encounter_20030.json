{
  "schema_version": "1.0",
  "encounter_id": "20030",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.89,
      "end_seconds": 5.26,
      "duration_seconds": 4.37,
      "text": "Doctor? Hello, I hope this is the right time."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.52,
      "end_seconds": 10.11,
      "duration_seconds": 3.59,
      "text": "Come in. Please sit. How can I help you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 12.09,
      "end_seconds": 21.88,
      "duration_seconds": 9.79,
      "text": "Um, so... swelling around the ankle. That's why I came. My sister suggested writing things down, but I forgot."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 27.81,
      "end_seconds": 29.19,
      "duration_seconds": 1.38,
      "text": "Since when exactly?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 33.78,
      "end_seconds": 43.05,
      "duration_seconds": 9.27,
      "text": "About... well, ten days. I'd rather not end up on lots of tablets if I can avoid it."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 44.87,
      "end_seconds": 54.3,
      "duration_seconds": 9.43,
      "text": "Tell me a bit more about it: how bad it gets, how often, and whether anything makes it better or worse."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 55.9,
      "end_seconds": 63.86,
      "duration_seconds": 7.96,
      "text": "About a four out of ten. It's all the time. I get some relief from raising it."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 74.52,
      "end_seconds": 77.02,
      "duration_seconds": 2.5,
      "text": "Any cracking sound at the time?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 77.91,
      "end_seconds": 81.52,
      "duration_seconds": 3.61,
      "text": "No, no cracking sound at the time."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 82.28,
      "end_seconds": 88.92,
      "duration_seconds": 6.64,
      "text": "Have you noticed pain at the base of the fifth toe or previous fracture?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 90.33,
      "end_seconds": 96.86,
      "duration_seconds": 6.53,
      "text": "No, no pain at the base of the fifth toe or previous fracture."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 97.43,
      "end_seconds": 101.25,
      "duration_seconds": 3.82,
      "text": "Yes. Anything on the skin I should know about?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 102.23,
      "end_seconds": 103.2,
      "duration_seconds": 0.97,
      "text": "no rashes"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 107.98,
      "end_seconds": 109.27,
      "duration_seconds": 1.29,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 110.52,
      "end_seconds": 112.83,
      "duration_seconds": 2.31,
      "text": "No, you know, never."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 114.06,
      "end_seconds": 117.91,
      "duration_seconds": 3.85,
      "text": "Right, any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 118.72,
      "end_seconds": 120.25,
      "duration_seconds": 1.53,
      "text": "No, no conditions."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 121.83,
      "end_seconds": 125.99,
      "duration_seconds": 4.16,
      "text": "Do you react to any medicines or foods? Any allergies?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 127.9,
      "end_seconds": 130.39,
      "duration_seconds": 2.49,
      "text": "not to my knowledge, no"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 148.18,
      "end_seconds": 151.52,
      "duration_seconds": 3.34,
      "text": "is there any regular medication you use?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 153.19,
      "end_seconds": 154.74,
      "duration_seconds": 1.55,
      "text": "nothing regular, no"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 159.48,
      "end_seconds": 161.51,
      "duration_seconds": 2.03,
      "text": "do you live by yourself?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 163.25,
      "end_seconds": 167.0,
      "duration_seconds": 3.75,
      "text": "No, I share a house with my brother."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 168.53,
      "end_seconds": 169.94,
      "duration_seconds": 1.41,
      "text": "what's your work?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 171.84,
      "end_seconds": 176.18,
      "duration_seconds": 4.34,
      "text": "I'm a plumber, lots of bending and kneeling."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 177.54,
      "end_seconds": 179.92,
      "duration_seconds": 2.38,
      "text": "Let's start with the basic checks."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 186.76,
      "end_seconds": 189.34,
      "duration_seconds": 2.58,
      "text": "Keep your arm relaxed for me..."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 204.14,
      "end_seconds": 213.01,
      "duration_seconds": 8.87,
      "text": "Okay: BP is 112 over 69, heart rate 86, oxygen saturation is 99 percent. And temperature is 36.9 degrees."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 214.74,
      "end_seconds": 218.51,
      "duration_seconds": 3.77,
      "text": "let me look at the area, I'll be gentle"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 226.69,
      "end_seconds": 228.25,
      "duration_seconds": 1.56,
      "text": "Yes, that's fine."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 230.12,
      "end_seconds": 231.71,
      "duration_seconds": 1.59,
      "text": "Let me feel here."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 239.32,
      "end_seconds": 248.58,
      "duration_seconds": 9.26,
      "text": "There is swelling and bruising over the outer ankle and I can't find any bony tenderness at the back of the ankle bone."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 251.38,
      "end_seconds": 252.96,
      "duration_seconds": 1.58,
      "text": "Please sit back down."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 260.65,
      "end_seconds": 294.68,
      "duration_seconds": 34.03,
      "text": "Having listened and examined, I can't pin this down yet. We're looking at an ankle sprain without signs of a fracture or a tendon injury. An ankle X-ray is what I'd like next, for ankle injury. What I'm giving you is paracetamol, 1 gram, every six hours if needed, for five days. You take it by mouth. That's for ankle pain. Rest, ice, a firm bandage and keep it raised, and start gentle movement after two days."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 295.57,
      "end_seconds": 297.91,
      "duration_seconds": 2.34,
      "text": "That's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 299.11,
      "end_seconds": 301.24,
      "duration_seconds": 2.13,
      "text": "Thank you, doctor, goodbye."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 302.65,
      "end_seconds": 305.0,
      "duration_seconds": 2.35,
      "text": "alright, have a good day"
    }
  ]
}