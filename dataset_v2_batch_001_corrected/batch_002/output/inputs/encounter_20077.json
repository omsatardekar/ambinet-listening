{
  "schema_version": "1.0",
  "encounter_id": "20077",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.51,
      "end_seconds": 5.43,
      "duration_seconds": 4.92,
      "text": "Right then, come on in. How are things, what's been happening?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 6.88,
      "end_seconds": 16.99,
      "duration_seconds": 10.11,
      "text": "Mainly a cough that won't go away. There's a couple of other things, but that's the main one."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 19.08,
      "end_seconds": 20.7,
      "duration_seconds": 1.62,
      "text": "When did this begin?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 22.02,
      "end_seconds": 26.54,
      "duration_seconds": 4.52,
      "text": "Actually, it's been going on for about two weeks."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 28.34,
      "end_seconds": 31.16,
      "duration_seconds": 2.82,
      "text": "How much does it limit you?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 32.77,
      "end_seconds": 35.48,
      "duration_seconds": 2.71,
      "text": "It feels severe to me."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 35.79,
      "end_seconds": 39.79,
      "duration_seconds": 4.0,
      "text": "Hm, okay. Have you noticed anything else alongside it?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 41.18,
      "end_seconds": 49.11,
      "duration_seconds": 7.93,
      "text": "When it starts I tend to get a bit of a sore throat as well."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 53.21,
      "end_seconds": 56.85,
      "duration_seconds": 3.64,
      "text": "Have you been getting breathless on the stairs?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 57.91,
      "end_seconds": 64.96,
      "duration_seconds": 7.05,
      "text": "Yes, actually. The bit of a sore throat? That's been since Friday."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 67.24,
      "end_seconds": 72.08,
      "duration_seconds": 4.84,
      "text": "Okay, I'll examine you in a second, make yourself comfortable."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 74.05,
      "end_seconds": 76.33,
      "duration_seconds": 2.28,
      "text": "Hold that for a second."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 85.88,
      "end_seconds": 90.67,
      "duration_seconds": 4.79,
      "text": "The chest is clear and your oxygen level is normal."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 92.46,
      "end_seconds": 93.69,
      "duration_seconds": 1.23,
      "text": "Okay, doctor."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 99.46,
      "end_seconds": 101.13,
      "duration_seconds": 1.67,
      "text": "Please sit back down."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 109.28,
      "end_seconds": 116.26,
      "duration_seconds": 6.98,
      "text": "Right, any leg swelling, sharp chest pain, coughing up blood or weight loss at all?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 116.94,
      "end_seconds": 125.3,
      "duration_seconds": 8.36,
      "text": "I haven't had leg swelling, sharp chest pain, coughing up blood or weight loss, no."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 125.86,
      "end_seconds": 130.05,
      "duration_seconds": 4.19,
      "text": "What about your tummy and bowels, anything unusual there?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 131.03,
      "end_seconds": 134.77,
      "duration_seconds": 3.74,
      "text": "Yeah, bowels are regular, nothing odd."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 136.05,
      "end_seconds": 138.04,
      "duration_seconds": 1.99,
      "text": "Anything unusual with passing urine?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 143.06,
      "end_seconds": 144.57,
      "duration_seconds": 1.51,
      "text": "No changes there."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 159.53,
      "end_seconds": 163.36,
      "duration_seconds": 3.83,
      "text": "Anything in your past medical history I should know?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 164.21,
      "end_seconds": 174.62,
      "duration_seconds": 10.41,
      "text": "Well, I've had asthma, yes. I wasn't sure whether to come in at all, to be honest."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 175.84,
      "end_seconds": 181.55,
      "duration_seconds": 5.71,
      "text": "Okay, I can see asthma in your file as well. Any previous surgeries?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 183.31,
      "end_seconds": 184.63,
      "duration_seconds": 1.32,
      "text": "No, never."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 185.85,
      "end_seconds": 190.34,
      "duration_seconds": 4.49,
      "text": "Has anything ever caused you a reaction? I mean any allergies."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 192.04,
      "end_seconds": 195.65,
      "duration_seconds": 3.61,
      "text": "Yes, grass pollen. I get itchy eyes."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 197.55,
      "end_seconds": 199.92,
      "duration_seconds": 2.37,
      "text": "Do you get out much?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 201.27,
      "end_seconds": 205.64,
      "duration_seconds": 4.37,
      "text": "Not much, I mostly stay in these days."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 206.79,
      "end_seconds": 209.65,
      "duration_seconds": 2.86,
      "text": "Are you on your own at home?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 211.66,
      "end_seconds": 215.11,
      "duration_seconds": 3.45,
      "text": "I live with my elderly mother."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 216.71,
      "end_seconds": 219.71,
      "duration_seconds": 3.0,
      "text": "Are you in work at the moment?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 221.75,
      "end_seconds": 226.22,
      "duration_seconds": 4.47,
      "text": "Yes, I work in a bakery, early starts."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 227.94,
      "end_seconds": 232.79,
      "duration_seconds": 4.85,
      "text": "Can you list what you take, tablets, creams or inhalers?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 233.81,
      "end_seconds": 239.82,
      "duration_seconds": 6.01,
      "text": "Seretide inhaler. I take it twice a day for my asthma."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 255.28,
      "end_seconds": 263.95,
      "duration_seconds": 8.67,
      "text": "Right, here's what I'm thinking. I'd lean towards a lingering cough after a viral infection. We shouldn't forget reflux."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 265.61,
      "end_seconds": 268.66,
      "duration_seconds": 3.05,
      "text": "What are the odds it's serious?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 270.39,
      "end_seconds": 282.86,
      "duration_seconds": 12.47,
      "text": "Nothing I've seen today points to an emergency. It looks like a lingering cough after a viral infection, but I'd like to confirm. We should do a breathing test for breathlessness."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 283.71,
      "end_seconds": 286.61,
      "duration_seconds": 2.9,
      "text": "The earliest is Monday, 11:30 am."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 287.56,
      "end_seconds": 313.53,
      "duration_seconds": 25.97,
      "text": "Let's get a chest X-ray, for persistent cough. I'd rather check than guess, and this is the quickest way to know more. For this, salbutamol inhaler, 100 micrograms, two puffs when needed, for two weeks. That should help with wheeze and cough. I'll put all of this in writing so you don't have to remember it."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 314.34,
      "end_seconds": 317.36,
      "duration_seconds": 3.02,
      "text": "Fine, uh, I'll begin it."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 319.36,
      "end_seconds": 325.08,
      "duration_seconds": 5.72,
      "text": "Honey and lemon in warm water can ease it, and avoid smoky rooms."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 325.64,
      "end_seconds": 329.89,
      "duration_seconds": 4.25,
      "text": "I follow. Anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 333.27,
      "end_seconds": 337.39,
      "duration_seconds": 4.12,
      "text": "I mean, I think I understand everything. Thanks."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 338.56,
      "end_seconds": 339.99,
      "duration_seconds": 1.43,
      "text": "Goodbye for now."
    }
  ]
}