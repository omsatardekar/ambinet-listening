{
  "schema_version": "1.0",
  "encounter_id": "20065",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.81,
      "end_seconds": 5.47,
      "duration_seconds": 4.66,
      "text": "Hi, doctor, I hope I'm not disturbing you."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.68,
      "end_seconds": 10.83,
      "duration_seconds": 4.15,
      "text": "Of course, leave it there. How can I help?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 12.73,
      "end_seconds": 16.35,
      "duration_seconds": 3.62,
      "text": "So, I've been feeling lightheaded, doctor."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 16.86,
      "end_seconds": 20.75,
      "duration_seconds": 3.89,
      "text": "Can you tell me when it first started?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 21.42,
      "end_seconds": 24.19,
      "duration_seconds": 2.77,
      "text": "I've had it for two months."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 26.2,
      "end_seconds": 32.11,
      "duration_seconds": 5.91,
      "text": "Is it there all the time or does it come and go?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 33.72,
      "end_seconds": 36.87,
      "duration_seconds": 3.15,
      "text": "It sort of comes and goes."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 37.97,
      "end_seconds": 41.86,
      "duration_seconds": 3.89,
      "text": "Is it a lot or only a little?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 42.8,
      "end_seconds": 44.37,
      "duration_seconds": 1.57,
      "text": "I'd say mild."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 49.55,
      "end_seconds": 52.33,
      "duration_seconds": 2.78,
      "text": "Is there something that settles it?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 53.62,
      "end_seconds": 56.86,
      "duration_seconds": 3.24,
      "text": "I get some relief from sitting down."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 57.35,
      "end_seconds": 62.65,
      "duration_seconds": 5.3,
      "text": "Yes, carry on. Did you get chest pain, leg swelling or sweating?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 63.15,
      "end_seconds": 66.53,
      "duration_seconds": 3.38,
      "text": "No, I haven't had any of them."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 70.01,
      "end_seconds": 72.83,
      "duration_seconds": 2.82,
      "text": "So, is your chest okay generally?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 73.42,
      "end_seconds": 75.16,
      "duration_seconds": 1.74,
      "text": "No, nothing there."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 77.26,
      "end_seconds": 80.7,
      "duration_seconds": 3.44,
      "text": "A few questions about your lifestyle now."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 84.23,
      "end_seconds": 95.55,
      "duration_seconds": 11.32,
      "text": "I have about eight cigarettes in a day. I swim twice a week. I look after my grandchildren most days."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 108.5,
      "end_seconds": 113.96,
      "duration_seconds": 5.46,
      "text": "Alright, do you have any medical conditions I should know about?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 115.49,
      "end_seconds": 118.55,
      "duration_seconds": 3.06,
      "text": "No, you know, no conditions."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 119.23,
      "end_seconds": 124.2,
      "duration_seconds": 4.97,
      "text": "Any allergies to tablets, food or anything in the environment?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 125.25,
      "end_seconds": 129.03,
      "duration_seconds": 3.78,
      "text": "I don't think I have any, no."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 129.86,
      "end_seconds": 133.47,
      "duration_seconds": 3.61,
      "text": "Okay, is there any regular medication you use?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 134.59,
      "end_seconds": 136.98,
      "duration_seconds": 2.39,
      "text": "No, I'm not on anything."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 149.63,
      "end_seconds": 153.6,
      "duration_seconds": 3.97,
      "text": "Let me get the readings out of the way."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 164.07,
      "end_seconds": 166.97,
      "duration_seconds": 2.9,
      "text": "That's it, just a little longer..."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 182.41,
      "end_seconds": 193.08,
      "duration_seconds": 10.67,
      "text": "Okay: pulse is 122 beats a minute, temperature is 37.1 degrees. And SpO2 97 percent on room air, pressure 129 over 74."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 196.02,
      "end_seconds": 199.51,
      "duration_seconds": 3.49,
      "text": "Could you come over to the couch, please?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 200.66,
      "end_seconds": 202.07,
      "duration_seconds": 1.41,
      "text": "Nearly finished here."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 218.37,
      "end_seconds": 221.54,
      "duration_seconds": 3.17,
      "text": "Heart sounds are normal with no murmur."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 222.7,
      "end_seconds": 223.93,
      "duration_seconds": 1.23,
      "text": "Look straight ahead."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 235.46,
      "end_seconds": 240.01,
      "duration_seconds": 4.55,
      "text": "The pulse is irregular, around ninety beats a minute."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 243.73,
      "end_seconds": 245.49,
      "duration_seconds": 1.76,
      "text": "All finished, thank you."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 258.81,
      "end_seconds": 271.8,
      "duration_seconds": 12.99,
      "text": "So, based on the history and the examination, I'm honestly not certain yet. It could be paroxysmal palpitations, possibly an atrial arrhythmia, or it might be an overactive thyroid."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 272.73,
      "end_seconds": 274.54,
      "duration_seconds": 1.81,
      "text": "Will it clear up?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 276.59,
      "end_seconds": 286.08,
      "duration_seconds": 9.49,
      "text": "It's reasonable to be concerned, but right now paroxysmal palpitations, possibly an atrial arrhythmia is my leading thought, not anything worse."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 300.69,
      "end_seconds": 314.65,
      "duration_seconds": 13.96,
      "text": "I'm going to order a thyroid test, for palpitations. I'd like you to take bisoprolol, 2.5 milligrams, once a day, until review. You take it by mouth. That's for heart rate control."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 316.54,
      "end_seconds": 319.91,
      "duration_seconds": 3.37,
      "text": "Should I take that with food?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 321.95,
      "end_seconds": 337.24,
      "duration_seconds": 15.29,
      "text": "Cut right back on coffee, tea and energy drinks for now. I'd like you back after the monitor results are back. Alright, that's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 338.88,
      "end_seconds": 341.1,
      "duration_seconds": 2.22,
      "text": "Thank you, that's helpful."
    }
  ]
}