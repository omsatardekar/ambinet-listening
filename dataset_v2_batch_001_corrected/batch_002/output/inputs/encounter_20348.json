{
  "schema_version": "1.0",
  "encounter_id": "20348",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.07,
      "end_seconds": 7.05,
      "duration_seconds": 5.98,
      "text": "Hello, come in. Mind the step. How are things, what's been happening?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 7.59,
      "end_seconds": 13.03,
      "duration_seconds": 5.44,
      "text": "Erm, I wanted to get swelling of my lips looked at."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 14.74,
      "end_seconds": 17.61,
      "duration_seconds": 2.87,
      "text": "How long has it been like this?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 18.18,
      "end_seconds": 20.89,
      "duration_seconds": 2.71,
      "text": "I've had it for ten days."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 21.75,
      "end_seconds": 30.52,
      "duration_seconds": 8.77,
      "text": "Tell me a bit more about it: how bad it gets, how often, and whether anything makes it better or worse."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 32.41,
      "end_seconds": 53.92,
      "duration_seconds": 21.51,
      "text": "pretty mild, if I'm being honest. I'd say a couple of times a week. Sorry, I know I'm rambling a bit. And I've been feeling a bit lightheaded as well, uh, for ten days. About feeling a bit lightheaded, I'd say mild"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 55.3,
      "end_seconds": 58.33,
      "duration_seconds": 3.03,
      "text": "I'll note down your vital signs first."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 71.37,
      "end_seconds": 74.0,
      "duration_seconds": 2.63,
      "text": "Okay, sit still for a moment..."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 83.83,
      "end_seconds": 93.82,
      "duration_seconds": 9.99,
      "text": "Okay: blood pressure 113 over 79, oxygen saturation is 98 percent, pulse is 78 beats a minute. And temp 36.7 degrees."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 102.18,
      "end_seconds": 107.46,
      "duration_seconds": 5.28,
      "text": "So, any wheeze, new food, throat tightness or trouble breathing?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 108.21,
      "end_seconds": 115.21,
      "duration_seconds": 7.0,
      "text": "I haven't had wheeze, new food, throat tightness or trouble breathing, no."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 115.6,
      "end_seconds": 117.18,
      "duration_seconds": 1.58,
      "text": "ah nothing like vomiting?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 119.27,
      "end_seconds": 122.43,
      "duration_seconds": 3.16,
      "text": "okay, so no, none, no vomiting"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 123.18,
      "end_seconds": 125.61,
      "duration_seconds": 2.43,
      "text": "your breathing, any trouble there?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 126.48,
      "end_seconds": 130.7,
      "duration_seconds": 4.22,
      "text": "right, you know, no problems with breathing"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 132.16,
      "end_seconds": 135.2,
      "duration_seconds": 3.04,
      "text": "How are your joints, any aches elsewhere?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 135.86,
      "end_seconds": 137.86,
      "duration_seconds": 2.0,
      "text": "I move fine otherwise"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 139.9,
      "end_seconds": 142.73,
      "duration_seconds": 2.83,
      "text": "have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 144.22,
      "end_seconds": 146.9,
      "duration_seconds": 2.68,
      "text": "No surgery, um, no."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 147.45,
      "end_seconds": 150.44,
      "duration_seconds": 2.99,
      "text": "What do you do during the day?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 151.62,
      "end_seconds": 155.01,
      "duration_seconds": 3.39,
      "text": "I look after my grandchildren most days."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 155.85,
      "end_seconds": 157.84,
      "duration_seconds": 1.99,
      "text": "Is there someone at home?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 158.37,
      "end_seconds": 162.39,
      "duration_seconds": 4.02,
      "text": "My husband and I live above the shop."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 164.49,
      "end_seconds": 166.24,
      "duration_seconds": 1.75,
      "text": "How active are you?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 167.73,
      "end_seconds": 171.07,
      "duration_seconds": 3.34,
      "text": "I hardly move around during the day."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 188.37,
      "end_seconds": 192.06,
      "duration_seconds": 3.69,
      "text": "Anything in your past medical history I should know?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 193.78,
      "end_seconds": 200.52,
      "duration_seconds": 6.74,
      "text": "I've got asthma. I'd rather know what's going on than keep guessing."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 202.29,
      "end_seconds": 206.73,
      "duration_seconds": 4.44,
      "text": "Ah. Are you taking anything regularly, including from the pharmacy?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 207.31,
      "end_seconds": 209.94,
      "duration_seconds": 2.63,
      "text": "Foracort inhaler, twice a day."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 210.49,
      "end_seconds": 211.52,
      "duration_seconds": 1.03,
      "text": "Right, right."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 213.46,
      "end_seconds": 215.51,
      "duration_seconds": 2.05,
      "text": "Cetirizine, when it flares."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 216.14,
      "end_seconds": 218.33,
      "duration_seconds": 2.19,
      "text": "Do you know the dose?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 222.31,
      "end_seconds": 231.41,
      "duration_seconds": 9.1,
      "text": "10 milligrams, I think that's what's on the box. I used to take Seretide inhaler, but I stopped it."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 232.68,
      "end_seconds": 235.63,
      "duration_seconds": 2.95,
      "text": "Before we go further, any allergies?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 236.38,
      "end_seconds": 241.95,
      "duration_seconds": 5.57,
      "text": "Yes, nickel, it gives me a rash on my skin."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 243.57,
      "end_seconds": 259.71,
      "duration_seconds": 16.14,
      "text": "Going by what you've described, I'd lean towards an allergic reaction, possibly to a recently started medicine. The reason I say that is that the way you describe it fits together. A viral rash is still possible."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 272.15,
      "end_seconds": 306.24,
      "duration_seconds": 34.09,
      "text": "For this, chlorphenamine, 4 milligrams, every six hours, for three days. You take it by mouth. It's for allergic rash. Let's use prednisolone, 30 milligrams, once a day, for three days. You take it by mouth. That's for allergic reaction. Stop the new tablet until we know what caused it and write down every medicine you took in the last week. Book a review after the review. Is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 309.08,
      "end_seconds": 312.26,
      "duration_seconds": 3.18,
      "text": "no, that's all thanks a lot"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 313.3,
      "end_seconds": 314.76,
      "duration_seconds": 1.46,
      "text": "All the best."
    }
  ]
}