{
  "schema_version": "1.0",
  "encounter_id": "20396",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.1,
      "end_seconds": 4.96,
      "duration_seconds": 3.86,
      "text": "Hi, doctor, I hope I'm not disturbing you."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.93,
      "end_seconds": 10.31,
      "duration_seconds": 4.38,
      "text": "Of course, leave it there. How can I help?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 11.5,
      "end_seconds": 18.33,
      "duration_seconds": 6.83,
      "text": "It's headaches in the morning. I thought I'd wait, but it hasn't gone."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 19.22,
      "end_seconds": 21.85,
      "duration_seconds": 2.63,
      "text": "What's on your current medicine list?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 22.85,
      "end_seconds": 27.15,
      "duration_seconds": 4.3,
      "text": "Well, I'm on simvastatin, at night for my cholesterol."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 28.25,
      "end_seconds": 30.67,
      "duration_seconds": 2.42,
      "text": "Do you know the dose?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 32.35,
      "end_seconds": 33.25,
      "duration_seconds": 0.9,
      "text": "20 milligrams."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 34.88,
      "end_seconds": 36.12,
      "duration_seconds": 1.24,
      "text": "Is that long-standing?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 37.73,
      "end_seconds": 39.31,
      "duration_seconds": 1.58,
      "text": "For two months."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 39.85,
      "end_seconds": 43.73,
      "duration_seconds": 3.88,
      "text": "Can you tell me when it first started?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 45.41,
      "end_seconds": 50.91,
      "duration_seconds": 5.5,
      "text": "About... well, four weeks. I've been putting this off for weeks."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 51.36,
      "end_seconds": 55.79,
      "duration_seconds": 4.43,
      "text": "Okay, go on. How strong would you say it is?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 56.7,
      "end_seconds": 58.83,
      "duration_seconds": 2.13,
      "text": "It's, It's mild, honestly."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 60.32,
      "end_seconds": 62.68,
      "duration_seconds": 2.36,
      "text": "Is it accompanied by anything?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 63.74,
      "end_seconds": 76.52,
      "duration_seconds": 12.78,
      "text": "I mean, you know, when it starts I tend to get blurred vision at times as well. The blurred vision at times? That's been for two years."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 78.28,
      "end_seconds": 81.49,
      "duration_seconds": 3.21,
      "text": "How strong would you say it is?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 82.31,
      "end_seconds": 93.37,
      "duration_seconds": 11.06,
      "text": "Moderate, I'd say. Oh, and a pounding feeling in my neck. That's been about the same, about three months."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 94.0,
      "end_seconds": 99.67,
      "duration_seconds": 5.67,
      "text": "Have you had headaches in the morning before, or is this the first time?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 101.47,
      "end_seconds": 106.68,
      "duration_seconds": 5.21,
      "text": "I had a similar thing last winter. It went away."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 107.71,
      "end_seconds": 113.59,
      "duration_seconds": 5.88,
      "text": "Any chest pain, weakness on one side or passing less urine at all?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 114.67,
      "end_seconds": 117.05,
      "duration_seconds": 2.38,
      "text": "No, none that I've noticed."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 118.86,
      "end_seconds": 122.44,
      "duration_seconds": 3.58,
      "text": "Any slurred speech or ankle swelling at all?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 123.55,
      "end_seconds": 128.22,
      "duration_seconds": 4.67,
      "text": "Hmm, no, no slurred speech or ankle swelling."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 129.51,
      "end_seconds": 132.11,
      "duration_seconds": 2.6,
      "text": "And your skin, any changes there?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 133.65,
      "end_seconds": 135.73,
      "duration_seconds": 2.08,
      "text": "No, skin's been fine."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 136.47,
      "end_seconds": 138.43,
      "duration_seconds": 1.96,
      "text": "Is your digestion otherwise okay?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 140.31,
      "end_seconds": 142.74,
      "duration_seconds": 2.43,
      "text": "Bowels are regular, nothing odd."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 144.13,
      "end_seconds": 148.56,
      "duration_seconds": 4.43,
      "text": "Let's talk a little about your daily life and habits."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 150.08,
      "end_seconds": 166.31,
      "duration_seconds": 16.23,
      "text": "I only drink at family occasions. I gave up cigarettes last spring. I'm a hairdresser, on my feet all day. I hardly move around during the day. I live with my elderly mother."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 168.22,
      "end_seconds": 173.09,
      "duration_seconds": 4.87,
      "text": "What conditions have you been treated for in the past?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 174.33,
      "end_seconds": 176.6,
      "duration_seconds": 2.27,
      "text": "I've got high cholesterol."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 181.98,
      "end_seconds": 186.23,
      "duration_seconds": 4.25,
      "text": "Alright, high cholesterol, that matches what I have here."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 198.42,
      "end_seconds": 201.29,
      "duration_seconds": 2.87,
      "text": "Let's start with the basic checks."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 210.23,
      "end_seconds": 213.63,
      "duration_seconds": 3.4,
      "text": "Alright, that's it, just a little longer..."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 234.23,
      "end_seconds": 243.94,
      "duration_seconds": 9.71,
      "text": "Okay: pulse is 83 beats a minute, respiratory rate 14, BP is 170 over 92, SpO2 98 percent on room air."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 246.03,
      "end_seconds": 247.49,
      "duration_seconds": 1.46,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 248.45,
      "end_seconds": 252.33,
      "duration_seconds": 3.88,
      "text": "They help me see the whole picture, more shortly."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 254.19,
      "end_seconds": 257.97,
      "duration_seconds": 3.78,
      "text": "Alright, over here please and I'll take a look."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 259.33,
      "end_seconds": 260.23,
      "duration_seconds": 0.9,
      "text": "That's alright."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 262.21,
      "end_seconds": 263.59,
      "duration_seconds": 1.38,
      "text": "Breathe out slowly."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 272.14,
      "end_seconds": 277.4,
      "duration_seconds": 5.26,
      "text": "The back of your eyes looks fine and your heart sounds are normal."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 281.19,
      "end_seconds": 283.77,
      "duration_seconds": 2.58,
      "text": "Alright, that's the examination finished."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 297.88,
      "end_seconds": 317.31,
      "duration_seconds": 19.43,
      "text": "So where does that leave us? I think we're dealing with poorly controlled high blood pressure at this stage. The reason I say that is that your story and my examination fit together. I'd also keep sleep apnoea in mind."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 333.76,
      "end_seconds": 342.1,
      "duration_seconds": 8.34,
      "text": "Let's book a home blood pressure diary to look into hypertension. I'd like to arrange blood tests for hypertension."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 342.87,
      "end_seconds": 346.62,
      "duration_seconds": 3.75,
      "text": "Well, where would I go for that?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 348.38,
      "end_seconds": 378.94,
      "duration_seconds": 30.56,
      "text": "What I'm giving you is amlodipine, 5 milligrams, once a day, long term. That's for high blood pressure. The pharmacy will go through the details again when you pick it up. Check your blood pressure at home twice a day for a week and bring the readings. Let's hold off on a urine test for now, and if there's no change in two weeks we can revisit it."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 379.77,
      "end_seconds": 391.48,
      "duration_seconds": 11.71,
      "text": "Keep an eye out, and if you get chest pain, weakness or trouble speaking, call us the same day or go to emergency."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 393.5,
      "end_seconds": 396.8,
      "duration_seconds": 3.3,
      "text": "I know what to watch for."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 398.58,
      "end_seconds": 400.77,
      "duration_seconds": 2.19,
      "text": "Come back in two weeks."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 402.33,
      "end_seconds": 406.01,
      "duration_seconds": 3.68,
      "text": "I, I'll note it in my calendar."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 407.0,
      "end_seconds": 409.5,
      "duration_seconds": 2.5,
      "text": "Does all of that make sense?"
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 411.41,
      "end_seconds": 415.8,
      "duration_seconds": 4.39,
      "text": "So, okay, that makes sense. Thanks for explaining."
    }
  ]
}