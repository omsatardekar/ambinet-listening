    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 199.79,
      "end_seconds": 216.6,
      "duration_seconds": 16.81,
      "text": "Right, um, I've had thin bones for about ten years now. Uh, I have an underactive thyroid, for about a year. It's a relief to finally sit down and talk about it."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 217.69,
      "end_seconds": 221.03,
      "duration_seconds": 3.34,
      "text": "so so I'll do your observations first"
