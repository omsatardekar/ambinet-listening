      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 135.9,
      "end_seconds": 141.77,
      "duration_seconds": 5.87,
      "text": "It's 50 micrograms. It's calcium tablets 500 milligrams twice a day."
