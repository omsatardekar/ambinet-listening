      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 122.55,
      "end_seconds": 131.57,
      "duration_seconds": 9.02,
      "text": "I take alendronate, 70 milligrams, once a week. Mm, I take Thyronorm, every morning for my thyroid."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 132.15,
      "end_seconds": 134.68,
      "duration_seconds": 2.53,
      "text": "Right, how much do you take?"
