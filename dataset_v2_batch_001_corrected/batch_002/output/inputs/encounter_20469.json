    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 172.92,
      "end_seconds": 175.27,
      "duration_seconds": 2.35,
      "text": "have you had any previous surgeries?"
