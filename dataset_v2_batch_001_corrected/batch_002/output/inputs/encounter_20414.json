{
  "schema_version": "1.0",
  "encounter_id": "20414",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.96,
      "end_seconds": 5.51,
      "duration_seconds": 4.55,
      "text": "Hello, you know, doctor. May I come in?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.1,
      "end_seconds": 10.79,
      "duration_seconds": 3.69,
      "text": "No problem at all, come in. What's troubling you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 11.44,
      "end_seconds": 18.86,
      "duration_seconds": 7.42,
      "text": "Well, I've been having a painful rash on one side of my chest."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 20.68,
      "end_seconds": 23.96,
      "duration_seconds": 3.28,
      "text": "How long has it been like this?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 25.53,
      "end_seconds": 31.99,
      "duration_seconds": 6.46,
      "text": "Two weeks, I think... sorry, about a week, I got that wrong."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 32.53,
      "end_seconds": 40.53,
      "duration_seconds": 8.0,
      "text": "Can you describe it a bit more for me? How strong it is, what the pattern is, what helps."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 42.59,
      "end_seconds": 56.79,
      "duration_seconds": 14.2,
      "text": "I notice it more with clothes rubbing. Severe, I'd say. It's a couple of times a week. Oh, you know, I've had a headache too, for one week."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 57.84,
      "end_seconds": 61.06,
      "duration_seconds": 3.22,
      "text": "Any small blisters in a band as well?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 61.6,
      "end_seconds": 65.85,
      "duration_seconds": 4.25,
      "text": "Yeah. Two days, um, I'd say."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 67.4,
      "end_seconds": 75.98,
      "duration_seconds": 8.58,
      "text": "Have you had a painful rash on one side of your chest before, or is this the first time?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 77.38,
      "end_seconds": 84.9,
      "duration_seconds": 7.52,
      "text": "Yes, something like this happened last year, and it went away on its own."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 86.91,
      "end_seconds": 89.87,
      "duration_seconds": 2.96,
      "text": "What operations have you had, if any?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 91.93,
      "end_seconds": 99.51,
      "duration_seconds": 7.58,
      "text": "Let me think, um, I had my tonsils removed as a teenager."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 112.52,
      "end_seconds": 119.12,
      "duration_seconds": 6.6,
      "text": "Before we go further, any allergies? I ask because it helps me narrow things down."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 120.3,
      "end_seconds": 124.21,
      "duration_seconds": 3.91,
      "text": "So, yes, cat fur. I get wheezing."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 125.88,
      "end_seconds": 131.01,
      "duration_seconds": 5.13,
      "text": "Do you have any long-term conditions? I'll explain everything as we go along."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 132.43,
      "end_seconds": 138.63,
      "duration_seconds": 6.2,
      "text": "Yes, high blood pressure. I, I have asthma, for about ten years."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 141.89,
      "end_seconds": 146.79,
      "duration_seconds": 4.9,
      "text": "Okay, I can see high blood pressure in your file as well."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 162.84,
      "end_seconds": 165.84,
      "duration_seconds": 3.0,
      "text": "Right, do you live by yourself?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 167.43,
      "end_seconds": 171.52,
      "duration_seconds": 4.09,
      "text": "No, I share a house with my brother."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 173.04,
      "end_seconds": 175.85,
      "duration_seconds": 2.81,
      "text": "Do you follow any particular diet?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 177.52,
      "end_seconds": 181.7,
      "duration_seconds": 4.18,
      "text": "I'm vegetarian and have been for years."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 183.58,
      "end_seconds": 186.45,
      "duration_seconds": 2.87,
      "text": "Okay, anything you do to stay fit?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 191.2,
      "end_seconds": 195.21,
      "duration_seconds": 4.01,
      "text": "I do a yoga class on Thursdays."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 195.9,
      "end_seconds": 197.99,
      "duration_seconds": 2.09,
      "text": "Tell me your medicines, please."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 198.95,
      "end_seconds": 208.24,
      "duration_seconds": 9.29,
      "text": "Sorry, you know, what was I saying, I'm on Dolo, 650 milligrams, when I get the pain."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 209.96,
      "end_seconds": 212.27,
      "duration_seconds": 2.31,
      "text": "Have you had any confusion?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 212.85,
      "end_seconds": 214.48,
      "duration_seconds": 1.63,
      "text": "No, no confusion."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 215.46,
      "end_seconds": 221.64,
      "duration_seconds": 6.18,
      "text": "A few quick ones: contact with chickenpox, rash near the eye or vision changes?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 222.95,
      "end_seconds": 231.06,
      "duration_seconds": 8.11,
      "text": "I haven't had contact with chickenpox, rash near the eye or vision changes, no."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 232.5,
      "end_seconds": 237.04,
      "duration_seconds": 4.54,
      "text": "What about your tummy and bowels, anything unusual there?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 238.98,
      "end_seconds": 241.8,
      "duration_seconds": 2.82,
      "text": "Nothing unusual, uh, no."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 242.96,
      "end_seconds": 253.6,
      "duration_seconds": 10.64,
      "text": "Okay, so the vitals from earlier. Blood pressure 119 over 80, respiratory rate 16. Pulse is 92 beats a minute, SpO2 96 percent on room air."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 255.41,
      "end_seconds": 256.34,
      "duration_seconds": 0.93,
      "text": "Okay, thanks."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 258.38,
      "end_seconds": 262.13,
      "duration_seconds": 3.75,
      "text": "Let me look at the area, I'll be gentle."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 263.87,
      "end_seconds": 265.13,
      "duration_seconds": 1.26,
      "text": "Does that hurt?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 275.45,
      "end_seconds": 284.3,
      "duration_seconds": 8.85,
      "text": "There are clustered blisters on a red base in a band across the right side of the chest, not crossing the midline."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 288.85,
      "end_seconds": 302.14,
      "duration_seconds": 13.29,
      "text": "That's all I needed to check. Okay, thinking it through, the most likely explanation is shingles. The reason I say that is that your story and my examination fit together."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 303.91,
      "end_seconds": 309.0,
      "duration_seconds": 5.09,
      "text": "Um, I'm scared it's something bad. Is it?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 310.0,
      "end_seconds": 317.68,
      "duration_seconds": 7.68,
      "text": "Nothing I've seen today points to an emergency. It looks like shingles, but I'd like to confirm."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 329.04,
      "end_seconds": 356.35,
      "duration_seconds": 27.31,
      "text": "I want a swab from a blister done, that's for vesicular rash. Let's use aciclovir, 800 milligrams, five times a day, for seven days. That should help with shingles. Keep the rash clean and dry and avoid contact with pregnant women or newborns until the blisters crust over. If the rash spreads to the eye or face, or you feel really unwell, please come to the emergency department."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 357.46,
      "end_seconds": 359.77,
      "duration_seconds": 2.31,
      "text": "That's fine by me."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 360.3,
      "end_seconds": 363.68,
      "duration_seconds": 3.38,
      "text": "Anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 365.18,
      "end_seconds": 370.97,
      "duration_seconds": 5.79,
      "text": "Okay, you know, so okay, that makes sense. Thanks for explaining."
    }
  ]
}