{
  "schema_version": "1.0",
  "encounter_id": "20437",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.0,
      "end_seconds": 6.71,
      "duration_seconds": 5.71,
      "text": "Come in, have a seat by the desk. What's been worrying you?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 7.74,
      "end_seconds": 14.12,
      "duration_seconds": 6.38,
      "text": "So, I've been passing out for a couple of minutes, doctor."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 15.48,
      "end_seconds": 18.57,
      "duration_seconds": 3.09,
      "text": "How long has this been bothering you?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 19.17,
      "end_seconds": 21.61,
      "duration_seconds": 2.44,
      "text": "Probably one week. Yeah."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 26.66,
      "end_seconds": 30.06,
      "duration_seconds": 3.4,
      "text": "Is it bearing on you a lot?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 31.41,
      "end_seconds": 33.03,
      "duration_seconds": 1.62,
      "text": "It's mild, honestly."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 33.55,
      "end_seconds": 37.42,
      "duration_seconds": 3.87,
      "text": "Right, right. Has there been a bitten tongue too?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 39.29,
      "end_seconds": 40.64,
      "duration_seconds": 1.35,
      "text": "Yes, actually."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 40.88,
      "end_seconds": 41.58,
      "duration_seconds": 0.7,
      "text": "Understood."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 42.78,
      "end_seconds": 48.01,
      "duration_seconds": 5.23,
      "text": "I've been feeling drowsy afterwards too, for about a week."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 51.56,
      "end_seconds": 58.66,
      "duration_seconds": 7.1,
      "text": "Have you been passing out for a couple of minutes at any time before this?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 59.44,
      "end_seconds": 68.42,
      "duration_seconds": 8.98,
      "text": "I mean, yes, something like this happened last year, and it went away on its own."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 70.4,
      "end_seconds": 72.74,
      "duration_seconds": 2.34,
      "text": "Have you had any head injury?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 73.48,
      "end_seconds": 77.22,
      "duration_seconds": 3.74,
      "text": "I, I haven't noticed any head injury."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 78.54,
      "end_seconds": 81.81,
      "duration_seconds": 3.27,
      "text": "Have you had any fever, palpitations or weakness?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 87.23,
      "end_seconds": 90.26,
      "duration_seconds": 3.03,
      "text": "No, none that I've noticed."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 90.76,
      "end_seconds": 94.93,
      "duration_seconds": 4.17,
      "text": "Understood. Anything on the skin I should know about?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 95.47,
      "end_seconds": 97.89,
      "duration_seconds": 2.42,
      "text": "No, skin's been fine."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 99.75,
      "end_seconds": 104.23,
      "duration_seconds": 4.48,
      "text": "What about your parents, brothers or sisters, any conditions?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 106.33,
      "end_seconds": 109.18,
      "duration_seconds": 2.85,
      "text": "My uncle has high cholesterol."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 110.72,
      "end_seconds": 115.35,
      "duration_seconds": 4.63,
      "text": "Tell me about your routine, work, habits, that sort of thing."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 116.28,
      "end_seconds": 137.14,
      "duration_seconds": 20.86,
      "text": "I have about eight cigarettes in a day. I used to drink heavily but I stopped four years ago. I'm a hairdresser, on my feet all day. I do a yoga class on Thursdays. Lots of rice, lentils and some fruit."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 138.15,
      "end_seconds": 140.87,
      "duration_seconds": 2.72,
      "text": "Have you got any known allergies?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 142.88,
      "end_seconds": 144.37,
      "duration_seconds": 1.49,
      "text": "No known allergies."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 145.92,
      "end_seconds": 148.31,
      "duration_seconds": 2.39,
      "text": "Anything surgical in your history?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 148.95,
      "end_seconds": 155.22,
      "duration_seconds": 6.27,
      "text": "Yes, I had keyhole surgery on my gallbladder, two years back."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 171.38,
      "end_seconds": 173.5,
      "duration_seconds": 2.12,
      "text": "Any regular medication at all?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 174.51,
      "end_seconds": 177.66,
      "duration_seconds": 3.15,
      "text": "No, nothing at the moment."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 179.35,
      "end_seconds": 186.12,
      "duration_seconds": 6.77,
      "text": "Right, do you have any long-term conditions? These questions might sound routine, but they matter."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 187.74,
      "end_seconds": 197.99,
      "duration_seconds": 10.25,
      "text": "Well, I've had high blood pressure, yes. I wasn't sure whether to come in at all, to be honest."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 198.8,
      "end_seconds": 206.85,
      "duration_seconds": 8.05,
      "text": "Okay, I can see high blood pressure in your file as well. I'll note down your vital signs first."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 218.45,
      "end_seconds": 220.57,
      "duration_seconds": 2.12,
      "text": "Okay, this won't take long..."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 241.43,
      "end_seconds": 250.08,
      "duration_seconds": 8.65,
      "text": "Okay: oxygen saturation is 98 percent, pressure 123 over 73, temperature is 36.6 degrees. And pulse 78."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 253.03,
      "end_seconds": 254.79,
      "duration_seconds": 1.76,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 255.48,
      "end_seconds": 258.19,
      "duration_seconds": 2.71,
      "text": "I'll come back to the numbers."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 260.17,
      "end_seconds": 263.92,
      "duration_seconds": 3.75,
      "text": "Could you come over to the couch, please?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 264.86,
      "end_seconds": 267.2,
      "duration_seconds": 2.34,
      "text": "I'm just checking this side."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 275.01,
      "end_seconds": 280.13,
      "duration_seconds": 5.12,
      "text": "The neurological examination is normal, with steady walking and equal power."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 282.99,
      "end_seconds": 285.79,
      "duration_seconds": 2.8,
      "text": "Good, you can sit up again."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 301.35,
      "end_seconds": 332.27,
      "duration_seconds": 30.92,
      "text": "Let me tell you where I've got to. I'd lean towards a possible first seizure. A faint with some jerking is also on my list. I'd like to arrange a brain scan for possible seizure. It's a routine test and it'll give us a much clearer picture. An ECG is what I'd like next, for loss of consciousness. That will help us see what's going on underneath and decide the next step."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 333.49,
      "end_seconds": 344.43,
      "duration_seconds": 10.94,
      "text": "No driving until you have been seen in the clinic, and avoid swimming or climbing alone. I'll also refer you to the epilepsy clinic."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 346.14,
      "end_seconds": 349.18,
      "duration_seconds": 3.04,
      "text": "Sure, where do I go?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 351.17,
      "end_seconds": 354.13,
      "duration_seconds": 2.96,
      "text": "Does all of that make sense?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 355.89,
      "end_seconds": 358.08,
      "duration_seconds": 2.19,
      "text": "Thank you, doctor, goodbye."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 360.17,
      "end_seconds": 362.14,
      "duration_seconds": 1.97,
      "text": "So, see you soon."
    }
  ]
}