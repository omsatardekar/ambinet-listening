{
  "schema_version": "1.0",
  "encounter_id": "20235",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 0.52,
      "end_seconds": 4.79,
      "duration_seconds": 4.27,
      "text": "Doctor, we're ready in room two, I've already taken the observations."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.81,
      "end_seconds": 11.09,
      "duration_seconds": 4.28,
      "text": "Thanks, that's helpful. Hello, please sit. What's been happening?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 12.3,
      "end_seconds": 17.21,
      "duration_seconds": 4.91,
      "text": "Morning, doctor. I'll stay and fill in anything that's missed."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 18.25,
      "end_seconds": 22.34,
      "duration_seconds": 4.09,
      "text": "Of course, please stay. It's helpful to have you here."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 23.26,
      "end_seconds": 26.59,
      "duration_seconds": 3.33,
      "text": "She's been having a twisted ankle, doctor."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 28.36,
      "end_seconds": 33.04,
      "duration_seconds": 4.68,
      "text": "What about swelling around the ankle, have you noticed that?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 34.08,
      "end_seconds": 37.62,
      "duration_seconds": 3.54,
      "text": "Yes, about the same, about two weeks."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 38.43,
      "end_seconds": 41.47,
      "duration_seconds": 3.04,
      "text": "Is it bearing on you a lot?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 43.26,
      "end_seconds": 49.39,
      "duration_seconds": 6.13,
      "text": "Well, it's... hard to say, it's kind of... I don't know—"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 51.06,
      "end_seconds": 56.44,
      "duration_seconds": 5.38,
      "text": "Take your time. Mild, moderate, or severe, if you had to pick?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 57.1,
      "end_seconds": 59.35,
      "duration_seconds": 2.25,
      "text": "It feels mild to me."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 61.22,
      "end_seconds": 64.75,
      "duration_seconds": 3.53,
      "text": "Right, is it constant or in episodes?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 67.15,
      "end_seconds": 69.42,
      "duration_seconds": 2.27,
      "text": "It's every other day."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 69.93,
      "end_seconds": 74.83,
      "duration_seconds": 4.9,
      "text": "Have you noticed cracking sound at the time or previous fracture?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 76.54,
      "end_seconds": 89.69,
      "duration_seconds": 13.15,
      "text": "No, no cracking sound at the time, no previous fracture. I did have pain walking at one point, but that went away on its own."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 91.76,
      "end_seconds": 96.65,
      "duration_seconds": 4.89,
      "text": "Have you noticed calf pain, knee pain or numbness in the foot?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 98.57,
      "end_seconds": 104.14,
      "duration_seconds": 5.57,
      "text": "No, no calf pain, knee pain or numbness in the foot."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 104.97,
      "end_seconds": 108.91,
      "duration_seconds": 3.94,
      "text": "Any change in your bowel habit or your stomach generally?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 109.89,
      "end_seconds": 111.82,
      "duration_seconds": 1.93,
      "text": "No, all normal there."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 113.38,
      "end_seconds": 115.29,
      "duration_seconds": 1.91,
      "text": "How are your meals?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 116.06,
      "end_seconds": 120.26,
      "duration_seconds": 4.2,
      "text": "I grab fast food at lunch most days."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 123.46,
      "end_seconds": 127.05,
      "duration_seconds": 3.59,
      "text": "Has anyone in your family had anything serious?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 128.48,
      "end_seconds": 132.97,
      "duration_seconds": 4.49,
      "text": "My sister had breast cancer. My father has Parkinson's disease."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 143.24,
      "end_seconds": 148.11,
      "duration_seconds": 4.87,
      "text": "What conditions have you been treated for in the past?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 149.71,
      "end_seconds": 158.46,
      "duration_seconds": 8.75,
      "text": "I've had depression for two years now. Yes, migraines. Yes, acid reflux. I have asthma, for five years."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 160.28,
      "end_seconds": 171.72,
      "duration_seconds": 11.44,
      "text": "Right, right. Yes, migraines is known to us, good to have that clear. Has anything ever caused you a reaction? I mean any allergies."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 173.05,
      "end_seconds": 182.76,
      "duration_seconds": 9.71,
      "text": "I think I reacted to some antibiotic once, years ago. I don't remember which one, or what happened exactly."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 194.44,
      "end_seconds": 199.79,
      "duration_seconds": 5.35,
      "text": "Okay, can you list what you take, tablets, creams or inhalers?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 200.76,
      "end_seconds": 206.42,
      "duration_seconds": 5.66,
      "text": "Propranolol, 40 milligrams, twice a day for the migraine prevention."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 207.6,
      "end_seconds": 215.84,
      "duration_seconds": 8.24,
      "text": "Doctor, I think the last prescription for the propranolol was 20 milligrams. We changed it at the last visit."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 217.01,
      "end_seconds": 221.13,
      "duration_seconds": 4.12,
      "text": "Hm, that's different. Is the latest prescription anywhere near you?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 221.76,
      "end_seconds": 230.11,
      "duration_seconds": 8.35,
      "text": "Not with me. I'll bring it next time. It's lansoprazole, 30 milligrams, before breakfast for my acidity."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 230.69,
      "end_seconds": 237.14,
      "duration_seconds": 6.45,
      "text": "That's what's prescribed, but I'm not sure she takes it every day."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 238.29,
      "end_seconds": 246.05,
      "duration_seconds": 7.76,
      "text": "Seretide inhaler. I take it twice a day. Ibuprofen. I take it 400 milligrams, when needed."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 246.84,
      "end_seconds": 256.82,
      "duration_seconds": 9.98,
      "text": "Here are the numbers, doctor. Pressure 108 over 80, respiratory rate 17, pulse is 65 beats a minute. Temp 36.6 degrees, saturation 98 percent."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 258.18,
      "end_seconds": 259.6,
      "duration_seconds": 1.42,
      "text": "Good, thank you."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 261.17,
      "end_seconds": 264.79,
      "duration_seconds": 3.62,
      "text": "Right, let's have a proper look at you."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 266.09,
      "end_seconds": 269.84,
      "duration_seconds": 3.75,
      "text": "Right, stay as you are for a moment."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 283.17,
      "end_seconds": 292.8,
      "duration_seconds": 9.63,
      "text": "There is swelling and bruising over the outer ankle and I can't find any bony tenderness at the back of the ankle bone."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 296.1,
      "end_seconds": 311.09,
      "duration_seconds": 14.99,
      "text": "All finished, thank you. Okay, thinking it through, this is probably an ankle sprain without signs of a fracture. A tendon injury is still possible. It could also be a small fracture, so we'll keep that open."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 316.34,
      "end_seconds": 319.37,
      "duration_seconds": 3.03,
      "text": "What are the odds it's serious?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 320.31,
      "end_seconds": 351.89,
      "duration_seconds": 31.58,
      "text": "It's reasonable to be concerned, but right now an ankle sprain without signs of a fracture is my leading thought, not anything worse. I'd like to arrange an ankle X-ray for ankle injury. I'm going to put you on paracetamol, 1 gram, every six hours if needed, for five days. You take it by mouth. That's for ankle pain. Rest, ice, a firm bandage and keep it raised, and start gentle movement after two days."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 356.77,
      "end_seconds": 368.23,
      "duration_seconds": 11.46,
      "text": "I'll also refer you to physiotherapy. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 370.23,
      "end_seconds": 373.37,
      "duration_seconds": 3.14,
      "text": "I know what to watch for."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 374.23,
      "end_seconds": 393.99,
      "duration_seconds": 19.76,
      "text": "Keep an eye out, and if you cannot put any weight on it or the foot goes numb, call us the same day or go to emergency. See me again if it isn't better in a week. Right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 397.64,
      "end_seconds": 400.96,
      "duration_seconds": 3.32,
      "text": "Good, thanks, I'll see you then."
    }
  ]
}