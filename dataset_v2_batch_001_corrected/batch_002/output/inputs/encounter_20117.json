{
  "schema_version": "1.0",
  "encounter_id": "20117",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.91,
      "end_seconds": 9.04,
      "duration_seconds": 8.13,
      "text": "Erm, you know, doctor, hi, where would you like me to put my coat?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 9.9,
      "end_seconds": 13.59,
      "duration_seconds": 3.69,
      "text": "That's fine, sit down. Tell me why you came."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 15.21,
      "end_seconds": 20.35,
      "duration_seconds": 5.14,
      "text": "Um, so... heavy periods. That's why I came."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 20.91,
      "end_seconds": 23.96,
      "duration_seconds": 3.05,
      "text": "Right, did it come on recently?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 25.31,
      "end_seconds": 30.66,
      "duration_seconds": 5.35,
      "text": "Let me think, uh, it's been four weeks now."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 31.17,
      "end_seconds": 36.11,
      "duration_seconds": 4.94,
      "text": "What about being breathless on the stairs, have you noticed that?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 36.84,
      "end_seconds": 41.04,
      "duration_seconds": 4.2,
      "text": "Uh, yeah. About a month, I'd say."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 42.14,
      "end_seconds": 48.67,
      "duration_seconds": 6.53,
      "text": "Let me check a few things. Any pelvic pain, chest pain or weight loss?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 49.82,
      "end_seconds": 59.64,
      "duration_seconds": 9.82,
      "text": "Sorry, uh, what was I saying, I haven't had pelvic pain, chest pain or weight loss, no."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 61.19,
      "end_seconds": 63.5,
      "duration_seconds": 2.31,
      "text": "Has your skin been okay?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 64.95,
      "end_seconds": 67.69,
      "duration_seconds": 2.74,
      "text": "Nothing on the skin, no."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 68.5,
      "end_seconds": 72.35,
      "duration_seconds": 3.85,
      "text": "What do you take on a normal day?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 73.57,
      "end_seconds": 81.59,
      "duration_seconds": 8.02,
      "text": "Sumatriptan, 50 milligrams, when needed. Okay, so I'm on hydrocortisone cream, when needed."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 86.55,
      "end_seconds": 90.42,
      "duration_seconds": 3.87,
      "text": "Alright, how long have you been on it?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 91.3,
      "end_seconds": 96.78,
      "duration_seconds": 5.48,
      "text": "Two months now. Iron tablets. I take it once a day."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 111.6,
      "end_seconds": 113.87,
      "duration_seconds": 2.27,
      "text": "Is there someone at home?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 115.86,
      "end_seconds": 119.95,
      "duration_seconds": 4.09,
      "text": "My husband and I live above the shop."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 123.68,
      "end_seconds": 125.89,
      "duration_seconds": 2.21,
      "text": "Tell me about your eating."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 127.7,
      "end_seconds": 133.84,
      "duration_seconds": 6.14,
      "text": "I drink a lot of tea and snack through the day."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 134.88,
      "end_seconds": 137.65,
      "duration_seconds": 2.77,
      "text": "Do you work outside the home?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 139.03,
      "end_seconds": 143.23,
      "duration_seconds": 4.2,
      "text": "I'm a hairdresser, on my feet all day."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 144.2,
      "end_seconds": 148.91,
      "duration_seconds": 4.71,
      "text": "Right, what about your parents, brothers or sisters, any conditions?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 150.58,
      "end_seconds": 155.24,
      "duration_seconds": 4.66,
      "text": "Let me think, my uncle has high cholesterol."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 157.02,
      "end_seconds": 159.36,
      "duration_seconds": 2.34,
      "text": "Have you had any surgical procedures?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 160.5,
      "end_seconds": 166.8,
      "duration_seconds": 6.3,
      "text": "Yes, um, I had my tonsils removed, as a teenager."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 172.09,
      "end_seconds": 174.66,
      "duration_seconds": 2.57,
      "text": "Do you have any long-term conditions?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 175.86,
      "end_seconds": 179.98,
      "duration_seconds": 4.12,
      "text": "Ah, I have migraines, for two years."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 181.77,
      "end_seconds": 183.48,
      "duration_seconds": 1.71,
      "text": "Is there anything more?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 184.12,
      "end_seconds": 188.99,
      "duration_seconds": 4.87,
      "text": "Um, I have eczema, for five years."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 189.9,
      "end_seconds": 195.05,
      "duration_seconds": 5.15,
      "text": "Yes, migraines is known to us, good to have that clear."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 197.37,
      "end_seconds": 199.52,
      "duration_seconds": 2.15,
      "text": "May I examine you now?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 201.0,
      "end_seconds": 203.42,
      "duration_seconds": 2.42,
      "text": "I'm just checking this side."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 219.47,
      "end_seconds": 224.39,
      "duration_seconds": 4.92,
      "text": "Your eyelids and the palms of your hands look pale."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 226.42,
      "end_seconds": 227.63,
      "duration_seconds": 1.21,
      "text": "Okay, doctor."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 231.84,
      "end_seconds": 234.4,
      "duration_seconds": 2.56,
      "text": "Okay, that's enough for me."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 249.84,
      "end_seconds": 261.02,
      "duration_seconds": 11.18,
      "text": "Okay, thinking it through, it's hard to say. Heavy periods with iron deficiency is one possibility and a thyroid problem another, and I'd rather not commit yet."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 262.02,
      "end_seconds": 265.54,
      "duration_seconds": 3.52,
      "text": "I'm scared it's something bad. Is it?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 266.26,
      "end_seconds": 282.61,
      "duration_seconds": 16.35,
      "text": "It's reasonable to be concerned, but right now heavy periods with iron deficiency is my leading thought, not anything worse. So, to recap quickly. You've had heavy periods for four weeks, and no pelvic pain or chest pain."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 284.11,
      "end_seconds": 284.81,
      "duration_seconds": 0.7,
      "text": "Exactly."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 298.66,
      "end_seconds": 323.86,
      "duration_seconds": 25.2,
      "text": "A blood count is what I'd like next, for heavy periods. It's a routine test and it'll give us a much clearer picture. I'll request a ferritin level, it'll help with iron deficiency. The treatment will be tranexamic acid, 1 gram, three times a day during periods, for four days each cycle. That's for heavy periods."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 324.71,
      "end_seconds": 325.88,
      "duration_seconds": 1.17,
      "text": "Mm, alright."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 326.83,
      "end_seconds": 351.01,
      "duration_seconds": 24.18,
      "text": "Iron can darken the stools and bother the stomach, so take it after food. I'm going to send a referral to the gynaecology clinic. I'm not ordering a pelvic ultrasound today. If things carry on in two weeks, we'll consider it. Do get help quickly if you soak through pads hourly or feel faint."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 354.55,
      "end_seconds": 356.48,
      "duration_seconds": 1.93,
      "text": "Yes, will do."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 357.84,
      "end_seconds": 361.27,
      "duration_seconds": 3.43,
      "text": "Let's plan a check in six weeks."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 365.04,
      "end_seconds": 365.74,
      "duration_seconds": 0.7,
      "text": "Sure."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 367.0,
      "end_seconds": 370.12,
      "duration_seconds": 3.12,
      "text": "Anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 371.25,
      "end_seconds": 374.35,
      "duration_seconds": 3.1,
      "text": "Mm, thank you, that's helpful."
    }
  ]
}