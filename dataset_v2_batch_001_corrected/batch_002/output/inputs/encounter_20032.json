{
  "schema_version": "1.0",
  "encounter_id": "20032",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.91,
      "end_seconds": 5.8,
      "duration_seconds": 4.89,
      "text": "Oh, good evening, doctor, thanks for seeing me."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.87,
      "end_seconds": 11.27,
      "duration_seconds": 4.4,
      "text": "You're alright, take a seat. What can I do for you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 12.43,
      "end_seconds": 17.38,
      "duration_seconds": 4.95,
      "text": "I've been dealing with burning pain in the upper tummy."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 18.97,
      "end_seconds": 22.65,
      "duration_seconds": 3.68,
      "text": "When was the first time you noticed it?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 27.5,
      "end_seconds": 31.88,
      "duration_seconds": 4.38,
      "text": "So, it's been going on for about a week."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 32.63,
      "end_seconds": 43.85,
      "duration_seconds": 11.22,
      "text": "Can you describe it a bit more for me? How strong it is, what the pattern is, what helps. Just so I get the full picture."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 45.08,
      "end_seconds": 55.98,
      "duration_seconds": 10.9,
      "text": "Empty stomach and spicy food definitely sets it off. Antacids helps a bit. I'd say a few times a day."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 57.92,
      "end_seconds": 60.28,
      "duration_seconds": 2.36,
      "text": "Is there anything else with it?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 62.2,
      "end_seconds": 97.03,
      "duration_seconds": 34.83,
      "text": "A bitter taste in my mouth goes along with it, most of the time. Okay, so the bitter taste in my mouth? That's been since last night. With bitter taste in my mouth, pretty severe, if I'm being honest. I've been feeling full quickly too. So, you know, I've also been belching, since yesterday. With belching, maybe a five out of ten on a bad day."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 98.32,
      "end_seconds": 100.84,
      "duration_seconds": 2.52,
      "text": "Have you had any weight loss?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 102.44,
      "end_seconds": 104.49,
      "duration_seconds": 2.05,
      "text": "No. No weight loss."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 105.28,
      "end_seconds": 111.82,
      "duration_seconds": 6.54,
      "text": "Let me check a few things. Any difficulty swallowing, black stools or chest pain?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 112.76,
      "end_seconds": 115.29,
      "duration_seconds": 2.53,
      "text": "No, none that I've noticed."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 116.87,
      "end_seconds": 120.79,
      "duration_seconds": 3.92,
      "text": "On the cardiac side, anything I should know?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 121.71,
      "end_seconds": 124.96,
      "duration_seconds": 3.25,
      "text": "No, you know, that's been fine."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 129.89,
      "end_seconds": 131.67,
      "duration_seconds": 1.78,
      "text": "How's your breathing otherwise?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 133.64,
      "end_seconds": 135.78,
      "duration_seconds": 2.14,
      "text": "No problems with breathing."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 137.24,
      "end_seconds": 139.4,
      "duration_seconds": 2.16,
      "text": "Let's run through your medicines."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 140.52,
      "end_seconds": 146.92,
      "duration_seconds": 6.4,
      "text": "I take paracetamol, 650 milligrams, maybe, when needed for the knee pain."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 148.64,
      "end_seconds": 153.1,
      "duration_seconds": 4.46,
      "text": "Have you got the box or the prescription on you?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 154.06,
      "end_seconds": 167.97,
      "duration_seconds": 13.91,
      "text": "No, it's at home. Iron tablets. I take it once a day. I'm supposed to take it regularly, but I don't always manage. Antacid, when needed."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 185.12,
      "end_seconds": 189.1,
      "duration_seconds": 3.98,
      "text": "What does a normal day of food look like?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 190.15,
      "end_seconds": 193.51,
      "duration_seconds": 3.36,
      "text": "Lots of rice, lentils and some fruit."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 194.65,
      "end_seconds": 197.65,
      "duration_seconds": 3.0,
      "text": "Are you on your own at home?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 198.24,
      "end_seconds": 201.15,
      "duration_seconds": 2.91,
      "text": "I live with my elderly mother."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 201.85,
      "end_seconds": 205.92,
      "duration_seconds": 4.07,
      "text": "Any allergies to tablets, food or anything in the environment?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 206.68,
      "end_seconds": 215.46,
      "duration_seconds": 8.78,
      "text": "I think I reacted to some antibiotic once, years ago. I don't remember which one, or what happened exactly."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 216.55,
      "end_seconds": 219.49,
      "duration_seconds": 2.94,
      "text": "Have you had any surgical procedures?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 225.71,
      "end_seconds": 238.39,
      "duration_seconds": 12.68,
      "text": "Yes, I had a meniscus repair on my knee, four years ago. I've been reading about it online and it worried me."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 239.06,
      "end_seconds": 241.5,
      "duration_seconds": 2.44,
      "text": "Do you have any long-term conditions?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 245.24,
      "end_seconds": 262.97,
      "duration_seconds": 17.73,
      "text": "Um, I've had acid reflux for about ten years now. Arthritis in my knees, for about ten years. Yes, low haemoglobin. I told myself I'd wait and see, and here I am."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 263.7,
      "end_seconds": 271.35,
      "duration_seconds": 7.65,
      "text": "I follow. Yes, arthritis in your knees is known to us, good to have that clear."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 287.38,
      "end_seconds": 290.32,
      "duration_seconds": 2.94,
      "text": "I'll note down your vital signs first."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 301.55,
      "end_seconds": 304.25,
      "duration_seconds": 2.7,
      "text": "That's it, just a little longer..."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 324.74,
      "end_seconds": 330.76,
      "duration_seconds": 6.02,
      "text": "Okay: pressure 121 over 77, pulse is 72 beats a minute, temperature 36.4."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 331.58,
      "end_seconds": 334.06,
      "duration_seconds": 2.48,
      "text": "So, is that alright, doctor?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 339.17,
      "end_seconds": 341.37,
      "duration_seconds": 2.2,
      "text": "We'll go over that shortly."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 357.02,
      "end_seconds": 388.48,
      "duration_seconds": 31.46,
      "text": "Let's get a test for the stomach germ, for dyspepsia. I think blood tests makes sense here, for dyspepsia. I'm going to put you on omeprazole, 20 milligrams, once a day, for four weeks. You take it by mouth. That should help with stomach acid. Please stop taking the anti-inflammatory tablets for now and use paracetamol for the pain. Cut down on salt and fried food for now, it really does make a difference."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 389.97,
      "end_seconds": 406.49,
      "duration_seconds": 16.52,
      "text": "And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose. Book a review after the test result. So, have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 408.26,
      "end_seconds": 410.07,
      "duration_seconds": 1.81,
      "text": "That's clear, thanks."
    }
  ]
}