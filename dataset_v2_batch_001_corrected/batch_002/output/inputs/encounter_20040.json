{
  "schema_version": "1.0",
  "encounter_id": "20040",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.19,
      "end_seconds": 6.14,
      "duration_seconds": 4.95,
      "text": "Morning, uh, doctor. Is this the right room?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.04,
      "end_seconds": 12.33,
      "duration_seconds": 5.29,
      "text": "Yes, come in and sit down. What brings you here today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 14.25,
      "end_seconds": 19.83,
      "duration_seconds": 5.58,
      "text": "I've been dealing with pins and needles in my hands and feet."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 21.52,
      "end_seconds": 22.7,
      "duration_seconds": 1.18,
      "text": "since when exactly?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 23.72,
      "end_seconds": 26.04,
      "duration_seconds": 2.32,
      "text": "It's been three weeks now."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 26.87,
      "end_seconds": 29.88,
      "duration_seconds": 3.01,
      "text": "would you say mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 31.63,
      "end_seconds": 32.75,
      "duration_seconds": 1.12,
      "text": "Mild, really"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 33.36,
      "end_seconds": 38.91,
      "duration_seconds": 5.55,
      "text": "Okay, what about being unsteady on your feet, have you noticed that?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 40.27,
      "end_seconds": 49.36,
      "duration_seconds": 9.09,
      "text": "yes, um, actually. Sorry, what was I saying, as for being unsteady on my feet, I'd say severe"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 49.61,
      "end_seconds": 54.56,
      "duration_seconds": 4.95,
      "text": "I see, go ahead. And what about diarrhoea or rash?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 56.12,
      "end_seconds": 59.66,
      "duration_seconds": 3.54,
      "text": "I haven't had diarrhoea or rash, no."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 60.99,
      "end_seconds": 64.61,
      "duration_seconds": 3.62,
      "text": "And what about weight loss or bladder problems?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 66.63,
      "end_seconds": 70.78,
      "duration_seconds": 4.15,
      "text": "Actually, no, no weight loss or bladder problems."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 72.43,
      "end_seconds": 76.8,
      "duration_seconds": 4.37,
      "text": "What about your tummy and bowels, anything unusual there?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 77.31,
      "end_seconds": 79.61,
      "duration_seconds": 2.3,
      "text": "No, all normal there."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 80.69,
      "end_seconds": 83.17,
      "duration_seconds": 2.48,
      "text": "is your urine normal, no changes?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 84.24,
      "end_seconds": 85.99,
      "duration_seconds": 1.75,
      "text": "Nothing there, no."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 95.96,
      "end_seconds": 100.2,
      "duration_seconds": 4.24,
      "text": "Let's talk a little about your daily life and habits."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 102.08,
      "end_seconds": 113.11,
      "duration_seconds": 11.03,
      "text": "I'm vegetarian and have been for years. I'm a plumber, lots of bending and kneeling. No, I share a house with my brother."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 114.95,
      "end_seconds": 117.66,
      "duration_seconds": 2.71,
      "text": "Have you got any known allergies?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 122.05,
      "end_seconds": 124.88,
      "duration_seconds": 2.83,
      "text": "No, I'm not allergic to anything."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 126.12,
      "end_seconds": 129.51,
      "duration_seconds": 3.39,
      "text": "what do you take on a normal day?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 131.19,
      "end_seconds": 138.48,
      "duration_seconds": 7.29,
      "text": "Glibenclamide, 5 milligrams, before breakfast. I take lansoprazole, 30 milligrams, before breakfast."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 157.36,
      "end_seconds": 161.06,
      "duration_seconds": 3.7,
      "text": "Anything in your past medical history I should know?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 162.0,
      "end_seconds": 177.87,
      "duration_seconds": 15.87,
      "text": "I've had diabetes, yes. Let me think, I've got acid reflux. I told my wife I'd come today. Work has been very busy so I kept ignoring it."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 179.72,
      "end_seconds": 185.1,
      "duration_seconds": 5.38,
      "text": "I follow. Alright, diabetes and acid reflux, that matches what I have here."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 199.13,
      "end_seconds": 202.4,
      "duration_seconds": 3.27,
      "text": "Has anyone in your family had anything serious?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 203.0,
      "end_seconds": 205.67,
      "duration_seconds": 2.67,
      "text": "My grandfather had a stroke."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 207.22,
      "end_seconds": 210.03,
      "duration_seconds": 2.81,
      "text": "Let me quickly check your readings."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 218.67,
      "end_seconds": 221.03,
      "duration_seconds": 2.36,
      "text": "Bear with me while this finishes..."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 237.0,
      "end_seconds": 243.85,
      "duration_seconds": 6.85,
      "text": "Okay: pressure 112 over 74, saturation 99 percent, pulse is 69 beats a minute."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 244.56,
      "end_seconds": 246.02,
      "duration_seconds": 1.46,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 247.84,
      "end_seconds": 249.86,
      "duration_seconds": 2.02,
      "text": "we'll go over that shortly"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 251.14,
      "end_seconds": 253.56,
      "duration_seconds": 2.42,
      "text": "May I examine you now?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 254.15,
      "end_seconds": 256.19,
      "duration_seconds": 2.04,
      "text": "Okay, um, doctor."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 257.16,
      "end_seconds": 258.53,
      "duration_seconds": 1.37,
      "text": "Breathe out slowly."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 269.14,
      "end_seconds": 272.45,
      "duration_seconds": 3.31,
      "text": "Your vibration sense is reduced at the ankles."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 275.4,
      "end_seconds": 291.0,
      "duration_seconds": 15.6,
      "text": "All finished, thank you. So, based on the history and the examination, I'd lean towards symptoms that fit a vitamin B12 deficiency. I want to be honest that this is an impression, not a final answer."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 292.96,
      "end_seconds": 295.88,
      "duration_seconds": 2.92,
      "text": "um, is this serious, doctor?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 301.07,
      "end_seconds": 317.11,
      "duration_seconds": 16.04,
      "text": "I understand the worry. At the moment I'd say it's symptoms that fit a vitamin B12 deficiency, and we'll watch how it goes. Let's use cyanocobalamin, 1000 micrograms, every other day, for two weeks. That's for low vitamin B12."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 317.99,
      "end_seconds": 319.6,
      "duration_seconds": 1.61,
      "text": "Okay, I understand."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 321.28,
      "end_seconds": 324.34,
      "duration_seconds": 3.06,
      "text": "Come back after the results are back."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 327.15,
      "end_seconds": 331.87,
      "duration_seconds": 4.72,
      "text": "actually, you know, I'll note it in my calendar"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 333.42,
      "end_seconds": 338.4,
      "duration_seconds": 4.98,
      "text": "Alright, before we finish, can you repeat the plan back to me?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 343.51,
      "end_seconds": 354.99,
      "duration_seconds": 11.48,
      "text": "So, I take the cyanocobalamin, 1000 micrograms, every other day and come back after the results are back. Is that right?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 356.41,
      "end_seconds": 361.76,
      "duration_seconds": 5.35,
      "text": "So, yes, exactly right. I think we're done unless you have questions."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 363.42,
      "end_seconds": 366.51,
      "duration_seconds": 3.09,
      "text": "Good, thanks, I'll see you then."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 368.24,
      "end_seconds": 369.61,
      "duration_seconds": 1.37,
      "text": "see you soon"
    }
  ]
}