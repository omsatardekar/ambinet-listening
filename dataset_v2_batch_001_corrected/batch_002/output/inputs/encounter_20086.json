{
  "schema_version": "1.0",
  "encounter_id": "20086",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.63,
      "end_seconds": 7.21,
      "duration_seconds": 6.58,
      "text": "Doctor? Hello, uh, I hope this is the right time."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.73,
      "end_seconds": 12.48,
      "duration_seconds": 4.75,
      "text": "Yes, come in and sit down. What brings you here today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 14.27,
      "end_seconds": 19.29,
      "duration_seconds": 5.02,
      "text": "Thank you for fitting us in, uh, doctor."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 20.83,
      "end_seconds": 24.45,
      "duration_seconds": 3.62,
      "text": "That's fine, sit down. We'll go through it together."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 25.23,
      "end_seconds": 34.44,
      "duration_seconds": 9.21,
      "text": "Let me think, so the thing is, I've got a cough that won't go away."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 35.28,
      "end_seconds": 38.73,
      "duration_seconds": 3.45,
      "text": "Can you tell me when it first started?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 39.99,
      "end_seconds": 44.55,
      "duration_seconds": 4.56,
      "text": "I've, I've had it it for two weeks."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 45.08,
      "end_seconds": 50.36,
      "duration_seconds": 5.28,
      "text": "Okay, give me more detail on it, whatever comes to mind."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 51.09,
      "end_seconds": 59.22,
      "duration_seconds": 8.13,
      "text": "it comes and goes maybe a six out of ten on a bad day"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 61.16,
      "end_seconds": 65.09,
      "duration_seconds": 3.93,
      "text": "Have you been getting breathless on the stairs?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 67.03,
      "end_seconds": 83.05,
      "duration_seconds": 16.02,
      "text": "Yeah, that too. Well, about getting breathless on the stairs, moderate, really. Well, you know, I was feeling washed out at one point, but that's gone now."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 84.72,
      "end_seconds": 88.38,
      "duration_seconds": 3.66,
      "text": "Okay, have you noticed weight loss or night sweats?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 89.55,
      "end_seconds": 96.14,
      "duration_seconds": 6.59,
      "text": "Uh, no weight loss or night sweats, none of it."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 97.38,
      "end_seconds": 101.5,
      "duration_seconds": 4.12,
      "text": "Have you noticed fever, coughing up blood or leg swelling?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 107.13,
      "end_seconds": 110.93,
      "duration_seconds": 3.8,
      "text": "Nope, you know, nothing like that."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 111.9,
      "end_seconds": 115.31,
      "duration_seconds": 3.41,
      "text": "Has your heart given you any trouble?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 117.03,
      "end_seconds": 121.61,
      "duration_seconds": 4.58,
      "text": "My heart's been fine, as far as I know."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 122.66,
      "end_seconds": 125.52,
      "duration_seconds": 2.86,
      "text": "Any rashes or skin problems otherwise?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 126.89,
      "end_seconds": 129.61,
      "duration_seconds": 2.72,
      "text": "Mm, no, skin's been fine."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 141.34,
      "end_seconds": 144.83,
      "duration_seconds": 3.49,
      "text": "Right, does your family have any medical conditions?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 146.04,
      "end_seconds": 149.31,
      "duration_seconds": 3.27,
      "text": "My daughter has type 1 diabetes."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 151.3,
      "end_seconds": 153.49,
      "duration_seconds": 2.19,
      "text": "What about your medical history?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 154.16,
      "end_seconds": 155.95,
      "duration_seconds": 1.79,
      "text": "yes, acid reflux"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 157.54,
      "end_seconds": 166.16,
      "duration_seconds": 8.62,
      "text": "Alright, acid reflux, that matches what I have here. What do you take on a normal day?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 166.71,
      "end_seconds": 171.94,
      "duration_seconds": 5.23,
      "text": "Lansoprazole, 30 milligrams, maybe, before breakfast for my acidity."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 173.43,
      "end_seconds": 177.64,
      "duration_seconds": 4.21,
      "text": "Have you got the box or the prescription on you?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 179.67,
      "end_seconds": 183.7,
      "duration_seconds": 4.03,
      "text": "Erm, um, no, it's at home."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 184.52,
      "end_seconds": 186.59,
      "duration_seconds": 2.07,
      "text": "Alright, any previous surgeries?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 188.03,
      "end_seconds": 192.25,
      "duration_seconds": 4.22,
      "text": "No, uh, I've never been operated on."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 193.15,
      "end_seconds": 197.99,
      "duration_seconds": 4.84,
      "text": "Tell me about your routine, work, habits, that sort of thing."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 201.92,
      "end_seconds": 214.18,
      "duration_seconds": 12.26,
      "text": "I'm vegetarian and have been for years. Not much, I mostly stay in these days. I'm a plumber, lots of bending and kneeling."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 224.44,
      "end_seconds": 226.86,
      "duration_seconds": 2.42,
      "text": "let me quickly check your readings"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 239.94,
      "end_seconds": 242.01,
      "duration_seconds": 2.07,
      "text": "Nearly done with the readings..."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 263.15,
      "end_seconds": 274.19,
      "duration_seconds": 11.04,
      "text": "Okay: SpO2 97 percent on room air, respiratory rate 14, blood pressure 121 over 70, temp 37.0 degrees, heart rate 68."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 275.92,
      "end_seconds": 277.41,
      "duration_seconds": 1.49,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 278.56,
      "end_seconds": 281.0,
      "duration_seconds": 2.44,
      "text": "We'll look at it together shortly."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 282.64,
      "end_seconds": 286.14,
      "duration_seconds": 3.5,
      "text": "Right, let's have a proper look at you."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 287.58,
      "end_seconds": 288.79,
      "duration_seconds": 1.21,
      "text": "that's alright"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 290.43,
      "end_seconds": 293.46,
      "duration_seconds": 3.03,
      "text": "stay as you are for a moment"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 311.98,
      "end_seconds": 315.88,
      "duration_seconds": 3.9,
      "text": "The chest is clear and your oxygen level is normal."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 319.72,
      "end_seconds": 330.12,
      "duration_seconds": 10.4,
      "text": "Please sit back down. Okay, so my impression is this: This looks most like a lingering cough after a viral infection."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 331.71,
      "end_seconds": 334.7,
      "duration_seconds": 2.99,
      "text": "what are the odds it's serious?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 335.21,
      "end_seconds": 348.99,
      "duration_seconds": 13.78,
      "text": "I understand the worry at the moment I'd say it's a lingering cough after a viral infection, and we'll know more once the a chest X-ray is back"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 367.06,
      "end_seconds": 379.39,
      "duration_seconds": 12.33,
      "text": "I'll request a chest X-ray, it'll help with persistent cough. I'm prescribing salbutamol inhaler, 100 micrograms, two puffs when needed, for two weeks. That should help with wheeze and cough."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 380.24,
      "end_seconds": 382.06,
      "duration_seconds": 1.82,
      "text": "Okay, I understand."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 387.09,
      "end_seconds": 400.72,
      "duration_seconds": 13.63,
      "text": "Honey and lemon in warm water can ease it, and and avoid smoky rooms. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 402.78,
      "end_seconds": 407.15,
      "duration_seconds": 4.37,
      "text": "well, yes, I'll bear that in mind"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 408.55,
      "end_seconds": 421.91,
      "duration_seconds": 13.36,
      "text": "Come back or go to emergency straight away if you cough up blood or get breathless at rest. I'll want another look after the chest X-ray. Does all of that make sense?"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 422.97,
      "end_seconds": 426.4,
      "duration_seconds": 3.43,
      "text": "I mean, alright, thanks, take care."
    }
  ]
}