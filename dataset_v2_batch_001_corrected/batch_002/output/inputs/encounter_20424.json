{
  "schema_version": "1.0",
  "encounter_id": "20424",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.05,
      "end_seconds": 2.8,
      "duration_seconds": 1.75,
      "text": "Welcome. Make yourself comfortable."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 6.62,
      "end_seconds": 9.79,
      "duration_seconds": 3.17,
      "text": "hello, thanks for fitting me in"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 10.96,
      "end_seconds": 14.13,
      "duration_seconds": 3.17,
      "text": "what would you like to start with today?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 14.64,
      "end_seconds": 19.06,
      "duration_seconds": 4.42,
      "text": "well, I've been having blurred vision at times"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 20.96,
      "end_seconds": 23.83,
      "duration_seconds": 2.87,
      "text": "right, I'll do your observations first"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 37.07,
      "end_seconds": 39.3,
      "duration_seconds": 2.23,
      "text": "Okay, this won't take long..."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 59.38,
      "end_seconds": 68.67,
      "duration_seconds": 9.29,
      "text": "okay: temp 36.6 degrees, respiratory rate 15, blood pressure 147 over 100. And pulse 87, saturation 99 percent"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 72.67,
      "end_seconds": 74.62,
      "duration_seconds": 1.95,
      "text": "is that alright, doctor?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 75.5,
      "end_seconds": 81.44,
      "duration_seconds": 5.94,
      "text": "I'll come back to the numbers. Has this been going on for long?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 82.86,
      "end_seconds": 86.81,
      "duration_seconds": 3.95,
      "text": "it's been nearly five years, I'm fairly sure"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 87.74,
      "end_seconds": 91.08,
      "duration_seconds": 3.34,
      "text": "is it a lot or only a little?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 93.07,
      "end_seconds": 95.26,
      "duration_seconds": 2.19,
      "text": "I, I'd say mild"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 96.57,
      "end_seconds": 100.12,
      "duration_seconds": 3.55,
      "text": "has there been headaches in the morning too?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 101.08,
      "end_seconds": 104.1,
      "duration_seconds": 3.02,
      "text": "Yes, about the same, three weeks."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 106.19,
      "end_seconds": 113.19,
      "duration_seconds": 7.0,
      "text": "have you had blurred vision at times before, or is this the first time?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 115.23,
      "end_seconds": 122.01,
      "duration_seconds": 6.78,
      "text": "I had a similar thing a couple of years ago. It went away."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 122.84,
      "end_seconds": 126.1,
      "duration_seconds": 3.26,
      "text": "did you get ankle swelling or chest pain?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 127.56,
      "end_seconds": 130.37,
      "duration_seconds": 2.81,
      "text": "No, not a single one."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 130.78,
      "end_seconds": 136.98,
      "duration_seconds": 6.2,
      "text": "Sure. Have you noticed slurred speech, weakness on one side or shortness of breath?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 138.7,
      "end_seconds": 145.02,
      "duration_seconds": 6.32,
      "text": "no, no slurred speech, weakness on one side or shortness of breath"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 146.4,
      "end_seconds": 149.4,
      "duration_seconds": 3.0,
      "text": "any problems with your joints or muscles?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 151.11,
      "end_seconds": 153.47,
      "duration_seconds": 2.36,
      "text": "no, joints are fine"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 154.66,
      "end_seconds": 159.41,
      "duration_seconds": 4.75,
      "text": "any change in your bowel habit or your stomach generally?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 161.13,
      "end_seconds": 164.29,
      "duration_seconds": 3.16,
      "text": "No, that that side's been fine."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 178.05,
      "end_seconds": 181.57,
      "duration_seconds": 3.52,
      "text": "alright did you ever have any procedures done?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 182.22,
      "end_seconds": 194.0,
      "duration_seconds": 11.78,
      "text": "Yes, I had a bunion operation, six years ago. I'd rather not end up on lots of tablets if I can avoid it."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 195.45,
      "end_seconds": 200.36,
      "duration_seconds": 4.91,
      "text": "what conditions have you been treated for in the past?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 201.69,
      "end_seconds": 203.94,
      "duration_seconds": 2.25,
      "text": "I've got high blood pressure."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 208.49,
      "end_seconds": 209.76,
      "duration_seconds": 1.27,
      "text": "Okay go on."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 226.35,
      "end_seconds": 228.73,
      "duration_seconds": 2.38,
      "text": "Do you follow any particular diet?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 230.44,
      "end_seconds": 234.26,
      "duration_seconds": 3.82,
      "text": "I'm vegetarian and have been for years."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 234.89,
      "end_seconds": 237.02,
      "duration_seconds": 2.13,
      "text": "Do you do any exercise?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 238.37,
      "end_seconds": 240.9,
      "duration_seconds": 2.53,
      "text": "I swim twice a week."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 242.11,
      "end_seconds": 244.9,
      "duration_seconds": 2.79,
      "text": "What's on your current medicine list?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 246.92,
      "end_seconds": 249.9,
      "duration_seconds": 2.98,
      "text": "I'm on valsartan, once a day"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 251.05,
      "end_seconds": 253.39,
      "duration_seconds": 2.34,
      "text": "do you know the dose?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 254.67,
      "end_seconds": 258.73,
      "duration_seconds": 4.06,
      "text": "80 milligrams I think that's what's on the box"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 259.28,
      "end_seconds": 266.0,
      "duration_seconds": 6.72,
      "text": "Yes, carry on. Are you allergic to anything? Any allergies to medicines or foods?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 266.53,
      "end_seconds": 274.01,
      "duration_seconds": 7.48,
      "text": "Years back I got a rash from erythromycin so I stay away from it now."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 275.82,
      "end_seconds": 280.51,
      "duration_seconds": 4.69,
      "text": "okay I'll examine you in a second make yourself comfortable"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 281.53,
      "end_seconds": 284.11,
      "duration_seconds": 2.58,
      "text": "Take a deep breath for me."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 302.41,
      "end_seconds": 308.33,
      "duration_seconds": 5.92,
      "text": "the back of your eyes looks fine and your heart sounds are normal"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 312.95,
      "end_seconds": 315.27,
      "duration_seconds": 2.32,
      "text": "You can sit up now."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 326.56,
      "end_seconds": 341.07,
      "duration_seconds": 14.51,
      "text": "I think blood tests makes sense here, for hypertension. For this, amlodipine, 5 milligrams, once a day, long term. You take it it by mouth. It's for high blood pressure"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 341.64,
      "end_seconds": 343.4,
      "duration_seconds": 1.76,
      "text": "okay, I understand"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 344.08,
      "end_seconds": 361.61,
      "duration_seconds": 17.53,
      "text": "Check your blood pressure at home twice a day for a week and bring the readings. Keep an eye out and if you get chest pain weakness or trouble speaking call us the same day or go to emergency."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 363.08,
      "end_seconds": 365.19,
      "duration_seconds": 2.11,
      "text": "That's fine by me."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 367.08,
      "end_seconds": 370.67,
      "duration_seconds": 3.59,
      "text": "I'd like to see you again in four weeks."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 371.72,
      "end_seconds": 372.42,
      "duration_seconds": 0.7,
      "text": "Sure."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 374.15,
      "end_seconds": 379.3,
      "duration_seconds": 5.15,
      "text": "Right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 380.35,
      "end_seconds": 381.81,
      "duration_seconds": 1.46,
      "text": "that's clear, thanks"
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 382.4,
      "end_seconds": 384.33,
      "duration_seconds": 1.93,
      "text": "Alright, take care now."
    }
  ]
}