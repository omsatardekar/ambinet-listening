{
  "schema_version": "1.0",
  "encounter_id": "20169",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.68,
      "end_seconds": 2.36,
      "duration_seconds": 1.68,
      "text": "good afternoon, doctor"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 3.23,
      "end_seconds": 7.66,
      "duration_seconds": 4.43,
      "text": "You're alright, take a seat. What can I do for you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 9.74,
      "end_seconds": 16.08,
      "duration_seconds": 6.34,
      "text": "Doctor I'll sit in if that's okay I know what's been happening."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 17.02,
      "end_seconds": 20.44,
      "duration_seconds": 3.42,
      "text": "Yes, that's no problem at all. Please sit."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 21.45,
      "end_seconds": 25.23,
      "duration_seconds": 3.78,
      "text": "we came because of being very thirsty"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 29.88,
      "end_seconds": 31.66,
      "duration_seconds": 1.78,
      "text": "when did this begin?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 33.62,
      "end_seconds": 37.83,
      "duration_seconds": 4.21,
      "text": "hmm, I've had it for four weeks"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 38.75,
      "end_seconds": 41.87,
      "duration_seconds": 3.12,
      "text": "how troublesome is it day to day?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 42.74,
      "end_seconds": 46.48,
      "duration_seconds": 3.74,
      "text": "a a six out of ten, I suppose"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 47.63,
      "end_seconds": 49.71,
      "duration_seconds": 2.08,
      "text": "Any blurry vision as well?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 50.84,
      "end_seconds": 63.75,
      "duration_seconds": 12.91,
      "text": "Mm um yes. As for recurrent thrush I honestly can't say when that began. It might have been last month or the month before."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 71.21,
      "end_seconds": 73.1,
      "duration_seconds": 1.89,
      "text": "any sign of confusion?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 75.01,
      "end_seconds": 76.37,
      "duration_seconds": 1.36,
      "text": "Definitely no confusion."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 78.34,
      "end_seconds": 82.43,
      "duration_seconds": 4.09,
      "text": "so did you get abdominal pain or chest pain?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 83.28,
      "end_seconds": 88.82,
      "duration_seconds": 5.54,
      "text": "Mm um no abdominal pain or chest pain none of it."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 89.98,
      "end_seconds": 94.12,
      "duration_seconds": 4.14,
      "text": "and what about fever fruity smelling breath or vomiting?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 95.07,
      "end_seconds": 98.73,
      "duration_seconds": 3.66,
      "text": "I mean, no, not a single one."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 99.62,
      "end_seconds": 101.54,
      "duration_seconds": 1.92,
      "text": "How's your breathing otherwise?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 102.77,
      "end_seconds": 103.68,
      "duration_seconds": 0.91,
      "text": "Breathing's normal."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 104.34,
      "end_seconds": 107.19,
      "duration_seconds": 2.85,
      "text": "so, have you got any known allergies?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 108.34,
      "end_seconds": 117.28,
      "duration_seconds": 8.94,
      "text": "I think I reacted to some antibiotic once, years ago. I don't remember which one, or what happened exactly."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 118.51,
      "end_seconds": 121.3,
      "duration_seconds": 2.79,
      "text": "a few questions about your lifestyle now"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 123.39,
      "end_seconds": 133.46,
      "duration_seconds": 10.07,
      "text": "I'm a hairdresser, on my feet all day. I'm vegetarian and have been for years. My partner and our baby"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 135.33,
      "end_seconds": 139.02,
      "duration_seconds": 3.69,
      "text": "tell me about any past illnesses or ongoing conditions"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 140.97,
      "end_seconds": 144.0,
      "duration_seconds": 3.03,
      "text": "High cholesterol, for about ten years"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 146.04,
      "end_seconds": 147.43,
      "duration_seconds": 1.39,
      "text": "Any other things?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 149.44,
      "end_seconds": 153.46,
      "duration_seconds": 4.02,
      "text": "I have high blood pressure for nearly five years"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 155.12,
      "end_seconds": 162.84,
      "duration_seconds": 7.72,
      "text": "Right, so high blood pressure is already on your record. We'll keep that in mind today."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 176.73,
      "end_seconds": 183.79,
      "duration_seconds": 7.06,
      "text": "what do you take on a normal day? I ask cos it helps me narrow things down"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 187.87,
      "end_seconds": 200.95,
      "duration_seconds": 13.08,
      "text": "I take atorvastatin, 20 milligrams, at night for my cholesterol. Telmisartan. I take it 40 milligrams, maybe, once a day for my pressure."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 201.45,
      "end_seconds": 205.49,
      "duration_seconds": 4.04,
      "text": "Do you have the packet or the prescription with you?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 206.53,
      "end_seconds": 211.54,
      "duration_seconds": 5.01,
      "text": "Mm, not with me. I'll bring it next time."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 212.09,
      "end_seconds": 214.86,
      "duration_seconds": 2.77,
      "text": "does your family have any medical conditions?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 216.01,
      "end_seconds": 220.73,
      "duration_seconds": 4.72,
      "text": "My father has Parkinson's disease. My uncle has high cholesterol."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 222.48,
      "end_seconds": 224.9,
      "duration_seconds": 2.42,
      "text": "Have you ever had an operation?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 226.44,
      "end_seconds": 233.78,
      "duration_seconds": 7.34,
      "text": "Let me think, just a meniscus repair on my knee, four years ago."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 235.35,
      "end_seconds": 238.5,
      "duration_seconds": 3.15,
      "text": "I'll note down your vital signs first."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 247.74,
      "end_seconds": 249.73,
      "duration_seconds": 1.99,
      "text": "sit still for a moment.."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 267.06,
      "end_seconds": 280.98,
      "duration_seconds": 13.92,
      "text": "Okay: saturation 96 percent, height 161 centimetres, BMI works out to 20.4, pulse is 74 beats a minute, BP is 144 over 96, weight 53 kilos."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 282.45,
      "end_seconds": 284.13,
      "duration_seconds": 1.68,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 285.03,
      "end_seconds": 287.24,
      "duration_seconds": 2.21,
      "text": "We'll go over that shortly."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 289.7,
      "end_seconds": 291.69,
      "duration_seconds": 1.99,
      "text": "may I examine you now?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 292.73,
      "end_seconds": 294.41,
      "duration_seconds": 1.68,
      "text": "so, look straight ahead"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 311.32,
      "end_seconds": 318.22,
      "duration_seconds": 6.9,
      "text": "your fingerprick sugar here is high, and your feet have good pulses and normal feeling"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 323.95,
      "end_seconds": 335.5,
      "duration_seconds": 11.55,
      "text": "good, you can sit up again taking everything into account, this looks most like symptoms that point to newly developed type 2 diabetes a urine infection is still possible"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 337.48,
      "end_seconds": 339.58,
      "duration_seconds": 2.1,
      "text": "is this serious, doctor?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 341.41,
      "end_seconds": 352.9,
      "duration_seconds": 11.49,
      "text": "it's reasonable to be concerned, but right now symptoms that point to newly developed type 2 diabetes is my leading thought, not anything worse"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 369.21,
      "end_seconds": 372.71,
      "duration_seconds": 3.5,
      "text": "have you had any tests for this so far?"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 374.38,
      "end_seconds": 383.9,
      "duration_seconds": 9.52,
      "text": "I mean I did have a urine test done a few months ago but the paper's at home."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 384.99,
      "end_seconds": 389.38,
      "duration_seconds": 4.39,
      "text": "I want an HbA1c done that's for suspected diabetes."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 390.38,
      "end_seconds": 392.51,
      "duration_seconds": 2.13,
      "text": "okay, I'll do it"
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 393.68,
      "end_seconds": 410.4,
      "duration_seconds": 16.72,
      "text": "I think a fasting blood sugar makes sense here, for thirst and polyuria. The result will help us decide whether anything more is needed. Let's use metformin, 500 milligrams, once a day with food, long term. That's for high blood sugar."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 411.43,
      "end_seconds": 412.45,
      "duration_seconds": 1.02,
      "text": "Mm, alright."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 413.5,
      "end_seconds": 432.85,
      "duration_seconds": 19.35,
      "text": "cut right down on sugary drinks and keep water with you i'm gonna send a referral to the diabetes educator and please bring the latest prescription or the medicine boxes to the next visit so we can settle the dose"
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 434.62,
      "end_seconds": 435.53,
      "duration_seconds": 0.91,
      "text": "I understand."
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 440.17,
      "end_seconds": 446.55,
      "duration_seconds": 6.38,
      "text": "we'll catch up after the blood results. Does all of that make sense?"
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 447.93,
      "end_seconds": 451.98,
      "duration_seconds": 4.05,
      "text": "Okay, that makes sense. Thanks for explaining."
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 452.87,
      "end_seconds": 454.73,
      "duration_seconds": 1.86,
      "text": "have a good day"
    }
  ]
}