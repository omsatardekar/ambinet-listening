{
  "schema_version": "1.0",
  "encounter_id": "20482",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.89,
      "end_seconds": 4.15,
      "duration_seconds": 3.26,
      "text": "Come in, have a seat by the desk."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 5.71,
      "end_seconds": 6.78,
      "duration_seconds": 1.07,
      "text": "Hi there."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 7.97,
      "end_seconds": 14.56,
      "duration_seconds": 6.59,
      "text": "Hello, doctor. I hope it's alright if I stay in for this."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 15.89,
      "end_seconds": 22.81,
      "duration_seconds": 6.92,
      "text": "Yes, that's no problem at all. Please sit. Tell me what's brought you in."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 23.45,
      "end_seconds": 26.93,
      "duration_seconds": 3.48,
      "text": "We came because of pain around my cheeks."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 27.99,
      "end_seconds": 31.1,
      "duration_seconds": 3.11,
      "text": "Has this been going on for long?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 35.72,
      "end_seconds": 38.02,
      "duration_seconds": 2.3,
      "text": "It's been three days now."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 39.8,
      "end_seconds": 42.2,
      "duration_seconds": 2.4,
      "text": "Is anything making it worse?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 43.62,
      "end_seconds": 46.47,
      "duration_seconds": 2.85,
      "text": "Bending forward definitely sets it off."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 47.75,
      "end_seconds": 51.09,
      "duration_seconds": 3.34,
      "text": "Has there been a blocked nose too?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 53.03,
      "end_seconds": 56.8,
      "duration_seconds": 3.77,
      "text": "Yeah, um, I've had that since Monday."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 57.99,
      "end_seconds": 60.4,
      "duration_seconds": 2.41,
      "text": "Any thick green mucus as well?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 61.97,
      "end_seconds": 69.3,
      "duration_seconds": 7.33,
      "text": "Yes, actually. I've also had a reduced sense of smell, for about a week."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 88.18,
      "end_seconds": 90.88,
      "duration_seconds": 2.7,
      "text": "Let's start with the basic checks."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 97.53,
      "end_seconds": 99.89,
      "duration_seconds": 2.36,
      "text": "Nearly done with the readings..."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 119.96,
      "end_seconds": 129.57,
      "duration_seconds": 9.61,
      "text": "Okay: SpO2 95 percent on room air, pulse is 106 beats a minute, BP is 111 over 66. And temp 39.3 degrees."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 131.6,
      "end_seconds": 135.41,
      "duration_seconds": 3.81,
      "text": "Let me look at the area, I'll be gentle."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 136.74,
      "end_seconds": 138.15,
      "duration_seconds": 1.41,
      "text": "Fine by me."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 139.39,
      "end_seconds": 141.42,
      "duration_seconds": 2.03,
      "text": "Tell me if that's sore."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 157.3,
      "end_seconds": 163.65,
      "duration_seconds": 6.35,
      "text": "There is tenderness over both cheeks and the nose is blocked with swollen lining."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 167.05,
      "end_seconds": 174.24,
      "duration_seconds": 7.19,
      "text": "All finished, thank you. And what about toothache, double vision, nosebleeds or swelling around the eyes?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 175.95,
      "end_seconds": 178.61,
      "duration_seconds": 2.66,
      "text": "No, not a single one."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 179.39,
      "end_seconds": 180.36,
      "duration_seconds": 0.97,
      "text": "Any fever?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 182.15,
      "end_seconds": 185.0,
      "duration_seconds": 2.85,
      "text": "No, I haven't had any fever."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 185.78,
      "end_seconds": 191.33,
      "duration_seconds": 5.55,
      "text": "Actually, doctor, I did notice fever. She doesn't always say."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 193.13,
      "end_seconds": 199.32,
      "duration_seconds": 6.19,
      "text": "No, I don't think I did. Maybe a little, I'm not sure."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 200.25,
      "end_seconds": 208.6,
      "duration_seconds": 8.35,
      "text": "Alright, I'll note both what you've said and what you've noticed. Has your heart given you any trouble?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 209.47,
      "end_seconds": 211.38,
      "duration_seconds": 1.91,
      "text": "No, that's been fine."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 213.35,
      "end_seconds": 216.58,
      "duration_seconds": 3.23,
      "text": "Alright, anything different when you pass water?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 217.85,
      "end_seconds": 219.88,
      "duration_seconds": 2.03,
      "text": "No, that's all fine."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 221.86,
      "end_seconds": 224.81,
      "duration_seconds": 2.95,
      "text": "What's on your current medicine list?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 225.35,
      "end_seconds": 237.19,
      "duration_seconds": 11.84,
      "text": "It's Asthalin inhaler, when needed for my asthma. It's lansoprazole, 30 milligrams, before breakfast for my acidity. I'm on metoprolol, 50 milligrams, twice a day."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 238.97,
      "end_seconds": 245.37,
      "duration_seconds": 6.4,
      "text": "That's what's prescribed, but I'm not sure she takes it every day."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 245.95,
      "end_seconds": 254.9,
      "duration_seconds": 8.95,
      "text": "I take saline nasal spray, several times a day. Before this I was on aspirin; that's been stopped."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 256.46,
      "end_seconds": 259.37,
      "duration_seconds": 2.91,
      "text": "A few questions about your lifestyle now."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 260.16,
      "end_seconds": 276.51,
      "duration_seconds": 16.35,
      "text": "I quit smoking around ten years ago. No, I share a house with my brother. I'm a plumber, lots of bending and kneeling. I'm vegetarian and have been for years."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 277.38,
      "end_seconds": 280.34,
      "duration_seconds": 2.96,
      "text": "Does your family have any medical conditions?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 281.2,
      "end_seconds": 283.96,
      "duration_seconds": 2.76,
      "text": "My daughter has type 1 diabetes."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 285.79,
      "end_seconds": 288.7,
      "duration_seconds": 2.91,
      "text": "Right, do you have any long-term conditions?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 290.76,
      "end_seconds": 292.85,
      "duration_seconds": 2.09,
      "text": "Asthma, for five years."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 294.33,
      "end_seconds": 295.77,
      "duration_seconds": 1.44,
      "text": "Is that everything?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 296.28,
      "end_seconds": 301.24,
      "duration_seconds": 4.96,
      "text": "I've had acid reflux, yes. I've got heart disease."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 302.71,
      "end_seconds": 310.19,
      "duration_seconds": 7.48,
      "text": "Alright, asthma and acid reflux, that matches what I have here. What operations have you had, if any?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 311.15,
      "end_seconds": 315.76,
      "duration_seconds": 4.61,
      "text": "Yes, I had a triple bypass, eight years ago."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 333.91,
      "end_seconds": 342.06,
      "duration_seconds": 8.15,
      "text": "So, based on the history and the examination, my working impression is acute sinusitis. A viral cold is still possible."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 343.69,
      "end_seconds": 347.04,
      "duration_seconds": 3.35,
      "text": "What are the odds it's serious?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 350.61,
      "end_seconds": 358.33,
      "duration_seconds": 7.72,
      "text": "I understand the worry. At the moment I'd say it's acute sinusitis, and we'll watch how it goes."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 372.6,
      "end_seconds": 381.51,
      "duration_seconds": 8.91,
      "text": "Let's use fluticasone nasal spray, 50 micrograms, two sprays each side once a day, for two weeks. That's for sinus congestion."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 382.1,
      "end_seconds": 383.58,
      "duration_seconds": 1.48,
      "text": "Thank you, doctor."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 385.13,
      "end_seconds": 395.03,
      "duration_seconds": 9.9,
      "text": "Steam inhalation and saline rinses can help clear the nose. Let's review you in two weeks. Does all of that make sense?"
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 395.67,
      "end_seconds": 397.8,
      "duration_seconds": 2.13,
      "text": "Thank you, doctor, goodbye."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 398.67,
      "end_seconds": 399.98,
      "duration_seconds": 1.31,
      "text": "See you soon."
    }
  ]
}