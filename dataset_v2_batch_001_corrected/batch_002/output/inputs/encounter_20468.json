{
  "schema_version": "1.0",
  "encounter_id": "20468",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 1.29,
      "end_seconds": 8.17,
      "duration_seconds": 6.88,
      "text": "okay, doctor, we're all set in here i'll give you the the numbers when you want them"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 13.07,
      "end_seconds": 16.44,
      "duration_seconds": 3.37,
      "text": "okay, thanks. Hi, how can I help today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 17.62,
      "end_seconds": 25.7,
      "duration_seconds": 8.08,
      "text": "yeah, it's sharp pain in the upper right of my tummy. I don't know what's causing it"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 26.87,
      "end_seconds": 28.06,
      "duration_seconds": 1.19,
      "text": "Since when exactly?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 34.05,
      "end_seconds": 36.59,
      "duration_seconds": 2.54,
      "text": "For three days, I'd say"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 37.97,
      "end_seconds": 40.32,
      "duration_seconds": 2.35,
      "text": "How much does it limit you?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 41.77,
      "end_seconds": 46.38,
      "duration_seconds": 4.61,
      "text": "maybe a three out of ten on a bad day"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 47.99,
      "end_seconds": 50.6,
      "duration_seconds": 2.61,
      "text": "Is there anything else with it?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 51.97,
      "end_seconds": 56.85,
      "duration_seconds": 4.88,
      "text": "When it starts I tend to get bloating as well."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 57.59,
      "end_seconds": 60.48,
      "duration_seconds": 2.89,
      "text": "how much does it limit you?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 61.41,
      "end_seconds": 68.99,
      "duration_seconds": 7.58,
      "text": "Maybe a three out of ten on a bad day. And a bit of vomiting too."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 69.88,
      "end_seconds": 73.31,
      "duration_seconds": 3.43,
      "text": "Rate it for me, mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 74.14,
      "end_seconds": 75.57,
      "duration_seconds": 1.43,
      "text": "Severe I'd say"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 77.02,
      "end_seconds": 81.99,
      "duration_seconds": 4.97,
      "text": "what conditions have you been treated for in the the past?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 83.98,
      "end_seconds": 92.44,
      "duration_seconds": 8.46,
      "text": "I've had high cholesterol for nearly five years now i've never really been one for hospitals"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 96.4,
      "end_seconds": 105.04,
      "duration_seconds": 8.64,
      "text": "alright, high cholesterol, that matches what I have here. What about your parents, brothers or sisters, any conditions?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 106.56,
      "end_seconds": 108.7,
      "duration_seconds": 2.14,
      "text": "My brother has epilepsy."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 121.46,
      "end_seconds": 124.98,
      "duration_seconds": 3.52,
      "text": "Let me ask about allergies, anything at all?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 126.03,
      "end_seconds": 129.87,
      "duration_seconds": 3.84,
      "text": "yes, tramadol, it gives me feeling very drowsy"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 131.7,
      "end_seconds": 135.02,
      "duration_seconds": 3.32,
      "text": "Do you take any prescribed or over-the-counter medicines?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 135.7,
      "end_seconds": 142.02,
      "duration_seconds": 6.32,
      "text": "sorry what was I saying I take atorvastatin 20 milligrams at night"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 142.93,
      "end_seconds": 145.42,
      "duration_seconds": 2.49,
      "text": "have you been to theatre before?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 147.47,
      "end_seconds": 156.65,
      "duration_seconds": 9.18,
      "text": "Yes, um, I had a cataract operation in my left eye, about a year ago."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 158.64,
      "end_seconds": 161.63,
      "duration_seconds": 2.99,
      "text": "Are you on your own at home?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 162.28,
      "end_seconds": 165.53,
      "duration_seconds": 3.25,
      "text": "I live with my elderly mother"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 167.5,
      "end_seconds": 169.61,
      "duration_seconds": 2.11,
      "text": "do you do any exercise?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 170.12,
      "end_seconds": 172.78,
      "duration_seconds": 2.66,
      "text": "I swim twice a week"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 189.03,
      "end_seconds": 192.98,
      "duration_seconds": 3.95,
      "text": "have you noticed yellow eyes or dark urine?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 194.41,
      "end_seconds": 197.71,
      "duration_seconds": 3.3,
      "text": "right, no, not a single one"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 197.98,
      "end_seconds": 201.19,
      "duration_seconds": 3.21,
      "text": "ah. Have you noticed fever or pale stools?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 203.0,
      "end_seconds": 205.18,
      "duration_seconds": 2.18,
      "text": "Nope, nothing like that."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 206.08,
      "end_seconds": 211.59,
      "duration_seconds": 5.51,
      "text": "Have you noticed any weakness, or anything odd with your balance?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 212.55,
      "end_seconds": 214.94,
      "duration_seconds": 2.39,
      "text": "No, that's all normal."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 218.6,
      "end_seconds": 222.4,
      "duration_seconds": 3.8,
      "text": "so, how are your joints, any aches elsewhere?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 223.05,
      "end_seconds": 224.87,
      "duration_seconds": 1.82,
      "text": "I move fine otherwise."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 226.43,
      "end_seconds": 235.15,
      "duration_seconds": 8.72,
      "text": "Okay, so the vitals from earlier. Pulse is 78 beats a minute, oxygen saturation is 99 percent, pressure 116 over 76."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 236.15,
      "end_seconds": 237.2,
      "duration_seconds": 1.05,
      "text": "okay, noted"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 238.44,
      "end_seconds": 241.6,
      "duration_seconds": 3.16,
      "text": "okay, time for me to examine you"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 243.04,
      "end_seconds": 245.13,
      "duration_seconds": 2.09,
      "text": "hold that for a second"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 262.89,
      "end_seconds": 271.03,
      "duration_seconds": 8.14,
      "text": "there is tenderness under the right ribs when you breathe in, and no yellowing of the eyes"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 272.64,
      "end_seconds": 273.63,
      "duration_seconds": 0.99,
      "text": "of course"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 278.1,
      "end_seconds": 289.28,
      "duration_seconds": 11.18,
      "text": "thank you you can get dressed let me tell you where I've got to it points towards biliary colic from gallstones i can't rule out peptic ulcer yet"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 289.88,
      "end_seconds": 293.12,
      "duration_seconds": 3.24,
      "text": "Is there something to worry about?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 294.18,
      "end_seconds": 301.72,
      "duration_seconds": 7.54,
      "text": "it's reasonable to be concerned but right now biliary colic from gallstones is my leading thought not anything worse"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 317.82,
      "end_seconds": 331.6,
      "duration_seconds": 13.78,
      "text": "I'd like to arrange an ultrasound of the tummy for right upper quadrant pain i'd rather check than guess and this is the quickest way to know more"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 332.25,
      "end_seconds": 333.32,
      "duration_seconds": 1.07,
      "text": "mm, alright"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 333.96,
      "end_seconds": 368.42,
      "duration_seconds": 34.46,
      "text": "I want liver blood tests done that's for upper abdominal pain. I'd like you to take diclofenac 50 milligrams three times a day if needed for three days. That's for gallbladder pain. Keep meals small and and low in fat until we have the scan. We'll refer you to the surgeons. One warning sign to remember: you develop a fever yellow eyes or severe constant pain. In that case don't wait. Have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 371.14,
      "end_seconds": 373.32,
      "duration_seconds": 2.18,
      "text": "thank you, doctor, goodbye"
    }
  ]
}