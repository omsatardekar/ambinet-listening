{
  "schema_version": "1.0",
  "encounter_id": "20476",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.97,
      "end_seconds": 7.29,
      "duration_seconds": 6.32,
      "text": "Right, hi there, the chair's free, sit down. Start wherever you like, I'm listening."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 8.9,
      "end_seconds": 11.61,
      "duration_seconds": 2.71,
      "text": "I'm here because of hot flushes."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 13.35,
      "end_seconds": 15.61,
      "duration_seconds": 2.26,
      "text": "Let's run through your medicines."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 19.47,
      "end_seconds": 25.43,
      "duration_seconds": 5.96,
      "text": "I'm on alendronate, 70 milligrams, once a week for my bones."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 31.28,
      "end_seconds": 32.6,
      "duration_seconds": 1.32,
      "text": "Since when exactly?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 34.42,
      "end_seconds": 48.17,
      "duration_seconds": 13.75,
      "text": "It's been four weeks now. It's a relief to finally sit down and talk about it. I didn't want to bother you but it keeps coming back."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 49.03,
      "end_seconds": 51.92,
      "duration_seconds": 2.89,
      "text": "Is it constant or in episodes?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 53.05,
      "end_seconds": 56.85,
      "duration_seconds": 3.8,
      "text": "I'd say a couple of times a week."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 57.71,
      "end_seconds": 60.62,
      "duration_seconds": 2.91,
      "text": "Has there been mood swings too?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 61.39,
      "end_seconds": 64.42,
      "duration_seconds": 3.03,
      "text": "Yes, about the same, four weeks."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 74.8,
      "end_seconds": 77.93,
      "duration_seconds": 3.13,
      "text": "Did you get weight loss or heavy bleeding?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 79.06,
      "end_seconds": 84.94,
      "duration_seconds": 5.88,
      "text": "Mm, no weight loss or heavy bleeding, none of it."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 87.03,
      "end_seconds": 90.24,
      "duration_seconds": 3.21,
      "text": "Have you noticed chest pain or palpitations?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 91.29,
      "end_seconds": 93.79,
      "duration_seconds": 2.5,
      "text": "No, I'd have said so."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 94.32,
      "end_seconds": 98.12,
      "duration_seconds": 3.8,
      "text": "Understood. Any problems with your joints or muscles?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 99.73,
      "end_seconds": 101.22,
      "duration_seconds": 1.49,
      "text": "Nothing else aches."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 105.81,
      "end_seconds": 110.26,
      "duration_seconds": 4.45,
      "text": "Do you react to any medicines or foods? Any allergies?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 116.4,
      "end_seconds": 117.98,
      "duration_seconds": 1.58,
      "text": "Diclofenac, I'd say."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 135.73,
      "end_seconds": 138.32,
      "duration_seconds": 2.59,
      "text": "Do you have any chronic illnesses?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 138.83,
      "end_seconds": 153.2,
      "duration_seconds": 14.37,
      "text": "Thin bones, for about a year. A neighbour of mine said I should see someone about it. I've been reading about it online and it worried me."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 155.22,
      "end_seconds": 157.34,
      "duration_seconds": 2.12,
      "text": "Do you get out much?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 161.77,
      "end_seconds": 165.71,
      "duration_seconds": 3.94,
      "text": "Not much, I mostly stay in these days."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 167.22,
      "end_seconds": 170.17,
      "duration_seconds": 2.95,
      "text": "Are you on your own at home?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 171.63,
      "end_seconds": 174.8,
      "duration_seconds": 3.17,
      "text": "I live with my elderly mother."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 186.41,
      "end_seconds": 188.93,
      "duration_seconds": 2.52,
      "text": "Let's start with the basic checks."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 198.72,
      "end_seconds": 201.63,
      "duration_seconds": 2.91,
      "text": "That's it, just a little longer..."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 211.73,
      "end_seconds": 216.88,
      "duration_seconds": 5.15,
      "text": "Okay: pulse 79, pressure 112 over 68, temperature is 36.9 degrees."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 218.01,
      "end_seconds": 219.67,
      "duration_seconds": 1.66,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 220.56,
      "end_seconds": 224.07,
      "duration_seconds": 3.51,
      "text": "Don't worry, we'll discuss it in a second."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 226.31,
      "end_seconds": 228.52,
      "duration_seconds": 2.21,
      "text": "May I examine you now?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 230.24,
      "end_seconds": 232.58,
      "duration_seconds": 2.34,
      "text": "I'll listen to your chest now."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 249.77,
      "end_seconds": 255.69,
      "duration_seconds": 5.92,
      "text": "Blood pressure and pulse are fine and there are no breast lumps on examination."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 259.98,
      "end_seconds": 282.14,
      "duration_seconds": 22.16,
      "text": "So, you can sit up now. Let me tell you where I've got to. I'm honestly not certain yet. It could be perimenopausal symptoms, or it might be an overactive thyroid. Just to be sure I understood. You've had hot flushes for four weeks, and no palpitations or chest pain."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 284.01,
      "end_seconds": 285.83,
      "duration_seconds": 1.82,
      "text": "That's it, yes."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 301.95,
      "end_seconds": 315.07,
      "duration_seconds": 13.12,
      "text": "Layers of clothing, a fan by the bed, and cutting down on caffeine and spicy food can help the flushes. Right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 316.8,
      "end_seconds": 318.95,
      "duration_seconds": 2.15,
      "text": "Thank you, doctor, goodbye."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 320.18,
      "end_seconds": 321.51,
      "duration_seconds": 1.33,
      "text": "All the best."
    }
  ]
}