{
  "schema_version": "1.0",
  "encounter_id": "20443",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.92,
      "end_seconds": 3.01,
      "duration_seconds": 2.09,
      "text": "Hi, sit anywhere you like."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 3.58,
      "end_seconds": 4.79,
      "duration_seconds": 1.21,
      "text": "Hi, thanks."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 9.64,
      "end_seconds": 11.98,
      "duration_seconds": 2.34,
      "text": "You came on your own today?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 13.04,
      "end_seconds": 16.17,
      "duration_seconds": 3.13,
      "text": "Yes, I managed on my own."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 17.51,
      "end_seconds": 18.84,
      "duration_seconds": 1.33,
      "text": "What's the problem?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 19.41,
      "end_seconds": 22.8,
      "duration_seconds": 3.39,
      "text": "I've been waking up breathless at night."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 23.92,
      "end_seconds": 27.21,
      "duration_seconds": 3.29,
      "text": "How long has it been like this?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 28.63,
      "end_seconds": 33.13,
      "duration_seconds": 4.5,
      "text": "It's been about a year, I'm fairly sure."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 34.64,
      "end_seconds": 43.1,
      "duration_seconds": 8.46,
      "text": "Tell me a bit more about it: how bad it gets, how often, and whether anything makes it better or worse."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 43.79,
      "end_seconds": 49.83,
      "duration_seconds": 6.04,
      "text": "A seven out of ten, I suppose. It's all the time."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 50.48,
      "end_seconds": 53.9,
      "duration_seconds": 3.42,
      "text": "And what about calf pain or chest pain?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 54.92,
      "end_seconds": 59.67,
      "duration_seconds": 4.75,
      "text": "Oh, I haven't had calf pain or chest pain, no."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 60.7,
      "end_seconds": 63.86,
      "duration_seconds": 3.16,
      "text": "Have you noticed fainting or cough with blood?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 65.54,
      "end_seconds": 68.45,
      "duration_seconds": 2.91,
      "text": "No, none of those at all."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 69.77,
      "end_seconds": 72.95,
      "duration_seconds": 3.18,
      "text": "How are your joints, any aches elsewhere?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 74.37,
      "end_seconds": 76.62,
      "duration_seconds": 2.25,
      "text": "I move fine otherwise."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 77.66,
      "end_seconds": 79.23,
      "duration_seconds": 1.57,
      "text": "Neurologically, anything strange?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 80.01,
      "end_seconds": 82.57,
      "duration_seconds": 2.56,
      "text": "Well, no, that's all normal."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 99.52,
      "end_seconds": 102.82,
      "duration_seconds": 3.3,
      "text": "Do you take any prescribed or over-the-counter medicines?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 104.23,
      "end_seconds": 109.14,
      "duration_seconds": 4.91,
      "text": "Metoprolol. I take it twice a day for my heart."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 110.15,
      "end_seconds": 112.5,
      "duration_seconds": 2.35,
      "text": "And what strength is that?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 117.48,
      "end_seconds": 126.08,
      "duration_seconds": 8.6,
      "text": "50 milligrams, I think that's what's on the box. Telmisartan, 40 milligrams, once a day for my pressure."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 127.95,
      "end_seconds": 133.9,
      "duration_seconds": 5.95,
      "text": "Alright, are you allergic to anything? Any allergies to medicines or foods?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 135.79,
      "end_seconds": 139.33,
      "duration_seconds": 3.54,
      "text": "Wheat. I come out in... well, bloating."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 141.32,
      "end_seconds": 144.08,
      "duration_seconds": 2.76,
      "text": "Has anyone ever diagnosed you with something?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 146.03,
      "end_seconds": 151.46,
      "duration_seconds": 5.43,
      "text": "Yes, heart failure. Right, I've had high blood pressure, yes."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 160.25,
      "end_seconds": 163.09,
      "duration_seconds": 2.84,
      "text": "Are you on your own at home?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 164.67,
      "end_seconds": 167.66,
      "duration_seconds": 2.99,
      "text": "I live with my elderly mother."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 168.42,
      "end_seconds": 171.49,
      "duration_seconds": 3.07,
      "text": "What do you do during the day?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 173.22,
      "end_seconds": 176.8,
      "duration_seconds": 3.58,
      "text": "I look after my grandchildren most days."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 178.06,
      "end_seconds": 179.84,
      "duration_seconds": 1.78,
      "text": "Right, are you active?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 183.74,
      "end_seconds": 186.56,
      "duration_seconds": 2.82,
      "text": "I walk the dog every morning."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 196.36,
      "end_seconds": 205.37,
      "duration_seconds": 9.01,
      "text": "Here are the numbers, doctor. Pressure 134 over 87, pulse is 119 beats a minute. Oxygen saturation is 98 percent, temp 36.9 degrees."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 206.7,
      "end_seconds": 208.07,
      "duration_seconds": 1.37,
      "text": "Good, thank you."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 220.96,
      "end_seconds": 226.92,
      "duration_seconds": 5.96,
      "text": "Right, here's what I'm thinking. My working impression is fluid overload from heart failure."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 227.78,
      "end_seconds": 229.17,
      "duration_seconds": 1.39,
      "text": "Is this permanent?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 235.0,
      "end_seconds": 253.98,
      "duration_seconds": 18.98,
      "text": "I understand the worry. At the moment I'd say it's fluid overload from heart failure, and we'll know more once the a heart ultrasound is back. I'm going to order a heart ultrasound, for suspected heart failure. I think blood tests makes sense here, for fluid overload."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 258.82,
      "end_seconds": 260.61,
      "duration_seconds": 1.79,
      "text": "That's fine with me."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 262.22,
      "end_seconds": 293.95,
      "duration_seconds": 31.73,
      "text": "Let's use furosemide, 40 milligrams, every morning, long term. You take it by mouth. It's for fluid retention. It's a commonly used medicine and most people tolerate it well. Keep the salt low and avoid adding it at the table. Weigh yourself every morning and tell us if you gain more than two kilos in three days. I'll also refer you to the community nursing team."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 294.53,
      "end_seconds": 296.21,
      "duration_seconds": 1.68,
      "text": "Alright, thank you."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 297.24,
      "end_seconds": 303.95,
      "duration_seconds": 6.71,
      "text": "I'd like you back in one week. Is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 304.78,
      "end_seconds": 308.87,
      "duration_seconds": 4.09,
      "text": "Um, good, thanks, I'll see you then."
    }
  ]
}