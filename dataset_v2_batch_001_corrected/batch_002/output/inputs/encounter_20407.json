{
  "schema_version": "1.0",
  "encounter_id": "20407",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.08,
      "end_seconds": 5.24,
      "duration_seconds": 4.16,
      "text": "Sorry, you know, doctor, shall I sit here?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.3,
      "end_seconds": 10.71,
      "duration_seconds": 4.41,
      "text": "That's fine, sit down. Tell me why you came."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 12.67,
      "end_seconds": 17.57,
      "duration_seconds": 4.9,
      "text": "I've been passing out for a couple of minutes."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 18.83,
      "end_seconds": 20.05,
      "duration_seconds": 1.22,
      "text": "Since when exactly?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 21.52,
      "end_seconds": 25.36,
      "duration_seconds": 3.84,
      "text": "It's been going on for about a week."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 27.08,
      "end_seconds": 30.16,
      "duration_seconds": 3.08,
      "text": "How troublesome is it day to day?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 31.36,
      "end_seconds": 32.39,
      "duration_seconds": 1.03,
      "text": "Moderate, really."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 33.14,
      "end_seconds": 35.51,
      "duration_seconds": 2.37,
      "text": "Any vomiting, fever or weakness?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 37.37,
      "end_seconds": 39.85,
      "duration_seconds": 2.48,
      "text": "No, not a single one."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 41.93,
      "end_seconds": 45.88,
      "duration_seconds": 3.95,
      "text": "What about your tummy and bowels, anything unusual there?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 47.39,
      "end_seconds": 50.12,
      "duration_seconds": 2.73,
      "text": "No, that side's been fine."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 51.69,
      "end_seconds": 53.42,
      "duration_seconds": 1.73,
      "text": "How's your breathing otherwise?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 54.81,
      "end_seconds": 55.79,
      "duration_seconds": 0.98,
      "text": "Breathing's normal."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 59.41,
      "end_seconds": 61.57,
      "duration_seconds": 2.16,
      "text": "What about your medical history?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 63.23,
      "end_seconds": 67.52,
      "duration_seconds": 4.29,
      "text": "I have high blood pressure, for about ten years."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 68.82,
      "end_seconds": 78.18,
      "duration_seconds": 9.36,
      "text": "Right, so high blood pressure is already on your record. We'll keep that in mind today. Right, have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 79.41,
      "end_seconds": 81.63,
      "duration_seconds": 2.22,
      "text": "No, not at all."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 95.21,
      "end_seconds": 99.9,
      "duration_seconds": 4.69,
      "text": "Any allergies to tablets, food or anything in the environment?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 101.47,
      "end_seconds": 104.86,
      "duration_seconds": 3.39,
      "text": "No, I'm not allergic to anything."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 114.83,
      "end_seconds": 116.88,
      "duration_seconds": 2.05,
      "text": "Let's run through your medicines."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 118.11,
      "end_seconds": 121.86,
      "duration_seconds": 3.75,
      "text": "Amlodipine. I take it once a day."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 123.95,
      "end_seconds": 126.28,
      "duration_seconds": 2.33,
      "text": "How much do you take?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 130.68,
      "end_seconds": 132.28,
      "duration_seconds": 1.6,
      "text": "It's 5 milligrams."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 143.29,
      "end_seconds": 144.24,
      "duration_seconds": 0.95,
      "text": "Any smoking?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 145.29,
      "end_seconds": 148.07,
      "duration_seconds": 2.78,
      "text": "I gave up cigarettes last spring."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 148.77,
      "end_seconds": 150.45,
      "duration_seconds": 1.68,
      "text": "And alcohol, how much?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 151.15,
      "end_seconds": 152.87,
      "duration_seconds": 1.72,
      "text": "Nothing, I'm teetotal."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 154.72,
      "end_seconds": 156.88,
      "duration_seconds": 2.16,
      "text": "Do you live by yourself?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 162.14,
      "end_seconds": 166.35,
      "duration_seconds": 4.21,
      "text": "No, I share a house with my brother."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 167.89,
      "end_seconds": 170.84,
      "duration_seconds": 2.95,
      "text": "Okay, do you do any exercise?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 171.79,
      "end_seconds": 174.21,
      "duration_seconds": 2.42,
      "text": "I swim twice a week."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 175.43,
      "end_seconds": 177.97,
      "duration_seconds": 2.54,
      "text": "Let's start with the basic checks."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 189.94,
      "end_seconds": 192.35,
      "duration_seconds": 2.41,
      "text": "Okay, this won't take long..."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 213.4,
      "end_seconds": 220.24,
      "duration_seconds": 6.84,
      "text": "Okay: temperature 36.7, BP is 128 over 81, pulse 78, oxygen saturation is 97 percent."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 221.45,
      "end_seconds": 222.93,
      "duration_seconds": 1.48,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 224.0,
      "end_seconds": 226.62,
      "duration_seconds": 2.62,
      "text": "I'll interpret them after the examination."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 227.8,
      "end_seconds": 230.07,
      "duration_seconds": 2.27,
      "text": "Shall I start the examination?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 231.13,
      "end_seconds": 233.38,
      "duration_seconds": 2.25,
      "text": "Raise your arm for me."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 249.43,
      "end_seconds": 254.49,
      "duration_seconds": 5.06,
      "text": "The neurological examination is normal, with steady walking and equal power."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 257.81,
      "end_seconds": 260.44,
      "duration_seconds": 2.63,
      "text": "Good, you can sit up again."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 270.68,
      "end_seconds": 275.88,
      "duration_seconds": 5.2,
      "text": "Taking everything into account, it points towards a possible first seizure."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 277.03,
      "end_seconds": 280.66,
      "duration_seconds": 3.63,
      "text": "Hmm, is there something to worry about?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 285.01,
      "end_seconds": 317.48,
      "duration_seconds": 32.47,
      "text": "I understand the worry. At the moment I'd say it's a possible first seizure, and we'll know more once the an ECG is back. I want an ECG done, that's for loss of consciousness. The result will help us decide whether anything more is needed. No driving until you have been seen in the clinic, and avoid swimming or climbing alone. I'd like to see you again after the scan."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 318.68,
      "end_seconds": 323.14,
      "duration_seconds": 4.46,
      "text": "Right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 324.6,
      "end_seconds": 328.61,
      "duration_seconds": 4.01,
      "text": "Okay, that makes sense. Thanks for explaining."
    }
  ]
}