{
  "schema_version": "1.0",
  "encounter_id": "20328",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 0.94,
      "end_seconds": 6.91,
      "duration_seconds": 5.97,
      "text": "Okay, doctor, we're all set in here. I'll give you the numbers when you want them."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.39,
      "end_seconds": 14.13,
      "duration_seconds": 5.74,
      "text": "Right, thanks. Hello, come in, sit down. What brings you in today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 14.75,
      "end_seconds": 28.29,
      "duration_seconds": 13.54,
      "text": "let me think, it's a fluttering in my chest, mostly i told myself I'd wait and see, and here I am it's the not knowing that gets to me"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 29.92,
      "end_seconds": 38.81,
      "duration_seconds": 8.89,
      "text": "Here are the numbers, doctor. BP is 114 over 86, temperature is 36.8 degrees. Heart rate 119, saturation 99 percent."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 40.63,
      "end_seconds": 43.58,
      "duration_seconds": 2.95,
      "text": "Okay, noted. Did it come on recently?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 44.74,
      "end_seconds": 57.2,
      "duration_seconds": 12.46,
      "text": "It's been going on for two months. I didn't want to bother you but it keeps coming back. Sorry, I know I'm rambling a bit."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 57.6,
      "end_seconds": 62.26,
      "duration_seconds": 4.66,
      "text": "Yes, carry on. Rate it for me, mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 63.02,
      "end_seconds": 64.86,
      "duration_seconds": 1.84,
      "text": "I'd call it mild."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 65.37,
      "end_seconds": 68.15,
      "duration_seconds": 2.78,
      "text": "And chest pain, any of that?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 69.14,
      "end_seconds": 71.4,
      "duration_seconds": 2.26,
      "text": "nope, no chest pain"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 73.17,
      "end_seconds": 76.51,
      "duration_seconds": 3.34,
      "text": "Any leg swelling, sweating or tremor at all?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 78.12,
      "end_seconds": 83.0,
      "duration_seconds": 4.88,
      "text": "I haven't had leg swelling, sweating or tremor, no."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 85.07,
      "end_seconds": 88.0,
      "duration_seconds": 2.93,
      "text": "okay, any trouble with the waterworks?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 88.52,
      "end_seconds": 89.93,
      "duration_seconds": 1.41,
      "text": "No changes there."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 90.68,
      "end_seconds": 95.44,
      "duration_seconds": 4.76,
      "text": "Can you list what you take, tablets, creams or inhalers?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 96.31,
      "end_seconds": 101.61,
      "duration_seconds": 5.3,
      "text": "Valsartan, 80 milligrams, once a day for my blood pressure."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 118.24,
      "end_seconds": 121.79,
      "duration_seconds": 3.55,
      "text": "Any health conditions I should have on record?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 123.24,
      "end_seconds": 126.72,
      "duration_seconds": 3.48,
      "text": "I've had high blood pressure, yes."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 127.72,
      "end_seconds": 128.42,
      "duration_seconds": 0.7,
      "text": "Yes."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 139.93,
      "end_seconds": 144.35,
      "duration_seconds": 4.42,
      "text": "Any allergies to tablets, food or anything in the environment?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 145.28,
      "end_seconds": 149.8,
      "duration_seconds": 4.52,
      "text": "Actually, no, nothing as far as I know."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 164.2,
      "end_seconds": 166.09,
      "duration_seconds": 1.89,
      "text": "Okay, do you smoke?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 167.49,
      "end_seconds": 170.7,
      "duration_seconds": 3.21,
      "text": "I gave up cigarettes last spring."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 172.4,
      "end_seconds": 174.28,
      "duration_seconds": 1.88,
      "text": "how are your meals?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 176.32,
      "end_seconds": 180.37,
      "duration_seconds": 4.05,
      "text": "I grab fast food at lunch most days."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 184.62,
      "end_seconds": 187.57,
      "duration_seconds": 2.95,
      "text": "Anything you do to stay fit?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 189.63,
      "end_seconds": 193.58,
      "duration_seconds": 3.95,
      "text": "I do a yoga class on Thursdays"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 194.47,
      "end_seconds": 197.78,
      "duration_seconds": 3.31,
      "text": "Are you in work at the moment?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 199.11,
      "end_seconds": 203.21,
      "duration_seconds": 4.1,
      "text": "Yes, I work in a bakery, early starts."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 206.15,
      "end_seconds": 211.02,
      "duration_seconds": 4.87,
      "text": "I'll need to examine you for this, it won't take long."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 212.81,
      "end_seconds": 214.07,
      "duration_seconds": 1.26,
      "text": "Nearly finished here."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 232.77,
      "end_seconds": 236.12,
      "duration_seconds": 3.35,
      "text": "Heart sounds are normal with no murmur."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 237.93,
      "end_seconds": 239.57,
      "duration_seconds": 1.64,
      "text": "Yeah, no problem."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 245.24,
      "end_seconds": 257.08,
      "duration_seconds": 11.84,
      "text": "thank you, you can get dressed let me tell you where I've got to this looks most like paroxysmal palpitations, possibly an atrial arrhythmia"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 258.93,
      "end_seconds": 261.47,
      "duration_seconds": 2.54,
      "text": "erm, is it dangerous, doctor?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 267.58,
      "end_seconds": 277.2,
      "duration_seconds": 9.62,
      "text": "Nothing I've seen today points to an emergency. It looks like paroxysmal palpitations, possibly an atrial arrhythmia, but I'd like to confirm."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 286.58,
      "end_seconds": 321.22,
      "duration_seconds": 34.64,
      "text": "I'd like to arrange an ECG for palpitations. I'm going to order a heart monitor for a few days, for palpitations. What I'm giving you is bisoprolol, 2.5 milligrams, once a day, until review. That's for heart rate control. Cut right back on coffee, tea and energy drinks for now. Please don't wait if you faint or get chest pain with the racing. That's when to be seen urgently."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 322.83,
      "end_seconds": 324.64,
      "duration_seconds": 1.81,
      "text": "That's fine by me."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 325.31,
      "end_seconds": 333.85,
      "duration_seconds": 8.54,
      "text": "We'll catch up after the monitor results are back. Is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 334.97,
      "end_seconds": 338.25,
      "duration_seconds": 3.28,
      "text": "I think I understand everything. Thanks."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 339.59,
      "end_seconds": 340.76,
      "duration_seconds": 1.17,
      "text": "Goodbye for now."
    }
  ]
}