{
  "schema_version": "1.0",
  "encounter_id": "20232",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 0.53,
      "end_seconds": 6.44,
      "duration_seconds": 5.91,
      "text": "doctor, this one's ready for you. Everything's on the chart, but I'll go through it"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 9.61,
      "end_seconds": 15.14,
      "duration_seconds": 5.53,
      "text": "great. Hello, come in and sit down. How can I help?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 16.45,
      "end_seconds": 22.92,
      "duration_seconds": 6.47,
      "text": "So the thing is, I've got pain in my lower back."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 23.77,
      "end_seconds": 26.68,
      "duration_seconds": 2.91,
      "text": "how long has it been like this?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 28.43,
      "end_seconds": 36.26,
      "duration_seconds": 7.83,
      "text": "I'd say about a year actually, uh, no, closer to nearly five years"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 37.63,
      "end_seconds": 46.17,
      "duration_seconds": 8.54,
      "text": "Can you describe it a bit more for me? How strong it is, what the pattern is, what helps."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 48.06,
      "end_seconds": 68.83,
      "duration_seconds": 20.77,
      "text": "well, I'd say a couple of times a week. Lying flat helps a bit. I've also been feeling unsteady, for two years. Erm, I've also had a stooped back. I've also been losing height"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 72.74,
      "end_seconds": 79.0,
      "duration_seconds": 6.26,
      "text": "have you had pain in your lower back before, or is this the first time?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 79.84,
      "end_seconds": 88.05,
      "duration_seconds": 8.21,
      "text": "Yes, something like this happened last winter, and it went away on its own."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 89.65,
      "end_seconds": 100.59,
      "duration_seconds": 10.94,
      "text": "Okay, so the vitals from earlier. BP is 115 over 71, pulse is 74 beats a minute, saturation 97 percent, temperature is 36.4 degrees."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 102.53,
      "end_seconds": 103.23,
      "duration_seconds": 0.7,
      "text": "thanks"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 105.19,
      "end_seconds": 108.07,
      "duration_seconds": 2.88,
      "text": "okay, time for me to examine you"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 109.71,
      "end_seconds": 112.58,
      "duration_seconds": 2.87,
      "text": "Take a deep breath for me."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 120.03,
      "end_seconds": 126.84,
      "duration_seconds": 6.81,
      "text": "There is tenderness over the mid lower spine and no weakness in the legs."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 131.37,
      "end_seconds": 135.0,
      "duration_seconds": 3.63,
      "text": "right, good, you can sit up again"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 151.29,
      "end_seconds": 154.94,
      "duration_seconds": 3.65,
      "text": "Did you get night pain or bladder problems?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 159.56,
      "end_seconds": 162.47,
      "duration_seconds": 2.91,
      "text": "no, nothing to report there"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 163.16,
      "end_seconds": 166.6,
      "duration_seconds": 3.44,
      "text": "any chest pain or fever at all?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 167.87,
      "end_seconds": 173.71,
      "duration_seconds": 5.84,
      "text": "Right, you know, I haven't had chest pain or fever, no."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 175.12,
      "end_seconds": 178.86,
      "duration_seconds": 3.74,
      "text": "On the cardiac side, anything I should know?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 180.36,
      "end_seconds": 181.85,
      "duration_seconds": 1.49,
      "text": "Nothing like that."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 197.16,
      "end_seconds": 200.06,
      "duration_seconds": 2.9,
      "text": "Do you have any long-term conditions?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 201.75,
      "end_seconds": 218.66,
      "duration_seconds": 16.91,
      "text": "I have an underactive thyroid. I have thin bones. I looked a few things up online, and that probably didn't help. Uh, I've had heart disease, yes."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 220.21,
      "end_seconds": 227.49,
      "duration_seconds": 7.28,
      "text": "Mm, okay. Okay, I can see an underactive thyroid and heart disease in your file as well."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 246.0,
      "end_seconds": 250.08,
      "duration_seconds": 4.08,
      "text": "Any allergies to tablets, food or anything in the environment?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 255.1,
      "end_seconds": 266.84,
      "duration_seconds": 11.74,
      "text": "So, I think I reacted to some antibiotic once, years ago. I don't remember which one, or what happened exactly."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 268.58,
      "end_seconds": 273.28,
      "duration_seconds": 4.7,
      "text": "let's talk a little about your daily life and habits"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 274.54,
      "end_seconds": 284.12,
      "duration_seconds": 9.58,
      "text": "I gave up cigarettes last spring. I swim twice a week. Yes, I work in a bakery, early starts."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 285.98,
      "end_seconds": 289.57,
      "duration_seconds": 3.59,
      "text": "Has anyone in your family had anything serious?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 290.23,
      "end_seconds": 293.13,
      "duration_seconds": 2.9,
      "text": "My aunt has rheumatoid arthritis."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 294.05,
      "end_seconds": 298.18,
      "duration_seconds": 4.13,
      "text": "Are you taking anything regularly, including from the pharmacy?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 299.2,
      "end_seconds": 318.21,
      "duration_seconds": 19.01,
      "text": "Eltroxin, 100 micrograms, every morning. Alendronate, 70 milligrams, once a week. Clopidogrel, 75 milligrams, once a day. Sorry, what was I saying, it's calcium tablets, 500 milligrams, twice a day."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 318.76,
      "end_seconds": 323.77,
      "duration_seconds": 5.01,
      "text": "doctor, our chart from the last visit lists it as 250 milligrams"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 325.73,
      "end_seconds": 331.48,
      "duration_seconds": 5.75,
      "text": "Okay. Have you got the newest prescription or the box with you?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 333.41,
      "end_seconds": 338.67,
      "duration_seconds": 5.26,
      "text": "erm, uh, no, I left it at home"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 339.84,
      "end_seconds": 350.61,
      "duration_seconds": 10.77,
      "text": "okay, thinking it through, it fits best with thin bones with a fragility fracture and back pain we shouldn't forget a spinal compression fracture"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 351.13,
      "end_seconds": 354.72,
      "duration_seconds": 3.59,
      "text": "What are the odds it's serious?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 355.9,
      "end_seconds": 385.03,
      "duration_seconds": 29.13,
      "text": "I understand the worry. At the moment I'd say it's thin bones with a fragility fracture and back pain, and we'll watch how it goes. Take the weekly tablet first thing with a full glass of water and stay upright for half an hour. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 385.84,
      "end_seconds": 387.67,
      "duration_seconds": 1.83,
      "text": "I'll remember that."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 389.57,
      "end_seconds": 392.26,
      "duration_seconds": 2.69,
      "text": "That's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 393.27,
      "end_seconds": 397.46,
      "duration_seconds": 4.19,
      "text": "Right, I'll do that. Thank you, doctor."
    }
  ]
}