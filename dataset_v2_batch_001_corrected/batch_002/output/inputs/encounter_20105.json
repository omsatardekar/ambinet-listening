{
  "schema_version": "1.0",
  "encounter_id": "20105",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.86,
      "end_seconds": 6.21,
      "duration_seconds": 5.35,
      "text": "Hi, uh, doctor, I hope I'm not disturbing you."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.96,
      "end_seconds": 10.62,
      "duration_seconds": 3.66,
      "text": "No problem at all, come in. What's troubling you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 12.66,
      "end_seconds": 18.6,
      "duration_seconds": 5.94,
      "text": "Well, um, I've been having pain in the calf."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 19.12,
      "end_seconds": 22.87,
      "duration_seconds": 3.75,
      "text": "How many days or weeks has it been?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 23.63,
      "end_seconds": 33.64,
      "duration_seconds": 10.01,
      "text": "It's been going on for about four days. I didn't want to make a fuss, you know."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 35.64,
      "end_seconds": 41.26,
      "duration_seconds": 5.62,
      "text": "Okay, give me more detail on it, whatever comes to mind."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 42.27,
      "end_seconds": 55.86,
      "duration_seconds": 13.59,
      "text": "Yes, walking. That makes it worse. A six out of ten, I suppose. I had a bite mark on the shin before. That's settled now, though."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 57.41,
      "end_seconds": 64.15,
      "duration_seconds": 6.74,
      "text": "Okay, have you had pain in the calf before, or is this the first time?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 65.51,
      "end_seconds": 76.22,
      "duration_seconds": 10.71,
      "text": "Yes, something like this happened a couple of years ago, and it went away on its own."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 77.88,
      "end_seconds": 81.91,
      "duration_seconds": 4.03,
      "text": "Anything in your past medical history I should know?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 83.1,
      "end_seconds": 88.58,
      "duration_seconds": 5.48,
      "text": "Let me think, I've had high blood pressure, yes."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 89.78,
      "end_seconds": 92.2,
      "duration_seconds": 2.42,
      "text": "Tell me your medicines, please."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 94.25,
      "end_seconds": 97.48,
      "duration_seconds": 3.23,
      "text": "Valsartan, 80 milligrams, once a day."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 99.32,
      "end_seconds": 100.69,
      "duration_seconds": 1.37,
      "text": "Do you smoke?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 102.49,
      "end_seconds": 106.77,
      "duration_seconds": 4.28,
      "text": "No, I've never smoked in my life."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 110.73,
      "end_seconds": 111.96,
      "duration_seconds": 1.23,
      "text": "What about alcohol?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 112.74,
      "end_seconds": 116.67,
      "duration_seconds": 3.93,
      "text": "I'll have a glass of wine with dinner."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 117.92,
      "end_seconds": 120.82,
      "duration_seconds": 2.9,
      "text": "Do you follow any particular diet?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 121.74,
      "end_seconds": 126.01,
      "duration_seconds": 4.27,
      "text": "I'm vegetarian and have been for years."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 131.61,
      "end_seconds": 133.2,
      "duration_seconds": 1.59,
      "text": "Who lives with you?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 133.77,
      "end_seconds": 136.59,
      "duration_seconds": 2.82,
      "text": "My partner and our baby."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 141.28,
      "end_seconds": 142.55,
      "duration_seconds": 1.27,
      "text": "Are you active?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 143.82,
      "end_seconds": 146.82,
      "duration_seconds": 3.0,
      "text": "I walk the dog every morning."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 161.76,
      "end_seconds": 163.13,
      "duration_seconds": 1.37,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 164.27,
      "end_seconds": 166.0,
      "duration_seconds": 1.73,
      "text": "No surgery, no."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 179.57,
      "end_seconds": 182.27,
      "duration_seconds": 2.7,
      "text": "Before we go further, any allergies?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 183.97,
      "end_seconds": 188.86,
      "duration_seconds": 4.89,
      "text": "I'm allergic to tramadol, I get feeling very drowsy."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 190.96,
      "end_seconds": 192.86,
      "duration_seconds": 1.9,
      "text": "Any vomiting or pus?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 193.5,
      "end_seconds": 197.83,
      "duration_seconds": 4.33,
      "text": "No vomiting or pus, none of it."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 198.94,
      "end_seconds": 204.87,
      "duration_seconds": 5.93,
      "text": "Okay, any red streaks up the leg, chest pain or wound at all?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 206.16,
      "end_seconds": 209.48,
      "duration_seconds": 3.32,
      "text": "No, none of those at all."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 210.18,
      "end_seconds": 213.75,
      "duration_seconds": 3.57,
      "text": "Any pins and needles or loss of strength anywhere?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 217.36,
      "end_seconds": 218.99,
      "duration_seconds": 1.63,
      "text": "Nothing odd there."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 219.5,
      "end_seconds": 222.84,
      "duration_seconds": 3.34,
      "text": "Shall I check your blood pressure and pulse?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 236.77,
      "end_seconds": 239.55,
      "duration_seconds": 2.78,
      "text": "Bear with me while this finishes..."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 261.37,
      "end_seconds": 271.19,
      "duration_seconds": 9.82,
      "text": "Okay: BP is 108 over 67, pulse is 99 beats a minute, oxygen saturation is 98 percent, temp 39.2 degrees, respiratory rate 18."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 272.7,
      "end_seconds": 277.2,
      "duration_seconds": 4.5,
      "text": "Let me look at the area, I'll be gentle."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 278.8,
      "end_seconds": 281.04,
      "duration_seconds": 2.24,
      "text": "Hold that for a second."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 294.7,
      "end_seconds": 302.43,
      "duration_seconds": 7.73,
      "text": "There is a warm, red, tender patch about ten centimetres across on the right shin with mild swelling."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 306.1,
      "end_seconds": 308.32,
      "duration_seconds": 2.22,
      "text": "Okay, that's enough for me."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 324.73,
      "end_seconds": 334.5,
      "duration_seconds": 9.77,
      "text": "I want blood tests done, that's for skin infection. I'd rather check than guess, and this is the quickest way to know more."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 335.55,
      "end_seconds": 338.71,
      "duration_seconds": 3.16,
      "text": "The earliest is Friday, 11:30 am."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 340.56,
      "end_seconds": 349.93,
      "duration_seconds": 9.37,
      "text": "I'd like you to take flucloxacillin, 500 milligrams, four times a day, for seven days. You take it by mouth. It's for cellulitis."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 350.92,
      "end_seconds": 352.09,
      "duration_seconds": 1.17,
      "text": "Mm, alright."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 354.14,
      "end_seconds": 372.94,
      "duration_seconds": 18.8,
      "text": "Mark the edge of the redness with a pen and keep the leg raised when sitting. One warning sign to remember: the redness spreads quickly or you get a high fever. In that case don't wait. I'd like to see you again in two days."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 374.58,
      "end_seconds": 376.93,
      "duration_seconds": 2.35,
      "text": "That's fine with me."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 381.0,
      "end_seconds": 384.95,
      "duration_seconds": 3.95,
      "text": "Is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 386.66,
      "end_seconds": 390.46,
      "duration_seconds": 3.8,
      "text": "I mean, thank you, that's helpful."
    }
  ]
}