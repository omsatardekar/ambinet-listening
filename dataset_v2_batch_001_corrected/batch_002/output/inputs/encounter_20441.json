{
  "schema_version": "1.0",
  "encounter_id": "20441",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.23,
      "end_seconds": 3.47,
      "duration_seconds": 2.24,
      "text": "So, morning, come on through."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "FAMILY_MEMBER",
      "start_seconds": 5.14,
      "end_seconds": 15.09,
      "duration_seconds": 9.95,
      "text": "Sorry, what was I saying, doctor, I'll sit in if that's okay, I know what's been happening."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 16.23,
      "end_seconds": 22.1,
      "duration_seconds": 5.87,
      "text": "absolutely, come and sit beside them. Tell me what's brought you in"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "FAMILY_MEMBER",
      "start_seconds": 23.85,
      "end_seconds": 28.89,
      "duration_seconds": 5.04,
      "text": "We came cos of small blisters in a band."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 33.7,
      "end_seconds": 36.19,
      "duration_seconds": 2.49,
      "text": "Let me quickly check your readings."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 48.98,
      "end_seconds": 51.43,
      "duration_seconds": 2.45,
      "text": "Bear with me while this finishes..."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 73.1,
      "end_seconds": 84.71,
      "duration_seconds": 11.61,
      "text": "Okay: pressure 121 over 74, temp 38.3 degrees, respiratory rate 19. And oxygen saturation is 95 percent, heart rate 89. Since when exactly?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 86.21,
      "end_seconds": 89.8,
      "duration_seconds": 3.59,
      "text": "So, I've had it for three days."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 91.55,
      "end_seconds": 94.1,
      "duration_seconds": 2.55,
      "text": "Does anything else come with it?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 95.86,
      "end_seconds": 110.85,
      "duration_seconds": 14.99,
      "text": "When it starts I tend to get a headache as well. With headache, it happens all the time. I've, I've also been feeling feverish, for five days."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 111.61,
      "end_seconds": 118.73,
      "duration_seconds": 7.12,
      "text": "Okay, have you had small blisters in a band before, or is this the first time?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 119.65,
      "end_seconds": 126.93,
      "duration_seconds": 7.28,
      "text": "I had a similar thing about six months ago. It went away"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 138.62,
      "end_seconds": 143.22,
      "duration_seconds": 4.6,
      "text": "Did you get weakness, confusion or rash near the eye?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 144.53,
      "end_seconds": 146.64,
      "duration_seconds": 2.11,
      "text": "nope, nothing like that"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 147.79,
      "end_seconds": 154.78,
      "duration_seconds": 6.99,
      "text": "Did you get vision changes, contact with chickenpox or rash on the other side?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 156.22,
      "end_seconds": 160.05,
      "duration_seconds": 3.83,
      "text": "Erm, uh, nope, nothing like that."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 161.95,
      "end_seconds": 164.05,
      "duration_seconds": 2.1,
      "text": "Is your digestion otherwise okay?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 165.61,
      "end_seconds": 168.53,
      "duration_seconds": 2.92,
      "text": "Bowels are regular, nothing odd."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 176.06,
      "end_seconds": 180.11,
      "duration_seconds": 4.05,
      "text": "what do you take on a a normal day?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 182.05,
      "end_seconds": 192.63,
      "duration_seconds": 10.58,
      "text": "Well, I'm on hydrochlorothiazide, 12.5 milligrams, every morning. Thyroxine. I take it 75 micrograms, maybe, every morning."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 193.33,
      "end_seconds": 197.87,
      "duration_seconds": 4.54,
      "text": "did you happen to bring the box or the paperwork?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 198.83,
      "end_seconds": 203.54,
      "duration_seconds": 4.71,
      "text": "Not with me. I'll bring it next time."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 204.86,
      "end_seconds": 207.6,
      "duration_seconds": 2.74,
      "text": "Has anyone ever diagnosed you with something?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 209.15,
      "end_seconds": 218.19,
      "duration_seconds": 9.04,
      "text": "I, I have high blood pressure. Ah, I've had an underactive thyroid for about a year now."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 219.64,
      "end_seconds": 221.47,
      "duration_seconds": 1.83,
      "text": "I see, go ahead."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 223.44,
      "end_seconds": 225.58,
      "duration_seconds": 2.14,
      "text": "I've got thin bones."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 227.62,
      "end_seconds": 239.29,
      "duration_seconds": 11.67,
      "text": "I see, go ahead. Alright, high blood pressure, that matches what I have here. Has anything ever caused you a reaction? I mean any allergies."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 240.67,
      "end_seconds": 245.18,
      "duration_seconds": 4.51,
      "text": "okay, so no, I'm not allergic to anything"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "FAMILY_MEMBER",
      "start_seconds": 245.84,
      "end_seconds": 253.35,
      "duration_seconds": 7.51,
      "text": "Um, I'm not sure that's right. I seem to recall a problem with erythromycin."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 258.67,
      "end_seconds": 260.96,
      "duration_seconds": 2.29,
      "text": "I don't remember that."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 261.87,
      "end_seconds": 267.33,
      "duration_seconds": 5.46,
      "text": "fair enough, I'll write down both versions. Alright, any surgery in the past?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 268.33,
      "end_seconds": 276.95,
      "duration_seconds": 8.62,
      "text": "Sorry, what was I saying, yes, I had keyhole surgery on my gallbladder, two years back."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 293.22,
      "end_seconds": 294.64,
      "duration_seconds": 1.42,
      "text": "What about alcohol?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 295.73,
      "end_seconds": 299.97,
      "duration_seconds": 4.24,
      "text": "I'll have a glass of wine with dinner."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 301.45,
      "end_seconds": 303.83,
      "duration_seconds": 2.38,
      "text": "Tell me about your eating."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 305.81,
      "end_seconds": 311.84,
      "duration_seconds": 6.03,
      "text": "I drink a lot of tea and snack through the day."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 312.89,
      "end_seconds": 316.14,
      "duration_seconds": 3.25,
      "text": "Are you on your own at home?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 317.24,
      "end_seconds": 320.45,
      "duration_seconds": 3.21,
      "text": "I live with my elderly mother."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 321.45,
      "end_seconds": 324.28,
      "duration_seconds": 2.83,
      "text": "Anything you do to stay fit?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 325.28,
      "end_seconds": 329.31,
      "duration_seconds": 4.03,
      "text": "I do a yoga class on Thursdays."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 330.97,
      "end_seconds": 335.24,
      "duration_seconds": 4.27,
      "text": "any inherited conditions that you know of in the family?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 336.98,
      "end_seconds": 339.37,
      "duration_seconds": 2.39,
      "text": "my brother has epilepsy"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 340.57,
      "end_seconds": 342.98,
      "duration_seconds": 2.41,
      "text": "Shall I start the examination?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 348.71,
      "end_seconds": 350.59,
      "duration_seconds": 1.88,
      "text": "Yeah, no problem."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 351.41,
      "end_seconds": 353.64,
      "duration_seconds": 2.23,
      "text": "Tell me if that's sore."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 365.34,
      "end_seconds": 374.84,
      "duration_seconds": 9.5,
      "text": "There are clustered blisters on a red base in a band across the right side of the chest, not crossing the midline."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 379.69,
      "end_seconds": 388.59,
      "duration_seconds": 8.9,
      "text": "That's the examination finished. Putting it all together, this is probably shingles. I'd also keep a herpes simplex rash in mind."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 389.37,
      "end_seconds": 390.98,
      "duration_seconds": 1.61,
      "text": "Is this permanent?"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 394.28,
      "end_seconds": 429.95,
      "duration_seconds": 35.67,
      "text": "nothing I've seen today points to an emergency it looks like shingles, but I'd like to confirm i want a swab from a blister done, that's for vesicular rash i'd like you to take aciclovir, 800 milligrams, five times a day, for seven days you take it by mouth that's for shingles keep the rash clean and dry and avoid contact with pregnant women or newborns until the blisters crust over"
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 431.82,
      "end_seconds": 440.22,
      "duration_seconds": 8.4,
      "text": "And please bring the latest prescription or the medicine boxes to the next visit, so so we can settle the dose."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 441.32,
      "end_seconds": 444.95,
      "duration_seconds": 3.63,
      "text": "I, I know what to watch for"
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 446.69,
      "end_seconds": 449.91,
      "duration_seconds": 3.22,
      "text": "I think we're done unless you have questions"
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 450.83,
      "end_seconds": 455.9,
      "duration_seconds": 5.07,
      "text": "Erm, okay, that makes sense. Thanks for explaining."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 456.76,
      "end_seconds": 457.96,
      "duration_seconds": 1.2,
      "text": "See you soon."
    }
  ]
}