{
  "schema_version": "1.0",
  "encounter_id": "20201",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.68,
      "end_seconds": 4.15,
      "duration_seconds": 3.47,
      "text": "Hello, doctor. I think it's my turn."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 4.92,
      "end_seconds": 9.8,
      "duration_seconds": 4.88,
      "text": "You're alright, take a seat. What can I do for you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 10.43,
      "end_seconds": 16.09,
      "duration_seconds": 5.66,
      "text": "It's pins and needles in my hands and feet, mostly."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 16.94,
      "end_seconds": 19.78,
      "duration_seconds": 2.84,
      "text": "Let me take your readings now."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 30.78,
      "end_seconds": 32.97,
      "duration_seconds": 2.19,
      "text": "Sit still for a moment..."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 42.99,
      "end_seconds": 51.26,
      "duration_seconds": 8.27,
      "text": "Okay: temperature is 36.8 degrees, SpO2 97 percent on room air, BP is 119 over 78, heart rate 70."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 52.64,
      "end_seconds": 55.54,
      "duration_seconds": 2.9,
      "text": "Uh, is that alright, doctor?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 56.6,
      "end_seconds": 62.47,
      "duration_seconds": 5.87,
      "text": "I'll come back to the numbers. Has this been going on for long?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 63.44,
      "end_seconds": 72.53,
      "duration_seconds": 9.09,
      "text": "I've had it for about three months. I didn't want to make a fuss, you know."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 73.15,
      "end_seconds": 76.61,
      "duration_seconds": 3.46,
      "text": "Okay, is it constant or in episodes?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 77.77,
      "end_seconds": 80.23,
      "duration_seconds": 2.46,
      "text": "It happens on and off."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 82.13,
      "end_seconds": 84.72,
      "duration_seconds": 2.59,
      "text": "Does anything else come with it?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 86.61,
      "end_seconds": 97.06,
      "duration_seconds": 10.45,
      "text": "When it starts I tend to get a sore tongue as well. The sore tongue? That's been for two years."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 98.26,
      "end_seconds": 103.93,
      "duration_seconds": 5.67,
      "text": "Let me check a few things. Any weight loss, rash or diarrhoea?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 108.58,
      "end_seconds": 111.36,
      "duration_seconds": 2.78,
      "text": "No, not a single one."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 112.8,
      "end_seconds": 114.15,
      "duration_seconds": 1.35,
      "text": "Any bladder problems?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 115.63,
      "end_seconds": 117.86,
      "duration_seconds": 2.23,
      "text": "No bladder problems, thankfully."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 119.01,
      "end_seconds": 121.48,
      "duration_seconds": 2.47,
      "text": "How are your bowels, any trouble?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 122.25,
      "end_seconds": 124.66,
      "duration_seconds": 2.41,
      "text": "Nothing unusual, um, no."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 126.36,
      "end_seconds": 128.19,
      "duration_seconds": 1.83,
      "text": "How's your breathing otherwise?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 129.74,
      "end_seconds": 131.87,
      "duration_seconds": 2.13,
      "text": "No problems with breathing."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 132.8,
      "end_seconds": 136.34,
      "duration_seconds": 3.54,
      "text": "Which medicines do you take at the moment?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 136.92,
      "end_seconds": 140.62,
      "duration_seconds": 3.7,
      "text": "I take glibenclamide, 5 milligrams, before breakfast."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 149.29,
      "end_seconds": 152.65,
      "duration_seconds": 3.36,
      "text": "A few questions about your lifestyle now."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 154.5,
      "end_seconds": 167.21,
      "duration_seconds": 12.71,
      "text": "No, I share a house with my brother. I do a yoga class on Thursdays. I drink a lot of tea and snack through the day."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 176.91,
      "end_seconds": 180.17,
      "duration_seconds": 3.26,
      "text": "Any health conditions I should have on record?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 180.92,
      "end_seconds": 182.57,
      "duration_seconds": 1.65,
      "text": "I've got diabetes."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 183.88,
      "end_seconds": 184.58,
      "duration_seconds": 0.7,
      "text": "Yes."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 193.53,
      "end_seconds": 197.15,
      "duration_seconds": 3.62,
      "text": "Has anyone in your family had anything serious?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 198.88,
      "end_seconds": 200.83,
      "duration_seconds": 1.95,
      "text": "My grandmother had dementia."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 218.94,
      "end_seconds": 223.52,
      "duration_seconds": 4.58,
      "text": "Are you allergic to anything? Any allergies to medicines or foods?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 224.87,
      "end_seconds": 231.74,
      "duration_seconds": 6.87,
      "text": "Years back I got a rash from erythromycin, so I stay away from it now."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 234.18,
      "end_seconds": 238.37,
      "duration_seconds": 4.19,
      "text": "I'll examine you in a second, make yourself comfortable."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 240.02,
      "end_seconds": 241.22,
      "duration_seconds": 1.2,
      "text": "Look straight ahead."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 249.62,
      "end_seconds": 252.46,
      "duration_seconds": 2.84,
      "text": "The tongue looks smooth and red."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 254.33,
      "end_seconds": 256.44,
      "duration_seconds": 2.11,
      "text": "Raise your arm for me."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 267.59,
      "end_seconds": 270.98,
      "duration_seconds": 3.39,
      "text": "Your vibration sense is reduced at the ankles."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 274.0,
      "end_seconds": 283.53,
      "duration_seconds": 9.53,
      "text": "Right, please sit back down. Having listened and examined, this is probably symptoms that fit a vitamin B12 deficiency."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 284.34,
      "end_seconds": 287.75,
      "duration_seconds": 3.41,
      "text": "Hmm, is it dangerous, doctor?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 288.52,
      "end_seconds": 319.21,
      "duration_seconds": 30.69,
      "text": "I understand the worry. At the moment I'd say it's symptoms that fit a vitamin B12 deficiency, and we'll know more once the a thyroid test is back. I'm going to order a thyroid test, for tiredness. The result will help us decide whether anything more is needed. For this, cyanocobalamin, 1000 micrograms, every other day, for two weeks. It's for low vitamin B12. Eating more eggs, dairy and fortified cereals will help over time."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 323.26,
      "end_seconds": 332.68,
      "duration_seconds": 9.42,
      "text": "Please come and see me after the results are back. Okay, is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 333.77,
      "end_seconds": 337.38,
      "duration_seconds": 3.61,
      "text": "Okay, that makes sense. Thanks for explaining."
    }
  ]
}