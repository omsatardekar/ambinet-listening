{
  "schema_version": "1.0",
  "encounter_id": "20042",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.98,
      "end_seconds": 4.44,
      "duration_seconds": 3.46,
      "text": "Morning, doctor. Lovely to meet you."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.35,
      "end_seconds": 8.88,
      "duration_seconds": 3.53,
      "text": "Come in. Please sit. How can I help you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 9.53,
      "end_seconds": 15.14,
      "duration_seconds": 5.61,
      "text": "It's heavy periods. I thought I'd wait, but it hasn't gone."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 16.06,
      "end_seconds": 19.88,
      "duration_seconds": 3.82,
      "text": "Can you tell me when it first started?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 21.39,
      "end_seconds": 24.6,
      "duration_seconds": 3.21,
      "text": "For nearly five years, I'd say."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 29.16,
      "end_seconds": 34.28,
      "duration_seconds": 5.12,
      "text": "What about being breathless on the stairs, have you noticed that?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 35.99,
      "end_seconds": 37.72,
      "duration_seconds": 1.73,
      "text": "Yes, I have."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 38.53,
      "end_seconds": 42.74,
      "duration_seconds": 4.21,
      "text": "Any pelvic pain, chest pain or fainting at all?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 44.13,
      "end_seconds": 48.34,
      "duration_seconds": 4.21,
      "text": "No, uh, I haven't had any of them."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 49.6,
      "end_seconds": 53.32,
      "duration_seconds": 3.72,
      "text": "Anything on the skin I should know about?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 56.96,
      "end_seconds": 58.0,
      "duration_seconds": 1.04,
      "text": "Skin's normal."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 58.61,
      "end_seconds": 61.93,
      "duration_seconds": 3.32,
      "text": "Any muscle or joint problems besides this?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 63.97,
      "end_seconds": 66.18,
      "duration_seconds": 2.21,
      "text": "I move fine otherwise."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 67.92,
      "end_seconds": 71.92,
      "duration_seconds": 4.0,
      "text": "Right, has anyone ever diagnosed you with something?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 73.83,
      "end_seconds": 80.58,
      "duration_seconds": 6.75,
      "text": "I've had heart failure, yes. I told my wife I'd come today."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 81.76,
      "end_seconds": 88.42,
      "duration_seconds": 6.66,
      "text": "Right, so heart failure is already on your record. We'll keep that in mind today."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 95.59,
      "end_seconds": 98.95,
      "duration_seconds": 3.36,
      "text": "Which medicines do you take at the moment?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 102.57,
      "end_seconds": 111.07,
      "duration_seconds": 8.5,
      "text": "Carvedilol, 6.25 milligrams, twice a day. Well, though honestly, some days I forget to take it."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 113.1,
      "end_seconds": 117.26,
      "duration_seconds": 4.16,
      "text": "Are there any allergies I should be aware of?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 118.43,
      "end_seconds": 121.95,
      "duration_seconds": 3.52,
      "text": "Mm, no, I've never reacted to anything."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 123.44,
      "end_seconds": 126.38,
      "duration_seconds": 2.94,
      "text": "Did you ever have any procedures done?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 132.34,
      "end_seconds": 138.97,
      "duration_seconds": 6.63,
      "text": "I had a mole taken off my arm a few years ago."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 140.55,
      "end_seconds": 142.89,
      "duration_seconds": 2.34,
      "text": "Is there someone at home?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 144.85,
      "end_seconds": 148.49,
      "duration_seconds": 3.64,
      "text": "My husband and I live above the shop."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 149.57,
      "end_seconds": 152.77,
      "duration_seconds": 3.2,
      "text": "What line of work are you in?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 153.95,
      "end_seconds": 159.05,
      "duration_seconds": 5.1,
      "text": "I'm a bus driver, so I sit for long hours."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 166.13,
      "end_seconds": 169.11,
      "duration_seconds": 2.98,
      "text": "Right, I'll do your observations first."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 179.01,
      "end_seconds": 181.14,
      "duration_seconds": 2.13,
      "text": "Nearly done with the readings..."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 191.03,
      "end_seconds": 196.86,
      "duration_seconds": 5.83,
      "text": "Okay: temp 36.9 degrees, blood pressure 115 over 68, pulse 68."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 201.22,
      "end_seconds": 202.61,
      "duration_seconds": 1.39,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 203.35,
      "end_seconds": 206.06,
      "duration_seconds": 2.71,
      "text": "I'll come back to the numbers."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 208.29,
      "end_seconds": 210.45,
      "duration_seconds": 2.16,
      "text": "May I examine you now?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 211.1,
      "end_seconds": 212.61,
      "duration_seconds": 1.51,
      "text": "Fine by me."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 213.78,
      "end_seconds": 215.76,
      "duration_seconds": 1.98,
      "text": "Tell me if that's sore."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 232.38,
      "end_seconds": 236.54,
      "duration_seconds": 4.16,
      "text": "Your eyelids and the palms of your hands look pale."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 242.26,
      "end_seconds": 244.76,
      "duration_seconds": 2.5,
      "text": "That's all I needed to check."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 258.34,
      "end_seconds": 277.82,
      "duration_seconds": 19.48,
      "text": "Okay, thinking it through, I can't pin this down yet. We're looking at heavy periods with iron deficiency or fibroids. I want a ferritin level done, that's for iron deficiency. I think a blood count makes sense here, for heavy periods."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 279.16,
      "end_seconds": 280.71,
      "duration_seconds": 1.55,
      "text": "That makes sense."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 282.02,
      "end_seconds": 292.72,
      "duration_seconds": 10.7,
      "text": "We'll begin with tranexamic acid, 1 gram, three times a day during periods, for four days each cycle. That should help with heavy periods."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 294.59,
      "end_seconds": 296.24,
      "duration_seconds": 1.65,
      "text": "Thank you, doctor."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 297.18,
      "end_seconds": 316.62,
      "duration_seconds": 19.44,
      "text": "Iron can darken the stools and bother the stomach, so take it after food. Don't skip meals, and try to eat smaller portions more often through the day. The gynaecology clinic would be the right next step, I'll refer you. Come back in six weeks."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 317.4,
      "end_seconds": 321.33,
      "duration_seconds": 3.93,
      "text": "I'll book it on my way out."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 322.25,
      "end_seconds": 325.03,
      "duration_seconds": 2.78,
      "text": "Have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 329.42,
      "end_seconds": 333.6,
      "duration_seconds": 4.18,
      "text": "Um, great, thank you for your help."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 334.61,
      "end_seconds": 335.78,
      "duration_seconds": 1.17,
      "text": "See you soon."
    }
  ]
}