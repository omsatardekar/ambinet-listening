{
  "schema_version": "1.0",
  "encounter_id": "20197",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 1.09,
      "end_seconds": 8.77,
      "duration_seconds": 7.68,
      "text": "Doctor, I've checked them in and done the preliminary measurements, I'll hand them over when you ask."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 10.05,
      "end_seconds": 15.67,
      "duration_seconds": 5.62,
      "text": "Thanks. Hello, come in, sit down. What brings you in today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 19.62,
      "end_seconds": 28.81,
      "duration_seconds": 9.19,
      "text": "Mainly pain in my right ear. There's a couple of other things, but that's the main one."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 29.35,
      "end_seconds": 31.06,
      "duration_seconds": 1.71,
      "text": "When did this begin?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 32.27,
      "end_seconds": 36.12,
      "duration_seconds": 3.85,
      "text": "It's been going on for two weeks."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 37.13,
      "end_seconds": 45.15,
      "duration_seconds": 8.02,
      "text": "Can you describe it a bit more for me? How strong it is, what the pattern is, what helps."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 46.0,
      "end_seconds": 53.0,
      "duration_seconds": 7.0,
      "text": "Only a warm cloth, and it's not much. Severe, really. It comes and goes."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 53.77,
      "end_seconds": 57.54,
      "duration_seconds": 3.77,
      "text": "Okay, have you had a discharge from the ear?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 58.45,
      "end_seconds": 61.56,
      "duration_seconds": 3.11,
      "text": "Yes, about the same, five days."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 78.41,
      "end_seconds": 83.39,
      "duration_seconds": 4.98,
      "text": "Have you had any swelling behind the ear, dizziness or facial weakness?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 85.08,
      "end_seconds": 91.13,
      "duration_seconds": 6.05,
      "text": "No, uh, no swelling behind the ear, dizziness or facial weakness."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 92.73,
      "end_seconds": 97.15,
      "duration_seconds": 4.42,
      "text": "Any fever or ringing in the ear at all?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 99.14,
      "end_seconds": 103.82,
      "duration_seconds": 4.68,
      "text": "I haven't had fever or ringing in the ear, no."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 109.94,
      "end_seconds": 113.71,
      "duration_seconds": 3.77,
      "text": "What about your tummy and bowels, anything unusual there?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 115.07,
      "end_seconds": 116.57,
      "duration_seconds": 1.5,
      "text": "Nothing unusual, no."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 118.07,
      "end_seconds": 122.23,
      "duration_seconds": 4.16,
      "text": "What conditions have you been treated for in the past?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 124.09,
      "end_seconds": 125.46,
      "duration_seconds": 1.37,
      "text": "I have diabetes."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 126.17,
      "end_seconds": 133.61,
      "duration_seconds": 7.44,
      "text": "Alright, diabetes, that matches what I have here. What operations have you had, if any?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 134.22,
      "end_seconds": 139.82,
      "duration_seconds": 5.6,
      "text": "I had a meniscus repair on my knee four years ago."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 140.92,
      "end_seconds": 142.22,
      "duration_seconds": 1.3,
      "text": "Are you active?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 143.18,
      "end_seconds": 146.02,
      "duration_seconds": 2.84,
      "text": "I walk the dog every morning."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 146.84,
      "end_seconds": 148.05,
      "duration_seconds": 1.21,
      "text": "And your job?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 149.09,
      "end_seconds": 152.33,
      "duration_seconds": 3.24,
      "text": "I work in accounts at a hospital."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 164.35,
      "end_seconds": 167.51,
      "duration_seconds": 3.16,
      "text": "Do you take any prescribed or over-the-counter medicines?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 173.8,
      "end_seconds": 177.58,
      "duration_seconds": 3.78,
      "text": "I take glibenclamide, 5 milligrams, before breakfast."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 179.08,
      "end_seconds": 181.67,
      "duration_seconds": 2.59,
      "text": "Before we go further, any allergies?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 183.53,
      "end_seconds": 185.9,
      "duration_seconds": 2.37,
      "text": "Not to my knowledge, no."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 186.94,
      "end_seconds": 195.81,
      "duration_seconds": 8.87,
      "text": "Here are the numbers, doctor. SpO2 98 percent on room air, BP is 117 over 81, heart rate 74."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 197.14,
      "end_seconds": 197.84,
      "duration_seconds": 0.7,
      "text": "Thanks."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 199.96,
      "end_seconds": 203.39,
      "duration_seconds": 3.43,
      "text": "Could you come over to the couch, please?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 204.36,
      "end_seconds": 205.06,
      "duration_seconds": 0.7,
      "text": "Right."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 205.97,
      "end_seconds": 208.2,
      "duration_seconds": 2.23,
      "text": "I'm just checking this side."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 222.59,
      "end_seconds": 230.18,
      "duration_seconds": 7.59,
      "text": "The ear canal is red and swollen with some debris, and it's painful when I pull the ear."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 236.05,
      "end_seconds": 246.54,
      "duration_seconds": 10.49,
      "text": "Please sit back down. So, based on the history and the examination, I think we're dealing with an outer ear canal infection at this stage."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 254.74,
      "end_seconds": 284.76,
      "duration_seconds": 30.02,
      "text": "I'll start you on antibiotic and steroid ear drops, 3 drops, twice a day, for seven days. That should help with ear canal infection. Keep the ear dry, no swimming, and don't poke anything into it. The thing that would worry me is if the ear swells or you get dizzy or feverish. If that happens, go to emergency. Let's plan a check in a week."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 286.64,
      "end_seconds": 289.42,
      "duration_seconds": 2.78,
      "text": "I'll note it in my calendar."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 295.51,
      "end_seconds": 299.1,
      "duration_seconds": 3.59,
      "text": "Anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 299.79,
      "end_seconds": 302.08,
      "duration_seconds": 2.29,
      "text": "Thank you, that's helpful."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 303.2,
      "end_seconds": 304.61,
      "duration_seconds": 1.41,
      "text": "Goodbye for now."
    }
  ]
}