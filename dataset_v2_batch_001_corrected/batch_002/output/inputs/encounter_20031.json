{
  "schema_version": "1.0",
  "encounter_id": "20031",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.56,
      "end_seconds": 4.92,
      "duration_seconds": 4.36,
      "text": "Doctor? Hello, I hope this is the right time."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.27,
      "end_seconds": 10.71,
      "duration_seconds": 4.44,
      "text": "That's fine, sit down. Tell me why you came."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 12.2,
      "end_seconds": 17.16,
      "duration_seconds": 4.96,
      "text": "Um, I'm here because of a dry tickly cough."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 18.79,
      "end_seconds": 22.28,
      "duration_seconds": 3.49,
      "text": "What's the timeline, when did it begin?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 23.22,
      "end_seconds": 30.38,
      "duration_seconds": 7.16,
      "text": "Nearly five years, I think... sorry, about a year, I got that wrong."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 31.73,
      "end_seconds": 37.4,
      "duration_seconds": 5.67,
      "text": "Okay, give me more detail on it, whatever comes to mind."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 38.17,
      "end_seconds": 46.03,
      "duration_seconds": 7.86,
      "text": "Pretty mild, if I'm being honest. I get some relief from sips of water."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 61.52,
      "end_seconds": 64.34,
      "duration_seconds": 2.82,
      "text": "Have you got any known allergies?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 65.71,
      "end_seconds": 70.26,
      "duration_seconds": 4.55,
      "text": "Naproxen. I come out in... well, a rash."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 72.32,
      "end_seconds": 75.13,
      "duration_seconds": 2.81,
      "text": "Do you have any long-term conditions?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 76.25,
      "end_seconds": 79.49,
      "duration_seconds": 3.24,
      "text": "I've had high blood pressure, yes."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 80.18,
      "end_seconds": 87.91,
      "duration_seconds": 7.73,
      "text": "Right, so high blood pressure is already on your record. We'll keep that in mind today."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 98.16,
      "end_seconds": 101.12,
      "duration_seconds": 2.96,
      "text": "What's on your current medicine list?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 101.79,
      "end_seconds": 112.14,
      "duration_seconds": 10.35,
      "text": "I take ramipril, 5 milligrams, every morning. I told myself I'd wait and see, and here I am."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 129.17,
      "end_seconds": 130.76,
      "duration_seconds": 1.59,
      "text": "Do you drink alcohol?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 131.42,
      "end_seconds": 136.57,
      "duration_seconds": 5.15,
      "text": "I used to drink heavily but I stopped four years ago."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 137.4,
      "end_seconds": 138.59,
      "duration_seconds": 1.19,
      "text": "Are you active?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 139.9,
      "end_seconds": 143.21,
      "duration_seconds": 3.31,
      "text": "I walk the dog every morning."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 145.24,
      "end_seconds": 148.67,
      "duration_seconds": 3.43,
      "text": "What do you do during the day?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 149.36,
      "end_seconds": 153.31,
      "duration_seconds": 3.95,
      "text": "I look after my grandchildren most days."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 154.0,
      "end_seconds": 156.93,
      "duration_seconds": 2.93,
      "text": "Any fever, coughing up blood or heartburn?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 158.18,
      "end_seconds": 160.94,
      "duration_seconds": 2.76,
      "text": "No, I'd have said so."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 161.2,
      "end_seconds": 164.55,
      "duration_seconds": 3.35,
      "text": "Understood. How are your bowels, any trouble?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 165.56,
      "end_seconds": 169.11,
      "duration_seconds": 3.55,
      "text": "Well, bowels are regular, nothing odd."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 170.83,
      "end_seconds": 174.17,
      "duration_seconds": 3.34,
      "text": "Any problems with your joints or muscles?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 176.07,
      "end_seconds": 178.06,
      "duration_seconds": 1.99,
      "text": "No, joints are fine."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 178.8,
      "end_seconds": 182.08,
      "duration_seconds": 3.28,
      "text": "Shall I check your blood pressure and pulse?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 190.23,
      "end_seconds": 192.81,
      "duration_seconds": 2.58,
      "text": "Bear with me while this finishes..."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 205.13,
      "end_seconds": 215.9,
      "duration_seconds": 10.77,
      "text": "Okay: respiratory rate 18, pulse is 76 beats a minute, temperature is 36.8 degrees, SpO2 97 percent on room air, BP is 123 over 74."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 218.44,
      "end_seconds": 222.12,
      "duration_seconds": 3.68,
      "text": "I'll examine you in a second, make yourself comfortable."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 222.9,
      "end_seconds": 224.59,
      "duration_seconds": 1.69,
      "text": "Fine by me."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 225.7,
      "end_seconds": 228.14,
      "duration_seconds": 2.44,
      "text": "Raise your arm for me."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 246.33,
      "end_seconds": 250.28,
      "duration_seconds": 3.95,
      "text": "Your chest is clear and there is no wheeze."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 254.44,
      "end_seconds": 264.89,
      "duration_seconds": 10.45,
      "text": "All finished, thank you. Putting it all together, this is probably a persistent dry cough without a clear cause so far."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 266.36,
      "end_seconds": 268.46,
      "duration_seconds": 2.1,
      "text": "Is this serious, doctor?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 270.73,
      "end_seconds": 282.65,
      "duration_seconds": 11.92,
      "text": "I understand the worry. At the moment I'd say it's a persistent dry cough without a clear cause so far, and we'll watch how it goes."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 298.43,
      "end_seconds": 307.34,
      "duration_seconds": 8.91,
      "text": "For now, no new medicines or tests are needed. Is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 308.62,
      "end_seconds": 311.85,
      "duration_seconds": 3.23,
      "text": "Great, thank you for your help."
    }
  ]
}