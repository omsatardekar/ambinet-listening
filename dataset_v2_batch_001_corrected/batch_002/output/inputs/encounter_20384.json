{
  "schema_version": "1.0",
  "encounter_id": "20384",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.19,
      "end_seconds": 5.06,
      "duration_seconds": 3.87,
      "text": "Come in, have a seat by the desk."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 6.23,
      "end_seconds": 12.98,
      "duration_seconds": 6.75,
      "text": "Hi doctor, uh, I got here as fast as I could."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 14.25,
      "end_seconds": 17.48,
      "duration_seconds": 3.23,
      "text": "Is this your first time with this clinic?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 18.06,
      "end_seconds": 23.93,
      "duration_seconds": 5.87,
      "text": "Mm, first time with this one, yes. A friend recommended it."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 25.49,
      "end_seconds": 27.51,
      "duration_seconds": 2.02,
      "text": "Right, what's the problem?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 29.01,
      "end_seconds": 34.26,
      "duration_seconds": 5.25,
      "text": "Mm, so the thing is, I've got loud snoring."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 34.5,
      "end_seconds": 40.45,
      "duration_seconds": 5.95,
      "text": "Yes, carry on. Has there been your partner noticing pauses in your breathing too?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 41.46,
      "end_seconds": 43.85,
      "duration_seconds": 2.39,
      "text": "Yes, for six months."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 45.12,
      "end_seconds": 48.37,
      "duration_seconds": 3.25,
      "text": "Have you been feeling sleepy during the day?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 50.23,
      "end_seconds": 66.57,
      "duration_seconds": 16.34,
      "text": "Yes, uh, for about a month. Right, about feeling sleepy during the day, yes, afternoons. That makes it worse. I get some relief from a short nap."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 83.55,
      "end_seconds": 86.1,
      "duration_seconds": 2.55,
      "text": "What's on your current medicine list?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 88.2,
      "end_seconds": 91.85,
      "duration_seconds": 3.65,
      "text": "Sitagliptin, 100 milligrams, once a day."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 92.43,
      "end_seconds": 94.48,
      "duration_seconds": 2.05,
      "text": "I see, go ahead."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 96.38,
      "end_seconds": 103.14,
      "duration_seconds": 6.76,
      "text": "Ah, I'd been on glibenclamide, not any more though, I stopped."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 104.87,
      "end_seconds": 108.04,
      "duration_seconds": 3.17,
      "text": "Did you ever have any procedures done?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 108.66,
      "end_seconds": 116.89,
      "duration_seconds": 8.23,
      "text": "Let me think, you know, yes, I had my tonsils removed, as a teenager."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 118.59,
      "end_seconds": 122.6,
      "duration_seconds": 4.01,
      "text": "Let's talk a little about your daily life and habits."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 123.88,
      "end_seconds": 140.35,
      "duration_seconds": 16.47,
      "text": "I smoke roughly a pack every two days. I only drink at family occasions. I'm a hairdresser, on my feet all day. I drink a lot of tea and snack through the day."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 145.63,
      "end_seconds": 148.37,
      "duration_seconds": 2.74,
      "text": "Has anyone ever diagnosed you with something?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 151.85,
      "end_seconds": 158.33,
      "duration_seconds": 6.48,
      "text": "Diabetes, for nearly five years. Sorry, I know I'm rambling a bit."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 159.61,
      "end_seconds": 162.34,
      "duration_seconds": 2.73,
      "text": "Right, and anything else to add?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 163.98,
      "end_seconds": 166.09,
      "duration_seconds": 2.11,
      "text": "Yes, high blood pressure."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 176.36,
      "end_seconds": 178.96,
      "duration_seconds": 2.6,
      "text": "Before we go further, any allergies?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 180.51,
      "end_seconds": 184.96,
      "duration_seconds": 4.45,
      "text": "Um, you know, no allergies at all."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 186.59,
      "end_seconds": 190.84,
      "duration_seconds": 4.25,
      "text": "Did you get palpitations, choking at night or leg swelling?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 192.1,
      "end_seconds": 199.45,
      "duration_seconds": 7.35,
      "text": "Right, I haven't had palpitations, choking at night or leg swelling, no."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 201.19,
      "end_seconds": 204.23,
      "duration_seconds": 3.04,
      "text": "Right, and your skin, any changes there?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 205.67,
      "end_seconds": 209.51,
      "duration_seconds": 3.84,
      "text": "Right, you know, no, skin's been fine."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 211.01,
      "end_seconds": 213.48,
      "duration_seconds": 2.47,
      "text": "Let's start with the basic checks."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 227.37,
      "end_seconds": 229.52,
      "duration_seconds": 2.15,
      "text": "Sit still for a moment..."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 243.3,
      "end_seconds": 253.29,
      "duration_seconds": 9.99,
      "text": "Okay: SpO2 98 percent on room air, blood pressure 151 over 104, respiratory rate 18, pulse is 73 beats a minute, temperature 36.5."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 255.22,
      "end_seconds": 258.3,
      "duration_seconds": 3.08,
      "text": "Erm, is that alright, doctor?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 258.9,
      "end_seconds": 261.35,
      "duration_seconds": 2.45,
      "text": "We'll go over that shortly."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 263.64,
      "end_seconds": 267.15,
      "duration_seconds": 3.51,
      "text": "Now I'm going to do a short physical check."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 268.58,
      "end_seconds": 271.2,
      "duration_seconds": 2.62,
      "text": "Yes, uh, that's fine."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 272.77,
      "end_seconds": 274.14,
      "duration_seconds": 1.37,
      "text": "Does that hurt?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 291.77,
      "end_seconds": 296.87,
      "duration_seconds": 5.1,
      "text": "Your neck is thick and the back of the throat looks crowded."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 302.15,
      "end_seconds": 304.04,
      "duration_seconds": 1.89,
      "text": "All finished, thank you."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 321.97,
      "end_seconds": 332.81,
      "duration_seconds": 10.84,
      "text": "So where does that leave us? This is probably symptoms that suggest obstructive sleep apnoea. It could also be an under-active thyroid, so we'll keep that open."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 334.78,
      "end_seconds": 338.65,
      "duration_seconds": 3.87,
      "text": "Yeah, um, is this serious, doctor?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 339.18,
      "end_seconds": 366.47,
      "duration_seconds": 27.29,
      "text": "It's reasonable to be concerned, but right now symptoms that suggest obstructive sleep apnoea is my leading thought, not anything worse. Let's get a thyroid test, for tiredness. Try to sleep on your side and avoid alcohol close to bedtime. Come back or go to emergency straight away if you feel sleepy while driving. I'll want another look in six weeks. Have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 368.32,
      "end_seconds": 374.88,
      "duration_seconds": 6.56,
      "text": "Sorry, what was I saying, great, thank you for your help."
    }
  ]
}