{
  "schema_version": "1.0",
  "encounter_id": "20473",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.19,
      "end_seconds": 5.55,
      "duration_seconds": 4.36,
      "text": "Hi, is it okay to come in now?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.13,
      "end_seconds": 11.59,
      "duration_seconds": 5.46,
      "text": "You're alright, take a seat. What can I do for you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 13.51,
      "end_seconds": 18.44,
      "duration_seconds": 4.93,
      "text": "Well, I've been having a high fever with shaking chills."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 19.22,
      "end_seconds": 22.36,
      "duration_seconds": 3.14,
      "text": "How long has this been bothering you?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 23.71,
      "end_seconds": 27.17,
      "duration_seconds": 3.46,
      "text": "It's been ten days, I'm fairly sure."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 28.91,
      "end_seconds": 37.95,
      "duration_seconds": 9.04,
      "text": "Can you describe it a bit more for me? How strong it is, what the pattern is, what helps."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 39.27,
      "end_seconds": 58.63,
      "duration_seconds": 19.36,
      "text": "It settles a little with paracetamol. I'd say on and off. So, and I've been feeling sick as well, for about four days. I've also been sweating a lot. I had muscle aches before. That's settled now, though."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 59.34,
      "end_seconds": 66.43,
      "duration_seconds": 7.09,
      "text": "Have you had a high fever with shaking chills before, or is this the first time?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 67.91,
      "end_seconds": 74.19,
      "duration_seconds": 6.28,
      "text": "A bit, a couple of years ago. It settled by itself back then."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 75.55,
      "end_seconds": 79.18,
      "duration_seconds": 3.63,
      "text": "Shall I check your blood pressure and pulse?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 92.39,
      "end_seconds": 95.1,
      "duration_seconds": 2.71,
      "text": "That's it, just a little longer..."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 108.79,
      "end_seconds": 117.0,
      "duration_seconds": 8.21,
      "text": "Okay: respiratory rate 21, pressure 119 over 70, SpO2 98 percent on room air, pulse is 108 beats a minute."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 122.17,
      "end_seconds": 123.66,
      "duration_seconds": 1.49,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 125.45,
      "end_seconds": 128.84,
      "duration_seconds": 3.39,
      "text": "I'll explain what these mean in a moment."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 129.88,
      "end_seconds": 133.84,
      "duration_seconds": 3.96,
      "text": "I'll examine you in a second, make yourself comfortable."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 136.74,
      "end_seconds": 137.77,
      "duration_seconds": 1.03,
      "text": "Of course."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 139.3,
      "end_seconds": 140.86,
      "duration_seconds": 1.56,
      "text": "Let me feel here."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 153.43,
      "end_seconds": 158.05,
      "duration_seconds": 4.62,
      "text": "The spleen tip is just palpable and the chest is clear."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 162.37,
      "end_seconds": 168.21,
      "duration_seconds": 5.84,
      "text": "You can relax now. Have you had any rash, yellow eyes or confusion?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 168.75,
      "end_seconds": 174.07,
      "duration_seconds": 5.32,
      "text": "No rash, yellow eyes or confusion, none of it."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 174.99,
      "end_seconds": 179.52,
      "duration_seconds": 4.53,
      "text": "Right, and what about diarrhoea, cough or neck stiffness?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 185.55,
      "end_seconds": 188.09,
      "duration_seconds": 2.54,
      "text": "No, not a single one."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 189.84,
      "end_seconds": 192.41,
      "duration_seconds": 2.57,
      "text": "Is your urine normal, no changes?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 193.95,
      "end_seconds": 195.58,
      "duration_seconds": 1.63,
      "text": "No changes there."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 197.32,
      "end_seconds": 202.78,
      "duration_seconds": 5.46,
      "text": "Tell me about your routine, work, habits, that sort of thing."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 203.4,
      "end_seconds": 215.05,
      "duration_seconds": 11.65,
      "text": "My partner and our baby. I grab fast food at lunch most days. Not much, I mostly stay in these days."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 229.85,
      "end_seconds": 232.26,
      "duration_seconds": 2.41,
      "text": "Tell me your medicines, please."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 234.13,
      "end_seconds": 237.64,
      "duration_seconds": 3.51,
      "text": "Sertraline. I take it once a day."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 238.22,
      "end_seconds": 240.23,
      "duration_seconds": 2.01,
      "text": "Do you know the dose?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 241.65,
      "end_seconds": 248.45,
      "duration_seconds": 6.8,
      "text": "It's 50 milligrams. Dolo. I take it 650 milligrams, when I get the fever."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 249.51,
      "end_seconds": 251.84,
      "duration_seconds": 2.33,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 252.76,
      "end_seconds": 255.88,
      "duration_seconds": 3.12,
      "text": "No, I've never been operated on."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 257.66,
      "end_seconds": 262.36,
      "duration_seconds": 4.7,
      "text": "Do you react to any medicines or foods? Any allergies?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 263.66,
      "end_seconds": 266.13,
      "duration_seconds": 2.47,
      "text": "Yes, I'm allergic to nickel."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 284.56,
      "end_seconds": 288.6,
      "duration_seconds": 4.04,
      "text": "Anything in your past medical history I should know?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 289.34,
      "end_seconds": 291.51,
      "duration_seconds": 2.17,
      "text": "Depression, for five years."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 299.01,
      "end_seconds": 309.03,
      "duration_seconds": 10.02,
      "text": "Okay, so my impression is this: It points towards a fever after travel that must be treated as possible malaria. Typhoid fever is still possible."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 310.05,
      "end_seconds": 313.12,
      "duration_seconds": 3.07,
      "text": "What are the odds it's serious?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 314.78,
      "end_seconds": 332.08,
      "duration_seconds": 17.3,
      "text": "Nothing I've seen today points to an emergency. It looks like a fever after travel that must be treated as possible malaria, but I'd like to confirm. I'm going to order blood cultures, for fever."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 333.91,
      "end_seconds": 336.29,
      "duration_seconds": 2.38,
      "text": "When would that take place?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 337.31,
      "end_seconds": 351.44,
      "duration_seconds": 14.13,
      "text": "Blood tests is what I'd like next, for fever. Avoid anti-inflammatory painkillers and keep drinking. Please come and see me after the results today. That's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 352.95,
      "end_seconds": 355.83,
      "duration_seconds": 2.88,
      "text": "I think I understand everything. Thanks."
    }
  ]
}