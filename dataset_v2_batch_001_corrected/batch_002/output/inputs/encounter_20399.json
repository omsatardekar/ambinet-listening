{
  "schema_version": "1.0",
  "encounter_id": "20399",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.26,
      "end_seconds": 6.7,
      "duration_seconds": 5.44,
      "text": "hi, doctor, I came as soon as they called me"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.79,
      "end_seconds": 13.16,
      "duration_seconds": 4.37,
      "text": "Yes, have a seat. Tell me what's going on."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 14.6,
      "end_seconds": 28.68,
      "duration_seconds": 14.08,
      "text": "Mainly burning pain before the rash. There's a couple of other things, um, but that's the main one. My sister suggested writing things down, but I forgot."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 29.29,
      "end_seconds": 33.02,
      "duration_seconds": 3.73,
      "text": "when was the first time you noticed it?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 35.07,
      "end_seconds": 43.34,
      "duration_seconds": 8.27,
      "text": "It's been like this since last night. I didn't want to bother you but it keeps coming back."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 44.03,
      "end_seconds": 46.49,
      "duration_seconds": 2.46,
      "text": "Is there anything else with it?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 47.78,
      "end_seconds": 64.85,
      "duration_seconds": 17.07,
      "text": "when it starts I tend to get a painful rash on one side of my chest as well. Okay, so the painful rash on one side of my chest? That's been for two weeks"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 66.8,
      "end_seconds": 71.9,
      "duration_seconds": 5.1,
      "text": "Have you noticed weakness, rash near the eye, vision changes or confusion?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 73.71,
      "end_seconds": 76.39,
      "duration_seconds": 2.68,
      "text": "No, none that I've noticed."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 78.2,
      "end_seconds": 80.92,
      "duration_seconds": 2.72,
      "text": "So, anything unusual with passing urine?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 82.75,
      "end_seconds": 87.01,
      "duration_seconds": 4.26,
      "text": "Yeah, that's normal as far as I know."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 88.34,
      "end_seconds": 92.63,
      "duration_seconds": 4.29,
      "text": "Any change in your bowel habit or your stomach generally?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 94.45,
      "end_seconds": 96.9,
      "duration_seconds": 2.45,
      "text": "Bowels are regular, nothing odd."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 98.46,
      "end_seconds": 102.45,
      "duration_seconds": 3.99,
      "text": "Are you taking anything regularly, including from the pharmacy?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 103.55,
      "end_seconds": 108.98,
      "duration_seconds": 5.43,
      "text": "Dolo. I take it 650 milligrams, when I get the pain."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 123.14,
      "end_seconds": 124.41,
      "duration_seconds": 1.27,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 125.97,
      "end_seconds": 127.02,
      "duration_seconds": 1.05,
      "text": "No, never."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 128.23,
      "end_seconds": 132.59,
      "duration_seconds": 4.36,
      "text": "Do you react to any medicines or foods? Any allergies?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 138.63,
      "end_seconds": 143.77,
      "duration_seconds": 5.14,
      "text": "I'm allergic to erythromycin, I get bad stomach cramps."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 156.01,
      "end_seconds": 157.36,
      "duration_seconds": 1.35,
      "text": "Do you smoke?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 158.25,
      "end_seconds": 161.92,
      "duration_seconds": 3.67,
      "text": "I have about eight cigarettes in a day."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 162.79,
      "end_seconds": 166.02,
      "duration_seconds": 3.23,
      "text": "Alright, do you work outside the home?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 167.17,
      "end_seconds": 171.53,
      "duration_seconds": 4.36,
      "text": "I'm a hairdresser, on my feet all day."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 173.44,
      "end_seconds": 177.83,
      "duration_seconds": 4.39,
      "text": "What does a normal day of food look like?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 178.94,
      "end_seconds": 182.81,
      "duration_seconds": 3.87,
      "text": "Lots of rice, lentils and some fruit."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 200.04,
      "end_seconds": 204.34,
      "duration_seconds": 4.3,
      "text": "Do you have any medical conditions I should know about?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 206.31,
      "end_seconds": 207.84,
      "duration_seconds": 1.53,
      "text": "Not really, no."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 209.82,
      "end_seconds": 213.55,
      "duration_seconds": 3.73,
      "text": "Let me get the readings out of the way."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 221.23,
      "end_seconds": 223.27,
      "duration_seconds": 2.04,
      "text": "Sit still for a moment..."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 239.28,
      "end_seconds": 248.01,
      "duration_seconds": 8.73,
      "text": "Okay: temp 38.8 degrees, oxygen saturation is 98 percent, BP is 114 over 74, pulse 101, respiratory rate 21."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 249.21,
      "end_seconds": 251.88,
      "duration_seconds": 2.67,
      "text": "So, may I examine you now?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 252.87,
      "end_seconds": 255.69,
      "duration_seconds": 2.82,
      "text": "Take a deep breath for me."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 268.33,
      "end_seconds": 277.56,
      "duration_seconds": 9.23,
      "text": "There are clustered blisters on a red base in a band across the right side of the chest, not crossing the midline."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 283.55,
      "end_seconds": 286.47,
      "duration_seconds": 2.92,
      "text": "Thank you, you can get dressed."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 296.86,
      "end_seconds": 308.04,
      "duration_seconds": 11.18,
      "text": "So where does that leave us? I think we're dealing with shingles at this stage. I'll request a swab from a blister, it'll help with vesicular rash."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 309.75,
      "end_seconds": 311.35,
      "duration_seconds": 1.6,
      "text": "Does it hurt?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 312.67,
      "end_seconds": 339.5,
      "duration_seconds": 26.83,
      "text": "I'm prescribing aciclovir, 800 milligrams, five times a day, for seven days. That should help with shingles. Keep the rash clean and dry and avoid contact with pregnant women or newborns until the blisters crust over. One warning sign to remember: the rash spreads to the eye or face. In that case don't wait."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 340.41,
      "end_seconds": 342.17,
      "duration_seconds": 1.76,
      "text": "yes, will do"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 343.44,
      "end_seconds": 346.38,
      "duration_seconds": 2.94,
      "text": "Does all of that make sense?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 347.62,
      "end_seconds": 351.24,
      "duration_seconds": 3.62,
      "text": "Right, I'll do that. Thank you, doctor."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 352.7,
      "end_seconds": 354.02,
      "duration_seconds": 1.32,
      "text": "look after yourself"
    }
  ]
}