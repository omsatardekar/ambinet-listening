{
  "schema_version": "1.0",
  "encounter_id": "20434",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.03,
      "end_seconds": 5.28,
      "duration_seconds": 4.25,
      "text": "Hi, doctor, I hope I'm not disturbing you."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.92,
      "end_seconds": 10.02,
      "duration_seconds": 4.1,
      "text": "Not at all, please sit. What seems to be wrong?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 10.89,
      "end_seconds": 18.01,
      "duration_seconds": 7.12,
      "text": "Honestly, it's pain around my cheeks, and my family pushed me to come."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 18.33,
      "end_seconds": 24.97,
      "duration_seconds": 6.64,
      "text": "Right, right. Is it there all the time or does it come and go?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 26.83,
      "end_seconds": 29.2,
      "duration_seconds": 2.37,
      "text": "It, It comes and goes."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 30.55,
      "end_seconds": 34.15,
      "duration_seconds": 3.6,
      "text": "Okay, how much trouble does it give you?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 36.2,
      "end_seconds": 53.17,
      "duration_seconds": 16.97,
      "text": "A six out of ten, I suppose. There's a blocked nose as well. About blocked nose, it settles a little with steam. I've, I've had a headache too, for about two weeks."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 55.05,
      "end_seconds": 62.06,
      "duration_seconds": 7.01,
      "text": "Have you had pain around your cheeks before, or is this the first time?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 62.81,
      "end_seconds": 70.54,
      "duration_seconds": 7.73,
      "text": "Yes, something like this happened about six months ago, and it went away on its own."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 71.1,
      "end_seconds": 75.17,
      "duration_seconds": 4.07,
      "text": "Can I check a few measurements before we carry on?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 88.83,
      "end_seconds": 91.23,
      "duration_seconds": 2.4,
      "text": "Bear with me while this finishes..."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 106.58,
      "end_seconds": 112.83,
      "duration_seconds": 6.25,
      "text": "Okay: respiratory rate 17, pressure 112 over 66, temperature 38.2, pulse 90."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 114.84,
      "end_seconds": 117.24,
      "duration_seconds": 2.4,
      "text": "May I examine you now?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 118.89,
      "end_seconds": 120.85,
      "duration_seconds": 1.96,
      "text": "Raise your arm for me."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 136.65,
      "end_seconds": 142.85,
      "duration_seconds": 6.2,
      "text": "There is tenderness over both cheeks and the nose is blocked with swollen lining."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 148.13,
      "end_seconds": 150.84,
      "duration_seconds": 2.71,
      "text": "Thank you, you can get dressed."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 168.58,
      "end_seconds": 174.34,
      "duration_seconds": 5.76,
      "text": "Have you had any double vision, toothache or swelling around the eyes?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 176.04,
      "end_seconds": 181.69,
      "duration_seconds": 5.65,
      "text": "No double vision, toothache or swelling around the eyes, none of it."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 182.36,
      "end_seconds": 183.17,
      "duration_seconds": 0.81,
      "text": "Any fever?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 183.68,
      "end_seconds": 185.03,
      "duration_seconds": 1.35,
      "text": "No. No fever."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 186.6,
      "end_seconds": 190.55,
      "duration_seconds": 3.95,
      "text": "What about your tummy and bowels, anything unusual there?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 191.95,
      "end_seconds": 193.93,
      "duration_seconds": 1.98,
      "text": "No, all normal there."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 195.07,
      "end_seconds": 200.06,
      "duration_seconds": 4.99,
      "text": "So, are you allergic to anything? Any allergies to medicines or foods?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 202.11,
      "end_seconds": 205.52,
      "duration_seconds": 3.41,
      "text": "Um, I've never had an allergy."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 206.47,
      "end_seconds": 210.07,
      "duration_seconds": 3.6,
      "text": "Anything in your past medical history I should know?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 210.72,
      "end_seconds": 214.68,
      "duration_seconds": 3.96,
      "text": "I've had asthma for about a year now."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 215.87,
      "end_seconds": 225.13,
      "duration_seconds": 9.26,
      "text": "Right, right. So, yes, asthma is known to us, good to have that clear. Now some background about your lifestyle."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 226.52,
      "end_seconds": 237.15,
      "duration_seconds": 10.63,
      "text": "I used to drink heavily but I stopped four years ago. I walk the dog every morning. I live with my elderly mother."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 245.24,
      "end_seconds": 247.28,
      "duration_seconds": 2.04,
      "text": "Let's run through your medicines."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 249.03,
      "end_seconds": 253.18,
      "duration_seconds": 4.15,
      "text": "I'm on saline nasal spray, several times a day."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 268.23,
      "end_seconds": 295.83,
      "duration_seconds": 27.6,
      "text": "Taking everything into account, it points towards acute sinusitis. That's my thinking for now, and it may change as we learn more. We shouldn't forget a viral cold. I'm prescribing fluticasone nasal spray, 50 micrograms, two sprays each side once a day, for two weeks. That's for sinus congestion. Steam inhalation and saline rinses can help clear the nose. Let's review you if it isn't improving in ten days."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 297.65,
      "end_seconds": 299.73,
      "duration_seconds": 2.08,
      "text": "That's fine with me."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 301.05,
      "end_seconds": 304.5,
      "duration_seconds": 3.45,
      "text": "I think we're done unless you have questions."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 305.52,
      "end_seconds": 307.49,
      "duration_seconds": 1.97,
      "text": "Thank you, that's helpful."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 312.94,
      "end_seconds": 314.89,
      "duration_seconds": 1.95,
      "text": "Have a good day."
    }
  ]
}