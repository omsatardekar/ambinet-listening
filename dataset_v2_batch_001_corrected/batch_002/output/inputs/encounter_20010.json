{
  "schema_version": "1.0",
  "encounter_id": "20010",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.7,
      "end_seconds": 3.81,
      "duration_seconds": 3.11,
      "text": "Morning, doctor. Lovely to meet you."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.42,
      "end_seconds": 10.68,
      "duration_seconds": 5.26,
      "text": "Alright, yes, come in and sit down. What brings you here today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 11.62,
      "end_seconds": 17.16,
      "duration_seconds": 5.54,
      "text": "Hello, doctor, I came in with them, if that's okay."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 18.6,
      "end_seconds": 22.2,
      "duration_seconds": 3.6,
      "text": "Yes, that's no problem at all. Please sit."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 24.17,
      "end_seconds": 27.47,
      "duration_seconds": 3.3,
      "text": "I've been dealing with yellow phlegm."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 29.33,
      "end_seconds": 33.11,
      "duration_seconds": 3.78,
      "text": "Can you tell me when it first started?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 34.32,
      "end_seconds": 35.78,
      "duration_seconds": 1.46,
      "text": "Just since yesterday."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 36.96,
      "end_seconds": 38.93,
      "duration_seconds": 1.97,
      "text": "Any other symptoms with it?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 39.84,
      "end_seconds": 47.69,
      "duration_seconds": 7.85,
      "text": "It usually comes with wheezing. I've also had a chesty cough, for about a week."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 48.58,
      "end_seconds": 51.05,
      "duration_seconds": 2.47,
      "text": "Is it constant or in episodes?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 52.42,
      "end_seconds": 65.84,
      "duration_seconds": 13.42,
      "text": "Honestly, once or twice a day. And I've been feeling feverish as well, for about a week. The wheezing? That's been for three days."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 67.18,
      "end_seconds": 74.43,
      "duration_seconds": 7.25,
      "text": "Let me check a few things. Any coughing up blood, leg swelling or night sweats?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 75.46,
      "end_seconds": 78.83,
      "duration_seconds": 3.37,
      "text": "No, uh, not a single one."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 80.87,
      "end_seconds": 86.82,
      "duration_seconds": 5.95,
      "text": "Okay, and what about ankle swelling, weight loss or sharp chest pain?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 87.52,
      "end_seconds": 93.75,
      "duration_seconds": 6.23,
      "text": "I, I haven't had ankle swelling, weight loss or sharp chest pain, no."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 95.46,
      "end_seconds": 98.15,
      "duration_seconds": 2.69,
      "text": "And your skin, any changes there?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 100.04,
      "end_seconds": 102.54,
      "duration_seconds": 2.5,
      "text": "Nothing on the skin, no."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 104.36,
      "end_seconds": 109.11,
      "duration_seconds": 4.75,
      "text": "Let's talk a little about your daily life and habits."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 109.69,
      "end_seconds": 122.63,
      "duration_seconds": 12.94,
      "text": "My husband and I live above the shop. I drink a lot of tea and snack through the day. I'm a hairdresser, on my feet all day."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 123.8,
      "end_seconds": 127.14,
      "duration_seconds": 3.34,
      "text": "Any health conditions I should have on record?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 127.93,
      "end_seconds": 134.29,
      "duration_seconds": 6.36,
      "text": "I have high blood pressure. I've had COPD for about a year now."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 136.14,
      "end_seconds": 145.5,
      "duration_seconds": 9.36,
      "text": "Alright, high blood pressure and COPD, that matches what I have here. What do you take on a normal day?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 146.53,
      "end_seconds": 155.39,
      "duration_seconds": 8.86,
      "text": "Valsartan. I take it 80 milligrams, once a day. Tiotropium inhaler. I take it once a day."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 155.79,
      "end_seconds": 156.49,
      "duration_seconds": 0.7,
      "text": "Sure."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 161.7,
      "end_seconds": 168.55,
      "duration_seconds": 6.85,
      "text": "Hmm, I'm on Dolo, 650 milligrams, when I get the fever."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 169.99,
      "end_seconds": 173.05,
      "duration_seconds": 3.06,
      "text": "Before we go further, any allergies?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 173.74,
      "end_seconds": 178.05,
      "duration_seconds": 4.31,
      "text": "No, you know, nothing as far as I know."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 179.85,
      "end_seconds": 187.73,
      "duration_seconds": 7.88,
      "text": "Actually, I remember he had some kind of reaction to naproxen before. I couldn't swear to it."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 189.06,
      "end_seconds": 191.77,
      "duration_seconds": 2.71,
      "text": "Really? I don't think so."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 192.55,
      "end_seconds": 197.71,
      "duration_seconds": 5.16,
      "text": "Alright, so that's unclear. I'll record what each of you said."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 209.74,
      "end_seconds": 212.62,
      "duration_seconds": 2.88,
      "text": "Does your family have any medical conditions?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 214.55,
      "end_seconds": 218.72,
      "duration_seconds": 4.17,
      "text": "My grandmother had dementia. My son has asthma."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 220.61,
      "end_seconds": 222.95,
      "duration_seconds": 2.34,
      "text": "Let's start with the basic checks."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 235.68,
      "end_seconds": 238.48,
      "duration_seconds": 2.8,
      "text": "Bear with me while this finishes..."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 258.61,
      "end_seconds": 265.68,
      "duration_seconds": 7.07,
      "text": "Okay: respiratory rate 24, oxygen saturation is 94 percent, blood pressure 124 over 86, pulse 100."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 267.13,
      "end_seconds": 270.49,
      "duration_seconds": 3.36,
      "text": "Okay, time for me to examine you."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 271.81,
      "end_seconds": 274.58,
      "duration_seconds": 2.77,
      "text": "Take a deep breath for me."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 292.92,
      "end_seconds": 297.07,
      "duration_seconds": 4.15,
      "text": "There are scattered wheezes on both sides and no crackles."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 299.41,
      "end_seconds": 301.89,
      "duration_seconds": 2.48,
      "text": "Good, you can sit up again."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 320.82,
      "end_seconds": 344.75,
      "duration_seconds": 23.93,
      "text": "I'm sending you for a chest X-ray because of productive cough. The result will help us decide whether anything more is needed. We should do a sputum sample for purulent sputum. We'll begin with prednisolone, 30 milligrams, once a day, for five days. You take it by mouth. That's for flare of lung disease."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 346.11,
      "end_seconds": 349.71,
      "duration_seconds": 3.6,
      "text": "Can I collect it from my own pharmacy?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 350.59,
      "end_seconds": 359.31,
      "duration_seconds": 8.72,
      "text": "If you become more breathless or your lips turn blue, or you feel really unwell, please come to the emergency department."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 361.2,
      "end_seconds": 364.07,
      "duration_seconds": 2.87,
      "text": "Yes, I'll bear that in mind."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 365.66,
      "end_seconds": 372.93,
      "duration_seconds": 7.27,
      "text": "I'd like to see you again in two weeks. That's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 374.94,
      "end_seconds": 377.7,
      "duration_seconds": 2.76,
      "text": "I think I understand everything. Thanks."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 379.6,
      "end_seconds": 381.4,
      "duration_seconds": 1.8,
      "text": "Okay, see you soon."
    }
  ]
}