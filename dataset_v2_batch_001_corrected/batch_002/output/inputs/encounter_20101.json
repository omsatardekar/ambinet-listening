{
  "schema_version": "1.0",
  "encounter_id": "20101",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 1.27,
      "end_seconds": 5.77,
      "duration_seconds": 4.5,
      "text": "Morning, doctor. I've settled them in, ready when you are."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.16,
      "end_seconds": 11.26,
      "duration_seconds": 4.1,
      "text": "Perfect, thanks. Hello there, so what's the trouble?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 12.57,
      "end_seconds": 18.08,
      "duration_seconds": 5.51,
      "text": "doctor, uh, I'm just here to help with the details"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 19.14,
      "end_seconds": 21.92,
      "duration_seconds": 2.78,
      "text": "please do. Extra information is always welcome"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 23.21,
      "end_seconds": 29.28,
      "duration_seconds": 6.07,
      "text": "mm, doctor, it's my heart racing it's getting on my nerves now"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 30.99,
      "end_seconds": 32.17,
      "duration_seconds": 1.18,
      "text": "Since when exactly?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 33.17,
      "end_seconds": 37.87,
      "duration_seconds": 4.7,
      "text": "Um, uh, for about three months, I'd say."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 39.86,
      "end_seconds": 45.11,
      "duration_seconds": 5.25,
      "text": "Okay, give me more detail on it, whatever comes to mind."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 46.21,
      "end_seconds": 57.86,
      "duration_seconds": 11.65,
      "text": "Okay, um, so it sort of comes and goes. It's mild, honestly. My neighbour said I should get it looked at."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 58.35,
      "end_seconds": 64.88,
      "duration_seconds": 6.53,
      "text": "And the other thing I wanted to mention is that I can't really—"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 64.98,
      "end_seconds": 70.57,
      "duration_seconds": 5.59,
      "text": "Tell the doctor about the other thing, that's what worries me."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 72.65,
      "end_seconds": 91.96,
      "duration_seconds": 19.31,
      "text": "Well, I was getting to that! I've been losing weight despite eating well too. Hmm, as for feeling hot all the time, I honestly can't say when that began. It might have been last month or the month before."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 92.51,
      "end_seconds": 109.64,
      "duration_seconds": 17.13,
      "text": "here are the numbers, doctor blood pressure 138 over 85, height 178 centimetres oxygen saturation is 99 percent, respiratory rate 17, pulse 120, temperature is 36.5 degrees, BMI works out to 20.2, weight 64 kilos"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 110.86,
      "end_seconds": 111.56,
      "duration_seconds": 0.7,
      "text": "Thanks."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 113.67,
      "end_seconds": 117.57,
      "duration_seconds": 3.9,
      "text": "let me look at the area, I'll be gentle"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 130.34,
      "end_seconds": 131.69,
      "duration_seconds": 1.35,
      "text": "Fine by me."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 133.3,
      "end_seconds": 135.06,
      "duration_seconds": 1.76,
      "text": "So, breathe out slowly."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 153.12,
      "end_seconds": 160.48,
      "duration_seconds": 7.36,
      "text": "There is a fine tremor of the outstretched hands and the pulse is fast and regular."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 164.22,
      "end_seconds": 164.92,
      "duration_seconds": 0.7,
      "text": "Right."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 165.78,
      "end_seconds": 167.14,
      "duration_seconds": 1.36,
      "text": "Does that hurt?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 179.14,
      "end_seconds": 184.54,
      "duration_seconds": 5.4,
      "text": "There is a smooth, small swelling at the front of the neck."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 188.16,
      "end_seconds": 196.57,
      "duration_seconds": 8.41,
      "text": "That's all I needed to check. Let me check a few things. Any double vision or chest pain?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 201.73,
      "end_seconds": 205.07,
      "duration_seconds": 3.34,
      "text": "Mm, no, I'd have said so."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 205.73,
      "end_seconds": 210.05,
      "duration_seconds": 4.32,
      "text": "have you noticed eye pain, fainting or neck swelling?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 210.73,
      "end_seconds": 216.39,
      "duration_seconds": 5.66,
      "text": "No eye pain, fainting or neck swelling, none of it."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 217.78,
      "end_seconds": 220.67,
      "duration_seconds": 2.89,
      "text": "Okay, anything unusual with passing urine?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 221.34,
      "end_seconds": 225.17,
      "duration_seconds": 3.83,
      "text": "So, that's normal as far as I know."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 226.72,
      "end_seconds": 228.71,
      "duration_seconds": 1.99,
      "text": "Let's run through your medicines."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 230.62,
      "end_seconds": 234.54,
      "duration_seconds": 3.92,
      "text": "I take losartan, 50 milligrams, once a day."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 236.03,
      "end_seconds": 243.95,
      "duration_seconds": 7.92,
      "text": "He is supposed to take it once a day, but I can't say he always does."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 245.35,
      "end_seconds": 250.26,
      "duration_seconds": 4.91,
      "text": "Propranolol i take it 40 milligrams, twice a day"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 251.42,
      "end_seconds": 254.86,
      "duration_seconds": 3.44,
      "text": "so, since when have you been taking it?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 255.94,
      "end_seconds": 262.5,
      "duration_seconds": 6.56,
      "text": "for about a year before this I was on lisinopril; that's been stopped"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 264.16,
      "end_seconds": 267.91,
      "duration_seconds": 3.75,
      "text": "Any health conditions I should have on record?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 269.5,
      "end_seconds": 278.07,
      "duration_seconds": 8.57,
      "text": "I have high blood pressure, for five years i've had migraines for about ten years now"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 279.19,
      "end_seconds": 282.8,
      "duration_seconds": 3.61,
      "text": "alright, migraines, that matches what I have here"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 292.9,
      "end_seconds": 294.63,
      "duration_seconds": 1.73,
      "text": "Right, what about alcohol?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 295.34,
      "end_seconds": 296.87,
      "duration_seconds": 1.53,
      "text": "Nothing, I'm teetotal."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 298.51,
      "end_seconds": 299.93,
      "duration_seconds": 1.42,
      "text": "What's your work?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 305.46,
      "end_seconds": 309.99,
      "duration_seconds": 4.53,
      "text": "I'm a plumber, lots of bending and kneeling."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 310.86,
      "end_seconds": 315.69,
      "duration_seconds": 4.83,
      "text": "Any allergies to tablets, food or anything in the environment?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 316.25,
      "end_seconds": 321.04,
      "duration_seconds": 4.79,
      "text": "Um, no, nothing as far as I know."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 321.73,
      "end_seconds": 324.07,
      "duration_seconds": 2.34,
      "text": "Anything surgical in your history?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 325.0,
      "end_seconds": 329.21,
      "duration_seconds": 4.21,
      "text": "I had a varicose vein procedure last year."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 329.9,
      "end_seconds": 341.58,
      "duration_seconds": 11.68,
      "text": "Having listened and examined, the most likely explanation is an overactive thyroid. It could also be an abnormal heart rhythm, so we'll keep that open. Another possibility is anxiety."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 343.37,
      "end_seconds": 346.82,
      "duration_seconds": 3.45,
      "text": "I've already done an ECG, it's ready for you"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 348.01,
      "end_seconds": 360.3,
      "duration_seconds": 12.29,
      "text": "Thanks, I'll have a look. We should do thyroid blood tests for palpitations and weight loss. The result will help us decide whether anything more is needed."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_5",
      "role": "CLINICAL_STAFF",
      "start_seconds": 361.11,
      "end_seconds": 363.92,
      "duration_seconds": 2.81,
      "text": "The earliest is Monday, 10 am."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 365.49,
      "end_seconds": 369.6,
      "duration_seconds": 4.11,
      "text": "Try to avoid caffeine while we sort this out."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 369.93,
      "end_seconds": 376.79,
      "duration_seconds": 6.86,
      "text": "I see, go ahead. Let's get you seen by the endocrine clinic, I'll arrange the letter."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 378.23,
      "end_seconds": 378.93,
      "duration_seconds": 0.7,
      "text": "okay"
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 380.96,
      "end_seconds": 396.88,
      "duration_seconds": 15.92,
      "text": "Let's hold off on a thyroid scan for now, and if there's no change in a month we can revisit it. The thing that would worry me is if the symptoms get worse. If that happens, go to emergency."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 398.47,
      "end_seconds": 399.97,
      "duration_seconds": 1.5,
      "text": "Alright, I follow."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 403.37,
      "end_seconds": 411.9,
      "duration_seconds": 8.53,
      "text": "please come and see me in two weeks right, that's the plan do you wanna ask me anything?"
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 412.49,
      "end_seconds": 417.04,
      "duration_seconds": 4.55,
      "text": "Uh, you know, alright, thanks, take care."
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 418.77,
      "end_seconds": 420.23,
      "duration_seconds": 1.46,
      "text": "look after yourself"
    }
  ]
}