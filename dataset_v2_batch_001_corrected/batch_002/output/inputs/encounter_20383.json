{
  "schema_version": "1.0",
  "encounter_id": "20383",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.36,
      "end_seconds": 4.35,
      "duration_seconds": 2.99,
      "text": "Sorry, doctor, shall I sit here?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.48,
      "end_seconds": 9.32,
      "duration_seconds": 3.84,
      "text": "Come in. Please sit. How can I help you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 10.52,
      "end_seconds": 18.53,
      "duration_seconds": 8.01,
      "text": "so the thing is, I've got no energy my family kept telling me to get it checked"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 24.26,
      "end_seconds": 27.53,
      "duration_seconds": 3.27,
      "text": "has this been going on for long?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 28.92,
      "end_seconds": 31.03,
      "duration_seconds": 2.11,
      "text": "About... well, four weeks."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 32.64,
      "end_seconds": 36.01,
      "duration_seconds": 3.37,
      "text": "alright, would you say mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 38.11,
      "end_seconds": 40.82,
      "duration_seconds": 2.71,
      "text": "it feels mild to me"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 41.08,
      "end_seconds": 42.0,
      "duration_seconds": 0.92,
      "text": "Hm, okay."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 43.89,
      "end_seconds": 47.26,
      "duration_seconds": 3.37,
      "text": "And a tight chest when stressed, too."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 51.35,
      "end_seconds": 59.73,
      "duration_seconds": 8.38,
      "text": "Can you describe it a bit more for me? How strong it is, what the pattern is, what helps."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 60.44,
      "end_seconds": 64.53,
      "duration_seconds": 4.09,
      "text": "I'd say all the time. Mild, I'd say."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 66.09,
      "end_seconds": 70.59,
      "duration_seconds": 4.5,
      "text": "A few quick ones: panic attacks, drinking more or chest pain?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 72.16,
      "end_seconds": 75.42,
      "duration_seconds": 3.26,
      "text": "Nope, you know, nothing like that."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 76.02,
      "end_seconds": 82.32,
      "duration_seconds": 6.3,
      "text": "Hm, okay. Have you noticed any weakness, or anything odd with your balance?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 83.37,
      "end_seconds": 85.34,
      "duration_seconds": 1.97,
      "text": "No, nothing like that."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 87.06,
      "end_seconds": 90.74,
      "duration_seconds": 3.68,
      "text": "okay, how are your joints, any aches elsewhere?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 91.96,
      "end_seconds": 93.75,
      "duration_seconds": 1.79,
      "text": "I move fine otherwise."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 94.47,
      "end_seconds": 98.7,
      "duration_seconds": 4.23,
      "text": "Do you react to any medicines or foods? Any allergies?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 100.4,
      "end_seconds": 101.59,
      "duration_seconds": 1.19,
      "text": "yes, naproxen"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 103.23,
      "end_seconds": 105.13,
      "duration_seconds": 1.9,
      "text": "and alcohol, how much?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 110.61,
      "end_seconds": 114.54,
      "duration_seconds": 3.93,
      "text": "I'll have a glass of wine with dinner."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 115.81,
      "end_seconds": 117.82,
      "duration_seconds": 2.01,
      "text": "Do you get out much?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 118.79,
      "end_seconds": 122.48,
      "duration_seconds": 3.69,
      "text": "Not much, I mostly stay in these days."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 124.1,
      "end_seconds": 126.9,
      "duration_seconds": 2.8,
      "text": "Are you in work at the moment?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 128.7,
      "end_seconds": 133.05,
      "duration_seconds": 4.35,
      "text": "Yes, I work in a bakery, early starts."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 134.53,
      "end_seconds": 136.41,
      "duration_seconds": 1.88,
      "text": "How are your meals?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 138.12,
      "end_seconds": 141.83,
      "duration_seconds": 3.71,
      "text": "I grab fast food at lunch most days"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 143.59,
      "end_seconds": 146.52,
      "duration_seconds": 2.93,
      "text": "do you take any regular medication?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 147.55,
      "end_seconds": 148.65,
      "duration_seconds": 1.1,
      "text": "No, none."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 149.86,
      "end_seconds": 153.76,
      "duration_seconds": 3.9,
      "text": "do you have any medical conditions I should know about?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 155.54,
      "end_seconds": 158.84,
      "duration_seconds": 3.3,
      "text": "no, I've always been fairly healthy"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 170.28,
      "end_seconds": 173.69,
      "duration_seconds": 3.41,
      "text": "Shall I check your blood pressure and pulse?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 183.02,
      "end_seconds": 186.5,
      "duration_seconds": 3.48,
      "text": "So, keep your arm relaxed for me..."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 205.94,
      "end_seconds": 216.28,
      "duration_seconds": 10.34,
      "text": "Okay: pulse is 76 beats a minute, respiratory rate 17. And pressure 122 over 73, oxygen saturation is 98 percent, temperature 36.5."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 217.38,
      "end_seconds": 220.45,
      "duration_seconds": 3.07,
      "text": "Okay, time for me to examine you."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 234.31,
      "end_seconds": 237.05,
      "duration_seconds": 2.74,
      "text": "Yeah, um, no problem."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 238.02,
      "end_seconds": 239.43,
      "duration_seconds": 1.41,
      "text": "Breathe out slowly."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 251.49,
      "end_seconds": 257.36,
      "duration_seconds": 5.87,
      "text": "Your pulse and blood pressure are normal and you are tearful when talking about work."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 259.5,
      "end_seconds": 261.5,
      "duration_seconds": 2.0,
      "text": "You can sit up now."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 275.35,
      "end_seconds": 287.23,
      "duration_seconds": 11.88,
      "text": "okay, so my impression is this: I don't have a clear answer today: low mood linked to work stress is possible, and so is an under-active thyroid"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 292.59,
      "end_seconds": 294.06,
      "duration_seconds": 1.47,
      "text": "Is this permanent?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 295.13,
      "end_seconds": 304.8,
      "duration_seconds": 9.67,
      "text": "it's reasonable to be concerned, but right now low mood linked to work stress is my leading thought, not anything worse"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 312.33,
      "end_seconds": 324.23,
      "duration_seconds": 11.9,
      "text": "I'd like to arrange a thyroid test for low mood and fatigue. I'd rather check than guess, and this is the the quickest way to know more."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 324.77,
      "end_seconds": 327.56,
      "duration_seconds": 2.79,
      "text": "well, is that done today?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 328.68,
      "end_seconds": 343.83,
      "duration_seconds": 15.15,
      "text": "I'll start you on sertraline, 50 milligrams, once a day, for six weeks then review. You take it by mouth. That's for low mood. Try a short walk each day and keep a regular bedtime."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 344.25,
      "end_seconds": 352.73,
      "duration_seconds": 8.48,
      "text": "Hm, okay. I'd like you to see the talking therapies service as well, and I'll write the referral."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 353.58,
      "end_seconds": 355.98,
      "duration_seconds": 2.4,
      "text": "sure, where do I go?"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 357.24,
      "end_seconds": 365.69,
      "duration_seconds": 8.45,
      "text": "Come back in four weeks. Right, that's the plan. Do you want to to ask me anything?"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 367.58,
      "end_seconds": 369.08,
      "duration_seconds": 1.5,
      "text": "that's clear, thanks"
    }
  ]
}