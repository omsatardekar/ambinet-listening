{
  "schema_version": "1.0",
  "encounter_id": "20058",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.61,
      "end_seconds": 3.65,
      "duration_seconds": 3.04,
      "text": "Hello, doctor. May I come in?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.53,
      "end_seconds": 9.6,
      "duration_seconds": 4.07,
      "text": "Yes, have a seat. Tell me what's going on."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 10.69,
      "end_seconds": 16.26,
      "duration_seconds": 5.57,
      "text": "I've been forgetting recent things, and I wanted to get it checked"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 17.53,
      "end_seconds": 21.26,
      "duration_seconds": 3.73,
      "text": "Let me get the readings out of the way."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 28.7,
      "end_seconds": 31.07,
      "duration_seconds": 2.37,
      "text": "bear with me while this finishes.."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 40.09,
      "end_seconds": 52.86,
      "duration_seconds": 12.77,
      "text": "Okay: temperature is 36.6 degrees, pulse 66, respiratory rate 14. And oxygen saturation is 98 percent, blood pressure 116 over 79. Anything that improves it?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 54.41,
      "end_seconds": 57.15,
      "duration_seconds": 2.74,
      "text": "Writing notes helps a bit"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 58.73,
      "end_seconds": 63.02,
      "duration_seconds": 4.29,
      "text": "So, what about a low mood, have you noticed that?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 64.3,
      "end_seconds": 78.39,
      "duration_seconds": 14.09,
      "text": "Yes, for two years. I've also been getting lost on familiar roads, for about three months. I was misplacing things at one point, but that's gone now."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 79.8,
      "end_seconds": 85.09,
      "duration_seconds": 5.29,
      "text": "Have you been forgetting recent things at any time before this?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 86.32,
      "end_seconds": 91.12,
      "duration_seconds": 4.8,
      "text": "I had a similar thing last year it went away"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 92.5,
      "end_seconds": 98.26,
      "duration_seconds": 5.76,
      "text": "Alright, have you noticed headache, hallucinations, falls or weakness on one side?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 102.37,
      "end_seconds": 104.8,
      "duration_seconds": 2.43,
      "text": "No, none that I've noticed."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 106.87,
      "end_seconds": 109.37,
      "duration_seconds": 2.5,
      "text": "And bladder problems, any of that?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 111.08,
      "end_seconds": 115.09,
      "duration_seconds": 4.01,
      "text": "No, I haven't had any bladder problems."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 116.64,
      "end_seconds": 119.83,
      "duration_seconds": 3.19,
      "text": "any muscle or joint problems besides this?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 120.45,
      "end_seconds": 122.24,
      "duration_seconds": 1.79,
      "text": "No, nothing there."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 123.11,
      "end_seconds": 125.58,
      "duration_seconds": 2.47,
      "text": "Any trouble with the waterworks?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 126.83,
      "end_seconds": 129.19,
      "duration_seconds": 2.36,
      "text": "No, that's all fine."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 130.37,
      "end_seconds": 134.74,
      "duration_seconds": 4.37,
      "text": "Any inherited conditions that you know of in the family?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 135.55,
      "end_seconds": 137.5,
      "duration_seconds": 1.95,
      "text": "My son has asthma."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 138.71,
      "end_seconds": 140.05,
      "duration_seconds": 1.34,
      "text": "are you active?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 141.3,
      "end_seconds": 144.23,
      "duration_seconds": 2.93,
      "text": "I walk the dog every morning."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 149.97,
      "end_seconds": 151.68,
      "duration_seconds": 1.71,
      "text": "Have you retired yet?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 153.23,
      "end_seconds": 157.57,
      "duration_seconds": 4.34,
      "text": "I retired from the post office two years ago."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 159.43,
      "end_seconds": 161.28,
      "duration_seconds": 1.85,
      "text": "Who lives with you?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 163.32,
      "end_seconds": 165.67,
      "duration_seconds": 2.35,
      "text": "My partner and our baby"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 167.65,
      "end_seconds": 170.93,
      "duration_seconds": 3.28,
      "text": "alright, have you ever had an operation?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 172.23,
      "end_seconds": 176.05,
      "duration_seconds": 3.82,
      "text": "I had a bunion operation six years ago"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 192.37,
      "end_seconds": 194.41,
      "duration_seconds": 2.04,
      "text": "Let's run through your medicines."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 196.07,
      "end_seconds": 203.3,
      "duration_seconds": 7.23,
      "text": "Simvastatin. I take it 20 milligrams, at night. Glibenclamide, 5 milligrams, before breakfast."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 205.36,
      "end_seconds": 208.66,
      "duration_seconds": 3.3,
      "text": "Let me ask about allergies, anything at all?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 209.18,
      "end_seconds": 223.18,
      "duration_seconds": 14.0,
      "text": "hmm, there was some antibiotic, I was told I was allergic but I couldn't tell you what it was called or what it did"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 234.85,
      "end_seconds": 238.98,
      "duration_seconds": 4.13,
      "text": "what conditions have you been treated for in the past?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 243.29,
      "end_seconds": 252.34,
      "duration_seconds": 9.05,
      "text": "High cholesterol, for nearly five years. Yes, diabetes. I've had high blood pressure for nearly five years now."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 253.68,
      "end_seconds": 259.67,
      "duration_seconds": 5.99,
      "text": "Ah. Yes, high blood pressure is known to us, good to have that clear."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 261.33,
      "end_seconds": 265.9,
      "duration_seconds": 4.57,
      "text": "I'll need to examine you for this, it won't take long."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 267.18,
      "end_seconds": 269.65,
      "duration_seconds": 2.47,
      "text": "Yes, uh, that's fine."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 270.78,
      "end_seconds": 273.53,
      "duration_seconds": 2.75,
      "text": "I'll listen to your chest now."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 287.33,
      "end_seconds": 295.22,
      "duration_seconds": 7.89,
      "text": "The memory test score is a little low today and the rest of the neurological check is normal."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 300.84,
      "end_seconds": 303.61,
      "duration_seconds": 2.77,
      "text": "that's all I needed to check"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 311.4,
      "end_seconds": 344.53,
      "duration_seconds": 33.13,
      "text": "Okay, so my impression is this: My working impression is a gradual memory problem that needs further assessment. We shouldn't forget a vitamin deficiency. I think blood tests makes sense here, for memory loss. I think a brain scan makes sense here, for memory loss. I'll request a memory test, it'll help with memory loss. That will help us see what's going on underneath and decide the next step."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 346.23,
      "end_seconds": 371.09,
      "duration_seconds": 24.86,
      "text": "Keep a daily routine and write things down, a notebook by the door works well. I'm going to send a referral to the older adults' assessment service. Please don't wait if you become suddenly confused. That's when to be seen urgently. We'll catch up in six weeks. So, I think we're done unless you have questions."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 372.34,
      "end_seconds": 376.2,
      "duration_seconds": 3.86,
      "text": "right, I'll do that. Thank you, doctor"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 376.9,
      "end_seconds": 378.27,
      "duration_seconds": 1.37,
      "text": "Look after yourself."
    }
  ]
}