{
  "schema_version": "1.0",
  "encounter_id": "20167",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.36,
      "end_seconds": 4.34,
      "duration_seconds": 2.98,
      "text": "Morning, doctor. Lovely to meet you."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.45,
      "end_seconds": 10.19,
      "duration_seconds": 4.74,
      "text": "You're alright, take a seat. What can I do for you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 14.48,
      "end_seconds": 20.51,
      "duration_seconds": 6.03,
      "text": "hello, doctor i'm here with them in case I can help"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 22.61,
      "end_seconds": 26.86,
      "duration_seconds": 4.25,
      "text": "that's fine, sit down we'll go through it together"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 27.38,
      "end_seconds": 30.42,
      "duration_seconds": 3.04,
      "text": "I've been losing weight without trying"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 31.8,
      "end_seconds": 35.62,
      "duration_seconds": 3.82,
      "text": "how many days or weeks has it been?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 36.6,
      "end_seconds": 46.01,
      "duration_seconds": 9.41,
      "text": "I've had it for four weeks. I'd rather not end up on lots of tablets if I can avoid it."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 46.89,
      "end_seconds": 49.82,
      "duration_seconds": 2.93,
      "text": "Have you noticed anything else alongside it?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 53.59,
      "end_seconds": 71.2,
      "duration_seconds": 17.61,
      "text": "A dry cough goes along with it, most of the time. The dry cough? That's been for nearly five years. As for dry cough, about a five out of ten. Oh, and a poor appetite."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 78.5,
      "end_seconds": 84.32,
      "duration_seconds": 5.82,
      "text": "let me check a few things. Any blood in the stool or itching?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 85.73,
      "end_seconds": 88.42,
      "duration_seconds": 2.69,
      "text": "No, nothing to report there."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 89.15,
      "end_seconds": 91.23,
      "duration_seconds": 2.08,
      "text": "Have you had any vomiting?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 91.93,
      "end_seconds": 93.54,
      "duration_seconds": 1.61,
      "text": "no, no vomiting"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 94.63,
      "end_seconds": 99.71,
      "duration_seconds": 5.08,
      "text": "Actually, doctor, I did notice vomiting. He doesn't always say."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 100.52,
      "end_seconds": 107.46,
      "duration_seconds": 6.94,
      "text": "No, I don't think I did. Maybe a little, I'm not sure."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 109.4,
      "end_seconds": 117.7,
      "duration_seconds": 8.3,
      "text": "alright, I'll note both what you've said and and what you've noticed any bone pain or difficulty swallowing at all?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 119.77,
      "end_seconds": 121.96,
      "duration_seconds": 2.19,
      "text": "None of those, no."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 124.45,
      "end_seconds": 129.21,
      "duration_seconds": 4.76,
      "text": "Any change in your bowel habit or your stomach generally?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 131.02,
      "end_seconds": 133.06,
      "duration_seconds": 2.04,
      "text": "No, all normal there."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 134.78,
      "end_seconds": 137.58,
      "duration_seconds": 2.8,
      "text": "Any problems with your joints or muscles?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 138.7,
      "end_seconds": 140.34,
      "duration_seconds": 1.64,
      "text": "No, nothing there."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 141.9,
      "end_seconds": 143.88,
      "duration_seconds": 1.98,
      "text": "What about your medical history?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 145.35,
      "end_seconds": 147.08,
      "duration_seconds": 1.73,
      "text": "Yes, high cholesterol."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 148.62,
      "end_seconds": 149.32,
      "duration_seconds": 0.7,
      "text": "Sure."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 150.29,
      "end_seconds": 155.82,
      "duration_seconds": 5.53,
      "text": "I have high blood pressure, for two years. I have epilepsy."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 156.54,
      "end_seconds": 170.59,
      "duration_seconds": 14.05,
      "text": "Right, so high cholesterol and epilepsy are already on your record. We'll keep that in mind today. Right, tell me about your routine, work, habits, that sort of thing."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 172.37,
      "end_seconds": 186.11,
      "duration_seconds": 13.74,
      "text": "I gave up cigarettes last spring. Not much, I mostly stay in these days. I'm a hairdresser, on my feet all day. My partner and our baby."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 194.66,
      "end_seconds": 199.69,
      "duration_seconds": 5.03,
      "text": "Do you react to to any medicines or foods? Any allergies?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 203.92,
      "end_seconds": 205.84,
      "duration_seconds": 1.92,
      "text": "No allergies at all."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 207.85,
      "end_seconds": 214.22,
      "duration_seconds": 6.37,
      "text": "hold on, doctor, I think he reacted to amoxicillin once. I'm not certain, though"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 215.67,
      "end_seconds": 218.19,
      "duration_seconds": 2.52,
      "text": "I, I don't remember that."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 219.14,
      "end_seconds": 225.4,
      "duration_seconds": 6.26,
      "text": "Okay, I'll note both of those. Alright, what's on your current medicine list?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 226.39,
      "end_seconds": 228.93,
      "duration_seconds": 2.54,
      "text": "I take simvastatin, at night."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 230.33,
      "end_seconds": 232.59,
      "duration_seconds": 2.26,
      "text": "How much do you take?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 234.55,
      "end_seconds": 245.16,
      "duration_seconds": 10.61,
      "text": "20 milligrams, I think that's what's on the box. I take something called sodi... sodium valproate, 500 milligrams, maybe, twice a day."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 247.2,
      "end_seconds": 252.28,
      "duration_seconds": 5.08,
      "text": "right, have you got the box or the prescription on you?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 252.87,
      "end_seconds": 254.99,
      "duration_seconds": 2.12,
      "text": "no, it's at home"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 256.62,
      "end_seconds": 259.56,
      "duration_seconds": 2.94,
      "text": "Have you been to to theatre before?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 260.81,
      "end_seconds": 276.79,
      "duration_seconds": 15.98,
      "text": "I had my tonsils removed as a teenager a neighbour of mine said I should see someone about it i didn't want to bother you but it keeps coming back"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 278.88,
      "end_seconds": 280.87,
      "duration_seconds": 1.99,
      "text": "I'll do your observations first."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 292.85,
      "end_seconds": 295.24,
      "duration_seconds": 2.39,
      "text": "Nearly done with the readings..."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 314.19,
      "end_seconds": 320.59,
      "duration_seconds": 6.4,
      "text": "okay: oxygen saturation is 99 percent, temperature 36.8, pulse 73, pressure 125 over 71."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 321.14,
      "end_seconds": 323.42,
      "duration_seconds": 2.28,
      "text": "Is that alright, doctor?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 324.46,
      "end_seconds": 328.07,
      "duration_seconds": 3.61,
      "text": "Don't worry, we'll discuss it in a second."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 329.25,
      "end_seconds": 333.31,
      "duration_seconds": 4.06,
      "text": "Could you come over to the couch, please?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 335.09,
      "end_seconds": 337.81,
      "duration_seconds": 2.72,
      "text": "Take a deep breath for me."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 347.41,
      "end_seconds": 353.67,
      "duration_seconds": 6.26,
      "text": "I can feel a couple of small glands in your neck, not tender."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 355.22,
      "end_seconds": 357.44,
      "duration_seconds": 2.22,
      "text": "Hold that for a second."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 367.21,
      "end_seconds": 371.99,
      "duration_seconds": 4.78,
      "text": "Your tummy is soft and I can't feel any lumps."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 374.06,
      "end_seconds": 376.01,
      "duration_seconds": 1.95,
      "text": "Please sit back down."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 390.3,
      "end_seconds": 407.11,
      "duration_seconds": 16.81,
      "text": "I'm going to order a chest X-ray, for cough and weight loss. Blood tests is what I'd like next, for weight loss. Weigh yourself once a week at the same time and note it down."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 407.7,
      "end_seconds": 426.49,
      "duration_seconds": 18.79,
      "text": "Hm, okay. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose. Please come and see me after the results are back. Does all of that make sense?"
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 427.37,
      "end_seconds": 430.04,
      "duration_seconds": 2.67,
      "text": "Well, thank you, doctor, goodbye."
    }
  ]
}