{
  "schema_version": "1.0",
  "encounter_id": "20425",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 0.95,
      "end_seconds": 5.14,
      "duration_seconds": 4.19,
      "text": "Morning, doctor. I've settled them in, ready when you are."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.66,
      "end_seconds": 8.77,
      "duration_seconds": 3.11,
      "text": "Thank you. Right, hello, what's the problem?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 9.72,
      "end_seconds": 15.84,
      "duration_seconds": 6.12,
      "text": "Well, hello, doctor. I'm here with them in case I can help."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 17.03,
      "end_seconds": 22.73,
      "duration_seconds": 5.7,
      "text": "Um, so... a fluttering in my chest. That's why I came."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 24.42,
      "end_seconds": 28.12,
      "duration_seconds": 3.7,
      "text": "How many days or weeks has it been?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 29.94,
      "end_seconds": 32.27,
      "duration_seconds": 2.33,
      "text": "It's been three weeks now."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 33.5,
      "end_seconds": 36.86,
      "duration_seconds": 3.36,
      "text": "How strong would you say it is?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 37.36,
      "end_seconds": 38.41,
      "duration_seconds": 1.05,
      "text": "Severe, really."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 38.9,
      "end_seconds": 45.69,
      "duration_seconds": 6.79,
      "text": "And the other thing I wanted to mention is that I can't really—"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 45.79,
      "end_seconds": 51.71,
      "duration_seconds": 5.92,
      "text": "Tell the doctor about the other thing, that's what worries me."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 53.71,
      "end_seconds": 56.12,
      "duration_seconds": 2.41,
      "text": "I was getting to that!"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 56.76,
      "end_seconds": 61.05,
      "duration_seconds": 4.29,
      "text": "Any being short of breath during an episode as well?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 62.62,
      "end_seconds": 67.06,
      "duration_seconds": 4.44,
      "text": "Hmm, yes, about the same, six months."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 67.8,
      "end_seconds": 70.59,
      "duration_seconds": 2.79,
      "text": "How often do you get it?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 71.53,
      "end_seconds": 75.27,
      "duration_seconds": 3.74,
      "text": "It happens a couple of times a week."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 76.6,
      "end_seconds": 83.13,
      "duration_seconds": 6.53,
      "text": "Have you had a fluttering in your chest before, or is this the first time?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 85.03,
      "end_seconds": 92.0,
      "duration_seconds": 6.97,
      "text": "I had a similar thing a couple of years ago. It went away."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 101.36,
      "end_seconds": 106.53,
      "duration_seconds": 5.17,
      "text": "Let me check a few things. Any weight loss or sweating?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 112.45,
      "end_seconds": 124.84,
      "duration_seconds": 12.39,
      "text": "No, no weight loss, no sweating. I did have my heart racing at one point, but that went away on its own."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 126.24,
      "end_seconds": 129.81,
      "duration_seconds": 3.57,
      "text": "And what about leg swelling, tremor or fainting?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 130.97,
      "end_seconds": 135.98,
      "duration_seconds": 5.01,
      "text": "No leg swelling, tremor or fainting, none of it."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 136.66,
      "end_seconds": 139.23,
      "duration_seconds": 2.57,
      "text": "How are your bowels, any trouble?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 139.81,
      "end_seconds": 142.18,
      "duration_seconds": 2.37,
      "text": "No, all normal there."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 143.15,
      "end_seconds": 146.83,
      "duration_seconds": 3.68,
      "text": "Let me ask about allergies, anything at all?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 148.19,
      "end_seconds": 158.3,
      "duration_seconds": 10.11,
      "text": "I think I reacted to some antibiotic once, years ago. I don't remember which one, or what happened exactly."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 159.77,
      "end_seconds": 162.03,
      "duration_seconds": 2.26,
      "text": "Tell me your medicines, please."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 164.75,
      "end_seconds": 174.98,
      "duration_seconds": 10.23,
      "text": "Valsartan, 80 milligrams, once a day. Glycomet, 500 milligrams, twice a day. Thyroxine, 75 micrograms, every morning."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 176.47,
      "end_seconds": 183.51,
      "duration_seconds": 7.04,
      "text": "He is supposed to take it every morning, but I can't say he always does."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 184.62,
      "end_seconds": 193.59,
      "duration_seconds": 8.97,
      "text": "It's naproxen, 250 milligrams, twice a day. I had glimepiride at one point, but I'm off it now."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 194.54,
      "end_seconds": 196.8,
      "duration_seconds": 2.26,
      "text": "Alright, and alcohol, how much?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 198.22,
      "end_seconds": 201.36,
      "duration_seconds": 3.14,
      "text": "I only drink at family occasions."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 202.72,
      "end_seconds": 203.94,
      "duration_seconds": 1.22,
      "text": "Do you smoke?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 205.29,
      "end_seconds": 209.25,
      "duration_seconds": 3.96,
      "text": "I smoke roughly a pack every two days."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 210.74,
      "end_seconds": 212.89,
      "duration_seconds": 2.15,
      "text": "Tell me about your eating."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 214.63,
      "end_seconds": 219.81,
      "duration_seconds": 5.18,
      "text": "I drink a lot of tea and snack through the day."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 220.61,
      "end_seconds": 222.28,
      "duration_seconds": 1.67,
      "text": "How active are you?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 223.12,
      "end_seconds": 226.82,
      "duration_seconds": 3.7,
      "text": "I hardly move around during the day."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 227.95,
      "end_seconds": 231.32,
      "duration_seconds": 3.37,
      "text": "Is there anything relevant on the family side?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 231.99,
      "end_seconds": 236.86,
      "duration_seconds": 4.87,
      "text": "My mother had a stroke. My grandmother had dementia."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 239.63,
      "end_seconds": 242.37,
      "duration_seconds": 2.74,
      "text": "Do you have any long-term conditions?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 243.65,
      "end_seconds": 246.45,
      "duration_seconds": 2.8,
      "text": "I've got high blood pressure."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 247.95,
      "end_seconds": 249.42,
      "duration_seconds": 1.47,
      "text": "Yes, carry on."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 250.42,
      "end_seconds": 256.13,
      "duration_seconds": 5.71,
      "text": "I've got diabetes. I have an underactive thyroid, for five years."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 256.71,
      "end_seconds": 258.3,
      "duration_seconds": 1.59,
      "text": "Is there anything more?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 258.94,
      "end_seconds": 263.64,
      "duration_seconds": 4.7,
      "text": "I have arthritis in my knees, for two years."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 264.95,
      "end_seconds": 271.91,
      "duration_seconds": 6.96,
      "text": "Yes, arthritis in your knees is known to us, good to have that clear."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 273.2,
      "end_seconds": 282.03,
      "duration_seconds": 8.83,
      "text": "Okay, so the vitals from earlier. Pulse 108, saturation 99 percent, blood pressure 135 over 76. Temperature 36.9."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 282.58,
      "end_seconds": 283.9,
      "duration_seconds": 1.32,
      "text": "Good, thank you."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 285.01,
      "end_seconds": 289.4,
      "duration_seconds": 4.39,
      "text": "I'll need to examine you for this, it won't take long."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 295.29,
      "end_seconds": 296.52,
      "duration_seconds": 1.23,
      "text": "Okay, doctor."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 298.27,
      "end_seconds": 299.84,
      "duration_seconds": 1.57,
      "text": "Let me feel here."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 318.27,
      "end_seconds": 321.59,
      "duration_seconds": 3.32,
      "text": "Heart sounds are normal with no murmur."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 323.45,
      "end_seconds": 325.26,
      "duration_seconds": 1.81,
      "text": "Let me feel here."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 337.61,
      "end_seconds": 341.98,
      "duration_seconds": 4.37,
      "text": "The pulse is irregular, around ninety beats a minute."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 344.09,
      "end_seconds": 354.36,
      "duration_seconds": 10.27,
      "text": "Good, you can sit up again. Having listened and examined, it points towards paroxysmal palpitations, possibly an atrial arrhythmia. Another possibility is anxiety-related palpitations."
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 369.64,
      "end_seconds": 373.46,
      "duration_seconds": 3.82,
      "text": "I've already done an ECG, it's ready for you."
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 375.22,
      "end_seconds": 412.34,
      "duration_seconds": 37.12,
      "text": "Thanks, that helps. I'll request a thyroid test, it'll help with palpitations. I want a heart monitor for a few days done, that's for palpitations. For this, bisoprolol, 2.5 milligrams, once a day, until review. It's for heart rate control. Cut right back on coffee, tea and energy drinks for now. Try to keep a simple diary of when it happens and what you were doing, and bring it to the next visit."
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 413.45,
      "end_seconds": 422.77,
      "duration_seconds": 9.32,
      "text": "If you faint or get chest pain with the racing, or you feel really unwell, please come to the emergency department."
    },
    {
      "segment_id": "SEG0059",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 424.49,
      "end_seconds": 426.69,
      "duration_seconds": 2.2,
      "text": "That's fine by me."
    },
    {
      "segment_id": "SEG0060",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 427.54,
      "end_seconds": 434.22,
      "duration_seconds": 6.68,
      "text": "Please come and see me in three weeks. Does all of that make sense?"
    },
    {
      "segment_id": "SEG0061",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 435.89,
      "end_seconds": 438.21,
      "duration_seconds": 2.32,
      "text": "Alright, thanks, take care."
    },
    {
      "segment_id": "SEG0062",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 440.22,
      "end_seconds": 442.25,
      "duration_seconds": 2.03,
      "text": "Okay, look after yourself."
    }
  ]
}