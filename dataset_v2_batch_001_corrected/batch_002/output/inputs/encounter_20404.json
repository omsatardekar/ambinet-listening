{
  "schema_version": "1.0",
  "encounter_id": "20404",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 1.1,
      "end_seconds": 7.24,
      "duration_seconds": 6.14,
      "text": "All set here, doctor. Chart's updated, and I'll read the readings out when you're ready."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 9.09,
      "end_seconds": 14.09,
      "duration_seconds": 5.0,
      "text": "Thanks. Hello, come in, sit down. What brings you in today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 15.95,
      "end_seconds": 24.08,
      "duration_seconds": 8.13,
      "text": "Let me think, mainly I've been feeling shaky and sweaty. That's why I came."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 25.59,
      "end_seconds": 29.12,
      "duration_seconds": 3.53,
      "text": "What's the timeline, when did it begin?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 30.79,
      "end_seconds": 35.18,
      "duration_seconds": 4.39,
      "text": "Yesterday, it came on out of nowhere."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 37.22,
      "end_seconds": 42.98,
      "duration_seconds": 5.76,
      "text": "Is it there all the time or does it come and go?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 45.77,
      "end_seconds": 55.52,
      "duration_seconds": 9.75,
      "text": "I'd say a few times a day. Oh, and headaches. I've been feeling confused at times too."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 56.47,
      "end_seconds": 73.17,
      "duration_seconds": 16.7,
      "text": "Here are the numbers, doctor. Temp 36.8 degrees, height 174 centimetres, weight 67 kilos. Blood pressure 118 over 79, pulse is 78 beats a minute, BMI works out to 22.1, SpO2 99 percent on room air."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 74.17,
      "end_seconds": 75.53,
      "duration_seconds": 1.36,
      "text": "Good, thank you."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 77.38,
      "end_seconds": 80.33,
      "duration_seconds": 2.95,
      "text": "Okay, time for me to examine you."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 81.7,
      "end_seconds": 83.43,
      "duration_seconds": 1.73,
      "text": "Let me feel here."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 94.91,
      "end_seconds": 100.59,
      "duration_seconds": 5.68,
      "text": "Your fingerprick sugar now is normal and your heart rate is steady."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 104.47,
      "end_seconds": 109.48,
      "duration_seconds": 5.01,
      "text": "You can relax now. A few quick ones: vomiting or slurred speech?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 111.99,
      "end_seconds": 116.8,
      "duration_seconds": 4.81,
      "text": "No vomiting or slurred speech, none of it."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 117.12,
      "end_seconds": 120.84,
      "duration_seconds": 3.72,
      "text": "Understood. Any chest pain, blurred vision or seizure?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 121.86,
      "end_seconds": 125.82,
      "duration_seconds": 3.96,
      "text": "No, um, I'd have said so."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 126.93,
      "end_seconds": 129.83,
      "duration_seconds": 2.9,
      "text": "Any problems with your joints or muscles?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 131.82,
      "end_seconds": 134.76,
      "duration_seconds": 2.94,
      "text": "Um, I move fine otherwise."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 152.87,
      "end_seconds": 155.87,
      "duration_seconds": 3.0,
      "text": "Any past operations I should know about?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 156.99,
      "end_seconds": 162.27,
      "duration_seconds": 5.28,
      "text": "Just a meniscus repair on my knee, four years ago."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 164.07,
      "end_seconds": 166.51,
      "duration_seconds": 2.44,
      "text": "Any regular medication at all?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 167.7,
      "end_seconds": 169.01,
      "duration_seconds": 1.31,
      "text": "No, none."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 170.99,
      "end_seconds": 174.83,
      "duration_seconds": 3.84,
      "text": "Any health conditions I should have on record?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 178.21,
      "end_seconds": 184.58,
      "duration_seconds": 6.37,
      "text": "Let me think, I've had kidney disease for two years now."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 185.38,
      "end_seconds": 186.08,
      "duration_seconds": 0.7,
      "text": "Understood."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 187.97,
      "end_seconds": 190.14,
      "duration_seconds": 2.17,
      "text": "I've, I've got diabetes."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 196.45,
      "end_seconds": 203.03,
      "duration_seconds": 6.58,
      "text": "Yes, carry on. Yes, kidney disease is known to us, good to have that clear."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 210.47,
      "end_seconds": 215.64,
      "duration_seconds": 5.17,
      "text": "Have you got any known allergies? I'll explain everything as we go along."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 217.1,
      "end_seconds": 220.89,
      "duration_seconds": 3.79,
      "text": "Yes, naproxen. I get stomach pain."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 223.66,
      "end_seconds": 227.22,
      "duration_seconds": 3.56,
      "text": "Right, a few questions about your lifestyle now."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 229.07,
      "end_seconds": 240.58,
      "duration_seconds": 11.51,
      "text": "I grab fast food at lunch most days. I look after my grandchildren most days. I do a yoga class on Thursdays."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 241.1,
      "end_seconds": 248.46,
      "duration_seconds": 7.36,
      "text": "Okay, thinking it through, it fits best with episodes of low blood sugar related to diabetes treatment."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 265.17,
      "end_seconds": 289.86,
      "duration_seconds": 24.69,
      "text": "A home sugar diary is what I'd like next, for hypoglycaemia. I'm going to order blood tests, for low sugar. That will help us see what's going on underneath and decide the next step. Never skip meals when you take the sugar tablet, and keep glucose tablets or juice with you."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 290.39,
      "end_seconds": 313.73,
      "duration_seconds": 23.34,
      "text": "Yes, carry on. A short walk every day, even twenty minutes, will help more than you'd think. I'm not ordering an HbA1c today. If things carry on in two weeks, we'll consider it. Come back or go to emergency straight away if you have an episode that does not settle with sugar."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 315.02,
      "end_seconds": 316.74,
      "duration_seconds": 1.72,
      "text": "I'll remember that."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 318.75,
      "end_seconds": 326.04,
      "duration_seconds": 7.29,
      "text": "Please come and see me after the blood tests. That's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 329.08,
      "end_seconds": 333.69,
      "duration_seconds": 4.61,
      "text": "So, good, thanks, I'll see you then."
    }
  ]
}