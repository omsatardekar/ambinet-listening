{
  "schema_version": "1.0",
  "encounter_id": "20177",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.82,
      "end_seconds": 2.69,
      "duration_seconds": 1.87,
      "text": "Evening. Let's get started."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 4.53,
      "end_seconds": 8.91,
      "duration_seconds": 4.38,
      "text": "Okay, so hello, thanks for fitting me in."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 14.92,
      "end_seconds": 19.6,
      "duration_seconds": 4.68,
      "text": "Doctor, you know, thank you for seeing us."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 21.13,
      "end_seconds": 23.83,
      "duration_seconds": 2.7,
      "text": "Start wherever you like, I'm listening."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 24.89,
      "end_seconds": 36.25,
      "duration_seconds": 11.36,
      "text": "Yeah, uh, it's burning pain in the upper tummy, doctor. He didn't want to come, but I insisted."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 36.48,
      "end_seconds": 39.66,
      "duration_seconds": 3.18,
      "text": "Yes. How often do you get it?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 45.36,
      "end_seconds": 48.88,
      "duration_seconds": 3.52,
      "text": "Honestly, a few times a day."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 50.46,
      "end_seconds": 53.06,
      "duration_seconds": 2.6,
      "text": "Right, have you had mild nausea?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 54.3,
      "end_seconds": 58.81,
      "duration_seconds": 4.51,
      "text": "Let me think, yes, for about a week."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 60.23,
      "end_seconds": 62.59,
      "duration_seconds": 2.36,
      "text": "How frequently does it come?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 64.44,
      "end_seconds": 83.79,
      "duration_seconds": 19.35,
      "text": "It's all the time. As for belching, I honestly can't say when that began. It might have been last month or the month before. I've also been feeling full quickly, for about four days."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_4",
      "role": "NURSE",
      "start_seconds": 85.39,
      "end_seconds": 99.04,
      "duration_seconds": 13.65,
      "text": "Okay, so the vitals from earlier. Blood pressure 126 over 74, temperature 36.7, pulse is 82 beats a minute, SpO2 98 percent on room air, respiratory rate 16."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 100.39,
      "end_seconds": 101.09,
      "duration_seconds": 0.7,
      "text": "Thanks."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 103.58,
      "end_seconds": 105.8,
      "duration_seconds": 2.22,
      "text": "Shall I start the examination?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 107.51,
      "end_seconds": 109.83,
      "duration_seconds": 2.32,
      "text": "Okay, um, doctor."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 111.26,
      "end_seconds": 114.63,
      "duration_seconds": 3.37,
      "text": "Stay as you are for a moment."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 130.23,
      "end_seconds": 134.99,
      "duration_seconds": 4.76,
      "text": "Your tummy is soft with some tenderness in the upper middle part."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 138.66,
      "end_seconds": 141.08,
      "duration_seconds": 2.42,
      "text": "That's all I needed to check."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 158.54,
      "end_seconds": 162.4,
      "duration_seconds": 3.86,
      "text": "Did you get black stools, jaundice or vomiting blood?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 163.42,
      "end_seconds": 168.68,
      "duration_seconds": 5.26,
      "text": "I haven't had black stools, jaundice or vomiting blood, no."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 170.51,
      "end_seconds": 172.31,
      "duration_seconds": 1.8,
      "text": "Nothing like difficulty swallowing?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 173.41,
      "end_seconds": 175.43,
      "duration_seconds": 2.02,
      "text": "No. No difficulty swallowing."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 177.41,
      "end_seconds": 181.12,
      "duration_seconds": 3.71,
      "text": "How about your heart, any problems like that?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 182.81,
      "end_seconds": 184.48,
      "duration_seconds": 1.67,
      "text": "Nothing like that."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 185.55,
      "end_seconds": 188.44,
      "duration_seconds": 2.89,
      "text": "Alright, your breathing, any trouble there?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 189.62,
      "end_seconds": 192.41,
      "duration_seconds": 2.79,
      "text": "No, my breathing's been fine."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 193.82,
      "end_seconds": 197.53,
      "duration_seconds": 3.71,
      "text": "Are you taking anything regularly, including from the pharmacy?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 198.32,
      "end_seconds": 215.05,
      "duration_seconds": 16.73,
      "text": "Let me think, I take naproxen, 250 milligrams, twice a day. I'm not great at remembering details, so bear with me. I took the morning off to come in today."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 215.61,
      "end_seconds": 216.47,
      "duration_seconds": 0.86,
      "text": "I follow."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 217.98,
      "end_seconds": 235.27,
      "duration_seconds": 17.29,
      "text": "Lansoprazole. I take it 30 milligrams, before breakfast. I did try to ignore it for a while. I take tamsulosin, 0.4 milligrams, maybe, at night for the prostate."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 237.23,
      "end_seconds": 241.98,
      "duration_seconds": 4.75,
      "text": "Alright, have you got the box or the prescription on you?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 243.94,
      "end_seconds": 249.61,
      "duration_seconds": 5.67,
      "text": "Not with me. I'll bring it next time. Antacid, when needed."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 250.54,
      "end_seconds": 253.27,
      "duration_seconds": 2.73,
      "text": "Does your family have any medical conditions?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 256.3,
      "end_seconds": 262.05,
      "duration_seconds": 5.75,
      "text": "Well, my brother has epilepsy. My father had bowel cancer."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 265.76,
      "end_seconds": 268.15,
      "duration_seconds": 2.39,
      "text": "Have you ever had an operation?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 269.69,
      "end_seconds": 275.94,
      "duration_seconds": 6.25,
      "text": "Yes, I had a meniscus repair on my knee, four years ago."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 277.99,
      "end_seconds": 282.29,
      "duration_seconds": 4.3,
      "text": "Tell me about any past illnesses or ongoing conditions."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 283.31,
      "end_seconds": 302.71,
      "duration_seconds": 19.4,
      "text": "Uh, uh, I've had arthritis in my knees for about a year now. Actually, I've had acid reflux for about ten years now. I've, I've had an enlarged prostate, yes."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 303.63,
      "end_seconds": 307.32,
      "duration_seconds": 3.69,
      "text": "Let me ask about allergies, anything at all?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 308.35,
      "end_seconds": 312.4,
      "duration_seconds": 4.05,
      "text": "Well, um, I've never had an allergy."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 314.01,
      "end_seconds": 320.36,
      "duration_seconds": 6.35,
      "text": "I'm not sure that's right. I seem to recall a problem with diclofenac."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 322.24,
      "end_seconds": 325.94,
      "duration_seconds": 3.7,
      "text": "Erm, really? I don't think so."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 326.58,
      "end_seconds": 331.94,
      "duration_seconds": 5.36,
      "text": "Okay, I'll note both of those. Now some background about your lifestyle."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 333.4,
      "end_seconds": 349.72,
      "duration_seconds": 16.32,
      "text": "I only drink at family occasions. My husband and I live above the shop. Lots of rice, lentils and some fruit. I'm a plumber, lots of bending and kneeling."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 368.13,
      "end_seconds": 376.89,
      "duration_seconds": 8.76,
      "text": "Having listened and examined, my working impression is dyspepsia possibly related to anti-inflammatory tablets. I'd also keep a stomach ulcer in mind."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 384.05,
      "end_seconds": 417.97,
      "duration_seconds": 33.92,
      "text": "Let's book blood tests to look into dyspepsia. A test for the stomach germ is what I'd like next, for dyspepsia. Please stop taking the anti-inflammatory tablets for now and use paracetamol for the pain. Try to keep a simple diary of when it happens and what you were doing, and bring it to the next visit. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 423.56,
      "end_seconds": 424.78,
      "duration_seconds": 1.22,
      "text": "I understand."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 426.65,
      "end_seconds": 439.01,
      "duration_seconds": 12.36,
      "text": "I'd like to see you again in four weeks. Can you tell me the plan back in your own words, so I know I've explained it clearly?"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 439.89,
      "end_seconds": 445.02,
      "duration_seconds": 5.13,
      "text": "So, I come back in four weeks. Is that right?"
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 445.99,
      "end_seconds": 449.87,
      "duration_seconds": 3.88,
      "text": "Yes, exactly right. Have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 450.52,
      "end_seconds": 454.19,
      "duration_seconds": 3.67,
      "text": "Right, I'll do that. Thank you, doctor."
    }
  ]
}