{
  "schema_version": "1.0",
  "encounter_id": "20395",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.61,
      "end_seconds": 6.32,
      "duration_seconds": 5.71,
      "text": "Hi, um, is it okay to come in now?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.75,
      "end_seconds": 13.13,
      "duration_seconds": 4.38,
      "text": "Not at all, please sit. What seems to be wrong?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 17.33,
      "end_seconds": 27.46,
      "duration_seconds": 10.13,
      "text": "Um, you know, so... watery diarrhoea. That's why I came. I'd rather know what's going on than keep guessing."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 29.54,
      "end_seconds": 31.51,
      "duration_seconds": 1.97,
      "text": "Let's run through your medicines."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 33.57,
      "end_seconds": 40.82,
      "duration_seconds": 7.25,
      "text": "Right, it's lisinopril, 10 milligrams, maybe, once a day for my pressure."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 41.77,
      "end_seconds": 45.95,
      "duration_seconds": 4.18,
      "text": "Do you have the packet or the prescription with you?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 47.27,
      "end_seconds": 58.61,
      "duration_seconds": 11.34,
      "text": "No, it's at home. Sorry, what was I saying, I used to take losartan, but I stopped it."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 60.51,
      "end_seconds": 63.59,
      "duration_seconds": 3.08,
      "text": "How long has this been bothering you?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 64.71,
      "end_seconds": 68.07,
      "duration_seconds": 3.36,
      "text": "Well, for ten days, I'd say."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 72.98,
      "end_seconds": 75.49,
      "duration_seconds": 2.51,
      "text": "Is it worse at certain times?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 76.01,
      "end_seconds": 94.85,
      "duration_seconds": 18.84,
      "text": "It's worse with eating. Erm, I've also been feeling dehydrated, for two weeks. As for feeling dehydrated, it settles a little with drinking water. Let me think, there was cramping tummy pain, yes, but that went away."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 96.34,
      "end_seconds": 101.91,
      "duration_seconds": 5.57,
      "text": "Okay, have you had watery diarrhoea before, or is this the first time?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 102.98,
      "end_seconds": 112.79,
      "duration_seconds": 9.81,
      "text": "Yes, uh, something like this happened about six months ago, and it went away on its own."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 125.7,
      "end_seconds": 131.05,
      "duration_seconds": 5.35,
      "text": "Did you get dizziness, severe abdominal pain, blood in the stool or confusion?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 132.12,
      "end_seconds": 140.55,
      "duration_seconds": 8.43,
      "text": "I haven't had dizziness, severe abdominal pain, blood in the stool or confusion, no."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 142.3,
      "end_seconds": 145.13,
      "duration_seconds": 2.83,
      "text": "Any muscle or joint problems besides this?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 146.1,
      "end_seconds": 147.66,
      "duration_seconds": 1.56,
      "text": "Nothing else aches."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 148.34,
      "end_seconds": 150.6,
      "duration_seconds": 2.26,
      "text": "Your breathing, any trouble there?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 152.11,
      "end_seconds": 153.21,
      "duration_seconds": 1.1,
      "text": "Breathing's normal."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 154.9,
      "end_seconds": 156.65,
      "duration_seconds": 1.75,
      "text": "And alcohol, how much?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 158.6,
      "end_seconds": 164.79,
      "duration_seconds": 6.19,
      "text": "I used to drink heavily but I stopped four years ago."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 165.4,
      "end_seconds": 166.71,
      "duration_seconds": 1.31,
      "text": "Do you smoke?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 167.57,
      "end_seconds": 171.18,
      "duration_seconds": 3.61,
      "text": "No, I've never smoked in my life."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 171.94,
      "end_seconds": 174.01,
      "duration_seconds": 2.07,
      "text": "Do you do any exercise?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 175.64,
      "end_seconds": 178.58,
      "duration_seconds": 2.94,
      "text": "I swim twice a week."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 183.1,
      "end_seconds": 185.23,
      "duration_seconds": 2.13,
      "text": "Do you live by yourself?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 187.31,
      "end_seconds": 191.79,
      "duration_seconds": 4.48,
      "text": "No, I share a house with my brother."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 195.97,
      "end_seconds": 200.12,
      "duration_seconds": 4.15,
      "text": "What does a normal day of food look like?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 201.64,
      "end_seconds": 205.19,
      "duration_seconds": 3.55,
      "text": "Lots of rice, lentils and some fruit."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 217.04,
      "end_seconds": 220.3,
      "duration_seconds": 3.26,
      "text": "Is there anything relevant on the family side?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 221.12,
      "end_seconds": 224.26,
      "duration_seconds": 3.14,
      "text": "My mother has an underactive thyroid."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 225.09,
      "end_seconds": 228.32,
      "duration_seconds": 3.23,
      "text": "Has anyone ever diagnosed you with something?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 230.29,
      "end_seconds": 234.87,
      "duration_seconds": 4.58,
      "text": "I have high blood pressure, for about ten years."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 236.02,
      "end_seconds": 244.23,
      "duration_seconds": 8.21,
      "text": "Okay, I can see high blood pressure in your file as well. Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 245.32,
      "end_seconds": 249.88,
      "duration_seconds": 4.56,
      "text": "Um, no, I've never been operated on."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 250.98,
      "end_seconds": 253.67,
      "duration_seconds": 2.69,
      "text": "Have you got any known allergies?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 254.48,
      "end_seconds": 257.66,
      "duration_seconds": 3.18,
      "text": "Yes, tramadol, it gives me vomiting."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 258.62,
      "end_seconds": 261.13,
      "duration_seconds": 2.51,
      "text": "Let me take your readings now."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 273.97,
      "end_seconds": 276.8,
      "duration_seconds": 2.83,
      "text": "That's it, just a little longer..."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 298.11,
      "end_seconds": 307.2,
      "duration_seconds": 9.09,
      "text": "Okay: temperature is 38.5 degrees, pulse 101. And pressure 124 over 72, oxygen saturation is 98 percent."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 308.02,
      "end_seconds": 309.75,
      "duration_seconds": 1.73,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 311.11,
      "end_seconds": 313.68,
      "duration_seconds": 2.57,
      "text": "That's fine, I'll explain it soon."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 315.38,
      "end_seconds": 319.91,
      "duration_seconds": 4.53,
      "text": "I'll need to examine you for this, it won't take long."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 321.11,
      "end_seconds": 323.92,
      "duration_seconds": 2.81,
      "text": "Take a deep breath for me."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 340.3,
      "end_seconds": 346.85,
      "duration_seconds": 6.55,
      "text": "Your mouth is a bit dry and your tummy is soft with mild tenderness all over."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 349.79,
      "end_seconds": 351.38,
      "duration_seconds": 1.59,
      "text": "That's the examination finished."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 363.57,
      "end_seconds": 382.94,
      "duration_seconds": 19.37,
      "text": "I'm sending you for blood tests because of dehydration. A stool test is what I'd like next, for diarrhoea. I'm going to put you on oral rehydration salts, 1 sachet, after each loose stool, for three days. That's for dehydration."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 383.5,
      "end_seconds": 385.3,
      "duration_seconds": 1.8,
      "text": "That's simple enough."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 386.15,
      "end_seconds": 413.43,
      "duration_seconds": 27.28,
      "text": "Small sips often are better than large drinks, and eat plain food as soon as you can. Try to get to bed and wake up at the same time each day, and keep your phone away from the bed. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 414.82,
      "end_seconds": 416.49,
      "duration_seconds": 1.67,
      "text": "Alright, I follow."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 417.49,
      "end_seconds": 428.75,
      "duration_seconds": 11.26,
      "text": "If you see blood in the stool or cannot keep fluids down, that's the point to come in urgently. Please come and see me after the stool result."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 430.51,
      "end_seconds": 434.75,
      "duration_seconds": 4.24,
      "text": "I, I'll book it on my way out."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 436.54,
      "end_seconds": 439.49,
      "duration_seconds": 2.95,
      "text": "That's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 440.88,
      "end_seconds": 446.7,
      "duration_seconds": 5.82,
      "text": "Sorry, um, what was I saying, thank you, doctor, goodbye."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 448.0,
      "end_seconds": 449.23,
      "duration_seconds": 1.23,
      "text": "All the best."
    }
  ]
}