{
  "schema_version": "1.0",
  "encounter_id": "20007",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.82,
      "end_seconds": 3.63,
      "duration_seconds": 2.81,
      "text": "Hello, doctor. May I come in?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 4.5,
      "end_seconds": 8.19,
      "duration_seconds": 3.69,
      "text": "Come in. Please sit. How can I help you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 10.0,
      "end_seconds": 14.96,
      "duration_seconds": 4.96,
      "text": "Hello, doctor. I'm here with them in case I can help."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 16.61,
      "end_seconds": 27.87,
      "duration_seconds": 11.26,
      "text": "I wanted to get a dry cough looked at. I wasn't sure whether to come in at all, um, to be honest."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 29.46,
      "end_seconds": 32.71,
      "duration_seconds": 3.25,
      "text": "How long has it been like this?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 33.92,
      "end_seconds": 38.62,
      "duration_seconds": 4.7,
      "text": "Ah, it's been five days, I'm fairly sure."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 43.09,
      "end_seconds": 53.37,
      "duration_seconds": 10.28,
      "text": "Tell me a bit more about it: how bad it gets, how often, and whether anything makes it better or worse."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 54.03,
      "end_seconds": 64.04,
      "duration_seconds": 10.01,
      "text": "It comes and goes. I'd call it severe. It's a relief to finally sit down and talk about it."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 64.68,
      "end_seconds": 71.02,
      "duration_seconds": 6.34,
      "text": "And the other thing I wanted to mention is that I can't really—"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_4",
      "role": "FAMILY_MEMBER",
      "start_seconds": 71.12,
      "end_seconds": 76.46,
      "duration_seconds": 5.34,
      "text": "Tell the doctor about the other thing, that's what worries me."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 78.02,
      "end_seconds": 80.77,
      "duration_seconds": 2.75,
      "text": "I was getting to that!"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 82.23,
      "end_seconds": 84.84,
      "duration_seconds": 2.61,
      "text": "Have you had aching all over?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 86.28,
      "end_seconds": 88.71,
      "duration_seconds": 2.43,
      "text": "Yes, for about four days."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 89.94,
      "end_seconds": 92.98,
      "duration_seconds": 3.04,
      "text": "How strong would you say it is?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 97.06,
      "end_seconds": 103.71,
      "duration_seconds": 6.65,
      "text": "Mild, I'd say. I've also been feeling short of breath, for ten days."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 104.92,
      "end_seconds": 107.14,
      "duration_seconds": 2.22,
      "text": "Any vomiting or chest pain?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 109.02,
      "end_seconds": 120.32,
      "duration_seconds": 11.3,
      "text": "Ah, no, no vomiting, no chest pain. I did have loss of taste at one point, but that went away on its own."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 121.85,
      "end_seconds": 128.11,
      "duration_seconds": 6.26,
      "text": "Let me check a few things. Any leg swelling, diarrhoea or blue lips?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 131.56,
      "end_seconds": 135.76,
      "duration_seconds": 4.2,
      "text": "No, no leg swelling, diarrhoea or blue lips."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 136.6,
      "end_seconds": 140.42,
      "duration_seconds": 3.82,
      "text": "Any pins and needles or loss of strength anywhere?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 142.21,
      "end_seconds": 145.36,
      "duration_seconds": 3.15,
      "text": "I mean, no weakness or anything."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 145.99,
      "end_seconds": 149.11,
      "duration_seconds": 3.12,
      "text": "Anything on the skin I should know about?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 150.97,
      "end_seconds": 153.67,
      "duration_seconds": 2.7,
      "text": "Nothing on the skin, no."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 154.53,
      "end_seconds": 157.27,
      "duration_seconds": 2.74,
      "text": "Are there any illnesses in your family?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 159.1,
      "end_seconds": 161.4,
      "duration_seconds": 2.3,
      "text": "My aunt has rheumatoid arthritis."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 162.24,
      "end_seconds": 164.88,
      "duration_seconds": 2.64,
      "text": "Have you been to theatre before?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 166.18,
      "end_seconds": 170.61,
      "duration_seconds": 4.43,
      "text": "Okay, so just my septum straightened, in my thirties."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 171.41,
      "end_seconds": 175.47,
      "duration_seconds": 4.06,
      "text": "Are you taking anything regularly, including from the pharmacy?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 176.25,
      "end_seconds": 179.06,
      "duration_seconds": 2.81,
      "text": "Glibenclamide, 5 milligrams, before breakfast."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 180.75,
      "end_seconds": 188.78,
      "duration_seconds": 8.03,
      "text": "It's a... um, I can't remember what it's called. It's a round yellow one."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 189.71,
      "end_seconds": 192.18,
      "duration_seconds": 2.47,
      "text": "Do you remember what it's for?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 193.82,
      "end_seconds": 209.39,
      "duration_seconds": 15.57,
      "text": "For my pressure, I believe. My wife sets them out for me, I just take what I'm given. I mean, you know, it's febuxostat, 80 milligrams, once a day for the gout."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 210.13,
      "end_seconds": 220.35,
      "duration_seconds": 10.22,
      "text": "Doctor, I think the last prescription for the febuxostat was 40 milligrams. We changed it at the last visit."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 223.73,
      "end_seconds": 227.05,
      "duration_seconds": 3.32,
      "text": "Alright. Did you bring the up-to-date prescription?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 228.39,
      "end_seconds": 232.31,
      "duration_seconds": 3.92,
      "text": "I don't think I have it with me."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 233.95,
      "end_seconds": 238.39,
      "duration_seconds": 4.44,
      "text": "Anything in your past medical history I should know?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 239.18,
      "end_seconds": 245.75,
      "duration_seconds": 6.57,
      "text": "Yes, diabetes. I've had high blood pressure for nearly five years now."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 247.68,
      "end_seconds": 248.62,
      "duration_seconds": 0.94,
      "text": "Anything else?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 253.66,
      "end_seconds": 275.2,
      "duration_seconds": 21.54,
      "text": "Heart disease, for nearly five years. I'd rather know what's going on than keep guessing. I'm not great at remembering details, so bear with me. I have gout. I told myself I'd wait and see, and here I am."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 275.89,
      "end_seconds": 285.15,
      "duration_seconds": 9.26,
      "text": "Alright, diabetes and high blood pressure, that matches what I have here. Do you react to any medicines or foods? Any allergies?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 285.74,
      "end_seconds": 289.11,
      "duration_seconds": 3.37,
      "text": "No, nothing as far as I know."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_4",
      "role": "FAMILY_MEMBER",
      "start_seconds": 291.2,
      "end_seconds": 297.97,
      "duration_seconds": 6.77,
      "text": "I'm not sure that's right. I seem to recall a problem with tramadol."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 299.45,
      "end_seconds": 302.54,
      "duration_seconds": 3.09,
      "text": "Maybe, but I don't recall it."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 303.91,
      "end_seconds": 308.43,
      "duration_seconds": 4.52,
      "text": "Alright, so that's unclear. I'll record what each of you said."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 321.97,
      "end_seconds": 323.73,
      "duration_seconds": 1.76,
      "text": "Who lives with you?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 324.91,
      "end_seconds": 327.32,
      "duration_seconds": 2.41,
      "text": "My partner and our baby."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 328.93,
      "end_seconds": 332.97,
      "duration_seconds": 4.04,
      "text": "Can I check a few measurements before we carry on?"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 342.1,
      "end_seconds": 344.08,
      "duration_seconds": 1.98,
      "text": "Nearly done with the readings..."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 354.21,
      "end_seconds": 365.08,
      "duration_seconds": 10.87,
      "text": "Okay: temperature is 36.9 degrees, pulse is 94 beats a minute, SpO2 94 percent on room air. And pressure 134 over 74."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 365.76,
      "end_seconds": 368.82,
      "duration_seconds": 3.06,
      "text": "Right, is that alright, doctor?"
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 370.02,
      "end_seconds": 372.52,
      "duration_seconds": 2.5,
      "text": "That's fine, I'll explain it soon."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 374.28,
      "end_seconds": 379.92,
      "duration_seconds": 5.64,
      "text": "Okay, I'll need to examine you for this, it won't take long."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 381.17,
      "end_seconds": 383.42,
      "duration_seconds": 2.25,
      "text": "I'm just checking this side."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 401.02,
      "end_seconds": 410.79,
      "duration_seconds": 9.77,
      "text": "Your chest is clear apart from a few crackles at the right base and your oxygen level is a bit low."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 415.01,
      "end_seconds": 436.21,
      "duration_seconds": 21.2,
      "text": "That's all I needed to check. Having listened and examined, it's hard to say. A viral chest infection with mildly low oxygen is one possibility and a flare of heart failure another, and I'd rather not commit yet. I'd also keep a bacterial pneumonia in mind."
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 443.24,
      "end_seconds": 473.39,
      "duration_seconds": 30.15,
      "text": "I think a viral swab makes sense here, for fever and cough. I'm sending you for a chest X-ray because of low oxygen and crackles. The result will help us decide whether anything more is needed. Rest, keep your fluids up and lie on your tummy or side to help your breathing. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 474.74,
      "end_seconds": 478.62,
      "duration_seconds": 3.88,
      "text": "Yes, you know, I'll bear that in mind."
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 480.56,
      "end_seconds": 484.88,
      "duration_seconds": 4.32,
      "text": "Do get help quickly if you become more breathless or confused."
    },
    {
      "segment_id": "SEG0059",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 486.08,
      "end_seconds": 489.44,
      "duration_seconds": 3.36,
      "text": "I know what to watch for."
    },
    {
      "segment_id": "SEG0060",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 490.02,
      "end_seconds": 492.37,
      "duration_seconds": 2.35,
      "text": "See me again in two days."
    },
    {
      "segment_id": "SEG0061",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 494.11,
      "end_seconds": 496.31,
      "duration_seconds": 2.2,
      "text": "Good, I'll return then."
    },
    {
      "segment_id": "SEG0062",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 497.41,
      "end_seconds": 505.81,
      "duration_seconds": 8.4,
      "text": "Can you tell me the plan back in your own words, so I know I've explained it clearly?"
    },
    {
      "segment_id": "SEG0063",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 507.78,
      "end_seconds": 513.57,
      "duration_seconds": 5.79,
      "text": "So, I come back in two days. Is that right?"
    },
    {
      "segment_id": "SEG0064",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 514.82,
      "end_seconds": 518.79,
      "duration_seconds": 3.97,
      "text": "Yes, exactly right. That's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0065",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 519.71,
      "end_seconds": 523.31,
      "duration_seconds": 3.6,
      "text": "Right, I'll do that. Thank you, doctor."
    }
  ]
}