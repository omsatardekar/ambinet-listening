{
  "schema_version": "1.0",
  "encounter_id": "20416",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.69,
      "end_seconds": 6.42,
      "duration_seconds": 5.73,
      "text": "Hello doctor, sorry, I took a wrong turn on the way here."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 11.85,
      "end_seconds": 16.19,
      "duration_seconds": 4.34,
      "text": "Yes, have a seat. Tell me what's going on."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 16.73,
      "end_seconds": 47.33,
      "duration_seconds": 30.6,
      "text": "Um, so... red eyes in the evening. That's why I came. I'd rather know what's going on than keep guessing. I've had watery eyes too, for about three months. I've had sore, gritty eyes too, for about a year. About sore, gritty eyes, it feels severe to me. I've also had blurred vision after the screen."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 48.94,
      "end_seconds": 62.13,
      "duration_seconds": 13.19,
      "text": "with blurred vision after the screen, maybe a four out of ten on a bad day it's worse with long screen time i get some relief from blinking"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 63.6,
      "end_seconds": 70.38,
      "duration_seconds": 6.78,
      "text": "Alright, have you had red eyes in the evening before, or is this the first time?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 71.16,
      "end_seconds": 77.56,
      "duration_seconds": 6.4,
      "text": "A bit, a couple of years ago. It settled by itself back then."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 86.48,
      "end_seconds": 91.3,
      "duration_seconds": 4.82,
      "text": "Have you had any loss of vision, eye pain or flashing lights?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 93.13,
      "end_seconds": 95.51,
      "duration_seconds": 2.38,
      "text": "None of those, no."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 96.25,
      "end_seconds": 98.38,
      "duration_seconds": 2.13,
      "text": "what about sensitivity to light?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 98.96,
      "end_seconds": 101.75,
      "duration_seconds": 2.79,
      "text": "definitely no sensitivity to light"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 102.95,
      "end_seconds": 105.62,
      "duration_seconds": 2.67,
      "text": "Okay, is your mobility otherwise okay?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 106.96,
      "end_seconds": 109.32,
      "duration_seconds": 2.36,
      "text": "oh, I move fine otherwise"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 114.42,
      "end_seconds": 118.52,
      "duration_seconds": 4.1,
      "text": "Any pins and needles or loss of strength anywhere?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 119.3,
      "end_seconds": 121.44,
      "duration_seconds": 2.14,
      "text": "No, nothing like that."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 123.08,
      "end_seconds": 126.68,
      "duration_seconds": 3.6,
      "text": "Any health conditions I should have on record?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 128.76,
      "end_seconds": 137.54,
      "duration_seconds": 8.78,
      "text": "I've got eczema i've got an underactive thyroid it's a relief to finally sit down and talk about it"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 138.86,
      "end_seconds": 142.01,
      "duration_seconds": 3.15,
      "text": "does your family have any medical conditions?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 144.0,
      "end_seconds": 149.66,
      "duration_seconds": 5.66,
      "text": "well, my father had bowel cancer. My mother has an underactive thyroid"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 168.65,
      "end_seconds": 173.86,
      "duration_seconds": 5.21,
      "text": "Alright, has anything ever caused you a reaction? I mean any allergies."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 174.82,
      "end_seconds": 178.82,
      "duration_seconds": 4.0,
      "text": "Walnuts i come out in... well, hives"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 179.51,
      "end_seconds": 183.04,
      "duration_seconds": 3.53,
      "text": "Alright, have you been to theatre before?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 184.7,
      "end_seconds": 189.64,
      "duration_seconds": 4.94,
      "text": "Just keyhole surgery on my gallbladder, two years back."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 190.31,
      "end_seconds": 191.77,
      "duration_seconds": 1.46,
      "text": "How about smoking?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 193.28,
      "end_seconds": 197.35,
      "duration_seconds": 4.07,
      "text": "No, I've never smoked in my life."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 199.42,
      "end_seconds": 202.05,
      "duration_seconds": 2.63,
      "text": "Do you work outside the home?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 203.46,
      "end_seconds": 207.57,
      "duration_seconds": 4.11,
      "text": "I'm a hairdresser, on my feet all day"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 209.6,
      "end_seconds": 211.6,
      "duration_seconds": 2.0,
      "text": "Is there someone at home?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 217.97,
      "end_seconds": 222.44,
      "duration_seconds": 4.47,
      "text": "My husband and I live above the shop."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 224.53,
      "end_seconds": 226.93,
      "duration_seconds": 2.4,
      "text": "Do you do any exercise?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 228.78,
      "end_seconds": 231.04,
      "duration_seconds": 2.26,
      "text": "I swim twice a week."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 243.85,
      "end_seconds": 247.21,
      "duration_seconds": 3.36,
      "text": "Which medicines do you take at the moment?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 248.85,
      "end_seconds": 275.21,
      "duration_seconds": 26.36,
      "text": "I take hydrocortisone cream, when needed for the eczema. Thyronorm, 50 micrograms, every morning for my thyroid. I do miss it now and then, to be fair. I mean, I'm on eye drops, when needed. My neighbour said I should get it looked at. I kept putting it off, which I know isn't sensible."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 276.45,
      "end_seconds": 279.16,
      "duration_seconds": 2.71,
      "text": "let me take your readings now"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 287.45,
      "end_seconds": 289.88,
      "duration_seconds": 2.43,
      "text": "Keep your arm relaxed for me..."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 308.89,
      "end_seconds": 320.58,
      "duration_seconds": 11.69,
      "text": "okay: temperature 37.0, pulse 80, BMI works out to 18.8, height 171 centimetres, pressure 118 over 80, weight 55 kilos, saturation 99 percent"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 321.76,
      "end_seconds": 325.41,
      "duration_seconds": 3.65,
      "text": "I'll examine you in a second, make yourself comfortable"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 326.39,
      "end_seconds": 328.8,
      "duration_seconds": 2.41,
      "text": "tell me if that's sore"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 346.81,
      "end_seconds": 353.69,
      "duration_seconds": 6.88,
      "text": "The eyes are slightly red with no discharge and the front of the eye looks clear."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 356.87,
      "end_seconds": 369.69,
      "duration_seconds": 12.82,
      "text": "Okay, that's enough for me. Okay, so my impression is this: I think we're dealing with dry eye syndrome at this stage. Allergic conjunctivitis is still possible."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 371.41,
      "end_seconds": 375.85,
      "duration_seconds": 4.44,
      "text": "Ah, is there something to to worry about?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 377.42,
      "end_seconds": 394.76,
      "duration_seconds": 17.34,
      "text": "It's reasonable to be concerned, but right now dry eye syndrome is my leading thought, not anything worse. Just to be sure I understood. You've had red eyes in the evening, and no sensitivity to light or loss of vision."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 396.26,
      "end_seconds": 396.96,
      "duration_seconds": 0.7,
      "text": "correct"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 397.94,
      "end_seconds": 403.15,
      "duration_seconds": 5.21,
      "text": "An eye test is what I'd like next, for blurred vision"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 404.71,
      "end_seconds": 407.18,
      "duration_seconds": 2.47,
      "text": "Do I need to prepare?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 408.62,
      "end_seconds": 416.48,
      "duration_seconds": 7.86,
      "text": "take a screen break every twenty minutes and try to blink fully. That's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 418.41,
      "end_seconds": 420.71,
      "duration_seconds": 2.3,
      "text": "Thank you, that's helpful."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 425.81,
      "end_seconds": 427.01,
      "duration_seconds": 1.2,
      "text": "See you soon."
    }
  ]
}