{
  "schema_version": "1.0",
  "encounter_id": "20103",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 0.6,
      "end_seconds": 6.26,
      "duration_seconds": 5.66,
      "text": "Doctor, this one's ready for you. Everything's on the chart, but I'll go through it."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.34,
      "end_seconds": 12.58,
      "duration_seconds": 5.24,
      "text": "Alright, thank you. Good morning, tell me what's been going on."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 13.1,
      "end_seconds": 24.2,
      "duration_seconds": 11.1,
      "text": "Sorry, um, what was I saying, honestly, it's yellow eyes, and my family pushed me to come."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 25.72,
      "end_seconds": 28.24,
      "duration_seconds": 2.52,
      "text": "What's on your current medicine list?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 28.76,
      "end_seconds": 33.3,
      "duration_seconds": 4.54,
      "text": "It's escitalopram, 10 milligrams, maybe, once a day."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 34.26,
      "end_seconds": 38.3,
      "duration_seconds": 4.04,
      "text": "Do you have the packet or the prescription with you?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 40.39,
      "end_seconds": 44.07,
      "duration_seconds": 3.68,
      "text": "No, um, it's at home."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 55.21,
      "end_seconds": 58.57,
      "duration_seconds": 3.36,
      "text": "What's the timeline, when did it begin?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 59.23,
      "end_seconds": 71.99,
      "duration_seconds": 12.76,
      "text": "Well, uh, it's been going on for five days. I did have pale stools at one point, but that's gone now."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 72.58,
      "end_seconds": 77.73,
      "duration_seconds": 5.15,
      "text": "Have you had yellow eyes before, or is this the first time?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 79.66,
      "end_seconds": 85.19,
      "duration_seconds": 5.53,
      "text": "I had a similar thing last year. It went away."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 85.8,
      "end_seconds": 90.33,
      "duration_seconds": 4.53,
      "text": "Have you had any vomiting blood, itching, bleeding or confusion?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 92.27,
      "end_seconds": 94.42,
      "duration_seconds": 2.15,
      "text": "Nope, nothing like that."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 96.3,
      "end_seconds": 100.87,
      "duration_seconds": 4.57,
      "text": "Have you noticed any weakness, or anything odd with your balance?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 102.27,
      "end_seconds": 107.04,
      "duration_seconds": 4.77,
      "text": "Let me think, um, no, that's all normal."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 109.08,
      "end_seconds": 111.98,
      "duration_seconds": 2.9,
      "text": "And your skin, any changes there?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 116.5,
      "end_seconds": 117.61,
      "duration_seconds": 1.11,
      "text": "Skin's normal."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 131.85,
      "end_seconds": 134.26,
      "duration_seconds": 2.41,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 136.09,
      "end_seconds": 138.61,
      "duration_seconds": 2.52,
      "text": "No, not at all."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 140.62,
      "end_seconds": 144.5,
      "duration_seconds": 3.88,
      "text": "Any health conditions I should have on record?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 146.37,
      "end_seconds": 152.36,
      "duration_seconds": 5.99,
      "text": "I have eczema. I'm hoping you can tell me something definite."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 153.42,
      "end_seconds": 154.36,
      "duration_seconds": 0.94,
      "text": "Mm, okay."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 158.0,
      "end_seconds": 159.17,
      "duration_seconds": 1.17,
      "text": "Yes, anxiety."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 160.08,
      "end_seconds": 169.53,
      "duration_seconds": 9.45,
      "text": "Okay, I can see anxiety in your file as well. Let's talk a little about your daily life and habits."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 171.09,
      "end_seconds": 188.78,
      "duration_seconds": 17.69,
      "text": "Nothing, I'm teetotal. I have about eight cigarettes in a day. I look after my grandchildren most days. I walk the dog every morning. My husband and I live above the shop."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 189.71,
      "end_seconds": 192.51,
      "duration_seconds": 2.8,
      "text": "Before we go further, any allergies?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 198.72,
      "end_seconds": 202.44,
      "duration_seconds": 3.72,
      "text": "So, um, no allergies at all."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 204.39,
      "end_seconds": 214.82,
      "duration_seconds": 10.43,
      "text": "Doctor, I've got the readings for you. Oxygen saturation is 99 percent, temperature is 36.7 degrees, pulse is 64 beats a minute, pressure 114 over 81."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 215.37,
      "end_seconds": 216.67,
      "duration_seconds": 1.3,
      "text": "Good, thank you."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 219.24,
      "end_seconds": 223.71,
      "duration_seconds": 4.47,
      "text": "Alright, over here please and I'll take a look."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 225.59,
      "end_seconds": 227.28,
      "duration_seconds": 1.69,
      "text": "Fine by me."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 228.95,
      "end_seconds": 230.14,
      "duration_seconds": 1.19,
      "text": "Breathe out slowly."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 237.44,
      "end_seconds": 244.22,
      "duration_seconds": 6.78,
      "text": "The whites of your eyes are yellow and the liver edge is tender under the right ribs."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 248.51,
      "end_seconds": 262.27,
      "duration_seconds": 13.76,
      "text": "Good, you can sit up again. Having listened and examined, I'm honestly not certain yet. It could be an acute viral hepatitis, or it might be a drug-related liver problem."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 264.1,
      "end_seconds": 265.57,
      "duration_seconds": 1.47,
      "text": "Is this permanent?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 267.54,
      "end_seconds": 279.43,
      "duration_seconds": 11.89,
      "text": "I understand the worry. At the moment I'd say it's an acute viral hepatitis, and we'll know more once the an ultrasound of the liver is back."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 296.22,
      "end_seconds": 314.24,
      "duration_seconds": 18.02,
      "text": "Let's book an ultrasound of the liver to look into jaundice. Let's book liver blood tests to look into jaundice. No alcohol at all and avoid paracetamol and other painkillers unless we say. The liver clinic would be the right next step, I'll refer you."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 315.46,
      "end_seconds": 317.35,
      "duration_seconds": 1.89,
      "text": "Alright, thank you."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 321.78,
      "end_seconds": 331.37,
      "duration_seconds": 9.59,
      "text": "And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 332.17,
      "end_seconds": 334.42,
      "duration_seconds": 2.25,
      "text": "Thank you, that's clear."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 335.27,
      "end_seconds": 352.05,
      "duration_seconds": 16.78,
      "text": "A hepatitis screen is something we might do if this doesn't improve next month. Please don't wait if you become drowsy or confused. That's when to be seen urgently. I'd like to see you again after the results."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 353.92,
      "end_seconds": 356.11,
      "duration_seconds": 2.19,
      "text": "Good, I'll return then."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 358.2,
      "end_seconds": 360.69,
      "duration_seconds": 2.49,
      "text": "Have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 361.83,
      "end_seconds": 367.26,
      "duration_seconds": 5.43,
      "text": "Right, um, I'll do that. Thank you, doctor."
    }
  ]
}