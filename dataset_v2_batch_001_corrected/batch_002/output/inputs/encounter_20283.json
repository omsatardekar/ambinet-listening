      "duration_seconds": 2.17,
      "text": "No bladder problems, thankfully."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 91.23,
      "end_seconds": 97.41,
      "duration_seconds": 6.18,
      "text": "let me check a few things. Any falls, head injury or weakness on one side?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 100.76,
      "end_seconds": 107.79,
      "duration_seconds": 7.03,
      "text": "I haven't had falls, head injury or weakness on one side, no"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 109.8,
      "end_seconds": 111.99,
      "duration_seconds": 2.19,
      "text": "Is your mobility otherwise okay?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 113.86,
      "end_seconds": 116.61,
      "duration_seconds": 2.75,
      "text": "no, you know, nothing there"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 117.93,
      "end_seconds": 121.73,
      "duration_seconds": 3.8,
      "text": "what does a normal day of food look like?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 122.45,
      "end_seconds": 126.89,
      "duration_seconds": 4.44,
      "text": "Lots of rice, lentils and some fruit."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 127.53,
      "end_seconds": 130.36,
      "duration_seconds": 2.83,
      "text": "Are you on your own at home?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 130.88,
      "end_seconds": 133.98,
      "duration_seconds": 3.1,
      "text": "I live with my elderly mother"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 145.4,
      "end_seconds": 148.03,
      "duration_seconds": 2.63,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 149.81,
      "end_seconds": 153.55,
      "duration_seconds": 3.74,
      "text": "Nothing, I haven't had any operations."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 154.81,
      "end_seconds": 157.9,
      "duration_seconds": 3.09,
      "text": "has anyone ever diagnosed you with something?"
