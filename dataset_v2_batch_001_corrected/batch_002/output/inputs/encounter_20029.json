{
  "schema_version": "1.0",
  "encounter_id": "20029",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.24,
      "end_seconds": 8.93,
      "duration_seconds": 7.69,
      "text": "Mm, doctor, hi, where would you like me to to put my coat?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 10.96,
      "end_seconds": 14.65,
      "duration_seconds": 3.69,
      "text": "No problem at all, come in. What's troubling you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 16.57,
      "end_seconds": 34.4,
      "duration_seconds": 17.83,
      "text": "So, doctor, I'll sit in if that's okay, I know what's been happening. It's, It's a high fever with shaking chills, doctor. She didn't want to come, but I insisted."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 36.16,
      "end_seconds": 38.86,
      "duration_seconds": 2.7,
      "text": "Let's start with the basic checks."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 51.9,
      "end_seconds": 54.76,
      "duration_seconds": 2.86,
      "text": "Keep your arm relaxed for me..."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 64.96,
      "end_seconds": 77.53,
      "duration_seconds": 12.57,
      "text": "Okay: pressure 108 over 78, oxygen saturation is 97 percent, pulse is 105 beats a minute, temp 39.2 degrees. Can you tell me when it first started?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 78.59,
      "end_seconds": 81.85,
      "duration_seconds": 3.26,
      "text": "Well, for three days, I'd say."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 83.07,
      "end_seconds": 88.68,
      "duration_seconds": 5.61,
      "text": "Okay, give me more detail on it, whatever comes to to mind."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 89.8,
      "end_seconds": 102.83,
      "duration_seconds": 13.03,
      "text": "I notice it more with evenings. It's once or twice a day. I'd rather not end up on lots of tablets if I can avoid it."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 104.1,
      "end_seconds": 106.56,
      "duration_seconds": 2.46,
      "text": "is it accompanied by anything?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 108.23,
      "end_seconds": 123.34,
      "duration_seconds": 15.11,
      "text": "A pounding headache goes along with it, most of the time. The pounding headache? That's been for one week. And I've been sweating a lot as well."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 140.46,
      "end_seconds": 142.85,
      "duration_seconds": 2.39,
      "text": "Have you had any diarrhoea?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 144.8,
      "end_seconds": 146.41,
      "duration_seconds": 1.61,
      "text": "Definitely no diarrhoea."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 148.01,
      "end_seconds": 151.53,
      "duration_seconds": 3.52,
      "text": "Any cough, rash or neck stiffness at all?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 153.14,
      "end_seconds": 158.19,
      "duration_seconds": 5.05,
      "text": "I haven't had cough, rash or neck stiffness, no"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 159.76,
      "end_seconds": 162.96,
      "duration_seconds": 3.2,
      "text": "Any problems with your joints or muscles?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 167.09,
      "end_seconds": 168.84,
      "duration_seconds": 1.75,
      "text": "Nothing else aches."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 169.84,
      "end_seconds": 172.37,
      "duration_seconds": 2.53,
      "text": "Anything different when you pass water?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 174.13,
      "end_seconds": 175.96,
      "duration_seconds": 1.83,
      "text": "Nothing there, no."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 177.65,
      "end_seconds": 181.17,
      "duration_seconds": 3.52,
      "text": "Is there anything relevant on the family side?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 182.79,
      "end_seconds": 185.73,
      "duration_seconds": 2.94,
      "text": "um, my grandmother had dementia"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 187.72,
      "end_seconds": 192.03,
      "duration_seconds": 4.31,
      "text": "Has anything ever caused you a reaction? I mean any allergies."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 193.08,
      "end_seconds": 196.32,
      "duration_seconds": 3.24,
      "text": "Actually, I've never had an allergy."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 212.27,
      "end_seconds": 215.39,
      "duration_seconds": 3.12,
      "text": "Do you take any prescribed or over-the-counter medicines?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 216.49,
      "end_seconds": 228.32,
      "duration_seconds": 11.83,
      "text": "I'm on Foracort inhaler, twice a day for my asthma. It's Dolo, 650 milligrams, maybe, when I get the fever"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 229.45,
      "end_seconds": 232.4,
      "duration_seconds": 2.95,
      "text": "is the packet here, or the prescription?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 233.3,
      "end_seconds": 237.6,
      "duration_seconds": 4.3,
      "text": "Not with me. I'll bring it next time."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 239.33,
      "end_seconds": 244.3,
      "duration_seconds": 4.97,
      "text": "tell me about your routine, work, habits, that sort of thing"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 245.28,
      "end_seconds": 267.55,
      "duration_seconds": 22.27,
      "text": "I used to drink heavily but I stopped four years ago. I smoke roughly a pack every two days. I walk the dog every morning. I live with my elderly mother. I work in accounts at a hospital"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 275.03,
      "end_seconds": 277.82,
      "duration_seconds": 2.79,
      "text": "Do you have any long-term conditions?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 278.89,
      "end_seconds": 291.04,
      "duration_seconds": 12.15,
      "text": "Um, I have asthma, for nearly five years. I wasn't sure whether to come in at all, to be honest."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 292.87,
      "end_seconds": 297.51,
      "duration_seconds": 4.64,
      "text": "Okay, I can see asthma in your file as well."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 299.77,
      "end_seconds": 302.55,
      "duration_seconds": 2.78,
      "text": "Let's move on to the examination."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 304.43,
      "end_seconds": 307.04,
      "duration_seconds": 2.61,
      "text": "take a deep breath for me"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 321.85,
      "end_seconds": 326.51,
      "duration_seconds": 4.66,
      "text": "The spleen tip is just palpable and the chest is clear."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 329.29,
      "end_seconds": 343.0,
      "duration_seconds": 13.71,
      "text": "Alright, please sit back down. Having listened and examined, I don't have a clear answer today: a fever after travel that must be treated as possible malaria is possible, and so is dengue fever."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 344.33,
      "end_seconds": 346.62,
      "duration_seconds": 2.29,
      "text": "Is this serious, doctor?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 347.43,
      "end_seconds": 362.86,
      "duration_seconds": 15.43,
      "text": "I can't promise yet, but most people with a fever after travel that must be treated as possible malaria do well once it's treated properly. We should do blood cultures for fever."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 363.67,
      "end_seconds": 364.85,
      "duration_seconds": 1.18,
      "text": "mm, alright"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 365.89,
      "end_seconds": 384.38,
      "duration_seconds": 18.49,
      "text": "I'm sending you for a malaria test because of fever after travel. Avoid anti-inflammatory painkillers and keep drinking. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 385.81,
      "end_seconds": 395.04,
      "duration_seconds": 9.23,
      "text": "That's fine by me. Actually, do I need blood tests? I read it might help."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 397.12,
      "end_seconds": 405.62,
      "duration_seconds": 8.5,
      "text": "Not right now, it wouldn't change what we do today. Anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 407.49,
      "end_seconds": 411.18,
      "duration_seconds": 3.69,
      "text": "Great, thank you for your help."
    }
  ]
}