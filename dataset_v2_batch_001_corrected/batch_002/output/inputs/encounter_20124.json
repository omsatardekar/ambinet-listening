{
  "schema_version": "1.0",
  "encounter_id": "20124",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.9,
      "end_seconds": 5.53,
      "duration_seconds": 4.63,
      "text": "Sorry I'm a little late, you know, doctor."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.28,
      "end_seconds": 10.99,
      "duration_seconds": 3.71,
      "text": "Come in. Please sit. How can I help you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 12.83,
      "end_seconds": 27.98,
      "duration_seconds": 15.15,
      "text": "Doctor, I'll sit in if that's okay, I know what's been happening. Okay, so it's been feeling lightheaded, doctor. She didn't want to come, but I insisted."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 28.75,
      "end_seconds": 35.17,
      "duration_seconds": 6.42,
      "text": "Did it come on recently? Bear with me, I'm just building up the picture."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 37.0,
      "end_seconds": 42.77,
      "duration_seconds": 5.77,
      "text": "Two weeks, I think... sorry, four weeks, I got that wrong."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 43.68,
      "end_seconds": 47.28,
      "duration_seconds": 3.6,
      "text": "Is it a lot or only a little?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 49.29,
      "end_seconds": 51.82,
      "duration_seconds": 2.53,
      "text": "I, I'd call it mild."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 52.37,
      "end_seconds": 59.48,
      "duration_seconds": 7.11,
      "text": "And, And the other thing I wanted to mention is that I can't really—"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 59.58,
      "end_seconds": 64.69,
      "duration_seconds": 5.11,
      "text": "Tell the doctor about the other thing, that's what worries me."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 65.43,
      "end_seconds": 67.84,
      "duration_seconds": 2.41,
      "text": "I was getting to that!"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 69.45,
      "end_seconds": 78.79,
      "duration_seconds": 9.34,
      "text": "That's fine, one at a time. I'll ask about everything. Any being short of breath during an episode as well?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 80.67,
      "end_seconds": 84.08,
      "duration_seconds": 3.41,
      "text": "Yes, about the same, about a month."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 85.85,
      "end_seconds": 88.41,
      "duration_seconds": 2.56,
      "text": "Have you had your heart racing?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 92.04,
      "end_seconds": 102.51,
      "duration_seconds": 10.47,
      "text": "So, yes, about the same, about three months. Oh, and a fluttering in my chest. That's been about the same, three weeks."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 107.81,
      "end_seconds": 110.32,
      "duration_seconds": 2.51,
      "text": "How much does it limit you?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 112.3,
      "end_seconds": 113.9,
      "duration_seconds": 1.6,
      "text": "Moderate, I'd say."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 115.97,
      "end_seconds": 120.46,
      "duration_seconds": 4.49,
      "text": "Have you been feeling lightheaded at any time before this?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 121.24,
      "end_seconds": 131.06,
      "duration_seconds": 9.82,
      "text": "Yes, something like this happened a couple of years ago, and it went away on its own."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_4",
      "role": "NURSE",
      "start_seconds": 131.81,
      "end_seconds": 142.65,
      "duration_seconds": 10.84,
      "text": "Doctor, I've got the readings for you. Pulse is 115 beats a minute, temperature 36.6, oxygen saturation is 97 percent. Blood pressure 129 over 75."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 143.5,
      "end_seconds": 144.42,
      "duration_seconds": 0.92,
      "text": "Okay, noted."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 147.04,
      "end_seconds": 150.96,
      "duration_seconds": 3.92,
      "text": "Right, let's have a proper look at you."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 166.42,
      "end_seconds": 167.48,
      "duration_seconds": 1.06,
      "text": "Of course."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 169.23,
      "end_seconds": 170.53,
      "duration_seconds": 1.3,
      "text": "Nearly finished here."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 184.87,
      "end_seconds": 188.53,
      "duration_seconds": 3.66,
      "text": "The pulse is irregular, around ninety beats a minute."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 190.17,
      "end_seconds": 192.45,
      "duration_seconds": 2.28,
      "text": "Hold that for a second."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 211.04,
      "end_seconds": 214.18,
      "duration_seconds": 3.14,
      "text": "Heart sounds are normal with no murmur."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 216.85,
      "end_seconds": 223.34,
      "duration_seconds": 6.49,
      "text": "All finished, thank you. And what about sweating, tremor, weight loss or leg swelling?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 224.14,
      "end_seconds": 228.98,
      "duration_seconds": 4.84,
      "text": "No, no sweating, tremor, weight loss or leg swelling."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 230.03,
      "end_seconds": 231.71,
      "duration_seconds": 1.68,
      "text": "Nothing like chest pain?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 232.92,
      "end_seconds": 236.73,
      "duration_seconds": 3.81,
      "text": "Not that I've noticed, no chest pain."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 238.64,
      "end_seconds": 241.75,
      "duration_seconds": 3.11,
      "text": "How are your joints, any aches elsewhere?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 245.07,
      "end_seconds": 247.85,
      "duration_seconds": 2.78,
      "text": "No, you know, nothing there."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 248.69,
      "end_seconds": 251.45,
      "duration_seconds": 2.76,
      "text": "Before we go further, any allergies?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 253.24,
      "end_seconds": 265.87,
      "duration_seconds": 12.63,
      "text": "Hmm, there was some antibiotic, I was told I was allergic. But I couldn't tell you what it was called or what it did."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 267.15,
      "end_seconds": 270.38,
      "duration_seconds": 3.23,
      "text": "A few questions about your lifestyle now."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 271.29,
      "end_seconds": 281.84,
      "duration_seconds": 10.55,
      "text": "I'll have a glass of wine with dinner. I quit smoking around ten years ago. I'm a plumber, lots of bending and kneeling."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 293.77,
      "end_seconds": 296.53,
      "duration_seconds": 2.76,
      "text": "Have you had any surgical procedures?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 297.8,
      "end_seconds": 310.91,
      "duration_seconds": 13.11,
      "text": "I had a triple bypass eight years ago. I did try to ignore it for a while. I've never really been one for hospitals."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 311.81,
      "end_seconds": 315.21,
      "duration_seconds": 3.4,
      "text": "Has anyone ever diagnosed you with something?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 315.97,
      "end_seconds": 325.75,
      "duration_seconds": 9.78,
      "text": "I have an underactive thyroid, for two years. I have diabetes. I've had high blood pressure, yes."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 326.37,
      "end_seconds": 327.63,
      "duration_seconds": 1.26,
      "text": "Is that everything?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 332.35,
      "end_seconds": 334.17,
      "duration_seconds": 1.82,
      "text": "I've got heart disease."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 335.2,
      "end_seconds": 336.88,
      "duration_seconds": 1.68,
      "text": "Is there anything more?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 338.16,
      "end_seconds": 347.63,
      "duration_seconds": 9.47,
      "text": "Yes, an underactive thyroid and diabetes are known to us, good to have that clear. What's on your current medicine list?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 348.98,
      "end_seconds": 358.68,
      "duration_seconds": 9.7,
      "text": "It's Thyronorm, 50 micrograms, every morning. Gliclazide. I take it 80 milligrams, twice a day for my sugar."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 359.68,
      "end_seconds": 367.0,
      "duration_seconds": 7.32,
      "text": "It's meant to be twice a day, though I don't see she take it every time."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 368.04,
      "end_seconds": 372.44,
      "duration_seconds": 4.4,
      "text": "It's metoprolol, twice a day for my pressure."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 373.9,
      "end_seconds": 375.86,
      "duration_seconds": 1.96,
      "text": "Do you know the dose?"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 376.9,
      "end_seconds": 381.93,
      "duration_seconds": 5.03,
      "text": "50 milligrams, I think that's what's on the box."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 386.2,
      "end_seconds": 389.04,
      "duration_seconds": 2.84,
      "text": "Roughly how long on that one?"
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 390.74,
      "end_seconds": 392.2,
      "duration_seconds": 1.46,
      "text": "For two months."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 393.43,
      "end_seconds": 401.33,
      "duration_seconds": 7.9,
      "text": "It's a... um, I can't remember what it's called. It's a small white one."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 402.15,
      "end_seconds": 404.91,
      "duration_seconds": 2.76,
      "text": "Do you remember what it's for?"
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 405.7,
      "end_seconds": 418.02,
      "duration_seconds": 12.32,
      "text": "For my heart, I believe. My wife sets them out for me, I just take what I'm given. Valsartan I don't take anymore."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 420.05,
      "end_seconds": 423.74,
      "duration_seconds": 3.69,
      "text": "Alright, are there any illnesses in your family?"
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 425.37,
      "end_seconds": 430.09,
      "duration_seconds": 4.72,
      "text": "My son has asthma. My father had bowel cancer."
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 430.78,
      "end_seconds": 453.05,
      "duration_seconds": 22.27,
      "text": "I'll request a thyroid test, it'll help with palpitations. The result will help us decide whether anything more is needed. Let's book a heart monitor for a few days to look into palpitations. Cut right back on coffee, tea and energy drinks for now. Have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 454.9,
      "end_seconds": 458.02,
      "duration_seconds": 3.12,
      "text": "Uh, alright, thanks, take care."
    }
  ]
}