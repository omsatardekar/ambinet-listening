{
  "schema_version": "1.0",
  "encounter_id": "20133",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.29,
      "end_seconds": 5.51,
      "duration_seconds": 4.22,
      "text": "Hi, doctor, I hope I'm not disturbing you."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.61,
      "end_seconds": 11.56,
      "duration_seconds": 3.95,
      "text": "Of course, leave it there. How can I help?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 13.23,
      "end_seconds": 18.38,
      "duration_seconds": 5.15,
      "text": "Well, I've been having tingling in my left foot."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 19.75,
      "end_seconds": 20.93,
      "duration_seconds": 1.18,
      "text": "Since when exactly?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 25.48,
      "end_seconds": 34.36,
      "duration_seconds": 8.88,
      "text": "I'm not sure when it began, to be honest. Some weeks ago, but I can't say how many."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 35.69,
      "end_seconds": 38.77,
      "duration_seconds": 3.08,
      "text": "How strong would you say it is?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 39.67,
      "end_seconds": 46.28,
      "duration_seconds": 6.61,
      "text": "A six out of ten, I suppose. And lower back pain, too."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 47.81,
      "end_seconds": 57.77,
      "duration_seconds": 9.96,
      "text": "Alright, can you describe it a bit more for me? How strong it is, what the pattern is, what helps."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 58.67,
      "end_seconds": 62.51,
      "duration_seconds": 3.84,
      "text": "Honestly, every other day. Heat helps a bit."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 64.11,
      "end_seconds": 67.98,
      "duration_seconds": 3.87,
      "text": "Let me get the readings out of the way."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 79.68,
      "end_seconds": 81.84,
      "duration_seconds": 2.16,
      "text": "Sit still for a moment..."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 101.26,
      "end_seconds": 109.36,
      "duration_seconds": 8.1,
      "text": "Okay: blood pressure 128 over 81, respiratory rate 14, temp 36.4 degrees. And pulse 65, saturation 98 percent."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 110.95,
      "end_seconds": 112.52,
      "duration_seconds": 1.57,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 114.41,
      "end_seconds": 118.65,
      "duration_seconds": 4.24,
      "text": "They help me see the whole picture, more shortly."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 121.41,
      "end_seconds": 123.37,
      "duration_seconds": 1.96,
      "text": "May I examine you now?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 124.12,
      "end_seconds": 125.94,
      "duration_seconds": 1.82,
      "text": "Yeah, no problem."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 127.35,
      "end_seconds": 129.15,
      "duration_seconds": 1.8,
      "text": "Let me feel here."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 140.21,
      "end_seconds": 150.37,
      "duration_seconds": 10.16,
      "text": "Straight leg raising on the left brings on the leg pain at about forty degrees, and the power and reflexes are normal."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 153.06,
      "end_seconds": 157.17,
      "duration_seconds": 4.11,
      "text": "You can relax now. Has there been any bowel problems?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 159.11,
      "end_seconds": 161.4,
      "duration_seconds": 2.29,
      "text": "Nope, no bowel problems."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 165.47,
      "end_seconds": 170.62,
      "duration_seconds": 5.15,
      "text": "Any fever, weakness in the foot or bladder problems at all?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 172.57,
      "end_seconds": 178.56,
      "duration_seconds": 5.99,
      "text": "I haven't had fever, weakness in the foot or bladder problems, no."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 179.51,
      "end_seconds": 182.56,
      "duration_seconds": 3.05,
      "text": "Is your urine normal, no changes?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 183.78,
      "end_seconds": 185.32,
      "duration_seconds": 1.54,
      "text": "No changes there."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 187.37,
      "end_seconds": 192.02,
      "duration_seconds": 4.65,
      "text": "Any change in your bowel habit or your stomach generally?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 194.0,
      "end_seconds": 195.64,
      "duration_seconds": 1.64,
      "text": "Nothing unusual, no."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 196.95,
      "end_seconds": 199.65,
      "duration_seconds": 2.7,
      "text": "Have you been to theatre before?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 201.48,
      "end_seconds": 209.79,
      "duration_seconds": 8.31,
      "text": "Sorry, what was I saying, yes, I had keyhole surgery on my gallbladder, two years back."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 225.73,
      "end_seconds": 228.61,
      "duration_seconds": 2.88,
      "text": "What's on your current medicine list?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 229.39,
      "end_seconds": 234.64,
      "duration_seconds": 5.25,
      "text": "Lisinopril. I take it 10 milligrams, maybe, once a day."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 235.61,
      "end_seconds": 239.54,
      "duration_seconds": 3.93,
      "text": "Did you happen to bring the box or the paperwork?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 240.95,
      "end_seconds": 243.13,
      "duration_seconds": 2.18,
      "text": "No, it's at home."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 254.17,
      "end_seconds": 257.69,
      "duration_seconds": 3.52,
      "text": "Are there any allergies I should be aware of?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 258.46,
      "end_seconds": 260.29,
      "duration_seconds": 1.83,
      "text": "No allergies at all."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 262.3,
      "end_seconds": 265.59,
      "duration_seconds": 3.29,
      "text": "Has anyone ever diagnosed you with something?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 268.51,
      "end_seconds": 270.78,
      "duration_seconds": 2.27,
      "text": "I have high blood pressure."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 276.29,
      "end_seconds": 284.06,
      "duration_seconds": 7.77,
      "text": "Right, so high blood pressure is already on your record. We'll keep that in mind today. What's your work?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 285.38,
      "end_seconds": 289.64,
      "duration_seconds": 4.26,
      "text": "I'm a plumber, lots of bending and kneeling."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 290.48,
      "end_seconds": 292.25,
      "duration_seconds": 1.77,
      "text": "How active are you?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 294.08,
      "end_seconds": 297.58,
      "duration_seconds": 3.5,
      "text": "I hardly move around during the day."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 298.52,
      "end_seconds": 300.35,
      "duration_seconds": 1.83,
      "text": "How are your meals?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 302.16,
      "end_seconds": 306.04,
      "duration_seconds": 3.88,
      "text": "I grab fast food at lunch most days."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 306.88,
      "end_seconds": 316.82,
      "duration_seconds": 9.94,
      "text": "Okay, thinking it through, it fits best with sciatica from a lumbar disc irritation. I'd also keep a muscle strain in mind."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 318.61,
      "end_seconds": 320.8,
      "duration_seconds": 2.19,
      "text": "Is it dangerous, doctor?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 322.4,
      "end_seconds": 332.03,
      "duration_seconds": 9.63,
      "text": "I can't promise yet, but most people with sciatica from a lumbar disc irritation do well once it's treated properly."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 340.9,
      "end_seconds": 361.81,
      "duration_seconds": 20.91,
      "text": "I'm going to order an MRI of the lower back, for sciatica. Blood tests is what I'd like next, for back pain. You'll be taking naproxen, 500 milligrams, twice a day with food, for one week. It's for back and leg pain."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 363.74,
      "end_seconds": 367.49,
      "duration_seconds": 3.75,
      "text": "Well, should I take that with food?"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 368.93,
      "end_seconds": 376.79,
      "duration_seconds": 7.86,
      "text": "Stay active and keep walking, bed rest makes this slower to settle. We'll refer you to physiotherapy."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 377.34,
      "end_seconds": 379.0,
      "duration_seconds": 1.66,
      "text": "Alright, thank you."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 380.51,
      "end_seconds": 397.59,
      "duration_seconds": 17.08,
      "text": "And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose. Please come and see me after the scan. Right, have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 398.71,
      "end_seconds": 400.89,
      "duration_seconds": 2.18,
      "text": "Alright, thanks, take care."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 401.82,
      "end_seconds": 403.14,
      "duration_seconds": 1.32,
      "text": "All the best."
    }
  ]
}