{
  "schema_version": "1.0",
  "encounter_id": "20280",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.9,
      "end_seconds": 3.39,
      "duration_seconds": 2.49,
      "text": "Good afternoon, uh, doctor."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 4.93,
      "end_seconds": 9.39,
      "duration_seconds": 4.46,
      "text": "Yes, have a seat. Tell me what's going on."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 10.44,
      "end_seconds": 18.94,
      "duration_seconds": 8.5,
      "text": "I've been feeling dizzy when I stand up, and I wanted to get it checked."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 19.63,
      "end_seconds": 22.18,
      "duration_seconds": 2.55,
      "text": "Tell me your medicines, please."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 23.54,
      "end_seconds": 29.46,
      "duration_seconds": 5.92,
      "text": "Lisinopril. I take it 10 milligrams, once a day for my pressure."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 30.04,
      "end_seconds": 33.06,
      "duration_seconds": 3.02,
      "text": "How long has it been like this?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 34.52,
      "end_seconds": 37.01,
      "duration_seconds": 2.49,
      "text": "Probably about two weeks. Yeah."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 37.68,
      "end_seconds": 40.58,
      "duration_seconds": 2.9,
      "text": "Has there been a dry mouth too?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 46.24,
      "end_seconds": 56.57,
      "duration_seconds": 10.33,
      "text": "So, yes, about the same, five days. Yeah, about dry mouth, it settles a little with sipping water."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 58.2,
      "end_seconds": 64.19,
      "duration_seconds": 5.99,
      "text": "Have you been feeling dizzy when you stand up at any time before this?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 65.15,
      "end_seconds": 71.65,
      "duration_seconds": 6.5,
      "text": "A bit, about six months ago. It settled by itself back then."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 74.92,
      "end_seconds": 77.88,
      "duration_seconds": 2.96,
      "text": "Right, have you noticed palpitations or vomiting?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 78.82,
      "end_seconds": 82.58,
      "duration_seconds": 3.76,
      "text": "I haven't had palpitations or vomiting, no."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 84.65,
      "end_seconds": 88.76,
      "duration_seconds": 4.11,
      "text": "Any fainting, slurred speech or black stools at all?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 90.11,
      "end_seconds": 93.53,
      "duration_seconds": 3.42,
      "text": "No, you know, not a single one."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 95.31,
      "end_seconds": 97.28,
      "duration_seconds": 1.97,
      "text": "Is your chest okay generally?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 98.02,
      "end_seconds": 99.68,
      "duration_seconds": 1.66,
      "text": "No, nothing there."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 107.65,
      "end_seconds": 111.1,
      "duration_seconds": 3.45,
      "text": "What operations have you had, if any?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 112.44,
      "end_seconds": 116.79,
      "duration_seconds": 4.35,
      "text": "Um, just my septum straightened, in my thirties."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 118.73,
      "end_seconds": 121.1,
      "duration_seconds": 2.37,
      "text": "What about your medical history?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 122.35,
      "end_seconds": 125.94,
      "duration_seconds": 3.59,
      "text": "Well, I've had high blood pressure, yes."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 129.65,
      "end_seconds": 131.07,
      "duration_seconds": 1.42,
      "text": "Yes, carry on."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 132.08,
      "end_seconds": 148.11,
      "duration_seconds": 16.03,
      "text": "I've had an enlarged prostate for nearly five years now. I thought it would sort itself out, but it hasn't. I'm not great at remembering details, so bear with me."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 149.74,
      "end_seconds": 155.35,
      "duration_seconds": 5.61,
      "text": "Yes, high blood pressure is known to us, good to have that clear."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 173.61,
      "end_seconds": 176.4,
      "duration_seconds": 2.79,
      "text": "Now some background about your lifestyle."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 178.26,
      "end_seconds": 193.85,
      "duration_seconds": 15.59,
      "text": "I have about eight cigarettes in a day. I work in accounts at a hospital. I hardly move around during the day. I grab fast food at lunch most days."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 209.64,
      "end_seconds": 213.52,
      "duration_seconds": 3.88,
      "text": "Alright, does your family have any medical conditions?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 214.41,
      "end_seconds": 217.61,
      "duration_seconds": 3.2,
      "text": "My daughter has type 1 diabetes."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 222.27,
      "end_seconds": 227.78,
      "duration_seconds": 5.51,
      "text": "Alright, do you react to any medicines or foods? Any allergies?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 228.38,
      "end_seconds": 232.74,
      "duration_seconds": 4.36,
      "text": "I'm allergic to kiwi, I get an itchy mouth."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 234.0,
      "end_seconds": 236.5,
      "duration_seconds": 2.5,
      "text": "Let me quickly check your readings."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 243.24,
      "end_seconds": 245.98,
      "duration_seconds": 2.74,
      "text": "Okay, sit still for a moment..."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 255.32,
      "end_seconds": 263.2,
      "duration_seconds": 7.88,
      "text": "Okay: saturation 98 percent, temperature is 36.6 degrees, pressure 104 over 65, pulse is 105 beats a minute."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 264.72,
      "end_seconds": 268.72,
      "duration_seconds": 4.0,
      "text": "Let me look at the area, I'll be gentle."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 270.6,
      "end_seconds": 272.38,
      "duration_seconds": 1.78,
      "text": "Let me feel here."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 281.64,
      "end_seconds": 285.78,
      "duration_seconds": 4.14,
      "text": "Heart sounds are normal and the chest is clear."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 290.07,
      "end_seconds": 303.39,
      "duration_seconds": 13.32,
      "text": "Thank you, you can get dressed. Taking everything into account, my working impression is postural low blood pressure, possibly related to medicines or dehydration. I'm sending you for blood tests because of dizziness."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 308.56,
      "end_seconds": 312.82,
      "duration_seconds": 4.26,
      "text": "We have a slot Wednesday at 10 am, if that works."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 313.46,
      "end_seconds": 335.3,
      "duration_seconds": 21.84,
      "text": "We should do an ECG for dizziness. Get up slowly from lying and sitting, and keep drinking fluids through the day. If it hasn't settled in two weeks, we'd think about a lying and standing blood pressure check, but not now. Right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 336.35,
      "end_seconds": 337.92,
      "duration_seconds": 1.57,
      "text": "That's clear, thanks."
    }
  ]
}