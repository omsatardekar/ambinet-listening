{
  "schema_version": "1.0",
  "encounter_id": "20001",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 1.12,
      "end_seconds": 5.42,
      "duration_seconds": 4.3,
      "text": "Ready for you, doctor. I'll stay in case you need anything."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.12,
      "end_seconds": 10.64,
      "duration_seconds": 4.52,
      "text": "Good, thank you. Welcome, tell me what's brought you in."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 11.61,
      "end_seconds": 16.46,
      "duration_seconds": 4.85,
      "text": "Hello, doctor. I'm here with them in case I can help."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 18.48,
      "end_seconds": 23.77,
      "duration_seconds": 5.29,
      "text": "So the thing is, I've got pain in my heel."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 24.64,
      "end_seconds": 28.04,
      "duration_seconds": 3.4,
      "text": "When was the first time you noticed it?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 29.3,
      "end_seconds": 32.49,
      "duration_seconds": 3.19,
      "text": "About three weeks, give or take."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 33.0,
      "end_seconds": 37.2,
      "duration_seconds": 4.2,
      "text": "I think it's been nearer a month, actually."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 38.73,
      "end_seconds": 42.93,
      "duration_seconds": 4.2,
      "text": "Okay, so roughly three to four weeks. Is that right?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 45.16,
      "end_seconds": 47.1,
      "duration_seconds": 1.94,
      "text": "Yeah, uh, roughly."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 47.98,
      "end_seconds": 57.27,
      "duration_seconds": 9.29,
      "text": "Can you describe it a bit more for me? How strong it is, what the pattern is, what helps."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 58.21,
      "end_seconds": 74.12,
      "duration_seconds": 15.91,
      "text": "Hmm, a seven out of ten, I suppose. It's a few times a day. It settles a little with resting. Oh, and an ache along the arch. Oh, and a tight calf."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 78.88,
      "end_seconds": 90.85,
      "duration_seconds": 11.97,
      "text": "Doctor, I've got the readings for you. SpO2 98 percent on room air, temperature 36.6. Pressure 113 over 72, pulse is 73 beats a minute."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 91.81,
      "end_seconds": 92.51,
      "duration_seconds": 0.7,
      "text": "Thanks."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 95.24,
      "end_seconds": 98.8,
      "duration_seconds": 3.56,
      "text": "Now I'm going to do a short physical check."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 100.09,
      "end_seconds": 101.04,
      "duration_seconds": 0.95,
      "text": "Sure thing."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 102.09,
      "end_seconds": 104.44,
      "duration_seconds": 2.35,
      "text": "Tell me if that's sore."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 117.03,
      "end_seconds": 127.33,
      "duration_seconds": 10.3,
      "text": "There is a sore spot at the inner front of the heel bone and pulling the toes back makes it worse."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 131.1,
      "end_seconds": 133.59,
      "duration_seconds": 2.49,
      "text": "All finished, thank you. Any fever?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 135.64,
      "end_seconds": 137.18,
      "duration_seconds": 1.54,
      "text": "Nope, no fever."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 138.61,
      "end_seconds": 143.73,
      "duration_seconds": 5.12,
      "text": "Actually, doctor, I did notice fever. She doesn't always say."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 145.11,
      "end_seconds": 151.15,
      "duration_seconds": 6.04,
      "text": "No, I don't think I did. Maybe a little, I'm not sure."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 151.94,
      "end_seconds": 161.0,
      "duration_seconds": 9.06,
      "text": "Alright, I'll note both what you've said and what you've noticed. Any injury, swelling, back pain or joint pain elsewhere?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 165.82,
      "end_seconds": 169.14,
      "duration_seconds": 3.32,
      "text": "Erm, no, nothing to report there."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 169.68,
      "end_seconds": 172.13,
      "duration_seconds": 2.45,
      "text": "Any rashes or skin problems otherwise?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 173.96,
      "end_seconds": 177.85,
      "duration_seconds": 3.89,
      "text": "Let me think, nothing on the skin, no."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 179.51,
      "end_seconds": 182.89,
      "duration_seconds": 3.38,
      "text": "On the cardiac side, anything I should know?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 186.23,
      "end_seconds": 189.74,
      "duration_seconds": 3.51,
      "text": "So, uh, no, that's been fine."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 202.21,
      "end_seconds": 205.35,
      "duration_seconds": 3.14,
      "text": "Does your family have any medical conditions?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 206.05,
      "end_seconds": 208.87,
      "duration_seconds": 2.82,
      "text": "My sister had breast cancer."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 224.79,
      "end_seconds": 226.96,
      "duration_seconds": 2.17,
      "text": "Do you live by yourself?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 227.56,
      "end_seconds": 232.16,
      "duration_seconds": 4.6,
      "text": "No, I share a house with my brother."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 233.18,
      "end_seconds": 235.27,
      "duration_seconds": 2.09,
      "text": "Do you get out much?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 235.86,
      "end_seconds": 239.56,
      "duration_seconds": 3.7,
      "text": "Not much, I mostly stay in these days."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 240.85,
      "end_seconds": 244.09,
      "duration_seconds": 3.24,
      "text": "Any health conditions I should have on record?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 245.32,
      "end_seconds": 255.16,
      "duration_seconds": 9.84,
      "text": "Yes, migraines. I have thin bones, for nearly five years. I didn't want to make a fuss, you know."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 256.39,
      "end_seconds": 265.78,
      "duration_seconds": 9.39,
      "text": "Right, so thin bones is already on your record. We'll keep that in mind today. Let me ask about allergies, anything at all?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 266.75,
      "end_seconds": 277.0,
      "duration_seconds": 10.25,
      "text": "I mean, I think I reacted to some antibiotic once, years ago. I don't remember which one, or what happened exactly."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 278.0,
      "end_seconds": 280.37,
      "duration_seconds": 2.37,
      "text": "Have you ever had an operation?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 282.07,
      "end_seconds": 286.59,
      "duration_seconds": 4.52,
      "text": "I had keyhole surgery on my gallbladder two years back."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 287.82,
      "end_seconds": 289.78,
      "duration_seconds": 1.96,
      "text": "Let's run through your medicines."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 291.86,
      "end_seconds": 300.3,
      "duration_seconds": 8.44,
      "text": "She is on propranolol, 40 milligrams, twice a day for the migraine prevention, I give it to her."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 300.87,
      "end_seconds": 303.72,
      "duration_seconds": 2.85,
      "text": "Alright, roughly how long on that one?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 305.73,
      "end_seconds": 310.43,
      "duration_seconds": 4.7,
      "text": "For about three months. She takes alendronate, once a week."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 315.78,
      "end_seconds": 317.9,
      "duration_seconds": 2.12,
      "text": "How much do you take?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 318.81,
      "end_seconds": 323.12,
      "duration_seconds": 4.31,
      "text": "It's 70 milligrams. She takes insoles, every day."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 331.51,
      "end_seconds": 337.83,
      "duration_seconds": 6.32,
      "text": "Putting it all together, it points towards plantar fasciitis. A heel spur is still possible."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 338.34,
      "end_seconds": 340.32,
      "duration_seconds": 1.98,
      "text": "Will it clear up?"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 341.27,
      "end_seconds": 354.97,
      "duration_seconds": 13.7,
      "text": "Nothing I've seen today points to an emergency. It looks like plantar fasciitis. Stop me if I've got anything wrong. You've had pain in your heel, and no joint pain elsewhere."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 356.59,
      "end_seconds": 359.39,
      "duration_seconds": 2.8,
      "text": "Yeah, yes, you've got it."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 360.36,
      "end_seconds": 370.49,
      "duration_seconds": 10.13,
      "text": "We'll refer you to podiatry. I'll want another look in six weeks. That's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 371.23,
      "end_seconds": 373.0,
      "duration_seconds": 1.77,
      "text": "That's clear, thanks."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 374.3,
      "end_seconds": 376.18,
      "duration_seconds": 1.88,
      "text": "Have a good day."
    }
  ]
}