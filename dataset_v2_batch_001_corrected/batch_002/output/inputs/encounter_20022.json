{
  "schema_version": "1.0",
  "encounter_id": "20022",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.96,
      "end_seconds": 6.68,
      "duration_seconds": 5.72,
      "text": "Hello, good to see you. Please sit. Did you take the bus in?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 8.12,
      "end_seconds": 11.56,
      "duration_seconds": 3.44,
      "text": "I drove. The roads were quiet today."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 12.4,
      "end_seconds": 14.93,
      "duration_seconds": 2.53,
      "text": "Alright, what's been worrying you?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 16.71,
      "end_seconds": 18.86,
      "duration_seconds": 2.15,
      "text": "I've been feeling low."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 20.67,
      "end_seconds": 23.86,
      "duration_seconds": 3.19,
      "text": "How long has this been bothering you?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 25.84,
      "end_seconds": 39.74,
      "duration_seconds": 13.9,
      "text": "About... well, nearly five years. My neighbour said I should get it looked at. I didn't want to bother you but it keeps coming back."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 40.18,
      "end_seconds": 45.24,
      "duration_seconds": 5.06,
      "text": "Ah. Okay, give me more detail on it, whatever comes to mind."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 46.99,
      "end_seconds": 51.72,
      "duration_seconds": 4.73,
      "text": "Mostly mild. Yes, work pressure. That makes it worse."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 53.76,
      "end_seconds": 56.68,
      "duration_seconds": 2.92,
      "text": "Have you been losing interest in things?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 61.28,
      "end_seconds": 63.43,
      "duration_seconds": 2.15,
      "text": "Mm, uh, yes."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 79.09,
      "end_seconds": 83.33,
      "duration_seconds": 4.24,
      "text": "Did you get chest pain, drinking more or panic attacks?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 84.79,
      "end_seconds": 90.33,
      "duration_seconds": 5.54,
      "text": "I haven't had chest pain, drinking more or panic attacks, no."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 94.88,
      "end_seconds": 99.25,
      "duration_seconds": 4.37,
      "text": "Any weight loss or thoughts of harming myself at all?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 102.82,
      "end_seconds": 106.02,
      "duration_seconds": 3.2,
      "text": "None of those, uh, no."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 110.75,
      "end_seconds": 112.18,
      "duration_seconds": 1.43,
      "text": "Neurologically, anything strange?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 114.08,
      "end_seconds": 117.47,
      "duration_seconds": 3.39,
      "text": "No, you know, nothing like that."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 129.87,
      "end_seconds": 133.51,
      "duration_seconds": 3.64,
      "text": "Do you take any prescribed or over-the-counter medicines?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 134.12,
      "end_seconds": 140.18,
      "duration_seconds": 6.06,
      "text": "I'm on something called sert... sertraline, 50 milligrams, maybe, once a day."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 140.98,
      "end_seconds": 145.13,
      "duration_seconds": 4.15,
      "text": "Have you got the box or the prescription on you?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 145.72,
      "end_seconds": 157.39,
      "duration_seconds": 11.67,
      "text": "Sorry, you know, what was I saying, no, it's at home. I'm, I'm on clopidogrel, 75 milligrams, once a day for the stent."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 157.94,
      "end_seconds": 163.25,
      "duration_seconds": 5.31,
      "text": "Mm-hmm. Are you allergic to anything? Any allergies to medicines or foods?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 164.99,
      "end_seconds": 168.88,
      "duration_seconds": 3.89,
      "text": "Yes, grass pollen. I get itchy eyes."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 169.93,
      "end_seconds": 172.3,
      "duration_seconds": 2.37,
      "text": "Have you ever had an operation?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 174.29,
      "end_seconds": 183.41,
      "duration_seconds": 9.12,
      "text": "I had two stents put in my heart three years ago. My family kept telling me to get it checked."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 185.01,
      "end_seconds": 188.45,
      "duration_seconds": 3.44,
      "text": "Right, do you have any long-term conditions?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 193.33,
      "end_seconds": 202.13,
      "duration_seconds": 8.8,
      "text": "I have depression, for nearly five years. Yes, heart disease. I've never really been one for hospitals."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 202.92,
      "end_seconds": 204.32,
      "duration_seconds": 1.4,
      "text": "And besides that?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 205.29,
      "end_seconds": 207.2,
      "duration_seconds": 1.91,
      "text": "So, how about smoking?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 208.98,
      "end_seconds": 213.51,
      "duration_seconds": 4.53,
      "text": "I smoke roughly a pack every two days."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 217.77,
      "end_seconds": 219.45,
      "duration_seconds": 1.68,
      "text": "And alcohol, how much?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 220.75,
      "end_seconds": 224.9,
      "duration_seconds": 4.15,
      "text": "I'll have a glass of wine with dinner."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 225.54,
      "end_seconds": 228.67,
      "duration_seconds": 3.13,
      "text": "Are you on your own at home?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 230.16,
      "end_seconds": 232.87,
      "duration_seconds": 2.71,
      "text": "I live with my elderly mother."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 233.56,
      "end_seconds": 234.98,
      "duration_seconds": 1.42,
      "text": "Are you active?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 236.82,
      "end_seconds": 239.93,
      "duration_seconds": 3.11,
      "text": "I walk the dog every morning."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 240.46,
      "end_seconds": 243.75,
      "duration_seconds": 3.29,
      "text": "Are you in work at the moment?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 245.66,
      "end_seconds": 250.26,
      "duration_seconds": 4.6,
      "text": "Yes, I work in a bakery, early starts."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 262.0,
      "end_seconds": 265.58,
      "duration_seconds": 3.58,
      "text": "Shall I check your blood pressure and pulse?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 278.45,
      "end_seconds": 280.86,
      "duration_seconds": 2.41,
      "text": "Bear with me while this finishes..."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 297.58,
      "end_seconds": 306.92,
      "duration_seconds": 9.34,
      "text": "Okay: saturation 98 percent, pulse is 77 beats a minute, blood pressure 114 over 77, temp 36.5 degrees."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 308.64,
      "end_seconds": 310.2,
      "duration_seconds": 1.56,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 314.71,
      "end_seconds": 317.63,
      "duration_seconds": 2.92,
      "text": "We'll look at it together shortly."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 319.75,
      "end_seconds": 325.21,
      "duration_seconds": 5.46,
      "text": "I'll need to examine you for this, it won't take long."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 326.99,
      "end_seconds": 329.71,
      "duration_seconds": 2.72,
      "text": "Stay as you are for a moment."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 337.63,
      "end_seconds": 344.38,
      "duration_seconds": 6.75,
      "text": "Your pulse and blood pressure are normal and you are tearful when talking about work."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 349.59,
      "end_seconds": 363.87,
      "duration_seconds": 14.28,
      "text": "Okay, that's enough for me. Having listened and examined, this is probably low mood linked to work stress. I'm sending you for a thyroid test because of low mood and fatigue."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 364.68,
      "end_seconds": 366.07,
      "duration_seconds": 1.39,
      "text": "That makes sense."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 366.79,
      "end_seconds": 391.72,
      "duration_seconds": 24.93,
      "text": "I'm sending you for a blood count because of fatigue. Try a short walk each day and keep a regular bedtime. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose. The thing that would worry me is if you have thoughts of harming yourself. If that happens, go to emergency."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 396.58,
      "end_seconds": 399.98,
      "duration_seconds": 3.4,
      "text": "Okay, I'll look out for that."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 401.92,
      "end_seconds": 409.53,
      "duration_seconds": 7.61,
      "text": "Please come and see me in four weeks. I think we're done unless you have questions."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 410.62,
      "end_seconds": 412.77,
      "duration_seconds": 2.15,
      "text": "Thank you, that's helpful."
    }
  ]
}