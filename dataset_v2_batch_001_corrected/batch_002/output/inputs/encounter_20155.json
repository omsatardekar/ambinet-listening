{
  "schema_version": "1.0",
  "encounter_id": "20155",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.22,
      "end_seconds": 6.4,
      "duration_seconds": 5.18,
      "text": "Doctor? Hello, I hope this is the right time."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.02,
      "end_seconds": 12.62,
      "duration_seconds": 4.6,
      "text": "Not at all, please sit. What seems to be wrong?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 13.92,
      "end_seconds": 22.69,
      "duration_seconds": 8.77,
      "text": "Yeah, it's spots on my back. I don't know what's causing it. Sorry, I know I'm rambling a bit."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 26.99,
      "end_seconds": 30.03,
      "duration_seconds": 3.04,
      "text": "How long has it been like this?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 30.72,
      "end_seconds": 33.31,
      "duration_seconds": 2.59,
      "text": "It's been two years now."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 33.6,
      "end_seconds": 39.27,
      "duration_seconds": 5.67,
      "text": "I see, go ahead. Right, is it bearing on you a lot?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 40.83,
      "end_seconds": 54.97,
      "duration_seconds": 14.14,
      "text": "I, I'd call it moderate. And there's sore red lumps as well, nearly five years now. Mm, I've also had marks left after the spots, for nearly five years."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 56.89,
      "end_seconds": 59.68,
      "duration_seconds": 2.79,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 62.73,
      "end_seconds": 65.31,
      "duration_seconds": 2.58,
      "text": "No surgery, uh, no."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 69.61,
      "end_seconds": 74.01,
      "duration_seconds": 4.4,
      "text": "Alright, do you have any medical conditions I should know about?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 74.93,
      "end_seconds": 78.91,
      "duration_seconds": 3.98,
      "text": "I mean, no, I've always been fairly healthy."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 80.9,
      "end_seconds": 82.64,
      "duration_seconds": 1.74,
      "text": "And alcohol, how much?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 83.76,
      "end_seconds": 89.77,
      "duration_seconds": 6.01,
      "text": "I used to drink heavily but I stopped four years ago."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 91.24,
      "end_seconds": 92.49,
      "duration_seconds": 1.25,
      "text": "How about smoking?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 93.68,
      "end_seconds": 97.3,
      "duration_seconds": 3.62,
      "text": "No, I've never smoked in my life."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 98.13,
      "end_seconds": 100.27,
      "duration_seconds": 2.14,
      "text": "Is there someone at home?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 100.9,
      "end_seconds": 104.5,
      "duration_seconds": 3.6,
      "text": "My husband and I live above the shop."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 105.84,
      "end_seconds": 109.18,
      "duration_seconds": 3.34,
      "text": "What do you do during the day?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 110.17,
      "end_seconds": 113.6,
      "duration_seconds": 3.43,
      "text": "I look after my grandchildren most days."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 124.72,
      "end_seconds": 127.27,
      "duration_seconds": 2.55,
      "text": "Tell me your medicines, please."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 132.53,
      "end_seconds": 136.37,
      "duration_seconds": 3.84,
      "text": "I take face wash, twice a day."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 137.98,
      "end_seconds": 141.7,
      "duration_seconds": 3.72,
      "text": "Are there any allergies I should be aware of?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 143.12,
      "end_seconds": 144.66,
      "duration_seconds": 1.54,
      "text": "No known allergies."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 153.13,
      "end_seconds": 158.04,
      "duration_seconds": 4.91,
      "text": "Let me check a few things. Any headaches or being pregnant?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 159.33,
      "end_seconds": 164.34,
      "duration_seconds": 5.01,
      "text": "Let me think, no, no headaches or being pregnant."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 168.39,
      "end_seconds": 174.01,
      "duration_seconds": 5.62,
      "text": "Let me check a few things. Any irregular periods or joint pain?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 174.53,
      "end_seconds": 176.9,
      "duration_seconds": 2.37,
      "text": "No, nothing to report there."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 179.69,
      "end_seconds": 183.45,
      "duration_seconds": 3.76,
      "text": "On the cardiac side, anything I should know?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 184.83,
      "end_seconds": 186.21,
      "duration_seconds": 1.38,
      "text": "Nothing like that."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 186.87,
      "end_seconds": 189.11,
      "duration_seconds": 2.24,
      "text": "Any trouble with the waterworks?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 190.38,
      "end_seconds": 197.35,
      "duration_seconds": 6.97,
      "text": "Let me think, you know, that's normal as far as I know."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 198.69,
      "end_seconds": 201.21,
      "duration_seconds": 2.52,
      "text": "Let me take your readings now."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 209.1,
      "end_seconds": 211.19,
      "duration_seconds": 2.09,
      "text": "Nearly done with the readings..."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 225.54,
      "end_seconds": 235.59,
      "duration_seconds": 10.05,
      "text": "Okay: respiratory rate 15, SpO2 97 percent on room air, pulse 81, blood pressure 127 over 75, temperature is 36.6 degrees."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 236.16,
      "end_seconds": 238.2,
      "duration_seconds": 2.04,
      "text": "Is that alright, doctor?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 238.82,
      "end_seconds": 241.38,
      "duration_seconds": 2.56,
      "text": "That's fine, I'll explain it soon."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 243.14,
      "end_seconds": 246.04,
      "duration_seconds": 2.9,
      "text": "Let's move on to the examination."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 250.51,
      "end_seconds": 251.21,
      "duration_seconds": 0.7,
      "text": "Right."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 252.72,
      "end_seconds": 255.64,
      "duration_seconds": 2.92,
      "text": "Stay as you are for a moment."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 269.44,
      "end_seconds": 276.64,
      "duration_seconds": 7.2,
      "text": "There are red inflamed lumps and blackheads over both cheeks and the forehead, and a few scars."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 278.76,
      "end_seconds": 281.64,
      "duration_seconds": 2.88,
      "text": "Good, you can sit up again."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 297.4,
      "end_seconds": 321.79,
      "duration_seconds": 24.39,
      "text": "Blood tests is what I'd like next, for acne treatment baseline. You'll be taking doxycycline, 100 milligrams, once a day, for twelve weeks. It's for acne. Use sunscreen daily, and the gel can sting for the first couple of weeks. We'll refer you to the dermatology clinic. Anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 323.61,
      "end_seconds": 327.2,
      "duration_seconds": 3.59,
      "text": "Okay, that makes sense. Thanks for explaining."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 329.07,
      "end_seconds": 330.37,
      "duration_seconds": 1.3,
      "text": "Take care now."
    }
  ]
}