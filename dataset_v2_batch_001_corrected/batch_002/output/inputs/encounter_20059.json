{
  "schema_version": "1.0",
  "encounter_id": "20059",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.51,
      "end_seconds": 2.82,
      "duration_seconds": 2.31,
      "text": "Alright, evening. Let's get started."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 4.1,
      "end_seconds": 8.84,
      "duration_seconds": 4.74,
      "text": "Let me think, hello, thanks for fitting me in."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 10.88,
      "end_seconds": 14.56,
      "duration_seconds": 3.68,
      "text": "What would you like to start with today?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 15.27,
      "end_seconds": 26.57,
      "duration_seconds": 11.3,
      "text": "It's sudden hunger. I thought I'd wait, you know, but it hasn't gone. It's the not knowing that gets to me."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 27.51,
      "end_seconds": 29.63,
      "duration_seconds": 2.12,
      "text": "Did it come on recently?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 31.65,
      "end_seconds": 34.82,
      "duration_seconds": 3.17,
      "text": "It's been about four days now."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 35.33,
      "end_seconds": 38.22,
      "duration_seconds": 2.89,
      "text": "Is there anything else with it?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 42.5,
      "end_seconds": 55.52,
      "duration_seconds": 13.02,
      "text": "When it starts I tend to get a pounding heart as well. Oh, and headaches. So, uh, the pounding heart? That's been for three days."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 57.41,
      "end_seconds": 60.6,
      "duration_seconds": 3.19,
      "text": "Has anyone in your family had anything serious?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 64.52,
      "end_seconds": 66.9,
      "duration_seconds": 2.38,
      "text": "My grandmother had dementia."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 78.04,
      "end_seconds": 79.32,
      "duration_seconds": 1.28,
      "text": "How about smoking?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 81.05,
      "end_seconds": 85.22,
      "duration_seconds": 4.17,
      "text": "I have about eight cigarettes in a day."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 87.19,
      "end_seconds": 88.98,
      "duration_seconds": 1.79,
      "text": "How active are you?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 89.5,
      "end_seconds": 93.51,
      "duration_seconds": 4.01,
      "text": "I hardly move around during the day."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 94.66,
      "end_seconds": 97.74,
      "duration_seconds": 3.08,
      "text": "Are you in work at the moment?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 99.83,
      "end_seconds": 104.84,
      "duration_seconds": 5.01,
      "text": "Yes, I work in a bakery, early starts."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 109.75,
      "end_seconds": 111.77,
      "duration_seconds": 2.02,
      "text": "Is there someone at home?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 113.34,
      "end_seconds": 118.26,
      "duration_seconds": 4.92,
      "text": "My husband and I live above the shop."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 128.37,
      "end_seconds": 131.01,
      "duration_seconds": 2.64,
      "text": "Have you ever had an operation?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 131.52,
      "end_seconds": 137.03,
      "duration_seconds": 5.51,
      "text": "Just keyhole surgery on my gallbladder, two years back."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 137.81,
      "end_seconds": 142.51,
      "duration_seconds": 4.7,
      "text": "Can you list what you take, tablets, creams or inhalers?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 143.26,
      "end_seconds": 147.24,
      "duration_seconds": 3.98,
      "text": "I'm on glibenclamide, 5 milligrams, before breakfast."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 154.97,
      "end_seconds": 159.5,
      "duration_seconds": 4.53,
      "text": "Do you react to any medicines or foods? Any allergies?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 161.23,
      "end_seconds": 166.42,
      "duration_seconds": 5.19,
      "text": "Right, I'm allergic to kiwi, I get an itchy mouth."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 167.62,
      "end_seconds": 171.16,
      "duration_seconds": 3.54,
      "text": "Anything in your past medical history I should know?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 171.73,
      "end_seconds": 176.11,
      "duration_seconds": 4.38,
      "text": "Diabetes, for two years. Yes, kidney disease."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 177.82,
      "end_seconds": 190.5,
      "duration_seconds": 12.68,
      "text": "Right, so kidney disease is already on your record. We'll keep that in mind today. Let me check a few things. Any fainting, chest pain or slurred speech?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 191.8,
      "end_seconds": 197.49,
      "duration_seconds": 5.69,
      "text": "No, you know, I haven't had any of them."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 200.06,
      "end_seconds": 203.19,
      "duration_seconds": 3.13,
      "text": "A few quick ones: vomiting or blurred vision?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 204.42,
      "end_seconds": 209.07,
      "duration_seconds": 4.65,
      "text": "Uh, no, I haven't had any of them."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 210.93,
      "end_seconds": 212.76,
      "duration_seconds": 1.83,
      "text": "How's your breathing otherwise?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 214.48,
      "end_seconds": 217.92,
      "duration_seconds": 3.44,
      "text": "Oh, no, my breathing's been fine."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 218.85,
      "end_seconds": 221.71,
      "duration_seconds": 2.86,
      "text": "Any rashes or skin problems otherwise?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 222.54,
      "end_seconds": 223.67,
      "duration_seconds": 1.13,
      "text": "No rashes."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 225.77,
      "end_seconds": 234.28,
      "duration_seconds": 8.51,
      "text": "Here are the numbers, doctor. Temp 36.5 degrees, pressure 118 over 82, respiratory rate 17, heart rate 85."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 235.74,
      "end_seconds": 237.14,
      "duration_seconds": 1.4,
      "text": "Good, thank you."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 238.67,
      "end_seconds": 242.5,
      "duration_seconds": 3.83,
      "text": "Right, let's have a proper look at you."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 243.5,
      "end_seconds": 245.44,
      "duration_seconds": 1.94,
      "text": "Let me feel here."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 264.14,
      "end_seconds": 268.86,
      "duration_seconds": 4.72,
      "text": "Your fingerprick sugar now is normal and your heart rate is steady."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 269.47,
      "end_seconds": 270.59,
      "duration_seconds": 1.12,
      "text": "Of course."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 273.7,
      "end_seconds": 303.89,
      "duration_seconds": 30.19,
      "text": "All finished, thank you. From what you've told me and what I found, it's hard to say. Episodes of low blood sugar related to diabetes treatment is one possibility and an anxiety attack another, and I'd rather not commit yet. I'll request an HbA1c, it'll help with diabetes control. It's a routine test and it'll give us a much clearer picture."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 305.88,
      "end_seconds": 310.87,
      "duration_seconds": 4.99,
      "text": "Okay, uh, so how long will it take?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 312.42,
      "end_seconds": 330.93,
      "duration_seconds": 18.51,
      "text": "A home sugar diary is what I'd like next, for hypoglycaemia. Never skip meals when you take the sugar tablet, and keep glucose tablets or juice with you. See me again after the blood tests. Right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 331.64,
      "end_seconds": 335.23,
      "duration_seconds": 3.59,
      "text": "Um, thank you, that's helpful."
    }
  ]
}