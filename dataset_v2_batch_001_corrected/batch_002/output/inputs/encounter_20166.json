{
  "schema_version": "1.0",
  "encounter_id": "20166",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.81,
      "end_seconds": 5.22,
      "duration_seconds": 4.41,
      "text": "Hi, doctor, I hope I'm not disturbing you."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.94,
      "end_seconds": 10.94,
      "duration_seconds": 4.0,
      "text": "Yes, have a seat. Tell me what's going on."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 12.28,
      "end_seconds": 19.68,
      "duration_seconds": 7.4,
      "text": "It's extra hair on my chin. I thought I'd wait, but it hasn't gone."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 20.29,
      "end_seconds": 23.67,
      "duration_seconds": 3.38,
      "text": "How long has it been like this?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 24.7,
      "end_seconds": 44.21,
      "duration_seconds": 19.51,
      "text": "For nearly five years, I'd say. Sorry, I know I'm rambling a bit. And I've been putting on weight as well, for two years. Right, and I've been feeling low as well. As for feeling low, I'd say moderate."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 44.61,
      "end_seconds": 50.75,
      "duration_seconds": 6.14,
      "text": "Okay, go on. Let me check a few things. Any breast discharge or being pregnant?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 51.5,
      "end_seconds": 56.0,
      "duration_seconds": 4.5,
      "text": "Sorry, what was I saying, none of those, no."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 57.67,
      "end_seconds": 63.42,
      "duration_seconds": 5.75,
      "text": "A few quick ones: headaches with vision changes, pelvic pain or heavy bleeding?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 67.74,
      "end_seconds": 70.68,
      "duration_seconds": 2.94,
      "text": "No, nothing to report there."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 72.63,
      "end_seconds": 74.37,
      "duration_seconds": 1.74,
      "text": "How's your breathing otherwise?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 75.45,
      "end_seconds": 78.09,
      "duration_seconds": 2.64,
      "text": "No, my breathing's been fine."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 88.58,
      "end_seconds": 91.23,
      "duration_seconds": 2.65,
      "text": "Have you had any surgical procedures?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 92.79,
      "end_seconds": 97.11,
      "duration_seconds": 4.32,
      "text": "Just an operation for a hernia, last spring."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 98.08,
      "end_seconds": 102.07,
      "duration_seconds": 3.99,
      "text": "What about your parents, brothers or sisters, any conditions?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 103.36,
      "end_seconds": 105.74,
      "duration_seconds": 2.38,
      "text": "My uncle has high cholesterol."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 107.42,
      "end_seconds": 113.46,
      "duration_seconds": 6.04,
      "text": "So, tell me about your routine, work, habits, that sort of thing."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 115.31,
      "end_seconds": 134.79,
      "duration_seconds": 19.48,
      "text": "Nothing, I'm teetotal. I have about eight cigarettes in a day. Yes, I work in a bakery, early starts. No, I share a house with my brother. I drink a lot of tea and snack through the day."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 135.3,
      "end_seconds": 138.57,
      "duration_seconds": 3.27,
      "text": "Let me ask about allergies, anything at all?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 139.22,
      "end_seconds": 142.9,
      "duration_seconds": 3.68,
      "text": "I don't think I have any, no."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 144.76,
      "end_seconds": 146.98,
      "duration_seconds": 2.22,
      "text": "Let's run through your medicines."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 148.39,
      "end_seconds": 153.55,
      "duration_seconds": 5.16,
      "text": "I, I take escitalopram, 10 milligrams, once a day."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 154.61,
      "end_seconds": 157.34,
      "duration_seconds": 2.73,
      "text": "Has anyone ever diagnosed you with something?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 158.09,
      "end_seconds": 163.98,
      "duration_seconds": 5.89,
      "text": "Um, I have anxiety. I told my wife I'd come today."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 165.18,
      "end_seconds": 172.11,
      "duration_seconds": 6.93,
      "text": "Sure. Yes, anxiety is known to us, good to have that clear. I'll do your observations first."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 181.11,
      "end_seconds": 184.03,
      "duration_seconds": 2.92,
      "text": "That's it, just a little longer..."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 205.79,
      "end_seconds": 211.31,
      "duration_seconds": 5.52,
      "text": "Okay: blood pressure 112 over 72, temperature 36.5, pulse 70."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 212.33,
      "end_seconds": 213.99,
      "duration_seconds": 1.66,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 219.13,
      "end_seconds": 222.11,
      "duration_seconds": 2.98,
      "text": "Alright, that's fine, I'll explain it soon."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 223.48,
      "end_seconds": 227.59,
      "duration_seconds": 4.11,
      "text": "So, could you come over to the couch, please?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 235.88,
      "end_seconds": 236.86,
      "duration_seconds": 0.98,
      "text": "Of course."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 238.32,
      "end_seconds": 241.01,
      "duration_seconds": 2.69,
      "text": "I'll listen to your chest now."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 255.09,
      "end_seconds": 264.2,
      "duration_seconds": 9.11,
      "text": "There is some acne on the face and extra hair on the chin, and your blood pressure is fine."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 269.82,
      "end_seconds": 272.4,
      "duration_seconds": 2.58,
      "text": "Thank you, you can get dressed."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 283.24,
      "end_seconds": 289.87,
      "duration_seconds": 6.63,
      "text": "Putting it all together, it points towards a pattern that fits polycystic ovary syndrome."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 290.46,
      "end_seconds": 294.34,
      "duration_seconds": 3.88,
      "text": "I mean, what are the odds it's serious?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 296.21,
      "end_seconds": 314.44,
      "duration_seconds": 18.23,
      "text": "I understand the worry. At the moment I'd say it's a pattern that fits polycystic ovary syndrome, and we'll watch how it goes. Today I'm not changing anything. That's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 315.69,
      "end_seconds": 318.72,
      "duration_seconds": 3.03,
      "text": "I think I understand everything. Thanks."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 322.27,
      "end_seconds": 323.48,
      "duration_seconds": 1.21,
      "text": "Look after yourself."
    }
  ]
}