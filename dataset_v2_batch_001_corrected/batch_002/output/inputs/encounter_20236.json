{
  "schema_version": "1.0",
  "encounter_id": "20236",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.82,
      "end_seconds": 5.3,
      "duration_seconds": 4.48,
      "text": "Hi, is it okay to come in now?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.06,
      "end_seconds": 12.03,
      "duration_seconds": 3.97,
      "text": "That's fine, sit down. Tell me why you came."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 13.28,
      "end_seconds": 20.08,
      "duration_seconds": 6.8,
      "text": "Doctor, it's blurred vision at times. It's getting on my nerves now."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 21.2,
      "end_seconds": 24.55,
      "duration_seconds": 3.35,
      "text": "How many days or weeks has it been?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 25.76,
      "end_seconds": 29.46,
      "duration_seconds": 3.7,
      "text": "Ah, I've had it for four weeks."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 31.26,
      "end_seconds": 34.04,
      "duration_seconds": 2.78,
      "text": "Is it bearing on you a lot?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 37.47,
      "end_seconds": 40.76,
      "duration_seconds": 3.29,
      "text": "Pretty moderate, if I'm being honest."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 42.86,
      "end_seconds": 45.02,
      "duration_seconds": 2.16,
      "text": "Have you been feeling stressed?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 46.59,
      "end_seconds": 48.26,
      "duration_seconds": 1.67,
      "text": "Yes, I have."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 49.69,
      "end_seconds": 56.38,
      "duration_seconds": 6.69,
      "text": "Let me check a few things. Any ankle swelling, passing less urine or slurred speech?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 57.92,
      "end_seconds": 61.05,
      "duration_seconds": 3.13,
      "text": "None of those, uh, no."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 62.57,
      "end_seconds": 66.06,
      "duration_seconds": 3.49,
      "text": "How are your joints, any aches elsewhere?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 66.65,
      "end_seconds": 69.25,
      "duration_seconds": 2.6,
      "text": "No, uh, nothing there."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 70.71,
      "end_seconds": 74.84,
      "duration_seconds": 4.13,
      "text": "Are there any allergies I should be aware of?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 76.26,
      "end_seconds": 80.03,
      "duration_seconds": 3.77,
      "text": "No, um, I've never reacted to anything."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 87.41,
      "end_seconds": 88.85,
      "duration_seconds": 1.44,
      "text": "What's your work?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 90.89,
      "end_seconds": 94.63,
      "duration_seconds": 3.74,
      "text": "I'm a plumber, lots of bending and kneeling."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 99.34,
      "end_seconds": 101.13,
      "duration_seconds": 1.79,
      "text": "Who lives with you?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 102.95,
      "end_seconds": 105.22,
      "duration_seconds": 2.27,
      "text": "My partner and our baby."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 112.88,
      "end_seconds": 115.41,
      "duration_seconds": 2.53,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 116.74,
      "end_seconds": 120.19,
      "duration_seconds": 3.45,
      "text": "Right, nothing, I haven't had any operations."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 121.88,
      "end_seconds": 124.3,
      "duration_seconds": 2.42,
      "text": "Are you on any regular medication?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 125.36,
      "end_seconds": 128.3,
      "duration_seconds": 2.94,
      "text": "No, nothing at the moment."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 128.85,
      "end_seconds": 133.56,
      "duration_seconds": 4.71,
      "text": "Do you have any medical conditions I should know about?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 134.62,
      "end_seconds": 136.78,
      "duration_seconds": 2.16,
      "text": "No, nothing at all."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 147.96,
      "end_seconds": 150.47,
      "duration_seconds": 2.51,
      "text": "So, I'll do your observations first."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 156.89,
      "end_seconds": 159.28,
      "duration_seconds": 2.39,
      "text": "Bear with me while this finishes..."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 178.26,
      "end_seconds": 186.99,
      "duration_seconds": 8.73,
      "text": "Okay: temp 36.5 degrees, heart rate 94. And oxygen saturation is 97 percent, blood pressure 167 over 100."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 189.56,
      "end_seconds": 193.73,
      "duration_seconds": 4.17,
      "text": "I'll examine you in a second, make yourself comfortable."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 206.13,
      "end_seconds": 207.58,
      "duration_seconds": 1.45,
      "text": "Fine by me."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 209.24,
      "end_seconds": 211.65,
      "duration_seconds": 2.41,
      "text": "Tell me if that's sore."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 227.76,
      "end_seconds": 234.13,
      "duration_seconds": 6.37,
      "text": "The back of your eyes looks fine and your heart sounds are normal."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 238.37,
      "end_seconds": 260.24,
      "duration_seconds": 21.87,
      "text": "Please sit back down. From what you've told me and what I found, I'd lean towards poorly controlled high blood pressure. I'm sending you for blood tests because of hypertension. It's a routine test and it'll give us a much clearer picture. I'm going to order a home blood pressure diary, for hypertension."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 261.57,
      "end_seconds": 263.97,
      "duration_seconds": 2.4,
      "text": "Mm, you know, alright."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 265.19,
      "end_seconds": 292.3,
      "duration_seconds": 27.11,
      "text": "Let's use amlodipine, 5 milligrams, once a day, long term. You take it by mouth. That's for high blood pressure. It's a commonly used medicine and most people tolerate it well. Check your blood pressure at home twice a day for a week and bring the readings. Please don't wait if you get chest pain, weakness or trouble speaking. That's when to be seen urgently."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 297.42,
      "end_seconds": 298.92,
      "duration_seconds": 1.5,
      "text": "Okay, makes sense."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 299.64,
      "end_seconds": 304.02,
      "duration_seconds": 4.38,
      "text": "I'd like to see you again in two weeks."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 304.58,
      "end_seconds": 306.05,
      "duration_seconds": 1.47,
      "text": "Yes, that's manageable."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 307.62,
      "end_seconds": 313.62,
      "duration_seconds": 6.0,
      "text": "Let me check I've been clear. What will you do once you get home?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 315.69,
      "end_seconds": 325.56,
      "duration_seconds": 9.87,
      "text": "So, you know, I take the amlodipine, 5 milligrams, once a day and come back in two weeks. Is that right?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 326.14,
      "end_seconds": 331.35,
      "duration_seconds": 5.21,
      "text": "Yes, exactly right. That's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 335.33,
      "end_seconds": 337.89,
      "duration_seconds": 2.56,
      "text": "Erm, thank you, that's helpful."
    }
  ]
}