{
  "schema_version": "1.0",
  "encounter_id": "20273",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.0,
      "end_seconds": 4.82,
      "duration_seconds": 3.82,
      "text": "hi, doctor, I hope I'm not disturbing you"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.76,
      "end_seconds": 10.15,
      "duration_seconds": 4.39,
      "text": "Not at all, please sit. What seems to be wrong?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 10.88,
      "end_seconds": 16.68,
      "duration_seconds": 5.8,
      "text": "um so... a ringing in the ear that's why I came"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 17.94,
      "end_seconds": 19.81,
      "duration_seconds": 1.87,
      "text": "when did this begin?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 21.86,
      "end_seconds": 30.21,
      "duration_seconds": 8.35,
      "text": "I've had it for two days i looked a few things up online and that probably didn't help"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 30.46,
      "end_seconds": 33.96,
      "duration_seconds": 3.5,
      "text": "right, right does anything else come with it?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 35.92,
      "end_seconds": 52.09,
      "duration_seconds": 16.17,
      "text": "it usually comes with trouble following conversations mm as for trouble following conversations I honestly can't say when that began it might have been last month or the month before"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 55.21,
      "end_seconds": 61.86,
      "duration_seconds": 6.65,
      "text": "have you had a ringing in the ear before or is this the first time?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 64.72,
      "end_seconds": 71.68,
      "duration_seconds": 6.96,
      "text": "Yes, something like this happened last winter, and it went away on its own."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 72.84,
      "end_seconds": 75.48,
      "duration_seconds": 2.64,
      "text": "any ear pain or facial weakness?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 76.03,
      "end_seconds": 81.16,
      "duration_seconds": 5.13,
      "text": "I haven't had ear pain or facial weakness, no"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 82.11,
      "end_seconds": 84.62,
      "duration_seconds": 2.51,
      "text": "have you noticed headache or discharge?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 86.02,
      "end_seconds": 90.0,
      "duration_seconds": 3.98,
      "text": "no headache or discharge, none of it"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 91.17,
      "end_seconds": 93.77,
      "duration_seconds": 2.6,
      "text": "Any rashes or skin problems otherwise?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 94.87,
      "end_seconds": 97.13,
      "duration_seconds": 2.26,
      "text": "no, skin's been fine"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 104.18,
      "end_seconds": 108.54,
      "duration_seconds": 4.36,
      "text": "let's talk a little about your daily life and habits"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 109.93,
      "end_seconds": 123.67,
      "duration_seconds": 13.74,
      "text": "My husband and I live above the shop. I hardly move around during the day. I'm a bus driver, so I sit for long hours."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 125.72,
      "end_seconds": 130.39,
      "duration_seconds": 4.67,
      "text": "has anything ever caused you a reaction? I mean any allergies"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 131.84,
      "end_seconds": 140.41,
      "duration_seconds": 8.57,
      "text": "I had a reaction to naproxen when I was younger a rash and I've avoided it since."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 158.76,
      "end_seconds": 162.66,
      "duration_seconds": 3.9,
      "text": "tell me about any past illnesses or ongoing conditions"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 163.88,
      "end_seconds": 167.84,
      "duration_seconds": 3.96,
      "text": "I have high blood pressure yes, migraines"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 172.85,
      "end_seconds": 177.22,
      "duration_seconds": 4.37,
      "text": "right, right alright, migraines, that matches what I have here"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 194.56,
      "end_seconds": 198.07,
      "duration_seconds": 3.51,
      "text": "has anyone in your family had anything serious?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 199.43,
      "end_seconds": 202.14,
      "duration_seconds": 2.71,
      "text": "My grandfather had a stroke."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 202.68,
      "end_seconds": 208.24,
      "duration_seconds": 5.56,
      "text": "what's on your current medicine list? These questions might sound routine, but they matter"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 209.79,
      "end_seconds": 222.76,
      "duration_seconds": 12.97,
      "text": "it's lisinopril, 10 milligrams, once a day. It's propranolol, 40 milligrams, twice a day. I thought it would sort itself out, but it hasn't"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 223.86,
      "end_seconds": 227.16,
      "duration_seconds": 3.3,
      "text": "alright, I'll note down your vital signs first"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 239.72,
      "end_seconds": 241.97,
      "duration_seconds": 2.25,
      "text": "okay, this won't take long.."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 263.76,
      "end_seconds": 271.01,
      "duration_seconds": 7.25,
      "text": "okay: pulse is 86 beats a a minute, temperature is 36.5 degrees, blood pressure 124 over 69."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 273.9,
      "end_seconds": 278.02,
      "duration_seconds": 4.12,
      "text": "I'd like to check you over now if that's alright."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 278.57,
      "end_seconds": 280.09,
      "duration_seconds": 1.52,
      "text": "Yes that's fine."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 281.1,
      "end_seconds": 282.27,
      "duration_seconds": 1.17,
      "text": "Breathe out slowly."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 290.48,
      "end_seconds": 296.88,
      "duration_seconds": 6.4,
      "text": "Both eardrums look normal and a tuning fork is heard better in the right ear."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 301.71,
      "end_seconds": 315.4,
      "duration_seconds": 13.69,
      "text": "good you can sit up again. Putting it all together I can't pin this down yet. We're looking at sudden loss of hearing that needs urgent assessment or a middle ear fluid problem"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 316.13,
      "end_seconds": 319.76,
      "duration_seconds": 3.63,
      "text": "Erm what are the odds it's serious?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 320.61,
      "end_seconds": 341.99,
      "duration_seconds": 21.38,
      "text": "I can't promise yet, but most people with sudden loss of hearing that needs urgent assessment do well once it's treated properly. I'm gonna order an MRI scan, for unilateral hearing loss. I think a hearing test makes sense here, for sudden hearing loss"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 343.15,
      "end_seconds": 344.79,
      "duration_seconds": 1.64,
      "text": "That makes sense."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 345.63,
      "end_seconds": 353.57,
      "duration_seconds": 7.94,
      "text": "I'm prescribing prednisolone 60 milligrams once a day in the morning for seven days. That's for sudden hearing loss"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 354.23,
      "end_seconds": 355.79,
      "duration_seconds": 1.56,
      "text": "Okay, I understand."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 357.24,
      "end_seconds": 367.88,
      "duration_seconds": 10.64,
      "text": "please attend the hearing test today if you can as timing matters see me again after the hearing test i think we're done unless you have questions"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 369.01,
      "end_seconds": 371.15,
      "duration_seconds": 2.14,
      "text": "alright, thanks, take care"
    }
  ]
}