  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.35,
      "end_seconds": 5.12,
      "duration_seconds": 3.77,
      "text": "morning, doctor is this the right room?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.6,
      "end_seconds": 10.67,
      "duration_seconds": 4.07,
      "text": "Not at all, please sit. What seems to be wrong?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 11.43,
      "end_seconds": 18.12,
      "duration_seconds": 6.69,
      "text": "Honestly, it's not opening my bowels, and my family pushed me to come."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 19.36,
      "end_seconds": 27.47,
      "duration_seconds": 8.11,
      "text": "Do you take any prescribed or over-the-counter medicines? Bear with me, I'm just building up the picture."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 28.22,
      "end_seconds": 32.1,
      "duration_seconds": 3.88,
      "text": "It's Thyronorm, 50 micrograms, maybe, every morning."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 35.33,
      "end_seconds": 38.82,
      "duration_seconds": 3.49,
      "text": "Is the packet here, or the prescription?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 39.75,
      "end_seconds": 41.9,
      "duration_seconds": 2.15,
      "text": "No, it's at home."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 49.64,
      "end_seconds": 53.53,
      "duration_seconds": 3.89,
      "text": "How many days or weeks has it been?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 54.76,
      "end_seconds": 68.05,
      "duration_seconds": 13.29,
      "text": "Probably two years. Yeah. There's hard small stools as well. About hard small stools, moderate, really. I've also had straining, for six months. Right, with straining, moderate, really."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 82.0,
      "end_seconds": 87.28,
      "duration_seconds": 5.28,
      "text": "Alright, any severe abdominal pain, black stools or passing wind at all?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 88.55,
      "end_seconds": 90.66,
      "duration_seconds": 2.11,
      "text": "None of those, no."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 91.75,
      "end_seconds": 96.67,
      "duration_seconds": 4.92,
      "text": "Okay, any vomiting or blood in the stool at all?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 98.71,
      "end_seconds": 101.64,
      "duration_seconds": 2.93,
      "text": "no, not a single one"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 103.49,
      "end_seconds": 106.04,
      "duration_seconds": 2.55,
      "text": "Any breathing difficulties apart from this?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 107.9,
      "end_seconds": 111.24,
      "duration_seconds": 3.34,
      "text": "Well, no, my breathing's been fine."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 113.14,
      "end_seconds": 114.62,
      "duration_seconds": 1.48,
      "text": "Neurologically, anything strange?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 115.48,
      "end_seconds": 116.9,
      "duration_seconds": 1.42,
      "text": "Nothing odd there."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 118.14,
      "end_seconds": 120.58,
      "duration_seconds": 2.44,
      "text": "Now some background about your lifestyle."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 122.06,
      "end_seconds": 133.19,
      "duration_seconds": 11.13,
      "text": "I used to drink heavily but I stopped four years ago. I'm a hairdresser, on my feet all day. My partner and our baby."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 134.69,
      "end_seconds": 136.89,
      "duration_seconds": 2.2,
      "text": "Any surgery in the past?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 137.92,
      "end_seconds": 152.65,
      "duration_seconds": 14.73,
      "text": "I had a cataract operation in my left eye about a year ago. I'd rather not end up on lots of tablets if I can avoid it"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 153.6,
      "end_seconds": 156.32,
      "duration_seconds": 2.72,
      "text": "have you got any known allergies?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 157.0,
      "end_seconds": 159.63,
      "duration_seconds": 2.63,
      "text": "I've never had an allergy."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 160.68,
      "end_seconds": 164.1,
      "duration_seconds": 3.42,
      "text": "any health conditions I should have on record?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 164.83,
      "end_seconds": 169.27,
      "duration_seconds": 4.44,
      "text": "I have an underactive thyroid, for about a year."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 174.4,
      "end_seconds": 178.15,
      "duration_seconds": 3.75,
      "text": "What about your parents, brothers or sisters, any conditions?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 179.58,
      "end_seconds": 182.18,
      "duration_seconds": 2.6,
      "text": "My father had bowel cancer."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 184.04,
      "end_seconds": 186.65,
      "duration_seconds": 2.61,
      "text": "Let me take your readings now."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 199.55,
      "end_seconds": 202.72,
      "duration_seconds": 3.17,
      "text": "Right, that's it, just a little longer..."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 221.98,
      "end_seconds": 229.39,
      "duration_seconds": 7.41,
      "text": "Okay: temperature is 37.0 degrees, pulse 74, respiratory rate 14. And BP is 109 over 78."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 230.83,
      "end_seconds": 234.26,
      "duration_seconds": 3.43,
      "text": "Right, let's have a proper look at you."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 249.22,
      "end_seconds": 250.29,
      "duration_seconds": 1.07,
      "text": "Of course."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 251.5,
      "end_seconds": 253.64,
      "duration_seconds": 2.14,
      "text": "Raise your arm for me."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 260.87,
      "end_seconds": 265.55,
      "duration_seconds": 4.68,
      "text": "There is firm stool in the left lower abdomen and no mass."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 268.92,
      "end_seconds": 282.02,
      "duration_seconds": 13.1,
      "text": "All finished, thank you. Okay, thinking it through, I don't have a clear answer today: constipation, possibly related to diet or medicines is possible, and so is low fibre intake."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 282.98,
      "end_seconds": 285.77,
      "duration_seconds": 2.79,
      "text": "Is there something to worry about?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 290.9,
      "end_seconds": 322.12,
      "duration_seconds": 31.22,
      "text": "I can't promise yet, but most people with constipation, possibly related to diet or medicines do well once it's treated properly. Let's book a blood count to look into constipation. I'd rather check than guess, and this is the quickest way to know more. The treatment will be macrogol, 1 sachet, once a day, for two weeks. That's for constipation. More fibre, plenty of water and a regular time on the toilet after breakfast."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 323.68,
      "end_seconds": 331.61,
      "duration_seconds": 7.93,
      "text": "And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 332.95,
      "end_seconds": 336.33,
      "duration_seconds": 3.38,
      "text": "I know what to watch for"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 337.73,
      "end_seconds": 345.37,
      "duration_seconds": 7.64,
      "text": "See me again if it isn't working in a week. I think we're done unless you have questions."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 346.47,
      "end_seconds": 349.54,
      "duration_seconds": 3.07,
      "text": "Um, alright, thanks, take care."
    }
  ]
