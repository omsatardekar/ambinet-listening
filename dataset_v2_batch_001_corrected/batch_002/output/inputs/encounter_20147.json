{
  "schema_version": "1.0",
  "encounter_id": "20147",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 1.02,
      "end_seconds": 7.66,
      "duration_seconds": 6.64,
      "text": "Doctor, your next patient is here. I've done the basics, I'll read them out in a moment."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 9.32,
      "end_seconds": 14.57,
      "duration_seconds": 5.25,
      "text": "Right, great. Hello, come in and sit down. How can I help?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 15.48,
      "end_seconds": 22.18,
      "duration_seconds": 6.7,
      "text": "I've been feeling dizzy. I just want to get back to normal, really."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 23.45,
      "end_seconds": 24.73,
      "duration_seconds": 1.28,
      "text": "Since when exactly?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 25.61,
      "end_seconds": 28.84,
      "duration_seconds": 3.23,
      "text": "Ever since... since last weekend, really."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 29.42,
      "end_seconds": 34.45,
      "duration_seconds": 5.03,
      "text": "Okay, give me more detail on it, whatever comes to mind."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 35.37,
      "end_seconds": 41.33,
      "duration_seconds": 5.96,
      "text": "Pretty mild, if I'm being honest. I'd say a few times a day."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 42.77,
      "end_seconds": 46.3,
      "duration_seconds": 3.53,
      "text": "Have you had a bump on your head?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 51.31,
      "end_seconds": 60.28,
      "duration_seconds": 8.97,
      "text": "Yes, for about four days. There was a headache since the fall, yes, but that went away."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 61.44,
      "end_seconds": 66.42,
      "duration_seconds": 4.98,
      "text": "Any clear fluid from the nose or ear, confusion or double vision?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 68.26,
      "end_seconds": 70.64,
      "duration_seconds": 2.38,
      "text": "No, I'd have said so."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 72.11,
      "end_seconds": 74.48,
      "duration_seconds": 2.37,
      "text": "Any loss of consciousness or weakness?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 75.57,
      "end_seconds": 80.71,
      "duration_seconds": 5.14,
      "text": "No loss of consciousness or weakness, none of it."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 81.69,
      "end_seconds": 84.43,
      "duration_seconds": 2.74,
      "text": "Has your heart given you any trouble?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 86.49,
      "end_seconds": 88.13,
      "duration_seconds": 1.64,
      "text": "Nothing like that."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 89.87,
      "end_seconds": 92.46,
      "duration_seconds": 2.59,
      "text": "Now some background about your lifestyle."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 93.47,
      "end_seconds": 106.47,
      "duration_seconds": 13.0,
      "text": "I'm a bus driver, so I sit for long hours. I swim twice a week. My husband and I live above the shop."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 119.03,
      "end_seconds": 122.38,
      "duration_seconds": 3.35,
      "text": "Right, what's on your current medicine list?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 123.83,
      "end_seconds": 128.62,
      "duration_seconds": 4.79,
      "text": "Amlodipine. I take it once a day for my pressure."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 130.3,
      "end_seconds": 132.25,
      "duration_seconds": 1.95,
      "text": "How much do you take?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 133.97,
      "end_seconds": 138.66,
      "duration_seconds": 4.69,
      "text": "5 milligrams, I think that's what's on the box."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 146.69,
      "end_seconds": 149.42,
      "duration_seconds": 2.73,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 150.73,
      "end_seconds": 155.45,
      "duration_seconds": 4.72,
      "text": "Nothing, you know, I haven't had any operations."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 157.16,
      "end_seconds": 159.24,
      "duration_seconds": 2.08,
      "text": "What about your medical history?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 160.31,
      "end_seconds": 163.62,
      "duration_seconds": 3.31,
      "text": "High blood pressure, for nearly five years."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 182.37,
      "end_seconds": 186.6,
      "duration_seconds": 4.23,
      "text": "Do you react to any medicines or foods? Any allergies?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 187.64,
      "end_seconds": 193.36,
      "duration_seconds": 5.72,
      "text": "Plasters. I come out in... well, a red itchy rash."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 193.92,
      "end_seconds": 204.02,
      "duration_seconds": 10.1,
      "text": "Doctor, I've got the readings for you. Pressure 119 over 74, saturation 98 percent, pulse 83. Respiratory rate 16, temp 36.6 degrees."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 205.19,
      "end_seconds": 205.89,
      "duration_seconds": 0.7,
      "text": "Thanks."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 207.96,
      "end_seconds": 212.15,
      "duration_seconds": 4.19,
      "text": "Right, could you come over to the couch, please?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 213.32,
      "end_seconds": 215.54,
      "duration_seconds": 2.22,
      "text": "Hold that for a second."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 228.1,
      "end_seconds": 235.96,
      "duration_seconds": 7.86,
      "text": "There is a small bruise on the forehead, the pupils are equal and reactive, and you are walking steadily."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 238.98,
      "end_seconds": 249.27,
      "duration_seconds": 10.29,
      "text": "That's the examination finished. So where does that leave us? This looks most like a minor head injury without worrying signs."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 251.0,
      "end_seconds": 255.4,
      "duration_seconds": 4.4,
      "text": "Okay, so what are the odds it's serious?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 256.02,
      "end_seconds": 272.59,
      "duration_seconds": 16.57,
      "text": "Nothing I've seen today points to an emergency. It looks like a minor head injury without worrying signs. Let's use paracetamol, 1 gram, every six hours if needed, for three days. That should help with headache."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 274.29,
      "end_seconds": 276.34,
      "duration_seconds": 2.05,
      "text": "Fine, I'll begin it."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 277.05,
      "end_seconds": 301.15,
      "duration_seconds": 24.1,
      "text": "Someone should stay with you tonight, and no alcohol or contact sport for now. The thing that would worry me is if you vomit repeatedly, become drowsy or confused, or have a fit. If that happens, go to emergency. I'd like to see you again if the headache gets worse. Have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 302.96,
      "end_seconds": 306.16,
      "duration_seconds": 3.2,
      "text": "I think I understand everything. Thanks."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 309.61,
      "end_seconds": 311.26,
      "duration_seconds": 1.65,
      "text": "Have a good day."
    }
  ]
}