{
  "schema_version": "1.0",
  "encounter_id": "20251",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.28,
      "end_seconds": 3.71,
      "duration_seconds": 2.43,
      "text": "Afternoon, thanks for coming in."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "CAREGIVER",
      "start_seconds": 4.89,
      "end_seconds": 10.99,
      "duration_seconds": 6.1,
      "text": "Right, good afternoon, doctor. I look after them so I thought I'd come."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 12.31,
      "end_seconds": 15.61,
      "duration_seconds": 3.3,
      "text": "What would you like to start with today?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "CAREGIVER",
      "start_seconds": 16.81,
      "end_seconds": 23.39,
      "duration_seconds": 6.58,
      "text": "It's breathlessness on exertion, doctor. He didn't want to come, but I insisted."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 25.08,
      "end_seconds": 28.53,
      "duration_seconds": 3.45,
      "text": "Has this been going on for long?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 29.7,
      "end_seconds": 32.24,
      "duration_seconds": 2.54,
      "text": "For two months, I'd say."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 33.28,
      "end_seconds": 38.79,
      "duration_seconds": 5.51,
      "text": "Okay, give me more detail on it, whatever comes to mind."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 40.71,
      "end_seconds": 48.29,
      "duration_seconds": 7.58,
      "text": "Mild, really. It settles a little with resting. Yes, stairs. That makes it worse."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 51.53,
      "end_seconds": 57.51,
      "duration_seconds": 5.98,
      "text": "Any a tight feeling in your chest when you walk uphill as well?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 58.81,
      "end_seconds": 67.88,
      "duration_seconds": 9.07,
      "text": "Yes, I have. As for tight feeling in my chest when I walk uphill, it's severe, honestly."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 69.1,
      "end_seconds": 72.42,
      "duration_seconds": 3.32,
      "text": "Have you been sweating with the tightness?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 73.79,
      "end_seconds": 80.03,
      "duration_seconds": 6.24,
      "text": "Yeah. Six months, I'd say. As for sweating with the tightness, mostly mild."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 80.46,
      "end_seconds": 81.83,
      "duration_seconds": 1.37,
      "text": "Yes, carry on."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 83.83,
      "end_seconds": 89.9,
      "duration_seconds": 6.07,
      "text": "I've had a heaviness in my left arm too, for nearly five years."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 91.6,
      "end_seconds": 94.67,
      "duration_seconds": 3.07,
      "text": "How strong would you say it is?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 96.72,
      "end_seconds": 97.76,
      "duration_seconds": 1.04,
      "text": "Mild, really."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 100.26,
      "end_seconds": 105.89,
      "duration_seconds": 5.63,
      "text": "Have you had breathlessness on exertion before, or is this the first time?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 107.2,
      "end_seconds": 111.86,
      "duration_seconds": 4.66,
      "text": "I had a similar thing last winter. It went away."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 113.79,
      "end_seconds": 118.13,
      "duration_seconds": 4.34,
      "text": "A few quick ones: fainting, pain at rest or cough?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 119.51,
      "end_seconds": 122.32,
      "duration_seconds": 2.81,
      "text": "No, not a single one."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 123.31,
      "end_seconds": 128.98,
      "duration_seconds": 5.67,
      "text": "A few quick ones: pain between the shoulder blades, ankle swelling or palpitations?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 130.53,
      "end_seconds": 133.2,
      "duration_seconds": 2.67,
      "text": "No, not a single one."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 134.37,
      "end_seconds": 136.42,
      "duration_seconds": 2.05,
      "text": "Any trouble with the waterworks?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 138.07,
      "end_seconds": 139.67,
      "duration_seconds": 1.6,
      "text": "Nothing there, no."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 141.58,
      "end_seconds": 145.34,
      "duration_seconds": 3.76,
      "text": "Any pins and needles or loss of strength anywhere?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 147.72,
      "end_seconds": 149.72,
      "duration_seconds": 2.0,
      "text": "No, that's all normal."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 151.4,
      "end_seconds": 155.76,
      "duration_seconds": 4.36,
      "text": "Any allergies to tablets, food or anything in the environment?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 157.0,
      "end_seconds": 159.29,
      "duration_seconds": 2.29,
      "text": "I've never had an allergy."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 176.03,
      "end_seconds": 178.41,
      "duration_seconds": 2.38,
      "text": "Anything surgical in your history?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 179.99,
      "end_seconds": 184.7,
      "duration_seconds": 4.71,
      "text": "Just keyhole surgery on my gallbladder, two years back."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 186.1,
      "end_seconds": 191.66,
      "duration_seconds": 5.56,
      "text": "Tell me about your routine, work, habits, that sort of thing."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 192.36,
      "end_seconds": 207.55,
      "duration_seconds": 15.19,
      "text": "I have about eight cigarettes in a day. Lots of rice, lentils and some fruit. I'm a plumber, lots of bending and kneeling. My partner and our baby."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 217.66,
      "end_seconds": 221.86,
      "duration_seconds": 4.2,
      "text": "Right, has anyone in your family had anything serious?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 223.08,
      "end_seconds": 227.78,
      "duration_seconds": 4.7,
      "text": "My father has Parkinson's disease. My grandmother had dementia."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 233.04,
      "end_seconds": 235.74,
      "duration_seconds": 2.7,
      "text": "What's on your current medicine list?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 237.55,
      "end_seconds": 247.09,
      "duration_seconds": 9.54,
      "text": "I take glibenclamide, 5 milligrams, before breakfast for my sugar. Metoprolol. I take it 50 milligrams, twice a day."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 247.45,
      "end_seconds": 248.89,
      "duration_seconds": 1.44,
      "text": "Yes, carry on."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 250.7,
      "end_seconds": 261.49,
      "duration_seconds": 10.79,
      "text": "Rosuvastatin, 10 milligrams, at night. Let me think, I'd been on metformin, not any more though, I stopped."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 263.24,
      "end_seconds": 265.39,
      "duration_seconds": 2.15,
      "text": "What about your medical history?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 267.34,
      "end_seconds": 268.97,
      "duration_seconds": 1.63,
      "text": "I've got diabetes."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 270.51,
      "end_seconds": 271.21,
      "duration_seconds": 0.7,
      "text": "Ah."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 272.47,
      "end_seconds": 276.5,
      "duration_seconds": 4.03,
      "text": "I have high blood pressure. Yes, high cholesterol."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 277.18,
      "end_seconds": 284.14,
      "duration_seconds": 6.96,
      "text": "Okay, I can see diabetes and high blood pressure in your file as well."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 299.5,
      "end_seconds": 302.62,
      "duration_seconds": 3.12,
      "text": "Shall I check your blood pressure and pulse?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 315.76,
      "end_seconds": 318.53,
      "duration_seconds": 2.77,
      "text": "Keep your arm relaxed for me..."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 337.2,
      "end_seconds": 345.63,
      "duration_seconds": 8.43,
      "text": "Okay: weight 81 kilos, respiratory rate 18, BP is 118 over 74, height 181 centimetres, pulse 66, temperature 36.8."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 346.57,
      "end_seconds": 348.25,
      "duration_seconds": 1.68,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 349.56,
      "end_seconds": 352.08,
      "duration_seconds": 2.52,
      "text": "I'll come back to the numbers."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 354.79,
      "end_seconds": 359.07,
      "duration_seconds": 4.28,
      "text": "Let me look at the area, I'll be gentle."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 359.97,
      "end_seconds": 362.14,
      "duration_seconds": 2.17,
      "text": "I'm just checking this side."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 375.39,
      "end_seconds": 378.77,
      "duration_seconds": 3.38,
      "text": "There is no swelling in your ankles."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 380.08,
      "end_seconds": 382.73,
      "duration_seconds": 2.65,
      "text": "Take a deep breath for me."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 395.51,
      "end_seconds": 400.2,
      "duration_seconds": 4.69,
      "text": "Heart sounds are normal, no murmur, and the chest is clear."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 403.73,
      "end_seconds": 423.69,
      "duration_seconds": 19.96,
      "text": "Thank you, you can get dressed. So where does that leave us? It points towards exertional angina until proven otherwise. A muscle strain is still possible. Let me repeat that back to make sure. You've had breathlessness on exertion for two months, mild, and no ankle swelling or palpitations."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 424.25,
      "end_seconds": 426.0,
      "duration_seconds": 1.75,
      "text": "Mm, that's right."
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 426.95,
      "end_seconds": 434.4,
      "duration_seconds": 7.45,
      "text": "I'm going to send a referral to the cardiology clinic. Does all of that make sense?"
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 435.24,
      "end_seconds": 441.08,
      "duration_seconds": 5.84,
      "text": "Sorry, what was I saying, I think I understand everything. Thanks."
    }
  ]
}