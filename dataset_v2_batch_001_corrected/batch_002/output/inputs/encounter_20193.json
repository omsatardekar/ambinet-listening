{
  "schema_version": "1.0",
  "encounter_id": "20193",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.98,
      "end_seconds": 5.1,
      "duration_seconds": 4.12,
      "text": "Hi, is it okay to come in now?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.75,
      "end_seconds": 10.88,
      "duration_seconds": 4.13,
      "text": "Come in. Please sit. How can I help you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 15.83,
      "end_seconds": 24.74,
      "duration_seconds": 8.91,
      "text": "Well, I've been having itching especially at night. I just want to get back to normal, really."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 25.89,
      "end_seconds": 28.82,
      "duration_seconds": 2.93,
      "text": "How long has this been bothering you?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 30.37,
      "end_seconds": 46.06,
      "duration_seconds": 15.69,
      "text": "Erm, I'd say about a year. Actually, no, closer to nearly five years. I looked a few things up online, and that probably didn't help. I told my wife I'd come today."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 46.33,
      "end_seconds": 48.98,
      "duration_seconds": 2.65,
      "text": "Yes. Have you noticed any triggers?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 49.78,
      "end_seconds": 53.55,
      "duration_seconds": 3.77,
      "text": "Warmth and night definitely sets it off."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 54.34,
      "end_seconds": 56.57,
      "duration_seconds": 2.23,
      "text": "Is it accompanied by anything?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 58.62,
      "end_seconds": 67.26,
      "duration_seconds": 8.64,
      "text": "It usually comes with trouble sleeping. Actually, you know, the trouble sleeping? That's been for three weeks."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 68.33,
      "end_seconds": 73.7,
      "duration_seconds": 5.37,
      "text": "So, have you had any oozing, swollen glands or joint pain?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 79.67,
      "end_seconds": 82.62,
      "duration_seconds": 2.95,
      "text": "No, none of those at all."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 84.64,
      "end_seconds": 88.08,
      "duration_seconds": 3.44,
      "text": "Has your heart given you any trouble?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 89.06,
      "end_seconds": 90.5,
      "duration_seconds": 1.44,
      "text": "Nothing like that."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 92.19,
      "end_seconds": 96.67,
      "duration_seconds": 4.48,
      "text": "Are you taking anything regularly, including from the pharmacy?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 97.91,
      "end_seconds": 100.59,
      "duration_seconds": 2.68,
      "text": "It's calamine lotion, when needed."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 113.98,
      "end_seconds": 118.27,
      "duration_seconds": 4.29,
      "text": "Do you have any medical conditions I should know about?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 119.04,
      "end_seconds": 122.22,
      "duration_seconds": 3.18,
      "text": "No, I've always been fairly healthy."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 131.46,
      "end_seconds": 134.67,
      "duration_seconds": 3.21,
      "text": "Are you on your own at home?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 136.03,
      "end_seconds": 139.42,
      "duration_seconds": 3.39,
      "text": "I live with my elderly mother."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 140.07,
      "end_seconds": 141.44,
      "duration_seconds": 1.37,
      "text": "What's your work?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 142.3,
      "end_seconds": 146.58,
      "duration_seconds": 4.28,
      "text": "I'm a plumber, lots of bending and kneeling."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 162.86,
      "end_seconds": 167.89,
      "duration_seconds": 5.03,
      "text": "So, has anything ever caused you a reaction? I mean any allergies."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 169.86,
      "end_seconds": 174.11,
      "duration_seconds": 4.25,
      "text": "Naproxen. I come out in... well, stomach pain."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 178.41,
      "end_seconds": 183.16,
      "duration_seconds": 4.75,
      "text": "Can I check a few measurements before we carry on?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 192.77,
      "end_seconds": 195.35,
      "duration_seconds": 2.58,
      "text": "Bear with me while this finishes..."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 216.62,
      "end_seconds": 226.02,
      "duration_seconds": 9.4,
      "text": "Okay: pulse is 75 beats a minute, oxygen saturation is 98 percent, pressure 125 over 79, temp 36.8 degrees."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 227.16,
      "end_seconds": 232.0,
      "duration_seconds": 4.84,
      "text": "I'll need to examine you for this, it won't take long."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 233.03,
      "end_seconds": 233.94,
      "duration_seconds": 0.91,
      "text": "Sure thing."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 235.85,
      "end_seconds": 238.21,
      "duration_seconds": 2.36,
      "text": "I'll listen to your chest now."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 255.14,
      "end_seconds": 262.95,
      "duration_seconds": 7.81,
      "text": "There are small burrow-like tracks and red bumps between the fingers and on the wrists, with scratch marks."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 266.41,
      "end_seconds": 268.49,
      "duration_seconds": 2.08,
      "text": "Alright, that's the examination finished."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 286.29,
      "end_seconds": 301.71,
      "duration_seconds": 15.42,
      "text": "Taking everything into account, I'd lean towards scabies. I want to be honest that this is an impression, not a final answer. Today I'm not changing anything. Does all of that make sense?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 302.23,
      "end_seconds": 305.33,
      "duration_seconds": 3.1,
      "text": "No, that's all. Thanks a lot."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 306.74,
      "end_seconds": 308.0,
      "duration_seconds": 1.26,
      "text": "Goodbye for now."
    }
  ]
}