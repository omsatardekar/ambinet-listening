{
  "schema_version": "1.0",
  "encounter_id": "20225",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.01,
      "end_seconds": 4.08,
      "duration_seconds": 3.07,
      "text": "Sorry, doctor, shall I sit here?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 4.75,
      "end_seconds": 9.82,
      "duration_seconds": 5.07,
      "text": "Okay, of course, leave it there. How can I help?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 11.48,
      "end_seconds": 17.79,
      "duration_seconds": 6.31,
      "text": "So, you know, I've been getting breathless on the stairs, doctor."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 18.53,
      "end_seconds": 21.61,
      "duration_seconds": 3.08,
      "text": "Has this been going on for long?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 23.65,
      "end_seconds": 31.24,
      "duration_seconds": 7.59,
      "text": "For one week, I'd say. I told myself I'd wait and see, and here I am."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 32.83,
      "end_seconds": 35.58,
      "duration_seconds": 2.75,
      "text": "How often do you get it?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 36.27,
      "end_seconds": 40.22,
      "duration_seconds": 3.95,
      "text": "I'd say a couple of times a week."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 41.16,
      "end_seconds": 45.34,
      "duration_seconds": 4.18,
      "text": "Has there been a tight chest in the morning too?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 46.11,
      "end_seconds": 50.31,
      "duration_seconds": 4.2,
      "text": "Uh, yeah. About a week, I'd say."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 52.36,
      "end_seconds": 57.37,
      "duration_seconds": 5.01,
      "text": "Have you had any coughing up blood, night sweats or leg swelling?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 58.02,
      "end_seconds": 61.32,
      "duration_seconds": 3.3,
      "text": "Um, no, I'd have said so."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 63.01,
      "end_seconds": 66.5,
      "duration_seconds": 3.49,
      "text": "Have you had weight loss, by any chance?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 67.85,
      "end_seconds": 72.09,
      "duration_seconds": 4.24,
      "text": "Not at all, um, no weight loss."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 72.76,
      "end_seconds": 74.05,
      "duration_seconds": 1.29,
      "text": "Neurologically, anything strange?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 78.75,
      "end_seconds": 80.83,
      "duration_seconds": 2.08,
      "text": "No, that's all normal."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 81.45,
      "end_seconds": 84.17,
      "duration_seconds": 2.72,
      "text": "Did you ever have any procedures done?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 85.98,
      "end_seconds": 90.47,
      "duration_seconds": 4.49,
      "text": "Yes, I had a triple bypass, eight years ago."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 91.29,
      "end_seconds": 98.33,
      "duration_seconds": 7.04,
      "text": "Any allergies to tablets, food or anything in the environment? Just so I get the full picture."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 98.85,
      "end_seconds": 103.15,
      "duration_seconds": 4.3,
      "text": "Well, yes, amoxicillin. I get a rash all over."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 104.57,
      "end_seconds": 108.62,
      "duration_seconds": 4.05,
      "text": "Let's talk a little about your daily life and habits."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 109.23,
      "end_seconds": 120.01,
      "duration_seconds": 10.78,
      "text": "I swim twice a week. I grab fast food at lunch most days. I'm a bus driver, so I sit for long hours."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 129.94,
      "end_seconds": 134.73,
      "duration_seconds": 4.79,
      "text": "Alright, can you list what you take, tablets, creams or inhalers?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 136.67,
      "end_seconds": 145.26,
      "duration_seconds": 8.59,
      "text": "I take lansoprazole, 30 milligrams, before breakfast. I take aspirin, 75 milligrams, once a day."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 146.86,
      "end_seconds": 150.18,
      "duration_seconds": 3.32,
      "text": "How long have you been on it?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 152.12,
      "end_seconds": 153.65,
      "duration_seconds": 1.53,
      "text": "Two months now."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 155.07,
      "end_seconds": 160.07,
      "duration_seconds": 5.0,
      "text": "Okay, what conditions have you been treated for in the past?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 161.7,
      "end_seconds": 165.39,
      "duration_seconds": 3.69,
      "text": "I've had acid reflux for two years now."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 167.07,
      "end_seconds": 168.39,
      "duration_seconds": 1.32,
      "text": "Okay, what else?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 170.18,
      "end_seconds": 172.19,
      "duration_seconds": 2.01,
      "text": "I have heart disease."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 174.19,
      "end_seconds": 175.89,
      "duration_seconds": 1.7,
      "text": "Is there anything more?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 177.63,
      "end_seconds": 182.22,
      "duration_seconds": 4.59,
      "text": "Alright, acid reflux, that matches what I have here."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 195.09,
      "end_seconds": 198.95,
      "duration_seconds": 3.86,
      "text": "Let me get the readings out of the way."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 206.36,
      "end_seconds": 208.87,
      "duration_seconds": 2.51,
      "text": "Okay, this won't take long..."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 229.35,
      "end_seconds": 240.59,
      "duration_seconds": 11.24,
      "text": "Okay: oxygen saturation is 97 percent, blood pressure 123 over 70, heart rate 72, temperature is 36.6 degrees, respiratory rate 18."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 242.09,
      "end_seconds": 243.48,
      "duration_seconds": 1.39,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 244.46,
      "end_seconds": 248.54,
      "duration_seconds": 4.08,
      "text": "So, don't worry, we'll discuss it in a second."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 249.95,
      "end_seconds": 253.4,
      "duration_seconds": 3.45,
      "text": "Okay, time for me to examine you."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 254.1,
      "end_seconds": 255.23,
      "duration_seconds": 1.13,
      "text": "Okay, doctor."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 256.44,
      "end_seconds": 257.66,
      "duration_seconds": 1.22,
      "text": "Does that hurt?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 275.83,
      "end_seconds": 280.41,
      "duration_seconds": 4.58,
      "text": "The chest is clear and your oxygen level is normal."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 282.87,
      "end_seconds": 295.91,
      "duration_seconds": 13.04,
      "text": "Please sit back down. Let me tell you where I've got to. I think we're dealing with a lingering cough after a viral infection at this stage."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 296.66,
      "end_seconds": 299.44,
      "duration_seconds": 2.78,
      "text": "Do you think it's something serious?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 301.5,
      "end_seconds": 310.7,
      "duration_seconds": 9.2,
      "text": "It's reasonable to be concerned, but right now a lingering cough after a viral infection is my leading thought, not anything worse."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 322.16,
      "end_seconds": 352.77,
      "duration_seconds": 30.61,
      "text": "I'll request a chest X-ray, it'll help with persistent cough. I'll request a breathing test, it'll help with breathlessness. The treatment will be salbutamol inhaler, 100 micrograms, two puffs when needed, for two weeks. It's for wheeze and cough. Honey and lemon in warm water can ease it, and avoid smoky rooms. Try to keep a simple diary of when it happens and what you were doing, and bring it to the next visit."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 354.39,
      "end_seconds": 362.44,
      "duration_seconds": 8.05,
      "text": "I'd like to see you again in three weeks. That's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 363.66,
      "end_seconds": 365.74,
      "duration_seconds": 2.08,
      "text": "Thank you, doctor, goodbye."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 366.47,
      "end_seconds": 367.7,
      "duration_seconds": 1.23,
      "text": "Goodbye for now."
    }
  ]
}