{
  "schema_version": "1.0",
  "encounter_id": "20247",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.18,
      "end_seconds": 3.03,
      "duration_seconds": 1.85,
      "text": "Welcome. Make yourself comfortable."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 4.4,
      "end_seconds": 5.39,
      "duration_seconds": 0.99,
      "text": "Hi there."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 9.93,
      "end_seconds": 13.97,
      "duration_seconds": 4.04,
      "text": "Good morning, doctor. I came along to help out."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 15.59,
      "end_seconds": 21.02,
      "duration_seconds": 5.43,
      "text": "Good, that'll be useful. Pull up a chair. What's been worrying you?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 22.33,
      "end_seconds": 30.07,
      "duration_seconds": 7.74,
      "text": "Uh, it's been feeling very tired, doctor. He didn't want to come, but I insisted."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 34.15,
      "end_seconds": 37.28,
      "duration_seconds": 3.13,
      "text": "Is it a lot or only a little?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 38.16,
      "end_seconds": 39.24,
      "duration_seconds": 1.08,
      "text": "Mostly severe."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 41.1,
      "end_seconds": 44.58,
      "duration_seconds": 3.48,
      "text": "Right, have you had a sore tongue?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 46.06,
      "end_seconds": 47.85,
      "duration_seconds": 1.79,
      "text": "Yes, I have."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 48.61,
      "end_seconds": 50.32,
      "duration_seconds": 1.71,
      "text": "What brings it on?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 52.32,
      "end_seconds": 56.1,
      "duration_seconds": 3.78,
      "text": "I notice it more with spicy food."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 71.01,
      "end_seconds": 74.38,
      "duration_seconds": 3.37,
      "text": "A few quick ones: diarrhoea or rash?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 75.05,
      "end_seconds": 77.5,
      "duration_seconds": 2.45,
      "text": "No, not a single one."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 79.06,
      "end_seconds": 84.05,
      "duration_seconds": 4.99,
      "text": "Any weakness of one side, bladder problems or loss of vision?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 85.74,
      "end_seconds": 92.85,
      "duration_seconds": 7.11,
      "text": "I haven't had weakness of one side, bladder problems or loss of vision, no."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 95.58,
      "end_seconds": 97.94,
      "duration_seconds": 2.36,
      "text": "Any rashes or skin problems otherwise?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 99.29,
      "end_seconds": 100.2,
      "duration_seconds": 0.91,
      "text": "No rashes."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 101.27,
      "end_seconds": 103.99,
      "duration_seconds": 2.72,
      "text": "Have you ever had an operation?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 105.09,
      "end_seconds": 109.97,
      "duration_seconds": 4.88,
      "text": "Yes, I had part of my thyroid removed, years back."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 111.89,
      "end_seconds": 120.04,
      "duration_seconds": 8.15,
      "text": "Are there any allergies I should be aware of? I'm asking so that we don't miss anything."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 122.12,
      "end_seconds": 123.59,
      "duration_seconds": 1.47,
      "text": "No known allergies."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 124.55,
      "end_seconds": 130.18,
      "duration_seconds": 5.63,
      "text": "Tell me about your routine, work, habits, that sort of thing."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 130.7,
      "end_seconds": 147.2,
      "duration_seconds": 16.5,
      "text": "I smoke roughly a pack every two days. My husband and I live above the shop. I'm a plumber, lots of bending and kneeling. I walk the dog every morning."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 159.26,
      "end_seconds": 162.11,
      "duration_seconds": 2.85,
      "text": "What's on your current medicine list?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 162.68,
      "end_seconds": 168.96,
      "duration_seconds": 6.28,
      "text": "Mm, he is on metformin, twice a day, I give it to him."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 169.55,
      "end_seconds": 172.01,
      "duration_seconds": 2.46,
      "text": "How much do you take?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 173.4,
      "end_seconds": 174.76,
      "duration_seconds": 1.36,
      "text": "It's 500 milligrams."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 189.13,
      "end_seconds": 191.85,
      "duration_seconds": 2.72,
      "text": "Has anyone ever diagnosed you with something?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 192.71,
      "end_seconds": 196.27,
      "duration_seconds": 3.56,
      "text": "I've had diabetes for two years now."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 197.98,
      "end_seconds": 205.63,
      "duration_seconds": 7.65,
      "text": "Okay, I can see diabetes in your file as well. So, shall I check your blood pressure and pulse?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 211.84,
      "end_seconds": 214.7,
      "duration_seconds": 2.86,
      "text": "Bear with me while this finishes..."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 227.63,
      "end_seconds": 233.74,
      "duration_seconds": 6.11,
      "text": "Okay: pulse 68, pressure 110 over 72, SpO2 97 percent on room air."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 234.3,
      "end_seconds": 235.85,
      "duration_seconds": 1.55,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 237.36,
      "end_seconds": 240.16,
      "duration_seconds": 2.8,
      "text": "That's fine, I'll explain it soon."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 241.22,
      "end_seconds": 244.67,
      "duration_seconds": 3.45,
      "text": "Right, let's have a proper look at you."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 245.49,
      "end_seconds": 246.84,
      "duration_seconds": 1.35,
      "text": "Breathe out slowly."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 254.14,
      "end_seconds": 256.61,
      "duration_seconds": 2.47,
      "text": "The tongue looks smooth and red."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 257.53,
      "end_seconds": 258.52,
      "duration_seconds": 0.99,
      "text": "Sure thing."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 261.67,
      "end_seconds": 274.45,
      "duration_seconds": 12.78,
      "text": "All finished, thank you. Putting it all together, I think we're dealing with symptoms that fit a vitamin B12 deficiency at this stage. I'd also keep an under-active thyroid in mind."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 275.63,
      "end_seconds": 277.78,
      "duration_seconds": 2.15,
      "text": "Is this serious, doctor?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 278.91,
      "end_seconds": 296.13,
      "duration_seconds": 17.22,
      "text": "I can't promise yet, but most people with symptoms that fit a vitamin B12 deficiency do well once it's treated properly. Let me just check I've got this right. You've been feeling very tired, severe, and no loss of vision or diarrhoea."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 297.13,
      "end_seconds": 299.08,
      "duration_seconds": 1.95,
      "text": "Yes, you've got it."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 299.82,
      "end_seconds": 328.16,
      "duration_seconds": 28.34,
      "text": "I'd like to arrange a thyroid test for tiredness. Let's book a full blood count to look into tiredness. I'm prescribing cyanocobalamin, 1000 micrograms, every other day, for two weeks. It's for low vitamin B12. Eating more eggs, dairy and fortified cereals will help over time. Make sure you're drinking plenty of fluids, two to three litres a day if you can, and get proper rest."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 330.0,
      "end_seconds": 342.76,
      "duration_seconds": 12.76,
      "text": "Let's hold off on a vitamin B12 level for now, and if there's no change in two weeks we can revisit it. Okay, that's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 343.45,
      "end_seconds": 346.5,
      "duration_seconds": 3.05,
      "text": "No, that's all. Thanks a lot."
    }
  ]
}