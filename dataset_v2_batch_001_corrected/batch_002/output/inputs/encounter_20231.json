{
  "schema_version": "1.0",
  "encounter_id": "20231",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.69,
      "end_seconds": 2.99,
      "duration_seconds": 2.3,
      "text": "Afternoon, thanks for coming in."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 5.0,
      "end_seconds": 10.53,
      "duration_seconds": 5.53,
      "text": "Hi doctor, I got here as fast as I could."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 12.44,
      "end_seconds": 15.36,
      "duration_seconds": 2.92,
      "text": "How are things, what's been happening?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 17.03,
      "end_seconds": 21.71,
      "duration_seconds": 4.68,
      "text": "I'm here because of a rash between my fingers."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 22.55,
      "end_seconds": 25.07,
      "duration_seconds": 2.52,
      "text": "Let me quickly check your readings."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 32.91,
      "end_seconds": 34.94,
      "duration_seconds": 2.03,
      "text": "Sit still for a moment..."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 44.53,
      "end_seconds": 55.16,
      "duration_seconds": 10.63,
      "text": "Okay: pulse is 78 beats a minute, respiratory rate 14. And BP is 111 over 68, saturation 99 percent. How long has it been like this?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 55.98,
      "end_seconds": 61.88,
      "duration_seconds": 5.9,
      "text": "Around about three months... no wait, it's more like about a month."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 62.61,
      "end_seconds": 65.44,
      "duration_seconds": 2.83,
      "text": "How troublesome is it day to day?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 67.35,
      "end_seconds": 76.14,
      "duration_seconds": 8.79,
      "text": "About a six out of ten. Uh, I've also had trouble sleeping, for about a month."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 76.7,
      "end_seconds": 77.48,
      "duration_seconds": 0.78,
      "text": "I follow."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 94.09,
      "end_seconds": 101.35,
      "duration_seconds": 7.26,
      "text": "Let me check a few things. Any new medicines, swollen glands, fever or rash on the face?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 103.31,
      "end_seconds": 110.31,
      "duration_seconds": 7.0,
      "text": "No, no new medicines, swollen glands, fever or rash on the face."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 112.27,
      "end_seconds": 115.01,
      "duration_seconds": 2.74,
      "text": "So, have you had any oozing?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 115.61,
      "end_seconds": 117.12,
      "duration_seconds": 1.51,
      "text": "Definitely no oozing."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 119.05,
      "end_seconds": 121.37,
      "duration_seconds": 2.32,
      "text": "Is your digestion otherwise okay?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 122.35,
      "end_seconds": 124.39,
      "duration_seconds": 2.04,
      "text": "No, all normal there."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 138.47,
      "end_seconds": 142.81,
      "duration_seconds": 4.34,
      "text": "Tell me about any past illnesses or ongoing conditions."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 144.22,
      "end_seconds": 157.25,
      "duration_seconds": 13.03,
      "text": "High cholesterol, for about a year. It's the not knowing that gets to me. Asthma, for two years. I've, I've had an underactive thyroid, yes."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 159.1,
      "end_seconds": 164.74,
      "duration_seconds": 5.64,
      "text": "Alright, asthma, that matches what I have here. Anything surgical in your history?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 166.06,
      "end_seconds": 171.08,
      "duration_seconds": 5.02,
      "text": "I had a wisdom tooth extraction under sedation five years ago."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 172.7,
      "end_seconds": 175.41,
      "duration_seconds": 2.71,
      "text": "Before we go further, any allergies?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 176.14,
      "end_seconds": 181.49,
      "duration_seconds": 5.35,
      "text": "I'm allergic to amoxicillin, I get a rash all over."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 198.71,
      "end_seconds": 203.44,
      "duration_seconds": 4.73,
      "text": "Can you list what you take, tablets, creams or inhalers?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 204.56,
      "end_seconds": 222.86,
      "duration_seconds": 18.3,
      "text": "It's rosuvastatin, 10 milligrams, at night. Asthalin inhaler, when needed for my asthma. I took the morning off to come in today. Sorry, I know I'm rambling a bit. Eltroxin. I take it every morning for my thyroid."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 224.34,
      "end_seconds": 226.37,
      "duration_seconds": 2.03,
      "text": "How much do you take?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 227.15,
      "end_seconds": 230.91,
      "duration_seconds": 3.76,
      "text": "It's 100 micrograms. Calamine lotion, when needed."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 232.42,
      "end_seconds": 233.81,
      "duration_seconds": 1.39,
      "text": "Is that long-standing?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 235.5,
      "end_seconds": 237.57,
      "duration_seconds": 2.07,
      "text": "For about a month."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 238.75,
      "end_seconds": 244.12,
      "duration_seconds": 5.37,
      "text": "Tell me about your routine, work, habits, that sort of thing."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 248.17,
      "end_seconds": 258.91,
      "duration_seconds": 10.74,
      "text": "Not much, I mostly stay in these days. My partner and our baby. Yes, I work in a bakery, early starts."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 259.95,
      "end_seconds": 263.99,
      "duration_seconds": 4.04,
      "text": "Alright, over here please and I'll take a look."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 265.63,
      "end_seconds": 266.76,
      "duration_seconds": 1.13,
      "text": "Sure thing."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 268.06,
      "end_seconds": 271.38,
      "duration_seconds": 3.32,
      "text": "Alright, stay as you are for a moment."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 287.67,
      "end_seconds": 296.24,
      "duration_seconds": 8.57,
      "text": "There are small burrow-like tracks and red bumps between the fingers and on the wrists, with scratch marks."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 297.78,
      "end_seconds": 298.88,
      "duration_seconds": 1.1,
      "text": "Of course."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 301.37,
      "end_seconds": 333.63,
      "duration_seconds": 32.26,
      "text": "Thank you, you can get dressed. Taking everything into account, my working impression is scabies. An allergic rash is still possible. I'd like you to take permethrin cream, 5 percent, once, then again after a week, for two weeks. That's for scabies. Everyone at home should be treated at the same time, and wash bedding and clothes at a high temperature. We'll catch up if the itching continues after four weeks. Okay, does all of that make sense?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 335.31,
      "end_seconds": 338.8,
      "duration_seconds": 3.49,
      "text": "Okay, that makes sense. Thanks for explaining."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 340.37,
      "end_seconds": 341.57,
      "duration_seconds": 1.2,
      "text": "See you soon."
    }
  ]
}