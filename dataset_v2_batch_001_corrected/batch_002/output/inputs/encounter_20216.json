{
  "schema_version": "1.0",
  "encounter_id": "20216",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.26,
      "end_seconds": 5.88,
      "duration_seconds": 4.62,
      "text": "Actually, hello, doctor. I think it's my turn."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.58,
      "end_seconds": 12.03,
      "duration_seconds": 4.45,
      "text": "Yes, have a seat. Tell me what's going on."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 12.99,
      "end_seconds": 22.75,
      "duration_seconds": 9.76,
      "text": "I'm here because of thick green mucus. A neighbour of mine said I should see someone about it."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 24.57,
      "end_seconds": 28.47,
      "duration_seconds": 3.9,
      "text": "How many days or weeks has it been?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 29.92,
      "end_seconds": 42.91,
      "duration_seconds": 12.99,
      "text": "Probably five days. Yeah. Let me think, and there's pain around my cheeks as well, about two weeks now. I've also had a blocked nose."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 44.39,
      "end_seconds": 46.58,
      "duration_seconds": 2.19,
      "text": "What eases it, if anything?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 47.08,
      "end_seconds": 51.56,
      "duration_seconds": 4.48,
      "text": "Um, only steam, and it's not much."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 52.08,
      "end_seconds": 58.99,
      "duration_seconds": 6.91,
      "text": "Okay, have you had thick green mucus before, or is this the first time?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 59.83,
      "end_seconds": 65.98,
      "duration_seconds": 6.15,
      "text": "A bit, last year. It settled by itself back then."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 67.52,
      "end_seconds": 68.45,
      "duration_seconds": 0.93,
      "text": "Any nosebleeds?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 73.85,
      "end_seconds": 76.49,
      "duration_seconds": 2.64,
      "text": "I haven't noticed any nosebleeds."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 77.68,
      "end_seconds": 83.0,
      "duration_seconds": 5.32,
      "text": "And what about toothache, double vision, fever or swelling around the eyes?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 84.7,
      "end_seconds": 91.02,
      "duration_seconds": 6.32,
      "text": "No, no toothache, double vision, fever or swelling around the eyes."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 91.42,
      "end_seconds": 97.03,
      "duration_seconds": 5.61,
      "text": "Okay, go on. Any change in your bowel habit or your stomach generally?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 98.13,
      "end_seconds": 100.95,
      "duration_seconds": 2.82,
      "text": "Bowels are regular, nothing odd."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 102.94,
      "end_seconds": 106.59,
      "duration_seconds": 3.65,
      "text": "Okay, any muscle or joint problems besides this?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 108.35,
      "end_seconds": 111.49,
      "duration_seconds": 3.14,
      "text": "Um, no, joints are fine."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 113.39,
      "end_seconds": 117.03,
      "duration_seconds": 3.64,
      "text": "Are you taking anything regularly, including from the pharmacy?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 117.72,
      "end_seconds": 123.44,
      "duration_seconds": 5.72,
      "text": "Okay, so it's thyroxine, 75 micrograms, every morning for my thyroid."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 132.73,
      "end_seconds": 137.17,
      "duration_seconds": 4.44,
      "text": "Are there any allergies I should be aware of?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 137.7,
      "end_seconds": 141.58,
      "duration_seconds": 3.88,
      "text": "Walnuts. I come out in... well, hives."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 154.03,
      "end_seconds": 158.0,
      "duration_seconds": 3.97,
      "text": "Anything in your past medical history I should know?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 159.05,
      "end_seconds": 167.23,
      "duration_seconds": 8.18,
      "text": "Mm, I've had asthma for about ten years now. I have an underactive thyroid."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 169.07,
      "end_seconds": 176.76,
      "duration_seconds": 7.69,
      "text": "I follow. Alright, an underactive thyroid, that matches what I have here. Any surgery in the past?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 177.91,
      "end_seconds": 182.82,
      "duration_seconds": 4.91,
      "text": "I had keyhole surgery on my gallbladder two years back."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 184.09,
      "end_seconds": 188.23,
      "duration_seconds": 4.14,
      "text": "Let's talk a little about your daily life and habits."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 190.12,
      "end_seconds": 206.88,
      "duration_seconds": 16.76,
      "text": "I gave up cigarettes last spring. Lots of rice, lentils and some fruit. No, I share a house with my brother. Yes, I work in a bakery, early starts."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 215.94,
      "end_seconds": 218.43,
      "duration_seconds": 2.49,
      "text": "Alright, I'll do your observations first."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 231.29,
      "end_seconds": 233.81,
      "duration_seconds": 2.52,
      "text": "Keep your arm relaxed for me..."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 246.7,
      "end_seconds": 253.05,
      "duration_seconds": 6.35,
      "text": "Okay: respiratory rate 22, pulse is 104 beats a minute, BP is 108 over 72."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 254.48,
      "end_seconds": 256.17,
      "duration_seconds": 1.69,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 257.43,
      "end_seconds": 260.71,
      "duration_seconds": 3.28,
      "text": "Don't worry, we'll discuss it in a second."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 262.08,
      "end_seconds": 264.25,
      "duration_seconds": 2.17,
      "text": "May I examine you now?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 265.33,
      "end_seconds": 266.51,
      "duration_seconds": 1.18,
      "text": "Nearly finished here."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 276.64,
      "end_seconds": 282.28,
      "duration_seconds": 5.64,
      "text": "There is tenderness over both cheeks and the nose is blocked with swollen lining."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 284.49,
      "end_seconds": 296.24,
      "duration_seconds": 11.75,
      "text": "Thank you, you can get dressed. Let me repeat that back to make sure. You've had thick green mucus for five days, and no nosebleeds or double vision."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 298.21,
      "end_seconds": 300.16,
      "duration_seconds": 1.95,
      "text": "That's it, yes."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 302.01,
      "end_seconds": 311.33,
      "duration_seconds": 9.32,
      "text": "For this, fluticasone nasal spray, 50 micrograms, two sprays each side once a day, for two weeks. That's for sinus congestion."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 311.95,
      "end_seconds": 315.78,
      "duration_seconds": 3.83,
      "text": "Is that safe with my other medicines?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 316.71,
      "end_seconds": 326.67,
      "duration_seconds": 9.96,
      "text": "Steam inhalation and saline rinses can help clear the nose. Please come and see me in two weeks. Does all of that make sense?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 327.87,
      "end_seconds": 330.02,
      "duration_seconds": 2.15,
      "text": "Thank you, that's helpful."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 331.08,
      "end_seconds": 332.3,
      "duration_seconds": 1.22,
      "text": "See you soon."
    }
  ]
}