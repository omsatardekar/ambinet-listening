{
  "schema_version": "1.0",
  "encounter_id": "20366",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.28,
      "end_seconds": 5.12,
      "duration_seconds": 3.84,
      "text": "Hi, doctor, I hope I'm not disturbing you."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.81,
      "end_seconds": 11.01,
      "duration_seconds": 4.2,
      "text": "That's fine, sit down. Tell me why you came."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 11.94,
      "end_seconds": 18.57,
      "duration_seconds": 6.63,
      "text": "Erm, honestly, it's spots on my face, and my family pushed me to come."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 19.55,
      "end_seconds": 22.87,
      "duration_seconds": 3.32,
      "text": "How long has it been like this?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 24.65,
      "end_seconds": 31.69,
      "duration_seconds": 7.04,
      "text": "About... well, six months. It's a relief to finally sit down and talk about it."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 31.98,
      "end_seconds": 35.31,
      "duration_seconds": 3.33,
      "text": "Mm-hmm. Is it worse at certain times?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 36.1,
      "end_seconds": 39.24,
      "duration_seconds": 3.14,
      "text": "It's worse with stress and greasy skin."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 40.3,
      "end_seconds": 42.88,
      "duration_seconds": 2.58,
      "text": "Have you tried anything for it?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 44.24,
      "end_seconds": 48.11,
      "duration_seconds": 3.87,
      "text": "Actually, only face wash, and it's not much."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 48.37,
      "end_seconds": 52.86,
      "duration_seconds": 4.49,
      "text": "Yes, carry on. Have you been feeling low about your skin?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 53.69,
      "end_seconds": 55.9,
      "duration_seconds": 2.21,
      "text": "Yes, for four weeks."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 57.94,
      "end_seconds": 60.28,
      "duration_seconds": 2.34,
      "text": "Any sore red lumps as well?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 61.94,
      "end_seconds": 63.53,
      "duration_seconds": 1.59,
      "text": "Yeah, that too."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 65.2,
      "end_seconds": 71.43,
      "duration_seconds": 6.23,
      "text": "Let me check a few things. Any headaches, irregular periods or being pregnant?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 72.84,
      "end_seconds": 75.87,
      "duration_seconds": 3.03,
      "text": "No, none of those at all."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 77.12,
      "end_seconds": 79.14,
      "duration_seconds": 2.02,
      "text": "Any sign of joint pain?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 81.19,
      "end_seconds": 83.39,
      "duration_seconds": 2.2,
      "text": "No joint pain, thankfully."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 88.41,
      "end_seconds": 92.43,
      "duration_seconds": 4.02,
      "text": "Anything with your nerves, like weakness or numbness?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 93.5,
      "end_seconds": 95.56,
      "duration_seconds": 2.06,
      "text": "No, that's all normal."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 100.05,
      "end_seconds": 102.51,
      "duration_seconds": 2.46,
      "text": "Any trouble with the waterworks?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 104.44,
      "end_seconds": 106.0,
      "duration_seconds": 1.56,
      "text": "Nothing there, no."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 120.27,
      "end_seconds": 122.61,
      "duration_seconds": 2.34,
      "text": "Is there someone at home?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 123.59,
      "end_seconds": 127.75,
      "duration_seconds": 4.16,
      "text": "My husband and I live above the shop."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 129.76,
      "end_seconds": 132.07,
      "duration_seconds": 2.31,
      "text": "Do you do any exercise?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 135.79,
      "end_seconds": 138.46,
      "duration_seconds": 2.67,
      "text": "I swim twice a week."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 139.63,
      "end_seconds": 143.31,
      "duration_seconds": 3.68,
      "text": "What does a normal day of food look like?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 144.81,
      "end_seconds": 148.85,
      "duration_seconds": 4.04,
      "text": "Lots of rice, lentils and some fruit."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 149.46,
      "end_seconds": 152.82,
      "duration_seconds": 3.36,
      "text": "Let me ask about allergies, anything at all?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 154.04,
      "end_seconds": 160.86,
      "duration_seconds": 6.82,
      "text": "Sorry, uh, what was I saying, I don't think I have any, no."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 162.0,
      "end_seconds": 164.54,
      "duration_seconds": 2.54,
      "text": "Tell me your medicines, please."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 166.2,
      "end_seconds": 176.29,
      "duration_seconds": 10.09,
      "text": "Escitalopram. I take it 10 milligrams, once a day for the anxiety. So, I take face wash, twice a day."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 189.06,
      "end_seconds": 192.27,
      "duration_seconds": 3.21,
      "text": "Does your family have any medical conditions?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 194.36,
      "end_seconds": 196.65,
      "duration_seconds": 2.29,
      "text": "My father has Parkinson's disease."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 202.21,
      "end_seconds": 204.65,
      "duration_seconds": 2.44,
      "text": "What about your medical history?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 205.16,
      "end_seconds": 212.78,
      "duration_seconds": 7.62,
      "text": "I've had anxiety for about ten years now. I did try to ignore it for a while."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 214.49,
      "end_seconds": 218.58,
      "duration_seconds": 4.09,
      "text": "Okay, I can see anxiety in your file as well."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 233.93,
      "end_seconds": 237.16,
      "duration_seconds": 3.23,
      "text": "Any past operations I should know about?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 238.92,
      "end_seconds": 243.9,
      "duration_seconds": 4.98,
      "text": "Yes, I had my tonsils removed, as a teenager."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 245.98,
      "end_seconds": 248.19,
      "duration_seconds": 2.21,
      "text": "I'll do your observations first."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 254.25,
      "end_seconds": 257.02,
      "duration_seconds": 2.77,
      "text": "Alright, nearly done with the readings..."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 278.02,
      "end_seconds": 285.44,
      "duration_seconds": 7.42,
      "text": "Okay: pulse is 77 beats a minute, oxygen saturation is 98 percent, blood pressure 117 over 75."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 286.86,
      "end_seconds": 288.52,
      "duration_seconds": 1.66,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 290.22,
      "end_seconds": 292.41,
      "duration_seconds": 2.19,
      "text": "We'll go over that shortly."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 293.79,
      "end_seconds": 296.02,
      "duration_seconds": 2.23,
      "text": "Shall I start the examination?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 297.32,
      "end_seconds": 298.6,
      "duration_seconds": 1.28,
      "text": "Look straight ahead."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 313.36,
      "end_seconds": 321.5,
      "duration_seconds": 8.14,
      "text": "There are red inflamed lumps and blackheads over both cheeks and the forehead, and a few scars."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 325.1,
      "end_seconds": 359.95,
      "duration_seconds": 34.85,
      "text": "All finished, thank you. Okay, thinking it through, I'd lean towards moderate inflammatory acne. I'd like to arrange blood tests for acne treatment baseline. You'll be taking adapalene gel, 0.1 percent, once a night, for twelve weeks. That should help with acne. Use sunscreen daily, and the gel can sting for the first couple of weeks. Please come and see me in twelve weeks. Right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 361.38,
      "end_seconds": 364.63,
      "duration_seconds": 3.25,
      "text": "No, that's all. Thanks a lot."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 365.37,
      "end_seconds": 367.29,
      "duration_seconds": 1.92,
      "text": "Right, see you soon."
    }
  ]
}