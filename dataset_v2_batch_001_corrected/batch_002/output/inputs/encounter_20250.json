{
  "schema_version": "1.0",
  "encounter_id": "20250",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.76,
      "end_seconds": 4.18,
      "duration_seconds": 3.42,
      "text": "Hello, good to see you. Please sit."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 5.77,
      "end_seconds": 6.85,
      "duration_seconds": 1.08,
      "text": "evening, doctor"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 8.81,
      "end_seconds": 11.54,
      "duration_seconds": 2.73,
      "text": "Did the receptionist sort you out quickly?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 13.22,
      "end_seconds": 16.59,
      "duration_seconds": 3.37,
      "text": "Yes, she was lovely about it."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 21.56,
      "end_seconds": 24.25,
      "duration_seconds": 2.69,
      "text": "Start wherever you like, I'm listening."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 25.43,
      "end_seconds": 31.91,
      "duration_seconds": 6.48,
      "text": "Doctor, it's spots on my face. It's getting on my nerves now."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 32.47,
      "end_seconds": 35.56,
      "duration_seconds": 3.09,
      "text": "How long has this been bothering you?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 39.54,
      "end_seconds": 44.01,
      "duration_seconds": 4.47,
      "text": "It's been about a year, I'm fairly sure."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 45.76,
      "end_seconds": 49.37,
      "duration_seconds": 3.61,
      "text": "have you had extra hair on your chin?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 50.21,
      "end_seconds": 51.84,
      "duration_seconds": 1.63,
      "text": "Yeah, that too."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 53.54,
      "end_seconds": 57.07,
      "duration_seconds": 3.53,
      "text": "Have you had pelvic pain, by any chance?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 59.03,
      "end_seconds": 61.18,
      "duration_seconds": 2.15,
      "text": "No, no pelvic pain."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 62.08,
      "end_seconds": 69.49,
      "duration_seconds": 7.41,
      "text": "Let me check a few things. Any breast discharge, headaches with vision changes or hot flushes?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 70.62,
      "end_seconds": 76.74,
      "duration_seconds": 6.12,
      "text": "No breast discharge, headaches with vision changes or hot flushes, none of it."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 77.29,
      "end_seconds": 81.97,
      "duration_seconds": 4.68,
      "text": "Sure. Any change in your bowel habit or your stomach generally?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 83.59,
      "end_seconds": 86.32,
      "duration_seconds": 2.73,
      "text": "Bowels are regular, nothing odd."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 91.38,
      "end_seconds": 96.75,
      "duration_seconds": 5.37,
      "text": "Has anything ever caused you a reaction? I mean any allergies."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 97.59,
      "end_seconds": 100.46,
      "duration_seconds": 2.87,
      "text": "Not to my knowledge, no."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 101.17,
      "end_seconds": 106.07,
      "duration_seconds": 4.9,
      "text": "Any inherited conditions that you know of in the family?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 107.7,
      "end_seconds": 109.5,
      "duration_seconds": 1.8,
      "text": "my cousin has psoriasis"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 116.6,
      "end_seconds": 119.37,
      "duration_seconds": 2.77,
      "text": "what line of work are you in?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 123.33,
      "end_seconds": 128.14,
      "duration_seconds": 4.81,
      "text": "I'm a bus driver, so I sit for long hours."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 129.8,
      "end_seconds": 133.9,
      "duration_seconds": 4.1,
      "text": "What does a normal day of food look like?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 135.85,
      "end_seconds": 139.82,
      "duration_seconds": 3.97,
      "text": "Lots of rice, lentils and some fruit."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 141.3,
      "end_seconds": 145.75,
      "duration_seconds": 4.45,
      "text": "Do you have any medical conditions I should know about?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 147.06,
      "end_seconds": 151.3,
      "duration_seconds": 4.24,
      "text": "No, you know, nothing I can think of."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 166.68,
      "end_seconds": 169.56,
      "duration_seconds": 2.88,
      "text": "any regular medication, tablets or creams?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 170.44,
      "end_seconds": 173.24,
      "duration_seconds": 2.8,
      "text": "No, I'm not on anything."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 188.96,
      "end_seconds": 192.17,
      "duration_seconds": 3.21,
      "text": "Time for your numbers, if that's okay."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 198.96,
      "end_seconds": 201.6,
      "duration_seconds": 2.64,
      "text": "Bear with me while this finishes..."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 219.09,
      "end_seconds": 229.19,
      "duration_seconds": 10.1,
      "text": "Okay: BP is 121 over 75, pulse is 79 beats a minute, SpO2 99 percent on room air, temperature 36.9."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 230.73,
      "end_seconds": 232.86,
      "duration_seconds": 2.13,
      "text": "Is that alright, doctor?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 238.57,
      "end_seconds": 241.52,
      "duration_seconds": 2.95,
      "text": "I'll come back to the numbers."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 243.37,
      "end_seconds": 245.37,
      "duration_seconds": 2.0,
      "text": "may I examine you now?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 246.86,
      "end_seconds": 249.47,
      "duration_seconds": 2.61,
      "text": "Take a deep breath for me."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 266.26,
      "end_seconds": 274.84,
      "duration_seconds": 8.58,
      "text": "There is some acne on the face and extra hair on the chin, and your blood pressure is fine."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 278.38,
      "end_seconds": 280.14,
      "duration_seconds": 1.76,
      "text": "You can relax now."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 295.15,
      "end_seconds": 318.31,
      "duration_seconds": 23.16,
      "text": "Okay, thinking it through, I think we're dealing with a pattern that fits polycystic ovary syndrome at this stage. I'm going to order a thyroid test, for weight gain. I'd like you to take metformin, 500 milligrams, once a day with food, for three months. That should help with cycle regulation and weight."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 319.04,
      "end_seconds": 322.83,
      "duration_seconds": 3.79,
      "text": "Should I carry on if I feel better?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 323.5,
      "end_seconds": 341.84,
      "duration_seconds": 18.34,
      "text": "Regular exercise and a small weight loss can make cycles more regular. The thing that would worry me is if you get very heavy bleeding or severe pelvic pain. If that happens, go to emergency. Alright, is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 343.84,
      "end_seconds": 347.5,
      "duration_seconds": 3.66,
      "text": "So, you know, thank you, doctor, goodbye."
    }
  ]
}