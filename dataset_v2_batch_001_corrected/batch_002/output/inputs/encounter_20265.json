{
  "schema_version": "1.0",
  "encounter_id": "20265",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.26,
      "end_seconds": 4.37,
      "duration_seconds": 3.11,
      "text": "Morning, doctor. Lovely to meet you."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.67,
      "end_seconds": 9.75,
      "duration_seconds": 4.08,
      "text": "So, come in. Please sit. How can I help you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 10.8,
      "end_seconds": 16.38,
      "duration_seconds": 5.58,
      "text": "Um, I'm here because of numbness in my feet."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 16.91,
      "end_seconds": 20.26,
      "duration_seconds": 3.35,
      "text": "How long has this been bothering you?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 21.41,
      "end_seconds": 23.27,
      "duration_seconds": 1.86,
      "text": "Probably three days. Yeah."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 24.9,
      "end_seconds": 30.17,
      "duration_seconds": 5.27,
      "text": "Okay, give me more detail on it, whatever comes to mind."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 31.1,
      "end_seconds": 43.99,
      "duration_seconds": 12.89,
      "text": "Pretty moderate, if I'm being honest. I'd say on and off. And there's a sore on the bottom of my foot as well, about four days now."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 45.49,
      "end_seconds": 51.93,
      "duration_seconds": 6.44,
      "text": "And what about calf pain, vomiting, chest pain or pain at rest in the leg?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 53.0,
      "end_seconds": 61.11,
      "duration_seconds": 8.11,
      "text": "I haven't had calf pain, vomiting, chest pain or pain at rest in the leg, no"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 61.4,
      "end_seconds": 64.59,
      "duration_seconds": 3.19,
      "text": "I follow any trouble with the waterworks?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 65.12,
      "end_seconds": 69.52,
      "duration_seconds": 4.4,
      "text": "mm, that's normal as far as I know"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 78.54,
      "end_seconds": 81.95,
      "duration_seconds": 3.41,
      "text": "So, what's on your current medicine list?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 83.39,
      "end_seconds": 93.14,
      "duration_seconds": 9.75,
      "text": "I take gliclazide, 80 milligrams, twice a day for my sugar. I take metoprolol, 50 milligrams, maybe, twice a day"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 95.21,
      "end_seconds": 98.42,
      "duration_seconds": 3.21,
      "text": "Is the packet here, or the prescription?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 99.05,
      "end_seconds": 101.01,
      "duration_seconds": 1.96,
      "text": "No, it's at home."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 103.02,
      "end_seconds": 104.45,
      "duration_seconds": 1.43,
      "text": "What's your work?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 105.99,
      "end_seconds": 109.77,
      "duration_seconds": 3.78,
      "text": "I'm a plumber, lots of bending and kneeling."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 111.64,
      "end_seconds": 114.74,
      "duration_seconds": 3.1,
      "text": "are you on your own at home?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 116.4,
      "end_seconds": 119.81,
      "duration_seconds": 3.41,
      "text": "I live with my elderly mother"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 122.9,
      "end_seconds": 124.99,
      "duration_seconds": 2.09,
      "text": "what about your medical history?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 125.7,
      "end_seconds": 130.3,
      "duration_seconds": 4.6,
      "text": "right, I've had diabetes for nearly five years now"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 131.25,
      "end_seconds": 132.32,
      "duration_seconds": 1.07,
      "text": "Hm, okay."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 133.55,
      "end_seconds": 142.1,
      "duration_seconds": 8.55,
      "text": "I have high blood pressure. It's a relief to finally sit down and talk about it"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 143.42,
      "end_seconds": 144.12,
      "duration_seconds": 0.7,
      "text": "Understood."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 161.4,
      "end_seconds": 164.66,
      "duration_seconds": 3.26,
      "text": "let me ask about allergies, anything at all?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 165.69,
      "end_seconds": 173.03,
      "duration_seconds": 7.34,
      "text": "years back I got itching from trimethoprim, so so I stay away from it now"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 173.9,
      "end_seconds": 176.86,
      "duration_seconds": 2.96,
      "text": "I'll note down your vital signs first."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 190.28,
      "end_seconds": 193.11,
      "duration_seconds": 2.83,
      "text": "Okay, sit still for a moment..."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 210.81,
      "end_seconds": 231.47,
      "duration_seconds": 20.66,
      "text": "okay: blood pressure 112 over 68, pulse 105, saturation 97 percent going by what you've described, I'd lean towards an infected diabetic foot ulcer i wanna be honest that this is an impression, not a final answer it could also be pressure damage, so we'll keep that open"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 241.94,
      "end_seconds": 246.06,
      "duration_seconds": 4.12,
      "text": "I'm going to order a foot X-ray, for ulcer."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 247.29,
      "end_seconds": 249.16,
      "duration_seconds": 1.87,
      "text": "is that done today?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 250.75,
      "end_seconds": 282.85,
      "duration_seconds": 32.1,
      "text": "I'll request a swab from the ulcer, it'll help with infected ulcer. I'd rather check than guess, and this is the quickest way to know more. I'm going to order blood tests, for infection. We'll begin with amoxicillin/clavulanic acid, 625 milligrams, three times a day, for seven days. That should help with foot infection. Keep the weight off that foot and keep the dressing dry."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 284.24,
      "end_seconds": 294.6,
      "duration_seconds": 10.36,
      "text": "a short walk every day, even twenty minutes, will help more than you'd think i'll also refer you to the foot clinic"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 295.57,
      "end_seconds": 296.27,
      "duration_seconds": 0.7,
      "text": "Okay."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 297.58,
      "end_seconds": 305.7,
      "duration_seconds": 8.12,
      "text": "And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 306.55,
      "end_seconds": 310.88,
      "duration_seconds": 4.33,
      "text": "Okay, uh, I'll look out for that."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 312.56,
      "end_seconds": 319.52,
      "duration_seconds": 6.96,
      "text": "Do get help quickly if the the redness spreads or you feel unwell with a fever."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 320.7,
      "end_seconds": 324.14,
      "duration_seconds": 3.44,
      "text": "Oh, okay, I'll look out for that."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 325.76,
      "end_seconds": 331.59,
      "duration_seconds": 5.83,
      "text": "See me again in three days. That's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 333.23,
      "end_seconds": 337.54,
      "duration_seconds": 4.31,
      "text": "Hmm, good, thanks, I'll see you then."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 338.81,
      "end_seconds": 340.06,
      "duration_seconds": 1.25,
      "text": "Look after yourself."
    }
  ]
}