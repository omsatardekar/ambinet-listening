{
  "schema_version": "1.0",
  "encounter_id": "20096",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.3,
      "end_seconds": 6.01,
      "duration_seconds": 4.71,
      "text": "Erm, hi, doctor, I hope I'm not disturbing you."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 11.11,
      "end_seconds": 15.09,
      "duration_seconds": 3.98,
      "text": "No problem at all, come in. What's troubling you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 16.51,
      "end_seconds": 19.43,
      "duration_seconds": 2.92,
      "text": "It's pain around my cheeks, mostly."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 20.68,
      "end_seconds": 23.98,
      "duration_seconds": 3.3,
      "text": "How many days or weeks has it been?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 24.82,
      "end_seconds": 33.33,
      "duration_seconds": 8.51,
      "text": "It's been two days now. I didn't want to bother you but it keeps coming back."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 35.01,
      "end_seconds": 42.9,
      "duration_seconds": 7.89,
      "text": "Can you describe it a bit more for me? How strong it is, what the pattern is, what helps."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 44.39,
      "end_seconds": 53.39,
      "duration_seconds": 9.0,
      "text": "I'd say a few times a day. Maybe a three out of ten on a bad day."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 63.84,
      "end_seconds": 68.88,
      "duration_seconds": 5.04,
      "text": "Let me check a few things. Any fever or double vision?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 70.02,
      "end_seconds": 73.91,
      "duration_seconds": 3.89,
      "text": "I haven't had fever or double vision, no."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 75.71,
      "end_seconds": 77.11,
      "duration_seconds": 1.4,
      "text": "What about toothache?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 79.8,
      "end_seconds": 81.57,
      "duration_seconds": 1.77,
      "text": "No, no toothache."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 81.86,
      "end_seconds": 85.98,
      "duration_seconds": 4.12,
      "text": "Understood. Anything with your nerves, like weakness or numbness?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 87.21,
      "end_seconds": 89.02,
      "duration_seconds": 1.81,
      "text": "No weakness or anything."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 90.14,
      "end_seconds": 92.87,
      "duration_seconds": 2.73,
      "text": "Any breathing difficulties apart from this?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 94.3,
      "end_seconds": 96.26,
      "duration_seconds": 1.96,
      "text": "No problems with breathing."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 109.55,
      "end_seconds": 113.08,
      "duration_seconds": 3.53,
      "text": "Any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 114.84,
      "end_seconds": 116.63,
      "duration_seconds": 1.79,
      "text": "No, no conditions."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 117.51,
      "end_seconds": 122.09,
      "duration_seconds": 4.58,
      "text": "Any allergies to tablets, food or anything in the environment?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 123.73,
      "end_seconds": 127.28,
      "duration_seconds": 3.55,
      "text": "Wheat. I come out in... well, bloating."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 129.29,
      "end_seconds": 131.63,
      "duration_seconds": 2.34,
      "text": "Anything surgical in your history?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 132.43,
      "end_seconds": 144.45,
      "duration_seconds": 12.02,
      "text": "Just a cataract operation in my left eye, about a year ago. I'd rather not end up on lots of tablets if I can avoid it."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 158.58,
      "end_seconds": 159.92,
      "duration_seconds": 1.34,
      "text": "Are you active?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 161.87,
      "end_seconds": 165.0,
      "duration_seconds": 3.13,
      "text": "I walk the dog every morning."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 166.69,
      "end_seconds": 170.13,
      "duration_seconds": 3.44,
      "text": "What do you do during the day?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 171.94,
      "end_seconds": 175.3,
      "duration_seconds": 3.36,
      "text": "I look after my grandchildren most days."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 175.81,
      "end_seconds": 180.05,
      "duration_seconds": 4.24,
      "text": "Can you list what you take, tablets, creams or inhalers?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 181.22,
      "end_seconds": 186.19,
      "duration_seconds": 4.97,
      "text": "I'm on saline nasal spray, several times a day."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 187.81,
      "end_seconds": 191.08,
      "duration_seconds": 3.27,
      "text": "I'll note down your vital signs first."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 202.07,
      "end_seconds": 205.05,
      "duration_seconds": 2.98,
      "text": "That's it, just a little longer..."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 214.29,
      "end_seconds": 223.04,
      "duration_seconds": 8.75,
      "text": "Okay: saturation 97 percent, pulse is 107 beats a minute, BP is 105 over 74, temperature 39.0."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 224.84,
      "end_seconds": 228.1,
      "duration_seconds": 3.26,
      "text": "Is that alright, uh, doctor?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 229.84,
      "end_seconds": 232.41,
      "duration_seconds": 2.57,
      "text": "We'll look at it together shortly."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 234.78,
      "end_seconds": 239.01,
      "duration_seconds": 4.23,
      "text": "I'd like to check you over now, if that's alright."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 240.6,
      "end_seconds": 242.21,
      "duration_seconds": 1.61,
      "text": "Yes, that's fine."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 243.51,
      "end_seconds": 247.04,
      "duration_seconds": 3.53,
      "text": "Okay, I'll listen to your chest now."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 260.42,
      "end_seconds": 266.53,
      "duration_seconds": 6.11,
      "text": "There is tenderness over both cheeks and the nose is blocked with swollen lining."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 271.95,
      "end_seconds": 285.22,
      "duration_seconds": 13.27,
      "text": "Okay, please sit back down. Right, here's what I'm thinking. The most likely explanation is acute sinusitis. I want to be honest that this is an impression, not a final answer."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 286.94,
      "end_seconds": 290.69,
      "duration_seconds": 3.75,
      "text": "Actually, um, is this serious, doctor?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 292.46,
      "end_seconds": 298.71,
      "duration_seconds": 6.25,
      "text": "Nothing I've seen today points to an emergency. It looks like acute sinusitis."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 313.78,
      "end_seconds": 348.1,
      "duration_seconds": 34.32,
      "text": "I'm prescribing fluticasone nasal spray, 50 micrograms, two sprays each side once a day, for two weeks. It's for sinus congestion. Steam inhalation and saline rinses can help clear the nose. Don't skip meals, and try to eat smaller portions more often through the day. One warning sign to remember: the eye swells or you get a severe headache. In that case don't wait. Let's review you if it isn't improving in ten days."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 348.71,
      "end_seconds": 351.05,
      "duration_seconds": 2.34,
      "text": "Good, I'll return then."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 352.71,
      "end_seconds": 355.88,
      "duration_seconds": 3.17,
      "text": "I think we're done unless you have questions."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 357.46,
      "end_seconds": 359.51,
      "duration_seconds": 2.05,
      "text": "Thank you, doctor, goodbye."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 360.57,
      "end_seconds": 362.02,
      "duration_seconds": 1.45,
      "text": "Goodbye for now."
    }
  ]
}