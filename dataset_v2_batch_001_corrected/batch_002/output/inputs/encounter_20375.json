{
  "schema_version": "1.0",
  "encounter_id": "20375",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.12,
      "end_seconds": 4.93,
      "duration_seconds": 3.81,
      "text": "Hello? Doctor? I was told to come in."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.61,
      "end_seconds": 10.46,
      "duration_seconds": 4.85,
      "text": "Yes, come in and sit down. What brings you here today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 12.43,
      "end_seconds": 19.34,
      "duration_seconds": 6.91,
      "text": "Mainly being very thirsty. There's a couple of other things, but that's the main one."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 20.86,
      "end_seconds": 27.37,
      "duration_seconds": 6.51,
      "text": "Right, since when exactly? I ask because it helps me narrow things down."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 28.86,
      "end_seconds": 37.22,
      "duration_seconds": 8.36,
      "text": "It's been two years, I'm fairly sure. I did try to ignore it for a while."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 39.0,
      "end_seconds": 41.38,
      "duration_seconds": 2.38,
      "text": "Does anything else come with it?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 42.25,
      "end_seconds": 54.3,
      "duration_seconds": 12.05,
      "text": "When it starts I tend to get blurry vision as well. About blurry vision, I'd give it a seven, out of ten."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 70.99,
      "end_seconds": 74.29,
      "duration_seconds": 3.3,
      "text": "Any chest pain, abdominal pain or confusion?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 75.09,
      "end_seconds": 77.43,
      "duration_seconds": 2.34,
      "text": "Nope, nothing like that."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 80.56,
      "end_seconds": 84.14,
      "duration_seconds": 3.58,
      "text": "Anything on the skin I should know about?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 85.26,
      "end_seconds": 87.53,
      "duration_seconds": 2.27,
      "text": "No, skin's been fine."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 89.18,
      "end_seconds": 91.22,
      "duration_seconds": 2.04,
      "text": "Any regular medication at all?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 95.76,
      "end_seconds": 98.33,
      "duration_seconds": 2.57,
      "text": "No, nothing at the moment."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 99.67,
      "end_seconds": 104.1,
      "duration_seconds": 4.43,
      "text": "Do you have any medical conditions I should know about?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 105.66,
      "end_seconds": 108.57,
      "duration_seconds": 2.91,
      "text": "Um, no, nothing at all."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 109.32,
      "end_seconds": 112.42,
      "duration_seconds": 3.1,
      "text": "Any past operations I should know about?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 113.76,
      "end_seconds": 117.75,
      "duration_seconds": 3.99,
      "text": "I had a bunion operation six years ago."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 135.32,
      "end_seconds": 139.58,
      "duration_seconds": 4.26,
      "text": "Are there any allergies I should be aware of?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 144.45,
      "end_seconds": 147.35,
      "duration_seconds": 2.9,
      "text": "Yes, cat fur. I get sneezing."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 148.99,
      "end_seconds": 152.05,
      "duration_seconds": 3.06,
      "text": "Are you in work at the moment?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 153.28,
      "end_seconds": 157.23,
      "duration_seconds": 3.95,
      "text": "Yes, I work in a bakery, early starts."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 159.23,
      "end_seconds": 160.88,
      "duration_seconds": 1.65,
      "text": "How are your meals?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 162.34,
      "end_seconds": 166.03,
      "duration_seconds": 3.69,
      "text": "I grab fast food at lunch most days."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 167.37,
      "end_seconds": 170.32,
      "duration_seconds": 2.95,
      "text": "Are there any illnesses in your family?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 171.39,
      "end_seconds": 174.43,
      "duration_seconds": 3.04,
      "text": "I mean, my son has asthma."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 190.35,
      "end_seconds": 193.27,
      "duration_seconds": 2.92,
      "text": "I'll just record a few vital signs."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 199.86,
      "end_seconds": 202.69,
      "duration_seconds": 2.83,
      "text": "That's it, just a little longer..."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 221.38,
      "end_seconds": 231.8,
      "duration_seconds": 10.42,
      "text": "Okay: heart rate 82, saturation 99 percent, blood pressure 159 over 90. And height 150 centimetres, temperature 36.9, weight 96 kilos, respiratory rate 15."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 233.43,
      "end_seconds": 234.82,
      "duration_seconds": 1.39,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 235.96,
      "end_seconds": 238.83,
      "duration_seconds": 2.87,
      "text": "We'll look at it together shortly."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 240.51,
      "end_seconds": 244.83,
      "duration_seconds": 4.32,
      "text": "I'd like to check you over now, if that's alright."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 246.73,
      "end_seconds": 248.67,
      "duration_seconds": 1.94,
      "text": "Hold that for a second."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 257.76,
      "end_seconds": 264.6,
      "duration_seconds": 6.84,
      "text": "Your fingerprick sugar here is high, and your feet have good pulses and normal feeling."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 267.71,
      "end_seconds": 270.84,
      "duration_seconds": 3.13,
      "text": "Alright, thank you, you can get dressed."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 281.92,
      "end_seconds": 295.54,
      "duration_seconds": 13.62,
      "text": "Putting it all together, this is probably symptoms that point to newly developed type 2 diabetes. I want to be honest that this is an impression, not a final answer."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 296.04,
      "end_seconds": 297.86,
      "duration_seconds": 1.82,
      "text": "Will it clear up?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 299.71,
      "end_seconds": 325.39,
      "duration_seconds": 25.68,
      "text": "I understand the worry. At the moment I'd say it's symptoms that point to newly developed type 2 diabetes, and we'll watch how it goes. You'll be taking metformin, 500 milligrams, once a day with food, long term. That should help with high blood sugar. Have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 326.81,
      "end_seconds": 328.94,
      "duration_seconds": 2.13,
      "text": "Alright, thanks, take care."
    }
  ]
}