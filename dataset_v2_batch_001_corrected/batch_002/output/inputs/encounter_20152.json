{
  "schema_version": "1.0",
  "encounter_id": "20152",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.67,
      "end_seconds": 5.87,
      "duration_seconds": 5.2,
      "text": "hello take a seat I'll be with you in a second"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 7.54,
      "end_seconds": 10.65,
      "duration_seconds": 3.11,
      "text": "morning, doctor, sorry about the rush"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 11.33,
      "end_seconds": 17.15,
      "duration_seconds": 5.82,
      "text": "erm hello doctor. I hope it's alright if I stay in for this"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 17.96,
      "end_seconds": 20.1,
      "duration_seconds": 2.14,
      "text": "what's the main thing today?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 21.88,
      "end_seconds": 29.68,
      "duration_seconds": 7.8,
      "text": "Yeah, uh, it's a dry tickly cough, doctor. He didn't want to come, but I insisted."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 31.0,
      "end_seconds": 34.86,
      "duration_seconds": 3.86,
      "text": "How many days or weeks has it been?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 39.1,
      "end_seconds": 41.85,
      "duration_seconds": 2.75,
      "text": "It's been two months now."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 43.29,
      "end_seconds": 46.71,
      "duration_seconds": 3.42,
      "text": "is it bearing on you a lot?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 47.86,
      "end_seconds": 50.17,
      "duration_seconds": 2.31,
      "text": "I, I'd say severe"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 52.0,
      "end_seconds": 55.53,
      "duration_seconds": 3.53,
      "text": "What do you do to make it better?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 56.22,
      "end_seconds": 59.83,
      "duration_seconds": 3.61,
      "text": "oh, sips of water helps a bit"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 61.8,
      "end_seconds": 65.22,
      "duration_seconds": 3.42,
      "text": "Is it it constant or in episodes?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 66.43,
      "end_seconds": 69.64,
      "duration_seconds": 3.21,
      "text": "it it happens all the time"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 70.3,
      "end_seconds": 75.84,
      "duration_seconds": 5.54,
      "text": "I was just going to say that the main thing is—"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_4",
      "role": "NURSE",
      "start_seconds": 75.94,
      "end_seconds": 83.21,
      "duration_seconds": 7.27,
      "text": "Sorry to cut in, doctor, quick question: shall I bring the trolley in now or later?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 88.45,
      "end_seconds": 93.72,
      "duration_seconds": 5.27,
      "text": "later thanks please go on have you had a little breathlessness?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 95.53,
      "end_seconds": 99.46,
      "duration_seconds": 3.93,
      "text": "Actually, yes, about the same, nearly five years."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 100.95,
      "end_seconds": 103.74,
      "duration_seconds": 2.79,
      "text": "How much does it limit you?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 104.36,
      "end_seconds": 105.78,
      "duration_seconds": 1.42,
      "text": "it's severe honestly"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 106.83,
      "end_seconds": 112.03,
      "duration_seconds": 5.2,
      "text": "any a tickle at the back of your throat as well?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 113.98,
      "end_seconds": 116.89,
      "duration_seconds": 2.91,
      "text": "yes, for about a year"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 118.8,
      "end_seconds": 124.55,
      "duration_seconds": 5.75,
      "text": "have you had a dry tickly cough before or is this the first time?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 126.56,
      "end_seconds": 136.11,
      "duration_seconds": 9.55,
      "text": "yes, something like this happened a couple of years ago, and it went away on its own"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_5",
      "role": "UNKNOWN",
      "start_seconds": 136.66,
      "end_seconds": 140.76,
      "duration_seconds": 4.1,
      "text": "yes, that's right, that's how it was"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 141.88,
      "end_seconds": 145.04,
      "duration_seconds": 3.16,
      "text": "and and what about weight loss or heartburn?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 146.25,
      "end_seconds": 149.98,
      "duration_seconds": 3.73,
      "text": "I haven't had weight loss or heartburn no"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 150.78,
      "end_seconds": 153.2,
      "duration_seconds": 2.42,
      "text": "did you notice any wheeze?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 154.59,
      "end_seconds": 158.56,
      "duration_seconds": 3.97,
      "text": "No, um, I haven't had any wheeze."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 160.2,
      "end_seconds": 164.5,
      "duration_seconds": 4.3,
      "text": "and what about coughing up blood fever or chest pain?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 165.03,
      "end_seconds": 170.98,
      "duration_seconds": 5.95,
      "text": "sorry, you know, what was I saying, nope, nothing like that"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 175.07,
      "end_seconds": 179.68,
      "duration_seconds": 4.61,
      "text": "Any pins and and needles or loss of strength anywhere?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 181.72,
      "end_seconds": 183.9,
      "duration_seconds": 2.18,
      "text": "No that's all normal."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 184.62,
      "end_seconds": 187.11,
      "duration_seconds": 2.49,
      "text": "any rashes or skin problems otherwise?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 187.72,
      "end_seconds": 188.63,
      "duration_seconds": 0.91,
      "text": "Skin's normal."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 190.45,
      "end_seconds": 193.27,
      "duration_seconds": 2.82,
      "text": "has anyone ever diagnosed you with something?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 194.01,
      "end_seconds": 215.9,
      "duration_seconds": 21.89,
      "text": "I've had acid reflux for five years now. High blood pressure, for two years i have thin bones it's a relief to finally sit down and talk about it i mean, I've had high cholesterol for about ten years now"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 217.81,
      "end_seconds": 229.99,
      "duration_seconds": 12.18,
      "text": "Right, so high blood pressure and thin bones are already on your record. We'll keep that in mind today. Have you had any surgical procedures?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 231.8,
      "end_seconds": 237.78,
      "duration_seconds": 5.98,
      "text": "I had a meniscus repair on my knee four years ago"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 238.75,
      "end_seconds": 242.19,
      "duration_seconds": 3.44,
      "text": "which medicines do you take at the moment?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 243.7,
      "end_seconds": 250.03,
      "duration_seconds": 6.33,
      "text": "Uh, um, I take pantoprazole, before breakfast for my acidity."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 250.54,
      "end_seconds": 252.77,
      "duration_seconds": 2.23,
      "text": "and what strength is that?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 253.67,
      "end_seconds": 262.61,
      "duration_seconds": 8.94,
      "text": "40 milligrams I think that's what's on the box. Ramipril i take it 5 milligrams every morning"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_4",
      "role": "NURSE",
      "start_seconds": 268.26,
      "end_seconds": 273.14,
      "duration_seconds": 4.88,
      "text": "Doctor, our chart from the last visit lists it as 10 milligrams."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 274.26,
      "end_seconds": 278.94,
      "duration_seconds": 4.68,
      "text": "Right. Do you happen to have the current prescription here?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 279.61,
      "end_seconds": 284.59,
      "duration_seconds": 4.98,
      "text": "no I left it at home. Alendronate once a week"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 286.12,
      "end_seconds": 288.21,
      "duration_seconds": 2.09,
      "text": "And what strength is that?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 290.16,
      "end_seconds": 294.37,
      "duration_seconds": 4.21,
      "text": "70 milligrams. Simvastatin, 20 milligrams, at night"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 296.27,
      "end_seconds": 301.67,
      "duration_seconds": 5.4,
      "text": "do you react to to any medicines or foods? Any allergies?"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 303.11,
      "end_seconds": 304.96,
      "duration_seconds": 1.85,
      "text": "no allergies at all"
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 306.03,
      "end_seconds": 309.32,
      "duration_seconds": 3.29,
      "text": "a few questions about your lifestyle now"
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 313.8,
      "end_seconds": 326.94,
      "duration_seconds": 13.14,
      "text": "I have about eight cigarettes in a day. I only drink at family occasions. I swim twice a week. I work in accounts at a hospital"
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_4",
      "role": "NURSE",
      "start_seconds": 327.71,
      "end_seconds": 337.58,
      "duration_seconds": 9.87,
      "text": "Okay, so the vitals from earlier. Pressure 127 over 79, respiratory rate 15. Heart rate 78, temperature 36.6, saturation 97 percent."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 338.43,
      "end_seconds": 339.29,
      "duration_seconds": 0.86,
      "text": "okay noted"
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 342.14,
      "end_seconds": 346.41,
      "duration_seconds": 4.27,
      "text": "I'll examine you in a second make yourself comfortable"
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 348.08,
      "end_seconds": 349.54,
      "duration_seconds": 1.46,
      "text": "nearly finished here"
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 366.08,
      "end_seconds": 370.03,
      "duration_seconds": 3.95,
      "text": "your chest is clear and there is no wheeze"
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 374.2,
      "end_seconds": 376.58,
      "duration_seconds": 2.38,
      "text": "Okay, that's enough for me."
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 384.19,
      "end_seconds": 388.62,
      "duration_seconds": 4.43,
      "text": "I'll request a chest X-ray it'll help with chronic cough"
    },
    {
      "segment_id": "SEG0059",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 390.69,
      "end_seconds": 394.07,
      "duration_seconds": 3.38,
      "text": "where would I go for that?"
    },
    {
      "segment_id": "SEG0060",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 395.77,
      "end_seconds": 406.05,
      "duration_seconds": 10.28,
      "text": "I want a breathing test done, that's for cough. That will help us see what's going on underneath and decide the next step."
    },
    {
      "segment_id": "SEG0061",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 407.41,
      "end_seconds": 410.42,
      "duration_seconds": 3.01,
      "text": "where would I go for that?"
    },
    {
      "segment_id": "SEG0062",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 411.45,
      "end_seconds": 425.84,
      "duration_seconds": 14.39,
      "text": "we will review your tablets and see whether the cough settles over a month and please bring the latest prescription or the medicine boxes to the next visit so we can settle the dose"
    },
    {
      "segment_id": "SEG0063",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 430.59,
      "end_seconds": 432.79,
      "duration_seconds": 2.2,
      "text": "I I'll remember that"
    },
    {
      "segment_id": "SEG0064",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 434.29,
      "end_seconds": 439.16,
      "duration_seconds": 4.87,
      "text": "come back in six weeks have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0065",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 440.04,
      "end_seconds": 443.05,
      "duration_seconds": 3.01,
      "text": "Good, thanks, I'll see you then."
    },
    {
      "segment_id": "SEG0066",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 443.9,
      "end_seconds": 445.33,
      "duration_seconds": 1.43,
      "text": "Goodbye for now."
    }
  ]
}