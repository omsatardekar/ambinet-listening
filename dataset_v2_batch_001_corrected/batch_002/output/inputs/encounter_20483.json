    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 117.96,
      "end_seconds": 122.52,
      "duration_seconds": 4.56,
      "text": "Not much, I mostly stay in these days."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 123.11,
      "end_seconds": 125.86,
      "duration_seconds": 2.75,
      "text": "What do you do during the day?"
