      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 74.22,
      "end_seconds": 77.61,
      "duration_seconds": 3.39,
      "text": "is there any regular medication you use?"
