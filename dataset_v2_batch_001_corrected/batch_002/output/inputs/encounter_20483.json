      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 127.57,
      "end_seconds": 131.11,
      "duration_seconds": 3.54,
      "text": "I look after my grandchildren most days"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 139.59,
      "end_seconds": 144.05,
      "duration_seconds": 4.46,
      "text": "What about your parents, brothers or sisters, any conditions?"
