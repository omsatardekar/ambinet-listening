      "start_seconds": 0.61,
      "end_seconds": 3.23,
      "duration_seconds": 2.62,
      "text": "Good afternoon, you know, doctor."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 4.49,
      "end_seconds": 9.18,
      "duration_seconds": 4.69,
      "text": "Yes come in and sit down. What brings you here today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 10.71,
      "end_seconds": 16.05,
      "duration_seconds": 5.34,
      "text": "um, so... a dry tickly cough. That's why I came"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 17.26,
      "end_seconds": 20.24,
      "duration_seconds": 2.98,
      "text": "has this been going on for long?"
