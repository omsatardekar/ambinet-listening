    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 107.07,
      "end_seconds": 110.42,
      "duration_seconds": 3.35,
      "text": "any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 111.23,
      "end_seconds": 113.05,
      "duration_seconds": 1.82,
      "text": "not really, no"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 114.1,
      "end_seconds": 116.39,
      "duration_seconds": 2.29,
      "text": "Do you get out much?"
