      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 81.85,
      "end_seconds": 83.48,
      "duration_seconds": 1.63,
      "text": "Nothing regular no."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 85.05,
      "end_seconds": 91.48,
      "duration_seconds": 6.43,
      "text": "Any allergies to tablets food or anything in the environment? Take your time there's no rush."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 92.95,
      "end_seconds": 97.08,
      "duration_seconds": 4.13,
      "text": "erm, uh, not to my knowledge, no"
