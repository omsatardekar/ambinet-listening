{
  "schema_version": "1.0",
  "encounter_id": "20174",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.19,
      "end_seconds": 6.85,
      "duration_seconds": 5.66,
      "text": "Hi, doctor, I came as soon as they called me."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.75,
      "end_seconds": 12.93,
      "duration_seconds": 4.18,
      "text": "come in please sit how can I help you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 13.54,
      "end_seconds": 26.91,
      "duration_seconds": 13.37,
      "text": "honestly, it's a bitten tongue, and my family pushed me to come i did try to ignore it for a while i've been putting this off for weeks"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 28.08,
      "end_seconds": 31.21,
      "duration_seconds": 3.13,
      "text": "Can you tell me when it first started?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 34.57,
      "end_seconds": 45.07,
      "duration_seconds": 10.5,
      "text": "Well, it's been going on for two days. A neighbour of mine said I should see someone about it."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 46.99,
      "end_seconds": 49.9,
      "duration_seconds": 2.91,
      "text": "How much trouble does it give you?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 51.43,
      "end_seconds": 55.04,
      "duration_seconds": 3.61,
      "text": "a five out of ten, I suppose"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 56.26,
      "end_seconds": 59.25,
      "duration_seconds": 2.99,
      "text": "right, is it accompanied by anything?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 59.8,
      "end_seconds": 79.79,
      "duration_seconds": 19.99,
      "text": "when it starts I tend to get a headache afterwards as well as for headache afterwards, severe, I'd say and I've been passing out for a couple of minutes as well as for passing out for a couple of minutes, I'd say moderate"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 80.84,
      "end_seconds": 86.92,
      "duration_seconds": 6.08,
      "text": "so, have you had a bitten tongue before, or is this the the first time?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 87.42,
      "end_seconds": 93.01,
      "duration_seconds": 5.59,
      "text": "a bit, about six months ago it settled by itself back then"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 94.19,
      "end_seconds": 98.79,
      "duration_seconds": 4.6,
      "text": "let me check a a few things any palpitations or vomiting?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 99.82,
      "end_seconds": 103.44,
      "duration_seconds": 3.62,
      "text": "I haven't had palpitations or vomiting, no."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 105.19,
      "end_seconds": 108.94,
      "duration_seconds": 3.75,
      "text": "Have you noticed chest pain, head injury or fever?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 109.97,
      "end_seconds": 115.64,
      "duration_seconds": 5.67,
      "text": "I haven't had chest pain, head injury or fever, no."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 116.72,
      "end_seconds": 119.62,
      "duration_seconds": 2.9,
      "text": "How are your joints, any aches elsewhere?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 120.29,
      "end_seconds": 122.56,
      "duration_seconds": 2.27,
      "text": "I move fine otherwise"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 123.49,
      "end_seconds": 128.16,
      "duration_seconds": 4.67,
      "text": "Has anything ever caused you a reaction? I mean any allergies."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 129.56,
      "end_seconds": 132.47,
      "duration_seconds": 2.91,
      "text": "Not to my knowledge, no."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 134.34,
      "end_seconds": 136.74,
      "duration_seconds": 2.4,
      "text": "Do you work outside the home?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 138.74,
      "end_seconds": 143.33,
      "duration_seconds": 4.59,
      "text": "I'm a hairdresser, on my feet all day."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 144.58,
      "end_seconds": 146.87,
      "duration_seconds": 2.29,
      "text": "Is there someone at home?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 148.52,
      "end_seconds": 152.78,
      "duration_seconds": 4.26,
      "text": "My husband and I live above the shop."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 154.78,
      "end_seconds": 159.16,
      "duration_seconds": 4.38,
      "text": "What about your parents, brothers or sisters, any conditions?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 161.12,
      "end_seconds": 164.29,
      "duration_seconds": 3.17,
      "text": "uh, my grandmother had dementia"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 165.77,
      "end_seconds": 167.99,
      "duration_seconds": 2.22,
      "text": "any surgery in the past?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 168.92,
      "end_seconds": 176.41,
      "duration_seconds": 7.49,
      "text": "Yes, I had a cataract operation in my left eye, about a year ago."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 192.33,
      "end_seconds": 196.64,
      "duration_seconds": 4.31,
      "text": "Tell me about any past illnesses or ongoing conditions."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 197.32,
      "end_seconds": 201.43,
      "duration_seconds": 4.11,
      "text": "I've had high blood pressure for five years now."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 202.28,
      "end_seconds": 208.51,
      "duration_seconds": 6.23,
      "text": "Right, right. Okay, I can see high blood pressure in your file as well."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 222.75,
      "end_seconds": 227.74,
      "duration_seconds": 4.99,
      "text": "Are you taking anything regularly, including from the the pharmacy?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 228.95,
      "end_seconds": 232.55,
      "duration_seconds": 3.6,
      "text": "it's ramipril, 5 milligrams, every morning"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 233.99,
      "end_seconds": 236.7,
      "duration_seconds": 2.71,
      "text": "Let's start with the basic checks."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 245.81,
      "end_seconds": 248.66,
      "duration_seconds": 2.85,
      "text": "That's it, just a little longer..."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 261.44,
      "end_seconds": 268.62,
      "duration_seconds": 7.18,
      "text": "Okay: pulse is 77 beats a minute, blood pressure 123 over 69, temperature 36.8."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 271.45,
      "end_seconds": 275.42,
      "duration_seconds": 3.97,
      "text": "okay, time for me to to examine you"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 276.94,
      "end_seconds": 279.3,
      "duration_seconds": 2.36,
      "text": "Tell me if that's sore."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 295.28,
      "end_seconds": 300.42,
      "duration_seconds": 5.14,
      "text": "The neurological examination is normal, with steady walking and equal power."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 306.21,
      "end_seconds": 315.82,
      "duration_seconds": 9.61,
      "text": "You can sit up now. From what you've told me and what I found, this looks most like a possible first seizure."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 316.65,
      "end_seconds": 318.04,
      "duration_seconds": 1.39,
      "text": "Is this permanent?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 319.8,
      "end_seconds": 328.05,
      "duration_seconds": 8.25,
      "text": "It's reasonable to be concerned, but right now a possible first seizure is my leading thought, not anything worse."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 341.83,
      "end_seconds": 346.62,
      "duration_seconds": 4.79,
      "text": "I'm sending you for an EEG because of possible seizure."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 348.41,
      "end_seconds": 352.85,
      "duration_seconds": 4.44,
      "text": "We have a slot Friday at 3:30 pm, if that works."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 353.49,
      "end_seconds": 356.2,
      "duration_seconds": 2.71,
      "text": "Friday, that works for me."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 356.8,
      "end_seconds": 389.64,
      "duration_seconds": 32.84,
      "text": "We should do an ECG for loss of consciousness. I'd rather check than guess, and this is the quickest way to know more. No driving until you have been seen in the clinic, and avoid swimming or climbing alone. If you have another episode or one lasts more than five minutes, or you feel really unwell, please come to the emergency department. I'd like you back after the scan."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 390.21,
      "end_seconds": 392.12,
      "duration_seconds": 1.91,
      "text": "I can manage that."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 395.72,
      "end_seconds": 398.22,
      "duration_seconds": 2.5,
      "text": "that's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 399.92,
      "end_seconds": 403.2,
      "duration_seconds": 3.28,
      "text": "No, that's all. Thanks a lot."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 405.28,
      "end_seconds": 406.47,
      "duration_seconds": 1.19,
      "text": "goodbye for now"
    }
  ]
}