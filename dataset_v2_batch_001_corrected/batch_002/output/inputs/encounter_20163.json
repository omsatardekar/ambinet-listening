{
  "schema_version": "1.0",
  "encounter_id": "20163",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.99,
      "end_seconds": 4.39,
      "duration_seconds": 3.4,
      "text": "Morning, doctor. Lovely to meet you."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 4.9,
      "end_seconds": 8.98,
      "duration_seconds": 4.08,
      "text": "No problem at all, come in. What's troubling you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 10.34,
      "end_seconds": 13.68,
      "duration_seconds": 3.34,
      "text": "It's blisters between my fingers, mostly."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 14.56,
      "end_seconds": 17.15,
      "duration_seconds": 2.59,
      "text": "Does anything else come with it?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 19.02,
      "end_seconds": 37.58,
      "duration_seconds": 18.56,
      "text": "Dry flaky skin goes along with it, most of the time. Well, you know, the Dry flaky skin? That's been for nearly five years. Let me think, about Dry flaky skin, it settles a little with moisturiser."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 42.39,
      "end_seconds": 47.47,
      "duration_seconds": 5.08,
      "text": "have you noticed joint pain, nail changes or new soap or cream?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 52.9,
      "end_seconds": 55.55,
      "duration_seconds": 2.65,
      "text": "no, nothing to report there"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 57.52,
      "end_seconds": 60.98,
      "duration_seconds": 3.46,
      "text": "Have you had any oozing or fever?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 62.41,
      "end_seconds": 65.64,
      "duration_seconds": 3.23,
      "text": "No, none of those at all."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 66.9,
      "end_seconds": 70.92,
      "duration_seconds": 4.02,
      "text": "Any pins and needles or loss of strength anywhere?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 71.66,
      "end_seconds": 74.38,
      "duration_seconds": 2.72,
      "text": "erm, no weakness or anything"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 76.06,
      "end_seconds": 78.86,
      "duration_seconds": 2.8,
      "text": "any muscle or joint problems besides this?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 79.82,
      "end_seconds": 81.28,
      "duration_seconds": 1.46,
      "text": "No, nothing there."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 83.26,
      "end_seconds": 84.53,
      "duration_seconds": 1.27,
      "text": "What about alcohol?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 89.21,
      "end_seconds": 93.22,
      "duration_seconds": 4.01,
      "text": "I'll have a glass of wine with dinner"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 94.11,
      "end_seconds": 95.53,
      "duration_seconds": 1.42,
      "text": "How about smoking?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 96.17,
      "end_seconds": 99.33,
      "duration_seconds": 3.16,
      "text": "I quit smoking around ten years ago."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 99.85,
      "end_seconds": 103.13,
      "duration_seconds": 3.28,
      "text": "Are you on your own at home?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 104.24,
      "end_seconds": 106.96,
      "duration_seconds": 2.72,
      "text": "I live with my elderly mother."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 107.53,
      "end_seconds": 109.57,
      "duration_seconds": 2.04,
      "text": "Tell me about your eating."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 110.25,
      "end_seconds": 116.33,
      "duration_seconds": 6.08,
      "text": "I drink a lot of tea and snack through the day"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 116.85,
      "end_seconds": 118.2,
      "duration_seconds": 1.35,
      "text": "Are you active?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 119.24,
      "end_seconds": 122.49,
      "duration_seconds": 3.25,
      "text": "I walk the dog every morning"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 123.78,
      "end_seconds": 128.04,
      "duration_seconds": 4.26,
      "text": "So, which medicines do you take at the moment?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 129.67,
      "end_seconds": 132.6,
      "duration_seconds": 2.93,
      "text": "it's moisturiser, several times a day"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 134.22,
      "end_seconds": 137.93,
      "duration_seconds": 3.71,
      "text": "Anything in your past medical history I should know?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 139.62,
      "end_seconds": 145.79,
      "duration_seconds": 6.17,
      "text": "Eczema, for about ten years. I've been putting this off for weeks."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 147.37,
      "end_seconds": 148.67,
      "duration_seconds": 1.3,
      "text": "okay, go on"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 149.95,
      "end_seconds": 164.38,
      "duration_seconds": 14.43,
      "text": "Hmm, I have COPD, for two years. My neighbour said I should get it looked at. My family kept telling me to get it checked."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 165.62,
      "end_seconds": 170.6,
      "duration_seconds": 4.98,
      "text": "Okay, I can see COPD in your file as well."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 181.18,
      "end_seconds": 184.43,
      "duration_seconds": 3.25,
      "text": "Okay, I'll just record a few vital signs."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 190.56,
      "end_seconds": 192.77,
      "duration_seconds": 2.21,
      "text": "Okay, this won't take long..."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 205.19,
      "end_seconds": 209.72,
      "duration_seconds": 4.53,
      "text": "Okay: BP is 119 over 79, heart rate 81."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 211.93,
      "end_seconds": 216.34,
      "duration_seconds": 4.41,
      "text": "Let me look at the area, I'll be gentle."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 217.8,
      "end_seconds": 218.5,
      "duration_seconds": 0.7,
      "text": "right"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 220.37,
      "end_seconds": 221.59,
      "duration_seconds": 1.22,
      "text": "Does that hurt?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 233.8,
      "end_seconds": 242.36,
      "duration_seconds": 8.56,
      "text": "The skin on both hands is red, dry and cracked in the finger creases, with no weeping."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 245.54,
      "end_seconds": 247.28,
      "duration_seconds": 1.74,
      "text": "Please sit back down."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 256.48,
      "end_seconds": 261.39,
      "duration_seconds": 4.91,
      "text": "Okay, thinking it through, it fits best with irritant hand dermatitis."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 262.63,
      "end_seconds": 264.73,
      "duration_seconds": 2.1,
      "text": "Is this serious, doctor?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 265.58,
      "end_seconds": 275.16,
      "duration_seconds": 9.58,
      "text": "I understand the worry. At the moment I'd say it's irritant hand dermatitis, and we'll know more once the a patch test is back"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 283.75,
      "end_seconds": 287.38,
      "duration_seconds": 3.63,
      "text": "I'd like to arrange a patch test for dermatitis."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 288.31,
      "end_seconds": 290.6,
      "duration_seconds": 2.29,
      "text": "How long will it take?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 291.79,
      "end_seconds": 299.39,
      "duration_seconds": 7.6,
      "text": "See me again if it hasn't settled in two weeks. That's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 300.98,
      "end_seconds": 304.65,
      "duration_seconds": 3.67,
      "text": "Okay, that makes sense. Thanks for explaining."
    }
  ]
}