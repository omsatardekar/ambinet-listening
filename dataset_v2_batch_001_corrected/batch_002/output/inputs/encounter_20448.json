    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 116.99,
      "end_seconds": 122.24,
      "duration_seconds": 5.25,
      "text": "Have you had any fainting, passing tissue or severe one-sided pain?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 123.31,
      "end_seconds": 128.12,
      "duration_seconds": 4.81,
      "text": "No, no fainting, passing tissue or severe one-sided pain."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 129.6,
      "end_seconds": 131.95,
      "duration_seconds": 2.35,
      "text": "Your breathing, any trouble there?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 137.5,
      "end_seconds": 138.41,
      "duration_seconds": 0.91,
      "text": "Breathing's normal."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 139.28,
      "end_seconds": 141.61,
      "duration_seconds": 2.33,
      "text": "Has your skin been okay?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 143.09,
      "end_seconds": 145.08,
      "duration_seconds": 1.99,
      "text": "no, skin's been fine"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 148.4,
      "end_seconds": 151.45,
      "duration_seconds": 3.05,
      "text": "I'll just record a few vital signs"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 164.89,
      "end_seconds": 167.08,
      "duration_seconds": 2.19,
      "text": "Nearly done with the readings..."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 187.52,
      "end_seconds": 197.66,
      "duration_seconds": 10.14,
      "text": "okay: temp 36.7 degrees, SpO2 98 percent on room air, respiratory rate 14, pulse 80, pressure 124 over 81."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 198.68,
      "end_seconds": 200.16,
      "duration_seconds": 1.48,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 201.47,
      "end_seconds": 205.15,
      "duration_seconds": 3.68,
      "text": "I'll explain what these mean in a moment."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 207.66,
      "end_seconds": 210.47,
      "duration_seconds": 2.81,
      "text": "Let's move on to to the examination."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 211.49,
      "end_seconds": 212.76,
      "duration_seconds": 1.27,
      "text": "Does that hurt?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 230.12,
      "end_seconds": 236.21,
      "duration_seconds": 6.09,
      "text": "Your tummy is soft with mild tenderness low down and your blood pressure is normal."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 241.65,
      "end_seconds": 244.51,
      "duration_seconds": 2.86,
      "text": "Good, you can sit up again."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 261.74,
      "end_seconds": 268.69,
      "duration_seconds": 6.95,
      "text": "Okay, thinking it through, my working impression is bleeding in early pregnancy that needs a scan."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 269.63,
      "end_seconds": 272.76,
      "duration_seconds": 3.13,
      "text": "is there something to worry about?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 274.49,
      "end_seconds": 283.23,
      "duration_seconds": 8.74,
      "text": "I can't promise yet, but most people with bleeding in early pregnancy that needs a scan do well once it's treated properly."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 302.18,
      "end_seconds": 308.08,
      "duration_seconds": 5.9,
      "text": "I'll request an early pregnancy scan, it'll help with bleeding in early pregnancy."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 308.81,
      "end_seconds": 311.34,
      "duration_seconds": 2.53,
      "text": "The earliest is Tuesday, 10 am."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 313.19,
      "end_seconds": 327.11,
      "duration_seconds": 13.92,
      "text": "A pregnancy hormone level is what I'd like next, for bleeding in early pregnancy. Use pads rather than tampons and avoid intercourse until the scan. We'll refer you to the early pregnancy unit."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 328.37,
      "end_seconds": 330.9,
      "duration_seconds": 2.53,
      "text": "Sure, where do I go?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 332.27,
      "end_seconds": 347.56,
      "duration_seconds": 15.29,
      "text": "Come back or go to emergency straight away if the bleeding becomes heavy or the pain becomes severe or one-sided. I'd like you back after the scan. Have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 349.54,
      "end_seconds": 352.47,
      "duration_seconds": 2.93,
      "text": "No, that's all. Thanks a lot."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 353.86,
      "end_seconds": 355.26,
      "duration_seconds": 1.4,
      "text": "All the best."
    }
