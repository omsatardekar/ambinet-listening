    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 26.31,
      "end_seconds": 40.63,
      "duration_seconds": 14.32,
      "text": "it's been like this since yesterday oh, and tender breasts that's been about the same, one week there's cramping in my lower tummy as well"
