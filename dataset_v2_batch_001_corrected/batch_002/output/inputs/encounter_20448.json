      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 58.6,
      "end_seconds": 61.7,
      "duration_seconds": 3.1,
      "text": "I'm on hydrocortisone cream, when needed"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 62.88,
      "end_seconds": 66.02,
      "duration_seconds": 3.14,
      "text": "So, have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 66.92,
      "end_seconds": 69.27,
      "duration_seconds": 2.35,
      "text": "No, not at all."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 72.44,
      "end_seconds": 75.52,
      "duration_seconds": 3.08,
      "text": "What do you do during the day?"
