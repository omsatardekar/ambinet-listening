      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 51.97,
      "end_seconds": 56.88,
      "duration_seconds": 4.91,
      "text": "I follow. What do you take on a normal day?"
