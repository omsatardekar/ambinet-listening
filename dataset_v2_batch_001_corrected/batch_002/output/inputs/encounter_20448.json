    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 87.86,
      "end_seconds": 91.1,
      "duration_seconds": 3.24,
      "text": "I do a yoga class on Thursdays."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 108.49,
      "end_seconds": 113.28,
      "duration_seconds": 4.79,
      "text": "Has anything ever caused you a reaction? I mean any allergies."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 114.45,
      "end_seconds": 116.01,
      "duration_seconds": 1.56,
      "text": "no known allergies"
