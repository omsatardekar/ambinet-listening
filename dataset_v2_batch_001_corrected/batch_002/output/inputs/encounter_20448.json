    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 78.66,
      "end_seconds": 82.43,
      "duration_seconds": 3.77,
      "text": "I look after my grandchildren most days."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 83.44,
      "end_seconds": 85.96,
      "duration_seconds": 2.52,
      "text": "Anything you do to stay fit?"
