      "role": "DOCTOR",
      "start_seconds": 6.86,
      "end_seconds": 11.2,
      "duration_seconds": 4.34,
      "text": "That's fine, sit down. Tell me why you came."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 11.81,
      "end_seconds": 16.89,
      "duration_seconds": 5.08,
      "text": "It's some bleeding. I thought I'd wait, but it hasn't gone."
