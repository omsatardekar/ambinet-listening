    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 18.95,
      "end_seconds": 20.82,
      "duration_seconds": 1.87,
      "text": "When did this begin?"
