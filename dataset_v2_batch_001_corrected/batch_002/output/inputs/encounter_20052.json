  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.65,
      "end_seconds": 4.1,
      "duration_seconds": 3.45,
      "text": "Good evening, doctor, thanks for seeing me."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 4.63,
      "end_seconds": 8.22,
      "duration_seconds": 3.59,
      "text": "come in. Please sit. How can I help you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 9.18,
      "end_seconds": 16.88,
      "duration_seconds": 7.7,
      "text": "It's a mole that has changed. I thought I'd wait, but it hasn't gone."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 18.01,
      "end_seconds": 21.2,
      "duration_seconds": 3.19,
      "text": "How long has this been bothering you?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 22.74,
      "end_seconds": 43.19,
      "duration_seconds": 20.45,
      "text": "It's been about three months, I'm fairly sure. Oh, and a crusty edge on the mole. That's been about the same, about a month. And there's a dark patch with an uneven edge as well, two years now."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 44.76,
      "end_seconds": 51.76,
      "duration_seconds": 7.0,
      "text": "Let me check a few things. Any lumps in the armpit, other new moles or weight loss?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 53.0,
      "end_seconds": 59.58,
      "duration_seconds": 6.58,
      "text": "I haven't had lumps in the armpit, other new moles or weight loss, no."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 60.62,
      "end_seconds": 63.06,
      "duration_seconds": 2.44,
      "text": "And pain, any of that?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 68.31,
      "end_seconds": 71.15,
      "duration_seconds": 2.84,
      "text": "No, I haven't had any pain."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 72.83,
      "end_seconds": 77.22,
      "duration_seconds": 4.39,
      "text": "so, any pins and and needles or loss of strength anywhere?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 78.5,
      "end_seconds": 80.62,
      "duration_seconds": 2.12,
      "text": "No, that's all normal."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 81.7,
      "end_seconds": 85.57,
      "duration_seconds": 3.87,
      "text": "What about your tummy and bowels, anything unusual there?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 86.37,
      "end_seconds": 88.94,
      "duration_seconds": 2.57,
      "text": "Bowels are regular, nothing odd."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 90.86,
      "end_seconds": 93.06,
      "duration_seconds": 2.2,
      "text": "Do you live by yourself?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 93.68,
      "end_seconds": 97.94,
      "duration_seconds": 4.26,
      "text": "No, I share a house with my brother."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 99.04,
      "end_seconds": 100.41,
      "duration_seconds": 1.37,
      "text": "Are you active?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 102.15,
      "end_seconds": 105.47,
      "duration_seconds": 3.32,
      "text": "I walk the dog every morning."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 107.41,
      "end_seconds": 109.19,
      "duration_seconds": 1.78,
      "text": "how are your meals?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 112.63,
      "end_seconds": 116.78,
      "duration_seconds": 4.15,
      "text": "I grab fast food at lunch most days"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 118.02,
      "end_seconds": 123.3,
      "duration_seconds": 5.28,
      "text": "Any allergies to to tablets, food or anything in the environment?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 124.12,
      "end_seconds": 128.6,
      "duration_seconds": 4.48,
      "text": "I'm allergic to kiwi, I get an itchy mouth"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 138.13,
      "end_seconds": 140.82,
      "duration_seconds": 2.69,
      "text": "are you on any regular medication?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 141.81,
      "end_seconds": 145.47,
      "duration_seconds": 3.66,
      "text": "No, you know, nothing at the moment."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 146.64,
      "end_seconds": 151.47,
      "duration_seconds": 4.83,
      "text": "Do you have any medical conditions I should know about?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 152.58,
      "end_seconds": 155.85,
      "duration_seconds": 3.27,
      "text": "No, nothing I can think of."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 165.37,
      "end_seconds": 167.39,
      "duration_seconds": 2.02,
      "text": "any surgery in the past?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 168.53,
      "end_seconds": 173.95,
      "duration_seconds": 5.42,
      "text": "Yeah, yes, I had my septum straightened, in my thirties."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 175.44,
      "end_seconds": 178.55,
      "duration_seconds": 3.11,
      "text": "Shall I check your blood pressure and pulse?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 186.42,
      "end_seconds": 188.56,
      "duration_seconds": 2.14,
      "text": "Okay, this won't take long..."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 204.99,
      "end_seconds": 213.53,
      "duration_seconds": 8.54,
      "text": "Okay: respiratory rate 16, temperature is 37.0 degrees, oxygen saturation is 97 percent. And pressure 127 over 78, pulse 67."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 215.08,
      "end_seconds": 217.39,
      "duration_seconds": 2.31,
      "text": "Shall I start the examination?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 218.53,
      "end_seconds": 220.77,
      "duration_seconds": 2.24,
      "text": "Raise your arm for me."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 235.54,
      "end_seconds": 239.96,
      "duration_seconds": 4.42,
      "text": "I can't feel any glands in the armpit or neck."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 241.59,
      "end_seconds": 243.14,
      "duration_seconds": 1.55,
      "text": "Yeah, no problem."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 244.71,
      "end_seconds": 246.86,
      "duration_seconds": 2.15,
      "text": "Raise your arm for me."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 257.26,
      "end_seconds": 266.18,
      "duration_seconds": 8.92,
      "text": "there is a dark, six-millimetre mole with an irregular border and two shades of brown on the upper back"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 269.32,
      "end_seconds": 270.89,
      "duration_seconds": 1.57,
      "text": "That's the examination finished."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 286.62,
      "end_seconds": 304.77,
      "duration_seconds": 18.15,
      "text": "Putting it all together, it's hard to say. A pigmented lesion that needs removal for a proper diagnosis is one possibility and a seborrhoeic keratosis another, and I'd rather not commit yet. I want a skin biopsy done, that's for changing mole."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 306.31,
      "end_seconds": 310.78,
      "duration_seconds": 4.47,
      "text": "We have a slot Tuesday at 2 pm, if that works."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 311.6,
      "end_seconds": 325.34,
      "duration_seconds": 13.74,
      "text": "Let's book a dermoscopy to look into changing mole. Cover up and use factor 50 sunscreen on exposed skin. Let's get you seen by the skin cancer clinic, I'll arrange the letter."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 330.93,
      "end_seconds": 333.4,
      "duration_seconds": 2.47,
      "text": "Sure, where do I go?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 334.99,
      "end_seconds": 337.58,
      "duration_seconds": 2.59,
      "text": "that's all from me any questions?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 338.34,
      "end_seconds": 341.62,
      "duration_seconds": 3.28,
      "text": "I think I understand everything thanks"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 342.49,
      "end_seconds": 343.96,
      "duration_seconds": 1.47,
      "text": "look after yourself"
    }
  ]
