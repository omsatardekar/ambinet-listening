{
  "schema_version": "1.0",
  "encounter_id": "20406",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.34,
      "end_seconds": 7.11,
      "duration_seconds": 5.77,
      "text": "Doctor, hi, where would you like me to put my coat?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.72,
      "end_seconds": 12.34,
      "duration_seconds": 3.62,
      "text": "Yes, have a seat. Tell me what's going on."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 14.27,
      "end_seconds": 32.45,
      "duration_seconds": 18.18,
      "text": "I've been losing weight without trying, and I wanted to get it checked. It's the not knowing that gets to me. I'd rather not end up on lots of tablets if I can avoid it"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 33.65,
      "end_seconds": 35.71,
      "duration_seconds": 2.06,
      "text": "Is it accompanied by anything?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 37.31,
      "end_seconds": 42.56,
      "duration_seconds": 5.25,
      "text": "A dry cough goes along with it, most of the time."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 44.2,
      "end_seconds": 47.35,
      "duration_seconds": 3.15,
      "text": "Has there been no real appetite too?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 48.04,
      "end_seconds": 49.08,
      "duration_seconds": 1.04,
      "text": "yes, actually"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 61.84,
      "end_seconds": 65.93,
      "duration_seconds": 4.09,
      "text": "any itching, blood in the stool or vomiting at all?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 67.62,
      "end_seconds": 70.3,
      "duration_seconds": 2.68,
      "text": "no, I'd have said so"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 73.01,
      "end_seconds": 76.74,
      "duration_seconds": 3.73,
      "text": "and what about difficulty swallowing or bone pain?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 77.6,
      "end_seconds": 81.33,
      "duration_seconds": 3.73,
      "text": "No, I haven't had any of them."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 82.38,
      "end_seconds": 85.68,
      "duration_seconds": 3.3,
      "text": "on the cardiac side, anything I should know?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 89.39,
      "end_seconds": 91.05,
      "duration_seconds": 1.66,
      "text": "Nothing like that."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 92.23,
      "end_seconds": 93.75,
      "duration_seconds": 1.52,
      "text": "Neurologically, anything strange?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 95.62,
      "end_seconds": 98.68,
      "duration_seconds": 3.06,
      "text": "No, you know, nothing like that."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 108.37,
      "end_seconds": 111.13,
      "duration_seconds": 2.76,
      "text": "have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 113.19,
      "end_seconds": 114.65,
      "duration_seconds": 1.46,
      "text": "no surgery, no"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 115.17,
      "end_seconds": 117.73,
      "duration_seconds": 2.56,
      "text": "do you have any long-term conditions?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 119.26,
      "end_seconds": 124.01,
      "duration_seconds": 4.75,
      "text": "I've had high blood pressure for about ten years now."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 125.27,
      "end_seconds": 129.89,
      "duration_seconds": 4.62,
      "text": "Okay, any allergies to tablets, food or anything in the environment?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 130.43,
      "end_seconds": 135.19,
      "duration_seconds": 4.76,
      "text": "Walnuts. I come out in... well, my lips swelling"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 136.08,
      "end_seconds": 139.55,
      "duration_seconds": 3.47,
      "text": "A A few questions about your lifestyle now."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 141.4,
      "end_seconds": 151.81,
      "duration_seconds": 10.41,
      "text": "No, I share a house with my brother. I work in accounts at a hospital. I grab fast food at lunch most days."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 152.6,
      "end_seconds": 155.5,
      "duration_seconds": 2.9,
      "text": "What's on your current medicine list?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 156.17,
      "end_seconds": 162.46,
      "duration_seconds": 6.29,
      "text": "it's something called telm... telmisartan, 40 milligrams, maybe, once a day"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 163.48,
      "end_seconds": 166.75,
      "duration_seconds": 3.27,
      "text": "Is the packet here, or the prescription?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 168.78,
      "end_seconds": 172.95,
      "duration_seconds": 4.17,
      "text": "Not with me. I'll bring it next time."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 173.58,
      "end_seconds": 175.57,
      "duration_seconds": 1.99,
      "text": "I'll do your observations first."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 183.23,
      "end_seconds": 185.38,
      "duration_seconds": 2.15,
      "text": "Okay, this won't take long..."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 206.99,
      "end_seconds": 209.85,
      "duration_seconds": 2.86,
      "text": "Okay: pulse 85, pressure 123 over 80."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 211.92,
      "end_seconds": 213.56,
      "duration_seconds": 1.64,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 214.8,
      "end_seconds": 218.53,
      "duration_seconds": 3.73,
      "text": "Don't worry, we'll discuss it in a second."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 219.77,
      "end_seconds": 222.13,
      "duration_seconds": 2.36,
      "text": "Let's move on to the examination."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 222.7,
      "end_seconds": 224.42,
      "duration_seconds": 1.72,
      "text": "Yeah, no problem."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 226.04,
      "end_seconds": 228.12,
      "duration_seconds": 2.08,
      "text": "Raise your arm for me."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 242.25,
      "end_seconds": 246.5,
      "duration_seconds": 4.25,
      "text": "Your tummy is soft and I can't feel any lumps."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 252.31,
      "end_seconds": 264.79,
      "duration_seconds": 12.48,
      "text": "Thank you, you can get dressed. From what you've told me and what I found, it it fits best with an unexplained weight loss that needs a proper work-up."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 283.77,
      "end_seconds": 309.58,
      "duration_seconds": 25.81,
      "text": "Let's book a thyroid test to look into weight loss. Weigh yourself once a week at the same time and note it down. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose. Let's hold off on blood tests for now, and if there's no change in a month we can revisit it."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 311.54,
      "end_seconds": 327.0,
      "duration_seconds": 15.46,
      "text": "If the symptoms get worse, or you feel really unwell, please come to the emergency department. Please come and see me after the results are back. Does all of that make sense?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 328.93,
      "end_seconds": 332.48,
      "duration_seconds": 3.55,
      "text": "Right, I'll do that. Thank you, doctor."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 333.08,
      "end_seconds": 334.36,
      "duration_seconds": 1.28,
      "text": "goodbye for now"
    }
  ]
}