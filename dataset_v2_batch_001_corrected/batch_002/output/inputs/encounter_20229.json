{
  "schema_version": "1.0",
  "encounter_id": "20229",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.73,
      "end_seconds": 7.52,
      "duration_seconds": 6.79,
      "text": "Hello doctor, sorry, I took a wrong turn on the way here."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.32,
      "end_seconds": 11.99,
      "duration_seconds": 3.67,
      "text": "Yes, have a seat. Tell me what's going on."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 13.54,
      "end_seconds": 24.35,
      "duration_seconds": 10.81,
      "text": "Morning, uh, doctor. I'll stay and fill in anything that's missed. It's heavy periods, doctor. She didn't want to come, but I insisted."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 25.44,
      "end_seconds": 29.62,
      "duration_seconds": 4.18,
      "text": "Right, can you tell me when it first started?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 31.28,
      "end_seconds": 34.15,
      "duration_seconds": 2.87,
      "text": "For about a month, I'd say."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 35.59,
      "end_seconds": 37.75,
      "duration_seconds": 2.16,
      "text": "Have you been passing clots?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 41.46,
      "end_seconds": 53.48,
      "duration_seconds": 12.02,
      "text": "Yes, for two years. I've been feeling exhausted too, for nearly five years. About feeling exhausted, only resting, and it's not much."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 54.1,
      "end_seconds": 56.47,
      "duration_seconds": 2.37,
      "text": "Do you have any long-term conditions?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 57.82,
      "end_seconds": 63.67,
      "duration_seconds": 5.85,
      "text": "Sorry, um, what was I saying, I've had heart disease, yes."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 64.84,
      "end_seconds": 71.94,
      "duration_seconds": 7.1,
      "text": "Mm-hmm. Right, so heart disease is already on your record. We'll keep that in mind today."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 88.87,
      "end_seconds": 91.28,
      "duration_seconds": 2.41,
      "text": "Alright, do you drink alcohol?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 93.21,
      "end_seconds": 94.83,
      "duration_seconds": 1.62,
      "text": "Nothing, I'm teetotal."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 96.27,
      "end_seconds": 97.91,
      "duration_seconds": 1.64,
      "text": "Who lives with you?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 99.6,
      "end_seconds": 102.14,
      "duration_seconds": 2.54,
      "text": "My partner and our baby."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 102.8,
      "end_seconds": 105.49,
      "duration_seconds": 2.69,
      "text": "Do you work outside the home?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 107.15,
      "end_seconds": 111.65,
      "duration_seconds": 4.5,
      "text": "I'm a hairdresser, on my feet all day."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 113.43,
      "end_seconds": 115.88,
      "duration_seconds": 2.45,
      "text": "Tell me about your eating."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 117.54,
      "end_seconds": 122.77,
      "duration_seconds": 5.23,
      "text": "I drink a lot of tea and snack through the day."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 134.27,
      "end_seconds": 138.5,
      "duration_seconds": 4.23,
      "text": "Any allergies to tablets, food or anything in the environment?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 139.48,
      "end_seconds": 140.98,
      "duration_seconds": 1.5,
      "text": "Yes, cat fur."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 142.11,
      "end_seconds": 144.45,
      "duration_seconds": 2.34,
      "text": "Are you on any regular medication?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 145.38,
      "end_seconds": 147.79,
      "duration_seconds": 2.41,
      "text": "No, nothing at the moment."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 148.96,
      "end_seconds": 153.54,
      "duration_seconds": 4.58,
      "text": "Let me check a few things. Any pelvic pain or fainting?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 154.78,
      "end_seconds": 159.16,
      "duration_seconds": 4.38,
      "text": "Hmm, you know, no, nothing to report there."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 159.91,
      "end_seconds": 163.52,
      "duration_seconds": 3.61,
      "text": "Anything on the skin I should know about?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 164.17,
      "end_seconds": 165.15,
      "duration_seconds": 0.98,
      "text": "No rashes."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 166.76,
      "end_seconds": 170.19,
      "duration_seconds": 3.43,
      "text": "Shall I check your blood pressure and pulse?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 180.17,
      "end_seconds": 182.66,
      "duration_seconds": 2.49,
      "text": "That's it, just a little longer..."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 202.26,
      "end_seconds": 210.92,
      "duration_seconds": 8.66,
      "text": "Okay: pressure 124 over 77, temperature is 36.5 degrees. And pulse is 79 beats a minute, respiratory rate 17."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 212.76,
      "end_seconds": 216.65,
      "duration_seconds": 3.89,
      "text": "Now I'm going to do a short physical check."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 228.3,
      "end_seconds": 229.34,
      "duration_seconds": 1.04,
      "text": "Of course."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 231.19,
      "end_seconds": 232.47,
      "duration_seconds": 1.28,
      "text": "Breathe out slowly."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 244.52,
      "end_seconds": 249.17,
      "duration_seconds": 4.65,
      "text": "Your eyelids and the palms of your hands look pale."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 251.88,
      "end_seconds": 260.59,
      "duration_seconds": 8.71,
      "text": "Please sit back down. So, based on the history and the examination, this looks most like heavy periods with iron deficiency."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 261.1,
      "end_seconds": 264.27,
      "duration_seconds": 3.17,
      "text": "Okay, so is it dangerous, doctor?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 268.46,
      "end_seconds": 304.27,
      "duration_seconds": 35.81,
      "text": "Nothing I've seen today points to an emergency. It looks like heavy periods with iron deficiency, but I'd like to confirm. I'm sending you for a pelvic ultrasound because of heavy periods. It's a routine test and it'll give us a much clearer picture. I'd like to arrange a ferritin level for iron deficiency. I'd like you to take ferrous sulfate, 200 milligrams, once a day, for three months. That should help with iron deficiency."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 306.02,
      "end_seconds": 309.66,
      "duration_seconds": 3.64,
      "text": "Should I carry on if I feel better?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 310.42,
      "end_seconds": 328.03,
      "duration_seconds": 17.61,
      "text": "I'd like you to take tranexamic acid, 1 gram, three times a day during periods, for four days each cycle. You take it by mouth. That's for heavy periods. Iron can darken the stools and bother the stomach, so take it after food."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 331.78,
      "end_seconds": 337.64,
      "duration_seconds": 5.86,
      "text": "Could I get a blood count done? A friend had it."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 339.36,
      "end_seconds": 360.68,
      "duration_seconds": 21.32,
      "text": "Not at this point, no. It isn't indicated yet. Keep an eye out, and if you soak through pads hourly or feel faint, call us the same day or go to emergency. Let's plan a check after the results. Can you run through the plan with me quickly, just to be certain?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 361.84,
      "end_seconds": 378.41,
      "duration_seconds": 16.57,
      "text": "So, um, I take the ferrous sulfate, 200 milligrams, once a day and take the tranexamic acid, 1 gram, three times a day during periods. Is that right?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 380.08,
      "end_seconds": 384.56,
      "duration_seconds": 4.48,
      "text": "Okay, yes, exactly right. Does all of that make sense?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 386.27,
      "end_seconds": 389.95,
      "duration_seconds": 3.68,
      "text": "Uh, I think I understand everything. Thanks."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 391.39,
      "end_seconds": 392.56,
      "duration_seconds": 1.17,
      "text": "All the best."
    }
  ]
}