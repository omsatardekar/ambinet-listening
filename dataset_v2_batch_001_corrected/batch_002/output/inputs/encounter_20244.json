{
  "schema_version": "1.0",
  "encounter_id": "20244",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.1,
      "end_seconds": 4.88,
      "duration_seconds": 3.78,
      "text": "Hi, is it okay to come in now?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.44,
      "end_seconds": 9.59,
      "duration_seconds": 4.15,
      "text": "Come in. Please sit. How can I help you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 14.28,
      "end_seconds": 19.25,
      "duration_seconds": 4.97,
      "text": "I mean, I wanted to get soreness looked at."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 21.24,
      "end_seconds": 23.19,
      "duration_seconds": 1.95,
      "text": "When did this begin?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 24.59,
      "end_seconds": 29.8,
      "duration_seconds": 5.21,
      "text": "So, it's been about a week, I'm fairly sure."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 31.85,
      "end_seconds": 35.22,
      "duration_seconds": 3.37,
      "text": "Would you say mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 36.68,
      "end_seconds": 47.82,
      "duration_seconds": 11.14,
      "text": "Pretty moderate, if I'm being honest. So, um, there was discomfort during sex, yes, but that went away."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 49.49,
      "end_seconds": 54.63,
      "duration_seconds": 5.14,
      "text": "Have you had soreness before, or is this the first time?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 55.8,
      "end_seconds": 61.77,
      "duration_seconds": 5.97,
      "text": "Uh, a bit, last winter. It settled by itself back then."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 63.26,
      "end_seconds": 66.38,
      "duration_seconds": 3.12,
      "text": "Which medicines do you take at the moment?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 66.95,
      "end_seconds": 72.16,
      "duration_seconds": 5.21,
      "text": "Ah, it's glibenclamide, 5 milligrams, before breakfast for my sugar."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 72.8,
      "end_seconds": 78.0,
      "duration_seconds": 5.2,
      "text": "Are you allergic to anything? Any allergies to medicines or foods?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 78.63,
      "end_seconds": 83.05,
      "duration_seconds": 4.42,
      "text": "Milk. I come out in... well, a rash."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 83.63,
      "end_seconds": 87.37,
      "duration_seconds": 3.74,
      "text": "Alright, is there anything relevant on the family side?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 88.69,
      "end_seconds": 90.93,
      "duration_seconds": 2.24,
      "text": "My mother had a stroke."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 104.19,
      "end_seconds": 108.28,
      "duration_seconds": 4.09,
      "text": "Tell me about any past illnesses or ongoing conditions."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 109.35,
      "end_seconds": 112.83,
      "duration_seconds": 3.48,
      "text": "I have diabetes, for two years."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 114.52,
      "end_seconds": 121.52,
      "duration_seconds": 7.0,
      "text": "Right, so diabetes is already on your record. We'll keep that in mind today."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 133.86,
      "end_seconds": 135.05,
      "duration_seconds": 1.19,
      "text": "Are you active?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 136.23,
      "end_seconds": 138.96,
      "duration_seconds": 2.73,
      "text": "I walk the dog every morning."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 140.19,
      "end_seconds": 141.5,
      "duration_seconds": 1.31,
      "text": "What's your work?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 142.16,
      "end_seconds": 146.6,
      "duration_seconds": 4.44,
      "text": "I'm a plumber, lots of bending and kneeling."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 147.53,
      "end_seconds": 149.89,
      "duration_seconds": 2.36,
      "text": "Anything surgical in your history?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 151.75,
      "end_seconds": 158.04,
      "duration_seconds": 6.29,
      "text": "Okay, so yes, I had a varicose vein procedure, last year."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 163.67,
      "end_seconds": 167.82,
      "duration_seconds": 4.15,
      "text": "Alright, and what about new partner, pelvic pain or fever?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 168.43,
      "end_seconds": 171.25,
      "duration_seconds": 2.82,
      "text": "No, I'd have said so."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 173.19,
      "end_seconds": 176.51,
      "duration_seconds": 3.32,
      "text": "Did you get smell or bleeding between periods?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 178.35,
      "end_seconds": 181.86,
      "duration_seconds": 3.51,
      "text": "Ah, no, not a single one."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 183.39,
      "end_seconds": 187.39,
      "duration_seconds": 4.0,
      "text": "Right, on the cardiac side, anything I should know?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 188.02,
      "end_seconds": 194.08,
      "duration_seconds": 6.06,
      "text": "My heart's been fine, um, as far as I know."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 195.64,
      "end_seconds": 199.08,
      "duration_seconds": 3.44,
      "text": "Shall I check your blood pressure and pulse?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 207.85,
      "end_seconds": 210.86,
      "duration_seconds": 3.01,
      "text": "That's it, just a little longer..."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 227.51,
      "end_seconds": 235.96,
      "duration_seconds": 8.45,
      "text": "Okay: temperature 36.9, BP is 117 over 74, respiratory rate 18. And heart rate 72, saturation 99 percent."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 237.27,
      "end_seconds": 239.21,
      "duration_seconds": 1.94,
      "text": "Is that alright, doctor?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 239.81,
      "end_seconds": 242.28,
      "duration_seconds": 2.47,
      "text": "We'll look at it together shortly."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 244.09,
      "end_seconds": 249.1,
      "duration_seconds": 5.01,
      "text": "I'll need to examine you for this, it won't take long."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 250.37,
      "end_seconds": 253.13,
      "duration_seconds": 2.76,
      "text": "Stay as you are for a moment."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 262.72,
      "end_seconds": 268.77,
      "duration_seconds": 6.05,
      "text": "There is a thick white discharge with redness of the vulva and no ulcers."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 272.75,
      "end_seconds": 281.94,
      "duration_seconds": 9.19,
      "text": "Okay, that's enough for me. Taking everything into account, it fits best with vaginal thrush. Bacterial vaginosis is still possible."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 293.44,
      "end_seconds": 302.04,
      "duration_seconds": 8.6,
      "text": "A swab is what I'd like next, for vaginal discharge. The result will help us decide whether anything more is needed."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 303.14,
      "end_seconds": 306.8,
      "duration_seconds": 3.66,
      "text": "I can book that for Monday at 11:30 am."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 308.29,
      "end_seconds": 339.47,
      "duration_seconds": 31.18,
      "text": "Let's book a urine test to look into dysuria. It's a routine test and it'll give us a much clearer picture. I'm prescribing fluconazole, 150 milligrams, once, for one day. It's for thrush. Wear cotton underwear and avoid scented soaps or washes. The thing that would worry me is if the symptoms get worse. If that happens, go to emergency. Let's review you if it isn't better in a week."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 340.31,
      "end_seconds": 341.01,
      "duration_seconds": 0.7,
      "text": "Right."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 342.38,
      "end_seconds": 346.03,
      "duration_seconds": 3.65,
      "text": "That's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 347.76,
      "end_seconds": 351.79,
      "duration_seconds": 4.03,
      "text": "Right, I'll do that. Thank you, doctor."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 352.57,
      "end_seconds": 354.14,
      "duration_seconds": 1.57,
      "text": "Have a good day."
    }
  ]
}