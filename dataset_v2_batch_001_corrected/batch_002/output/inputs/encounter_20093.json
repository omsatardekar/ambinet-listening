{
  "schema_version": "1.0",
  "encounter_id": "20093",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 1.36,
      "end_seconds": 6.79,
      "duration_seconds": 5.43,
      "text": "Doctor, if you're free, we can start. I've got the numbers noted down."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.6,
      "end_seconds": 11.0,
      "duration_seconds": 3.4,
      "text": "perfect, thanks. Hello there, so what's the trouble?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 15.03,
      "end_seconds": 23.5,
      "duration_seconds": 8.47,
      "text": "mainly a pounding headache. There's a couple of other things, uh, but that's the main one"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 25.04,
      "end_seconds": 27.15,
      "duration_seconds": 2.11,
      "text": "Any regular medication at all?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 28.83,
      "end_seconds": 31.67,
      "duration_seconds": 2.84,
      "text": "no, I'm not on anything"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 39.92,
      "end_seconds": 42.04,
      "duration_seconds": 2.12,
      "text": "did it come on recently?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 43.83,
      "end_seconds": 48.11,
      "duration_seconds": 4.28,
      "text": "It's been about four days, I'm fairly sure."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 48.57,
      "end_seconds": 52.53,
      "duration_seconds": 3.96,
      "text": "I follow. How much trouble does it give you?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 53.57,
      "end_seconds": 54.75,
      "duration_seconds": 1.18,
      "text": "Severe, really."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 56.34,
      "end_seconds": 58.55,
      "duration_seconds": 2.21,
      "text": "Have you been feeling sick?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 59.54,
      "end_seconds": 60.65,
      "duration_seconds": 1.11,
      "text": "Yes, actually."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 69.88,
      "end_seconds": 73.9,
      "duration_seconds": 4.02,
      "text": "any cough, rash, confusion or neck stiffness at all?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 75.58,
      "end_seconds": 80.44,
      "duration_seconds": 4.86,
      "text": "ah, no, no cough, rash, confusion or neck stiffness"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 81.41,
      "end_seconds": 83.85,
      "duration_seconds": 2.44,
      "text": "Any breathing difficulties apart from this?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 84.91,
      "end_seconds": 87.86,
      "duration_seconds": 2.95,
      "text": "No, my breathing's been fine."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 94.23,
      "end_seconds": 97.36,
      "duration_seconds": 3.13,
      "text": "Right, have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 98.14,
      "end_seconds": 99.22,
      "duration_seconds": 1.08,
      "text": "No, never."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 100.45,
      "end_seconds": 102.33,
      "duration_seconds": 1.88,
      "text": "How active are you?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 104.41,
      "end_seconds": 108.0,
      "duration_seconds": 3.59,
      "text": "I hardly move around during the day"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 109.29,
      "end_seconds": 110.51,
      "duration_seconds": 1.22,
      "text": "What's your work?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 111.79,
      "end_seconds": 115.69,
      "duration_seconds": 3.9,
      "text": "I'm a plumber, lots of bending and kneeling"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 125.87,
      "end_seconds": 129.11,
      "duration_seconds": 3.24,
      "text": "any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 130.23,
      "end_seconds": 131.91,
      "duration_seconds": 1.68,
      "text": "No, no conditions."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 133.81,
      "end_seconds": 137.92,
      "duration_seconds": 4.11,
      "text": "Any allergies to tablets, food or anything in the environment?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 143.58,
      "end_seconds": 150.9,
      "duration_seconds": 7.32,
      "text": "I was told I'm allergic to trimethoprim, but I don't remember what reaction I had"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 151.4,
      "end_seconds": 155.29,
      "duration_seconds": 3.89,
      "text": "Has anyone in your family had anything serious?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 156.04,
      "end_seconds": 160.19,
      "duration_seconds": 4.15,
      "text": "erm, uh, my grandfather had a stroke"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 160.83,
      "end_seconds": 169.55,
      "duration_seconds": 8.72,
      "text": "doctor, I've got the readings for you. BP is 119 over 71, pulse 99, temperature is 38.3 degrees"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 174.21,
      "end_seconds": 174.91,
      "duration_seconds": 0.7,
      "text": "thanks"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 177.29,
      "end_seconds": 180.06,
      "duration_seconds": 2.77,
      "text": "Okay, shall I start the examination?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 181.87,
      "end_seconds": 182.89,
      "duration_seconds": 1.02,
      "text": "Sure thing."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 184.72,
      "end_seconds": 186.77,
      "duration_seconds": 2.05,
      "text": "I'm just checking this side."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 195.56,
      "end_seconds": 200.83,
      "duration_seconds": 5.27,
      "text": "The spleen tip is just palpable and the chest is clear."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 203.35,
      "end_seconds": 206.25,
      "duration_seconds": 2.9,
      "text": "That's all I needed to check."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 219.86,
      "end_seconds": 238.48,
      "duration_seconds": 18.62,
      "text": "Let me tell you where I've got to. The most likely explanation is a fever after travel that must be treated as possible malaria. Let me repeat that back to make sure. You've had a pounding headache for about four days, severe, and no confusion or rash."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 239.11,
      "end_seconds": 240.82,
      "duration_seconds": 1.71,
      "text": "mm, that's right"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 245.29,
      "end_seconds": 257.13,
      "duration_seconds": 11.84,
      "text": "We should do blood cultures for fever. I'm going to order a malaria test, for fever after travel. The result will help us decide whether anything more is needed."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 258.99,
      "end_seconds": 261.8,
      "duration_seconds": 2.81,
      "text": "Oh, do I need to prepare?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 266.48,
      "end_seconds": 282.69,
      "duration_seconds": 16.21,
      "text": "Avoid anti-inflammatory painkillers and keep drinking. We'll refer you to the tropical diseases unit. If you become confused or cannot keep fluids down, or you feel really unwell, please come to the emergency department."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 287.2,
      "end_seconds": 290.06,
      "duration_seconds": 2.86,
      "text": "Yes, I'll bear that in mind."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 291.14,
      "end_seconds": 293.62,
      "duration_seconds": 2.48,
      "text": "let's review you in two days"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 299.14,
      "end_seconds": 301.4,
      "duration_seconds": 2.26,
      "text": "Alright, I'll be back."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 303.46,
      "end_seconds": 306.99,
      "duration_seconds": 3.53,
      "text": "that's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 308.18,
      "end_seconds": 312.18,
      "duration_seconds": 4.0,
      "text": "So, okay, that makes sense. Thanks for explaining."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 313.38,
      "end_seconds": 314.7,
      "duration_seconds": 1.32,
      "text": "See you soon."
    }
  ]
}