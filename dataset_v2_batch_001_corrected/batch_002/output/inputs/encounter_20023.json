{
  "schema_version": "1.0",
  "encounter_id": "20023",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.78,
      "end_seconds": 2.64,
      "duration_seconds": 1.86,
      "text": "Evening. Let's get started."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 3.52,
      "end_seconds": 8.56,
      "duration_seconds": 5.04,
      "text": "Hi doctor, I got here as fast as I could."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 9.86,
      "end_seconds": 12.99,
      "duration_seconds": 3.13,
      "text": "What would you like to start with today?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 13.6,
      "end_seconds": 20.04,
      "duration_seconds": 6.44,
      "text": "I wanted to get cramps in my calves at night looked at."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 20.58,
      "end_seconds": 21.91,
      "duration_seconds": 1.33,
      "text": "Since when exactly?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 23.19,
      "end_seconds": 25.98,
      "duration_seconds": 2.79,
      "text": "About... well, about a month."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 27.26,
      "end_seconds": 30.18,
      "duration_seconds": 2.92,
      "text": "Is it worse at certain times?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 32.07,
      "end_seconds": 47.84,
      "duration_seconds": 15.77,
      "text": "Yes, lying in bed. That makes it worse. As for tired legs by evening, I honestly can't say when that began. It might have been last month or the month before."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 49.39,
      "end_seconds": 51.15,
      "duration_seconds": 1.76,
      "text": "Does anything help it?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 53.15,
      "end_seconds": 58.29,
      "duration_seconds": 5.14,
      "text": "Only putting my feet up, and it's not much."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 58.86,
      "end_seconds": 59.56,
      "duration_seconds": 0.7,
      "text": "Yes."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 61.07,
      "end_seconds": 83.39,
      "duration_seconds": 22.32,
      "text": "And there's a dull ache after the cramp as well, two years now. Hmm, with dull ache after the cramp, a five out of ten, I suppose. I've also had tingling in my feet, for about a year."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 84.77,
      "end_seconds": 87.23,
      "duration_seconds": 2.46,
      "text": "How frequently does it come?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 88.01,
      "end_seconds": 90.27,
      "duration_seconds": 2.26,
      "text": "I'd say every other day."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 90.96,
      "end_seconds": 96.6,
      "duration_seconds": 5.64,
      "text": "A few quick ones: weakness in the legs or redness of the leg?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 97.72,
      "end_seconds": 103.74,
      "duration_seconds": 6.02,
      "text": "I haven't had weakness in the legs or redness of the leg, no."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 105.59,
      "end_seconds": 112.64,
      "duration_seconds": 7.05,
      "text": "Any back pain, swelling of the legs, chest pain or shortness of breath at all?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 113.5,
      "end_seconds": 116.29,
      "duration_seconds": 2.79,
      "text": "No, nothing to report there."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 117.27,
      "end_seconds": 120.14,
      "duration_seconds": 2.87,
      "text": "How are your bowels, any trouble?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 121.81,
      "end_seconds": 124.81,
      "duration_seconds": 3.0,
      "text": "Erm, no, all normal there."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 138.08,
      "end_seconds": 139.32,
      "duration_seconds": 1.24,
      "text": "What about alcohol?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 141.11,
      "end_seconds": 145.11,
      "duration_seconds": 4.0,
      "text": "I'll have a glass of wine with dinner."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 146.93,
      "end_seconds": 149.02,
      "duration_seconds": 2.09,
      "text": "Do you live by yourself?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 149.89,
      "end_seconds": 154.44,
      "duration_seconds": 4.55,
      "text": "No, I share a house with my brother."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 155.71,
      "end_seconds": 157.29,
      "duration_seconds": 1.58,
      "text": "How are your meals?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 158.01,
      "end_seconds": 161.99,
      "duration_seconds": 3.98,
      "text": "I grab fast food at lunch most days."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 163.37,
      "end_seconds": 166.25,
      "duration_seconds": 2.88,
      "text": "Do you work outside the home?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 166.91,
      "end_seconds": 170.83,
      "duration_seconds": 3.92,
      "text": "I'm a hairdresser, on my feet all day."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 172.04,
      "end_seconds": 174.14,
      "duration_seconds": 2.1,
      "text": "Tell me your medicines, please."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 176.21,
      "end_seconds": 190.06,
      "duration_seconds": 13.85,
      "text": "It's glimepiride, 2 milligrams, before breakfast for my sugar. Lisinopril, 10 milligrams, once a day. Right, before this I was on gliclazide; that's been stopped."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 190.89,
      "end_seconds": 194.35,
      "duration_seconds": 3.46,
      "text": "Let me ask about allergies, anything at all?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 195.98,
      "end_seconds": 197.42,
      "duration_seconds": 1.44,
      "text": "No known allergies."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 199.13,
      "end_seconds": 202.21,
      "duration_seconds": 3.08,
      "text": "Has anyone ever diagnosed you with something?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 202.88,
      "end_seconds": 206.46,
      "duration_seconds": 3.58,
      "text": "I've had diabetes for five years now."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 208.08,
      "end_seconds": 209.11,
      "duration_seconds": 1.03,
      "text": "Hm, okay."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 210.5,
      "end_seconds": 215.2,
      "duration_seconds": 4.7,
      "text": "I have high blood pressure, for nearly five years."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 217.04,
      "end_seconds": 218.3,
      "duration_seconds": 1.26,
      "text": "And besides that?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 218.83,
      "end_seconds": 224.65,
      "duration_seconds": 5.82,
      "text": "Okay, I can see diabetes and high blood pressure in your file as well."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 238.91,
      "end_seconds": 242.15,
      "duration_seconds": 3.24,
      "text": "Does your family have any medical conditions?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 244.02,
      "end_seconds": 246.28,
      "duration_seconds": 2.26,
      "text": "My mother had a stroke."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 247.84,
      "end_seconds": 250.77,
      "duration_seconds": 2.93,
      "text": "I'll just record a few vital signs."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 258.82,
      "end_seconds": 261.12,
      "duration_seconds": 2.3,
      "text": "Nearly done with the readings..."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 274.5,
      "end_seconds": 280.37,
      "duration_seconds": 5.87,
      "text": "Okay: heart rate 64, temp 36.9 degrees, blood pressure 118 over 80."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 282.44,
      "end_seconds": 284.09,
      "duration_seconds": 1.65,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 285.69,
      "end_seconds": 288.44,
      "duration_seconds": 2.75,
      "text": "That's fine, I'll explain it soon."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 301.46,
      "end_seconds": 313.8,
      "duration_seconds": 12.34,
      "text": "From what you've told me, it points towards night-time muscle cramps without a worrying cause. Another possibility is a low salt level or low magnesium."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 314.65,
      "end_seconds": 317.55,
      "duration_seconds": 2.9,
      "text": "Is there something to worry about?"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 319.57,
      "end_seconds": 338.39,
      "duration_seconds": 18.82,
      "text": "I understand the worry. At the moment I'd say it's night-time muscle cramps without a worrying cause, and we'll know more once the blood tests is back. We should do blood tests for muscle cramps. We should do a vitamin level for tingling feet."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 339.84,
      "end_seconds": 341.44,
      "duration_seconds": 1.6,
      "text": "Does it hurt?"
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 343.03,
      "end_seconds": 355.51,
      "duration_seconds": 12.48,
      "text": "Gentle calf stretches against a wall before bed often help. Come back or go to emergency straight away if one leg becomes red, hot or swollen."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 356.48,
      "end_seconds": 358.49,
      "duration_seconds": 2.01,
      "text": "That's fine by me."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 359.77,
      "end_seconds": 367.78,
      "duration_seconds": 8.01,
      "text": "Let's review you in four weeks. How would you describe the plan, so we're on the same page?"
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 369.0,
      "end_seconds": 374.38,
      "duration_seconds": 5.38,
      "text": "So, I come back in four weeks. Is that right?"
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 376.06,
      "end_seconds": 382.24,
      "duration_seconds": 6.18,
      "text": "Okay, yes, exactly right. Is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 382.93,
      "end_seconds": 385.78,
      "duration_seconds": 2.85,
      "text": "Great, thank you for your help."
    }
  ]
}