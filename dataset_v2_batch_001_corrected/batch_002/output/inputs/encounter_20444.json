{
  "schema_version": "1.0",
  "encounter_id": "20444",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.57,
      "end_seconds": 3.72,
      "duration_seconds": 3.15,
      "text": "Hello, sorry about the delay, do sit."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 4.66,
      "end_seconds": 7.78,
      "duration_seconds": 3.12,
      "text": "Hello. I hope I'm not late."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 9.0,
      "end_seconds": 12.21,
      "duration_seconds": 3.21,
      "text": "What would you like to start with today?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 13.97,
      "end_seconds": 20.54,
      "duration_seconds": 6.57,
      "text": "Oh, doctor, it's a trembling in my hands. It's getting on my nerves now."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 21.27,
      "end_seconds": 24.79,
      "duration_seconds": 3.52,
      "text": "Okay, has this been going on for long?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 26.62,
      "end_seconds": 35.7,
      "duration_seconds": 9.08,
      "text": "For nearly five years, I'd say. Work has been very busy so I kept ignoring it."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 36.36,
      "end_seconds": 39.44,
      "duration_seconds": 3.08,
      "text": "Is it bearing on you a lot?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 40.95,
      "end_seconds": 61.35,
      "duration_seconds": 20.4,
      "text": "Let me think, maybe a six out of ten on a bad day. And I've been losing weight despite eating well as well, for nearly five years. I've also had my heart racing, for two months."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 63.03,
      "end_seconds": 67.03,
      "duration_seconds": 4.0,
      "text": "And what about double vision, eye pain or fever?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 71.71,
      "end_seconds": 74.47,
      "duration_seconds": 2.76,
      "text": "No, none that I've noticed."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 76.22,
      "end_seconds": 80.13,
      "duration_seconds": 3.91,
      "text": "Have you had any fainting or neck swelling?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 82.01,
      "end_seconds": 84.37,
      "duration_seconds": 2.36,
      "text": "None of those, no."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 86.07,
      "end_seconds": 88.94,
      "duration_seconds": 2.87,
      "text": "Any problems with your joints or muscles?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 91.02,
      "end_seconds": 92.4,
      "duration_seconds": 1.38,
      "text": "Nothing else aches."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 94.18,
      "end_seconds": 98.43,
      "duration_seconds": 4.25,
      "text": "Let's talk a little about your daily life and habits."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 99.25,
      "end_seconds": 109.24,
      "duration_seconds": 9.99,
      "text": "I'm a bus driver, so I sit for long hours. I swim twice a week. I live with my elderly mother."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 125.36,
      "end_seconds": 133.05,
      "duration_seconds": 7.69,
      "text": "Are you taking anything regularly, including from the pharmacy? Just so I get the full picture."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 133.83,
      "end_seconds": 138.08,
      "duration_seconds": 4.25,
      "text": "Valsartan. I take it 80 milligrams, once a day."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 139.92,
      "end_seconds": 142.83,
      "duration_seconds": 2.91,
      "text": "Right, any surgery in the past?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 143.68,
      "end_seconds": 149.6,
      "duration_seconds": 5.92,
      "text": "Yes, I had a meniscus repair on my knee, four years ago."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 150.67,
      "end_seconds": 152.64,
      "duration_seconds": 1.97,
      "text": "What about your medical history?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 153.15,
      "end_seconds": 156.71,
      "duration_seconds": 3.56,
      "text": "High blood pressure, for about a year."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 158.21,
      "end_seconds": 160.09,
      "duration_seconds": 1.88,
      "text": "I see, go ahead."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 171.29,
      "end_seconds": 174.69,
      "duration_seconds": 3.4,
      "text": "Let me ask about allergies, anything at all?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 175.56,
      "end_seconds": 178.54,
      "duration_seconds": 2.98,
      "text": "Yes, wheat, it gives me bloating."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 179.39,
      "end_seconds": 182.14,
      "duration_seconds": 2.75,
      "text": "Does your family have any medical conditions?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 185.82,
      "end_seconds": 188.0,
      "duration_seconds": 2.18,
      "text": "My cousin has psoriasis."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 199.63,
      "end_seconds": 204.17,
      "duration_seconds": 4.54,
      "text": "Can I check a few measurements before we carry on?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 213.67,
      "end_seconds": 216.23,
      "duration_seconds": 2.56,
      "text": "Bear with me while this finishes..."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 230.37,
      "end_seconds": 236.65,
      "duration_seconds": 6.28,
      "text": "Okay: SpO2 96 percent on room air, pulse 109, pressure 138 over 71."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 239.47,
      "end_seconds": 243.69,
      "duration_seconds": 4.22,
      "text": "I'd like to check you over now, if that's alright."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 245.04,
      "end_seconds": 247.5,
      "duration_seconds": 2.46,
      "text": "Raise your arm for me."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 262.0,
      "end_seconds": 269.28,
      "duration_seconds": 7.28,
      "text": "There is a fine tremor of the outstretched hands and the pulse is fast and regular."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 272.43,
      "end_seconds": 283.65,
      "duration_seconds": 11.22,
      "text": "That's all I needed to check. Taking everything into account, this looks most like an overactive thyroid. I can't rule out anxiety yet."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 285.03,
      "end_seconds": 287.82,
      "duration_seconds": 2.79,
      "text": "What are the odds it's serious?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 288.76,
      "end_seconds": 302.39,
      "duration_seconds": 13.63,
      "text": "Nothing I've seen today points to an emergency. It looks like an overactive thyroid, but I'd like to confirm. I'm sending you for a thyroid scan because of neck swelling."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 303.29,
      "end_seconds": 304.81,
      "duration_seconds": 1.52,
      "text": "Does it hurt?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 305.79,
      "end_seconds": 328.36,
      "duration_seconds": 22.57,
      "text": "What I'm giving you is propranolol, 20 milligrams, twice a day, until review. That's for racing heart and tremor. Try to avoid caffeine while we sort this out. Cut down on salt and fried food for now, it really does make a difference. I'll also refer you to the endocrine clinic. Come back in two weeks."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 329.28,
      "end_seconds": 331.38,
      "duration_seconds": 2.1,
      "text": "That's fine with me."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 332.33,
      "end_seconds": 335.15,
      "duration_seconds": 2.82,
      "text": "Does all of that make sense?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 336.41,
      "end_seconds": 339.34,
      "duration_seconds": 2.93,
      "text": "I think I understand everything. Thanks."
    }
  ]
}