{
  "schema_version": "1.0",
  "encounter_id": "20243",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.76,
      "end_seconds": 6.66,
      "duration_seconds": 5.9,
      "text": "Hello doctor, sorry, I took a wrong turn on the way here."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.47,
      "end_seconds": 13.48,
      "duration_seconds": 5.01,
      "text": "Yes, come in and sit down. What brings you here today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 17.86,
      "end_seconds": 24.36,
      "duration_seconds": 6.5,
      "text": "Honestly, it's sore, gritty eyes, and my family pushed me to come."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 25.4,
      "end_seconds": 30.97,
      "duration_seconds": 5.57,
      "text": "What's on your current medicine list? Take your time, there's no rush."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 32.86,
      "end_seconds": 42.49,
      "duration_seconds": 9.63,
      "text": "Hydrocortisone cream. I take it when needed for the eczema. Though honestly, some days I forget to take it."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 51.5,
      "end_seconds": 54.4,
      "duration_seconds": 2.9,
      "text": "What's the timeline, when did it begin?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 56.42,
      "end_seconds": 62.81,
      "duration_seconds": 6.39,
      "text": "About two weeks, I think... sorry, four weeks, I got that wrong."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 63.81,
      "end_seconds": 67.1,
      "duration_seconds": 3.29,
      "text": "Is it bearing on you a lot?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 67.89,
      "end_seconds": 69.1,
      "duration_seconds": 1.21,
      "text": "Moderate, really."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 70.27,
      "end_seconds": 72.44,
      "duration_seconds": 2.17,
      "text": "What aggravates it, if anything?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 73.84,
      "end_seconds": 77.07,
      "duration_seconds": 3.23,
      "text": "Yes, wind. That makes it worse."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 80.06,
      "end_seconds": 82.52,
      "duration_seconds": 2.46,
      "text": "Any other symptoms with it?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 83.24,
      "end_seconds": 93.3,
      "duration_seconds": 10.06,
      "text": "It usually comes with red eyes in the evening. Uh, the red eyes in the evening? That's been for four weeks."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 104.41,
      "end_seconds": 109.14,
      "duration_seconds": 4.73,
      "text": "And what about loss of vision, double vision or flashing lights?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 110.26,
      "end_seconds": 113.12,
      "duration_seconds": 2.86,
      "text": "Uh, nope, nothing like that."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 114.01,
      "end_seconds": 116.91,
      "duration_seconds": 2.9,
      "text": "Any eye pain or sensitivity to light?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 118.01,
      "end_seconds": 122.91,
      "duration_seconds": 4.9,
      "text": "No eye pain or sensitivity to light, none of it."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 123.69,
      "end_seconds": 127.37,
      "duration_seconds": 3.68,
      "text": "What about your tummy and bowels, anything unusual there?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 130.59,
      "end_seconds": 132.94,
      "duration_seconds": 2.35,
      "text": "No, all normal there."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 136.87,
      "end_seconds": 141.15,
      "duration_seconds": 4.28,
      "text": "Anything with your heart, like skipped beats or fainting?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 143.21,
      "end_seconds": 145.86,
      "duration_seconds": 2.65,
      "text": "No, nothing with my heart."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 153.71,
      "end_seconds": 156.14,
      "duration_seconds": 2.43,
      "text": "Do you live by yourself?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 157.44,
      "end_seconds": 161.38,
      "duration_seconds": 3.94,
      "text": "No, I share a house with my brother."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 161.97,
      "end_seconds": 164.03,
      "duration_seconds": 2.06,
      "text": "Okay, what's your work?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 165.64,
      "end_seconds": 169.63,
      "duration_seconds": 3.99,
      "text": "I'm a plumber, lots of bending and kneeling."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 171.08,
      "end_seconds": 173.06,
      "duration_seconds": 1.98,
      "text": "What about your medical history?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 175.04,
      "end_seconds": 177.7,
      "duration_seconds": 2.66,
      "text": "I've, I've had eczema, yes."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 182.74,
      "end_seconds": 192.94,
      "duration_seconds": 10.2,
      "text": "Right, so eczema is already on your record. We'll keep that in mind today. Okay, do you react to any medicines or foods? Any allergies?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 196.97,
      "end_seconds": 200.12,
      "duration_seconds": 3.15,
      "text": "No, not that I know of."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 201.99,
      "end_seconds": 204.31,
      "duration_seconds": 2.32,
      "text": "Anything surgical in your history?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 205.24,
      "end_seconds": 211.48,
      "duration_seconds": 6.24,
      "text": "I had a wisdom tooth extraction under sedation five years ago."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 213.1,
      "end_seconds": 215.69,
      "duration_seconds": 2.59,
      "text": "Let's start with the basic checks."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 222.99,
      "end_seconds": 225.9,
      "duration_seconds": 2.91,
      "text": "So, nearly done with the readings..."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 236.66,
      "end_seconds": 248.67,
      "duration_seconds": 12.01,
      "text": "Okay: height 151 centimetres, saturation 99 percent, weight 57 kilos, heart rate 83, BMI works out to 25.0, BP is 120 over 69."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 250.73,
      "end_seconds": 252.38,
      "duration_seconds": 1.65,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 254.08,
      "end_seconds": 256.74,
      "duration_seconds": 2.66,
      "text": "I'll interpret them after the examination."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 259.0,
      "end_seconds": 263.23,
      "duration_seconds": 4.23,
      "text": "Let me look at the area, I'll be gentle."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 264.04,
      "end_seconds": 266.97,
      "duration_seconds": 2.93,
      "text": "I'll listen to your chest now."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 278.08,
      "end_seconds": 285.98,
      "duration_seconds": 7.9,
      "text": "The eyes are slightly red with no discharge and the front of the eye looks clear."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 290.48,
      "end_seconds": 313.76,
      "duration_seconds": 23.28,
      "text": "Okay, that's enough for me. So where does that leave us? It fits best with dry eye syndrome. The reason I say that is that your story and my examination fit together. We shouldn't forget allergic conjunctivitis. I think an eye test makes sense here, for blurred vision. That's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 314.76,
      "end_seconds": 316.68,
      "duration_seconds": 1.92,
      "text": "Thank you, that's helpful."
    }
  ]
}