{
  "schema_version": "1.0",
  "encounter_id": "20389",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.92,
      "end_seconds": 5.0,
      "duration_seconds": 4.08,
      "text": "good evening, doctor, thanks for seeing me"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.37,
      "end_seconds": 11.11,
      "duration_seconds": 4.74,
      "text": "okay, of course, leave it there how can I help?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 14.95,
      "end_seconds": 22.05,
      "duration_seconds": 7.1,
      "text": "honestly, it's a dry tickly cough, and my family pushed me to come"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 23.98,
      "end_seconds": 27.28,
      "duration_seconds": 3.3,
      "text": "How many days or weeks has it been?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 29.2,
      "end_seconds": 32.86,
      "duration_seconds": 3.66,
      "text": "It's been going on for about three months."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 33.9,
      "end_seconds": 37.85,
      "duration_seconds": 3.95,
      "text": "Is it a lot or only a little?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 39.63,
      "end_seconds": 42.08,
      "duration_seconds": 2.45,
      "text": "it feels severe to me"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 43.11,
      "end_seconds": 46.3,
      "duration_seconds": 3.19,
      "text": "is it it worse at certain times?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 48.02,
      "end_seconds": 51.51,
      "duration_seconds": 3.49,
      "text": "yes, lying down. That makes it worse"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 55.13,
      "end_seconds": 57.38,
      "duration_seconds": 2.25,
      "text": "is it accompanied by anything?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 58.99,
      "end_seconds": 68.05,
      "duration_seconds": 9.06,
      "text": "It usually comes with a hoarse voice. Hmm, the hoarse voice? That's been for about three months."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 69.05,
      "end_seconds": 73.05,
      "duration_seconds": 4.0,
      "text": "Any wheeze, coughing up blood, weight loss or fever?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 74.17,
      "end_seconds": 77.72,
      "duration_seconds": 3.55,
      "text": "oh, no, I'd have said so so"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 79.15,
      "end_seconds": 84.29,
      "duration_seconds": 5.14,
      "text": "have you noticed any weakness, or anything odd with your balance?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 86.28,
      "end_seconds": 90.42,
      "duration_seconds": 4.14,
      "text": "Okay, so so no, nothing like that."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 103.84,
      "end_seconds": 105.29,
      "duration_seconds": 1.45,
      "text": "What's your work?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 106.5,
      "end_seconds": 110.73,
      "duration_seconds": 4.23,
      "text": "I'm a plumber, lots of bending and kneeling."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 112.66,
      "end_seconds": 113.83,
      "duration_seconds": 1.17,
      "text": "are you active?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 114.9,
      "end_seconds": 117.62,
      "duration_seconds": 2.72,
      "text": "I walk the dog every morning."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 131.65,
      "end_seconds": 134.29,
      "duration_seconds": 2.64,
      "text": "What's on your current medicine list?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 135.87,
      "end_seconds": 145.3,
      "duration_seconds": 9.43,
      "text": "Cough syrup. I take it at night. I'd rather not end up on lots of tablets if I can avoid it"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 147.24,
      "end_seconds": 151.85,
      "duration_seconds": 4.61,
      "text": "Do you have any medical conditions I should know about?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 153.74,
      "end_seconds": 155.26,
      "duration_seconds": 1.52,
      "text": "not really no"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 156.78,
      "end_seconds": 159.73,
      "duration_seconds": 2.95,
      "text": "have you got any known allergies?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 161.6,
      "end_seconds": 166.77,
      "duration_seconds": 5.17,
      "text": "I'm allergic to nickel, I get a rash on my skin."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 168.3,
      "end_seconds": 172.69,
      "duration_seconds": 4.39,
      "text": "Let me get the readings out of the way."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 183.36,
      "end_seconds": 185.63,
      "duration_seconds": 2.27,
      "text": "nearly done with the readings.."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 197.03,
      "end_seconds": 208.21,
      "duration_seconds": 11.18,
      "text": "Okay: BP is 111 over 68, heart rate 79. And oxygen saturation is 98 percent, respiratory rate 18, temperature is 37.0 degrees."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 210.52,
      "end_seconds": 214.76,
      "duration_seconds": 4.24,
      "text": "I'll examine you in a second make yourself comfortable"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 216.6,
      "end_seconds": 218.32,
      "duration_seconds": 1.72,
      "text": "Let me feel here."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 228.0,
      "end_seconds": 231.73,
      "duration_seconds": 3.73,
      "text": "Your chest is clear and there is no wheeze."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 234.82,
      "end_seconds": 237.11,
      "duration_seconds": 2.29,
      "text": "you can sit up now"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 248.25,
      "end_seconds": 262.77,
      "duration_seconds": 14.52,
      "text": "so where does that leave us? This is probably a persistent dry cough without a clear cause so far i want to be honest that this is an impression, not a final answer"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 263.35,
      "end_seconds": 267.58,
      "duration_seconds": 4.23,
      "text": "sorry what was I saying will it clear up?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 269.25,
      "end_seconds": 286.31,
      "duration_seconds": 17.06,
      "text": "Nothing I've seen today points to an emergency. It looks like a persistent dry cough without a clear cause so far, but I'd like to confirm. I'll request a chest X-ray, it'll help with chronic cough."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 287.41,
      "end_seconds": 291.47,
      "duration_seconds": 4.06,
      "text": "Okay, so where would I go for that?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 293.28,
      "end_seconds": 309.55,
      "duration_seconds": 16.27,
      "text": "we will review your tablets and see whether the cough settles over a month one warning sign to remember: you cough up blood or lose weight in that case don't wait let's review you in four weeks"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 310.41,
      "end_seconds": 311.11,
      "duration_seconds": 0.7,
      "text": "right"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 312.54,
      "end_seconds": 315.75,
      "duration_seconds": 3.21,
      "text": "anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 317.01,
      "end_seconds": 321.09,
      "duration_seconds": 4.08,
      "text": "right uh I'll do that. Thank you doctor"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 323.04,
      "end_seconds": 324.61,
      "duration_seconds": 1.57,
      "text": "Have a good day."
    }
  ]
}