{
  "schema_version": "1.0",
  "encounter_id": "20364",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.67,
      "end_seconds": 3.33,
      "duration_seconds": 2.66,
      "text": "Good afternoon, how are you today?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 4.88,
      "end_seconds": 7.77,
      "duration_seconds": 2.89,
      "text": "Tell me what's brought you in."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 9.34,
      "end_seconds": 17.46,
      "duration_seconds": 8.12,
      "text": "Um, doctor, it's bright red blood on the paper. It's getting on my nerves now."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 18.98,
      "end_seconds": 22.62,
      "duration_seconds": 3.64,
      "text": "So, time for your numbers, if that's okay."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 36.14,
      "end_seconds": 39.72,
      "duration_seconds": 3.58,
      "text": "Alright, that's it, just a little longer..."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 57.37,
      "end_seconds": 64.21,
      "duration_seconds": 6.84,
      "text": "Okay: heart rate 81, saturation 97 percent, temperature is 36.9 degrees, pressure 120 over 75."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 71.87,
      "end_seconds": 73.53,
      "duration_seconds": 1.66,
      "text": "When did this begin?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 76.78,
      "end_seconds": 78.4,
      "duration_seconds": 1.62,
      "text": "It started yesterday."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 80.03,
      "end_seconds": 82.57,
      "duration_seconds": 2.54,
      "text": "Has there been hard stools too?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 83.85,
      "end_seconds": 94.94,
      "duration_seconds": 11.09,
      "text": "Yes, for one week. With hard stools, about a five out of ten. And discomfort when sitting as well, since last Tuesday."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 95.68,
      "end_seconds": 102.56,
      "duration_seconds": 6.88,
      "text": "Have you had bright red blood on the paper before, or is this the first time?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 104.19,
      "end_seconds": 111.16,
      "duration_seconds": 6.97,
      "text": "Yes, something like this happened last winter, and it went away on its own."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 112.8,
      "end_seconds": 117.57,
      "duration_seconds": 4.77,
      "text": "Let me check a few things. Any black stools or weight loss?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 118.64,
      "end_seconds": 121.3,
      "duration_seconds": 2.66,
      "text": "No, none that I've noticed."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 121.98,
      "end_seconds": 126.93,
      "duration_seconds": 4.95,
      "text": "Have you noticed dizziness, fever or change in bowel habit?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 127.8,
      "end_seconds": 130.79,
      "duration_seconds": 2.99,
      "text": "No, none of those at all."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 132.69,
      "end_seconds": 136.01,
      "duration_seconds": 3.32,
      "text": "Any problems with your joints or muscles?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 137.6,
      "end_seconds": 139.59,
      "duration_seconds": 1.99,
      "text": "No, joints are fine."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 140.18,
      "end_seconds": 142.38,
      "duration_seconds": 2.2,
      "text": "Anything unusual with passing urine?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 143.23,
      "end_seconds": 146.64,
      "duration_seconds": 3.41,
      "text": "That's normal as far as I know."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 147.86,
      "end_seconds": 151.67,
      "duration_seconds": 3.81,
      "text": "Anything in your past medical history I should know?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 152.87,
      "end_seconds": 155.43,
      "duration_seconds": 2.56,
      "text": "Low haemoglobin, for two years."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 156.5,
      "end_seconds": 164.31,
      "duration_seconds": 7.81,
      "text": "Hm, okay. Alright, low haemoglobin, that matches what I have here. What's on your current medicine list?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 165.78,
      "end_seconds": 175.73,
      "duration_seconds": 9.95,
      "text": "I take iron tablets, once a day for my blood count. A soothing cream. I take it when needed."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 177.08,
      "end_seconds": 178.25,
      "duration_seconds": 1.17,
      "text": "Is that long-standing?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 179.87,
      "end_seconds": 182.13,
      "duration_seconds": 2.26,
      "text": "About a year now."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 184.06,
      "end_seconds": 186.6,
      "duration_seconds": 2.54,
      "text": "Before we go further, any allergies?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 187.41,
      "end_seconds": 196.59,
      "duration_seconds": 9.18,
      "text": "Hmm, yes, nickel. I've no idea what the reaction was, only that I'm not supposed to have it."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 197.28,
      "end_seconds": 201.42,
      "duration_seconds": 4.14,
      "text": "Let's talk a little about your daily life and habits."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 204.52,
      "end_seconds": 216.34,
      "duration_seconds": 11.82,
      "text": "Lots of rice, lentils and some fruit. I'm a plumber, lots of bending and kneeling. I walk the dog every morning."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 218.44,
      "end_seconds": 223.12,
      "duration_seconds": 4.68,
      "text": "Right, now I'm going to do a short physical check."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 233.44,
      "end_seconds": 234.94,
      "duration_seconds": 1.5,
      "text": "Yes, that's fine."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 235.94,
      "end_seconds": 238.59,
      "duration_seconds": 2.65,
      "text": "Alright, raise your arm for me."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 247.25,
      "end_seconds": 256.35,
      "duration_seconds": 9.1,
      "text": "There is a small soft lump at the edge of the anus and no tear that I can see."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 259.5,
      "end_seconds": 261.23,
      "duration_seconds": 1.73,
      "text": "You can relax now."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 268.68,
      "end_seconds": 274.26,
      "duration_seconds": 5.58,
      "text": "Having listened and examined, it points towards haemorrhoids. We shouldn't forget an anal tear."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 275.27,
      "end_seconds": 277.18,
      "duration_seconds": 1.91,
      "text": "Is this serious, doctor?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 279.07,
      "end_seconds": 306.83,
      "duration_seconds": 27.76,
      "text": "It's reasonable to be concerned, but right now haemorrhoids is my leading thought, not anything worse. I'll request a blood count, it'll help with rectal bleeding. Fibre, plenty of water, and don't sit on the toilet for long. I'm going to send a referral to the colorectal clinic. Please come and see me after the camera test. Is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 308.44,
      "end_seconds": 310.68,
      "duration_seconds": 2.24,
      "text": "Thank you, doctor, goodbye."
    }
  ]
}