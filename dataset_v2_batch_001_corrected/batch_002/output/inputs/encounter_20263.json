{
  "schema_version": "1.0",
  "encounter_id": "20263",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.17,
      "end_seconds": 5.29,
      "duration_seconds": 4.12,
      "text": "Hello? Doctor? I was told to come in."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.57,
      "end_seconds": 11.32,
      "duration_seconds": 4.75,
      "text": "Not at all, please sit. What seems to be wrong?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 13.32,
      "end_seconds": 17.72,
      "duration_seconds": 4.4,
      "text": "I've been dealing with a ringing in the ear."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 19.14,
      "end_seconds": 20.43,
      "duration_seconds": 1.29,
      "text": "Since when exactly?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 21.07,
      "end_seconds": 26.67,
      "duration_seconds": 5.6,
      "text": "I'd say about a week. Actually, no, closer to about two weeks."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 27.1,
      "end_seconds": 30.44,
      "duration_seconds": 3.34,
      "text": "Yes, carry on. Is it accompanied by anything?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 32.23,
      "end_seconds": 39.51,
      "duration_seconds": 7.28,
      "text": "Sudden hearing loss in my left ear goes along with it, most of the time."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 42.24,
      "end_seconds": 49.67,
      "duration_seconds": 7.43,
      "text": "Alright, have you had a ringing in the ear before, or is this the first time?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 50.85,
      "end_seconds": 57.48,
      "duration_seconds": 6.63,
      "text": "I mean, a bit, last year. It settled by itself back then."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 58.5,
      "end_seconds": 61.4,
      "duration_seconds": 2.9,
      "text": "Let's start with the basic checks."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 72.82,
      "end_seconds": 75.39,
      "duration_seconds": 2.57,
      "text": "That's it, just a little longer..."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 93.4,
      "end_seconds": 100.71,
      "duration_seconds": 7.31,
      "text": "Okay: oxygen saturation is 99 percent, blood pressure 127 over 75. And respiratory rate 16, heart rate 79."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 102.66,
      "end_seconds": 104.09,
      "duration_seconds": 1.43,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 105.2,
      "end_seconds": 107.7,
      "duration_seconds": 2.5,
      "text": "That's fine, I'll explain it soon."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 110.03,
      "end_seconds": 113.28,
      "duration_seconds": 3.25,
      "text": "Could you come over to the couch, please?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 114.63,
      "end_seconds": 115.81,
      "duration_seconds": 1.18,
      "text": "Breathe out slowly."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 125.99,
      "end_seconds": 131.93,
      "duration_seconds": 5.94,
      "text": "Both eardrums look normal and a tuning fork is heard better in the right ear."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 135.68,
      "end_seconds": 137.62,
      "duration_seconds": 1.94,
      "text": "Please sit back down."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 153.07,
      "end_seconds": 154.3,
      "duration_seconds": 1.23,
      "text": "What about discharge?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 157.55,
      "end_seconds": 159.14,
      "duration_seconds": 1.59,
      "text": "Definitely no discharge."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 160.18,
      "end_seconds": 164.91,
      "duration_seconds": 4.73,
      "text": "Any head injury, recent flying or ear pain at all?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 165.66,
      "end_seconds": 168.59,
      "duration_seconds": 2.93,
      "text": "No, I'd have said so."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 169.58,
      "end_seconds": 172.39,
      "duration_seconds": 2.81,
      "text": "How are your bowels, any trouble?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 173.49,
      "end_seconds": 175.89,
      "duration_seconds": 2.4,
      "text": "Bowels are regular, nothing odd."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 176.66,
      "end_seconds": 179.39,
      "duration_seconds": 2.73,
      "text": "Is your urine normal, no changes?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 181.15,
      "end_seconds": 183.12,
      "duration_seconds": 1.97,
      "text": "No, that's all fine."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 184.49,
      "end_seconds": 186.74,
      "duration_seconds": 2.25,
      "text": "Any surgery in the past?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 192.41,
      "end_seconds": 198.27,
      "duration_seconds": 5.86,
      "text": "I had my appendix taken out when I was in my twenties."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 198.89,
      "end_seconds": 201.23,
      "duration_seconds": 2.34,
      "text": "Let's run through your medicines."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 201.92,
      "end_seconds": 211.57,
      "duration_seconds": 9.65,
      "text": "I'm on amlodipine, 5 milligrams, once a day. I told myself I'd wait and see, and here I am."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 219.26,
      "end_seconds": 222.79,
      "duration_seconds": 3.53,
      "text": "Any health conditions I should have on record?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 224.07,
      "end_seconds": 229.06,
      "duration_seconds": 4.99,
      "text": "I've had high blood pressure for nearly five years now."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 230.02,
      "end_seconds": 241.37,
      "duration_seconds": 11.35,
      "text": "Ah. Alright, high blood pressure, that matches what I have here. Have you got any known allergies? Bear with me, I'm just building up the picture."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 242.11,
      "end_seconds": 246.68,
      "duration_seconds": 4.57,
      "text": "Oh, I don't think I have any, no."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 247.58,
      "end_seconds": 250.14,
      "duration_seconds": 2.56,
      "text": "Now some background about your lifestyle."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 250.79,
      "end_seconds": 264.4,
      "duration_seconds": 13.61,
      "text": "I hardly move around during the day. No, I share a house with my brother. I'm a bus driver, so I sit for long hours."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 276.41,
      "end_seconds": 296.63,
      "duration_seconds": 20.22,
      "text": "Okay, so my impression is this: The most likely explanation is sudden loss of hearing that needs urgent assessment. We shouldn't forget a middle ear fluid problem. Stop me if I've got anything wrong. You've had a ringing in the ear for about two weeks, and no ear pain or discharge."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 298.63,
      "end_seconds": 300.28,
      "duration_seconds": 1.65,
      "text": "That's it, yes."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 301.54,
      "end_seconds": 335.2,
      "duration_seconds": 33.66,
      "text": "I'm going to order a hearing test, for sudden hearing loss. What I'm giving you is prednisolone, 60 milligrams, once a day in the morning, for seven days. It's for sudden hearing loss. Please attend the hearing test today if you can, as timing matters. I'll also refer you to the ear specialists. One warning sign to remember: the dizziness gets worse or you develop facial weakness. In that case don't wait."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 336.08,
      "end_seconds": 343.11,
      "duration_seconds": 7.03,
      "text": "I'd like to see you again after the hearing test. Right, that's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 345.12,
      "end_seconds": 348.7,
      "duration_seconds": 3.58,
      "text": "Good, thanks, I'll see you then."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 350.15,
      "end_seconds": 352.1,
      "duration_seconds": 1.95,
      "text": "Have a good day."
    }
  ]
}