{
  "schema_version": "1.0",
  "encounter_id": "20028",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.71,
      "end_seconds": 6.8,
      "duration_seconds": 6.09,
      "text": "Doctor, hi, where would you like me to put my coat?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.4,
      "end_seconds": 12.88,
      "duration_seconds": 4.48,
      "text": "Of course, leave it there. How can I help?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 14.96,
      "end_seconds": 20.68,
      "duration_seconds": 5.72,
      "text": "I'm here because of red, cracked skin on my hands."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 22.21,
      "end_seconds": 23.41,
      "duration_seconds": 1.2,
      "text": "Since when exactly?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 24.76,
      "end_seconds": 33.68,
      "duration_seconds": 8.92,
      "text": "I'm not sure when it began, to be honest. Some weeks ago, but I can't say how many."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 34.25,
      "end_seconds": 40.0,
      "duration_seconds": 5.75,
      "text": "Understood. Okay, give me more detail on it, whatever comes to mind."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 42.96,
      "end_seconds": 52.89,
      "duration_seconds": 9.93,
      "text": "Only moisturiser, and it's not much. Yes, gloves and washing hands. That makes it worse. About a three out of ten."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 53.5,
      "end_seconds": 56.05,
      "duration_seconds": 2.55,
      "text": "Is there anything else with it?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 57.79,
      "end_seconds": 71.47,
      "duration_seconds": 13.68,
      "text": "It usually comes with stinging when I wash up. With stinging when I wash up, a eight out of ten, I suppose. Yes, washing up. That makes it worse."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 76.3,
      "end_seconds": 80.83,
      "duration_seconds": 4.53,
      "text": "Are you taking anything regularly, including from the pharmacy?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 85.77,
      "end_seconds": 98.64,
      "duration_seconds": 12.87,
      "text": "Hydrocortisone cream. I take it when needed. I'm supposed to take it regularly, but I don't always manage. Ah, I'm on moisturiser, several times a day."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 100.17,
      "end_seconds": 102.99,
      "duration_seconds": 2.82,
      "text": "How long have you been on it?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 104.19,
      "end_seconds": 105.65,
      "duration_seconds": 1.46,
      "text": "For two months."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 119.23,
      "end_seconds": 121.21,
      "duration_seconds": 1.98,
      "text": "What about your medical history?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 121.84,
      "end_seconds": 126.25,
      "duration_seconds": 4.41,
      "text": "Mm, I have eczema, for nearly five years."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 126.9,
      "end_seconds": 138.66,
      "duration_seconds": 11.76,
      "text": "Right, right. Yes, eczema is known to us, good to have that clear. Tell me about your routine, work, habits, that sort of thing."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 140.45,
      "end_seconds": 149.12,
      "duration_seconds": 8.67,
      "text": "Lots of rice, lentils and some fruit. I do a yoga class on Thursdays. My partner and our baby."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 150.66,
      "end_seconds": 154.54,
      "duration_seconds": 3.88,
      "text": "Are there any allergies I should be aware of?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 155.28,
      "end_seconds": 158.87,
      "duration_seconds": 3.59,
      "text": "I'm allergic to trimethoprim, I get itching."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 173.93,
      "end_seconds": 176.91,
      "duration_seconds": 2.98,
      "text": "Any nail changes or fever at all?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 177.9,
      "end_seconds": 181.48,
      "duration_seconds": 3.58,
      "text": "Erm, no, none that I've noticed."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 183.47,
      "end_seconds": 188.32,
      "duration_seconds": 4.85,
      "text": "Did you get new soap or cream or rash elsewhere?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 190.42,
      "end_seconds": 195.58,
      "duration_seconds": 5.16,
      "text": "I haven't had new soap or cream or rash elsewhere, no."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 197.14,
      "end_seconds": 199.46,
      "duration_seconds": 2.32,
      "text": "Any trouble with the waterworks?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 199.98,
      "end_seconds": 203.0,
      "duration_seconds": 3.02,
      "text": "No, um, that's all fine."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 203.79,
      "end_seconds": 207.46,
      "duration_seconds": 3.67,
      "text": "Any pins and needles or loss of strength anywhere?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 209.29,
      "end_seconds": 210.73,
      "duration_seconds": 1.44,
      "text": "Nothing odd there."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 211.53,
      "end_seconds": 214.79,
      "duration_seconds": 3.26,
      "text": "Time for your numbers, if that's okay."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 227.19,
      "end_seconds": 229.75,
      "duration_seconds": 2.56,
      "text": "Keep your arm relaxed for me..."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 250.43,
      "end_seconds": 258.54,
      "duration_seconds": 8.11,
      "text": "Okay: heart rate 85, blood pressure 124 over 72, temp 36.9 degrees, oxygen saturation is 98 percent."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 259.9,
      "end_seconds": 261.43,
      "duration_seconds": 1.53,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 263.25,
      "end_seconds": 266.24,
      "duration_seconds": 2.99,
      "text": "So, I'll interpret them after the examination."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 268.28,
      "end_seconds": 270.56,
      "duration_seconds": 2.28,
      "text": "Shall I start the examination?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 272.04,
      "end_seconds": 273.27,
      "duration_seconds": 1.23,
      "text": "Does that hurt?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 283.21,
      "end_seconds": 290.99,
      "duration_seconds": 7.78,
      "text": "The skin on both hands is red, dry and cracked in the finger creases, with no weeping."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 294.96,
      "end_seconds": 296.53,
      "duration_seconds": 1.57,
      "text": "That's the examination finished."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 315.49,
      "end_seconds": 335.5,
      "duration_seconds": 20.01,
      "text": "From what you've told me and what I found, it fits best with irritant hand dermatitis. Another possibility is allergic contact dermatitis. Stop me if I've got anything wrong. You've had red, cracked skin on your hands, and no rash elsewhere or new soap or cream."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 341.01,
      "end_seconds": 343.46,
      "duration_seconds": 2.45,
      "text": "Yes, um, that's right."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 347.5,
      "end_seconds": 351.99,
      "duration_seconds": 4.49,
      "text": "I think a patch test makes sense here, for dermatitis."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 353.71,
      "end_seconds": 356.93,
      "duration_seconds": 3.22,
      "text": "I can book that for Tuesday at 2 pm."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 358.8,
      "end_seconds": 367.63,
      "duration_seconds": 8.83,
      "text": "Use gloves for washing up and moisturise straight after you dry your hands. Come back if it hasn't settled in two weeks."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 369.36,
      "end_seconds": 371.15,
      "duration_seconds": 1.79,
      "text": "I can manage that."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 373.23,
      "end_seconds": 377.54,
      "duration_seconds": 4.31,
      "text": "That's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 378.65,
      "end_seconds": 380.82,
      "duration_seconds": 2.17,
      "text": "Thank you, doctor, goodbye."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 381.86,
      "end_seconds": 383.88,
      "duration_seconds": 2.02,
      "text": "Right, goodbye for now."
    }
  ]
}