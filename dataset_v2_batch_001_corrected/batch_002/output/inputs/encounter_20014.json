{
  "schema_version": "1.0",
  "encounter_id": "20014",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.59,
      "end_seconds": 5.81,
      "duration_seconds": 5.22,
      "text": "Doctor, hi, where would you like me to put my coat?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.24,
      "end_seconds": 11.91,
      "duration_seconds": 4.67,
      "text": "Yes, come in and sit down. What brings you here today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 13.97,
      "end_seconds": 20.59,
      "duration_seconds": 6.62,
      "text": "Hmm you know so the thing is I've got a chesty cough."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 22.07,
      "end_seconds": 24.4,
      "duration_seconds": 2.33,
      "text": "let's start with the basic checks"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 37.18,
      "end_seconds": 39.66,
      "duration_seconds": 2.48,
      "text": "sit still for a a moment.."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 54.58,
      "end_seconds": 64.1,
      "duration_seconds": 9.52,
      "text": "Okay: BP is 127 over 72, heart rate 85, temp 37.6 degrees. And saturation 90 percent, respiratory rate 20."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 82.75,
      "end_seconds": 84.01,
      "duration_seconds": 1.26,
      "text": "since when exactly?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 86.04,
      "end_seconds": 88.47,
      "duration_seconds": 2.43,
      "text": "I've had it since Friday"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 90.23,
      "end_seconds": 99.45,
      "duration_seconds": 9.22,
      "text": "tell me a bit more about it: how bad it gets, how often, and whether anything makes it better or worse"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 100.48,
      "end_seconds": 121.13,
      "duration_seconds": 20.65,
      "text": "pretty severe, if I'm being honest i get some relief from warm drinks i'd say on and off it's worse with cold air my family kept telling me to get it it checked i kept putting it off, which I know isn't sensible"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 123.1,
      "end_seconds": 125.41,
      "duration_seconds": 2.31,
      "text": "Nothing like coughing up blood?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 125.97,
      "end_seconds": 129.5,
      "duration_seconds": 3.53,
      "text": "I haven't noticed any coughing up blood."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 130.64,
      "end_seconds": 134.18,
      "duration_seconds": 3.54,
      "text": "So So any sharp chest pain or ankle swelling?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 135.55,
      "end_seconds": 137.57,
      "duration_seconds": 2.02,
      "text": "None of those, no."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 139.51,
      "end_seconds": 141.83,
      "duration_seconds": 2.32,
      "text": "has your skin been okay?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 142.56,
      "end_seconds": 145.02,
      "duration_seconds": 2.46,
      "text": "nothing on the skin, no"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 146.17,
      "end_seconds": 149.49,
      "duration_seconds": 3.32,
      "text": "okay, do you follow any particular diet?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 151.25,
      "end_seconds": 154.77,
      "duration_seconds": 3.52,
      "text": "I'm vegetarian and have been for years."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 159.75,
      "end_seconds": 161.06,
      "duration_seconds": 1.31,
      "text": "Are you active?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 162.19,
      "end_seconds": 165.18,
      "duration_seconds": 2.99,
      "text": "I walk the dog every morning"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 175.03,
      "end_seconds": 180.42,
      "duration_seconds": 5.39,
      "text": "okay, what conditions have you been treated for in the the past?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 181.71,
      "end_seconds": 183.09,
      "duration_seconds": 1.38,
      "text": "I've got COPD"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 183.63,
      "end_seconds": 185.55,
      "duration_seconds": 1.92,
      "text": "Is there anything more?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 186.93,
      "end_seconds": 193.66,
      "duration_seconds": 6.73,
      "text": "Yes, high blood pressure. I've been reading about it online and it worried me."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 198.1,
      "end_seconds": 201.66,
      "duration_seconds": 3.56,
      "text": "Let me ask about allergies, anything at all?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 203.64,
      "end_seconds": 205.13,
      "duration_seconds": 1.49,
      "text": "no known allergies"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 223.35,
      "end_seconds": 228.37,
      "duration_seconds": 5.02,
      "text": "Are you taking anything regularly, including from the the pharmacy?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 232.77,
      "end_seconds": 239.93,
      "duration_seconds": 7.16,
      "text": "Valsartan. I take it 80 milligrams, once a day for my blood pressure."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 241.68,
      "end_seconds": 245.68,
      "duration_seconds": 4.0,
      "text": "I'd like to check you over now, if that's alright"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 247.15,
      "end_seconds": 248.74,
      "duration_seconds": 1.59,
      "text": "let me feel here"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 259.41,
      "end_seconds": 264.38,
      "duration_seconds": 4.97,
      "text": "there are scattered wheezes on both sides and and no crackles"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 267.18,
      "end_seconds": 277.56,
      "duration_seconds": 10.38,
      "text": "so, please sit back down. Right, here's what I'm thinking. It fits best with an infective exacerbation of chronic lung disease"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 278.57,
      "end_seconds": 280.26,
      "duration_seconds": 1.69,
      "text": "is this permanent?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 280.85,
      "end_seconds": 291.03,
      "duration_seconds": 10.18,
      "text": "it's reasonable to be concerned but right now an infective exacerbation of chronic lung disease is my leading thought not anything worse"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 308.58,
      "end_seconds": 321.71,
      "duration_seconds": 13.13,
      "text": "A chest X-ray is what I'd like next for productive cough. Let's use prednisolone 30 milligrams once a day for five days. That should help with flare of lung disease."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 323.38,
      "end_seconds": 326.34,
      "duration_seconds": 2.96,
      "text": "alright, I'll pick it up today"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 328.23,
      "end_seconds": 333.55,
      "duration_seconds": 5.32,
      "text": "keep using your inhaler as before and drink plenty of fluids"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 334.07,
      "end_seconds": 350.7,
      "duration_seconds": 16.63,
      "text": "Yes carry on. I'm not ordering a sputum sample today. If things carry on in two weeks we'll consider it. I'd like you back if it hasn't settled in a week. That's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 352.56,
      "end_seconds": 354.77,
      "duration_seconds": 2.21,
      "text": "Alright thanks take care."
    }
  ]
}