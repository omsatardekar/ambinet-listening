{
  "schema_version": "1.0",
  "encounter_id": "20226",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 1.2,
      "end_seconds": 5.7,
      "duration_seconds": 4.5,
      "text": "Ready for you, doctor. I'll stay in case you need anything."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.23,
      "end_seconds": 11.18,
      "duration_seconds": 3.95,
      "text": "Alright, thank you. Right, hello, what's the problem?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 11.73,
      "end_seconds": 18.69,
      "duration_seconds": 6.96,
      "text": "Mainly I've been passing out for a couple of minutes. That's why I came."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 20.69,
      "end_seconds": 23.97,
      "duration_seconds": 3.28,
      "text": "Has this been going on for long?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 25.04,
      "end_seconds": 36.48,
      "duration_seconds": 11.44,
      "text": "Honestly I can't say exactly when it started. It might have been last month or the month before, I really can't pin it down."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 37.96,
      "end_seconds": 41.66,
      "duration_seconds": 3.7,
      "text": "Is it a lot or only a little?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 43.07,
      "end_seconds": 51.97,
      "duration_seconds": 8.9,
      "text": "A six out of ten, I suppose. And a bitten tongue as well, since this morning."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 53.5,
      "end_seconds": 56.47,
      "duration_seconds": 2.97,
      "text": "Is it bearing on you a lot?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 58.11,
      "end_seconds": 66.06,
      "duration_seconds": 7.95,
      "text": "It feels mild to me. There was a headache afterwards, yes, but that went away."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 67.61,
      "end_seconds": 74.39,
      "duration_seconds": 6.78,
      "text": "Okay, so the vitals from earlier. Heart rate 69, respiratory rate 16, pressure 124 over 80."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 76.34,
      "end_seconds": 77.86,
      "duration_seconds": 1.52,
      "text": "Good, thank you."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 79.43,
      "end_seconds": 81.7,
      "duration_seconds": 2.27,
      "text": "Shall I start the examination?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 82.9,
      "end_seconds": 84.36,
      "duration_seconds": 1.46,
      "text": "Nearly finished here."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 102.83,
      "end_seconds": 107.95,
      "duration_seconds": 5.12,
      "text": "The neurological examination is normal, with steady walking and equal power."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 113.64,
      "end_seconds": 118.97,
      "duration_seconds": 5.33,
      "text": "Okay, that's enough for me. And what about fever, chest pain or weakness?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 120.61,
      "end_seconds": 123.59,
      "duration_seconds": 2.98,
      "text": "No, none of those at all."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 125.07,
      "end_seconds": 126.32,
      "duration_seconds": 1.25,
      "text": "Any head injury?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 127.46,
      "end_seconds": 129.46,
      "duration_seconds": 2.0,
      "text": "No. No head injury."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 130.09,
      "end_seconds": 132.43,
      "duration_seconds": 2.34,
      "text": "Has your skin been okay?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 134.27,
      "end_seconds": 135.21,
      "duration_seconds": 0.94,
      "text": "Skin's normal."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 136.76,
      "end_seconds": 141.04,
      "duration_seconds": 4.28,
      "text": "So, how about your heart, any problems like that?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 142.58,
      "end_seconds": 144.54,
      "duration_seconds": 1.96,
      "text": "No, that's been fine."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 158.39,
      "end_seconds": 163.31,
      "duration_seconds": 4.92,
      "text": "So, tell me about any past illnesses or ongoing conditions."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 164.3,
      "end_seconds": 168.74,
      "duration_seconds": 4.44,
      "text": "I've got high blood pressure. Yes, an enlarged prostate."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 170.23,
      "end_seconds": 173.74,
      "duration_seconds": 3.51,
      "text": "Do you take any prescribed or over-the-counter medicines?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 175.55,
      "end_seconds": 185.42,
      "duration_seconds": 9.87,
      "text": "I take telmisartan, 40 milligrams, once a day. I'm on tamsulosin, 0.4 milligrams, at night for the prostate."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 198.92,
      "end_seconds": 201.76,
      "duration_seconds": 2.84,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 203.36,
      "end_seconds": 206.29,
      "duration_seconds": 2.93,
      "text": "Nothing, I haven't had any operations."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 207.53,
      "end_seconds": 208.72,
      "duration_seconds": 1.19,
      "text": "Do you smoke?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 210.42,
      "end_seconds": 214.46,
      "duration_seconds": 4.04,
      "text": "No, I've never smoked in my life."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 215.36,
      "end_seconds": 217.25,
      "duration_seconds": 1.89,
      "text": "And alcohol, how much?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 219.19,
      "end_seconds": 224.13,
      "duration_seconds": 4.94,
      "text": "I used to drink heavily but I stopped four years ago."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 225.18,
      "end_seconds": 228.07,
      "duration_seconds": 2.89,
      "text": "Do you work outside the home?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 229.85,
      "end_seconds": 234.2,
      "duration_seconds": 4.35,
      "text": "I'm a hairdresser, on my feet all day."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 234.98,
      "end_seconds": 237.4,
      "duration_seconds": 2.42,
      "text": "Tell me about your eating."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 239.07,
      "end_seconds": 245.08,
      "duration_seconds": 6.01,
      "text": "I drink a lot of tea and snack through the day."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 246.74,
      "end_seconds": 248.83,
      "duration_seconds": 2.09,
      "text": "Do you live by yourself?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 250.57,
      "end_seconds": 255.08,
      "duration_seconds": 4.51,
      "text": "No, I share a house with my brother."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 256.3,
      "end_seconds": 261.11,
      "duration_seconds": 4.81,
      "text": "Any allergies to tablets, food or anything in the environment?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 262.31,
      "end_seconds": 264.44,
      "duration_seconds": 2.13,
      "text": "No allergies at all."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 273.78,
      "end_seconds": 285.13,
      "duration_seconds": 11.35,
      "text": "Let me tell you where I've got to. The most likely explanation is a possible first seizure. A faint with some jerking is also on my list."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 285.84,
      "end_seconds": 288.12,
      "duration_seconds": 2.28,
      "text": "Is it dangerous, doctor?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 289.51,
      "end_seconds": 313.13,
      "duration_seconds": 23.62,
      "text": "Nothing I've seen today points to an emergency. It looks like a possible first seizure, but I'd like to confirm. We should do an EEG for possible seizure. No driving until you have been seen in the clinic, and avoid swimming or climbing alone. The epilepsy clinic would be the right next step, I'll refer you."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 313.77,
      "end_seconds": 318.78,
      "duration_seconds": 5.01,
      "text": "Could I get a brain scan done? A friend had it."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 320.8,
      "end_seconds": 341.33,
      "duration_seconds": 20.53,
      "text": "I don't think that's needed at this stage, the history doesn't call for it. The thing that would worry me is if you have another episode or one lasts more than five minutes. If that happens, go to emergency. Does all of that make sense?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 343.01,
      "end_seconds": 346.06,
      "duration_seconds": 3.05,
      "text": "Good, thanks, I'll see you then."
    }
  ]
}