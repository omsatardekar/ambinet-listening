{
  "schema_version": "1.0",
  "encounter_id": "20312",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.26,
      "end_seconds": 2.84,
      "duration_seconds": 1.58,
      "text": "Good afternoon, doctor."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 3.94,
      "end_seconds": 8.36,
      "duration_seconds": 4.42,
      "text": "No problem at all, come in. What's troubling you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 9.52,
      "end_seconds": 15.26,
      "duration_seconds": 5.74,
      "text": "Um, so... a cut on my finger. That's why I came."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 16.94,
      "end_seconds": 20.82,
      "duration_seconds": 3.88,
      "text": "Do you take any prescribed or over-the-counter medicines?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 22.48,
      "end_seconds": 24.75,
      "duration_seconds": 2.27,
      "text": "It's furosemide, every morning."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 26.76,
      "end_seconds": 28.8,
      "duration_seconds": 2.04,
      "text": "And what strength is that?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 30.57,
      "end_seconds": 61.2,
      "duration_seconds": 30.63,
      "text": "It's 40 milligrams. I'm on febuxostat, 80 milligrams, once a day for the gout. Bisoprolol. I take it 2.5 milligrams, once a day. I'd rather not end up on lots of tablets if I can avoid it. I did try to ignore it for a while. I had apixaban at one point, but I'm off it now."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 64.38,
      "end_seconds": 66.34,
      "duration_seconds": 1.96,
      "text": "When did this begin?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 67.97,
      "end_seconds": 70.83,
      "duration_seconds": 2.86,
      "text": "I've had it for ten days."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 71.87,
      "end_seconds": 74.22,
      "duration_seconds": 2.35,
      "text": "Is anything making it worse?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 74.93,
      "end_seconds": 91.35,
      "duration_seconds": 16.42,
      "text": "Okay, so yes, gripping. That makes it worse. There's pain in the finger as well. About pain in the finger, I'd say a few times a day. I had bleeding before. That's settled now, though."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 92.56,
      "end_seconds": 98.08,
      "duration_seconds": 5.52,
      "text": "A few quick ones: redness spreading, weakness of the hand, pus or bite?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 98.8,
      "end_seconds": 105.2,
      "duration_seconds": 6.4,
      "text": "I haven't had redness spreading, weakness of the hand, pus or bite, no."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 106.97,
      "end_seconds": 110.45,
      "duration_seconds": 3.48,
      "text": "Alright, is your urine normal, no changes?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 111.15,
      "end_seconds": 113.51,
      "duration_seconds": 2.36,
      "text": "No, that's all fine."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 114.95,
      "end_seconds": 117.37,
      "duration_seconds": 2.42,
      "text": "Is your chest okay generally?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 118.64,
      "end_seconds": 120.22,
      "duration_seconds": 1.58,
      "text": "No, nothing there."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 122.51,
      "end_seconds": 126.42,
      "duration_seconds": 3.91,
      "text": "What does a normal day of food look like?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 127.5,
      "end_seconds": 131.25,
      "duration_seconds": 3.75,
      "text": "Lots of rice, lentils and some fruit."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 132.8,
      "end_seconds": 135.24,
      "duration_seconds": 2.44,
      "text": "Do you get out much?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 135.78,
      "end_seconds": 140.29,
      "duration_seconds": 4.51,
      "text": "Not much, I mostly stay in these days."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 142.35,
      "end_seconds": 145.04,
      "duration_seconds": 2.69,
      "text": "So, is there someone at home?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 150.74,
      "end_seconds": 154.58,
      "duration_seconds": 3.84,
      "text": "My husband and I live above the shop."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 164.29,
      "end_seconds": 167.27,
      "duration_seconds": 2.98,
      "text": "Right, do you have any chronic illnesses?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 168.73,
      "end_seconds": 187.25,
      "duration_seconds": 18.52,
      "text": "I've had heart failure for nearly five years now. I wasn't sure whether to come in at all, to be honest. I've had gout, yes. I have an irregular heartbeat, for about a year."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 187.76,
      "end_seconds": 190.46,
      "duration_seconds": 2.7,
      "text": "Before we go further, any allergies?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 191.3,
      "end_seconds": 194.63,
      "duration_seconds": 3.33,
      "text": "Yes, grass pollen. I get itchy eyes."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 196.45,
      "end_seconds": 199.59,
      "duration_seconds": 3.14,
      "text": "Does your family have any medical conditions?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 200.75,
      "end_seconds": 203.93,
      "duration_seconds": 3.18,
      "text": "My daughter has type 1 diabetes."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 204.99,
      "end_seconds": 209.12,
      "duration_seconds": 4.13,
      "text": "Okay, what operations have you had, if any?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 210.09,
      "end_seconds": 216.85,
      "duration_seconds": 6.76,
      "text": "I had my appendix taken out when I was in my twenties."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 217.86,
      "end_seconds": 220.91,
      "duration_seconds": 3.05,
      "text": "Time for your numbers, if that's okay."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 232.82,
      "end_seconds": 235.7,
      "duration_seconds": 2.88,
      "text": "Bear with me while this finishes..."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 252.77,
      "end_seconds": 261.2,
      "duration_seconds": 8.43,
      "text": "Okay: respiratory rate 18, pressure 111 over 80, SpO2 99 percent on room air, heart rate 74, temperature 36.5."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 261.71,
      "end_seconds": 263.37,
      "duration_seconds": 1.66,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 265.25,
      "end_seconds": 268.83,
      "duration_seconds": 3.58,
      "text": "Okay, that's fine, I'll explain it soon."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 270.55,
      "end_seconds": 274.21,
      "duration_seconds": 3.66,
      "text": "Alright, over here please and I'll take a look."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 283.72,
      "end_seconds": 284.82,
      "duration_seconds": 1.1,
      "text": "That's alright."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 286.61,
      "end_seconds": 288.77,
      "duration_seconds": 2.16,
      "text": "I'm just checking this side."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 302.43,
      "end_seconds": 310.05,
      "duration_seconds": 7.62,
      "text": "There is a two-centimetre clean cut over the first knuckle, the finger moves fully and the fingertip feels normal."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 312.17,
      "end_seconds": 328.83,
      "duration_seconds": 16.66,
      "text": "Thank you, you can get dressed. Having listened and examined, the most likely explanation is a clean finger laceration without nerve or tendon injury. That's my thinking for now, and it may change as we learn more."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 330.86,
      "end_seconds": 334.2,
      "duration_seconds": 3.34,
      "text": "I'm scared it's something bad. Is it?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 335.17,
      "end_seconds": 346.93,
      "duration_seconds": 11.76,
      "text": "It's reasonable to be concerned, but right now a clean finger laceration without nerve or tendon injury is my leading thought, not anything worse."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 363.58,
      "end_seconds": 368.5,
      "duration_seconds": 4.92,
      "text": "I'm going to order an X-ray of the finger, for laceration."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 369.36,
      "end_seconds": 371.21,
      "duration_seconds": 1.85,
      "text": "Is that done today?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 372.96,
      "end_seconds": 382.27,
      "duration_seconds": 9.31,
      "text": "I'm going to put you on tetanus booster, 0.5 ml, once, for one day. That should help with tetanus prevention."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 384.18,
      "end_seconds": 387.21,
      "duration_seconds": 3.03,
      "text": "Should I take that with food?"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 387.87,
      "end_seconds": 397.63,
      "duration_seconds": 9.76,
      "text": "Keep the dressing dry for two days and watch for redness or pus. Please come and see me in five days."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 398.35,
      "end_seconds": 401.74,
      "duration_seconds": 3.39,
      "text": "I'll book it on my way out."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 403.17,
      "end_seconds": 405.6,
      "duration_seconds": 2.43,
      "text": "That's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 406.71,
      "end_seconds": 411.48,
      "duration_seconds": 4.77,
      "text": "Right, you know, I'll do that. Thank you, doctor."
    }
  ]
}