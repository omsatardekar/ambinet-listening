{
  "schema_version": "1.0",
  "encounter_id": "20017",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.15,
      "end_seconds": 4.74,
      "duration_seconds": 3.59,
      "text": "Hi there, the chair's free, sit down."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 6.31,
      "end_seconds": 9.02,
      "duration_seconds": 2.71,
      "text": "Afternoon, is this seat fine?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 9.68,
      "end_seconds": 12.94,
      "duration_seconds": 3.26,
      "text": "Was it a long journey this morning?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 14.44,
      "end_seconds": 18.18,
      "duration_seconds": 3.74,
      "text": "Not too bad, the roads were quiet."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 19.29,
      "end_seconds": 22.13,
      "duration_seconds": 2.84,
      "text": "Tell me what's brought you in."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 22.86,
      "end_seconds": 29.62,
      "duration_seconds": 6.76,
      "text": "So the thing is, I've got burning pain in the upper tummy."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 30.55,
      "end_seconds": 33.78,
      "duration_seconds": 3.23,
      "text": "How long has it been like this?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 34.69,
      "end_seconds": 37.29,
      "duration_seconds": 2.6,
      "text": "It's been ten days now."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 38.32,
      "end_seconds": 46.83,
      "duration_seconds": 8.51,
      "text": "Tell me a bit more about it: how bad it gets, how often, and whether anything makes it better or worse."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 48.76,
      "end_seconds": 61.39,
      "duration_seconds": 12.63,
      "text": "Only antacids, and it's not much. It happens a few times a day. And I've been feeling full quickly as well, for two weeks."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 62.19,
      "end_seconds": 65.4,
      "duration_seconds": 3.21,
      "text": "Any vomiting blood, jaundice or difficulty swallowing?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 66.82,
      "end_seconds": 71.84,
      "duration_seconds": 5.02,
      "text": "No vomiting blood, jaundice or difficulty swallowing, none of it."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 73.62,
      "end_seconds": 75.04,
      "duration_seconds": 1.42,
      "text": "Any chest pain?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 76.8,
      "end_seconds": 80.67,
      "duration_seconds": 3.87,
      "text": "No, I haven't had any chest pain."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 81.75,
      "end_seconds": 83.94,
      "duration_seconds": 2.19,
      "text": "Anything unusual with passing urine?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 84.92,
      "end_seconds": 87.13,
      "duration_seconds": 2.21,
      "text": "No, that's all fine."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 88.74,
      "end_seconds": 92.22,
      "duration_seconds": 3.48,
      "text": "Any health conditions I should have on record?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 92.73,
      "end_seconds": 97.41,
      "duration_seconds": 4.68,
      "text": "I've had arthritis in my knees for five years now."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 99.05,
      "end_seconds": 103.58,
      "duration_seconds": 4.53,
      "text": "Can you list what you take, tablets, creams or inhalers?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 104.6,
      "end_seconds": 112.03,
      "duration_seconds": 7.43,
      "text": "I'm on diclofenac, 50 milligrams, when needed. Antacid. I take it when needed."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 129.0,
      "end_seconds": 131.41,
      "duration_seconds": 2.41,
      "text": "Have you ever had an operation?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 132.97,
      "end_seconds": 138.87,
      "duration_seconds": 5.9,
      "text": "Just a mole taken off my arm, a few years ago."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 146.08,
      "end_seconds": 148.12,
      "duration_seconds": 2.04,
      "text": "Tell me about your eating."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 148.63,
      "end_seconds": 153.57,
      "duration_seconds": 4.94,
      "text": "I drink a lot of tea and snack through the day."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 154.82,
      "end_seconds": 157.89,
      "duration_seconds": 3.07,
      "text": "Are you on your own at home?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 158.46,
      "end_seconds": 161.39,
      "duration_seconds": 2.93,
      "text": "I live with my elderly mother."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 162.56,
      "end_seconds": 164.98,
      "duration_seconds": 2.42,
      "text": "Do you work outside the home?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 167.02,
      "end_seconds": 171.38,
      "duration_seconds": 4.36,
      "text": "I'm a hairdresser, on my feet all day."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 181.9,
      "end_seconds": 184.99,
      "duration_seconds": 3.09,
      "text": "I'll note down your vital signs first."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 198.36,
      "end_seconds": 200.68,
      "duration_seconds": 2.32,
      "text": "Okay, this won't take long..."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 213.6,
      "end_seconds": 220.89,
      "duration_seconds": 7.29,
      "text": "Okay: oxygen saturation is 99 percent, pulse is 75 beats a minute, BP is 109 over 71."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 222.84,
      "end_seconds": 224.45,
      "duration_seconds": 1.61,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 225.34,
      "end_seconds": 228.42,
      "duration_seconds": 3.08,
      "text": "Right, I'll come back to the numbers."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 230.55,
      "end_seconds": 233.91,
      "duration_seconds": 3.36,
      "text": "Okay, time for me to examine you."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 234.52,
      "end_seconds": 235.93,
      "duration_seconds": 1.41,
      "text": "Fine by me."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 237.58,
      "end_seconds": 240.35,
      "duration_seconds": 2.77,
      "text": "Okay, I'm just checking this side."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 257.17,
      "end_seconds": 262.91,
      "duration_seconds": 5.74,
      "text": "Your tummy is soft with some tenderness in the upper middle part."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 267.02,
      "end_seconds": 280.82,
      "duration_seconds": 13.8,
      "text": "That's the examination finished. Okay, so my impression is this: I don't have a clear answer today: dyspepsia possibly related to anti-inflammatory tablets is possible, and so is reflux."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 285.1,
      "end_seconds": 288.23,
      "duration_seconds": 3.13,
      "text": "I'm scared it's something bad. Is it?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 289.52,
      "end_seconds": 299.27,
      "duration_seconds": 9.75,
      "text": "It's reasonable to be concerned, but right now dyspepsia possibly related to anti-inflammatory tablets is my leading thought, not anything worse."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 306.84,
      "end_seconds": 318.65,
      "duration_seconds": 11.81,
      "text": "Let's get blood tests, for dyspepsia. I'm going to put you on omeprazole, 20 milligrams, once a day, for four weeks. It's for stomach acid."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 319.21,
      "end_seconds": 320.8,
      "duration_seconds": 1.59,
      "text": "Thank you, doctor."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 321.41,
      "end_seconds": 339.95,
      "duration_seconds": 18.54,
      "text": "Please stop taking the anti-inflammatory tablets for now and use paracetamol for the pain. A test for the stomach germ is something we might do if this doesn't improve in a month. Come back after the test result. I think we're done unless you have questions."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 341.86,
      "end_seconds": 345.27,
      "duration_seconds": 3.41,
      "text": "Great, thank you for your help."
    }
  ]
}