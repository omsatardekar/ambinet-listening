{
  "schema_version": "1.0",
  "encounter_id": "20272",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 1.27,
      "end_seconds": 7.6,
      "duration_seconds": 6.33,
      "text": "okay, doctor, we're all set in here i'll give you the numbers when you want them"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 9.41,
      "end_seconds": 12.88,
      "duration_seconds": 3.47,
      "text": "Perfect, thanks. Hello there, so what's the trouble?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 14.69,
      "end_seconds": 19.55,
      "duration_seconds": 4.86,
      "text": "Morning, doctor. I'll stay and fill in anything that's missed."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 21.29,
      "end_seconds": 27.04,
      "duration_seconds": 5.75,
      "text": "Yeah, I wanted to get pain in my right groin looked at."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 28.81,
      "end_seconds": 35.68,
      "duration_seconds": 6.87,
      "text": "okay, can you tell me when it first started? Just so I get the full picture"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 36.36,
      "end_seconds": 39.29,
      "duration_seconds": 2.93,
      "text": "I've had it for six months."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 41.28,
      "end_seconds": 43.34,
      "duration_seconds": 2.06,
      "text": "Is anything making it worse?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 44.8,
      "end_seconds": 48.91,
      "duration_seconds": 4.11,
      "text": "So, yes, stairs. That makes it worse."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 50.8,
      "end_seconds": 53.4,
      "duration_seconds": 2.6,
      "text": "Is it constant or in episodes?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 54.69,
      "end_seconds": 56.89,
      "duration_seconds": 2.2,
      "text": "it's on and off"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 58.57,
      "end_seconds": 61.34,
      "duration_seconds": 2.77,
      "text": "how much trouble does it give you?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 62.74,
      "end_seconds": 68.99,
      "duration_seconds": 6.25,
      "text": "Well, it's... hard to say, it's kind of... I don't know—"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 70.79,
      "end_seconds": 76.31,
      "duration_seconds": 5.52,
      "text": "take your time. Mild, moderate, or severe, if you had to pick?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 77.92,
      "end_seconds": 79.42,
      "duration_seconds": 1.5,
      "text": "Moderate, I'd say."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 79.86,
      "end_seconds": 86.12,
      "duration_seconds": 6.26,
      "text": "I was just going to say that the main thing is—"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 86.22,
      "end_seconds": 93.25,
      "duration_seconds": 7.03,
      "text": "Sorry to cut in, doctor, quick question: shall I bring the trolley in now or later?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 94.41,
      "end_seconds": 97.57,
      "duration_seconds": 3.16,
      "text": "Alright, later, thanks. Please go on."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 98.93,
      "end_seconds": 111.77,
      "duration_seconds": 12.84,
      "text": "uh, as for stiffness in the hip after sitting, I honestly can't say when that began it might have been last month or the month before"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 113.03,
      "end_seconds": 115.87,
      "duration_seconds": 2.84,
      "text": "would you say mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 116.61,
      "end_seconds": 118.08,
      "duration_seconds": 1.47,
      "text": "it's mild, honestly"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 119.96,
      "end_seconds": 126.17,
      "duration_seconds": 6.21,
      "text": "Have you had pain in your right groin before, or is this the first time?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 131.4,
      "end_seconds": 137.75,
      "duration_seconds": 6.35,
      "text": "I had a similar thing a couple of years ago. It went away."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_5",
      "role": "UNKNOWN",
      "start_seconds": 138.29,
      "end_seconds": 141.17,
      "duration_seconds": 2.88,
      "text": "Mm, that's what happened, yes."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 160.15,
      "end_seconds": 163.88,
      "duration_seconds": 3.73,
      "text": "Have you had any swelling of the leg?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 164.71,
      "end_seconds": 167.73,
      "duration_seconds": 3.02,
      "text": "No swelling of the leg, thankfully."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 169.14,
      "end_seconds": 170.45,
      "duration_seconds": 1.31,
      "text": "nothing like fever?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 171.71,
      "end_seconds": 173.27,
      "duration_seconds": 1.56,
      "text": "No fever, thankfully."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 174.39,
      "end_seconds": 179.9,
      "duration_seconds": 5.51,
      "text": "actually, doctor, I did notice fever she doesn't always say"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 181.47,
      "end_seconds": 188.26,
      "duration_seconds": 6.79,
      "text": "no, I don't think I did maybe a little, I'm not sure"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 189.18,
      "end_seconds": 198.51,
      "duration_seconds": 9.33,
      "text": "Alright, I'll note both what you've said and what you've noticed. Any fall, weight loss or back pain at all?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 199.6,
      "end_seconds": 217.38,
      "duration_seconds": 17.78,
      "text": "Sorry, you know, what was I saying, no, no fall, no weight loss, no back pain. I did have a limp at one point, but that went away on its own."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 219.38,
      "end_seconds": 222.49,
      "duration_seconds": 3.11,
      "text": "right, how are your bowels, any trouble?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 224.03,
      "end_seconds": 226.94,
      "duration_seconds": 2.91,
      "text": "Bowels are regular, nothing odd."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 228.42,
      "end_seconds": 232.55,
      "duration_seconds": 4.13,
      "text": "Are you taking anything regularly, including from the pharmacy?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 233.75,
      "end_seconds": 248.85,
      "duration_seconds": 15.1,
      "text": "It's hydrochlorothiazide, 12.5 milligrams, every morning. Diclofenac, 50 milligrams, when needed for the joint pain. Levetiracetam, 500 milligrams, twice a day for the seizures. It's paracetamol, 1 gram, when needed."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 250.85,
      "end_seconds": 255.38,
      "duration_seconds": 4.53,
      "text": "So, what about your parents, brothers or sisters, any conditions?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 256.25,
      "end_seconds": 263.73,
      "duration_seconds": 7.48,
      "text": "sorry, what was I saying, my grandmother had dementia right, my father had bowel cancer"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 264.78,
      "end_seconds": 268.53,
      "duration_seconds": 3.75,
      "text": "Anything in your past medical history I should know?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 269.49,
      "end_seconds": 272.91,
      "duration_seconds": 3.42,
      "text": "High blood pressure, for about a year."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 273.94,
      "end_seconds": 274.64,
      "duration_seconds": 0.7,
      "text": "Yes."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 276.49,
      "end_seconds": 283.25,
      "duration_seconds": 6.76,
      "text": "I've, I've got arthritis in my knees. Uh, I've had epilepsy, yes."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 284.03,
      "end_seconds": 296.9,
      "duration_seconds": 12.87,
      "text": "okay, go on okay, I can see high blood pressure and arthritis in your knees in your file as well what do you do during the day?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 301.19,
      "end_seconds": 304.42,
      "duration_seconds": 3.23,
      "text": "I look after my grandchildren most days."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 305.64,
      "end_seconds": 308.71,
      "duration_seconds": 3.07,
      "text": "Are you on your own at home?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 310.67,
      "end_seconds": 313.8,
      "duration_seconds": 3.13,
      "text": "I live with my elderly mother"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 315.21,
      "end_seconds": 319.13,
      "duration_seconds": 3.92,
      "text": "Let me ask about allergies, anything at all?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 322.86,
      "end_seconds": 325.0,
      "duration_seconds": 2.14,
      "text": "No allergies at all."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 340.22,
      "end_seconds": 341.49,
      "duration_seconds": 1.27,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 343.2,
      "end_seconds": 346.25,
      "duration_seconds": 3.05,
      "text": "nothing, I haven't had any operations"
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 352.15,
      "end_seconds": 363.64,
      "duration_seconds": 11.49,
      "text": "Here are the numbers, doctor. Pulse is 82 beats a minute, respiratory rate 15, blood pressure 118 over 77, oxygen saturation is 97 percent, temperature is 36.8 degrees."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 365.53,
      "end_seconds": 366.48,
      "duration_seconds": 0.95,
      "text": "Okay, noted."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 369.46,
      "end_seconds": 373.08,
      "duration_seconds": 3.62,
      "text": "Could you come over to the the couch, please?"
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 374.91,
      "end_seconds": 378.21,
      "duration_seconds": 3.3,
      "text": "stay as you are for a moment"
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 391.11,
      "end_seconds": 397.0,
      "duration_seconds": 5.89,
      "text": "Rotation of the right hip is painful and limited compared with the left."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 401.81,
      "end_seconds": 426.58,
      "duration_seconds": 24.77,
      "text": "Okay, that's enough for me. Putting it all together, this is probably osteoarthritis of the right hip. A pinched nerve in the back is also on my list. So, to recap quickly. You've had pain in your right groin for six months, moderate, and no swelling of the leg."
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 427.65,
      "end_seconds": 429.67,
      "duration_seconds": 2.02,
      "text": "That's what happened, yes."
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 430.47,
      "end_seconds": 454.72,
      "duration_seconds": 24.25,
      "text": "Blood tests is what I'd like next, for joint pain. That will help us see what's going on underneath and decide the next step. We should do a hip X-ray for hip pain. Keep walking in short regular bursts and and use a stick in the opposite hand. That's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 456.55,
      "end_seconds": 459.52,
      "duration_seconds": 2.97,
      "text": "no, that's all. Thanks a lot"
    }
  ]
}