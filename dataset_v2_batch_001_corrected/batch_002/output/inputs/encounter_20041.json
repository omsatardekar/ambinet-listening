{
  "schema_version": "1.0",
  "encounter_id": "20041",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.72,
      "end_seconds": 2.32,
      "duration_seconds": 1.6,
      "text": "Welcome. Make yourself comfortable."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 4.28,
      "end_seconds": 5.34,
      "duration_seconds": 1.06,
      "text": "hello, doctor"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 7.12,
      "end_seconds": 9.98,
      "duration_seconds": 2.86,
      "text": "Okay, you came on your own today?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 10.48,
      "end_seconds": 13.58,
      "duration_seconds": 3.1,
      "text": "Yes, I managed on my own."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 17.45,
      "end_seconds": 20.64,
      "duration_seconds": 3.19,
      "text": "so what can I do for you?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 22.53,
      "end_seconds": 30.37,
      "duration_seconds": 7.84,
      "text": "So the thing is, I've got irregular periods. I did try to ignore it for a while."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 36.12,
      "end_seconds": 38.9,
      "duration_seconds": 2.78,
      "text": "Right, did it come on recently?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 39.63,
      "end_seconds": 43.97,
      "duration_seconds": 4.34,
      "text": "so, um, it's been six months now"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 44.59,
      "end_seconds": 47.63,
      "duration_seconds": 3.04,
      "text": "would you say mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 48.42,
      "end_seconds": 56.72,
      "duration_seconds": 8.3,
      "text": "Maybe a six out of ten on a bad day. And, And night sweats, too."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 57.22,
      "end_seconds": 57.92,
      "duration_seconds": 0.7,
      "text": "Understood."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 59.99,
      "end_seconds": 76.47,
      "duration_seconds": 16.48,
      "text": "As for mood swings, I honestly can't say when that began. It might have been last month or the month before. With mood swings, it feels mild to me."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 77.8,
      "end_seconds": 80.6,
      "duration_seconds": 2.8,
      "text": "Have you ever had an operation?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 85.86,
      "end_seconds": 92.0,
      "duration_seconds": 6.14,
      "text": "Yes, I had a caesarean for my second baby, nine years ago."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 93.89,
      "end_seconds": 95.25,
      "duration_seconds": 1.36,
      "text": "Do you smoke?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 97.04,
      "end_seconds": 100.25,
      "duration_seconds": 3.21,
      "text": "I gave up cigarettes last spring."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 101.41,
      "end_seconds": 104.08,
      "duration_seconds": 2.67,
      "text": "Do you follow any particular diet?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 105.92,
      "end_seconds": 109.27,
      "duration_seconds": 3.35,
      "text": "I'm vegetarian and have been for years."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 110.15,
      "end_seconds": 112.21,
      "duration_seconds": 2.06,
      "text": "Is there someone at home?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 114.04,
      "end_seconds": 118.27,
      "duration_seconds": 4.23,
      "text": "My husband and I live above the shop."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 120.32,
      "end_seconds": 124.78,
      "duration_seconds": 4.46,
      "text": "Any allergies to tablets, food or anything in the environment?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 125.78,
      "end_seconds": 130.82,
      "duration_seconds": 5.04,
      "text": "Ah, you know, no, I've never reacted to anything."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 132.3,
      "end_seconds": 135.56,
      "duration_seconds": 3.26,
      "text": "What do you take on a normal day?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 136.42,
      "end_seconds": 148.06,
      "duration_seconds": 11.64,
      "text": "Alendronate. I take it 70 milligrams, once a week for my bones. I'd rather know what's going on than keep guessing."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 148.43,
      "end_seconds": 149.38,
      "duration_seconds": 0.95,
      "text": "Right, right."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 164.8,
      "end_seconds": 167.44,
      "duration_seconds": 2.64,
      "text": "Do you have any chronic illnesses?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 168.93,
      "end_seconds": 170.54,
      "duration_seconds": 1.61,
      "text": "Yes, thin bones."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 171.63,
      "end_seconds": 180.77,
      "duration_seconds": 9.14,
      "text": "Right, so thin bones is already on your record. We'll keep that in mind today. Has anyone in your family had anything serious?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 182.83,
      "end_seconds": 184.72,
      "duration_seconds": 1.89,
      "text": "My cousin has psoriasis."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 185.3,
      "end_seconds": 190.85,
      "duration_seconds": 5.55,
      "text": "any heavy bleeding, chest pain, weight loss or bleeding after sex at all?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 191.72,
      "end_seconds": 194.88,
      "duration_seconds": 3.16,
      "text": "No, none of those at all."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 196.54,
      "end_seconds": 198.41,
      "duration_seconds": 1.87,
      "text": "Nothing like breast lumps?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 200.17,
      "end_seconds": 202.34,
      "duration_seconds": 2.17,
      "text": "No breast lumps, thankfully."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 204.24,
      "end_seconds": 206.58,
      "duration_seconds": 2.34,
      "text": "Your breathing, any trouble there?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 207.94,
      "end_seconds": 210.45,
      "duration_seconds": 2.51,
      "text": "no, my breathing's been fine"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 219.39,
      "end_seconds": 222.49,
      "duration_seconds": 3.1,
      "text": "Time for your numbers, if that's okay."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 229.67,
      "end_seconds": 231.76,
      "duration_seconds": 2.09,
      "text": "Nearly done with the readings..."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 250.16,
      "end_seconds": 260.8,
      "duration_seconds": 10.64,
      "text": "Okay: pulse 81, temperature is 36.8 degrees, respiratory rate 14, blood pressure 128 over 73, oxygen saturation is 97 percent."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 263.09,
      "end_seconds": 264.5,
      "duration_seconds": 1.41,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 266.23,
      "end_seconds": 268.59,
      "duration_seconds": 2.36,
      "text": "I'll interpret them after the examination."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 271.34,
      "end_seconds": 276.06,
      "duration_seconds": 4.72,
      "text": "I'll need to examine you for this, it won't take long."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 277.55,
      "end_seconds": 279.44,
      "duration_seconds": 1.89,
      "text": "Let me feel here."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 286.51,
      "end_seconds": 293.22,
      "duration_seconds": 6.71,
      "text": "Blood pressure and pulse are fine and and there are no breast lumps on examination."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 295.57,
      "end_seconds": 314.12,
      "duration_seconds": 18.55,
      "text": "Okay, that's enough for me. Let me tell you where I've got to. I'd lean towards perimenopausal symptoms. I can't rule out anaemia yet. Let me repeat that back to make sure. You've had irregular periods for six months, and no weight loss or breast lumps."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 314.68,
      "end_seconds": 316.46,
      "duration_seconds": 1.78,
      "text": "yes, that's right"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 323.8,
      "end_seconds": 333.95,
      "duration_seconds": 10.15,
      "text": "I want blood tests done, that's for hot flushes. A bone density scan is what I'd like next, for menopause bone health."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 334.9,
      "end_seconds": 336.94,
      "duration_seconds": 2.04,
      "text": "Is that done today?"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 338.7,
      "end_seconds": 350.27,
      "duration_seconds": 11.57,
      "text": "Layers of clothing, a fan by the bed, and cutting down on caffeine and spicy food can help the flushes. Do get help quickly if the symptoms get worse."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 352.0,
      "end_seconds": 353.68,
      "duration_seconds": 1.68,
      "text": "okay, makes sense"
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 357.79,
      "end_seconds": 364.4,
      "duration_seconds": 6.61,
      "text": "See me again after the blood tests. Anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 366.07,
      "end_seconds": 369.12,
      "duration_seconds": 3.05,
      "text": "great, thank you for your help"
    }
  ]
}