{
  "schema_version": "1.0",
  "encounter_id": "20066",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.65,
      "end_seconds": 3.89,
      "duration_seconds": 3.24,
      "text": "Hi doctor, am I too early?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.49,
      "end_seconds": 9.54,
      "duration_seconds": 4.05,
      "text": "That's fine, sit down. Tell me why you came."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 15.21,
      "end_seconds": 18.22,
      "duration_seconds": 3.01,
      "text": "Well, I've been having some bleeding."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 20.18,
      "end_seconds": 24.0,
      "duration_seconds": 3.82,
      "text": "Let me get the readings out of the way."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 30.24,
      "end_seconds": 32.35,
      "duration_seconds": 2.11,
      "text": "Okay, this won't take long..."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 43.31,
      "end_seconds": 52.26,
      "duration_seconds": 8.95,
      "text": "Okay: heart rate 72, BP is 126 over 71, saturation 97 percent, temperature 36.8. When did this begin?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 53.64,
      "end_seconds": 61.19,
      "duration_seconds": 7.55,
      "text": "About... well, about two weeks. I told myself I'd wait and see, and here I am."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 62.68,
      "end_seconds": 66.4,
      "duration_seconds": 3.72,
      "text": "Have you been feeling sick in the mornings?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 67.64,
      "end_seconds": 79.35,
      "duration_seconds": 11.71,
      "text": "Yeah, that too. As for feeling sick in the mornings, mostly mild. Oh, and a missed period. That's been about the same, about a week."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 80.19,
      "end_seconds": 85.6,
      "duration_seconds": 5.41,
      "text": "Any shoulder tip pain, severe one-sided pain or passing tissue at all?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 87.1,
      "end_seconds": 94.87,
      "duration_seconds": 7.77,
      "text": "Okay, so no shoulder tip pain, severe one-sided pain or passing tissue, none of it."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 96.01,
      "end_seconds": 98.66,
      "duration_seconds": 2.65,
      "text": "Any fever or fainting at all?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 99.16,
      "end_seconds": 101.84,
      "duration_seconds": 2.68,
      "text": "Actually, none of those, no."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 102.82,
      "end_seconds": 106.65,
      "duration_seconds": 3.83,
      "text": "Alright, how are your joints, any aches elsewhere?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 107.64,
      "end_seconds": 109.87,
      "duration_seconds": 2.23,
      "text": "I move fine otherwise."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 125.71,
      "end_seconds": 130.47,
      "duration_seconds": 4.76,
      "text": "Any allergies to tablets, food or anything in the environment?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 132.39,
      "end_seconds": 143.74,
      "duration_seconds": 11.35,
      "text": "Hmm, there was some antibiotic, I was told I was allergic. But I couldn't tell you what it was called or what it did."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 145.35,
      "end_seconds": 148.22,
      "duration_seconds": 2.87,
      "text": "Has anyone ever diagnosed you with something?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 149.86,
      "end_seconds": 156.73,
      "duration_seconds": 6.87,
      "text": "I have anxiety. Erm, I've had asthma for about ten years now."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 157.66,
      "end_seconds": 158.85,
      "duration_seconds": 1.19,
      "text": "And besides that?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 159.69,
      "end_seconds": 169.34,
      "duration_seconds": 9.65,
      "text": "So, yes, asthma is known to us, good to have that clear. Do you take any prescribed or over-the-counter medicines?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 170.94,
      "end_seconds": 182.24,
      "duration_seconds": 11.3,
      "text": "It's escitalopram, 10 milligrams, once a day for the anxiety. Though honestly, some days I forget to take it. Foracort inhaler, twice a day."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 184.3,
      "end_seconds": 189.02,
      "duration_seconds": 4.72,
      "text": "Any inherited conditions that you know of in the family?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 189.65,
      "end_seconds": 193.01,
      "duration_seconds": 3.36,
      "text": "Erm, my father has Parkinson's disease."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 201.76,
      "end_seconds": 204.56,
      "duration_seconds": 2.8,
      "text": "So, do you do any exercise?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 206.58,
      "end_seconds": 208.98,
      "duration_seconds": 2.4,
      "text": "I swim twice a week."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 210.0,
      "end_seconds": 214.07,
      "duration_seconds": 4.07,
      "text": "What does a normal day of food look like?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 215.39,
      "end_seconds": 219.07,
      "duration_seconds": 3.68,
      "text": "Lots of rice, lentils and some fruit."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 221.55,
      "end_seconds": 224.46,
      "duration_seconds": 2.91,
      "text": "Okay, time for me to examine you."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 226.22,
      "end_seconds": 227.14,
      "duration_seconds": 0.92,
      "text": "Of course."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 229.13,
      "end_seconds": 230.53,
      "duration_seconds": 1.4,
      "text": "Breathe out slowly."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 241.32,
      "end_seconds": 247.17,
      "duration_seconds": 5.85,
      "text": "Your tummy is soft with mild tenderness low down and your blood pressure is normal."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 248.32,
      "end_seconds": 249.43,
      "duration_seconds": 1.11,
      "text": "Of course."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 251.67,
      "end_seconds": 266.9,
      "duration_seconds": 15.23,
      "text": "You can relax now. So, based on the history and the examination, this is probably bleeding in early pregnancy that needs a scan. I can't rule out a threatened miscarriage yet."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 267.64,
      "end_seconds": 272.19,
      "duration_seconds": 4.55,
      "text": "Let me think, what are the odds it's serious?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 273.84,
      "end_seconds": 284.03,
      "duration_seconds": 10.19,
      "text": "It's reasonable to be concerned, but right now bleeding in early pregnancy that needs a scan is my leading thought, not anything worse."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 292.45,
      "end_seconds": 312.55,
      "duration_seconds": 20.1,
      "text": "I'm sending you for an early pregnancy scan because of bleeding in early pregnancy. Let's get a pregnancy hormone level, for bleeding in early pregnancy. Use pads rather than tampons and avoid intercourse until the scan. I'll also refer you to the early pregnancy unit."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 313.52,
      "end_seconds": 315.09,
      "duration_seconds": 1.57,
      "text": "Alright, thank you."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 315.8,
      "end_seconds": 326.59,
      "duration_seconds": 10.79,
      "text": "One warning sign to remember: the bleeding becomes heavy or the pain becomes severe or one-sided. In that case don't wait. See me again after the scan."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 328.64,
      "end_seconds": 331.64,
      "duration_seconds": 3.0,
      "text": "Well, okay, I'll arrange it."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 332.39,
      "end_seconds": 335.94,
      "duration_seconds": 3.55,
      "text": "Anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 336.63,
      "end_seconds": 338.6,
      "duration_seconds": 1.97,
      "text": "Thank you, that's helpful."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 340.54,
      "end_seconds": 341.81,
      "duration_seconds": 1.27,
      "text": "See you soon."
    }
  ]
}