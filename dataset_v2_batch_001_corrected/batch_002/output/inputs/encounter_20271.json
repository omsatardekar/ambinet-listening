  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.84,
      "end_seconds": 4.81,
      "duration_seconds": 3.97,
      "text": "morning, doctor lovely to to meet you"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.56,
      "end_seconds": 10.38,
      "duration_seconds": 4.82,
      "text": "Yes, come in and and sit down. What brings you here today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 11.78,
      "end_seconds": 14.49,
      "duration_seconds": 2.71,
      "text": "Doctor, thank you for seeing us."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 16.85,
      "end_seconds": 20.47,
      "duration_seconds": 3.62,
      "text": "Yes, that's no problem at all. Please sit."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 22.43,
      "end_seconds": 26.05,
      "duration_seconds": 3.62,
      "text": "We came because of spots on my face."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 26.99,
      "end_seconds": 28.94,
      "duration_seconds": 1.95,
      "text": "Any regular medication at all?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 30.53,
      "end_seconds": 34.05,
      "duration_seconds": 3.52,
      "text": "no, um, nothing at the moment"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 35.09,
      "end_seconds": 38.35,
      "duration_seconds": 3.26,
      "text": "Okay, how long has this been bothering you?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 39.78,
      "end_seconds": 42.17,
      "duration_seconds": 2.39,
      "text": "It's been two years now."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 43.52,
      "end_seconds": 47.51,
      "duration_seconds": 3.99,
      "text": "rate it for me, mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 49.03,
      "end_seconds": 53.11,
      "duration_seconds": 4.08,
      "text": "I'd give it a six, out of ten."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 54.76,
      "end_seconds": 59.08,
      "duration_seconds": 4.32,
      "text": "Right, what about irregular periods, have you noticed that?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 60.45,
      "end_seconds": 76.93,
      "duration_seconds": 16.48,
      "text": "yes, for nearly five years with irregular periods, it's moderate, honestly as for feeling low, I honestly can't say when that began it might have been last month or the month before"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 78.33,
      "end_seconds": 83.52,
      "duration_seconds": 5.19,
      "text": "Did you get being pregnant, breast discharge, hot flushes or pelvic pain?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 85.12,
      "end_seconds": 88.06,
      "duration_seconds": 2.94,
      "text": "No, none that I've noticed."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 88.52,
      "end_seconds": 92.33,
      "duration_seconds": 3.81,
      "text": "Hm, okay. Has there been any heavy bleeding?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 93.47,
      "end_seconds": 95.67,
      "duration_seconds": 2.2,
      "text": "Definitely no heavy bleeding."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 100.09,
      "end_seconds": 102.44,
      "duration_seconds": 2.35,
      "text": "any breathing difficulties apart from this?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 102.96,
      "end_seconds": 103.87,
      "duration_seconds": 0.91,
      "text": "Breathing's normal."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 104.65,
      "end_seconds": 108.5,
      "duration_seconds": 3.85,
      "text": "anything with your heart, like skipped beats or fainting?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 109.07,
      "end_seconds": 113.21,
      "duration_seconds": 4.14,
      "text": "my heart's been fine, as far as I know"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 115.31,
      "end_seconds": 118.59,
      "duration_seconds": 3.28,
      "text": "let me ask about allergies, anything at all?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 119.26,
      "end_seconds": 128.32,
      "duration_seconds": 9.06,
      "text": "I had a reaction to naproxen when I was younger, stomach pain, and I've avoided it since."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 133.78,
      "end_seconds": 136.68,
      "duration_seconds": 2.9,
      "text": "Have you ever had an operation?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 138.23,
      "end_seconds": 143.69,
      "duration_seconds": 5.46,
      "text": "yes, I had keyhole surgery on my gallbladder, two years back"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 156.54,
      "end_seconds": 159.7,
      "duration_seconds": 3.16,
      "text": "Does your family have any medical conditions?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 161.35,
      "end_seconds": 164.7,
      "duration_seconds": 3.35,
      "text": "My mother has an underactive thyroid."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 166.22,
      "end_seconds": 169.35,
      "duration_seconds": 3.13,
      "text": "Are you in work at the moment?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 171.19,
      "end_seconds": 175.48,
      "duration_seconds": 4.29,
      "text": "Yes, I work in a bakery, early starts."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 176.58,
      "end_seconds": 178.77,
      "duration_seconds": 2.19,
      "text": "Do you do any exercise?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 179.89,
      "end_seconds": 182.34,
      "duration_seconds": 2.45,
      "text": "I swim twice a week."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 189.62,
      "end_seconds": 193.63,
      "duration_seconds": 4.01,
      "text": "Do you have any medical conditions I should know about?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 195.71,
      "end_seconds": 197.62,
      "duration_seconds": 1.91,
      "text": "No, nothing at all."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 206.9,
      "end_seconds": 209.09,
      "duration_seconds": 2.19,
      "text": "I'll do your observations first."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 222.39,
      "end_seconds": 224.39,
      "duration_seconds": 2.0,
      "text": "Sit still for a moment..."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 234.32,
      "end_seconds": 241.35,
      "duration_seconds": 7.03,
      "text": "okay: BP is 122 over 79, heart rate 68, temperature is 36.6 degrees"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 243.48,
      "end_seconds": 246.64,
      "duration_seconds": 3.16,
      "text": "Let's move on to the the examination."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 247.68,
      "end_seconds": 250.6,
      "duration_seconds": 2.92,
      "text": "I'll listen to your chest now."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 265.65,
      "end_seconds": 274.4,
      "duration_seconds": 8.75,
      "text": "there is some acne on the face and extra hair on the chin, and your blood pressure is fine"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 277.05,
      "end_seconds": 297.35,
      "duration_seconds": 20.3,
      "text": "that's all I needed to check right, here's what I'm thinking my working impression is a pattern that fits polycystic ovary syndrome that's my thinking for now, and it may change as we learn more we shouldn't forget raised prolactin i'm sending you for a thyroid test because of weight gain"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 297.91,
      "end_seconds": 299.76,
      "duration_seconds": 1.85,
      "text": "That That makes sense."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 301.28,
      "end_seconds": 332.35,
      "duration_seconds": 31.07,
      "text": "What I'm giving you is metformin, 500 milligrams, once a day with food, for three months. You take it by mouth. That's for cycle regulation and weight. Regular exercise and a small weight loss can make cycles more regular. If you get very heavy bleeding or severe pelvic pain, that's the point to come in urgently. Let's plan a check after the scan."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 333.47,
      "end_seconds": 335.42,
      "duration_seconds": 1.95,
      "text": "I can manage that."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 336.62,
      "end_seconds": 339.93,
      "duration_seconds": 3.31,
      "text": "Anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 340.94,
      "end_seconds": 343.11,
      "duration_seconds": 2.17,
      "text": "thank you, doctor, goodbye"
    }
  ]
}