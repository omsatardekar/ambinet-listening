{
  "schema_version": "1.0",
  "encounter_id": "20454",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 0.85,
      "end_seconds": 7.48,
      "duration_seconds": 6.63,
      "text": "All set here, doctor. Chart's updated, and I'll read the readings out when you're ready."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 9.39,
      "end_seconds": 13.75,
      "duration_seconds": 4.36,
      "text": "Thank you. Good morning, tell me what's been going on."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 15.53,
      "end_seconds": 20.67,
      "duration_seconds": 5.14,
      "text": "Hello, doctor, I came in with them, if that's okay."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 22.61,
      "end_seconds": 25.99,
      "duration_seconds": 3.38,
      "text": "Good, that'll be useful. Pull up a chair."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 26.65,
      "end_seconds": 37.6,
      "duration_seconds": 10.95,
      "text": "Um, um, it's been passing out for a couple of minutes, doctor. She didn't want to come, but I insisted."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 38.65,
      "end_seconds": 42.83,
      "duration_seconds": 4.18,
      "text": "What about your arms jerking, have you noticed that?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 43.5,
      "end_seconds": 45.92,
      "duration_seconds": 2.42,
      "text": "Yeah. One week, I'd say."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_5",
      "role": "UNKNOWN",
      "start_seconds": 47.71,
      "end_seconds": 51.7,
      "duration_seconds": 3.99,
      "text": "Yes, that's right, that's how it was."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 52.29,
      "end_seconds": 53.89,
      "duration_seconds": 1.6,
      "text": "Any weakness or palpitations?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 55.76,
      "end_seconds": 67.78,
      "duration_seconds": 12.02,
      "text": "No, no weakness, no palpitations. I did have a headache afterwards at one point, but that went away on its own."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 70.65,
      "end_seconds": 74.98,
      "duration_seconds": 4.33,
      "text": "So, did you get chest pain, head injury or vomiting?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 75.95,
      "end_seconds": 81.51,
      "duration_seconds": 5.56,
      "text": "No chest pain, head injury or vomiting, none of it."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 82.08,
      "end_seconds": 84.76,
      "duration_seconds": 2.68,
      "text": "How are your bowels, any trouble?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 86.25,
      "end_seconds": 88.9,
      "duration_seconds": 2.65,
      "text": "No, that side's been fine."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 90.33,
      "end_seconds": 94.1,
      "duration_seconds": 3.77,
      "text": "How about your heart, any problems like that?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 95.12,
      "end_seconds": 98.8,
      "duration_seconds": 3.68,
      "text": "I mean, no, nothing with my heart."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 100.61,
      "end_seconds": 103.47,
      "duration_seconds": 2.86,
      "text": "Are you in work at the moment?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 104.29,
      "end_seconds": 108.96,
      "duration_seconds": 4.67,
      "text": "Yes, I work in a bakery, early starts."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 109.63,
      "end_seconds": 113.38,
      "duration_seconds": 3.75,
      "text": "What do you take on a normal day?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 114.29,
      "end_seconds": 119.84,
      "duration_seconds": 5.55,
      "text": "It's amlodipine, 5 milligrams, once a day for my pressure."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 120.72,
      "end_seconds": 131.72,
      "duration_seconds": 11.0,
      "text": "Erm, doctor, I think the last prescription for the amlodipine was 10 milligrams. We changed it at the last visit."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 133.07,
      "end_seconds": 137.54,
      "duration_seconds": 4.47,
      "text": "Right. Do you happen to have the current prescription here?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 138.79,
      "end_seconds": 142.71,
      "duration_seconds": 3.92,
      "text": "I don't think I have it with me."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 144.08,
      "end_seconds": 147.29,
      "duration_seconds": 3.21,
      "text": "Any health conditions I should have on record?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 147.79,
      "end_seconds": 150.13,
      "duration_seconds": 2.34,
      "text": "I've got high blood pressure."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 151.29,
      "end_seconds": 158.57,
      "duration_seconds": 7.28,
      "text": "Alright, high blood pressure, that matches what I have here. Has anyone in your family had anything serious?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 163.27,
      "end_seconds": 169.29,
      "duration_seconds": 6.02,
      "text": "Sorry, um, what was I saying, my sister had breast cancer."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 169.82,
      "end_seconds": 177.13,
      "duration_seconds": 7.31,
      "text": "Has anything ever caused you a reaction? I mean any allergies. I'll explain everything as we go along."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 177.8,
      "end_seconds": 188.5,
      "duration_seconds": 10.7,
      "text": "I think I reacted to some antibiotic once, years ago. I don't remember which one, or what happened exactly."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 193.53,
      "end_seconds": 196.98,
      "duration_seconds": 3.45,
      "text": "Okay, have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 197.64,
      "end_seconds": 200.65,
      "duration_seconds": 3.01,
      "text": "No, I've never been operated on."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 212.94,
      "end_seconds": 224.04,
      "duration_seconds": 11.1,
      "text": "Doctor, I've got the readings for you. Blood pressure 127 over 81, temperature is 36.8 degrees, heart rate 84. Respiratory rate 16, SpO2 98 percent on room air."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 224.56,
      "end_seconds": 225.49,
      "duration_seconds": 0.93,
      "text": "Okay, noted."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 227.76,
      "end_seconds": 230.48,
      "duration_seconds": 2.72,
      "text": "Let's move on to the examination."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 234.97,
      "end_seconds": 236.58,
      "duration_seconds": 1.61,
      "text": "Fine by me."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 237.66,
      "end_seconds": 239.84,
      "duration_seconds": 2.18,
      "text": "Raise your arm for me."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 254.77,
      "end_seconds": 259.46,
      "duration_seconds": 4.69,
      "text": "The neurological examination is normal, with steady walking and equal power."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 261.47,
      "end_seconds": 281.23,
      "duration_seconds": 19.76,
      "text": "That's all I needed to check. Okay, so my impression is this: I don't have a clear answer today: a possible first seizure is possible, and so is a faint with some jerking. A heart rhythm problem is still possible."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 295.56,
      "end_seconds": 304.3,
      "duration_seconds": 8.74,
      "text": "I want an ECG done, that's for loss of consciousness. The result will help us decide whether anything more is needed."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 305.76,
      "end_seconds": 308.46,
      "duration_seconds": 2.7,
      "text": "Where would I go for that?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 309.68,
      "end_seconds": 340.56,
      "duration_seconds": 30.88,
      "text": "I think a brain scan makes sense here, for possible seizure. I'm going to order an EEG, for possible seizure. I'd rather check than guess, and this is the quickest way to know more. No driving until you have been seen in the clinic, and avoid swimming or climbing alone. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 342.6,
      "end_seconds": 355.59,
      "duration_seconds": 12.99,
      "text": "If you have another episode or one lasts more than five minutes, or you feel really unwell, please come to the emergency department. I'd like to see you again after the scan."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 356.14,
      "end_seconds": 358.0,
      "duration_seconds": 1.86,
      "text": "That's fine with me."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 358.54,
      "end_seconds": 360.89,
      "duration_seconds": 2.35,
      "text": "Does all of that make sense?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 364.77,
      "end_seconds": 367.69,
      "duration_seconds": 2.92,
      "text": "So, thank you, that's helpful."
    }
  ]
}