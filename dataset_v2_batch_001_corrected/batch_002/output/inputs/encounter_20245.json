{
  "schema_version": "1.0",
  "encounter_id": "20245",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.76,
      "end_seconds": 3.89,
      "duration_seconds": 3.13,
      "text": "Sorry I'm a little late, doctor."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.75,
      "end_seconds": 11.12,
      "duration_seconds": 5.37,
      "text": "Yes, come in and sit down. What brings you here today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 12.33,
      "end_seconds": 18.87,
      "duration_seconds": 6.54,
      "text": "Um, so... pain in my lower back. That's why I came."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 22.04,
      "end_seconds": 24.39,
      "duration_seconds": 2.35,
      "text": "Let's run through your medicines."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 25.42,
      "end_seconds": 28.87,
      "duration_seconds": 3.45,
      "text": "It's alendronate, 70 milligrams, once a week."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 40.71,
      "end_seconds": 44.39,
      "duration_seconds": 3.68,
      "text": "Can you tell me when it first started?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 46.11,
      "end_seconds": 48.06,
      "duration_seconds": 1.95,
      "text": "About... well, two months."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 48.98,
      "end_seconds": 58.3,
      "duration_seconds": 9.32,
      "text": "Can you describe it a bit more for me? How strong it is, what the pattern is, what helps."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 60.38,
      "end_seconds": 65.62,
      "duration_seconds": 5.24,
      "text": "I'd say moderate. I notice it more with lifting and bending."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 66.52,
      "end_seconds": 69.8,
      "duration_seconds": 3.28,
      "text": "Have you noticed weight loss or chest pain?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 70.93,
      "end_seconds": 74.4,
      "duration_seconds": 3.47,
      "text": "No, none of those at all."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 75.74,
      "end_seconds": 77.44,
      "duration_seconds": 1.7,
      "text": "What about night pain?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 78.89,
      "end_seconds": 81.2,
      "duration_seconds": 2.31,
      "text": "Nope, no night pain."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 82.43,
      "end_seconds": 85.78,
      "duration_seconds": 3.35,
      "text": "Anything with your nerves, like weakness or numbness?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 86.41,
      "end_seconds": 88.61,
      "duration_seconds": 2.2,
      "text": "No, nothing like that."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 90.7,
      "end_seconds": 94.87,
      "duration_seconds": 4.17,
      "text": "Do you react to any medicines or foods? Any allergies?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 99.57,
      "end_seconds": 100.92,
      "duration_seconds": 1.35,
      "text": "No known allergies."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 102.58,
      "end_seconds": 104.6,
      "duration_seconds": 2.02,
      "text": "What about your medical history?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 106.29,
      "end_seconds": 108.25,
      "duration_seconds": 1.96,
      "text": "I've got thin bones."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 122.83,
      "end_seconds": 124.1,
      "duration_seconds": 1.27,
      "text": "Are you active?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 124.94,
      "end_seconds": 128.11,
      "duration_seconds": 3.17,
      "text": "I walk the dog every morning."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 129.94,
      "end_seconds": 132.68,
      "duration_seconds": 2.74,
      "text": "Okay, tell me about your eating."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 134.73,
      "end_seconds": 140.87,
      "duration_seconds": 6.14,
      "text": "I drink a lot of tea and snack through the day."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 159.85,
      "end_seconds": 162.35,
      "duration_seconds": 2.5,
      "text": "Let me quickly check your readings."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 171.7,
      "end_seconds": 173.68,
      "duration_seconds": 1.98,
      "text": "Nearly done with the readings..."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 186.94,
      "end_seconds": 202.64,
      "duration_seconds": 15.7,
      "text": "Okay: temperature is 36.9 degrees, BMI works out to 20.9, weight 59 kilos, height 168 centimetres, SpO2 97 percent on room air, blood pressure 123 over 80, pulse is 79 beats a minute."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 204.22,
      "end_seconds": 206.31,
      "duration_seconds": 2.09,
      "text": "Is that alright, doctor?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 207.69,
      "end_seconds": 210.61,
      "duration_seconds": 2.92,
      "text": "We'll look at it together shortly."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 211.75,
      "end_seconds": 215.63,
      "duration_seconds": 3.88,
      "text": "Now I'm going to do a short physical check."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 216.45,
      "end_seconds": 218.93,
      "duration_seconds": 2.48,
      "text": "Take a deep breath for me."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 232.15,
      "end_seconds": 238.01,
      "duration_seconds": 5.86,
      "text": "There is tenderness over the mid lower spine and no weakness in the legs."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 241.24,
      "end_seconds": 257.15,
      "duration_seconds": 15.91,
      "text": "You can relax now. Putting it all together, the most likely explanation is thin bones with a fragility fracture and back pain. That's my thinking for now, and it may change as we learn more."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 268.55,
      "end_seconds": 272.93,
      "duration_seconds": 4.38,
      "text": "Let's get a bone density scan, for fracture risk."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 273.63,
      "end_seconds": 275.56,
      "duration_seconds": 1.93,
      "text": "Is that done today?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 276.45,
      "end_seconds": 293.18,
      "duration_seconds": 16.73,
      "text": "Take the weekly tablet first thing with a full glass of water and stay upright for half an hour. The falls clinic would be the right next step, I'll refer you. I'd like you back in six weeks."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 293.73,
      "end_seconds": 295.32,
      "duration_seconds": 1.59,
      "text": "Yes, that's manageable."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 297.36,
      "end_seconds": 300.51,
      "duration_seconds": 3.15,
      "text": "Anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 302.01,
      "end_seconds": 303.59,
      "duration_seconds": 1.58,
      "text": "That's clear, thanks."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 304.24,
      "end_seconds": 305.43,
      "duration_seconds": 1.19,
      "text": "Look after yourself."
    }
  ]
}