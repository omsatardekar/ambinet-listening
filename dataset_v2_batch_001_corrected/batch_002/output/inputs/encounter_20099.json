    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 132.47,
      "end_seconds": 139.23,
      "duration_seconds": 6.76,
      "text": "Your mouth is a bit dry and your tummy is soft with mild tenderness all over."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 145.23,
      "end_seconds": 149.17,
      "duration_seconds": 3.94,
      "text": "you can relax now. So, any severe abdominal pain?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 150.14,
      "end_seconds": 152.85,
      "duration_seconds": 2.71,
      "text": "nope, no severe abdominal pain"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 153.91,
      "end_seconds": 158.71,
      "duration_seconds": 4.8,
      "text": "let me check a a few things. Any black stools or dizziness?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 163.8,
      "end_seconds": 166.54,
      "duration_seconds": 2.74,
      "text": "erm no nothing to report there"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 167.78,
      "end_seconds": 171.53,
      "duration_seconds": 3.75,
      "text": "alright, anything with your nerves, like weakness or numbness?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 173.39,
      "end_seconds": 175.38,
      "duration_seconds": 1.99,
      "text": "No, nothing like that."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 176.4,
      "end_seconds": 177.73,
      "duration_seconds": 1.33,
      "text": "What's your work?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 179.11,
      "end_seconds": 182.98,
      "duration_seconds": 3.87,
      "text": "I'm a plumber, lots of bending and kneeling"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 185.04,
      "end_seconds": 187.29,
      "duration_seconds": 2.25,
      "text": "do you live by yourself?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 190.85,
      "end_seconds": 194.95,
      "duration_seconds": 4.1,
      "text": "No, I share a house with my brother"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 200.21,
      "end_seconds": 202.62,
      "duration_seconds": 2.41,
      "text": "do you get out much?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 203.39,
      "end_seconds": 207.63,
      "duration_seconds": 4.24,
      "text": "Not much, I mostly stay in these days."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 211.55,
      "end_seconds": 215.99,
      "duration_seconds": 4.44,
      "text": "has anything ever caused you a reaction? I mean any allergies"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 217.28,
      "end_seconds": 222.78,
      "duration_seconds": 5.5,
      "text": "not currently, but as a youngster naproxen gave me a rash"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 224.24,
      "end_seconds": 228.36,
      "duration_seconds": 4.12,
      "text": "what about your parents, brothers or sisters, any conditions?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 228.96,
      "end_seconds": 230.77,
      "duration_seconds": 1.81,
      "text": "My son has asthma."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 232.21,
      "end_seconds": 234.58,
      "duration_seconds": 2.37,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 235.1,
      "end_seconds": 238.41,
      "duration_seconds": 3.31,
      "text": "Well nothing I haven't had any operations."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 249.07,
      "end_seconds": 251.48,
      "duration_seconds": 2.41,
      "text": "Are you on any regular medication?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 252.73,
      "end_seconds": 255.14,
      "duration_seconds": 2.41,
      "text": "No, I'm not on anything."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 264.11,
      "end_seconds": 268.37,
      "duration_seconds": 4.26,
      "text": "Do you have any medical conditions I should know about?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 269.19,
      "end_seconds": 271.17,
      "duration_seconds": 1.98,
      "text": "no, nothing at all"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 282.54,
      "end_seconds": 296.39,
      "duration_seconds": 13.85,
      "text": "let me tell you where I've got to i'd lean towards infective gastroenteritis, likely after recent travel that's my thinking for now, and it may change as we learn more"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 298.25,
      "end_seconds": 300.3,
      "duration_seconds": 2.05,
      "text": "Will it clear up?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 301.87,
      "end_seconds": 311.64,
      "duration_seconds": 9.77,
      "text": "nothing I've seen today points to an emergency it looks like infective gastroenteritis, likely after recent travel but I'd like to to confirm"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 322.42,
      "end_seconds": 346.95,
      "duration_seconds": 24.53,
      "text": "I'm sending you for a stool test because of diarrhoea i'll start you on oral rehydration salts, 1 sachet, after each loose stool, for three days that's for dehydration small sips often are better than large drinks, and eat plain food as soon as you can we'll catch up after the stool result"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 351.69,
      "end_seconds": 352.39,
      "duration_seconds": 0.7,
      "text": "right"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 353.51,
      "end_seconds": 357.37,
      "duration_seconds": 3.86,
      "text": "anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 358.47,
      "end_seconds": 361.45,
      "duration_seconds": 2.98,
      "text": "Great thank you for your help."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 362.79,
      "end_seconds": 364.16,
