      "start_seconds": 1.26,
      "end_seconds": 5.53,
      "duration_seconds": 4.27,
      "text": "hi, is it okay to come in now?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.51,
      "end_seconds": 11.74,
      "duration_seconds": 4.23,
      "text": "that's fine, sit down tell me why you came"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 13.77,
      "end_seconds": 17.37,
      "duration_seconds": 3.6,
      "text": "well, I've been having cramping tummy pain"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 18.0,
      "end_seconds": 21.08,
      "duration_seconds": 3.08,
      "text": "what's the timeline when did it begin?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 21.6,
      "end_seconds": 25.03,
      "duration_seconds": 3.43,
      "text": "ever since... since last Tuesday, really"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 26.82,
      "end_seconds": 35.4,
      "duration_seconds": 8.58,
      "text": "tell me a bit more about it: how bad it gets how often and whether anything makes it better or worse"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 36.49,
      "end_seconds": 43.04,
      "duration_seconds": 6.55,
      "text": "A hot water bottle helps a bit. Severe, really it's all the time"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 44.8,
      "end_seconds": 47.02,
      "duration_seconds": 2.22,
      "text": "Have you been feeling dehydrated?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 52.13,
      "end_seconds": 55.7,
      "duration_seconds": 3.57,
