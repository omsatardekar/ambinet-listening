    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 56.45,
      "end_seconds": 60.68,
      "duration_seconds": 4.23,
      "text": "Let me get the readings out of the way."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 69.3,
      "end_seconds": 71.25,
      "duration_seconds": 1.95,
      "text": "sit still for a moment.."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 89.35,
      "end_seconds": 100.53,
      "duration_seconds": 11.18,
      "text": "okay: blood pressure 122 over 74, respiratory rate 17, pulse is 108 beats a minute and oxygen saturation is 96 percent, temp 39.3 degrees"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 101.69,
      "end_seconds": 103.58,
      "duration_seconds": 1.89,
      "text": "Is that that okay?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 109.37,
      "end_seconds": 113.1,
      "duration_seconds": 3.73,
      "text": "I'll explain what these mean in a moment"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 115.07,
      "end_seconds": 117.18,
      "duration_seconds": 2.11,
      "text": "may I examine you now?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 118.01,
      "end_seconds": 119.1,
      "duration_seconds": 1.09,
      "text": "of course"
