    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 120.02,
      "end_seconds": 121.23,
      "duration_seconds": 1.21,
      "text": "nearly finished here"
