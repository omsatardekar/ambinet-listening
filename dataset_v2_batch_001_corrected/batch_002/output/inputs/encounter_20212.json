{
  "schema_version": "1.0",
  "encounter_id": "20212",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.26,
      "end_seconds": 3.77,
      "duration_seconds": 2.51,
      "text": "Good morning, grab a seat."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 5.03,
      "end_seconds": 10.64,
      "duration_seconds": 5.61,
      "text": "Hi doctor, I got here as fast as I could."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 11.29,
      "end_seconds": 12.93,
      "duration_seconds": 1.64,
      "text": "Where shall we begin?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 14.95,
      "end_seconds": 20.83,
      "duration_seconds": 5.88,
      "text": "It's cramping tummy pain. I thought I'd wait, but it hasn't gone."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 22.52,
      "end_seconds": 25.75,
      "duration_seconds": 3.23,
      "text": "How long has it been like this?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 29.38,
      "end_seconds": 33.29,
      "duration_seconds": 3.91,
      "text": "Since this morning, that's when it began."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 34.76,
      "end_seconds": 37.94,
      "duration_seconds": 3.18,
      "text": "Would you say mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 39.1,
      "end_seconds": 40.17,
      "duration_seconds": 1.07,
      "text": "Mild, really."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 41.84,
      "end_seconds": 44.25,
      "duration_seconds": 2.41,
      "text": "Does anything else come with it?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 46.16,
      "end_seconds": 53.55,
      "duration_seconds": 7.39,
      "text": "It usually comes with watery diarrhoea. The watery diarrhoea? That's been for two weeks."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 60.93,
      "end_seconds": 65.81,
      "duration_seconds": 4.88,
      "text": "Have you had any vomiting blood, black stools or confusion?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 70.26,
      "end_seconds": 76.78,
      "duration_seconds": 6.52,
      "text": "Yeah, I haven't had vomiting blood, black stools or confusion, no."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 81.7,
      "end_seconds": 85.07,
      "duration_seconds": 3.37,
      "text": "Has there been any blood in the stool?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 87.03,
      "end_seconds": 90.43,
      "duration_seconds": 3.4,
      "text": "Nope, no blood in the stool."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 91.89,
      "end_seconds": 94.04,
      "duration_seconds": 2.15,
      "text": "Your breathing, any trouble there?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 95.8,
      "end_seconds": 97.71,
      "duration_seconds": 1.91,
      "text": "No problems with breathing."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 98.67,
      "end_seconds": 103.56,
      "duration_seconds": 4.89,
      "text": "Have you noticed any weakness, or anything odd with your balance?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 104.18,
      "end_seconds": 105.76,
      "duration_seconds": 1.58,
      "text": "Nothing odd there."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 107.15,
      "end_seconds": 109.82,
      "duration_seconds": 2.67,
      "text": "Anything you do to stay fit?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 111.73,
      "end_seconds": 115.22,
      "duration_seconds": 3.49,
      "text": "I do a yoga class on Thursdays."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 118.61,
      "end_seconds": 121.76,
      "duration_seconds": 3.15,
      "text": "Are you on your own at home?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 123.53,
      "end_seconds": 126.9,
      "duration_seconds": 3.37,
      "text": "I live with my elderly mother."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 128.02,
      "end_seconds": 130.26,
      "duration_seconds": 2.24,
      "text": "Tell me about your eating."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 131.94,
      "end_seconds": 136.87,
      "duration_seconds": 4.93,
      "text": "I drink a lot of tea and snack through the day."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 155.63,
      "end_seconds": 158.14,
      "duration_seconds": 2.51,
      "text": "What's on your current medicine list?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 159.37,
      "end_seconds": 168.34,
      "duration_seconds": 8.97,
      "text": "Hydrochlorothiazide, 12.5 milligrams, every morning. Sodium valproate. I take it 500 milligrams, twice a day for the fits."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 169.99,
      "end_seconds": 172.9,
      "duration_seconds": 2.91,
      "text": "Has anyone ever diagnosed you with something?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 174.87,
      "end_seconds": 180.71,
      "duration_seconds": 5.84,
      "text": "High blood pressure, for about ten years. Epilepsy, for about ten years."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 181.47,
      "end_seconds": 182.17,
      "duration_seconds": 0.7,
      "text": "Ah."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 191.8,
      "end_seconds": 195.04,
      "duration_seconds": 3.24,
      "text": "Any past operations I should know about?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 196.52,
      "end_seconds": 202.67,
      "duration_seconds": 6.15,
      "text": "I had a meniscus repair on my knee four years ago."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 206.76,
      "end_seconds": 211.4,
      "duration_seconds": 4.64,
      "text": "Are you allergic to anything? Any allergies to medicines or foods?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 214.24,
      "end_seconds": 222.59,
      "duration_seconds": 8.35,
      "text": "I was told I'm allergic to amoxicillin, but I don't remember what reaction I had."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 228.39,
      "end_seconds": 239.07,
      "duration_seconds": 10.68,
      "text": "Okay, so the vitals from earlier. Temp 38.5 degrees, respiratory rate 16, pressure 114 over 70, pulse 92, oxygen saturation is 96 percent."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 240.14,
      "end_seconds": 249.93,
      "duration_seconds": 9.79,
      "text": "Okay, noted. Putting together what you've described, I think we're dealing with infective gastroenteritis, likely after recent travel at this stage."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 251.93,
      "end_seconds": 255.23,
      "duration_seconds": 3.3,
      "text": "Do you think it's something serious?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 255.79,
      "end_seconds": 268.59,
      "duration_seconds": 12.8,
      "text": "I understand the worry. At the moment I'd say it's infective gastroenteritis, likely after recent travel, and we'll know more once the blood tests is back."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 286.49,
      "end_seconds": 316.03,
      "duration_seconds": 29.54,
      "text": "I'm sending you for blood tests because of dehydration. For this, oral rehydration salts, 1 sachet, after each loose stool, for three days. It's for dehydration. Small sips often are better than large drinks, and eat plain food as soon as you can. Keep an eye out, and if you see blood in the stool or cannot keep fluids down, call us the same day or go to emergency."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 317.86,
      "end_seconds": 327.59,
      "duration_seconds": 9.73,
      "text": "I'd like to see you again if it isn't better in three days. Alright, anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 328.13,
      "end_seconds": 331.77,
      "duration_seconds": 3.64,
      "text": "Okay, that makes sense. Thanks for explaining."
    }
  ]
}