{
  "schema_version": "1.0",
  "encounter_id": "20289",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.54,
      "end_seconds": 6.7,
      "duration_seconds": 6.16,
      "text": "So, afternoon, thanks for coming in. You came on your own today?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 11.27,
      "end_seconds": 14.62,
      "duration_seconds": 3.35,
      "text": "Yes, I managed on my own."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 16.3,
      "end_seconds": 18.24,
      "duration_seconds": 1.94,
      "text": "Where shall we begin?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 23.45,
      "end_seconds": 27.96,
      "duration_seconds": 4.51,
      "text": "I've been dealing with cramps in my calves at night."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 28.82,
      "end_seconds": 31.67,
      "duration_seconds": 2.85,
      "text": "Time for your numbers, if that's okay."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 39.5,
      "end_seconds": 42.2,
      "duration_seconds": 2.7,
      "text": "Keep your arm relaxed for me..."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 60.51,
      "end_seconds": 73.81,
      "duration_seconds": 13.3,
      "text": "Okay: BMI works out to 32.1, temp 36.6 degrees. And weight 95 kilos, saturation 98 percent, height 172 centimetres, blood pressure 111 over 81, pulse is 78 beats a minute."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 75.26,
      "end_seconds": 76.64,
      "duration_seconds": 1.38,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 77.32,
      "end_seconds": 84.61,
      "duration_seconds": 7.29,
      "text": "Don't worry, we'll discuss it in a second. When was the first time you noticed it?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 85.45,
      "end_seconds": 90.09,
      "duration_seconds": 4.64,
      "text": "Right, it's been going on for about a year."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 91.37,
      "end_seconds": 100.64,
      "duration_seconds": 9.27,
      "text": "So, tell me a bit more about it: how bad it gets, how often, and whether anything makes it better or worse."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 102.0,
      "end_seconds": 116.52,
      "duration_seconds": 14.52,
      "text": "Mm, I'd give it a eight, out of ten. Stretching and walking about helps a bit. Oh, and trouble sleeping. That's been about the same, three weeks."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 118.26,
      "end_seconds": 123.07,
      "duration_seconds": 4.81,
      "text": "And what about redness of the leg or weakness in the legs?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 124.32,
      "end_seconds": 127.68,
      "duration_seconds": 3.36,
      "text": "No, uh, I'd have said so."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 129.72,
      "end_seconds": 133.48,
      "duration_seconds": 3.76,
      "text": "Have you noticed chest pain or shortness of breath?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 134.79,
      "end_seconds": 140.84,
      "duration_seconds": 6.05,
      "text": "Actually, no chest pain or shortness of breath, none of it."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 142.74,
      "end_seconds": 146.15,
      "duration_seconds": 3.41,
      "text": "Alright, any rashes or skin problems otherwise?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 147.15,
      "end_seconds": 148.23,
      "duration_seconds": 1.08,
      "text": "Skin's normal."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 164.31,
      "end_seconds": 167.37,
      "duration_seconds": 3.06,
      "text": "Has anyone ever diagnosed you with something?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 168.45,
      "end_seconds": 169.81,
      "duration_seconds": 1.36,
      "text": "I have diabetes."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 179.29,
      "end_seconds": 184.59,
      "duration_seconds": 5.3,
      "text": "Are you allergic to anything? Any allergies to medicines or foods?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 185.34,
      "end_seconds": 189.73,
      "duration_seconds": 4.39,
      "text": "Erythromycin. I come out in... well, bad stomach cramps."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 191.38,
      "end_seconds": 193.82,
      "duration_seconds": 2.44,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 195.65,
      "end_seconds": 197.34,
      "duration_seconds": 1.69,
      "text": "No surgery, no."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 205.31,
      "end_seconds": 208.46,
      "duration_seconds": 3.15,
      "text": "Which medicines do you take at the moment?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 210.03,
      "end_seconds": 214.83,
      "duration_seconds": 4.8,
      "text": "Oh, it's gliclazide, 80 milligrams, twice a day."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 216.28,
      "end_seconds": 217.46,
      "duration_seconds": 1.18,
      "text": "What about alcohol?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 218.12,
      "end_seconds": 221.03,
      "duration_seconds": 2.91,
      "text": "I only drink at family occasions."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 221.62,
      "end_seconds": 222.99,
      "duration_seconds": 1.37,
      "text": "Are you active?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 224.58,
      "end_seconds": 227.56,
      "duration_seconds": 2.98,
      "text": "I walk the dog every morning."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 228.53,
      "end_seconds": 232.15,
      "duration_seconds": 3.62,
      "text": "Alright, what line of work are you in?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 233.88,
      "end_seconds": 238.95,
      "duration_seconds": 5.07,
      "text": "I'm a bus driver, so I sit for long hours."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 242.75,
      "end_seconds": 244.92,
      "duration_seconds": 2.17,
      "text": "Tell me about your eating."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 245.44,
      "end_seconds": 251.1,
      "duration_seconds": 5.66,
      "text": "I drink a lot of tea and snack through the day."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 253.56,
      "end_seconds": 258.33,
      "duration_seconds": 4.77,
      "text": "I'll need to examine you for this, it won't take long."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 260.02,
      "end_seconds": 261.35,
      "duration_seconds": 1.33,
      "text": "Nearly finished here."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 272.03,
      "end_seconds": 279.08,
      "duration_seconds": 7.05,
      "text": "Both calves are soft and not tender, and the pulses at your feet are good."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 284.18,
      "end_seconds": 292.7,
      "duration_seconds": 8.52,
      "text": "Okay, that's enough for me. Putting it all together, it points towards night-time muscle cramps without a worrying cause."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 293.85,
      "end_seconds": 295.9,
      "duration_seconds": 2.05,
      "text": "Is this serious, doctor?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 297.76,
      "end_seconds": 307.48,
      "duration_seconds": 9.72,
      "text": "I can't promise yet, but most people with night-time muscle cramps without a worrying cause do well once it's treated properly."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 314.91,
      "end_seconds": 320.35,
      "duration_seconds": 5.44,
      "text": "Let's get blood tests, for muscle cramps. Does all of that make sense?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 322.07,
      "end_seconds": 326.24,
      "duration_seconds": 4.17,
      "text": "No, uh, that's all. Thanks a lot."
    }
  ]
}