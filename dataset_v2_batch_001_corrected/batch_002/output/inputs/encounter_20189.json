{
  "schema_version": "1.0",
  "encounter_id": "20189",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.65,
      "end_seconds": 3.47,
      "duration_seconds": 2.82,
      "text": "Morning, doctor. Lovely to meet you."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.51,
      "end_seconds": 10.06,
      "duration_seconds": 4.55,
      "text": "Of course, leave it there. How can I help?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 14.09,
      "end_seconds": 17.62,
      "duration_seconds": 3.53,
      "text": "I've been dealing with a stinging pain."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 19.5,
      "end_seconds": 22.74,
      "duration_seconds": 3.24,
      "text": "How long has it been like this?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 23.54,
      "end_seconds": 26.6,
      "duration_seconds": 3.06,
      "text": "I've had it since last weekend."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 42.64,
      "end_seconds": 46.37,
      "duration_seconds": 3.73,
      "text": "And burn on the face, any of that?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 47.86,
      "end_seconds": 52.03,
      "duration_seconds": 4.17,
      "text": "No, none, no burn on the face."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 53.87,
      "end_seconds": 61.57,
      "duration_seconds": 7.7,
      "text": "Let me check a few things. Any numbness at the burn, chemical exposure or trouble breathing?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 62.08,
      "end_seconds": 64.95,
      "duration_seconds": 2.87,
      "text": "No, nothing to report there."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 65.49,
      "end_seconds": 67.74,
      "duration_seconds": 2.25,
      "text": "Is your mobility otherwise okay?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 69.46,
      "end_seconds": 70.96,
      "duration_seconds": 1.5,
      "text": "No, nothing there."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 88.55,
      "end_seconds": 90.44,
      "duration_seconds": 1.89,
      "text": "And alcohol, how much?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 92.46,
      "end_seconds": 95.49,
      "duration_seconds": 3.03,
      "text": "I only drink at family occasions."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 96.12,
      "end_seconds": 96.95,
      "duration_seconds": 0.83,
      "text": "Any smoking?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 97.57,
      "end_seconds": 101.65,
      "duration_seconds": 4.08,
      "text": "I smoke roughly a pack every two days."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 103.58,
      "end_seconds": 105.77,
      "duration_seconds": 2.19,
      "text": "Is there someone at home?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 106.61,
      "end_seconds": 111.06,
      "duration_seconds": 4.45,
      "text": "My husband and I live above the shop."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 112.39,
      "end_seconds": 115.2,
      "duration_seconds": 2.81,
      "text": "Are you in work at the moment?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 117.16,
      "end_seconds": 121.83,
      "duration_seconds": 4.67,
      "text": "Yes, I work in a bakery, early starts."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 122.63,
      "end_seconds": 126.25,
      "duration_seconds": 3.62,
      "text": "Are there any allergies I should be aware of?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 127.46,
      "end_seconds": 130.17,
      "duration_seconds": 2.71,
      "text": "I've never had an allergy."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 146.46,
      "end_seconds": 150.16,
      "duration_seconds": 3.7,
      "text": "Any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 151.28,
      "end_seconds": 154.32,
      "duration_seconds": 3.04,
      "text": "No, I've always been fairly healthy."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 156.04,
      "end_seconds": 158.41,
      "duration_seconds": 2.37,
      "text": "Do you take any regular medication?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 158.97,
      "end_seconds": 161.88,
      "duration_seconds": 2.91,
      "text": "No, nothing at the moment."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 165.95,
      "end_seconds": 168.66,
      "duration_seconds": 2.71,
      "text": "Let me take your readings now."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 174.8,
      "end_seconds": 177.68,
      "duration_seconds": 2.88,
      "text": "So, keep your arm relaxed for me..."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 198.61,
      "end_seconds": 207.75,
      "duration_seconds": 9.14,
      "text": "Okay: pressure 126 over 68, respiratory rate 18, heart rate 66, saturation 98 percent, temperature is 36.5 degrees."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 208.69,
      "end_seconds": 210.12,
      "duration_seconds": 1.43,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 210.89,
      "end_seconds": 213.74,
      "duration_seconds": 2.85,
      "text": "I'll interpret them after the examination."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 215.46,
      "end_seconds": 219.64,
      "duration_seconds": 4.18,
      "text": "Alright, over here please and I'll take a look."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 220.96,
      "end_seconds": 222.67,
      "duration_seconds": 1.71,
      "text": "Okay, nearly finished here."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 230.71,
      "end_seconds": 239.11,
      "duration_seconds": 8.4,
      "text": "There is a five-centimetre area of redness with an intact blister on the left forearm, and it blanches and is painful."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 240.69,
      "end_seconds": 241.7,
      "duration_seconds": 1.01,
      "text": "That's alright."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 244.93,
      "end_seconds": 246.67,
      "duration_seconds": 1.74,
      "text": "Please sit back down."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 255.31,
      "end_seconds": 282.87,
      "duration_seconds": 27.56,
      "text": "From what you've told me and what I found, the most likely explanation is a superficial partial-thickness burn. For this, paracetamol, 1 gram, every six hours if needed, for three days. You take it by mouth. It's for burn pain. Cool the area under running water for twenty minutes and cover it with a non-stick dressing, and leave the blister alone."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 283.96,
      "end_seconds": 294.02,
      "duration_seconds": 10.06,
      "text": "Try to get to bed and wake up at the same time each day, and keep your phone away from the bed."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 294.24,
      "end_seconds": 306.47,
      "duration_seconds": 12.23,
      "text": "Yes. If the burn becomes smelly, spreads or you get a fever, or you feel really unwell, please come to the emergency department. We'll catch up in three days."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 308.54,
      "end_seconds": 309.24,
      "duration_seconds": 0.7,
      "text": "Sure."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 310.84,
      "end_seconds": 315.43,
      "duration_seconds": 4.59,
      "text": "Is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 317.19,
      "end_seconds": 319.36,
      "duration_seconds": 2.17,
      "text": "Alright, thanks, take care."
    }
  ]
}