{
  "schema_version": "1.0",
  "encounter_id": "20258",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 0.64,
      "end_seconds": 5.56,
      "duration_seconds": 4.92,
      "text": "Doctor, I've brought them through. The observations are done, whenever you need them."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.88,
      "end_seconds": 12.17,
      "duration_seconds": 5.29,
      "text": "Great. Hello, come in and sit down. How can I help?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 13.53,
      "end_seconds": 21.11,
      "duration_seconds": 7.58,
      "text": "Sorry, what was I saying, honestly, it's nausea, and my family pushed me to come."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 22.11,
      "end_seconds": 25.86,
      "duration_seconds": 3.75,
      "text": "Okay, how many days or weeks has it been?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 27.28,
      "end_seconds": 30.74,
      "duration_seconds": 3.46,
      "text": "It's been going on for ten days."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 31.8,
      "end_seconds": 36.31,
      "duration_seconds": 4.51,
      "text": "Okay, give me more detail on it, whatever comes to mind."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 37.52,
      "end_seconds": 42.89,
      "duration_seconds": 5.37,
      "text": "I'd say on and off. Mostly moderate. And watery diarrhoea, too."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 44.81,
      "end_seconds": 46.1,
      "duration_seconds": 1.29,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 48.47,
      "end_seconds": 51.36,
      "duration_seconds": 2.89,
      "text": "No surgery, you know, no."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 52.75,
      "end_seconds": 56.37,
      "duration_seconds": 3.62,
      "text": "Let me ask about allergies, anything at all?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 57.54,
      "end_seconds": 59.66,
      "duration_seconds": 2.12,
      "text": "No allergies at all."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 61.28,
      "end_seconds": 64.6,
      "duration_seconds": 3.32,
      "text": "Any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 65.9,
      "end_seconds": 67.62,
      "duration_seconds": 1.72,
      "text": "Not really, no."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 69.22,
      "end_seconds": 72.81,
      "duration_seconds": 3.59,
      "text": "Has anyone in your family had anything serious?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 73.71,
      "end_seconds": 76.13,
      "duration_seconds": 2.42,
      "text": "My uncle has high cholesterol."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 84.66,
      "end_seconds": 87.69,
      "duration_seconds": 3.03,
      "text": "Any regular medication, tablets or creams?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 89.4,
      "end_seconds": 92.25,
      "duration_seconds": 2.85,
      "text": "No, nothing at the moment."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 93.94,
      "end_seconds": 95.79,
      "duration_seconds": 1.85,
      "text": "And alcohol, how much?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 96.73,
      "end_seconds": 100.02,
      "duration_seconds": 3.29,
      "text": "I only drink at family occasions."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 101.78,
      "end_seconds": 104.15,
      "duration_seconds": 2.37,
      "text": "Is there someone at home?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 106.01,
      "end_seconds": 109.9,
      "duration_seconds": 3.89,
      "text": "My husband and I live above the shop."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 110.83,
      "end_seconds": 113.78,
      "duration_seconds": 2.95,
      "text": "Alright, anything you do to stay fit?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 119.25,
      "end_seconds": 122.54,
      "duration_seconds": 3.29,
      "text": "I do a yoga class on Thursdays."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 124.35,
      "end_seconds": 128.66,
      "duration_seconds": 4.31,
      "text": "Any dizziness, severe abdominal pain or blood in the stool?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 132.04,
      "end_seconds": 135.63,
      "duration_seconds": 3.59,
      "text": "Erm, um, nope, nothing like that."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 136.61,
      "end_seconds": 139.67,
      "duration_seconds": 3.06,
      "text": "Have you had confusion, by any chance?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 140.98,
      "end_seconds": 144.34,
      "duration_seconds": 3.36,
      "text": "Ah, not at all, no confusion."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 145.93,
      "end_seconds": 149.59,
      "duration_seconds": 3.66,
      "text": "Anything on the skin I should know about?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 151.47,
      "end_seconds": 153.9,
      "duration_seconds": 2.43,
      "text": "Nothing on the skin, no."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 171.83,
      "end_seconds": 180.63,
      "duration_seconds": 8.8,
      "text": "Okay, so the vitals from earlier. Pressure 116 over 71, pulse 96, oxygen saturation is 97 percent, temp 38.0 degrees."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 181.4,
      "end_seconds": 182.1,
      "duration_seconds": 0.7,
      "text": "Thanks."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 184.91,
      "end_seconds": 187.89,
      "duration_seconds": 2.98,
      "text": "Okay, time for me to examine you."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 189.46,
      "end_seconds": 191.8,
      "duration_seconds": 2.34,
      "text": "Raise your arm for me."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 204.73,
      "end_seconds": 211.49,
      "duration_seconds": 6.76,
      "text": "Your mouth is a bit dry and your tummy is soft with mild tenderness all over."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 215.03,
      "end_seconds": 216.76,
      "duration_seconds": 1.73,
      "text": "You can relax now."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 223.86,
      "end_seconds": 230.59,
      "duration_seconds": 6.73,
      "text": "So where does that leave us? This is probably infective gastroenteritis, likely after recent travel."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 232.23,
      "end_seconds": 234.42,
      "duration_seconds": 2.19,
      "text": "Is this serious, doctor?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 235.68,
      "end_seconds": 254.44,
      "duration_seconds": 18.76,
      "text": "Nothing I've seen today points to an emergency. It looks like infective gastroenteritis, likely after recent travel, but I'd like to confirm. So, to recap quickly. You've had nausea for ten days, moderate, and no blood in the stool or severe abdominal pain."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 256.45,
      "end_seconds": 259.33,
      "duration_seconds": 2.88,
      "text": "Erm, yes, you've got it."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 261.31,
      "end_seconds": 264.49,
      "duration_seconds": 3.18,
      "text": "Let's book blood tests to look into dehydration."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 266.1,
      "end_seconds": 269.01,
      "duration_seconds": 2.91,
      "text": "Where would I go for that?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 270.09,
      "end_seconds": 300.67,
      "duration_seconds": 30.58,
      "text": "I'm going to order a stool test, for diarrhoea. I'm going to put you on oral rehydration salts, 1 sachet, after each loose stool, for three days. It's for dehydration. Small sips often are better than large drinks, and eat plain food as soon as you can. One warning sign to remember: you see blood in the stool or cannot keep fluids down. In that case don't wait. Let's plan a check after the stool result."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 301.58,
      "end_seconds": 305.49,
      "duration_seconds": 3.91,
      "text": "Is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 307.59,
      "end_seconds": 309.25,
      "duration_seconds": 1.66,
      "text": "That's clear, thanks."
    }
  ]
}