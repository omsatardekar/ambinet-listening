  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.2,
      "end_seconds": 7.67,
      "duration_seconds": 6.47,
      "text": "Let me think, doctor? Hello, I hope this is the right time."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 9.72,
      "end_seconds": 14.74,
      "duration_seconds": 5.02,
      "text": "Okay, of course, leave it there. How can I help?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 16.73,
      "end_seconds": 27.76,
      "duration_seconds": 11.03,
      "text": "Yeah, it's some bleeding. I don't know what's causing it. I kept putting it off, which I know isn't sensible."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 28.84,
      "end_seconds": 31.97,
      "duration_seconds": 3.13,
      "text": "How many days or weeks has it been?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 33.54,
      "end_seconds": 36.9,
      "duration_seconds": 3.36,
      "text": "It's been about two weeks now."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 38.44,
      "end_seconds": 40.52,
      "duration_seconds": 2.08,
      "text": "Have you had tender breasts?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 41.37,
      "end_seconds": 43.01,
      "duration_seconds": 1.64,
      "text": "Yeah, that too."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 61.23,
      "end_seconds": 65.24,
      "duration_seconds": 4.01,
      "text": "Have you noticed passing tissue or severe one-sided pain?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 66.93,
      "end_seconds": 71.82,
      "duration_seconds": 4.89,
      "text": "I haven't had passing tissue or severe one-sided pain, no."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 72.43,
      "end_seconds": 73.87,
      "duration_seconds": 1.44,
      "text": "Nothing like fever?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 75.65,
      "end_seconds": 77.07,
      "duration_seconds": 1.42,
      "text": "No. No fever."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 80.1,
      "end_seconds": 82.49,
      "duration_seconds": 2.39,
      "text": "Any rashes or skin problems otherwise?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 83.53,
      "end_seconds": 85.96,
      "duration_seconds": 2.43,
      "text": "Nothing on the skin, no."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 86.72,
      "end_seconds": 90.53,
      "duration_seconds": 3.81,
      "text": "On the cardiac side, anything I should know?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 92.13,
      "end_seconds": 94.13,
      "duration_seconds": 2.0,
      "text": "No, that's been fine."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 111.58,
      "end_seconds": 114.39,
      "duration_seconds": 2.81,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 116.4,
      "end_seconds": 117.49,
      "duration_seconds": 1.09,
      "text": "No, never."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 119.4,
      "end_seconds": 122.33,
      "duration_seconds": 2.93,
      "text": "Before we go further, any allergies?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 123.36,
      "end_seconds": 128.09,
      "duration_seconds": 4.73,
      "text": "I mean, no, nothing as far as I know."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 135.78,
      "end_seconds": 138.8,
      "duration_seconds": 3.02,
      "text": "Is there any regular medication you use?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 139.73,
      "end_seconds": 140.75,
      "duration_seconds": 1.02,
      "text": "No, none."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 141.37,
      "end_seconds": 145.75,
      "duration_seconds": 4.38,
      "text": "Do you have any medical conditions I should know about?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 150.69,
      "end_seconds": 153.94,
      "duration_seconds": 3.25,
      "text": "No, nothing I can think of."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 155.25,
      "end_seconds": 156.67,
      "duration_seconds": 1.42,
      "text": "Are you active?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 158.57,
      "end_seconds": 161.93,
      "duration_seconds": 3.36,
      "text": "I walk the dog every morning."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 162.43,
      "end_seconds": 164.29,
      "duration_seconds": 1.86,
      "text": "Who lives with you?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 165.46,
      "end_seconds": 168.25,
      "duration_seconds": 2.79,
      "text": "My partner and our baby."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 169.47,
      "end_seconds": 172.35,
      "duration_seconds": 2.88,
      "text": "Time for your numbers, if that's okay."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 184.4,
      "end_seconds": 187.1,
      "duration_seconds": 2.7,
      "text": "Right, nearly done with the readings..."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 206.24,
      "end_seconds": 213.38,
      "duration_seconds": 7.14,
      "text": "Okay: pressure 112 over 76, pulse 85, temperature 36.6, oxygen saturation is 99 percent."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 218.54,
      "end_seconds": 220.83,
      "duration_seconds": 2.29,
      "text": "Is that alright, doctor?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 221.73,
      "end_seconds": 224.07,
      "duration_seconds": 2.34,
      "text": "We'll go over that shortly."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 225.3,
      "end_seconds": 228.49,
      "duration_seconds": 3.19,
      "text": "Okay, time for me to examine you."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 230.16,
      "end_seconds": 231.28,
      "duration_seconds": 1.12,
      "text": "Of course."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 232.85,
      "end_seconds": 234.82,
      "duration_seconds": 1.97,
      "text": "Tell me if that's sore."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 250.74,
      "end_seconds": 257.26,
      "duration_seconds": 6.52,
      "text": "Your tummy is soft with mild tenderness low down and your blood pressure is normal."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 263.06,
      "end_seconds": 266.11,
      "duration_seconds": 3.05,
      "text": "Thank you, you can get dressed."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 279.88,
      "end_seconds": 292.07,
      "duration_seconds": 12.19,
      "text": "Having listened and examined, this looks most like bleeding in early pregnancy that needs a scan. I'm sending you for a pregnancy hormone level because of bleeding in early pregnancy."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 293.37,
      "end_seconds": 295.94,
      "duration_seconds": 2.57,
      "text": "Oh, that's fine with me."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 300.71,
      "end_seconds": 315.9,
      "duration_seconds": 15.19,
      "text": "Use pads rather than tampons and avoid intercourse until the scan. Come back or go to emergency straight away if the bleeding becomes heavy or the pain becomes severe or one-sided."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 317.54,
      "end_seconds": 319.19,
      "duration_seconds": 1.65,
      "text": "Okay, makes sense."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 319.92,
      "end_seconds": 324.73,
      "duration_seconds": 4.81,
      "text": "Right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 325.57,
      "end_seconds": 329.56,
      "duration_seconds": 3.99,
      "text": "Right, good, thanks, I'll see you then."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 331.03,
      "end_seconds": 332.34,
      "duration_seconds": 1.31,
      "text": "Goodbye for now."
    }
  ]
}