      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 199.77,
      "end_seconds": 215.89,
      "duration_seconds": 16.12,
      "text": "okay, so the the vitals from earlier heart rate 85, BMI works out to 25.1, height 184 centimetres temp 36.8 degrees, blood pressure 153 over 90, weight 85 kilos, oxygen saturation is 96 percent"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 217.84,
      "end_seconds": 219.36,
      "duration_seconds": 1.52,
      "text": "good, thank you"
