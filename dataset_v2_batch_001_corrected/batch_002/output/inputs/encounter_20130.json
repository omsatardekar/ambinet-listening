      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 221.02,
      "end_seconds": 225.55,
      "duration_seconds": 4.53,
      "text": "I'll need to examine you for this, it won't take long."
