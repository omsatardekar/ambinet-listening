{
  "schema_version": "1.0",
  "encounter_id": "20254",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.15,
      "end_seconds": 5.31,
      "duration_seconds": 4.16,
      "text": "Good evening, doctor, thanks for seeing me."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.28,
      "end_seconds": 10.64,
      "duration_seconds": 4.36,
      "text": "No problem at all, come in. What's troubling you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 12.62,
      "end_seconds": 17.65,
      "duration_seconds": 5.03,
      "text": "Yeah, it's heavy periods. I don't know what's causing it."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 19.72,
      "end_seconds": 22.93,
      "duration_seconds": 3.21,
      "text": "When was the first time you noticed it?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 24.95,
      "end_seconds": 36.85,
      "duration_seconds": 11.9,
      "text": "Sorry, what was I saying, it's been going on for about a month. I've also been feeling exhausted, for about a year."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 37.45,
      "end_seconds": 40.05,
      "duration_seconds": 2.6,
      "text": "Let me quickly check your readings."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 47.73,
      "end_seconds": 50.27,
      "duration_seconds": 2.54,
      "text": "Keep your arm relaxed for me..."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 62.88,
      "end_seconds": 75.53,
      "duration_seconds": 12.65,
      "text": "Okay: weight 87 kilos, pulse is 77 beats a minute. And temperature is 36.9 degrees, pressure 117 over 75, SpO2 97 percent on room air, height 163 centimetres."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 77.43,
      "end_seconds": 80.36,
      "duration_seconds": 2.93,
      "text": "So, shall I start the examination?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 81.62,
      "end_seconds": 84.17,
      "duration_seconds": 2.55,
      "text": "Take a deep breath for me."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 98.45,
      "end_seconds": 102.7,
      "duration_seconds": 4.25,
      "text": "Your eyelids and the palms of your hands look pale."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 107.24,
      "end_seconds": 109.39,
      "duration_seconds": 2.15,
      "text": "Right, that's the examination finished."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 123.56,
      "end_seconds": 129.05,
      "duration_seconds": 5.49,
      "text": "Have you noticed weight loss, pelvic pain, chest pain or fainting?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 129.6,
      "end_seconds": 135.79,
      "duration_seconds": 6.19,
      "text": "I haven't had weight loss, pelvic pain, chest pain or fainting, no."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 138.18,
      "end_seconds": 141.57,
      "duration_seconds": 3.39,
      "text": "Has your heart given you any trouble?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 143.55,
      "end_seconds": 145.24,
      "duration_seconds": 1.69,
      "text": "Nothing like that."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 145.82,
      "end_seconds": 149.57,
      "duration_seconds": 3.75,
      "text": "So, anything with your nerves, like weakness or numbness?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 151.66,
      "end_seconds": 155.2,
      "duration_seconds": 3.54,
      "text": "Okay, so no, nothing like that."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 156.21,
      "end_seconds": 157.48,
      "duration_seconds": 1.27,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 158.37,
      "end_seconds": 159.84,
      "duration_seconds": 1.47,
      "text": "No surgery, no."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 174.12,
      "end_seconds": 177.57,
      "duration_seconds": 3.45,
      "text": "Any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 179.38,
      "end_seconds": 182.88,
      "duration_seconds": 3.5,
      "text": "No, nothing I can think of."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 186.48,
      "end_seconds": 189.71,
      "duration_seconds": 3.23,
      "text": "Is there anything relevant on the family side?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 190.67,
      "end_seconds": 193.76,
      "duration_seconds": 3.09,
      "text": "My mother has an underactive thyroid."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 197.52,
      "end_seconds": 199.93,
      "duration_seconds": 2.41,
      "text": "Any regular medication at all?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 200.48,
      "end_seconds": 201.96,
      "duration_seconds": 1.48,
      "text": "Nothing regular, no."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 203.21,
      "end_seconds": 208.01,
      "duration_seconds": 4.8,
      "text": "Let's talk a little about your daily life and habits."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 209.81,
      "end_seconds": 228.68,
      "duration_seconds": 18.87,
      "text": "I used to drink heavily but I stopped four years ago. I walk the dog every morning. I'm a bus driver, so I sit for long hours. I drink a lot of tea and snack through the day."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 230.01,
      "end_seconds": 236.8,
      "duration_seconds": 6.79,
      "text": "Right, here's what I'm thinking. This looks most like heavy periods with iron deficiency."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 237.5,
      "end_seconds": 239.69,
      "duration_seconds": 2.19,
      "text": "Will it clear up?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 241.37,
      "end_seconds": 251.47,
      "duration_seconds": 10.1,
      "text": "Nothing I've seen today points to an emergency. It looks like heavy periods with iron deficiency, but I'd like to confirm."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 264.47,
      "end_seconds": 281.97,
      "duration_seconds": 17.5,
      "text": "We should do a ferritin level for iron deficiency. Let's use tranexamic acid, 1 gram, three times a day during periods, for four days each cycle. You take it by mouth. That's for heavy periods."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 286.31,
      "end_seconds": 290.12,
      "duration_seconds": 3.81,
      "text": "So, alright, I'll pick it up today."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 291.89,
      "end_seconds": 306.35,
      "duration_seconds": 14.46,
      "text": "Iron can darken the stools and bother the stomach, so take it after food. Book a review after the results. Is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 307.9,
      "end_seconds": 312.09,
      "duration_seconds": 4.19,
      "text": "Right, I'll do that. Thank you, doctor."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 313.07,
      "end_seconds": 315.04,
      "duration_seconds": 1.97,
      "text": "Have a good day."
    }
  ]
}