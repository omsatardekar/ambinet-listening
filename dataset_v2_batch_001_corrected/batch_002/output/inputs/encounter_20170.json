{
  "schema_version": "1.0",
  "encounter_id": "20170",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.98,
      "end_seconds": 3.87,
      "duration_seconds": 2.89,
      "text": "Hello, doctor. May I come in?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.95,
      "end_seconds": 9.64,
      "duration_seconds": 3.69,
      "text": "Yes, have a seat. Tell me what's going on."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 10.29,
      "end_seconds": 13.4,
      "duration_seconds": 3.11,
      "text": "I've been losing weight without trying."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 15.11,
      "end_seconds": 18.61,
      "duration_seconds": 3.5,
      "text": "So, how long has it been like this?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 20.05,
      "end_seconds": 23.18,
      "duration_seconds": 3.13,
      "text": "For about a year, I'd say."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 23.69,
      "end_seconds": 24.68,
      "duration_seconds": 0.99,
      "text": "I follow."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 25.88,
      "end_seconds": 31.43,
      "duration_seconds": 5.55,
      "text": "And I've been feeling tired as well, for three weeks."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 34.97,
      "end_seconds": 37.31,
      "duration_seconds": 2.34,
      "text": "Let me quickly check your readings."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 44.08,
      "end_seconds": 46.41,
      "duration_seconds": 2.33,
      "text": "Nearly done with the readings..."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 64.69,
      "end_seconds": 71.45,
      "duration_seconds": 6.76,
      "text": "Okay: temp 36.4 degrees, BP is 122 over 72, pulse is 64 beats a minute."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 73.48,
      "end_seconds": 76.24,
      "duration_seconds": 2.76,
      "text": "Let's move on to the examination."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 77.67,
      "end_seconds": 79.64,
      "duration_seconds": 1.97,
      "text": "Raise your arm for me."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 92.55,
      "end_seconds": 97.02,
      "duration_seconds": 4.47,
      "text": "Your tummy is soft and I can't feel any lumps."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 98.31,
      "end_seconds": 99.72,
      "duration_seconds": 1.41,
      "text": "Does that hurt?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 114.11,
      "end_seconds": 119.4,
      "duration_seconds": 5.29,
      "text": "I can feel a couple of small glands in your neck, not tender."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 121.69,
      "end_seconds": 128.87,
      "duration_seconds": 7.18,
      "text": "All finished, thank you. And what about difficulty swallowing, vomiting, blood in the stool or bone pain?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 129.85,
      "end_seconds": 132.47,
      "duration_seconds": 2.62,
      "text": "No, none that I've noticed."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 133.76,
      "end_seconds": 136.14,
      "duration_seconds": 2.38,
      "text": "Is your mobility otherwise okay?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 136.84,
      "end_seconds": 138.86,
      "duration_seconds": 2.02,
      "text": "I move fine otherwise."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 154.64,
      "end_seconds": 159.45,
      "duration_seconds": 4.81,
      "text": "Do you react to any medicines or foods? Any allergies?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 160.51,
      "end_seconds": 163.54,
      "duration_seconds": 3.03,
      "text": "Yes, trimethoprim, it gives me itching."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 165.54,
      "end_seconds": 169.4,
      "duration_seconds": 3.86,
      "text": "Has anyone in your family had anything serious?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 170.98,
      "end_seconds": 173.25,
      "duration_seconds": 2.27,
      "text": "My grandmother had dementia."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 188.4,
      "end_seconds": 191.59,
      "duration_seconds": 3.19,
      "text": "Do you take any prescribed or over-the-counter medicines?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 193.35,
      "end_seconds": 196.98,
      "duration_seconds": 3.63,
      "text": "It's losartan, 50 milligrams, once a day."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 202.81,
      "end_seconds": 206.12,
      "duration_seconds": 3.31,
      "text": "How long have you been on it?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 206.96,
      "end_seconds": 208.46,
      "duration_seconds": 1.5,
      "text": "For two years."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 209.85,
      "end_seconds": 212.09,
      "duration_seconds": 2.24,
      "text": "Do you live by yourself?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 212.91,
      "end_seconds": 216.76,
      "duration_seconds": 3.85,
      "text": "No, I share a house with my brother."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 220.73,
      "end_seconds": 225.24,
      "duration_seconds": 4.51,
      "text": "So, what does a normal day of food look like?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 225.8,
      "end_seconds": 229.49,
      "duration_seconds": 3.69,
      "text": "Lots of rice, lentils and some fruit."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 230.91,
      "end_seconds": 239.86,
      "duration_seconds": 8.95,
      "text": "Tell me about any past illnesses or ongoing conditions. Bear with me, I'm just building up the picture."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 241.54,
      "end_seconds": 246.88,
      "duration_seconds": 5.34,
      "text": "I've had high blood pressure for about a year now."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 262.37,
      "end_seconds": 270.22,
      "duration_seconds": 7.85,
      "text": "Having listened and examined, this looks most like an unexplained weight loss that needs a proper work-up."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 271.13,
      "end_seconds": 272.93,
      "duration_seconds": 1.8,
      "text": "Will it clear up?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 274.85,
      "end_seconds": 304.88,
      "duration_seconds": 30.03,
      "text": "Nothing I've seen today points to an emergency. It looks like an unexplained weight loss that needs a proper work-up, but I'd like to confirm. I'll request blood tests, it'll help with weight loss. I'll request a chest X-ray, it'll help with cough and weight loss. Weigh yourself once a week at the same time and note it down. I'd like you back after the results are back. I think we're done unless you have questions."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 305.8,
      "end_seconds": 307.96,
      "duration_seconds": 2.16,
      "text": "Alright, thanks, take care."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 309.11,
      "end_seconds": 310.56,
      "duration_seconds": 1.45,
      "text": "Goodbye for now."
    }
  ]
}