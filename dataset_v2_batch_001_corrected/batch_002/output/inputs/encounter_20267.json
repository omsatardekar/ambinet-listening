{
  "schema_version": "1.0",
  "encounter_id": "20267",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.7,
      "end_seconds": 5.2,
      "duration_seconds": 4.5,
      "text": "Hi, doctor, I hope I'm not disturbing you."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.32,
      "end_seconds": 10.46,
      "duration_seconds": 4.14,
      "text": "No problem at all, come in. What's troubling you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 13.85,
      "end_seconds": 17.71,
      "duration_seconds": 3.86,
      "text": "I've been dealing with a chesty cough."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 19.03,
      "end_seconds": 20.98,
      "duration_seconds": 1.95,
      "text": "Did it come on recently?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 21.5,
      "end_seconds": 24.85,
      "duration_seconds": 3.35,
      "text": "It's been ten days, I'm fairly sure."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 25.56,
      "end_seconds": 30.43,
      "duration_seconds": 4.87,
      "text": "Okay, give me more detail on it, whatever comes to mind."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 31.93,
      "end_seconds": 40.94,
      "duration_seconds": 9.01,
      "text": "Yes, mornings. That makes it worse. It's a few times a day. About a three out of ten."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 42.64,
      "end_seconds": 46.96,
      "duration_seconds": 4.32,
      "text": "Let me get the readings out of the way."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 57.29,
      "end_seconds": 59.64,
      "duration_seconds": 2.35,
      "text": "Bear with me while this finishes..."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 79.71,
      "end_seconds": 87.98,
      "duration_seconds": 8.27,
      "text": "Okay: temperature 37.6, pressure 125 over 86, respiratory rate 24. And oxygen saturation is 91 percent, pulse 84."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 89.28,
      "end_seconds": 90.88,
      "duration_seconds": 1.6,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 92.11,
      "end_seconds": 94.12,
      "duration_seconds": 2.01,
      "text": "We'll go over that shortly."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 95.2,
      "end_seconds": 99.68,
      "duration_seconds": 4.48,
      "text": "I'll need to examine you for this, it won't take long."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 101.03,
      "end_seconds": 103.59,
      "duration_seconds": 2.56,
      "text": "Alright, I'm just checking this side."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 113.98,
      "end_seconds": 117.95,
      "duration_seconds": 3.97,
      "text": "There are scattered wheezes on both sides and no crackles."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 121.52,
      "end_seconds": 124.04,
      "duration_seconds": 2.52,
      "text": "That's all I needed to check."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 142.54,
      "end_seconds": 148.32,
      "duration_seconds": 5.78,
      "text": "Let me check a few things. Any leg swelling, ankle swelling or weight loss?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 149.44,
      "end_seconds": 153.22,
      "duration_seconds": 3.78,
      "text": "No, I haven't had any of them."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 154.04,
      "end_seconds": 156.38,
      "duration_seconds": 2.34,
      "text": "Any trouble with the waterworks?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 159.96,
      "end_seconds": 161.6,
      "duration_seconds": 1.64,
      "text": "No changes there."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 162.51,
      "end_seconds": 166.23,
      "duration_seconds": 3.72,
      "text": "Tell me about any past illnesses or ongoing conditions."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 167.45,
      "end_seconds": 171.95,
      "duration_seconds": 4.5,
      "text": "I've had COPD, yes. I've got high blood pressure."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 173.66,
      "end_seconds": 175.08,
      "duration_seconds": 1.42,
      "text": "Do you smoke?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 177.36,
      "end_seconds": 181.21,
      "duration_seconds": 3.85,
      "text": "I quit smoking around ten years ago."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 181.78,
      "end_seconds": 185.98,
      "duration_seconds": 4.2,
      "text": "What does a normal day of food look like?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 187.69,
      "end_seconds": 191.04,
      "duration_seconds": 3.35,
      "text": "Lots of rice, lentils and some fruit."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 191.68,
      "end_seconds": 194.95,
      "duration_seconds": 3.27,
      "text": "Are you in work at the moment?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 195.65,
      "end_seconds": 200.18,
      "duration_seconds": 4.53,
      "text": "Yes, I work in a bakery, early starts."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 200.87,
      "end_seconds": 203.75,
      "duration_seconds": 2.88,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 204.51,
      "end_seconds": 207.41,
      "duration_seconds": 2.9,
      "text": "No, I've never been operated on."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 214.79,
      "end_seconds": 222.42,
      "duration_seconds": 7.63,
      "text": "Which medicines do you take at the moment? These questions might sound routine, but they matter."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 226.43,
      "end_seconds": 230.79,
      "duration_seconds": 4.36,
      "text": "It's Tiotropium inhaler, once a day. Hydrochlorothiazide, every morning."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 231.51,
      "end_seconds": 233.54,
      "duration_seconds": 2.03,
      "text": "Do you know the dose?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 234.98,
      "end_seconds": 242.54,
      "duration_seconds": 7.56,
      "text": "It's 12.5 milligrams. Dolo. I take it 650 milligrams, when I get the fever."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 243.52,
      "end_seconds": 263.18,
      "duration_seconds": 19.66,
      "text": "Let me tell you where I've got to. This is probably an infective exacerbation of chronic lung disease. Let me just check I've got this right. You've had a chesty cough for ten days, and no weight loss or ankle swelling."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 264.93,
      "end_seconds": 266.6,
      "duration_seconds": 1.67,
      "text": "That's it, yes."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 282.33,
      "end_seconds": 299.26,
      "duration_seconds": 16.93,
      "text": "I want a chest X-ray done, that's for productive cough. I'll request a sputum sample, it'll help with purulent sputum. I'm prescribing prednisolone, 30 milligrams, once a day, for five days. That's for flare of lung disease."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 300.04,
      "end_seconds": 304.42,
      "duration_seconds": 4.38,
      "text": "Should I carry on if I feel better?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 305.52,
      "end_seconds": 315.63,
      "duration_seconds": 10.11,
      "text": "Keep using your inhaler as before and drink plenty of fluids. If you smoke, this is a good moment to stop, and we can help."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 316.01,
      "end_seconds": 324.24,
      "duration_seconds": 8.23,
      "text": "Yes. See me again if it hasn't settled in a week. Anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 325.7,
      "end_seconds": 328.91,
      "duration_seconds": 3.21,
      "text": "I think I understand everything. Thanks."
    }
  ]
}