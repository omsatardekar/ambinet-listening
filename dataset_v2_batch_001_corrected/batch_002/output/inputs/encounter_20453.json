{
  "schema_version": "1.0",
  "encounter_id": "20453",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.86,
      "end_seconds": 2.56,
      "duration_seconds": 1.7,
      "text": "Good afternoon, doctor."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 3.24,
      "end_seconds": 7.76,
      "duration_seconds": 4.52,
      "text": "Yes, come in and sit down. What brings you here today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 8.92,
      "end_seconds": 19.67,
      "duration_seconds": 10.75,
      "text": "doctor, thank you for seeing us it's red, cracked skin on my hands, doctor he didn't want to come, but I insisted"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 20.95,
      "end_seconds": 24.38,
      "duration_seconds": 3.43,
      "text": "What's the timeline, when did it begin?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 26.06,
      "end_seconds": 31.64,
      "duration_seconds": 5.58,
      "text": "Okay, so it's been two years, I'm fairly sure."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 32.89,
      "end_seconds": 35.02,
      "duration_seconds": 2.13,
      "text": "Is anything making it worse?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 35.74,
      "end_seconds": 38.34,
      "duration_seconds": 2.6,
      "text": "Ah, it's worse with gloves."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 39.04,
      "end_seconds": 45.89,
      "duration_seconds": 6.85,
      "text": "I was just going to say that the main thing is—"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_4",
      "role": "NURSE",
      "start_seconds": 45.99,
      "end_seconds": 52.46,
      "duration_seconds": 6.47,
      "text": "Sorry to cut in, doctor, quick question: shall I bring the trolley in now or later?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 53.94,
      "end_seconds": 61.18,
      "duration_seconds": 7.24,
      "text": "later, thanks. Please go on. What about stinging when you wash up, have you noticed that?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 61.86,
      "end_seconds": 63.17,
      "duration_seconds": 1.31,
      "text": "Yes, actually."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 64.72,
      "end_seconds": 68.54,
      "duration_seconds": 3.82,
      "text": "Is it a lot or only a little?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 69.99,
      "end_seconds": 76.32,
      "duration_seconds": 6.33,
      "text": "It's mild, honestly. Let me think, there's dry flaky skin as well."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 78.35,
      "end_seconds": 80.48,
      "duration_seconds": 2.13,
      "text": "right, anything that improves it?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 82.14,
      "end_seconds": 84.53,
      "duration_seconds": 2.39,
      "text": "Moisturiser helps a bit"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 85.83,
      "end_seconds": 89.02,
      "duration_seconds": 3.19,
      "text": "is it a lot or only a little?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 90.9,
      "end_seconds": 97.04,
      "duration_seconds": 6.14,
      "text": "Maybe a five out of ten on a bad day."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 98.22,
      "end_seconds": 99.91,
      "duration_seconds": 1.69,
      "text": "Have you had itching?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 100.42,
      "end_seconds": 105.07,
      "duration_seconds": 4.65,
      "text": "Yes, you know, about the same, two years."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 105.93,
      "end_seconds": 108.25,
      "duration_seconds": 2.32,
      "text": "so, anything that improves it?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 109.12,
      "end_seconds": 113.05,
      "duration_seconds": 3.93,
      "text": "Um, a cool cloth helps a bit."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 114.49,
      "end_seconds": 121.0,
      "duration_seconds": 6.51,
      "text": "Have you had red, cracked skin on your hands before, or is this the first time?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 122.67,
      "end_seconds": 129.54,
      "duration_seconds": 6.87,
      "text": "I had a similar thing about six months ago. It went away"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_5",
      "role": "UNKNOWN",
      "start_seconds": 130.21,
      "end_seconds": 132.17,
      "duration_seconds": 1.96,
      "text": "Yes, exactly like that."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 133.96,
      "end_seconds": 135.39,
      "duration_seconds": 1.43,
      "text": "What about fever?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 136.42,
      "end_seconds": 140.02,
      "duration_seconds": 3.6,
      "text": "No, I haven't had any fever."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 141.88,
      "end_seconds": 148.26,
      "duration_seconds": 6.38,
      "text": "have you noticed joint pain, oozing, rash elsewhere or new soap or cream?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 148.77,
      "end_seconds": 157.47,
      "duration_seconds": 8.7,
      "text": "I, I haven't had joint pain, oozing, rash elsewhere or new soap or cream, no."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 159.05,
      "end_seconds": 163.34,
      "duration_seconds": 4.29,
      "text": "any pins and needles or loss of strength anywhere?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 165.27,
      "end_seconds": 167.83,
      "duration_seconds": 2.56,
      "text": "no, that's all normal"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 186.66,
      "end_seconds": 191.78,
      "duration_seconds": 5.12,
      "text": "Are you allergic to anything? Any allergies to medicines or foods?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 195.8,
      "end_seconds": 200.0,
      "duration_seconds": 4.2,
      "text": "I'm allergic to milk, I get stomach cramps."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 202.08,
      "end_seconds": 205.77,
      "duration_seconds": 3.69,
      "text": "any health conditions I should have on record?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 210.8,
      "end_seconds": 222.57,
      "duration_seconds": 11.77,
      "text": "I, I have eczema. I'd rather know what's going on than keep guessing. Work has been very busy so I kept ignoring it."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 223.23,
      "end_seconds": 226.65,
      "duration_seconds": 3.42,
      "text": "what line of work are you in?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 228.27,
      "end_seconds": 233.45,
      "duration_seconds": 5.18,
      "text": "I'm a bus driver, so I sit for long hours."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 242.05,
      "end_seconds": 245.57,
      "duration_seconds": 3.52,
      "text": "Do you take any prescribed or over-the-counter medicines?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 247.14,
      "end_seconds": 252.41,
      "duration_seconds": 5.27,
      "text": "I take hydrocortisone cream, when needed for the eczema."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 253.54,
      "end_seconds": 262.26,
      "duration_seconds": 8.72,
      "text": "It's, It's meant to to be when needed, though I don't see he take it every time."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 263.3,
      "end_seconds": 268.95,
      "duration_seconds": 5.65,
      "text": "okay, so I take moisturiser, several times a day"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_4",
      "role": "NURSE",
      "start_seconds": 269.57,
      "end_seconds": 278.66,
      "duration_seconds": 9.09,
      "text": "Okay, so the vitals from earlier. Pulse 80, temp 36.7 degrees, saturation 97 percent, respiratory rate 17, blood pressure 108 over 73."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 279.99,
      "end_seconds": 280.69,
      "duration_seconds": 0.7,
      "text": "thanks"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 282.96,
      "end_seconds": 286.59,
      "duration_seconds": 3.63,
      "text": "alright, over here please and I'll take a look"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 287.86,
      "end_seconds": 288.96,
      "duration_seconds": 1.1,
      "text": "sure thing"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 290.4,
      "end_seconds": 293.11,
      "duration_seconds": 2.71,
      "text": "I'll listen to your chest now."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 311.49,
      "end_seconds": 318.34,
      "duration_seconds": 6.85,
      "text": "The skin on both hands is red, dry and cracked in the finger creases, with no weeping."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 319.53,
      "end_seconds": 320.71,
      "duration_seconds": 1.18,
      "text": "Of course."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 326.64,
      "end_seconds": 343.64,
      "duration_seconds": 17.0,
      "text": "Good, you can sit up again. Let's get a patch test, for dermatitis. Use gloves for washing up and moisturise straight after you dry your hands. If the symptoms get worse, or you feel really unwell, please come to the emergency department."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 344.67,
      "end_seconds": 345.68,
      "duration_seconds": 1.01,
      "text": "I understand."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 346.78,
      "end_seconds": 355.49,
      "duration_seconds": 8.71,
      "text": "please come and see me if it hasn't settled in two weeks have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 356.41,
      "end_seconds": 358.67,
      "duration_seconds": 2.26,
      "text": "Thank you, doctor, goodbye."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 359.46,
      "end_seconds": 360.75,
      "duration_seconds": 1.29,
      "text": "See you soon."
    }
  ]
}