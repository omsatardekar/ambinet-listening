  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.7,
      "end_seconds": 4.19,
      "duration_seconds": 3.49,
      "text": "Morning, doctor. Is this the right room?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.26,
      "end_seconds": 10.83,
      "duration_seconds": 4.57,
      "text": "yes, come in and sit down what brings you here today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 12.77,
      "end_seconds": 19.0,
      "duration_seconds": 6.23,
      "text": "yeah, it's a cut on my finger. I don't know what's causing it"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 20.71,
      "end_seconds": 23.73,
      "duration_seconds": 3.02,
      "text": "How long has this been bothering you?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 24.38,
      "end_seconds": 26.63,
      "duration_seconds": 2.25,
      "text": "About... well, five days."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 27.31,
      "end_seconds": 29.29,
      "duration_seconds": 1.98,
      "text": "Does anything set it off?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 30.98,
      "end_seconds": 33.69,
      "duration_seconds": 2.71,
      "text": "Gripping definitely sets it it off."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 34.55,
      "end_seconds": 36.78,
      "duration_seconds": 2.23,
      "text": "Any other symptoms with it?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 38.84,
      "end_seconds": 43.03,
      "duration_seconds": 4.19,
      "text": "It It usually comes with difficulty bending the finger."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 44.91,
      "end_seconds": 47.06,
      "duration_seconds": 2.15,
      "text": "Has there been bleeding too?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 48.08,
      "end_seconds": 51.67,
      "duration_seconds": 3.59,
      "text": "Right, yeah. Three days, I'd say."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 53.33,
      "end_seconds": 56.96,
      "duration_seconds": 3.63,
      "text": "let me get the readings out of the way"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 63.83,
      "end_seconds": 66.17,
      "duration_seconds": 2.34,
      "text": "sit still for a moment.."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 77.67,
      "end_seconds": 87.62,
      "duration_seconds": 9.95,
      "text": "Okay: pressure 128 over 76, oxygen saturation is 98 percent, temp 36.5 degrees. And pulse is 80 beats a minute."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 89.57,
      "end_seconds": 91.1,
      "duration_seconds": 1.53,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 91.95,
      "end_seconds": 94.55,
      "duration_seconds": 2.6,
      "text": "we'll look at it together shortly"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 96.49,
      "end_seconds": 100.18,
      "duration_seconds": 3.69,
      "text": "I'll examine you in a second, make yourself comfortable."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 102.24,
      "end_seconds": 104.85,
      "duration_seconds": 2.61,
      "text": "Yes, um, that's fine."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 106.68,
      "end_seconds": 109.74,
      "duration_seconds": 3.06,
      "text": "Okay, I'm just checking this side."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 118.61,
      "end_seconds": 126.86,
      "duration_seconds": 8.25,
      "text": "There is a two-centimetre clean cut over the first knuckle, the finger moves fully and the fingertip feels normal."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 132.13,
      "end_seconds": 136.22,
      "duration_seconds": 4.09,
      "text": "That's all I needed to check. Any sign of fever?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 137.66,
      "end_seconds": 139.31,
      "duration_seconds": 1.65,
      "text": "No. No fever."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 140.73,
      "end_seconds": 145.22,
      "duration_seconds": 4.49,
      "text": "any dirt in the wound, bite or redness spreading?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 148.34,
      "end_seconds": 155.36,
      "duration_seconds": 7.02,
      "text": "I haven't had dirt in the wound, bite or redness spreading, no"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 156.18,
      "end_seconds": 159.83,
      "duration_seconds": 3.65,
      "text": "What about your tummy and bowels, anything unusual there?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 161.45,
      "end_seconds": 164.0,
      "duration_seconds": 2.55,
      "text": "No, that side's been fine."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 181.07,
      "end_seconds": 185.0,
      "duration_seconds": 3.93,
      "text": "Do you react to any medicines or foods? Any allergies?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 186.15,
      "end_seconds": 189.44,
      "duration_seconds": 3.29,
      "text": "Yes, milk. I get stomach cramps."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 194.53,
      "end_seconds": 198.32,
      "duration_seconds": 3.79,
      "text": "which medicines do you take at the moment?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 202.83,
      "end_seconds": 223.27,
      "duration_seconds": 20.44,
      "text": "I'm on naproxen, 250 milligrams, twice a day for the knee pain. Work has been very busy so I kept ignoring it. I just wanna get back to normal, really. Apixaban. I take it 5 milligrams, twice a day for the heart rhythm."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 237.31,
      "end_seconds": 239.85,
      "duration_seconds": 2.54,
      "text": "Do you have any chronic illnesses?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 241.09,
      "end_seconds": 243.92,
      "duration_seconds": 2.83,
      "text": "I have arthritis in my knees."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 245.78,
      "end_seconds": 246.67,
      "duration_seconds": 0.89,
      "text": "I follow"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 248.14,
      "end_seconds": 251.52,
      "duration_seconds": 3.38,
      "text": "An irregular heartbeat, for about ten years."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 258.73,
      "end_seconds": 261.61,
      "duration_seconds": 2.88,
      "text": "Are you on your own at home?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 262.38,
      "end_seconds": 265.41,
      "duration_seconds": 3.03,
      "text": "I live with my elderly mother"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 270.69,
      "end_seconds": 272.16,
      "duration_seconds": 1.47,
      "text": "Are you active?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 272.67,
      "end_seconds": 275.79,
      "duration_seconds": 3.12,
      "text": "I walk the dog every morning."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 277.65,
      "end_seconds": 279.87,
      "duration_seconds": 2.22,
      "text": "tell me about your eating"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 281.75,
      "end_seconds": 287.23,
      "duration_seconds": 5.48,
      "text": "I drink a lot of tea and snack through the day"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 287.74,
      "end_seconds": 296.71,
      "duration_seconds": 8.97,
      "text": "Okay, thinking it through, this is probably a clean finger laceration without nerve or tendon injury. We shouldn't forget an infected wound."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 297.31,
      "end_seconds": 300.5,
      "duration_seconds": 3.19,
      "text": "what are the odds it's serious?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 301.49,
      "end_seconds": 324.18,
      "duration_seconds": 22.69,
      "text": "Nothing I've seen today points to an emergency. It looks like a clean finger laceration without nerve or tendon injury, but I'd like to confirm. Let's book an X-ray of the finger to look into laceration. For this, tetanus booster, 0.5 ml, once, for one day. It's for tetanus prevention."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 325.11,
      "end_seconds": 327.46,
      "duration_seconds": 2.35,
      "text": "fine, I'll begin it"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 328.4,
      "end_seconds": 342.91,
      "duration_seconds": 14.51,
      "text": "Keep the dressing dry for two days and watch for redness or pus. If the wound becomes red, hot or swollen, that's the point to come in urgently. I'd like you back in five days."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 344.54,
      "end_seconds": 346.6,
      "duration_seconds": 2.06,
      "text": "Okay, I'll arrange it."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 348.5,
      "end_seconds": 352.36,
      "duration_seconds": 3.86,
      "text": "anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 358.08,
      "end_seconds": 359.58,
      "duration_seconds": 1.5,
      "text": "That's clear, thanks."
    }
  ]
