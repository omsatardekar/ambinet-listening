{
  "schema_version": "1.0",
  "encounter_id": "20092",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.18,
      "end_seconds": 5.89,
      "duration_seconds": 4.71,
      "text": "Hi, is it okay to come in now?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 12.19,
      "end_seconds": 15.94,
      "duration_seconds": 3.75,
      "text": "That's fine, sit down. Tell me why you came."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 17.18,
      "end_seconds": 25.85,
      "duration_seconds": 8.67,
      "text": "So the thing is, I've got swollen ankles. My sister suggested writing things down, but I forgot."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 27.81,
      "end_seconds": 31.67,
      "duration_seconds": 3.86,
      "text": "How many days or weeks has it been?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 32.76,
      "end_seconds": 35.69,
      "duration_seconds": 2.93,
      "text": "About... well, about three months."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 37.77,
      "end_seconds": 40.16,
      "duration_seconds": 2.39,
      "text": "Is it constant or in episodes?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 41.86,
      "end_seconds": 45.16,
      "duration_seconds": 3.3,
      "text": "It's once or twice a day."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 46.38,
      "end_seconds": 49.13,
      "duration_seconds": 2.75,
      "text": "Have you been putting on weight quickly?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 50.74,
      "end_seconds": 58.49,
      "duration_seconds": 7.75,
      "text": "Well, yes, for two years. I've had breathlessness lying flat too, for about a month."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 62.73,
      "end_seconds": 66.53,
      "duration_seconds": 3.8,
      "text": "Is it a lot or only a little?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 68.75,
      "end_seconds": 73.84,
      "duration_seconds": 5.09,
      "text": "Maybe a three out of ten on a bad day."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 74.46,
      "end_seconds": 78.95,
      "duration_seconds": 4.49,
      "text": "Have you noticed fever, chest pain or calf pain?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 80.47,
      "end_seconds": 88.28,
      "duration_seconds": 7.81,
      "text": "So, uh, no fever, chest pain or calf pain, none of it."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 92.81,
      "end_seconds": 96.81,
      "duration_seconds": 4.0,
      "text": "Alright, have you noticed cough with blood or palpitations?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 97.81,
      "end_seconds": 102.34,
      "duration_seconds": 4.53,
      "text": "No cough with blood or palpitations, none of it."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 104.17,
      "end_seconds": 106.7,
      "duration_seconds": 2.53,
      "text": "Any rashes or skin problems otherwise?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 107.43,
      "end_seconds": 108.51,
      "duration_seconds": 1.08,
      "text": "Skin's normal."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 109.15,
      "end_seconds": 113.62,
      "duration_seconds": 4.47,
      "text": "Alright, what do you take on a normal day?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 115.5,
      "end_seconds": 125.08,
      "duration_seconds": 9.58,
      "text": "It's furosemide, 40 milligrams, every morning for the fluid. I'm, I'm on amlodipine, 5 milligrams, once a day."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 127.16,
      "end_seconds": 129.76,
      "duration_seconds": 2.6,
      "text": "Now some background about your lifestyle."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 130.26,
      "end_seconds": 140.41,
      "duration_seconds": 10.15,
      "text": "I do a yoga class on Thursdays. I'm a plumber, lots of bending and kneeling. My partner and our baby."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 151.72,
      "end_seconds": 156.61,
      "duration_seconds": 4.89,
      "text": "Any inherited conditions that you know of in the family?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 158.55,
      "end_seconds": 162.04,
      "duration_seconds": 3.49,
      "text": "My mother has an underactive thyroid."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 177.29,
      "end_seconds": 179.67,
      "duration_seconds": 2.38,
      "text": "Have you been to theatre before?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 181.32,
      "end_seconds": 185.75,
      "duration_seconds": 4.43,
      "text": "Just my septum straightened, in my thirties."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 191.32,
      "end_seconds": 195.35,
      "duration_seconds": 4.03,
      "text": "Anything in your past medical history I should know?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 196.23,
      "end_seconds": 201.11,
      "duration_seconds": 4.88,
      "text": "Erm, I've had heart failure for two years now."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 202.32,
      "end_seconds": 204.32,
      "duration_seconds": 2.0,
      "text": "Right, and besides that?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 205.18,
      "end_seconds": 211.98,
      "duration_seconds": 6.8,
      "text": "I've, I've got high blood pressure. I've been putting this off for weeks."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 214.01,
      "end_seconds": 218.61,
      "duration_seconds": 4.6,
      "text": "Do you react to any medicines or foods? Any allergies?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 220.62,
      "end_seconds": 224.8,
      "duration_seconds": 4.18,
      "text": "Okay, so not to my knowledge, no."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 232.23,
      "end_seconds": 235.97,
      "duration_seconds": 3.74,
      "text": "Let me get the readings out of the way."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 245.76,
      "end_seconds": 248.31,
      "duration_seconds": 2.55,
      "text": "That's it, just a little longer..."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 268.42,
      "end_seconds": 282.92,
      "duration_seconds": 14.5,
      "text": "Okay: weight 54 kilos, blood pressure 115 over 75, height 175 centimetres, pulse is 115 beats a minute, respiratory rate 19, oxygen saturation is 98 percent, BMI works out to 17.6, temperature 36.9."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 285.7,
      "end_seconds": 290.64,
      "duration_seconds": 4.94,
      "text": "Alright, I'll examine you in a second, make yourself comfortable."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 291.92,
      "end_seconds": 295.49,
      "duration_seconds": 3.57,
      "text": "Right, stay as you are for a moment."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 311.38,
      "end_seconds": 313.45,
      "duration_seconds": 2.07,
      "text": "Your neck veins look raised."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 316.8,
      "end_seconds": 334.85,
      "duration_seconds": 18.05,
      "text": "That's all I needed to check. Putting it all together, it fits best with fluid overload from heart failure. The reason I say that is that your story and my examination fit together. We shouldn't forget a chest infection."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 335.41,
      "end_seconds": 337.87,
      "duration_seconds": 2.46,
      "text": "Will it clear up?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 339.81,
      "end_seconds": 354.76,
      "duration_seconds": 14.95,
      "text": "It's reasonable to be concerned, but right now fluid overload from heart failure is my leading thought, not anything worse. I'm sending you for blood tests because of fluid overload."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 356.4,
      "end_seconds": 360.23,
      "duration_seconds": 3.83,
      "text": "I can book that for Friday at 11:30 am."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 360.91,
      "end_seconds": 365.36,
      "duration_seconds": 4.45,
      "text": "I'll request a chest X-ray, it'll help with breathlessness."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 367.02,
      "end_seconds": 370.09,
      "duration_seconds": 3.07,
      "text": "Where would I go for that?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 370.64,
      "end_seconds": 393.03,
      "duration_seconds": 22.39,
      "text": "Weigh yourself every morning and tell us if you gain more than two kilos in three days. The thing that would worry me is if you become more breathless or gain weight quickly. If that happens, go to emergency. Right, I think we're done unless you have questions."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 394.82,
      "end_seconds": 399.65,
      "duration_seconds": 4.83,
      "text": "Good, uh, thanks, I'll see you then."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 401.41,
      "end_seconds": 402.79,
      "duration_seconds": 1.38,
      "text": "Look after yourself."
    }
  ]
}