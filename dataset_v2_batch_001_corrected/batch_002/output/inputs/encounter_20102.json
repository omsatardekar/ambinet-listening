{
  "schema_version": "1.0",
  "encounter_id": "20102",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 0.92,
      "end_seconds": 9.26,
      "duration_seconds": 8.34,
      "text": "Doctor, the patient's with us now. I did the usual checks at the front, so just say when you want them."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 10.27,
      "end_seconds": 15.05,
      "duration_seconds": 4.78,
      "text": "Great. Hello, come in and sit down. How can I help?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 16.08,
      "end_seconds": 18.63,
      "duration_seconds": 2.55,
      "text": "It's a bloated tummy, mostly."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 20.25,
      "end_seconds": 24.1,
      "duration_seconds": 3.85,
      "text": "Okay, would you say mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 25.82,
      "end_seconds": 45.65,
      "duration_seconds": 19.83,
      "text": "It's moderate, honestly. As for hard small stools, I honestly can't say when that began. It might have been last month or the month before. I've also had not opening my bowels, for two years."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 46.51,
      "end_seconds": 60.37,
      "duration_seconds": 13.86,
      "text": "Doctor, I've got the readings for you. Temp 36.4 degrees, BP is 128 over 77, SpO2 99 percent on room air, height 182 centimetres, weight 63 kilos, pulse 70."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 61.45,
      "end_seconds": 62.15,
      "duration_seconds": 0.7,
      "text": "Thanks."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 64.17,
      "end_seconds": 67.07,
      "duration_seconds": 2.9,
      "text": "Okay, time for me to examine you."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 68.03,
      "end_seconds": 70.08,
      "duration_seconds": 2.05,
      "text": "Hold that for a second."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 86.94,
      "end_seconds": 91.99,
      "duration_seconds": 5.05,
      "text": "There is firm stool in the left lower abdomen and no mass."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 97.62,
      "end_seconds": 99.59,
      "duration_seconds": 1.97,
      "text": "All finished, thank you."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 111.34,
      "end_seconds": 115.88,
      "duration_seconds": 4.54,
      "text": "A few quick ones: passing wind, vomiting or weight loss?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 117.9,
      "end_seconds": 121.46,
      "duration_seconds": 3.56,
      "text": "No, I haven't had any of them."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 122.95,
      "end_seconds": 125.44,
      "duration_seconds": 2.49,
      "text": "Have you had any black stools?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 125.97,
      "end_seconds": 128.13,
      "duration_seconds": 2.16,
      "text": "No, no black stools."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 128.39,
      "end_seconds": 131.67,
      "duration_seconds": 3.28,
      "text": "Ah. Has your heart given you any trouble?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 132.54,
      "end_seconds": 134.46,
      "duration_seconds": 1.92,
      "text": "No, that's been fine."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 135.93,
      "end_seconds": 139.68,
      "duration_seconds": 3.75,
      "text": "Tell me about any past illnesses or ongoing conditions."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 140.25,
      "end_seconds": 144.89,
      "duration_seconds": 4.64,
      "text": "Arthritis in my knees, for nearly five years."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 146.58,
      "end_seconds": 148.05,
      "duration_seconds": 1.47,
      "text": "Yes, carry on."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 148.58,
      "end_seconds": 150.55,
      "duration_seconds": 1.97,
      "text": "Yes, an underactive thyroid."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 151.22,
      "end_seconds": 163.53,
      "duration_seconds": 12.31,
      "text": "Alright, an underactive thyroid, that matches what I have here. Are there any allergies I should be aware of? These questions might sound routine, but they matter."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 165.32,
      "end_seconds": 168.48,
      "duration_seconds": 3.16,
      "text": "Yes, milk. I get a rash."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 170.1,
      "end_seconds": 172.53,
      "duration_seconds": 2.43,
      "text": "Do you follow any particular diet?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 173.8,
      "end_seconds": 177.71,
      "duration_seconds": 3.91,
      "text": "I'm vegetarian and have been for years."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 179.41,
      "end_seconds": 183.23,
      "duration_seconds": 3.82,
      "text": "Alright, are you on your own at home?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 189.24,
      "end_seconds": 192.38,
      "duration_seconds": 3.14,
      "text": "I live with my elderly mother."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 194.31,
      "end_seconds": 196.82,
      "duration_seconds": 2.51,
      "text": "Anything you do to stay fit?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 198.81,
      "end_seconds": 202.48,
      "duration_seconds": 3.67,
      "text": "I do a yoga class on Thursdays."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 203.52,
      "end_seconds": 208.06,
      "duration_seconds": 4.54,
      "text": "Can you list what you take, tablets, creams or inhalers?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 212.81,
      "end_seconds": 218.74,
      "duration_seconds": 5.93,
      "text": "I'm on naproxen, 250 milligrams, twice a day for the knee pain."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 219.02,
      "end_seconds": 219.82,
      "duration_seconds": 0.8,
      "text": "I follow."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 221.39,
      "end_seconds": 226.21,
      "duration_seconds": 4.82,
      "text": "It's Thyronorm, 50 micrograms, every morning for my thyroid."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 228.17,
      "end_seconds": 230.94,
      "duration_seconds": 2.77,
      "text": "How long have you been on it?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 231.64,
      "end_seconds": 233.77,
      "duration_seconds": 2.13,
      "text": "About three months now."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 242.93,
      "end_seconds": 245.63,
      "duration_seconds": 2.7,
      "text": "Right, any surgery in the past?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 247.21,
      "end_seconds": 252.62,
      "duration_seconds": 5.41,
      "text": "I had my appendix taken out when I was in my twenties."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 269.08,
      "end_seconds": 275.41,
      "duration_seconds": 6.33,
      "text": "Putting it all together, it fits best with constipation, possibly related to diet or medicines."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 277.19,
      "end_seconds": 280.66,
      "duration_seconds": 3.47,
      "text": "Actually, what are the odds it's serious?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 281.21,
      "end_seconds": 311.29,
      "duration_seconds": 30.08,
      "text": "I can't promise yet, but most people with constipation, possibly related to diet or medicines do well once it's treated properly. I think blood tests makes sense here, for constipation. The result will help us decide whether anything more is needed. What I'm giving you is macrogol, 1 sachet, once a day, for two weeks. It's for constipation. I'll put all of this in writing so you don't have to remember it."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 313.23,
      "end_seconds": 328.98,
      "duration_seconds": 15.75,
      "text": "More fibre, plenty of water and a regular time on the toilet after breakfast. If it hasn't settled next month, we'd think about a blood count, but not now. See me again in three weeks."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 331.05,
      "end_seconds": 332.97,
      "duration_seconds": 1.92,
      "text": "Alright, I'll be back."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 334.65,
      "end_seconds": 340.35,
      "duration_seconds": 5.7,
      "text": "Let me check I've been clear. What will you do once you get home?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 342.26,
      "end_seconds": 353.26,
      "duration_seconds": 11.0,
      "text": "So, I take the macrogol, 1 sachet, once a day and come back in three weeks. Is that right?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 355.24,
      "end_seconds": 359.08,
      "duration_seconds": 3.84,
      "text": "Yes, exactly right. Have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 361.02,
      "end_seconds": 363.05,
      "duration_seconds": 2.03,
      "text": "Thank you, that's helpful."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 363.96,
      "end_seconds": 365.97,
      "duration_seconds": 2.01,
      "text": "Okay, goodbye for now."
    }
  ]
}