  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.23,
      "end_seconds": 4.66,
      "duration_seconds": 3.43,
      "text": "sorry, doctor, shall I sit here?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.69,
      "end_seconds": 10.38,
      "duration_seconds": 3.69,
      "text": "of course leave it there how can I help?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 11.11,
      "end_seconds": 20.74,
      "duration_seconds": 9.63,
      "text": "so the thing is, I've got a twisted ankle. I took the morning off to come in today"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 21.46,
      "end_seconds": 24.58,
      "duration_seconds": 3.12,
      "text": "when was the first time you noticed it?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 25.82,
      "end_seconds": 29.42,
      "duration_seconds": 3.6,
      "text": "it's been going on for one week"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 34.54,
      "end_seconds": 38.81,
      "duration_seconds": 4.27,
      "text": "Are there any allergies I should be aware of?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 40.15,
      "end_seconds": 42.17,
      "duration_seconds": 2.02,
      "text": "no allergies at all"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 54.04,
      "end_seconds": 56.61,
      "duration_seconds": 2.57,
      "text": "have you been to theatre before?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 58.35,
      "end_seconds": 62.52,
      "duration_seconds": 4.17,
      "text": "I had part of my thyroid removed years back"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 72.23,
      "end_seconds": 76.74,
      "duration_seconds": 4.51,
      "text": "Let's talk a little about your daily life and habits."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 77.7,
      "end_seconds": 93.05,
      "duration_seconds": 15.35,
      "text": "I used to drink heavily but I stopped four years ago. I quit smoking around ten years ago. Lots of rice, lentils and some fruit. Yes, I work in a bakery, early starts."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 108.52,
      "end_seconds": 112.38,
      "duration_seconds": 3.86,
      "text": "what do you take on a normal day?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 113.72,
      "end_seconds": 117.21,
      "duration_seconds": 3.49,
      "text": "I take ibuprofen 400 milligrams when needed."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 125.38,
      "end_seconds": 129.64,
      "duration_seconds": 4.26,
      "text": "right, any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 130.21,
      "end_seconds": 132.83,
      "duration_seconds": 2.62,
      "text": "right, no, nothing at all"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 134.45,
      "end_seconds": 140.65,
      "duration_seconds": 6.2,
      "text": "Have you noticed calf pain, cracking sound at the time or knee pain?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 141.18,
      "end_seconds": 143.25,
      "duration_seconds": 2.07,
      "text": "Nope, nothing like that."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 143.85,
      "end_seconds": 147.57,
      "duration_seconds": 3.72,
      "text": "Mm-hmm. Any rashes or skin problems otherwise?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 152.06,
      "end_seconds": 153.12,
      "duration_seconds": 1.06,
      "text": "no rashes"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 154.56,
      "end_seconds": 157.15,
      "duration_seconds": 2.59,
      "text": "Let me quickly check your readings."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 165.07,
      "end_seconds": 167.78,
      "duration_seconds": 2.71,
      "text": "That's it, just a little longer..."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 189.37,
      "end_seconds": 195.27,
      "duration_seconds": 5.9,
      "text": "okay: BP is 108 over 80 SpO2 97 percent on room air pulse 64."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 197.35,
      "end_seconds": 199.22,
      "duration_seconds": 1.87,
      "text": "Is that that normal?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 202.67,
      "end_seconds": 205.48,
      "duration_seconds": 2.81,
      "text": "We'll go over that that shortly."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 207.19,
      "end_seconds": 211.17,
      "duration_seconds": 3.98,
      "text": "Right, let's have a a proper look at you."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 212.49,
      "end_seconds": 214.92,
      "duration_seconds": 2.43,
      "text": "raise your arm for me"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 222.44,
      "end_seconds": 233.82,
      "duration_seconds": 11.38,
      "text": "There is swelling and bruising over the outer ankle and I can't find any bony tenderness at the the back of the ankle bone."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 235.18,
      "end_seconds": 236.29,
      "duration_seconds": 1.11,
      "text": "Sure thing."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 241.6,
      "end_seconds": 255.98,
      "duration_seconds": 14.38,
      "text": "please sit back down. Right, here's what I'm thinking. It fits best with an ankle sprain without signs of a fracture. That's my thinking for now, and it may change as we learn more"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 257.1,
      "end_seconds": 259.84,
      "duration_seconds": 2.74,
      "text": "what are the odds it's serious?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 260.55,
      "end_seconds": 275.9,
      "duration_seconds": 15.35,
      "text": "it's reasonable to be concerned, but right now an ankle sprain without signs of a fracture is my leading thought, not anything worse. I want an ankle X-ray done, that's for ankle injury"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 277.5,
      "end_seconds": 282.53,
      "duration_seconds": 5.03,
      "text": "we have a slot Tuesday at 11:30 am, if that works"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 284.23,
      "end_seconds": 298.71,
      "duration_seconds": 14.48,
      "text": "we'll begin with paracetamol, 1 gram, every six hours if needed, for five days that's for ankle pain rest, ice, a firm bandage and keep it raised, and start gentle movement after two days"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 298.99,
      "end_seconds": 303.36,
      "duration_seconds": 4.37,
      "text": "right, right i'm going to send a referral to physiotherapy"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 305.07,
      "end_seconds": 307.93,
      "duration_seconds": 2.86,
      "text": "Sure, where do I go?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 308.83,
      "end_seconds": 311.91,
      "duration_seconds": 3.08,
      "text": "I'll want another look in two weeks"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 312.85,
      "end_seconds": 317.34,
      "duration_seconds": 4.49,
      "text": "Um, you know, that's fine with me."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 318.1,
      "end_seconds": 322.03,
      "duration_seconds": 3.93,
      "text": "anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 323.03,
      "end_seconds": 325.81,
      "duration_seconds": 2.78,
      "text": "good thanks I'll see you then"
    }
  ]
}