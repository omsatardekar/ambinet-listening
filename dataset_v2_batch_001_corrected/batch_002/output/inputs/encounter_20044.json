{
  "schema_version": "1.0",
  "encounter_id": "20044",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.87,
      "end_seconds": 2.43,
      "duration_seconds": 1.56,
      "text": "Evening. Let's get started."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "CAREGIVER",
      "start_seconds": 3.64,
      "end_seconds": 8.22,
      "duration_seconds": 4.58,
      "text": "Morning, doctor. I'll stay and fill in anything that's missed."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 9.33,
      "end_seconds": 11.38,
      "duration_seconds": 2.05,
      "text": "Weather's turned, hasn't it?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 11.92,
      "end_seconds": 16.58,
      "duration_seconds": 4.66,
      "text": "It has. I got caught in the rain walking over."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 18.1,
      "end_seconds": 20.96,
      "duration_seconds": 2.86,
      "text": "What do you need help with?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 22.01,
      "end_seconds": 25.15,
      "duration_seconds": 3.14,
      "text": "I've been dealing with loud snoring."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 26.38,
      "end_seconds": 29.6,
      "duration_seconds": 3.22,
      "text": "Can you tell me when it first started?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 31.63,
      "end_seconds": 40.03,
      "duration_seconds": 8.4,
      "text": "It's been about a month, I'm fairly sure. I've been reading about it online and it worried me."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 41.39,
      "end_seconds": 45.17,
      "duration_seconds": 3.78,
      "text": "Have you been waking up with a headache?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 46.39,
      "end_seconds": 49.65,
      "duration_seconds": 3.26,
      "text": "Yes, about the same, two months."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 50.21,
      "end_seconds": 55.0,
      "duration_seconds": 4.79,
      "text": "Have you had loud snoring before, or is this the first time?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 56.24,
      "end_seconds": 63.44,
      "duration_seconds": 7.2,
      "text": "Yes, something like this happened last year, and it went away on its own."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 65.09,
      "end_seconds": 69.08,
      "duration_seconds": 3.99,
      "text": "What does a normal day of food look like?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 73.94,
      "end_seconds": 77.21,
      "duration_seconds": 3.27,
      "text": "Lots of rice, lentils and some fruit."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 78.01,
      "end_seconds": 79.65,
      "duration_seconds": 1.64,
      "text": "Who lives with you?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 80.24,
      "end_seconds": 82.71,
      "duration_seconds": 2.47,
      "text": "My partner and our baby."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 87.5,
      "end_seconds": 89.93,
      "duration_seconds": 2.43,
      "text": "Have you ever had an operation?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 93.67,
      "end_seconds": 111.87,
      "duration_seconds": 18.2,
      "text": "Just my appendix taken out, when I was in my twenties. A neighbour of mine said I should see someone about it. I didn't want to bother you but it keeps coming back."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 113.32,
      "end_seconds": 118.16,
      "duration_seconds": 4.84,
      "text": "Any allergies to tablets, food or anything in the environment?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 118.84,
      "end_seconds": 121.28,
      "duration_seconds": 2.44,
      "text": "I've never had an allergy."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 122.02,
      "end_seconds": 124.82,
      "duration_seconds": 2.8,
      "text": "What's on your current medicine list?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "CAREGIVER",
      "start_seconds": 126.54,
      "end_seconds": 130.89,
      "duration_seconds": 4.35,
      "text": "It's sitagliptin, 100 milligrams, once a day, doctor."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 146.95,
      "end_seconds": 154.6,
      "duration_seconds": 7.65,
      "text": "Has anyone ever diagnosed you with something? I ask because it helps me narrow things down."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 155.4,
      "end_seconds": 161.49,
      "duration_seconds": 6.09,
      "text": "Yes, diabetes. I just want to get back to normal, really."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 163.49,
      "end_seconds": 169.24,
      "duration_seconds": 5.75,
      "text": "I follow. Okay, I can see diabetes in your file as well."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 177.6,
      "end_seconds": 180.73,
      "duration_seconds": 3.13,
      "text": "Have you noticed chest pain or leg swelling?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 184.41,
      "end_seconds": 188.77,
      "duration_seconds": 4.36,
      "text": "I haven't had chest pain or leg swelling, no."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 190.44,
      "end_seconds": 196.12,
      "duration_seconds": 5.68,
      "text": "Have you noticed palpitations, choking at night or falling asleep while driving?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 199.04,
      "end_seconds": 200.95,
      "duration_seconds": 1.91,
      "text": "None of those, no."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 201.88,
      "end_seconds": 205.42,
      "duration_seconds": 3.54,
      "text": "How are your joints, any aches elsewhere?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 207.2,
      "end_seconds": 209.11,
      "duration_seconds": 1.91,
      "text": "No, joints are fine."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 210.33,
      "end_seconds": 213.25,
      "duration_seconds": 2.92,
      "text": "Right, anything unusual with passing urine?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 215.22,
      "end_seconds": 218.06,
      "duration_seconds": 2.84,
      "text": "Um, no, that's all fine."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 234.96,
      "end_seconds": 237.29,
      "duration_seconds": 2.33,
      "text": "I'll do your observations first."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 247.07,
      "end_seconds": 249.79,
      "duration_seconds": 2.72,
      "text": "Alright, sit still for a moment..."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 266.92,
      "end_seconds": 274.49,
      "duration_seconds": 7.57,
      "text": "Okay: saturation 97 percent, blood pressure 157 over 101, pulse is 73 beats a minute, respiratory rate 17."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 277.42,
      "end_seconds": 279.98,
      "duration_seconds": 2.56,
      "text": "So, may I examine you now?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 281.46,
      "end_seconds": 283.43,
      "duration_seconds": 1.97,
      "text": "Let me feel here."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 299.94,
      "end_seconds": 305.14,
      "duration_seconds": 5.2,
      "text": "Your neck is thick and the back of the throat looks crowded."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 307.12,
      "end_seconds": 308.09,
      "duration_seconds": 0.97,
      "text": "That's alright."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 311.47,
      "end_seconds": 329.64,
      "duration_seconds": 18.17,
      "text": "All finished, thank you. So, based on the history and the examination, this looks most like symptoms that suggest obstructive sleep apnoea. Poor sleep habits is also on my list. Let's book an overnight sleep study to look into suspected sleep apnoea."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 330.74,
      "end_seconds": 333.51,
      "duration_seconds": 2.77,
      "text": "When would that take place?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 335.1,
      "end_seconds": 358.04,
      "duration_seconds": 22.94,
      "text": "Let's get a thyroid test, for tiredness. The result will help us decide whether anything more is needed. Try to sleep on your side and avoid alcohol close to bedtime. One warning sign to remember: you feel sleepy while driving. In that case don't wait. I'd like you back after the sleep study."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 359.45,
      "end_seconds": 361.24,
      "duration_seconds": 1.79,
      "text": "I can manage that."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 363.01,
      "end_seconds": 365.74,
      "duration_seconds": 2.73,
      "text": "That's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 367.51,
      "end_seconds": 370.86,
      "duration_seconds": 3.35,
      "text": "Great, thank you for your help."
    }
  ]
}