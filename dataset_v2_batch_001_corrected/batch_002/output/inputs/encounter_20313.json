{
  "schema_version": "1.0",
  "encounter_id": "20313",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 0.93,
      "end_seconds": 7.72,
      "duration_seconds": 6.79,
      "text": "Doctor, your next patient is here. I've done the basics, I'll read them out in a moment."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.69,
      "end_seconds": 13.77,
      "duration_seconds": 5.08,
      "text": "Thanks. Hello, come in, sit down. What brings you in today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 14.71,
      "end_seconds": 17.78,
      "duration_seconds": 3.07,
      "text": "Doctor, thank you for seeing us."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 18.84,
      "end_seconds": 27.78,
      "duration_seconds": 8.94,
      "text": "So, So the thing is, I've got a tight feeling in my chest when I walk uphill."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 28.57,
      "end_seconds": 30.92,
      "duration_seconds": 2.35,
      "text": "Did it come on recently?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 31.82,
      "end_seconds": 45.62,
      "duration_seconds": 13.8,
      "text": "Mm, it's been six months, I'm fairly sure. My family kept telling me to get it checked. I told my wife I'd come today."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 47.62,
      "end_seconds": 55.64,
      "duration_seconds": 8.02,
      "text": "Can you describe it a bit more for me? How strong it is, what the pattern is, what helps."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 60.81,
      "end_seconds": 68.33,
      "duration_seconds": 7.52,
      "text": "Yes, walking uphill. That makes it worse. A eight out of ten, I suppose."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 68.96,
      "end_seconds": 75.24,
      "duration_seconds": 6.28,
      "text": "I was just going to say that the main thing is—"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 75.34,
      "end_seconds": 81.83,
      "duration_seconds": 6.49,
      "text": "Sorry to cut in, doctor, quick question: shall I bring the trolley in now or later?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 82.64,
      "end_seconds": 85.53,
      "duration_seconds": 2.89,
      "text": "Okay, later, thanks. Please go on."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 90.04,
      "end_seconds": 102.65,
      "duration_seconds": 12.61,
      "text": "And, And breathlessness on exertion, too. And there's a heaviness in my left arm as well, you know, about three months now."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 103.56,
      "end_seconds": 107.43,
      "duration_seconds": 3.87,
      "text": "Rate it for me, mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 113.57,
      "end_seconds": 116.29,
      "duration_seconds": 2.72,
      "text": "I, I'd call it moderate."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_5",
      "role": "UNKNOWN",
      "start_seconds": 117.43,
      "end_seconds": 120.16,
      "duration_seconds": 2.73,
      "text": "Mm, that's what happened, yes."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 121.6,
      "end_seconds": 131.26,
      "duration_seconds": 9.66,
      "text": "Doctor, I've got the readings for you. Pulse is 64 beats a minute, respiratory rate 15, pressure 117 over 79. Oxygen saturation is 99 percent."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 136.47,
      "end_seconds": 137.51,
      "duration_seconds": 1.04,
      "text": "Okay, noted."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 138.56,
      "end_seconds": 142.93,
      "duration_seconds": 4.37,
      "text": "Alright, over here please and I'll take a look."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 144.19,
      "end_seconds": 146.2,
      "duration_seconds": 2.01,
      "text": "Tell me if that's sore."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 153.28,
      "end_seconds": 158.4,
      "duration_seconds": 5.12,
      "text": "Heart sounds are normal, no murmur, and the chest is clear."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 159.59,
      "end_seconds": 161.77,
      "duration_seconds": 2.18,
      "text": "I'm just checking this side."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 171.66,
      "end_seconds": 174.59,
      "duration_seconds": 2.93,
      "text": "There is no swelling in your ankles."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 178.08,
      "end_seconds": 181.02,
      "duration_seconds": 2.94,
      "text": "Good, you can sit up again."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 195.9,
      "end_seconds": 199.31,
      "duration_seconds": 3.41,
      "text": "A few quick ones: ankle swelling or cough?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 204.65,
      "end_seconds": 207.77,
      "duration_seconds": 3.12,
      "text": "No, none of those at all."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 209.75,
      "end_seconds": 214.69,
      "duration_seconds": 4.94,
      "text": "Have you had any palpitations or pain between the shoulder blades?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 216.45,
      "end_seconds": 221.69,
      "duration_seconds": 5.24,
      "text": "No, no palpitations or pain between the shoulder blades."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 223.73,
      "end_seconds": 227.11,
      "duration_seconds": 3.38,
      "text": "Any fainting or pain at rest at all?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 228.41,
      "end_seconds": 232.08,
      "duration_seconds": 3.67,
      "text": "Uh, no, I'd have said so."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 232.92,
      "end_seconds": 235.48,
      "duration_seconds": 2.56,
      "text": "Anything different when you pass water?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 236.94,
      "end_seconds": 238.69,
      "duration_seconds": 1.75,
      "text": "Nothing there, no."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 240.65,
      "end_seconds": 242.85,
      "duration_seconds": 2.2,
      "text": "Is your mobility otherwise okay?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 243.9,
      "end_seconds": 248.9,
      "duration_seconds": 5.0,
      "text": "Let me think, uh, no, joints are fine."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 265.07,
      "end_seconds": 267.63,
      "duration_seconds": 2.56,
      "text": "Now some background about your lifestyle."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 268.93,
      "end_seconds": 283.4,
      "duration_seconds": 14.47,
      "text": "I gave up cigarettes last spring. I'll have a glass of wine with dinner. I look after my grandchildren most days. I live with my elderly mother."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 284.05,
      "end_seconds": 288.74,
      "duration_seconds": 4.69,
      "text": "Do you react to any medicines or foods? Any allergies?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 289.27,
      "end_seconds": 292.97,
      "duration_seconds": 3.7,
      "text": "I don't think I have any, no."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 297.86,
      "end_seconds": 306.41,
      "duration_seconds": 8.55,
      "text": "So, hold on, doctor, I think he reacted to amoxicillin once. I'm not certain, though."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 307.29,
      "end_seconds": 309.26,
      "duration_seconds": 1.97,
      "text": "I don't remember that."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 310.5,
      "end_seconds": 316.65,
      "duration_seconds": 6.15,
      "text": "Okay, I'll note both of those. Are you taking anything regularly, including from the pharmacy?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 317.37,
      "end_seconds": 321.97,
      "duration_seconds": 4.6,
      "text": "Atorvastatin. I take it 20 milligrams, at night."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 323.54,
      "end_seconds": 335.23,
      "duration_seconds": 11.69,
      "text": "I mean, doctor, I think the last prescription for the atorvastatin was 10 milligrams. We changed it at the last visit."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 336.78,
      "end_seconds": 342.05,
      "duration_seconds": 5.27,
      "text": "Okay. Have you got the newest prescription or the box with you?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 343.08,
      "end_seconds": 360.39,
      "duration_seconds": 17.31,
      "text": "I mean, not with me. I'll bring it next time. Sitagliptin, 100 milligrams, once a day for my sugar. Hmm, you know, I take metoprolol, 50 milligrams, twice a day."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 361.52,
      "end_seconds": 369.0,
      "duration_seconds": 7.48,
      "text": "Let me think, that's what's prescribed, but I'm not sure he takes it every day."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 370.71,
      "end_seconds": 383.12,
      "duration_seconds": 12.41,
      "text": "Let me think, I'm on pantoprazole, 40 milligrams, before breakfast for my acidity. Before this I was on ramipril; that's been stopped."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 384.68,
      "end_seconds": 388.08,
      "duration_seconds": 3.4,
      "text": "Has anyone ever diagnosed you with something?"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 389.16,
      "end_seconds": 398.57,
      "duration_seconds": 9.41,
      "text": "Oh, I have high cholesterol, for nearly five years. I've had diabetes for five years now."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 399.57,
      "end_seconds": 400.55,
      "duration_seconds": 0.98,
      "text": "Right, right."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 401.81,
      "end_seconds": 404.99,
      "duration_seconds": 3.18,
      "text": "I, I have high blood pressure."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 405.86,
      "end_seconds": 406.56,
      "duration_seconds": 0.7,
      "text": "Yes."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 407.67,
      "end_seconds": 409.5,
      "duration_seconds": 1.83,
      "text": "Yes, acid reflux."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 413.87,
      "end_seconds": 415.45,
      "duration_seconds": 1.58,
      "text": "Okay, what else?"
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 417.49,
      "end_seconds": 426.06,
      "duration_seconds": 8.57,
      "text": "Okay, I can see high cholesterol and high blood pressure in your file as well. Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 426.69,
      "end_seconds": 429.04,
      "duration_seconds": 2.35,
      "text": "No, not at all."
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 429.95,
      "end_seconds": 440.97,
      "duration_seconds": 11.02,
      "text": "Let me tell you where I've got to. It points towards exertional angina until proven otherwise. I can't rule out a muscle strain yet."
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 441.63,
      "end_seconds": 444.02,
      "duration_seconds": 2.39,
      "text": "Is it dangerous, doctor?"
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 445.3,
      "end_seconds": 470.27,
      "duration_seconds": 24.97,
      "text": "I understand the worry. At the moment I'd say it's exertional angina until proven otherwise, and we'll watch how it goes. If the tightness comes, stop, sit down and use the spray under your tongue. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0059",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 471.79,
      "end_seconds": 480.04,
      "duration_seconds": 8.25,
      "text": "Hmm, uh, could I get an ECG done? A friend had it."
    },
    {
      "segment_id": "SEG0060",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 481.32,
      "end_seconds": 492.71,
      "duration_seconds": 11.39,
      "text": "Not at this point, no. It isn't indicated yet. Book a review after the test results are back. Alright, that's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0061",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 493.43,
      "end_seconds": 496.72,
      "duration_seconds": 3.29,
      "text": "No, that's all. Thanks a lot."
    }
  ]
}