{
  "schema_version": "1.0",
  "encounter_id": "20205",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 1.02,
      "end_seconds": 5.31,
      "duration_seconds": 4.29,
      "text": "Ready for you, doctor. I'll stay in case you need anything."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 10.32,
      "end_seconds": 14.34,
      "duration_seconds": 4.02,
      "text": "Okay, thanks. Hi, how can I help today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 15.49,
      "end_seconds": 22.47,
      "duration_seconds": 6.98,
      "text": "Mainly wheezing. There's a couple of other things, but that's the main one."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 23.88,
      "end_seconds": 27.78,
      "duration_seconds": 3.9,
      "text": "How many days or weeks has it been?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 29.22,
      "end_seconds": 40.96,
      "duration_seconds": 11.74,
      "text": "About... well, two days. And a sore chest from coughing, too. With sore chest from coughing, I'd say once or twice a day."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 41.87,
      "end_seconds": 47.23,
      "duration_seconds": 5.36,
      "text": "Alright, and what about weight loss, ankle swelling or coughing up blood?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 48.68,
      "end_seconds": 54.41,
      "duration_seconds": 5.73,
      "text": "I haven't had weight loss, ankle swelling or coughing up blood, no."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 56.13,
      "end_seconds": 59.99,
      "duration_seconds": 3.86,
      "text": "Any pins and needles or loss of strength anywhere?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 60.52,
      "end_seconds": 62.08,
      "duration_seconds": 1.56,
      "text": "Nothing odd there."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 63.73,
      "end_seconds": 67.61,
      "duration_seconds": 3.88,
      "text": "Let me ask about allergies, anything at all?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 72.01,
      "end_seconds": 75.81,
      "duration_seconds": 3.8,
      "text": "I don't think I have any, no."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 87.64,
      "end_seconds": 90.01,
      "duration_seconds": 2.37,
      "text": "Do you have any long-term conditions?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 91.32,
      "end_seconds": 93.02,
      "duration_seconds": 1.7,
      "text": "I've got COPD."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 104.56,
      "end_seconds": 107.5,
      "duration_seconds": 2.94,
      "text": "Right, tell me your medicines, please."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 108.16,
      "end_seconds": 111.28,
      "duration_seconds": 3.12,
      "text": "It's Tiotropium inhaler, once a day."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 112.4,
      "end_seconds": 114.12,
      "duration_seconds": 1.72,
      "text": "Do you drink alcohol?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 116.09,
      "end_seconds": 119.43,
      "duration_seconds": 3.34,
      "text": "I only drink at family occasions."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 121.47,
      "end_seconds": 123.22,
      "duration_seconds": 1.75,
      "text": "How active are you?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 125.22,
      "end_seconds": 128.5,
      "duration_seconds": 3.28,
      "text": "I hardly move around during the day."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 129.9,
      "end_seconds": 132.54,
      "duration_seconds": 2.64,
      "text": "Do you work outside the home?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 134.61,
      "end_seconds": 138.37,
      "duration_seconds": 3.76,
      "text": "I'm a hairdresser, on my feet all day."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 140.21,
      "end_seconds": 143.13,
      "duration_seconds": 2.92,
      "text": "What operations have you had, if any?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 145.15,
      "end_seconds": 148.85,
      "duration_seconds": 3.7,
      "text": "Just part of my thyroid removed, years back."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 158.29,
      "end_seconds": 170.38,
      "duration_seconds": 12.09,
      "text": "Okay, so the vitals from earlier. Pulse is 98 beats a minute, temperature is 37.6 degrees, oxygen saturation is 89 percent. Respiratory rate 21, blood pressure 141 over 90."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 171.6,
      "end_seconds": 172.7,
      "duration_seconds": 1.1,
      "text": "Okay, noted."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 175.5,
      "end_seconds": 180.84,
      "duration_seconds": 5.34,
      "text": "Okay, I'll need to examine you for this, it won't take long."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 182.04,
      "end_seconds": 184.23,
      "duration_seconds": 2.19,
      "text": "I'm just checking this side."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 196.06,
      "end_seconds": 200.47,
      "duration_seconds": 4.41,
      "text": "There are scattered wheezes on both sides and no crackles."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 205.63,
      "end_seconds": 208.11,
      "duration_seconds": 2.48,
      "text": "That's all I needed to check."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 227.0,
      "end_seconds": 235.71,
      "duration_seconds": 8.71,
      "text": "Okay, so my impression is this: The most likely explanation is an infective exacerbation of chronic lung disease."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 237.57,
      "end_seconds": 240.2,
      "duration_seconds": 2.63,
      "text": "Mm, is this serious, doctor?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 241.97,
      "end_seconds": 262.76,
      "duration_seconds": 20.79,
      "text": "I can't promise yet, but most people with an infective exacerbation of chronic lung disease do well once it's treated properly. I'd like to arrange a sputum sample for purulent sputum. It's a routine test and it'll give us a much clearer picture."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 263.92,
      "end_seconds": 269.9,
      "duration_seconds": 5.98,
      "text": "Doctor, I did a chest X-ray before they came in, the result's on your screen."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 270.72,
      "end_seconds": 292.71,
      "duration_seconds": 21.99,
      "text": "Thanks, that helps. Let's use doxycycline, 100 milligrams, twice a day, for five days. It's for chest infection. Keep using your inhaler as before and drink plenty of fluids. If you become more breathless or your lips turn blue, that's the point to come in urgently."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 296.67,
      "end_seconds": 301.58,
      "duration_seconds": 4.91,
      "text": "Um, uh, I know what to watch for."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 302.63,
      "end_seconds": 309.02,
      "duration_seconds": 6.39,
      "text": "Let's plan a check in two weeks. That's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 310.15,
      "end_seconds": 313.68,
      "duration_seconds": 3.53,
      "text": "Erm, good, thanks, I'll see you then."
    }
  ]
}