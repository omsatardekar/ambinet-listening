{
  "schema_version": "1.0",
  "encounter_id": "20281",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.89,
      "end_seconds": 4.52,
      "duration_seconds": 3.63,
      "text": "Sorry, doctor, shall I sit here?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.45,
      "end_seconds": 9.61,
      "duration_seconds": 4.16,
      "text": "No problem at all, come in. What's troubling you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 11.49,
      "end_seconds": 14.73,
      "duration_seconds": 3.24,
      "text": "I'm here because of a sore throat."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 15.52,
      "end_seconds": 19.25,
      "duration_seconds": 3.73,
      "text": "shall I check your blood pressure and pulse?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 29.42,
      "end_seconds": 31.62,
      "duration_seconds": 2.2,
      "text": "Okay, this won't take long..."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 48.12,
      "end_seconds": 59.17,
      "duration_seconds": 11.05,
      "text": "Okay: blood pressure 121 over 71, temp 39.1 degrees, oxygen saturation is 95 percent, respiratory rate 16, pulse 96. Since when exactly?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 60.73,
      "end_seconds": 62.72,
      "duration_seconds": 1.99,
      "text": "Probably five days. Yeah."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 63.72,
      "end_seconds": 72.45,
      "duration_seconds": 8.73,
      "text": "Can you describe it a bit more for me? How strong it is, what the pattern is, what helps."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 73.55,
      "end_seconds": 86.38,
      "duration_seconds": 12.83,
      "text": "It settles a little with warm drinks. I notice it more with swallowing. Pretty moderate, if I'm being honest. I've also had pain on swallowing, for five days."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 94.65,
      "end_seconds": 99.61,
      "duration_seconds": 4.96,
      "text": "Have you had any drooling, ear pain, rash or cough?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 101.33,
      "end_seconds": 104.45,
      "duration_seconds": 3.12,
      "text": "No, none of those at all."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 106.06,
      "end_seconds": 108.23,
      "duration_seconds": 2.17,
      "text": "Is your chest okay generally?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 109.81,
      "end_seconds": 113.34,
      "duration_seconds": 3.53,
      "text": "uh, no, my breathing's been fine"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 115.1,
      "end_seconds": 117.69,
      "duration_seconds": 2.59,
      "text": "How are your bowels, any trouble?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 119.55,
      "end_seconds": 122.38,
      "duration_seconds": 2.83,
      "text": "No, that side's been fine."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 127.02,
      "end_seconds": 128.64,
      "duration_seconds": 1.62,
      "text": "how are your meals?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 129.24,
      "end_seconds": 133.06,
      "duration_seconds": 3.82,
      "text": "I grab fast food at lunch most days"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 133.7,
      "end_seconds": 137.11,
      "duration_seconds": 3.41,
      "text": "What do you do during the day?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 138.08,
      "end_seconds": 141.36,
      "duration_seconds": 3.28,
      "text": "I look after my grandchildren most days."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 143.36,
      "end_seconds": 146.82,
      "duration_seconds": 3.46,
      "text": "Are there any illnesses in your family?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 148.75,
      "end_seconds": 151.73,
      "duration_seconds": 2.98,
      "text": "My mother has an underactive thyroid."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 153.43,
      "end_seconds": 155.97,
      "duration_seconds": 2.54,
      "text": "What's on your current medicine list?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 156.61,
      "end_seconds": 171.55,
      "duration_seconds": 14.94,
      "text": "Dolo, 650 milligrams, when I get the fever. Work has been very busy so I kept ignoring it. My sister suggested writing things down, but I forgot."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 189.83,
      "end_seconds": 196.08,
      "duration_seconds": 6.25,
      "text": "Any medical conditions, anything you've been treated for? I'll explain everything as we go along."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 197.01,
      "end_seconds": 199.2,
      "duration_seconds": 2.19,
      "text": "No, nothing at all."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 201.3,
      "end_seconds": 204.24,
      "duration_seconds": 2.94,
      "text": "Let's move on to the examination."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 205.98,
      "end_seconds": 208.6,
      "duration_seconds": 2.62,
      "text": "Take a deep breath for me."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 227.58,
      "end_seconds": 234.2,
      "duration_seconds": 6.62,
      "text": "Both tonsils are red and enlarged with white patches, and the neck glands are tender."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 240.16,
      "end_seconds": 242.25,
      "duration_seconds": 2.09,
      "text": "You can sit up now."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 256.54,
      "end_seconds": 286.06,
      "duration_seconds": 29.52,
      "text": "okay, so my impression is this: The most likely explanation is tonsillitis. I want to be honest that this is an impression, not a final answer. I want a throat swab done, that's for sore throat. The treatment will be phenoxymethylpenicillin, 500 milligrams, four times a day, for ten days. You take it by mouth. That should help with tonsillitis. I'll put all of this in writing so you don't have to remember it"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 286.59,
      "end_seconds": 289.22,
      "duration_seconds": 2.63,
      "text": "okay, uh, I understand"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 291.56,
      "end_seconds": 316.92,
      "duration_seconds": 25.36,
      "text": "Gargle with warm salt water and drink plenty of fluids. Try to keep a simple diary of when it happens and what you were doing, and bring it to the next visit. The thing that would worry me is if you cannot swallow your saliva or have trouble breathing. If that happens, go to emergency."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 320.22,
      "end_seconds": 323.49,
      "duration_seconds": 3.27,
      "text": "Yes, I'll bear that in mind."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 325.31,
      "end_seconds": 332.67,
      "duration_seconds": 7.36,
      "text": "I'd like you back if it isn't better in three days. That's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 333.73,
      "end_seconds": 335.91,
      "duration_seconds": 2.18,
      "text": "Thank you, that's helpful."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 337.19,
      "end_seconds": 338.48,
      "duration_seconds": 1.29,
      "text": "See you soon."
    }
  ]
}