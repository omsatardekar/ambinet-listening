{
  "schema_version": "1.0",
  "encounter_id": "20464",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.83,
      "end_seconds": 2.58,
      "duration_seconds": 1.75,
      "text": "Welcome. Make yourself comfortable."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 4.31,
      "end_seconds": 7.87,
      "duration_seconds": 3.56,
      "text": "Morning, doctor, sorry about the rush."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 9.64,
      "end_seconds": 11.41,
      "duration_seconds": 1.77,
      "text": "Where shall we begin?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 13.12,
      "end_seconds": 21.52,
      "duration_seconds": 8.4,
      "text": "Um, mainly nausea. There's a couple of other things, but that's the main one."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 22.95,
      "end_seconds": 33.91,
      "duration_seconds": 10.96,
      "text": "Alright, tell me a bit more about it: how bad it gets, how often, and whether anything makes it better or worse."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 35.4,
      "end_seconds": 39.91,
      "duration_seconds": 4.51,
      "text": "It sort of comes and goes. I'd say moderate."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 41.17,
      "end_seconds": 43.65,
      "duration_seconds": 2.48,
      "text": "Is there anything else with it?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 45.31,
      "end_seconds": 53.11,
      "duration_seconds": 7.8,
      "text": "It usually comes with cramping tummy pain. Actually, the cramping tummy pain? That's been since last Tuesday."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 54.19,
      "end_seconds": 57.87,
      "duration_seconds": 3.68,
      "text": "Rate it for me, mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 58.61,
      "end_seconds": 59.69,
      "duration_seconds": 1.08,
      "text": "Moderate, really."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 60.25,
      "end_seconds": 62.25,
      "duration_seconds": 2.0,
      "text": "Have you been feeling dehydrated?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 63.96,
      "end_seconds": 71.73,
      "duration_seconds": 7.77,
      "text": "Yes, that started yesterday. As for feeling dehydrated, I'd give it a three, out of ten."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 85.68,
      "end_seconds": 89.41,
      "duration_seconds": 3.73,
      "text": "Okay, shall I check your blood pressure and pulse?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 100.03,
      "end_seconds": 102.64,
      "duration_seconds": 2.61,
      "text": "Keep your arm relaxed for me..."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 123.8,
      "end_seconds": 130.49,
      "duration_seconds": 6.69,
      "text": "Okay: saturation 95 percent, respiratory rate 21. And pulse 88, BP is 104 over 67."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 131.98,
      "end_seconds": 133.49,
      "duration_seconds": 1.51,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 137.98,
      "end_seconds": 140.77,
      "duration_seconds": 2.79,
      "text": "We'll look at it together shortly."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 143.65,
      "end_seconds": 147.38,
      "duration_seconds": 3.73,
      "text": "Could you come over to the couch, please?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 148.83,
      "end_seconds": 150.97,
      "duration_seconds": 2.14,
      "text": "Raise your arm for me."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 165.13,
      "end_seconds": 171.49,
      "duration_seconds": 6.36,
      "text": "Your mouth is a bit dry and your tummy is soft with mild tenderness all over."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 176.34,
      "end_seconds": 179.62,
      "duration_seconds": 3.28,
      "text": "Right, good, you can sit up again."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 190.43,
      "end_seconds": 194.8,
      "duration_seconds": 4.37,
      "text": "Did you get black stools, confusion or vomiting blood?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 196.25,
      "end_seconds": 201.5,
      "duration_seconds": 5.25,
      "text": "I haven't had black stools, confusion or vomiting blood, no."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 203.31,
      "end_seconds": 208.42,
      "duration_seconds": 5.11,
      "text": "Did you get severe abdominal pain or blood in the stool?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 209.75,
      "end_seconds": 212.35,
      "duration_seconds": 2.6,
      "text": "No, I'd have said so."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 213.69,
      "end_seconds": 216.73,
      "duration_seconds": 3.04,
      "text": "Is your urine normal, no changes?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 217.48,
      "end_seconds": 219.13,
      "duration_seconds": 1.65,
      "text": "No changes there."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 220.67,
      "end_seconds": 228.09,
      "duration_seconds": 7.42,
      "text": "Any medical conditions, anything you've been treated for? These questions might sound routine, but they matter."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 230.12,
      "end_seconds": 231.82,
      "duration_seconds": 1.7,
      "text": "No, no conditions."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 233.18,
      "end_seconds": 236.42,
      "duration_seconds": 3.24,
      "text": "A few questions about your lifestyle now."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 237.67,
      "end_seconds": 254.86,
      "duration_seconds": 17.19,
      "text": "I've never touched a cigarette. I'll have a glass of wine with dinner. My partner and our baby. I drink a lot of tea and snack through the day. Not much, I mostly stay in these days."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 256.64,
      "end_seconds": 259.6,
      "duration_seconds": 2.96,
      "text": "Have you got any known allergies?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 261.18,
      "end_seconds": 265.13,
      "duration_seconds": 3.95,
      "text": "I don't think I have any, no."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 266.88,
      "end_seconds": 269.23,
      "duration_seconds": 2.35,
      "text": "Tell me your medicines, please."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 271.19,
      "end_seconds": 274.01,
      "duration_seconds": 2.82,
      "text": "It's ORS, after each loose stool."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 275.26,
      "end_seconds": 287.64,
      "duration_seconds": 12.38,
      "text": "From what you've told me and what I found, it points towards infective gastroenteritis, likely after recent travel. A parasitic infection is also on my list."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 288.95,
      "end_seconds": 290.9,
      "duration_seconds": 1.95,
      "text": "Is this serious, doctor?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 292.31,
      "end_seconds": 304.49,
      "duration_seconds": 12.18,
      "text": "I understand the worry. At the moment I'd say it's infective gastroenteritis, likely after recent travel, and we'll know more once the a stool test is back."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 323.27,
      "end_seconds": 348.61,
      "duration_seconds": 25.34,
      "text": "I'll request a stool test, it'll help with diarrhoea. Small sips often are better than large drinks, and eat plain food as soon as you can. If you see blood in the stool or cannot keep fluids down, that's the point to come in urgently. Please come and see me if it isn't better in three days."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 350.38,
      "end_seconds": 352.03,
      "duration_seconds": 1.65,
      "text": "Yes, that's manageable."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 352.92,
      "end_seconds": 355.48,
      "duration_seconds": 2.56,
      "text": "That's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 356.24,
      "end_seconds": 359.12,
      "duration_seconds": 2.88,
      "text": "Great, thank you for your help."
    }
  ]
}