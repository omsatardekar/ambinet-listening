{
  "schema_version": "1.0",
  "encounter_id": "20027",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.97,
      "end_seconds": 6.77,
      "duration_seconds": 5.8,
      "text": "Hello, good to see you. Please sit. Have you been waiting long?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 8.86,
      "end_seconds": 12.11,
      "duration_seconds": 3.25,
      "text": "only about ten minutes, no trouble"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 13.8,
      "end_seconds": 16.35,
      "duration_seconds": 2.55,
      "text": "start wherever you like, I'm listening"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 17.75,
      "end_seconds": 25.45,
      "duration_seconds": 7.7,
      "text": "I've been dealing with yellow eyes i didn't wanna make a fuss, you know"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 27.51,
      "end_seconds": 31.23,
      "duration_seconds": 3.72,
      "text": "how many days or weeks has it been?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 32.16,
      "end_seconds": 44.04,
      "duration_seconds": 11.88,
      "text": "Around two weeks... no wait, it's more like about a week. Yeah, I've had dark urine too, for about two weeks."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 46.04,
      "end_seconds": 49.44,
      "duration_seconds": 3.4,
      "text": "what about tiredness, have you noticed that?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 50.2,
      "end_seconds": 51.78,
      "duration_seconds": 1.58,
      "text": "Yeah, that too."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 53.76,
      "end_seconds": 59.17,
      "duration_seconds": 5.41,
      "text": "Have you had yellow eyes before or is this the first time?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 60.9,
      "end_seconds": 69.98,
      "duration_seconds": 9.08,
      "text": "let me think, I had a a similar thing about six months ago it went away"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 81.86,
      "end_seconds": 86.17,
      "duration_seconds": 4.31,
      "text": "let me check a few things. Any fever or itching?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 87.84,
      "end_seconds": 90.5,
      "duration_seconds": 2.66,
      "text": "No, no fever or itching."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 91.34,
      "end_seconds": 95.58,
      "duration_seconds": 4.24,
      "text": "And what about confusion, bleeding or severe abdominal pain?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 97.0,
      "end_seconds": 102.32,
      "duration_seconds": 5.32,
      "text": "No confusion, bleeding or severe abdominal pain, none of it."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 103.96,
      "end_seconds": 108.16,
      "duration_seconds": 4.2,
      "text": "anything with your heart, like skipped beats or fainting?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 108.88,
      "end_seconds": 110.95,
      "duration_seconds": 2.07,
      "text": "no that's been fine"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 127.39,
      "end_seconds": 128.58,
      "duration_seconds": 1.19,
      "text": "what's your work?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 129.15,
      "end_seconds": 133.26,
      "duration_seconds": 4.11,
      "text": "I'm a plumber, lots of bending and kneeling"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 134.1,
      "end_seconds": 136.38,
      "duration_seconds": 2.28,
      "text": "is there someone at home?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 137.55,
      "end_seconds": 141.58,
      "duration_seconds": 4.03,
      "text": "My husband and I live above the shop"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 143.04,
      "end_seconds": 147.93,
      "duration_seconds": 4.89,
      "text": "Can you list what you take, tablets, creams or inhalers?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 152.6,
      "end_seconds": 159.64,
      "duration_seconds": 7.04,
      "text": "Diclofenac 50 milligrams when needed. Though honestly some days I forget to take it."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 161.36,
      "end_seconds": 165.04,
      "duration_seconds": 3.68,
      "text": "Any health conditions I should have on record?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 165.57,
      "end_seconds": 168.93,
      "duration_seconds": 3.36,
      "text": "Arthritis in my knees, for two years."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 169.81,
      "end_seconds": 173.61,
      "duration_seconds": 3.8,
      "text": "Hm, okay. Have you got any known allergies?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 174.21,
      "end_seconds": 176.94,
      "duration_seconds": 2.73,
      "text": "not to my knowledge, no"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 177.92,
      "end_seconds": 181.23,
      "duration_seconds": 3.31,
      "text": "Are there any illnesses in your family?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 182.24,
      "end_seconds": 189.9,
      "duration_seconds": 7.66,
      "text": "Sorry what was I saying my grandmother had dementia. Ah uh my sister had breast cancer."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 203.71,
      "end_seconds": 207.0,
      "duration_seconds": 3.29,
      "text": "Shall I check your blood pressure and pulse?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 215.84,
      "end_seconds": 218.03,
      "duration_seconds": 2.19,
      "text": "okay, this won't take long.."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 229.98,
      "end_seconds": 236.71,
      "duration_seconds": 6.73,
      "text": "okay: BP is 124 over 76 temperature 36.9 pulse is 86 beats a minute"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 237.97,
      "end_seconds": 239.34,
      "duration_seconds": 1.37,
      "text": "is that okay?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 240.32,
      "end_seconds": 242.96,
      "duration_seconds": 2.64,
      "text": "that's fine I'll explain it soon"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 245.47,
      "end_seconds": 249.41,
      "duration_seconds": 3.94,
      "text": "could you come over to the couch, please?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 251.01,
      "end_seconds": 252.14,
      "duration_seconds": 1.13,
      "text": "Okay, doctor."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 253.36,
      "end_seconds": 254.66,
      "duration_seconds": 1.3,
      "text": "Look straight ahead."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 272.75,
      "end_seconds": 280.49,
      "duration_seconds": 7.74,
      "text": "The whites of your eyes are yellow and the liver edge is tender under the right ribs."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 284.71,
      "end_seconds": 301.83,
      "duration_seconds": 17.12,
      "text": "please sit back down. Taking everything into account, my working impression is an acute viral hepatitis. The reason I say that is that your story and my examination fit together. Another possibility is a drug-related liver problem"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 302.77,
      "end_seconds": 305.45,
      "duration_seconds": 2.68,
      "text": "What are the odds it's serious?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 306.22,
      "end_seconds": 321.67,
      "duration_seconds": 15.45,
      "text": "It's reasonable to be concerned, but right now an acute viral hepatitis is my leading thought, not anything worse. So, to recap quickly. You've had yellow eyes for about a week, and no confusion or itching."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 323.36,
      "end_seconds": 325.58,
      "duration_seconds": 2.22,
      "text": "that's it it yes"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 326.22,
      "end_seconds": 344.33,
      "duration_seconds": 18.11,
      "text": "I'm gonna order a hepatitis screen for jaundice. Liver blood tests is what I'd like next for jaundice no alcohol at all and avoid paracetamol and other painkillers unless we say i'd like you to see the liver clinic as well and I'll write the referral"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 345.16,
      "end_seconds": 346.58,
      "duration_seconds": 1.42,
      "text": "Alright thank you."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 347.25,
      "end_seconds": 354.89,
      "duration_seconds": 7.64,
      "text": "If you become drowsy or confused, that's the point to come in urgently. See me again in one week."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 359.07,
      "end_seconds": 361.07,
      "duration_seconds": 2.0,
      "text": "That's fine with me."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 362.67,
      "end_seconds": 365.15,
      "duration_seconds": 2.48,
      "text": "that's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 367.02,
      "end_seconds": 369.08,
      "duration_seconds": 2.06,
      "text": "Thank you, doctor, goodbye."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 370.13,
      "end_seconds": 371.32,
      "duration_seconds": 1.19,
      "text": "Take care now."
    }
  ]
