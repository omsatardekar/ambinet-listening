{
  "schema_version": "1.0",
  "encounter_id": "20199",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.61,
      "end_seconds": 7.03,
      "duration_seconds": 6.42,
      "text": "Sorry, what was I saying, hello, doctor. May I come in?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.31,
      "end_seconds": 12.65,
      "duration_seconds": 4.34,
      "text": "Come in. Please sit. How can I help you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 13.7,
      "end_seconds": 21.19,
      "duration_seconds": 7.49,
      "text": "So, mainly I've been feeling shaky and sweaty. That's why I came."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 21.86,
      "end_seconds": 25.53,
      "duration_seconds": 3.67,
      "text": "When was the first time you noticed it?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 27.53,
      "end_seconds": 29.99,
      "duration_seconds": 2.46,
      "text": "Probably about four days. Yeah."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 31.48,
      "end_seconds": 36.21,
      "duration_seconds": 4.73,
      "text": "Okay, give me more detail on it, whatever comes to mind."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 36.95,
      "end_seconds": 54.32,
      "duration_seconds": 17.37,
      "text": "Well, uh, I'd give it a three, out of ten. It happens a couple of times a week. I've been putting this off for weeks. Well, uh, I've also had a pounding heart."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 55.42,
      "end_seconds": 57.83,
      "duration_seconds": 2.41,
      "text": "Is it constant or in episodes?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 59.22,
      "end_seconds": 63.2,
      "duration_seconds": 3.98,
      "text": "It's a couple of times a week."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 80.74,
      "end_seconds": 83.54,
      "duration_seconds": 2.8,
      "text": "Did you notice any chest pain?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 84.42,
      "end_seconds": 88.17,
      "duration_seconds": 3.75,
      "text": "Not at all, no chest pain."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 89.45,
      "end_seconds": 93.06,
      "duration_seconds": 3.61,
      "text": "Any vomiting, seizure, slurred speech or fainting?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 94.44,
      "end_seconds": 102.27,
      "duration_seconds": 7.83,
      "text": "Sorry, what was I saying, no, no vomiting, seizure, slurred speech or fainting."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 103.9,
      "end_seconds": 108.18,
      "duration_seconds": 4.28,
      "text": "Any change in your bowel habit or your stomach generally?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 109.67,
      "end_seconds": 114.93,
      "duration_seconds": 5.26,
      "text": "So, you know, bowels are regular, nothing odd."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 117.02,
      "end_seconds": 122.35,
      "duration_seconds": 5.33,
      "text": "Have you noticed any weakness, or anything odd with your balance?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 124.0,
      "end_seconds": 127.77,
      "duration_seconds": 3.77,
      "text": "No, you know, that's all normal."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 129.48,
      "end_seconds": 132.43,
      "duration_seconds": 2.95,
      "text": "Right, now some background about your lifestyle."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 133.02,
      "end_seconds": 147.21,
      "duration_seconds": 14.19,
      "text": "I only drink at family occasions. I'm a bus driver, so I sit for long hours. No, I share a house with my brother."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 148.0,
      "end_seconds": 150.56,
      "duration_seconds": 2.56,
      "text": "Before we go further, any allergies?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 152.41,
      "end_seconds": 157.7,
      "duration_seconds": 5.29,
      "text": "No, uh, nothing as far as I know."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 170.12,
      "end_seconds": 173.0,
      "duration_seconds": 2.88,
      "text": "Do you have any chronic illnesses?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 173.87,
      "end_seconds": 180.41,
      "duration_seconds": 6.54,
      "text": "I, I have diabetes, for two years. I've got kidney disease."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 181.23,
      "end_seconds": 189.5,
      "duration_seconds": 8.27,
      "text": "Okay, I can see kidney disease in your file as well. Have you ever had an operation?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 190.05,
      "end_seconds": 194.55,
      "duration_seconds": 4.5,
      "text": "I had part of my thyroid removed years back."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 196.2,
      "end_seconds": 198.99,
      "duration_seconds": 2.79,
      "text": "What's on your current medicine list?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 199.49,
      "end_seconds": 206.38,
      "duration_seconds": 6.89,
      "text": "Oh, I take gliclazide, 80 milligrams, twice a day for my sugar."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 207.4,
      "end_seconds": 209.96,
      "duration_seconds": 2.56,
      "text": "Let me take your readings now."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 217.71,
      "end_seconds": 220.46,
      "duration_seconds": 2.75,
      "text": "That's it, just a little longer..."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 237.49,
      "end_seconds": 246.57,
      "duration_seconds": 9.08,
      "text": "Okay: pressure 124 over 72, temp 36.5 degrees, pulse is 73 beats a minute, weight 66 kilos, height 154 centimetres."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 248.25,
      "end_seconds": 249.99,
      "duration_seconds": 1.74,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 255.78,
      "end_seconds": 258.64,
      "duration_seconds": 2.86,
      "text": "I'll interpret them after the examination."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 260.76,
      "end_seconds": 265.59,
      "duration_seconds": 4.83,
      "text": "I'll need to examine you for this, it won't take long."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 266.89,
      "end_seconds": 268.28,
      "duration_seconds": 1.39,
      "text": "Breathe out slowly."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 277.48,
      "end_seconds": 282.65,
      "duration_seconds": 5.17,
      "text": "Your fingerprick sugar now is normal and your heart rate is steady."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 285.45,
      "end_seconds": 302.44,
      "duration_seconds": 16.99,
      "text": "Okay, that's enough for me. From what you've told me and what I found, I'm honestly not certain yet. It could be episodes of low blood sugar related to diabetes treatment, or it might be an abnormal heart rhythm."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 303.99,
      "end_seconds": 307.02,
      "duration_seconds": 3.03,
      "text": "What are the odds it's serious?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 307.55,
      "end_seconds": 320.6,
      "duration_seconds": 13.05,
      "text": "I understand the worry. At the moment I'd say it's episodes of low blood sugar related to diabetes treatment, and we'll know more once the blood tests is back."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 328.28,
      "end_seconds": 361.49,
      "duration_seconds": 33.21,
      "text": "Let's get blood tests, for low sugar. I think an HbA1c makes sense here, for diabetes control. Never skip meals when you take the sugar tablet, and keep glucose tablets or juice with you. I'm not ordering a home sugar diary today. If things carry on in two weeks, we'll consider it. Please don't wait if you have an episode that does not settle with sugar. That's when to be seen urgently. See me again in two weeks."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 362.93,
      "end_seconds": 365.51,
      "duration_seconds": 2.58,
      "text": "That's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 367.0,
      "end_seconds": 371.1,
      "duration_seconds": 4.1,
      "text": "Ah, good, thanks, I'll see you then."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 371.82,
      "end_seconds": 373.02,
      "duration_seconds": 1.2,
      "text": "See you soon."
    }
  ]
}