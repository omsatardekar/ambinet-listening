{
  "schema_version": "1.0",
  "encounter_id": "20025",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.01,
      "end_seconds": 3.48,
      "duration_seconds": 2.47,
      "text": "Good morning, grab a seat."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 5.16,
      "end_seconds": 7.4,
      "duration_seconds": 2.24,
      "text": "Hi, uh, thanks."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 9.19,
      "end_seconds": 13.48,
      "duration_seconds": 4.29,
      "text": "Good morning, doctor. I came along to help out."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 14.05,
      "end_seconds": 17.23,
      "duration_seconds": 3.18,
      "text": "What would you like to start with today?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 18.86,
      "end_seconds": 26.38,
      "duration_seconds": 7.52,
      "text": "Oh, doctor, it's a sore on the bottom of my foot. That's what we're worried about."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 27.95,
      "end_seconds": 29.79,
      "duration_seconds": 1.84,
      "text": "When did this begin?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 30.8,
      "end_seconds": 32.89,
      "duration_seconds": 2.09,
      "text": "Probably two days. Yeah."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 34.89,
      "end_seconds": 43.92,
      "duration_seconds": 9.03,
      "text": "Tell me a bit more about it: how bad it gets, how often, and whether anything makes it better or worse."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 46.97,
      "end_seconds": 53.31,
      "duration_seconds": 6.34,
      "text": "Walking definitely sets it off. Pretty moderate, if I'm being honest."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 55.13,
      "end_seconds": 58.02,
      "duration_seconds": 2.89,
      "text": "Okay, have you been feeling feverish?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 59.49,
      "end_seconds": 63.81,
      "duration_seconds": 4.32,
      "text": "Yes, actually. With feeling feverish, it's mild, honestly."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 64.46,
      "end_seconds": 69.33,
      "duration_seconds": 4.87,
      "text": "Let me check a few things. Any calf pain or confusion?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 71.17,
      "end_seconds": 73.58,
      "duration_seconds": 2.41,
      "text": "No, nothing to report there."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 75.35,
      "end_seconds": 81.28,
      "duration_seconds": 5.93,
      "text": "Any chest pain, black toes or pain at rest in the leg?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 82.06,
      "end_seconds": 92.03,
      "duration_seconds": 9.97,
      "text": "Sorry, you know, what was I saying, no, no chest pain, black toes or pain at rest in the leg."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 93.03,
      "end_seconds": 96.24,
      "duration_seconds": 3.21,
      "text": "Has your heart given you any trouble?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 97.77,
      "end_seconds": 101.72,
      "duration_seconds": 3.95,
      "text": "I mean, no, nothing with my heart."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 114.6,
      "end_seconds": 121.85,
      "duration_seconds": 7.25,
      "text": "So, do you have any chronic illnesses? I'm asking so that we don't miss anything."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 123.08,
      "end_seconds": 129.94,
      "duration_seconds": 6.86,
      "text": "I've had diabetes, yes. I've had high blood pressure for five years now."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 130.76,
      "end_seconds": 132.05,
      "duration_seconds": 1.29,
      "text": "Okay, what else?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 133.5,
      "end_seconds": 135.83,
      "duration_seconds": 2.33,
      "text": "Have you got any known allergies?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 136.54,
      "end_seconds": 138.93,
      "duration_seconds": 2.39,
      "text": "Yes, I'm allergic to amoxicillin."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 140.93,
      "end_seconds": 142.41,
      "duration_seconds": 1.48,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 143.23,
      "end_seconds": 145.44,
      "duration_seconds": 2.21,
      "text": "No, not at all."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 157.53,
      "end_seconds": 162.06,
      "duration_seconds": 4.53,
      "text": "Let's talk a little about your daily life and habits."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 162.67,
      "end_seconds": 181.15,
      "duration_seconds": 18.48,
      "text": "I'll have a glass of wine with dinner. I smoke roughly a pack every two days. I'm a plumber, lots of bending and kneeling. Lots of rice, lentils and some fruit. My partner and our baby."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 182.15,
      "end_seconds": 184.32,
      "duration_seconds": 2.17,
      "text": "Let's run through your medicines."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 186.37,
      "end_seconds": 190.07,
      "duration_seconds": 3.7,
      "text": "Glibenclamide, 5 milligrams, maybe, before breakfast."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 191.36,
      "end_seconds": 195.47,
      "duration_seconds": 4.11,
      "text": "Did you happen to bring the box or the paperwork?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 196.66,
      "end_seconds": 200.45,
      "duration_seconds": 3.79,
      "text": "Not with me. I'll bring it next time."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 202.21,
      "end_seconds": 205.51,
      "duration_seconds": 3.3,
      "text": "Shall I check your blood pressure and pulse?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 213.82,
      "end_seconds": 216.23,
      "duration_seconds": 2.41,
      "text": "Bear with me while this finishes..."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 237.1,
      "end_seconds": 248.31,
      "duration_seconds": 11.21,
      "text": "Okay: temperature 39.3, pulse 95, oxygen saturation is 97 percent. And weight 95 kilos, height 155 centimetres, blood pressure 110 over 68."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 248.96,
      "end_seconds": 250.44,
      "duration_seconds": 1.48,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 252.09,
      "end_seconds": 254.05,
      "duration_seconds": 1.96,
      "text": "We'll go over that shortly."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 255.8,
      "end_seconds": 259.7,
      "duration_seconds": 3.9,
      "text": "Could you come over to the couch, please?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 260.52,
      "end_seconds": 263.43,
      "duration_seconds": 2.91,
      "text": "Stay as you are for a moment."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 276.03,
      "end_seconds": 280.94,
      "duration_seconds": 4.91,
      "text": "The pulses at the ankle are weak but I can feel them."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 283.74,
      "end_seconds": 286.67,
      "duration_seconds": 2.93,
      "text": "That's all I needed to check."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 302.66,
      "end_seconds": 324.63,
      "duration_seconds": 21.97,
      "text": "Having listened and examined, this looks most like an infected diabetic foot ulcer. Poor circulation to the foot is also on my list. I'd like to arrange blood tests for infection. I'll request a swab from the ulcer, it'll help with infected ulcer. Keep the weight off that foot and keep the dressing dry."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 324.91,
      "end_seconds": 341.66,
      "duration_seconds": 16.75,
      "text": "Mm, okay. I'd like you to see the foot clinic as well, and I'll write the referral. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 342.25,
      "end_seconds": 345.98,
      "duration_seconds": 3.73,
      "text": "Should I have a foot X-ray as well?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 346.65,
      "end_seconds": 354.3,
      "duration_seconds": 7.65,
      "text": "Not at this point, no. It isn't indicated yet. Okay, that's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 355.85,
      "end_seconds": 357.54,
      "duration_seconds": 1.69,
      "text": "That's clear, thanks."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 359.62,
      "end_seconds": 360.94,
      "duration_seconds": 1.32,
      "text": "See you soon."
    }
  ]
}