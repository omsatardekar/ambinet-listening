      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 193.06,
      "end_seconds": 204.43,
      "duration_seconds": 11.37,
      "text": "My partner and our baby. Lots of rice, lentils and some fruit. I hardly move around during the day"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 205.43,
      "end_seconds": 210.01,
      "duration_seconds": 4.58,
      "text": "do you have any medical conditions I should know about?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 211.11,
      "end_seconds": 212.66,
      "duration_seconds": 1.55,
      "text": "no no conditions"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 213.18,
      "end_seconds": 215.98,
      "duration_seconds": 2.8,
      "text": "Let's start with the the basic checks."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 226.27,
      "end_seconds": 228.83,
      "duration_seconds": 2.56,
      "text": "keep your arm relaxed for me.."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 246.24,
      "end_seconds": 260.14,
      "duration_seconds": 13.9,
      "text": "okay: height 161 centimetres, pulse is 66 beats a minute, respiratory rate 14. And temp 36.8 degrees, pressure 111 over 73, BMI works out to 30.1, weight 78 kilos"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 261.69,
      "end_seconds": 263.67,
      "duration_seconds": 1.98,
      "text": "is that alright doctor?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 264.8,
      "end_seconds": 267.73,
      "duration_seconds": 2.93,
      "text": "that's fine I'll explain it soon"
