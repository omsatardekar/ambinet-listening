{
  "schema_version": "1.0",
  "encounter_id": "20190",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 0.69,
      "end_seconds": 6.87,
      "duration_seconds": 6.18,
      "text": "Doctor, this one's ready for you. Everything's on the chart, but I'll go through it."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.77,
      "end_seconds": 12.8,
      "duration_seconds": 5.03,
      "text": "Thanks. Hello, come in, sit down. What brings you in today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 13.61,
      "end_seconds": 21.04,
      "duration_seconds": 7.43,
      "text": "Um, so... sudden hearing loss in my left ear. That's why I came."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 22.51,
      "end_seconds": 25.94,
      "duration_seconds": 3.43,
      "text": "Do you take any prescribed or over-the-counter medicines?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 26.93,
      "end_seconds": 40.22,
      "duration_seconds": 13.29,
      "text": "I take amlodipine, 5 milligrams, once a day for my pressure. I had losartan at one point, but I'm off it now."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 42.17,
      "end_seconds": 45.34,
      "duration_seconds": 3.17,
      "text": "How many days or weeks has it been?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 47.16,
      "end_seconds": 51.31,
      "duration_seconds": 4.15,
      "text": "It's been about four days, I'm fairly sure."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 52.74,
      "end_seconds": 56.27,
      "duration_seconds": 3.53,
      "text": "Has there been a ringing in the ear too?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 58.16,
      "end_seconds": 60.12,
      "duration_seconds": 1.96,
      "text": "Yes, since yesterday."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 61.84,
      "end_seconds": 67.14,
      "duration_seconds": 5.3,
      "text": "Is it there all the time or does it come and go?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 67.98,
      "end_seconds": 86.21,
      "duration_seconds": 18.23,
      "text": "It happens a few times a day. Erm, I've been feeling a bit dizzy too. Let me think, with feeling a bit dizzy, it sort of comes and goes."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 92.44,
      "end_seconds": 97.28,
      "duration_seconds": 4.84,
      "text": "Have you noticed facial weakness, head injury or ear pain?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 99.31,
      "end_seconds": 104.88,
      "duration_seconds": 5.57,
      "text": "Sorry, what was I saying, no, I'd have said so."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 106.64,
      "end_seconds": 110.08,
      "duration_seconds": 3.44,
      "text": "A few quick ones: discharge or recent flying?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 110.87,
      "end_seconds": 113.43,
      "duration_seconds": 2.56,
      "text": "None of those, no."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 115.44,
      "end_seconds": 119.83,
      "duration_seconds": 4.39,
      "text": "What about your tummy and bowels, anything unusual there?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 120.57,
      "end_seconds": 126.25,
      "duration_seconds": 5.68,
      "text": "Let me think, you know, bowels are regular, nothing odd."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 127.28,
      "end_seconds": 132.04,
      "duration_seconds": 4.76,
      "text": "Right, what conditions have you been treated for in the past?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 134.03,
      "end_seconds": 136.19,
      "duration_seconds": 2.16,
      "text": "Yes, high blood pressure."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 137.84,
      "end_seconds": 139.84,
      "duration_seconds": 2.0,
      "text": "Do you get out much?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 140.75,
      "end_seconds": 145.38,
      "duration_seconds": 4.63,
      "text": "Not much, I mostly stay in these days."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 146.68,
      "end_seconds": 149.08,
      "duration_seconds": 2.4,
      "text": "Do you follow any particular diet?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 150.84,
      "end_seconds": 155.05,
      "duration_seconds": 4.21,
      "text": "I'm vegetarian and have been for years."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 156.14,
      "end_seconds": 158.91,
      "duration_seconds": 2.77,
      "text": "Before we go further, any allergies?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 160.17,
      "end_seconds": 163.44,
      "duration_seconds": 3.27,
      "text": "Ah, not to my knowledge, no."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 164.56,
      "end_seconds": 167.09,
      "duration_seconds": 2.53,
      "text": "Have you had any surgical procedures?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 167.75,
      "end_seconds": 175.44,
      "duration_seconds": 7.69,
      "text": "Uh, yes, I had keyhole surgery on my gallbladder, two years back."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 193.32,
      "end_seconds": 201.5,
      "duration_seconds": 8.18,
      "text": "Doctor, I've got the readings for you. BP is 112 over 69, heart rate 65, SpO2 98 percent on room air."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 203.56,
      "end_seconds": 204.26,
      "duration_seconds": 0.7,
      "text": "Thanks."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 206.21,
      "end_seconds": 209.06,
      "duration_seconds": 2.85,
      "text": "Let's move on to the examination."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 225.16,
      "end_seconds": 226.3,
      "duration_seconds": 1.14,
      "text": "That's alright."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 227.9,
      "end_seconds": 230.23,
      "duration_seconds": 2.33,
      "text": "Hold that for a second."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 241.96,
      "end_seconds": 247.92,
      "duration_seconds": 5.96,
      "text": "Both eardrums look normal and a tuning fork is heard better in the right ear."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 250.14,
      "end_seconds": 251.81,
      "duration_seconds": 1.67,
      "text": "You can relax now."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 266.82,
      "end_seconds": 279.54,
      "duration_seconds": 12.72,
      "text": "From what you've told me and what I found, I'd lean towards sudden loss of hearing that needs urgent assessment. Wax is also on my list."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 280.8,
      "end_seconds": 286.01,
      "duration_seconds": 5.21,
      "text": "Hmm, um, what are the odds it's serious?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 288.03,
      "end_seconds": 306.89,
      "duration_seconds": 18.86,
      "text": "I understand the worry. At the moment I'd say it's sudden loss of hearing that needs urgent assessment, and we'll know more once the an MRI scan is back. I'm sending you for an MRI scan because of unilateral hearing loss."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 307.61,
      "end_seconds": 310.66,
      "duration_seconds": 3.05,
      "text": "I mean, is that done today?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 312.09,
      "end_seconds": 345.57,
      "duration_seconds": 33.48,
      "text": "Let's book a hearing test to look into sudden hearing loss. I'm going to put you on prednisolone, 60 milligrams, once a day in the morning, for seven days. It's for sudden hearing loss. It's a commonly used medicine and most people tolerate it well. Please attend the hearing test today if you can, as timing matters. Please don't wait if the dizziness gets worse or you develop facial weakness. That's when to be seen urgently."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 347.45,
      "end_seconds": 354.84,
      "duration_seconds": 7.39,
      "text": "Let's review you after the hearing test. Right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 356.34,
      "end_seconds": 358.24,
      "duration_seconds": 1.9,
      "text": "That's clear, thanks."
    }
  ]
}