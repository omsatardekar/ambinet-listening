{
  "schema_version": "1.0",
  "encounter_id": "20056",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.17,
      "end_seconds": 7.3,
      "duration_seconds": 6.13,
      "text": "Hi, doctor, I came as soon as they called me."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.51,
      "end_seconds": 12.95,
      "duration_seconds": 4.44,
      "text": "Right, of course, leave it there. How can I help?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 14.72,
      "end_seconds": 23.84,
      "duration_seconds": 9.12,
      "text": "I, I wanted to get a sore on the bottom of my foot looked at."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 24.52,
      "end_seconds": 26.3,
      "duration_seconds": 1.78,
      "text": "When did this begin?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 29.22,
      "end_seconds": 32.78,
      "duration_seconds": 3.56,
      "text": "I've had it for two days."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 34.35,
      "end_seconds": 36.69,
      "duration_seconds": 2.34,
      "text": "Have you tried anything for it?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 37.65,
      "end_seconds": 43.26,
      "duration_seconds": 5.61,
      "text": "Hmm, I get some relief from keeping off it."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 45.19,
      "end_seconds": 47.65,
      "duration_seconds": 2.46,
      "text": "What aggravates it, if anything?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 49.5,
      "end_seconds": 52.34,
      "duration_seconds": 2.84,
      "text": "Walking definitely sets it off."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 54.27,
      "end_seconds": 57.38,
      "duration_seconds": 3.11,
      "text": "Would you say mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 59.07,
      "end_seconds": 60.23,
      "duration_seconds": 1.16,
      "text": "Mostly severe."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 61.36,
      "end_seconds": 64.19,
      "duration_seconds": 2.83,
      "text": "Okay, any other symptoms with it?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 65.87,
      "end_seconds": 80.58,
      "duration_seconds": 14.71,
      "text": "Numbness in my feet goes along with it, um, most of the time. The numbness in my feet? That's been for two weeks."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 82.22,
      "end_seconds": 85.16,
      "duration_seconds": 2.94,
      "text": "How strong would you say it is?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 87.02,
      "end_seconds": 88.22,
      "duration_seconds": 1.2,
      "text": "Mostly severe."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 89.42,
      "end_seconds": 93.27,
      "duration_seconds": 3.85,
      "text": "Alright, have you had redness around the sore?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 94.24,
      "end_seconds": 97.13,
      "duration_seconds": 2.89,
      "text": "Yes, uh, I have."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 97.71,
      "end_seconds": 103.97,
      "duration_seconds": 6.26,
      "text": "Let me check a few things. Any vomiting or pain at rest in the leg?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 105.08,
      "end_seconds": 111.14,
      "duration_seconds": 6.06,
      "text": "No vomiting or pain at rest in the leg, none of it."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 112.93,
      "end_seconds": 116.66,
      "duration_seconds": 3.73,
      "text": "And what about chest pain, confusion or black toes?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 117.61,
      "end_seconds": 122.98,
      "duration_seconds": 5.37,
      "text": "So, no, no chest pain, confusion or black toes."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 123.96,
      "end_seconds": 127.4,
      "duration_seconds": 3.44,
      "text": "Okay, has your heart given you any trouble?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 128.32,
      "end_seconds": 133.42,
      "duration_seconds": 5.1,
      "text": "My heart's been fine, as far as I know."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 135.51,
      "end_seconds": 138.21,
      "duration_seconds": 2.7,
      "text": "How are your bowels, any trouble?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 139.78,
      "end_seconds": 142.55,
      "duration_seconds": 2.77,
      "text": "Bowels are regular, nothing odd."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 144.38,
      "end_seconds": 148.72,
      "duration_seconds": 4.34,
      "text": "Can you list what you take, tablets, creams or inhalers?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 152.75,
      "end_seconds": 157.98,
      "duration_seconds": 5.23,
      "text": "Um, I take glimepiride, 2 milligrams, maybe, before breakfast."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 158.66,
      "end_seconds": 162.97,
      "duration_seconds": 4.31,
      "text": "Do you have the packet or the prescription with you?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 164.14,
      "end_seconds": 179.38,
      "duration_seconds": 15.24,
      "text": "No, it's at home. It's rosuvastatin, 10 milligrams, at night for my cholesterol. Losartan, 50 milligrams, once a day. I'm, I'm on aspirin, 75 milligrams, once a day."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 180.62,
      "end_seconds": 182.66,
      "duration_seconds": 2.04,
      "text": "What about your medical history?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 184.47,
      "end_seconds": 202.92,
      "duration_seconds": 18.45,
      "text": "I have diabetes. Yes, high cholesterol. Mm, I have high blood pressure. I've been putting this off for weeks. I thought it would sort itself out, but it hasn't. I have heart disease."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 203.5,
      "end_seconds": 208.46,
      "duration_seconds": 4.96,
      "text": "Okay, I can see high cholesterol in your file as well."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 221.02,
      "end_seconds": 223.44,
      "duration_seconds": 2.42,
      "text": "Any surgery in the past?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 225.11,
      "end_seconds": 229.71,
      "duration_seconds": 4.6,
      "text": "I, I had a triple bypass eight years ago."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 230.5,
      "end_seconds": 233.22,
      "duration_seconds": 2.72,
      "text": "Have you got any known allergies?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 234.57,
      "end_seconds": 239.91,
      "duration_seconds": 5.34,
      "text": "Yes, nickel, it gives me a rash on my skin."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 240.58,
      "end_seconds": 242.72,
      "duration_seconds": 2.14,
      "text": "Is there someone at home?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 247.14,
      "end_seconds": 251.75,
      "duration_seconds": 4.61,
      "text": "My husband and I live above the shop."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 253.8,
      "end_seconds": 255.38,
      "duration_seconds": 1.58,
      "text": "How active are you?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 257.41,
      "end_seconds": 261.21,
      "duration_seconds": 3.8,
      "text": "I hardly move around during the day."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 262.36,
      "end_seconds": 264.15,
      "duration_seconds": 1.79,
      "text": "Have you retired yet?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 265.84,
      "end_seconds": 270.84,
      "duration_seconds": 5.0,
      "text": "I retired from the post office two years ago."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 272.2,
      "end_seconds": 275.39,
      "duration_seconds": 3.19,
      "text": "Shall I check your blood pressure and pulse?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 287.49,
      "end_seconds": 289.71,
      "duration_seconds": 2.22,
      "text": "Okay, this won't take long..."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 311.49,
      "end_seconds": 326.67,
      "duration_seconds": 15.18,
      "text": "Okay: temperature 39.3, BMI works out to 22.8, pulse is 93 beats a minute. And SpO2 97 percent on room air, height 174 centimetres, respiratory rate 18, pressure 117 over 80, weight 69 kilos."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 327.47,
      "end_seconds": 330.78,
      "duration_seconds": 3.31,
      "text": "Actually, is that alright, doctor?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 331.53,
      "end_seconds": 334.02,
      "duration_seconds": 2.49,
      "text": "I'll interpret them after the examination."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 335.91,
      "end_seconds": 338.78,
      "duration_seconds": 2.87,
      "text": "Let's move on to the examination."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 340.72,
      "end_seconds": 342.99,
      "duration_seconds": 2.27,
      "text": "I'm just checking this side."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 354.84,
      "end_seconds": 361.9,
      "duration_seconds": 7.06,
      "text": "There is a two-centimetre ulcer on the ball of the right foot with redness around it."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 363.18,
      "end_seconds": 364.41,
      "duration_seconds": 1.23,
      "text": "Look straight ahead."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 379.63,
      "end_seconds": 385.39,
      "duration_seconds": 5.76,
      "text": "The pulses at the ankle are weak but I can feel them."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 388.28,
      "end_seconds": 390.71,
      "duration_seconds": 2.43,
      "text": "That's all I needed to check."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 398.94,
      "end_seconds": 414.2,
      "duration_seconds": 15.26,
      "text": "Let me tell you where I've got to. The most likely explanation is an infected diabetic foot ulcer. That's my thinking for now, and it may change as we learn more."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 415.41,
      "end_seconds": 419.17,
      "duration_seconds": 3.76,
      "text": "I'm scared it's something bad. Is it?"
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 419.92,
      "end_seconds": 433.01,
      "duration_seconds": 13.09,
      "text": "I understand the worry. At the moment I'd say it's an infected diabetic foot ulcer, and we'll know more once the a swab from the ulcer is back."
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 443.11,
      "end_seconds": 457.6,
      "duration_seconds": 14.49,
      "text": "I think a swab from the ulcer makes sense here, for infected ulcer. I think blood tests makes sense here, for infection. That will help us see what's going on underneath and decide the next step."
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 459.12,
      "end_seconds": 462.77,
      "duration_seconds": 3.65,
      "text": "Where would I go for that?"
    },
    {
      "segment_id": "SEG0059",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 464.59,
      "end_seconds": 475.66,
      "duration_seconds": 11.07,
      "text": "We'll begin with amoxicillin/clavulanic acid, 625 milligrams, three times a day, for seven days. You take it by mouth. That's for foot infection."
    },
    {
      "segment_id": "SEG0060",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 480.94,
      "end_seconds": 485.74,
      "duration_seconds": 4.8,
      "text": "Should I carry on if I feel better?"
    },
    {
      "segment_id": "SEG0061",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 486.32,
      "end_seconds": 494.71,
      "duration_seconds": 8.39,
      "text": "Keep the weight off that foot and keep the dressing dry. We'll refer you to the foot clinic."
    },
    {
      "segment_id": "SEG0062",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 496.44,
      "end_seconds": 500.12,
      "duration_seconds": 3.68,
      "text": "Actually, sure, where do I go?"
    },
    {
      "segment_id": "SEG0063",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 500.97,
      "end_seconds": 515.53,
      "duration_seconds": 14.56,
      "text": "And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose. So, anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0064",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 516.65,
      "end_seconds": 518.56,
      "duration_seconds": 1.91,
      "text": "That's clear, thanks."
    }
  ]
}