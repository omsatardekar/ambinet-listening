{
  "schema_version": "1.0",
  "encounter_id": "20430",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.56,
      "end_seconds": 4.47,
      "duration_seconds": 3.91,
      "text": "Come in, have a seat by the desk."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 6.2,
      "end_seconds": 9.27,
      "duration_seconds": 3.07,
      "text": "Hello. I hope I'm not late."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 11.25,
      "end_seconds": 17.08,
      "duration_seconds": 5.83,
      "text": "well, hello, doctor i hope it's alright if I stay in for this"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 17.9,
      "end_seconds": 20.77,
      "duration_seconds": 2.87,
      "text": "So what can I do for you?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 22.04,
      "end_seconds": 28.35,
      "duration_seconds": 6.31,
      "text": "well, I've been having pain going down the back of my left leg"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 30.38,
      "end_seconds": 33.3,
      "duration_seconds": 2.92,
      "text": "what's the timeline, when did it begin?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 34.18,
      "end_seconds": 37.28,
      "duration_seconds": 3.1,
      "text": "For about three months, I'd say."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 37.58,
      "end_seconds": 41.71,
      "duration_seconds": 4.13,
      "text": "Mm, okay. Okay, what aggravates it, if anything?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 42.62,
      "end_seconds": 46.01,
      "duration_seconds": 3.39,
      "text": "I notice it more with sitting."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 46.27,
      "end_seconds": 50.61,
      "duration_seconds": 4.34,
      "text": "mm, okay would you say mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 52.44,
      "end_seconds": 55.25,
      "duration_seconds": 2.81,
      "text": "I'd call it it moderate."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 55.98,
      "end_seconds": 59.37,
      "duration_seconds": 3.39,
      "text": "have you noticed anything else alongside it?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 60.04,
      "end_seconds": 70.55,
      "duration_seconds": 10.51,
      "text": "Stiffness in the morning goes along with it, most of the time. The Stiffness in the morning? That's been for two years."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 72.0,
      "end_seconds": 78.24,
      "duration_seconds": 6.24,
      "text": "Did you get weakness in the foot, bowel problems or numbness between the legs?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 78.98,
      "end_seconds": 86.46,
      "duration_seconds": 7.48,
      "text": "No, no weakness in the foot, bowel problems or numbness between the legs."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 87.53,
      "end_seconds": 90.52,
      "duration_seconds": 2.99,
      "text": "Did you get bladder problems or fever?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 92.05,
      "end_seconds": 94.01,
      "duration_seconds": 1.96,
      "text": "none of those, no"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 96.03,
      "end_seconds": 99.45,
      "duration_seconds": 3.42,
      "text": "How about your heart, any problems like that?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 101.01,
      "end_seconds": 102.36,
      "duration_seconds": 1.35,
      "text": "Nothing like that."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 117.68,
      "end_seconds": 119.67,
      "duration_seconds": 1.99,
      "text": "let's run through your medicines"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 121.3,
      "end_seconds": 126.24,
      "duration_seconds": 4.94,
      "text": "I'm on escitalopram, once a day for my mood."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 128.31,
      "end_seconds": 130.43,
      "duration_seconds": 2.12,
      "text": "Do you know the dose?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 131.8,
      "end_seconds": 144.13,
      "duration_seconds": 12.33,
      "text": "10 milligrams, I think that's what's on the box. Paracetamol i take it 1 gram, when needed before this I was on lisinopril; that's been stopped"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 162.22,
      "end_seconds": 164.65,
      "duration_seconds": 2.43,
      "text": "Do you follow any particular diet?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 165.19,
      "end_seconds": 168.6,
      "duration_seconds": 3.41,
      "text": "I'm vegetarian and have been for years."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 170.3,
      "end_seconds": 173.74,
      "duration_seconds": 3.44,
      "text": "Are you in work at the moment?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 175.38,
      "end_seconds": 179.42,
      "duration_seconds": 4.04,
      "text": "Yes, I work in a bakery, early starts."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 193.62,
      "end_seconds": 196.44,
      "duration_seconds": 2.82,
      "text": "Have you got any known allergies?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 197.29,
      "end_seconds": 200.69,
      "duration_seconds": 3.4,
      "text": "No, nothing as far as I know."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 202.52,
      "end_seconds": 205.36,
      "duration_seconds": 2.84,
      "text": "Do you have any chronic illnesses?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 206.43,
      "end_seconds": 211.79,
      "duration_seconds": 5.36,
      "text": "I've got high blood pressure. Depression, for about a year."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 213.15,
      "end_seconds": 223.57,
      "duration_seconds": 10.42,
      "text": "Yes. Okay, I can see depression in your file as well. Can I check a few measurements before we carry on?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 232.3,
      "end_seconds": 234.41,
      "duration_seconds": 2.11,
      "text": "Sit still for a moment..."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 243.82,
      "end_seconds": 251.97,
      "duration_seconds": 8.15,
      "text": "okay: oxygen saturation is 98 percent, temperature is 36.4 degrees, heart rate 64, BP is 122 over 72."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 253.61,
      "end_seconds": 256.56,
      "duration_seconds": 2.95,
      "text": "let's move on to to the examination"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 257.42,
      "end_seconds": 258.62,
      "duration_seconds": 1.2,
      "text": "Nearly finished here."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 276.15,
      "end_seconds": 286.37,
      "duration_seconds": 10.22,
      "text": "Straight leg raising on the left brings on the leg pain at about forty degrees, and the power and reflexes are normal"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 290.26,
      "end_seconds": 310.01,
      "duration_seconds": 19.75,
      "text": "That's all I needed to check. So where does that leave us? It points towards sciatica from a lumbar disc irritation. I want to be honest that this is an impression, not a final answer. I'd also keep a muscle strain in mind."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 310.93,
      "end_seconds": 312.99,
      "duration_seconds": 2.06,
      "text": "Is this serious, doctor?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 314.77,
      "end_seconds": 347.28,
      "duration_seconds": 32.51,
      "text": "it's reasonable to be concerned, but right now sciatica from a lumbar disc irritation is my leading thought, not anything worse. I'm going to order an MRI of the lower back, for sciatica. The treatment will be naproxen, 500 milligrams, twice a day with food, for one week. You take it by mouth. That's for back and leg pain. It's a commonly used medicine and most people tolerate it well"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 348.83,
      "end_seconds": 354.03,
      "duration_seconds": 5.2,
      "text": "So, should I carry on if I feel better?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 354.83,
      "end_seconds": 362.74,
      "duration_seconds": 7.91,
      "text": "Stay active and keep walking, bed rest makes this slower to settle. I think physiotherapy should see you too."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 364.77,
      "end_seconds": 369.96,
      "duration_seconds": 5.19,
      "text": "Ah, could I get blood tests done? A friend had it."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 375.02,
      "end_seconds": 384.95,
      "duration_seconds": 9.93,
      "text": "Not right now, it wouldn't change what we do today. Let me check I've been clear. What will you do once you get home?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 385.97,
      "end_seconds": 394.78,
      "duration_seconds": 8.81,
      "text": "so, I take the naproxen, 500 milligrams, twice a day with food. Is that right?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 395.52,
      "end_seconds": 401.74,
      "duration_seconds": 6.22,
      "text": "yes, exactly right alright, that's everything on my side anything you're unsure about?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 403.31,
      "end_seconds": 406.77,
      "duration_seconds": 3.46,
      "text": "No, that's all. Thanks a lot."
    }
  ]
}