{
  "schema_version": "1.0",
  "encounter_id": "20009",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.72,
      "end_seconds": 5.99,
      "duration_seconds": 5.27,
      "text": "Um, hi, doctor, I hope I'm not disturbing you."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.87,
      "end_seconds": 10.72,
      "duration_seconds": 3.85,
      "text": "That's fine, sit down. Tell me why you came."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 11.66,
      "end_seconds": 15.86,
      "duration_seconds": 4.2,
      "text": "Well, I've been having a thick white discharge."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 16.33,
      "end_seconds": 20.24,
      "duration_seconds": 3.91,
      "text": "I see, go ahead. Is it accompanied by anything?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 21.51,
      "end_seconds": 32.14,
      "duration_seconds": 10.63,
      "text": "Sorry, uh, what was I saying, when it starts I tend to get discomfort during sex as well."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 33.54,
      "end_seconds": 36.7,
      "duration_seconds": 3.16,
      "text": "Has there been pain when passing urine too?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 41.33,
      "end_seconds": 57.75,
      "duration_seconds": 16.42,
      "text": "I mean, yeah. One week, I'd say. Let me think, the discomfort during sex? That's been for about two weeks. Oh, about discomfort during sex, pretty mild, if I'm being honest."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 59.17,
      "end_seconds": 62.83,
      "duration_seconds": 3.66,
      "text": "Have you had bleeding between periods, by any chance?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 64.87,
      "end_seconds": 67.32,
      "duration_seconds": 2.45,
      "text": "No. No bleeding between periods."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 67.89,
      "end_seconds": 73.3,
      "duration_seconds": 5.41,
      "text": "So, a few quick ones: new partner, being pregnant or pelvic pain?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 74.08,
      "end_seconds": 78.98,
      "duration_seconds": 4.9,
      "text": "No, no new partner, being pregnant or pelvic pain."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 80.19,
      "end_seconds": 83.11,
      "duration_seconds": 2.92,
      "text": "Has your heart given you any trouble?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 89.19,
      "end_seconds": 93.89,
      "duration_seconds": 4.7,
      "text": "My heart's been fine, as far as I know."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 94.93,
      "end_seconds": 99.13,
      "duration_seconds": 4.2,
      "text": "Are there any allergies I should be aware of?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 100.44,
      "end_seconds": 104.0,
      "duration_seconds": 3.56,
      "text": "Actually, not to my knowledge, no."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 105.17,
      "end_seconds": 109.97,
      "duration_seconds": 4.8,
      "text": "Tell me about your routine, work, habits, that sort of thing."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 111.14,
      "end_seconds": 135.1,
      "duration_seconds": 23.96,
      "text": "I smoke roughly a pack every two days. I used to drink heavily but I stopped four years ago. Not much, I mostly stay in these days. I work in accounts at a hospital. I grab fast food at lunch most days."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 148.47,
      "end_seconds": 151.79,
      "duration_seconds": 3.32,
      "text": "Is there anything relevant on the family side?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 153.6,
      "end_seconds": 156.07,
      "duration_seconds": 2.47,
      "text": "My father had bowel cancer."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 158.03,
      "end_seconds": 160.94,
      "duration_seconds": 2.91,
      "text": "Okay, what's on your current medicine list?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 163.02,
      "end_seconds": 169.33,
      "duration_seconds": 6.31,
      "text": "Okay, so it's Glycomet, 500 milligrams, twice a day for my sugar."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 170.87,
      "end_seconds": 172.82,
      "duration_seconds": 1.95,
      "text": "And for how long?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 174.0,
      "end_seconds": 181.6,
      "duration_seconds": 7.6,
      "text": "About three months now. I'd been on sitagliptin, not any more though, I stopped."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 183.2,
      "end_seconds": 186.38,
      "duration_seconds": 3.18,
      "text": "Has anyone ever diagnosed you with something?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 188.34,
      "end_seconds": 192.4,
      "duration_seconds": 4.06,
      "text": "I, I have diabetes, for two years."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 193.44,
      "end_seconds": 203.26,
      "duration_seconds": 9.82,
      "text": "I see, go ahead. Yes, diabetes is known to us, good to have that clear. Any past operations I should know about?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 204.74,
      "end_seconds": 211.82,
      "duration_seconds": 7.08,
      "text": "Yes, uh, I had a caesarean for my second baby, nine years ago."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 212.47,
      "end_seconds": 215.76,
      "duration_seconds": 3.29,
      "text": "Shall I check your blood pressure and pulse?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 223.47,
      "end_seconds": 225.75,
      "duration_seconds": 2.28,
      "text": "Sit still for a moment..."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 239.59,
      "end_seconds": 246.56,
      "duration_seconds": 6.97,
      "text": "Okay: BP is 127 over 78, temperature is 36.7 degrees, pulse is 77 beats a minute."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 248.45,
      "end_seconds": 252.1,
      "duration_seconds": 3.65,
      "text": "Now I'm going to do a short physical check."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 253.92,
      "end_seconds": 255.2,
      "duration_seconds": 1.28,
      "text": "Look straight ahead."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 264.66,
      "end_seconds": 270.39,
      "duration_seconds": 5.73,
      "text": "There is a thick white discharge with redness of the vulva and no ulcers."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 274.44,
      "end_seconds": 276.01,
      "duration_seconds": 1.57,
      "text": "That's the examination finished."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 287.09,
      "end_seconds": 294.81,
      "duration_seconds": 7.72,
      "text": "So where does that leave us? My working impression is vaginal thrush. A urine infection is still possible."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 296.6,
      "end_seconds": 300.1,
      "duration_seconds": 3.5,
      "text": "I mean, is it dangerous, doctor?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 301.62,
      "end_seconds": 309.6,
      "duration_seconds": 7.98,
      "text": "Nothing I've seen today points to an emergency. It looks like vaginal thrush, but I'd like to confirm."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 328.18,
      "end_seconds": 347.78,
      "duration_seconds": 19.6,
      "text": "I'm going to order a urine test, for dysuria. I'd like you to take fluconazole, 150 milligrams, once, for one day. You take it by mouth. That should help with thrush. The pharmacy will go through the details again when you pick it up."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 348.91,
      "end_seconds": 350.82,
      "duration_seconds": 1.91,
      "text": "Okay, I understand."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 351.72,
      "end_seconds": 358.37,
      "duration_seconds": 6.65,
      "text": "Wear cotton underwear and avoid scented soaps or washes. I think we're done unless you have questions."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 360.09,
      "end_seconds": 363.77,
      "duration_seconds": 3.68,
      "text": "Right, I'll do that. Thank you, doctor."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 365.15,
      "end_seconds": 366.5,
      "duration_seconds": 1.35,
      "text": "See you soon."
    }
  ]
}