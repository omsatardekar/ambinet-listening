{
  "schema_version": "1.0",
  "encounter_id": "20315",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.79,
      "end_seconds": 4.66,
      "duration_seconds": 3.87,
      "text": "Hi, is it okay to come in now?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.72,
      "end_seconds": 9.41,
      "duration_seconds": 3.69,
      "text": "Yes, have a seat. Tell me what's going on."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 11.23,
      "end_seconds": 20.58,
      "duration_seconds": 9.35,
      "text": "Thank you for fitting us in, doctor. Actually, doctor, it's pain after sitting for a while. That's what we're worried about."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 21.27,
      "end_seconds": 22.47,
      "duration_seconds": 1.2,
      "text": "Since when exactly?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 24.08,
      "end_seconds": 26.59,
      "duration_seconds": 2.51,
      "text": "Around a week, I think."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 28.02,
      "end_seconds": 32.59,
      "duration_seconds": 4.57,
      "text": "It was closer to two weeks, uh, doctor."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 34.32,
      "end_seconds": 39.22,
      "duration_seconds": 4.9,
      "text": "Okay, so roughly one to two weeks. Is that right?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 39.9,
      "end_seconds": 42.67,
      "duration_seconds": 2.77,
      "text": "Oh, that sounds about right."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 43.73,
      "end_seconds": 46.46,
      "duration_seconds": 2.73,
      "text": "Is it bearing on you a lot?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 47.83,
      "end_seconds": 58.43,
      "duration_seconds": 10.6,
      "text": "Mild, really. And an ache along the arch, too. Okay, so there was a tight calf, yes, but that went away."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 59.84,
      "end_seconds": 66.6,
      "duration_seconds": 6.76,
      "text": "Have you had pain after sitting for a while before, or is this the first time?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 67.28,
      "end_seconds": 72.45,
      "duration_seconds": 5.17,
      "text": "I had a similar thing last winter. It went away."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 74.51,
      "end_seconds": 76.89,
      "duration_seconds": 2.38,
      "text": "What's on your current medicine list?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 78.34,
      "end_seconds": 84.29,
      "duration_seconds": 5.95,
      "text": "He is on propranolol, twice a day, I give it to him."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 85.51,
      "end_seconds": 87.53,
      "duration_seconds": 2.02,
      "text": "Do you know the dose?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 88.67,
      "end_seconds": 90.27,
      "duration_seconds": 1.6,
      "text": "It's 40 milligrams."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 91.06,
      "end_seconds": 92.32,
      "duration_seconds": 1.26,
      "text": "Is that long-standing?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 93.13,
      "end_seconds": 105.23,
      "duration_seconds": 12.1,
      "text": "About two years. Right, it's aspirin, 75 milligrams, once a day for my heart, doctor. He is on insoles, every day, I give it to him."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 106.68,
      "end_seconds": 107.95,
      "duration_seconds": 1.27,
      "text": "Is that long-standing?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 109.06,
      "end_seconds": 110.65,
      "duration_seconds": 1.59,
      "text": "For six months."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 111.82,
      "end_seconds": 114.63,
      "duration_seconds": 2.81,
      "text": "What line of work are you in?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 120.36,
      "end_seconds": 125.35,
      "duration_seconds": 4.99,
      "text": "I'm a bus driver, so I sit for long hours."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 126.64,
      "end_seconds": 128.91,
      "duration_seconds": 2.27,
      "text": "Do you live by yourself?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 129.63,
      "end_seconds": 133.52,
      "duration_seconds": 3.89,
      "text": "No, I share a house with my brother."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 134.03,
      "end_seconds": 136.12,
      "duration_seconds": 2.09,
      "text": "Okay, how are your meals?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 137.83,
      "end_seconds": 141.75,
      "duration_seconds": 3.92,
      "text": "I grab fast food at lunch most days."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 143.03,
      "end_seconds": 147.44,
      "duration_seconds": 4.41,
      "text": "Tell me about any past illnesses or ongoing conditions."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 148.19,
      "end_seconds": 154.81,
      "duration_seconds": 6.62,
      "text": "I have migraines, for about a year. I've had heart disease, yes."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 156.07,
      "end_seconds": 158.96,
      "duration_seconds": 2.89,
      "text": "Have you ever had an operation?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 160.84,
      "end_seconds": 164.32,
      "duration_seconds": 3.48,
      "text": "Just a triple bypass, eight years ago."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 165.8,
      "end_seconds": 169.83,
      "duration_seconds": 4.03,
      "text": "Do you react to any medicines or foods? Any allergies?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 171.82,
      "end_seconds": 177.06,
      "duration_seconds": 5.24,
      "text": "Um, yes, grass pollen, it gives me itchy eyes."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 193.31,
      "end_seconds": 198.0,
      "duration_seconds": 4.69,
      "text": "And what about fever, injury or numbness in the foot?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 198.93,
      "end_seconds": 204.87,
      "duration_seconds": 5.94,
      "text": "Sorry, what was I saying, no, none of those at all."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 205.6,
      "end_seconds": 208.56,
      "duration_seconds": 2.96,
      "text": "Any swelling or back pain at all?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 212.8,
      "end_seconds": 216.67,
      "duration_seconds": 3.87,
      "text": "Um, no, nothing to report there."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 218.75,
      "end_seconds": 221.01,
      "duration_seconds": 2.26,
      "text": "Your breathing, any trouble there?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 221.66,
      "end_seconds": 224.02,
      "duration_seconds": 2.36,
      "text": "Right, no problems with breathing."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 235.06,
      "end_seconds": 237.88,
      "duration_seconds": 2.82,
      "text": "Let me take your readings now."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 249.07,
      "end_seconds": 251.14,
      "duration_seconds": 2.07,
      "text": "Sit still for a moment..."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 267.8,
      "end_seconds": 277.34,
      "duration_seconds": 9.54,
      "text": "Okay: pulse is 68 beats a minute, saturation 98 percent. And pressure 128 over 76, temp 36.7 degrees."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 279.4,
      "end_seconds": 281.41,
      "duration_seconds": 2.01,
      "text": "Is that alright, doctor?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 282.95,
      "end_seconds": 286.18,
      "duration_seconds": 3.23,
      "text": "I'll explain what these mean in a moment."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 287.51,
      "end_seconds": 291.84,
      "duration_seconds": 4.33,
      "text": "I'll examine you in a second, make yourself comfortable."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 292.65,
      "end_seconds": 294.37,
      "duration_seconds": 1.72,
      "text": "Let me feel here."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 306.56,
      "end_seconds": 315.51,
      "duration_seconds": 8.95,
      "text": "There is a sore spot at the inner front of the heel bone and pulling the toes back makes it worse."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 318.54,
      "end_seconds": 320.56,
      "duration_seconds": 2.02,
      "text": "You can sit up now."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 328.7,
      "end_seconds": 347.85,
      "duration_seconds": 19.15,
      "text": "Putting it all together, it fits best with plantar fasciitis. It could also be a stress fracture, so we'll keep that open. So, to recap quickly. You've had pain after sitting for a while, mild, and no numbness in the foot or fever."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 349.9,
      "end_seconds": 352.58,
      "duration_seconds": 2.68,
      "text": "Right, that's what happened, yes."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 354.56,
      "end_seconds": 358.31,
      "duration_seconds": 3.75,
      "text": "We should do a foot X-ray for heel pain."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 359.71,
      "end_seconds": 360.81,
      "duration_seconds": 1.1,
      "text": "Mm, alright."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 361.56,
      "end_seconds": 387.4,
      "duration_seconds": 25.84,
      "text": "What I'm giving you is ibuprofen gel, three times a day, for two weeks. That should help with heel pain. Stretch the calf and the sole of the foot before getting out of bed and wear cushioned shoes. The thing that would worry me is if the symptoms get worse. If that happens, go to emergency. Please come and see me in six weeks."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 389.45,
      "end_seconds": 391.54,
      "duration_seconds": 2.09,
      "text": "Good, I'll return then."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 392.15,
      "end_seconds": 395.51,
      "duration_seconds": 3.36,
      "text": "I think we're done unless you have questions."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 396.55,
      "end_seconds": 399.4,
      "duration_seconds": 2.85,
      "text": "That's clear, you know, thanks."
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 401.13,
      "end_seconds": 402.31,
      "duration_seconds": 1.18,
      "text": "All the best."
    }
  ]
}