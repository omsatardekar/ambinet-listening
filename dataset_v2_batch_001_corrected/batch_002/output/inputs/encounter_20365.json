{
  "schema_version": "1.0",
  "encounter_id": "20365",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.14,
      "end_seconds": 4.65,
      "duration_seconds": 3.51,
      "text": "Morning, doctor. Is this the right room?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.25,
      "end_seconds": 10.62,
      "duration_seconds": 4.37,
      "text": "That's fine, sit down. Tell me why you came."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 11.24,
      "end_seconds": 21.78,
      "duration_seconds": 10.54,
      "text": "I'm here because of a red, hot area on my lower leg. I didn't want to make a fuss, you know."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 23.32,
      "end_seconds": 25.31,
      "duration_seconds": 1.99,
      "text": "Did it come on recently?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 30.82,
      "end_seconds": 43.68,
      "duration_seconds": 12.86,
      "text": "Probably three days. Yeah. I looked a few things up online, and that probably didn't help. I told my wife I'd come today."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 45.16,
      "end_seconds": 46.89,
      "duration_seconds": 1.73,
      "text": "Does anything help it?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 48.85,
      "end_seconds": 52.08,
      "duration_seconds": 3.23,
      "text": "It settles a little with elevation."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 57.23,
      "end_seconds": 61.28,
      "duration_seconds": 4.05,
      "text": "Any a bite mark on the shin as well?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 66.09,
      "end_seconds": 73.98,
      "duration_seconds": 7.89,
      "text": "Yes, actually. Oh, and a swollen leg. That's been about the same, two weeks."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 74.75,
      "end_seconds": 77.33,
      "duration_seconds": 2.58,
      "text": "How much does it limit you?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 78.91,
      "end_seconds": 81.81,
      "duration_seconds": 2.9,
      "text": "About a five out of ten."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 82.26,
      "end_seconds": 86.28,
      "duration_seconds": 4.02,
      "text": "I see, go ahead. Let me take your readings now."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 98.88,
      "end_seconds": 101.5,
      "duration_seconds": 2.62,
      "text": "Bear with me while this finishes..."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 111.25,
      "end_seconds": 125.34,
      "duration_seconds": 14.09,
      "text": "Okay: height 178 centimetres, BMI works out to 29.4, pulse is 100 beats a minute, weight 93 kilos, temperature 38.9, saturation 96 percent, blood pressure 110 over 78."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 127.68,
      "end_seconds": 131.96,
      "duration_seconds": 4.28,
      "text": "Alright, over here please and I'll take a look."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 133.15,
      "end_seconds": 134.4,
      "duration_seconds": 1.25,
      "text": "Nearly finished here."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 149.74,
      "end_seconds": 157.52,
      "duration_seconds": 7.78,
      "text": "There is a warm, red, tender patch about ten centimetres across on the right shin with mild swelling."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 161.67,
      "end_seconds": 164.16,
      "duration_seconds": 2.49,
      "text": "That's all I needed to check."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 173.74,
      "end_seconds": 179.25,
      "duration_seconds": 5.51,
      "text": "A few quick ones: wound, red streaks up the leg or vomiting?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 180.22,
      "end_seconds": 186.09,
      "duration_seconds": 5.87,
      "text": "I haven't had wound, red streaks up the leg or vomiting, no."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 187.88,
      "end_seconds": 191.6,
      "duration_seconds": 3.72,
      "text": "Have you had any breathlessness or chest pain?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 193.33,
      "end_seconds": 196.34,
      "duration_seconds": 3.01,
      "text": "No, no breathlessness or chest pain."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 197.08,
      "end_seconds": 199.14,
      "duration_seconds": 2.06,
      "text": "Is your mobility otherwise okay?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 200.07,
      "end_seconds": 201.55,
      "duration_seconds": 1.48,
      "text": "Nothing else aches."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 218.48,
      "end_seconds": 222.83,
      "duration_seconds": 4.35,
      "text": "Do you react to any medicines or foods? Any allergies?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 226.0,
      "end_seconds": 235.46,
      "duration_seconds": 9.46,
      "text": "Yes, walnuts. I've no idea what the reaction was, only that I'm not supposed to have it."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 237.48,
      "end_seconds": 241.05,
      "duration_seconds": 3.57,
      "text": "Anything in your past medical history I should know?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 244.99,
      "end_seconds": 246.93,
      "duration_seconds": 1.94,
      "text": "I've had diabetes, yes."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 247.68,
      "end_seconds": 248.86,
      "duration_seconds": 1.18,
      "text": "How about smoking?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 249.96,
      "end_seconds": 254.26,
      "duration_seconds": 4.3,
      "text": "I smoke roughly a pack every two days."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 259.5,
      "end_seconds": 260.67,
      "duration_seconds": 1.17,
      "text": "What about alcohol?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 261.23,
      "end_seconds": 262.75,
      "duration_seconds": 1.52,
      "text": "Nothing, I'm teetotal."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 263.87,
      "end_seconds": 265.23,
      "duration_seconds": 1.36,
      "text": "What's your work?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 265.81,
      "end_seconds": 270.41,
      "duration_seconds": 4.6,
      "text": "I'm a plumber, lots of bending and kneeling."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 272.34,
      "end_seconds": 274.3,
      "duration_seconds": 1.96,
      "text": "Is there someone at home?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 278.06,
      "end_seconds": 281.64,
      "duration_seconds": 3.58,
      "text": "My husband and I live above the shop."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 286.56,
      "end_seconds": 289.04,
      "duration_seconds": 2.48,
      "text": "Do you take any regular medication?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 293.3,
      "end_seconds": 295.12,
      "duration_seconds": 1.82,
      "text": "Nothing regular, no."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 303.26,
      "end_seconds": 315.13,
      "duration_seconds": 11.87,
      "text": "So where does that leave us? The most likely explanation is cellulitis of the right leg. I want an ultrasound of the leg veins done, that's for leg swelling."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 316.68,
      "end_seconds": 317.76,
      "duration_seconds": 1.08,
      "text": "Mm, alright."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 318.41,
      "end_seconds": 329.03,
      "duration_seconds": 10.62,
      "text": "I'm going to put you on flucloxacillin, 500 milligrams, four times a day, for seven days. That should help with cellulitis."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 330.64,
      "end_seconds": 332.25,
      "duration_seconds": 1.61,
      "text": "Thank you, doctor."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 333.06,
      "end_seconds": 357.45,
      "duration_seconds": 24.39,
      "text": "Mark the edge of the redness with a pen and keep the leg raised when sitting. Do get help quickly if the redness spreads quickly or you get a high fever. Let's review you if the redness spreads. Tell me what you've taken from all that, so I can fill in any gaps."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 358.19,
      "end_seconds": 369.26,
      "duration_seconds": 11.07,
      "text": "So, um, I take the flucloxacillin, 500 milligrams, four times a day and come back if the redness spreads. Is that right?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 371.12,
      "end_seconds": 377.37,
      "duration_seconds": 6.25,
      "text": "Yes, exactly right. Is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 378.68,
      "end_seconds": 381.49,
      "duration_seconds": 2.81,
      "text": "I think I understand everything. Thanks."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 382.53,
      "end_seconds": 383.87,
      "duration_seconds": 1.34,
      "text": "All the best."
    }
  ]
}