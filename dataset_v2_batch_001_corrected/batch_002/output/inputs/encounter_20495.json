{
  "schema_version": "1.0",
  "encounter_id": "20495",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.3,
      "end_seconds": 5.26,
      "duration_seconds": 3.96,
      "text": "hi, doctor, I hope I'm not disturbing you"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.05,
      "end_seconds": 13.41,
      "duration_seconds": 5.36,
      "text": "Yes, come in and sit down. What brings you here today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 14.68,
      "end_seconds": 21.13,
      "duration_seconds": 6.45,
      "text": "Well, you know, I've been having burning when I pass urine."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 21.67,
      "end_seconds": 24.81,
      "duration_seconds": 3.14,
      "text": "Can you tell me when it first started?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 28.81,
      "end_seconds": 31.61,
      "duration_seconds": 2.8,
      "text": "I've had it since last weekend"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 33.37,
      "end_seconds": 37.03,
      "duration_seconds": 3.66,
      "text": "What do you do to make it better?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 38.29,
      "end_seconds": 40.63,
      "duration_seconds": 2.34,
      "text": "Drinking water helps a bit"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 47.0,
      "end_seconds": 49.21,
      "duration_seconds": 2.21,
      "text": "is it accompanied by anything?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 50.29,
      "end_seconds": 57.45,
      "duration_seconds": 7.16,
      "text": "A sudden urgent need to go goes along with it, most of the time."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 57.83,
      "end_seconds": 60.56,
      "duration_seconds": 2.73,
      "text": "I follow. Any cloudy urine as well?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 65.33,
      "end_seconds": 70.0,
      "duration_seconds": 4.67,
      "text": "Sorry, what was I saying, yes, for one week."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 71.7,
      "end_seconds": 74.46,
      "duration_seconds": 2.76,
      "text": "Do you have any long-term conditions?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 76.5,
      "end_seconds": 77.69,
      "duration_seconds": 1.19,
      "text": "yes, diabetes"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 78.44,
      "end_seconds": 79.14,
      "duration_seconds": 0.7,
      "text": "Yes."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 81.1,
      "end_seconds": 84.4,
      "duration_seconds": 3.3,
      "text": "Ah, I've had thin bones, yes."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 86.27,
      "end_seconds": 93.5,
      "duration_seconds": 7.23,
      "text": "Right, so thin bones is already on your record. We'll keep that in mind today. Any previous surgeries?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 95.13,
      "end_seconds": 96.18,
      "duration_seconds": 1.05,
      "text": "no, never"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 97.79,
      "end_seconds": 100.05,
      "duration_seconds": 2.26,
      "text": "Tell me about your eating."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 101.12,
      "end_seconds": 106.05,
      "duration_seconds": 4.93,
      "text": "I drink a lot of tea and snack through the day."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 107.31,
      "end_seconds": 108.51,
      "duration_seconds": 1.2,
      "text": "are you active?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 110.13,
      "end_seconds": 112.9,
      "duration_seconds": 2.77,
      "text": "I walk the dog every morning"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 114.53,
      "end_seconds": 118.01,
      "duration_seconds": 3.48,
      "text": "Has anyone in your family had anything serious?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 119.57,
      "end_seconds": 121.79,
      "duration_seconds": 2.22,
      "text": "My brother has epilepsy."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 135.65,
      "end_seconds": 139.98,
      "duration_seconds": 4.33,
      "text": "alright, what do you take on a normal day?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 141.43,
      "end_seconds": 144.71,
      "duration_seconds": 3.28,
      "text": "It's glibenclamide, 5 milligrams, before breakfast."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 146.24,
      "end_seconds": 149.26,
      "duration_seconds": 3.02,
      "text": "How long has that been going on?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 150.51,
      "end_seconds": 162.3,
      "duration_seconds": 11.79,
      "text": "about six months. Alendronate. I take it 70 milligrams, once a week for my bones. Uh, I'm on cranberry juice, every day"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 163.21,
      "end_seconds": 168.91,
      "duration_seconds": 5.7,
      "text": "let me check a few things any vomiting, new partner or vaginal discharge?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 170.13,
      "end_seconds": 172.39,
      "duration_seconds": 2.26,
      "text": "Nope, nothing like that."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 173.72,
      "end_seconds": 176.91,
      "duration_seconds": 3.19,
      "text": "Any fever or loin pain at all?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 177.47,
      "end_seconds": 180.12,
      "duration_seconds": 2.65,
      "text": "yeah, nope, nothing like that"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 181.71,
      "end_seconds": 185.26,
      "duration_seconds": 3.55,
      "text": "Anything with your nerves, like weakness or numbness?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 185.78,
      "end_seconds": 187.32,
      "duration_seconds": 1.54,
      "text": "Nothing odd there."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 188.05,
      "end_seconds": 190.96,
      "duration_seconds": 2.91,
      "text": "Any breathing difficulties apart from this?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 192.61,
      "end_seconds": 195.4,
      "duration_seconds": 2.79,
      "text": "No, my breathing's been fine."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 213.82,
      "end_seconds": 216.7,
      "duration_seconds": 2.88,
      "text": "let me take your readings now"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 226.08,
      "end_seconds": 228.12,
      "duration_seconds": 2.04,
      "text": "Nearly done with the readings..."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 242.99,
      "end_seconds": 255.29,
      "duration_seconds": 12.3,
      "text": "Okay: BP is 125 over 68, temperature is 36.5 degrees, height 155 centimetres. And weight 65 kilos, pulse is 70 beats a a minute."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 256.38,
      "end_seconds": 257.98,
      "duration_seconds": 1.6,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 259.52,
      "end_seconds": 263.6,
      "duration_seconds": 4.08,
      "text": "They help me see the whole picture, more shortly."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 282.46,
      "end_seconds": 314.13,
      "duration_seconds": 31.67,
      "text": "I think a urine culture makes sense here, for recurrent urinary infection. Let's book a urine test to look into dysuria. I'll start you on nitrofurantoin, 100 milligrams, twice a day, for three days. That should help with urinary infection. Drink plenty of water and don't hold on when you need to go. Do get help quickly if you get fever, loin pain or vomiting. See me again after the culture result"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 315.93,
      "end_seconds": 318.1,
      "duration_seconds": 2.17,
      "text": "Good, I'll return then."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 319.49,
      "end_seconds": 324.31,
      "duration_seconds": 4.82,
      "text": "right, that's everything on my side anything you're unsure about?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 325.76,
      "end_seconds": 329.27,
      "duration_seconds": 3.51,
      "text": "Oh, good, thanks, I'll see you then."
    }
  ]
}