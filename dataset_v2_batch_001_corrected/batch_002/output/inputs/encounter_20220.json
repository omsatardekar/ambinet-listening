{
  "schema_version": "1.0",
  "encounter_id": "20220",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 0.99,
      "end_seconds": 9.46,
      "duration_seconds": 8.47,
      "text": "doctor, the patient's with us now. I did the usual checks at the front, so just say when you want them"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 11.54,
      "end_seconds": 15.81,
      "duration_seconds": 4.27,
      "text": "Good, thank you. Welcome, tell me what's brought you in."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 17.61,
      "end_seconds": 22.49,
      "duration_seconds": 4.88,
      "text": "Hello, doctor. I'm here with them in case I can help."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 24.55,
      "end_seconds": 36.01,
      "duration_seconds": 11.46,
      "text": "Yeah, it's pain going to my right shoulder. I don't know what's causing it. I thought it would sort itself out, but it hasn't."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 38.41,
      "end_seconds": 40.31,
      "duration_seconds": 1.9,
      "text": "When did this begin?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 41.9,
      "end_seconds": 48.11,
      "duration_seconds": 6.21,
      "text": "About two weeks, I think... sorry, one week, I got that wrong"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 53.18,
      "end_seconds": 58.4,
      "duration_seconds": 5.22,
      "text": "is it there all the time or does it come and go?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 59.86,
      "end_seconds": 62.67,
      "duration_seconds": 2.81,
      "text": "I'd say all the time."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 63.68,
      "end_seconds": 66.42,
      "duration_seconds": 2.74,
      "text": "is there anything else with it?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 67.42,
      "end_seconds": 81.46,
      "duration_seconds": 14.04,
      "text": "When it starts I tend to get sharp pain in the upper right of my tummy as well. I've had a bit of vomiting too, for about a week."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 86.09,
      "end_seconds": 89.9,
      "duration_seconds": 3.81,
      "text": "so, how much trouble does it give you?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 91.44,
      "end_seconds": 97.62,
      "duration_seconds": 6.18,
      "text": "Well, it's... hard to say, it's kind of... I don't know—"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 99.62,
      "end_seconds": 105.66,
      "duration_seconds": 6.04,
      "text": "Take your time. Mild, moderate, or severe, if you had to pick?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 106.24,
      "end_seconds": 114.66,
      "duration_seconds": 8.42,
      "text": "Mostly severe. The sharp pain in the upper right of my tummy? That's been for three days."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 115.24,
      "end_seconds": 117.61,
      "duration_seconds": 2.37,
      "text": "How much does it limit you?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 118.65,
      "end_seconds": 122.43,
      "duration_seconds": 3.78,
      "text": "Mm, about a six out of ten."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 124.4,
      "end_seconds": 127.99,
      "duration_seconds": 3.59,
      "text": "have you had any dark urine or pale stools?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 133.57,
      "end_seconds": 135.98,
      "duration_seconds": 2.41,
      "text": "No, not a single one."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 138.03,
      "end_seconds": 140.36,
      "duration_seconds": 2.33,
      "text": "Has there been any weight loss?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 142.09,
      "end_seconds": 145.2,
      "duration_seconds": 3.11,
      "text": "Nope, um, no weight loss."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 145.61,
      "end_seconds": 150.81,
      "duration_seconds": 5.2,
      "text": "Yes. Have you had any black stools, yellow eyes or fever?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 152.01,
      "end_seconds": 156.19,
      "duration_seconds": 4.18,
      "text": "No, you know, not a single one."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 157.9,
      "end_seconds": 160.36,
      "duration_seconds": 2.46,
      "text": "Any trouble with the waterworks?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 161.88,
      "end_seconds": 165.38,
      "duration_seconds": 3.5,
      "text": "That's normal as far as I know."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 167.03,
      "end_seconds": 170.25,
      "duration_seconds": 3.22,
      "text": "Any problems with your joints or muscles?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 171.39,
      "end_seconds": 173.62,
      "duration_seconds": 2.23,
      "text": "I move fine otherwise."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 186.26,
      "end_seconds": 189.09,
      "duration_seconds": 2.83,
      "text": "Do you have any long-term conditions?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 189.87,
      "end_seconds": 201.85,
      "duration_seconds": 11.98,
      "text": "I've got high cholesterol. COPD, for nearly five years. Yes, high blood pressure. My sister suggested writing things down, but I forgot. I've got anxiety."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 203.03,
      "end_seconds": 204.48,
      "duration_seconds": 1.45,
      "text": "And besides that?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 205.59,
      "end_seconds": 217.7,
      "duration_seconds": 12.11,
      "text": "Right, so high cholesterol and COPD are already on your record. We'll keep that in mind today. Let's talk a little about your daily life and habits."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 219.02,
      "end_seconds": 234.72,
      "duration_seconds": 15.7,
      "text": "I'll have a glass of wine with dinner. I smoke roughly a pack every two days. My husband and I live above the shop. I do a yoga class on Thursdays."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 235.55,
      "end_seconds": 237.92,
      "duration_seconds": 2.37,
      "text": "Any surgery in the past?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 239.32,
      "end_seconds": 244.11,
      "duration_seconds": 4.79,
      "text": "Just keyhole surgery on my gallbladder, two years back."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 251.65,
      "end_seconds": 255.32,
      "duration_seconds": 3.67,
      "text": "Let me ask about allergies, anything at all?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 256.28,
      "end_seconds": 261.08,
      "duration_seconds": 4.8,
      "text": "I'm allergic to tramadol, I get feeling very drowsy."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 262.31,
      "end_seconds": 265.61,
      "duration_seconds": 3.3,
      "text": "what do you take on a normal day?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 266.54,
      "end_seconds": 269.62,
      "duration_seconds": 3.08,
      "text": "Atorvastatin, 20 milligrams, at night"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 271.08,
      "end_seconds": 278.1,
      "duration_seconds": 7.02,
      "text": "she is supposed to to take it at night, but I can't say she always does"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 280.12,
      "end_seconds": 291.12,
      "duration_seconds": 11.0,
      "text": "I'm on Tiotropium inhaler, once a day for my chest. Metoprolol, 50 milligrams, twice a day for my pressure."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 292.07,
      "end_seconds": 297.03,
      "duration_seconds": 4.96,
      "text": "Doctor, our chart from the last visit lists it as 100 milligrams."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 298.65,
      "end_seconds": 302.74,
      "duration_seconds": 4.09,
      "text": "Hm, that's different. Is the latest prescription anywhere near you?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 304.23,
      "end_seconds": 307.17,
      "duration_seconds": 2.94,
      "text": "No, I left it at home."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 309.89,
      "end_seconds": 322.35,
      "duration_seconds": 12.46,
      "text": "Doctor, I've got the readings for you. Pulse is 74 beats a minute, BP is 122 over 73, temp 36.5 degrees, respiratory rate 17, oxygen saturation is 97 percent."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 323.81,
      "end_seconds": 325.85,
      "duration_seconds": 2.04,
      "text": "So, good, thank you."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 328.1,
      "end_seconds": 331.77,
      "duration_seconds": 3.67,
      "text": "Could you come over to the couch, please?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 333.37,
      "end_seconds": 336.29,
      "duration_seconds": 2.92,
      "text": "Stay as you are for a moment."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 347.81,
      "end_seconds": 355.8,
      "duration_seconds": 7.99,
      "text": "there is tenderness under the right ribs when you breathe in, and and no yellowing of the eyes"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 361.41,
      "end_seconds": 375.58,
      "duration_seconds": 14.17,
      "text": "You can relax now. Let me just check I've got this right. You've had pain going to your right shoulder for one week, and no dark urine or yellow eyes."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 380.9,
      "end_seconds": 382.9,
      "duration_seconds": 2.0,
      "text": "yes, you've got it"
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 387.54,
      "end_seconds": 406.81,
      "duration_seconds": 19.27,
      "text": "We should do liver blood tests for upper abdominal pain. I want an ultrasound of the tummy done, that's for right upper quadrant pain. The treatment will be diclofenac, 50 milligrams, three times a day if needed, for three days. It's for gallbladder pain."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 408.05,
      "end_seconds": 409.39,
      "duration_seconds": 1.34,
      "text": "That's simple enough."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 410.55,
      "end_seconds": 432.15,
      "duration_seconds": 21.6,
      "text": "keep meals small and low in fat until we have the scan. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose. Book a review in two weeks. Right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 433.14,
      "end_seconds": 435.99,
      "duration_seconds": 2.85,
      "text": "Yeah, alright, thanks, take care."
    }
  ]
}