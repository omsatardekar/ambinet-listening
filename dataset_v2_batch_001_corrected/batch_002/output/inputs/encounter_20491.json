{
  "schema_version": "1.0",
  "encounter_id": "20491",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.52,
      "end_seconds": 4.88,
      "duration_seconds": 4.36,
      "text": "Hi, doctor, I hope I'm not disturbing you."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.06,
      "end_seconds": 10.69,
      "duration_seconds": 4.63,
      "text": "yes, come in and sit down. What brings you here today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 11.8,
      "end_seconds": 17.07,
      "duration_seconds": 5.27,
      "text": "It's soreness. I thought I'd wait, but it hasn't gone."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 22.03,
      "end_seconds": 25.88,
      "duration_seconds": 3.85,
      "text": "When was the first time you noticed it?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 27.05,
      "end_seconds": 32.21,
      "duration_seconds": 5.16,
      "text": "let me think, it's been going on for ten days"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 32.69,
      "end_seconds": 36.9,
      "duration_seconds": 4.21,
      "text": "Okay, go on. Is it bearing on you a lot?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 37.9,
      "end_seconds": 39.48,
      "duration_seconds": 1.58,
      "text": "Moderate, I'd say"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 40.09,
      "end_seconds": 43.17,
      "duration_seconds": 3.08,
      "text": "have you noticed anything else alongside it?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 44.36,
      "end_seconds": 48.3,
      "duration_seconds": 3.94,
      "text": "It usually comes with discomfort during sex."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 49.76,
      "end_seconds": 52.68,
      "duration_seconds": 2.92,
      "text": "have you had a thick white discharge?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 57.61,
      "end_seconds": 77.71,
      "duration_seconds": 20.1,
      "text": "Yeah, that too. As for pain when passing urine, I honestly can't say when that that began. It might have been last month or the month before. With pain when passing urine, mostly mild. It happens a couple of times a week."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 78.47,
      "end_seconds": 82.61,
      "duration_seconds": 4.14,
      "text": "Okay, anything in your past medical history I should know?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 84.16,
      "end_seconds": 87.65,
      "duration_seconds": 3.49,
      "text": "I have diabetes, for nearly five years."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 96.29,
      "end_seconds": 98.64,
      "duration_seconds": 2.35,
      "text": "Anything surgical in your history?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 99.89,
      "end_seconds": 103.89,
      "duration_seconds": 4.0,
      "text": "Just a bunion operation, six years ago."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 108.34,
      "end_seconds": 112.39,
      "duration_seconds": 4.05,
      "text": "Let me ask about allergies, anything at all?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 114.0,
      "end_seconds": 124.59,
      "duration_seconds": 10.59,
      "text": "I think I reacted to some antibiotic once, years ago. I don't remember which one, or what happened exactly"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 141.39,
      "end_seconds": 143.81,
      "duration_seconds": 2.42,
      "text": "Do you take any regular medication?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 144.82,
      "end_seconds": 147.58,
      "duration_seconds": 2.76,
      "text": "No, nothing at the moment."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 149.03,
      "end_seconds": 152.3,
      "duration_seconds": 3.27,
      "text": "okay, a few questions about your lifestyle now"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 154.01,
      "end_seconds": 166.75,
      "duration_seconds": 12.74,
      "text": "Nothing, I'm teetotal. No, I've never smoked in my life. I'm a plumber, lots of bending and kneeling. Not much, I mostly stay in these days."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 169.72,
      "end_seconds": 173.56,
      "duration_seconds": 3.84,
      "text": "Have you had any being pregnant or smell?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 175.44,
      "end_seconds": 179.65,
      "duration_seconds": 4.21,
      "text": "I haven't had being pregnant or smell, no."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 181.26,
      "end_seconds": 186.0,
      "duration_seconds": 4.74,
      "text": "And what about fever, bleeding between periods or pelvic pain?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 187.48,
      "end_seconds": 190.63,
      "duration_seconds": 3.15,
      "text": "None of those, you know, no."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 192.66,
      "end_seconds": 194.62,
      "duration_seconds": 1.96,
      "text": "Is your digestion otherwise okay?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 195.18,
      "end_seconds": 197.78,
      "duration_seconds": 2.6,
      "text": "bowels are regular, nothing odd"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 203.01,
      "end_seconds": 206.42,
      "duration_seconds": 3.41,
      "text": "Any muscle or joint problems besides this?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 208.23,
      "end_seconds": 210.07,
      "duration_seconds": 1.84,
      "text": "I move fine otherwise."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 212.16,
      "end_seconds": 220.97,
      "duration_seconds": 8.81,
      "text": "Here are the numbers, doctor. Temperature is 36.6 degrees, blood pressure 114 over 72, heart rate 79. Saturation 97 percent."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 224.89,
      "end_seconds": 225.59,
      "duration_seconds": 0.7,
      "text": "thanks"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 226.83,
      "end_seconds": 230.66,
      "duration_seconds": 3.83,
      "text": "Now I'm going to do a short physical check."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 232.46,
      "end_seconds": 233.85,
      "duration_seconds": 1.39,
      "text": "Breathe out slowly."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 244.02,
      "end_seconds": 249.46,
      "duration_seconds": 5.44,
      "text": "There is a thick white discharge with redness of the vulva and no ulcers."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 253.76,
      "end_seconds": 256.41,
      "duration_seconds": 2.65,
      "text": "alright, you can sit up now"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 270.89,
      "end_seconds": 280.49,
      "duration_seconds": 9.6,
      "text": "Having listened and examined, I'm honestly not certain yet. It could be vaginal thrush, or it might be bacterial vaginosis."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 284.14,
      "end_seconds": 287.14,
      "duration_seconds": 3.0,
      "text": "Is there something to worry about?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 287.68,
      "end_seconds": 304.53,
      "duration_seconds": 16.85,
      "text": "Nothing I've seen today points to an emergency. It looks like vaginal thrush, but I'd like to confirm. So, to recap quickly. You've had soreness for ten days, moderate, and no bleeding between periods or pelvic pain."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 306.22,
      "end_seconds": 307.86,
      "duration_seconds": 1.64,
      "text": "Yes, that's right."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 309.49,
      "end_seconds": 313.79,
      "duration_seconds": 4.3,
      "text": "I've already done a urine test, it's ready for you."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 315.32,
      "end_seconds": 332.71,
      "duration_seconds": 17.39,
      "text": "Right, thank you. I'd like to arrange a swab for vaginal discharge. For this, fluconazole, 150 milligrams, once, for one day. You take it by mouth. That's for thrush. The pharmacy will go through the details again when you pick it it up."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 333.48,
      "end_seconds": 335.15,
      "duration_seconds": 1.67,
      "text": "that's simple enough"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 336.16,
      "end_seconds": 346.52,
      "duration_seconds": 10.36,
      "text": "Wear cotton underwear and avoid scented soaps or washes. Let's plan a check if it isn't better in a week. Have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 347.42,
      "end_seconds": 349.5,
      "duration_seconds": 2.08,
      "text": "Thank you, doctor, goodbye."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 350.18,
      "end_seconds": 351.53,
      "duration_seconds": 1.35,
      "text": "Take care now."
    }
  ]
}