{
  "schema_version": "1.0",
  "encounter_id": "20246",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.86,
      "end_seconds": 3.02,
      "duration_seconds": 2.16,
      "text": "Hi, sit anywhere you like."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 4.72,
      "end_seconds": 8.88,
      "duration_seconds": 4.16,
      "text": "Um, hello, thanks for fitting me in."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 9.84,
      "end_seconds": 16.8,
      "duration_seconds": 6.96,
      "text": "good afternoon, doctor. I look after them so I thought I'd come"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 18.54,
      "end_seconds": 24.81,
      "duration_seconds": 6.27,
      "text": "That's fine, sit down. We'll go through it together. What's the main thing today?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 25.95,
      "end_seconds": 33.12,
      "duration_seconds": 7.17,
      "text": "It's my heart racing, doctor. She didn't want to come, but I insisted."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 35.16,
      "end_seconds": 37.88,
      "duration_seconds": 2.72,
      "text": "I'll just record a few vital signs."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 48.56,
      "end_seconds": 50.72,
      "duration_seconds": 2.16,
      "text": "nearly done with the readings.."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 62.38,
      "end_seconds": 74.18,
      "duration_seconds": 11.8,
      "text": "Okay: pressure 133 over 84, temperature is 36.7 degrees, weight 91 kilos, pulse 104, height 169 centimetres. Is it it bearing on you a lot?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 75.1,
      "end_seconds": 78.46,
      "duration_seconds": 3.36,
      "text": "about a three out of ten"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 79.08,
      "end_seconds": 80.88,
      "duration_seconds": 1.8,
      "text": "Does anything help it?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 82.0,
      "end_seconds": 86.9,
      "duration_seconds": 4.9,
      "text": "So, you know, lying down helps a bit."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 88.8,
      "end_seconds": 90.78,
      "duration_seconds": 1.98,
      "text": "does anything set it off?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 96.94,
      "end_seconds": 112.47,
      "duration_seconds": 15.53,
      "text": "I notice it more with stress and I've been feeling lightheaded as well, for two months yeah, about feeling lightheaded, honestly, on and off i get some relief from sitting down"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 113.42,
      "end_seconds": 116.84,
      "duration_seconds": 3.42,
      "text": "Any a fluttering in your chest as well?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 119.8,
      "end_seconds": 128.7,
      "duration_seconds": 8.9,
      "text": "Yeah. Nearly five years, um, I'd say. With fluttering in my chest, I'd call it mild."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 129.09,
      "end_seconds": 129.79,
      "duration_seconds": 0.7,
      "text": "Understood."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 143.23,
      "end_seconds": 149.13,
      "duration_seconds": 5.9,
      "text": "Let me check a few things. Any sweating, weight loss, fainting or leg swelling?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 150.83,
      "end_seconds": 154.41,
      "duration_seconds": 3.58,
      "text": "No, um, none that I've noticed."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 156.47,
      "end_seconds": 158.76,
      "duration_seconds": 2.29,
      "text": "Has your skin been okay?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 160.61,
      "end_seconds": 163.64,
      "duration_seconds": 3.03,
      "text": "Nothing on the skin, no."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 164.2,
      "end_seconds": 167.91,
      "duration_seconds": 3.71,
      "text": "Let me ask about allergies, anything at all?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 169.99,
      "end_seconds": 173.02,
      "duration_seconds": 3.03,
      "text": "Not to my knowledge, no."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 173.61,
      "end_seconds": 181.63,
      "duration_seconds": 8.02,
      "text": "Actually, I remember she had some kind of reaction to erythromycin before. I couldn't swear to it."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 183.0,
      "end_seconds": 186.45,
      "duration_seconds": 3.45,
      "text": "I mean, I don't remember that."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 188.22,
      "end_seconds": 190.85,
      "duration_seconds": 2.63,
      "text": "Okay, I'll note both of those."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 204.14,
      "end_seconds": 207.92,
      "duration_seconds": 3.78,
      "text": "Which medicines do you take at the moment?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 213.93,
      "end_seconds": 218.86,
      "duration_seconds": 4.93,
      "text": "actually, I'm on glimepiride, 2 milligrams, maybe, before breakfast"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 219.93,
      "end_seconds": 224.97,
      "duration_seconds": 5.04,
      "text": "have you got the the box or the prescription on you?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 230.89,
      "end_seconds": 238.21,
      "duration_seconds": 7.32,
      "text": "No, it's at home. I used to take glibenclamide, but I stopped it."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 239.15,
      "end_seconds": 241.29,
      "duration_seconds": 2.14,
      "text": "Tell me about your eating."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 243.16,
      "end_seconds": 249.39,
      "duration_seconds": 6.23,
      "text": "I drink a lot of tea and snack through the day"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 250.05,
      "end_seconds": 252.0,
      "duration_seconds": 1.95,
      "text": "Who lives with you?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 255.59,
      "end_seconds": 258.22,
      "duration_seconds": 2.63,
      "text": "My partner and our baby."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 259.43,
      "end_seconds": 261.4,
      "duration_seconds": 1.97,
      "text": "Okay, are you active?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 263.37,
      "end_seconds": 267.0,
      "duration_seconds": 3.63,
      "text": "I walk the dog every morning."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 282.45,
      "end_seconds": 285.8,
      "duration_seconds": 3.35,
      "text": "Has anyone ever diagnosed you with something?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 286.47,
      "end_seconds": 310.09,
      "duration_seconds": 23.62,
      "text": "An underactive thyroid, for about a year. I did try to ignore it for a while. I have high blood pressure. Mm, I've had diabetes for five years now. My neighbour said I should get it looked at."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 311.66,
      "end_seconds": 314.2,
      "duration_seconds": 2.54,
      "text": "Have you ever had an operation?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 314.73,
      "end_seconds": 324.88,
      "duration_seconds": 10.15,
      "text": "sorry, um, what was I saying, yes, I had keyhole surgery on my gallbladder, two years back"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 327.27,
      "end_seconds": 330.63,
      "duration_seconds": 3.36,
      "text": "Okay, time for me to examine you."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 331.9,
      "end_seconds": 333.36,
      "duration_seconds": 1.46,
      "text": "Does that hurt?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 341.09,
      "end_seconds": 344.74,
      "duration_seconds": 3.65,
      "text": "the pulse is irregular, around ninety beats a minute"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 345.92,
      "end_seconds": 347.11,
      "duration_seconds": 1.19,
      "text": "Nearly finished here."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 355.85,
      "end_seconds": 359.28,
      "duration_seconds": 3.43,
      "text": "Heart sounds are normal with no murmur"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 364.47,
      "end_seconds": 378.58,
      "duration_seconds": 14.11,
      "text": "That's all I needed to check. Right, here's what I'm thinking. The most likely explanation is paroxysmal palpitations, possibly an atrial arrhythmia. I can't rule out an overactive thyroid yet."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 379.55,
      "end_seconds": 381.14,
      "duration_seconds": 1.59,
      "text": "Is this permanent?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 383.08,
      "end_seconds": 414.92,
      "duration_seconds": 31.84,
      "text": "nothing I've seen today points to an emergency. It looks like paroxysmal palpitations, possibly an atrial arrhythmia, but I'd like to confirm. Let's get an ECG, for palpitations. Let's get a thyroid test, for palpitations. The treatment will be bisoprolol, 2.5 milligrams, once a day, until review. It's for heart rate control. Cut right back on coffee, tea and energy drinks for now"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 415.45,
      "end_seconds": 423.86,
      "duration_seconds": 8.41,
      "text": "And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 424.51,
      "end_seconds": 428.31,
      "duration_seconds": 3.8,
      "text": "yes, I'll bear that in mind"
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 429.52,
      "end_seconds": 447.01,
      "duration_seconds": 17.49,
      "text": "A heart monitor for a few days is something we might do if this doesn't improve in a month. We'll catch up after the monitor results are back. Right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 448.88,
      "end_seconds": 453.47,
      "duration_seconds": 4.59,
      "text": "Okay, um, that makes sense. Thanks for explaining."
    }
  ]
}