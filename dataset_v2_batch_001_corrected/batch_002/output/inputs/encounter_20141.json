{
  "schema_version": "1.0",
  "encounter_id": "20141",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.52,
      "end_seconds": 2.81,
      "duration_seconds": 2.29,
      "text": "good morning, grab a seat"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 3.6,
      "end_seconds": 9.1,
      "duration_seconds": 5.5,
      "text": "hi doctor, I got here as fast as I could"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 10.02,
      "end_seconds": 12.37,
      "duration_seconds": 2.35,
      "text": "Alright, what's been worrying you?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 13.03,
      "end_seconds": 18.53,
      "duration_seconds": 5.5,
      "text": "So the the thing is, I've got headaches in the morning."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 19.32,
      "end_seconds": 22.19,
      "duration_seconds": 2.87,
      "text": "How long has it been like this?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 23.12,
      "end_seconds": 27.29,
      "duration_seconds": 4.17,
      "text": "it's been nearly five years, I'm fairly sure"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 27.5,
      "end_seconds": 37.3,
      "duration_seconds": 9.8,
      "text": "Yes. Can you describe it a bit more for me? How strong it is, what the pattern is, what helps."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 38.28,
      "end_seconds": 46.19,
      "duration_seconds": 7.91,
      "text": "Mostly moderate. It's a few times a day. I get some relief from lying down."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 47.97,
      "end_seconds": 51.34,
      "duration_seconds": 3.37,
      "text": "has there been blurred vision at times too?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 51.97,
      "end_seconds": 58.62,
      "duration_seconds": 6.65,
      "text": "Yeah. Three weeks, I'd say. About blurred vision at times, it's mild, honestly."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 59.19,
      "end_seconds": 68.68,
      "duration_seconds": 9.49,
      "text": "Doctor, I've got the readings for you. Temperature is 36.5 degrees, heart rate 73, pressure 146 over 90, SpO2 97 percent on room air."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 69.51,
      "end_seconds": 70.49,
      "duration_seconds": 0.98,
      "text": "Okay, noted."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 73.18,
      "end_seconds": 76.73,
      "duration_seconds": 3.55,
      "text": "Could you come over to the couch, please?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 78.32,
      "end_seconds": 79.74,
      "duration_seconds": 1.42,
      "text": "breathe out slowly"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 87.58,
      "end_seconds": 93.35,
      "duration_seconds": 5.77,
      "text": "the back of your eyes looks fine and your heart sounds are normal"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 95.66,
      "end_seconds": 97.96,
      "duration_seconds": 2.3,
      "text": "You can sit up now."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 112.83,
      "end_seconds": 114.5,
      "duration_seconds": 1.67,
      "text": "Nothing like slurred speech?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 115.38,
      "end_seconds": 117.41,
      "duration_seconds": 2.03,
      "text": "no slurred speech, thankfully"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 119.37,
      "end_seconds": 125.7,
      "duration_seconds": 6.33,
      "text": "A few quick ones: weakness on one side, passing less urine or chest pain?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 127.21,
      "end_seconds": 129.69,
      "duration_seconds": 2.48,
      "text": "No, none that I've noticed."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 134.81,
      "end_seconds": 137.86,
      "duration_seconds": 3.05,
      "text": "How are your bowels, any trouble?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 142.55,
      "end_seconds": 144.48,
      "duration_seconds": 1.93,
      "text": "no, all normal there"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 146.49,
      "end_seconds": 149.22,
      "duration_seconds": 2.73,
      "text": "Any muscle or joint problems besides this?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 150.05,
      "end_seconds": 151.86,
      "duration_seconds": 1.81,
      "text": "No, nothing there."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 153.28,
      "end_seconds": 156.0,
      "duration_seconds": 2.72,
      "text": "Are you on any regular medication?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 158.08,
      "end_seconds": 161.21,
      "duration_seconds": 3.13,
      "text": "No, I don't take any tablets."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 168.34,
      "end_seconds": 171.13,
      "duration_seconds": 2.79,
      "text": "do you have any chronic illnesses?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 173.08,
      "end_seconds": 174.61,
      "duration_seconds": 1.53,
      "text": "I have diabetes"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 179.54,
      "end_seconds": 184.6,
      "duration_seconds": 5.06,
      "text": "Ah. Do you react to any medicines or foods? Any allergies?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 190.73,
      "end_seconds": 193.17,
      "duration_seconds": 2.44,
      "text": "I've never had an allergy."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 194.61,
      "end_seconds": 198.71,
      "duration_seconds": 4.1,
      "text": "Any inherited conditions that you know of in the family?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 202.01,
      "end_seconds": 203.88,
      "duration_seconds": 1.87,
      "text": "my grandmother had dementia"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 204.5,
      "end_seconds": 207.1,
      "duration_seconds": 2.6,
      "text": "Anything you do to stay fit?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 208.31,
      "end_seconds": 211.99,
      "duration_seconds": 3.68,
      "text": "I do a yoga class on Thursdays."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 213.79,
      "end_seconds": 216.63,
      "duration_seconds": 2.84,
      "text": "What line of work are you in?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 218.59,
      "end_seconds": 224.29,
      "duration_seconds": 5.7,
      "text": "I'm a bus driver, so I sit for long hours."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 231.68,
      "end_seconds": 234.16,
      "duration_seconds": 2.48,
      "text": "Have you ever had an operation?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 235.73,
      "end_seconds": 239.6,
      "duration_seconds": 3.87,
      "text": "Just a varicose vein procedure, last year."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 240.37,
      "end_seconds": 249.48,
      "duration_seconds": 9.11,
      "text": "Taking everything into account, I'd lean towards poorly controlled high blood pressure. A side effect of a medicine is still possible."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 253.87,
      "end_seconds": 256.15,
      "duration_seconds": 2.28,
      "text": "Is it dangerous, doctor?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 257.05,
      "end_seconds": 270.79,
      "duration_seconds": 13.74,
      "text": "It's reasonable to be concerned, but right now poorly controlled high blood pressure is my leading thought, not anything worse. I'm going to order a home blood pressure diary, for hypertension."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 271.6,
      "end_seconds": 274.99,
      "duration_seconds": 3.39,
      "text": "Where would I go for that?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 276.33,
      "end_seconds": 281.95,
      "duration_seconds": 5.62,
      "text": "do I need a a urine test? I read it might help"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 283.56,
      "end_seconds": 292.62,
      "duration_seconds": 9.06,
      "text": "Not at this point, no. It isn't indicated yet. Book a review in two weeks. That's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 293.39,
      "end_seconds": 296.55,
      "duration_seconds": 3.16,
      "text": "No, that's all. Thanks a lot."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 299.71,
      "end_seconds": 301.05,
      "duration_seconds": 1.34,
      "text": "see you soon"
    }
  ]
}