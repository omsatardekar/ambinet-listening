{
  "schema_version": "1.0",
  "encounter_id": "20067",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.27,
      "end_seconds": 6.11,
      "duration_seconds": 4.84,
      "text": "I mean, sorry, doctor, shall I sit here?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.95,
      "end_seconds": 11.2,
      "duration_seconds": 4.25,
      "text": "Of course, leave it there. How can I help?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 11.99,
      "end_seconds": 19.42,
      "duration_seconds": 7.43,
      "text": "Yeah, it's pain in my right shoulder. I don't know what's causing it."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 20.64,
      "end_seconds": 23.78,
      "duration_seconds": 3.14,
      "text": "Can you tell me when it first started?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 25.18,
      "end_seconds": 36.93,
      "duration_seconds": 11.75,
      "text": "I'm not sure when it began, you know, to be honest. Some weeks ago, but I can't say how many."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 38.75,
      "end_seconds": 41.77,
      "duration_seconds": 3.02,
      "text": "Okay, how often do you get it?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 42.87,
      "end_seconds": 46.65,
      "duration_seconds": 3.78,
      "text": "I'd say once or twice a day."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 47.4,
      "end_seconds": 50.03,
      "duration_seconds": 2.63,
      "text": "Is there anything else with it?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 51.39,
      "end_seconds": 56.1,
      "duration_seconds": 4.71,
      "text": "It usually comes with difficulty combing my hair."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 57.37,
      "end_seconds": 62.27,
      "duration_seconds": 4.9,
      "text": "What about a clicking in the shoulder, have you noticed that?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 68.11,
      "end_seconds": 70.89,
      "duration_seconds": 2.78,
      "text": "Yeah. Six months, I'd say."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 75.49,
      "end_seconds": 83.58,
      "duration_seconds": 8.09,
      "text": "Here are the numbers, doctor. Temperature 36.6, pulse is 76 beats a minute, blood pressure 118 over 78."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 84.96,
      "end_seconds": 86.29,
      "duration_seconds": 1.33,
      "text": "Good, thank you."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 87.99,
      "end_seconds": 92.33,
      "duration_seconds": 4.34,
      "text": "I'll examine you in a second, make yourself comfortable."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 93.58,
      "end_seconds": 95.56,
      "duration_seconds": 1.98,
      "text": "Raise your arm for me."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 104.39,
      "end_seconds": 115.13,
      "duration_seconds": 10.74,
      "text": "There is pain when you lift the arm out to the side between about sixty and one hundred and twenty degrees, and the grip strength is normal."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 118.73,
      "end_seconds": 126.15,
      "duration_seconds": 7.42,
      "text": "All finished, thank you. Let me check a few things. Any fall or injury, numbness or chest pain?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 127.14,
      "end_seconds": 133.37,
      "duration_seconds": 6.23,
      "text": "Well, no fall or injury, numbness or chest pain, none of it."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 134.13,
      "end_seconds": 136.85,
      "duration_seconds": 2.72,
      "text": "Did you get fever or neck pain?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 138.79,
      "end_seconds": 142.96,
      "duration_seconds": 4.17,
      "text": "Let me think, none of those, no."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 144.31,
      "end_seconds": 147.78,
      "duration_seconds": 3.47,
      "text": "Okay, anything different when you pass water?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 149.45,
      "end_seconds": 151.1,
      "duration_seconds": 1.65,
      "text": "Nothing there, no."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 169.71,
      "end_seconds": 172.39,
      "duration_seconds": 2.68,
      "text": "Do you have any chronic illnesses?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 173.97,
      "end_seconds": 182.63,
      "duration_seconds": 8.66,
      "text": "Well, I've had high blood pressure, yes. Uh, uh, I've had migraines, yes."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 198.96,
      "end_seconds": 201.74,
      "duration_seconds": 2.78,
      "text": "Have you ever had an operation?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 203.43,
      "end_seconds": 207.34,
      "duration_seconds": 3.91,
      "text": "Just my tonsils removed, as a teenager."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 207.86,
      "end_seconds": 212.41,
      "duration_seconds": 4.55,
      "text": "What about your parents, brothers or sisters, any conditions?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 213.21,
      "end_seconds": 220.22,
      "duration_seconds": 7.01,
      "text": "My grandfather had a stroke. Hmm, my sister had breast cancer."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 221.83,
      "end_seconds": 226.23,
      "duration_seconds": 4.4,
      "text": "Any allergies to tablets, food or anything in the environment?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 227.43,
      "end_seconds": 231.83,
      "duration_seconds": 4.4,
      "text": "I don't think I have any, no."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 235.73,
      "end_seconds": 241.11,
      "duration_seconds": 5.38,
      "text": "Tell me about your routine, work, habits, that sort of thing."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 241.8,
      "end_seconds": 257.94,
      "duration_seconds": 16.14,
      "text": "I'm a plumber, lots of bending and kneeling. I drink a lot of tea and snack through the day. My husband and I live above the shop."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 270.07,
      "end_seconds": 274.56,
      "duration_seconds": 4.49,
      "text": "Can you list what you take, tablets, creams or inhalers?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 275.49,
      "end_seconds": 280.48,
      "duration_seconds": 4.99,
      "text": "I take hydrochlorothiazide, 12.5 milligrams, maybe, every morning."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 281.4,
      "end_seconds": 285.73,
      "duration_seconds": 4.33,
      "text": "Did you happen to bring the box or the paperwork?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 287.81,
      "end_seconds": 296.64,
      "duration_seconds": 8.83,
      "text": "Okay, so no, it's at home. Propranolol. I take it 40 milligrams, twice a day."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 297.27,
      "end_seconds": 301.88,
      "duration_seconds": 4.61,
      "text": "Doctor, our chart from the last visit lists it as 80 milligrams."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 302.65,
      "end_seconds": 307.03,
      "duration_seconds": 4.38,
      "text": "Hm. Do you have the latest prescription with you?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 307.98,
      "end_seconds": 319.58,
      "duration_seconds": 11.6,
      "text": "Okay, uh, so not with me. I'll bring it next time. Okay, so I take diclofenac gel, twice a day."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 320.3,
      "end_seconds": 322.4,
      "duration_seconds": 2.1,
      "text": "When did you start it?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 323.72,
      "end_seconds": 325.21,
      "duration_seconds": 1.49,
      "text": "Two years now."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 326.13,
      "end_seconds": 336.14,
      "duration_seconds": 10.01,
      "text": "So, based on the history and the examination, this looks most like a rotator cuff tendon problem. A frozen shoulder is also on my list."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 337.42,
      "end_seconds": 341.34,
      "duration_seconds": 3.92,
      "text": "I'm scared it's something bad. Is it?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 342.71,
      "end_seconds": 359.71,
      "duration_seconds": 17.0,
      "text": "I can't promise yet, but most people with a rotator cuff tendon problem do well once it's treated properly. I think an ultrasound of the shoulder makes sense here, for shoulder pain. I'll request a shoulder X-ray, it'll help with shoulder pain."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 360.9,
      "end_seconds": 364.42,
      "duration_seconds": 3.52,
      "text": "Where would I go for that?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 368.75,
      "end_seconds": 379.87,
      "duration_seconds": 11.12,
      "text": "Keep the shoulder moving gently within comfort and avoid heavy overhead lifting. I'd like you to see physiotherapy as well, and I'll write the referral."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 381.21,
      "end_seconds": 381.91,
      "duration_seconds": 0.7,
      "text": "Okay."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 383.78,
      "end_seconds": 400.61,
      "duration_seconds": 16.83,
      "text": "And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose. Book a review after the scan. Alright, is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 402.53,
      "end_seconds": 407.65,
      "duration_seconds": 5.12,
      "text": "Mm, uh, no, that's all. Thanks a lot."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 408.69,
      "end_seconds": 409.95,
      "duration_seconds": 1.26,
      "text": "All the best."
    }
  ]
}