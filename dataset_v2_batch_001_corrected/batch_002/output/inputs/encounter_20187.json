{
  "schema_version": "1.0",
  "encounter_id": "20187",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.99,
      "end_seconds": 6.85,
      "duration_seconds": 5.86,
      "text": "Doctor, hi, where would you like me to put my coat?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.52,
      "end_seconds": 11.36,
      "duration_seconds": 3.84,
      "text": "That's fine, sit down. Tell me why you came."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 13.37,
      "end_seconds": 17.47,
      "duration_seconds": 4.1,
      "text": "Thank you for fitting us in, doctor."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 19.07,
      "end_seconds": 21.95,
      "duration_seconds": 2.88,
      "text": "Absolutely, come and sit beside them."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 22.65,
      "end_seconds": 29.39,
      "duration_seconds": 6.74,
      "text": "It's, It's trouble sleeping, doctor. She didn't want to come, but I insisted."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 30.65,
      "end_seconds": 32.39,
      "duration_seconds": 1.74,
      "text": "When did this begin?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 34.25,
      "end_seconds": 42.87,
      "duration_seconds": 8.62,
      "text": "Erm, it's been about a month now. I did try to ignore it for a while."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 43.14,
      "end_seconds": 46.91,
      "duration_seconds": 3.77,
      "text": "Sure. Right, is it bearing on you a lot?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 48.59,
      "end_seconds": 50.92,
      "duration_seconds": 2.33,
      "text": "I'd call it mild."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 51.57,
      "end_seconds": 54.65,
      "duration_seconds": 3.08,
      "text": "Have you had tingling in your feet?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 55.62,
      "end_seconds": 60.19,
      "duration_seconds": 4.57,
      "text": "Erm, yes, about the same, four weeks."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 61.62,
      "end_seconds": 65.17,
      "duration_seconds": 3.55,
      "text": "Any health conditions I should have on record?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 66.66,
      "end_seconds": 73.19,
      "duration_seconds": 6.53,
      "text": "I've had diabetes, yes. I've got high blood pressure. I've got heart disease."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 75.26,
      "end_seconds": 80.33,
      "duration_seconds": 5.07,
      "text": "So, can you list what you take, tablets, creams or inhalers?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 82.16,
      "end_seconds": 94.72,
      "duration_seconds": 12.56,
      "text": "Okay, so it's gliclazide, 80 milligrams, twice a day, doctor. Um, she is on losartan, once a day, I give it to her."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 96.09,
      "end_seconds": 98.45,
      "duration_seconds": 2.36,
      "text": "Do you know the dose?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 99.81,
      "end_seconds": 108.86,
      "duration_seconds": 9.05,
      "text": "It's, It's 50 milligrams. It's, It's clopidogrel, 75 milligrams, once a day for the stent, doctor."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 110.72,
      "end_seconds": 112.61,
      "duration_seconds": 1.89,
      "text": "And for how long?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 114.23,
      "end_seconds": 121.01,
      "duration_seconds": 6.78,
      "text": "For two years. Yeah, uh, she takes magnesium tablets, at night."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 122.04,
      "end_seconds": 124.84,
      "duration_seconds": 2.8,
      "text": "Since when have you been taking it?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 126.09,
      "end_seconds": 128.19,
      "duration_seconds": 2.1,
      "text": "About a year now."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 130.12,
      "end_seconds": 131.36,
      "duration_seconds": 1.24,
      "text": "Are you active?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 132.86,
      "end_seconds": 135.81,
      "duration_seconds": 2.95,
      "text": "I walk the dog every morning."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 139.2,
      "end_seconds": 140.92,
      "duration_seconds": 1.72,
      "text": "Have you retired yet?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 142.79,
      "end_seconds": 148.33,
      "duration_seconds": 5.54,
      "text": "I retired from the post office two years ago."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 156.21,
      "end_seconds": 160.48,
      "duration_seconds": 4.27,
      "text": "What about your parents, brothers or sisters, any conditions?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 162.33,
      "end_seconds": 164.86,
      "duration_seconds": 2.53,
      "text": "My mother had a stroke."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 177.81,
      "end_seconds": 180.15,
      "duration_seconds": 2.34,
      "text": "Have you had any surgical procedures?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 181.06,
      "end_seconds": 187.62,
      "duration_seconds": 6.56,
      "text": "Yes, I had two stents put in my heart, three years ago."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 189.32,
      "end_seconds": 193.35,
      "duration_seconds": 4.03,
      "text": "Any chest pain or redness of the leg at all?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 195.1,
      "end_seconds": 201.4,
      "duration_seconds": 6.3,
      "text": "Let me think, you know, no, I'd have said so."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 202.37,
      "end_seconds": 209.23,
      "duration_seconds": 6.86,
      "text": "Any weakness in the legs, shortness of breath or swelling of the legs at all?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 211.08,
      "end_seconds": 214.31,
      "duration_seconds": 3.23,
      "text": "Yeah, no, none that I've noticed."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 216.86,
      "end_seconds": 218.98,
      "duration_seconds": 2.12,
      "text": "Has your skin been okay?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 219.58,
      "end_seconds": 220.64,
      "duration_seconds": 1.06,
      "text": "No rashes."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 228.34,
      "end_seconds": 231.04,
      "duration_seconds": 2.7,
      "text": "Let me quickly check your readings."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 239.73,
      "end_seconds": 242.42,
      "duration_seconds": 2.69,
      "text": "Bear with me while this finishes..."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 257.08,
      "end_seconds": 264.78,
      "duration_seconds": 7.7,
      "text": "Okay: heart rate 81, respiratory rate 16, BP is 125 over 77, SpO2 99 percent on room air."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 265.28,
      "end_seconds": 267.78,
      "duration_seconds": 2.5,
      "text": "Is that alright, doctor?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 268.89,
      "end_seconds": 271.29,
      "duration_seconds": 2.4,
      "text": "I'll come back to the numbers."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 274.02,
      "end_seconds": 276.42,
      "duration_seconds": 2.4,
      "text": "Let's move on to the examination."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 279.64,
      "end_seconds": 281.95,
      "duration_seconds": 2.31,
      "text": "Okay, you know, doctor."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 283.61,
      "end_seconds": 286.76,
      "duration_seconds": 3.15,
      "text": "Stay as you are for a moment."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 298.66,
      "end_seconds": 305.43,
      "duration_seconds": 6.77,
      "text": "Both calves are soft and not tender, and the pulses at your feet are good."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 310.35,
      "end_seconds": 319.76,
      "duration_seconds": 9.41,
      "text": "Thank you, you can get dressed. Okay, thinking it through, it fits best with night-time muscle cramps without a worrying cause."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 320.66,
      "end_seconds": 322.4,
      "duration_seconds": 1.74,
      "text": "Is this permanent?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 322.9,
      "end_seconds": 336.98,
      "duration_seconds": 14.08,
      "text": "Nothing I've seen today points to an emergency. It looks like night-time muscle cramps without a worrying cause. There's nothing new for me to start or arrange today. Does all of that make sense?"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 338.4,
      "end_seconds": 341.65,
      "duration_seconds": 3.25,
      "text": "Alright, uh, thanks, take care."
    }
  ]
}