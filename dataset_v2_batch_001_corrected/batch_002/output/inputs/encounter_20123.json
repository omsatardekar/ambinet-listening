{
  "schema_version": "1.0",
  "encounter_id": "20123",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.57,
      "end_seconds": 7.51,
      "duration_seconds": 6.94,
      "text": "Mm, hello doctor, sorry, I took a wrong turn on the way here."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.95,
      "end_seconds": 13.0,
      "duration_seconds": 4.05,
      "text": "Yes, have a seat. Tell me what's going on."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 17.85,
      "end_seconds": 27.42,
      "duration_seconds": 9.57,
      "text": "Ah, you know, doctor, it's blurred vision at times. It's getting on my nerves now."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 28.24,
      "end_seconds": 31.86,
      "duration_seconds": 3.62,
      "text": "Let me get the readings out of the way."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 44.0,
      "end_seconds": 46.39,
      "duration_seconds": 2.39,
      "text": "Keep your arm relaxed for me..."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 55.45,
      "end_seconds": 69.11,
      "duration_seconds": 13.66,
      "text": "Okay: BP is 164 over 90, pulse is 92 beats a minute, saturation 98 percent, respiratory rate 18, temp 36.9 degrees. What's the timeline, when did it begin?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 70.11,
      "end_seconds": 72.92,
      "duration_seconds": 2.81,
      "text": "About... well, about three months."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 74.97,
      "end_seconds": 79.19,
      "duration_seconds": 4.22,
      "text": "Alright, rate it for me, mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 80.65,
      "end_seconds": 86.33,
      "duration_seconds": 5.68,
      "text": "Maybe a eight out of ten on a bad day."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 87.19,
      "end_seconds": 90.6,
      "duration_seconds": 3.41,
      "text": "Alright, have you had headaches in the morning?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 92.0,
      "end_seconds": 100.72,
      "duration_seconds": 8.72,
      "text": "Yeah. About a month, I'd say. As for headaches in the morning, I'd say mild."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 107.75,
      "end_seconds": 111.77,
      "duration_seconds": 4.02,
      "text": "Did you get chest pain, ankle swelling or slurred speech?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 113.57,
      "end_seconds": 117.98,
      "duration_seconds": 4.41,
      "text": "Okay, so no, I'd have said so."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 119.65,
      "end_seconds": 124.02,
      "duration_seconds": 4.37,
      "text": "A few quick ones: passing less urine or shortness of breath?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 125.67,
      "end_seconds": 130.29,
      "duration_seconds": 4.62,
      "text": "No, um, I haven't had any of them."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 132.24,
      "end_seconds": 134.72,
      "duration_seconds": 2.48,
      "text": "How are your bowels, any trouble?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 135.4,
      "end_seconds": 138.21,
      "duration_seconds": 2.81,
      "text": "Nothing unusual, you know, no."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 139.79,
      "end_seconds": 141.92,
      "duration_seconds": 2.13,
      "text": "Is your mobility otherwise okay?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 143.51,
      "end_seconds": 145.67,
      "duration_seconds": 2.16,
      "text": "No, joints are fine."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 146.53,
      "end_seconds": 150.83,
      "duration_seconds": 4.3,
      "text": "Alright, do you take any prescribed or over-the-counter medicines?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 151.35,
      "end_seconds": 161.39,
      "duration_seconds": 10.04,
      "text": "I take rosuvastatin, 10 milligrams, at night. I mean, I'd been on atorvastatin, not any more though, I stopped."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 176.66,
      "end_seconds": 179.17,
      "duration_seconds": 2.51,
      "text": "Do you have any long-term conditions?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 181.23,
      "end_seconds": 183.47,
      "duration_seconds": 2.24,
      "text": "I have high cholesterol."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 184.24,
      "end_seconds": 188.35,
      "duration_seconds": 4.11,
      "text": "Do you react to any medicines or foods? Any allergies?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 189.6,
      "end_seconds": 192.65,
      "duration_seconds": 3.05,
      "text": "Yeah, no allergies at all."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 195.8,
      "end_seconds": 197.07,
      "duration_seconds": 1.27,
      "text": "How about smoking?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 197.66,
      "end_seconds": 200.72,
      "duration_seconds": 3.06,
      "text": "I gave up cigarettes last spring."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 201.51,
      "end_seconds": 204.46,
      "duration_seconds": 2.95,
      "text": "What do you do during the day?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 210.22,
      "end_seconds": 214.08,
      "duration_seconds": 3.86,
      "text": "I look after my grandchildren most days."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 215.13,
      "end_seconds": 217.36,
      "duration_seconds": 2.23,
      "text": "Do you get out much?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 218.79,
      "end_seconds": 222.8,
      "duration_seconds": 4.01,
      "text": "Not much, I mostly stay in these days."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 224.31,
      "end_seconds": 226.66,
      "duration_seconds": 2.35,
      "text": "Is there someone at home?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 227.96,
      "end_seconds": 232.49,
      "duration_seconds": 4.53,
      "text": "My husband and I live above the shop."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 233.99,
      "end_seconds": 237.55,
      "duration_seconds": 3.56,
      "text": "Is there anything relevant on the family side?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 241.57,
      "end_seconds": 245.46,
      "duration_seconds": 3.89,
      "text": "I mean, my mother had a stroke."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 247.97,
      "end_seconds": 251.02,
      "duration_seconds": 3.05,
      "text": "Alright, may I examine you now?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 253.01,
      "end_seconds": 255.2,
      "duration_seconds": 2.19,
      "text": "Tell me if that's sore."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 262.52,
      "end_seconds": 267.59,
      "duration_seconds": 5.07,
      "text": "The back of your eyes looks fine and your heart sounds are normal."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 271.81,
      "end_seconds": 274.31,
      "duration_seconds": 2.5,
      "text": "Good, you can sit up again."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 292.42,
      "end_seconds": 322.35,
      "duration_seconds": 29.93,
      "text": "From what you've told me and what I found, it points towards poorly controlled high blood pressure. The reason I say that is that your story and my examination fit together. A side effect of a medicine is still possible. Check your blood pressure at home twice a day for a week and bring the readings. Right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 324.05,
      "end_seconds": 326.75,
      "duration_seconds": 2.7,
      "text": "Well, thank you, that's helpful."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 327.68,
      "end_seconds": 329.31,
      "duration_seconds": 1.63,
      "text": "Have a good day."
    }
  ]
}