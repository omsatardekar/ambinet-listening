{
  "schema_version": "1.0",
  "encounter_id": "20496",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.0,
      "end_seconds": 5.95,
      "duration_seconds": 4.95,
      "text": "Hi, doctor, I hope I'm not disturbing you."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.07,
      "end_seconds": 11.82,
      "duration_seconds": 4.75,
      "text": "You're alright, take a seat. What can I do for you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 13.46,
      "end_seconds": 22.56,
      "duration_seconds": 9.1,
      "text": "Sorry, what was I saying, hello, doctor. I'm here with them in case I can help."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 23.49,
      "end_seconds": 26.57,
      "duration_seconds": 3.08,
      "text": "Please do. Extra information is always welcome."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 27.78,
      "end_seconds": 33.71,
      "duration_seconds": 5.93,
      "text": "So, So the thing is, I've got drenching night sweats."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 35.31,
      "end_seconds": 39.77,
      "duration_seconds": 4.46,
      "text": "Right, when was the first time you noticed it?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 40.68,
      "end_seconds": 43.65,
      "duration_seconds": 2.97,
      "text": "About... well, about four days."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 44.02,
      "end_seconds": 50.09,
      "duration_seconds": 6.07,
      "text": "I follow. Okay, give me more detail on it, whatever comes to mind."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 51.16,
      "end_seconds": 56.93,
      "duration_seconds": 5.77,
      "text": "It, It feels severe to me. It happens all the time."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 58.03,
      "end_seconds": 60.8,
      "duration_seconds": 2.77,
      "text": "Have you been feeling run down?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 61.6,
      "end_seconds": 71.93,
      "duration_seconds": 10.33,
      "text": "Yes, uh, actually. I mean, uh, and there's itching all over as well, about two weeks now."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 73.97,
      "end_seconds": 77.7,
      "duration_seconds": 3.73,
      "text": "Okay, would you say mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 79.72,
      "end_seconds": 83.48,
      "duration_seconds": 3.76,
      "text": "A seven out of ten, I suppose."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 85.53,
      "end_seconds": 87.28,
      "duration_seconds": 1.75,
      "text": "Any sign of cough?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 88.9,
      "end_seconds": 90.81,
      "duration_seconds": 1.91,
      "text": "No, no cough."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 92.65,
      "end_seconds": 97.9,
      "duration_seconds": 5.25,
      "text": "Did you get recent travel, joint pain, chest pain or weight loss?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 100.49,
      "end_seconds": 103.21,
      "duration_seconds": 2.72,
      "text": "Mm, nope, nothing like that."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 103.93,
      "end_seconds": 105.56,
      "duration_seconds": 1.63,
      "text": "How's your breathing otherwise?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 107.05,
      "end_seconds": 109.45,
      "duration_seconds": 2.4,
      "text": "No problems with breathing."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 111.41,
      "end_seconds": 116.52,
      "duration_seconds": 5.11,
      "text": "Has anything ever caused you a reaction? I mean any allergies."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 118.25,
      "end_seconds": 122.83,
      "duration_seconds": 4.58,
      "text": "Yes, plasters. I get a red itchy rash."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 124.78,
      "end_seconds": 126.37,
      "duration_seconds": 1.59,
      "text": "Do you drink alcohol?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 127.81,
      "end_seconds": 132.24,
      "duration_seconds": 4.43,
      "text": "I'll have a glass of wine with dinner."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 133.3,
      "end_seconds": 134.59,
      "duration_seconds": 1.29,
      "text": "What's your work?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 136.23,
      "end_seconds": 141.15,
      "duration_seconds": 4.92,
      "text": "I'm a plumber, lots of bending and kneeling."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 142.07,
      "end_seconds": 143.66,
      "duration_seconds": 1.59,
      "text": "How active are you?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 144.47,
      "end_seconds": 147.95,
      "duration_seconds": 3.48,
      "text": "I hardly move around during the day."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 149.64,
      "end_seconds": 152.95,
      "duration_seconds": 3.31,
      "text": "Alright, are you on your own at home?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 153.64,
      "end_seconds": 156.87,
      "duration_seconds": 3.23,
      "text": "I live with my elderly mother."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 158.01,
      "end_seconds": 160.88,
      "duration_seconds": 2.87,
      "text": "Okay, do you have any long-term conditions?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 162.82,
      "end_seconds": 176.12,
      "duration_seconds": 13.3,
      "text": "I've had high cholesterol, yes. I've had high blood pressure for two years now. Sorry, you know, I know I'm rambling a bit."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 180.84,
      "end_seconds": 191.52,
      "duration_seconds": 10.68,
      "text": "Right, so high cholesterol and high blood pressure are already on your record. We'll keep that in mind today. What do you take on a normal day?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 192.09,
      "end_seconds": 206.56,
      "duration_seconds": 14.47,
      "text": "She is on simvastatin, 20 milligrams, at night for my cholesterol, I give it to her. She is on ramipril, 5 milligrams, every morning, I give it to her."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 215.78,
      "end_seconds": 219.06,
      "duration_seconds": 3.28,
      "text": "Shall I check your blood pressure and pulse?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 228.3,
      "end_seconds": 230.57,
      "duration_seconds": 2.27,
      "text": "Nearly done with the readings..."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 251.86,
      "end_seconds": 259.12,
      "duration_seconds": 7.26,
      "text": "Okay: pressure 114 over 74, saturation 97 percent, heart rate 108, temperature is 38.0 degrees."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 260.91,
      "end_seconds": 262.57,
      "duration_seconds": 1.66,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 264.24,
      "end_seconds": 266.68,
      "duration_seconds": 2.44,
      "text": "I'll come back to the numbers."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 285.12,
      "end_seconds": 300.29,
      "duration_seconds": 15.17,
      "text": "Okay, so my impression from what you've said is this: It fits best with an enlarged gland with night sweats that needs a proper work-up. I'd like to arrange an ultrasound of the armpit for lymph node."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 301.97,
      "end_seconds": 304.76,
      "duration_seconds": 2.79,
      "text": "Do I need to prepare?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 309.15,
      "end_seconds": 337.43,
      "duration_seconds": 28.28,
      "text": "I'd like to arrange a chest X-ray for night sweats. Blood tests is what I'd like next, for night sweats. That will help us see what's going on underneath and decide the next step. Keep a note of your temperature each evening. Don't skip meals, and try to eat smaller portions more often through the day. I'd like you to see the haematology clinic as well, and I'll write the referral."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 338.47,
      "end_seconds": 342.07,
      "duration_seconds": 3.6,
      "text": "Do get help quickly if the symptoms get worse."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 343.91,
      "end_seconds": 345.57,
      "duration_seconds": 1.66,
      "text": "I'll remember that."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 347.11,
      "end_seconds": 349.45,
      "duration_seconds": 2.34,
      "text": "Book a review in a week."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 350.87,
      "end_seconds": 351.57,
      "duration_seconds": 0.7,
      "text": "Sure."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 352.08,
      "end_seconds": 357.9,
      "duration_seconds": 5.82,
      "text": "Can you run through the plan with me quickly, just to be certain?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 359.65,
      "end_seconds": 364.71,
      "duration_seconds": 5.06,
      "text": "So, I come back in a week. Is that right?"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 366.58,
      "end_seconds": 372.37,
      "duration_seconds": 5.79,
      "text": "Yes, exactly right. Is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 373.32,
      "end_seconds": 378.17,
      "duration_seconds": 4.85,
      "text": "Right, you know, I think I understand everything. Thanks."
    }
  ]
}