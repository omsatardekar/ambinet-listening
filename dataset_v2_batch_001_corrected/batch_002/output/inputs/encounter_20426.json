{
  "schema_version": "1.0",
  "encounter_id": "20426",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.38,
      "end_seconds": 5.94,
      "duration_seconds": 4.56,
      "text": "Hi, doctor, I hope I'm not disturbing you."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.82,
      "end_seconds": 10.74,
      "duration_seconds": 3.92,
      "text": "Of course, leave it there. How can I help?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 11.67,
      "end_seconds": 16.72,
      "duration_seconds": 5.05,
      "text": "morning, doctor. I'll stay and fill in anything that's missed"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 18.62,
      "end_seconds": 21.25,
      "duration_seconds": 2.63,
      "text": "Absolutely, come and sit beside them."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 22.12,
      "end_seconds": 27.94,
      "duration_seconds": 5.82,
      "text": "doctor, it's pain in my heel that's what we're worried about"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 29.34,
      "end_seconds": 31.0,
      "duration_seconds": 1.66,
      "text": "When did this begin?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 32.21,
      "end_seconds": 36.12,
      "duration_seconds": 3.91,
      "text": "It's been six months, I'm fairly sure."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 37.04,
      "end_seconds": 44.44,
      "duration_seconds": 7.4,
      "text": "and the other thing I wanted to mention is that I can't really—"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 44.54,
      "end_seconds": 50.18,
      "duration_seconds": 5.64,
      "text": "Tell the doctor about the other thing, that's what worries me."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 51.42,
      "end_seconds": 54.52,
      "duration_seconds": 3.1,
      "text": "Erm, I was getting to that!"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 56.52,
      "end_seconds": 60.16,
      "duration_seconds": 3.64,
      "text": "What about pain after exercise, have you noticed that?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 65.02,
      "end_seconds": 70.45,
      "duration_seconds": 5.43,
      "text": "yes, for six months about pain after exercise, mostly moderate"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 71.34,
      "end_seconds": 77.28,
      "duration_seconds": 5.94,
      "text": "Have you had pain in your heel before, or is this the first time?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 78.85,
      "end_seconds": 85.45,
      "duration_seconds": 6.6,
      "text": "I had a similar thing a couple of years ago. It went away."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 86.71,
      "end_seconds": 92.31,
      "duration_seconds": 5.6,
      "text": "have you noticed back pain, swelling, joint pain elsewhere or fever?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 92.89,
      "end_seconds": 107.67,
      "duration_seconds": 14.78,
      "text": "No, no back pain, no swelling, no joint pain elsewhere. I did have pain after sitting for a while at one point, but that went away on its own."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 109.09,
      "end_seconds": 113.11,
      "duration_seconds": 4.02,
      "text": "Have you had any injury or numbness in the foot?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 119.12,
      "end_seconds": 124.9,
      "duration_seconds": 5.78,
      "text": "I haven't had injury or numbness in the foot, no."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 128.85,
      "end_seconds": 131.49,
      "duration_seconds": 2.64,
      "text": "So, any trouble with the waterworks?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 133.2,
      "end_seconds": 134.61,
      "duration_seconds": 1.41,
      "text": "No changes there."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 148.19,
      "end_seconds": 150.27,
      "duration_seconds": 2.08,
      "text": "Is there someone at home?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 151.67,
      "end_seconds": 155.91,
      "duration_seconds": 4.24,
      "text": "My husband and I live above the shop."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 157.56,
      "end_seconds": 161.59,
      "duration_seconds": 4.03,
      "text": "Any inherited conditions that you know of in the family?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 163.36,
      "end_seconds": 168.74,
      "duration_seconds": 5.38,
      "text": "My grandfather had a stroke. My sister had breast cancer."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 169.48,
      "end_seconds": 175.16,
      "duration_seconds": 5.68,
      "text": "Tell me your medicines, please. Bear with me, I'm just building up the picture."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 176.38,
      "end_seconds": 184.3,
      "duration_seconds": 7.92,
      "text": "it's a... um, I can't remember what it's called it's a small white one"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 185.41,
      "end_seconds": 188.11,
      "duration_seconds": 2.7,
      "text": "Do you remember what it's for?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 189.17,
      "end_seconds": 205.79,
      "duration_seconds": 16.62,
      "text": "For my mood, I believe. My son sets them out for me, I just take what I'm given. I had Foracort inhaler at one point, but I'm off it now."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 206.84,
      "end_seconds": 213.47,
      "duration_seconds": 6.63,
      "text": "Let me ask about allergies, anything at all? Just so I get the full picture."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 214.88,
      "end_seconds": 226.23,
      "duration_seconds": 11.35,
      "text": "I think I reacted to some antibiotic once, you know, years ago i don't remember which one, or what happened exactly"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 228.24,
      "end_seconds": 232.21,
      "duration_seconds": 3.97,
      "text": "Tell me about any past illnesses or ongoing conditions."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 232.92,
      "end_seconds": 238.83,
      "duration_seconds": 5.91,
      "text": "I've got asthma. I did try to ignore it for a while."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 239.67,
      "end_seconds": 241.6,
      "duration_seconds": 1.93,
      "text": "Is there anything more?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 243.52,
      "end_seconds": 249.27,
      "duration_seconds": 5.75,
      "text": "Yes, depression. I kept putting it off, which I know isn't sensible."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 250.8,
      "end_seconds": 254.69,
      "duration_seconds": 3.89,
      "text": "Alright, asthma, that matches what I have here."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 271.99,
      "end_seconds": 274.49,
      "duration_seconds": 2.5,
      "text": "Let me take your readings now."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 281.29,
      "end_seconds": 284.02,
      "duration_seconds": 2.73,
      "text": "Keep your arm relaxed for me..."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 294.34,
      "end_seconds": 300.25,
      "duration_seconds": 5.91,
      "text": "Okay: pressure 108 over 80, heart rate 66, oxygen saturation is 99 percent."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 301.32,
      "end_seconds": 302.76,
      "duration_seconds": 1.44,
      "text": "is that normal?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 307.92,
      "end_seconds": 312.68,
      "duration_seconds": 4.76,
      "text": "They help me see the the whole picture, more shortly."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 314.69,
      "end_seconds": 318.35,
      "duration_seconds": 3.66,
      "text": "Now I'm going to do a short physical check."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 319.59,
      "end_seconds": 321.18,
      "duration_seconds": 1.59,
      "text": "Let me feel here."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 334.13,
      "end_seconds": 344.13,
      "duration_seconds": 10.0,
      "text": "There is a sore spot at the inner front of the heel bone and pulling the toes back makes it worse."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 345.75,
      "end_seconds": 347.42,
      "duration_seconds": 1.67,
      "text": "yes, that's fine"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 352.23,
      "end_seconds": 375.38,
      "duration_seconds": 23.15,
      "text": "So, that's all I needed to check. Taking everything into account, the most likely explanation is plantar fasciitis. I'd also keep a heel spur in mind. I'm going to order a foot X-ray, for heel pain. I'm prescribing ibuprofen gel, three times a day, for two weeks. That should help with heel pain."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 376.49,
      "end_seconds": 379.95,
      "duration_seconds": 3.46,
      "text": "Is that safe with my other medicines?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 380.89,
      "end_seconds": 394.22,
      "duration_seconds": 13.33,
      "text": "Stretch the calf and the sole of the foot before getting out of bed and wear cushioned shoes. I'll want another look in six weeks. Anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 394.88,
      "end_seconds": 396.9,
      "duration_seconds": 2.02,
      "text": "thank you, that's helpful"
    }
  ]
}