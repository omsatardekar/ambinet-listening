{
  "schema_version": "1.0",
  "encounter_id": "20325",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.53,
      "end_seconds": 5.86,
      "duration_seconds": 5.33,
      "text": "Hi, um, doctor, I hope I'm not disturbing you."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.77,
      "end_seconds": 10.68,
      "duration_seconds": 3.91,
      "text": "Yes, have a seat. Tell me what's going on."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 12.3,
      "end_seconds": 17.94,
      "duration_seconds": 5.64,
      "text": "Mainly I've been feeling shaky and sweaty. That's why I came."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 19.64,
      "end_seconds": 21.97,
      "duration_seconds": 2.33,
      "text": "Let's run through your medicines."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 23.41,
      "end_seconds": 29.4,
      "duration_seconds": 5.99,
      "text": "I take sitagliptin, 100 milligrams, once a day for my sugar."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 29.93,
      "end_seconds": 33.64,
      "duration_seconds": 3.71,
      "text": "How many days or weeks has it been?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 35.4,
      "end_seconds": 39.38,
      "duration_seconds": 3.98,
      "text": "It's been going on for about a week."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 40.46,
      "end_seconds": 50.78,
      "duration_seconds": 10.32,
      "text": "Tell me a bit more about it: how bad it gets, how often, and whether anything makes it better or worse."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 51.64,
      "end_seconds": 62.66,
      "duration_seconds": 11.02,
      "text": "A five out of ten, I suppose. Yes, missing meals. That makes it worse. I get some relief from sugary drinks."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 67.03,
      "end_seconds": 69.69,
      "duration_seconds": 2.66,
      "text": "So, is it accompanied by anything?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 71.12,
      "end_seconds": 79.97,
      "duration_seconds": 8.85,
      "text": "It usually comes with a pounding heart. The pounding heart? That's been for about four days."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 81.58,
      "end_seconds": 86.83,
      "duration_seconds": 5.25,
      "text": "Let me check a few things. Any chest pain, seizure or slurred speech?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 88.21,
      "end_seconds": 93.67,
      "duration_seconds": 5.46,
      "text": "I haven't had chest pain, seizure or slurred speech, no."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 96.65,
      "end_seconds": 100.41,
      "duration_seconds": 3.76,
      "text": "Any pins and needles or loss of strength anywhere?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 102.23,
      "end_seconds": 103.74,
      "duration_seconds": 1.51,
      "text": "Nothing odd there."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 105.24,
      "end_seconds": 107.6,
      "duration_seconds": 2.36,
      "text": "Any breathing difficulties apart from this?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 109.3,
      "end_seconds": 110.37,
      "duration_seconds": 1.07,
      "text": "Breathing's normal."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 111.42,
      "end_seconds": 114.81,
      "duration_seconds": 3.39,
      "text": "Let me ask about allergies, anything at all?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 116.13,
      "end_seconds": 120.97,
      "duration_seconds": 4.84,
      "text": "I don't think I have any, um, no."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 131.19,
      "end_seconds": 133.72,
      "duration_seconds": 2.53,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 134.87,
      "end_seconds": 136.61,
      "duration_seconds": 1.74,
      "text": "No surgery, no."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 137.82,
      "end_seconds": 141.14,
      "duration_seconds": 3.32,
      "text": "Are you in work at the moment?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 141.86,
      "end_seconds": 146.49,
      "duration_seconds": 4.63,
      "text": "Yes, I work in a bakery, early starts."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 148.53,
      "end_seconds": 150.88,
      "duration_seconds": 2.35,
      "text": "Do you follow any particular diet?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 152.34,
      "end_seconds": 156.23,
      "duration_seconds": 3.89,
      "text": "I'm vegetarian and have been for years."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 156.93,
      "end_seconds": 159.61,
      "duration_seconds": 2.68,
      "text": "Do you have any chronic illnesses?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 160.72,
      "end_seconds": 164.02,
      "duration_seconds": 3.3,
      "text": "I have diabetes, for about ten years."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 167.85,
      "end_seconds": 173.76,
      "duration_seconds": 5.91,
      "text": "Right, so diabetes is already on your record. We'll keep that in mind today."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 192.42,
      "end_seconds": 195.1,
      "duration_seconds": 2.68,
      "text": "Let me take your readings now."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 204.68,
      "end_seconds": 207.35,
      "duration_seconds": 2.67,
      "text": "Bear with me while this finishes..."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 221.91,
      "end_seconds": 232.38,
      "duration_seconds": 10.47,
      "text": "Okay: BP is 125 over 76, oxygen saturation is 98 percent, pulse is 74 beats a minute. And temp 36.5 degrees."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 234.35,
      "end_seconds": 235.73,
      "duration_seconds": 1.38,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 237.08,
      "end_seconds": 240.25,
      "duration_seconds": 3.17,
      "text": "So, I'll interpret them after the examination."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 241.27,
      "end_seconds": 245.87,
      "duration_seconds": 4.6,
      "text": "I'll need to examine you for this, it won't take long."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 246.71,
      "end_seconds": 248.8,
      "duration_seconds": 2.09,
      "text": "Hold that for a second."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 264.14,
      "end_seconds": 268.82,
      "duration_seconds": 4.68,
      "text": "Your fingerprick sugar now is normal and your heart rate is steady."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 281.83,
      "end_seconds": 282.84,
      "duration_seconds": 1.01,
      "text": "Sure thing."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 288.38,
      "end_seconds": 291.41,
      "duration_seconds": 3.03,
      "text": "Okay, good, you can sit up again."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 305.39,
      "end_seconds": 321.2,
      "duration_seconds": 15.81,
      "text": "Let me tell you where I've got to. This looks most like episodes of low blood sugar related to diabetes treatment. I want to be honest that this is an impression, not a final answer."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 322.98,
      "end_seconds": 325.75,
      "duration_seconds": 2.77,
      "text": "Do you think it's something serious?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 326.8,
      "end_seconds": 364.27,
      "duration_seconds": 37.47,
      "text": "It's reasonable to be concerned, but right now episodes of low blood sugar related to diabetes treatment is my leading thought, not anything worse. Let's book blood tests to look into low sugar. Never skip meals when you take the sugar tablet, and keep glucose tablets or juice with you. Please don't wait if you have an episode that does not settle with sugar. That's when to be seen urgently. Book a review after the blood tests."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 365.32,
      "end_seconds": 368.51,
      "duration_seconds": 3.19,
      "text": "Anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 369.18,
      "end_seconds": 372.47,
      "duration_seconds": 3.29,
      "text": "Good, thanks, I'll see you then."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 373.03,
      "end_seconds": 374.36,
      "duration_seconds": 1.33,
      "text": "Look after yourself."
    }
  ]
}