{
  "schema_version": "1.0",
  "encounter_id": "20449",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 0.57,
      "end_seconds": 8.58,
      "duration_seconds": 8.01,
      "text": "Doctor, the patient's with us now. I did the usual checks at the front, so just say when you want them."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 10.43,
      "end_seconds": 14.7,
      "duration_seconds": 4.27,
      "text": "Thank you. Good morning, tell me what's been going on."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 15.41,
      "end_seconds": 21.02,
      "duration_seconds": 5.61,
      "text": "Let me think, thank you for fitting us in, doctor."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 22.46,
      "end_seconds": 30.54,
      "duration_seconds": 8.08,
      "text": "Doctor, you know, it's a cough that won't go away. It's getting on my nerves now."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 31.06,
      "end_seconds": 34.52,
      "duration_seconds": 3.46,
      "text": "what's the timeline, when did it begin?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 35.4,
      "end_seconds": 46.84,
      "duration_seconds": 11.44,
      "text": "it's been going on for about four days a neighbour of mine said I should see someone about it"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 48.57,
      "end_seconds": 56.53,
      "duration_seconds": 7.96,
      "text": "can you describe it a bit more for me? How strong it is, what the pattern is, what helps"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 57.98,
      "end_seconds": 74.47,
      "duration_seconds": 16.49,
      "text": "let me think, I'd give it a three, out of ten it happens once or twice a day i just want to get back to normal, really"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 75.24,
      "end_seconds": 78.19,
      "duration_seconds": 2.95,
      "text": "Okay, does anything else come with it?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 79.86,
      "end_seconds": 94.28,
      "duration_seconds": 14.42,
      "text": "Hmm, when it starts I tend to get a tight chest in the morning as well. The tight chest in the morning? That's been for about four days."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 96.18,
      "end_seconds": 104.94,
      "duration_seconds": 8.76,
      "text": "Tell me a bit more about it: how bad it gets, how often, and whether anything makes it better or worse."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 109.95,
      "end_seconds": 123.92,
      "duration_seconds": 13.97,
      "text": "Okay, so it's a few times a day. Maybe a eight out of ten on a bad day. I mean, I've also been getting breathless on the stairs."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 125.68,
      "end_seconds": 136.91,
      "duration_seconds": 11.23,
      "text": "Here are the numbers, doctor. Saturation 99 percent, respiratory rate 17, pulse is 66 beats a minute, BP is 121 over 80, temperature is 36.9 degrees."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 138.09,
      "end_seconds": 139.04,
      "duration_seconds": 0.95,
      "text": "Okay, noted."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 140.54,
      "end_seconds": 144.47,
      "duration_seconds": 3.93,
      "text": "Alright, over here please and I'll take a look."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 145.99,
      "end_seconds": 147.46,
      "duration_seconds": 1.47,
      "text": "Does that hurt?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 162.77,
      "end_seconds": 167.62,
      "duration_seconds": 4.85,
      "text": "the chest is clear and your oxygen level is normal"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 168.39,
      "end_seconds": 170.36,
      "duration_seconds": 1.97,
      "text": "Yes, that's fine."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 176.03,
      "end_seconds": 178.87,
      "duration_seconds": 2.84,
      "text": "Good, you can sit up again."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 188.02,
      "end_seconds": 191.14,
      "duration_seconds": 3.12,
      "text": "have you had any sharp chest pain?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 192.26,
      "end_seconds": 195.08,
      "duration_seconds": 2.82,
      "text": "No. No sharp chest pain."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 196.84,
      "end_seconds": 203.67,
      "duration_seconds": 6.83,
      "text": "Let me check a few things. Any leg swelling, night sweats or coughing up blood?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 205.22,
      "end_seconds": 208.26,
      "duration_seconds": 3.04,
      "text": "no, not a single one"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 208.77,
      "end_seconds": 212.61,
      "duration_seconds": 3.84,
      "text": "Yes, carry on. Is your urine normal, no changes?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 213.25,
      "end_seconds": 217.07,
      "duration_seconds": 3.82,
      "text": "I mean, no, that's all fine"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 221.73,
      "end_seconds": 225.5,
      "duration_seconds": 3.77,
      "text": "What about your tummy and bowels, anything unusual there?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 226.98,
      "end_seconds": 229.73,
      "duration_seconds": 2.75,
      "text": "Nothing unusual, you know, no."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 236.91,
      "end_seconds": 242.26,
      "duration_seconds": 5.35,
      "text": "okay, do you react to any medicines or foods? Any allergies?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 242.91,
      "end_seconds": 247.08,
      "duration_seconds": 4.17,
      "text": "Oh, no, I've never reacted to anything."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 248.06,
      "end_seconds": 254.73,
      "duration_seconds": 6.67,
      "text": "I'm not sure that's right. I seem to recall a problem with tramadol."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 259.56,
      "end_seconds": 262.36,
      "duration_seconds": 2.8,
      "text": "Really? I don't think so."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 263.98,
      "end_seconds": 270.99,
      "duration_seconds": 7.01,
      "text": "alright, so that's unclear. I'll record what each of you said. Let's run through your medicines"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 272.93,
      "end_seconds": 277.72,
      "duration_seconds": 4.79,
      "text": "erm, I'm on lansoprazole, 30 milligrams, before breakfast"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 278.83,
      "end_seconds": 291.34,
      "duration_seconds": 12.51,
      "text": "I mean, um, doctor, I think the last prescription for the lansoprazole was 60 milligrams. We changed it at the last visit."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 291.98,
      "end_seconds": 296.02,
      "duration_seconds": 4.04,
      "text": "I see. Is the the most recent prescription on you?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 296.68,
      "end_seconds": 305.79,
      "duration_seconds": 9.11,
      "text": "Ah, no, I left it at home. It's Seretide inhaler, twice a day for my asthma."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 321.13,
      "end_seconds": 323.81,
      "duration_seconds": 2.68,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 324.4,
      "end_seconds": 327.95,
      "duration_seconds": 3.55,
      "text": "No, uh, not at all."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 329.49,
      "end_seconds": 331.88,
      "duration_seconds": 2.39,
      "text": "Do you work outside the home?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 333.55,
      "end_seconds": 338.08,
      "duration_seconds": 4.53,
      "text": "I'm a hairdresser, on my feet all day."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 339.11,
      "end_seconds": 341.1,
      "duration_seconds": 1.99,
      "text": "Do you get out much?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 342.69,
      "end_seconds": 347.11,
      "duration_seconds": 4.42,
      "text": "Not much, I mostly stay in these days."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 350.05,
      "end_seconds": 353.14,
      "duration_seconds": 3.09,
      "text": "Has anyone ever diagnosed you with something?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 354.62,
      "end_seconds": 360.51,
      "duration_seconds": 5.89,
      "text": "I've got acid reflux. I have asthma, for nearly five years."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 362.61,
      "end_seconds": 364.42,
      "duration_seconds": 1.81,
      "text": "is there anything more?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 365.33,
      "end_seconds": 376.6,
      "duration_seconds": 11.27,
      "text": "Alright, asthma, that matches what I have here. Taking everything into account, this is probably a lingering cough after a viral infection. Cough-variant asthma is still possible."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 377.76,
      "end_seconds": 380.84,
      "duration_seconds": 3.08,
      "text": "Is there something to worry about?"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 382.52,
      "end_seconds": 392.09,
      "duration_seconds": 9.57,
      "text": "it's reasonable to be concerned, but right now a lingering cough after a viral infection is my leading thought, not anything worse"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 393.96,
      "end_seconds": 397.47,
      "duration_seconds": 3.51,
      "text": "We've already done a chest X-ray this morning, doctor."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 399.45,
      "end_seconds": 434.82,
      "duration_seconds": 35.37,
      "text": "Right, thank you. A breathing test is what I'd like next, for breathlessness. Let's use salbutamol inhaler, 100 micrograms, two puffs when needed, for two weeks. It's for wheeze and cough. Honey and lemon in warm water can ease it, and avoid smoky rooms. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose. Please come and see me in three weeks."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 436.14,
      "end_seconds": 440.09,
      "duration_seconds": 3.95,
      "text": "I think we're done unless you have questions"
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 441.94,
      "end_seconds": 445.77,
      "duration_seconds": 3.83,
      "text": "Right, I'll do that. Thank you, doctor."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 446.73,
      "end_seconds": 447.92,
      "duration_seconds": 1.19,
      "text": "Look after yourself."
    }
  ]
}