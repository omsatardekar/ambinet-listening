    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 22.85,
      "end_seconds": 26.26,
      "duration_seconds": 3.41,
      "text": "What's the timeline, when did it begin?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 28.01,
      "end_seconds": 31.84,
      "duration_seconds": 3.83,
      "text": "Hmm, it's been two years now."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 32.56,
      "end_seconds": 35.73,
      "duration_seconds": 3.17,
      "text": "Have you been getting lost on familiar roads?"
