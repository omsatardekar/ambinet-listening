      "role": "PATIENT",
      "start_seconds": 1.24,
      "end_seconds": 7.8,
      "duration_seconds": 6.56,
      "text": "Yeah, hi, doctor, I came as soon as they called me."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.66,
      "end_seconds": 13.53,
      "duration_seconds": 4.87,
      "text": "Yes, come in and sit down. What brings you here today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 14.07,
      "end_seconds": 17.24,
      "duration_seconds": 3.17,
      "text": "I've been repeating the same question."
