    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 169.6,
      "end_seconds": 171.63,
      "duration_seconds": 2.03,
      "text": "No problems with breathing."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 172.26,
      "end_seconds": 174.88,
      "duration_seconds": 2.62,
      "text": "How are your bowels, any trouble?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 176.37,
      "end_seconds": 177.95,
      "duration_seconds": 1.58,
      "text": "Nothing unusual, no."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 183.35,
      "end_seconds": 185.18,
      "duration_seconds": 1.83,
      "text": "And alcohol, how much?"
