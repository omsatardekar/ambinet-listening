    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 193.6,
      "end_seconds": 195.93,
      "duration_seconds": 2.33,
      "text": "My partner and our baby."
