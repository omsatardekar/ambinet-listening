    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 201.03,
      "end_seconds": 203.36,
      "duration_seconds": 2.33,
      "text": "I swim twice a week."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 204.69,
      "end_seconds": 209.01,
      "duration_seconds": 4.32,
      "text": "Are you allergic to anything? Any allergies to medicines or foods?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 210.83,
      "end_seconds": 214.29,
      "duration_seconds": 3.46,
      "text": "No, nothing as far as I know."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 222.39,
      "end_seconds": 226.32,
      "duration_seconds": 3.93,
      "text": "What conditions have you been treated for in the past?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 232.49,
      "end_seconds": 234.76,
      "duration_seconds": 2.27,
      "text": "Yes, high blood pressure."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 236.49,
      "end_seconds": 244.99,
      "duration_seconds": 8.5,
      "text": "Yes, carry on. Okay, I can see high blood pressure in your file as well. Do you take any regular medication?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 246.89,
      "end_seconds": 249.82,
      "duration_seconds": 2.93,
      "text": "Actually, no, nothing at the moment."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 263.76,
      "end_seconds": 266.69,
      "duration_seconds": 2.93,
      "text": "So, have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 267.67,
      "end_seconds": 268.85,
      "duration_seconds": 1.18,
      "text": "No, never."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 270.43,
      "end_seconds": 277.78,
      "duration_seconds": 7.35,
      "text": "Taking everything into account, it fits best with a gradual memory problem that needs further assessment."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 279.61,
      "end_seconds": 282.47,
      "duration_seconds": 2.86,
      "text": "What are the odds it's serious?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 284.42,
      "end_seconds": 305.3,
      "duration_seconds": 20.88,
      "text": "I understand the worry. At the moment I'd say it's a gradual memory problem that needs further assessment, and we'll know more once the blood tests is back. Let's get blood tests, for memory loss. Is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 306.13,
      "end_seconds": 308.25,
      "duration_seconds": 2.12,
      "text": "Alright, thanks, take care."
    }
  ]
