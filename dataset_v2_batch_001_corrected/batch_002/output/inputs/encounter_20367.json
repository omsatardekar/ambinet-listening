    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 186.15,
      "end_seconds": 190.0,
      "duration_seconds": 3.85,
      "text": "I'll have a glass of wine with dinner."
