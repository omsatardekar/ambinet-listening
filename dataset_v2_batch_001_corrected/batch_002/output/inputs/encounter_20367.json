    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 190.91,
      "end_seconds": 192.73,
      "duration_seconds": 1.82,
      "text": "Who lives with you?"
