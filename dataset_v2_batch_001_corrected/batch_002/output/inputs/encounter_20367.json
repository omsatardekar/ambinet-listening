    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 197.15,
      "end_seconds": 199.19,
      "duration_seconds": 2.04,
      "text": "Do you do any exercise?"
