    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 36.8,
      "end_seconds": 39.75,
      "duration_seconds": 2.95,
      "text": "Yes, for about a month."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 41.14,
      "end_seconds": 44.01,
      "duration_seconds": 2.87,
      "text": "Let's start with the basic checks."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 56.4,
      "end_seconds": 58.62,
      "duration_seconds": 2.22,
      "text": "Okay, this won't take long..."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 79.72,
      "end_seconds": 87.49,
      "duration_seconds": 7.77,
      "text": "Okay: temperature 36.9, blood pressure 115 over 71, pulse 67, SpO2 97 percent on room air."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 88.63,
      "end_seconds": 92.72,
      "duration_seconds": 4.09,
      "text": "I'll examine you in a second, make yourself comfortable."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 104.46,
      "end_seconds": 105.51,
      "duration_seconds": 1.05,
      "text": "Of course."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 106.7,
      "end_seconds": 108.0,
      "duration_seconds": 1.3,
      "text": "Does that hurt?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 118.89,
      "end_seconds": 126.52,
      "duration_seconds": 7.63,
      "text": "The memory test score is a little low today and the rest of the neurological check is normal."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 127.95,
      "end_seconds": 129.62,
      "duration_seconds": 1.67,
      "text": "Yes, that's fine."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 135.53,
      "end_seconds": 138.01,
      "duration_seconds": 2.48,
      "text": "Good, you can sit up again."
