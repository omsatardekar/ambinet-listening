    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 153.64,
      "end_seconds": 158.66,
      "duration_seconds": 5.02,
      "text": "A few quick ones: head injury, bladder problems or falls?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 159.24,
      "end_seconds": 163.25,
      "duration_seconds": 4.01,
      "text": "No, no head injury, bladder problems or falls."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 165.31,
      "end_seconds": 167.72,
      "duration_seconds": 2.41,
      "text": "Is your chest okay generally?"
