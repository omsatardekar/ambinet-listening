{
  "schema_version": "1.0",
  "encounter_id": "20346",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.7,
      "end_seconds": 4.39,
      "duration_seconds": 3.69,
      "text": "Morning, doctor. Is this the right room?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 4.95,
      "end_seconds": 8.86,
      "duration_seconds": 3.91,
      "text": "Come in. Please sit. How can I help you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 9.74,
      "end_seconds": 14.73,
      "duration_seconds": 4.99,
      "text": "Hello, doctor. I'm here with them in case I can help."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 15.43,
      "end_seconds": 18.97,
      "duration_seconds": 3.54,
      "text": "Yes, that's no problem at all. Please sit."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 20.66,
      "end_seconds": 26.96,
      "duration_seconds": 6.3,
      "text": "It's swollen ankles, doctor. He didn't want to come, but I insisted."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 27.75,
      "end_seconds": 30.16,
      "duration_seconds": 2.41,
      "text": "I'll do your observations first."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 38.54,
      "end_seconds": 40.66,
      "duration_seconds": 2.12,
      "text": "Okay, this won't take long..."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 56.41,
      "end_seconds": 63.27,
      "duration_seconds": 6.86,
      "text": "Okay: pulse 107, respiratory rate 19, blood pressure 136 over 73, oxygen saturation is 98 percent."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 75.48,
      "end_seconds": 78.49,
      "duration_seconds": 3.01,
      "text": "What's the timeline, when did it begin?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 82.52,
      "end_seconds": 88.99,
      "duration_seconds": 6.47,
      "text": "Two months, I think... sorry, about three months, I got that wrong."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 90.96,
      "end_seconds": 100.29,
      "duration_seconds": 9.33,
      "text": "Tell me a bit more about it: how bad it gets, how often, and whether anything makes it better or worse."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 101.21,
      "end_seconds": 112.16,
      "duration_seconds": 10.95,
      "text": "Yes, evenings and standing. That makes it worse. Mostly mild. I've also been waking up breathless at night, for two months."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 113.96,
      "end_seconds": 116.78,
      "duration_seconds": 2.82,
      "text": "Is it bearing on you a lot?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 117.62,
      "end_seconds": 118.62,
      "duration_seconds": 1.0,
      "text": "Mostly moderate."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 123.87,
      "end_seconds": 127.22,
      "duration_seconds": 3.35,
      "text": "A few quick ones: fever or chest pain?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 128.72,
      "end_seconds": 139.03,
      "duration_seconds": 10.31,
      "text": "No, no fever, no chest pain. I was putting on weight quickly at one point, but that went away on its own."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 143.81,
      "end_seconds": 148.58,
      "duration_seconds": 4.77,
      "text": "A few quick ones: palpitations, calf pain or cough with blood?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 149.18,
      "end_seconds": 152.03,
      "duration_seconds": 2.85,
      "text": "No, nothing to report there."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 152.99,
      "end_seconds": 157.88,
      "duration_seconds": 4.89,
      "text": "So, any pins and needles or loss of strength anywhere?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 158.85,
      "end_seconds": 160.77,
      "duration_seconds": 1.92,
      "text": "No weakness or anything."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 162.24,
      "end_seconds": 165.3,
      "duration_seconds": 3.06,
      "text": "Any muscle or joint problems besides this?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 166.55,
      "end_seconds": 168.11,
      "duration_seconds": 1.56,
      "text": "Nothing else aches."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 173.26,
      "end_seconds": 176.05,
      "duration_seconds": 2.79,
      "text": "Do you follow any particular diet?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 177.85,
      "end_seconds": 181.3,
      "duration_seconds": 3.45,
      "text": "I'm vegetarian and have been for years."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 181.98,
      "end_seconds": 184.08,
      "duration_seconds": 2.1,
      "text": "Is there someone at home?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 185.49,
      "end_seconds": 189.8,
      "duration_seconds": 4.31,
      "text": "My husband and I live above the shop."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 199.16,
      "end_seconds": 201.48,
      "duration_seconds": 2.32,
      "text": "What about your medical history?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 203.99,
      "end_seconds": 215.46,
      "duration_seconds": 11.47,
      "text": "I've had heart failure for two years now. Uh, I've had high blood pressure, yes. Yes, an irregular heartbeat."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 217.44,
      "end_seconds": 228.69,
      "duration_seconds": 11.25,
      "text": "Alright, high blood pressure and an irregular heartbeat, that matches what I have here. Before we go further, any allergies? Take your time, there's no rush."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 230.05,
      "end_seconds": 241.67,
      "duration_seconds": 11.62,
      "text": "Hmm, there was some antibiotic, I was told I was allergic. But I couldn't tell you what it was called or what it did."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 243.65,
      "end_seconds": 246.69,
      "duration_seconds": 3.04,
      "text": "What operations have you had, if any?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 248.71,
      "end_seconds": 262.59,
      "duration_seconds": 13.88,
      "text": "Just an operation for a hernia, last spring. I've been reading about it online and it worried me. I told myself I'd wait and see, and here I am."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 263.11,
      "end_seconds": 266.96,
      "duration_seconds": 3.85,
      "text": "Do you take any prescribed or over-the-counter medicines?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 268.04,
      "end_seconds": 280.85,
      "duration_seconds": 12.81,
      "text": "I take carvedilol, 6.25 milligrams, twice a day. Losartan. I take it 50 milligrams, once a day for my blood pressure."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 282.16,
      "end_seconds": 289.13,
      "duration_seconds": 6.97,
      "text": "It's meant to be once a day, though I don't see he take it every time."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 290.84,
      "end_seconds": 298.4,
      "duration_seconds": 7.56,
      "text": "It's a... um, I can't remember what it's called. It's a round yellow one."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 299.83,
      "end_seconds": 302.49,
      "duration_seconds": 2.66,
      "text": "Do you remember what it's for?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 304.01,
      "end_seconds": 320.33,
      "duration_seconds": 16.32,
      "text": "For the blood thinning, I believe. My daughter sets them out for me, I just take what I'm given. I had bisoprolol at one point, but I'm off it now."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 321.56,
      "end_seconds": 324.8,
      "duration_seconds": 3.24,
      "text": "Right, let's have a proper look at you."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 325.63,
      "end_seconds": 326.82,
      "duration_seconds": 1.19,
      "text": "Breathe out slowly."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 343.35,
      "end_seconds": 345.42,
      "duration_seconds": 2.07,
      "text": "Your neck veins look raised."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 347.0,
      "end_seconds": 348.43,
      "duration_seconds": 1.43,
      "text": "Breathe out slowly."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 356.53,
      "end_seconds": 361.03,
      "duration_seconds": 4.5,
      "text": "There is pitting swelling up to the shins on both sides."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 364.87,
      "end_seconds": 393.07,
      "duration_seconds": 28.2,
      "text": "That's all I needed to check. From what you've told me and what I found, I think we're dealing with fluid overload from heart failure at this stage. We shouldn't forget a chest infection. We shouldn't forget a kidney problem. Just to be sure I understood. You've had swollen ankles for about three months, mild, and no chest pain or cough with blood."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 394.0,
      "end_seconds": 395.7,
      "duration_seconds": 1.7,
      "text": "Mm, that's right."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 396.53,
      "end_seconds": 399.41,
      "duration_seconds": 2.88,
      "text": "Let's get a chest X-ray, for breathlessness."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_4",
      "role": "CLINICAL_STAFF",
      "start_seconds": 400.44,
      "end_seconds": 404.45,
      "duration_seconds": 4.01,
      "text": "I can book that for Friday at 11:30 am."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 406.31,
      "end_seconds": 421.13,
      "duration_seconds": 14.82,
      "text": "I want blood tests done, that's for fluid overload. Let's get a heart ultrasound, for suspected heart failure. What I'm giving you is furosemide, 40 milligrams, every morning, long term. That's for fluid retention."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 422.11,
      "end_seconds": 423.64,
      "duration_seconds": 1.53,
      "text": "That's simple enough."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 425.38,
      "end_seconds": 447.9,
      "duration_seconds": 22.52,
      "text": "Keep the salt low and avoid adding it at the table. Weigh yourself every morning and tell us if you gain more than two kilos in three days. The thing that would worry me is if you become more breathless or gain weight quickly. If that happens, go to emergency. Book a review after the heart scan."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 449.28,
      "end_seconds": 449.98,
      "duration_seconds": 0.7,
      "text": "Right."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 451.73,
      "end_seconds": 455.47,
      "duration_seconds": 3.74,
      "text": "I think we're done unless you have questions."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 457.39,
      "end_seconds": 459.57,
      "duration_seconds": 2.18,
      "text": "Thank you, doctor, goodbye."
    }
  ]
}