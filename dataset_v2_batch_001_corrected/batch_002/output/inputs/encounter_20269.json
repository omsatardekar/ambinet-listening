{
  "schema_version": "1.0",
  "encounter_id": "20269",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.96,
      "end_seconds": 6.34,
      "duration_seconds": 5.38,
      "text": "Hello, come in. Mind the the step. Cold out there today?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 7.77,
      "end_seconds": 11.79,
      "duration_seconds": 4.02,
      "text": "freezing, I could hardly feel my hands"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 13.2,
      "end_seconds": 14.41,
      "duration_seconds": 1.21,
      "text": "what's the problem?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 15.61,
      "end_seconds": 20.01,
      "duration_seconds": 4.4,
      "text": "I've been feeling dizzy when I stand up."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 21.92,
      "end_seconds": 25.09,
      "duration_seconds": 3.17,
      "text": "How many days or weeks has it been?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 26.5,
      "end_seconds": 28.92,
      "duration_seconds": 2.42,
      "text": "for five days, I'd say"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 31.0,
      "end_seconds": 40.97,
      "duration_seconds": 9.97,
      "text": "tell me a bit more about it: how bad it gets, how often, and whether anything makes it better or worse"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 42.93,
      "end_seconds": 51.8,
      "duration_seconds": 8.87,
      "text": "It happens a few times a day. About a six out of ten. There's a dry mouth as well."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 52.93,
      "end_seconds": 55.79,
      "duration_seconds": 2.86,
      "text": "Okay, any nearly blacking out as well?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 56.34,
      "end_seconds": 59.63,
      "duration_seconds": 3.29,
      "text": "Yeah. About a week, I'd say."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 61.35,
      "end_seconds": 66.26,
      "duration_seconds": 4.91,
      "text": "Okay, give me more detail on it, whatever comes to mind."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 67.27,
      "end_seconds": 74.22,
      "duration_seconds": 6.95,
      "text": "Severe, really. Honestly, all the time. I took the morning off to come in today."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 74.76,
      "end_seconds": 78.1,
      "duration_seconds": 3.34,
      "text": "understood. Any chest pain or palpitations at all?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 79.06,
      "end_seconds": 81.95,
      "duration_seconds": 2.89,
      "text": "no, no chest pain or palpitations"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 82.41,
      "end_seconds": 86.31,
      "duration_seconds": 3.9,
      "text": "yes any vomiting, fainting or slurred speech at all?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 87.8,
      "end_seconds": 92.75,
      "duration_seconds": 4.95,
      "text": "I haven't had vomiting, fainting or slurred speech, no"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 94.83,
      "end_seconds": 96.82,
      "duration_seconds": 1.99,
      "text": "has your skin been okay?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 98.68,
      "end_seconds": 101.3,
      "duration_seconds": 2.62,
      "text": "nothing on the skin, no"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 115.37,
      "end_seconds": 119.49,
      "duration_seconds": 4.12,
      "text": "What conditions have you been treated for in the past?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 120.49,
      "end_seconds": 124.38,
      "duration_seconds": 3.89,
      "text": "High blood pressure, for about ten years."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 125.21,
      "end_seconds": 133.92,
      "duration_seconds": 8.71,
      "text": "Understood. Right, so high blood pressure is already on your record. We'll keep that in mind today. Let's run through your medicines."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 137.8,
      "end_seconds": 146.03,
      "duration_seconds": 8.23,
      "text": "It's amlodipine, 5 milligrams, once a day. I've been reading about it online and it worried me."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 147.49,
      "end_seconds": 150.29,
      "duration_seconds": 2.8,
      "text": "Have you got any known allergies?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 151.83,
      "end_seconds": 153.86,
      "duration_seconds": 2.03,
      "text": "No allergies at all."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 155.66,
      "end_seconds": 159.18,
      "duration_seconds": 3.52,
      "text": "okay, what line of work are you in?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 161.11,
      "end_seconds": 166.01,
      "duration_seconds": 4.9,
      "text": "I'm a bus driver, so I sit for long hours."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 167.34,
      "end_seconds": 169.36,
      "duration_seconds": 2.02,
      "text": "Tell me about your eating."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 173.12,
      "end_seconds": 178.39,
      "duration_seconds": 5.27,
      "text": "I drink a lot of tea and snack through the day"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 180.07,
      "end_seconds": 181.9,
      "duration_seconds": 1.83,
      "text": "How active are you?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 183.15,
      "end_seconds": 186.44,
      "duration_seconds": 3.29,
      "text": "I hardly move around during the day."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 188.12,
      "end_seconds": 191.83,
      "duration_seconds": 3.71,
      "text": "Now I'm going to do a short physical check."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 193.88,
      "end_seconds": 194.93,
      "duration_seconds": 1.05,
      "text": "okay, doctor"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 195.96,
      "end_seconds": 198.1,
      "duration_seconds": 2.14,
      "text": "tell me if that's sore"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 209.75,
      "end_seconds": 214.12,
      "duration_seconds": 4.37,
      "text": "Heart sounds are normal and the the chest is clear."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 215.89,
      "end_seconds": 217.99,
      "duration_seconds": 2.1,
      "text": "Alright, breathe out slowly."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 229.38,
      "end_seconds": 235.79,
      "duration_seconds": 6.41,
      "text": "Your blood pressure drops when you stand, from the lying reading to standing."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 237.81,
      "end_seconds": 240.73,
      "duration_seconds": 2.92,
      "text": "thank you, you can get dressed"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 252.19,
      "end_seconds": 262.15,
      "duration_seconds": 9.96,
      "text": "Putting it all together, I'd lean towards postural low blood pressure, possibly related to medicines or dehydration. I can't rule out dehydration yet."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 264.04,
      "end_seconds": 267.99,
      "duration_seconds": 3.95,
      "text": "I'm scared it's something bad. Is it?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 269.55,
      "end_seconds": 280.48,
      "duration_seconds": 10.93,
      "text": "I can't promise yet, but most people with postural low blood pressure, possibly related to medicines or dehydration do well once it's treated properly."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 293.07,
      "end_seconds": 298.62,
      "duration_seconds": 5.55,
      "text": "Let's book a lying and standing blood pressure check to look into dizziness."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 299.7,
      "end_seconds": 303.19,
      "duration_seconds": 3.49,
      "text": "right, when would that take place?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 303.7,
      "end_seconds": 323.88,
      "duration_seconds": 20.18,
      "text": "Get up slowly from lying and sitting, and keep drinking fluids through the day. Come back or go to emergency straight away if you faint or have chest pain. We'll catch up after the results are back. Is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 325.29,
      "end_seconds": 328.32,
      "duration_seconds": 3.03,
      "text": "Great, thank you for your help."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 331.79,
      "end_seconds": 333.12,
      "duration_seconds": 1.33,
      "text": "Take care now."
    }
  ]
}