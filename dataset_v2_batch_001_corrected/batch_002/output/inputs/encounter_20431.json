{
  "schema_version": "1.0",
  "encounter_id": "20431",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 0.55,
      "end_seconds": 4.47,
      "duration_seconds": 3.92,
      "text": "Morning, doctor. I've settled them in, ready when you are."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.43,
      "end_seconds": 11.28,
      "duration_seconds": 4.85,
      "text": "So, thanks, that's helpful. Hello, please sit. What's been happening?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 13.29,
      "end_seconds": 19.02,
      "duration_seconds": 5.73,
      "text": "It's swollen ankles. I thought I'd wait, but it hasn't gone."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 20.68,
      "end_seconds": 22.62,
      "duration_seconds": 1.94,
      "text": "When did this begin?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 28.9,
      "end_seconds": 31.19,
      "duration_seconds": 2.29,
      "text": "Probably nearly five years. Yeah."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 32.15,
      "end_seconds": 35.71,
      "duration_seconds": 3.56,
      "text": "Rate it for me, mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 37.17,
      "end_seconds": 43.61,
      "duration_seconds": 6.44,
      "text": "About a eight out of ten. Erm, I've also had a tight stomach."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 44.58,
      "end_seconds": 47.39,
      "duration_seconds": 2.81,
      "text": "Have you had breathlessness lying flat?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 48.68,
      "end_seconds": 51.19,
      "duration_seconds": 2.51,
      "text": "Yes, for about a month."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 52.25,
      "end_seconds": 60.86,
      "duration_seconds": 8.61,
      "text": "Can you describe it a bit more for me? How strong it is, what the pattern is, what helps."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 62.35,
      "end_seconds": 67.57,
      "duration_seconds": 5.22,
      "text": "I'd call it severe. It happens once or twice a day."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 67.77,
      "end_seconds": 74.77,
      "duration_seconds": 7.0,
      "text": "Hm, okay. Let me check a few things. Any calf pain, cough with blood or palpitations?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 76.44,
      "end_seconds": 81.85,
      "duration_seconds": 5.41,
      "text": "I haven't had calf pain, cough with blood or palpitations, no."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 82.31,
      "end_seconds": 85.77,
      "duration_seconds": 3.46,
      "text": "Hm, okay. Has there been any fainting?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 87.85,
      "end_seconds": 90.05,
      "duration_seconds": 2.2,
      "text": "No, none, no fainting."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 91.86,
      "end_seconds": 94.85,
      "duration_seconds": 2.99,
      "text": "How are your joints, any aches elsewhere?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 95.52,
      "end_seconds": 97.73,
      "duration_seconds": 2.21,
      "text": "No, joints are fine."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 98.77,
      "end_seconds": 102.14,
      "duration_seconds": 3.37,
      "text": "Do you take any prescribed or over-the-counter medicines?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 103.26,
      "end_seconds": 108.12,
      "duration_seconds": 4.86,
      "text": "Spironolactone, 25 milligrams, once a day for my heart."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 109.42,
      "end_seconds": 112.31,
      "duration_seconds": 2.89,
      "text": "Roughly how long on that one?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 113.89,
      "end_seconds": 121.96,
      "duration_seconds": 8.07,
      "text": "About about a year. I'm on ramipril, 5 milligrams, every morning for my blood pressure."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 122.51,
      "end_seconds": 125.58,
      "duration_seconds": 3.07,
      "text": "Before we go further, any allergies?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 126.27,
      "end_seconds": 129.27,
      "duration_seconds": 3.0,
      "text": "Yes, tramadol, it gives me vomiting."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 145.84,
      "end_seconds": 149.91,
      "duration_seconds": 4.07,
      "text": "Let's talk a little about your daily life and habits."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 151.47,
      "end_seconds": 159.71,
      "duration_seconds": 8.24,
      "text": "I swim twice a week. I live with my elderly mother. I'm vegetarian and have been for years."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 160.5,
      "end_seconds": 163.89,
      "duration_seconds": 3.39,
      "text": "Right, are there any illnesses in your family?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 165.23,
      "end_seconds": 167.76,
      "duration_seconds": 2.53,
      "text": "My aunt has rheumatoid arthritis."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 169.59,
      "end_seconds": 171.84,
      "duration_seconds": 2.25,
      "text": "What about your medical history?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 172.9,
      "end_seconds": 181.72,
      "duration_seconds": 8.82,
      "text": "I have heart failure, for nearly five years. I've had high blood pressure for about ten years now."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 182.95,
      "end_seconds": 187.49,
      "duration_seconds": 4.54,
      "text": "Okay, I can see heart failure in your file as well."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 205.67,
      "end_seconds": 209.04,
      "duration_seconds": 3.37,
      "text": "Did you ever have any procedures done?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 210.59,
      "end_seconds": 215.1,
      "duration_seconds": 4.51,
      "text": "Yes, I had my septum straightened, in my thirties."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 216.42,
      "end_seconds": 226.2,
      "duration_seconds": 9.78,
      "text": "Doctor, I've got the readings for you. Temp 36.9 degrees, heart rate 114, BP is 128 over 70, SpO2 99 percent on room air."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 228.03,
      "end_seconds": 229.4,
      "duration_seconds": 1.37,
      "text": "Good, thank you."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 230.94,
      "end_seconds": 235.19,
      "duration_seconds": 4.25,
      "text": "Alright, over here please and I'll take a look."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 250.14,
      "end_seconds": 251.54,
      "duration_seconds": 1.4,
      "text": "Fine by me."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 252.75,
      "end_seconds": 255.75,
      "duration_seconds": 3.0,
      "text": "Stay as you are for a moment."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 265.61,
      "end_seconds": 270.1,
      "duration_seconds": 4.49,
      "text": "I can hear crackles at the bases of both lungs."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 274.3,
      "end_seconds": 285.3,
      "duration_seconds": 11.0,
      "text": "You can relax now. So where does that leave us? This looks most like fluid overload from heart failure. I'd also keep a chest infection in mind."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 285.92,
      "end_seconds": 289.53,
      "duration_seconds": 3.61,
      "text": "Let me think, is it dangerous, doctor?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 290.42,
      "end_seconds": 304.78,
      "duration_seconds": 14.36,
      "text": "I understand the worry. At the moment I'd say it's fluid overload from heart failure, and we'll know more once the a chest X-ray is back. I'd like to arrange a chest X-ray for breathlessness."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 306.38,
      "end_seconds": 308.58,
      "duration_seconds": 2.2,
      "text": "Okay, I'll do it."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 309.76,
      "end_seconds": 321.01,
      "duration_seconds": 11.25,
      "text": "Weigh yourself every morning and tell us if you gain more than two kilos in three days. We'll refer you to the community nursing team."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 322.39,
      "end_seconds": 324.13,
      "duration_seconds": 1.74,
      "text": "Alright, thank you."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 328.5,
      "end_seconds": 334.5,
      "duration_seconds": 6.0,
      "text": "I'll want another look in one week. I think we're done unless you have questions."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 336.14,
      "end_seconds": 338.21,
      "duration_seconds": 2.07,
      "text": "Thank you, that's helpful."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 342.68,
      "end_seconds": 344.53,
      "duration_seconds": 1.85,
      "text": "Alright, all the best."
    }
  ]
}