{
  "schema_version": "1.0",
  "encounter_id": "20081",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.56,
      "end_seconds": 4.39,
      "duration_seconds": 3.83,
      "text": "hi, doctor, I hope I'm not disturbing you"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 9.95,
      "end_seconds": 13.68,
      "duration_seconds": 3.73,
      "text": "No problem at all, come in. What's troubling you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 15.35,
      "end_seconds": 24.92,
      "duration_seconds": 9.57,
      "text": "morning, doctor. I'll stay and fill in anything that's missed. Doctor, it's bleeding. That's what we're worried about"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 26.48,
      "end_seconds": 29.29,
      "duration_seconds": 2.81,
      "text": "How long has this been bothering you?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 34.3,
      "end_seconds": 37.08,
      "duration_seconds": 2.78,
      "text": "I've had it since Monday"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 38.5,
      "end_seconds": 40.15,
      "duration_seconds": 1.65,
      "text": "Does anything help it?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 41.36,
      "end_seconds": 44.28,
      "duration_seconds": 2.92,
      "text": "I get some relief from pressure."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 45.13,
      "end_seconds": 48.39,
      "duration_seconds": 3.26,
      "text": "has there been difficulty bending the finger too?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 49.95,
      "end_seconds": 57.93,
      "duration_seconds": 7.98,
      "text": "Mm, yes. About difficulty bending the finger, a six out of ten, I suppose."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 61.62,
      "end_seconds": 65.59,
      "duration_seconds": 3.97,
      "text": "What about a numb fingertip, have you noticed that?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 66.31,
      "end_seconds": 74.31,
      "duration_seconds": 8.0,
      "text": "Yeah. Two days, I'd say. About numb fingertip, it sort of comes and goes."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 76.14,
      "end_seconds": 81.92,
      "duration_seconds": 5.78,
      "text": "Did you get dirt in the wound, weakness of the hand or redness spreading?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 83.29,
      "end_seconds": 86.14,
      "duration_seconds": 2.85,
      "text": "No none of those at all."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 91.84,
      "end_seconds": 94.7,
      "duration_seconds": 2.86,
      "text": "Did you get bite or pus?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 96.06,
      "end_seconds": 100.45,
      "duration_seconds": 4.39,
      "text": "no, you know, none of those at all"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 102.09,
      "end_seconds": 104.67,
      "duration_seconds": 2.58,
      "text": "anything different when you pass water?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 106.5,
      "end_seconds": 109.85,
      "duration_seconds": 3.35,
      "text": "that's normal as far as I know"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 110.44,
      "end_seconds": 113.85,
      "duration_seconds": 3.41,
      "text": "How about your heart any problems like that?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 115.49,
      "end_seconds": 120.77,
      "duration_seconds": 5.28,
      "text": "my heart's been fine, you know, as far as I know"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 121.45,
      "end_seconds": 126.25,
      "duration_seconds": 4.8,
      "text": "alright, are there any allergies I should be aware of?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 127.99,
      "end_seconds": 141.66,
      "duration_seconds": 13.67,
      "text": "hmm, there was some antibiotic, I was told I was allergic but I couldn't tell you what it was called or what it did"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 142.78,
      "end_seconds": 145.2,
      "duration_seconds": 2.42,
      "text": "Any regular medication tablets or creams?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 146.75,
      "end_seconds": 149.58,
      "duration_seconds": 2.83,
      "text": "no, I don't take any tablets"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 150.79,
      "end_seconds": 153.6,
      "duration_seconds": 2.81,
      "text": "has anyone ever diagnosed you with something?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 154.71,
      "end_seconds": 158.33,
      "duration_seconds": 3.62,
      "text": "I've had acid reflux for five years now."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 159.46,
      "end_seconds": 160.16,
      "duration_seconds": 0.7,
      "text": "Ah."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 161.57,
      "end_seconds": 165.39,
      "duration_seconds": 3.82,
      "text": "I've had epilepsy for two years now."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 166.97,
      "end_seconds": 173.4,
      "duration_seconds": 6.43,
      "text": "I follow. Right, so epilepsy is already on your record. We'll keep that in mind today."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 181.78,
      "end_seconds": 184.7,
      "duration_seconds": 2.92,
      "text": "so, have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 185.85,
      "end_seconds": 188.85,
      "duration_seconds": 3.0,
      "text": "no, I've never been operated on"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 189.35,
      "end_seconds": 192.29,
      "duration_seconds": 2.94,
      "text": "now some background about your lifestyle"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 195.8,
      "end_seconds": 211.62,
      "duration_seconds": 15.82,
      "text": "I only drink at family occasions. I'm a plumber, lots of bending and kneeling. I hardly move around during the day. My husband and I live above the shop."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 227.01,
      "end_seconds": 230.57,
      "duration_seconds": 3.56,
      "text": "I'll just record a a few vital signs"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 243.12,
      "end_seconds": 245.33,
      "duration_seconds": 2.21,
      "text": "Okay, this won't take long..."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 262.31,
      "end_seconds": 269.77,
      "duration_seconds": 7.46,
      "text": "okay: oxygen saturation is 99 percent temperature 36.9 BP is 108 over 80. And heart rate 73."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 270.52,
      "end_seconds": 272.14,
      "duration_seconds": 1.62,
      "text": "is that okay?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 272.9,
      "end_seconds": 276.85,
      "duration_seconds": 3.95,
      "text": "don't worry, we'll discuss it in a second"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 279.14,
      "end_seconds": 282.3,
      "duration_seconds": 3.16,
      "text": "Could you come over to the couch please?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 283.69,
      "end_seconds": 285.85,
      "duration_seconds": 2.16,
      "text": "Raise your arm for me."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 294.15,
      "end_seconds": 303.16,
      "duration_seconds": 9.01,
      "text": "there is a two-centimetre clean cut over the first knuckle, the finger moves fully and the fingertip feels normal"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 307.75,
      "end_seconds": 309.44,
      "duration_seconds": 1.69,
      "text": "You can relax now."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 324.58,
      "end_seconds": 336.94,
      "duration_seconds": 12.36,
      "text": "Right, here's what I'm thinking. This is probably a clean finger laceration without nerve or tendon injury. It could also be an infected wound, so we'll keep that open."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 338.99,
      "end_seconds": 340.51,
      "duration_seconds": 1.52,
      "text": "is this permanent?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 344.9,
      "end_seconds": 364.66,
      "duration_seconds": 19.76,
      "text": "I can't promise yet but most people with a clean finger laceration without nerve or tendon injury do well once it's treated properly stop me if I've got anything wrong you've had bleeding since Monday and no pus or weakness of the hand"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 365.52,
      "end_seconds": 367.2,
      "duration_seconds": 1.68,
      "text": "yes, that's right"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 369.27,
      "end_seconds": 374.58,
      "duration_seconds": 5.31,
      "text": "I'm going to order an X-ray of the finger for laceration."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 375.68,
      "end_seconds": 376.73,
      "duration_seconds": 1.05,
      "text": "Right, understood."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 377.95,
      "end_seconds": 405.01,
      "duration_seconds": 27.06,
      "text": "we'll begin with tetanus booster 0.5 ml once for one day it's for tetanus prevention keep the dressing dry for two days and watch for redness or pus keep an eye out and if the wound becomes red hot or swollen call us the same day or go to emergency let's plan a check if it looks infected i think we're done unless you have questions"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 408.13,
      "end_seconds": 410.29,
      "duration_seconds": 2.16,
      "text": "thank you doctor goodbye"
    }
  ]
}