{
  "schema_version": "1.0",
  "encounter_id": "20021",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 1.25,
      "end_seconds": 5.71,
      "duration_seconds": 4.46,
      "text": "Doctor, we're ready in room two, I've already taken the observations."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.33,
      "end_seconds": 10.91,
      "duration_seconds": 3.58,
      "text": "Alright, thank you. Right, hello, what's the problem?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 11.8,
      "end_seconds": 21.89,
      "duration_seconds": 10.09,
      "text": "Hello, doctor. I hope it's alright if I stay in for this. Doctor, it's spots on my face. That's what we're worried about."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 23.64,
      "end_seconds": 24.92,
      "duration_seconds": 1.28,
      "text": "Since when exactly?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 28.57,
      "end_seconds": 31.9,
      "duration_seconds": 3.33,
      "text": "It's been six months, I'm fairly sure."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 32.63,
      "end_seconds": 35.92,
      "duration_seconds": 3.29,
      "text": "How much trouble does it give you?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 37.31,
      "end_seconds": 46.2,
      "duration_seconds": 8.89,
      "text": "About a four out of ten. I've had marks left after the spots too, for six months."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 48.13,
      "end_seconds": 51.74,
      "duration_seconds": 3.61,
      "text": "Is it a lot or only a little?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 55.85,
      "end_seconds": 59.72,
      "duration_seconds": 3.87,
      "text": "I'd give it a seven, out of ten."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_5",
      "role": "UNKNOWN",
      "start_seconds": 60.58,
      "end_seconds": 62.64,
      "duration_seconds": 2.06,
      "text": "Yes, exactly like that."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 64.73,
      "end_seconds": 68.63,
      "duration_seconds": 3.9,
      "text": "Alright, is there anything relevant on the family side?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 69.84,
      "end_seconds": 73.19,
      "duration_seconds": 3.35,
      "text": "Actually, my sister had breast cancer."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 74.46,
      "end_seconds": 76.37,
      "duration_seconds": 1.91,
      "text": "And alcohol, how much?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 78.27,
      "end_seconds": 82.61,
      "duration_seconds": 4.34,
      "text": "I'll have a glass of wine with dinner."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 83.2,
      "end_seconds": 85.25,
      "duration_seconds": 2.05,
      "text": "Tell me about your eating."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 87.19,
      "end_seconds": 92.22,
      "duration_seconds": 5.03,
      "text": "I drink a lot of tea and snack through the day."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 94.26,
      "end_seconds": 96.28,
      "duration_seconds": 2.02,
      "text": "Do you do any exercise?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 97.99,
      "end_seconds": 100.23,
      "duration_seconds": 2.24,
      "text": "I swim twice a week."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 118.96,
      "end_seconds": 123.48,
      "duration_seconds": 4.52,
      "text": "Are you taking anything regularly, including from the pharmacy?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 124.39,
      "end_seconds": 134.26,
      "duration_seconds": 9.87,
      "text": "Um, I'm on something called esci... escitalopram, 10 milligrams, maybe, once a day for the anxiety."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 134.91,
      "end_seconds": 139.08,
      "duration_seconds": 4.17,
      "text": "Do you have the packet or the prescription with you?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 139.73,
      "end_seconds": 146.18,
      "duration_seconds": 6.45,
      "text": "Not with me. I'll bring it next time. It's face wash, twice a day."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 151.36,
      "end_seconds": 153.49,
      "duration_seconds": 2.13,
      "text": "What about your medical history?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 154.95,
      "end_seconds": 163.25,
      "duration_seconds": 8.3,
      "text": "I've had anxiety for nearly five years now. I'm hoping you can tell me something definite."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 164.44,
      "end_seconds": 173.28,
      "duration_seconds": 8.84,
      "text": "Yes, carry on. Right, so anxiety is already on your record. We'll keep that in mind today. Any previous surgeries?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 173.82,
      "end_seconds": 174.96,
      "duration_seconds": 1.14,
      "text": "No, never."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 187.68,
      "end_seconds": 189.69,
      "duration_seconds": 2.01,
      "text": "Any fever or irregular periods?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 190.99,
      "end_seconds": 202.45,
      "duration_seconds": 11.46,
      "text": "No, no fever, no irregular periods. I did have spots on my back at one point, but that went away on its own."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 203.24,
      "end_seconds": 207.77,
      "duration_seconds": 4.53,
      "text": "Have you noticed headaches, being pregnant or excess hair growth?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 209.84,
      "end_seconds": 212.61,
      "duration_seconds": 2.77,
      "text": "No, none that I've noticed."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 213.69,
      "end_seconds": 216.12,
      "duration_seconds": 2.43,
      "text": "Is your chest okay generally?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 218.15,
      "end_seconds": 220.0,
      "duration_seconds": 1.85,
      "text": "No problems with breathing."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 221.31,
      "end_seconds": 225.5,
      "duration_seconds": 4.19,
      "text": "Any pins and needles or loss of strength anywhere?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 227.2,
      "end_seconds": 229.3,
      "duration_seconds": 2.1,
      "text": "No, nothing like that."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 230.79,
      "end_seconds": 238.98,
      "duration_seconds": 8.19,
      "text": "Here are the numbers, doctor. Temperature is 36.5 degrees, BP is 128 over 80. Pulse 80, respiratory rate 15."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 240.91,
      "end_seconds": 241.9,
      "duration_seconds": 0.99,
      "text": "Okay, noted."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 243.66,
      "end_seconds": 246.94,
      "duration_seconds": 3.28,
      "text": "Right, let's have a proper look at you."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 247.99,
      "end_seconds": 250.43,
      "duration_seconds": 2.44,
      "text": "Tell me if that's sore."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 260.75,
      "end_seconds": 267.63,
      "duration_seconds": 6.88,
      "text": "There are red inflamed lumps and blackheads over both cheeks and the forehead, and a few scars."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 270.07,
      "end_seconds": 286.66,
      "duration_seconds": 16.59,
      "text": "Please sit back down. Right, here's what I'm thinking. It fits best with moderate inflammatory acne. That's my thinking for now, and it may change as we learn more. A hormonal cause is still possible."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 288.29,
      "end_seconds": 291.3,
      "duration_seconds": 3.01,
      "text": "What are the odds it's serious?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 293.77,
      "end_seconds": 312.84,
      "duration_seconds": 19.07,
      "text": "I understand the worry. At the moment I'd say it's moderate inflammatory acne, and we'll know more once the blood tests is back. Stop me if I've got anything wrong. You've had spots on your face for six months, and no headaches or being pregnant."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 314.55,
      "end_seconds": 315.25,
      "duration_seconds": 0.7,
      "text": "Correct."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 316.54,
      "end_seconds": 354.25,
      "duration_seconds": 37.71,
      "text": "I'll request blood tests, it'll help with acne treatment baseline. For this, adapalene gel, 0.1 percent, once a night, for twelve weeks. It's for acne. Use sunscreen daily, and the gel can sting for the first couple of weeks. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose. Let's review you in twelve weeks. That's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 354.89,
      "end_seconds": 356.95,
      "duration_seconds": 2.06,
      "text": "Thank you, doctor, goodbye."
    }
  ]
}