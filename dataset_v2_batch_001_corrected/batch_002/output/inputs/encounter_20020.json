{
  "schema_version": "1.0",
  "encounter_id": "20020",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.53,
      "end_seconds": 3.35,
      "duration_seconds": 2.82,
      "text": "Good afternoon, how are you today?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 4.33,
      "end_seconds": 5.98,
      "duration_seconds": 1.65,
      "text": "What's been worrying you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 7.76,
      "end_seconds": 14.43,
      "duration_seconds": 6.67,
      "text": "Doctor, it's a cough that won't go away. It's getting on my nerves now."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 15.09,
      "end_seconds": 17.89,
      "duration_seconds": 2.8,
      "text": "How long has this been bothering you?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 18.55,
      "end_seconds": 20.71,
      "duration_seconds": 2.16,
      "text": "Probably five days. Yeah."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 22.68,
      "end_seconds": 24.63,
      "duration_seconds": 1.95,
      "text": "How frequently does it come?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 25.99,
      "end_seconds": 34.63,
      "duration_seconds": 8.64,
      "text": "It's a few times a day. I've also had a bit of a sore throat, for ten days."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 36.54,
      "end_seconds": 39.49,
      "duration_seconds": 2.95,
      "text": "Time for your numbers, if that's okay."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 51.16,
      "end_seconds": 54.02,
      "duration_seconds": 2.86,
      "text": "That's it, just a little longer..."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 65.22,
      "end_seconds": 78.65,
      "duration_seconds": 13.43,
      "text": "Okay: pressure 120 over 73, height 163 centimetres, respiratory rate 15. And weight 57 kilos, BMI works out to 21.5, heart rate 73, oxygen saturation is 97 percent."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 81.2,
      "end_seconds": 84.72,
      "duration_seconds": 3.52,
      "text": "Could you come over to the couch, please?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 97.48,
      "end_seconds": 99.03,
      "duration_seconds": 1.55,
      "text": "Yeah, no problem."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 100.09,
      "end_seconds": 102.12,
      "duration_seconds": 2.03,
      "text": "Raise your arm for me."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 118.15,
      "end_seconds": 122.86,
      "duration_seconds": 4.71,
      "text": "The chest is clear and your oxygen level is normal."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 128.38,
      "end_seconds": 130.84,
      "duration_seconds": 2.46,
      "text": "Okay, that's enough for me."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 140.5,
      "end_seconds": 143.7,
      "duration_seconds": 3.2,
      "text": "Have you noticed night sweats or fever?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 145.57,
      "end_seconds": 149.39,
      "duration_seconds": 3.82,
      "text": "No night sweats or fever, none of it."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 150.61,
      "end_seconds": 154.7,
      "duration_seconds": 4.09,
      "text": "Any weight loss, coughing up blood or leg swelling?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 156.71,
      "end_seconds": 159.51,
      "duration_seconds": 2.8,
      "text": "No, I'd have said so."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 160.56,
      "end_seconds": 163.46,
      "duration_seconds": 2.9,
      "text": "Anything different when you pass water?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 164.48,
      "end_seconds": 165.99,
      "duration_seconds": 1.51,
      "text": "Nothing there, no."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 168.01,
      "end_seconds": 170.44,
      "duration_seconds": 2.43,
      "text": "Tell me your medicines, please."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 172.47,
      "end_seconds": 176.41,
      "duration_seconds": 3.94,
      "text": "I take lansoprazole, 30 milligrams, before breakfast."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 177.51,
      "end_seconds": 180.33,
      "duration_seconds": 2.82,
      "text": "Any past operations I should know about?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 180.94,
      "end_seconds": 185.94,
      "duration_seconds": 5.0,
      "text": "Yes, I had a varicose vein procedure, last year."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 186.95,
      "end_seconds": 189.11,
      "duration_seconds": 2.16,
      "text": "Do you get out much?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 194.32,
      "end_seconds": 198.61,
      "duration_seconds": 4.29,
      "text": "Not much, I mostly stay in these days."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 199.62,
      "end_seconds": 203.0,
      "duration_seconds": 3.38,
      "text": "Are you on your own at home?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 206.86,
      "end_seconds": 210.07,
      "duration_seconds": 3.21,
      "text": "I live with my elderly mother."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 211.93,
      "end_seconds": 215.87,
      "duration_seconds": 3.94,
      "text": "Right, are you in work at the moment?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 216.58,
      "end_seconds": 220.76,
      "duration_seconds": 4.18,
      "text": "Yes, I work in a bakery, early starts."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 222.53,
      "end_seconds": 226.64,
      "duration_seconds": 4.11,
      "text": "Anything in your past medical history I should know?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 229.43,
      "end_seconds": 230.96,
      "duration_seconds": 1.53,
      "text": "Yes, acid reflux."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 232.7,
      "end_seconds": 237.88,
      "duration_seconds": 5.18,
      "text": "Right, do you react to any medicines or foods? Any allergies?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 238.78,
      "end_seconds": 243.33,
      "duration_seconds": 4.55,
      "text": "No, uh, I've never reacted to anything."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 244.66,
      "end_seconds": 251.75,
      "duration_seconds": 7.09,
      "text": "Taking everything into account, my working impression is a lingering cough after a viral infection."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 253.28,
      "end_seconds": 256.81,
      "duration_seconds": 3.53,
      "text": "I'm scared it's something bad. Is it?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 258.8,
      "end_seconds": 269.33,
      "duration_seconds": 10.53,
      "text": "It's reasonable to be concerned, but right now a lingering cough after a viral infection is my leading thought, not anything worse."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 280.87,
      "end_seconds": 310.9,
      "duration_seconds": 30.03,
      "text": "I want a breathing test done, that's for breathlessness. The result will help us decide whether anything more is needed. I want a chest X-ray done, that's for persistent cough. We'll begin with salbutamol inhaler, 100 micrograms, two puffs when needed, for two weeks. That should help with wheeze and cough. Honey and lemon in warm water can ease it, and avoid smoky rooms."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 311.68,
      "end_seconds": 327.14,
      "duration_seconds": 15.46,
      "text": "Keep an eye out, and if you cough up blood or get breathless at rest, call us the same day or go to emergency. We'll catch up after the chest X-ray. I think we're done unless you have questions."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 327.91,
      "end_seconds": 330.24,
      "duration_seconds": 2.33,
      "text": "Thank you, doctor, goodbye."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 332.18,
      "end_seconds": 333.36,
      "duration_seconds": 1.18,
      "text": "See you soon."
    }
  ]
}