{
  "schema_version": "1.0",
  "encounter_id": "20461",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.22,
      "end_seconds": 7.57,
      "duration_seconds": 6.35,
      "text": "Hmm, doctor, hi, where would you like me to put my coat?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 9.02,
      "end_seconds": 13.17,
      "duration_seconds": 4.15,
      "text": "That's fine, sit down. Tell me why you came."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 14.99,
      "end_seconds": 21.05,
      "duration_seconds": 6.06,
      "text": "Good afternoon, doctor. I look after them so I thought I'd come."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 21.84,
      "end_seconds": 25.0,
      "duration_seconds": 3.16,
      "text": "Right, absolutely, come and sit beside them."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 26.67,
      "end_seconds": 31.82,
      "duration_seconds": 5.15,
      "text": "I'm here because of bright red blood on the paper."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 33.38,
      "end_seconds": 35.85,
      "duration_seconds": 2.47,
      "text": "Did it come on recently?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 36.44,
      "end_seconds": 40.37,
      "duration_seconds": 3.93,
      "text": "It's been two weeks, I'm fairly sure."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 41.74,
      "end_seconds": 43.95,
      "duration_seconds": 2.21,
      "text": "What aggravates it, if anything?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 45.6,
      "end_seconds": 48.33,
      "duration_seconds": 2.73,
      "text": "I notice it more with straining."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 48.81,
      "end_seconds": 52.48,
      "duration_seconds": 3.67,
      "text": "I follow. Any itching around your bottom as well?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 54.34,
      "end_seconds": 57.19,
      "duration_seconds": 2.85,
      "text": "Yes, you know, I have."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 74.24,
      "end_seconds": 79.61,
      "duration_seconds": 5.37,
      "text": "Have you noticed dizziness, severe pain, weight loss or change in bowel habit?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 84.04,
      "end_seconds": 91.85,
      "duration_seconds": 7.81,
      "text": "I haven't had dizziness, severe pain, weight loss or change in bowel habit, no."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 93.3,
      "end_seconds": 96.57,
      "duration_seconds": 3.27,
      "text": "Any problems with your joints or muscles?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 101.26,
      "end_seconds": 104.28,
      "duration_seconds": 3.02,
      "text": "Um, no, joints are fine."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 113.39,
      "end_seconds": 115.99,
      "duration_seconds": 2.6,
      "text": "Do you have any long-term conditions?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 116.88,
      "end_seconds": 118.36,
      "duration_seconds": 1.48,
      "text": "Yes, low haemoglobin."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 120.3,
      "end_seconds": 130.2,
      "duration_seconds": 9.9,
      "text": "Mm-hmm. Okay, I can see low haemoglobin in your file as well. Do you react to any medicines or foods? Any allergies?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 131.62,
      "end_seconds": 135.44,
      "duration_seconds": 3.82,
      "text": "No, nothing as far as I know."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 150.94,
      "end_seconds": 154.55,
      "duration_seconds": 3.61,
      "text": "Do you take any prescribed or over-the-counter medicines?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 155.31,
      "end_seconds": 158.72,
      "duration_seconds": 3.41,
      "text": "It's iron tablets, once a day."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 160.22,
      "end_seconds": 162.91,
      "duration_seconds": 2.69,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 163.71,
      "end_seconds": 168.2,
      "duration_seconds": 4.49,
      "text": "Nothing, um, I haven't had any operations."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 169.86,
      "end_seconds": 171.27,
      "duration_seconds": 1.41,
      "text": "How about smoking?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 173.16,
      "end_seconds": 176.33,
      "duration_seconds": 3.17,
      "text": "I gave up cigarettes last spring."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 178.19,
      "end_seconds": 180.56,
      "duration_seconds": 2.37,
      "text": "Do you follow any particular diet?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 182.34,
      "end_seconds": 185.54,
      "duration_seconds": 3.2,
      "text": "I'm vegetarian and have been for years."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 186.65,
      "end_seconds": 188.59,
      "duration_seconds": 1.94,
      "text": "Do you live by yourself?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 189.29,
      "end_seconds": 193.5,
      "duration_seconds": 4.21,
      "text": "No, I share a house with my brother."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 194.62,
      "end_seconds": 199.37,
      "duration_seconds": 4.75,
      "text": "Can I check a few measurements before we carry on?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 210.32,
      "end_seconds": 212.7,
      "duration_seconds": 2.38,
      "text": "Sit still for a moment..."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 223.53,
      "end_seconds": 231.59,
      "duration_seconds": 8.06,
      "text": "Okay: saturation 98 percent, heart rate 86. And temperature 36.7, blood pressure 128 over 71, respiratory rate 15."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 232.15,
      "end_seconds": 235.18,
      "duration_seconds": 3.03,
      "text": "So, is that alright, doctor?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 236.53,
      "end_seconds": 239.96,
      "duration_seconds": 3.43,
      "text": "Don't worry, we'll discuss it in a second."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 241.47,
      "end_seconds": 245.74,
      "duration_seconds": 4.27,
      "text": "I'll examine you in a second, make yourself comfortable."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 247.21,
      "end_seconds": 249.59,
      "duration_seconds": 2.38,
      "text": "Yeah, uh, no problem."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 251.19,
      "end_seconds": 254.04,
      "duration_seconds": 2.85,
      "text": "Take a deep breath for me."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 261.11,
      "end_seconds": 269.38,
      "duration_seconds": 8.27,
      "text": "There is a small soft lump at the edge of the anus and no tear that I can see."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 275.03,
      "end_seconds": 293.96,
      "duration_seconds": 18.93,
      "text": "All finished, thank you. Taking everything into account, I think we're dealing with haemorrhoids at this stage. That's my thinking for now, and it may change as we learn more. A polyp in the bowel is also on my list."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 295.68,
      "end_seconds": 297.88,
      "duration_seconds": 2.2,
      "text": "Will it clear up?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 298.98,
      "end_seconds": 324.19,
      "duration_seconds": 25.21,
      "text": "Nothing I've seen today points to an emergency. It looks like haemorrhoids, but I'd like to confirm. I'll request a blood count, it'll help with rectal bleeding. I want a camera test of the bowel done, that's for rectal bleeding. What I'm giving you is haemorrhoid cream, twice a day, for a week. It's for haemorrhoids."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 325.34,
      "end_seconds": 327.37,
      "duration_seconds": 2.03,
      "text": "Mm, uh, alright."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 329.03,
      "end_seconds": 353.55,
      "duration_seconds": 24.52,
      "text": "Fibre, plenty of water, and don't sit on the toilet for long. Keep an eye out, and if the bleeding gets heavier or you feel faint, call us the same day or go to emergency. I'd like you back in four weeks. Anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 354.65,
      "end_seconds": 356.25,
      "duration_seconds": 1.6,
      "text": "That's clear, thanks."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 360.0,
      "end_seconds": 361.2,
      "duration_seconds": 1.2,
      "text": "Take care now."
    }
  ]
}