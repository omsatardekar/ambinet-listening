{
  "schema_version": "1.0",
  "encounter_id": "20290",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.3,
      "end_seconds": 4.49,
      "duration_seconds": 3.19,
      "text": "Good morning. I've just opened your notes."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 6.0,
      "end_seconds": 6.93,
      "duration_seconds": 0.93,
      "text": "Hi there."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 7.58,
      "end_seconds": 10.21,
      "duration_seconds": 2.63,
      "text": "You came on your own today?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 10.86,
      "end_seconds": 14.18,
      "duration_seconds": 3.32,
      "text": "Yes, I managed on my own."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 18.23,
      "end_seconds": 20.85,
      "duration_seconds": 2.62,
      "text": "Tell me what's brought you in."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 22.12,
      "end_seconds": 26.48,
      "duration_seconds": 4.36,
      "text": "it's pain going to my right shoulder, mostly"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 27.81,
      "end_seconds": 30.75,
      "duration_seconds": 2.94,
      "text": "How long has this been bothering you?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 33.87,
      "end_seconds": 36.16,
      "duration_seconds": 2.29,
      "text": "About... well, three days."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 36.6,
      "end_seconds": 40.73,
      "duration_seconds": 4.13,
      "text": "Mm-hmm. Rate it for me, mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 41.39,
      "end_seconds": 64.56,
      "duration_seconds": 23.17,
      "text": "Pretty severe, if I'm being honest. Oh, and sharp pain in the upper right of my tummy. With sharp pain in the upper right of my tummy, I'd give it a six, out of ten. I'd say every other day. Yes, fatty meals. That makes it worse."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 67.26,
      "end_seconds": 68.48,
      "duration_seconds": 1.22,
      "text": "Any dark urine?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 70.5,
      "end_seconds": 72.33,
      "duration_seconds": 1.83,
      "text": "No. No dark urine."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 73.12,
      "end_seconds": 78.49,
      "duration_seconds": 5.37,
      "text": "Let me check a few things. Any pale stools or fever?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 82.33,
      "end_seconds": 84.36,
      "duration_seconds": 2.03,
      "text": "Nope, nothing like that."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 84.58,
      "end_seconds": 89.96,
      "duration_seconds": 5.38,
      "text": "I see, go ahead. Any pins and needles or loss of strength anywhere?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 90.52,
      "end_seconds": 92.74,
      "duration_seconds": 2.22,
      "text": "No weakness or anything."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 94.1,
      "end_seconds": 99.16,
      "duration_seconds": 5.06,
      "text": "Tell me about your routine, work, habits, that that sort of thing."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 99.76,
      "end_seconds": 120.44,
      "duration_seconds": 20.68,
      "text": "I used to drink heavily but I stopped four years ago. I have about eight cigarettes in a day. I live with my elderly mother. Lots of rice, lentils and some fruit. Yes, I work in a bakery, early starts."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 125.45,
      "end_seconds": 127.68,
      "duration_seconds": 2.23,
      "text": "any surgery in the past?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 129.18,
      "end_seconds": 134.5,
      "duration_seconds": 5.32,
      "text": "Just my appendix taken out, when I was in my twenties."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 135.39,
      "end_seconds": 139.98,
      "duration_seconds": 4.59,
      "text": "Can you list what you take, tablets, creams or inhalers?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 140.71,
      "end_seconds": 145.09,
      "duration_seconds": 4.38,
      "text": "I'm on simvastatin, at night for my cholesterol."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 146.32,
      "end_seconds": 148.57,
      "duration_seconds": 2.25,
      "text": "And what strength is that?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 150.41,
      "end_seconds": 151.5,
      "duration_seconds": 1.09,
      "text": "20 milligrams"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 159.37,
      "end_seconds": 161.98,
      "duration_seconds": 2.61,
      "text": "before we go further, any allergies?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 162.69,
      "end_seconds": 164.24,
      "duration_seconds": 1.55,
      "text": "Milk, I'd say"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 180.13,
      "end_seconds": 183.93,
      "duration_seconds": 3.8,
      "text": "Tell me about any past illnesses or ongoing conditions."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 185.85,
      "end_seconds": 190.62,
      "duration_seconds": 4.77,
      "text": "I've had high cholesterol for about ten years now"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 191.73,
      "end_seconds": 195.37,
      "duration_seconds": 3.64,
      "text": "Shall I check your blood pressure and pulse?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 202.75,
      "end_seconds": 205.22,
      "duration_seconds": 2.47,
      "text": "bear with me while this finishes.."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 218.54,
      "end_seconds": 231.82,
      "duration_seconds": 13.28,
      "text": "okay: pulse is 68 beats a minute, blood pressure 118 over 76, temperature 36.8, weight 97 kilos, height 159 centimetres, SpO2 98 percent on room air"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 233.2,
      "end_seconds": 234.61,
      "duration_seconds": 1.41,
      "text": "is that okay?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 235.65,
      "end_seconds": 238.11,
      "duration_seconds": 2.46,
      "text": "I'll interpret them after the examination."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 239.64,
      "end_seconds": 244.08,
      "duration_seconds": 4.44,
      "text": "Alright, over here please and I'll take a look."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 246.15,
      "end_seconds": 246.85,
      "duration_seconds": 0.7,
      "text": "right"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 247.66,
      "end_seconds": 249.64,
      "duration_seconds": 1.98,
      "text": "Tell me if that's sore."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 262.26,
      "end_seconds": 270.22,
      "duration_seconds": 7.96,
      "text": "There is tenderness under the right ribs when you breathe in, and no yellowing of the eyes."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 275.88,
      "end_seconds": 278.76,
      "duration_seconds": 2.88,
      "text": "Thank you, you can get dressed."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 287.49,
      "end_seconds": 295.63,
      "duration_seconds": 8.14,
      "text": "Taking everything into account, I can't pin this down yet. We're looking at biliary colic from gallstones or peptic ulcer."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 297.68,
      "end_seconds": 300.51,
      "duration_seconds": 2.83,
      "text": "what are the odds it's serious?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 302.41,
      "end_seconds": 310.02,
      "duration_seconds": 7.61,
      "text": "I can't promise yet, but most people with biliary colic from gallstones do well once it's treated properly."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 320.14,
      "end_seconds": 347.34,
      "duration_seconds": 27.2,
      "text": "I think liver blood tests makes sense here, for upper abdominal pain. That will help us see what's going on underneath and decide the next step. What I'm giving you is diclofenac, 50 milligrams, three times a day if needed, for three days. You take it by mouth. That should help with gallbladder pain. Keep meals small and low in fat until we have the scan."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 349.41,
      "end_seconds": 358.57,
      "duration_seconds": 9.16,
      "text": "I'd like you to see the surgeons as well, and I'll write the referral. I'd like you back in two weeks."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 359.79,
      "end_seconds": 360.49,
      "duration_seconds": 0.7,
      "text": "right"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 362.33,
      "end_seconds": 366.11,
      "duration_seconds": 3.78,
      "text": "I think we're done unless you have questions"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 366.72,
      "end_seconds": 370.1,
      "duration_seconds": 3.38,
      "text": "Right, I'll do that. Thank you, doctor."
    }
  ]
}