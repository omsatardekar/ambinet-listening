  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.57,
      "end_seconds": 3.73,
      "duration_seconds": 3.16,
      "text": "Hello, sorry about the delay, do sit."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "FAMILY_MEMBER",
      "start_seconds": 5.49,
      "end_seconds": 11.05,
      "duration_seconds": 5.56,
      "text": "Ah, doctor, I'm just here to help with the details."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 12.94,
      "end_seconds": 18.77,
      "duration_seconds": 5.83,
      "text": "Good, that'll be useful. Pull up a chair. What's the main thing today?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "FAMILY_MEMBER",
      "start_seconds": 20.06,
      "end_seconds": 26.47,
      "duration_seconds": 6.41,
      "text": "Um, doctor, it's swollen ankles. That's what we're worried about."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 28.1,
      "end_seconds": 30.97,
      "duration_seconds": 2.87,
      "text": "Let me quickly check your readings."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 37.16,
      "end_seconds": 39.9,
      "duration_seconds": 2.74,
      "text": "Keep your arm relaxed for me..."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 58.67,
      "end_seconds": 66.81,
      "duration_seconds": 8.14,
      "text": "Okay: pulse is 125 beats a minute, BP is 118 over 76, saturation 97 percent, temperature 36.9."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 67.89,
      "end_seconds": 71.38,
      "duration_seconds": 3.49,
      "text": "Is that alright, uh, doctor?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 71.93,
      "end_seconds": 74.61,
      "duration_seconds": 2.68,
      "text": "That's fine, I'll explain it soon."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 86.74,
      "end_seconds": 89.86,
      "duration_seconds": 3.12,
      "text": "How long has it been like this?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 90.84,
      "end_seconds": 95.8,
      "duration_seconds": 4.96,
      "text": "It's been about a month, I'm fairly sure."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 97.43,
      "end_seconds": 102.5,
      "duration_seconds": 5.07,
      "text": "Okay, give me more detail on it, whatever comes to mind."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 103.45,
      "end_seconds": 123.71,
      "duration_seconds": 20.26,
      "text": "Okay, uh, so yes, standing and evenings. That makes it worse. I get some relief from raising my legs. I've also been waking up breathless at night. As for waking up breathless at night, I'd say mild."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 132.51,
      "end_seconds": 136.37,
      "duration_seconds": 3.86,
      "text": "Have you had any cough with blood or palpitations?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 138.46,
      "end_seconds": 145.02,
      "duration_seconds": 6.56,
      "text": "Ah, uh, I haven't had cough with blood or palpitations, no."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 147.04,
      "end_seconds": 151.56,
      "duration_seconds": 4.52,
      "text": "Have you had any fever, chest pain or calf pain?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 152.62,
      "end_seconds": 158.49,
      "duration_seconds": 5.87,
      "text": "No, you know, no fever, chest pain or calf pain."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 160.58,
      "end_seconds": 164.99,
      "duration_seconds": 4.41,
      "text": "What about your tummy and bowels, anything unusual there?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 166.29,
      "end_seconds": 169.37,
      "duration_seconds": 3.08,
      "text": "No, um, all normal there."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 169.89,
      "end_seconds": 173.26,
      "duration_seconds": 3.37,
      "text": "So, have you ever had an operation?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 174.52,
      "end_seconds": 180.25,
      "duration_seconds": 5.73,
      "text": "Mm, yes, I had my septum straightened, in my thirties."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 181.14,
      "end_seconds": 183.29,
      "duration_seconds": 2.15,
      "text": "What about your medical history?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 183.97,
      "end_seconds": 199.31,
      "duration_seconds": 15.34,
      "text": "Erm, I've had heart failure for about a year now. Right, I've had an irregular heartbeat, yes. I did try to ignore it for a while."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 218.16,
      "end_seconds": 222.59,
      "duration_seconds": 4.43,
      "text": "Do you react to any medicines or foods? Any allergies?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 223.89,
      "end_seconds": 227.62,
      "duration_seconds": 3.73,
      "text": "Oh, no, not that I know of."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 232.53,
      "end_seconds": 235.8,
      "duration_seconds": 3.27,
      "text": "Has anyone in your family had anything serious?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 236.92,
      "end_seconds": 240.04,
      "duration_seconds": 3.12,
      "text": "My daughter has type 1 diabetes."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 242.12,
      "end_seconds": 244.64,
      "duration_seconds": 2.52,
      "text": "Now some background about your lifestyle."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 246.51,
      "end_seconds": 260.24,
      "duration_seconds": 13.73,
      "text": "I'm a plumber, lots of bending and kneeling. No, I share a house with my brother. Lots of rice, lentils and some fruit."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 260.92,
      "end_seconds": 265.23,
      "duration_seconds": 4.31,
      "text": "Can you list what you take, tablets, creams or inhalers?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "FAMILY_MEMBER",
      "start_seconds": 266.13,
      "end_seconds": 278.19,
      "duration_seconds": 12.06,
      "text": "Uh, it's furosemide, 40 milligrams, every morning for the fluid, doctor. So, it's metoprolol, 50 milligrams, twice a day, doctor."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 280.14,
      "end_seconds": 282.95,
      "duration_seconds": 2.81,
      "text": "Let's move on to the examination."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 283.76,
      "end_seconds": 285.72,
      "duration_seconds": 1.96,
      "text": "Tell me if that's sore."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 303.13,
      "end_seconds": 305.15,
      "duration_seconds": 2.02,
      "text": "Your neck veins look raised."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 306.91,
      "end_seconds": 308.37,
      "duration_seconds": 1.46,
      "text": "Look straight ahead."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 322.6,
      "end_seconds": 327.96,
      "duration_seconds": 5.36,
      "text": "There is pitting swelling up to the shins on both sides."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 328.62,
      "end_seconds": 329.32,
      "duration_seconds": 0.7,
      "text": "Right."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 332.91,
      "end_seconds": 366.05,
      "duration_seconds": 33.14,
      "text": "That's the examination finished. From what you've told me and what I found, it fits best with fluid overload from heart failure. I want a heart ultrasound done, that's for suspected heart failure. That will help us see what's going on underneath and decide the next step. We should do blood tests for fluid overload. Keep the salt low and avoid adding it at the table. I'm going to send a referral to the community nursing team."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 367.07,
      "end_seconds": 373.82,
      "duration_seconds": 6.75,
      "text": "I'd like you back after the heart scan. That's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 375.36,
      "end_seconds": 379.36,
      "duration_seconds": 4.0,
      "text": "Okay, that makes sense. Thanks for explaining."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 380.6,
      "end_seconds": 382.29,
      "duration_seconds": 1.69,
      "text": "Have a good day."
    }
  ]
}