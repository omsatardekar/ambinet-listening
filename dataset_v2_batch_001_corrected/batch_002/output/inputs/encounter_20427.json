{
  "schema_version": "1.0",
  "encounter_id": "20427",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.26,
      "end_seconds": 7.38,
      "duration_seconds": 6.12,
      "text": "Hello doctor, sorry, I took a wrong turn on the way here."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.59,
      "end_seconds": 12.88,
      "duration_seconds": 4.29,
      "text": "No problem at all, come in. What's troubling you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 13.95,
      "end_seconds": 22.47,
      "duration_seconds": 8.52,
      "text": "So, you know, good afternoon, doctor. I look after them so I thought I'd come."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 24.45,
      "end_seconds": 42.88,
      "duration_seconds": 18.43,
      "text": "Honestly, it's irregular periods, and my family pushed me to come. My neighbour said I should get it looked at. A neighbour of mine said I should see someone about it."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 43.9,
      "end_seconds": 47.26,
      "duration_seconds": 3.36,
      "text": "Can you tell me when it first started?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 48.2,
      "end_seconds": 51.93,
      "duration_seconds": 3.73,
      "text": "About three days, give or take."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 53.27,
      "end_seconds": 58.53,
      "duration_seconds": 5.26,
      "text": "Let me think, hm, I'd say more like five days."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 59.61,
      "end_seconds": 64.55,
      "duration_seconds": 4.94,
      "text": "Okay, so roughly three to five days. Is that right?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 65.68,
      "end_seconds": 67.98,
      "duration_seconds": 2.3,
      "text": "That sounds about right."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 68.98,
      "end_seconds": 72.4,
      "duration_seconds": 3.42,
      "text": "How strong would you say it is?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 76.41,
      "end_seconds": 89.3,
      "duration_seconds": 12.89,
      "text": "Mostly mild. I've had hot flushes too, uh, for about a month. With hot flushes, yes, warm rooms and caffeine. That makes it worse."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 90.88,
      "end_seconds": 92.86,
      "duration_seconds": 1.98,
      "text": "Have you had poor sleep?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 96.75,
      "end_seconds": 107.54,
      "duration_seconds": 10.79,
      "text": "Mm, yes. Ah, with poor sleep, mostly severe. I've also had mood swings, for about a month."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 108.09,
      "end_seconds": 115.14,
      "duration_seconds": 7.05,
      "text": "Let me check a few things. Any weight loss, bleeding after sex, palpitations or chest pain?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 120.33,
      "end_seconds": 122.98,
      "duration_seconds": 2.65,
      "text": "No, none that I've noticed."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 123.96,
      "end_seconds": 127.76,
      "duration_seconds": 3.8,
      "text": "Any heavy bleeding or breast lumps at all?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 129.36,
      "end_seconds": 132.52,
      "duration_seconds": 3.16,
      "text": "I mean, none of those, no."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 134.23,
      "end_seconds": 137.35,
      "duration_seconds": 3.12,
      "text": "Any muscle or joint problems besides this?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 139.07,
      "end_seconds": 141.74,
      "duration_seconds": 2.67,
      "text": "Actually, I move fine otherwise."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 143.18,
      "end_seconds": 145.95,
      "duration_seconds": 2.77,
      "text": "How are your bowels, any trouble?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 146.84,
      "end_seconds": 150.21,
      "duration_seconds": 3.37,
      "text": "No, uh, all normal there."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 158.91,
      "end_seconds": 161.77,
      "duration_seconds": 2.86,
      "text": "Do you work outside the home?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 162.7,
      "end_seconds": 167.05,
      "duration_seconds": 4.35,
      "text": "I'm a hairdresser, on my feet all day."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 171.52,
      "end_seconds": 175.55,
      "duration_seconds": 4.03,
      "text": "What does a normal day of food look like?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 180.0,
      "end_seconds": 183.66,
      "duration_seconds": 3.66,
      "text": "Lots of rice, lentils and some fruit."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 185.67,
      "end_seconds": 187.67,
      "duration_seconds": 2.0,
      "text": "Is there someone at home?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 188.67,
      "end_seconds": 193.57,
      "duration_seconds": 4.9,
      "text": "My husband and I live above the shop."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 195.02,
      "end_seconds": 197.87,
      "duration_seconds": 2.85,
      "text": "So, do you have any chronic illnesses?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 201.58,
      "end_seconds": 203.52,
      "duration_seconds": 1.94,
      "text": "Yes, thin bones."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 205.51,
      "end_seconds": 208.08,
      "duration_seconds": 2.57,
      "text": "Right, and anything else to add?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 209.65,
      "end_seconds": 211.13,
      "duration_seconds": 1.48,
      "text": "I have COPD."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 212.67,
      "end_seconds": 223.57,
      "duration_seconds": 10.9,
      "text": "Right, so COPD is already on your record. We'll keep that in mind today. Do you take any prescribed or over-the-counter medicines?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 224.38,
      "end_seconds": 234.44,
      "duration_seconds": 10.06,
      "text": "Alendronate, 70 milligrams, once a week for my bones. I take Tiotropium inhaler, once a day for my chest."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 235.93,
      "end_seconds": 241.01,
      "duration_seconds": 5.08,
      "text": "Has anything ever caused you a reaction? I mean any allergies."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 243.8,
      "end_seconds": 245.58,
      "duration_seconds": 1.78,
      "text": "No known allergies."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 247.21,
      "end_seconds": 255.31,
      "duration_seconds": 8.1,
      "text": "Actually, I remember she had some kind of reaction to erythromycin before. I couldn't swear to it."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 256.05,
      "end_seconds": 258.56,
      "duration_seconds": 2.51,
      "text": "Really? I don't think so."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 260.6,
      "end_seconds": 263.62,
      "duration_seconds": 3.02,
      "text": "Fair enough, I'll write down both versions."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 273.93,
      "end_seconds": 276.03,
      "duration_seconds": 2.1,
      "text": "I'll do your observations first."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 287.43,
      "end_seconds": 290.12,
      "duration_seconds": 2.69,
      "text": "Keep your arm relaxed for me..."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 301.23,
      "end_seconds": 306.72,
      "duration_seconds": 5.49,
      "text": "Okay: heart rate 67, temperature 36.6, pressure 109 over 76."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 308.73,
      "end_seconds": 312.76,
      "duration_seconds": 4.03,
      "text": "Could you come over to the couch, please?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 314.27,
      "end_seconds": 316.71,
      "duration_seconds": 2.44,
      "text": "Hold that for a second."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 334.03,
      "end_seconds": 339.68,
      "duration_seconds": 5.65,
      "text": "Blood pressure and pulse are fine and there are no breast lumps on examination."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 344.98,
      "end_seconds": 347.04,
      "duration_seconds": 2.06,
      "text": "All finished, thank you."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 354.48,
      "end_seconds": 363.04,
      "duration_seconds": 8.56,
      "text": "Having listened and examined, I'd lean towards perimenopausal symptoms. It could also be anaemia, so we'll keep that open."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 364.31,
      "end_seconds": 366.66,
      "duration_seconds": 2.35,
      "text": "Is this serious, doctor?"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 368.16,
      "end_seconds": 398.96,
      "duration_seconds": 30.8,
      "text": "Nothing I've seen today points to an emergency. It looks like perimenopausal symptoms, but I'd like to confirm. I want a bone density scan done, that's for menopause bone health. I'd rather check than guess, and this is the quickest way to know more. Blood tests is what I'd like next, for hot flushes. Layers of clothing, a fan by the bed, and cutting down on caffeine and spicy food can help the flushes."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 400.27,
      "end_seconds": 406.39,
      "duration_seconds": 6.12,
      "text": "Book a review after the blood tests. Have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 410.94,
      "end_seconds": 413.54,
      "duration_seconds": 2.6,
      "text": "Thank you, doctor, goodbye."
    }
  ]
}