{
  "schema_version": "1.0",
  "encounter_id": "20068",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.37,
      "end_seconds": 7.3,
      "duration_seconds": 5.93,
      "text": "okay so doctor hi where would you like me to put my coat?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.14,
      "end_seconds": 13.02,
      "duration_seconds": 4.88,
      "text": "you're alright, take a seat. What can I do for you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 14.94,
      "end_seconds": 26.61,
      "duration_seconds": 11.67,
      "text": "good afternoon doctor i look after them so I thought I'd come doctor it's been losing height that's what we're worried about"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 27.62,
      "end_seconds": 29.83,
      "duration_seconds": 2.21,
      "text": "Let's run through your medicines."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 33.66,
      "end_seconds": 40.64,
      "duration_seconds": 6.98,
      "text": "She is on alendronate, 70 milligrams, once a week, I give it to her."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 41.23,
      "end_seconds": 42.91,
      "duration_seconds": 1.68,
      "text": "I see, go ahead."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 46.06,
      "end_seconds": 57.55,
      "duration_seconds": 11.49,
      "text": "yeah, um, she takes thyroxine, 75 micrograms, every morning she is on calcium tablets, 500 milligrams, twice a day, I give it to her"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 58.69,
      "end_seconds": 62.01,
      "duration_seconds": 3.32,
      "text": "Has this been going on for long?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 63.14,
      "end_seconds": 65.94,
      "duration_seconds": 2.8,
      "text": "About three weeks give or take."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 67.43,
      "end_seconds": 72.12,
      "duration_seconds": 4.69,
      "text": "okay, so I think it's been nearer a month, actually"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 72.79,
      "end_seconds": 76.83,
      "duration_seconds": 4.04,
      "text": "Okay, so roughly three to four weeks. Is that right?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 78.86,
      "end_seconds": 79.99,
      "duration_seconds": 1.13,
      "text": "Yeah, roughly."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 80.36,
      "end_seconds": 84.0,
      "duration_seconds": 3.64,
      "text": "Okay go on. How much does it limit you?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 85.46,
      "end_seconds": 90.4,
      "duration_seconds": 4.94,
      "text": "I'd give it a six uh out of ten."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 90.87,
      "end_seconds": 100.02,
      "duration_seconds": 9.15,
      "text": "uh um and and the other thing I wanted to mention is that I can't really—"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 100.12,
      "end_seconds": 105.42,
      "duration_seconds": 5.3,
      "text": "tell the doctor about the other thing, that's what worries me"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 107.36,
      "end_seconds": 109.98,
      "duration_seconds": 2.62,
      "text": "I was getting to that!"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 111.73,
      "end_seconds": 114.28,
      "duration_seconds": 2.55,
      "text": "Any a stooped back as well?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 114.89,
      "end_seconds": 129.29,
      "duration_seconds": 14.4,
      "text": "yes, about the same, three weeks and I've been feeling unsteady as well, you know, for two months okay, so and there's a painful wrist as well, two months now"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 131.22,
      "end_seconds": 134.18,
      "duration_seconds": 2.96,
      "text": "How much does it limit you?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 138.58,
      "end_seconds": 139.73,
      "duration_seconds": 1.15,
      "text": "Moderate, really"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 141.79,
      "end_seconds": 145.72,
      "duration_seconds": 3.93,
      "text": "have you been losing height at any time before this?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 146.6,
      "end_seconds": 154.54,
      "duration_seconds": 7.94,
      "text": "okay, so a bit, about six months ago. It settled by itself back then"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 155.16,
      "end_seconds": 160.92,
      "duration_seconds": 5.76,
      "text": "Any bladder problems, numbness in the legs or weight loss at all?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 162.83,
      "end_seconds": 169.52,
      "duration_seconds": 6.69,
      "text": "no bladder problems, numbness in the legs or weight loss, none of it"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 171.19,
      "end_seconds": 174.9,
      "duration_seconds": 3.71,
      "text": "Did you get fever, chest pain or night pain?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 176.4,
      "end_seconds": 179.15,
      "duration_seconds": 2.75,
      "text": "No, none that I've noticed."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 180.4,
      "end_seconds": 182.52,
      "duration_seconds": 2.12,
      "text": "Is your chest okay generally?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 183.56,
      "end_seconds": 184.5,
      "duration_seconds": 0.94,
      "text": "breathing's normal"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 185.28,
      "end_seconds": 186.47,
      "duration_seconds": 1.19,
      "text": "how about smoking?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 188.27,
      "end_seconds": 190.78,
      "duration_seconds": 2.51,
      "text": "I've never touched a cigarette."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 191.99,
      "end_seconds": 195.1,
      "duration_seconds": 3.11,
      "text": "what line of work are you in?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 196.02,
      "end_seconds": 201.37,
      "duration_seconds": 5.35,
      "text": "I'm a bus driver, so I sit for long hours."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 202.58,
      "end_seconds": 206.37,
      "duration_seconds": 3.79,
      "text": "tell me about any past illnesses or ongoing conditions"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 207.18,
      "end_seconds": 209.19,
      "duration_seconds": 2.01,
      "text": "I have thin bones."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 210.06,
      "end_seconds": 211.09,
      "duration_seconds": 1.03,
      "text": "Hm, okay."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 212.83,
      "end_seconds": 222.27,
      "duration_seconds": 9.44,
      "text": "I have an underactive thyroid, for about a year. I'm hoping you can tell me something definite."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 222.79,
      "end_seconds": 227.43,
      "duration_seconds": 4.64,
      "text": "any inherited conditions that you know of in the family?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 229.1,
      "end_seconds": 234.18,
      "duration_seconds": 5.08,
      "text": "my father had bowel cancer my son has asthma"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 235.38,
      "end_seconds": 238.66,
      "duration_seconds": 3.28,
      "text": "Let me ask about allergies, anything at all?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 240.33,
      "end_seconds": 253.48,
      "duration_seconds": 13.15,
      "text": "Hmm, you know, there was some antibiotic, I was told I was allergic. But I couldn't tell you what it was called or what it did."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 254.7,
      "end_seconds": 257.24,
      "duration_seconds": 2.54,
      "text": "have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 258.24,
      "end_seconds": 260.01,
      "duration_seconds": 1.77,
      "text": "No surgery, no."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_4",
      "role": "NURSE",
      "start_seconds": 272.73,
      "end_seconds": 286.52,
      "duration_seconds": 13.79,
      "text": "Okay, so the vitals from earlier. Temperature 36.8, height 165 centimetres, oxygen saturation is 97 percent. BP is 108 over 80, BMI works out to 29.8, weight 81 kilos, pulse 65, respiratory rate 14."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 291.86,
      "end_seconds": 293.23,
      "duration_seconds": 1.37,
      "text": "good thank you"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 295.51,
      "end_seconds": 300.32,
      "duration_seconds": 4.81,
      "text": "I'll need to to examine you for this, it won't take long."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 301.77,
      "end_seconds": 304.76,
      "duration_seconds": 2.99,
      "text": "stay as you are for a moment"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 321.2,
      "end_seconds": 326.75,
      "duration_seconds": 5.55,
      "text": "there is tenderness over the mid lower spine and no weakness in the legs"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 330.17,
      "end_seconds": 348.54,
      "duration_seconds": 18.37,
      "text": "good, you can sit up again. Having listened and examined, it points towards thin bones with a fragility fracture and back pain. I'd also keep a spinal compression fracture in mind. Another possibility is a muscle strain"
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 349.8,
      "end_seconds": 354.96,
      "duration_seconds": 5.16,
      "text": "uh um I'm scared it's something bad. Is it?"
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 355.86,
      "end_seconds": 376.66,
      "duration_seconds": 20.8,
      "text": "I understand the worry at the moment I'd say it's thin bones with a fragility fracture and back pain and we'll watch how it goes stop me if I've got anything wrong you've been losing height and no bladder problems or chest pain"
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 378.28,
      "end_seconds": 378.98,
      "duration_seconds": 0.7,
      "text": "correct"
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 391.04,
      "end_seconds": 405.0,
      "duration_seconds": 13.96,
      "text": "I'd like you to see the falls clinic as well, and I'll write the referral. Please come and see me after the scan. Anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 406.18,
      "end_seconds": 408.33,
      "duration_seconds": 2.15,
      "text": "Alright, thanks, take care."
    }
  ]
}