{
  "schema_version": "1.0",
  "encounter_id": "20112",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.69,
      "end_seconds": 4.27,
      "duration_seconds": 3.58,
      "text": "Morning, doctor. Lovely to meet you."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.89,
      "end_seconds": 9.67,
      "duration_seconds": 3.78,
      "text": "come in please sit how can I help you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 11.4,
      "end_seconds": 21.03,
      "duration_seconds": 9.63,
      "text": "It's pain in my right ear, mostly. I'd rather know what's going on than keep guessing."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 21.66,
      "end_seconds": 24.41,
      "duration_seconds": 2.75,
      "text": "is there any regular medication you use?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 29.19,
      "end_seconds": 32.33,
      "duration_seconds": 3.14,
      "text": "No, I don't take any tablets."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 40.0,
      "end_seconds": 42.66,
      "duration_seconds": 2.66,
      "text": "how often do you get it?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 44.39,
      "end_seconds": 46.63,
      "duration_seconds": 2.24,
      "text": "Honestly, all the time."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 47.46,
      "end_seconds": 49.84,
      "duration_seconds": 2.38,
      "text": "Does anything else come with it?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 51.54,
      "end_seconds": 64.35,
      "duration_seconds": 12.81,
      "text": "When it starts I tend to get a discharge from the ear as well. Oh, the discharge from the ear? That's been for about a week."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 65.21,
      "end_seconds": 67.99,
      "duration_seconds": 2.78,
      "text": "Right, has there been any dizziness?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 68.75,
      "end_seconds": 70.6,
      "duration_seconds": 1.85,
      "text": "nope, no dizziness"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 71.44,
      "end_seconds": 77.69,
      "duration_seconds": 6.25,
      "text": "have you noticed facial weakness, fever, swelling behind the ear or recent swimming?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 82.63,
      "end_seconds": 88.09,
      "duration_seconds": 5.46,
      "text": "Erm, um, no, I haven't had any of them."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 90.02,
      "end_seconds": 94.5,
      "duration_seconds": 4.48,
      "text": "Any change in your bowel habit or your stomach generally?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 95.69,
      "end_seconds": 98.66,
      "duration_seconds": 2.97,
      "text": "nothing unusual, you know, no"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 99.41,
      "end_seconds": 102.25,
      "duration_seconds": 2.84,
      "text": "is your urine normal, no changes?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 104.07,
      "end_seconds": 108.33,
      "duration_seconds": 4.26,
      "text": "oh, that's normal as far as I know"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 125.92,
      "end_seconds": 129.84,
      "duration_seconds": 3.92,
      "text": "Do you have any medical conditions I should know about?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 131.0,
      "end_seconds": 135.63,
      "duration_seconds": 4.63,
      "text": "No, you know, nothing I can think of."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 136.77,
      "end_seconds": 138.25,
      "duration_seconds": 1.48,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 139.13,
      "end_seconds": 142.82,
      "duration_seconds": 3.69,
      "text": "Nothing, I haven't had any operations."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 147.36,
      "end_seconds": 148.92,
      "duration_seconds": 1.56,
      "text": "How are your meals?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 149.46,
      "end_seconds": 154.04,
      "duration_seconds": 4.58,
      "text": "I grab fast food at lunch most days."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 155.83,
      "end_seconds": 157.19,
      "duration_seconds": 1.36,
      "text": "Are you active?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 158.21,
      "end_seconds": 161.31,
      "duration_seconds": 3.1,
      "text": "I walk the dog every morning."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 162.66,
      "end_seconds": 168.45,
      "duration_seconds": 5.79,
      "text": "Alright, are you allergic to anything? Any allergies to medicines or foods?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 169.7,
      "end_seconds": 174.29,
      "duration_seconds": 4.59,
      "text": "Tramadol. I come out in... well, feeling very drowsy."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 176.05,
      "end_seconds": 178.87,
      "duration_seconds": 2.82,
      "text": "Does your family have any medical conditions?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 180.17,
      "end_seconds": 182.67,
      "duration_seconds": 2.5,
      "text": "my sister had breast cancer"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 183.55,
      "end_seconds": 188.31,
      "duration_seconds": 4.76,
      "text": "can I check a few measurements before we carry on?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 197.33,
      "end_seconds": 199.83,
      "duration_seconds": 2.5,
      "text": "Bear with me while this finishes..."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 210.39,
      "end_seconds": 216.76,
      "duration_seconds": 6.37,
      "text": "okay: heart rate 85, temperature is 36.8 degrees, blood pressure 127 over 76."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 221.11,
      "end_seconds": 223.45,
      "duration_seconds": 2.34,
      "text": "Is that alright, doctor?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 224.47,
      "end_seconds": 226.69,
      "duration_seconds": 2.22,
      "text": "We'll go over that shortly."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 228.32,
      "end_seconds": 230.48,
      "duration_seconds": 2.16,
      "text": "May I examine you now?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 232.09,
      "end_seconds": 233.73,
      "duration_seconds": 1.64,
      "text": "Fine by me."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 234.54,
      "end_seconds": 236.87,
      "duration_seconds": 2.33,
      "text": "Hold that for a second."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 248.85,
      "end_seconds": 256.53,
      "duration_seconds": 7.68,
      "text": "The ear canal is red and swollen with some debris, and it's painful when I pull the ear."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 259.19,
      "end_seconds": 272.6,
      "duration_seconds": 13.41,
      "text": "good, you can sit up again putting it all together, it points towards an outer ear canal infection i want to be honest that this is an impression, not a final answer"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 276.97,
      "end_seconds": 279.36,
      "duration_seconds": 2.39,
      "text": "Will it clear up?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 283.69,
      "end_seconds": 301.51,
      "duration_seconds": 17.82,
      "text": "I understand the the worry. At the moment I'd say it's an outer ear canal infection, and we'll watch how it goes. Stop me if I've got anything wrong. You've had pain in your right ear, and no recent swimming or dizziness."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 303.2,
      "end_seconds": 304.81,
      "duration_seconds": 1.61,
      "text": "Mm, that's right."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 323.14,
      "end_seconds": 332.64,
      "duration_seconds": 9.5,
      "text": "The treatment will be antibiotic and steroid ear drops, 3 drops, twice a day, for seven days. That's for ear canal infection."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 333.24,
      "end_seconds": 334.42,
      "duration_seconds": 1.18,
      "text": "mm, alright"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 335.27,
      "end_seconds": 356.2,
      "duration_seconds": 20.93,
      "text": "Keep the ear dry, no swimming, and don't poke anything into it. The thing that would worry me is if the ear swells or you get dizzy or feverish. If that happens, go to emergency. I'll want another look if it isn't better in three days."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 357.16,
      "end_seconds": 360.76,
      "duration_seconds": 3.6,
      "text": "Come by reception afterwards and I'll fix the appointment."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 361.54,
      "end_seconds": 364.75,
      "duration_seconds": 3.21,
      "text": "I mean, okay, I'll arrange it."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 366.54,
      "end_seconds": 368.89,
      "duration_seconds": 2.35,
      "text": "Have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 369.93,
      "end_seconds": 373.92,
      "duration_seconds": 3.99,
      "text": "right, I'll do that thank you, doctor"
    }
  ]
}