{
  "schema_version": "1.0",
  "encounter_id": "20390",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 0.98,
      "end_seconds": 8.75,
      "duration_seconds": 7.77,
      "text": "Doctor, I've checked them in and done the preliminary measurements, I'll hand them over when you ask."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 9.3,
      "end_seconds": 14.2,
      "duration_seconds": 4.9,
      "text": "So, thanks, that's helpful. Hello, please sit. What's been happening?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 16.1,
      "end_seconds": 19.82,
      "duration_seconds": 3.72,
      "text": "Um, so... itching. That's why I came."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 25.05,
      "end_seconds": 28.65,
      "duration_seconds": 3.6,
      "text": "Can you tell me when it first started?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 30.39,
      "end_seconds": 32.3,
      "duration_seconds": 1.91,
      "text": "Probably six months. Yeah."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 33.09,
      "end_seconds": 36.41,
      "duration_seconds": 3.32,
      "text": "Would you say mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 38.36,
      "end_seconds": 39.46,
      "duration_seconds": 1.1,
      "text": "Mild, really."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 41.35,
      "end_seconds": 44.66,
      "duration_seconds": 3.31,
      "text": "Have you noticed anything else alongside it?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 45.65,
      "end_seconds": 74.17,
      "duration_seconds": 28.52,
      "text": "Um, it usually comes with stinging when I wash up. I've also had red, cracked skin on my hands, for two months. The stinging when I wash up? That's been for two years. Let me think, as for stinging when I wash up, mostly mild. I've had blisters between my fingers too, for about a year."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 75.11,
      "end_seconds": 76.82,
      "duration_seconds": 1.71,
      "text": "How about rash elsewhere?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 78.29,
      "end_seconds": 80.21,
      "duration_seconds": 1.92,
      "text": "Definitely no rash elsewhere."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 81.2,
      "end_seconds": 87.05,
      "duration_seconds": 5.85,
      "text": "Have you noticed new soap or cream, nail changes, fever or joint pain?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 88.83,
      "end_seconds": 91.6,
      "duration_seconds": 2.77,
      "text": "No, not a single one."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 93.17,
      "end_seconds": 96.12,
      "duration_seconds": 2.95,
      "text": "Is your urine normal, no changes?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 97.03,
      "end_seconds": 99.4,
      "duration_seconds": 2.37,
      "text": "No, that's all fine."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 100.23,
      "end_seconds": 103.09,
      "duration_seconds": 2.86,
      "text": "Any problems with your joints or muscles?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 104.56,
      "end_seconds": 106.21,
      "duration_seconds": 1.65,
      "text": "Nothing else aches."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 107.46,
      "end_seconds": 108.44,
      "duration_seconds": 0.98,
      "text": "Any smoking?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 109.11,
      "end_seconds": 111.85,
      "duration_seconds": 2.74,
      "text": "I gave up cigarettes last spring."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 113.39,
      "end_seconds": 114.7,
      "duration_seconds": 1.31,
      "text": "What about alcohol?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 115.54,
      "end_seconds": 121.04,
      "duration_seconds": 5.5,
      "text": "I used to drink heavily but I stopped four years ago."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 122.25,
      "end_seconds": 123.7,
      "duration_seconds": 1.45,
      "text": "What's your work?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 124.23,
      "end_seconds": 128.24,
      "duration_seconds": 4.01,
      "text": "I'm a plumber, lots of bending and kneeling."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 129.35,
      "end_seconds": 131.29,
      "duration_seconds": 1.94,
      "text": "Tell me about your eating."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 137.15,
      "end_seconds": 142.96,
      "duration_seconds": 5.81,
      "text": "I drink a lot of tea and snack through the day."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 151.79,
      "end_seconds": 154.76,
      "duration_seconds": 2.97,
      "text": "Does your family have any medical conditions?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 156.8,
      "end_seconds": 161.3,
      "duration_seconds": 4.5,
      "text": "My uncle has high cholesterol. My cousin has psoriasis."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 172.81,
      "end_seconds": 177.98,
      "duration_seconds": 5.17,
      "text": "Are you allergic to anything? Any allergies to medicines or foods?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 183.44,
      "end_seconds": 184.98,
      "duration_seconds": 1.54,
      "text": "No known allergies."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 186.77,
      "end_seconds": 188.22,
      "duration_seconds": 1.45,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 189.05,
      "end_seconds": 190.14,
      "duration_seconds": 1.09,
      "text": "No, never."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 191.51,
      "end_seconds": 193.93,
      "duration_seconds": 2.42,
      "text": "What about your medical history?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 195.73,
      "end_seconds": 203.22,
      "duration_seconds": 7.49,
      "text": "I've had eczema for about ten years now. I've had migraines for about a year now."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 205.27,
      "end_seconds": 215.86,
      "duration_seconds": 10.59,
      "text": "Alright, eczema and migraines, that matches what I have here. What's on your current medicine list? Take your time, there's no rush."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 216.98,
      "end_seconds": 231.8,
      "duration_seconds": 14.82,
      "text": "Hydrocortisone cream. I take it when needed. I didn't want to make a fuss, you know. I'm on propranolol, 40 milligrams, twice a day for the migraine prevention."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 234.96,
      "end_seconds": 239.98,
      "duration_seconds": 5.02,
      "text": "Doctor, our chart from the last visit lists it as 80 milligrams."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 240.79,
      "end_seconds": 246.13,
      "duration_seconds": 5.34,
      "text": "Okay. Have you got the newest prescription or the box with you?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 247.38,
      "end_seconds": 255.87,
      "duration_seconds": 8.49,
      "text": "Not with me. I'll bring it next time. I used to take sumatriptan, but I stopped it."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 257.82,
      "end_seconds": 266.68,
      "duration_seconds": 8.86,
      "text": "Here are the numbers, doctor. BP is 114 over 71, temp 36.6 degrees, saturation 97 percent. Respiratory rate 17, pulse 78."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 267.96,
      "end_seconds": 268.91,
      "duration_seconds": 0.95,
      "text": "Okay, noted."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 271.47,
      "end_seconds": 275.99,
      "duration_seconds": 4.52,
      "text": "Alright, over here please and I'll take a look."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 276.96,
      "end_seconds": 279.1,
      "duration_seconds": 2.14,
      "text": "Tell me if that's sore."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 286.21,
      "end_seconds": 293.73,
      "duration_seconds": 7.52,
      "text": "The skin on both hands is red, dry and cracked in the finger creases, with no weeping."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 298.64,
      "end_seconds": 300.84,
      "duration_seconds": 2.2,
      "text": "Okay, that's enough for me."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 308.07,
      "end_seconds": 332.96,
      "duration_seconds": 24.89,
      "text": "Right, here's what I'm thinking. This looks most like irritant hand dermatitis. I'd also keep a fungal skin infection in mind. Use gloves for washing up and moisturise straight after you dry your hands. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 334.11,
      "end_seconds": 335.11,
      "duration_seconds": 1.0,
      "text": "I understand."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 336.01,
      "end_seconds": 339.2,
      "duration_seconds": 3.19,
      "text": "Anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 340.6,
      "end_seconds": 343.61,
      "duration_seconds": 3.01,
      "text": "Good, thanks, I'll see you then."
    }
  ]
}