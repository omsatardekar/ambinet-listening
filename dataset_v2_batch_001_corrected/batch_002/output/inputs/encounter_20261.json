{
  "schema_version": "1.0",
  "encounter_id": "20261",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.55,
      "end_seconds": 5.51,
      "duration_seconds": 4.96,
      "text": "Hello, take a seat, I'll be with you in a second."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 6.81,
      "end_seconds": 10.11,
      "duration_seconds": 3.3,
      "text": "Morning, doctor, sorry about the rush."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 11.42,
      "end_seconds": 14.39,
      "duration_seconds": 2.97,
      "text": "Did the receptionist sort you out quickly?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 18.32,
      "end_seconds": 21.12,
      "duration_seconds": 2.8,
      "text": "Yes, she was lovely about it."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 22.81,
      "end_seconds": 25.7,
      "duration_seconds": 2.89,
      "text": "How are things, what's been happening?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 26.74,
      "end_seconds": 32.32,
      "duration_seconds": 5.58,
      "text": "It's a pounding heart. I thought I'd wait, but it hasn't gone."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 33.7,
      "end_seconds": 36.58,
      "duration_seconds": 2.88,
      "text": "How long has this been bothering you?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 37.27,
      "end_seconds": 39.22,
      "duration_seconds": 1.95,
      "text": "About... well, one week."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 40.89,
      "end_seconds": 45.57,
      "duration_seconds": 4.68,
      "text": "Is it there all the time or does it come and go?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 47.08,
      "end_seconds": 52.87,
      "duration_seconds": 5.79,
      "text": "It's on and off. I've been feeling confused at times too."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 56.12,
      "end_seconds": 59.15,
      "duration_seconds": 3.03,
      "text": "How much trouble does it give you?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 61.02,
      "end_seconds": 63.38,
      "duration_seconds": 2.36,
      "text": "It feels severe to me."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 79.74,
      "end_seconds": 82.08,
      "duration_seconds": 2.34,
      "text": "Has there been any chest pain?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 82.7,
      "end_seconds": 86.59,
      "duration_seconds": 3.89,
      "text": "No, I haven't had any chest pain."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 87.19,
      "end_seconds": 90.55,
      "duration_seconds": 3.36,
      "text": "Any seizure or slurred speech at all?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 91.18,
      "end_seconds": 94.59,
      "duration_seconds": 3.41,
      "text": "No, no seizure or slurred speech."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 95.18,
      "end_seconds": 98.21,
      "duration_seconds": 3.03,
      "text": "I follow. Anything unusual with passing urine?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 98.74,
      "end_seconds": 100.91,
      "duration_seconds": 2.17,
      "text": "No, that's all fine."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 102.06,
      "end_seconds": 105.01,
      "duration_seconds": 2.95,
      "text": "Any muscle or joint problems besides this?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 106.87,
      "end_seconds": 109.06,
      "duration_seconds": 2.19,
      "text": "No, joints are fine."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 110.66,
      "end_seconds": 113.1,
      "duration_seconds": 2.44,
      "text": "What's on your current medicine list?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 113.72,
      "end_seconds": 117.79,
      "duration_seconds": 4.07,
      "text": "Glimepiride. I take it 2 milligrams, before breakfast."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 118.0,
      "end_seconds": 123.12,
      "duration_seconds": 5.12,
      "text": "Mm-hmm. Tell me about any past illnesses or ongoing conditions."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 125.21,
      "end_seconds": 126.8,
      "duration_seconds": 1.59,
      "text": "I've got diabetes."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 127.76,
      "end_seconds": 139.43,
      "duration_seconds": 11.67,
      "text": "Right, so diabetes is already on your record. We'll keep that in mind today. Alright, tell me about your routine, work, habits, that sort of thing."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 140.56,
      "end_seconds": 154.94,
      "duration_seconds": 14.38,
      "text": "I have about eight cigarettes in a day. My husband and I live above the shop. I walk the dog every morning. I grab fast food at lunch most days."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 155.5,
      "end_seconds": 160.03,
      "duration_seconds": 4.53,
      "text": "Any inherited conditions that you know of in the family?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 160.92,
      "end_seconds": 163.71,
      "duration_seconds": 2.79,
      "text": "My mother had a stroke."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 177.57,
      "end_seconds": 180.49,
      "duration_seconds": 2.92,
      "text": "Time for your numbers, if that's okay."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 191.07,
      "end_seconds": 193.38,
      "duration_seconds": 2.31,
      "text": "Nearly done with the readings..."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 207.98,
      "end_seconds": 215.72,
      "duration_seconds": 7.74,
      "text": "Okay: heart rate 77, respiratory rate 15, BP is 118 over 78, temperature 36.9."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 218.26,
      "end_seconds": 222.48,
      "duration_seconds": 4.22,
      "text": "I'd like to check you over now, if that's alright."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 223.71,
      "end_seconds": 225.08,
      "duration_seconds": 1.37,
      "text": "Nearly finished here."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 233.17,
      "end_seconds": 238.48,
      "duration_seconds": 5.31,
      "text": "Your fingerprick sugar now is normal and your heart rate is steady."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 244.14,
      "end_seconds": 246.48,
      "duration_seconds": 2.34,
      "text": "That's all I needed to check."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 257.25,
      "end_seconds": 271.8,
      "duration_seconds": 14.55,
      "text": "Right, here's what I'm thinking. It's hard to say. Episodes of low blood sugar related to diabetes treatment is one possibility and an abnormal heart rhythm another, and I'd rather not commit yet."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 273.31,
      "end_seconds": 278.44,
      "duration_seconds": 5.13,
      "text": "Let me think, what are the odds it's serious?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 279.54,
      "end_seconds": 298.65,
      "duration_seconds": 19.11,
      "text": "I understand the worry. At the moment I'd say it's episodes of low blood sugar related to diabetes treatment, and we'll know more once the blood tests is back. So, to recap quickly. You've had a pounding heart for one week, and no seizure or chest pain."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 303.85,
      "end_seconds": 304.55,
      "duration_seconds": 0.7,
      "text": "Correct."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 305.34,
      "end_seconds": 337.21,
      "duration_seconds": 31.87,
      "text": "I'm going to order blood tests, for low sugar. That will help us see what's going on underneath and decide the next step. Never skip meals when you take the sugar tablet, and keep glucose tablets or juice with you. A short walk every day, even twenty minutes, will help more than you'd think. The thing that would worry me is if you have an episode that does not settle with sugar. If that happens, go to emergency."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 338.72,
      "end_seconds": 340.4,
      "duration_seconds": 1.68,
      "text": "Alright, I follow."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 345.44,
      "end_seconds": 351.7,
      "duration_seconds": 6.26,
      "text": "Let's plan a check after the blood tests. Anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 352.25,
      "end_seconds": 353.79,
      "duration_seconds": 1.54,
      "text": "That's clear, thanks."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 354.56,
      "end_seconds": 355.88,
      "duration_seconds": 1.32,
      "text": "Goodbye for now."
    }
  ]
}