{
  "schema_version": "1.0",
  "encounter_id": "20292",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.24,
      "end_seconds": 4.2,
      "duration_seconds": 2.96,
      "text": "Sorry, doctor, shall I sit here?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.9,
      "end_seconds": 10.95,
      "duration_seconds": 5.05,
      "text": "Yes, come in and sit down. What brings you here today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 12.9,
      "end_seconds": 16.91,
      "duration_seconds": 4.01,
      "text": "Well, I've been having nausea and vomiting."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 19.73,
      "end_seconds": 23.06,
      "duration_seconds": 3.33,
      "text": "Shall I check your blood pressure and pulse?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 32.98,
      "end_seconds": 35.37,
      "duration_seconds": 2.39,
      "text": "Bear with me while this finishes..."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 53.61,
      "end_seconds": 64.03,
      "duration_seconds": 10.42,
      "text": "Okay: BP is 110 over 69, pulse 77. And SpO2 98 percent on room air, respiratory rate 16. When was the first time you noticed it?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 66.08,
      "end_seconds": 69.51,
      "duration_seconds": 3.43,
      "text": "Since Friday, that's when it began."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 70.06,
      "end_seconds": 73.18,
      "duration_seconds": 3.12,
      "text": "How strong would you say it is?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 74.07,
      "end_seconds": 87.12,
      "duration_seconds": 13.05,
      "text": "I'd call it mild. So, you know, there's being unsteady as well. With being unsteady, maybe a four out of ten on a bad day."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 89.4,
      "end_seconds": 91.2,
      "duration_seconds": 1.8,
      "text": "What about double vision?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 92.85,
      "end_seconds": 95.54,
      "duration_seconds": 2.69,
      "text": "I haven't noticed any double vision."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 96.84,
      "end_seconds": 100.39,
      "duration_seconds": 3.55,
      "text": "Okay, and what about weakness or hearing loss?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 102.35,
      "end_seconds": 105.94,
      "duration_seconds": 3.59,
      "text": "Right, no, I'd have said so."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 107.05,
      "end_seconds": 109.95,
      "duration_seconds": 2.9,
      "text": "Is your urine normal, no changes?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 111.49,
      "end_seconds": 116.15,
      "duration_seconds": 4.66,
      "text": "Um, that's normal as far as I know."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 123.44,
      "end_seconds": 126.14,
      "duration_seconds": 2.7,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 127.41,
      "end_seconds": 128.43,
      "duration_seconds": 1.02,
      "text": "No, never."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 137.38,
      "end_seconds": 142.78,
      "duration_seconds": 5.4,
      "text": "Tell me about your routine, work, habits, that sort of thing."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 147.27,
      "end_seconds": 161.73,
      "duration_seconds": 14.46,
      "text": "I quit smoking around ten years ago. No, I share a house with my brother. I swim twice a week. Lots of rice, lentils and some fruit."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 165.41,
      "end_seconds": 167.93,
      "duration_seconds": 2.52,
      "text": "Tell me your medicines, please."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 169.3,
      "end_seconds": 172.72,
      "duration_seconds": 3.42,
      "text": "It's metoprolol, 50 milligrams, twice a day."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 174.19,
      "end_seconds": 183.26,
      "duration_seconds": 9.07,
      "text": "What conditions have you been treated for in the past? I ask because it helps me narrow things down."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 185.04,
      "end_seconds": 193.37,
      "duration_seconds": 8.33,
      "text": "I have high blood pressure, for about ten years. I'd rather know what's going on than keep guessing."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 195.64,
      "end_seconds": 200.2,
      "duration_seconds": 4.56,
      "text": "I'll need to examine you for this, it won't take long."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 202.02,
      "end_seconds": 203.44,
      "duration_seconds": 1.42,
      "text": "Nearly finished here."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 216.65,
      "end_seconds": 224.93,
      "duration_seconds": 8.28,
      "text": "I can see a fine jerking of the eyes to the left and your walking is a little unsteady."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 230.0,
      "end_seconds": 232.41,
      "duration_seconds": 2.41,
      "text": "You can sit up now."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 241.7,
      "end_seconds": 248.28,
      "duration_seconds": 6.58,
      "text": "Okay, thinking it through, it points towards an inner-ear balance problem such as vestibular neuritis."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 250.36,
      "end_seconds": 252.47,
      "duration_seconds": 2.11,
      "text": "Is it dangerous, doctor?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 253.44,
      "end_seconds": 264.92,
      "duration_seconds": 11.48,
      "text": "I understand the worry. At the moment I'd say it's an inner-ear balance problem such as vestibular neuritis, and we'll know more once the a positional test is back."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 283.73,
      "end_seconds": 287.41,
      "duration_seconds": 3.68,
      "text": "I want a positional test done, that's for vertigo."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 288.57,
      "end_seconds": 291.87,
      "duration_seconds": 3.3,
      "text": "Ah, how long will it take?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 292.6,
      "end_seconds": 306.0,
      "duration_seconds": 13.4,
      "text": "Blood tests is what I'd like next, for dizziness. What I'm giving you is prochlorperazine, 5 milligrams, three times a day, for three days. It's for nausea and vertigo."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 308.72,
      "end_seconds": 310.8,
      "duration_seconds": 2.08,
      "text": "Fine, I'll begin it."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 315.51,
      "end_seconds": 328.97,
      "duration_seconds": 13.46,
      "text": "Start moving around gently as soon as you can, since resting too long slows recovery. Please don't wait if you get double vision, weakness or trouble speaking. That's when to be seen urgently."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 330.35,
      "end_seconds": 331.25,
      "duration_seconds": 0.9,
      "text": "I understand."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 333.08,
      "end_seconds": 340.56,
      "duration_seconds": 7.48,
      "text": "We'll catch up if it isn't settling in five days. Does all of that make sense?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 342.48,
      "end_seconds": 344.25,
      "duration_seconds": 1.77,
      "text": "That's clear, thanks."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 348.5,
      "end_seconds": 349.94,
      "duration_seconds": 1.44,
      "text": "All the best."
    }
  ]
}