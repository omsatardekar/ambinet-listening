  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.89,
      "end_seconds": 4.26,
      "duration_seconds": 3.37,
      "text": "Hello, doctor. May I come in?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.6,
      "end_seconds": 9.83,
      "duration_seconds": 4.23,
      "text": "No problem at all, come in. What's troubling you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 11.88,
      "end_seconds": 19.56,
      "duration_seconds": 7.68,
      "text": "Honestly, it's a mole that has changed, and my family pushed me to come."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 21.43,
      "end_seconds": 23.23,
      "duration_seconds": 1.8,
      "text": "Okay, since when exactly?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 24.77,
      "end_seconds": 29.22,
      "duration_seconds": 4.45,
      "text": "Erm, it's been about three months, I'm fairly sure."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 29.73,
      "end_seconds": 33.47,
      "duration_seconds": 3.74,
      "text": "Have you had bleeding from the mole once?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 35.37,
      "end_seconds": 40.73,
      "duration_seconds": 5.36,
      "text": "Okay, so yes, about the same, about three months."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 41.47,
      "end_seconds": 47.68,
      "duration_seconds": 6.21,
      "text": "Have you had a mole that has changed before, or is this the first time?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 49.43,
      "end_seconds": 56.0,
      "duration_seconds": 6.57,
      "text": "I had a similar thing about six months ago. It went away."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 56.51,
      "end_seconds": 59.41,
      "duration_seconds": 2.9,
      "text": "Time for your numbers, if that's okay."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 70.04,
      "end_seconds": 72.67,
      "duration_seconds": 2.63,
      "text": "That's it, just a little longer..."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 92.7,
      "end_seconds": 99.49,
      "duration_seconds": 6.79,
      "text": "Okay: temp 36.6 degrees, BP is 128 over 70, pulse 73, respiratory rate 17."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 118.14,
      "end_seconds": 124.82,
      "duration_seconds": 6.68,
      "text": "A few quick ones: weight loss, other new moles or lumps in the armpit?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 126.88,
      "end_seconds": 134.87,
      "duration_seconds": 7.99,
      "text": "No weight loss, other new moles or lumps in the armpit, none of it."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 136.28,
      "end_seconds": 139.96,
      "duration_seconds": 3.68,
      "text": "Did you get pain or family history of melanoma?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 141.03,
      "end_seconds": 142.97,
      "duration_seconds": 1.94,
      "text": "None of those, no."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 144.91,
      "end_seconds": 147.06,
      "duration_seconds": 2.15,
      "text": "Is your digestion otherwise okay?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 148.92,
      "end_seconds": 151.52,
      "duration_seconds": 2.6,
      "text": "Nothing unusual, um, no."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 163.23,
      "end_seconds": 165.79,
      "duration_seconds": 2.56,
      "text": "Do you work outside the home?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 166.51,
      "end_seconds": 170.73,
      "duration_seconds": 4.22,
      "text": "I'm a hairdresser, on my feet all day."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 171.72,
      "end_seconds": 175.83,
      "duration_seconds": 4.11,
      "text": "What does a normal day of food look like?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 176.68,
      "end_seconds": 180.65,
      "duration_seconds": 3.97,
      "text": "Lots of rice, lentils and some fruit."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 182.05,
      "end_seconds": 185.18,
      "duration_seconds": 3.13,
      "text": "Is there anything relevant on the family side?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 186.28,
      "end_seconds": 192.03,
      "duration_seconds": 5.75,
      "text": "Sorry, what was I saying, my father had bowel cancer."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 196.6,
      "end_seconds": 203.33,
      "duration_seconds": 6.73,
      "text": "Right, has anyone ever diagnosed you with something? It helps to be thorough at this stage."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 205.07,
      "end_seconds": 211.99,
      "duration_seconds": 6.92,
      "text": "Yes, heart disease. I'm not great at remembering details, so bear with me."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 213.53,
      "end_seconds": 221.56,
      "duration_seconds": 8.03,
      "text": "Alright, heart disease, that matches what I have here. So, which medicines do you take at the moment?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 222.72,
      "end_seconds": 228.01,
      "duration_seconds": 5.29,
      "text": "I take aspirin, 75 milligrams, once a day for my heart."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 228.53,
      "end_seconds": 231.34,
      "duration_seconds": 2.81,
      "text": "Roughly how long on that one?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 232.06,
      "end_seconds": 233.9,
      "duration_seconds": 1.84,
      "text": "About about a year."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 235.6,
      "end_seconds": 243.19,
      "duration_seconds": 7.59,
      "text": "Going by what you've described, this looks most like a pigmented lesion that needs removal for a proper diagnosis."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 244.52,
      "end_seconds": 248.29,
      "duration_seconds": 3.77,
      "text": "Hmm, what are the odds it's serious?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 249.84,
      "end_seconds": 260.93,
      "duration_seconds": 11.09,
      "text": "I can't promise yet, but most people with a pigmented lesion that needs removal for a proper diagnosis do well once it's treated properly."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 269.51,
      "end_seconds": 298.5,
      "duration_seconds": 28.99,
      "text": "I'm sending you for a skin biopsy because of changing mole. Cover up and use factor 50 sunscreen on exposed skin. I'll also refer you to the skin cancer clinic. One warning sign to remember: the mole bleeds or grows quickly. In that case don't wait. Come back in two weeks. Can you run through the plan with me quickly, just to be certain?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 300.17,
      "end_seconds": 304.94,
      "duration_seconds": 4.77,
      "text": "So, I come back in two weeks. Is that right?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 306.02,
      "end_seconds": 310.98,
      "duration_seconds": 4.96,
      "text": "Yes, exactly right. Anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 311.8,
      "end_seconds": 313.84,
      "duration_seconds": 2.04,
      "text": "Alright, thanks, take care."
    }
  ]
}