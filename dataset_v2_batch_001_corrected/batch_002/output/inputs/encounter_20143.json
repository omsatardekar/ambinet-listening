{
  "schema_version": "1.0",
  "encounter_id": "20143",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.71,
      "end_seconds": 3.86,
      "duration_seconds": 3.15,
      "text": "morning, doctor. Lovely to meet you"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.76,
      "end_seconds": 9.75,
      "duration_seconds": 3.99,
      "text": "Come in. Please sit. How can I help you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 11.67,
      "end_seconds": 18.45,
      "duration_seconds": 6.78,
      "text": "um, you know, so... nearly blacking out that's why I came"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 19.05,
      "end_seconds": 22.32,
      "duration_seconds": 3.27,
      "text": "I'll note down your vital signs first"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 31.62,
      "end_seconds": 35.1,
      "duration_seconds": 3.48,
      "text": "so, bear with me while this finishes.."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 47.91,
      "end_seconds": 58.99,
      "duration_seconds": 11.08,
      "text": "okay: temperature is 37.1 degrees, saturation 98 percent, respiratory rate 20, BP is 93 over 57, pulse 110. When did this begin?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 60.75,
      "end_seconds": 64.0,
      "duration_seconds": 3.25,
      "text": "I've had it since last Tuesday"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 65.04,
      "end_seconds": 75.53,
      "duration_seconds": 10.49,
      "text": "Tell me a bit more about it: how bad it gets, how often, and whether anything makes it it better or worse."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 77.16,
      "end_seconds": 81.27,
      "duration_seconds": 4.11,
      "text": "It settles a little with lying down. Mostly severe."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 93.83,
      "end_seconds": 98.59,
      "duration_seconds": 4.76,
      "text": "And what about slurred speech, black stools, vomiting or chest pain?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 101.99,
      "end_seconds": 104.14,
      "duration_seconds": 2.15,
      "text": "Nope, nothing like that."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 105.89,
      "end_seconds": 109.89,
      "duration_seconds": 4.0,
      "text": "How about your heart, any problems like that?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 111.85,
      "end_seconds": 116.99,
      "duration_seconds": 5.14,
      "text": "My heart's been fine, as far as I know."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 119.01,
      "end_seconds": 121.41,
      "duration_seconds": 2.4,
      "text": "Do you have any chronic illnesses?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 122.43,
      "end_seconds": 129.26,
      "duration_seconds": 6.83,
      "text": "I've had an enlarged prostate for two years now. Yes, high blood pressure."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 130.86,
      "end_seconds": 133.79,
      "duration_seconds": 2.93,
      "text": "sure. Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 134.89,
      "end_seconds": 136.35,
      "duration_seconds": 1.46,
      "text": "No surgery, no."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 137.91,
      "end_seconds": 140.84,
      "duration_seconds": 2.93,
      "text": "What's on your current medicine list?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 142.63,
      "end_seconds": 152.33,
      "duration_seconds": 9.7,
      "text": "Tamsulosin, 0.4 milligrams, at night for the prostate. Losartan, 50 milligrams, once a day for my blood pressure."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 169.94,
      "end_seconds": 172.32,
      "duration_seconds": 2.38,
      "text": "Do you get out much?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 177.46,
      "end_seconds": 181.43,
      "duration_seconds": 3.97,
      "text": "Not much, I mostly stay in these days"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 183.47,
      "end_seconds": 185.27,
      "duration_seconds": 1.8,
      "text": "Have you retired yet?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 186.96,
      "end_seconds": 191.37,
      "duration_seconds": 4.41,
      "text": "I retired from the post office two years ago."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 192.17,
      "end_seconds": 194.99,
      "duration_seconds": 2.82,
      "text": "are you on your own at home?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 197.95,
      "end_seconds": 200.94,
      "duration_seconds": 2.99,
      "text": "I live with my elderly mother."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 215.84,
      "end_seconds": 220.3,
      "duration_seconds": 4.46,
      "text": "Do you react to any medicines or foods? Any allergies?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 221.31,
      "end_seconds": 223.82,
      "duration_seconds": 2.51,
      "text": "I've never had an allergy."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 226.18,
      "end_seconds": 230.01,
      "duration_seconds": 3.83,
      "text": "let me look at the area, I'll be gentle"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 231.06,
      "end_seconds": 232.3,
      "duration_seconds": 1.24,
      "text": "Nearly finished here."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 250.8,
      "end_seconds": 256.55,
      "duration_seconds": 5.75,
      "text": "Your blood pressure drops when you stand, from the lying reading to standing."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 260.86,
      "end_seconds": 271.42,
      "duration_seconds": 10.56,
      "text": "You can relax now. Putting it all together, this looks most like postural low blood pressure, possibly related to medicines or dehydration."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 284.78,
      "end_seconds": 290.27,
      "duration_seconds": 5.49,
      "text": "I want a lying and standing blood pressure check done, that's for dizziness"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 291.93,
      "end_seconds": 294.21,
      "duration_seconds": 2.28,
      "text": "okay, I'll do it"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 295.1,
      "end_seconds": 298.04,
      "duration_seconds": 2.94,
      "text": "we should do an ECG for dizziness"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 299.48,
      "end_seconds": 302.19,
      "duration_seconds": 2.71,
      "text": "Do I need to prepare?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 303.34,
      "end_seconds": 326.46,
      "duration_seconds": 23.12,
      "text": "Get up slowly from lying and sitting, and keep drinking fluids through the day. If you faint or have chest pain, or you feel really unwell, please come to the emergency department. I'd like to see you again after the results are back. Have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 327.03,
      "end_seconds": 328.49,
      "duration_seconds": 1.46,
      "text": "That's clear, thanks."
    }
  ]
}