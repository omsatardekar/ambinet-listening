  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.05,
      "end_seconds": 4.62,
      "duration_seconds": 3.57,
      "text": "Hello, sorry about the delay, do sit."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 6.25,
      "end_seconds": 9.36,
      "duration_seconds": 3.11,
      "text": "Morning, doctor, sorry about the rush."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 10.24,
      "end_seconds": 14.36,
      "duration_seconds": 4.12,
      "text": "Thank you for fitting us in, you know, doctor."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 15.03,
      "end_seconds": 17.45,
      "duration_seconds": 2.42,
      "text": "have you been here before?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 19.45,
      "end_seconds": 22.71,
      "duration_seconds": 3.26,
      "text": "A couple of times, but not recently."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 24.25,
      "end_seconds": 27.15,
      "duration_seconds": 2.9,
      "text": "How are things, what's been happening?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 31.3,
      "end_seconds": 36.68,
      "duration_seconds": 5.38,
      "text": "Doctor, it's nearly blacking out. That's what we're worried about."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 37.96,
      "end_seconds": 41.84,
      "duration_seconds": 3.88,
      "text": "Can you tell me when it first started?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 42.41,
      "end_seconds": 46.29,
      "duration_seconds": 3.88,
      "text": "it's been two days, I'm fairly sure"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 46.58,
      "end_seconds": 50.48,
      "duration_seconds": 3.9,
      "text": "Right, right. How much does it limit you?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 51.78,
      "end_seconds": 54.85,
      "duration_seconds": 3.07,
      "text": "Pretty mild, if I'm being honest."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 55.29,
      "end_seconds": 56.86,
      "duration_seconds": 1.57,
      "text": "yes, carry on"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 58.83,
      "end_seconds": 66.21,
      "duration_seconds": 7.38,
      "text": "Oh, and a pounding in my head. That's been about the same, ten days."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 67.19,
      "end_seconds": 70.1,
      "duration_seconds": 2.91,
      "text": "Alright, do you follow any particular diet?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 71.0,
      "end_seconds": 74.65,
      "duration_seconds": 3.65,
      "text": "I'm vegetarian and have been for years"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 76.2,
      "end_seconds": 78.6,
      "duration_seconds": 2.4,
      "text": "do you do any exercise?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 80.22,
      "end_seconds": 82.47,
      "duration_seconds": 2.25,
      "text": "I swim twice a week."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 86.6,
      "end_seconds": 89.14,
      "duration_seconds": 2.54,
      "text": "do you have any chronic illnesses?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 89.97,
      "end_seconds": 92.48,
      "duration_seconds": 2.51,
      "text": "I have an enlarged prostate"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 108.57,
      "end_seconds": 111.33,
      "duration_seconds": 2.76,
      "text": "have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 112.4,
      "end_seconds": 115.37,
      "duration_seconds": 2.97,
      "text": "Nothing, I haven't had any operations."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 125.48,
      "end_seconds": 130.45,
      "duration_seconds": 4.97,
      "text": "so, has anything ever caused you a reaction? I mean any allergies"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 131.8,
      "end_seconds": 135.14,
      "duration_seconds": 3.34,
      "text": "No, I'm not allergic to anything."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 136.93,
      "end_seconds": 141.66,
      "duration_seconds": 4.73,
      "text": "Can you list what you take, tablets, creams or inhalers?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 143.02,
      "end_seconds": 148.62,
      "duration_seconds": 5.6,
      "text": "It's tamsulosin, 0.4 milligrams, at night for the prostate, doctor."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 154.69,
      "end_seconds": 158.12,
      "duration_seconds": 3.43,
      "text": "Alright, did you get fainting, vomiting or palpitations?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 160.18,
      "end_seconds": 165.05,
      "duration_seconds": 4.87,
      "text": "No, you know, I haven't had any of them."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 167.03,
      "end_seconds": 169.97,
      "duration_seconds": 2.94,
      "text": "has there been any chest pain?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 170.95,
      "end_seconds": 173.12,
      "duration_seconds": 2.17,
      "text": "Definitely no chest pain."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 179.46,
      "end_seconds": 182.9,
      "duration_seconds": 3.44,
      "text": "How about your heart, any problems like that?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 184.64,
      "end_seconds": 190.37,
      "duration_seconds": 5.73,
      "text": "My heart's been fine, um, as far as I know."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 191.89,
      "end_seconds": 195.19,
      "duration_seconds": 3.3,
      "text": "Time for your numbers, if that's okay."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 201.76,
      "end_seconds": 204.25,
      "duration_seconds": 2.49,
      "text": "keep your arm relaxed for me.."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 216.49,
      "end_seconds": 226.05,
      "duration_seconds": 9.56,
      "text": "Okay: BP is 98 over 59, temperature 37.1, respiratory rate 20. And heart rate 109, saturation 98 percent."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 226.73,
      "end_seconds": 228.29,
      "duration_seconds": 1.56,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 228.83,
      "end_seconds": 231.25,
      "duration_seconds": 2.42,
      "text": "We'll go over that shortly."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 233.73,
      "end_seconds": 237.8,
      "duration_seconds": 4.07,
      "text": "Let me look at the area, I'll be gentle."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 239.35,
      "end_seconds": 241.99,
      "duration_seconds": 2.64,
      "text": "Take a deep breath for me."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 257.12,
      "end_seconds": 262.66,
      "duration_seconds": 5.54,
      "text": "Your blood pressure drops when you stand, from the lying reading to standing."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 264.26,
      "end_seconds": 266.55,
      "duration_seconds": 2.29,
      "text": "Hold that for a second."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 284.74,
      "end_seconds": 288.3,
      "duration_seconds": 3.56,
      "text": "Heart sounds are normal and the chest is clear"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 290.99,
      "end_seconds": 293.84,
      "duration_seconds": 2.85,
      "text": "That's all I needed to check."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 309.67,
      "end_seconds": 341.45,
      "duration_seconds": 31.78,
      "text": "So, based on the history and the examination, I think we're dealing with postural low blood pressure, possibly related to medicines or dehydration at this stage. We shouldn't forget an abnormal heart rhythm. I'd like to arrange blood tests for dizziness. I'd like to arrange an ECG for dizziness. That will help us see what's going on underneath and decide the next step. Get up slowly from lying and sitting, and keep drinking fluids through the day."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 342.58,
      "end_seconds": 354.49,
      "duration_seconds": 11.91,
      "text": "Please come and see me after the results are back. Can you tell me the plan back in your own words, so I know I've explained it clearly?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 356.58,
      "end_seconds": 362.68,
      "duration_seconds": 6.1,
      "text": "so, I come back after the results are back is that right?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 363.92,
      "end_seconds": 369.41,
      "duration_seconds": 5.49,
      "text": "Yes, exactly right. I think we're done unless you have questions."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 372.46,
      "end_seconds": 376.43,
      "duration_seconds": 3.97,
      "text": "Right, I'll do that. Thank you, doctor."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 377.8,
      "end_seconds": 379.04,
      "duration_seconds": 1.24,
      "text": "Take care now."
    }
  ]
