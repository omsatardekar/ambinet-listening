{
  "schema_version": "1.0",
  "encounter_id": "20132",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.65,
      "end_seconds": 4.64,
      "duration_seconds": 3.99,
      "text": "Ah, morning, doctor. Lovely to meet you."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.42,
      "end_seconds": 11.99,
      "duration_seconds": 4.57,
      "text": "Yes, have a seat. Tell me what's going on."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 12.94,
      "end_seconds": 19.68,
      "duration_seconds": 6.74,
      "text": "I've been feeling shaky and sweaty, and I wanted to get it checked."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 20.92,
      "end_seconds": 24.09,
      "duration_seconds": 3.17,
      "text": "How many days or weeks has it been?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 25.93,
      "end_seconds": 29.93,
      "duration_seconds": 4.0,
      "text": "Mm, it's been going on for five days."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 31.63,
      "end_seconds": 36.76,
      "duration_seconds": 5.13,
      "text": "Okay, give me more detail on it, whatever comes to mind."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 37.41,
      "end_seconds": 60.62,
      "duration_seconds": 23.21,
      "text": "Hmm, only sugary drinks, and it's not much. Yes, missing meals. That makes it worse. Severe, I'd say. I'd say a few times a day. Erm, and there's headaches as well, about a week now. As for headaches, pretty severe, if I'm being honest."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 62.36,
      "end_seconds": 65.81,
      "duration_seconds": 3.45,
      "text": "Have you noticed fainting, seizure or blurred vision?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 67.09,
      "end_seconds": 71.51,
      "duration_seconds": 4.42,
      "text": "Okay, so no, none that I've noticed."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 77.6,
      "end_seconds": 80.62,
      "duration_seconds": 3.02,
      "text": "Any slurred speech or vomiting at all?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 83.63,
      "end_seconds": 87.89,
      "duration_seconds": 4.26,
      "text": "Right, um, no, not a single one."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 89.77,
      "end_seconds": 93.14,
      "duration_seconds": 3.37,
      "text": "How about your heart, any problems like that?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 97.48,
      "end_seconds": 100.23,
      "duration_seconds": 2.75,
      "text": "No, nothing with my heart."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 105.99,
      "end_seconds": 108.73,
      "duration_seconds": 2.74,
      "text": "Any muscle or joint problems besides this?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 109.68,
      "end_seconds": 111.21,
      "duration_seconds": 1.53,
      "text": "Nothing else aches."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 112.9,
      "end_seconds": 116.36,
      "duration_seconds": 3.46,
      "text": "Right, a few questions about your lifestyle now."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 122.46,
      "end_seconds": 133.66,
      "duration_seconds": 11.2,
      "text": "I live with my elderly mother. Not much, I mostly stay in these days. I grab fast food at lunch most days."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 134.36,
      "end_seconds": 137.06,
      "duration_seconds": 2.7,
      "text": "Have you got any known allergies?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 138.43,
      "end_seconds": 143.96,
      "duration_seconds": 5.53,
      "text": "So, you know, no, not that I know of."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 144.56,
      "end_seconds": 149.48,
      "duration_seconds": 4.92,
      "text": "Right, can you list what you take, tablets, creams or inhalers?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 151.19,
      "end_seconds": 157.75,
      "duration_seconds": 6.56,
      "text": "So, uh, I used to take sitagliptin, but I stopped it."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 176.27,
      "end_seconds": 179.48,
      "duration_seconds": 3.21,
      "text": "Any health conditions I should have on record?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 183.34,
      "end_seconds": 192.6,
      "duration_seconds": 9.26,
      "text": "Diabetes, for two years. A neighbour of mine said I should see someone about it."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 194.03,
      "end_seconds": 194.88,
      "duration_seconds": 0.85,
      "text": "I follow."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 211.35,
      "end_seconds": 214.08,
      "duration_seconds": 2.73,
      "text": "I'll note down your vital signs first."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 227.32,
      "end_seconds": 229.69,
      "duration_seconds": 2.37,
      "text": "Keep your arm relaxed for me..."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 238.83,
      "end_seconds": 245.63,
      "duration_seconds": 6.8,
      "text": "Okay: pulse 64, saturation 97 percent, blood pressure 127 over 70. And temp 36.5 degrees."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 247.58,
      "end_seconds": 251.26,
      "duration_seconds": 3.68,
      "text": "Alright, over here please and I'll take a look."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 253.12,
      "end_seconds": 255.15,
      "duration_seconds": 2.03,
      "text": "I'm just checking this side."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 273.26,
      "end_seconds": 278.22,
      "duration_seconds": 4.96,
      "text": "Your fingerprick sugar now is normal and your heart rate is steady."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 280.5,
      "end_seconds": 292.21,
      "duration_seconds": 11.71,
      "text": "That's all I needed to check. From what you've told me and what I found, this is probably episodes of low blood sugar related to diabetes treatment."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 293.43,
      "end_seconds": 297.13,
      "duration_seconds": 3.7,
      "text": "Do you think it's something serious?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 298.38,
      "end_seconds": 311.26,
      "duration_seconds": 12.88,
      "text": "I understand the worry. At the moment I'd say it's episodes of low blood sugar related to diabetes treatment, and we'll know more once the an HbA1c is back."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 329.08,
      "end_seconds": 357.32,
      "duration_seconds": 28.24,
      "text": "I want an HbA1c done, that's for diabetes control. I want blood tests done, that's for low sugar. Never skip meals when you take the sugar tablet, and keep glucose tablets or juice with you. I'm not ordering a home sugar diary today. If things carry on in two weeks, we'll consider it. So, anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 359.25,
      "end_seconds": 362.72,
      "duration_seconds": 3.47,
      "text": "I think I understand everything. Thanks."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 365.92,
      "end_seconds": 367.56,
      "duration_seconds": 1.64,
      "text": "Have a good day."
    }
  ]
}