{
  "schema_version": "1.0",
  "encounter_id": "20485",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.61,
      "end_seconds": 2.37,
      "duration_seconds": 1.76,
      "text": "Good afternoon, doctor."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 3.74,
      "end_seconds": 8.99,
      "duration_seconds": 5.25,
      "text": "Yes, come in and sit down. What brings you here today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 10.19,
      "end_seconds": 14.05,
      "duration_seconds": 3.86,
      "text": "I've been dealing with my heart racing."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 16.06,
      "end_seconds": 18.66,
      "duration_seconds": 2.6,
      "text": "Let me take your readings now."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 30.06,
      "end_seconds": 32.86,
      "duration_seconds": 2.8,
      "text": "That's it, just a little longer..."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 52.25,
      "end_seconds": 67.68,
      "duration_seconds": 15.43,
      "text": "Okay: SpO2 99 percent on room air, height 170 centimetres, weight 59 kilos. And temp 36.6 degrees, pulse 119, blood pressure 138 over 79, respiratory rate 19. Since when exactly?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 69.38,
      "end_seconds": 71.49,
      "duration_seconds": 2.11,
      "text": "Probably three weeks. Yeah."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 73.25,
      "end_seconds": 76.2,
      "duration_seconds": 2.95,
      "text": "Is it bearing on you a lot?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 77.35,
      "end_seconds": 86.75,
      "duration_seconds": 9.4,
      "text": "A three out of ten, I suppose. Erm, I've also had loose stools, for nearly five years."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 98.4,
      "end_seconds": 102.51,
      "duration_seconds": 4.11,
      "text": "A few quick ones: double vision, fever or fainting?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 104.5,
      "end_seconds": 106.94,
      "duration_seconds": 2.44,
      "text": "No, I'd have said so."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 108.56,
      "end_seconds": 111.09,
      "duration_seconds": 2.53,
      "text": "Any rashes or skin problems otherwise?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 111.94,
      "end_seconds": 112.93,
      "duration_seconds": 0.99,
      "text": "No rashes."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 114.23,
      "end_seconds": 117.99,
      "duration_seconds": 3.76,
      "text": "Any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 120.92,
      "end_seconds": 123.75,
      "duration_seconds": 2.83,
      "text": "No, I've always been fairly healthy."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 124.89,
      "end_seconds": 126.36,
      "duration_seconds": 1.47,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 128.39,
      "end_seconds": 131.61,
      "duration_seconds": 3.22,
      "text": "Nothing, I haven't had any operations."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 148.45,
      "end_seconds": 151.37,
      "duration_seconds": 2.92,
      "text": "Do you take any regular medication?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 152.73,
      "end_seconds": 153.8,
      "duration_seconds": 1.07,
      "text": "No, none."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 171.43,
      "end_seconds": 175.39,
      "duration_seconds": 3.96,
      "text": "Let's talk a little about your daily life and habits."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 176.01,
      "end_seconds": 193.76,
      "duration_seconds": 17.75,
      "text": "I gave up cigarettes last spring. I'll have a glass of wine with dinner. I swim twice a week. I'm vegetarian and have been for years. I live with my elderly mother."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 194.59,
      "end_seconds": 197.23,
      "duration_seconds": 2.64,
      "text": "Before we go further, any allergies?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 199.07,
      "end_seconds": 202.05,
      "duration_seconds": 2.98,
      "text": "No, I've never reacted to anything."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 204.81,
      "end_seconds": 209.08,
      "duration_seconds": 4.27,
      "text": "Let me look at the area, I'll be gentle."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 209.93,
      "end_seconds": 211.74,
      "duration_seconds": 1.81,
      "text": "Yes, that's fine."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 212.6,
      "end_seconds": 214.19,
      "duration_seconds": 1.59,
      "text": "Let me feel here."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 231.7,
      "end_seconds": 238.44,
      "duration_seconds": 6.74,
      "text": "There is a fine tremor of the outstretched hands and the pulse is fast and regular."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 239.58,
      "end_seconds": 241.21,
      "duration_seconds": 1.63,
      "text": "Let me feel here."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 250.5,
      "end_seconds": 256.35,
      "duration_seconds": 5.85,
      "text": "There is a smooth, small swelling at the front of the neck."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 258.81,
      "end_seconds": 265.8,
      "duration_seconds": 6.99,
      "text": "You can sit up now. Putting it all together, the most likely explanation is an overactive thyroid."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 267.48,
      "end_seconds": 271.39,
      "duration_seconds": 3.91,
      "text": "I'm scared it's something bad. Is it?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 272.33,
      "end_seconds": 291.07,
      "duration_seconds": 18.74,
      "text": "I understand the worry. At the moment I'd say it's an overactive thyroid, and we'll know more once the an ECG is back. Stop me if I've got anything wrong. You've had your heart racing for three weeks, and no fever or fainting."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 291.91,
      "end_seconds": 292.61,
      "duration_seconds": 0.7,
      "text": "Exactly."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 303.13,
      "end_seconds": 318.75,
      "duration_seconds": 15.62,
      "text": "I'll request an ECG, it'll help with palpitations. I'm going to put you on propranolol, 20 milligrams, twice a day, until review. You take it by mouth. That's for racing heart and tremor."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 319.44,
      "end_seconds": 323.05,
      "duration_seconds": 3.61,
      "text": "Um, how soon will it work?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 324.0,
      "end_seconds": 331.09,
      "duration_seconds": 7.09,
      "text": "Try to avoid caffeine while we sort this out. Come back after the thyroid results."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 333.08,
      "end_seconds": 335.11,
      "duration_seconds": 2.03,
      "text": "Alright, I'll be back."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 338.06,
      "end_seconds": 341.28,
      "duration_seconds": 3.22,
      "text": "I think we're done unless you have questions."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 342.69,
      "end_seconds": 345.52,
      "duration_seconds": 2.83,
      "text": "No, that's all. Thanks a lot."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 346.95,
      "end_seconds": 348.43,
      "duration_seconds": 1.48,
      "text": "See you soon."
    }
  ]
}