  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 1.21,
      "end_seconds": 6.76,
      "duration_seconds": 5.55,
      "text": "doctor, I've brought them through. The observations are done, whenever you need them"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.68,
      "end_seconds": 11.48,
      "duration_seconds": 3.8,
      "text": "Perfect, thanks. Hello there, so what's the trouble?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 13.31,
      "end_seconds": 16.83,
      "duration_seconds": 3.52,
      "text": "thank you for fitting us in doctor"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 18.42,
      "end_seconds": 21.86,
      "duration_seconds": 3.44,
      "text": "Please do. Extra information is always welcome."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 23.89,
      "end_seconds": 27.64,
      "duration_seconds": 3.75,
      "text": "He's been having drenching night sweats doctor."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 29.69,
      "end_seconds": 32.66,
      "duration_seconds": 2.97,
      "text": "what's the timeline, when did it begin?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 34.49,
      "end_seconds": 37.15,
      "duration_seconds": 2.66,
      "text": "for two days, I'd say"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 38.01,
      "end_seconds": 46.85,
      "duration_seconds": 8.84,
      "text": "Okay, can you describe it a bit more for me? How strong it is, what the pattern is, what helps."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 49.61,
      "end_seconds": 60.9,
      "duration_seconds": 11.29,
      "text": "it's, It's every other day i get some relief from changing my clothes my neighbour said I should get it looked at"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 61.68,
      "end_seconds": 68.91,
      "duration_seconds": 7.23,
      "text": "I mean, I was just gonna say that the main thing is—"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 69.01,
      "end_seconds": 75.72,
      "duration_seconds": 6.71,
      "text": "sorry to cut in, doctor, quick question: shall I bring the trolley in now or later?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 76.75,
      "end_seconds": 78.86,
      "duration_seconds": 2.11,
      "text": "Later thanks. Please go on."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 80.21,
      "end_seconds": 95.94,
      "duration_seconds": 15.73,
      "text": "Oh, and a lump in my armpit. Had that since this morning. Oh, you know, and a low fever in the evenings. That's been about the same, two weeks."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 96.64,
      "end_seconds": 103.04,
      "duration_seconds": 6.4,
      "text": "Have you had drenching night sweats before or is this the first time?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 104.41,
      "end_seconds": 111.63,
      "duration_seconds": 7.22,
      "text": "A A bit a couple of years ago. It settled by itself back then."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 112.58,
      "end_seconds": 114.98,
      "duration_seconds": 2.4,
      "text": "now some background about your lifestyle"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 116.45,
      "end_seconds": 131.99,
      "duration_seconds": 15.54,
      "text": "Nothing, I'm teetotal. No, I've never smoked in my life. I'm a bus driver, so I sit for long hours. Not much, I mostly stay in these days"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 134.06,
      "end_seconds": 136.98,
      "duration_seconds": 2.92,
      "text": "do you have any chronic illnesses?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 137.79,
      "end_seconds": 148.48,
      "duration_seconds": 10.69,
      "text": "I have high blood pressure i'd rather not end up on lots of tablets if I can avoid it"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 149.42,
      "end_seconds": 150.5,
      "duration_seconds": 1.08,
      "text": "mm, okay"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 151.97,
      "end_seconds": 155.61,
      "duration_seconds": 3.64,
      "text": "Right, I've had high cholesterol, yes."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 157.32,
      "end_seconds": 168.16,
      "duration_seconds": 10.84,
      "text": "mm okay okay I can see high blood pressure and high cholesterol in your file as well can you list what you take tablets creams or inhalers?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 168.77,
      "end_seconds": 174.36,
      "duration_seconds": 5.59,
      "text": "I take amlodipine, 5 milligrams, maybe, once a day."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 175.82,
      "end_seconds": 180.29,
      "duration_seconds": 4.47,
      "text": "Did you happen to bring the box or the paperwork?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 181.36,
      "end_seconds": 194.97,
      "duration_seconds": 13.61,
      "text": "No, it's at home. Simvastatin, 20 milligrams, at night for my cholesterol. Dolo. I take it 650 milligrams, when I get the fever."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 201.06,
      "end_seconds": 202.29,
      "duration_seconds": 1.23,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 203.96,
      "end_seconds": 207.09,
      "duration_seconds": 3.13,
      "text": "uh, no, not at all"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 207.59,
      "end_seconds": 210.96,
      "duration_seconds": 3.37,
      "text": "has anyone in your family had anything serious?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 212.16,
      "end_seconds": 217.43,
      "duration_seconds": 5.27,
      "text": "My father had bowel cancer. My grandmother had dementia."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 218.88,
      "end_seconds": 223.61,
      "duration_seconds": 4.73,
      "text": "any allergies to to tablets, food or anything in the environment?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 224.81,
      "end_seconds": 228.7,
      "duration_seconds": 3.89,
      "text": "right um not to my knowledge no"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 230.31,
      "end_seconds": 234.35,
      "duration_seconds": 4.04,
      "text": "have you had any recent travel or joint pain?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 235.97,
      "end_seconds": 242.56,
      "duration_seconds": 6.59,
      "text": "Um, I haven't had recent travel or joint pain, no."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 244.62,
      "end_seconds": 249.47,
      "duration_seconds": 4.85,
      "text": "let me check a few things. Any cough or weight loss?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 250.45,
      "end_seconds": 256.14,
      "duration_seconds": 5.69,
      "text": "I, I haven't had cough or weight loss, no."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 256.79,
      "end_seconds": 258.14,
      "duration_seconds": 1.35,
      "text": "any chest pain?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 260.17,
      "end_seconds": 262.47,
      "duration_seconds": 2.3,
      "text": "No, no chest pain."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 264.49,
      "end_seconds": 266.66,
      "duration_seconds": 2.17,
      "text": "Has your skin been okay?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 268.19,
      "end_seconds": 269.24,
      "duration_seconds": 1.05,
      "text": "No rashes."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 285.76,
      "end_seconds": 296.59,
      "duration_seconds": 10.83,
      "text": "doctor, I've got the readings for you pulse is 104 beats a a minute, temp 39.2 degrees, oxygen saturation is 97 percent, pressure 110 over 72."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 297.27,
      "end_seconds": 298.78,
      "duration_seconds": 1.51,
      "text": "Good, thank you."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 300.26,
      "end_seconds": 304.77,
      "duration_seconds": 4.51,
      "text": "I'll need to examine you for this it won't take long"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 306.77,
      "end_seconds": 308.81,
      "duration_seconds": 2.04,
      "text": "I'm just checking this side"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 320.37,
      "end_seconds": 322.47,
      "duration_seconds": 2.1,
      "text": "I can't feel your spleen"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 324.29,
      "end_seconds": 326.54,
      "duration_seconds": 2.25,
      "text": "tell me if that's sore"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 334.59,
      "end_seconds": 340.72,
      "duration_seconds": 6.13,
      "text": "there's a firm, rubbery gland about two centimetres in the left armpit not tender"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 346.54,
      "end_seconds": 349.17,
      "duration_seconds": 2.63,
      "text": "that's all I needed to check"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 359.13,
      "end_seconds": 377.44,
      "duration_seconds": 18.31,
      "text": "okay, thinking it through, I don't have a clear answer today: an enlarged gland with night sweats that needs a proper work-up is possible, and so is a lingering infection a blood condition is also on my list"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 378.16,
      "end_seconds": 382.28,
      "duration_seconds": 4.12,
      "text": "Ah, I'm scared it's something bad. Is it?"
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 383.2,
      "end_seconds": 400.89,
      "duration_seconds": 17.69,
      "text": "It's reasonable to be concerned, but right now an enlarged gland with night sweats that needs a proper work-up is my leading thought, not anything worse. I'm gonna order an ultrasound of the armpit, for lymph node."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 401.99,
      "end_seconds": 404.73,
      "duration_seconds": 2.74,
      "text": "Well, is that done today?"
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 406.37,
      "end_seconds": 427.47,
      "duration_seconds": 21.1,
      "text": "Blood tests is what I'd like next, for night sweats. Keep a note of your temperature each evening. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose. Do get help quickly if the symptoms get worse."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 428.75,
      "end_seconds": 429.73,
      "duration_seconds": 0.98,
      "text": "I understand"
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 430.68,
      "end_seconds": 436.34,
      "duration_seconds": 5.66,
      "text": "I'd like to to see you again after the results are back."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 437.83,
      "end_seconds": 439.89,
      "duration_seconds": 2.06,
      "text": "Good, I'll return then."
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 440.5,
      "end_seconds": 443.34,
      "duration_seconds": 2.84,
      "text": "have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 445.11,
      "end_seconds": 449.81,
      "duration_seconds": 4.7,
      "text": "So uh no that's all. Thanks a lot."
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 451.03,
      "end_seconds": 452.43,
      "duration_seconds": 1.4,
      "text": "goodbye for now"
    }
  ]
