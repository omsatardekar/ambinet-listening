{
  "schema_version": "1.0",
  "encounter_id": "20217",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 1.28,
      "end_seconds": 6.06,
      "duration_seconds": 4.78,
      "text": "Afternoon, doctor. They're in and comfortable, and I have the measurements ready."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.93,
      "end_seconds": 11.52,
      "duration_seconds": 4.59,
      "text": "Great. Hello, come in and sit down. How can I help?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 15.99,
      "end_seconds": 20.34,
      "duration_seconds": 4.35,
      "text": "Doctor, I'm just here to help with the details."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 21.38,
      "end_seconds": 25.29,
      "duration_seconds": 3.91,
      "text": "Alright, yes, that's no problem at all. Please sit."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 25.87,
      "end_seconds": 32.02,
      "duration_seconds": 6.15,
      "text": "Honestly, it's some bleeding, and my family pushed me to come."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 33.21,
      "end_seconds": 36.57,
      "duration_seconds": 3.36,
      "text": "has this been going on for long?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 38.3,
      "end_seconds": 40.99,
      "duration_seconds": 2.69,
      "text": "I've had it since last Tuesday"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 41.4,
      "end_seconds": 45.25,
      "duration_seconds": 3.85,
      "text": "Okay, go on. Any a missed period as well?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 46.3,
      "end_seconds": 49.17,
      "duration_seconds": 2.87,
      "text": "Yeah. Three days, I'd say."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 51.09,
      "end_seconds": 54.53,
      "duration_seconds": 3.44,
      "text": "How strong would you say it is?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 56.57,
      "end_seconds": 58.18,
      "duration_seconds": 1.61,
      "text": "I'd say severe."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 59.87,
      "end_seconds": 68.79,
      "duration_seconds": 8.92,
      "text": "Let me check a a few things. Any passing tissue, shoulder tip pain, severe one-sided pain or fainting?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 69.48,
      "end_seconds": 82.32,
      "duration_seconds": 12.84,
      "text": "no, no passing tissue, no shoulder tip pain, no severe one-sided pain i did have tender breasts at one point, but that went away on its own"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 82.99,
      "end_seconds": 84.44,
      "duration_seconds": 1.45,
      "text": "Nothing like fever?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 85.15,
      "end_seconds": 86.52,
      "duration_seconds": 1.37,
      "text": "Definitely no fever."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 88.26,
      "end_seconds": 91.56,
      "duration_seconds": 3.3,
      "text": "Anything on the skin I should know about?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 92.91,
      "end_seconds": 95.21,
      "duration_seconds": 2.3,
      "text": "No, skin's been fine."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 96.2,
      "end_seconds": 99.42,
      "duration_seconds": 3.22,
      "text": "how are your joints, any aches elsewhere?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 101.03,
      "end_seconds": 102.72,
      "duration_seconds": 1.69,
      "text": "no, nothing there"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 103.34,
      "end_seconds": 106.32,
      "duration_seconds": 2.98,
      "text": "alright, what about your medical history?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 110.62,
      "end_seconds": 114.17,
      "duration_seconds": 3.55,
      "text": "I've had depression for two years now"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 114.81,
      "end_seconds": 116.09,
      "duration_seconds": 1.28,
      "text": "and besides that?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 117.74,
      "end_seconds": 119.91,
      "duration_seconds": 2.17,
      "text": "I've had migraines, yes."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 120.84,
      "end_seconds": 124.58,
      "duration_seconds": 3.74,
      "text": "Alright, depression, that matches what I have here."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 136.33,
      "end_seconds": 139.06,
      "duration_seconds": 2.73,
      "text": "are there any illnesses in your family?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 142.09,
      "end_seconds": 146.79,
      "duration_seconds": 4.7,
      "text": "My uncle has high cholesterol. My grandfather had a stroke."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 148.61,
      "end_seconds": 151.91,
      "duration_seconds": 3.3,
      "text": "what do you take on a normal day?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 156.56,
      "end_seconds": 162.3,
      "duration_seconds": 5.74,
      "text": "I'm on something called esci... escitalopram, 10 milligrams, maybe, once a day."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 162.96,
      "end_seconds": 166.87,
      "duration_seconds": 3.91,
      "text": "Do you have the packet or the prescription with you?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 167.37,
      "end_seconds": 176.07,
      "duration_seconds": 8.7,
      "text": "No, it's at home. Ah, uh, it's sumatriptan, 50 milligrams, when needed for my migraines."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 177.87,
      "end_seconds": 185.13,
      "duration_seconds": 7.26,
      "text": "she is supposed to take it when needed, but I can't say she always does"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 185.99,
      "end_seconds": 190.09,
      "duration_seconds": 4.1,
      "text": "I was on mirtazapine before. I stopped taking it."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 193.82,
      "end_seconds": 197.84,
      "duration_seconds": 4.02,
      "text": "Any allergies to tablets, food or anything in the environment?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 199.6,
      "end_seconds": 208.44,
      "duration_seconds": 8.84,
      "text": "Yes, walnuts. I've no idea what the reaction was, only that that I'm not supposed to have it."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 210.36,
      "end_seconds": 212.91,
      "duration_seconds": 2.55,
      "text": "now some background about your lifestyle"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 217.07,
      "end_seconds": 230.77,
      "duration_seconds": 13.7,
      "text": "I only drink at family occasions. I have about eight cigarettes in a day. I swim twice a week. I grab fast food at lunch most days."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 232.0,
      "end_seconds": 234.93,
      "duration_seconds": 2.93,
      "text": "What operations have you had, if any?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 235.91,
      "end_seconds": 241.82,
      "duration_seconds": 5.91,
      "text": "just my appendix taken out, when I was in my twenties"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 250.7,
      "end_seconds": 263.71,
      "duration_seconds": 13.01,
      "text": "okay, so the vitals from earlier temp 36.7 degrees, SpO2 97 percent on room air pulse is 70 beats a minute, blood pressure 115 over 70, respiratory rate 15."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 265.45,
      "end_seconds": 266.4,
      "duration_seconds": 0.95,
      "text": "Okay, noted."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 267.43,
      "end_seconds": 271.53,
      "duration_seconds": 4.1,
      "text": "Let me look at the area, I'll be gentle."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 272.54,
      "end_seconds": 274.49,
      "duration_seconds": 1.95,
      "text": "Raise your arm for me."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 282.16,
      "end_seconds": 288.22,
      "duration_seconds": 6.06,
      "text": "Your tummy is soft with mild tenderness low down and your blood pressure is normal."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 293.17,
      "end_seconds": 315.57,
      "duration_seconds": 22.4,
      "text": "You can sit up now. Let's get an early pregnancy scan, for bleeding in early pregnancy. We should do a pregnancy hormone level for bleeding in early pregnancy. Use pads rather than tampons and avoid intercourse until the scan. I'm gonna send a referral to the early pregnancy unit."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 317.02,
      "end_seconds": 317.72,
      "duration_seconds": 0.7,
      "text": "okay"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 319.71,
      "end_seconds": 328.66,
      "duration_seconds": 8.95,
      "text": "And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 329.55,
      "end_seconds": 332.44,
      "duration_seconds": 2.89,
      "text": "Yes, I'll bear that in mind."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 333.08,
      "end_seconds": 344.02,
      "duration_seconds": 10.94,
      "text": "do get help quickly if the bleeding becomes heavy or the pain becomes severe or one-sided. I'd like to see you again after the scan"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 345.7,
      "end_seconds": 347.6,
      "duration_seconds": 1.9,
      "text": "That's fine with me."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 349.55,
      "end_seconds": 354.49,
      "duration_seconds": 4.94,
      "text": "right, that's the the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 355.19,
      "end_seconds": 357.16,
      "duration_seconds": 1.97,
      "text": "thank you, that's helpful"
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 359.12,
      "end_seconds": 360.37,
      "duration_seconds": 1.25,
      "text": "Take care now."
    }
  ]
}