{
  "schema_version": "1.0",
  "encounter_id": "20138",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.6,
      "end_seconds": 5.27,
      "duration_seconds": 4.67,
      "text": "Sorry, uh, doctor, shall I sit here?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.84,
      "end_seconds": 10.55,
      "duration_seconds": 4.71,
      "text": "Alright, of course, leave it there. How can I help?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 11.13,
      "end_seconds": 18.69,
      "duration_seconds": 7.56,
      "text": "Honestly, it's pain in my heel, and my family pushed me to come."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 20.72,
      "end_seconds": 23.69,
      "duration_seconds": 2.97,
      "text": "How long has it been like this?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 27.62,
      "end_seconds": 29.86,
      "duration_seconds": 2.24,
      "text": "Probably two years. Yeah."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 31.45,
      "end_seconds": 39.76,
      "duration_seconds": 8.31,
      "text": "Can you describe it a bit more for me? How strong it is, what the pattern is, what helps."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 40.38,
      "end_seconds": 46.12,
      "duration_seconds": 5.74,
      "text": "I'd give it a six, out of ten. It comes and goes."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 46.81,
      "end_seconds": 50.43,
      "duration_seconds": 3.62,
      "text": "Any back pain, fever or swelling at all?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 52.24,
      "end_seconds": 54.19,
      "duration_seconds": 1.95,
      "text": "Nope, nothing like that."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 55.08,
      "end_seconds": 58.57,
      "duration_seconds": 3.49,
      "text": "So, has your heart given you any trouble?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 59.47,
      "end_seconds": 61.38,
      "duration_seconds": 1.91,
      "text": "No, that's been fine."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 62.75,
      "end_seconds": 66.6,
      "duration_seconds": 3.85,
      "text": "Anything on the skin I should know about?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 68.29,
      "end_seconds": 69.19,
      "duration_seconds": 0.9,
      "text": "Skin's normal."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 82.98,
      "end_seconds": 86.79,
      "duration_seconds": 3.81,
      "text": "Any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 87.35,
      "end_seconds": 90.69,
      "duration_seconds": 3.34,
      "text": "No, I've always been fairly healthy."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 92.02,
      "end_seconds": 95.96,
      "duration_seconds": 3.94,
      "text": "Let's talk a little about your daily life and habits."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 97.14,
      "end_seconds": 117.3,
      "duration_seconds": 20.16,
      "text": "I'll have a glass of wine with dinner. I have about eight cigarettes in a day. I work in accounts at a hospital. I live with my elderly mother. Lots of rice, lentils and some fruit."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 119.16,
      "end_seconds": 121.53,
      "duration_seconds": 2.37,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 123.05,
      "end_seconds": 126.52,
      "duration_seconds": 3.47,
      "text": "Nothing, I haven't had any operations."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 128.18,
      "end_seconds": 131.22,
      "duration_seconds": 3.04,
      "text": "Before we go further, any allergies?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 132.38,
      "end_seconds": 137.54,
      "duration_seconds": 5.16,
      "text": "I'm allergic to walnuts, I get my lips swelling."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 148.43,
      "end_seconds": 150.95,
      "duration_seconds": 2.52,
      "text": "Tell me your medicines, please."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 152.92,
      "end_seconds": 155.73,
      "duration_seconds": 2.81,
      "text": "Insoles. I take it every day."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 168.11,
      "end_seconds": 172.25,
      "duration_seconds": 4.14,
      "text": "Can I check a few measurements before we carry on?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 183.25,
      "end_seconds": 185.32,
      "duration_seconds": 2.07,
      "text": "Okay, this won't take long..."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 196.75,
      "end_seconds": 206.42,
      "duration_seconds": 9.67,
      "text": "Okay: pressure 124 over 73, respiratory rate 17. And temperature 36.9, pulse is 68 beats a minute, oxygen saturation is 99 percent."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 208.29,
      "end_seconds": 209.79,
      "duration_seconds": 1.5,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 210.62,
      "end_seconds": 214.15,
      "duration_seconds": 3.53,
      "text": "Don't worry, we'll discuss it in a second."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 215.79,
      "end_seconds": 221.2,
      "duration_seconds": 5.41,
      "text": "I'll need to examine you for this, it won't take long."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 222.64,
      "end_seconds": 224.33,
      "duration_seconds": 1.69,
      "text": "So, look straight ahead."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 238.37,
      "end_seconds": 247.43,
      "duration_seconds": 9.06,
      "text": "There is a sore spot at the inner front of the heel bone and pulling the toes back makes it worse."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 249.94,
      "end_seconds": 251.9,
      "duration_seconds": 1.96,
      "text": "Please sit back down."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 270.88,
      "end_seconds": 276.38,
      "duration_seconds": 5.5,
      "text": "Let me tell you where I've got to. I'd lean towards plantar fasciitis."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 278.18,
      "end_seconds": 279.98,
      "duration_seconds": 1.8,
      "text": "Will it clear up?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 281.43,
      "end_seconds": 295.35,
      "duration_seconds": 13.92,
      "text": "I understand the worry. At the moment I'd say it's plantar fasciitis, and we'll know more once the a foot X-ray is back. Let's get a foot X-ray, for heel pain."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 296.34,
      "end_seconds": 298.43,
      "duration_seconds": 2.09,
      "text": "Is that done today?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 304.14,
      "end_seconds": 320.29,
      "duration_seconds": 16.15,
      "text": "Let's use ibuprofen gel, three times a day, for two weeks. That should help with heel pain. Stretch the calf and the sole of the foot before getting out of bed and wear cushioned shoes. Come back in six weeks."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 321.45,
      "end_seconds": 325.26,
      "duration_seconds": 3.81,
      "text": "I'll book it on my way out."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 326.6,
      "end_seconds": 329.71,
      "duration_seconds": 3.11,
      "text": "Anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 333.36,
      "end_seconds": 335.18,
      "duration_seconds": 1.82,
      "text": "That's clear, thanks."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 336.77,
      "end_seconds": 338.07,
      "duration_seconds": 1.3,
      "text": "Take care now."
    }
  ]
}