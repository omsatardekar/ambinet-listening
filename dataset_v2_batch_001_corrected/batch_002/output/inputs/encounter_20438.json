{
  "schema_version": "1.0",
  "encounter_id": "20438",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.78,
      "end_seconds": 7.32,
      "duration_seconds": 6.54,
      "text": "Hello doctor, sorry, I took a wrong turn on the way here."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 9.1,
      "end_seconds": 14.09,
      "duration_seconds": 4.99,
      "text": "alright, come in please sit how can I help you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 15.89,
      "end_seconds": 22.75,
      "duration_seconds": 6.86,
      "text": "I'm, I'm here because of pain going down the back of my left leg."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 24.1,
      "end_seconds": 26.9,
      "duration_seconds": 2.8,
      "text": "is there any regular medication you use?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 27.64,
      "end_seconds": 30.25,
      "duration_seconds": 2.61,
      "text": "No, nothing at the moment."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 31.32,
      "end_seconds": 34.65,
      "duration_seconds": 3.33,
      "text": "okay, has this been going on for long?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 35.74,
      "end_seconds": 38.98,
      "duration_seconds": 3.24,
      "text": "it's been going on for two years"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 40.12,
      "end_seconds": 48.97,
      "duration_seconds": 8.85,
      "text": "tell me a bit more about it: how bad it gets, how often, and whether anything makes it better or worse"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 49.58,
      "end_seconds": 56.35,
      "duration_seconds": 6.77,
      "text": "Pretty mild, if I'm being honest. Yes, sitting and coughing. That makes it worse."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 57.29,
      "end_seconds": 61.51,
      "duration_seconds": 4.22,
      "text": "What about stiffness in the morning, have you noticed that?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 62.49,
      "end_seconds": 70.31,
      "duration_seconds": 7.82,
      "text": "Yes, about the same, about a month. As for stiffness in the morning, severe, really."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 72.37,
      "end_seconds": 76.88,
      "duration_seconds": 4.51,
      "text": "Have you noticed bladder problems, bowel problems or weight loss?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 77.72,
      "end_seconds": 82.74,
      "duration_seconds": 5.02,
      "text": "No, no bladder problems, bowel problems or weight loss."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 83.17,
      "end_seconds": 88.54,
      "duration_seconds": 5.37,
      "text": "Hm, okay. Right, on the cardiac side, anything I should know?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 89.18,
      "end_seconds": 91.79,
      "duration_seconds": 2.61,
      "text": "no, nothing with my heart"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 92.95,
      "end_seconds": 95.72,
      "duration_seconds": 2.77,
      "text": "What do you do during the day?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 97.55,
      "end_seconds": 100.86,
      "duration_seconds": 3.31,
      "text": "I look after my grandchildren most days."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 102.89,
      "end_seconds": 105.13,
      "duration_seconds": 2.24,
      "text": "is there someone at home?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 107.05,
      "end_seconds": 110.94,
      "duration_seconds": 3.89,
      "text": "My husband and I live above the shop."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 112.29,
      "end_seconds": 114.65,
      "duration_seconds": 2.36,
      "text": "Have you got any known allergies?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 118.99,
      "end_seconds": 122.49,
      "duration_seconds": 3.5,
      "text": "no, not that I know of"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 124.22,
      "end_seconds": 127.56,
      "duration_seconds": 3.34,
      "text": "Has anyone ever diagnosed you with something?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 128.12,
      "end_seconds": 131.61,
      "duration_seconds": 3.49,
      "text": "High blood pressure, for nearly five years."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 132.87,
      "end_seconds": 139.8,
      "duration_seconds": 6.93,
      "text": "okay, I can see high blood pressure in your file as well. Any previous surgeries?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 140.94,
      "end_seconds": 142.1,
      "duration_seconds": 1.16,
      "text": "no, never"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 152.73,
      "end_seconds": 156.96,
      "duration_seconds": 4.23,
      "text": "let me get the readings out of the way"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 170.12,
      "end_seconds": 172.57,
      "duration_seconds": 2.45,
      "text": "Okay, this won't take long..."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 192.07,
      "end_seconds": 202.94,
      "duration_seconds": 10.87,
      "text": "Okay: blood pressure 119 over 80, heart rate 79, SpO2 99 percent on room air. And temperature is 36.9 degrees, respiratory rate 16."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 204.39,
      "end_seconds": 209.13,
      "duration_seconds": 4.74,
      "text": "I'll need to examine you for this, it won't take long."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 210.0,
      "end_seconds": 212.66,
      "duration_seconds": 2.66,
      "text": "Take a deep breath for me."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 227.53,
      "end_seconds": 236.24,
      "duration_seconds": 8.71,
      "text": "Straight leg raising on the left brings on the leg pain at about forty degrees, and the power and reflexes are normal."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 241.09,
      "end_seconds": 242.88,
      "duration_seconds": 1.79,
      "text": "You can relax now."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 258.77,
      "end_seconds": 271.64,
      "duration_seconds": 12.87,
      "text": "let me tell you where I've got to it's hard to say. Sciatica from a lumbar disc irritation is one possibility and a muscle strain another, and I'd rather not commit yet"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 278.84,
      "end_seconds": 290.19,
      "duration_seconds": 11.35,
      "text": "I'd like to arrange blood tests for back pain. I'd rather check than guess, and and this is the quickest way to know more."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 290.7,
      "end_seconds": 293.08,
      "duration_seconds": 2.38,
      "text": "when would that take place?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 293.65,
      "end_seconds": 318.88,
      "duration_seconds": 25.23,
      "text": "I'm sending you for an MRI of the lower back because of sciatica. You'll be taking naproxen, 500 milligrams, twice a day with food, for one week. It's for back and leg pain. Stay active and keep walking, bed rest makes this slower to settle. I'm going to send a referral to physiotherapy."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 319.82,
      "end_seconds": 322.42,
      "duration_seconds": 2.6,
      "text": "Sure, where do I go?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 323.9,
      "end_seconds": 342.88,
      "duration_seconds": 18.98,
      "text": "If you get numbness between the legs or trouble passing urine, or you feel really unwell, please come to the emergency department. I'll want another look after the scan. That's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 343.47,
      "end_seconds": 346.9,
      "duration_seconds": 3.43,
      "text": "Right, I'll do that. Thank you, doctor."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 347.44,
      "end_seconds": 348.77,
      "duration_seconds": 1.33,
      "text": "take care now"
    }
  ]
}