{
  "schema_version": "1.0",
  "encounter_id": "20100",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.86,
      "end_seconds": 4.53,
      "duration_seconds": 3.67,
      "text": "Hello? Doctor? I was told to come in."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.05,
      "end_seconds": 9.9,
      "duration_seconds": 3.85,
      "text": "Come in. Please sit. How can I help you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 14.97,
      "end_seconds": 23.46,
      "duration_seconds": 8.49,
      "text": "Well, it's cramps in my calves at night. I thought I'd wait, but it hasn't gone."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 25.5,
      "end_seconds": 27.39,
      "duration_seconds": 1.89,
      "text": "When did this begin?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 28.58,
      "end_seconds": 32.16,
      "duration_seconds": 3.58,
      "text": "Right, for two months, I'd say."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 33.19,
      "end_seconds": 38.18,
      "duration_seconds": 4.99,
      "text": "Okay, give me more detail on it, whatever comes to mind."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 39.83,
      "end_seconds": 46.49,
      "duration_seconds": 6.66,
      "text": "It's once or twice a day. I notice it more with lying in bed."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 48.34,
      "end_seconds": 51.51,
      "duration_seconds": 3.17,
      "text": "Have you noticed anything else alongside it?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 53.51,
      "end_seconds": 67.71,
      "duration_seconds": 14.2,
      "text": "A dull ache after the cramp goes along with it, most of the time. So, and there's tingling in my feet as well, nearly five years now."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 68.87,
      "end_seconds": 71.48,
      "duration_seconds": 2.61,
      "text": "How often do you get it?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 72.7,
      "end_seconds": 74.98,
      "duration_seconds": 2.28,
      "text": "I'd say on and off."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 77.02,
      "end_seconds": 83.65,
      "duration_seconds": 6.63,
      "text": "A few quick ones: swelling of the legs, weakness in the legs or chest pain?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 84.65,
      "end_seconds": 92.57,
      "duration_seconds": 7.92,
      "text": "No swelling of the legs, weakness in the legs or chest pain, none of it."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 94.2,
      "end_seconds": 98.64,
      "duration_seconds": 4.44,
      "text": "A few quick ones: redness of the leg or back pain?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 99.98,
      "end_seconds": 102.88,
      "duration_seconds": 2.9,
      "text": "Hmm, nope, nothing like that."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 103.98,
      "end_seconds": 107.66,
      "duration_seconds": 3.68,
      "text": "How about your heart, any problems like that?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 109.4,
      "end_seconds": 113.75,
      "duration_seconds": 4.35,
      "text": "My heart's been fine, as far as I know."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 115.28,
      "end_seconds": 119.76,
      "duration_seconds": 4.48,
      "text": "Any change in your bowel habit or your stomach generally?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 120.53,
      "end_seconds": 122.16,
      "duration_seconds": 1.63,
      "text": "Nothing unusual, no."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 124.06,
      "end_seconds": 126.22,
      "duration_seconds": 2.16,
      "text": "Tell me your medicines, please."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 128.3,
      "end_seconds": 131.79,
      "duration_seconds": 3.49,
      "text": "I take magnesium tablets, at night."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 141.56,
      "end_seconds": 143.9,
      "duration_seconds": 2.34,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 145.92,
      "end_seconds": 148.76,
      "duration_seconds": 2.84,
      "text": "No, I've never been operated on."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 163.25,
      "end_seconds": 167.71,
      "duration_seconds": 4.46,
      "text": "Right, what about your parents, brothers or sisters, any conditions?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 169.02,
      "end_seconds": 172.63,
      "duration_seconds": 3.61,
      "text": "Um, my father has Parkinson's disease."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 173.65,
      "end_seconds": 175.56,
      "duration_seconds": 1.91,
      "text": "So, do you smoke?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 176.9,
      "end_seconds": 179.3,
      "duration_seconds": 2.4,
      "text": "I've never touched a cigarette."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 180.1,
      "end_seconds": 181.77,
      "duration_seconds": 1.67,
      "text": "Do you drink alcohol?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 182.83,
      "end_seconds": 184.34,
      "duration_seconds": 1.51,
      "text": "Nothing, I'm teetotal."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 185.39,
      "end_seconds": 187.68,
      "duration_seconds": 2.29,
      "text": "Do you get out much?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 189.35,
      "end_seconds": 193.22,
      "duration_seconds": 3.87,
      "text": "Not much, I mostly stay in these days."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 194.43,
      "end_seconds": 197.04,
      "duration_seconds": 2.61,
      "text": "Do you follow any particular diet?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 198.13,
      "end_seconds": 201.37,
      "duration_seconds": 3.24,
      "text": "I'm vegetarian and have been for years."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 202.58,
      "end_seconds": 205.52,
      "duration_seconds": 2.94,
      "text": "Are you in work at the moment?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 206.02,
      "end_seconds": 210.19,
      "duration_seconds": 4.17,
      "text": "Yes, I work in a bakery, early starts."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 212.27,
      "end_seconds": 216.29,
      "duration_seconds": 4.02,
      "text": "Do you have any medical conditions I should know about?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 219.79,
      "end_seconds": 223.12,
      "duration_seconds": 3.33,
      "text": "No, I've always been fairly healthy."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 227.56,
      "end_seconds": 231.5,
      "duration_seconds": 3.94,
      "text": "Can I check a few measurements before we carry on?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 242.67,
      "end_seconds": 244.75,
      "duration_seconds": 2.08,
      "text": "Nearly done with the readings..."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 253.95,
      "end_seconds": 257.95,
      "duration_seconds": 4.0,
      "text": "Okay: blood pressure 115 over 76, pulse 66."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 260.56,
      "end_seconds": 265.5,
      "duration_seconds": 4.94,
      "text": "I'll need to examine you for this, it won't take long."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 266.79,
      "end_seconds": 268.88,
      "duration_seconds": 2.09,
      "text": "Hold that for a second."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 277.93,
      "end_seconds": 283.93,
      "duration_seconds": 6.0,
      "text": "Both calves are soft and not tender, and the pulses at your feet are good."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 289.54,
      "end_seconds": 291.93,
      "duration_seconds": 2.39,
      "text": "Okay, that's enough for me."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 305.91,
      "end_seconds": 318.97,
      "duration_seconds": 13.06,
      "text": "Having listened and examined, this looks most like night-time muscle cramps without a worrying cause. The reason I say that is that your story and my examination fit together."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 319.81,
      "end_seconds": 321.73,
      "duration_seconds": 1.92,
      "text": "Will it clear up?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 322.43,
      "end_seconds": 337.78,
      "duration_seconds": 15.35,
      "text": "I understand the worry. At the moment I'd say it's night-time muscle cramps without a worrying cause, and we'll know more once the a vitamin level is back. Let's get a vitamin level, for tingling feet."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 339.11,
      "end_seconds": 343.95,
      "duration_seconds": 4.84,
      "text": "We have a slot Thursday at 10 am, if that works."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 345.8,
      "end_seconds": 350.84,
      "duration_seconds": 5.04,
      "text": "I'd like to arrange a blood sugar test for tingling feet."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 351.65,
      "end_seconds": 353.47,
      "duration_seconds": 1.82,
      "text": "Is that done today?"
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 355.13,
      "end_seconds": 375.31,
      "duration_seconds": 20.18,
      "text": "Keep well hydrated through the day. Gentle calf stretches against a wall before bed often help. Avoid taking any extra painkillers on top of what I'm prescribing without checking with us. Please don't wait if one leg becomes red, hot or swollen. That's when to be seen urgently."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 376.98,
      "end_seconds": 378.7,
      "duration_seconds": 1.72,
      "text": "Okay, makes sense."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 380.27,
      "end_seconds": 387.9,
      "duration_seconds": 7.63,
      "text": "We'll catch up after the results are back. Okay, I think we're done unless you have questions."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 389.84,
      "end_seconds": 392.69,
      "duration_seconds": 2.85,
      "text": "No, that's all. Thanks a lot."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 393.37,
      "end_seconds": 394.61,
      "duration_seconds": 1.24,
      "text": "Goodbye for now."
    }
  ]
}