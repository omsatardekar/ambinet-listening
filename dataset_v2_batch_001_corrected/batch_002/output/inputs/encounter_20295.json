{
  "schema_version": "1.0",
  "encounter_id": "20295",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.36,
      "end_seconds": 8.66,
      "duration_seconds": 7.3,
      "text": "Actually, doctor, hi, where would you like me to put my coat?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 10.03,
      "end_seconds": 14.49,
      "duration_seconds": 4.46,
      "text": "That's fine, sit down. Tell me why you came."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 16.56,
      "end_seconds": 31.47,
      "duration_seconds": 14.91,
      "text": "Let me think, doctor, I'll sit in if that's okay, I know what's been happening. Oh, doctor, it's extra hair on my chin. That's what we're worried about."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 33.11,
      "end_seconds": 37.17,
      "duration_seconds": 4.06,
      "text": "So, what do you take on a normal day?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 38.55,
      "end_seconds": 44.44,
      "duration_seconds": 5.89,
      "text": "I take escitalopram, 10 milligrams, once a day for the anxiety."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 45.64,
      "end_seconds": 50.81,
      "duration_seconds": 5.17,
      "text": "Did it come on recently? Just so I get the full picture."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 51.96,
      "end_seconds": 66.46,
      "duration_seconds": 14.5,
      "text": "I've had it for about a month. I've never really been one for hospitals. So, I had irregular periods before. That's settled now, though."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 71.57,
      "end_seconds": 73.22,
      "duration_seconds": 1.65,
      "text": "How about pelvic pain?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 74.76,
      "end_seconds": 78.54,
      "duration_seconds": 3.78,
      "text": "Actually, I haven't noticed any pelvic pain."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 79.01,
      "end_seconds": 85.39,
      "duration_seconds": 6.38,
      "text": "Mm-hmm. Alright, have you noticed being pregnant, headaches with vision changes or heavy bleeding?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 86.73,
      "end_seconds": 95.98,
      "duration_seconds": 9.25,
      "text": "Let me think, uh, no being pregnant, headaches with vision changes or heavy bleeding, none of it."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 97.68,
      "end_seconds": 102.3,
      "duration_seconds": 4.62,
      "text": "Have you noticed any weakness, or anything odd with your balance?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 107.27,
      "end_seconds": 110.31,
      "duration_seconds": 3.04,
      "text": "No, uh, that's all normal."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 111.94,
      "end_seconds": 114.4,
      "duration_seconds": 2.46,
      "text": "Your breathing, any trouble there?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 115.43,
      "end_seconds": 119.88,
      "duration_seconds": 4.45,
      "text": "I mean, no, my breathing's been fine."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 124.89,
      "end_seconds": 126.32,
      "duration_seconds": 1.43,
      "text": "What about alcohol?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 127.38,
      "end_seconds": 130.58,
      "duration_seconds": 3.2,
      "text": "I only drink at family occasions."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 131.44,
      "end_seconds": 132.67,
      "duration_seconds": 1.23,
      "text": "Do you smoke?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 133.9,
      "end_seconds": 138.65,
      "duration_seconds": 4.75,
      "text": "I smoke roughly a pack every two days."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 140.4,
      "end_seconds": 142.46,
      "duration_seconds": 2.06,
      "text": "Do you do any exercise?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 143.41,
      "end_seconds": 145.84,
      "duration_seconds": 2.43,
      "text": "I swim twice a week."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 147.31,
      "end_seconds": 150.69,
      "duration_seconds": 3.38,
      "text": "Are you on your own at home?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 152.31,
      "end_seconds": 155.67,
      "duration_seconds": 3.36,
      "text": "I live with my elderly mother."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 156.43,
      "end_seconds": 160.1,
      "duration_seconds": 3.67,
      "text": "What does a normal day of food look like?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 161.05,
      "end_seconds": 164.74,
      "duration_seconds": 3.69,
      "text": "Lots of rice, lentils and some fruit."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 179.72,
      "end_seconds": 182.85,
      "duration_seconds": 3.13,
      "text": "Has anyone ever diagnosed you with something?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 183.73,
      "end_seconds": 190.11,
      "duration_seconds": 6.38,
      "text": "Mm, yes, anxiety. I've been putting this off for weeks."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 191.64,
      "end_seconds": 192.93,
      "duration_seconds": 1.29,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 194.31,
      "end_seconds": 198.82,
      "duration_seconds": 4.51,
      "text": "Right, nothing, I haven't had any operations."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 206.36,
      "end_seconds": 211.3,
      "duration_seconds": 4.94,
      "text": "Any allergies to tablets, food or anything in the environment?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 213.07,
      "end_seconds": 218.05,
      "duration_seconds": 4.98,
      "text": "I'm allergic to plasters, I get a red itchy rash."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 228.58,
      "end_seconds": 231.57,
      "duration_seconds": 2.99,
      "text": "I'll just record a few vital signs."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 238.23,
      "end_seconds": 240.55,
      "duration_seconds": 2.32,
      "text": "Okay, this won't take long..."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 252.82,
      "end_seconds": 261.6,
      "duration_seconds": 8.78,
      "text": "Okay: pressure 121 over 72, heart rate 86. And temp 36.5 degrees, SpO2 99 percent on room air."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 262.87,
      "end_seconds": 264.5,
      "duration_seconds": 1.63,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 266.11,
      "end_seconds": 268.83,
      "duration_seconds": 2.72,
      "text": "I'll come back to the numbers."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 271.54,
      "end_seconds": 276.17,
      "duration_seconds": 4.63,
      "text": "I'd like to check you over now, if that's alright."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 276.73,
      "end_seconds": 277.43,
      "duration_seconds": 0.7,
      "text": "Right."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 279.16,
      "end_seconds": 280.61,
      "duration_seconds": 1.45,
      "text": "Nearly finished here."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 290.82,
      "end_seconds": 298.67,
      "duration_seconds": 7.85,
      "text": "There is some acne on the face and extra hair on the chin, and your blood pressure is fine."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 303.66,
      "end_seconds": 319.13,
      "duration_seconds": 15.47,
      "text": "That's the examination finished. I want a thyroid test done, that's for weight gain. A pelvic ultrasound is what I'd like next, for irregular periods. I want hormone blood tests done, that's for irregular periods."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 319.85,
      "end_seconds": 322.07,
      "duration_seconds": 2.22,
      "text": "That's fine with me."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 322.88,
      "end_seconds": 342.12,
      "duration_seconds": 19.24,
      "text": "The treatment will be metformin, 500 milligrams, once a day with food, for three months. That's for cycle regulation and weight. Regular exercise and a small weight loss can make cycles more regular. Do get help quickly if you get very heavy bleeding or severe pelvic pain."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 343.32,
      "end_seconds": 345.06,
      "duration_seconds": 1.74,
      "text": "I'll remember that."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 345.81,
      "end_seconds": 353.84,
      "duration_seconds": 8.03,
      "text": "I'd like you back after the scan. Is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 354.91,
      "end_seconds": 358.16,
      "duration_seconds": 3.25,
      "text": "Good, thanks, I'll see you then."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 360.13,
      "end_seconds": 361.38,
      "duration_seconds": 1.25,
      "text": "Look after yourself."
    }
  ]
}