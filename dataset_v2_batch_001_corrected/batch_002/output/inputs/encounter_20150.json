{
  "schema_version": "1.0",
  "encounter_id": "20150",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.8,
      "end_seconds": 3.91,
      "duration_seconds": 3.11,
      "text": "Hi doctor, am I too early?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 4.8,
      "end_seconds": 9.27,
      "duration_seconds": 4.47,
      "text": "No problem at all, come in. What's troubling you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 10.75,
      "end_seconds": 17.29,
      "duration_seconds": 6.54,
      "text": "Doctor, I've come along because I know the history, if it helps."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 18.54,
      "end_seconds": 24.55,
      "duration_seconds": 6.01,
      "text": "So the thing is, I've got an itchy rash all over."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 25.2,
      "end_seconds": 28.25,
      "duration_seconds": 3.05,
      "text": "Time for your numbers, if that's okay."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 38.84,
      "end_seconds": 42.14,
      "duration_seconds": 3.3,
      "text": "Right, keep your arm relaxed for me..."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 63.58,
      "end_seconds": 70.89,
      "duration_seconds": 7.31,
      "text": "Okay: pulse is 82 beats a minute, SpO2 98 percent on room air, BP is 127 over 72."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 71.4,
      "end_seconds": 72.86,
      "duration_seconds": 1.46,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 73.94,
      "end_seconds": 78.66,
      "duration_seconds": 4.72,
      "text": "We'll go over that shortly. Did it come on recently?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 79.43,
      "end_seconds": 82.91,
      "duration_seconds": 3.48,
      "text": "Yeah, about two weeks, give or take."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 84.28,
      "end_seconds": 87.93,
      "duration_seconds": 3.65,
      "text": "I think it's been nearer three weeks, actually."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 88.52,
      "end_seconds": 92.78,
      "duration_seconds": 4.26,
      "text": "Okay, so roughly two to three weeks. Is that right?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 93.32,
      "end_seconds": 95.45,
      "duration_seconds": 2.13,
      "text": "That sounds about right."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 98.75,
      "end_seconds": 107.15,
      "duration_seconds": 8.4,
      "text": "Okay, give me more detail on it, whatever comes to mind. I'll explain everything as we go along."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 108.78,
      "end_seconds": 115.82,
      "duration_seconds": 7.04,
      "text": "I'd give it a five, out of ten. It sort of comes and goes."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 117.25,
      "end_seconds": 120.58,
      "duration_seconds": 3.33,
      "text": "Have you been feeling a bit lightheaded?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 122.33,
      "end_seconds": 140.25,
      "duration_seconds": 17.92,
      "text": "Yes, for one week. With feeling a bit lightheaded, a three out of ten, I suppose. Oh, and swelling of my lips. As for swelling of my lips, maybe a four out of ten on a bad day."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 140.84,
      "end_seconds": 144.54,
      "duration_seconds": 3.7,
      "text": "Have you noticed vomiting, new food or trouble breathing?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 146.13,
      "end_seconds": 150.77,
      "duration_seconds": 4.64,
      "text": "No, no vomiting, new food or trouble breathing."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 151.64,
      "end_seconds": 154.71,
      "duration_seconds": 3.07,
      "text": "Any throat tightness, fainting or wheeze?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 155.69,
      "end_seconds": 160.66,
      "duration_seconds": 4.97,
      "text": "I haven't had throat tightness, fainting or wheeze, no."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 162.68,
      "end_seconds": 165.07,
      "duration_seconds": 2.39,
      "text": "Is your chest okay generally?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 165.81,
      "end_seconds": 168.0,
      "duration_seconds": 2.19,
      "text": "No problems with breathing."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 168.89,
      "end_seconds": 172.25,
      "duration_seconds": 3.36,
      "text": "Okay, any problems with your joints or muscles?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 174.03,
      "end_seconds": 175.99,
      "duration_seconds": 1.96,
      "text": "No, joints are fine."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 176.52,
      "end_seconds": 179.92,
      "duration_seconds": 3.4,
      "text": "Does your family have any medical conditions?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 181.24,
      "end_seconds": 186.8,
      "duration_seconds": 5.56,
      "text": "My father had bowel cancer. My mother had a stroke."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 187.52,
      "end_seconds": 190.99,
      "duration_seconds": 3.47,
      "text": "Which medicines do you take at the moment?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 192.83,
      "end_seconds": 199.09,
      "duration_seconds": 6.26,
      "text": "He is on Foracort inhaler, twice a day, I give it to him."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 200.01,
      "end_seconds": 202.79,
      "duration_seconds": 2.78,
      "text": "How long have you been on it?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 203.45,
      "end_seconds": 213.61,
      "duration_seconds": 10.16,
      "text": "For about a month. It's clopidogrel, 75 milligrams, once a day, doctor. He takes cetirizine, when it flares."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 215.36,
      "end_seconds": 217.88,
      "duration_seconds": 2.52,
      "text": "So, and what strength is that?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 222.72,
      "end_seconds": 227.47,
      "duration_seconds": 4.75,
      "text": "10 milligrams, I think that's what's on the box."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 228.36,
      "end_seconds": 230.09,
      "duration_seconds": 1.73,
      "text": "And for how long?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 231.78,
      "end_seconds": 233.78,
      "duration_seconds": 2.0,
      "text": "For nearly five years."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 235.68,
      "end_seconds": 238.57,
      "duration_seconds": 2.89,
      "text": "Did you ever have any procedures done?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 239.37,
      "end_seconds": 251.66,
      "duration_seconds": 12.29,
      "text": "Let me think, yes, I had a varicose vein procedure, last year. I've been reading about it online and it worried me."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 252.52,
      "end_seconds": 256.32,
      "duration_seconds": 3.8,
      "text": "Anything in your past medical history I should know?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 257.26,
      "end_seconds": 263.18,
      "duration_seconds": 5.92,
      "text": "I have asthma. I've had heart disease for nearly five years now."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 264.61,
      "end_seconds": 271.09,
      "duration_seconds": 6.48,
      "text": "Right, so heart disease is already on your record. We'll keep that in mind today."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 288.44,
      "end_seconds": 291.47,
      "duration_seconds": 3.03,
      "text": "A few questions about your lifestyle now."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 292.17,
      "end_seconds": 313.9,
      "duration_seconds": 21.73,
      "text": "I'll have a glass of wine with dinner. I have about eight cigarettes in a day. I'm a bus driver, so I sit for long hours. I do a yoga class on Thursdays. I live with my elderly mother."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 332.41,
      "end_seconds": 337.21,
      "duration_seconds": 4.8,
      "text": "Okay, are you allergic to anything? Any allergies to medicines or foods?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 342.66,
      "end_seconds": 345.63,
      "duration_seconds": 2.97,
      "text": "No, not that I know of."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 346.18,
      "end_seconds": 355.36,
      "duration_seconds": 9.18,
      "text": "Actually, I remember he had some kind of reaction to amoxicillin before. I couldn't swear to it."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 357.11,
      "end_seconds": 360.42,
      "duration_seconds": 3.31,
      "text": "Maybe, but I don't recall it."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 362.37,
      "end_seconds": 366.89,
      "duration_seconds": 4.52,
      "text": "Alright, so that's unclear. I'll record what each of you said."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 368.18,
      "end_seconds": 371.76,
      "duration_seconds": 3.58,
      "text": "Could you come over to the couch, please?"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 372.42,
      "end_seconds": 374.11,
      "duration_seconds": 1.69,
      "text": "Yes, that's fine."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 375.43,
      "end_seconds": 379.04,
      "duration_seconds": 3.61,
      "text": "Okay, stay as you are for a moment."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 391.0,
      "end_seconds": 402.5,
      "duration_seconds": 11.5,
      "text": "There are raised pink welts on the trunk and arms, the lips are a little puffy, and the tongue and throat look normal."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 408.26,
      "end_seconds": 410.07,
      "duration_seconds": 1.81,
      "text": "You can relax now."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 419.59,
      "end_seconds": 445.14,
      "duration_seconds": 25.55,
      "text": "We'll begin with chlorphenamine, 4 milligrams, every six hours, for three days. That should help with allergic rash. The treatment will be prednisolone, 30 milligrams, once a day, for three days. You take it by mouth. It's for allergic reaction. Stop the new tablet until we know what caused it and write down every medicine you took in the last week."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 445.45,
      "end_seconds": 460.85,
      "duration_seconds": 15.4,
      "text": "Ah. Make sure you're drinking plenty of fluids, two to three litres a day if you can, and get proper rest. See me again after the review. Anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 461.62,
      "end_seconds": 465.2,
      "duration_seconds": 3.58,
      "text": "Good, thanks, I'll see you then."
    }
  ]
}