{
  "schema_version": "1.0",
  "encounter_id": "20213",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.67,
      "end_seconds": 4.58,
      "duration_seconds": 3.91,
      "text": "Hello? Doctor? I was told to come in."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.71,
      "end_seconds": 9.51,
      "duration_seconds": 3.8,
      "text": "Come in. Please sit. How can I help you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 10.82,
      "end_seconds": 14.67,
      "duration_seconds": 3.85,
      "text": "I wanted to get watery diarrhoea looked at."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 17.49,
      "end_seconds": 20.53,
      "duration_seconds": 3.04,
      "text": "Has this been going on for long?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 23.8,
      "end_seconds": 27.24,
      "duration_seconds": 3.44,
      "text": "For about a week, I'd say."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 32.29,
      "end_seconds": 41.63,
      "duration_seconds": 9.34,
      "text": "Alright, can you describe it a bit more for me? How strong it is, what the pattern is, what helps."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 46.74,
      "end_seconds": 53.6,
      "duration_seconds": 6.86,
      "text": "Maybe a seven out of ten on a bad day. Eating definitely sets it off."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 54.54,
      "end_seconds": 56.1,
      "duration_seconds": 1.56,
      "text": "Have you had nausea?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 56.87,
      "end_seconds": 58.8,
      "duration_seconds": 1.93,
      "text": "Yes, for one week."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 60.11,
      "end_seconds": 62.53,
      "duration_seconds": 2.42,
      "text": "Have you been feeling dehydrated?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 64.26,
      "end_seconds": 75.98,
      "duration_seconds": 11.72,
      "text": "Yeah, um, I've had that since last Tuesday. As for feeling dehydrated, severe, really. It settles a little with drinking water."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 76.3,
      "end_seconds": 79.57,
      "duration_seconds": 3.27,
      "text": "Yes. Any black stools, confusion or dizziness?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 80.81,
      "end_seconds": 83.24,
      "duration_seconds": 2.43,
      "text": "No, not a single one."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 85.05,
      "end_seconds": 88.92,
      "duration_seconds": 3.87,
      "text": "Any vomiting blood or blood in the stool?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 91.9,
      "end_seconds": 94.26,
      "duration_seconds": 2.36,
      "text": "No, not a single one."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 95.05,
      "end_seconds": 98.88,
      "duration_seconds": 3.83,
      "text": "Anything with your nerves, like weakness or numbness?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 101.14,
      "end_seconds": 103.18,
      "duration_seconds": 2.04,
      "text": "No, nothing like that."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 112.27,
      "end_seconds": 116.05,
      "duration_seconds": 3.78,
      "text": "Right, do you take any prescribed or over-the-counter medicines?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 117.63,
      "end_seconds": 120.91,
      "duration_seconds": 3.28,
      "text": "I take valsartan, once a day."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 121.49,
      "end_seconds": 123.68,
      "duration_seconds": 2.19,
      "text": "How much do you take?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 124.77,
      "end_seconds": 132.57,
      "duration_seconds": 7.8,
      "text": "80 milligrams, I think that's what's on the box. ORS, after each loose stool."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 133.47,
      "end_seconds": 136.38,
      "duration_seconds": 2.91,
      "text": "Do you have any long-term conditions?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 137.01,
      "end_seconds": 142.14,
      "duration_seconds": 5.13,
      "text": "Erm, I have high blood pressure, for about a year."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 144.16,
      "end_seconds": 156.33,
      "duration_seconds": 12.17,
      "text": "I follow. Right, so high blood pressure is already on your record. We'll keep that in mind today. Let's talk a little about your daily life and habits."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 157.66,
      "end_seconds": 170.8,
      "duration_seconds": 13.14,
      "text": "I'll have a glass of wine with dinner. I've never touched a cigarette. I look after my grandchildren most days. My husband and I live above the shop."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 178.7,
      "end_seconds": 181.6,
      "duration_seconds": 2.9,
      "text": "Have you got any known allergies?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 183.09,
      "end_seconds": 186.06,
      "duration_seconds": 2.97,
      "text": "No, I've never reacted to anything."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 188.03,
      "end_seconds": 192.03,
      "duration_seconds": 4.0,
      "text": "Right, shall I check your blood pressure and pulse?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 198.86,
      "end_seconds": 201.54,
      "duration_seconds": 2.68,
      "text": "That's it, just a little longer..."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 222.92,
      "end_seconds": 231.19,
      "duration_seconds": 8.27,
      "text": "Okay: saturation 95 percent, temp 38.2 degrees, heart rate 106, blood pressure 121 over 70, respiratory rate 19."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 233.49,
      "end_seconds": 237.4,
      "duration_seconds": 3.91,
      "text": "Now I'm going to do a short physical check."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 238.56,
      "end_seconds": 239.99,
      "duration_seconds": 1.43,
      "text": "Fine by me."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 241.45,
      "end_seconds": 243.9,
      "duration_seconds": 2.45,
      "text": "Take a deep breath for me."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 262.3,
      "end_seconds": 270.02,
      "duration_seconds": 7.72,
      "text": "Your mouth is a bit dry and your tummy is soft with mild tenderness all over."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 272.06,
      "end_seconds": 286.25,
      "duration_seconds": 14.19,
      "text": "Okay, that's enough for me. Right, here's what I'm thinking. I can't pin this down yet. We're looking at infective gastroenteritis, likely after recent travel or food poisoning."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 291.4,
      "end_seconds": 293.44,
      "duration_seconds": 2.04,
      "text": "Is it dangerous, doctor?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 294.39,
      "end_seconds": 303.64,
      "duration_seconds": 9.25,
      "text": "Nothing I've seen today points to an emergency. It looks like infective gastroenteritis, likely after recent travel, but I'd like to confirm."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 312.68,
      "end_seconds": 346.62,
      "duration_seconds": 33.94,
      "text": "We should do a stool test for diarrhoea. Blood tests is what I'd like next, for dehydration. Small sips often are better than large drinks, and eat plain food as soon as you can. The thing that would worry me is if you see blood in the stool or cannot keep fluids down. If that happens, go to emergency. Book a review after the stool result. That's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 348.23,
      "end_seconds": 351.3,
      "duration_seconds": 3.07,
      "text": "No, that's all. Thanks a lot."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 352.93,
      "end_seconds": 354.23,
      "duration_seconds": 1.3,
      "text": "All the best."
    }
  ]
}