      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 293.6,
      "end_seconds": 305.11,
      "duration_seconds": 11.51,
      "text": "That's all I needed to check. Let me tell you where I've got to. I think we're dealing with plantar fasciitis at this stage."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 305.74,
      "end_seconds": 307.1,
      "duration_seconds": 1.36,
      "text": "Is this permanent?"
