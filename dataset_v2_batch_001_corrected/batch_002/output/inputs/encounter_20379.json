    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 288.31,
      "end_seconds": 289.82,
      "duration_seconds": 1.51,
      "text": "Yeah, no problem."
