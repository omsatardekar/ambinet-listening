  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 0.86,
      "end_seconds": 6.2,
      "duration_seconds": 5.34,
      "text": "Doctor, I've brought them through. The observations are done, whenever you need them."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 10.7,
      "end_seconds": 14.45,
      "duration_seconds": 3.75,
      "text": "Thanks that's helpful. Hello please sit. What's been happening?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 16.21,
      "end_seconds": 22.31,
      "duration_seconds": 6.1,
      "text": "um hello doctor I came in with them if that's okay"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 26.19,
      "end_seconds": 29.1,
      "duration_seconds": 2.91,
      "text": "please do. Extra information is always welcome"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 30.37,
      "end_seconds": 42.05,
      "duration_seconds": 11.68,
      "text": "it's a bloated tummy i thought I'd wait, but it hasn't gone my neighbour said I should get it looked at"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 43.0,
      "end_seconds": 45.76,
      "duration_seconds": 2.76,
      "text": "has this been going on for long?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 47.32,
      "end_seconds": 51.89,
      "duration_seconds": 4.57,
      "text": "So, uh, it's been four weeks now."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 52.75,
      "end_seconds": 55.6,
      "duration_seconds": 2.85,
      "text": "is it bearing on you a lot?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 56.78,
      "end_seconds": 61.51,
      "duration_seconds": 4.73,
      "text": "Erm, um, it feels severe to to me."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 62.09,
      "end_seconds": 65.29,
      "duration_seconds": 3.2,
      "text": "mm-hmm is there anything else with it?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 67.36,
      "end_seconds": 85.34,
      "duration_seconds": 17.98,
      "text": "Straining goes along with it, most of the time. The Straining? That's been for about a year. I did have not opening my bowels at one point, but that's gone now."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 87.41,
      "end_seconds": 93.64,
      "duration_seconds": 6.23,
      "text": "a few quick ones: severe abdominal pain passing wind blood in the stool or weight loss?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 95.3,
      "end_seconds": 98.69,
      "duration_seconds": 3.39,
      "text": "Nope you know nothing like that."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 100.76,
      "end_seconds": 103.4,
      "duration_seconds": 2.64,
      "text": "and your skin, any changes there?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 103.93,
      "end_seconds": 107.77,
      "duration_seconds": 3.84,
      "text": "let me think, no, skin's been fine"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 109.34,
      "end_seconds": 111.8,
      "duration_seconds": 2.46,
      "text": "any trouble with the waterworks?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 113.81,
      "end_seconds": 117.83,
      "duration_seconds": 4.02,
      "text": "that's normal as far as I know"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 132.91,
      "end_seconds": 135.29,
      "duration_seconds": 2.38,
      "text": "have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 138.75,
      "end_seconds": 143.36,
      "duration_seconds": 4.61,
      "text": "I mean nothing I haven't had any operations"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 144.83,
      "end_seconds": 148.52,
      "duration_seconds": 3.69,
      "text": "Is there anything relevant on the the family side?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 150.3,
      "end_seconds": 153.77,
      "duration_seconds": 3.47,
      "text": "uh, my father had bowel cancer"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 154.57,
      "end_seconds": 158.49,
      "duration_seconds": 3.92,
      "text": "Tell me about any past illnesses or ongoing conditions."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 160.26,
      "end_seconds": 175.76,
      "duration_seconds": 15.5,
      "text": "well, I've had arthritis in my knees for two years now i'd rather not end up on lots of tablets if I can avoid it yes, an underactive thyroid"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 176.87,
      "end_seconds": 178.11,
      "duration_seconds": 1.24,
      "text": "Any other things?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 179.19,
      "end_seconds": 185.35,
      "duration_seconds": 6.16,
      "text": "Okay, I can see arthritis in your knees in your file as well."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 194.74,
      "end_seconds": 197.71,
      "duration_seconds": 2.97,
      "text": "What do you do during the day?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 198.54,
      "end_seconds": 201.95,
      "duration_seconds": 3.41,
      "text": "I look after my grandchildren most days."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 203.79,
      "end_seconds": 206.39,
      "duration_seconds": 2.6,
      "text": "Anything you do to stay fit?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 208.15,
      "end_seconds": 212.12,
      "duration_seconds": 3.97,
      "text": "I do a yoga class on Thursdays"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 213.62,
      "end_seconds": 215.85,
      "duration_seconds": 2.23,
      "text": "do you live by yourself?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 217.52,
      "end_seconds": 221.98,
      "duration_seconds": 4.46,
      "text": "No, I share a house with my brother."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 229.66,
      "end_seconds": 234.39,
      "duration_seconds": 4.73,
      "text": "any allergies to tablets, food or anything in the environment?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 236.45,
      "end_seconds": 239.87,
      "duration_seconds": 3.42,
      "text": "no, not that I know of"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 241.82,
      "end_seconds": 248.56,
      "duration_seconds": 6.74,
      "text": "I'm not sure that's right i seem to recall a a problem with tramadol"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 250.18,
      "end_seconds": 254.47,
      "duration_seconds": 4.29,
      "text": "actually, maybe, but I don't recall it it"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 255.64,
      "end_seconds": 261.34,
      "duration_seconds": 5.7,
      "text": "okay, I'll note both of those what's on your current medicine list?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 263.26,
      "end_seconds": 271.86,
      "duration_seconds": 8.6,
      "text": "Well, it's diclofenac, 50 milligrams, when needed. Eltroxin. I take it 100 micrograms, every morning."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 273.09,
      "end_seconds": 278.5,
      "duration_seconds": 5.41,
      "text": "Doctor, our chart from the last visit lists it as 200 micrograms."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 280.19,
      "end_seconds": 283.37,
      "duration_seconds": 3.18,
      "text": "alright. Did you bring the up-to-date prescription?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 285.03,
      "end_seconds": 294.68,
      "duration_seconds": 9.65,
      "text": "Not with me. I'll bring it next time. Lactulose. I take it 15 ml, at night."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 296.12,
      "end_seconds": 305.43,
      "duration_seconds": 9.31,
      "text": "Here are the numbers, doctor. Respiratory rate 15, heart rate 67. BP is 114 over 80, oxygen saturation is 99 percent."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 307.3,
      "end_seconds": 308.28,
      "duration_seconds": 0.98,
      "text": "okay, noted"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 309.4,
      "end_seconds": 311.79,
      "duration_seconds": 2.39,
      "text": "let's move on to the examination"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 313.28,
      "end_seconds": 315.85,
      "duration_seconds": 2.57,
      "text": "okay I'm just checking this side"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 330.49,
      "end_seconds": 335.67,
      "duration_seconds": 5.18,
      "text": "There is firm stool in the left lower abdomen and no mass."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 341.09,
      "end_seconds": 366.12,
      "duration_seconds": 25.03,
      "text": "good, you can sit up again from what you've told me and what I found, it's hard to say. Constipation, possibly related to diet or medicines is one possibility and and an under-active thyroid another, and I'd rather not commit yet i want a blood count done, that's for constipation"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 366.71,
      "end_seconds": 371.57,
      "duration_seconds": 4.86,
      "text": "hmm, you know, when would that take place?"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 372.82,
      "end_seconds": 376.17,
      "duration_seconds": 3.35,
      "text": "I want blood tests done, that's for constipation."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 376.98,
      "end_seconds": 380.67,
      "duration_seconds": 3.69,
      "text": "so, when would that take place?"
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 382.17,
      "end_seconds": 403.13,
      "duration_seconds": 20.96,
      "text": "I'll start you on macrogol, 1 sachet, once a day, for two weeks. It's for constipation. More fibre, plenty of water and a regular time on the toilet after breakfast. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 403.97,
      "end_seconds": 408.82,
      "duration_seconds": 4.85,
      "text": "okay, so I know what to to watch for"
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 410.67,
      "end_seconds": 417.07,
      "duration_seconds": 6.4,
      "text": "do get help quickly if you are unable to pass wind or have severe tummy pain"
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 417.98,
      "end_seconds": 419.94,
      "duration_seconds": 1.96,
      "text": "I I'll remember that"
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 420.94,
      "end_seconds": 428.83,
      "duration_seconds": 7.89,
      "text": "See me again if it isn't working in a week. Anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 430.79,
      "end_seconds": 435.22,
      "duration_seconds": 4.43,
      "text": "great uh thank you for your help"
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 435.82,
      "end_seconds": 437.09,
      "duration_seconds": 1.27,
      "text": "all the best"
    }
  ]
