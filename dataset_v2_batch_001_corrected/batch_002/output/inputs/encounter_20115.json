{
  "schema_version": "1.0",
  "encounter_id": "20115",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.81,
      "end_seconds": 7.46,
      "duration_seconds": 6.65,
      "text": "Hello doctor, sorry, I took a wrong turn on the way here."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.2,
      "end_seconds": 12.74,
      "duration_seconds": 4.54,
      "text": "Yes, come in and sit down. What brings you here today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 14.57,
      "end_seconds": 18.48,
      "duration_seconds": 3.91,
      "text": "Well, I've been having drenching night sweats."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 19.0,
      "end_seconds": 22.49,
      "duration_seconds": 3.49,
      "text": "can you tell me when it first started?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 23.31,
      "end_seconds": 29.46,
      "duration_seconds": 6.15,
      "text": "About... well, one week. I took the morning off to come in today."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 31.54,
      "end_seconds": 34.04,
      "duration_seconds": 2.5,
      "text": "Is it constant or in episodes?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 34.65,
      "end_seconds": 36.48,
      "duration_seconds": 1.83,
      "text": "it comes and goes"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 41.06,
      "end_seconds": 43.98,
      "duration_seconds": 2.92,
      "text": "Have you tried anything for it?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 45.18,
      "end_seconds": 48.4,
      "duration_seconds": 3.22,
      "text": "Changing my clothes helps a bit"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 66.75,
      "end_seconds": 69.67,
      "duration_seconds": 2.92,
      "text": "Let me take your readings now."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 82.36,
      "end_seconds": 84.64,
      "duration_seconds": 2.28,
      "text": "Okay, this won't take long..."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 95.33,
      "end_seconds": 101.64,
      "duration_seconds": 6.31,
      "text": "Okay: blood pressure 123 over 80, pulse 106, oxygen saturation is 96 percent."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 102.2,
      "end_seconds": 104.58,
      "duration_seconds": 2.38,
      "text": "is that alright, doctor?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 105.97,
      "end_seconds": 108.44,
      "duration_seconds": 2.47,
      "text": "I'll interpret them after the examination."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 111.18,
      "end_seconds": 115.0,
      "duration_seconds": 3.82,
      "text": "I'll examine you in a second, make yourself comfortable."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 116.03,
      "end_seconds": 116.73,
      "duration_seconds": 0.7,
      "text": "Right."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 118.6,
      "end_seconds": 120.76,
      "duration_seconds": 2.16,
      "text": "I'm just checking this side."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 129.19,
      "end_seconds": 135.43,
      "duration_seconds": 6.24,
      "text": "There's a firm, rubbery gland about two centimetres in the left armpit, not tender."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 137.27,
      "end_seconds": 139.23,
      "duration_seconds": 1.96,
      "text": "Let me feel here."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 147.83,
      "end_seconds": 149.97,
      "duration_seconds": 2.14,
      "text": "I can't feel your spleen."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 152.32,
      "end_seconds": 159.0,
      "duration_seconds": 6.68,
      "text": "Okay, that's enough for me. Any joint pain, diarrhoea or weight loss at all?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 160.59,
      "end_seconds": 165.71,
      "duration_seconds": 5.12,
      "text": "well, you know, no, I haven't had any of them"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 167.03,
      "end_seconds": 169.63,
      "duration_seconds": 2.6,
      "text": "Is your urine normal, no changes?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 171.37,
      "end_seconds": 172.88,
      "duration_seconds": 1.51,
      "text": "No changes there."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 174.69,
      "end_seconds": 177.36,
      "duration_seconds": 2.67,
      "text": "Any breathing difficulties apart from this?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 178.67,
      "end_seconds": 181.59,
      "duration_seconds": 2.92,
      "text": "no, my breathing's been fine"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 191.61,
      "end_seconds": 193.98,
      "duration_seconds": 2.37,
      "text": "Have you had any surgical procedures?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 194.66,
      "end_seconds": 202.97,
      "duration_seconds": 8.31,
      "text": "Let me think, just a triple bypass, eight years ago. I'm hoping you can tell me something definite."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 204.27,
      "end_seconds": 208.17,
      "duration_seconds": 3.9,
      "text": "Let's talk a little about your daily life and habits."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 209.08,
      "end_seconds": 220.58,
      "duration_seconds": 11.5,
      "text": "I swim twice a week. No, I share a house with my brother. I'm a bus driver, so I sit for long hours."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 221.94,
      "end_seconds": 224.43,
      "duration_seconds": 2.49,
      "text": "what's on your current medicine list?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 225.68,
      "end_seconds": 234.66,
      "duration_seconds": 8.98,
      "text": "Mm, it's clopidogrel, 75 milligrams, once a day. I'm on Dolo, 650 milligrams, when I get the fever."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 235.01,
      "end_seconds": 238.2,
      "duration_seconds": 3.19,
      "text": "Yes. Do you have any long-term conditions?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 239.73,
      "end_seconds": 241.71,
      "duration_seconds": 1.98,
      "text": "I have heart disease."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 243.08,
      "end_seconds": 248.18,
      "duration_seconds": 5.1,
      "text": "are you allergic to anything? Any allergies to medicines or foods?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 249.08,
      "end_seconds": 253.74,
      "duration_seconds": 4.66,
      "text": "Okay, um, so yes, I'm allergic to diclofenac."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 270.56,
      "end_seconds": 281.8,
      "duration_seconds": 11.24,
      "text": "So, based on the history and the examination, it fits best with an enlarged gland with night sweats that needs a proper work-up."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 283.9,
      "end_seconds": 287.61,
      "duration_seconds": 3.71,
      "text": "Erm, do you think it's something serious?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 288.89,
      "end_seconds": 302.54,
      "duration_seconds": 13.65,
      "text": "I understand the worry. At the moment I'd say it's an enlarged gland with night sweats that needs a proper work-up, and we'll know more once the the a chest X-ray is back."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 320.07,
      "end_seconds": 351.55,
      "duration_seconds": 31.48,
      "text": "Let's book a chest X-ray to look into night sweats. Let's book blood tests to look into night sweats. That will help us see what's going on underneath and decide the next step. Keep a note of your temperature each evening. Try to get to bed and wake up at the same time each day, and keep your phone away from the bed. Is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 353.02,
      "end_seconds": 355.01,
      "duration_seconds": 1.99,
      "text": "Thank you, that's helpful."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 356.17,
      "end_seconds": 357.5,
      "duration_seconds": 1.33,
      "text": "Take care now."
    }
  ]
}