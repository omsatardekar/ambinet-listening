{
  "schema_version": "1.0",
  "encounter_id": "20259",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.35,
      "end_seconds": 5.71,
      "duration_seconds": 4.36,
      "text": "Hi, doctor, I hope I'm not disturbing you."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.75,
      "end_seconds": 11.12,
      "duration_seconds": 4.37,
      "text": "No problem at all, come in. What's troubling you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 12.12,
      "end_seconds": 18.68,
      "duration_seconds": 6.56,
      "text": "So the thing is, I've got pain after sitting for a while."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 20.35,
      "end_seconds": 24.56,
      "duration_seconds": 4.21,
      "text": "Alright, how many days or weeks has it been?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 26.5,
      "end_seconds": 31.24,
      "duration_seconds": 4.74,
      "text": "Around two weeks... no wait, it's more like three weeks."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 32.63,
      "end_seconds": 33.57,
      "duration_seconds": 0.94,
      "text": "Any fever?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 34.56,
      "end_seconds": 36.24,
      "duration_seconds": 1.68,
      "text": "No, no fever."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 38.07,
      "end_seconds": 43.02,
      "duration_seconds": 4.95,
      "text": "Have you noticed joint pain elsewhere, injury or back pain?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 44.89,
      "end_seconds": 46.95,
      "duration_seconds": 2.06,
      "text": "Nope, nothing like that."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 47.67,
      "end_seconds": 51.83,
      "duration_seconds": 4.16,
      "text": "Anything with your heart, like skipped beats or fainting?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 52.34,
      "end_seconds": 57.46,
      "duration_seconds": 5.12,
      "text": "So, my heart's been fine, as far as I know."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 76.12,
      "end_seconds": 79.05,
      "duration_seconds": 2.93,
      "text": "Do you take any regular medication?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 79.76,
      "end_seconds": 81.37,
      "duration_seconds": 1.61,
      "text": "nothing regular, no"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 95.52,
      "end_seconds": 96.72,
      "duration_seconds": 1.2,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 97.6,
      "end_seconds": 99.83,
      "duration_seconds": 2.23,
      "text": "no, not at all"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 115.87,
      "end_seconds": 117.69,
      "duration_seconds": 1.82,
      "text": "who lives with you?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 118.3,
      "end_seconds": 121.09,
      "duration_seconds": 2.79,
      "text": "My partner and our baby."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 122.25,
      "end_seconds": 124.02,
      "duration_seconds": 1.77,
      "text": "Have you retired yet?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 124.78,
      "end_seconds": 129.43,
      "duration_seconds": 4.65,
      "text": "I retired from the post office two years ago."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 130.67,
      "end_seconds": 133.38,
      "duration_seconds": 2.71,
      "text": "Anything you do to stay fit?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 133.91,
      "end_seconds": 137.1,
      "duration_seconds": 3.19,
      "text": "I do a yoga class on Thursdays"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 137.74,
      "end_seconds": 141.25,
      "duration_seconds": 3.51,
      "text": "Let me ask about allergies, anything at all?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 142.96,
      "end_seconds": 145.45,
      "duration_seconds": 2.49,
      "text": "I've never had an allergy."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 147.49,
      "end_seconds": 152.0,
      "duration_seconds": 4.51,
      "text": "Do you have any medical conditions I should know about?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 156.64,
      "end_seconds": 159.48,
      "duration_seconds": 2.84,
      "text": "No, nothing I can think of."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 161.18,
      "end_seconds": 163.84,
      "duration_seconds": 2.66,
      "text": "Let me quickly check your readings."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 172.2,
      "end_seconds": 174.24,
      "duration_seconds": 2.04,
      "text": "Nearly done with the readings..."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 193.18,
      "end_seconds": 199.61,
      "duration_seconds": 6.43,
      "text": "okay: pulse 79, temp 36.5 degrees, blood pressure 112 over 74, respiratory rate 15."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 202.05,
      "end_seconds": 205.87,
      "duration_seconds": 3.82,
      "text": "Could you come over to the couch, please?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 207.2,
      "end_seconds": 210.0,
      "duration_seconds": 2.8,
      "text": "right, raise your arm for me"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 227.36,
      "end_seconds": 235.51,
      "duration_seconds": 8.15,
      "text": "There is a sore spot at the inner front of the heel bone and pulling the toes back makes it worse."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 237.59,
      "end_seconds": 256.32,
      "duration_seconds": 18.73,
      "text": "Alright, you can relax now. So where does that leave us? My working impression is plantar fasciitis. So, to recap quickly. You've had pain after sitting for a while for three weeks, and no injury or back pain."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 257.82,
      "end_seconds": 259.51,
      "duration_seconds": 1.69,
      "text": "That's it, yes."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 269.33,
      "end_seconds": 273.53,
      "duration_seconds": 4.2,
      "text": "I'd like to arrange a foot X-ray for heel pain."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 277.01,
      "end_seconds": 279.73,
      "duration_seconds": 2.72,
      "text": "how long will it take?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 280.95,
      "end_seconds": 288.1,
      "duration_seconds": 7.15,
      "text": "The treatment will be ibuprofen gel, three times a day, for two weeks. It's for heel pain."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 289.49,
      "end_seconds": 292.57,
      "duration_seconds": 3.08,
      "text": "should I take that with food?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 293.19,
      "end_seconds": 305.82,
      "duration_seconds": 12.63,
      "text": "Stretch the calf and the sole of the foot before getting out of bed and wear cushioned shoes. Book a review in six weeks. Does all of that make sense?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 306.73,
      "end_seconds": 309.1,
      "duration_seconds": 2.37,
      "text": "Alright, thanks, take care."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 309.85,
      "end_seconds": 311.22,
      "duration_seconds": 1.37,
      "text": "Goodbye for now."
    }
  ]
}