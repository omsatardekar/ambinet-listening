{
  "schema_version": "1.0",
  "encounter_id": "20360",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.78,
      "end_seconds": 3.39,
      "duration_seconds": 2.61,
      "text": "Good afternoon, how are you today?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 5.18,
      "end_seconds": 7.5,
      "duration_seconds": 2.32,
      "text": "Have you been here before?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 8.84,
      "end_seconds": 14.32,
      "duration_seconds": 5.48,
      "text": "Erm, um, a couple of times, but not recently."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 16.28,
      "end_seconds": 19.6,
      "duration_seconds": 3.32,
      "text": "What would you like to start with today?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 20.52,
      "end_seconds": 29.26,
      "duration_seconds": 8.74,
      "text": "Oh, mainly I've been feeling dizzy when I stand up. That's why I came."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 31.3,
      "end_seconds": 40.9,
      "duration_seconds": 9.6,
      "text": "Here are the numbers, doctor. Pulse 102, oxygen saturation is 97 percent, respiratory rate 19, BP is 97 over 64, temperature is 37.0 degrees."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 46.35,
      "end_seconds": 47.7,
      "duration_seconds": 1.35,
      "text": "Good, thank you."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 57.32,
      "end_seconds": 60.16,
      "duration_seconds": 2.84,
      "text": "How long has it been like this?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 60.68,
      "end_seconds": 64.84,
      "duration_seconds": 4.16,
      "text": "Let me think, ever since... since Friday, really."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 66.02,
      "end_seconds": 69.27,
      "duration_seconds": 3.25,
      "text": "How troublesome is it day to day?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 74.62,
      "end_seconds": 75.84,
      "duration_seconds": 1.22,
      "text": "Mostly severe."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 77.87,
      "end_seconds": 79.72,
      "duration_seconds": 1.85,
      "text": "What brings it on?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 81.69,
      "end_seconds": 88.52,
      "duration_seconds": 6.83,
      "text": "So, um, yes, standing up quickly. That makes it worse."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 89.39,
      "end_seconds": 92.78,
      "duration_seconds": 3.39,
      "text": "Right, how often do you get it?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 93.9,
      "end_seconds": 97.71,
      "duration_seconds": 3.81,
      "text": "Mm, it sort of comes and goes."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 98.37,
      "end_seconds": 105.84,
      "duration_seconds": 7.47,
      "text": "I, I was just going to say that the main thing is—"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 105.94,
      "end_seconds": 112.84,
      "duration_seconds": 6.9,
      "text": "Sorry to cut in, doctor, quick question: shall I bring the trolley in now or later?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 113.75,
      "end_seconds": 116.06,
      "duration_seconds": 2.31,
      "text": "Later, thanks. Please go on."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 116.81,
      "end_seconds": 122.76,
      "duration_seconds": 5.95,
      "text": "I've also had nearly blacking out, for about two weeks."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 123.46,
      "end_seconds": 126.49,
      "duration_seconds": 3.03,
      "text": "How troublesome is it day to day?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 128.17,
      "end_seconds": 129.47,
      "duration_seconds": 1.3,
      "text": "Mild, really."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_4",
      "role": "UNKNOWN",
      "start_seconds": 130.7,
      "end_seconds": 134.65,
      "duration_seconds": 3.95,
      "text": "Yes, that's right, that's how it was."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 136.5,
      "end_seconds": 141.64,
      "duration_seconds": 5.14,
      "text": "Right, have you had any chest pain, fainting or vomiting?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 143.54,
      "end_seconds": 158.66,
      "duration_seconds": 15.12,
      "text": "Uh, you know, no, no chest pain, no fainting, no vomiting. I was feeling weak at one point, but that went away on its own."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 160.49,
      "end_seconds": 164.55,
      "duration_seconds": 4.06,
      "text": "Did you get palpitations, slurred speech or black stools?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 166.52,
      "end_seconds": 170.52,
      "duration_seconds": 4.0,
      "text": "No, uh, none of those at all."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 172.49,
      "end_seconds": 175.04,
      "duration_seconds": 2.55,
      "text": "Your breathing, any trouble there?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 175.88,
      "end_seconds": 180.26,
      "duration_seconds": 4.38,
      "text": "Okay, so no, my breathing's been fine."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 185.1,
      "end_seconds": 186.38,
      "duration_seconds": 1.28,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 186.89,
      "end_seconds": 189.57,
      "duration_seconds": 2.68,
      "text": "No surgery, um, no."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 190.61,
      "end_seconds": 192.75,
      "duration_seconds": 2.14,
      "text": "Tell me your medicines, please."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 193.61,
      "end_seconds": 205.33,
      "duration_seconds": 11.72,
      "text": "Right, I take Seretide inhaler, twice a day. I looked a few things up online, and that probably didn't help."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 215.9,
      "end_seconds": 220.3,
      "duration_seconds": 4.4,
      "text": "Anything in your past medical history I should know?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 221.62,
      "end_seconds": 225.99,
      "duration_seconds": 4.37,
      "text": "High blood pressure, for about ten years."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 231.13,
      "end_seconds": 231.83,
      "duration_seconds": 0.7,
      "text": "Sure."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 232.95,
      "end_seconds": 243.16,
      "duration_seconds": 10.21,
      "text": "So, I have asthma, for two years. Work has been very busy so I kept ignoring it."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 244.67,
      "end_seconds": 247.17,
      "duration_seconds": 2.5,
      "text": "Right, and anything else to add?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 248.02,
      "end_seconds": 254.88,
      "duration_seconds": 6.86,
      "text": "Yes, asthma is known to us, good to have that clear. Do you smoke?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 255.85,
      "end_seconds": 260.02,
      "duration_seconds": 4.17,
      "text": "I smoke roughly a pack every two days."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 261.67,
      "end_seconds": 263.23,
      "duration_seconds": 1.56,
      "text": "How are your meals?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 264.48,
      "end_seconds": 268.37,
      "duration_seconds": 3.89,
      "text": "I grab fast food at lunch most days."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 269.58,
      "end_seconds": 273.92,
      "duration_seconds": 4.34,
      "text": "What about your parents, brothers or sisters, any conditions?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 274.8,
      "end_seconds": 276.82,
      "duration_seconds": 2.02,
      "text": "My cousin has psoriasis."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 279.4,
      "end_seconds": 283.3,
      "duration_seconds": 3.9,
      "text": "Right, let's have a proper look at you."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 284.17,
      "end_seconds": 285.53,
      "duration_seconds": 1.36,
      "text": "Breathe out slowly."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 292.71,
      "end_seconds": 297.91,
      "duration_seconds": 5.2,
      "text": "Your blood pressure drops when you stand, from the lying reading to standing."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 299.6,
      "end_seconds": 300.73,
      "duration_seconds": 1.13,
      "text": "Okay, doctor."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 302.3,
      "end_seconds": 303.72,
      "duration_seconds": 1.42,
      "text": "Breathe out slowly."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 315.14,
      "end_seconds": 319.39,
      "duration_seconds": 4.25,
      "text": "Heart sounds are normal and the chest is clear."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 324.44,
      "end_seconds": 339.81,
      "duration_seconds": 15.37,
      "text": "Right, thank you, you can get dressed. Let me tell you where I've got to. This looks most like postural low blood pressure, possibly related to medicines or dehydration. We shouldn't forget dehydration."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 341.15,
      "end_seconds": 346.47,
      "duration_seconds": 5.32,
      "text": "Yeah, um, do you think it's something serious?"
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 347.39,
      "end_seconds": 360.07,
      "duration_seconds": 12.68,
      "text": "I can't promise yet, but most people with postural low blood pressure, possibly related to medicines or dehydration do well once it's treated properly. We should do blood tests for dizziness."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_5",
      "role": "CLINICAL_STAFF",
      "start_seconds": 362.01,
      "end_seconds": 366.47,
      "duration_seconds": 4.46,
      "text": "We have a slot Thursday at 10 am, if that works."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 368.33,
      "end_seconds": 403.37,
      "duration_seconds": 35.04,
      "text": "I want a lying and standing blood pressure check done, that's for dizziness. That will help us see what's going on underneath and decide the next step. Get up slowly from lying and sitting, and keep drinking fluids through the day. If you faint or have chest pain, that's the point to come in urgently. See me again after the results are back. Can you run through the plan with me quickly, just to be certain?"
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 405.31,
      "end_seconds": 412.35,
      "duration_seconds": 7.04,
      "text": "So, um, I come back after the results are back. Is that right?"
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 416.43,
      "end_seconds": 422.7,
      "duration_seconds": 6.27,
      "text": "Yes, exactly right. So, is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 423.92,
      "end_seconds": 428.31,
      "duration_seconds": 4.39,
      "text": "Right, I'll do that. Thank you, doctor."
    }
  ]
}