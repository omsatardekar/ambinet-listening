{
  "schema_version": "1.0",
  "encounter_id": "20142",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.16,
      "end_seconds": 5.34,
      "duration_seconds": 4.18,
      "text": "Doctor? Hello, I hope this is the right time."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.7,
      "end_seconds": 11.12,
      "duration_seconds": 4.42,
      "text": "Of course, leave it there. How can I help?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 12.52,
      "end_seconds": 19.71,
      "duration_seconds": 7.19,
      "text": "Yeah, uh, it's a stiff neck. I don't know what's causing it."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 20.95,
      "end_seconds": 23.22,
      "duration_seconds": 2.27,
      "text": "Did it come on recently?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 28.49,
      "end_seconds": 31.02,
      "duration_seconds": 2.53,
      "text": "It's been six months now."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 31.97,
      "end_seconds": 35.5,
      "duration_seconds": 3.53,
      "text": "Is it a lot or only a little?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 36.63,
      "end_seconds": 38.12,
      "duration_seconds": 1.49,
      "text": "It's mild, honestly."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 39.01,
      "end_seconds": 40.91,
      "duration_seconds": 1.9,
      "text": "Who lives with you?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 42.33,
      "end_seconds": 44.88,
      "duration_seconds": 2.55,
      "text": "My partner and our baby."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 45.63,
      "end_seconds": 47.45,
      "duration_seconds": 1.82,
      "text": "How are your meals?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 48.0,
      "end_seconds": 51.99,
      "duration_seconds": 3.99,
      "text": "I grab fast food at lunch most days."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 56.29,
      "end_seconds": 57.73,
      "duration_seconds": 1.44,
      "text": "And your job?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 59.46,
      "end_seconds": 63.02,
      "duration_seconds": 3.56,
      "text": "I work in accounts at a hospital."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 64.13,
      "end_seconds": 68.35,
      "duration_seconds": 4.22,
      "text": "Do you react to any medicines or foods? Any allergies?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 69.21,
      "end_seconds": 71.99,
      "duration_seconds": 2.78,
      "text": "I've never had an allergy."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 73.42,
      "end_seconds": 74.79,
      "duration_seconds": 1.37,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 76.7,
      "end_seconds": 80.1,
      "duration_seconds": 3.4,
      "text": "No, I've never been operated on."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 82.04,
      "end_seconds": 87.02,
      "duration_seconds": 4.98,
      "text": "Can you list what you take, tablets, creams or inhalers?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 89.0,
      "end_seconds": 92.96,
      "duration_seconds": 3.96,
      "text": "I take paracetamol, 500 milligrams, most days."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 100.19,
      "end_seconds": 104.11,
      "duration_seconds": 3.92,
      "text": "Any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 105.97,
      "end_seconds": 107.79,
      "duration_seconds": 1.82,
      "text": "No, no conditions."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 120.26,
      "end_seconds": 124.29,
      "duration_seconds": 4.03,
      "text": "And what about vomiting, weakness or head injury?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 125.91,
      "end_seconds": 129.41,
      "duration_seconds": 3.5,
      "text": "Ah, no, I'd have said so."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 130.17,
      "end_seconds": 133.01,
      "duration_seconds": 2.84,
      "text": "Is your urine normal, no changes?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 133.94,
      "end_seconds": 135.6,
      "duration_seconds": 1.66,
      "text": "Nothing there, no."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 136.52,
      "end_seconds": 140.31,
      "duration_seconds": 3.79,
      "text": "Let me get the readings out of the way."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 148.09,
      "end_seconds": 150.45,
      "duration_seconds": 2.36,
      "text": "Bear with me while this finishes..."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 167.34,
      "end_seconds": 178.33,
      "duration_seconds": 10.99,
      "text": "Okay: temperature 36.5, heart rate 71, SpO2 99 percent on room air. And respiratory rate 18, blood pressure 119 over 74."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 179.61,
      "end_seconds": 184.09,
      "duration_seconds": 4.48,
      "text": "I'll need to examine you for this, it won't take long."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 185.88,
      "end_seconds": 187.95,
      "duration_seconds": 2.07,
      "text": "I'm just checking this side."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 204.95,
      "end_seconds": 210.94,
      "duration_seconds": 5.99,
      "text": "Neck muscles are tight and tender, and the eye and limb checks are normal."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 212.66,
      "end_seconds": 213.56,
      "duration_seconds": 0.9,
      "text": "That's alright."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 217.59,
      "end_seconds": 219.7,
      "duration_seconds": 2.11,
      "text": "You can sit up now."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 231.64,
      "end_seconds": 237.71,
      "duration_seconds": 6.07,
      "text": "Right, here's what I'm thinking. It points towards tension-type headaches with possible medication overuse."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 238.87,
      "end_seconds": 241.56,
      "duration_seconds": 2.69,
      "text": "Do you think it's something serious?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 243.55,
      "end_seconds": 254.39,
      "duration_seconds": 10.84,
      "text": "I understand the worry. At the moment I'd say it's tension-type headaches with possible medication overuse, and we'll know more once the blood tests is back."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 272.12,
      "end_seconds": 299.97,
      "duration_seconds": 27.85,
      "text": "We should do blood tests for headache. I think a headache diary makes sense here, for frequent headaches. Try to limit painkillers to two days a week and keep a diary of the headaches. Short breaks from the screen every hour and some neck stretches. If you get a sudden severe headache or weakness, or you feel really unwell, please come to the emergency department."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 300.56,
      "end_seconds": 303.52,
      "duration_seconds": 2.96,
      "text": "I know what to watch for."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 304.2,
      "end_seconds": 310.24,
      "duration_seconds": 6.04,
      "text": "I'd like you back in four weeks. Have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 310.89,
      "end_seconds": 312.59,
      "duration_seconds": 1.7,
      "text": "That's clear, thanks."
    }
  ]
}