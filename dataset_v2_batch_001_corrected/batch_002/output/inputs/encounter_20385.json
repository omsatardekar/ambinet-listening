{
  "schema_version": "1.0",
  "encounter_id": "20385",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.25,
      "end_seconds": 4.37,
      "duration_seconds": 3.12,
      "text": "Sorry I'm a little late, doctor."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.73,
      "end_seconds": 10.22,
      "duration_seconds": 4.49,
      "text": "Yes, have a seat. Tell me what's going on."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 12.28,
      "end_seconds": 19.22,
      "duration_seconds": 6.94,
      "text": "I've been feeling shaky and sweaty, and I wanted to get it checked."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 19.96,
      "end_seconds": 23.28,
      "duration_seconds": 3.32,
      "text": "How many days or weeks has it been?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 24.23,
      "end_seconds": 26.6,
      "duration_seconds": 2.37,
      "text": "For ten days, I'd say."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 26.88,
      "end_seconds": 38.98,
      "duration_seconds": 12.1,
      "text": "Yes. Tell me a bit more about it: how bad it gets, how often, and whether anything makes it better or worse. Take your time, there's no rush."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 40.0,
      "end_seconds": 43.73,
      "duration_seconds": 3.73,
      "text": "It happens all the time. It's severe, honestly."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 44.45,
      "end_seconds": 47.32,
      "duration_seconds": 2.87,
      "text": "I'll just record a few vital signs."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 60.44,
      "end_seconds": 63.04,
      "duration_seconds": 2.6,
      "text": "Keep your arm relaxed for me..."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 76.56,
      "end_seconds": 89.06,
      "duration_seconds": 12.5,
      "text": "Okay: weight 58 kilos, temperature is 36.7 degrees. And oxygen saturation is 98 percent, height 170 centimetres, heart rate 82, blood pressure 121 over 74."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 91.69,
      "end_seconds": 94.64,
      "duration_seconds": 2.95,
      "text": "Let's move on to the examination."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 96.41,
      "end_seconds": 98.44,
      "duration_seconds": 2.03,
      "text": "Tell me if that's sore."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 111.54,
      "end_seconds": 116.66,
      "duration_seconds": 5.12,
      "text": "Your fingerprick sugar now is normal and your heart rate is steady."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 119.3,
      "end_seconds": 121.5,
      "duration_seconds": 2.2,
      "text": "You can sit up now."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 137.64,
      "end_seconds": 140.29,
      "duration_seconds": 2.65,
      "text": "Any fainting, slurred speech or seizure?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 141.95,
      "end_seconds": 146.93,
      "duration_seconds": 4.98,
      "text": "I haven't had fainting, slurred speech or seizure, no."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 153.3,
      "end_seconds": 156.0,
      "duration_seconds": 2.7,
      "text": "Any breathing difficulties apart from this?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 157.48,
      "end_seconds": 158.57,
      "duration_seconds": 1.09,
      "text": "Breathing's normal."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 159.46,
      "end_seconds": 162.74,
      "duration_seconds": 3.28,
      "text": "How about your heart, any problems like that?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 163.88,
      "end_seconds": 166.78,
      "duration_seconds": 2.9,
      "text": "No, nothing with my heart."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 168.69,
      "end_seconds": 173.11,
      "duration_seconds": 4.42,
      "text": "Has anything ever caused you a reaction? I mean any allergies."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 177.53,
      "end_seconds": 181.3,
      "duration_seconds": 3.77,
      "text": "Yes, cat fur, it gives me wheezing."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 181.97,
      "end_seconds": 185.31,
      "duration_seconds": 3.34,
      "text": "Are you in work at the moment?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 185.88,
      "end_seconds": 190.19,
      "duration_seconds": 4.31,
      "text": "Yes, I work in a bakery, early starts."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 195.64,
      "end_seconds": 198.37,
      "duration_seconds": 2.73,
      "text": "Anything you do to stay fit?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 200.31,
      "end_seconds": 204.02,
      "duration_seconds": 3.71,
      "text": "I do a yoga class on Thursdays."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 205.74,
      "end_seconds": 208.42,
      "duration_seconds": 2.68,
      "text": "Do you have any chronic illnesses?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 213.75,
      "end_seconds": 215.42,
      "duration_seconds": 1.67,
      "text": "I've got diabetes."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 216.2,
      "end_seconds": 220.85,
      "duration_seconds": 4.65,
      "text": "Okay, I can see diabetes in your file as well."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 228.05,
      "end_seconds": 230.47,
      "duration_seconds": 2.42,
      "text": "Let's run through your medicines."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 231.29,
      "end_seconds": 235.03,
      "duration_seconds": 3.74,
      "text": "It's Glycomet, 500 milligrams, twice a day."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 239.95,
      "end_seconds": 253.25,
      "duration_seconds": 13.3,
      "text": "Okay, thinking it through, this looks most like episodes of low blood sugar related to diabetes treatment. That's my thinking for now, and it may change as we learn more."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 253.86,
      "end_seconds": 256.65,
      "duration_seconds": 2.79,
      "text": "Mm, will it clear up?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 258.44,
      "end_seconds": 267.72,
      "duration_seconds": 9.28,
      "text": "I can't promise yet, but most people with episodes of low blood sugar related to diabetes treatment do well once it's treated properly."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 276.23,
      "end_seconds": 311.41,
      "duration_seconds": 35.18,
      "text": "I'll request an HbA1c, it'll help with diabetes control. I think blood tests makes sense here, for low sugar. Never skip meals when you take the sugar tablet, and keep glucose tablets or juice with you. Make sure you're drinking plenty of fluids, two to three litres a day if you can, and get proper rest. A home sugar diary is something we might do if this doesn't improve in two weeks."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 312.35,
      "end_seconds": 329.81,
      "duration_seconds": 17.46,
      "text": "The thing that would worry me is if you have an episode that does not settle with sugar. If that happens, go to emergency. Please come and see me after the blood tests. That's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 330.39,
      "end_seconds": 334.5,
      "duration_seconds": 4.11,
      "text": "Right, I'll do that. Thank you, doctor."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 338.55,
      "end_seconds": 339.79,
      "duration_seconds": 1.24,
      "text": "All the best."
    }
  ]
}