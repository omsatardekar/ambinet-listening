{
  "schema_version": "1.0",
  "encounter_id": "20303",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 1.35,
      "end_seconds": 6.37,
      "duration_seconds": 5.02,
      "text": "doctor, if you're free, we can start i've got the numbers noted down"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 11.4,
      "end_seconds": 14.5,
      "duration_seconds": 3.1,
      "text": "thank you. Right, hello, what's the problem?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 15.98,
      "end_seconds": 24.39,
      "duration_seconds": 8.41,
      "text": "Mainly pain in my right shoulder. There's a couple of other things but that's the main one."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 25.84,
      "end_seconds": 37.83,
      "duration_seconds": 11.99,
      "text": "Doctor, I've got the readings for you. Respiratory rate 16, blood pressure 127 over 79, pulse is 70 beats a minute, oxygen saturation is 97 percent."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 38.86,
      "end_seconds": 41.26,
      "duration_seconds": 2.4,
      "text": "thanks when did this begin?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 45.72,
      "end_seconds": 49.2,
      "duration_seconds": 3.48,
      "text": "I mean, for three weeks, I'd say."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 49.83,
      "end_seconds": 58.87,
      "duration_seconds": 9.04,
      "text": "can you describe it a bit more for me? How strong it is, what the pattern is, what helps"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 62.2,
      "end_seconds": 75.81,
      "duration_seconds": 13.61,
      "text": "it's worse with lifting my arm and reaching overhead i'd say moderate i had a clicking in the shoulder before that's settled now, though"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 77.04,
      "end_seconds": 80.47,
      "duration_seconds": 3.43,
      "text": "A few quick ones: numbness or swelling?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 82.21,
      "end_seconds": 84.95,
      "duration_seconds": 2.74,
      "text": "no, nothing to report there"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 85.21,
      "end_seconds": 92.65,
      "duration_seconds": 7.44,
      "text": "I see, go ahead. Let me check a few things. Any fever, fall or injury or chest pain?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 93.7,
      "end_seconds": 96.41,
      "duration_seconds": 2.71,
      "text": "No, none that I've noticed."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 98.22,
      "end_seconds": 100.46,
      "duration_seconds": 2.24,
      "text": "has your skin been okay?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 101.28,
      "end_seconds": 102.18,
      "duration_seconds": 0.9,
      "text": "Skin's normal."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 118.79,
      "end_seconds": 122.62,
      "duration_seconds": 3.83,
      "text": "Is there anything relevant on the family side?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 123.54,
      "end_seconds": 125.88,
      "duration_seconds": 2.34,
      "text": "My father has Parkinson's disease."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 127.31,
      "end_seconds": 129.31,
      "duration_seconds": 2.0,
      "text": "and alcohol, how much?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 130.71,
      "end_seconds": 135.12,
      "duration_seconds": 4.41,
      "text": "I'll have a glass of wine with dinner."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 138.44,
      "end_seconds": 139.35,
      "duration_seconds": 0.91,
      "text": "any smoking?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 141.24,
      "end_seconds": 144.99,
      "duration_seconds": 3.75,
      "text": "I have about eight cigarettes in a day."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 146.98,
      "end_seconds": 148.8,
      "duration_seconds": 1.82,
      "text": "Who lives with you?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 150.89,
      "end_seconds": 153.62,
      "duration_seconds": 2.73,
      "text": "My partner and our baby"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 154.46,
      "end_seconds": 155.63,
      "duration_seconds": 1.17,
      "text": "Are you active?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 157.33,
      "end_seconds": 160.29,
      "duration_seconds": 2.96,
      "text": "I walk the dog every morning"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 161.02,
      "end_seconds": 163.76,
      "duration_seconds": 2.74,
      "text": "Do you work outside the the home?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 164.99,
      "end_seconds": 169.4,
      "duration_seconds": 4.41,
      "text": "I'm a hairdresser, on my feet all day."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 178.75,
      "end_seconds": 181.09,
      "duration_seconds": 2.34,
      "text": "let's run through your medicines"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 183.08,
      "end_seconds": 185.76,
      "duration_seconds": 2.68,
      "text": "I take losartan once a day"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 187.06,
      "end_seconds": 189.09,
      "duration_seconds": 2.03,
      "text": "Do you know the dose?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 190.45,
      "end_seconds": 207.83,
      "duration_seconds": 17.38,
      "text": "it's 50 milligrams. Alendronate i take it it 70 milligrams, once a week for my bones well, I take Eltroxin, 100 micrograms, every morning for my thyroid it's, It's diclofenac gel, twice a day"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 213.22,
      "end_seconds": 217.72,
      "duration_seconds": 4.5,
      "text": "okay what conditions have you been treated for in the past?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 223.52,
      "end_seconds": 233.26,
      "duration_seconds": 9.74,
      "text": "I have high blood pressure, for about a year i've had thin bones for nearly five years now"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 234.08,
      "end_seconds": 235.56,
      "duration_seconds": 1.48,
      "text": "any other things?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 237.3,
      "end_seconds": 240.06,
      "duration_seconds": 2.76,
      "text": "I have an underactive thyroid"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 241.81,
      "end_seconds": 254.53,
      "duration_seconds": 12.72,
      "text": "okay, go on. Right, so an underactive thyroid is already on your record. We'll keep that in mind today. Did you ever have any procedures done?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 256.37,
      "end_seconds": 262.01,
      "duration_seconds": 5.64,
      "text": "yes I had part of my thyroid removed years back"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 262.75,
      "end_seconds": 265.6,
      "duration_seconds": 2.85,
      "text": "Before we go further, any allergies?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 266.92,
      "end_seconds": 270.43,
      "duration_seconds": 3.51,
      "text": "Yes, cat fur. I get sneezing."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 278.68,
      "end_seconds": 306.66,
      "duration_seconds": 27.98,
      "text": "we should do a shoulder X-ray for shoulder pain. I'd rather check than guess, and this is the quickest way to know more. Keep the shoulder moving gently within comfort and avoid heavy overhead lifting. Keep an eye out, and if the arm becomes numb or you get fever, call us the same day or go to emergency"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 307.68,
      "end_seconds": 309.25,
      "duration_seconds": 1.57,
      "text": "Alright I follow."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 314.43,
      "end_seconds": 320.79,
      "duration_seconds": 6.36,
      "text": "I'll want another look after the scan. Anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 322.86,
      "end_seconds": 324.47,
      "duration_seconds": 1.61,
      "text": "that's clear, thanks"
    }
  ]
}