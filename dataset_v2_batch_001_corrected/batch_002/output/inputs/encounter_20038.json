{
  "schema_version": "1.0",
  "encounter_id": "20038",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.98,
      "end_seconds": 4.24,
      "duration_seconds": 3.26,
      "text": "sorry I'm a little late, doctor"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.6,
      "end_seconds": 9.51,
      "duration_seconds": 3.91,
      "text": "That's fine, sit down. Tell me why you came."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 10.69,
      "end_seconds": 19.27,
      "duration_seconds": 8.58,
      "text": "Honestly, it's pain going to my right shoulder, and my family pushed me to come."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 21.21,
      "end_seconds": 24.26,
      "duration_seconds": 3.05,
      "text": "I'll note down your vital signs first"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 30.72,
      "end_seconds": 33.16,
      "duration_seconds": 2.44,
      "text": "keep your arm relaxed for me.."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 43.0,
      "end_seconds": 58.04,
      "duration_seconds": 15.04,
      "text": "okay: oxygen saturation is 97 percent, pressure 116 over 75, weight 98 kilos, temp 36.5 degrees, height 157 centimetres, pulse 85, BMI works out to 39.8. Did it come on recently?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 59.23,
      "end_seconds": 62.93,
      "duration_seconds": 3.7,
      "text": "Erm, I've had it for two weeks."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 64.65,
      "end_seconds": 69.7,
      "duration_seconds": 5.05,
      "text": "Okay, give me more detail on it, whatever comes to mind."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 71.18,
      "end_seconds": 77.06,
      "duration_seconds": 5.88,
      "text": "I'd call it severe. It's a couple of times a week."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 79.15,
      "end_seconds": 81.5,
      "duration_seconds": 2.35,
      "text": "Is there anything else with it?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 82.41,
      "end_seconds": 90.46,
      "duration_seconds": 8.05,
      "text": "Sharp pain in the upper right of my tummy goes along with it, most of the time."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 92.02,
      "end_seconds": 99.24,
      "duration_seconds": 7.22,
      "text": "Okay, give me more detail on it, whatever comes to mind. Take your time, there's no rush."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 100.44,
      "end_seconds": 104.78,
      "duration_seconds": 4.34,
      "text": "Mostly severe. Honestly, a couple of times a week."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 119.52,
      "end_seconds": 122.79,
      "duration_seconds": 3.27,
      "text": "Any black stools, weight loss or dark urine?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 123.86,
      "end_seconds": 126.25,
      "duration_seconds": 2.39,
      "text": "no, none that I've noticed"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 128.24,
      "end_seconds": 130.48,
      "duration_seconds": 2.24,
      "text": "Anything unusual with passing urine?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 131.49,
      "end_seconds": 133.08,
      "duration_seconds": 1.59,
      "text": "No changes there."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 134.76,
      "end_seconds": 138.1,
      "duration_seconds": 3.34,
      "text": "anything on the skin I should know about?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 139.1,
      "end_seconds": 140.01,
      "duration_seconds": 0.91,
      "text": "No rashes."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 148.86,
      "end_seconds": 153.09,
      "duration_seconds": 4.23,
      "text": "do you have any medical conditions I should know about?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 158.09,
      "end_seconds": 161.31,
      "duration_seconds": 3.22,
      "text": "no, nothing I can think of"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 178.07,
      "end_seconds": 179.94,
      "duration_seconds": 1.87,
      "text": "and alcohol, how much?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 180.82,
      "end_seconds": 185.35,
      "duration_seconds": 4.53,
      "text": "I'll have a glass of wine with dinner"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 186.84,
      "end_seconds": 188.72,
      "duration_seconds": 1.88,
      "text": "Right, are you active?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 189.87,
      "end_seconds": 192.99,
      "duration_seconds": 3.12,
      "text": "I walk the dog every morning."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 193.75,
      "end_seconds": 195.92,
      "duration_seconds": 2.17,
      "text": "Right, how are your meals?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 199.11,
      "end_seconds": 203.43,
      "duration_seconds": 4.32,
      "text": "I grab fast food at lunch most days."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 205.22,
      "end_seconds": 207.72,
      "duration_seconds": 2.5,
      "text": "Any regular medication, tablets or creams?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 212.94,
      "end_seconds": 214.46,
      "duration_seconds": 1.52,
      "text": "Nothing regular, no."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 218.21,
      "end_seconds": 221.5,
      "duration_seconds": 3.29,
      "text": "Let me ask about allergies, anything at all?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 223.52,
      "end_seconds": 225.71,
      "duration_seconds": 2.19,
      "text": "No allergies at all."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 228.41,
      "end_seconds": 230.67,
      "duration_seconds": 2.26,
      "text": "shall I start the examination?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 238.17,
      "end_seconds": 239.08,
      "duration_seconds": 0.91,
      "text": "That's alright."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 240.49,
      "end_seconds": 242.79,
      "duration_seconds": 2.3,
      "text": "hold that for a second"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 255.14,
      "end_seconds": 262.6,
      "duration_seconds": 7.46,
      "text": "There is tenderness under the right ribs when you breathe in, and no yellowing of the eyes."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 267.33,
      "end_seconds": 275.84,
      "duration_seconds": 8.51,
      "text": "Thank you, you can get dressed. So where does that leave us? My working impression is biliary colic from gallstones."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 276.67,
      "end_seconds": 279.53,
      "duration_seconds": 2.86,
      "text": "what are the odds it's serious?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 280.67,
      "end_seconds": 309.9,
      "duration_seconds": 29.23,
      "text": "I can't promise yet, but most people with biliary colic from gallstones do well once it's treated properly. Let's book liver blood tests to look into upper abdominal pain. I'd rather check than guess, and this is the quickest way to know more. We'll begin with diclofenac, 50 milligrams, three times a day if needed, for three days. You take it by mouth. That's for gallbladder pain"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 310.93,
      "end_seconds": 322.14,
      "duration_seconds": 11.21,
      "text": "keep meals small and low in fat until we have the scan. Let's review you after the ultrasound. Anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 323.83,
      "end_seconds": 326.08,
      "duration_seconds": 2.25,
      "text": "Thank you, doctor, goodbye."
    }
  ]
}