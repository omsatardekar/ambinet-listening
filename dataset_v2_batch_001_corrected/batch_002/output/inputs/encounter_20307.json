{
  "schema_version": "1.0",
  "encounter_id": "20307",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.55,
      "end_seconds": 5.68,
      "duration_seconds": 5.13,
      "text": "Hi, you know, is it okay to come in now?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.5,
      "end_seconds": 12.44,
      "duration_seconds": 4.94,
      "text": "You're alright, take a seat. What can I do for you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 14.46,
      "end_seconds": 20.19,
      "duration_seconds": 5.73,
      "text": "So, So the thing is, I've got an itchy rash all over."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 22.03,
      "end_seconds": 26.38,
      "duration_seconds": 4.35,
      "text": "Can I check a few measurements before we carry on?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 38.04,
      "end_seconds": 40.69,
      "duration_seconds": 2.65,
      "text": "Keep your arm relaxed for me..."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 59.53,
      "end_seconds": 66.05,
      "duration_seconds": 6.52,
      "text": "Okay: temp 36.8 degrees, pulse 68, pressure 121 over 68, saturation 97 percent."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 75.24,
      "end_seconds": 78.03,
      "duration_seconds": 2.79,
      "text": "How long has it been like this?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 79.85,
      "end_seconds": 83.59,
      "duration_seconds": 3.74,
      "text": "It's been going on for ten days."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 84.75,
      "end_seconds": 89.33,
      "duration_seconds": 4.58,
      "text": "Okay, give me more detail on it, whatever comes to mind."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 90.24,
      "end_seconds": 101.5,
      "duration_seconds": 11.26,
      "text": "I'd call it mild. An antihistamine helps a bit. I've, I've also been feeling a bit lightheaded, for ten days."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 117.61,
      "end_seconds": 119.03,
      "duration_seconds": 1.42,
      "text": "How about wheeze?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 120.14,
      "end_seconds": 122.63,
      "duration_seconds": 2.49,
      "text": "Nope, you know, no wheeze."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 124.7,
      "end_seconds": 127.99,
      "duration_seconds": 3.29,
      "text": "Did you get new food, vomiting or fainting?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 128.88,
      "end_seconds": 131.83,
      "duration_seconds": 2.95,
      "text": "Nope, um, nothing like that."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 133.12,
      "end_seconds": 136.03,
      "duration_seconds": 2.91,
      "text": "Any problems with your joints or muscles?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 136.6,
      "end_seconds": 141.79,
      "duration_seconds": 5.19,
      "text": "Sorry, what was I saying, no, joints are fine."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 142.36,
      "end_seconds": 149.64,
      "duration_seconds": 7.28,
      "text": "Alright, before we go further, any allergies? I'm asking so that we don't miss anything."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 150.75,
      "end_seconds": 155.3,
      "duration_seconds": 4.55,
      "text": "Yes, grass pollen, it gives me itchy eyes."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 164.55,
      "end_seconds": 169.47,
      "duration_seconds": 4.92,
      "text": "Do you have any medical conditions I should know about?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 170.36,
      "end_seconds": 174.85,
      "duration_seconds": 4.49,
      "text": "No, uh, I've always been fairly healthy."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 176.15,
      "end_seconds": 180.7,
      "duration_seconds": 4.55,
      "text": "Right, do you take any prescribed or over-the-counter medicines?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 186.52,
      "end_seconds": 190.99,
      "duration_seconds": 4.47,
      "text": "I'm on cetirizine, 10 milligrams, when it flares."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 195.85,
      "end_seconds": 198.86,
      "duration_seconds": 3.01,
      "text": "Okay, do you live by yourself?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 199.5,
      "end_seconds": 203.75,
      "duration_seconds": 4.25,
      "text": "No, I share a house with my brother."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 205.6,
      "end_seconds": 207.46,
      "duration_seconds": 1.86,
      "text": "How active are you?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 209.02,
      "end_seconds": 212.26,
      "duration_seconds": 3.24,
      "text": "I hardly move around during the day."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 213.51,
      "end_seconds": 215.54,
      "duration_seconds": 2.03,
      "text": "May I examine you now?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 216.07,
      "end_seconds": 217.14,
      "duration_seconds": 1.07,
      "text": "Sure thing."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 218.3,
      "end_seconds": 220.68,
      "duration_seconds": 2.38,
      "text": "I'll listen to your chest now."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 238.15,
      "end_seconds": 247.34,
      "duration_seconds": 9.19,
      "text": "There are raised pink welts on the trunk and arms, the lips are a little puffy, and the tongue and throat look normal."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 250.55,
      "end_seconds": 252.88,
      "duration_seconds": 2.33,
      "text": "You can sit up now."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 269.8,
      "end_seconds": 295.57,
      "duration_seconds": 25.77,
      "text": "I'll start you on chlorphenamine, 4 milligrams, every six hours, for three days. It's for allergic rash. Stop the new tablet until we know what caused it and write down every medicine you took in the last week. I'll want another look after the review. What are the next steps as you understand them?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 296.28,
      "end_seconds": 307.16,
      "duration_seconds": 10.88,
      "text": "So, I take the chlorphenamine, 4 milligrams, every six hours and come back after the review. Is that right?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 307.7,
      "end_seconds": 313.84,
      "duration_seconds": 6.14,
      "text": "Yes, exactly right. Right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 315.4,
      "end_seconds": 319.54,
      "duration_seconds": 4.14,
      "text": "Erm, you know, thank you, that's helpful."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 320.28,
      "end_seconds": 321.63,
      "duration_seconds": 1.35,
      "text": "Look after yourself."
    }
  ]
}