{
  "schema_version": "1.0",
  "encounter_id": "20154",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.52,
      "end_seconds": 3.65,
      "duration_seconds": 3.13,
      "text": "Sorry, doctor, shall I sit here?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 4.84,
      "end_seconds": 9.54,
      "duration_seconds": 4.7,
      "text": "Okay, come in. Please sit. How can I help you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 13.32,
      "end_seconds": 20.76,
      "duration_seconds": 7.44,
      "text": "Oh, doctor, it's bright red blood on the paper. It's getting on my nerves now."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 22.49,
      "end_seconds": 24.78,
      "duration_seconds": 2.29,
      "text": "Okay, when did this begin?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 26.51,
      "end_seconds": 40.36,
      "duration_seconds": 13.85,
      "text": "It's been one week, I'm fairly sure. I'd rather not end up on lots of tablets if I can avoid it. I did try to ignore it for a while."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 44.82,
      "end_seconds": 47.42,
      "duration_seconds": 2.6,
      "text": "Is it worse at certain times?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 49.27,
      "end_seconds": 51.56,
      "duration_seconds": 2.29,
      "text": "Straining definitely sets it off."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 54.9,
      "end_seconds": 58.7,
      "duration_seconds": 3.8,
      "text": "Any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 60.3,
      "end_seconds": 63.43,
      "duration_seconds": 3.13,
      "text": "No, nothing I can think of."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 75.53,
      "end_seconds": 76.85,
      "duration_seconds": 1.32,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 78.69,
      "end_seconds": 80.35,
      "duration_seconds": 1.66,
      "text": "No surgery, no."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 81.21,
      "end_seconds": 82.79,
      "duration_seconds": 1.58,
      "text": "How are your meals?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 83.68,
      "end_seconds": 87.45,
      "duration_seconds": 3.77,
      "text": "I grab fast food at lunch most days."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 88.81,
      "end_seconds": 91.09,
      "duration_seconds": 2.28,
      "text": "Do you live by yourself?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 92.08,
      "end_seconds": 95.84,
      "duration_seconds": 3.76,
      "text": "No, I share a house with my brother."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 96.65,
      "end_seconds": 98.0,
      "duration_seconds": 1.35,
      "text": "Are you active?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 98.65,
      "end_seconds": 101.43,
      "duration_seconds": 2.78,
      "text": "I walk the dog every morning."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 117.73,
      "end_seconds": 121.16,
      "duration_seconds": 3.43,
      "text": "Do you take any prescribed or over-the-counter medicines?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 121.96,
      "end_seconds": 126.81,
      "duration_seconds": 4.85,
      "text": "Okay, so I take a soothing cream, when needed."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 134.94,
      "end_seconds": 137.81,
      "duration_seconds": 2.87,
      "text": "Have you got any known allergies?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 138.53,
      "end_seconds": 141.02,
      "duration_seconds": 2.49,
      "text": "I've never had an allergy."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 142.12,
      "end_seconds": 143.38,
      "duration_seconds": 1.26,
      "text": "Nothing like dizziness?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 144.14,
      "end_seconds": 145.63,
      "duration_seconds": 1.49,
      "text": "Definitely no dizziness."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 147.37,
      "end_seconds": 150.64,
      "duration_seconds": 3.27,
      "text": "Any weight loss, black stools or severe pain?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 151.29,
      "end_seconds": 154.08,
      "duration_seconds": 2.79,
      "text": "No, nothing to report there."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 155.07,
      "end_seconds": 159.07,
      "duration_seconds": 4.0,
      "text": "On the cardiac side, anything I should know?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 160.61,
      "end_seconds": 161.97,
      "duration_seconds": 1.36,
      "text": "Nothing like that."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 165.65,
      "end_seconds": 167.85,
      "duration_seconds": 2.2,
      "text": "I'll do your observations first."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 175.86,
      "end_seconds": 178.43,
      "duration_seconds": 2.57,
      "text": "Alright, nearly done with the readings..."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 191.08,
      "end_seconds": 197.74,
      "duration_seconds": 6.66,
      "text": "Okay: temperature is 36.9 degrees, heart rate 85, pressure 113 over 82, respiratory rate 16."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 199.31,
      "end_seconds": 200.69,
      "duration_seconds": 1.38,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 201.34,
      "end_seconds": 204.24,
      "duration_seconds": 2.9,
      "text": "We'll look at it together shortly."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 205.73,
      "end_seconds": 208.09,
      "duration_seconds": 2.36,
      "text": "Let's move on to the examination."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 209.99,
      "end_seconds": 211.62,
      "duration_seconds": 1.63,
      "text": "Let me feel here."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 228.22,
      "end_seconds": 235.72,
      "duration_seconds": 7.5,
      "text": "There is a small soft lump at the edge of the anus and no tear that I can see."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 241.13,
      "end_seconds": 255.59,
      "duration_seconds": 14.46,
      "text": "Good, you can sit up again. Okay, thinking it through, the most likely explanation is haemorrhoids. The reason I say that is that your story and my examination fit together."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 256.98,
      "end_seconds": 258.79,
      "duration_seconds": 1.81,
      "text": "Will it clear up?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 264.5,
      "end_seconds": 275.81,
      "duration_seconds": 11.31,
      "text": "I understand the worry. At the moment I'd say it's haemorrhoids, and we'll know more once the a camera test of the bowel is back."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 294.38,
      "end_seconds": 299.74,
      "duration_seconds": 5.36,
      "text": "I'll request a camera test of the bowel, it'll help with rectal bleeding."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 300.58,
      "end_seconds": 305.02,
      "duration_seconds": 4.44,
      "text": "We have a slot Wednesday at 11:30 am, if that works."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 305.53,
      "end_seconds": 308.24,
      "duration_seconds": 2.71,
      "text": "Wednesday, that works for me."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 309.8,
      "end_seconds": 321.61,
      "duration_seconds": 11.81,
      "text": "Fibre, plenty of water, and don't sit on the toilet for long. I'd like you to see the colorectal clinic as well, and I'll write the referral."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 322.44,
      "end_seconds": 326.1,
      "duration_seconds": 3.66,
      "text": "Sure, um, where do I go?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 326.86,
      "end_seconds": 332.93,
      "duration_seconds": 6.07,
      "text": "Come back after the camera test. What are the next steps as you understand them?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 334.43,
      "end_seconds": 339.99,
      "duration_seconds": 5.56,
      "text": "So, I come back after the camera test. Is that right?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 341.75,
      "end_seconds": 345.42,
      "duration_seconds": 3.67,
      "text": "Yes, exactly right. Have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 351.31,
      "end_seconds": 356.7,
      "duration_seconds": 5.39,
      "text": "Ah, uh, okay, that makes sense. Thanks for explaining."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 357.74,
      "end_seconds": 359.04,
      "duration_seconds": 1.3,
      "text": "All the best."
    }
  ]
}