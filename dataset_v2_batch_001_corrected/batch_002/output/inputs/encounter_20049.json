{
  "schema_version": "1.0",
  "encounter_id": "20049",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.09,
      "end_seconds": 6.43,
      "duration_seconds": 5.34,
      "text": "Right, thanks for waiting, come in. Tell me what's brought you in."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 7.71,
      "end_seconds": 13.58,
      "duration_seconds": 5.87,
      "text": "Mainly I've been repeating the same question. That's why I came."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 15.45,
      "end_seconds": 18.22,
      "duration_seconds": 2.77,
      "text": "Has this been going on for long?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 20.25,
      "end_seconds": 29.29,
      "duration_seconds": 9.04,
      "text": "It's been four weeks, I'm fairly sure. I've been getting lost on familiar roads too, for two years."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 31.14,
      "end_seconds": 34.86,
      "duration_seconds": 3.72,
      "text": "A few quick ones: hallucinations or bladder problems?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 36.84,
      "end_seconds": 40.12,
      "duration_seconds": 3.28,
      "text": "No, no hallucinations or bladder problems."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 41.17,
      "end_seconds": 45.54,
      "duration_seconds": 4.37,
      "text": "Did you get weakness on one side or falls?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 47.1,
      "end_seconds": 50.47,
      "duration_seconds": 3.37,
      "text": "No, none of those at all."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 51.93,
      "end_seconds": 54.12,
      "duration_seconds": 2.19,
      "text": "Anything unusual with passing urine?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 56.08,
      "end_seconds": 59.42,
      "duration_seconds": 3.34,
      "text": "That's normal as far as I know."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 63.3,
      "end_seconds": 66.49,
      "duration_seconds": 3.19,
      "text": "Okay, your breathing, any trouble there?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 68.03,
      "end_seconds": 70.11,
      "duration_seconds": 2.08,
      "text": "No problems with breathing."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 88.11,
      "end_seconds": 93.19,
      "duration_seconds": 5.08,
      "text": "Has anything ever caused you a reaction? I mean any allergies."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 94.05,
      "end_seconds": 96.51,
      "duration_seconds": 2.46,
      "text": "Not to my knowledge, no."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 113.09,
      "end_seconds": 116.43,
      "duration_seconds": 3.34,
      "text": "What do you take on a normal day?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 118.1,
      "end_seconds": 121.45,
      "duration_seconds": 3.35,
      "text": "I'm on losartan, once a day."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 121.99,
      "end_seconds": 124.19,
      "duration_seconds": 2.2,
      "text": "How much do you take?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 124.96,
      "end_seconds": 129.64,
      "duration_seconds": 4.68,
      "text": "50 milligrams, I think that's what's on the box."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 131.51,
      "end_seconds": 134.92,
      "duration_seconds": 3.41,
      "text": "A few questions about your lifestyle now."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 136.18,
      "end_seconds": 148.54,
      "duration_seconds": 12.36,
      "text": "No, I share a house with my brother. I'm vegetarian and have been for years. I'm a plumber, lots of bending and kneeling."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 153.59,
      "end_seconds": 157.45,
      "duration_seconds": 3.86,
      "text": "Tell me about any past illnesses or ongoing conditions."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 158.43,
      "end_seconds": 160.55,
      "duration_seconds": 2.12,
      "text": "Yes, high blood pressure."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 162.4,
      "end_seconds": 166.68,
      "duration_seconds": 4.28,
      "text": "Yes, carry on. Let me take your readings now."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 179.62,
      "end_seconds": 181.79,
      "duration_seconds": 2.17,
      "text": "Okay, this won't take long..."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 202.07,
      "end_seconds": 209.1,
      "duration_seconds": 7.03,
      "text": "Okay: pulse 64, respiratory rate 15. And temp 36.5 degrees, pressure 117 over 81."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 209.63,
      "end_seconds": 210.98,
      "duration_seconds": 1.35,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 212.72,
      "end_seconds": 215.08,
      "duration_seconds": 2.36,
      "text": "I'll come back to the numbers."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 216.79,
      "end_seconds": 220.31,
      "duration_seconds": 3.52,
      "text": "Could you come over to the couch, please?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 221.92,
      "end_seconds": 222.84,
      "duration_seconds": 0.92,
      "text": "Sure thing."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 223.76,
      "end_seconds": 225.86,
      "duration_seconds": 2.1,
      "text": "Hold that for a second."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 239.54,
      "end_seconds": 247.97,
      "duration_seconds": 8.43,
      "text": "The memory test score is a little low today and the rest of the neurological check is normal."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 250.34,
      "end_seconds": 252.89,
      "duration_seconds": 2.55,
      "text": "Good, you can sit up again."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 263.63,
      "end_seconds": 271.05,
      "duration_seconds": 7.42,
      "text": "Putting it all together, this is probably a gradual memory problem that needs further assessment."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 281.61,
      "end_seconds": 308.02,
      "duration_seconds": 26.41,
      "text": "I'm going to order a brain scan, for memory loss. Keep a daily routine and write things down, a notebook by the door works well. One warning sign to remember: you become suddenly confused. In that case don't wait. We'll catch up after the results. Anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 310.07,
      "end_seconds": 313.46,
      "duration_seconds": 3.39,
      "text": "No, that's all. Thanks a lot."
    }
  ]
}