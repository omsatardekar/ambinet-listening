{
  "schema_version": "1.0",
  "encounter_id": "20120",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.12,
      "end_seconds": 5.38,
      "duration_seconds": 4.26,
      "text": "Actually, sorry, doctor, shall I sit here?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 9.99,
      "end_seconds": 14.07,
      "duration_seconds": 4.08,
      "text": "Of course, leave it there. How can I help?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 14.71,
      "end_seconds": 19.02,
      "duration_seconds": 4.31,
      "text": "Thank you for fitting us in, uh, doctor."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 19.93,
      "end_seconds": 23.74,
      "duration_seconds": 3.81,
      "text": "That's fine, sit down. We'll go through it together."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 25.53,
      "end_seconds": 32.94,
      "duration_seconds": 7.41,
      "text": "It's pain in my right ear, doctor. She didn't want to come, but I insisted."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 34.79,
      "end_seconds": 38.02,
      "duration_seconds": 3.23,
      "text": "Has this been going on for long?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 39.86,
      "end_seconds": 41.94,
      "duration_seconds": 2.08,
      "text": "Probably five days. Yeah."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 43.84,
      "end_seconds": 52.41,
      "duration_seconds": 8.57,
      "text": "Can you describe it a bit more for me? How strong it is, what the pattern is, what helps."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 53.3,
      "end_seconds": 59.8,
      "duration_seconds": 6.5,
      "text": "It happens all the time. I notice it more with touching the ear."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 60.61,
      "end_seconds": 62.64,
      "duration_seconds": 2.03,
      "text": "Is it accompanied by anything?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 63.24,
      "end_seconds": 80.5,
      "duration_seconds": 17.26,
      "text": "Oh, um, when it starts I tend to get itching in the ear canal as well. As for itching in the ear canal, it happens a few times a day."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 83.81,
      "end_seconds": 86.33,
      "duration_seconds": 2.52,
      "text": "Have you had a blocked feeling?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 91.17,
      "end_seconds": 93.44,
      "duration_seconds": 2.27,
      "text": "Yes, uh, actually."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 94.17,
      "end_seconds": 96.52,
      "duration_seconds": 2.35,
      "text": "Let's start with the basic checks."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 109.35,
      "end_seconds": 111.86,
      "duration_seconds": 2.51,
      "text": "Bear with me while this finishes..."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 124.55,
      "end_seconds": 140.3,
      "duration_seconds": 15.75,
      "text": "Okay: height 157 centimetres, BMI works out to 30.4, temperature is 36.7 degrees. And BP is 117 over 70, weight 75 kilos, saturation 99 percent, pulse is 74 beats a minute."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 142.81,
      "end_seconds": 146.61,
      "duration_seconds": 3.8,
      "text": "I'll examine you in a second, make yourself comfortable."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 147.9,
      "end_seconds": 149.91,
      "duration_seconds": 2.01,
      "text": "Raise your arm for me."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 161.55,
      "end_seconds": 169.86,
      "duration_seconds": 8.31,
      "text": "The ear canal is red and swollen with some debris, and it's painful when I pull the ear."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 172.07,
      "end_seconds": 176.25,
      "duration_seconds": 4.18,
      "text": "Thank you, you can get dressed. Any fever or dizziness?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 177.56,
      "end_seconds": 180.41,
      "duration_seconds": 2.85,
      "text": "No, no fever or dizziness."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 182.09,
      "end_seconds": 187.4,
      "duration_seconds": 5.31,
      "text": "Alright, and what about facial weakness, swelling behind the ear or recent swimming?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 188.55,
      "end_seconds": 194.31,
      "duration_seconds": 5.76,
      "text": "No, no facial weakness, swelling behind the ear or recent swimming."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 196.75,
      "end_seconds": 199.77,
      "duration_seconds": 3.02,
      "text": "Any muscle or joint problems besides this?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 201.54,
      "end_seconds": 203.78,
      "duration_seconds": 2.24,
      "text": "No, joints are fine."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 204.96,
      "end_seconds": 208.04,
      "duration_seconds": 3.08,
      "text": "So, do you work outside the home?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 209.43,
      "end_seconds": 213.56,
      "duration_seconds": 4.13,
      "text": "I'm a hairdresser, on my feet all day."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 215.47,
      "end_seconds": 217.38,
      "duration_seconds": 1.91,
      "text": "How are your meals?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 219.28,
      "end_seconds": 222.93,
      "duration_seconds": 3.65,
      "text": "I grab fast food at lunch most days."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 223.66,
      "end_seconds": 226.38,
      "duration_seconds": 2.72,
      "text": "Are you on your own at home?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 230.28,
      "end_seconds": 232.97,
      "duration_seconds": 2.69,
      "text": "I live with my elderly mother."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 234.98,
      "end_seconds": 237.57,
      "duration_seconds": 2.59,
      "text": "Have you got any known allergies?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 238.75,
      "end_seconds": 242.71,
      "duration_seconds": 3.96,
      "text": "Oh, yes, erythromycin, it gives me a rash."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 259.92,
      "end_seconds": 263.72,
      "duration_seconds": 3.8,
      "text": "Which medicines do you take at the moment?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 265.01,
      "end_seconds": 269.38,
      "duration_seconds": 4.37,
      "text": "It's aspirin, 75 milligrams, once a day, doctor."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 271.21,
      "end_seconds": 274.09,
      "duration_seconds": 2.88,
      "text": "What operations have you had, if any?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 275.68,
      "end_seconds": 279.1,
      "duration_seconds": 3.42,
      "text": "Just a triple bypass, eight years ago."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 289.15,
      "end_seconds": 292.05,
      "duration_seconds": 2.9,
      "text": "Are there any illnesses in your family?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 293.99,
      "end_seconds": 296.4,
      "duration_seconds": 2.41,
      "text": "My aunt has rheumatoid arthritis."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 297.31,
      "end_seconds": 301.99,
      "duration_seconds": 4.68,
      "text": "What about your medical history? I'll explain everything as we go along."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 306.46,
      "end_seconds": 315.24,
      "duration_seconds": 8.78,
      "text": "Actually, I've had diabetes for about ten years now. Yes, heart disease. I've never really been one for hospitals."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 316.46,
      "end_seconds": 320.27,
      "duration_seconds": 3.81,
      "text": "Alright, diabetes, that matches what I have here."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 337.78,
      "end_seconds": 365.29,
      "duration_seconds": 27.51,
      "text": "So where does that leave us? It fits best with an outer ear canal infection. I'd like you to take antibiotic and steroid ear drops, 3 drops, twice a day, for seven days. That should help with ear canal infection. Keep the ear dry, no swimming, and don't poke anything into it. Let's plan a check in a week. Okay, does all of that make sense?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 366.59,
      "end_seconds": 369.51,
      "duration_seconds": 2.92,
      "text": "Great, thank you for your help."
    }
  ]
}