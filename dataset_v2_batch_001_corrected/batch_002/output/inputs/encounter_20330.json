{
  "schema_version": "1.0",
  "encounter_id": "20330",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.29,
      "end_seconds": 4.97,
      "duration_seconds": 3.68,
      "text": "Good evening, doctor, thanks for seeing me."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.19,
      "end_seconds": 10.72,
      "duration_seconds": 4.53,
      "text": "Of course, leave it there. How can I help?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 12.1,
      "end_seconds": 17.01,
      "duration_seconds": 4.91,
      "text": "Hello, doctor, I came in with them, if that's okay."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 17.93,
      "end_seconds": 24.67,
      "duration_seconds": 6.74,
      "text": "Yeah, it's not opening my bowels. I don't know what's causing it."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 26.76,
      "end_seconds": 31.13,
      "duration_seconds": 4.37,
      "text": "Are you taking anything regularly, including from the pharmacy?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 31.81,
      "end_seconds": 41.24,
      "duration_seconds": 9.43,
      "text": "Naproxen, 250 milligrams, twice a day. something called eltr... Eltroxin. I take it 100 micrograms, maybe, every morning."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 42.65,
      "end_seconds": 46.7,
      "duration_seconds": 4.05,
      "text": "Did you happen to bring the box or the paperwork?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 48.27,
      "end_seconds": 59.28,
      "duration_seconds": 11.01,
      "text": "No, it's at home. I'm on metoprolol, 50 milligrams, twice a day for my heart. Lactulose. I take it 15 ml, at night."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 60.62,
      "end_seconds": 63.65,
      "duration_seconds": 3.03,
      "text": "Has this been going on for long?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 65.24,
      "end_seconds": 67.64,
      "duration_seconds": 2.4,
      "text": "About... well, nearly five years."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 69.32,
      "end_seconds": 77.25,
      "duration_seconds": 7.93,
      "text": "Can you describe it a bit more for me? How strong it is, what the pattern is, what helps."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 78.96,
      "end_seconds": 84.47,
      "duration_seconds": 5.51,
      "text": "It's severe, honestly. It settles a little with prune juice."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 85.05,
      "end_seconds": 87.98,
      "duration_seconds": 2.93,
      "text": "Have you noticed anything else alongside it?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 91.72,
      "end_seconds": 101.65,
      "duration_seconds": 9.93,
      "text": "It usually comes with a lack of appetite. And there's hard small stools as well, about three months now."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 103.51,
      "end_seconds": 106.83,
      "duration_seconds": 3.32,
      "text": "How much trouble does it give you?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 110.96,
      "end_seconds": 112.68,
      "duration_seconds": 1.72,
      "text": "Moderate, I'd say."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 113.99,
      "end_seconds": 120.95,
      "duration_seconds": 6.96,
      "text": "Alright, have you had not opening your bowels before, or is this the first time?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 121.77,
      "end_seconds": 129.74,
      "duration_seconds": 7.97,
      "text": "Yes, something like this happened last winter, and it went away on its own."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 130.56,
      "end_seconds": 135.07,
      "duration_seconds": 4.51,
      "text": "Okay, have you noticed vomiting, weight loss or black stools?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 136.06,
      "end_seconds": 141.22,
      "duration_seconds": 5.16,
      "text": "No vomiting, weight loss or black stools, none of it."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 142.51,
      "end_seconds": 145.46,
      "duration_seconds": 2.95,
      "text": "And severe abdominal pain, any of that?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 147.52,
      "end_seconds": 150.25,
      "duration_seconds": 2.73,
      "text": "Definitely no severe abdominal pain."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 151.86,
      "end_seconds": 156.67,
      "duration_seconds": 4.81,
      "text": "Have you noticed passing wind or blood in the stool?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 161.03,
      "end_seconds": 166.48,
      "duration_seconds": 5.45,
      "text": "I haven't had passing wind or blood in the stool, no."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 171.6,
      "end_seconds": 174.28,
      "duration_seconds": 2.68,
      "text": "Any breathing difficulties apart from this?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 175.94,
      "end_seconds": 177.45,
      "duration_seconds": 1.51,
      "text": "No, nothing there."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 185.37,
      "end_seconds": 189.53,
      "duration_seconds": 4.16,
      "text": "What about your parents, brothers or sisters, any conditions?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 190.61,
      "end_seconds": 192.56,
      "duration_seconds": 1.95,
      "text": "My grandmother had dementia."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 193.64,
      "end_seconds": 194.53,
      "duration_seconds": 0.89,
      "text": "Any smoking?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 195.83,
      "end_seconds": 199.15,
      "duration_seconds": 3.32,
      "text": "I gave up cigarettes last spring."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 200.51,
      "end_seconds": 203.24,
      "duration_seconds": 2.73,
      "text": "Do you follow any particular diet?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 205.34,
      "end_seconds": 208.89,
      "duration_seconds": 3.55,
      "text": "I'm vegetarian and have been for years."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 210.4,
      "end_seconds": 212.45,
      "duration_seconds": 2.05,
      "text": "Okay, are you active?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 213.54,
      "end_seconds": 216.44,
      "duration_seconds": 2.9,
      "text": "I walk the dog every morning."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 231.19,
      "end_seconds": 233.94,
      "duration_seconds": 2.75,
      "text": "Have you been to theatre before?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 234.85,
      "end_seconds": 239.44,
      "duration_seconds": 4.59,
      "text": "Just two stents put in my heart, three years ago."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 242.66,
      "end_seconds": 246.87,
      "duration_seconds": 4.21,
      "text": "Anything in your past medical history I should know?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 248.91,
      "end_seconds": 254.3,
      "duration_seconds": 5.39,
      "text": "Yes, arthritis in my knees. I've had an underactive thyroid, yes."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 255.28,
      "end_seconds": 256.6,
      "duration_seconds": 1.32,
      "text": "Is that everything?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 257.5,
      "end_seconds": 259.48,
      "duration_seconds": 1.98,
      "text": "I've got heart disease."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 261.42,
      "end_seconds": 262.26,
      "duration_seconds": 0.84,
      "text": "Anything else?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 266.8,
      "end_seconds": 269.94,
      "duration_seconds": 3.14,
      "text": "Shall I check your blood pressure and pulse?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 283.51,
      "end_seconds": 286.18,
      "duration_seconds": 2.67,
      "text": "Keep your arm relaxed for me..."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 305.23,
      "end_seconds": 312.63,
      "duration_seconds": 7.4,
      "text": "Okay: pulse 67, pressure 116 over 72, temp 36.4 degrees, SpO2 97 percent on room air."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 314.32,
      "end_seconds": 319.17,
      "duration_seconds": 4.85,
      "text": "I'll need to examine you for this, it won't take long."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 320.23,
      "end_seconds": 321.7,
      "duration_seconds": 1.47,
      "text": "Yeah, no problem."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 323.59,
      "end_seconds": 324.96,
      "duration_seconds": 1.37,
      "text": "Does that hurt?"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 339.4,
      "end_seconds": 345.32,
      "duration_seconds": 5.92,
      "text": "There is firm stool in the left lower abdomen and no mass."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 347.48,
      "end_seconds": 359.58,
      "duration_seconds": 12.1,
      "text": "Okay, that's enough for me. So where does that leave us? It fits best with constipation, possibly related to diet or medicines. An under-active thyroid is also on my list."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 361.63,
      "end_seconds": 363.92,
      "duration_seconds": 2.29,
      "text": "Is it dangerous, doctor?"
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 365.28,
      "end_seconds": 374.61,
      "duration_seconds": 9.33,
      "text": "Nothing I've seen today points to an emergency. It looks like constipation, possibly related to diet or medicines, but I'd like to confirm."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 385.08,
      "end_seconds": 389.13,
      "duration_seconds": 4.05,
      "text": "Let's book a blood count to look into constipation."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 393.5,
      "end_seconds": 395.71,
      "duration_seconds": 2.21,
      "text": "That's fine with me."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 399.26,
      "end_seconds": 410.8,
      "duration_seconds": 11.54,
      "text": "I'm going to order blood tests, for constipation. For this, macrogol, 1 sachet, once a day, for two weeks. You take it by mouth. It's for constipation."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 412.39,
      "end_seconds": 415.86,
      "duration_seconds": 3.47,
      "text": "Alright, I'll pick it up today."
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 416.75,
      "end_seconds": 422.36,
      "duration_seconds": 5.61,
      "text": "More fibre, plenty of water and a regular time on the toilet after breakfast."
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 422.95,
      "end_seconds": 432.24,
      "duration_seconds": 9.29,
      "text": "Okay, go on. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 433.27,
      "end_seconds": 437.42,
      "duration_seconds": 4.15,
      "text": "Okay, uh, I'll look out for that."
    },
    {
      "segment_id": "SEG0059",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 438.24,
      "end_seconds": 452.51,
      "duration_seconds": 14.27,
      "text": "One warning sign to remember: you are unable to pass wind or have severe tummy pain. In that case don't wait. Let's plan a check in three weeks. Does all of that make sense?"
    },
    {
      "segment_id": "SEG0060",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 458.62,
      "end_seconds": 461.42,
      "duration_seconds": 2.8,
      "text": "I think I understand everything. Thanks."
    }
  ]
}