  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.76,
      "end_seconds": 3.17,
      "duration_seconds": 2.41,
      "text": "Afternoon, thanks for coming in."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 4.55,
      "end_seconds": 7.3,
      "duration_seconds": 2.75,
      "text": "good morning, doctor, thank you"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 9.25,
      "end_seconds": 11.11,
      "duration_seconds": 1.86,
      "text": "Where shall we begin?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 11.9,
      "end_seconds": 26.12,
      "duration_seconds": 14.22,
      "text": "So So the thing is, I've got red eyes in the evening. I'd rather not end up on lots of tablets if I can avoid it."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 27.86,
      "end_seconds": 34.99,
      "duration_seconds": 7.13,
      "text": "Has this been going on for long? Bear with me, I'm just building up the picture."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 36.18,
      "end_seconds": 47.87,
      "duration_seconds": 11.69,
      "text": "Uh, around about a year... no wait, it's more like nearly five years. It's a relief to finally sit down and talk about it."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 48.31,
      "end_seconds": 49.01,
      "duration_seconds": 0.7,
      "text": "ah"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 58.96,
      "end_seconds": 60.39,
      "duration_seconds": 1.43,
      "text": "Any eye pain?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 61.43,
      "end_seconds": 64.84,
      "duration_seconds": 3.41,
      "text": "I haven't noticed any eye pain."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 66.46,
      "end_seconds": 70.03,
      "duration_seconds": 3.57,
      "text": "Have you noticed double vision or sensitivity to light?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 70.87,
      "end_seconds": 75.97,
      "duration_seconds": 5.1,
      "text": "No double vision or sensitivity to light, none of it."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 77.54,
      "end_seconds": 81.19,
      "duration_seconds": 3.65,
      "text": "Anything on the skin I should know about?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 82.94,
      "end_seconds": 85.47,
      "duration_seconds": 2.53,
      "text": "Right, no, skin's been fine."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 85.98,
      "end_seconds": 90.68,
      "duration_seconds": 4.7,
      "text": "Can you list what you take, tablets, creams or inhalers?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 91.62,
      "end_seconds": 93.95,
      "duration_seconds": 2.33,
      "text": "Eye drops, when needed"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 106.53,
      "end_seconds": 110.57,
      "duration_seconds": 4.04,
      "text": "Do you have any medical conditions I should know about?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 111.26,
      "end_seconds": 112.77,
      "duration_seconds": 1.51,
      "text": "Not really, no."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 113.6,
      "end_seconds": 116.12,
      "duration_seconds": 2.52,
      "text": "before we go further, any allergies?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 116.8,
      "end_seconds": 119.34,
      "duration_seconds": 2.54,
      "text": "not to my knowledge, no"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 128.55,
      "end_seconds": 130.51,
      "duration_seconds": 1.96,
      "text": "Have you retired yet?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 131.16,
      "end_seconds": 135.6,
      "duration_seconds": 4.44,
      "text": "I retired from the post office two years ago."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 137.31,
      "end_seconds": 140.16,
      "duration_seconds": 2.85,
      "text": "do you follow any particular diet?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 145.2,
      "end_seconds": 148.47,
      "duration_seconds": 3.27,
      "text": "I'm vegetarian and have been for years."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 149.57,
      "end_seconds": 153.22,
      "duration_seconds": 3.65,
      "text": "let me get the readings out of the way"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 159.7,
      "end_seconds": 162.66,
      "duration_seconds": 2.96,
      "text": "Okay, keep your arm relaxed for me..."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 184.1,
      "end_seconds": 194.57,
      "duration_seconds": 10.47,
      "text": "okay: BP is 110 over 77, temperature is 36.5 degrees, pulse is 86 beats a minute, respiratory rate 16, saturation 99 percent"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 196.13,
      "end_seconds": 197.75,
      "duration_seconds": 1.62,
      "text": "is that normal?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 198.41,
      "end_seconds": 203.01,
      "duration_seconds": 4.6,
      "text": "Okay, they help me see the whole picture, more shortly."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 205.74,
      "end_seconds": 210.85,
      "duration_seconds": 5.11,
      "text": "Alright, I'd like to check you over now, if that's alright."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 212.01,
      "end_seconds": 213.07,
      "duration_seconds": 1.06,
      "text": "Okay, doctor."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 214.12,
      "end_seconds": 215.56,
      "duration_seconds": 1.44,
      "text": "nearly finished here"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 233.35,
      "end_seconds": 240.88,
      "duration_seconds": 7.53,
      "text": "The eyes are slightly red with no discharge and the front of the eye looks clear."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 242.89,
      "end_seconds": 250.93,
      "duration_seconds": 8.04,
      "text": "Thank you, you can get dressed. Putting it all together, it points towards dry eye syndrome."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 264.82,
      "end_seconds": 274.23,
      "duration_seconds": 9.41,
      "text": "An eye test is what I'd like next, for blurred vision. The result will help us decide whether anything more is needed."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 275.43,
      "end_seconds": 276.67,
      "duration_seconds": 1.24,
      "text": "mm, alright"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 277.97,
      "end_seconds": 299.69,
      "duration_seconds": 21.72,
      "text": "Take a screen break every twenty minutes and try to blink fully. If you lose vision or get severe eye pain, or you feel really unwell, please come to the emergency department. I'd like to see you again in four weeks. What are the next steps as you understand them?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 300.75,
      "end_seconds": 305.81,
      "duration_seconds": 5.06,
      "text": "So, I come back in four weeks. Is that right?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 306.31,
      "end_seconds": 312.62,
      "duration_seconds": 6.31,
      "text": "Yes, exactly right. Is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 314.57,
      "end_seconds": 317.02,
      "duration_seconds": 2.45,
      "text": "Alright, thanks, take care."
    }
  ]
}