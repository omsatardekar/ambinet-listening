  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.63,
      "end_seconds": 3.16,
      "duration_seconds": 2.53,
      "text": "Hi, sit anywhere you like."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 4.56,
      "end_seconds": 5.84,
      "duration_seconds": 1.28,
      "text": "Evening, doctor."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 6.67,
      "end_seconds": 9.23,
      "duration_seconds": 2.56,
      "text": "Start wherever you like, I'm listening."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 10.69,
      "end_seconds": 24.92,
      "duration_seconds": 14.23,
      "text": "Right, so the thing is, I've got pain in my right shoulder. I'd rather not end up on lots of tablets if I can avoid it."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 25.81,
      "end_seconds": 30.11,
      "duration_seconds": 4.3,
      "text": "Alright, when was the first time you noticed it?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 31.87,
      "end_seconds": 43.35,
      "duration_seconds": 11.48,
      "text": "About two weeks, I think... sorry, four weeks, I got that wrong. I thought it would sort itself out, but it hasn't."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 45.35,
      "end_seconds": 47.01,
      "duration_seconds": 1.66,
      "text": "What brings it on?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 48.83,
      "end_seconds": 51.54,
      "duration_seconds": 2.71,
      "text": "It's worse with reaching overhead."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 53.51,
      "end_seconds": 56.69,
      "duration_seconds": 3.18,
      "text": "Is it bearing on you a lot?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 58.03,
      "end_seconds": 65.82,
      "duration_seconds": 7.79,
      "text": "It's moderate, honestly. I've also had an ache down the upper arm, for three weeks."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 67.23,
      "end_seconds": 70.46,
      "duration_seconds": 3.23,
      "text": "Is it bearing on you a lot?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 71.48,
      "end_seconds": 73.46,
      "duration_seconds": 1.98,
      "text": "I'd call it mild."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 77.73,
      "end_seconds": 82.1,
      "duration_seconds": 4.37,
      "text": "What about difficulty combing your hair, have you noticed that?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 84.17,
      "end_seconds": 85.87,
      "duration_seconds": 1.7,
      "text": "Yeah, that too."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 86.93,
      "end_seconds": 91.03,
      "duration_seconds": 4.1,
      "text": "A few quick ones: chest pain or neck pain?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 92.05,
      "end_seconds": 96.39,
      "duration_seconds": 4.34,
      "text": "No, you know, I'd have said so."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 97.8,
      "end_seconds": 100.77,
      "duration_seconds": 2.97,
      "text": "Any fall or injury, swelling or fever?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 101.47,
      "end_seconds": 106.17,
      "duration_seconds": 4.7,
      "text": "No, uh, I haven't had any of them."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 110.9,
      "end_seconds": 112.68,
      "duration_seconds": 1.78,
      "text": "How's your breathing otherwise?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 114.74,
      "end_seconds": 116.34,
      "duration_seconds": 1.6,
      "text": "No, nothing there."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 117.3,
      "end_seconds": 122.55,
      "duration_seconds": 5.25,
      "text": "Have you noticed any weakness, or anything odd with your balance?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 124.14,
      "end_seconds": 125.83,
      "duration_seconds": 1.69,
      "text": "Nothing odd there."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 144.78,
      "end_seconds": 147.72,
      "duration_seconds": 2.94,
      "text": "What do you do during the day?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 149.82,
      "end_seconds": 153.79,
      "duration_seconds": 3.97,
      "text": "I look after my grandchildren most days."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 154.48,
      "end_seconds": 156.45,
      "duration_seconds": 1.97,
      "text": "Tell me about your eating."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 158.41,
      "end_seconds": 164.82,
      "duration_seconds": 6.41,
      "text": "I drink a lot of tea and snack through the day."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 166.68,
      "end_seconds": 169.57,
      "duration_seconds": 2.89,
      "text": "Are you on your own at home?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 172.76,
      "end_seconds": 176.11,
      "duration_seconds": 3.35,
      "text": "I live with my elderly mother."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 177.59,
      "end_seconds": 181.59,
      "duration_seconds": 4.0,
      "text": "Do you react to any medicines or foods? Any allergies?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 182.97,
      "end_seconds": 188.05,
      "duration_seconds": 5.08,
      "text": "Yes, tramadol, it gives me feeling very drowsy."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 189.05,
      "end_seconds": 192.9,
      "duration_seconds": 3.85,
      "text": "Any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 193.81,
      "end_seconds": 195.66,
      "duration_seconds": 1.85,
      "text": "No, no conditions."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 207.73,
      "end_seconds": 212.6,
      "duration_seconds": 4.87,
      "text": "Alright, can you list what you take, tablets, creams or inhalers?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 213.52,
      "end_seconds": 216.67,
      "duration_seconds": 3.15,
      "text": "It's diclofenac gel, twice a day."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 217.63,
      "end_seconds": 220.21,
      "duration_seconds": 2.58,
      "text": "Let's start with the basic checks."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 231.24,
      "end_seconds": 233.25,
      "duration_seconds": 2.01,
      "text": "Nearly done with the readings..."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 242.62,
      "end_seconds": 248.16,
      "duration_seconds": 5.54,
      "text": "Okay: pulse 79, pressure 125 over 69, temp 36.7 degrees."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 258.59,
      "end_seconds": 283.45,
      "duration_seconds": 24.86,
      "text": "Going by what you've described, it points towards a rotator cuff tendon problem. We shouldn't forget neck-related arm pain. We should do an ultrasound of the shoulder for shoulder pain. Let's book a shoulder X-ray to look into shoulder pain. Keep the shoulder moving gently within comfort and avoid heavy overhead lifting. We'll refer you to physiotherapy."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 285.54,
      "end_seconds": 288.39,
      "duration_seconds": 2.85,
      "text": "Alright, you know, thank you."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 289.18,
      "end_seconds": 292.23,
      "duration_seconds": 3.05,
      "text": "I'd like you back in four weeks."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 293.46,
      "end_seconds": 297.86,
      "duration_seconds": 4.4,
      "text": "Okay, um, so that's fine with me."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 299.1,
      "end_seconds": 301.8,
      "duration_seconds": 2.7,
      "text": "That's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 306.17,
      "end_seconds": 309.53,
      "duration_seconds": 3.36,
      "text": "No, that's all. Thanks a lot."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 310.1,
      "end_seconds": 311.38,
      "duration_seconds": 1.28,
      "text": "Look after yourself."
    }
  ]
