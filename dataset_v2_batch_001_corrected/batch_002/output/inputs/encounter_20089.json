{
  "schema_version": "1.0",
  "encounter_id": "20089",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.0,
      "end_seconds": 2.74,
      "duration_seconds": 1.74,
      "text": "Welcome. Make yourself comfortable."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 7.9,
      "end_seconds": 9.07,
      "duration_seconds": 1.17,
      "text": "Evening, doctor."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 10.91,
      "end_seconds": 12.91,
      "duration_seconds": 2.0,
      "text": "What's the main thing today?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 14.13,
      "end_seconds": 23.42,
      "duration_seconds": 9.29,
      "text": "Right, it's a cough that won't go away. I thought I'd wait, but it hasn't gone."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 24.69,
      "end_seconds": 27.98,
      "duration_seconds": 3.29,
      "text": "What's the timeline, when did it begin?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 29.87,
      "end_seconds": 32.7,
      "duration_seconds": 2.83,
      "text": "I've had it for one week."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 33.31,
      "end_seconds": 42.19,
      "duration_seconds": 8.88,
      "text": "Tell me a bit more about it: how bad it gets, how often, and whether anything makes it better or worse."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 43.0,
      "end_seconds": 60.76,
      "duration_seconds": 17.76,
      "text": "I mean, I'd say mild. It's once or twice a day. And, And I've been feeling washed out as well. About feeling washed out, maybe a eight out of ten on a bad day."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 62.71,
      "end_seconds": 67.66,
      "duration_seconds": 4.95,
      "text": "Did you get sharp chest pain, night sweats, fever or leg swelling?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 68.57,
      "end_seconds": 74.04,
      "duration_seconds": 5.47,
      "text": "No, no sharp chest pain, night sweats, fever or leg swelling."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 77.88,
      "end_seconds": 80.1,
      "duration_seconds": 2.22,
      "text": "Is your digestion otherwise okay?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 80.96,
      "end_seconds": 84.84,
      "duration_seconds": 3.88,
      "text": "Let me think, bowels are regular, nothing odd."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 85.37,
      "end_seconds": 86.87,
      "duration_seconds": 1.5,
      "text": "Neurologically, anything strange?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 92.62,
      "end_seconds": 95.57,
      "duration_seconds": 2.95,
      "text": "Yeah, no, nothing like that."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 96.56,
      "end_seconds": 97.94,
      "duration_seconds": 1.38,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 99.41,
      "end_seconds": 102.13,
      "duration_seconds": 2.72,
      "text": "No surgery, you know, no."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 112.9,
      "end_seconds": 116.07,
      "duration_seconds": 3.17,
      "text": "Which medicines do you take at the moment?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 117.79,
      "end_seconds": 125.96,
      "duration_seconds": 8.17,
      "text": "Seretide inhaler, twice a day. I take pantoprazole, 40 milligrams, before breakfast for my acidity."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 126.27,
      "end_seconds": 128.28,
      "duration_seconds": 2.01,
      "text": "I see, go ahead."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 130.3,
      "end_seconds": 134.28,
      "duration_seconds": 3.98,
      "text": "Simvastatin. I take it 20 milligrams, at night."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 135.27,
      "end_seconds": 138.89,
      "duration_seconds": 3.62,
      "text": "Let me ask about allergies, anything at all?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 140.86,
      "end_seconds": 149.18,
      "duration_seconds": 8.32,
      "text": "Years back I got feeling very drowsy from tramadol, so I stay away from it now."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 164.07,
      "end_seconds": 168.94,
      "duration_seconds": 4.87,
      "text": "Let's talk a little about your daily life and habits."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 170.49,
      "end_seconds": 187.43,
      "duration_seconds": 16.94,
      "text": "I smoke roughly a pack every two days. I used to drink heavily but I stopped four years ago. My husband and I live above the shop. I'm a hairdresser, on my feet all day."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 188.68,
      "end_seconds": 192.59,
      "duration_seconds": 3.91,
      "text": "Tell me about any past illnesses or ongoing conditions."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 193.32,
      "end_seconds": 197.64,
      "duration_seconds": 4.32,
      "text": "Ah, I've had asthma for about a year now."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 199.06,
      "end_seconds": 199.95,
      "duration_seconds": 0.89,
      "text": "I follow."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 200.53,
      "end_seconds": 204.61,
      "duration_seconds": 4.08,
      "text": "I have acid reflux, for two years."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 206.04,
      "end_seconds": 207.69,
      "duration_seconds": 1.65,
      "text": "Is there anything more?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 209.58,
      "end_seconds": 211.59,
      "duration_seconds": 2.01,
      "text": "I've got high cholesterol."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 216.99,
      "end_seconds": 220.4,
      "duration_seconds": 3.41,
      "text": "Alright, asthma, that matches what I have here."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 221.95,
      "end_seconds": 224.53,
      "duration_seconds": 2.58,
      "text": "Let's move on to the examination."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 226.49,
      "end_seconds": 228.21,
      "duration_seconds": 1.72,
      "text": "Yeah, no problem."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 229.74,
      "end_seconds": 232.18,
      "duration_seconds": 2.44,
      "text": "Raise your arm for me."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 242.99,
      "end_seconds": 247.72,
      "duration_seconds": 4.73,
      "text": "The chest is clear and your oxygen level is normal."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 252.16,
      "end_seconds": 264.79,
      "duration_seconds": 12.63,
      "text": "Thank you, you can get dressed. Okay, thinking it through, this is probably a lingering cough after a viral infection. I can't rule out cough-variant asthma yet."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 275.8,
      "end_seconds": 279.59,
      "duration_seconds": 3.79,
      "text": "I'm going to order a breathing test, for breathlessness."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 280.85,
      "end_seconds": 284.4,
      "duration_seconds": 3.55,
      "text": "I can book that for Monday at 9 am."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 285.07,
      "end_seconds": 313.54,
      "duration_seconds": 28.47,
      "text": "I'm sending you for a chest X-ray because of persistent cough. What I'm giving you is salbutamol inhaler, 100 micrograms, two puffs when needed, for two weeks. That should help with wheeze and cough. Honey and lemon in warm water can ease it, and avoid smoky rooms. Do get help quickly if you cough up blood or get breathless at rest."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 318.41,
      "end_seconds": 319.92,
      "duration_seconds": 1.51,
      "text": "Yes, will do."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 321.15,
      "end_seconds": 326.79,
      "duration_seconds": 5.64,
      "text": "I'd like you back in three weeks. Does all of that make sense?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 328.7,
      "end_seconds": 331.56,
      "duration_seconds": 2.86,
      "text": "No, that's all. Thanks a lot."
    }
  ]
}