{
  "schema_version": "1.0",
  "encounter_id": "20359",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 0.52,
      "end_seconds": 5.52,
      "duration_seconds": 5.0,
      "text": "doctor, I've brought them through. The observations are done, whenever you need them"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.12,
      "end_seconds": 10.38,
      "duration_seconds": 4.26,
      "text": "good thank you welcome tell me what's brought you in"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 11.74,
      "end_seconds": 17.89,
      "duration_seconds": 6.15,
      "text": "Um, good morning, doctor. I came along to help out."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 19.12,
      "end_seconds": 23.3,
      "duration_seconds": 4.18,
      "text": "Of course please stay. It's helpful to have you here."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 24.3,
      "end_seconds": 30.8,
      "duration_seconds": 6.5,
      "text": "doctor, it's burning when I pass urine that's what we're worried about"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 31.53,
      "end_seconds": 40.77,
      "duration_seconds": 9.24,
      "text": "Here are the numbers, doctor. Saturation 99 percent, temp 36.6 degrees, BP is 121 over 70, heart rate 84."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 42.34,
      "end_seconds": 46.79,
      "duration_seconds": 4.45,
      "text": "Good, thank you. How many days or weeks has it been?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 48.22,
      "end_seconds": 53.0,
      "duration_seconds": 4.78,
      "text": "it's been going on for about a week"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 55.04,
      "end_seconds": 58.22,
      "duration_seconds": 3.18,
      "text": "right how often do you get it?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 59.26,
      "end_seconds": 62.26,
      "duration_seconds": 3.0,
      "text": "it just comes and goes"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 62.78,
      "end_seconds": 69.58,
      "duration_seconds": 6.8,
      "text": "well, I was just going to say that the main thing is—"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 69.68,
      "end_seconds": 75.64,
      "duration_seconds": 5.96,
      "text": "Sorry to cut in, doctor, quick question: shall I bring the trolley in now or later?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 76.14,
      "end_seconds": 82.91,
      "duration_seconds": 6.77,
      "text": "later, thanks please go on has there been a dull ache above the pubic bone too?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 83.56,
      "end_seconds": 86.55,
      "duration_seconds": 2.99,
      "text": "yes, for about a week"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 87.6,
      "end_seconds": 97.48,
      "duration_seconds": 9.88,
      "text": "right, tell me a bit more about it: how bad it gets, how often, and whether anything makes it better or worse"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 99.15,
      "end_seconds": 117.14,
      "duration_seconds": 17.99,
      "text": "oh, it's every other day. Mild, really uh, I've had a sudden urgent need to go too, for two weeks i've, I've also had cloudy urine, since yesterday"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 118.23,
      "end_seconds": 124.47,
      "duration_seconds": 6.24,
      "text": "Have you had burning when you pass urine before or is this the first time?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 126.47,
      "end_seconds": 133.62,
      "duration_seconds": 7.15,
      "text": "a bit, about six months ago it settled by itself back then"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 145.22,
      "end_seconds": 148.99,
      "duration_seconds": 3.77,
      "text": "a a few quick ones: vomiting or vaginal discharge?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 150.93,
      "end_seconds": 154.65,
      "duration_seconds": 3.72,
      "text": "Yeah, no, I'd have said so."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 155.84,
      "end_seconds": 160.57,
      "duration_seconds": 4.73,
      "text": "A A few quick ones: blood in the urine or loin pain?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 162.13,
      "end_seconds": 165.72,
      "duration_seconds": 3.59,
      "text": "no you know I'd have said so"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 166.75,
      "end_seconds": 170.26,
      "duration_seconds": 3.51,
      "text": "have you had new partner, by any chance?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 172.0,
      "end_seconds": 175.71,
      "duration_seconds": 3.71,
      "text": "Hmm, no, none, no new partner."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 177.74,
      "end_seconds": 180.63,
      "duration_seconds": 2.89,
      "text": "Has your heart given you any trouble?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 182.5,
      "end_seconds": 187.97,
      "duration_seconds": 5.47,
      "text": "My heart's been fine, uh, as far as I know."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 189.3,
      "end_seconds": 192.21,
      "duration_seconds": 2.91,
      "text": "How are your joints, any aches elsewhere?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 193.53,
      "end_seconds": 195.01,
      "duration_seconds": 1.48,
      "text": "nothing else aches"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 196.5,
      "end_seconds": 204.17,
      "duration_seconds": 7.67,
      "text": "Right, anything in your past medical history I should know? I ask cos it helps me narrow things down."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 205.3,
      "end_seconds": 222.45,
      "duration_seconds": 17.15,
      "text": "I've had diabetes for about a year now. Yes, migraines. Hmm, I've had an irregular heartbeat for about ten years now. I didn't wanna make a fuss, you know."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 223.29,
      "end_seconds": 223.99,
      "duration_seconds": 0.7,
      "text": "ah"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 224.8,
      "end_seconds": 231.73,
      "duration_seconds": 6.93,
      "text": "mm, you know, I've had high blood pressure for five years now"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 233.33,
      "end_seconds": 236.06,
      "duration_seconds": 2.73,
      "text": "did you ever have any procedures done?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 236.67,
      "end_seconds": 242.92,
      "duration_seconds": 6.25,
      "text": "okay, so I had keyhole surgery on my gallbladder two years back"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 260.11,
      "end_seconds": 265.48,
      "duration_seconds": 5.37,
      "text": "Has anything ever caused you a reaction? I mean any allergies."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 268.58,
      "end_seconds": 281.8,
      "duration_seconds": 13.22,
      "text": "sorry what was I saying I think I reacted to some antibiotic once years ago i don't remember which one or what happened exactly"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 283.5,
      "end_seconds": 287.48,
      "duration_seconds": 3.98,
      "text": "are you taking anything regularly including from the pharmacy?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 289.22,
      "end_seconds": 299.55,
      "duration_seconds": 10.33,
      "text": "Uh uh it's a... um I can't remember what it's called. It's a round yellow one."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 301.15,
      "end_seconds": 304.26,
      "duration_seconds": 3.11,
      "text": "right, do you remember what it's for?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 304.9,
      "end_seconds": 321.81,
      "duration_seconds": 16.91,
      "text": "For my sugar, I believe. My daughter sets them out for me, I just take what I'm given. Metoprolol. I take it twice a day for the heart rhythm."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 322.58,
      "end_seconds": 324.8,
      "duration_seconds": 2.22,
      "text": "How much do you take?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 326.88,
      "end_seconds": 353.57,
      "duration_seconds": 26.69,
      "text": "It's 50 milligrams. Hydrochlorothiazide. I take it 12.5 milligrams, every morning. Um, I'm on cranberry juice, every day. I told myself I'd wait and see, and and here I am. I looked a few things up online, and that probably didn't help."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 355.27,
      "end_seconds": 359.44,
      "duration_seconds": 4.17,
      "text": "Okay, has anyone in your family had anything serious?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 360.16,
      "end_seconds": 368.33,
      "duration_seconds": 8.17,
      "text": "My daughter has type 1 diabetes. Let me think, my father has Parkinson's disease."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 370.3,
      "end_seconds": 372.95,
      "duration_seconds": 2.65,
      "text": "Right, do you do any exercise?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 373.7,
      "end_seconds": 376.24,
      "duration_seconds": 2.54,
      "text": "I swim twice a week"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 378.13,
      "end_seconds": 381.04,
      "duration_seconds": 2.91,
      "text": "So, do you live by yourself?"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 383.05,
      "end_seconds": 387.48,
      "duration_seconds": 4.43,
      "text": "No, I share a house with my brother."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 388.52,
      "end_seconds": 391.63,
      "duration_seconds": 3.11,
      "text": "okay, time for me to examine you"
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 393.04,
      "end_seconds": 396.15,
      "duration_seconds": 3.11,
      "text": "Stay as you are for a moment."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 411.51,
      "end_seconds": 418.53,
      "duration_seconds": 7.02,
      "text": "your tummy is soft with mild tenderness low down and no pain in the loins"
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 422.16,
      "end_seconds": 436.08,
      "duration_seconds": 13.92,
      "text": "Okay, that's enough for me. So where does that leave us? The most likely explanation is a lower urinary tract infection. Vaginal irritation is still possible. A kidney infection is still possible."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 437.63,
      "end_seconds": 441.0,
      "duration_seconds": 3.37,
      "text": "we've already done a urine test this morning, doctor"
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 441.89,
      "end_seconds": 457.57,
      "duration_seconds": 15.68,
      "text": "Thanks I'll have a look. Let's get a urine culture for recurrent urinary infection. The treatment will be nitrofurantoin 100 milligrams twice a day for three days. That should help with urinary infection."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 458.08,
      "end_seconds": 461.25,
      "duration_seconds": 3.17,
      "text": "Fine, um, I'll begin it."
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 463.14,
      "end_seconds": 472.94,
      "duration_seconds": 9.8,
      "text": "Drink plenty of water and don't hold on when you need to go. Is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 473.68,
      "end_seconds": 479.38,
      "duration_seconds": 5.7,
      "text": "I mean okay that that makes sense. Thanks for explaining"
    }
  ]
}