{
  "schema_version": "1.0",
  "encounter_id": "20183",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.28,
      "end_seconds": 8.95,
      "duration_seconds": 7.67,
      "text": "I mean, hello doctor, sorry, I took a wrong turn on the way here."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 9.68,
      "end_seconds": 15.03,
      "duration_seconds": 5.35,
      "text": "Okay, yes, come in and sit down. What brings you here today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 19.99,
      "end_seconds": 24.09,
      "duration_seconds": 4.1,
      "text": "Um, so... irregular periods. That's why I came."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 25.67,
      "end_seconds": 27.66,
      "duration_seconds": 1.99,
      "text": "Did it come on recently?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 28.38,
      "end_seconds": 38.35,
      "duration_seconds": 9.97,
      "text": "It's been going on for four weeks. I wasn't sure whether to come in at all, to be honest."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 39.67,
      "end_seconds": 43.17,
      "duration_seconds": 3.5,
      "text": "Is it a lot or only a little?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 44.5,
      "end_seconds": 49.54,
      "duration_seconds": 5.04,
      "text": "Mostly mild. I've also had mood swings, for about a year."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 51.62,
      "end_seconds": 56.04,
      "duration_seconds": 4.42,
      "text": "Let's talk a little about your daily life and habits."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 57.73,
      "end_seconds": 74.91,
      "duration_seconds": 17.18,
      "text": "I have about eight cigarettes in a day. Not much, I mostly stay in these days. I grab fast food at lunch most days. My husband and I live above the shop."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 90.52,
      "end_seconds": 94.53,
      "duration_seconds": 4.01,
      "text": "Anything in your past medical history I should know?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 96.2,
      "end_seconds": 99.95,
      "duration_seconds": 3.75,
      "text": "I've had thin bones for five years now."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 100.83,
      "end_seconds": 101.53,
      "duration_seconds": 0.7,
      "text": "Yes."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 120.29,
      "end_seconds": 121.56,
      "duration_seconds": 1.27,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 122.13,
      "end_seconds": 129.29,
      "duration_seconds": 7.16,
      "text": "Sorry, you know, what was I saying, nothing, I haven't had any operations."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 130.59,
      "end_seconds": 135.73,
      "duration_seconds": 5.14,
      "text": "Are you allergic to anything? Any allergies to medicines or foods?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 136.31,
      "end_seconds": 140.49,
      "duration_seconds": 4.18,
      "text": "Grass pollen. I come out in... well, itchy eyes."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 148.4,
      "end_seconds": 152.22,
      "duration_seconds": 3.82,
      "text": "Which medicines do you take at the moment?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 153.99,
      "end_seconds": 158.06,
      "duration_seconds": 4.07,
      "text": "I take alendronate, 70 milligrams, once a week."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 174.05,
      "end_seconds": 178.23,
      "duration_seconds": 4.18,
      "text": "Did you get heavy bleeding, palpitations or chest pain?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 180.16,
      "end_seconds": 184.91,
      "duration_seconds": 4.75,
      "text": "No heavy bleeding, palpitations or chest pain, none of it."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 185.9,
      "end_seconds": 190.45,
      "duration_seconds": 4.55,
      "text": "What about your tummy and bowels, anything unusual there?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 192.28,
      "end_seconds": 193.95,
      "duration_seconds": 1.67,
      "text": "Nothing unusual, no."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 195.77,
      "end_seconds": 199.9,
      "duration_seconds": 4.13,
      "text": "Let me get the readings out of the way."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 208.56,
      "end_seconds": 210.96,
      "duration_seconds": 2.4,
      "text": "Keep your arm relaxed for me..."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 229.8,
      "end_seconds": 236.25,
      "duration_seconds": 6.45,
      "text": "Okay: temperature 36.5, pulse is 83 beats a minute, pressure 113 over 78."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 237.83,
      "end_seconds": 239.29,
      "duration_seconds": 1.46,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 240.79,
      "end_seconds": 243.36,
      "duration_seconds": 2.57,
      "text": "We'll look at it together shortly."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 244.48,
      "end_seconds": 247.06,
      "duration_seconds": 2.58,
      "text": "Let's move on to the examination."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 248.01,
      "end_seconds": 250.79,
      "duration_seconds": 2.78,
      "text": "Stay as you are for a moment."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 265.6,
      "end_seconds": 271.36,
      "duration_seconds": 5.76,
      "text": "Blood pressure and pulse are fine and there are no breast lumps on examination."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 274.14,
      "end_seconds": 285.58,
      "duration_seconds": 11.44,
      "text": "All finished, thank you. Okay, thinking it through, the most likely explanation is perimenopausal symptoms. That's my thinking for now, and it may change as we learn more."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 286.71,
      "end_seconds": 288.21,
      "duration_seconds": 1.5,
      "text": "Is this permanent?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 289.12,
      "end_seconds": 308.47,
      "duration_seconds": 19.35,
      "text": "Nothing I've seen today points to an emergency. It looks like perimenopausal symptoms. Layers of clothing, a fan by the bed, and cutting down on caffeine and spicy food can help the flushes. Is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 310.09,
      "end_seconds": 311.89,
      "duration_seconds": 1.8,
      "text": "That's clear, thanks."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 313.25,
      "end_seconds": 314.56,
      "duration_seconds": 1.31,
      "text": "Goodbye for now."
    }
  ]
}