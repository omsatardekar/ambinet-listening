{
  "schema_version": "1.0",
  "encounter_id": "20208",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.73,
      "end_seconds": 5.88,
      "duration_seconds": 5.15,
      "text": "Hello, take a seat, I'll be with you in a second."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 12.16,
      "end_seconds": 16.86,
      "duration_seconds": 4.7,
      "text": "Hmm, um, afternoon, is this seat fine?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 17.63,
      "end_seconds": 22.18,
      "duration_seconds": 4.55,
      "text": "Erm, thank you for fitting us in, doctor."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 23.12,
      "end_seconds": 25.5,
      "duration_seconds": 2.38,
      "text": "Alright, weather's turned, hasn't it?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 26.98,
      "end_seconds": 34.42,
      "duration_seconds": 7.44,
      "text": "So, you know, it has. I got caught in the rain walking over."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 36.27,
      "end_seconds": 37.96,
      "duration_seconds": 1.69,
      "text": "What's been worrying you?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 39.99,
      "end_seconds": 50.55,
      "duration_seconds": 10.56,
      "text": "It's a tickle at the back of my throat, doctor. He didn't want to come, but I insisted."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 51.52,
      "end_seconds": 55.79,
      "duration_seconds": 4.27,
      "text": "Are you taking anything regularly, including from the pharmacy?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 57.1,
      "end_seconds": 69.92,
      "duration_seconds": 12.82,
      "text": "Valsartan. I take it 80 milligrams, once a day for my blood pressure. Oh, I'm on Foracort inhaler, twice a day."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 70.77,
      "end_seconds": 79.32,
      "duration_seconds": 8.55,
      "text": "It's meant to be twice a day, though I don't see he take it every time."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 80.0,
      "end_seconds": 86.33,
      "duration_seconds": 6.33,
      "text": "Well, uh, I used to take amlodipine, but I stopped it."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 87.32,
      "end_seconds": 91.24,
      "duration_seconds": 3.92,
      "text": "So, how long has this been bothering you?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 92.74,
      "end_seconds": 95.58,
      "duration_seconds": 2.84,
      "text": "For two years, I'd say."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 96.1,
      "end_seconds": 98.96,
      "duration_seconds": 2.86,
      "text": "Would you say mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 100.78,
      "end_seconds": 103.46,
      "duration_seconds": 2.68,
      "text": "It's, It's moderate, honestly."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 104.45,
      "end_seconds": 112.88,
      "duration_seconds": 8.43,
      "text": "Hmm, and the other thing I wanted to mention is that I can't really—"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 112.98,
      "end_seconds": 118.67,
      "duration_seconds": 5.69,
      "text": "Tell the doctor about the other thing, that's what worries me."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 120.01,
      "end_seconds": 122.98,
      "duration_seconds": 2.97,
      "text": "I was getting to that!"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 123.57,
      "end_seconds": 127.62,
      "duration_seconds": 4.05,
      "text": "That's fine, one at a time. I'll ask about everything."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 128.23,
      "end_seconds": 134.43,
      "duration_seconds": 6.2,
      "text": "Right, and there's a hoarse voice as well, three weeks now."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_4",
      "role": "UNKNOWN",
      "start_seconds": 136.16,
      "end_seconds": 139.82,
      "duration_seconds": 3.66,
      "text": "Yes, that's right, that's how it was."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 140.35,
      "end_seconds": 145.09,
      "duration_seconds": 4.74,
      "text": "Let me check a few things. Any heartburn or fever?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 146.81,
      "end_seconds": 159.33,
      "duration_seconds": 12.52,
      "text": "No, uh, no heartburn, no fever. I did have a little breathlessness at one point, but that went away on its own."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 161.1,
      "end_seconds": 166.12,
      "duration_seconds": 5.02,
      "text": "Have you noticed coughing up blood, wheeze, chest pain or weight loss?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 167.58,
      "end_seconds": 177.53,
      "duration_seconds": 9.95,
      "text": "Well, uh, no coughing up blood, wheeze, chest pain or weight loss, none of it."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 179.39,
      "end_seconds": 180.77,
      "duration_seconds": 1.38,
      "text": "Neurologically, anything strange?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 181.71,
      "end_seconds": 184.8,
      "duration_seconds": 3.09,
      "text": "Erm, no, nothing like that."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 185.43,
      "end_seconds": 187.43,
      "duration_seconds": 2.0,
      "text": "Is your digestion otherwise okay?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 189.17,
      "end_seconds": 193.57,
      "duration_seconds": 4.4,
      "text": "Let me think, bowels are regular, nothing odd."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 211.71,
      "end_seconds": 216.09,
      "duration_seconds": 4.38,
      "text": "Any inherited conditions that you know of in the family?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 216.94,
      "end_seconds": 223.03,
      "duration_seconds": 6.09,
      "text": "My daughter has type 1 diabetes. My father has Parkinson's disease."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 241.26,
      "end_seconds": 244.14,
      "duration_seconds": 2.88,
      "text": "What operations have you had, if any?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 246.22,
      "end_seconds": 250.14,
      "duration_seconds": 3.92,
      "text": "Just a bunion operation, six years ago."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 250.95,
      "end_seconds": 254.65,
      "duration_seconds": 3.7,
      "text": "Are there any allergies I should be aware of?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 256.69,
      "end_seconds": 267.2,
      "duration_seconds": 10.51,
      "text": "I think I reacted to some antibiotic once, years ago. I don't remember which one, or what happened exactly."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 268.75,
      "end_seconds": 272.46,
      "duration_seconds": 3.71,
      "text": "Anything in your past medical history I should know?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 273.85,
      "end_seconds": 282.63,
      "duration_seconds": 8.78,
      "text": "Yes, high blood pressure. I've, I've had acid reflux for two years now. I've had asthma, yes."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 284.66,
      "end_seconds": 291.87,
      "duration_seconds": 7.21,
      "text": "Mm-hmm. Okay, I can see high blood pressure and asthma in your file as well. Any smoking?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 296.24,
      "end_seconds": 300.63,
      "duration_seconds": 4.39,
      "text": "I smoke roughly a pack every two days."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 302.03,
      "end_seconds": 303.35,
      "duration_seconds": 1.32,
      "text": "What about alcohol?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 303.9,
      "end_seconds": 309.64,
      "duration_seconds": 5.74,
      "text": "I used to drink heavily but I stopped four years ago."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 310.92,
      "end_seconds": 313.13,
      "duration_seconds": 2.21,
      "text": "Is there someone at home?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 313.77,
      "end_seconds": 318.4,
      "duration_seconds": 4.63,
      "text": "My husband and I live above the shop."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_5",
      "role": "NURSE",
      "start_seconds": 319.14,
      "end_seconds": 327.78,
      "duration_seconds": 8.64,
      "text": "Doctor, I've got the readings for you. Pressure 118 over 76, pulse 79, temperature 36.6, respiratory rate 15, saturation 98 percent."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 329.37,
      "end_seconds": 330.07,
      "duration_seconds": 0.7,
      "text": "Thanks."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 332.13,
      "end_seconds": 335.9,
      "duration_seconds": 3.77,
      "text": "Right, let's have a proper look at you."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 336.45,
      "end_seconds": 338.23,
      "duration_seconds": 1.78,
      "text": "Yeah, no problem."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 339.48,
      "end_seconds": 342.38,
      "duration_seconds": 2.9,
      "text": "I'll listen to your chest now."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 352.69,
      "end_seconds": 356.4,
      "duration_seconds": 3.71,
      "text": "Your chest is clear and there is no wheeze."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 358.93,
      "end_seconds": 387.13,
      "duration_seconds": 28.2,
      "text": "That's the examination finished. So where does that leave us? I think we're dealing with a persistent dry cough without a clear cause so far at this stage. It could also be reflux, so we'll keep that open. I'd like to arrange a breathing test for cough. I think a chest X-ray makes sense here, for chronic cough."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 389.04,
      "end_seconds": 390.28,
      "duration_seconds": 1.24,
      "text": "Right, understood."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 391.92,
      "end_seconds": 398.7,
      "duration_seconds": 6.78,
      "text": "We will review your tablets and see whether the cough settles over a month."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 399.1,
      "end_seconds": 407.02,
      "duration_seconds": 7.92,
      "text": "Yes, carry on. If you cough up blood or lose weight, that's the point to come in urgently."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 407.86,
      "end_seconds": 411.43,
      "duration_seconds": 3.57,
      "text": "Thank you, uh, that's clear."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 412.47,
      "end_seconds": 414.86,
      "duration_seconds": 2.39,
      "text": "Let's review you in six weeks."
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 416.88,
      "end_seconds": 418.99,
      "duration_seconds": 2.11,
      "text": "Alright, I'll be back."
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 420.23,
      "end_seconds": 422.83,
      "duration_seconds": 2.6,
      "text": "Have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 423.64,
      "end_seconds": 428.11,
      "duration_seconds": 4.47,
      "text": "Hmm, uh, alright, thanks, take care."
    },
    {
      "segment_id": "SEG0059",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 432.63,
      "end_seconds": 433.91,
      "duration_seconds": 1.28,
      "text": "See you soon."
    }
  ]
}