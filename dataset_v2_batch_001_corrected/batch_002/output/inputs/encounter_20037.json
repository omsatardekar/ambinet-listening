  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.22,
      "end_seconds": 7.23,
      "duration_seconds": 6.01,
      "text": "Right doctor? Hello I hope this is the right time."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 9.04,
      "end_seconds": 12.94,
      "duration_seconds": 3.9,
      "text": "yes have a seat tell me what's going on"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 13.76,
      "end_seconds": 17.97,
      "duration_seconds": 4.21,
      "text": "Yeah I'm here cos of a twisted ankle."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 19.9,
      "end_seconds": 23.28,
      "duration_seconds": 3.38,
      "text": "when was the first time you noticed it?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 27.58,
      "end_seconds": 40.56,
      "duration_seconds": 12.98,
      "text": "I'd say five days. Actually, um, no, closer to three days. My sister suggested writing things down, but I forgot."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 41.8,
      "end_seconds": 44.18,
      "duration_seconds": 2.38,
      "text": "Any other symptoms with it?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 46.09,
      "end_seconds": 57.88,
      "duration_seconds": 11.79,
      "text": "A feeling of the ankle giving way goes along with it, most of the time. I've also had pain walking, since last Tuesday."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 58.83,
      "end_seconds": 60.84,
      "duration_seconds": 2.01,
      "text": "How frequently does it come?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 62.21,
      "end_seconds": 64.36,
      "duration_seconds": 2.15,
      "text": "Honestly, every other day."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 65.95,
      "end_seconds": 72.96,
      "duration_seconds": 7.01,
      "text": "any knee pain, pain at the base of the fifth toe or numbness in the foot?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 73.59,
      "end_seconds": 75.89,
      "duration_seconds": 2.3,
      "text": "nope, nothing like that"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 76.99,
      "end_seconds": 81.44,
      "duration_seconds": 4.45,
      "text": "and what about cracking sound at the time or calf pain?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 82.68,
      "end_seconds": 85.57,
      "duration_seconds": 2.89,
      "text": "Nope uh nothing like that."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 90.26,
      "end_seconds": 93.5,
      "duration_seconds": 3.24,
      "text": "anything with your nerves like weakness or numbness?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 94.67,
      "end_seconds": 97.54,
      "duration_seconds": 2.87,
      "text": "ah no nothing like that"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 112.11,
      "end_seconds": 115.05,
      "duration_seconds": 2.94,
      "text": "A few questions about your lifestyle now."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 116.13,
      "end_seconds": 129.04,
      "duration_seconds": 12.91,
      "text": "I do a yoga class on Thursdays. I drink a lot of tea and snack through the day. I'm a hairdresser, on my feet all day."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 147.52,
      "end_seconds": 152.12,
      "duration_seconds": 4.6,
      "text": "Has anything ever caused you a reaction? I mean any allergies."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 152.96,
      "end_seconds": 159.41,
      "duration_seconds": 6.45,
      "text": "Hmm I'm allergic to walnuts I get my lips swelling."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 160.09,
      "end_seconds": 164.57,
      "duration_seconds": 4.48,
      "text": "What about your parents, brothers or sisters, any conditions?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 165.58,
      "end_seconds": 167.98,
      "duration_seconds": 2.4,
      "text": "My brother has epilepsy."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 169.55,
      "end_seconds": 174.81,
      "duration_seconds": 5.26,
      "text": "What conditions have you been treated for in the the past?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 176.14,
      "end_seconds": 178.91,
      "duration_seconds": 2.77,
      "text": "I've got an underactive thyroid."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 179.79,
      "end_seconds": 190.43,
      "duration_seconds": 10.64,
      "text": "Alright, an underactive thyroid, that matches what I have here. Tell me your medicines, please. Bear with me, I'm just building up the picture."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 191.11,
      "end_seconds": 195.19,
      "duration_seconds": 4.08,
      "text": "It's Eltroxin, 100 micrograms, maybe, every morning."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 196.49,
      "end_seconds": 201.05,
      "duration_seconds": 4.56,
      "text": "have you got the box or the the prescription on you?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 202.7,
      "end_seconds": 206.74,
      "duration_seconds": 4.04,
      "text": "Not with me. I'll bring it next time."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 218.8,
      "end_seconds": 221.98,
      "duration_seconds": 3.18,
      "text": "I'll just record a few vital signs."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 228.01,
      "end_seconds": 230.34,
      "duration_seconds": 2.33,
      "text": "sit still for a moment.."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 243.65,
      "end_seconds": 251.2,
      "duration_seconds": 7.55,
      "text": "okay: temperature 36.5, oxygen saturation is 97 percent, BP is 126 over 73, heart rate 83."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 251.94,
      "end_seconds": 254.56,
      "duration_seconds": 2.62,
      "text": "yeah is that alright doctor?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 256.9,
      "end_seconds": 259.83,
      "duration_seconds": 2.93,
      "text": "I'll come back to the numbers."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 262.39,
      "end_seconds": 265.94,
      "duration_seconds": 3.55,
      "text": "okay, time for me to examine you"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 267.36,
      "end_seconds": 268.56,
      "duration_seconds": 1.2,
      "text": "Of course."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 269.75,
      "end_seconds": 272.05,
      "duration_seconds": 2.3,
      "text": "I'm just checking this side."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 288.96,
      "end_seconds": 297.97,
      "duration_seconds": 9.01,
      "text": "there is swelling and bruising over the outer ankle and I can't find any bony tenderness at the back of the ankle bone"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 303.36,
      "end_seconds": 322.16,
      "duration_seconds": 18.8,
      "text": "you can sit up now okay thinking it through the most likely explanation is an ankle sprain without signs of a fracture i wanna be honest that this is an impression not a final answer i can't rule out a tendon injury yet"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 323.42,
      "end_seconds": 325.5,
      "duration_seconds": 2.08,
      "text": "Is this serious, doctor?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 327.34,
      "end_seconds": 361.42,
      "duration_seconds": 34.08,
      "text": "Nothing I've seen today points to an emergency. It looks like an ankle sprain without signs of a fracture, but I'd like to confirm. An ankle X-ray is what I'd like next, for ankle injury. I'll start you on paracetamol, 1 gram, every six hours if needed, for five days. It's for ankle pain. Rest, ice, a a firm bandage and keep it raised, and start gentle movement after two days."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 362.51,
      "end_seconds": 382.18,
      "duration_seconds": 19.67,
      "text": "I'd like you to see physiotherapy as well, and I'll write the referral. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose. Come back if it isn't better in a week."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 383.21,
      "end_seconds": 386.43,
      "duration_seconds": 3.22,
      "text": "yeah, okay, I'll arrange it it"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 388.01,
      "end_seconds": 390.37,
      "duration_seconds": 2.36,
      "text": "have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 392.35,
      "end_seconds": 394.84,
      "duration_seconds": 2.49,
      "text": "alright, thanks, take care"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 396.57,
      "end_seconds": 397.83,
      "duration_seconds": 1.26,
      "text": "See you soon."
    }
  ]
