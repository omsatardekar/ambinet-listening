  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.23,
      "end_seconds": 7.6,
      "duration_seconds": 6.37,
      "text": "So, hi, doctor, I came as soon as they called me."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.77,
      "end_seconds": 12.94,
      "duration_seconds": 4.17,
      "text": "Of course, leave it there. How can I help?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 14.93,
      "end_seconds": 18.08,
      "duration_seconds": 3.15,
      "text": "I've, I've been feeling full quickly."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 18.78,
      "end_seconds": 22.63,
      "duration_seconds": 3.85,
      "text": "So, how long has this been bothering you?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 24.09,
      "end_seconds": 28.48,
      "duration_seconds": 4.39,
      "text": "It's been about a week, I'm fairly sure."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 29.82,
      "end_seconds": 33.18,
      "duration_seconds": 3.36,
      "text": "Right, is it bearing on you a lot?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 33.95,
      "end_seconds": 40.21,
      "duration_seconds": 6.26,
      "text": "I'd call it moderate. I've been belching too, for one week."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 42.29,
      "end_seconds": 45.93,
      "duration_seconds": 3.64,
      "text": "Have you had burning pain in the upper tummy?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 47.7,
      "end_seconds": 56.79,
      "duration_seconds": 9.09,
      "text": "Yeah, that too. As for burning pain in the upper tummy, only antacids, and it's not much."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 58.79,
      "end_seconds": 63.5,
      "duration_seconds": 4.71,
      "text": "Have you been feeling full quickly at any time before this?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 64.02,
      "end_seconds": 71.13,
      "duration_seconds": 7.11,
      "text": "I had a similar thing a couple of years ago. It went away."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 72.54,
      "end_seconds": 76.03,
      "duration_seconds": 3.49,
      "text": "Did you get chest pain or vomiting blood?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 77.17,
      "end_seconds": 79.21,
      "duration_seconds": 2.04,
      "text": "None of those, no."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 80.29,
      "end_seconds": 84.45,
      "duration_seconds": 4.16,
      "text": "Did you get weight loss, black stools or difficulty swallowing?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 85.58,
      "end_seconds": 92.71,
      "duration_seconds": 7.13,
      "text": "Oh, I haven't had weight loss, black stools or difficulty swallowing, no."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 93.86,
      "end_seconds": 97.87,
      "duration_seconds": 4.01,
      "text": "Alright, how about your heart, any problems like that?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 99.28,
      "end_seconds": 102.53,
      "duration_seconds": 3.25,
      "text": "No, uh, that's been fine."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 103.91,
      "end_seconds": 107.62,
      "duration_seconds": 3.71,
      "text": "Anything on the skin I should know about?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 109.54,
      "end_seconds": 110.44,
      "duration_seconds": 0.9,
      "text": "Skin's normal."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 111.92,
      "end_seconds": 116.42,
      "duration_seconds": 4.5,
      "text": "Are you allergic to anything? Any allergies to medicines or foods?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 118.49,
      "end_seconds": 120.81,
      "duration_seconds": 2.32,
      "text": "Grass pollen, I'd say."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 121.78,
      "end_seconds": 126.04,
      "duration_seconds": 4.26,
      "text": "Can you list what you take, tablets, creams or inhalers?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 127.38,
      "end_seconds": 138.04,
      "duration_seconds": 10.66,
      "text": "I'm on diclofenac, 50 milligrams, when needed. Antacid, when needed. I'd rather know what's going on than keep guessing."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 138.54,
      "end_seconds": 141.74,
      "duration_seconds": 3.2,
      "text": "A few questions about your lifestyle now."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 142.67,
      "end_seconds": 153.44,
      "duration_seconds": 10.77,
      "text": "I live with my elderly mother. Yes, I work in a bakery, early starts. Lots of rice, lentils and some fruit."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 160.69,
      "end_seconds": 162.78,
      "duration_seconds": 2.09,
      "text": "What about your medical history?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 164.69,
      "end_seconds": 170.49,
      "duration_seconds": 5.8,
      "text": "I, I have arthritis in my knees, for about ten years."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 171.25,
      "end_seconds": 178.29,
      "duration_seconds": 7.04,
      "text": "I follow. Okay, yes, arthritis in your knees is known to us, good to have that clear."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 190.09,
      "end_seconds": 193.03,
      "duration_seconds": 2.94,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 194.0,
      "end_seconds": 195.67,
      "duration_seconds": 1.67,
      "text": "No surgery, no."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 197.51,
      "end_seconds": 207.49,
      "duration_seconds": 9.98,
      "text": "Doctor, I've got the readings for you. Temperature is 36.9 degrees, heart rate 82, blood pressure 123 over 79, SpO2 99 percent on room air."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 208.92,
      "end_seconds": 209.62,
      "duration_seconds": 0.7,
      "text": "Thanks."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 212.29,
      "end_seconds": 214.7,
      "duration_seconds": 2.41,
      "text": "Let's move on to the examination."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 230.42,
      "end_seconds": 231.55,
      "duration_seconds": 1.13,
      "text": "Okay, doctor."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 232.76,
      "end_seconds": 234.48,
      "duration_seconds": 1.72,
      "text": "Alright, look straight ahead."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 252.76,
      "end_seconds": 257.44,
      "duration_seconds": 4.68,
      "text": "Your tummy is soft with some tenderness in the upper middle part."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 260.55,
      "end_seconds": 276.29,
      "duration_seconds": 15.74,
      "text": "Right, please sit back down. Let me tell you where I've got to. It's hard to say. Dyspepsia possibly related to anti-inflammatory tablets is one possibility and a stomach ulcer another, and I'd rather not commit yet."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 276.96,
      "end_seconds": 280.07,
      "duration_seconds": 3.11,
      "text": "What are the odds it's serious?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 280.62,
      "end_seconds": 308.28,
      "duration_seconds": 27.66,
      "text": "I can't promise yet, but most people with dyspepsia possibly related to anti-inflammatory tablets do well once it's treated properly. Let's book blood tests to look into dyspepsia. Let's use omeprazole, 20 milligrams, once a day, for four weeks. You take it by mouth. That should help with stomach acid. Please stop taking the anti-inflammatory tablets for now and use paracetamol for the pain."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 309.89,
      "end_seconds": 315.4,
      "duration_seconds": 5.51,
      "text": "Can you send me for a test for the stomach germ?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 316.56,
      "end_seconds": 323.85,
      "duration_seconds": 7.29,
      "text": "Not right now, it wouldn't change what we do today. Let's review you after the test result."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 328.61,
      "end_seconds": 331.93,
      "duration_seconds": 3.32,
      "text": "I'll book it on my way out."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 333.74,
      "end_seconds": 336.98,
      "duration_seconds": 3.24,
      "text": "I think we're done unless you have questions."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 339.93,
      "end_seconds": 341.62,
      "duration_seconds": 1.69,
      "text": "That's clear, thanks."
    }
  ]
