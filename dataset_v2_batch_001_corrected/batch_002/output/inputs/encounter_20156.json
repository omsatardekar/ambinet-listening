{
  "schema_version": "1.0",
  "encounter_id": "20156",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.5,
      "end_seconds": 5.45,
      "duration_seconds": 4.95,
      "text": "Hello, take a seat, I'll be with you in a second."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "CAREGIVER",
      "start_seconds": 6.04,
      "end_seconds": 11.81,
      "duration_seconds": 5.77,
      "text": "Hello, doctor. I hope it's alright if I stay in for this."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 13.52,
      "end_seconds": 19.91,
      "duration_seconds": 6.39,
      "text": "Please do. Extra information is always welcome. So what can I do for you?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "CAREGIVER",
      "start_seconds": 21.52,
      "end_seconds": 25.77,
      "duration_seconds": 4.25,
      "text": "She's been having a lump in my armpit, doctor."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 26.66,
      "end_seconds": 29.99,
      "duration_seconds": 3.33,
      "text": "How long has this been bothering you?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 31.95,
      "end_seconds": 34.77,
      "duration_seconds": 2.82,
      "text": "Around about a month, I think."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "CAREGIVER",
      "start_seconds": 36.18,
      "end_seconds": 40.96,
      "duration_seconds": 4.78,
      "text": "I think it's been nearer about two months, actually."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 42.12,
      "end_seconds": 46.25,
      "duration_seconds": 4.13,
      "text": "Okay, so roughly one to two months. Is that right?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 48.33,
      "end_seconds": 53.55,
      "duration_seconds": 5.22,
      "text": "I suppose so, um, yes. And itching all over, too."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 54.95,
      "end_seconds": 58.52,
      "duration_seconds": 3.57,
      "text": "Have you had a low fever in the evenings?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 60.84,
      "end_seconds": 64.29,
      "duration_seconds": 3.45,
      "text": "Yes, about the same, about four days."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 65.32,
      "end_seconds": 68.2,
      "duration_seconds": 2.88,
      "text": "Is it bearing on you a lot?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 70.12,
      "end_seconds": 71.89,
      "duration_seconds": 1.77,
      "text": "It's severe, honestly."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 72.15,
      "end_seconds": 73.23,
      "duration_seconds": 1.08,
      "text": "Hm, okay."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 74.0,
      "end_seconds": 77.39,
      "duration_seconds": 3.39,
      "text": "There's drenching night sweats as well."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 85.72,
      "end_seconds": 88.83,
      "duration_seconds": 3.11,
      "text": "Did you get cough or recent travel?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 90.55,
      "end_seconds": 92.88,
      "duration_seconds": 2.33,
      "text": "None of those, no."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 93.81,
      "end_seconds": 98.73,
      "duration_seconds": 4.92,
      "text": "Have you had any chest pain, joint pain or diarrhoea?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 99.82,
      "end_seconds": 101.78,
      "duration_seconds": 1.96,
      "text": "None of those, no."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 102.76,
      "end_seconds": 105.11,
      "duration_seconds": 2.35,
      "text": "Is your mobility otherwise okay?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 106.6,
      "end_seconds": 108.38,
      "duration_seconds": 1.78,
      "text": "No, nothing there."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 109.01,
      "end_seconds": 111.54,
      "duration_seconds": 2.53,
      "text": "What's on your current medicine list?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "CAREGIVER",
      "start_seconds": 112.21,
      "end_seconds": 120.31,
      "duration_seconds": 8.1,
      "text": "She is on rosuvastatin, 10 milligrams, at night for my cholesterol, I give it to her."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 122.38,
      "end_seconds": 126.59,
      "duration_seconds": 4.21,
      "text": "What about your parents, brothers or sisters, any conditions?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 128.05,
      "end_seconds": 134.17,
      "duration_seconds": 6.12,
      "text": "Um, my mother had a stroke. Uh, my son has asthma."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 134.93,
      "end_seconds": 136.13,
      "duration_seconds": 1.2,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 136.86,
      "end_seconds": 139.03,
      "duration_seconds": 2.17,
      "text": "No, not at all."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 139.82,
      "end_seconds": 144.67,
      "duration_seconds": 4.85,
      "text": "Tell me about your routine, work, habits, that sort of thing."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 148.56,
      "end_seconds": 159.29,
      "duration_seconds": 10.73,
      "text": "Yes, I work in a bakery, early starts. I swim twice a week. I grab fast food at lunch most days."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 172.85,
      "end_seconds": 180.27,
      "duration_seconds": 7.42,
      "text": "Do you react to any medicines or foods? Any allergies? These questions might sound routine, but they matter."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 180.92,
      "end_seconds": 185.72,
      "duration_seconds": 4.8,
      "text": "No, um, nothing as far as I know."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "CAREGIVER",
      "start_seconds": 189.19,
      "end_seconds": 196.6,
      "duration_seconds": 7.41,
      "text": "Hold on, doctor, I think she reacted to naproxen once. I'm not certain, though."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 197.63,
      "end_seconds": 199.76,
      "duration_seconds": 2.13,
      "text": "I don't remember that."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 204.61,
      "end_seconds": 210.14,
      "duration_seconds": 5.53,
      "text": "Okay, I'll note both of those. Alright, do you have any chronic illnesses?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 212.05,
      "end_seconds": 214.67,
      "duration_seconds": 2.62,
      "text": "I've had high cholesterol, yes."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 215.76,
      "end_seconds": 226.0,
      "duration_seconds": 10.24,
      "text": "Right, so high cholesterol is already on your record. We'll keep that in mind today. So, I'll just record a few vital signs."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 239.57,
      "end_seconds": 242.31,
      "duration_seconds": 2.74,
      "text": "That's it, just a little longer..."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 264.06,
      "end_seconds": 269.18,
      "duration_seconds": 5.12,
      "text": "Okay: pulse 101, respiratory rate 16, pressure 118 over 72."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 271.91,
      "end_seconds": 275.93,
      "duration_seconds": 4.02,
      "text": "Okay, could you come over to the couch, please?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 292.21,
      "end_seconds": 293.89,
      "duration_seconds": 1.68,
      "text": "Fine by me."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 295.8,
      "end_seconds": 298.56,
      "duration_seconds": 2.76,
      "text": "Stay as you are for a moment."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 316.82,
      "end_seconds": 318.77,
      "duration_seconds": 1.95,
      "text": "I can't feel your spleen."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 320.3,
      "end_seconds": 322.05,
      "duration_seconds": 1.75,
      "text": "Let me feel here."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 329.24,
      "end_seconds": 335.7,
      "duration_seconds": 6.46,
      "text": "There's a firm, rubbery gland about two centimetres in the left armpit, not tender."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 340.91,
      "end_seconds": 371.29,
      "duration_seconds": 30.38,
      "text": "Thank you, you can get dressed. Okay, thinking it through, I'd lean towards an enlarged gland with night sweats that needs a proper work-up. It could also be a lingering infection, so we'll keep that open. An ultrasound of the armpit is what I'd like next, for lymph node. That will help us see what's going on underneath and decide the next step."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 372.52,
      "end_seconds": 373.62,
      "duration_seconds": 1.1,
      "text": "Right, understood."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 374.17,
      "end_seconds": 378.79,
      "duration_seconds": 4.62,
      "text": "I'm sending you for blood tests because of night sweats."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 380.62,
      "end_seconds": 383.09,
      "duration_seconds": 2.47,
      "text": "Do I need to prepare?"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 388.69,
      "end_seconds": 393.96,
      "duration_seconds": 5.27,
      "text": "A chest X-ray is what I'd like next, for night sweats."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 395.61,
      "end_seconds": 398.35,
      "duration_seconds": 2.74,
      "text": "Where would I go for that?"
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 399.26,
      "end_seconds": 413.65,
      "duration_seconds": 14.39,
      "text": "Keep a note of your temperature each evening. Please don't wait if the symptoms get worse. That's when to be seen urgently. I'll want another look in a week. Anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 414.77,
      "end_seconds": 418.65,
      "duration_seconds": 3.88,
      "text": "So, no, that's all. Thanks a lot."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 420.46,
      "end_seconds": 422.21,
      "duration_seconds": 1.75,
      "text": "Have a good day."
    }
  ]
}