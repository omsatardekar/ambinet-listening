{
  "schema_version": "1.0",
  "encounter_id": "20436",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.19,
      "end_seconds": 5.09,
      "duration_seconds": 3.9,
      "text": "Hello, doctor. I think it's my turn."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.15,
      "end_seconds": 11.41,
      "duration_seconds": 4.26,
      "text": "Okay, of course, leave it there. How can I help?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 12.26,
      "end_seconds": 18.28,
      "duration_seconds": 6.02,
      "text": "Doctor, I've come along because I know the history, if it helps."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 22.89,
      "end_seconds": 30.41,
      "duration_seconds": 7.52,
      "text": "I'm here because of a tight feeling in my chest when I walk uphill."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 35.29,
      "end_seconds": 38.24,
      "duration_seconds": 2.95,
      "text": "How long has this been bothering you?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 39.37,
      "end_seconds": 43.3,
      "duration_seconds": 3.93,
      "text": "I've had it for about a year."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 45.39,
      "end_seconds": 49.39,
      "duration_seconds": 4.0,
      "text": "Rate it for me, mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 50.29,
      "end_seconds": 53.21,
      "duration_seconds": 2.92,
      "text": "About a five out of ten."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 53.86,
      "end_seconds": 55.43,
      "duration_seconds": 1.57,
      "text": "Anything that improves it?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 56.47,
      "end_seconds": 60.22,
      "duration_seconds": 3.75,
      "text": "I get some relief from stopping and resting."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 63.24,
      "end_seconds": 66.09,
      "duration_seconds": 2.85,
      "text": "Does anything else come with it?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 66.85,
      "end_seconds": 79.92,
      "duration_seconds": 13.07,
      "text": "A heaviness in my left arm goes along with it, most of the time. Right, as for heaviness in my left arm, resting helps a bit."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 97.02,
      "end_seconds": 101.34,
      "duration_seconds": 4.32,
      "text": "Any inherited conditions that you know of in the family?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 102.45,
      "end_seconds": 105.32,
      "duration_seconds": 2.87,
      "text": "Oh, my grandfather had a stroke."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 107.41,
      "end_seconds": 110.2,
      "duration_seconds": 2.79,
      "text": "Has anyone ever diagnosed you with something?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 111.33,
      "end_seconds": 116.41,
      "duration_seconds": 5.08,
      "text": "I've had high blood pressure for five years now."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 118.04,
      "end_seconds": 118.74,
      "duration_seconds": 0.7,
      "text": "Yes."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 120.3,
      "end_seconds": 132.97,
      "duration_seconds": 12.67,
      "text": "I have diabetes. I'm hoping you can tell me something definite. I wasn't sure whether to come in at all, to be honest."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 134.69,
      "end_seconds": 137.89,
      "duration_seconds": 3.2,
      "text": "Do you take any prescribed or over-the-counter medicines?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 141.85,
      "end_seconds": 158.11,
      "duration_seconds": 16.26,
      "text": "I'm on lisinopril, 10 milligrams, once a day for my pressure. I've been reading about it online and it worried me. Glimepiride. I take it 2 milligrams, before breakfast for my sugar."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 159.28,
      "end_seconds": 161.62,
      "duration_seconds": 2.34,
      "text": "Have you got any known allergies?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 165.45,
      "end_seconds": 168.38,
      "duration_seconds": 2.93,
      "text": "No, not that I know of."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 169.24,
      "end_seconds": 172.28,
      "duration_seconds": 3.04,
      "text": "Are you on your own at home?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 173.51,
      "end_seconds": 176.21,
      "duration_seconds": 2.7,
      "text": "I live with my elderly mother."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 177.98,
      "end_seconds": 179.77,
      "duration_seconds": 1.79,
      "text": "How active are you?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 180.67,
      "end_seconds": 184.21,
      "duration_seconds": 3.54,
      "text": "I hardly move around during the day."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 185.05,
      "end_seconds": 188.27,
      "duration_seconds": 3.22,
      "text": "What line of work are you in?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 189.03,
      "end_seconds": 194.21,
      "duration_seconds": 5.18,
      "text": "I'm a bus driver, so I sit for long hours."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 196.02,
      "end_seconds": 202.02,
      "duration_seconds": 6.0,
      "text": "Have you had any cough, palpitations or pain between the shoulder blades?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 203.31,
      "end_seconds": 209.72,
      "duration_seconds": 6.41,
      "text": "I haven't had cough, palpitations or pain between the shoulder blades, no."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 210.56,
      "end_seconds": 213.61,
      "duration_seconds": 3.05,
      "text": "And pain at rest, any of that?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 215.42,
      "end_seconds": 218.28,
      "duration_seconds": 2.86,
      "text": "Nope, no pain at rest."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 219.92,
      "end_seconds": 222.08,
      "duration_seconds": 2.16,
      "text": "Your breathing, any trouble there?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 223.73,
      "end_seconds": 226.35,
      "duration_seconds": 2.62,
      "text": "No, my breathing's been fine."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 227.94,
      "end_seconds": 230.08,
      "duration_seconds": 2.14,
      "text": "Any trouble with the waterworks?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 231.99,
      "end_seconds": 233.56,
      "duration_seconds": 1.57,
      "text": "No changes there."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 235.53,
      "end_seconds": 237.6,
      "duration_seconds": 2.07,
      "text": "I'll do your observations first."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 248.43,
      "end_seconds": 250.86,
      "duration_seconds": 2.43,
      "text": "Okay, this won't take long..."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 272.02,
      "end_seconds": 281.26,
      "duration_seconds": 9.24,
      "text": "Okay: SpO2 99 percent on room air, pressure 120 over 81, temp 36.7 degrees. And pulse is 86 beats a minute."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 290.39,
      "end_seconds": 302.7,
      "duration_seconds": 12.31,
      "text": "Let me tell you where I've got to. My working impression is exertional angina until proven otherwise. I'd also keep reflux-related chest pain in mind."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 304.25,
      "end_seconds": 306.39,
      "duration_seconds": 2.14,
      "text": "Will it clear up?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 307.32,
      "end_seconds": 317.31,
      "duration_seconds": 9.99,
      "text": "I understand the worry. At the moment I'd say it's exertional angina until proven otherwise, and we'll watch how it goes."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 327.39,
      "end_seconds": 330.78,
      "duration_seconds": 3.39,
      "text": "We'll refer you to the cardiology clinic."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 332.56,
      "end_seconds": 334.07,
      "duration_seconds": 1.51,
      "text": "Alright, thank you."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 335.43,
      "end_seconds": 344.92,
      "duration_seconds": 9.49,
      "text": "I'd like to see you again in two weeks. Right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 346.98,
      "end_seconds": 350.29,
      "duration_seconds": 3.31,
      "text": "Good, thanks, I'll see you then."
    }
  ]
}