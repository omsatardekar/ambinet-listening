{
  "schema_version": "1.0",
  "encounter_id": "20070",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.32,
      "end_seconds": 4.34,
      "duration_seconds": 3.02,
      "text": "Sorry, doctor, shall I sit here?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.22,
      "end_seconds": 10.61,
      "duration_seconds": 4.39,
      "text": "You're alright, take a seat. What can I do for you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 12.48,
      "end_seconds": 16.61,
      "duration_seconds": 4.13,
      "text": "I wanted to get a pounding heart looked at."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 17.94,
      "end_seconds": 20.29,
      "duration_seconds": 2.35,
      "text": "What's on your current medicine list?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 21.89,
      "end_seconds": 29.59,
      "duration_seconds": 7.7,
      "text": "Sitagliptin. I take it 100 milligrams, once a day. I've never really been one for hospitals."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 42.21,
      "end_seconds": 45.4,
      "duration_seconds": 3.19,
      "text": "Has this been going on for long?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 50.79,
      "end_seconds": 54.69,
      "duration_seconds": 3.9,
      "text": "Yesterday, it came on out of nowhere."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 55.64,
      "end_seconds": 63.75,
      "duration_seconds": 8.11,
      "text": "Can you describe it a bit more for me? How strong it is, what the pattern is, what helps."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 65.67,
      "end_seconds": 71.38,
      "duration_seconds": 5.71,
      "text": "Uh, I'd call it moderate. It's once or twice a day."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 72.51,
      "end_seconds": 75.55,
      "duration_seconds": 3.04,
      "text": "Any blurred vision, chest pain or vomiting?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 76.93,
      "end_seconds": 78.88,
      "duration_seconds": 1.95,
      "text": "Nope, nothing like that."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 80.73,
      "end_seconds": 82.36,
      "duration_seconds": 1.63,
      "text": "How's your breathing otherwise?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 82.96,
      "end_seconds": 85.87,
      "duration_seconds": 2.91,
      "text": "No, my breathing's been fine."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 94.61,
      "end_seconds": 99.53,
      "duration_seconds": 4.92,
      "text": "Do you react to any medicines or foods? Any allergies?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 101.59,
      "end_seconds": 105.21,
      "duration_seconds": 3.62,
      "text": "Yes, cat fur, it gives me sneezing."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 113.65,
      "end_seconds": 114.97,
      "duration_seconds": 1.32,
      "text": "Are you active?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 115.86,
      "end_seconds": 118.83,
      "duration_seconds": 2.97,
      "text": "I walk the dog every morning."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 120.53,
      "end_seconds": 122.99,
      "duration_seconds": 2.46,
      "text": "Do you follow any particular diet?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 123.81,
      "end_seconds": 127.67,
      "duration_seconds": 3.86,
      "text": "I'm vegetarian and have been for years."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 128.79,
      "end_seconds": 132.48,
      "duration_seconds": 3.69,
      "text": "Tell me about any past illnesses or ongoing conditions."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 138.33,
      "end_seconds": 141.72,
      "duration_seconds": 3.39,
      "text": "I have diabetes, for about ten years."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 143.59,
      "end_seconds": 147.83,
      "duration_seconds": 4.24,
      "text": "Any inherited conditions that you know of in the family?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 148.56,
      "end_seconds": 151.26,
      "duration_seconds": 2.7,
      "text": "My mother had a stroke."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 151.83,
      "end_seconds": 154.23,
      "duration_seconds": 2.4,
      "text": "Let me take your readings now."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 166.87,
      "end_seconds": 168.99,
      "duration_seconds": 2.12,
      "text": "Okay, this won't take long..."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 186.56,
      "end_seconds": 201.19,
      "duration_seconds": 14.63,
      "text": "Okay: height 179 centimetres, temp 37.0 degrees, oxygen saturation is 98 percent, heart rate 85, BMI works out to 24.3, weight 78 kilos, BP is 127 over 72."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 202.12,
      "end_seconds": 204.21,
      "duration_seconds": 2.09,
      "text": "Is that alright, doctor?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 205.53,
      "end_seconds": 208.1,
      "duration_seconds": 2.57,
      "text": "I'll interpret them after the examination."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 210.27,
      "end_seconds": 213.18,
      "duration_seconds": 2.91,
      "text": "Let's move on to the examination."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 224.66,
      "end_seconds": 225.69,
      "duration_seconds": 1.03,
      "text": "Sure thing."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 227.0,
      "end_seconds": 228.23,
      "duration_seconds": 1.23,
      "text": "Look straight ahead."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 243.66,
      "end_seconds": 249.2,
      "duration_seconds": 5.54,
      "text": "Your fingerprick sugar now is normal and your heart rate is steady."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 252.33,
      "end_seconds": 269.88,
      "duration_seconds": 17.55,
      "text": "Alright, all finished, thank you. Having listened and examined, this looks most like episodes of low blood sugar related to diabetes treatment. That's my thinking for now, and it may change as we learn more."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 271.91,
      "end_seconds": 273.87,
      "duration_seconds": 1.96,
      "text": "Is this serious, doctor?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 275.88,
      "end_seconds": 308.26,
      "duration_seconds": 32.38,
      "text": "Nothing I've seen today points to an emergency. It looks like episodes of low blood sugar related to diabetes treatment, but I'd like to confirm. We should do a home sugar diary for hypoglycaemia. Never skip meals when you take the sugar tablet, and keep glucose tablets or juice with you. If you have an episode that does not settle with sugar, or you feel really unwell, please come to the emergency department."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 309.27,
      "end_seconds": 312.69,
      "duration_seconds": 3.42,
      "text": "Yes, I'll bear that in mind."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 314.38,
      "end_seconds": 321.8,
      "duration_seconds": 7.42,
      "text": "I'll want another look after the blood tests. That's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 323.65,
      "end_seconds": 326.06,
      "duration_seconds": 2.41,
      "text": "Alright, thanks, take care."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 327.06,
      "end_seconds": 328.46,
      "duration_seconds": 1.4,
      "text": "Look after yourself."
    }
  ]
}