{
  "schema_version": "1.0",
  "encounter_id": "20335",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.39,
      "end_seconds": 4.26,
      "duration_seconds": 2.87,
      "text": "Hi doctor, am I too early?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.85,
      "end_seconds": 10.01,
      "duration_seconds": 4.16,
      "text": "Come in. Please sit. How can I help you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 10.89,
      "end_seconds": 19.42,
      "duration_seconds": 8.53,
      "text": "Mainly wheezing when I exercise. There's a couple of other things, but that's the main one."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 21.1,
      "end_seconds": 24.49,
      "duration_seconds": 3.39,
      "text": "How long has it been like this?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 26.5,
      "end_seconds": 29.95,
      "duration_seconds": 3.45,
      "text": "I've had it for about four days."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 33.1,
      "end_seconds": 42.04,
      "duration_seconds": 8.94,
      "text": "Can you describe it a bit more for me? How strong it is, what the pattern is, what helps."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 43.3,
      "end_seconds": 58.4,
      "duration_seconds": 15.1,
      "text": "Yes, running. That makes it worse. A seven out of ten, I suppose. Honestly, on and off. Oh, and sneezing a lot. That's been about the same, about two weeks."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 60.29,
      "end_seconds": 64.45,
      "duration_seconds": 4.16,
      "text": "A few quick ones: fever, weight loss or chest pain?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 66.37,
      "end_seconds": 72.15,
      "duration_seconds": 5.78,
      "text": "No fever, weight loss or chest pain, none of it."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 73.96,
      "end_seconds": 75.84,
      "duration_seconds": 1.88,
      "text": "How about blue lips?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 77.24,
      "end_seconds": 79.23,
      "duration_seconds": 1.99,
      "text": "No. No blue lips."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 80.58,
      "end_seconds": 83.43,
      "duration_seconds": 2.85,
      "text": "Is your urine normal, no changes?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 85.02,
      "end_seconds": 86.41,
      "duration_seconds": 1.39,
      "text": "No changes there."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 101.04,
      "end_seconds": 104.94,
      "duration_seconds": 3.9,
      "text": "What about your parents, brothers or sisters, any conditions?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 106.84,
      "end_seconds": 109.25,
      "duration_seconds": 2.41,
      "text": "My father has Parkinson's disease."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 110.14,
      "end_seconds": 115.77,
      "duration_seconds": 5.63,
      "text": "Right, any allergies to tablets, food or anything in the environment?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 120.55,
      "end_seconds": 123.92,
      "duration_seconds": 3.37,
      "text": "No, I've never reacted to anything."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 124.57,
      "end_seconds": 128.26,
      "duration_seconds": 3.69,
      "text": "Do you take any prescribed or over-the-counter medicines?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 129.97,
      "end_seconds": 137.29,
      "duration_seconds": 7.32,
      "text": "It's Asthalin inhaler, when needed. Cetirizine. I take it 10 milligrams, when it flares."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 148.4,
      "end_seconds": 152.98,
      "duration_seconds": 4.58,
      "text": "What conditions have you been treated for in the past?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 154.52,
      "end_seconds": 155.73,
      "duration_seconds": 1.21,
      "text": "Yes, asthma."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 157.11,
      "end_seconds": 159.44,
      "duration_seconds": 2.33,
      "text": "Do you follow any particular diet?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 160.2,
      "end_seconds": 163.56,
      "duration_seconds": 3.36,
      "text": "I'm vegetarian and have been for years."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 165.4,
      "end_seconds": 167.62,
      "duration_seconds": 2.22,
      "text": "Right, who lives with you?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 168.89,
      "end_seconds": 171.29,
      "duration_seconds": 2.4,
      "text": "My partner and our baby."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 173.1,
      "end_seconds": 176.37,
      "duration_seconds": 3.27,
      "text": "I'll note down your vital signs first."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 182.53,
      "end_seconds": 184.62,
      "duration_seconds": 2.09,
      "text": "Sit still for a moment..."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 204.12,
      "end_seconds": 214.47,
      "duration_seconds": 10.35,
      "text": "Okay: temperature is 36.6 degrees, pressure 112 over 68, respiratory rate 17. And saturation 98 percent, pulse is 78 beats a minute."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 215.88,
      "end_seconds": 217.52,
      "duration_seconds": 1.64,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 218.98,
      "end_seconds": 221.67,
      "duration_seconds": 2.69,
      "text": "I'll come back to the numbers."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 222.94,
      "end_seconds": 227.13,
      "duration_seconds": 4.19,
      "text": "Let me look at the area, I'll be gentle."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 229.04,
      "end_seconds": 230.69,
      "duration_seconds": 1.65,
      "text": "Let me feel here."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 248.06,
      "end_seconds": 254.95,
      "duration_seconds": 6.89,
      "text": "I can hear a faint wheeze at the end of breathing out, otherwise the chest is clear."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 259.91,
      "end_seconds": 262.44,
      "duration_seconds": 2.53,
      "text": "Good, you can sit up again."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 270.63,
      "end_seconds": 275.62,
      "duration_seconds": 4.99,
      "text": "Having listened and examined, I'd lean towards exercise-triggered asthma with seasonal allergy."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 276.55,
      "end_seconds": 279.82,
      "duration_seconds": 3.27,
      "text": "What are the odds it's serious?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 280.72,
      "end_seconds": 295.64,
      "duration_seconds": 14.92,
      "text": "I understand the worry. At the moment I'd say it's exercise-triggered asthma with seasonal allergy, and we'll know more once the a breathing test is back. A breathing test is what I'd like next, for wheeze."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 296.36,
      "end_seconds": 298.0,
      "duration_seconds": 1.64,
      "text": "That makes sense."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 298.81,
      "end_seconds": 312.94,
      "duration_seconds": 14.13,
      "text": "I'll start you on budesonide-formoterol inhaler, 200 micrograms, one puff twice a day, long term. That's for asthma control. Rinse your mouth after the preventer inhaler and use the spacer."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 313.35,
      "end_seconds": 325.81,
      "duration_seconds": 12.46,
      "text": "Okay, go on. A peak flow diary is something we might do if this doesn't improve next month. Right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 326.56,
      "end_seconds": 331.4,
      "duration_seconds": 4.84,
      "text": "Right, uh, I'll do that. Thank you, doctor."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 332.85,
      "end_seconds": 335.13,
      "duration_seconds": 2.28,
      "text": "Right, have a good day."
    }
  ]
}