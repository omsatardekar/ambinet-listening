{
  "schema_version": "1.0",
  "encounter_id": "20008",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.06,
      "end_seconds": 5.05,
      "duration_seconds": 3.99,
      "text": "Hello? Doctor? I was told to come in."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.8,
      "end_seconds": 11.21,
      "duration_seconds": 4.41,
      "text": "No problem at all, come in. What's troubling you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 13.07,
      "end_seconds": 19.41,
      "duration_seconds": 6.34,
      "text": "I've been dealing with a red, hot area on my lower leg"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 25.21,
      "end_seconds": 27.93,
      "duration_seconds": 2.72,
      "text": "has this been going on for long?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 29.99,
      "end_seconds": 32.02,
      "duration_seconds": 2.03,
      "text": "Probably three days. Yeah."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 33.86,
      "end_seconds": 36.31,
      "duration_seconds": 2.45,
      "text": "Any a swollen leg as well?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 37.61,
      "end_seconds": 40.99,
      "duration_seconds": 3.38,
      "text": "Yes, you know, for about a week."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 52.15,
      "end_seconds": 55.83,
      "duration_seconds": 3.68,
      "text": "Has there been any red streaks up the leg?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 57.93,
      "end_seconds": 61.37,
      "duration_seconds": 3.44,
      "text": "no red streaks up the leg, thankfully"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 63.0,
      "end_seconds": 65.65,
      "duration_seconds": 2.65,
      "text": "any pus, chest pain or vomiting?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 66.72,
      "end_seconds": 70.56,
      "duration_seconds": 3.84,
      "text": "no I haven't had any of them"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 72.42,
      "end_seconds": 74.78,
      "duration_seconds": 2.36,
      "text": "is your digestion otherwise okay?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 75.44,
      "end_seconds": 78.11,
      "duration_seconds": 2.67,
      "text": "No, that side's been fine."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 80.17,
      "end_seconds": 82.08,
      "duration_seconds": 1.91,
      "text": "How are your meals?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 83.79,
      "end_seconds": 87.54,
      "duration_seconds": 3.75,
      "text": "I grab fast food at lunch most days."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 88.96,
      "end_seconds": 90.8,
      "duration_seconds": 1.84,
      "text": "who lives with you?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 91.92,
      "end_seconds": 94.45,
      "duration_seconds": 2.53,
      "text": "My partner and our baby."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 95.72,
      "end_seconds": 99.07,
      "duration_seconds": 3.35,
      "text": "what line of work are you in?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 100.66,
      "end_seconds": 105.49,
      "duration_seconds": 4.83,
      "text": "I'm a bus driver, so I sit for long hours"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 119.21,
      "end_seconds": 127.75,
      "duration_seconds": 8.54,
      "text": "has anything ever caused you a reaction? I mean any allergies these questions might sound routine, but they matter"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 128.77,
      "end_seconds": 132.11,
      "duration_seconds": 3.34,
      "text": "No, nothing as far as I know."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 134.13,
      "end_seconds": 138.55,
      "duration_seconds": 4.42,
      "text": "Do you have any medical conditions I should know about?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 140.22,
      "end_seconds": 143.12,
      "duration_seconds": 2.9,
      "text": "no nothing I can think of"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 154.81,
      "end_seconds": 157.61,
      "duration_seconds": 2.8,
      "text": "Is there any regular medication you use?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 158.86,
      "end_seconds": 162.01,
      "duration_seconds": 3.15,
      "text": "no I don't take any tablets"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 162.79,
      "end_seconds": 166.64,
      "duration_seconds": 3.85,
      "text": "let me get the readings out of the way"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 172.65,
      "end_seconds": 175.41,
      "duration_seconds": 2.76,
      "text": "Bear with me while this finishes..."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 185.71,
      "end_seconds": 191.77,
      "duration_seconds": 6.06,
      "text": "Okay: pulse 97, oxygen saturation is 95 percent, blood pressure 112 over 68."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 193.75,
      "end_seconds": 196.54,
      "duration_seconds": 2.79,
      "text": "let's move on to the examination"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 197.15,
      "end_seconds": 198.14,
      "duration_seconds": 0.99,
      "text": "That's alright."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 199.46,
      "end_seconds": 200.87,
      "duration_seconds": 1.41,
      "text": "Nearly finished here."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 213.06,
      "end_seconds": 220.9,
      "duration_seconds": 7.84,
      "text": "There is a warm, red, tender patch about ten centimetres across on the right shin with mild swelling."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 223.1,
      "end_seconds": 225.26,
      "duration_seconds": 2.16,
      "text": "that's the the examination finished"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 241.19,
      "end_seconds": 250.6,
      "duration_seconds": 9.41,
      "text": "Putting it all together, I'm honestly not certain yet. It could be cellulitis of the right leg, or it might be stasis dermatitis."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 251.84,
      "end_seconds": 254.67,
      "duration_seconds": 2.83,
      "text": "will it it clear up?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 255.45,
      "end_seconds": 281.58,
      "duration_seconds": 26.13,
      "text": "I can't promise yet, but most people with cellulitis of the right leg do well once it's treated properly. An ultrasound of the leg veins is what I'd like next, for leg swelling. I'm going to put you on flucloxacillin, 500 milligrams, four times a day, for seven days. You take it by mouth. That should help with cellulitis."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 282.68,
      "end_seconds": 284.38,
      "duration_seconds": 1.7,
      "text": "that's simple enough"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 286.32,
      "end_seconds": 311.35,
      "duration_seconds": 25.03,
      "text": "mark the edge of the redness with a pen and keep the leg raised when sitting the thing that would worry me is if the redness spreads quickly or you get a high fever if that happens, go to to emergency is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 312.12,
      "end_seconds": 315.23,
      "duration_seconds": 3.11,
      "text": "no that's all thanks a lot"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 320.6,
      "end_seconds": 321.8,
      "duration_seconds": 1.2,
      "text": "look after yourself"
    }
  ]
}