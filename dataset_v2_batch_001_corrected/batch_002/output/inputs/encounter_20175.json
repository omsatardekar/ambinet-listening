{
  "schema_version": "1.0",
  "encounter_id": "20175",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.13,
      "end_seconds": 5.04,
      "duration_seconds": 3.91,
      "text": "Hello, doctor. I think it's my turn."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.39,
      "end_seconds": 10.61,
      "duration_seconds": 4.22,
      "text": "Of course, leave it there. How can I help?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 12.1,
      "end_seconds": 16.84,
      "duration_seconds": 4.74,
      "text": "Um, so... muscle aches. That's why I came."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 17.57,
      "end_seconds": 20.81,
      "duration_seconds": 3.24,
      "text": "I'll just record a few vital signs."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 31.59,
      "end_seconds": 34.04,
      "duration_seconds": 2.45,
      "text": "Sit still for a moment..."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 43.25,
      "end_seconds": 50.47,
      "duration_seconds": 7.22,
      "text": "okay: respiratory rate 19, pulse is 106 beats a minute, BP is 126 over 72."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 52.01,
      "end_seconds": 53.35,
      "duration_seconds": 1.34,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 55.33,
      "end_seconds": 61.2,
      "duration_seconds": 5.87,
      "text": "That's fine, I'll explain it soon. When was the first time you noticed it?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 62.13,
      "end_seconds": 70.16,
      "duration_seconds": 8.03,
      "text": "Probably one week. Yeah. I didn't want to bother you but it keeps coming back."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 72.05,
      "end_seconds": 79.83,
      "duration_seconds": 7.78,
      "text": "Can you describe it a bit more for me? How strong it is, what the pattern is, what helps."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 81.49,
      "end_seconds": 91.32,
      "duration_seconds": 9.83,
      "text": "I'd say mild i'd say every other day i wasn't sure whether to come in at all, to be honest"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 105.06,
      "end_seconds": 108.6,
      "duration_seconds": 3.54,
      "text": "Any diarrhoea, neck stiffness or confusion at all?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 113.02,
      "end_seconds": 115.3,
      "duration_seconds": 2.28,
      "text": "Nope, nothing like that."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 117.07,
      "end_seconds": 118.37,
      "duration_seconds": 1.3,
      "text": "Nothing like rash?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 119.31,
      "end_seconds": 122.29,
      "duration_seconds": 2.98,
      "text": "mm, not at all, no rash"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 124.1,
      "end_seconds": 127.07,
      "duration_seconds": 2.97,
      "text": "right, and your skin, any changes there?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 127.66,
      "end_seconds": 128.62,
      "duration_seconds": 0.96,
      "text": "No rashes."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 140.72,
      "end_seconds": 143.78,
      "duration_seconds": 3.06,
      "text": "Are you in work at the moment?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 144.66,
      "end_seconds": 149.05,
      "duration_seconds": 4.39,
      "text": "Yes, I work in a bakery, early starts."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 150.19,
      "end_seconds": 153.56,
      "duration_seconds": 3.37,
      "text": "Are you on your own at home?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 154.54,
      "end_seconds": 157.48,
      "duration_seconds": 2.94,
      "text": "I live with my elderly mother."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 158.03,
      "end_seconds": 164.92,
      "duration_seconds": 6.89,
      "text": "Any health conditions I should have on record? These questions might sound routine, but they matter."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 165.62,
      "end_seconds": 170.58,
      "duration_seconds": 4.96,
      "text": "I've had high blood pressure for nearly five years now."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 172.16,
      "end_seconds": 175.48,
      "duration_seconds": 3.32,
      "text": "I follow. Have you had any surgical procedures?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 176.58,
      "end_seconds": 184.19,
      "duration_seconds": 7.61,
      "text": "Let me think, just a mole taken off my arm, a few years ago."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 185.58,
      "end_seconds": 189.95,
      "duration_seconds": 4.37,
      "text": "Are there any allergies I should be aware of?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 194.45,
      "end_seconds": 198.29,
      "duration_seconds": 3.84,
      "text": "Right, no, I've never reacted to anything."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 199.26,
      "end_seconds": 201.84,
      "duration_seconds": 2.58,
      "text": "are you on any regular medication?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 202.49,
      "end_seconds": 205.27,
      "duration_seconds": 2.78,
      "text": "no, I'm not on anything"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 206.77,
      "end_seconds": 210.77,
      "duration_seconds": 4.0,
      "text": "alright, over here please and I'll take a look"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 212.02,
      "end_seconds": 214.77,
      "duration_seconds": 2.75,
      "text": "stay as you are for a moment"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 231.31,
      "end_seconds": 236.7,
      "duration_seconds": 5.39,
      "text": "The spleen tip is just palpable and the chest is clear."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 238.68,
      "end_seconds": 240.03,
      "duration_seconds": 1.35,
      "text": "Fine by me."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 243.4,
      "end_seconds": 245.34,
      "duration_seconds": 1.94,
      "text": "that's the examination finished"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 258.18,
      "end_seconds": 275.52,
      "duration_seconds": 17.34,
      "text": "From what you've told me and what I found, it fits best with a fever after travel that must be treated as possible malaria. The reason I say that is that your story and my examination fit together."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 276.48,
      "end_seconds": 279.26,
      "duration_seconds": 2.78,
      "text": "do you think it's something serious?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 284.09,
      "end_seconds": 297.32,
      "duration_seconds": 13.23,
      "text": "I understand the worry. At the moment I'd say it's a fever after travel that must be treated as possible malaria, and we'll know more once the blood cultures is back."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 313.72,
      "end_seconds": 321.59,
      "duration_seconds": 7.87,
      "text": "I think blood cultures makes sense here, for fever. We should do blood tests for fever."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 322.64,
      "end_seconds": 326.04,
      "duration_seconds": 3.4,
      "text": "where would I go for that?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 327.51,
      "end_seconds": 343.61,
      "duration_seconds": 16.1,
      "text": "Avoid anti-inflammatory painkillers and keep drinking. Let's get you seen by the tropical diseases unit, I'll arrange the letter. If you become confused or cannot keep fluids down, or you feel really unwell, please come to the emergency department."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 344.4,
      "end_seconds": 346.12,
      "duration_seconds": 1.72,
      "text": "alright, I follow"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 350.2,
      "end_seconds": 356.87,
      "duration_seconds": 6.67,
      "text": "I'd like you back after the results today. Anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 358.1,
      "end_seconds": 361.45,
      "duration_seconds": 3.35,
      "text": "I think I understand everything thanks"
    }
  ]
}