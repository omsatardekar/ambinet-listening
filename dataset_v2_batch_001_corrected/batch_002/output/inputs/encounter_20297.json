{
  "schema_version": "1.0",
  "encounter_id": "20297",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.56,
      "end_seconds": 3.13,
      "duration_seconds": 2.57,
      "text": "Hi, sit anywhere you like."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 5.2,
      "end_seconds": 8.15,
      "duration_seconds": 2.95,
      "text": "Morning, doctor, sorry about the rush."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 8.84,
      "end_seconds": 12.13,
      "duration_seconds": 3.29,
      "text": "Did the receptionist sort you out quickly?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 13.3,
      "end_seconds": 16.2,
      "duration_seconds": 2.9,
      "text": "Yes, she was lovely about it."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 16.88,
      "end_seconds": 20.2,
      "duration_seconds": 3.32,
      "text": "What would you like to start with today?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 21.33,
      "end_seconds": 31.71,
      "duration_seconds": 10.38,
      "text": "Mainly sudden hearing loss in my left ear. There's a couple of other things, you know, but that's the main one."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 32.87,
      "end_seconds": 34.2,
      "duration_seconds": 1.33,
      "text": "Since when exactly?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 35.02,
      "end_seconds": 37.6,
      "duration_seconds": 2.58,
      "text": "It's been two weeks now."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 38.05,
      "end_seconds": 39.59,
      "duration_seconds": 1.54,
      "text": "Okay, go on."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 41.62,
      "end_seconds": 46.73,
      "duration_seconds": 5.11,
      "text": "I've also been feeling a bit dizzy, for ten days."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 47.73,
      "end_seconds": 51.56,
      "duration_seconds": 3.83,
      "text": "Any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 52.79,
      "end_seconds": 54.85,
      "duration_seconds": 2.06,
      "text": "No, nothing at all."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 62.92,
      "end_seconds": 65.63,
      "duration_seconds": 2.71,
      "text": "Any regular medication, tablets or creams?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 67.42,
      "end_seconds": 70.31,
      "duration_seconds": 2.89,
      "text": "No, I'm not on anything."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 71.82,
      "end_seconds": 76.64,
      "duration_seconds": 4.82,
      "text": "Do you react to any medicines or foods? Any allergies?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 78.67,
      "end_seconds": 81.19,
      "duration_seconds": 2.52,
      "text": "Not to my knowledge, no."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 83.52,
      "end_seconds": 84.82,
      "duration_seconds": 1.3,
      "text": "Are you active?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 86.25,
      "end_seconds": 89.53,
      "duration_seconds": 3.28,
      "text": "I walk the dog every morning."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 94.26,
      "end_seconds": 95.96,
      "duration_seconds": 1.7,
      "text": "How are your meals?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 97.5,
      "end_seconds": 101.08,
      "duration_seconds": 3.58,
      "text": "I grab fast food at lunch most days."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 102.83,
      "end_seconds": 107.82,
      "duration_seconds": 4.99,
      "text": "And what about recent flying, discharge, facial weakness or head injury?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 109.06,
      "end_seconds": 116.1,
      "duration_seconds": 7.04,
      "text": "No recent flying, discharge, facial weakness or head injury, none of it."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 117.29,
      "end_seconds": 121.78,
      "duration_seconds": 4.49,
      "text": "Right, anything with your heart, like skipped beats or fainting?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 123.29,
      "end_seconds": 128.04,
      "duration_seconds": 4.75,
      "text": "My heart's been fine, as far as I know."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 145.56,
      "end_seconds": 149.6,
      "duration_seconds": 4.04,
      "text": "So, time for your numbers, if that's okay."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 162.75,
      "end_seconds": 165.53,
      "duration_seconds": 2.78,
      "text": "That's it, just a little longer..."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 179.98,
      "end_seconds": 192.99,
      "duration_seconds": 13.01,
      "text": "Okay: pressure 110 over 70, height 183 centimetres, SpO2 99 percent on room air, BMI works out to 23.6, weight 79 kilos, heart rate 66, temperature 36.9."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 198.07,
      "end_seconds": 200.13,
      "duration_seconds": 2.06,
      "text": "Is that alright, doctor?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 202.22,
      "end_seconds": 204.94,
      "duration_seconds": 2.72,
      "text": "Right, we'll go over that shortly."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 206.91,
      "end_seconds": 209.96,
      "duration_seconds": 3.05,
      "text": "Alright, shall I start the examination?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 217.06,
      "end_seconds": 218.73,
      "duration_seconds": 1.67,
      "text": "Yes, that's fine."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 220.31,
      "end_seconds": 223.53,
      "duration_seconds": 3.22,
      "text": "Stay as you are for a moment."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 235.9,
      "end_seconds": 242.36,
      "duration_seconds": 6.46,
      "text": "Both eardrums look normal and a tuning fork is heard better in the right ear."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 246.59,
      "end_seconds": 249.09,
      "duration_seconds": 2.5,
      "text": "Okay, that's enough for me."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 259.41,
      "end_seconds": 269.39,
      "duration_seconds": 9.98,
      "text": "Putting it all together, I'm honestly not certain yet. It could be sudden loss of hearing that needs urgent assessment, or it might be wax."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 271.48,
      "end_seconds": 272.92,
      "duration_seconds": 1.44,
      "text": "Is this permanent?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 274.27,
      "end_seconds": 289.3,
      "duration_seconds": 15.03,
      "text": "It's reasonable to be concerned, but right now sudden loss of hearing that needs urgent assessment is my leading thought, not anything worse. I want an MRI scan done, that's for unilateral hearing loss."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 290.97,
      "end_seconds": 293.18,
      "duration_seconds": 2.21,
      "text": "Okay, I'll do it."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 294.51,
      "end_seconds": 328.09,
      "duration_seconds": 33.58,
      "text": "I want a hearing test done, that's for sudden hearing loss. The result will help us decide whether anything more is needed. The treatment will be prednisolone, 60 milligrams, once a day in the morning, for seven days. You take it by mouth. That's for sudden hearing loss. Please attend the hearing test today if you can, as timing matters. A short walk every day, even twenty minutes, will help more than you'd think."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 330.11,
      "end_seconds": 344.43,
      "duration_seconds": 14.32,
      "text": "Let's get you seen by the ear specialists, I'll arrange the letter. Come back after the hearing test. Right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 345.73,
      "end_seconds": 347.98,
      "duration_seconds": 2.25,
      "text": "Alright, thanks, take care."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 349.75,
      "end_seconds": 351.03,
      "duration_seconds": 1.28,
      "text": "Look after yourself."
    }
  ]
}