{
  "schema_version": "1.0",
  "encounter_id": "20076",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.64,
      "end_seconds": 3.65,
      "duration_seconds": 3.01,
      "text": "Sorry I'm a little late, doctor."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.52,
      "end_seconds": 9.98,
      "duration_seconds": 4.46,
      "text": "no problem at all, come in what's troubling you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 10.51,
      "end_seconds": 24.42,
      "duration_seconds": 13.91,
      "text": "doctor, thank you for seeing us. It's, It's a red, hot area on my lower leg, doctor. She didn't wanna to come, but I insisted"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 26.18,
      "end_seconds": 29.16,
      "duration_seconds": 2.98,
      "text": "What's the timeline, when did it begin?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 30.99,
      "end_seconds": 43.16,
      "duration_seconds": 12.17,
      "text": "It's been like this since last night. I've also had a swollen leg. As for swollen leg, I'd say a couple of times a week."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 45.05,
      "end_seconds": 49.97,
      "duration_seconds": 4.92,
      "text": "what about pain in the calf, have you noticed that?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 50.67,
      "end_seconds": 58.28,
      "duration_seconds": 7.61,
      "text": "yeah. About four days, I'd say with pain in the calf, I'd say severe"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 58.49,
      "end_seconds": 62.67,
      "duration_seconds": 4.18,
      "text": "I follow. Are you in work at the moment?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 67.1,
      "end_seconds": 71.34,
      "duration_seconds": 4.24,
      "text": "Yes, I work in a bakery, early starts."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 72.18,
      "end_seconds": 73.4,
      "duration_seconds": 1.22,
      "text": "Are you active?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 74.57,
      "end_seconds": 77.73,
      "duration_seconds": 3.16,
      "text": "I walk the dog every morning"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 79.79,
      "end_seconds": 81.36,
      "duration_seconds": 1.57,
      "text": "How are your meals?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 82.47,
      "end_seconds": 86.65,
      "duration_seconds": 4.18,
      "text": "I grab fast food at lunch most days."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 91.23,
      "end_seconds": 93.21,
      "duration_seconds": 1.98,
      "text": "Any regular medication at all?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 94.06,
      "end_seconds": 95.86,
      "duration_seconds": 1.8,
      "text": "Nothing regular, no."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 98.79,
      "end_seconds": 103.27,
      "duration_seconds": 4.48,
      "text": "any inherited conditions that you know of in the family?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 104.77,
      "end_seconds": 106.86,
      "duration_seconds": 2.09,
      "text": "my son has asthma"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 107.75,
      "end_seconds": 112.85,
      "duration_seconds": 5.1,
      "text": "Has anything ever caused you a reaction? I mean any allergies."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 115.31,
      "end_seconds": 117.19,
      "duration_seconds": 1.88,
      "text": "No allergies at all."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 117.89,
      "end_seconds": 121.23,
      "duration_seconds": 3.34,
      "text": "Okay, have you been to theatre before?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 122.47,
      "end_seconds": 127.69,
      "duration_seconds": 5.22,
      "text": "I had a meniscus repair on my knee four years ago"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 135.37,
      "end_seconds": 138.33,
      "duration_seconds": 2.96,
      "text": "Do you have any chronic illnesses?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 143.09,
      "end_seconds": 145.5,
      "duration_seconds": 2.41,
      "text": "I've got high blood pressure."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 146.24,
      "end_seconds": 151.6,
      "duration_seconds": 5.36,
      "text": "any red streaks up the leg, wound or chest pain at all?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 153.32,
      "end_seconds": 160.67,
      "duration_seconds": 7.35,
      "text": "No red streaks up the leg, wound or chest pain, none of it."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 162.48,
      "end_seconds": 163.43,
      "duration_seconds": 0.95,
      "text": "Any vomiting?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 165.41,
      "end_seconds": 169.43,
      "duration_seconds": 4.02,
      "text": "erm, not that I've noticed, no vomiting"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 171.21,
      "end_seconds": 175.39,
      "duration_seconds": 4.18,
      "text": "Right, any pins and needles or loss of strength anywhere?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 176.7,
      "end_seconds": 178.73,
      "duration_seconds": 2.03,
      "text": "No weakness or anything."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 180.71,
      "end_seconds": 183.04,
      "duration_seconds": 2.33,
      "text": "Any trouble with the waterworks?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 184.96,
      "end_seconds": 186.62,
      "duration_seconds": 1.66,
      "text": "No changes there."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 187.87,
      "end_seconds": 192.15,
      "duration_seconds": 4.28,
      "text": "Shall I check your blood pressure and and pulse?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 205.98,
      "end_seconds": 208.54,
      "duration_seconds": 2.56,
      "text": "keep your arm relaxed for me.."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 220.34,
      "end_seconds": 230.83,
      "duration_seconds": 10.49,
      "text": "Okay: pulse is 88 beats a minute, SpO2 98 percent on room air, respiratory rate 16. And pressure 107 over 78."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 232.48,
      "end_seconds": 234.4,
      "duration_seconds": 1.92,
      "text": "Is that alright, doctor?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 235.26,
      "end_seconds": 237.25,
      "duration_seconds": 1.99,
      "text": "We'll go over that shortly."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 239.41,
      "end_seconds": 241.82,
      "duration_seconds": 2.41,
      "text": "may I examine you now?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 243.29,
      "end_seconds": 245.08,
      "duration_seconds": 1.79,
      "text": "let me feel here"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 253.12,
      "end_seconds": 262.05,
      "duration_seconds": 8.93,
      "text": "There is a warm, red, tender patch about ten centimetres across on the right shin with mild swelling."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 267.1,
      "end_seconds": 269.36,
      "duration_seconds": 2.26,
      "text": "you can sit up now"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 287.48,
      "end_seconds": 296.41,
      "duration_seconds": 8.93,
      "text": "so where does that leave us? The most likely explanation is cellulitis of the right leg we shouldn't forget a deep vein thrombosis"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 307.44,
      "end_seconds": 326.92,
      "duration_seconds": 19.48,
      "text": "I want blood tests done, that's for skin infection. I'm going to put you on flucloxacillin, 500 milligrams, four times a day, for seven days. That should help with cellulitis. Mark the edge of the redness with a pen and keep the leg raised when sitting."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 328.11,
      "end_seconds": 333.46,
      "duration_seconds": 5.35,
      "text": "Should I have an ultrasound of the leg veins as well?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 335.1,
      "end_seconds": 351.77,
      "duration_seconds": 16.67,
      "text": "Not right now, it wouldn't change what we do today. Do get help quickly if the redness spreads quickly or you get a high fever. I'll want another look in two days. Alright, anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 352.57,
      "end_seconds": 356.39,
      "duration_seconds": 3.82,
      "text": "Right, I'll do that. Thank you, doctor."
    }
  ]
}