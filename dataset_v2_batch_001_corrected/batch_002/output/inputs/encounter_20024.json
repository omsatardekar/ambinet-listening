{
  "schema_version": "1.0",
  "encounter_id": "20024",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 0.7,
      "end_seconds": 5.63,
      "duration_seconds": 4.93,
      "text": "Ready for you, doctor. I'll stay in case you need anything."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.22,
      "end_seconds": 11.39,
      "duration_seconds": 4.17,
      "text": "Good, thank you. Welcome, tell me what's brought you in."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 12.38,
      "end_seconds": 20.16,
      "duration_seconds": 7.78,
      "text": "Ah, I wanted to get tingling in my thumb and first two fingers looked at."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 20.77,
      "end_seconds": 23.88,
      "duration_seconds": 3.11,
      "text": "How long has this been bothering you?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 24.61,
      "end_seconds": 28.23,
      "duration_seconds": 3.62,
      "text": "I've had it for about a year"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 29.67,
      "end_seconds": 31.95,
      "duration_seconds": 2.28,
      "text": "how frequently does it come?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 33.57,
      "end_seconds": 35.57,
      "duration_seconds": 2.0,
      "text": "it's every other day"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 44.12,
      "end_seconds": 53.13,
      "duration_seconds": 9.01,
      "text": "doctor, I've got the readings for you. Blood pressure 126 over 77, saturation 98 percent, temperature 37.0, pulse 71."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 54.8,
      "end_seconds": 56.32,
      "duration_seconds": 1.52,
      "text": "good, thank you"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 59.01,
      "end_seconds": 63.01,
      "duration_seconds": 4.0,
      "text": "Alright, over here please and I'll take a look."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 66.49,
      "end_seconds": 68.21,
      "duration_seconds": 1.72,
      "text": "Yeah, no problem."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 69.79,
      "end_seconds": 72.23,
      "duration_seconds": 2.44,
      "text": "Tell me if that's sore."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 83.73,
      "end_seconds": 93.23,
      "duration_seconds": 9.5,
      "text": "Tapping over the wrist brings on the tingling, and the muscle at the base of the thumb looks slightly thin."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 97.69,
      "end_seconds": 100.57,
      "duration_seconds": 2.88,
      "text": "So, you can sit up now."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 109.19,
      "end_seconds": 116.16,
      "duration_seconds": 6.97,
      "text": "So, have you noticed fever, neck pain, injury to the wrist or weakness in the legs?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 121.01,
      "end_seconds": 123.1,
      "duration_seconds": 2.09,
      "text": "None of those, no."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 123.62,
      "end_seconds": 125.63,
      "duration_seconds": 2.01,
      "text": "Is your mobility otherwise okay?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 127.57,
      "end_seconds": 130.28,
      "duration_seconds": 2.71,
      "text": "erm, no, joints are fine"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 133.95,
      "end_seconds": 138.08,
      "duration_seconds": 4.13,
      "text": "Any change in your bowel habit or your stomach generally?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 138.95,
      "end_seconds": 140.7,
      "duration_seconds": 1.75,
      "text": "Nothing unusual, no."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 148.02,
      "end_seconds": 151.23,
      "duration_seconds": 3.21,
      "text": "What operations have you had, if any?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 152.17,
      "end_seconds": 157.91,
      "duration_seconds": 5.74,
      "text": "Just a caesarean for my second baby, nine years ago."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 159.93,
      "end_seconds": 163.23,
      "duration_seconds": 3.3,
      "text": "any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 164.11,
      "end_seconds": 166.04,
      "duration_seconds": 1.93,
      "text": "No, nothing at all."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 173.43,
      "end_seconds": 176.88,
      "duration_seconds": 3.45,
      "text": "let me ask about allergies, anything at all?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 178.68,
      "end_seconds": 181.06,
      "duration_seconds": 2.38,
      "text": "Yes, I'm allergic to plasters."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 182.76,
      "end_seconds": 185.74,
      "duration_seconds": 2.98,
      "text": "Are you on your own at home?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 186.44,
      "end_seconds": 189.22,
      "duration_seconds": 2.78,
      "text": "I live with my elderly mother."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 191.15,
      "end_seconds": 192.84,
      "duration_seconds": 1.69,
      "text": "Right, are you active?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 194.58,
      "end_seconds": 197.28,
      "duration_seconds": 2.7,
      "text": "I walk the dog every morning."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 199.28,
      "end_seconds": 201.06,
      "duration_seconds": 1.78,
      "text": "How are your meals?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 202.28,
      "end_seconds": 206.37,
      "duration_seconds": 4.09,
      "text": "I grab fast food at lunch most days."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 207.75,
      "end_seconds": 210.5,
      "duration_seconds": 2.75,
      "text": "Is there any regular medication you use?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 215.82,
      "end_seconds": 217.0,
      "duration_seconds": 1.18,
      "text": "no, none"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 217.69,
      "end_seconds": 227.55,
      "duration_seconds": 9.86,
      "text": "Okay, thinking it through, it points towards carpal tunnel syndrome. That's my thinking for now, and it may change as we learn more."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 228.89,
      "end_seconds": 231.9,
      "duration_seconds": 3.01,
      "text": "Do you think it's something serious?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 232.83,
      "end_seconds": 262.87,
      "duration_seconds": 30.04,
      "text": "it's reasonable to be concerned, but right now carpal tunnel syndrome is my leading thought, not anything worse i want blood tests done, that's for numbness that will help us see what's going on underneath and decide the next step i want nerve conduction tests done, that's for hand numbness i'd rather check than guess, and this is the quickest way to know more a wrist splint at night will often settle it"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 268.95,
      "end_seconds": 275.06,
      "duration_seconds": 6.11,
      "text": "I'd like you to see occupational therapy as well, and I'll write the referral."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 276.12,
      "end_seconds": 277.92,
      "duration_seconds": 1.8,
      "text": "Alright, thank you."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 279.31,
      "end_seconds": 292.94,
      "duration_seconds": 13.63,
      "text": "Keep an eye out, and if the numbness spreads or you notice more weakness, call us the same day or go to emergency. Book a review after the nerve test."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 293.82,
      "end_seconds": 294.52,
      "duration_seconds": 0.7,
      "text": "Sure."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 296.11,
      "end_seconds": 300.24,
      "duration_seconds": 4.13,
      "text": "That's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 300.88,
      "end_seconds": 302.91,
      "duration_seconds": 2.03,
      "text": "thank you, that's helpful"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 304.23,
      "end_seconds": 306.4,
      "duration_seconds": 2.17,
      "text": "Have a a good day."
    }
  ]
