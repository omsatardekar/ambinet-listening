{
  "schema_version": "1.0",
  "encounter_id": "20137",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 1.37,
      "end_seconds": 8.09,
      "duration_seconds": 6.72,
      "text": "Doctor, your next patient is here. I've done the basics, I'll read them out in a moment."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.85,
      "end_seconds": 12.46,
      "duration_seconds": 3.61,
      "text": "Perfect, thanks. Hello there, so what's the trouble?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 16.53,
      "end_seconds": 30.74,
      "duration_seconds": 14.21,
      "text": "Doctor, uh, I've come along because I know the history, if it helps. It's a fever, doctor. She didn't want to come, but I insisted."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 31.56,
      "end_seconds": 34.81,
      "duration_seconds": 3.25,
      "text": "Is it a lot or only a little?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 36.38,
      "end_seconds": 59.77,
      "duration_seconds": 23.39,
      "text": "I mean, about a five out of ten. Oh, and swollen glands in my neck. That's been about the same, one week. Uh, with swollen glands in my neck, I'd say moderate. Oh, there's bad breath as well. Oh, and a sore throat."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 60.6,
      "end_seconds": 64.04,
      "duration_seconds": 3.44,
      "text": "is it it bearing on you a lot?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 65.54,
      "end_seconds": 68.08,
      "duration_seconds": 2.54,
      "text": "it feels moderate to me"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 68.64,
      "end_seconds": 74.9,
      "duration_seconds": 6.26,
      "text": "let me check a a few things. Any trouble opening the mouth or cough?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 76.98,
      "end_seconds": 82.96,
      "duration_seconds": 5.98,
      "text": "Oh, no trouble opening the mouth or cough, none of it."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 83.47,
      "end_seconds": 87.37,
      "duration_seconds": 3.9,
      "text": "And what about drooling, rash or ear pain?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 88.96,
      "end_seconds": 95.46,
      "duration_seconds": 6.5,
      "text": "I, I haven't had drooling, rash or ear pain, no."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 97.13,
      "end_seconds": 99.92,
      "duration_seconds": 2.79,
      "text": "Any muscle or joint problems besides this?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 100.83,
      "end_seconds": 103.81,
      "duration_seconds": 2.98,
      "text": "No, you know, nothing there."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 105.02,
      "end_seconds": 108.98,
      "duration_seconds": 3.96,
      "text": "Okay, anything on the skin I should know about?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 110.39,
      "end_seconds": 111.52,
      "duration_seconds": 1.13,
      "text": "no rashes"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 116.16,
      "end_seconds": 119.32,
      "duration_seconds": 3.16,
      "text": "Has anyone in your family had anything serious?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 119.9,
      "end_seconds": 124.58,
      "duration_seconds": 4.68,
      "text": "My cousin has psoriasis. My son has asthma."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 125.11,
      "end_seconds": 126.39,
      "duration_seconds": 1.28,
      "text": "What's your work?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 126.96,
      "end_seconds": 131.99,
      "duration_seconds": 5.03,
      "text": "I'm a plumber, lots of bending and kneeling."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 133.33,
      "end_seconds": 135.13,
      "duration_seconds": 1.8,
      "text": "Who lives with you?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 137.1,
      "end_seconds": 139.8,
      "duration_seconds": 2.7,
      "text": "My partner and our baby."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 140.89,
      "end_seconds": 143.57,
      "duration_seconds": 2.68,
      "text": "okay, do you get out much?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 144.74,
      "end_seconds": 149.49,
      "duration_seconds": 4.75,
      "text": "Not much, I mostly stay in these days"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 151.15,
      "end_seconds": 155.07,
      "duration_seconds": 3.92,
      "text": "Which medicines do you take at the moment?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 157.04,
      "end_seconds": 163.43,
      "duration_seconds": 6.39,
      "text": "I take Dolo, 650 milligrams, maybe, when I get the fever"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 164.71,
      "end_seconds": 168.33,
      "duration_seconds": 3.62,
      "text": "right, is the packet here, or the prescription?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 169.16,
      "end_seconds": 176.69,
      "duration_seconds": 7.53,
      "text": "Not with me. I'll bring it next time. Escitalopram I don't take anymore."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 186.5,
      "end_seconds": 189.81,
      "duration_seconds": 3.31,
      "text": "Has anyone ever diagnosed you with something?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 190.97,
      "end_seconds": 195.15,
      "duration_seconds": 4.18,
      "text": "I have anxiety, for about ten years."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 211.35,
      "end_seconds": 215.3,
      "duration_seconds": 3.95,
      "text": "Do you react to any medicines or foods? Any allergies?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 220.0,
      "end_seconds": 228.54,
      "duration_seconds": 8.54,
      "text": "I'm allergic to trimethoprim, I get a rash i'm allergic to kiwi, I get an itchy mouth"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 230.26,
      "end_seconds": 239.2,
      "duration_seconds": 8.94,
      "text": "Okay, so the vitals from earlier. Temp 38.2 degrees, pulse 89, pressure 110 over 79, SpO2 97 percent on room air."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 240.33,
      "end_seconds": 241.03,
      "duration_seconds": 0.7,
      "text": "Thanks."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 242.75,
      "end_seconds": 245.12,
      "duration_seconds": 2.37,
      "text": "May I examine you now?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 247.03,
      "end_seconds": 248.32,
      "duration_seconds": 1.29,
      "text": "Nearly finished here."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 262.71,
      "end_seconds": 269.04,
      "duration_seconds": 6.33,
      "text": "Both tonsils are red and enlarged with white patches, and the neck glands are tender."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 273.84,
      "end_seconds": 276.12,
      "duration_seconds": 2.28,
      "text": "Okay, that's enough for me."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 292.74,
      "end_seconds": 300.81,
      "duration_seconds": 8.07,
      "text": "Let me tell you where I've got to. It fits best with tonsillitis. Another possibility is a viral sore throat."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 301.57,
      "end_seconds": 304.71,
      "duration_seconds": 3.14,
      "text": "Is there something to worry about?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 309.45,
      "end_seconds": 338.99,
      "duration_seconds": 29.54,
      "text": "I can't promise yet, but most people with tonsillitis do well once it's treated properly. I'll request a throat swab, it'll help with sore throat. I'd rather check than guess, and this is the quickest way to know more. I'll start you on phenoxymethylpenicillin, 500 milligrams, four times a day, for ten days. That's for tonsillitis. Gargle with warm salt water and drink plenty of fluids."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 339.65,
      "end_seconds": 362.64,
      "duration_seconds": 22.99,
      "text": "And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose. Do get help quickly if you cannot swallow your saliva or have trouble breathing. I'll want another look if it isn't better in three days. Have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 364.55,
      "end_seconds": 368.96,
      "duration_seconds": 4.41,
      "text": "Great, uh, thank you for your help."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 370.37,
      "end_seconds": 372.05,
      "duration_seconds": 1.68,
      "text": "Have a good day."
    }
  ]
}