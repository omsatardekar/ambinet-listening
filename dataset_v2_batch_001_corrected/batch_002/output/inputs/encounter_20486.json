{
  "schema_version": "1.0",
  "encounter_id": "20486",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.79,
      "end_seconds": 5.05,
      "duration_seconds": 4.26,
      "text": "Morning, you know, doctor. Is this the right room?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 9.82,
      "end_seconds": 15.15,
      "duration_seconds": 5.33,
      "text": "Yes, come in and sit down. What brings you here today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 16.03,
      "end_seconds": 23.42,
      "duration_seconds": 7.39,
      "text": "Yeah, honestly, it's a cough at night, and my family pushed me to come."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 24.99,
      "end_seconds": 26.73,
      "duration_seconds": 1.74,
      "text": "When did this begin?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 27.61,
      "end_seconds": 32.15,
      "duration_seconds": 4.54,
      "text": "It's, It's been two days, I'm fairly sure."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 32.76,
      "end_seconds": 37.79,
      "duration_seconds": 5.03,
      "text": "Is it there all the time or does it come and go?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 39.46,
      "end_seconds": 48.21,
      "duration_seconds": 8.75,
      "text": "It's every other day. Oh, and chest tightness. I had wheezing when I exercise before. That's settled now, though."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 49.12,
      "end_seconds": 53.0,
      "duration_seconds": 3.88,
      "text": "Anything in your past medical history I should know?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 53.78,
      "end_seconds": 57.98,
      "duration_seconds": 4.2,
      "text": "I, I have asthma, for about ten years."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 58.71,
      "end_seconds": 61.45,
      "duration_seconds": 2.74,
      "text": "A few questions about your lifestyle now."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 62.74,
      "end_seconds": 73.94,
      "duration_seconds": 11.2,
      "text": "I walk the dog every morning. I look after my grandchildren most days. My husband and I live above the shop."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 89.77,
      "end_seconds": 92.64,
      "duration_seconds": 2.87,
      "text": "Alright, have you ever had an operation?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 93.69,
      "end_seconds": 100.93,
      "duration_seconds": 7.24,
      "text": "Yes, I had my appendix taken out, when I was in my twenties."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 116.29,
      "end_seconds": 118.72,
      "duration_seconds": 2.43,
      "text": "Let's run through your medicines."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 120.47,
      "end_seconds": 126.05,
      "duration_seconds": 5.58,
      "text": "Seretide inhaler, twice a day. Cetirizine, 10 milligrams, when it flares."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 137.67,
      "end_seconds": 142.88,
      "duration_seconds": 5.21,
      "text": "Has anything ever caused you a reaction? I mean any allergies."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 144.84,
      "end_seconds": 147.06,
      "duration_seconds": 2.22,
      "text": "No allergies at all."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 147.74,
      "end_seconds": 153.23,
      "duration_seconds": 5.49,
      "text": "A few quick ones: weight loss, fever, blue lips or ankle swelling?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 157.94,
      "end_seconds": 163.97,
      "duration_seconds": 6.03,
      "text": "No, no weight loss, fever, blue lips or ankle swelling."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 165.33,
      "end_seconds": 168.2,
      "duration_seconds": 2.87,
      "text": "Any muscle or joint problems besides this?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 169.35,
      "end_seconds": 171.12,
      "duration_seconds": 1.77,
      "text": "No, nothing there."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 172.6,
      "end_seconds": 175.96,
      "duration_seconds": 3.36,
      "text": "I'll note down your vital signs first."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 183.98,
      "end_seconds": 185.94,
      "duration_seconds": 1.96,
      "text": "Nearly done with the readings..."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 196.21,
      "end_seconds": 203.22,
      "duration_seconds": 7.01,
      "text": "Okay: SpO2 99 percent on room air, pulse 68, respiratory rate 18, BP is 118 over 79."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 204.69,
      "end_seconds": 206.81,
      "duration_seconds": 2.12,
      "text": "Is that alright, doctor?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 207.78,
      "end_seconds": 210.98,
      "duration_seconds": 3.2,
      "text": "I'll explain what these mean in a moment."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 212.93,
      "end_seconds": 217.38,
      "duration_seconds": 4.45,
      "text": "Now I'm going to do a short physical check."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 218.05,
      "end_seconds": 219.17,
      "duration_seconds": 1.12,
      "text": "Okay, doctor."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 220.09,
      "end_seconds": 222.56,
      "duration_seconds": 2.47,
      "text": "I'll listen to your chest now."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 233.17,
      "end_seconds": 240.21,
      "duration_seconds": 7.04,
      "text": "I can hear a faint wheeze at the end of breathing out, otherwise the chest is clear."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 243.78,
      "end_seconds": 254.18,
      "duration_seconds": 10.4,
      "text": "Thank you, you can get dressed. Putting it all together, I can't pin this down yet. We're looking at exercise-triggered asthma with seasonal allergy or reflux."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 255.44,
      "end_seconds": 258.39,
      "duration_seconds": 2.95,
      "text": "So, is it dangerous, doctor?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 260.42,
      "end_seconds": 273.89,
      "duration_seconds": 13.47,
      "text": "It's reasonable to be concerned, but right now exercise-triggered asthma with seasonal allergy is my leading thought, not anything worse. I'm sending you for an allergy test because of seasonal symptoms."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 278.66,
      "end_seconds": 281.17,
      "duration_seconds": 2.51,
      "text": "Yeah, that's fine with me."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 282.22,
      "end_seconds": 290.4,
      "duration_seconds": 8.18,
      "text": "I'm prescribing budesonide-formoterol inhaler, 200 micrograms, one puff twice a day, long term. That's for asthma control."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 292.2,
      "end_seconds": 295.12,
      "duration_seconds": 2.92,
      "text": "Alright, I'll pick it up today."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 297.02,
      "end_seconds": 307.66,
      "duration_seconds": 10.64,
      "text": "Rinse your mouth after the preventer inhaler and use the spacer. Book a review after the breathing test. Anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 308.62,
      "end_seconds": 311.54,
      "duration_seconds": 2.92,
      "text": "I think I understand everything. Thanks."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 315.08,
      "end_seconds": 316.78,
      "duration_seconds": 1.7,
      "text": "Alright, all the best."
    }
  ]
}