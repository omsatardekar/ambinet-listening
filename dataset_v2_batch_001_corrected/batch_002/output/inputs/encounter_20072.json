{
  "schema_version": "1.0",
  "encounter_id": "20072",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.16,
      "end_seconds": 4.5,
      "duration_seconds": 3.34,
      "text": "Morning, doctor. Lovely to meet you."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.66,
      "end_seconds": 9.57,
      "duration_seconds": 3.91,
      "text": "That's fine, sit down. Tell me why you came."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 10.84,
      "end_seconds": 13.94,
      "duration_seconds": 3.1,
      "text": "Thank you for fitting us in, doctor."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 14.67,
      "end_seconds": 18.53,
      "duration_seconds": 3.86,
      "text": "Good, that'll be useful. Pull up a a chair."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 21.1,
      "end_seconds": 24.99,
      "duration_seconds": 3.89,
      "text": "We came because of headaches in the morning."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_4",
      "role": "NURSE",
      "start_seconds": 26.26,
      "end_seconds": 34.5,
      "duration_seconds": 8.24,
      "text": "Doctor, I've got the readings for you. Saturation 97 percent, pulse is 75 beats a minute, pressure 171 over 95."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 36.06,
      "end_seconds": 36.76,
      "duration_seconds": 0.7,
      "text": "Thanks."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 47.85,
      "end_seconds": 49.61,
      "duration_seconds": 1.76,
      "text": "Alright, since when exactly?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 50.34,
      "end_seconds": 52.72,
      "duration_seconds": 2.38,
      "text": "I'd say a week, maybe"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 54.06,
      "end_seconds": 58.7,
      "duration_seconds": 4.64,
      "text": "okay, so hm, I'd say more like two weeks"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 59.59,
      "end_seconds": 64.45,
      "duration_seconds": 4.86,
      "text": "okay, so roughly one to two weeks. Is that right?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 70.3,
      "end_seconds": 72.45,
      "duration_seconds": 2.15,
      "text": "I suppose so, yes."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 73.73,
      "end_seconds": 78.41,
      "duration_seconds": 4.68,
      "text": "Is it there all the time or does it come and go?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 80.56,
      "end_seconds": 82.48,
      "duration_seconds": 1.92,
      "text": "Honestly, on and off."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 83.47,
      "end_seconds": 86.23,
      "duration_seconds": 2.76,
      "text": "Is it bearing on you a lot?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 87.21,
      "end_seconds": 91.56,
      "duration_seconds": 4.35,
      "text": "I'd give it a three, out of ten."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 93.45,
      "end_seconds": 95.85,
      "duration_seconds": 2.4,
      "text": "Is there anything else with it?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 97.71,
      "end_seconds": 104.19,
      "duration_seconds": 6.48,
      "text": "A pounding feeling in my neck goes along with it, most of the time."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 104.81,
      "end_seconds": 108.1,
      "duration_seconds": 3.29,
      "text": "Has there been blurred vision at times too?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 108.71,
      "end_seconds": 117.72,
      "duration_seconds": 9.01,
      "text": "Yes, I have. I mean, the pounding feeling in my neck? That's been for six months."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 118.85,
      "end_seconds": 126.48,
      "duration_seconds": 7.63,
      "text": "Have you noticed ankle swelling, weakness on one side, shortness of breath or chest pain?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 128.13,
      "end_seconds": 131.7,
      "duration_seconds": 3.57,
      "text": "no, uh, not a single one"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 136.55,
      "end_seconds": 137.92,
      "duration_seconds": 1.37,
      "text": "Any slurred speech?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 138.79,
      "end_seconds": 144.1,
      "duration_seconds": 5.31,
      "text": "let me think, not at all, no slurred speech"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 146.01,
      "end_seconds": 148.84,
      "duration_seconds": 2.83,
      "text": "how are your bowels, any trouble?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 150.36,
      "end_seconds": 152.13,
      "duration_seconds": 1.77,
      "text": "nothing unusual, no"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 164.33,
      "end_seconds": 166.96,
      "duration_seconds": 2.63,
      "text": "Now some background about your lifestyle."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 168.72,
      "end_seconds": 183.59,
      "duration_seconds": 14.87,
      "text": "I quit smoking around ten years ago. I drink a lot of tea and snack through the day. No, I share a house with my brother."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 184.63,
      "end_seconds": 188.28,
      "duration_seconds": 3.65,
      "text": "Has anyone in your family had anything serious?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 189.36,
      "end_seconds": 192.17,
      "duration_seconds": 2.81,
      "text": "My father has Parkinson's disease."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 193.47,
      "end_seconds": 197.56,
      "duration_seconds": 4.09,
      "text": "okay, any health conditions I should have on record?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 198.45,
      "end_seconds": 201.85,
      "duration_seconds": 3.4,
      "text": "yes, diabetes i've got high cholesterol"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 202.99,
      "end_seconds": 211.11,
      "duration_seconds": 8.12,
      "text": "okay, I can see high cholesterol in your file as well before we go further, any allergies?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 212.79,
      "end_seconds": 216.09,
      "duration_seconds": 3.3,
      "text": "No, I've never reacted to anything."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 218.03,
      "end_seconds": 224.64,
      "duration_seconds": 6.61,
      "text": "I'm not sure that's right. I seem to recall a problem with naproxen."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 225.28,
      "end_seconds": 227.85,
      "duration_seconds": 2.57,
      "text": "Really? I don't think so."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 229.59,
      "end_seconds": 235.51,
      "duration_seconds": 5.92,
      "text": "Okay, I'll note both of those. Which medicines do you take at the moment?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 236.87,
      "end_seconds": 245.69,
      "duration_seconds": 8.82,
      "text": "Right, it's sitagliptin, 100 milligrams, once a day for my sugar, doctor. He takes atorvastatin, 20 milligrams, at night."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 247.11,
      "end_seconds": 250.38,
      "duration_seconds": 3.27,
      "text": "Right, roughly how long on that one?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 254.71,
      "end_seconds": 256.81,
      "duration_seconds": 2.1,
      "text": "For nearly five years."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 258.29,
      "end_seconds": 267.88,
      "duration_seconds": 9.59,
      "text": "so, based on your history, my working impression is poorly controlled high blood pressure. A side effect of a medicine is still possible"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 280.62,
      "end_seconds": 291.73,
      "duration_seconds": 11.11,
      "text": "Check your blood pressure at home twice a day for a week and bring the readings. I'd like to see you again in four weeks."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 292.68,
      "end_seconds": 293.38,
      "duration_seconds": 0.7,
      "text": "Right."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 295.1,
      "end_seconds": 299.21,
      "duration_seconds": 4.11,
      "text": "that's everything on my side anything you're unsure about?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 301.02,
      "end_seconds": 304.5,
      "duration_seconds": 3.48,
      "text": "no, that's all thanks a lot"
    }
  ]
}