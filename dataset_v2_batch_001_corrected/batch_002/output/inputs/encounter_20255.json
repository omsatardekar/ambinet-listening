{
  "schema_version": "1.0",
  "encounter_id": "20255",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.12,
      "end_seconds": 5.18,
      "duration_seconds": 4.06,
      "text": "hello? Doctor? I was told to come in"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.59,
      "end_seconds": 10.1,
      "duration_seconds": 3.51,
      "text": "come in please sit how can I help you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 11.67,
      "end_seconds": 18.6,
      "duration_seconds": 6.93,
      "text": "Well, I've been having a red, hot area on my lower leg."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 19.58,
      "end_seconds": 22.9,
      "duration_seconds": 3.32,
      "text": "What do you take on a normal day?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 24.52,
      "end_seconds": 29.1,
      "duration_seconds": 4.58,
      "text": "I'm on metoprolol 50 milligrams maybe twice a day"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 29.67,
      "end_seconds": 33.76,
      "duration_seconds": 4.09,
      "text": "do you have the packet or the prescription with you?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 38.92,
      "end_seconds": 42.4,
      "duration_seconds": 3.48,
      "text": "No, uh, it's at home."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 43.53,
      "end_seconds": 45.99,
      "duration_seconds": 2.46,
      "text": "did it come on recently?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 48.06,
      "end_seconds": 50.12,
      "duration_seconds": 2.06,
      "text": "about... well three days"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 50.76,
      "end_seconds": 54.47,
      "duration_seconds": 3.71,
      "text": "what do you do to make it better?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 56.1,
      "end_seconds": 59.1,
      "duration_seconds": 3.0,
      "text": "It settles a little with elevation."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 59.62,
      "end_seconds": 62.27,
      "duration_seconds": 2.65,
      "text": "Alright, any other symptoms with it?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 64.6,
      "end_seconds": 78.99,
      "duration_seconds": 14.39,
      "text": "Pain in the calf goes along with it, most of the time and and I've been feeling feverish as well, for five days"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 92.69,
      "end_seconds": 97.91,
      "duration_seconds": 5.22,
      "text": "Have you noticed breathlessness pus chest pain or red streaks up the leg?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 99.34,
      "end_seconds": 102.2,
      "duration_seconds": 2.86,
      "text": "so, none of those, no"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 103.0,
      "end_seconds": 105.19,
      "duration_seconds": 2.19,
      "text": "Is your digestion otherwise okay?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 106.91,
      "end_seconds": 110.71,
      "duration_seconds": 3.8,
      "text": "Right, you know, no, all normal there."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 111.85,
      "end_seconds": 114.24,
      "duration_seconds": 2.39,
      "text": "What about your medical history?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 116.26,
      "end_seconds": 120.85,
      "duration_seconds": 4.59,
      "text": "I have high blood pressure, for about a year"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 122.14,
      "end_seconds": 125.04,
      "duration_seconds": 2.9,
      "text": "Have you been to theatre before?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 125.62,
      "end_seconds": 130.98,
      "duration_seconds": 5.36,
      "text": "just keyhole surgery on my gallbladder, two years back"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 132.82,
      "end_seconds": 137.02,
      "duration_seconds": 4.2,
      "text": "Let's talk a little about your daily life and habits."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 138.74,
      "end_seconds": 147.42,
      "duration_seconds": 8.68,
      "text": "I swim twice a week. I'm vegetarian and have been for years. My partner and our baby."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 155.24,
      "end_seconds": 162.12,
      "duration_seconds": 6.88,
      "text": "Let me ask about allergies anything at all? It helps to be thorough at this stage."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 163.38,
      "end_seconds": 165.07,
      "duration_seconds": 1.69,
      "text": "Erythromycin, I'd say"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 168.85,
      "end_seconds": 171.8,
      "duration_seconds": 2.95,
      "text": "I'll note down your vital signs first"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 180.1,
      "end_seconds": 182.6,
      "duration_seconds": 2.5,
      "text": "keep your arm relaxed for me.."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 197.38,
      "end_seconds": 204.84,
      "duration_seconds": 7.46,
      "text": "okay: oxygen saturation is 97 percent, temp 39.1 degrees. And pressure 120 over 67, pulse 105."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 208.59,
      "end_seconds": 210.43,
      "duration_seconds": 1.84,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 212.21,
      "end_seconds": 214.99,
      "duration_seconds": 2.78,
      "text": "we'll look at it it together shortly"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 216.59,
      "end_seconds": 218.91,
      "duration_seconds": 2.32,
      "text": "May I examine you now?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 220.43,
      "end_seconds": 223.2,
      "duration_seconds": 2.77,
      "text": "I'll listen to your chest now"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 238.21,
      "end_seconds": 246.05,
      "duration_seconds": 7.84,
      "text": "There is a warm, red, tender patch about ten centimetres across on the right shin with mild swelling."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 246.67,
      "end_seconds": 248.45,
      "duration_seconds": 1.78,
      "text": "fine by me"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 253.64,
      "end_seconds": 255.21,
      "duration_seconds": 1.57,
      "text": "Please sit back down."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 269.41,
      "end_seconds": 277.88,
      "duration_seconds": 8.47,
      "text": "Okay, so my impression is this: This is probably cellulitis of the right leg. We shouldn't forget a deep vein thrombosis."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 279.01,
      "end_seconds": 282.26,
      "duration_seconds": 3.25,
      "text": "right, is this serious, doctor?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 283.54,
      "end_seconds": 308.42,
      "duration_seconds": 24.88,
      "text": "I can't promise yet, but most people with cellulitis of the right leg do well once it's treated properly. Let's book blood tests to look into skin infection. I'm prescribing flucloxacillin, 500 milligrams, four times a day, for seven days. That's for cellulitis. Mark the edge of the redness with a pen and keep the leg raised when sitting"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 309.11,
      "end_seconds": 318.92,
      "duration_seconds": 9.81,
      "text": "and please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 320.22,
      "end_seconds": 321.36,
      "duration_seconds": 1.14,
      "text": "I understand."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 324.61,
      "end_seconds": 331.91,
      "duration_seconds": 7.3,
      "text": "do get help quickly if the redness spreads quickly or you get a high fever"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 332.69,
      "end_seconds": 336.42,
      "duration_seconds": 3.73,
      "text": "Yeah, uh, that's fine by me."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 337.62,
      "end_seconds": 341.07,
      "duration_seconds": 3.45,
      "text": "I think we're done unless you have questions."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 341.98,
      "end_seconds": 347.49,
      "duration_seconds": 5.51,
      "text": "hmm, okay, that makes sense thanks for explaining"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 352.66,
      "end_seconds": 353.86,
      "duration_seconds": 1.2,
      "text": "Take care now."
    }
  ]
}