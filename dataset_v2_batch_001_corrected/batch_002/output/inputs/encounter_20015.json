  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.65,
      "end_seconds": 6.58,
      "duration_seconds": 5.93,
      "text": "hello doctor, sorry, I took a wrong turn on the way here"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.2,
      "end_seconds": 11.4,
      "duration_seconds": 4.2,
      "text": "That's fine, sit down. Tell me why you came."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 13.2,
      "end_seconds": 21.19,
      "duration_seconds": 7.99,
      "text": "I mean good afternoon doctor. I look after them so so I thought I'd come"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 22.51,
      "end_seconds": 25.72,
      "duration_seconds": 3.21,
      "text": "please do extra information is always welcome"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 27.29,
      "end_seconds": 30.17,
      "duration_seconds": 2.88,
      "text": "we came because of nose bleeds"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 30.67,
      "end_seconds": 33.44,
      "duration_seconds": 2.77,
      "text": "Has this been going on for long?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 35.0,
      "end_seconds": 38.89,
      "duration_seconds": 3.89,
      "text": "It's been going on for nearly five years."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 39.56,
      "end_seconds": 42.5,
      "duration_seconds": 2.94,
      "text": "How much trouble does it give you?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 43.84,
      "end_seconds": 45.28,
      "duration_seconds": 1.44,
      "text": "I'd say severe."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 46.32,
      "end_seconds": 48.77,
      "duration_seconds": 2.45,
      "text": "Any bruising easily as well?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 50.5,
      "end_seconds": 60.32,
      "duration_seconds": 9.82,
      "text": "Yeah. About three months, I'd say. I was feeling tired at one point, but that's gone now."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 61.03,
      "end_seconds": 66.6,
      "duration_seconds": 5.57,
      "text": "have you had any fainting, pain at rest or blood in the urine?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 68.24,
      "end_seconds": 71.02,
      "duration_seconds": 2.78,
      "text": "no, nothing to report there"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 72.81,
      "end_seconds": 76.61,
      "duration_seconds": 3.8,
      "text": "So, any palpitations or black stools at all?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 78.18,
      "end_seconds": 80.14,
      "duration_seconds": 1.96,
      "text": "nope nothing like that"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 81.63,
      "end_seconds": 84.74,
      "duration_seconds": 3.11,
      "text": "right has your heart given you any trouble?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 85.41,
      "end_seconds": 90.49,
      "duration_seconds": 5.08,
      "text": "My heart's been fine as far as I know"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 91.18,
      "end_seconds": 94.03,
      "duration_seconds": 2.85,
      "text": "do you work outside the home?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 95.97,
      "end_seconds": 99.94,
      "duration_seconds": 3.97,
      "text": "I'm a hairdresser, on my feet all day"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 101.55,
      "end_seconds": 103.64,
      "duration_seconds": 2.09,
      "text": "do you live by yourself?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 104.39,
      "end_seconds": 108.98,
      "duration_seconds": 4.59,
      "text": "No, I share a house with my brother."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 117.85,
      "end_seconds": 120.49,
      "duration_seconds": 2.64,
      "text": "Have you had any surgical procedures?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 122.55,
      "end_seconds": 128.27,
      "duration_seconds": 5.72,
      "text": "just my appendix taken out when I was in my twenties"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 135.93,
      "end_seconds": 138.41,
      "duration_seconds": 2.48,
      "text": "Do you have any chronic illnesses?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 140.45,
      "end_seconds": 148.77,
      "duration_seconds": 8.32,
      "text": "I've I've had diabetes for two years now. Right I've had heart disease for five years now."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 150.6,
      "end_seconds": 160.31,
      "duration_seconds": 9.71,
      "text": "Right so diabetes is already on your record. We'll keep that in mind today. Have you got any known allergies?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 162.08,
      "end_seconds": 165.89,
      "duration_seconds": 3.81,
      "text": "No, um, not that I know of."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 183.79,
      "end_seconds": 185.79,
      "duration_seconds": 2.0,
      "text": "Tell me your medicines please."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 189.78,
      "end_seconds": 200.79,
      "duration_seconds": 11.01,
      "text": "it's glibenclamide 5 milligrams before breakfast for my sugar doctor. Mm he takes aspirin 75 milligrams once a day for my heart"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 201.38,
      "end_seconds": 205.77,
      "duration_seconds": 4.39,
      "text": "Mm, okay. Is there anything relevant on the family side?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 210.43,
      "end_seconds": 212.23,
      "duration_seconds": 1.8,
      "text": "My brother has epilepsy."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 214.77,
      "end_seconds": 217.28,
      "duration_seconds": 2.51,
      "text": "let's move on to the examination"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 219.22,
      "end_seconds": 221.92,
      "duration_seconds": 2.7,
      "text": "Take a deep breath for me."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 231.89,
      "end_seconds": 236.08,
      "duration_seconds": 4.19,
      "text": "Heart sounds are normal and your chest is clear"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 239.93,
      "end_seconds": 253.75,
      "duration_seconds": 13.82,
      "text": "that's the examination finished let me tell you where I've got to the most likely explanation is stable coronary disease on antiplatelet treatment, with minor bleeding i'd also keep angina in mind"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 259.17,
      "end_seconds": 261.86,
      "duration_seconds": 2.69,
      "text": "Is there something to worry about?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 262.6,
      "end_seconds": 288.38,
      "duration_seconds": 25.78,
      "text": "it's reasonable to be concerned, but right now stable coronary disease on antiplatelet treatment, with minor bleeding is my leading thought, not anything worse. I'll request a lipid profile, it'll help with cardiovascular risk. I think an ECG makes sense here, for chest discomfort. That will help us see what's going on underneath and decide the next step"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 289.64,
      "end_seconds": 319.01,
      "duration_seconds": 29.37,
      "text": "You'll be taking pantoprazole 40 milligrams before breakfast long term. You take it by mouth. That should help with stomach protection. Take your blood-thinning tablets after food and do not stop them on your own. If you pass black stools or have prolonged bleeding or you feel really unwell please come to the emergency department. I'll want another look in six weeks. Right what are the next steps as you understand them?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 320.4,
      "end_seconds": 330.53,
      "duration_seconds": 10.13,
      "text": "so I take the pantoprazole 40 milligrams before breakfast and come back in six weeks is that right?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 331.04,
      "end_seconds": 335.0,
      "duration_seconds": 3.96,
      "text": "yes, exactly right that's all from me any questions?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 336.8,
      "end_seconds": 340.08,
      "duration_seconds": 3.28,
      "text": "Great, thank you for your help."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 342.08,
      "end_seconds": 343.51,
      "duration_seconds": 1.43,
      "text": "Look after yourself."
    }
  ]
