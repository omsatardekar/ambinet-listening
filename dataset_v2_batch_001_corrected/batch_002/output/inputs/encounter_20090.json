{
  "schema_version": "1.0",
  "encounter_id": "20090",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.1,
      "end_seconds": 5.24,
      "duration_seconds": 4.14,
      "text": "Good evening, doctor, thanks for seeing me."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.8,
      "end_seconds": 9.57,
      "duration_seconds": 3.77,
      "text": "Of course, leave it there. How can I help?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 10.16,
      "end_seconds": 22.45,
      "duration_seconds": 12.29,
      "text": "Mainly loud snoring. There's a couple of other things, but that's the main one. I did try to ignore it for a while."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 24.26,
      "end_seconds": 27.58,
      "duration_seconds": 3.32,
      "text": "Has this been going on for long?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 29.15,
      "end_seconds": 32.95,
      "duration_seconds": 3.8,
      "text": "It's been three weeks, I'm fairly sure."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 34.65,
      "end_seconds": 36.74,
      "duration_seconds": 2.09,
      "text": "Does anything set it off?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 37.39,
      "end_seconds": 40.66,
      "duration_seconds": 3.27,
      "text": "It's worse with lying on my back."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 42.53,
      "end_seconds": 45.63,
      "duration_seconds": 3.1,
      "text": "What operations have you had, if any?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 46.3,
      "end_seconds": 51.81,
      "duration_seconds": 5.51,
      "text": "Just two stents put in my heart, three years ago."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 53.4,
      "end_seconds": 57.69,
      "duration_seconds": 4.29,
      "text": "Anything in your past medical history I should know?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 58.37,
      "end_seconds": 60.78,
      "duration_seconds": 2.41,
      "text": "I've had heart disease, yes."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 72.28,
      "end_seconds": 75.59,
      "duration_seconds": 3.31,
      "text": "Has anyone in your family had anything serious?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 76.74,
      "end_seconds": 78.77,
      "duration_seconds": 2.03,
      "text": "My cousin has psoriasis."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 81.59,
      "end_seconds": 84.56,
      "duration_seconds": 2.97,
      "text": "Alright, tell me your medicines, please."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 85.61,
      "end_seconds": 90.78,
      "duration_seconds": 5.17,
      "text": "Aspirin, 75 milligrams, once a day for my heart."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 92.81,
      "end_seconds": 97.82,
      "duration_seconds": 5.01,
      "text": "Tell me about your routine, work, habits, that sort of thing."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 98.88,
      "end_seconds": 114.71,
      "duration_seconds": 15.83,
      "text": "I used to drink heavily but I stopped four years ago. I walk the dog every morning. I live with my elderly mother. I look after my grandchildren most days."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 123.83,
      "end_seconds": 129.45,
      "duration_seconds": 5.62,
      "text": "Have you noticed falling asleep while driving, choking at night or chest pain?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 130.42,
      "end_seconds": 136.82,
      "duration_seconds": 6.4,
      "text": "No, no falling asleep while driving, choking at night or chest pain."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 138.82,
      "end_seconds": 141.78,
      "duration_seconds": 2.96,
      "text": "And your skin, any changes there?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 142.58,
      "end_seconds": 143.68,
      "duration_seconds": 1.1,
      "text": "Skin's normal."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 144.35,
      "end_seconds": 148.32,
      "duration_seconds": 3.97,
      "text": "On the cardiac side, anything I should know?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 149.42,
      "end_seconds": 151.67,
      "duration_seconds": 2.25,
      "text": "No, that's been fine."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 166.32,
      "end_seconds": 169.89,
      "duration_seconds": 3.57,
      "text": "Let me get the readings out of the way."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 183.84,
      "end_seconds": 186.17,
      "duration_seconds": 2.33,
      "text": "Bear with me while this finishes..."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 199.86,
      "end_seconds": 208.15,
      "duration_seconds": 8.29,
      "text": "Okay: respiratory rate 17, saturation 99 percent, heart rate 73. And temperature is 36.6 degrees, pressure 151 over 99."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 210.42,
      "end_seconds": 215.63,
      "duration_seconds": 5.21,
      "text": "I'll need to examine you for this, it won't take long."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 216.47,
      "end_seconds": 217.67,
      "duration_seconds": 1.2,
      "text": "Look straight ahead."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 227.74,
      "end_seconds": 233.4,
      "duration_seconds": 5.66,
      "text": "Your neck is thick and the back of the throat looks crowded."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 237.07,
      "end_seconds": 239.44,
      "duration_seconds": 2.37,
      "text": "Okay, that's enough for me."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 257.94,
      "end_seconds": 267.68,
      "duration_seconds": 9.74,
      "text": "So where does that leave us? It points towards symptoms that suggest obstructive sleep apnoea. Let's book a thyroid test to look into tiredness."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 268.71,
      "end_seconds": 272.73,
      "duration_seconds": 4.02,
      "text": "I can book that for Tuesday at 10 am."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 273.29,
      "end_seconds": 275.57,
      "duration_seconds": 2.28,
      "text": "Okay, I'll be there."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 277.26,
      "end_seconds": 292.86,
      "duration_seconds": 15.6,
      "text": "Try to sleep on your side and avoid alcohol close to bedtime. We'll refer you to the sleep clinic. Come back in six weeks. That's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 294.12,
      "end_seconds": 298.19,
      "duration_seconds": 4.07,
      "text": "Good, uh, thanks, I'll see you then."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 299.28,
      "end_seconds": 300.63,
      "duration_seconds": 1.35,
      "text": "See you soon."
    }
  ]
}