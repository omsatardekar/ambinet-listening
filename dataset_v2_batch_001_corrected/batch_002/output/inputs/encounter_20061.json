{
  "schema_version": "1.0",
  "encounter_id": "20061",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.04,
      "end_seconds": 5.33,
      "duration_seconds": 4.29,
      "text": "Hi, is it okay to come in now?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.98,
      "end_seconds": 9.97,
      "duration_seconds": 3.99,
      "text": "No problem at all, come in. What's troubling you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 12.06,
      "end_seconds": 19.01,
      "duration_seconds": 6.95,
      "text": "it's wheezing when I exercise. I thought I'd wait, but it hasn't gone"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 20.0,
      "end_seconds": 21.67,
      "duration_seconds": 1.67,
      "text": "What brings it on?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 22.21,
      "end_seconds": 25.72,
      "duration_seconds": 3.51,
      "text": "it's worse with cold air and running"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 26.48,
      "end_seconds": 28.95,
      "duration_seconds": 2.47,
      "text": "Is there anything else with it?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 30.88,
      "end_seconds": 46.04,
      "duration_seconds": 15.16,
      "text": "It usually comes with itchy eyes. The itchy eyes? That's been for about four days. A cough at night was there, uh, but it's gone away on its own."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 47.64,
      "end_seconds": 51.13,
      "duration_seconds": 3.49,
      "text": "I'll just record a a few vital signs"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 63.96,
      "end_seconds": 66.47,
      "duration_seconds": 2.51,
      "text": "That's it, just a little longer..."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 81.77,
      "end_seconds": 93.23,
      "duration_seconds": 11.46,
      "text": "Okay: oxygen saturation is 98 percent respiratory rate 16 pulse is 80 beats a minute. And temp 36.4 degrees blood pressure 116 over 72."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 93.83,
      "end_seconds": 95.25,
      "duration_seconds": 1.42,
      "text": "is that normal?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 97.34,
      "end_seconds": 99.86,
      "duration_seconds": 2.52,
      "text": "that's fine, I'll explain it soon"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 101.38,
      "end_seconds": 105.14,
      "duration_seconds": 3.76,
      "text": "Could you come over to the couch please?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 119.94,
      "end_seconds": 121.08,
      "duration_seconds": 1.14,
      "text": "Okay, doctor."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 122.16,
      "end_seconds": 123.37,
      "duration_seconds": 1.21,
      "text": "does that hurt?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 136.27,
      "end_seconds": 143.39,
      "duration_seconds": 7.12,
      "text": "I can hear a faint wheeze at the end of breathing out, otherwise the chest is clear"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 144.89,
      "end_seconds": 145.92,
      "duration_seconds": 1.03,
      "text": "sure thing"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 151.73,
      "end_seconds": 153.67,
      "duration_seconds": 1.94,
      "text": "all finished, thank you"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 168.32,
      "end_seconds": 173.53,
      "duration_seconds": 5.21,
      "text": "Did you get weight loss, blue lips, chest pain or ankle swelling?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 175.33,
      "end_seconds": 177.72,
      "duration_seconds": 2.39,
      "text": "no, I'd have said so"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 178.88,
      "end_seconds": 181.67,
      "duration_seconds": 2.79,
      "text": "any muscle or joint problems besides this?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 183.21,
      "end_seconds": 184.85,
      "duration_seconds": 1.64,
      "text": "Nothing else aches."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 186.33,
      "end_seconds": 188.33,
      "duration_seconds": 2.0,
      "text": "and alcohol, how much?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 189.38,
      "end_seconds": 195.19,
      "duration_seconds": 5.81,
      "text": "I used to drink heavily but I stopped four years ago."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 196.84,
      "end_seconds": 198.91,
      "duration_seconds": 2.07,
      "text": "right, do you smoke?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 202.12,
      "end_seconds": 205.43,
      "duration_seconds": 3.31,
      "text": "No, I've never smoked in my life"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 206.42,
      "end_seconds": 208.85,
      "duration_seconds": 2.43,
      "text": "tell me about your eating"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 210.51,
      "end_seconds": 216.16,
      "duration_seconds": 5.65,
      "text": "I drink a lot of tea and snack through the day."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 217.66,
      "end_seconds": 219.27,
      "duration_seconds": 1.61,
      "text": "Who lives with you?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 220.96,
      "end_seconds": 223.33,
      "duration_seconds": 2.37,
      "text": "My partner and our baby."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 225.37,
      "end_seconds": 229.18,
      "duration_seconds": 3.81,
      "text": "Are you taking anything regularly, including from the pharmacy?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 230.59,
      "end_seconds": 237.23,
      "duration_seconds": 6.64,
      "text": "Asthalin inhaler, when needed for my asthma. I take cetirizine, when it flares."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 239.69,
      "end_seconds": 242.15,
      "duration_seconds": 2.46,
      "text": "and what strength is that?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 242.84,
      "end_seconds": 243.81,
      "duration_seconds": 0.97,
      "text": "10 milligrams"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 245.43,
      "end_seconds": 248.11,
      "duration_seconds": 2.68,
      "text": "Have you got any known allergies?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 248.79,
      "end_seconds": 250.93,
      "duration_seconds": 2.14,
      "text": "no allergies at all"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 251.88,
      "end_seconds": 254.82,
      "duration_seconds": 2.94,
      "text": "do you have any chronic illnesses?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 255.53,
      "end_seconds": 261.86,
      "duration_seconds": 6.33,
      "text": "I have asthma for two years. Sorry I know I'm rambling a bit"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 262.78,
      "end_seconds": 269.71,
      "duration_seconds": 6.93,
      "text": "Yes, asthma is known to us, good to have that clear. Right, any previous surgeries?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 271.42,
      "end_seconds": 274.38,
      "duration_seconds": 2.96,
      "text": "Nothing I haven't had any operations."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 282.31,
      "end_seconds": 294.03,
      "duration_seconds": 11.72,
      "text": "having listened and examined it fits best with exercise-triggered asthma with seasonal allergy the reason I say that is that your story and my examination fit together"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 295.98,
      "end_seconds": 299.0,
      "duration_seconds": 3.02,
      "text": "Is there something to worry about?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 302.68,
      "end_seconds": 333.72,
      "duration_seconds": 31.04,
      "text": "I understand the worry. At the moment I'd say it's exercise-triggered asthma with seasonal allergy and we'll know more once the an allergy test is back. an allergy test is what I'd like next for seasonal symptoms. I'd like to arrange a breathing test for wheeze. I'll start you on budesonide-formoterol inhaler 200 micrograms one puff twice a day long term. It's for asthma control. Rinse your mouth after the preventer inhaler and use the spacer."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 335.76,
      "end_seconds": 344.49,
      "duration_seconds": 8.73,
      "text": "A peak flow diary is something we might do if this doesn't improve in a month. Come back in six weeks."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 345.22,
      "end_seconds": 345.92,
      "duration_seconds": 0.7,
      "text": "sure"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 346.92,
      "end_seconds": 349.77,
      "duration_seconds": 2.85,
      "text": "Does all of that that make sense?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 351.06,
      "end_seconds": 353.23,
      "duration_seconds": 2.17,
      "text": "thank you, doctor, goodbye"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 354.55,
      "end_seconds": 355.96,
      "duration_seconds": 1.41,
      "text": "see you soon"
    }
  ]
