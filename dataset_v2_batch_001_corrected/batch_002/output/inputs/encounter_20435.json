{
  "schema_version": "1.0",
  "encounter_id": "20435",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.38,
      "end_seconds": 8.06,
      "duration_seconds": 6.68,
      "text": "hello doctor, sorry, I took a wrong turn on the way here"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.94,
      "end_seconds": 13.43,
      "duration_seconds": 4.49,
      "text": "Of course, leave it there. How can I help?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 14.73,
      "end_seconds": 24.37,
      "duration_seconds": 9.64,
      "text": "Doctor, thank you for seeing us. Okay, so it's dark urine, doctor. He didn't wanna come, but I insisted."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 25.46,
      "end_seconds": 28.71,
      "duration_seconds": 3.25,
      "text": "how long has it been like this?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 30.19,
      "end_seconds": 37.54,
      "duration_seconds": 7.35,
      "text": "I'd say about two weeks. Actually no closer to to about a week"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 38.26,
      "end_seconds": 40.73,
      "duration_seconds": 2.47,
      "text": "Does anything else come with it?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 41.27,
      "end_seconds": 48.89,
      "duration_seconds": 7.62,
      "text": "No appetite goes along with it, most of the time. I've also had yellow eyes."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 50.21,
      "end_seconds": 55.24,
      "duration_seconds": 5.03,
      "text": "Have you had dark urine before, or is this the first time?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 55.96,
      "end_seconds": 62.95,
      "duration_seconds": 6.99,
      "text": "I had a similar thing a couple of years ago. It went away"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 80.02,
      "end_seconds": 84.34,
      "duration_seconds": 4.32,
      "text": "right what do you take on a a normal day?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 85.57,
      "end_seconds": 98.39,
      "duration_seconds": 12.82,
      "text": "he is on sumatriptan 50 milligrams when needed I give it to him he takes ramipril 5 milligrams every morning for my blood pressure"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 99.04,
      "end_seconds": 100.6,
      "duration_seconds": 1.56,
      "text": "and for how long?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 102.3,
      "end_seconds": 103.59,
      "duration_seconds": 1.29,
      "text": "About two months."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 104.15,
      "end_seconds": 108.59,
      "duration_seconds": 4.44,
      "text": "Is there anything relevant on the the family side?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 110.15,
      "end_seconds": 112.87,
      "duration_seconds": 2.72,
      "text": "My grandfather had a a stroke."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 113.39,
      "end_seconds": 114.97,
      "duration_seconds": 1.58,
      "text": "How active are you?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 118.93,
      "end_seconds": 122.78,
      "duration_seconds": 3.85,
      "text": "I hardly move around during the day."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 124.32,
      "end_seconds": 127.36,
      "duration_seconds": 3.04,
      "text": "what line of work are you in?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 128.46,
      "end_seconds": 133.48,
      "duration_seconds": 5.02,
      "text": "I'm a bus driver, so I sit for long hours"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 135.34,
      "end_seconds": 139.85,
      "duration_seconds": 4.51,
      "text": "What conditions have you been treated for in the past?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 140.89,
      "end_seconds": 144.4,
      "duration_seconds": 3.51,
      "text": "I have migraines, for about ten years"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 145.45,
      "end_seconds": 147.25,
      "duration_seconds": 1.8,
      "text": "Is there anything more?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 147.95,
      "end_seconds": 152.52,
      "duration_seconds": 4.57,
      "text": "I've had high blood pressure for five years now."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 153.18,
      "end_seconds": 161.28,
      "duration_seconds": 8.1,
      "text": "okay, I can see migraines and high blood pressure in your file as well. Before we go further, any allergies?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 161.98,
      "end_seconds": 165.53,
      "duration_seconds": 3.55,
      "text": "I don't think I have any, no"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 166.82,
      "end_seconds": 169.25,
      "duration_seconds": 2.43,
      "text": "nothing like severe abdominal pain?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 170.95,
      "end_seconds": 173.24,
      "duration_seconds": 2.29,
      "text": "No. No severe abdominal pain."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 177.0,
      "end_seconds": 180.45,
      "duration_seconds": 3.45,
      "text": "Did you get fever, itching or vomiting blood?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 181.42,
      "end_seconds": 185.99,
      "duration_seconds": 4.57,
      "text": "No fever, itching or vomiting blood, none of it."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 187.88,
      "end_seconds": 192.97,
      "duration_seconds": 5.09,
      "text": "Have you noticed any weakness or anything odd with your balance?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 194.01,
      "end_seconds": 195.41,
      "duration_seconds": 1.4,
      "text": "nothing odd there"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 195.98,
      "end_seconds": 198.72,
      "duration_seconds": 2.74,
      "text": "Let me take your readings now."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 207.12,
      "end_seconds": 209.7,
      "duration_seconds": 2.58,
      "text": "bear with me while this finishes.."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 220.92,
      "end_seconds": 233.7,
      "duration_seconds": 12.78,
      "text": "Okay: oxygen saturation is 97 percent, pulse 66. And blood pressure 120 over 79, temp 36.7 degrees, height 167 centimetres, respiratory rate 17, weight 94 kilos."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 234.42,
      "end_seconds": 236.64,
      "duration_seconds": 2.22,
      "text": "is that alright, doctor?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 238.38,
      "end_seconds": 241.02,
      "duration_seconds": 2.64,
      "text": "that's fine I'll explain it soon"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 243.86,
      "end_seconds": 249.3,
      "duration_seconds": 5.44,
      "text": "I'll need to examine you for this, it won't take long"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 253.78,
      "end_seconds": 255.28,
      "duration_seconds": 1.5,
      "text": "Yeah, no problem."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 257.04,
      "end_seconds": 259.01,
      "duration_seconds": 1.97,
      "text": "does that that hurt?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 269.26,
      "end_seconds": 276.06,
      "duration_seconds": 6.8,
      "text": "the whites of your eyes are yellow and the liver edge is tender under the right ribs"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 281.9,
      "end_seconds": 283.48,
      "duration_seconds": 1.58,
      "text": "That's the examination finished."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 291.3,
      "end_seconds": 299.18,
      "duration_seconds": 7.88,
      "text": "Let me tell you where I've got to. This looks most like an acute viral hepatitis."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 301.44,
      "end_seconds": 304.6,
      "duration_seconds": 3.16,
      "text": "Is there something to worry about?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 305.63,
      "end_seconds": 324.47,
      "duration_seconds": 18.84,
      "text": "nothing I've seen today points to an emergency. It looks like an acute viral hepatitis, but I'd like to confirm. Let me just check I've got this right. You've had dark urine for about a week, and no severe abdominal pain or itching"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 326.4,
      "end_seconds": 328.39,
      "duration_seconds": 1.99,
      "text": "that's what happened, yes"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 337.81,
      "end_seconds": 354.82,
      "duration_seconds": 17.01,
      "text": "I want liver blood tests done that's for jaundice. No alcohol at all and avoid paracetamol and other painkillers unless we say. The The liver clinic would be the right next step I'll refer you. Let's plan a check after the results."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 355.56,
      "end_seconds": 356.26,
      "duration_seconds": 0.7,
      "text": "Sure."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 358.03,
      "end_seconds": 360.9,
      "duration_seconds": 2.87,
      "text": "okay, have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 366.64,
      "end_seconds": 370.08,
      "duration_seconds": 3.44,
      "text": "Great, thank you for your help."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 371.1,
      "end_seconds": 372.27,
      "duration_seconds": 1.17,
      "text": "All the best."
    }
  ]
}