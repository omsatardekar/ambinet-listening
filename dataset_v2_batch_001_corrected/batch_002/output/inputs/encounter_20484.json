{
  "schema_version": "1.0",
  "encounter_id": "20484",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.6,
      "end_seconds": 6.78,
      "duration_seconds": 6.18,
      "text": "Doctor, hi, where would you like me to put my coat?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.68,
      "end_seconds": 12.33,
      "duration_seconds": 4.65,
      "text": "Not at all, please sit. What seems to be wrong?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 13.26,
      "end_seconds": 17.55,
      "duration_seconds": 4.29,
      "text": "Good morning, doctor. I came along to help out."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 18.35,
      "end_seconds": 21.09,
      "duration_seconds": 2.74,
      "text": "please do. Extra information is always welcome"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 22.21,
      "end_seconds": 25.82,
      "duration_seconds": 3.61,
      "text": "She's been having a dry cough, doctor."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 27.31,
      "end_seconds": 29.75,
      "duration_seconds": 2.44,
      "text": "Let's start with the basic checks."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 42.46,
      "end_seconds": 44.85,
      "duration_seconds": 2.39,
      "text": "keep your arm relaxed for me.."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 64.53,
      "end_seconds": 73.52,
      "duration_seconds": 8.99,
      "text": "okay: BP is 123 over 73, pulse is 84 beats a minute, SpO2 90 percent on room air since when exactly?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 74.57,
      "end_seconds": 76.93,
      "duration_seconds": 2.36,
      "text": "It's been three days now."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 77.76,
      "end_seconds": 85.97,
      "duration_seconds": 8.21,
      "text": "Can you describe it a bit more for me? How strong it is, what the pattern is, what helps."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 87.16,
      "end_seconds": 102.71,
      "duration_seconds": 15.55,
      "text": "Only honey, and it's not much. Mostly moderate. It happens all the time. Work has been very busy so I kept ignoring it. And there's aching all over as well, about a week now."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 102.99,
      "end_seconds": 106.22,
      "duration_seconds": 3.23,
      "text": "ah have you had a high temperature?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 108.15,
      "end_seconds": 111.45,
      "duration_seconds": 3.3,
      "text": "Yeah, I've had that since Monday."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 112.22,
      "end_seconds": 118.75,
      "duration_seconds": 6.53,
      "text": "Have you had a dry cough before, or is this the first time?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 120.24,
      "end_seconds": 127.09,
      "duration_seconds": 6.85,
      "text": "A bit, about six months ago. It settled by itself back then."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 136.04,
      "end_seconds": 138.31,
      "duration_seconds": 2.27,
      "text": "Alright, any vomiting or confusion?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 140.25,
      "end_seconds": 142.66,
      "duration_seconds": 2.41,
      "text": "No, no vomiting or confusion."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 144.6,
      "end_seconds": 150.22,
      "duration_seconds": 5.62,
      "text": "Let me check a few things. Any blue lips or chest pain?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 151.9,
      "end_seconds": 155.8,
      "duration_seconds": 3.9,
      "text": "No, I haven't had any of them."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 156.79,
      "end_seconds": 159.18,
      "duration_seconds": 2.39,
      "text": "Any trouble with the waterworks?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 159.73,
      "end_seconds": 161.39,
      "duration_seconds": 1.66,
      "text": "Nothing there, no."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 174.58,
      "end_seconds": 183.36,
      "duration_seconds": 8.78,
      "text": "can you list what you take, tablets, creams or inhalers? I ask because it helps me narrow things down"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 185.39,
      "end_seconds": 191.03,
      "duration_seconds": 5.64,
      "text": "Erm, it's glibenclamide, 5 milligrams, maybe, before breakfast for my sugar."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 191.62,
      "end_seconds": 195.69,
      "duration_seconds": 4.07,
      "text": "Have you got the box or the prescription on you?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 196.94,
      "end_seconds": 205.44,
      "duration_seconds": 8.5,
      "text": "Not with me. I'll bring it next time. I take Dolo, 650 milligrams, when I get the fever."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 206.74,
      "end_seconds": 210.77,
      "duration_seconds": 4.03,
      "text": "Anything in your past medical history I should know?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 211.7,
      "end_seconds": 212.82,
      "duration_seconds": 1.12,
      "text": "yes, diabetes"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 213.44,
      "end_seconds": 214.14,
      "duration_seconds": 0.7,
      "text": "Ah."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 215.14,
      "end_seconds": 218.64,
      "duration_seconds": 3.5,
      "text": "High blood pressure, for about ten years."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 220.61,
      "end_seconds": 229.34,
      "duration_seconds": 8.73,
      "text": "Okay, I can see diabetes and high blood pressure in your file as well. Does your family have any medical conditions?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 231.01,
      "end_seconds": 233.63,
      "duration_seconds": 2.62,
      "text": "My sister had breast cancer."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 235.46,
      "end_seconds": 237.84,
      "duration_seconds": 2.38,
      "text": "do you get out much?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 239.46,
      "end_seconds": 243.39,
      "duration_seconds": 3.93,
      "text": "Not much, I mostly stay in these days"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 244.48,
      "end_seconds": 246.18,
      "duration_seconds": 1.7,
      "text": "have you retired yet?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 247.3,
      "end_seconds": 251.72,
      "duration_seconds": 4.42,
      "text": "I retired from the post office two years ago"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 252.64,
      "end_seconds": 254.79,
      "duration_seconds": 2.15,
      "text": "tell me about your eating"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 259.37,
      "end_seconds": 264.94,
      "duration_seconds": 5.57,
      "text": "I drink a lot of tea and snack through the day."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 276.72,
      "end_seconds": 280.74,
      "duration_seconds": 4.02,
      "text": "let me ask about allergies, anything at all?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 282.19,
      "end_seconds": 284.97,
      "duration_seconds": 2.78,
      "text": "I've never had an allergy."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 285.87,
      "end_seconds": 293.45,
      "duration_seconds": 7.58,
      "text": "Actually, I remember she had some kind of reaction to naproxen before. I couldn't swear to it."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 298.41,
      "end_seconds": 300.8,
      "duration_seconds": 2.39,
      "text": "Really? I don't think so."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 302.29,
      "end_seconds": 304.86,
      "duration_seconds": 2.57,
      "text": "okay, I'll note both of those"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 307.12,
      "end_seconds": 311.41,
      "duration_seconds": 4.29,
      "text": "Let me look at the area, I'll be gentle."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 313.38,
      "end_seconds": 315.77,
      "duration_seconds": 2.39,
      "text": "Raise your arm for me."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 332.22,
      "end_seconds": 340.91,
      "duration_seconds": 8.69,
      "text": "Your chest is clear apart from a few crackles at the right base and your oxygen level is a bit low."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 346.01,
      "end_seconds": 375.34,
      "duration_seconds": 29.33,
      "text": "All finished, thank you. I think a chest X-ray makes sense here, for low oxygen and crackles. Let's book a viral swab to look into fever and cough. Rest, keep your fluids up and lie on your tummy or side to help your breathing. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 376.49,
      "end_seconds": 379.42,
      "duration_seconds": 2.93,
      "text": "Yes, I'll bear that in mind."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 380.73,
      "end_seconds": 388.14,
      "duration_seconds": 7.41,
      "text": "I'd like to see you again after the chest X-ray. I think we're done unless you have questions."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 389.39,
      "end_seconds": 392.79,
      "duration_seconds": 3.4,
      "text": "No, that's all. Thanks a lot."
    }
  ]
}