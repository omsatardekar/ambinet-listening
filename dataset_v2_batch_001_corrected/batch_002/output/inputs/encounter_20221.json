{
  "schema_version": "1.0",
  "encounter_id": "20221",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.36,
      "end_seconds": 6.7,
      "duration_seconds": 5.34,
      "text": "Good morning, grab a seat. So what can I do for you?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 9.83,
      "end_seconds": 14.89,
      "duration_seconds": 5.06,
      "text": "I've been waking at night with my hand numb."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 20.53,
      "end_seconds": 26.92,
      "duration_seconds": 6.39,
      "text": "How long has it been like this? I'll explain everything as we go along."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 28.44,
      "end_seconds": 30.49,
      "duration_seconds": 2.05,
      "text": "Probably four weeks. Yeah."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 34.8,
      "end_seconds": 37.21,
      "duration_seconds": 2.41,
      "text": "How much does it limit you?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 38.89,
      "end_seconds": 42.68,
      "duration_seconds": 3.79,
      "text": "I'd give it a seven, out of ten."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 44.66,
      "end_seconds": 48.82,
      "duration_seconds": 4.16,
      "text": "Right, time for your numbers, if that's okay."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 57.28,
      "end_seconds": 59.62,
      "duration_seconds": 2.34,
      "text": "Keep your arm relaxed for me..."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 76.57,
      "end_seconds": 82.2,
      "duration_seconds": 5.63,
      "text": "Okay: pulse 76, temp 36.9 degrees, blood pressure 126 over 79."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 83.12,
      "end_seconds": 84.54,
      "duration_seconds": 1.42,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 86.53,
      "end_seconds": 89.82,
      "duration_seconds": 3.29,
      "text": "Don't worry, we'll discuss it in a second."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 91.02,
      "end_seconds": 95.43,
      "duration_seconds": 4.41,
      "text": "Alright, over here please and I'll take a look."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 96.4,
      "end_seconds": 98.09,
      "duration_seconds": 1.69,
      "text": "Yes, that's fine."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 99.08,
      "end_seconds": 100.43,
      "duration_seconds": 1.35,
      "text": "Look straight ahead."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 108.12,
      "end_seconds": 117.23,
      "duration_seconds": 9.11,
      "text": "Tapping over the wrist brings on the tingling, and the muscle at the base of the thumb looks slightly thin."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 121.39,
      "end_seconds": 129.91,
      "duration_seconds": 8.52,
      "text": "Okay, you can relax now. And what about injury to the wrist, weakness in the legs or swelling of the wrist?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 130.72,
      "end_seconds": 139.08,
      "duration_seconds": 8.36,
      "text": "No injury to the wrist, weakness in the legs or swelling of the wrist, none of it."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 140.6,
      "end_seconds": 143.46,
      "duration_seconds": 2.86,
      "text": "Any muscle or joint problems besides this?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 145.35,
      "end_seconds": 147.17,
      "duration_seconds": 1.82,
      "text": "I move fine otherwise."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 165.06,
      "end_seconds": 168.2,
      "duration_seconds": 3.14,
      "text": "What do you do during the day?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 169.62,
      "end_seconds": 173.52,
      "duration_seconds": 3.9,
      "text": "I look after my grandchildren most days."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 174.6,
      "end_seconds": 178.24,
      "duration_seconds": 3.64,
      "text": "What does a normal day of food look like?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 179.97,
      "end_seconds": 183.56,
      "duration_seconds": 3.59,
      "text": "Lots of rice, lentils and some fruit."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 184.12,
      "end_seconds": 188.97,
      "duration_seconds": 4.85,
      "text": "Has anything ever caused you a reaction? I mean any allergies."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 190.14,
      "end_seconds": 194.35,
      "duration_seconds": 4.21,
      "text": "I'm allergic to milk, I get a rash."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 195.06,
      "end_seconds": 199.77,
      "duration_seconds": 4.71,
      "text": "Any inherited conditions that you know of in the family?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 200.58,
      "end_seconds": 203.24,
      "duration_seconds": 2.66,
      "text": "Actually, my grandmother had dementia."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 215.45,
      "end_seconds": 218.15,
      "duration_seconds": 2.7,
      "text": "Have you had any surgical procedures?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 219.68,
      "end_seconds": 225.74,
      "duration_seconds": 6.06,
      "text": "I, I had a meniscus repair on my knee four years ago."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 227.17,
      "end_seconds": 232.6,
      "duration_seconds": 5.43,
      "text": "Right, do you have any medical conditions I should know about?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 234.43,
      "end_seconds": 237.46,
      "duration_seconds": 3.03,
      "text": "No, nothing I can think of."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 238.17,
      "end_seconds": 241.07,
      "duration_seconds": 2.9,
      "text": "Are you on any regular medication?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 241.7,
      "end_seconds": 243.31,
      "duration_seconds": 1.61,
      "text": "Nothing regular, no."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 259.96,
      "end_seconds": 265.48,
      "duration_seconds": 5.52,
      "text": "So where does that leave us? This looks most like carpal tunnel syndrome."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 275.24,
      "end_seconds": 279.73,
      "duration_seconds": 4.49,
      "text": "Blood tests is what I'd like next, for numbness."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 280.49,
      "end_seconds": 286.03,
      "duration_seconds": 5.54,
      "text": "We have a slot Tuesday at 3:30 pm, if that works."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 287.68,
      "end_seconds": 296.23,
      "duration_seconds": 8.55,
      "text": "A wrist splint at night will often settle it. Right, I think we're done unless you have questions."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 297.46,
      "end_seconds": 300.88,
      "duration_seconds": 3.42,
      "text": "Right, I'll do that. Thank you, doctor."
    }
  ]
}