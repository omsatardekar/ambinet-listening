    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "CAREGIVER",
      "start_seconds": 175.44,
      "end_seconds": 181.94,
      "duration_seconds": 6.5,
      "text": "it's 5 milligrams. It's aspirin, 75 milligrams, once a day for my heart, doctor"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 182.52,
      "end_seconds": 186.21,
      "duration_seconds": 3.69,
      "text": "Anything in your past medical history I should know?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 186.74,
      "end_seconds": 191.93,
      "duration_seconds": 5.19,
      "text": "yes high blood pressure. I have diabetes for about a year"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 192.51,
      "end_seconds": 193.21,
      "duration_seconds": 0.7,
      "text": "Sure."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 195.0,
      "end_seconds": 196.83,
      "duration_seconds": 1.83,
      "text": "I've got heart disease."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 197.97,
      "end_seconds": 206.07,
      "duration_seconds": 8.1,
      "text": "alright diabetes that matches what I have here. A few quick ones: confusion black toes or chest pain?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 208.0,
      "end_seconds": 212.44,
      "duration_seconds": 4.44,
      "text": "no um I haven't had any of them"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 214.24,
      "end_seconds": 218.49,
      "duration_seconds": 4.25,
      "text": "So what about pain at rest in the leg?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 219.73,
      "end_seconds": 224.09,
      "duration_seconds": 4.36,
      "text": "no, none, no pain at rest in the leg"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 225.03,
      "end_seconds": 227.39,
      "duration_seconds": 2.36,
      "text": "Did you notice any vomiting?"
