      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "CAREGIVER",
      "start_seconds": 166.27,
      "end_seconds": 171.43,
      "duration_seconds": 5.16,
      "text": "he is on glibenclamide, before breakfast, I give it to him"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 172.0,
      "end_seconds": 174.82,
      "duration_seconds": 2.82,
      "text": "And And what strength is that?"
