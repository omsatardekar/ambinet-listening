    {
      "segment_id": "SEG0020",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 149.04,
      "end_seconds": 152.92,
      "duration_seconds": 3.88,
      "text": "I'm a hairdresser, on my feet all day."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 153.42,
      "end_seconds": 156.28,
      "duration_seconds": 2.86,
      "text": "alright, do you follow any particular diet?"
