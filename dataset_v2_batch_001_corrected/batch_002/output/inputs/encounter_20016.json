      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "CAREGIVER",
      "start_seconds": 41.46,
      "end_seconds": 45.42,
      "duration_seconds": 3.96,
      "text": "I think it's been nearer a month, actually"
