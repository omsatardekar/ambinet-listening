    {
      "segment_id": "SEG0004",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 21.42,
      "end_seconds": 29.41,
      "duration_seconds": 7.99,
      "text": "Yeah, it's a sore on the bottom of my foot. I don't know what's causing it."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 31.44,
      "end_seconds": 35.23,
      "duration_seconds": 3.79,
      "text": "how many days or weeks has it been?"
