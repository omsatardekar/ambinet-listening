{
  "schema_version": "1.0",
  "encounter_id": "20500",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.82,
      "end_seconds": 5.12,
      "duration_seconds": 4.3,
      "text": "Doctor? Hello, I hope this is the right time."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.1,
      "end_seconds": 10.99,
      "duration_seconds": 3.89,
      "text": "No problem at all, come in. What's troubling you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 11.85,
      "end_seconds": 18.25,
      "duration_seconds": 6.4,
      "text": "Doctor, I've come along because I know the history, if it helps."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 19.46,
      "end_seconds": 22.94,
      "duration_seconds": 3.48,
      "text": "Yes, that's no problem at all. Please sit."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 24.58,
      "end_seconds": 33.67,
      "duration_seconds": 9.09,
      "text": "Okay, so doctor, it's been waking at night with my hand numb. That's what we're worried about."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 34.59,
      "end_seconds": 38.4,
      "duration_seconds": 3.81,
      "text": "Let me get the readings out of the way."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 50.71,
      "end_seconds": 53.64,
      "duration_seconds": 2.93,
      "text": "Bear with me while this finishes..."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 68.13,
      "end_seconds": 75.1,
      "duration_seconds": 6.97,
      "text": "Okay: heart rate 71, respiratory rate 18, temp 36.5 degrees. And BP is 116 over 70."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 76.29,
      "end_seconds": 77.66,
      "duration_seconds": 1.37,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 78.88,
      "end_seconds": 90.08,
      "duration_seconds": 11.2,
      "text": "Don't worry, we'll discuss it in a second. Can you describe it a bit more for me? How strong it is, what the pattern is, what helps."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 91.98,
      "end_seconds": 104.66,
      "duration_seconds": 12.68,
      "text": "A six out of ten, um, I suppose. It happens once or twice a day. Ah, and there's dropping things as well, about a year now."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 105.4,
      "end_seconds": 108.97,
      "duration_seconds": 3.57,
      "text": "Is it a lot or only a little?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 110.19,
      "end_seconds": 111.69,
      "duration_seconds": 1.5,
      "text": "It's severe, honestly."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 112.94,
      "end_seconds": 117.03,
      "duration_seconds": 4.09,
      "text": "And what about swelling of the wrist or neck pain?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 118.66,
      "end_seconds": 124.27,
      "duration_seconds": 5.61,
      "text": "I haven't had swelling of the wrist or neck pain, no."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 125.14,
      "end_seconds": 131.1,
      "duration_seconds": 5.96,
      "text": "So, did you get fever, weight loss or weakness in the legs?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 132.95,
      "end_seconds": 139.41,
      "duration_seconds": 6.46,
      "text": "So, no, no fever, weight loss or weakness in the legs."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 141.38,
      "end_seconds": 145.89,
      "duration_seconds": 4.51,
      "text": "Anything with your heart, like skipped beats or fainting?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 147.88,
      "end_seconds": 150.48,
      "duration_seconds": 2.6,
      "text": "No, nothing with my heart."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 151.43,
      "end_seconds": 153.33,
      "duration_seconds": 1.9,
      "text": "How's your breathing otherwise?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 153.98,
      "end_seconds": 154.9,
      "duration_seconds": 0.92,
      "text": "Breathing's normal."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 172.21,
      "end_seconds": 175.13,
      "duration_seconds": 2.92,
      "text": "Are there any illnesses in your family?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 175.87,
      "end_seconds": 178.7,
      "duration_seconds": 2.83,
      "text": "My father had bowel cancer."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 179.76,
      "end_seconds": 183.39,
      "duration_seconds": 3.63,
      "text": "Are there any allergies I should be aware of?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 185.48,
      "end_seconds": 189.24,
      "duration_seconds": 3.76,
      "text": "No, nothing as far as I know."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 205.65,
      "end_seconds": 208.72,
      "duration_seconds": 3.07,
      "text": "What operations have you had, if any?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 209.25,
      "end_seconds": 213.31,
      "duration_seconds": 4.06,
      "text": "Just my septum straightened, in my thirties."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 229.1,
      "end_seconds": 237.01,
      "duration_seconds": 7.91,
      "text": "Do you take any prescribed or over-the-counter medicines? I ask because it helps me narrow things down."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 238.77,
      "end_seconds": 244.31,
      "duration_seconds": 5.54,
      "text": "I take sitagliptin, 100 milligrams, once a day for my sugar."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 249.88,
      "end_seconds": 255.04,
      "duration_seconds": 5.16,
      "text": "Tell me about your routine, work, habits, that sort of thing."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 256.07,
      "end_seconds": 267.38,
      "duration_seconds": 11.31,
      "text": "My husband and I live above the shop. Lots of rice, lentils and some fruit. Yes, I work in a bakery, early starts."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 268.03,
      "end_seconds": 270.1,
      "duration_seconds": 2.07,
      "text": "What about your medical history?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 275.37,
      "end_seconds": 276.81,
      "duration_seconds": 1.44,
      "text": "I've got diabetes."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 278.1,
      "end_seconds": 281.78,
      "duration_seconds": 3.68,
      "text": "Could you come over to the couch, please?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 282.67,
      "end_seconds": 283.8,
      "duration_seconds": 1.13,
      "text": "Of course."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 284.72,
      "end_seconds": 285.98,
      "duration_seconds": 1.26,
      "text": "Nearly finished here."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 300.43,
      "end_seconds": 308.77,
      "duration_seconds": 8.34,
      "text": "Tapping over the wrist brings on the tingling, and the muscle at the base of the thumb looks slightly thin."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 313.59,
      "end_seconds": 331.42,
      "duration_seconds": 17.83,
      "text": "All finished, thank you. Right, here's what I'm thinking. I think we're dealing with carpal tunnel syndrome at this stage. I'll request nerve conduction tests, it'll help with hand numbness. I'll request blood tests, it'll help with numbness."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 333.07,
      "end_seconds": 334.76,
      "duration_seconds": 1.69,
      "text": "That makes sense."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 336.38,
      "end_seconds": 350.52,
      "duration_seconds": 14.14,
      "text": "A wrist splint at night will often settle it. Come back or go to emergency straight away if the numbness spreads or you notice more weakness. Book a review after the nerve test."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 351.38,
      "end_seconds": 354.15,
      "duration_seconds": 2.77,
      "text": "I'll note it in my calendar."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 354.69,
      "end_seconds": 358.11,
      "duration_seconds": 3.42,
      "text": "Right, that's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 363.09,
      "end_seconds": 366.63,
      "duration_seconds": 3.54,
      "text": "Okay, so thank you, doctor, goodbye."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 369.61,
      "end_seconds": 371.35,
      "duration_seconds": 1.74,
      "text": "Have a good day."
    }
  ]
}