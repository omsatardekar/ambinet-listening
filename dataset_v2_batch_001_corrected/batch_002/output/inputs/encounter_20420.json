{
  "schema_version": "1.0",
  "encounter_id": "20420",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.81,
      "end_seconds": 3.94,
      "duration_seconds": 3.13,
      "text": "Sorry, doctor, shall I sit here?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 4.98,
      "end_seconds": 9.0,
      "duration_seconds": 4.02,
      "text": "That's fine, sit down. Tell me why you came."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 11.01,
      "end_seconds": 20.29,
      "duration_seconds": 9.28,
      "text": "Doctor, it's a painful rash on one side of my chest. It's getting on my nerves now."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 21.89,
      "end_seconds": 25.27,
      "duration_seconds": 3.38,
      "text": "When was the first time you noticed it?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 26.26,
      "end_seconds": 29.74,
      "duration_seconds": 3.48,
      "text": "It's been three days, I'm fairly sure."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 30.44,
      "end_seconds": 40.2,
      "duration_seconds": 9.76,
      "text": "Right, tell me a bit more about it: how bad it gets, how often, and whether anything makes it better or worse."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 41.86,
      "end_seconds": 47.75,
      "duration_seconds": 5.89,
      "text": "It's worse with touch. I'd say a few times a day."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 66.51,
      "end_seconds": 68.95,
      "duration_seconds": 2.44,
      "text": "Has there been any vision changes?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 72.15,
      "end_seconds": 74.37,
      "duration_seconds": 2.22,
      "text": "Nope, no vision changes."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 75.72,
      "end_seconds": 82.81,
      "duration_seconds": 7.09,
      "text": "Have you noticed contact with chickenpox, rash near the eye or rash on the other side?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 84.25,
      "end_seconds": 92.75,
      "duration_seconds": 8.5,
      "text": "No, no contact with chickenpox, rash near the eye or rash on the other side."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 93.82,
      "end_seconds": 96.96,
      "duration_seconds": 3.14,
      "text": "Has your heart given you any trouble?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 98.71,
      "end_seconds": 100.29,
      "duration_seconds": 1.58,
      "text": "Nothing like that."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 108.77,
      "end_seconds": 111.95,
      "duration_seconds": 3.18,
      "text": "Which medicines do you take at the moment?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 112.89,
      "end_seconds": 118.21,
      "duration_seconds": 5.32,
      "text": "Dolo. I take it 650 milligrams, when I get the pain."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 119.05,
      "end_seconds": 120.38,
      "duration_seconds": 1.33,
      "text": "Do you smoke?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 123.3,
      "end_seconds": 126.17,
      "duration_seconds": 2.87,
      "text": "I gave up cigarettes last spring."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 127.19,
      "end_seconds": 128.5,
      "duration_seconds": 1.31,
      "text": "Are you active?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 129.22,
      "end_seconds": 131.99,
      "duration_seconds": 2.77,
      "text": "I walk the dog every morning."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 133.15,
      "end_seconds": 135.64,
      "duration_seconds": 2.49,
      "text": "Do you work outside the home?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 136.37,
      "end_seconds": 140.14,
      "duration_seconds": 3.77,
      "text": "I'm a hairdresser, on my feet all day."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 142.04,
      "end_seconds": 144.38,
      "duration_seconds": 2.34,
      "text": "Do you follow any particular diet?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 145.59,
      "end_seconds": 149.52,
      "duration_seconds": 3.93,
      "text": "I'm vegetarian and have been for years."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 166.13,
      "end_seconds": 169.93,
      "duration_seconds": 3.8,
      "text": "Any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 171.13,
      "end_seconds": 174.42,
      "duration_seconds": 3.29,
      "text": "No, nothing I can think of."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 176.44,
      "end_seconds": 179.61,
      "duration_seconds": 3.17,
      "text": "I'll just record a few vital signs."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 193.54,
      "end_seconds": 195.74,
      "duration_seconds": 2.2,
      "text": "Sit still for a moment..."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 207.85,
      "end_seconds": 218.24,
      "duration_seconds": 10.39,
      "text": "Okay: blood pressure 119 over 77, respiratory rate 17, SpO2 97 percent on room air, temperature 38.1, pulse is 103 beats a minute."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 219.6,
      "end_seconds": 223.93,
      "duration_seconds": 4.33,
      "text": "I'd like to check you over now, if that's alright."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 225.25,
      "end_seconds": 226.69,
      "duration_seconds": 1.44,
      "text": "Does that hurt?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 235.48,
      "end_seconds": 246.3,
      "duration_seconds": 10.82,
      "text": "There are clustered blisters on a red base in a band across the right side of the chest, not crossing the midline."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 249.8,
      "end_seconds": 252.69,
      "duration_seconds": 2.89,
      "text": "That's all I needed to check."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 262.65,
      "end_seconds": 268.5,
      "duration_seconds": 5.85,
      "text": "Let me tell you where I've got to. It points towards shingles."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 270.09,
      "end_seconds": 272.85,
      "duration_seconds": 2.76,
      "text": "Do you think it's something serious?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 278.53,
      "end_seconds": 289.27,
      "duration_seconds": 10.74,
      "text": "I can't promise yet, but most people with shingles do well once it's treated properly. I'm going to order a swab from a blister, for vesicular rash."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 292.61,
      "end_seconds": 295.36,
      "duration_seconds": 2.75,
      "text": "How long will it take?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 296.06,
      "end_seconds": 307.77,
      "duration_seconds": 11.71,
      "text": "I'm going to put you on aciclovir, 800 milligrams, five times a day, for seven days. You take it by mouth. It's for shingles."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 309.07,
      "end_seconds": 310.65,
      "duration_seconds": 1.58,
      "text": "That's simple enough."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 312.07,
      "end_seconds": 339.35,
      "duration_seconds": 27.28,
      "text": "Keep the rash clean and dry and avoid contact with pregnant women or newborns until the blisters crust over. Avoid taking any extra painkillers on top of what I'm prescribing without checking with us. Come back or go to emergency straight away if the rash spreads to the eye or face. See me again if the pain persists after a month."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 341.14,
      "end_seconds": 344.08,
      "duration_seconds": 2.94,
      "text": "Okay, so okay, I'll arrange it."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 345.14,
      "end_seconds": 352.01,
      "duration_seconds": 6.87,
      "text": "Let me check I've been clear. What will you do once you get home?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 353.97,
      "end_seconds": 366.53,
      "duration_seconds": 12.56,
      "text": "So, I take the aciclovir, 800 milligrams, five times a day and come back if the pain persists after a month. Is that right?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 368.05,
      "end_seconds": 373.18,
      "duration_seconds": 5.13,
      "text": "So, yes, exactly right. Have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 374.59,
      "end_seconds": 378.08,
      "duration_seconds": 3.49,
      "text": "Okay, that makes sense. Thanks for explaining."
    }
  ]
}