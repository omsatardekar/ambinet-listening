{
  "schema_version": "1.0",
  "encounter_id": "20320",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.68,
      "end_seconds": 4.46,
      "duration_seconds": 3.78,
      "text": "Hi, is it okay to come in now?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 4.98,
      "end_seconds": 8.65,
      "duration_seconds": 3.67,
      "text": "Of course, leave it there. How can I help?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 10.68,
      "end_seconds": 20.04,
      "duration_seconds": 9.36,
      "text": "Yeah, it's my heart racing. I don't know what's causing it. I'm hoping you can tell me something definite."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 20.83,
      "end_seconds": 23.68,
      "duration_seconds": 2.85,
      "text": "Let me take your readings now."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 32.81,
      "end_seconds": 35.49,
      "duration_seconds": 2.68,
      "text": "Bear with me while this finishes..."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 45.86,
      "end_seconds": 59.65,
      "duration_seconds": 13.79,
      "text": "Okay: respiratory rate 16, SpO2 98 percent on room air. And BP is 115 over 80, pulse is 105 beats a minute. How long has this been bothering you?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 61.46,
      "end_seconds": 64.92,
      "duration_seconds": 3.46,
      "text": "It's been going on for three weeks."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 66.34,
      "end_seconds": 71.97,
      "duration_seconds": 5.63,
      "text": "Okay, give me more detail on it, whatever comes to mind."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 74.01,
      "end_seconds": 87.41,
      "duration_seconds": 13.4,
      "text": "It's all the time. Only lying down, and it's not much. It's worse with stress and coffee. I've also been feeling lightheaded, for nearly five years."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 89.27,
      "end_seconds": 94.27,
      "duration_seconds": 5.0,
      "text": "Have you had any chest pain, tremor, sweating or leg swelling?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 95.68,
      "end_seconds": 98.67,
      "duration_seconds": 2.99,
      "text": "Well, no, I'd have said so."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 99.8,
      "end_seconds": 102.15,
      "duration_seconds": 2.35,
      "text": "Has your skin been okay?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 104.14,
      "end_seconds": 105.1,
      "duration_seconds": 0.96,
      "text": "No rashes."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 120.79,
      "end_seconds": 122.27,
      "duration_seconds": 1.48,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 123.36,
      "end_seconds": 125.46,
      "duration_seconds": 2.1,
      "text": "No, not at all."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 141.95,
      "end_seconds": 144.75,
      "duration_seconds": 2.8,
      "text": "Now some background about your lifestyle."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 146.36,
      "end_seconds": 160.32,
      "duration_seconds": 13.96,
      "text": "I gave up cigarettes last spring. I walk the dog every morning. I live with my elderly mother. I grab fast food at lunch most days."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 161.44,
      "end_seconds": 164.77,
      "duration_seconds": 3.33,
      "text": "Any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 168.77,
      "end_seconds": 171.85,
      "duration_seconds": 3.08,
      "text": "No, I've always been fairly healthy."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 173.5,
      "end_seconds": 175.88,
      "duration_seconds": 2.38,
      "text": "Are you on any regular medication?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 176.45,
      "end_seconds": 179.27,
      "duration_seconds": 2.82,
      "text": "No, I'm not on anything."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 196.17,
      "end_seconds": 200.93,
      "duration_seconds": 4.76,
      "text": "Okay, are there any allergies I should be aware of?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 201.84,
      "end_seconds": 206.18,
      "duration_seconds": 4.34,
      "text": "Naproxen. I come out in... well, stomach pain."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 207.96,
      "end_seconds": 210.5,
      "duration_seconds": 2.54,
      "text": "Let's move on to the examination."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 211.67,
      "end_seconds": 212.99,
      "duration_seconds": 1.32,
      "text": "Nearly finished here."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 220.56,
      "end_seconds": 223.76,
      "duration_seconds": 3.2,
      "text": "Heart sounds are normal with no murmur."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 225.0,
      "end_seconds": 227.39,
      "duration_seconds": 2.39,
      "text": "I'm just checking this side."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 240.88,
      "end_seconds": 245.14,
      "duration_seconds": 4.26,
      "text": "The pulse is irregular, around ninety beats a minute."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 250.99,
      "end_seconds": 252.93,
      "duration_seconds": 1.94,
      "text": "You can relax now."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 266.29,
      "end_seconds": 271.97,
      "duration_seconds": 5.68,
      "text": "Putting it all together, I'd lean towards paroxysmal palpitations, possibly an atrial arrhythmia."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 273.01,
      "end_seconds": 276.1,
      "duration_seconds": 3.09,
      "text": "What are the odds it's serious?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 277.83,
      "end_seconds": 308.27,
      "duration_seconds": 30.44,
      "text": "It's reasonable to be concerned, but right now paroxysmal palpitations, possibly an atrial arrhythmia is my leading thought, not anything worse. Let's book a thyroid test to look into palpitations. Let's use bisoprolol, 2.5 milligrams, once a day, until review. It's for heart rate control. Cut right back on coffee, tea and energy drinks for now. One warning sign to remember: you faint or get chest pain with the racing. In that case don't wait."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 310.08,
      "end_seconds": 313.13,
      "duration_seconds": 3.05,
      "text": "I know what to watch for."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 314.44,
      "end_seconds": 317.08,
      "duration_seconds": 2.64,
      "text": "Let's review you in three weeks."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 318.56,
      "end_seconds": 319.26,
      "duration_seconds": 0.7,
      "text": "Right."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 320.11,
      "end_seconds": 322.72,
      "duration_seconds": 2.61,
      "text": "Does all of that make sense?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 324.52,
      "end_seconds": 327.98,
      "duration_seconds": 3.46,
      "text": "No, that's all. Thanks a lot."
    }
  ]
}