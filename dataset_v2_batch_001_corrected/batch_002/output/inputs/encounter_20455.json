  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.74,
      "end_seconds": 4.42,
      "duration_seconds": 3.68,
      "text": "Hello, doctor. I think it's my turn."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.95,
      "end_seconds": 9.77,
      "duration_seconds": 3.82,
      "text": "No problem at all, come in. What's troubling you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 11.04,
      "end_seconds": 17.81,
      "duration_seconds": 6.77,
      "text": "Yeah, it's a sudden urgent need to go. I don't know what's causing it."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 19.78,
      "end_seconds": 23.43,
      "duration_seconds": 3.65,
      "text": "When was the first time you noticed it?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 24.72,
      "end_seconds": 28.55,
      "duration_seconds": 3.83,
      "text": "Yesterday, it came on out of nowhere."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 30.17,
      "end_seconds": 34.78,
      "duration_seconds": 4.61,
      "text": "So, anything in your past medical history I should know?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 40.44,
      "end_seconds": 43.19,
      "duration_seconds": 2.75,
      "text": "I have diabetes. Yes, migraines."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 45.14,
      "end_seconds": 47.01,
      "duration_seconds": 1.87,
      "text": "Is there anything more?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 48.09,
      "end_seconds": 53.07,
      "duration_seconds": 4.98,
      "text": "yes, migraines is known to us, good to have that clear"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 67.43,
      "end_seconds": 69.42,
      "duration_seconds": 1.99,
      "text": "okay, any previous surgeries?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 71.36,
      "end_seconds": 74.78,
      "duration_seconds": 3.42,
      "text": "No, I've never been operated on."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 75.41,
      "end_seconds": 77.64,
      "duration_seconds": 2.23,
      "text": "Tell me your medicines, please."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 83.85,
      "end_seconds": 87.1,
      "duration_seconds": 3.25,
      "text": "Glibenclamide, before breakfast for my sugar."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 88.64,
      "end_seconds": 91.39,
      "duration_seconds": 2.75,
      "text": "Alright, do you know the dose?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 92.41,
      "end_seconds": 106.72,
      "duration_seconds": 14.31,
      "text": "It's 5 milligrams. I'm on propranolol, 40 milligrams, twice a day for the migraine prevention. It's the not knowing that gets to me. I take cranberry juice, every day."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 111.44,
      "end_seconds": 113.2,
      "duration_seconds": 1.76,
      "text": "Alright, are you active?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 115.0,
      "end_seconds": 118.02,
      "duration_seconds": 3.02,
      "text": "I walk the dog every morning."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 119.5,
      "end_seconds": 122.14,
      "duration_seconds": 2.64,
      "text": "do you follow any particular diet?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 123.35,
      "end_seconds": 126.68,
      "duration_seconds": 3.33,
      "text": "I'm vegetarian and have been for years"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 137.51,
      "end_seconds": 139.47,
      "duration_seconds": 1.96,
      "text": "Nothing like loin pain?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 140.14,
      "end_seconds": 144.14,
      "duration_seconds": 4.0,
      "text": "No, I haven't had any loin pain."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 145.69,
      "end_seconds": 149.08,
      "duration_seconds": 3.39,
      "text": "Did you get vomiting, new partner or fever?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 151.0,
      "end_seconds": 154.45,
      "duration_seconds": 3.45,
      "text": "No, no vomiting, new partner or fever."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 155.71,
      "end_seconds": 159.04,
      "duration_seconds": 3.33,
      "text": "Any muscle or joint problems besides this?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 160.36,
      "end_seconds": 162.34,
      "duration_seconds": 1.98,
      "text": "No, joints are fine."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 163.83,
      "end_seconds": 168.72,
      "duration_seconds": 4.89,
      "text": "Have you noticed any weakness, or anything odd with your balance?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 169.54,
      "end_seconds": 170.9,
      "duration_seconds": 1.36,
      "text": "Nothing odd there."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 179.71,
      "end_seconds": 182.6,
      "duration_seconds": 2.89,
      "text": "Time for your numbers, if that's okay."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 193.77,
      "end_seconds": 196.03,
      "duration_seconds": 2.26,
      "text": "Nearly done with the readings..."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 214.9,
      "end_seconds": 223.81,
      "duration_seconds": 8.91,
      "text": "okay: BP is 116 over 79, saturation 97 percent, temperature is 36.9 degrees, heart rate 79, respiratory rate 17."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 224.85,
      "end_seconds": 230.05,
      "duration_seconds": 5.2,
      "text": "I'll need to examine you for this, it won't take long"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 239.94,
      "end_seconds": 240.85,
      "duration_seconds": 0.91,
      "text": "That's alright."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 241.92,
      "end_seconds": 243.92,
      "duration_seconds": 2.0,
      "text": "Right, does that hurt?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 259.26,
      "end_seconds": 265.3,
      "duration_seconds": 6.04,
      "text": "Your tummy is soft with mild tenderness low down and no pain in the loins."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 267.99,
      "end_seconds": 280.75,
      "duration_seconds": 12.76,
      "text": "All finished, thank you. So, based on the history and the examination, this looks most like a lower urinary tract infection. Let's book a urine test to look into dysuria."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 282.07,
      "end_seconds": 284.22,
      "duration_seconds": 2.15,
      "text": "Okay, I'll do it."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 286.04,
      "end_seconds": 313.03,
      "duration_seconds": 26.99,
      "text": "I'll start you on nitrofurantoin, 100 milligrams, twice a day, for three days. That should help with urinary infection. I'll put all of this in writing so you don't have to remember it. Drink plenty of water and don't hold on when you need to go. Let's plan a check after the culture result. Is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 314.91,
      "end_seconds": 317.87,
      "duration_seconds": 2.96,
      "text": "Right, thank you, that's helpful."
    }
  ]
}