{
  "schema_version": "1.0",
  "encounter_id": "20153",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.94,
      "end_seconds": 7.34,
      "duration_seconds": 6.4,
      "text": "Hi, doctor, I came as soon as they called me."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.5,
      "end_seconds": 13.71,
      "duration_seconds": 5.21,
      "text": "You're alright, take a seat. What can I do for you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 15.65,
      "end_seconds": 21.74,
      "duration_seconds": 6.09,
      "text": "I mean, doctor, I'm just here to help with the details."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 22.98,
      "end_seconds": 29.8,
      "duration_seconds": 6.82,
      "text": "Mm, doctor, it's a band-like headache. It's getting on my nerves now."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 33.6,
      "end_seconds": 36.5,
      "duration_seconds": 2.9,
      "text": "Let me take your readings now."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 50.37,
      "end_seconds": 52.46,
      "duration_seconds": 2.09,
      "text": "Okay, this won't take long..."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 65.12,
      "end_seconds": 75.51,
      "duration_seconds": 10.39,
      "text": "Okay: temperature 36.6, blood pressure 115 over 81, pulse is 86 beats a minute. How long has it been like this?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 80.87,
      "end_seconds": 83.53,
      "duration_seconds": 2.66,
      "text": "It's been three weeks now."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 89.56,
      "end_seconds": 93.12,
      "duration_seconds": 3.56,
      "text": "Would you say mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 94.61,
      "end_seconds": 101.83,
      "duration_seconds": 7.22,
      "text": "Well, it's... hard to say, it's kind of... I don't know—"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 103.81,
      "end_seconds": 109.16,
      "duration_seconds": 5.35,
      "text": "Take your time. Mild, moderate, or severe, if you had to pick?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 110.48,
      "end_seconds": 111.69,
      "duration_seconds": 1.21,
      "text": "Mostly moderate."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 112.27,
      "end_seconds": 122.5,
      "duration_seconds": 10.23,
      "text": "Oh, you know, and the other thing I wanted to mention is that I can't really—"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_4",
      "role": "FAMILY_MEMBER",
      "start_seconds": 122.6,
      "end_seconds": 128.82,
      "duration_seconds": 6.22,
      "text": "Actually, tell the doctor about the other thing, that's what worries me."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 129.88,
      "end_seconds": 132.63,
      "duration_seconds": 2.75,
      "text": "I was getting to that!"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 133.89,
      "end_seconds": 137.25,
      "duration_seconds": 3.36,
      "text": "Has there been a tight scalp too?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 139.0,
      "end_seconds": 143.24,
      "duration_seconds": 4.24,
      "text": "Yes, uh, about the same, six months."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 144.0,
      "end_seconds": 147.53,
      "duration_seconds": 3.53,
      "text": "Has there been a bit of nausea too?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 148.5,
      "end_seconds": 149.8,
      "duration_seconds": 1.3,
      "text": "Mm, yes."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 150.68,
      "end_seconds": 153.63,
      "duration_seconds": 2.95,
      "text": "Would you say mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 154.6,
      "end_seconds": 158.15,
      "duration_seconds": 3.55,
      "text": "A eight out of ten, I suppose."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_5",
      "role": "UNKNOWN",
      "start_seconds": 159.52,
      "end_seconds": 163.42,
      "duration_seconds": 3.9,
      "text": "Yes, that's right, that's how it was."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 164.78,
      "end_seconds": 167.55,
      "duration_seconds": 2.77,
      "text": "Have you had any fever or vomiting?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 168.3,
      "end_seconds": 179.62,
      "duration_seconds": 11.32,
      "text": "No, no fever, no vomiting. I did have trouble sleeping at one point, but that went away on its own."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 180.99,
      "end_seconds": 188.45,
      "duration_seconds": 7.46,
      "text": "Let me check a few things. Any blurred vision, weakness, head injury or jaw pain on chewing?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 190.41,
      "end_seconds": 193.46,
      "duration_seconds": 3.05,
      "text": "No, none of those at all."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 195.46,
      "end_seconds": 199.05,
      "duration_seconds": 3.59,
      "text": "On the cardiac side, anything I should know?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 202.81,
      "end_seconds": 206.89,
      "duration_seconds": 4.08,
      "text": "Mm, you know, no, that's been fine."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 224.71,
      "end_seconds": 227.17,
      "duration_seconds": 2.46,
      "text": "What's on your current medicine list?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 228.93,
      "end_seconds": 237.34,
      "duration_seconds": 8.41,
      "text": "Uh, it's a... um, I can't remember what it's called. It's a little pink tablet."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 238.26,
      "end_seconds": 241.01,
      "duration_seconds": 2.75,
      "text": "Do you remember what it's for?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 241.56,
      "end_seconds": 258.03,
      "duration_seconds": 16.47,
      "text": "Ah, for my migraines, I believe. My wife sets them out for me, I just take what I'm given. It's, It's escitalopram, 10 milligrams, once a day."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_4",
      "role": "FAMILY_MEMBER",
      "start_seconds": 258.62,
      "end_seconds": 269.42,
      "duration_seconds": 10.8,
      "text": "Doctor, I think the last prescription for the escitalopram was 5 milligrams. We changed it at the last visit."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 270.68,
      "end_seconds": 274.79,
      "duration_seconds": 4.11,
      "text": "So, I see. Is the most recent prescription on you?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 275.72,
      "end_seconds": 287.58,
      "duration_seconds": 11.86,
      "text": "I don't think I have it with me. I take something called carv... carvedilol, 6.25 milligrams, maybe, twice a day."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 288.56,
      "end_seconds": 292.58,
      "duration_seconds": 4.02,
      "text": "Have you got the box or the prescription on you?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 293.21,
      "end_seconds": 305.04,
      "duration_seconds": 11.83,
      "text": "Okay, um, so no, it's at home. I'm on paracetamol, 500 milligrams, most days. Diclofenac I don't take anymore."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 306.83,
      "end_seconds": 309.27,
      "duration_seconds": 2.44,
      "text": "What about your medical history?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 310.43,
      "end_seconds": 313.64,
      "duration_seconds": 3.21,
      "text": "I have migraines. I have anxiety."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 315.67,
      "end_seconds": 316.37,
      "duration_seconds": 0.7,
      "text": "Ah."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 321.81,
      "end_seconds": 329.26,
      "duration_seconds": 7.45,
      "text": "I have heart failure. I've had arthritis in my knees for two years now."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 329.91,
      "end_seconds": 337.62,
      "duration_seconds": 7.71,
      "text": "Hm, okay. Alright, migraines and anxiety, that matches what I have here. Anything surgical in your history?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 339.09,
      "end_seconds": 355.96,
      "duration_seconds": 16.87,
      "text": "I had my tonsils removed as a teenager. A neighbour of mine said I should see someone about it. Work has been very busy so I kept ignoring it."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 371.77,
      "end_seconds": 373.36,
      "duration_seconds": 1.59,
      "text": "Do you drink alcohol?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 374.97,
      "end_seconds": 377.89,
      "duration_seconds": 2.92,
      "text": "I only drink at family occasions."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 379.02,
      "end_seconds": 381.93,
      "duration_seconds": 2.91,
      "text": "So, do you follow any particular diet?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 383.02,
      "end_seconds": 386.8,
      "duration_seconds": 3.78,
      "text": "I'm vegetarian and have been for years."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 388.25,
      "end_seconds": 390.17,
      "duration_seconds": 1.92,
      "text": "How active are you?"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 392.07,
      "end_seconds": 395.57,
      "duration_seconds": 3.5,
      "text": "I hardly move around during the day."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 396.13,
      "end_seconds": 401.09,
      "duration_seconds": 4.96,
      "text": "Any allergies to tablets, food or anything in the environment?"
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 405.68,
      "end_seconds": 415.35,
      "duration_seconds": 9.67,
      "text": "Plasters. I come out in... well, a red itchy rash. Yes, erythromycin. I get bad stomach cramps."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 416.94,
      "end_seconds": 446.28,
      "duration_seconds": 29.34,
      "text": "Listening to the whole story, I think we're dealing with tension-type headaches with possible medication overuse at this stage. I want to be honest that this is an impression, not a final answer. I can't rule out a posture-related neck problem yet. It could also be migraine, so we'll keep that open. I want blood tests done, that's for headache."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 448.25,
      "end_seconds": 455.9,
      "duration_seconds": 7.65,
      "text": "Let's get a headache diary, for frequent headaches. The result will help us decide whether anything more is needed."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 457.57,
      "end_seconds": 459.27,
      "duration_seconds": 1.7,
      "text": "Does it hurt?"
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 462.72,
      "end_seconds": 485.86,
      "duration_seconds": 23.14,
      "text": "Short breaks from the screen every hour and some neck stretches. Try to limit painkillers to two days a week and keep a diary of the headaches. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 486.39,
      "end_seconds": 488.05,
      "duration_seconds": 1.66,
      "text": "Yes, will do."
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 491.43,
      "end_seconds": 498.46,
      "duration_seconds": 7.03,
      "text": "Let's plan a check in four weeks. I think we're done unless you have questions."
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 504.55,
      "end_seconds": 509.9,
      "duration_seconds": 5.35,
      "text": "Um, uh, I think I understand everything. Thanks."
    }
  ]
}