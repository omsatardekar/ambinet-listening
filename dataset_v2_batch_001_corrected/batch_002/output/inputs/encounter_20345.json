{
  "schema_version": "1.0",
  "encounter_id": "20345",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 0.74,
      "end_seconds": 7.86,
      "duration_seconds": 7.12,
      "text": "Okay, doctor, we're all set in here. I'll give you the numbers when you want them."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.44,
      "end_seconds": 13.88,
      "duration_seconds": 5.44,
      "text": "Great. Hello, come in and sit down. How can I help?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 18.8,
      "end_seconds": 24.87,
      "duration_seconds": 6.07,
      "text": "Good afternoon, doctor. I look after them so I thought I'd come."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 26.79,
      "end_seconds": 30.96,
      "duration_seconds": 4.17,
      "text": "Of course, please stay. It's helpful to have you here."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 31.6,
      "end_seconds": 37.73,
      "duration_seconds": 6.13,
      "text": "Yeah, it's being very thirsty. I don't know what's causing it."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 42.02,
      "end_seconds": 50.73,
      "duration_seconds": 8.71,
      "text": "Here are the numbers, doctor. Heart rate 73, SpO2 98 percent on room air. Blood pressure 168 over 95, respiratory rate 18."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 51.33,
      "end_seconds": 54.88,
      "duration_seconds": 3.55,
      "text": "Thanks. How long has it been like this?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 56.43,
      "end_seconds": 58.79,
      "duration_seconds": 2.36,
      "text": "For six months, I'd say."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 59.33,
      "end_seconds": 62.78,
      "duration_seconds": 3.45,
      "text": "Have you been passing a lot of urine?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 63.94,
      "end_seconds": 71.92,
      "duration_seconds": 7.98,
      "text": "Yes, I have. I, I did have recurrent thrush at one point, but that's gone now."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 73.96,
      "end_seconds": 75.8,
      "duration_seconds": 1.84,
      "text": "Any fruity smelling breath?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 76.58,
      "end_seconds": 79.86,
      "duration_seconds": 3.28,
      "text": "Not at all, no fruity smelling breath."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 81.65,
      "end_seconds": 86.61,
      "duration_seconds": 4.96,
      "text": "Have you had any vomiting, chest pain, abdominal pain or fever?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 88.36,
      "end_seconds": 94.96,
      "duration_seconds": 6.6,
      "text": "I haven't had vomiting, chest pain, abdominal pain or fever, no."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 95.83,
      "end_seconds": 100.14,
      "duration_seconds": 4.31,
      "text": "Okay, how about your heart, any problems like that?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 101.76,
      "end_seconds": 103.28,
      "duration_seconds": 1.52,
      "text": "Nothing like that."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 105.24,
      "end_seconds": 109.15,
      "duration_seconds": 3.91,
      "text": "Any inherited conditions that you know of in the family?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 111.24,
      "end_seconds": 113.96,
      "duration_seconds": 2.72,
      "text": "My mother had a stroke."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 127.69,
      "end_seconds": 131.19,
      "duration_seconds": 3.5,
      "text": "What do you take on a normal day?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 133.23,
      "end_seconds": 146.33,
      "duration_seconds": 13.1,
      "text": "He is on metoprolol, 50 milligrams, twice a day for my pressure, I give it to him. It's simvastatin, 20 milligrams, at night, doctor."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 148.22,
      "end_seconds": 151.48,
      "duration_seconds": 3.26,
      "text": "Okay, roughly how long on that one?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 152.02,
      "end_seconds": 153.98,
      "duration_seconds": 1.96,
      "text": "For about three months."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 154.66,
      "end_seconds": 158.87,
      "duration_seconds": 4.21,
      "text": "I used to take atorvastatin, but I stopped it."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 159.55,
      "end_seconds": 162.13,
      "duration_seconds": 2.58,
      "text": "Now some background about your lifestyle."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 162.94,
      "end_seconds": 172.0,
      "duration_seconds": 9.06,
      "text": "I work in accounts at a hospital. I'm vegetarian and have been for years. I live with my elderly mother."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 173.81,
      "end_seconds": 176.55,
      "duration_seconds": 2.74,
      "text": "Do you have any chronic illnesses?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 177.85,
      "end_seconds": 184.35,
      "duration_seconds": 6.5,
      "text": "I've had high blood pressure for five years now. I've got high cholesterol."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 186.33,
      "end_seconds": 197.03,
      "duration_seconds": 10.7,
      "text": "Yes, carry on. Right, so high blood pressure and high cholesterol are already on your record. We'll keep that in mind today."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 215.29,
      "end_seconds": 217.97,
      "duration_seconds": 2.68,
      "text": "Before we go further, any allergies?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 221.2,
      "end_seconds": 222.82,
      "duration_seconds": 1.62,
      "text": "No known allergies."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 223.62,
      "end_seconds": 229.4,
      "duration_seconds": 5.78,
      "text": "I'm not sure that's right. I seem to recall a problem with trimethoprim."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 229.92,
      "end_seconds": 231.74,
      "duration_seconds": 1.82,
      "text": "I don't remember that."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 233.29,
      "end_seconds": 238.82,
      "duration_seconds": 5.53,
      "text": "Alright, so that's unclear. I'll record what each of you said."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 240.12,
      "end_seconds": 244.9,
      "duration_seconds": 4.78,
      "text": "I'll need to examine you for this, it won't take long."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 246.89,
      "end_seconds": 249.43,
      "duration_seconds": 2.54,
      "text": "I'll listen to your chest now."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 257.63,
      "end_seconds": 264.04,
      "duration_seconds": 6.41,
      "text": "Your fingerprick sugar here is high, and your feet have good pulses and normal feeling."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 266.97,
      "end_seconds": 269.68,
      "duration_seconds": 2.71,
      "text": "Thank you, you can get dressed."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 281.67,
      "end_seconds": 297.66,
      "duration_seconds": 15.99,
      "text": "So where does that leave us? I'd lean towards symptoms that point to newly developed type 2 diabetes. That's my thinking for now, and it may change as we learn more. Another possibility is an overactive thyroid."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 299.64,
      "end_seconds": 302.68,
      "duration_seconds": 3.04,
      "text": "What are the odds it's serious?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 304.15,
      "end_seconds": 317.1,
      "duration_seconds": 12.95,
      "text": "I understand the worry. At the moment I'd say it's symptoms that point to newly developed type 2 diabetes, and we'll know more once the a urine test is back."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 318.71,
      "end_seconds": 322.4,
      "duration_seconds": 3.69,
      "text": "We've already done a urine test this morning, doctor."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 323.7,
      "end_seconds": 338.8,
      "duration_seconds": 15.1,
      "text": "Thanks, that helps. I'd like to arrange an HbA1c for suspected diabetes. I'm prescribing metformin, 500 milligrams, once a day with food, long term. You take it by mouth. It's for high blood sugar."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 340.86,
      "end_seconds": 342.57,
      "duration_seconds": 1.71,
      "text": "Okay, I understand."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 343.75,
      "end_seconds": 369.04,
      "duration_seconds": 25.29,
      "text": "Cut right down on sugary drinks and keep water with you. Please take the tablets with food so they don't upset your stomach. The diabetes educator would be the right next step, I'll refer you. If you are vomiting or feel confused, that's the point to come in urgently. Anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 369.94,
      "end_seconds": 373.06,
      "duration_seconds": 3.12,
      "text": "I think I understand everything. Thanks."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 374.36,
      "end_seconds": 375.72,
      "duration_seconds": 1.36,
      "text": "Goodbye for now."
    }
  ]
}