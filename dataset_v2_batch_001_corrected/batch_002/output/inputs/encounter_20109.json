      "role": "NURSE",
      "start_seconds": 165.98,
      "end_seconds": 178.01,
      "duration_seconds": 12.03,
      "text": "okay, so the vitals from earlier blood pressure 108 over 70, temperature is 36.5 degrees, pulse is 68 beats a minute, respiratory rate 18, oxygen saturation is 98 percent"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
