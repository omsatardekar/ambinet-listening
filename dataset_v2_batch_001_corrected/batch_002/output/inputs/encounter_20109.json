      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 261.75,
      "end_seconds": 265.54,
      "duration_seconds": 3.79,
      "text": "I'll request blood tests, it'll help with weight loss."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 266.57,
      "end_seconds": 268.72,
      "duration_seconds": 2.15,
      "text": "right, uh, understood"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 270.75,
      "end_seconds": 295.86,
      "duration_seconds": 25.11,
      "text": "I'm going to order a thyroid test, for weight loss. Weigh yourself once a week at the same time and note it down. Cut back on tea, coffee and fizzy drinks for a couple of weeks and see how things settle. We'll refer you to the chest clinic. Let's review you in two weeks."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 297.43,
      "end_seconds": 298.13,
      "duration_seconds": 0.7,
      "text": "sure"
    },
