      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 223.19,
      "end_seconds": 225.56,
      "duration_seconds": 2.37,
      "text": "that's all I needed to check"
