      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 211.62,
      "end_seconds": 217.16,
      "duration_seconds": 5.54,
      "text": "I can feel a couple of small glands in your neck, not tender"
