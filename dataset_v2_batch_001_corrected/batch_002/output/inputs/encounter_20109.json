    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 218.94,
      "end_seconds": 220.05,
      "duration_seconds": 1.11,
      "text": "okay, doctor"
