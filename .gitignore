# Secrets and local configuration (never commit)
.env

# Python
.venv/
.venv-extraction/
__pycache__/
*.pyc
.pytest_cache/

# Frontend
frontend/node_modules/
frontend/dist/

# Runtime data created by the app (may contain patient audio; never commit)
offline_recordings/
backend/uploads/
*.tmp



# generated by the build scripts (the upload files score_single_file*.py are kept)
finetune_slm/deployment/h1_baseline/code_bundle/
finetune_slm/deployment/source/code_bundle/
finetune_slm/deployment/source/code_bundle_*/

# SOAP module: local job data and command-line output (patient-related)
soap_data/
soap_out/

# Large or local-only items (never commit)
*.zip
office_transfer_package/
.tts_cache/
extraction_data/
**/ov_cache/
**/ov_cache_smoke/
finetune_slm/experiments/qwen3_0.6b_baseline/EXP_002_QWEN3_0.6B_GPU_DIRECT/env_openvino/
finetune_slm/experiments/qwen3_1.7b_track/models/hf_cache/
finetune_slm/experiments/qwen3_1.7b_track/models/Qwen3-1.7B-ov-fp16/openvino_model.bin

# fine-tuning: large model files and caches kept locally (the 11 files of each deployment model are registered in Azure ML, not committed)
finetune_slm/models/
finetune_slm/archive/*.zip
finetune_slm/archive/*.tar
finetune_slm/archive/transfer_tarballs/
finetune_slm/evaluation/judge_eval/cache/
finetune_slm/deployment/*/model_files/

# a local .git/info/exclude hides every folder called "archive"; the moved datasets must be tracked
!finetune_slm/archive/
finetune_slm/archive/dataset/
