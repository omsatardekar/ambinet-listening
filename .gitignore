# Secrets and local configuration (never commit)
.env

# Python
.venv/
__pycache__/
*.pyc
.pytest_cache/

# Frontend
frontend/node_modules/
frontend/dist/

# Runtime data created by the app (may contain patient audio; never commit)
offline_recordings/
backend/uploads/
*.tmp

# Voice model downloaded on first start (reused afterwards)
models/

# Generated or large local data
output/
sessions/
audit/
