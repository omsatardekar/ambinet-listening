# Copy this file to .env and fill in your own values. Never commit .env.

# Azure Storage (required)
AZURE_STORAGE_ACCOUNT_NAME=
AZURE_STORAGE_ACCOUNT_KEY=
AZURE_AUDIO_CONTAINER=
AZURE_TRANSCRIPT_CONTAINER=
AZURE_STORAGE_OUTPUT_CONTAINER=
AZURE_STORAGE_SLM_CONTAINER=

# Azure Speech - option 1 (azure_speech)
AZURE_SPEECH_ENDPOINT=
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# Azure Speech - option 2 (foundry_fast)
AZURE_FOUNDRY_SPEECH_ENDPOINT=
AZURE_FOUNDRY_SPEECH_KEY=

# Azure AI Foundry agent (required for transcript reconstruction)
FOUNDRY_PROJECT_ENDPOINT=
FOUNDRY_API_KEY=
FOUNDRY_MODEL_DEPLOYMENT_NAME=
FOUNDRY_AGENT_NAME=
FOUNDRY_API_VERSION=

# Optional settings (defaults are used when left empty)
AZURE_TTS_MIN_INTERVAL_SEC=
VOICE_DOCTOR=
VOICE_PATIENT=
VOICE_NURSE=
SPEECH_LOCALE=
SPEECH_MAX_SPEAKERS=
SPEECH_API_VERSION=
POLL_INTERVAL_SECONDS=
JOB_TIMEOUT_MINUTES=
SAS_VALID_HOURS=
OUTPUT_FILE_PATTERN=
MAX_OUTPUT_TOKENS=
REQUEST_TIMEOUT_SECONDS=
MAX_RETRIES=
RETRY_BASE_SECONDS=
RECONSTRUCTED_FILE_SUFFIX=
SLM_FILE_SUFFIX=
LOG_LEVEL=
FOUNDRY_SPEECH_API_VERSION=
FOUNDRY_SPEECH_TIMEOUT_SECONDS=
ASHA_VOICE_MODEL=vosk-model-small-en-in-0.4
# Agent instructions file in prompts/. Default agent_instructions_v2.md; set agent_instructions.md for the original v1 behaviour.
AGENT_PROMPT_FILE=
