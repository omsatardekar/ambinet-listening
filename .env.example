# Copy this file to .env and fill in your own values. Never commit .env.

# Azure Storage (required)
AZURE_STORAGE_ACCOUNT_NAME=
AZURE_STORAGE_ACCOUNT_KEY=
AZURE_AUDIO_CONTAINER=
AZURE_TRANSCRIPT_CONTAINER=
AZURE_STORAGE_OUTPUT_CONTAINER=
AZURE_STORAGE_SLM_CONTAINER=

# Azure Speech - option 1 (azure_speech)
AZURE_SPEECH_ENDPOINT=
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# Azure Speech - option 2 (foundry_fast)
AZURE_FOUNDRY_SPEECH_ENDPOINT=
AZURE_FOUNDRY_SPEECH_KEY=

# Azure AI Foundry agent (required for transcript reconstruction)
FOUNDRY_PROJECT_ENDPOINT=
FOUNDRY_API_KEY=
FOUNDRY_MODEL_DEPLOYMENT_NAME=
FOUNDRY_AGENT_NAME=
FOUNDRY_API_VERSION=

# Optional settings (defaults are used when left empty)
AZURE_TTS_MIN_INTERVAL_SEC=
# Voices for scripts/ambient_tts.py. Optional: an unset line uses the voice written in the scenario's scenario.json.
# Lookup order per speaker: VOICE_<ROLE>_<M|F> (patients carry a gender), then VOICE_<ROLE>. Two people in one
# encounter never share a voice (the later one falls back to scenario.json). List voices: python scripts/ambient_tts.py voices
VOICE_DOCTOR=en-US-JasonNeural
VOICE_NURSE=en-US-DavisNeural
VOICE_PATIENT_M=en-US-TonyNeural
VOICE_PATIENT_F=en-US-NancyNeural
VOICE_CAREGIVER=en-GB-SoniaNeural
VOICE_FAMILY_MEMBER=en-US-GuyNeural
VOICE_CLINICAL_STAFF=en-US-AriaNeural
VOICE_UNKNOWN=en-IN-PrabhatNeural
# VOICE_PATIENT=            (one voice for every patient; overridden by the _M/_F lines above)
SPEECH_LOCALE=
SPEECH_MAX_SPEAKERS=
SPEECH_API_VERSION=
POLL_INTERVAL_SECONDS=
JOB_TIMEOUT_MINUTES=
SAS_VALID_HOURS=
OUTPUT_FILE_PATTERN=
MAX_OUTPUT_TOKENS=
REQUEST_TIMEOUT_SECONDS=
MAX_RETRIES=
RETRY_BASE_SECONDS=
RECONSTRUCTED_FILE_SUFFIX=
SLM_FILE_SUFFIX=
LOG_LEVEL=
FOUNDRY_SPEECH_API_VERSION=
FOUNDRY_SPEECH_TIMEOUT_SECONDS=
ASHA_VOICE_MODEL=vosk-model-small-en-in-0.4
# Agent instructions file in prompts/. Default agent_instructions_v2.md; set agent_instructions.md for the original v1 behaviour.
AGENT_PROMPT_FILE=
# Join consecutive turns of the same speaker after attribution (1 = on, 0 = off).
MERGE_SAME_SPEAKER_TURNS=
# Progress-bar pacing while waiting on external services (seconds per second of audio / model time).
PROGRESS_FAST_SPEECH_FACTOR=
PROGRESS_BATCH_SPEECH_FACTOR=
PROGRESS_LLM_BASE_SECONDS=
PROGRESS_LLM_SECONDS_PER_SEGMENT=

# Stage 3: clinical extraction (clinical_extraction/). Reads {NN}slm_input.json from AZURE_STORAGE_SLM_CONTAINER, runs the model, saves {NN}extraction.json
# to the container below (created automatically if missing).
# The model runs on the Azure ML endpoint below whenever both EXTRACTION_ENDPOINT_* values are set (see finetune_slm/README.md, "Deploying a model to Azure ML", to host the model there).
# Azure ML > Endpoints > your endpoint > Consume: "REST endpoint" (ends with /score) and "Primary key".
EXTRACTION_ENDPOINT_URL=
EXTRACTION_ENDPOINT_KEY=
AZURE_STORAGE_EXTRACTION_CONTAINER=
# Optional. EXTRACTION_BACKEND=local forces the local model (Qwen3-0.6B + H1 prompt on this computer; one-time setup: python -m clinical_extraction.setup_local_model).
# With no endpoint configured, the local model is used automatically. EXTRACTION_DEVICE: AUTO (default, GPU if present else CPU) | GPU | CPU.
# EXTRACTION_PYTHON is only for a custom OpenVINO environment; .venv-extraction (made by the setup script) is found automatically.
EXTRACTION_BACKEND=
EXTRACTION_DEVICE=
EXTRACTION_PYTHON=

# LLM-judge evaluation (judge_eval/). Frontier model deployed in Azure AI Foundry. Synthetic data only.
JUDGE_ENDPOINT_URL=
JUDGE_API_KEY=
JUDGE_DEPLOYMENT=
JUDGE_API_VERSION=
# Second judge (a different model family, used on a sample to measure judge agreement)
JUDGE2_ENDPOINT_URL=
JUDGE2_API_KEY=
JUDGE2_DEPLOYMENT=

# ---- Module 4: SOAP note (the last step; reads the saved extraction, writes the note) ----
# New container for the finished notes ({NN}soap.json and {NN}soap.md); created automatically.
AZURE_STORAGE_SOAP_CONTAINER=soap-output
# Who writes the note: "agent" = a Foundry prompt agent (create it once: python scripts/create_soap_agent.py --model <deployment>), "model" = a direct call to a deployment.
# Empty = agent when SOAP_AGENT_NAME is set, otherwise model (it then reuses the JUDGE_* settings below when SOAP_MODEL_* are empty).
SOAP_BACKEND=
SOAP_AGENT_NAME=clinical-soap-note
# Required when SOAP_BACKEND=agent: the version number printed by `python scripts/create_soap_agent.py --model <deployment> --update-env` (it also writes it here).
SOAP_AGENT_VERSION=
SOAP_MODEL_ENDPOINT_URL=
SOAP_MODEL_API_KEY=
SOAP_MODEL_DEPLOYMENT=
# 0 (default, by design) = the SOAP step works only from the extraction stage output, so the quality of the note follows the quality of the extraction model.
# 1 = also give the writer the whole conversation (only for experiments: it lets the writer override the extraction).
SOAP_INCLUDE_TRANSCRIPT=0
# 0 (default) = the agent holds the prompt and requests stay short. 1 = also send the prompt with every request.
SOAP_SEND_INSTRUCTIONS=0
