    {
      "evidence_id": "EV_010",
      "speaker_id": "person_1",
      "speaker_role": "nurse",
      "transcript_text": "Here are the numbers, doctor. Blood pressure 120 over 79, weight 59 kilos. Heart rate 72, temp 36.9 degrees, BMI works out to 25.2, oxygen saturation is 97 percent, height 153 centimetres, respiratory rate 16.",
      "start_timestamp": "03:59",
