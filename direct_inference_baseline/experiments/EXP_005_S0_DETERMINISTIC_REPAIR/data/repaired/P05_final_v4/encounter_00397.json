      "supports": [
        "clinical_conditions[0]"
      ]
    },
    {
      "evidence_id": "EV_012",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "I understand the worry. At the moment I'd say it's an ankle sprain, and we'll know more once the an X-ray of the ankle is back. I'd like to arrange an X-ray of the ankle for ankle injury.",
      "start_timestamp": "05:41",
      "end_timestamp": "05:58",
      "supports": [
        "clinical_conditions[0]",
        "procedures_and_investigations[0]"
      ]
    },
    {
      "evidence_id": "EV_013",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "I'll start you on paracetamol, 650 milligrams, three times a day, for three days. It's for ankle pain. I'll put all of this in writing so you don't have to remember it. Rest, ice for twenty minutes at a time, a compression bandage and keep the foot up. Let's get you seen by physiotherapy, I'll arrange the letter.",
