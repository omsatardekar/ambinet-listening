      "supports": [
        "vital_signs[0]"
      ]
    },
    {
      "evidence_id": "EV_011",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Right, thanks, please take a seat again. Let me tell you where I've got to. This is probably an ankle sprain. I want to be honest that this is an impression, not a final answer. I'd also keep a ligament tear in mind.",
