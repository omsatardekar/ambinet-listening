    {
      "evidence_id": "EV_004",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "I have COPD, for five years. I took the morning off to come in today.",
      "start_timestamp": "01:42",
      "end_timestamp": "01:50",
      "supports": [
        "chief_complaint",
        "review_of_systems[0]",
