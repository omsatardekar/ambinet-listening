      "supports": [
        "allergies[0]"
      ]
    },
    {
      "evidence_id": "EV_008",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Okay: temperature is 37.5 degrees, heart rate 98. And respiratory rate 20, blood pressure 119 over 75, SpO2 90 percent on room air.",
      "start_timestamp": "03:56",
      "end_timestamp": "04:08",
      "supports": [
        "vital_signs[0]"
      ]
    },
    {
      "evidence_id": "EV_009",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Thanks, please take a seat again. Let me tell you where I've got to. I don't have a clear answer today: a flare-up of COPD is possible, and so is pneumonia.",
      "start_timestamp": "04:42",
      "end_timestamp": "04:58",
      "supports": [
        "clinical_conditions[0]",
        "clinical_assessment[0]"
      ]
    },
    {
      "evidence_id": "EV_010",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "I'm going to order blood tests, for infective exacerbation. I'm going to order a chest X-ray, for breathlessness.",
      "start_timestamp": "05:07",
      "end_timestamp": "05:14",
      "supports": [
        "symptoms[0]",
        "procedures_and_investigations[0]",
        "procedures_and_investigations[1]"
      ]
    },
    {
      "evidence_id": "EV_011",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Let's use doxycycline, 100 milligrams, twice a day, for five days. It's for chest infection.",
      "start_timestamp": "05:19",
      "end_timestamp": "05:25",
      "supports": [
        "symptoms[0]",
        "clinical_actions[0]"
      ]
    },
    {
      "evidence_id": "EV_012",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "I'll start you on prednisolone, 30 milligrams, once a day, for five days. That should help with COPD flare-up. I'll put all of this in writing so you don't have to remember it. If you become more breathless or your lips turn blue, that's the point to come in urgently.",
