      "end_timestamp": "05:29",
      "supports": [
        "clinical_conditions[0]",
        "clinical_assessment[0]",
        "procedures_and_investigations[0]",
        "follow_up[0]"
      ]
    },
    {
      "evidence_id": "EV_010",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Drink three litres of water a day and try to strain your urine so we can catch the stone if it passes. I'd like you to see the urology team as well, and I'll write the referral. Please don't wait if you get a fever or can't pass urine at all. That's when to be seen urgently. I'd like to see you again after the scan.",
