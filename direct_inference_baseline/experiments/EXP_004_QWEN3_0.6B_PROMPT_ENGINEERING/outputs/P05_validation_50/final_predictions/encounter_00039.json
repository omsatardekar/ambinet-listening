  "clinical_evidence": [
    {
      "evidence_id": "EV_001",
      "speaker_id": "person_3",
      "speaker_role": "family_member",
      "transcript_text": "It's hot flushes, doctor. She didn't want to come, but I insisted.",
      "start_timestamp": "00:26",
      "end_timestamp": "00:32",
      "supports": [
        "symptoms[0]"
