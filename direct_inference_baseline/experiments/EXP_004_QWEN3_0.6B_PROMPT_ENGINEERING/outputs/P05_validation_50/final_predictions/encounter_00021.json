      "supports": [
        "allergies[0]"
      ]
    },
    {
      "evidence_id": "EV_005",
      "speaker_id": "person_1",
      "speaker_role": "nurse",
      "transcript_text": "Okay, so the vitals from earlier. Saturation 96 percent, heart rate 108. Temp 37.1 degrees, respiratory rate 20, blood pressure 134 over 78.",
      "start_timestamp": "03:51",
      "end_timestamp": "04:01",
      "supports": [
