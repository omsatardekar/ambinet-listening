    {
      "evidence_id": "EV_001",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Seretide inhaler. I take it twice a day. Cough syrup. I take it at night. I was on amlodipine before. I stopped taking it.",
